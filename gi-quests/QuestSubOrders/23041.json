  "subQuests": [
    {
      "subId": "2304101",
      "subQuestName": "Talk to Nermin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230410101"
        ],
        "dialogs": {
          "230410101": {
            "id": "230410101",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Whew... Loosening the soil like this should work...",
            "nextDialogs": [
              "230410102"
            ]
          },
          "230410102": {
            "id": "230410102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you still looking after this flower?",
            "nextDialogs": [
              "230410103"
            ]
          },
          "230410103": {
            "id": "230410103",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Yep. Granny Kulsoom gave me a lot of tips on taking care of flowers.",
            "nextDialogs": [
              "230410104"
            ]
          },
          "230410104": {
            "id": "230410104",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Things like loosening soil, regularly trimming leaves, getting rid of bugs using various methods...",
            "nextDialogs": [
              "230410105"
            ]
          },
          "230410105": {
            "id": "230410105",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Oh, and you shouldn't water them too often, or else the roots will rot.",
            "nextDialogs": [
              "230410106"
            ]
          },
          "230410106": {
            "id": "230410106",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "*sigh* And I thought watering them every day was the way to go... To keep the soil moist and stuff...",
            "nextDialogs": [
              "230410107"
            ]
          },
          "230410107": {
            "id": "230410107",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "But it's a good thing, because I don't have to fetch water everyday anymore. The stepwell's really far away.",
            "nextDialogs": [
              "230410108"
            ]
          },
          "230410108": {
            "id": "230410108",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "I have to continue trimming the leaves. In the meantime, could you fetch a small can of water for me?",
            "nextDialogs": [
              "230410109"
            ]
          },
          "230410109": {
            "id": "230410109",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "I've talked to Kazan. He said I could water the flowers today.",
            "nextDialogs": [
              "230410114",
              "230410112"
            ]
          },
          "230410114": {
            "id": "230410114",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "The watering can is over there. Be careful when drawing water. Don't let too much mud get into the can!"
          },
          "230410112": {
            "id": "230410112",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Mm... Kinda. Granny Kulsoom knows everything. I always go to her when I have questions.",
            "nextDialogs": [
              "230410113"
            ]
          },
          "230410113": {
            "id": "230410113",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "I'm counting on you! One small can of water will do."
          }
        }
      }
    },
    {
      "subId": "2304102",
      "subQuestName": "Take the watering can",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230410201"
        ],
        "dialogs": {
          "230410201": {
            "id": "230410201",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Oh no... There's more bitten leaves...",
            "nextDialogs": [
              "230410202"
            ]
          },
          "230410202": {
            "id": "230410202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "230410203"
            ]
          },
          "230410203": {
            "id": "230410203",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Traveler, look! That kitten is chewing on my flowers again!",
            "nextDialogs": [
              "230410204"
            ]
          },
          "230410204": {
            "id": "230410204",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Look at this leaf over here... That one too! They all have large chunks bitten off!",
            "nextDialogs": [
              "230410206",
              "230410209"
            ]
          },
          "230410206": {
            "id": "230410206",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "That's also what Raef said. He even went around to feed the kitten...",
            "nextDialogs": [
              "230410207"
            ]
          },
          "230410207": {
            "id": "230410207",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "But the next day, the kitten came back to nibble on my flowers.",
            "nextDialogs": [
              "230410210"
            ]
          },
          "230410210": {
            "id": "230410210",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "The kitten just munches on leaves for now. What if it starts biting the stems? ...That would be a disaster.",
            "nextDialogs": [
              "230410211"
            ]
          },
          "230410211": {
            "id": "230410211",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "But I don't want to chase it away either. If it leaves the village, it'll have nowhere to go but to the desert...",
            "nextDialogs": [
              "230410212"
            ]
          },
          "230410212": {
            "id": "230410212",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Traveler, could you help me feed the kitten again? I hope it doesn't come nibbling at my flower leaves again. They're not even tasty to begin with..."
          },
          "230410209": {
            "id": "230410209",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "I'm not sure what it likes..."
          }
        }
      }
    },
    {
      "subId": "2304103",
      "subQuestName": "Fetch water from the stepwell",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230410301"
        ],
        "dialogs": {
          "230410301": {
            "id": "230410301",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Traveler, perfect timing! Come have a taste of the Minty Bean Soup I made.",
            "nextDialogs": [
              "230410303"
            ]
          },
          "230410303": {
            "id": "230410303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The ingredients in your soup...",
            "nextDialogs": [
              "230410304"
            ]
          },
          "230410304": {
            "id": "230410304",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "I asked someone to buy most of the ingredients for me, but as for Mint... I grew them myself.",
            "nextDialogs": [
              "230410305"
            ]
          },
          "230410305": {
            "id": "230410305",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Raef gave me a set of gardening tools and some fertilizer.",
            "nextDialogs": [
              "230410306"
            ]
          },
          "230410306": {
            "id": "230410306",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "I thought it would be a waste to use them on one single pot of flowers... So I asked Azalai to buy some Mint seeds for me.",
            "nextDialogs": [
              "230410307"
            ]
          },
          "230410307": {
            "id": "230410307",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "After planting the Mint seeds, I took care of them just like how I take care of the flowers.",
            "nextDialogs": [
              "230410308"
            ]
          },
          "230410308": {
            "id": "230410308",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "As time went on, the Mint grew and matured...",
            "nextDialogs": [
              "230410309"
            ]
          },
          "230410309": {
            "id": "230410309",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "So I picked some and made this Minty Bean Soup. What do you think? Tastes pretty good, huh?",
            "nextDialogs": [
              "230410310"
            ]
          },
          "230410310": {
            "id": "230410310",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Um... Since you ate my Minty Bean Soup, you have to do me a favor.",
            "nextDialogs": [
              "230410313"
            ]
          },
          "230410313": {
            "id": "230410313",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Hey, I was just joking! I'll give you a nice reward for your help.",
            "nextDialogs": [
              "230410314"
            ]
          },
          "230410314": {
            "id": "230410314",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "I just need you to pick three Zaytun Peaches for me. They're Raef's favorite fruit.",
            "nextDialogs": [
              "230410315"
            ]
          },
          "230410315": {
            "id": "230410315",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "I wanna add them to my Minty Bean Soup and bring it to him.",
            "nextDialogs": [
              "230410316"
            ]
          },
          "230410316": {
            "id": "230410316",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Now that I know how to make Minty Bean Soup, I just need someone to get the Zaytun Peaches for me."
          }
        }
      }
    },
    {
      "subId": "2304105",
      "subQuestName": "Go back and water the plants",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230410501"
        ],
        "dialogs": {
          "230410501": {
            "id": "230410501",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Did you fetch the water?",
            "nextDialogs": [
              "230410502"
            ]
          },
          "230410502": {
            "id": "230410502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "If this counts...",
            "nextDialogs": [
              "230410503"
            ]
          },
          "230410503": {
            "id": "230410503",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Great! I'm gonna start watering the flowers. Please wait a second...",
            "nextDialogs": [
              "230410504"
            ]
          },
          "230410504": {
            "id": "230410504",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Nermin starts watering the flowers...",
            "nextDialogs": [
              "230410505"
            ]
          },
          "230410505": {
            "id": "230410505",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Whew. This should do it...",
            "nextDialogs": [
              "230410506"
            ]
          },
          "230410506": {
            "id": "230410506",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Granny Kulsoom says that when you're watering plants, you should stop when the water starts seeping out from below the flower pot.",
            "nextDialogs": [
              "230410507"
            ]
          },
          "230410507": {
            "id": "230410507",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Because that means the soil has been \"soaked through.\" You need to water them once every three days...",
            "nextDialogs": [
              "230410508"
            ]
          },
          "230410508": {
            "id": "230410508",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Ah! Sorry, I got carried away... Here's the reward I promised. Thank you for helping out, Traveler.",
            "nextDialogs": [
              "230410509"
            ]
          },
          "230410509": {
            "id": "230410509",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Which tool should I use for trimming leaves..."
          }
        }
      }
    },
    {
      "subId": "2304113",
      "subQuestName": "Search for the kitten",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230410602"
        ],
        "dialogs": {
          "230410602": {
            "id": "230410602",
            "speakerId": 12899,
            "speakerName": "Lazy Cat",
            "text": "Meow? Meow meow meow!",
            "nextDialogs": [
              "230410603"
            ]
          },
          "230410603": {
            "id": "230410603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa! We aren't bad guys! Don't get so worked up!",
            "nextDialogs": [
              "230410604"
            ]
          },
          "230410604": {
            "id": "230410604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This should be the cat Nermin was talking about. Let's give it some food.",
            "nextDialogs": [
              "230410605"
            ]
          },
          "230410605": {
            "id": "230410605",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You place the food in front of the wary cat.",
            "nextDialogs": [
              "230410606"
            ]
          },
          "230410606": {
            "id": "230410606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It really likes the food. Paimon guesses this will do. Let's report back to Nermin."
          }
        }
      }
    },

    {
      "subId": "2304107",
      "subQuestName": "Report back to Nermin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230410701"
        ],
        "dialogs": {
          "230410701": {
            "id": "230410701",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Traveler, did you find the kitten?",
            "nextDialogs": [
              "230410704"
            ]
          },
          "230410704": {
            "id": "230410704",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Great! I hope it doesn't mess up my flowers again... Cat food is supposed to taste better than flower leaves, after all.",
            "nextDialogs": [
              "230410705"
            ]
          },
          "230410705": {
            "id": "230410705",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Thanks for your help, Traveler. Here, this is your reward.",
            "nextDialogs": [
              "230410706"
            ]
          },
          "230410706": {
            "id": "230410706",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "*sigh* I hope the kitten doesn't get hungry too soon..."
          }
        }
      }
    },
    {
      "subId": "2304109",
      "subQuestName": "Give Nermin the Zaytun Peaches",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230410901"
        ],
        "dialogs": {
          "230410901": {
            "id": "230410901",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Thank you. I need to cut them into pieces, then put them in my Minty Bean Soup...",
            "nextDialogs": [
              "230410902"
            ]
          },
          "230410902": {
            "id": "230410902",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Nermin starts making her special Minty Bean Soup...",
            "nextDialogs": [
              "230410903"
            ]
          },
          "230410903": {
            "id": "230410903",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Done! Hmm... It doesn't look any different than the regular Minty Bean Soup...",
            "nextDialogs": [
              "230410904"
            ]
          },
          "230410904": {
            "id": "230410904",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "But I'm sure it's gonna taste different!",
            "nextDialogs": [
              "230410905"
            ]
          },
          "230410905": {
            "id": "230410905",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Traveler, please bring this bowl of Minty Bean Soup to Raef.",
            "nextDialogs": [
              "230410906"
            ]
          },
          "230410906": {
            "id": "230410906",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "I have to make a few more servings for Granny Kulsoom. Ebeid and Hilmi said they wanted to try some too...",
            "nextDialogs": [
              "230410908",
              "230410910"
            ]
          },
          "230410908": {
            "id": "230410908",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "I won't! It's just a few bowls of Minty Bowl Soup, not a big deal at all!",
            "nextDialogs": [
              "230410911"
            ]
          },
          "230410911": {
            "id": "230410911",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Anyway, please bring this Minty Bean Soup to Raef.",
            "nextDialogs": [
              "230410912"
            ]
          },
          "230410912": {
            "id": "230410912",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "I have to prepare some for Nawaz and Ramiz as well..."
          },
          "230410910": {
            "id": "230410910",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Well... Since I'm finally able to actually do something meaningful, I have to make the most out of it."
          }
        }
      }
    },

    {
      "subId": "1203112",
      "subQuestName": "Go close to Uyuu Restaurant",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120311901"
        ],
        "dialogs": {
          "120311901": {
            "id": "120311901",
            "speakerId": 1004,
            "speakerName": "Kyouta",
            "text": "Ugh, the wait is unbearable! How has the next chapter of \"The Miraculous Adventures of the Traveler\" not been released yet!",
            "nextDialogs": [
              "120311902"
            ]
          },
          "120311902": {
            "id": "120311902",
            "speakerId": 1005,
            "speakerName": "Oosuke",
            "text": "It was quite a surprise when the \"moonless night\" finally came.",
            "nextDialogs": [
              "120311903"
            ]
          },
          "120311903": {
            "id": "120311903",
            "speakerId": 1006,
            "speakerName": "Tetsuo",
            "text": "Yeah, that huge black cloud over Mt. Yougou that night. It just seemed to form out of nowhere!",
            "nextDialogs": [
              "120311904"
            ]
          },
          "120311904": {
            "id": "120311904",
            "speakerId": 1005,
            "speakerName": "Oosuke",
            "text": "But then nothing happened after I made a wish using the method in that book.",
            "nextDialogs": [
              "120311905"
            ]
          },
          "120311905": {
            "id": "120311905",
            "speakerId": 1006,
            "speakerName": "Tetsuo",
            "text": "*sigh* I guess light novels are just fiction after all, huh.",
            "nextDialogs": [
              "120311906"
            ]
          },
          "120311906": {
            "id": "120311906",
            "speakerId": 1005,
            "speakerName": "Oosuke",
            "text": "That night was definitely the nail in the coffin for the \"incantations from novels\" fad. Still, something tells me \"The Miraculous Adventures of the Traveler\" will remain an interesting series for a long time to come!",
            "nextDialogs": [
              "120311907"
            ]
          },
          "120311907": {
            "id": "120311907",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Paimon can't see Miko anywhere.",
            "nextDialogs": [
              "120311908"
            ]
          },
          "120311908": {
            "id": "120311908",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Guess she's not out here. Uh... maybe she went inside already? Let's head in and look for her."
          }
        }
      }
    },

          },
          "739110102": {
            "id": "739110102",
            "speakerId": 4130,
            "speakerName": "Butrus",
            "text": "Exaggerated? No, no, no!",
            "nextDialogs": [
              "739110103"
            ]
          },
          "739110103": {
            "id": "739110103",
            "speakerId": 4130,
            "speakerName": "Butrus",
            "text": "I've been selling fish here my whole life. If I were a guy who exaggerates, I would've been shunned by customers and lost my business long ago.",
            "nextDialogs": [
              "739110104"
            ]
          },
          "739110104": {
            "id": "739110104",
            "speakerId": 4130,
            "speakerName": "Butrus",
            "text": "I know you won't believe me without trying it. Here, take some and have a taste! It's on the house!",
            "nextDialogs": [
              "739110105"
            ]
          },
          "739110105": {
            "id": "739110105",
            "speakerId": 4130,
            "speakerName": "Butrus",
            "text": "If you think they're good, then come back often."
          }
        }

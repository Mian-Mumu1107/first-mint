    {
      "subId": "46105",
      "subQuestName": "Talk",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4610513"
        ],
        "dialogs": {
          "4610513": {
            "id": "4610513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No. We're here for...",
            "nextDialogs": [
              "4610502"
            ]
          },
          "4610502": {
            "id": "4610502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Nope. We just want to know if you've been to the Arcadian Ruins?",
            "nextDialogs": [
              "4610503"
            ]
          },
          "4610503": {
            "id": "4610503",
            "speakerId": 1003,
            "speakerName": "Stanley",
            "text": "Arcadian Ruins? Imagine that... So there are places that I haven't been to...",
            "nextDialogs": [
              "4610504"
            ]
          },
          "4610504": {
            "id": "4610504",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh? Even the great Stanley doesn't know?",
            "nextDialogs": [
              "4610505"
            ]
          },
          "4610505": {
            "id": "4610505",
            "speakerId": 1003,
            "speakerName": "Stanley",
            "text": "Never mind this Arcadia... You need to know what happened to me on the Mare Jivari and in the Geyser Realm...",
            "nextDialogs": [
              "4610506"
            ]
          },
          "4610506": {
            "id": "4610506",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We don't have time for your stories. Think hard, please. We need clues.",
            "nextDialogs": [
              "4610507"
            ]
          },
          "4610507": {
            "id": "4610507",
            "speakerId": 1003,
            "speakerName": "Stanley",
            "text": "The Mare Jivari... It was a place of death...",
            "nextDialogs": [
              "4610508"
            ]
          },
          "4610508": {
            "id": "4610508",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Gosh...",
            "nextDialogs": [
              "4610509"
            ]
          },
          "4610509": {
            "id": "4610509",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "When we find the Arcadian<color=#00E1FFFF>treasure</color>, our story will definitely be better than your stupid stories!",
            "nextDialogs": [
              "4610510"
            ]
          },
          "4610510": {
            "id": "4610510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Now she's done it...)",
            "nextDialogs": [
              "4610511"
            ]
          },
          "4610511": {
            "id": "4610511",
            "speakerId": 1003,
            "speakerName": "Stanley",
            "text": "Treasure...? Even Tales too?",
            "nextDialogs": [
              "4610512"
            ]
          },
          "4610512": {
            "id": "4610512",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmph! It's a waste of time talking to him. Let's go already."
          }
        }
      }
    },
    {
      "subId": "46106",
      "subQuestName": "Talk",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4610612"
        ],
        "dialogs": {
          "4610612": {
            "id": "4610612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'd like to ask...",
            "nextDialogs": [
              "4610602"
            ]
          },
          "4610602": {
            "id": "4610602",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! Do you have any intel on the Arcadian Ruins?",
            "nextDialogs": [
              "4610603"
            ]
          },
          "4610603": {
            "id": "4610603",
            "speakerId": 1004,
            "speakerName": "Jack",
            "text": "Arcadian... Can't say I've heard of it. Sorry, I'm still new here, so...",
            "nextDialogs": [
              "4610604"
            ]
          },
          "4610604": {
            "id": "4610604",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Really...",
            "nextDialogs": [
              "4610605"
            ]
          },
          "4610605": {
            "id": "4610605",
            "speakerId": 1004,
            "speakerName": "Jack",
            "text": "But you can try posting a commission and see if there are any adventurers who know about it.",
            "nextDialogs": [
              "4610606"
            ]
          },
          "4610606": {
            "id": "4610606",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's a no-no! No way.",
            "nextDialogs": [
              "4610607"
            ]
          },
          "4610607": {
            "id": "4610607",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We can't afford them beating us to the treasure!",
            "nextDialogs": [
              "4610608"
            ]
          },
          "4610608": {
            "id": "4610608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Now she's done it...)",
            "nextDialogs": [
              "4610609"
            ]
          },
          "4610609": {
            "id": "4610609",
            "speakerId": 1004,
            "speakerName": "Jack",
            "text": "Really!?",
            "nextDialogs": [
              "4610610"
            ]
          },
          "4610610": {
            "id": "4610610",
            "speakerId": 1004,
            "speakerName": "Jack",
            "text": "Well then, I'll keep a lookout for your treasure — I mean, your Arcadian Ruins.",
            "nextDialogs": [
              "4610611"
            ]
          },
          "4610611": {
            "id": "4610611",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Great! Thanks!"
          }
        }
      }
    },
    {
      "subId": "46107",
      "subQuestName": "Report to Kaeya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4610801"
        ],
        "dialogs": {
          "4610801": {
            "id": "4610801",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "Oh, you're back. Do you have news for me?",
            "nextDialogs": [
              "4610802"
            ]
          },
          "4610802": {
            "id": "4610802",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Listen, we asked around the Adventurers' Guild and found... Well, nothing.",
            "nextDialogs": [
              "4610803"
            ]
          },
          "4610803": {
            "id": "4610803",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "Haha... That much is expected.",
            "nextDialogs": [
              "4610804"
            ]
          },
          "4610804": {
            "id": "4610804",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why is that?",
            "nextDialogs": [
              "4610805"
            ]
          },
          "4610805": {
            "id": "4610805",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "Oh, I only mean that, what's the fun in finding it without the hard work?",
            "nextDialogs": [
              "4610806"
            ]
          },
          "4610806": {
            "id": "4610806",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "However, I do have some clues.",
            "nextDialogs": [
              "4610807"
            ]
          },
          "4610807": {
            "id": "4610807",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "I sent someone to collate black market intel. It seems that someone does know about the Arcadian Ruins.",
            "nextDialogs": [
              "4610808"
            ]
          },
          "4610808": {
            "id": "4610808",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Really? Where's the guy?",
            "nextDialogs": [
              "4610809"
            ]
          },
          "4610809": {
            "id": "4610809",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "Now, now, as per the black market's rules, they will send someone to meet us to prevent leaks.",
            "nextDialogs": [
              "4610810"
            ]
          },
          "4610810": {
            "id": "4610810",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "We will be meeting the informant at the Whispering Woods.",
            "nextDialogs": [
              "4610811"
            ]
          },
          "4610811": {
            "id": "4610811",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Then, what are we waiting here for?",
            "nextDialogs": [
              "4610813"
            ]
          },
          "4610813": {
            "id": "4610813",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "That's right. You read my mind.",
            "nextDialogs": [
              "4610814"
            ]
          },
          "4610814": {
            "id": "4610814",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "I am a knight... so I shouldn't have any dealings with the black market.",
            "nextDialogs": [
              "4610816"
            ]
          },
          "4610816": {
            "id": "4610816",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "You have my thanks.",
            "nextDialogs": [
              "4610817"
            ]
          },
          "4610817": {
            "id": "4610817",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "Of course, you'll be compensated for your troubles... by the Knights.",
            "nextDialogs": [
              "4610818"
            ]
          },
          "4610818": {
            "id": "4610818",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ooh, no problemo!"
          }
        }
      }
    },
    {
      "subId": "46109",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4610901"
        ],
        "dialogs": {

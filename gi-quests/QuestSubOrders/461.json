  "subQuests": [
    {
      "subId": "46101",
      "subQuestName": "Talk to Kaeya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4610101"
        ],
        "dialogs": {
          "4610101": {
            "id": "4610101",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "This is bad... Such a hassle... What am I going to do...",
            "nextDialogs": [
              "4610104"
            ]
          },
          "4610104": {
            "id": "4610104",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "#Oh, thank the Thousand Winds! {NICKNAME}, your arrival must be the grace of the gods!",
            "nextDialogs": [
              "4610105"
            ]
          },
          "4610105": {
            "id": "4610105",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "If I may ask — envoy sent by the Anemo God to save this mere mortal — could you spare a moment?",
            "nextDialogs": [
              "4610106"
            ]
          },
          "4610106": {
            "id": "4610106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ewwww, cut it out!"
          }
        }
      }
    },
    {
      "subId": "46110",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4611001"
        ],
        "dialogs": {
          "4611001": {
            "id": "4611001",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Help... Help!"
          }
        }
      }
    },
    {
      "subId": "46102",
      "subQuestName": "Talk to Kaeya at the meeting spot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4610201"
        ],
        "dialogs": {
          "4610201": {
            "id": "4610201",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "This place will do.",
            "nextDialogs": [
              "4610202"
            ]
          },
          "4610202": {
            "id": "4610202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Tell us what it's about already!",
            "nextDialogs": [
              "4610203"
            ]
          },
          "4610203": {
            "id": "4610203",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "How should I begin... Oh, right, let me tell you a secret first.",
            "nextDialogs": [
              "4610204"
            ]
          },
          "4610204": {
            "id": "4610204",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "It's a secret of my past, and I confide in you to keep it.",
            "nextDialogs": [
              "4610205"
            ]
          },
          "4610205": {
            "id": "4610205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Don't worry, Paimon's lips are sealed.",
            "nextDialogs": [
              "4610206"
            ]
          },
          "4610206": {
            "id": "4610206",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "As a matter of fact, my grandfather was a pirate!",
            "nextDialogs": [
              "4610207"
            ]
          },
          "4610207": {
            "id": "4610207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh.",
            "nextDialogs": [
              "4610208"
            ]
          },
          "4610208": {
            "id": "4610208",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "...Wait, why do you sound so blithe? Do you think I'm making it up?",
            "nextDialogs": [
              "4610209"
            ]
          },
          "4610209": {
            "id": "4610209",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "Look at my eye patch! I inherited it from my grandfather and this is solid proof that we are related by blood!",
            "nextDialogs": [
              "4610211"
            ]
          },
          "4610211": {
            "id": "4610211",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "#My! {NICKNAME}, how could you not know such common knowledge!",
            "nextDialogs": [
              "4610212"
            ]
          },
          "4610212": {
            "id": "4610212",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "This is no different from children inheriting their hairstyles from their parents!",
            "nextDialogs": [
              "4610214"
            ]
          },
          "4610214": {
            "id": "4610214",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "Yesterday I was glancing through the notes my grandfather left and stumbled upon records that spoke of a <color=#00E1FFFF>treasure</color>...",
            "nextDialogs": [
              "4610215"
            ]
          },
          "4610215": {
            "id": "4610215",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...Treasure!?",
            "nextDialogs": [
              "4610216"
            ]
          },
          "4610216": {
            "id": "4610216",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "According to his notes, the treasure is buried in the \"Lost Arcadian Ruins.\"",
            "nextDialogs": [
              "4610217"
            ]
          },
          "4610217": {
            "id": "4610217",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Treasure...",
            "nextDialogs": [
              "4610218"
            ]
          },
          "4610218": {
            "id": "4610218",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "But the location of the ruins is currently unknown. I've tried searching for clues...",
            "nextDialogs": [
              "4610219"
            ]
          },
          "4610219": {
            "id": "4610219",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Treasure!",
            "nextDialogs": [
              "4610220"
            ]
          },
          "4610220": {
            "id": "4610220",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Kaeya! What kind of treasure is it? Gold? Or better yet, gems!?",
            "nextDialogs": [
              "4610221"
            ]
          },
          "4610221": {
            "id": "4610221",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "Hmph! Treasures that consist of nothing but gold and gems are third-rate treasures...",
            "nextDialogs": [
              "4610222"
            ]
          },
          "4610222": {
            "id": "4610222",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "My grandfather's treasure is a sword!",
            "nextDialogs": [
              "4610223"
            ]
          },
          "4610223": {
            "id": "4610223",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "A magic sword that grants the wielder unrivaled power!",
            "nextDialogs": [
              "4610224"
            ]
          },
          "4610224": {
            "id": "4610224",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh wowwwww!",
            "nextDialogs": [
              "4610225"
            ]
          },
          "4610225": {
            "id": "4610225",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "The sword was dropped from Celestia into the sea by a god. It was later salvaged by my grandfather's crew by pure coincidence.",
            "nextDialogs": [
              "4610226"
            ]
          },
          "4610226": {
            "id": "4610226",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "The moment he gripped the sword, thunder roared, billows howled, and the clear skies were suddenly swallowed by raging winds...",
            "nextDialogs": [
              "4610227"
            ]
          },
          "4610227": {
            "id": "4610227",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "With the might of the magic sword, my grandfather went on to defeat a hydra, a silver-haired banshee, a wicked abyss dragon...",
            "nextDialogs": [
              "4610228"
            ]
          },
          "4610228": {
            "id": "4610228",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "But the immense power of the sword enticed many more greedy pirates.",
            "nextDialogs": [
              "4610229"
            ]
          },
          "4610229": {
            "id": "4610229",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "To avoid meaningless conflicts, my grandfather hid the magic sword."
          }
        }
      }
    },
    {

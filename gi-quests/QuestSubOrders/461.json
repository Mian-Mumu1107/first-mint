    {
      "subId": "46103",
      "subQuestName": "Go to the Adventurers' Guild and listen to their report",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4610404"
        ],
        "dialogs": {
          "4610404": {
            "id": "4610404",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmph! We're not here for something that boring!",
            "nextDialogs": [
              "4610405"
            ]
          },
          "4610405": {
            "id": "4610405",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We're looking for a sword that fell from Celestia... One that can kill eight-headed banshees and silver-haired hydras.",
            "nextDialogs": [
              "4610406"
            ]
          },
          "4610406": {
            "id": "4610406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's super, mega, uber powerful!",
            "nextDialogs": [
              "4610408",
              "4610411"
            ]
          },
          "4610408": {
            "id": "4610408",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's what Paimon said! It's a super epic sword!",
            "nextDialogs": [
              "4610409"
            ]
          },
          "4610409": {
            "id": "4610409",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Anyway, it's fine as long as Paimon doesn't tell them the treasure's location!",
            "nextDialogs": [
              "4610413"
            ]
          },
          "4610413": {
            "id": "4610413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Now she's done it...)",
            "nextDialogs": [
              "4610414"
            ]
          },
          "4610414": {
            "id": "4610414",
            "speakerId": 1002,
            "speakerName": "Cyrus",
            "text": "Arcadian Ruins... Never heard of them.",
            "nextDialogs": [
              "4610415"
            ]
          },
          "4610415": {
            "id": "4610415",
            "speakerId": 1002,
            "speakerName": "Cyrus",
            "text": "Thanks for your intel anyway. If you do find these ruins, I'd love to see them.",
            "nextDialogs": [
              "4610416"
            ]
          },
          "4610416": {
            "id": "4610416",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh... my... intel...?"
          },
          "4610411": {
            "id": "4610411",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's fine! As long as Paimon doesn't tell them the treasure's location!",
            "nextDialogs": [
              "4610412"
            ]
          },
          "4610412": {
            "id": "4610412",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So, Cyrus, do you know where the Lost Arcadian Ruins are supposed to be?"
          }
        }
      }
    },
    {
      "subId": "46104",

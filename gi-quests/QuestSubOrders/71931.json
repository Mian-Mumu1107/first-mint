        "dialogs": {
          "719310101": {
            "id": "719310101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How are your travels through Liyue going?",
            "nextDialogs": [
              "719310102"
            ]
          },
          "719310102": {
            "id": "719310102",
            "speakerId": 1612,
            "speakerName": "Soraya",
            "text": "Great! The ruins and history are fascinating, as are the local customs.",
            "nextDialogs": [
              "719310103"
            ]
          },
          "719310103": {
            "id": "719310103",
            "speakerId": 1612,
            "speakerName": "Soraya",
            "text": "I mean, a lot of local customs are also derived from history. I've learned a lot just from studying them.",
            "nextDialogs": [
              "719310104"
            ]
          },
          "719310104": {
            "id": "719310104",
            "speakerId": 1612,
            "speakerName": "Soraya",
            "text": "Take, for example, this particular record of Liyue wedding customs, which was written about in Customs of Liyue: Flower Ball by a scholar from Sumeru.",
            "nextDialogs": [
              "719310105"
            ]
          },
          "719310105": {
            "id": "719310105",
            "speakerId": 1612,
            "speakerName": "Soraya",
            "text": "If it interests you, do take it and have a look. It's very fascinating indeed."
          }
        }
      }
    }

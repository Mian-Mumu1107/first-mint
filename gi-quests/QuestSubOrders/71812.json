              "718120208"
            ]
          },
          "718120208": {
            "id": "718120208",
            "speakerId": 1000,
            "speakerName": "Lan",
            "text": "I'll arrange for someone to head over to Dunyu Ruins to conduct a more thorough search.",
            "nextDialogs": [
              "718120209"
            ]
          },
          "718120209": {
            "id": "718120209",
            "speakerId": 1000,
            "speakerName": "Lan",
            "text": "So strange... The Dunyu Ruins area has been combed countless times... How did we miss this?"
          }
        }
      }

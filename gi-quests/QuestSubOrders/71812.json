            ]
          },
          "718120207": {
            "id": "718120207",
            "speakerId": 1000,
            "speakerName": "Lan",
            "text": "Thank you for getting to the bottom of this for us. As per the adventurers' code, this item is all yours now. Along with your reward, of course.",

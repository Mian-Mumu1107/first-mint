  "subQuests": [
    {
      "subId": "7618401",
      "subQuestName": "Head to a high vantage point in the Kuuvahki Experimental Design Bureau to start the tea party",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761840101"
        ],
        "dialogs": {
          "761840101": {
            "id": "761840101",
            "speakerId": 10200,
            "speakerName": "Childe",
            "text": "Well, this is one for the books. Never thought I'd see the day when you'd invite me to one of your tea parties, Sandrone.",
            "nextDialogs": [
              "761840102"
            ]
          },
          "761840102": {
            "id": "761840102",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Perhaps if you'd worked on your etiquette, I would have invited you over sooner.",
            "nextDialogs": [
              "761840103"
            ]
          },
          "761840103": {
            "id": "761840103",
            "speakerId": 1080,
            "speakerName": "The Knave",
            "text": "I agree. It might also help your case if you stopped challenging people to duels all the time.",
            "nextDialogs": [
              "761840104"
            ]
          },
          "761840104": {
            "id": "761840104",
            "speakerId": 10200,
            "speakerName": "Childe",
            "text": "Heh. You sound exactly like my big brothers and sisters. I can't help it. Back when my master was training me in the wild, etiquette wasn't exactly a priority.",
            "nextDialogs": [
              "761840105"
            ]
          },
          "761840105": {
            "id": "761840105",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Forget it. It's not often we manage to get together. Let's just relax and enjoy the moment.",
            "nextDialogs": [
              "761840106"
            ]
          },
          "761840106": {
            "id": "761840106",
            "speakerId": 10200,
            "speakerName": "Childe",
            "text": "Hmm. Is this your latest creation?",
            "nextDialogs": [
              "761840107"
            ]
          },
          "761840107": {
            "id": "761840107",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Her name is Fagio. It stands for \"Facilitatrice Automatisee Generaliste Interactive et Omnitache.\"",
            "nextDialogs": [
              "761840108"
            ]
          },
          "761840108": {
            "id": "761840108",
            "speakerId": 10200,
            "speakerName": "Childe",
            "text": "Does this mean Pulonia is really beyond repair...? I'm sorry to hear that, Sandrone.",
            "nextDialogs": [
              "761840109"
            ]
          },
          "761840109": {
            "id": "761840109",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "It's fine, I...",
            "nextDialogs": [
              "761840110"
            ]
          },
          "761840110": {
            "id": "761840110",
            "speakerId": 10200,
            "speakerName": "Childe",
            "text": "...I'm sorry to hear that I'll never get the chance to fight him.",
            "nextDialogs": [
              "761840111"
            ]
          },
          "761840111": {
            "id": "761840111",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Of course you are...",
            "nextDialogs": [
              "761840112"
            ]
          },
          "761840112": {
            "id": "761840112",
            "speakerId": 10200,
            "speakerName": "Childe",
            "text": "Pulonia looked strong, but this \"Fagio\" on the other hand...",
            "nextDialogs": [
              "761840113"
            ]
          },
          "761840113": {
            "id": "761840113",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "...Were you about to say she looks weak?",
            "nextDialogs": [
              "761840114"
            ]
          },
          "761840114": {
            "id": "761840114",
            "speakerId": 10200,
            "speakerName": "Childe",
            "text": "Uhm... Haha, no, no. It's just that she doesn't look quite as strong as Pulonia.",
            "nextDialogs": [
              "761840115"
            ]
          },
          "761840115": {
            "id": "761840115",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Hmph. Pulonia was built for measurements and calculations. I was careful not to compromise his processing power when giving him combat capabilities.",
            "nextDialogs": [
              "761840116"
            ]
          },
          "761840116": {
            "id": "761840116",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "But Fagio doesn't need to process complex formulas. All of her computing power can be devoted to her combat module.",
            "nextDialogs": [
              "761840117"
            ]
          },
          "761840117": {
            "id": "761840117",
            "speakerId": 10200,
            "speakerName": "Childe",
            "text": "So... That means she's actually stronger than Pulonia? Is that even possible...?",
            "nextDialogs": [
              "761840118"
            ]
          },
          "761840118": {
            "id": "761840118",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "You really won't be satisfied without a demonstration, will you?",
            "nextDialogs": [
              "761840119"
            ]
          },
          "761840119": {
            "id": "761840119",
            "speakerId": 10200,
            "speakerName": "Childe",
            "text": "Just so we're clear, I'm not paying for any repairs if I break her.",
            "nextDialogs": [
              "761840120"
            ]
          },
          "761840120": {
            "id": "761840120",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "And I won't be paying your hospital bill.",
            "nextDialogs": [
              "761840121"
            ]
          },
          "761840121": {
            "id": "761840121",
            "speakerId": 1080,
            "speakerName": "The Knave",
            "text": "(*sigh*... I knew this would happen.)",
            "nextDialogs": [
              "761840122"
            ]
          },
          "761840122": {
            "id": "761840122",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "(*nom nom*...)"
          }
        }
      }
    },

        ],
        "dialogs": {
          "761840301": {
            "id": "761840301",
            "speakerId": 10200,
            "speakerName": "Childe",
            "text": "Not bad, these tea parties, all in all. If I'd known they were this much fun, I would've attended one sooner.",
            "nextDialogs": [
              "761840304"
            ]
          },
          "761840304": {
            "id": "761840304",
            "speakerId": 10200,
            "speakerName": "Childe",
            "text": "Alright, see you next time!"
          }

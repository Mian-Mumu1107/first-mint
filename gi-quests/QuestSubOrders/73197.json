            "id": "731970101",
            "speakerId": 1000,
            "speakerName": "Bimarstan's Proverb Column",
            "text": "This is the Proverb Column that holds the dicta of the Akademiya's previous researchers. Only by following the steps of our trail-blazing pioneers may we behold the light of wisdom.",
            "nextDialogs": [
              "731970102"
            ]
          },
          "731970102": {
            "id": "731970102",
            "speakerId": 1000,
            "speakerName": "Bimarstan's Proverb Column",
            "text": "As the old saying goes, \"There is nothing new under the sun.\""
          }
        }
      }
    },
    {

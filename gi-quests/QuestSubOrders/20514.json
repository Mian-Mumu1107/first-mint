  },
  "subQuests": [
    {
      "subId": "2051401",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140101"
        ],
        "dialogs": {
          "205140101": {
            "id": "205140101",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "How did this happen...",
            "nextDialogs": [
              "205140102"
            ]
          },
          "205140102": {
            "id": "205140102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "205140103"
            ]
          },
          "205140103": {
            "id": "205140103",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Oh, it's you. Just in time, too. Anna's been getting better ever since eating the medicine prescribed by that doctor.",
            "nextDialogs": [
              "205140104"
            ]
          },
          "205140104": {
            "id": "205140104",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "When she wasn't well, she needed a lot of rest, and so spent a lot of time convalescing at home.",
            "nextDialogs": [
              "205140105"
            ]
          },
          "205140105": {
            "id": "205140105",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Now that she's better, she's started pestering me every day to go out at play, and I couldn't refuse her.",
            "nextDialogs": [
              "205140106"
            ]
          },
          "205140106": {
            "id": "205140106",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "But now, I absolutely cannot find her. I have no idea where she's gone. Please help me find her!",
            "nextDialogs": [
              "205140108",
              "205140111",
              "205140114"
            ]
          },
          "205140108": {
            "id": "205140108",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "I'll be waiting here. Please hurry.",
            "nextDialogs": [
              "205140109"
            ]
          },
          "205140109": {
            "id": "205140109",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "She just got better, and now she's scampering about. What will we do if something happens to her...?",
            "nextDialogs": [
              "205140116"
            ]
          },
          "205140116": {
            "id": "205140116",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "I've already been searching for quite a while. I haven't looked in the vicinity of the Adventurers' Guild yet, but I'm just beat at this point...",
            "nextDialogs": [
              "205140117"
            ]
          },
          "205140117": {
            "id": "205140117",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "You should start your search over there. Who knows, maybe Cyrus has noticed something...",
            "nextDialogs": [
              "205140118"
            ]
          },
          "205140118": {
            "id": "205140118",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "I hope you find her, or I'll have to go out again..."
          },
          "205140111": {
            "id": "205140111",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Happy? This is no laughing matter. She's only gotten a little better, and now she's flying about like a kite!",
            "nextDialogs": [
              "205140112"
            ]
          },
          "205140112": {
            "id": "205140112",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "When she gets back, I'll give her what for."
          },
          "205140114": {
            "id": "205140114",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Are you taking my sister for some sort of cat? And she's only just recovered. How can we let her go hungry?",
            "nextDialogs": [
              "205140115"
            ]
          },
          "205140115": {
            "id": "205140115",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Alright, alright. Please help me find her, I'll be waiting for you here."
          }
        }
      }
    },
    {
      "subId": "2051402",
      "subQuestName": "Find Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140201"
        ],
        "dialogs": {
          "205140201": {
            "id": "205140201",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "I'm so high up! My brother will never find me here!",
            "nextDialogs": [
              "205140202"
            ]
          },
          "205140202": {
            "id": "205140202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing here...",
            "nextDialogs": [
              "205140203"
            ]
          },
          "205140203": {
            "id": "205140203",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "Wah! How'd you get up here, and without a sound, too!",
            "nextDialogs": [
              "205140204"
            ]
          },
          "205140204": {
            "id": "205140204",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "No, wait. How did you even find me?",
            "nextDialogs": [
              "205140205"
            ]
          },
          "205140205": {
            "id": "205140205",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "Me? I just climbed up here.",
            "nextDialogs": [
              "205140206"
            ]
          },
          "205140206": {
            "id": "205140206",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "My brother's looking for me? Huh. It's been some time, hasn't it? I hadn't noticed.",
            "nextDialogs": [
              "205140207"
            ]
          },
          "205140207": {
            "id": "205140207",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "I got it. I'll go back soon. Just let me stay here for a while..."
          }
        }
      }
    },
    {
      "subId": "2051403",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140301"
        ],
        "dialogs": {
          "205140301": {
            "id": "205140301",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Have you found Anna?",
            "nextDialogs": [
              "205140302"
            ]
          },
          "205140302": {
            "id": "205140302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She's on top of a windmill.",
            "nextDialogs": [
              "205140303"
            ]
          },
          "205140303": {
            "id": "205140303",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "A windmill!? How did that girl get up there? I'm calling the Knights of Favonius right now!",
            "nextDialogs": [
              "205140304"
            ]
          },
          "205140304": {
            "id": "205140304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She said she'll be back soon.",
            "nextDialogs": [
              "205140305"
            ]
          },
          "205140305": {
            "id": "205140305",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "O—Oh. Is that so? Well, she's fine, and that's what matters. You scared me there for a moment! I thought she was stuck on top of a windmill.",
            "nextDialogs": [
              "205140306"
            ]
          },
          "205140306": {
            "id": "205140306",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Thank you, I'll go look for her now.",
            "nextDialogs": [
              "205140307"
            ]
          },
          "205140307": {
            "id": "205140307",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Running off like that when she's only just recovered... I have to teach her a lesson."
          }
        }
      }
    },
    {
      "subId": "2051404",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140401"
        ],
        "dialogs": {
          "205140401": {
            "id": "205140401",
            "speakerId": 1002,
            "speakerName": "Cyrus",
            "text": "Oh? You're here? That's unusual.",
            "nextDialogs": [
              "205140402"
            ]
          },
          "205140402": {
            "id": "205140402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you seen a certain girl?",
            "nextDialogs": [
              "205140403"
            ]
          },
          "205140403": {
            "id": "205140403",
            "speakerId": 1002,
            "speakerName": "Cyrus",
            "text": "A girl? Oh, you mean Anna? I did see her. She was heading for that windmill over there.",
            "nextDialogs": [
              "205140404"
            ]
          },
          "205140404": {
            "id": "205140404",
            "speakerId": 1002,
            "speakerName": "Cyrus",
            "text": "I'm still quite puzzled by it, myself. I thought she was unwell. Where did she suddenly get all that energy from?",
            "nextDialogs": [
              "205140405"
            ]
          },
          "205140405": {
            "id": "205140405",
            "speakerId": 1002,
            "speakerName": "Cyrus",
            "text": "She greeted me and just ran by.",
            "nextDialogs": [
              "205140406"
            ]
          },
          "205140406": {
            "id": "205140406",
            "speakerId": 1002,
            "speakerName": "Cyrus",
            "text": "That kid... Do you have any idea when she recovered from her illness?"
          }
        }
      }
    },
    {
      "subId": "2051405",
      "subQuestName": "Find Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140501"
        ],
        "dialogs": {
          "205140501": {
            "id": "205140501",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "I'm so high up! My brother will never find me here!",
            "nextDialogs": [
              "205140502"
            ]
          },
          "205140502": {
            "id": "205140502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing here...",
            "nextDialogs": [
              "205140503"
            ]
          },
          "205140503": {
            "id": "205140503",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "Whoa! How'd you get up here, and without a sound, too!",
            "nextDialogs": [
              "205140504"
            ]
          },
          "205140504": {
            "id": "205140504",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "Also, how did you even find me?",
            "nextDialogs": [
              "205140505"
            ]
          },
          "205140505": {
            "id": "205140505",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "Ah, I know. Mr. Cyrus must have told you.",
            "nextDialogs": [
              "205140506"
            ]
          },
          "205140506": {
            "id": "205140506",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "He's always taken care of my brother and I, and I greeted him as I was passing by. He looked so surprised, too!",
            "nextDialogs": [
              "205140507"
            ]
          },
          "205140507": {
            "id": "205140507",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "Maybe I should try out for the Adventurers' Guild and become an Adventurer. That might be nice!",
            "nextDialogs": [
              "205140508"
            ]
          },
          "205140508": {
            "id": "205140508",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "What? My brother's looking for me? Huh. It's been some time, hasn't it? I hadn't noticed at all!",
            "nextDialogs": [
              "205140509"
            ]
          },
          "205140509": {
            "id": "205140509",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "I got it. Just let me stay here for a while, I'll go back myself."
          }
        }
      }
    },
    {
      "subId": "2051406",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140601"
        ],
        "dialogs": {
          "205140601": {
            "id": "205140601",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Have you found Anna yet?",
            "nextDialogs": [
              "205140602"
            ]
          },
          "205140602": {
            "id": "205140602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She's on top of a windmill.",
            "nextDialogs": [
              "205140603"
            ]
          },
          "205140603": {
            "id": "205140603",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "A windmill!? How did that girl get up there? I'm going up there right now...",
            "nextDialogs": [
              "205140604"
            ]
          },
          "205140604": {
            "id": "205140604",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "What? She wants to try becoming an adventurer?",
            "nextDialogs": [
              "205140605"
            ]
          },
          "205140605": {
            "id": "205140605",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "She's getting ahead of herself, she hasn't even fully recovered yet!",
            "nextDialogs": [
              "205140606"
            ]
          },
          "205140606": {
            "id": "205140606",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Don't get me wrong. Once she's well, I don't have any problems with her going out to see the world.",
            "nextDialogs": [
              "205140607"
            ]
          },
          "205140607": {
            "id": "205140607",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Thanks, I'll go look for her. Running off like that when she's only just recovered... I have to teach her a lesson."
          }
        }
      }
    },
    {
      "subId": "2051407",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140701"
        ],
        "dialogs": {
          "205140701": {
            "id": "205140701",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Once I find Anna, I'll have to teach her a lesson."
          }
        }
      }
    },
    {
      "subId": "2051408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140801"
        ],
        "dialogs": {
          "205140801": {
            "id": "205140801",
            "speakerId": 1001,
            "speakerName": "Anna",
            "text": "The wind feels great here. I'd love to see how it feels in some faraway place."
          }
        }
      }
    },
    {
      "subId": "2051409",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205140901"
        ],
        "dialogs": {
          "205140901": {
            "id": "205140901",
            "speakerId": 1002,
            "speakerName": "Cyrus",
            "text": "It seems like that kid has recovered from her illness."
          }
        }
      }
    }
  ]
}
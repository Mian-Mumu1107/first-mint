    {
      "subId": "7620702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762070201"
        ],
        "dialogs": {
          "762070201": {
            "id": "762070201",
            "speakerId": 7682,
            "speakerName": "Tosalis",
            "text": "Ah... I was once language itself. Now, I am reduced to a shattered subject of illusion, returning once more to this imperfect \"symbol.\"",
            "nextDialogs": [
              "762070202"
            ]
          },
          "762070202": {
            "id": "762070202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eek! A weirdo saying weird things just popped out of a weird book!",
            "nextDialogs": [
              "762070203"
            ]
          },
          "762070203": {
            "id": "762070203",
            "speakerId": 7682,
            "speakerName": "Tosalis",
            "text": "\"Weird\" is an imprecise term. It implies a unique entity that cannot be described, written, or characterized. I clearly do not fit that definition.",
            "nextDialogs": [
              "762070204"
            ]
          },
          "762070204": {
            "id": "762070204",
            "speakerId": 7682,
            "speakerName": "Tosalis",
            "text": "I was merely attempting to find an entry point to \"reality\" within these pages, only to slip into an inadvertent, infinite deferral of metaphors...",
            "nextDialogs": [
              "762070205"
            ]
          },
          "762070205": {
            "id": "762070205",
            "speakerId": 7682,
            "speakerName": "Tosalis",
            "text": "I have become a remainder that defies symbolization. It is thanks to your intervention that the tyranny of language has been stripped from me. Now, I can finally begin to misrecognize myself once more...",
            "nextDialogs": [
              "762070206"
            ]
          },
          "762070206": {
            "id": "762070206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "In the common tongue, please.",
            "nextDialogs": [
              "762070207"
            ]
          },
          "762070207": {
            "id": "762070207",
            "speakerId": 7682,
            "speakerName": "Tosalis",
            "text": "...I accidentally tumbled into the pages and got stuck. Thank you for pulling me out."
          }
        }
      }
    }
  ]
}
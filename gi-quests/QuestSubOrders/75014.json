    {
      "subId": "7501412",
      "subQuestName": "Go to the camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750141201"
        ],
        "dialogs": {
          "750141201": {
            "id": "750141201",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "Huh? Are you lost, little one?",
            "nextDialogs": [
              "750141202"
            ]
          },
          "750141202": {
            "id": "750141202",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr! Raaaawr!",
            "nextDialogs": [
              "750141203"
            ]
          },
          "750141203": {
            "id": "750141203",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "How energetic! You look healthy. And there's a special pattern on your horn... Not bad.",
            "nextDialogs": [
              "750141204"
            ]
          },
          "750141204": {
            "id": "750141204",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "Still, why did you all come here together? Did I do a bad job of teaching? That can't be, right?",
            "nextDialogs": [
              "750141205"
            ]
          },
          "750141205": {
            "id": "750141205",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rooh? Rawrrr!",
            "nextDialogs": [
              "750141206"
            ]
          },
          "750141206": {
            "id": "750141206",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "Huh? What's wrong with it? Did it bring you here?",
            "nextDialogs": [
              "750141207"
            ]
          },
          "750141207": {
            "id": "750141207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(I can't let her notice me...)",
            "nextDialogs": [
              "750141210"
            ]
          },
          "750141210": {
            "id": "750141210",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "Why are you making such weird sounds? Are you sick? You seem to be acting strange too. We might need to get you checked out properly.",
            "nextDialogs": [
              "750141211"
            ]
          },
          "750141211": {
            "id": "750141211",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750141212"
            ]
          },
          "750141212": {
            "id": "750141212",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "Don't be impatient, little one. It'll be your turn soon.",
            "nextDialogs": [
              "750141221"
            ]
          },
          "750141221": {
            "id": "750141221",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "You're up first. Follow me. Do you understand?"
          }
        }
      }
    },

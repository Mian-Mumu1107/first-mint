    {
      "subId": "7501408",
      "subQuestName": "Eavesdrop on the secret meeting without being noticed",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750140801"
        ],
        "dialogs": {
          "750140801": {
            "id": "750140801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(Hmm... Paimon can't see clearly from here, but they might spot us if we get closer. It's better to listen from where we are for now.)",
            "nextDialogs": [
              "750140802"
            ]
          },
          "750140802": {
            "id": "750140802",
            "speakerId": 1651,
            "speakerName": "Gentle Voice",
            "text": "We're really happy with the quality of the last batch of goods. We'll be counting on you again this time.",
            "nextDialogs": [
              "750140803"
            ]
          },
          "750140803": {
            "id": "750140803",
            "speakerId": 1006,
            "speakerName": "Deep Voice",
            "text": "Not a problem at all. Just follow the usual protocol?",
            "nextDialogs": [
              "750140804"
            ]
          },
          "750140804": {
            "id": "750140804",
            "speakerId": 1651,
            "speakerName": "Gentle Voice",
            "text": "Yes. We'll need the goods delivered before the air race. Someone's gonna need it.",
            "nextDialogs": [
              "750140805"
            ]
          },
          "750140805": {
            "id": "750140805",
            "speakerId": 1006,
            "speakerName": "Deep Voice",
            "text": "No problem. They should be just about done talking over there too, so let's wrap up and leave.",
            "nextDialogs": [
              "750140806"
            ]
          },
          "750140806": {
            "id": "750140806",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(Huh? Are they leaving already? That's not what Paimon imagined... Let's head back ourselves. Don't let them catch you!)"
          }
        }
      }
    },
    {
      "subId": "7501411",
      "subQuestName": "Don the perfect disguise and escape!",
      "sceneId": null,
      "locations": [],

    {
      "subId": "7001101",
      "subQuestName": "Talk to the hilichurl",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700110101"
        ],
        "dialogs": {
          "700110101": {
            "id": "700110101",
            "speakerId": 1000,
            "speakerName": "Cautious Hilichurl",
            "text": "Yaya dala! Kundala?",
            "nextDialogs": [
              "700110102"
            ]
          },
          "700110102": {
            "id": "700110102",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "Mimi nye odomu! Kundala nye!",
            "nextDialogs": [
              "700110103"
            ]
          },
          "700110103": {
            "id": "700110103",
            "speakerId": 1000,
            "speakerName": "Cautious Hilichurl",
            "text": "Nye Odomu? Yoyo mani mi?",
            "nextDialogs": [
              "700110104"
            ]
          },
          "700110104": {
            "id": "700110104",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "Mimi tomo, mimi plata odomu! Mimi mani ye!",
            "nextDialogs": [
              "700110105"
            ]
          },
          "700110105": {
            "id": "700110105",
            "speakerId": 1000,
            "speakerName": "Cautious Hilichurl",
            "text": "Mani...? Zido mi, mi dada. Nye kundala? Mi plata yeye!",
            "nextDialogs": [
              "700110106"
            ]
          },
          "700110106": {
            "id": "700110106",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Whew... This one's got a real bad temper...",
            "nextDialogs": [
              "700110109"
            ]
          },
          "700110109": {
            "id": "700110109",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "No, thank you. Everything's fine. I can understand.",
            "nextDialogs": [
              "700110110"
            ]
          },
          "700110110": {
            "id": "700110110",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "...Huh?",
            "nextDialogs": [
              "700110111"
            ]
          },
          "700110111": {
            "id": "700110111",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "It just wants us to help defeat an enemy. ...Here, on the Map.",
            "nextDialogs": [
              "700110113"
            ]
          },
          "700110113": {
            "id": "700110113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I see...",
            "nextDialogs": [
              "700110114"
            ]
          },
          "700110114": {
            "id": "700110114",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "Okay then, the location is marked on your Map — the rest is in your hands!",
            "nextDialogs": [
              "700110115"
            ]
          },
          "700110115": {
            "id": "700110115",
            "speakerId": 1000,
            "speakerName": "Cautious Hilichurl",
            "text": "Dada, Valo!"
          }
        }
      }
    },
    {

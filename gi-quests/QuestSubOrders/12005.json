    {
      "subId": "1200509",
      "subQuestName": "Talk to the ronin who snatched away the goods",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1200510",
      "subQuestName": "Defeat the ronin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120051001"
        ],
        "dialogs": {
          "120051001": {
            "id": "120051001",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "Excellent news! So, apart from the silk, I think everything else I need, I've got in store already...",
            "nextDialogs": [
              "120051002"
            ]
          },
          "120051002": {
            "id": "120051002",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "I just need to go and take stock of our materials — it won't take me a moment. I'll be right back.",
            "nextDialogs": [
              "120051003"
            ]
          },
          "120051003": {
            "id": "120051003",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "They'd better be all there!",
            "nextDialogs": [
              "120051004"
            ]
          },
          "120051004": {
            "id": "120051004",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "I do hope nothing else is missing.",
            "nextDialogs": [
              "120051005"
            ]
          },
          "120051005": {
            "id": "120051005",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Traveler, on the subject of garments, I've been meaning to acquire a new outfit for you, too.",
            "nextDialogs": [
              "120051006"
            ]
          },
          "120051006": {
            "id": "120051006",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "It's just... I wasn't sure how you'd feel about the idea of dressing in Inazuman attire...",
            "nextDialogs": [
              "120051007"
            ]
          },
          "120051007": {
            "id": "120051007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's a kind thought, but I'm fine with my current outfit.",
            "nextDialogs": [
              "120051008"
            ]
          },
          "120051008": {
            "id": "120051008",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Oh? Are you sure?",
            "nextDialogs": [
              "120051011"
            ]
          },
          "120051011": {
            "id": "120051011",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Is that so...",
            "nextDialogs": [
              "120051012"
            ]
          },
          "120051012": {
            "id": "120051012",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Impressive... So, travelers of your stature hold themselves to a dress code, as well as a code of conduct.",
            "nextDialogs": [
              "120051013"
            ]
          },
          "120051013": {
            "id": "120051013",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... More like, when you're away from home, you've gotta live by certain rules to survive, whether you like it or not.",
            "nextDialogs": [
              "120051014"
            ]
          },
          "120051014": {
            "id": "120051014",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But Paimon would still love to check out some Inazuman outfits!",
            "nextDialogs": [
              "120051015"
            ]
          },
          "120051015": {
            "id": "120051015",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do they do Paimon sizes here?",
            "nextDialogs": [
              "120051016"
            ]
          },
          "120051016": {
            "id": "120051016",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Just what is that supposed to mean? They make them in whatever size the customer asks for!",
            "nextDialogs": [
              "120051017"
            ]
          },
          "120051017": {
            "id": "120051017",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Hahaha, ah, your interactions are so adorable to watch... Ahem! I mean, um... I can certainly find someone to tailor a Paimon-sized outfit, if Paimon so wishes."
          }
        }
      }
    },

    "Ronin": 7
  },
  "subQuests": [
    {
      "subId": "1200501",
      "subQuestName": "Go to Ogura Textiles & Kimonos",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120050101"
        ],
        "dialogs": {
          "120050101": {
            "id": "120050101",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Hm? This must be...",
            "nextDialogs": [
              "120050102"
            ]
          },
          "120050102": {
            "id": "120050102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's a festival promotion.",
            "nextDialogs": [
              "120050103"
            ]
          },
          "120050103": {
            "id": "120050103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, speaking of — we haven't been anywhere fun since we arrived in Inazuma!",
            "nextDialogs": [
              "120050104"
            ]
          },
          "120050104": {
            "id": "120050104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did you want to go, Ayaka?",
            "nextDialogs": [
              "120050105"
            ]
          },
          "120050105": {
            "id": "120050105",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "N—No, what made you think that? Ahem... Festivals are a common occurrence here in Inazuma. We in the Yashiro Commission are very well acquainted with these sorts of customs.",
            "nextDialogs": [
              "120050106"
            ]
          },
          "120050106": {
            "id": "120050106",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Each season brings its own festival... and each festival, in turn, brings a fresh challenge to the task of maintaining public order...",
            "nextDialogs": [
              "120050107"
            ]
          },
          "120050107": {
            "id": "120050107",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "So, while festivals are undoubtedly joyous and lively occasions, for us they are also a cause for concern...",
            "nextDialogs": [
              "120050108"
            ]
          },
          "120050108": {
            "id": "120050108",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Oh! My apologies, I should stop thinking about work, this is hardly relevant to the matter at hand. This store here is the place I wanted to visit.",
            "nextDialogs": [
              "120050109"
            ]
          },
          "120050109": {
            "id": "120050109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, so you weren't checking out the promotion... Well, let's take a look inside then.",
            "nextDialogs": [
              "120050110"
            ]
          },
          "120050110": {
            "id": "120050110",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "Welcome, I have all the latest styles. Please take a look!",
            "nextDialogs": [
              "120050111"
            ]
          },
          "120050111": {
            "id": "120050111",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "Oh! It's Miss Kamisato — with guests from overseas! Welcome to Ogura Textiles & Kimonos. Are you here to purchase fabric, or for tailored garments?",
            "nextDialogs": [
              "120050112"
            ]
          },
          "120050112": {
            "id": "120050112",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Oh! Greetings to you too. I have a design here for a garment, would you be so kind as to take a look?",
            "nextDialogs": [
              "120050113"
            ]
          },
          "120050113": {
            "id": "120050113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ohh, Ayaka came prepared!",
            "nextDialogs": [
              "120050114"
            ]
          },
          "120050114": {
            "id": "120050114",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "Let me see... Hmm? Hmm, this could be...",
            "nextDialogs": [
              "120050115"
            ]
          },
          "120050115": {
            "id": "120050115",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Mm-hmm? Could be...?",
            "nextDialogs": [
              "120050116"
            ]
          },
          "120050116": {
            "id": "120050116",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "—Oh, it's a very fine design!",
            "nextDialogs": [
              "120050117"
            ]
          },
          "120050117": {
            "id": "120050117",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "...Miss Kamisato — you'd like us to make a kimono following this design, yes?",
            "nextDialogs": [
              "120050118"
            ]
          },
          "120050118": {
            "id": "120050118",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Please, if you could.",
            "nextDialogs": [
              "120050119"
            ]
          },
          "120050119": {
            "id": "120050119",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "I'm honored that you'd choose Ogura Textiles & Kimonos for your tailoring needs! However... there is one rather difficult problem...",
            "nextDialogs": [
              "120050120"
            ]
          },
          "120050120": {
            "id": "120050120",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "Based on the design, this kind of kimono would require silk made from the Silk Flower. The majority of Inazuma's silk is imported from Liyue Harbor, but given the current climate...",
            "nextDialogs": [
              "120050121"
            ]
          },
          "120050121": {
            "id": "120050121",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "*sigh* As you well know, Inazuma is currently under a strict lockdown.",
            "nextDialogs": [
              "120050122"
            ]
          },
          "120050122": {
            "id": "120050122",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "In all honesty, the impact on the textiles industry has been quite significant. We're struggling to import high-grade fabrics, so much of our tailoring business has been put on hold indefinitely.",
            "nextDialogs": [
              "120050123"
            ]
          },
          "120050123": {
            "id": "120050123",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "But of course, where our customers are able to provide the fabric themselves, we can still be of service.",
            "nextDialogs": [
              "120050124"
            ]
          },
          "120050124": {
            "id": "120050124",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "*sigh* So you're saying, we need to go and buy some silk first?",
            "nextDialogs": [
              "120050125"
            ]
          },
          "120050125": {
            "id": "120050125",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "If even Ogura Textiles & Kimonos can't get ahold of high-grade fabric... where would we buy it from?",
            "nextDialogs": [
              "120050126"
            ]
          },
          "120050126": {
            "id": "120050126",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "You could try the International Trade Association. They are a little better connected than we are — after all, the association brings together merchants from all over the world.",
            "nextDialogs": [
              "120050127"
            ]
          },
          "120050127": {
            "id": "120050127",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "The only thing is their prices... they're not the cheapest. In times like these, though, we're lucky to even have an option of getting hold of the things we want in the first place.",
            "nextDialogs": [
              "120050128"
            ]
          },
          "120050128": {
            "id": "120050128",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh, so even just getting clothes made is an ordeal in Inazuma...",
            "nextDialogs": [
              "120050129"
            ]
          },
          "120050129": {
            "id": "120050129",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, the International Trade Association? That's Kurisu's thing, right? We haven't been to Ritou in a while.",
            "nextDialogs": [
              "120050130"
            ]
          },
          "120050130": {
            "id": "120050130",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Hmm... It looks like that will be our next stop.",
            "nextDialogs": [
              "120050131"
            ]
          },
          "120050131": {
            "id": "120050131",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Thank you ever so much. We will be back once we've acquired the fabric.",
            "nextDialogs": [
              "120050132"
            ]
          },
          "120050132": {
            "id": "120050132",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "In the meantime, I have one other very small request. Could you...",
            "nextDialogs": [
              "120050133"
            ]
          },
          "120050133": {
            "id": "120050133",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why's she being so secretive all of a sudden?",
            "nextDialogs": [
              "120050134"
            ]
          },
          "120050134": {
            "id": "120050134",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "Mm-hmm... Absolutely.",
            "nextDialogs": [
              "120050135"
            ]
          },
          "120050135": {
            "id": "120050135",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Much obliged.",
            "nextDialogs": [
              "120050136"
            ]
          },
          "120050136": {
            "id": "120050136",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "My pleasure, Miss Kamisato.",
            "nextDialogs": [
              "120050137"
            ]
          },
          "120050137": {
            "id": "120050137",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "Honestly, I'm just as excited as you to see the end product! We haven't made a silk kimono for the longest time now, and this is a beautiful design...",
            "nextDialogs": [
              "120050138"
            ]
          },
          "120050138": {
            "id": "120050138",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "That's very kind of you, thank you. Goodbye for now.",
            "nextDialogs": [
              "120050139"
            ]
          },
          "120050139": {
            "id": "120050139",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Traveler, Paimon — let's try our luck at the International Trade Association."
          }
        }
      }
    },
    {
      "subId": "1200502",
      "subQuestName": "Talk to Kamisato Ayaka",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1200503",
      "subQuestName": "Go to the International Trade Association in Ritou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120050301"
        ],
        "dialogs": {
          "120050301": {
            "id": "120050301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Stop, thief!",
            "nextDialogs": [
              "120050302"
            ]
          },
          "120050302": {
            "id": "120050302",
            "speakerId": 1003,
            "speakerName": "Ronin",
            "text": "Hah! You think you can get your stuff back with this bunch? You must be dreaming.",
            "nextDialogs": [
              "120050303"
            ]
          },
          "120050303": {
            "id": "120050303",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Why you... You better hope you have the courage of your convictions...",
            "nextDialogs": [
              "120050304"
            ]
          },
          "120050304": {
            "id": "120050304",
            "speakerId": 1003,
            "speakerName": "Ronin",
            "text": "Why wouldn't I, old man? Answer me this — you're one of those outlander merchants, right?",
            "nextDialogs": [
              "120050305"
            ]
          },
          "120050305": {
            "id": "120050305",
            "speakerId": 1003,
            "speakerName": "Ronin",
            "text": "You trade association types are worms, coming over to our land, leeching off our people... Who's gonna leap to your defense, huh? Tell me, who's gonna stick their neck out for the likes of you?",
            "nextDialogs": [
              "120050306"
            ]
          },
          "120050306": {
            "id": "120050306",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "...",
            "nextDialogs": [
              "120050307"
            ]
          },
          "120050307": {
            "id": "120050307",
            "speakerId": 1003,
            "speakerName": "Ronin",
            "text": "Hahaha! Look at that, no response. You know I'm right.",
            "nextDialogs": [
              "120050308"
            ]
          },
          "120050308": {
            "id": "120050308",
            "speakerId": 1003,
            "speakerName": "Ronin",
            "text": "Face it. This is Inazuma, you've got no ties here, you're at the bottom of the pile... Can you really blame us for walking all over you?",
            "nextDialogs": [
              "120050309"
            ]
          },
          "120050309": {
            "id": "120050309",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "...You are despicable...",
            "nextDialogs": [
              "120050310"
            ]
          },
          "120050310": {
            "id": "120050310",
            "speakerId": 1003,
            "speakerName": "Ronin",
            "text": "Hey! I just had an idea. Since you came all this way — how about we do some business?",
            "nextDialogs": [
              "120050311"
            ]
          },
          "120050311": {
            "id": "120050311",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Business?",
            "nextDialogs": [
              "120050312"
            ]
          },
          "120050312": {
            "id": "120050312",
            "speakerId": 1003,
            "speakerName": "Ronin",
            "text": "Pay up, and you can take your fabric back. Sound good? If you ask me, it beats walking out of here with black eyes and a broken nose.",
            "nextDialogs": [
              "120050313"
            ]
          },
          "120050313": {
            "id": "120050313",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "*gasp* You're just a big bully!",
            "nextDialogs": [
              "120050314"
            ]
          },
          "120050314": {
            "id": "120050314",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "I... Ugh! What choice do I have...",
            "nextDialogs": [
              "120050315"
            ]
          },
          "120050315": {
            "id": "120050315",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Wait.",
            "nextDialogs": [
              "120050316"
            ]
          },
          "120050316": {
            "id": "120050316",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Mr. Kurisu, please do not pay any money to this man.",
            "nextDialogs": [
              "120050317"
            ]
          },
          "120050317": {
            "id": "120050317",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "But, but...",
            "nextDialogs": [
              "120050318"
            ]
          },
          "120050318": {
            "id": "120050318",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "I trust you remember our agreement? If you keep your lips firmly sealed, I, too, shall uphold my end of the deal.",
            "nextDialogs": [
              "120050319"
            ]
          },
          "120050319": {
            "id": "120050319",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Oh, yes, of course!",
            "nextDialogs": [
              "120050320"
            ]
          },
          "120050320": {
            "id": "120050320",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Then please stand well back, where it is safe. Now... it is time for me to honor my word."
          }
        }
      }
    },
    {
      "subId": "1200504",
      "subQuestName": "Check out the situation nearby",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120050401"
        ],
        "dialogs": {
          "120050401": {
            "id": "120050401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, that's that resolved then!",
            "nextDialogs": [
              "120050402"
            ]
          },
          "120050402": {
            "id": "120050402",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "...Phew.",
            "nextDialogs": [
              "120050405"
            ]
          },
          "120050405": {
            "id": "120050405",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "No, please, I... It was nothing, I was simply doing my duty.",
            "nextDialogs": [
              "120050406"
            ]
          },
          "120050406": {
            "id": "120050406",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Miss Kamisato, Traveler, a—are you hurt!?",
            "nextDialogs": [
              "120050407"
            ]
          },
          "120050407": {
            "id": "120050407",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Don't worry. We're fine.",
            "nextDialogs": [
              "120050408"
            ]
          },
          "120050408": {
            "id": "120050408",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "The vagrants left in quite a hurry — it would seem they didn't have time to take anything with them. I believe your stolen goods should all be here.",
            "nextDialogs": [
              "120050409"
            ]
          },
          "120050409": {
            "id": "120050409",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Th—Thank you, thank you so much...",
            "nextDialogs": [
              "120050410"
            ]
          },
          "120050410": {
            "id": "120050410",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "You'd best do a count.",
            "nextDialogs": [
              "120050411"
            ]
          },
          "120050411": {
            "id": "120050411",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "6, 8, 10... Yep, it's all here!",
            "nextDialogs": [
              "120050412"
            ]
          },
          "120050412": {
            "id": "120050412",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Great! Now we can finally buy some silk!",
            "nextDialogs": [
              "120050413"
            ]
          },
          "120050413": {
            "id": "120050413",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Buy silk? ...You mean, you need some of this silk, here?",
            "nextDialogs": [
              "120050414"
            ]
          },
          "120050414": {
            "id": "120050414",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "This was indeed our intent.",
            "nextDialogs": [
              "120050415"
            ]
          },
          "120050415": {
            "id": "120050415",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Don't get us wrong though, that's not the reason we helped you out! Even if it were just a few Carrots or Cabbages, chances are we still would've helped you get them back.",
            "nextDialogs": [
              "120050416"
            ]
          },
          "120050416": {
            "id": "120050416",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon thinks we were pretty lucky! If we'd arrived any later, our chances of getting silk in Inazuma would have been zero...",
            "nextDialogs": [
              "120050417"
            ]
          },
          "120050417": {
            "id": "120050417",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "I honestly can't thank you all enough...",
            "nextDialogs": [
              "120050418"
            ]
          },
          "120050418": {
            "id": "120050418",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Please, say no more! You need silk? I'll pick out a piece for you right away!",
            "nextDialogs": [
              "120050419"
            ]
          },
          "120050419": {
            "id": "120050419",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Thank you, good sir. How much do I owe you?",
            "nextDialogs": [
              "120050420"
            ]
          },
          "120050420": {
            "id": "120050420",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Oh, it's free of charge! I could never ask you to pay after everything you've done for me!",
            "nextDialogs": [
              "120050421"
            ]
          },
          "120050421": {
            "id": "120050421",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "No, no, that will never do. Things cost what they cost, and what they cost is what I shall pay.",
            "nextDialogs": [
              "120050422"
            ]
          },
          "120050422": {
            "id": "120050422",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Merchants already have enough challenges to deal with, and as Paimon explained, my help was unconditional. Please, sell your wares to me at the price you would sell them to any other customer.",
            "nextDialogs": [
              "120050423"
            ]
          },
          "120050423": {
            "id": "120050423",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "There is nothing to feel distressed about, because nothing, I repeat, nothing, happened here in these woods today. Did it?",
            "nextDialogs": [
              "120050424"
            ]
          },
          "120050424": {
            "id": "120050424",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Nope, just an uneventful stroll in the woods.",
            "nextDialogs": [
              "120050425"
            ]
          },
          "120050425": {
            "id": "120050425",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Thank you, I... I don't think I could ever repay you. You have helped me greatly, and I will never forget it.",
            "nextDialogs": [
              "120050426"
            ]
          },
          "120050426": {
            "id": "120050426",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "I'm afraid we must part ways — I must get these goods back to the Association. If you ever need anything at all, just come to the International Trade Association and ask for Kurisu!",
            "nextDialogs": [
              "120050427"
            ]
          },
          "120050427": {
            "id": "120050427",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Very well, and thank you for the silk, Mr. Kurisu.",
            "nextDialogs": [
              "120050428"
            ]
          },
          "120050428": {
            "id": "120050428",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "See ya then, bye! Safe journey home, don't go getting robbed again!",
            "nextDialogs": [
              "120050429"
            ]
          },
          "120050429": {
            "id": "120050429",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Traveler, thank you for stepping in to help out."
          }
        }
      }
    },
    {
      "subId": "1200506",
      "subQuestName": "Talk to Kurisu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120050201"
        ],
        "dialogs": {
          "120050201": {
            "id": "120050201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Look, look! There he is!",
            "nextDialogs": [
              "120050202"
            ]
          },
          "120050202": {
            "id": "120050202",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Ah, looks like we found him.",
            "nextDialogs": [
              "120050203"
            ]
          },
          "120050203": {
            "id": "120050203",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "*whimpering* What am I going to do...",
            "nextDialogs": [
              "120050204"
            ]
          },
          "120050204": {
            "id": "120050204",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Mr. Kurisu, are you alright?",
            "nextDialogs": [
              "120050205"
            ]
          },
          "120050205": {
            "id": "120050205",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Oh! You're M—Miss Ayaka from the K—Kamisato Clan. How do you do?",
            "nextDialogs": [
              "120050206"
            ]
          },
          "120050206": {
            "id": "120050206",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Better than you, it appears.",
            "nextDialogs": [
              "120050207"
            ]
          },
          "120050207": {
            "id": "120050207",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "And if it isn't the Traveler... I haven't seen you in a while — I take it you've been out of Ritou?",
            "nextDialogs": [
              "120050208"
            ]
          },
          "120050208": {
            "id": "120050208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It sure has been a bit.",
            "nextDialogs": [
              "120050209"
            ]
          },
          "120050209": {
            "id": "120050209",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Thanks again for your help last time. The Association is back in business, and it's all thanks to you.",
            "nextDialogs": [
              "120050210"
            ]
          },
          "120050210": {
            "id": "120050210",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's great, but uh... Why were you staring into space just now? Did something bad happen?",
            "nextDialogs": [
              "120050211"
            ]
          },
          "120050211": {
            "id": "120050211",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Well... You see... *sigh*",
            "nextDialogs": [
              "120050212"
            ]
          },
          "120050212": {
            "id": "120050212",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "It's embarrassing to admit, but some of the Association's goods have been... stolen. By vagrants.",
            "nextDialogs": [
              "120050213"
            ]
          },
          "120050213": {
            "id": "120050213",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Which goods were stolen?",
            "nextDialogs": [
              "120050214"
            ]
          },
          "120050214": {
            "id": "120050214",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "It was a batch of high-grade silk.",
            "nextDialogs": [
              "120050215"
            ]
          },
          "120050215": {
            "id": "120050215",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "...!",
            "nextDialogs": [
              "120050216"
            ]
          },
          "120050216": {
            "id": "120050216",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "We imported a big batch of silk from Liyue several years ago. It's been sitting in storage ever since.",
            "nextDialogs": [
              "120050217"
            ]
          },
          "120050217": {
            "id": "120050217",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Recently, we heard that clothing stores in the city have more or less sold off all their silk stocks. So we figured now would be a good time to bring our batch out of storage, thinking it'd probably fetch a good price. But then...",
            "nextDialogs": [
              "120050218"
            ]
          },
          "120050218": {
            "id": "120050218",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "The vagrants swiped the whole batch then disappeared into the woods. I'd report it to the authorities, but...",
            "nextDialogs": [
              "120050219"
            ]
          },
          "120050219": {
            "id": "120050219",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Well, as you know, they don't think much of foreign merchants like us. The Kanjou Commission don't want to give us the time of day — honestly, you can just tell that our suffering amuses them...",
            "nextDialogs": [
              "120050220"
            ]
          },
          "120050220": {
            "id": "120050220",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "While I also take issue with aspects of the Kanjou Commission's operational methods, please remember, Mr. Kurisu, that while you are here in Inazuma, you should be careful with your words.",
            "nextDialogs": [
              "120050221"
            ]
          },
          "120050221": {
            "id": "120050221",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Oh! M—My apologies... I had to let off some steam...",
            "nextDialogs": [
              "120050222"
            ]
          },
          "120050222": {
            "id": "120050222",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Anyway, there doesn't seem to be much we can do ourselves to get our goods back.",
            "nextDialogs": [
              "120050223"
            ]
          },
          "120050223": {
            "id": "120050223",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "*sigh* Perhaps I'm doomed to go bankrupt after all...",
            "nextDialogs": [
              "120050224"
            ]
          },
          "120050224": {
            "id": "120050224",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "I'm afraid I can't intervene in an official capacity... but I can still help you get your lost goods back.",
            "nextDialogs": [
              "120050225"
            ]
          },
          "120050225": {
            "id": "120050225",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Of course, I would never— Wait, what!?",
            "nextDialogs": [
              "120050226"
            ]
          },
          "120050226": {
            "id": "120050226",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What!?",
            "nextDialogs": [
              "120050227"
            ]
          },
          "120050227": {
            "id": "120050227",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Seriously?",
            "nextDialogs": [
              "120050228"
            ]
          },
          "120050228": {
            "id": "120050228",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Yes. Acting in my own capacity, mind you. Even then, there is no escaping the fact that my every action and word will be seen to reflect on the Yashiro Commission and the Kamisato Clan.",
            "nextDialogs": [
              "120050229"
            ]
          },
          "120050229": {
            "id": "120050229",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "I do so not without reservations, so... I hope that you will treat this matter as confidential.",
            "nextDialogs": [
              "120050230"
            ]
          },
          "120050230": {
            "id": "120050230",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "That aside — as I'm sure you're aware, I'm afraid that I won't always be able to help you in such circumstances.",
            "nextDialogs": [
              "120050231"
            ]
          },
          "120050231": {
            "id": "120050231",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Given your position and that of the International Trade Association... please try to exercise more caution in the future. You do not want to incur further unnecessary losses.",
            "nextDialogs": [
              "120050232"
            ]
          },
          "120050232": {
            "id": "120050232",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "We will, we certainly will!",
            "nextDialogs": [
              "120050233"
            ]
          },
          "120050233": {
            "id": "120050233",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "But, um... are you sure this isn't going to cause any issues... for you?",
            "nextDialogs": [
              "120050234"
            ]
          },
          "120050234": {
            "id": "120050234",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "What if someone high up in the Kanjou Commission sees what you're doing and doesn't like it? You're a highly respected member of society... Surely, putting your neck on the line for small-timers like me can't be worth the risk!?",
            "nextDialogs": [
              "120050235"
            ]
          },
          "120050235": {
            "id": "120050235",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Very humorous.",
            "nextDialogs": [
              "120050236"
            ]
          },
          "120050236": {
            "id": "120050236",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Let's not forget that I am the eldest daughter of the Kamisato Clan. I would be very surprised indeed if anybody in the Kanjou Commission felt that I was accountable to them for my actions.",
            "nextDialogs": [
              "120050237"
            ]
          },
          "120050237": {
            "id": "120050237",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa, that sent shivers down Paimon's spine! Does everyone from a powerful clan talk like that?",
            "nextDialogs": [
              "120050238"
            ]
          },
          "120050238": {
            "id": "120050238",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Mr. Kurisu, I need to know the exact time and location of the theft, and anything that stood out about the perpetrators' appearance.",
            "nextDialogs": [
              "120050239"
            ]
          },
          "120050239": {
            "id": "120050239",
            "speakerId": 1004,
            "speakerName": "Kurisu",
            "text": "Thank you so much! Let's see, it was two hours ago now, over at the...",
            "nextDialogs": [
              "120050240"
            ]
          },
          "120050240": {
            "id": "120050240",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Everyone, please follow me to the scene of the crime. The investigation starts there...",
            "nextDialogs": [
              "120050241"
            ]
          },
          "120050241": {
            "id": "120050241",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Alright, off we go!"
          }
        }
      }
    },

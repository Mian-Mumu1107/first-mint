    {
      "subId": "1200516",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120051101"
        ],
        "dialogs": {
          "120051101": {
            "id": "120051101",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "I do hope you manage to get hold of your silk."
          }
        }
      }
    },
    {
      "subId": "1200509",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120050901"
        ],
        "dialogs": {
          "120050901": {
            "id": "120050901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey there, we're back!",
            "nextDialogs": [
              "120050902"
            ]
          },
          "120050902": {
            "id": "120050902",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "Welcome back!",
            "nextDialogs": [
              "120050903"
            ]
          },
          "120050903": {
            "id": "120050903",
            "speakerId": 1002,
            "speakerName": "Ogura Mio",
            "text": "So, any luck at the International Trade Association? Did they have any silk in stock?",
            "nextDialogs": [
              "120050904"
            ]
          },
          "120050904": {
            "id": "120050904",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Yes, they did.",
            "nextDialogs": [
              "120050905"
            ]
          },
          "120050905": {
            "id": "120050905",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "Here."
          }
        }
      }
    },
    {
      "subId": "1200599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120059901"
        ],
        "dialogs": {
          "120059901": {
            "id": "120059901",
            "speakerId": 1000,
            "speakerName": "Kamisato Ayaka",
            "text": "This is it, the International Trade Association.",
            "nextDialogs": [
              "120059902"
            ]
          },
          "120059902": {
            "id": "120059902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Okay, then... we need to talk to Kurisu, right?",
            "nextDialogs": [
              "120059903"
            ]
          },
          "120059903": {
            "id": "120059903",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Doesn't look like he's here. Let's look around!"
          }
        }
      }
    }
  ]

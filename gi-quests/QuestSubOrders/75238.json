{
  "lineCounts": {
    "Citlali": 14,
    "Marionette": 10
  },
  "subQuests": [
    {
      "subId": "7523801",
      "subQuestName": "Head for the vicinity of Citlali's home to start the tea party",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752380101"
        ],
        "dialogs": {
          "752380101": {
            "id": "752380101",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Is the tea to your liking? Or would you prefer something with a little more bite?",
            "nextDialogs": [
              "752380102"
            ]
          },
          "752380102": {
            "id": "752380102",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Tea is fine. I feel guilty drinking during the day. Best not to do it too often...",
            "nextDialogs": [
              "752380103"
            ]
          },
          "752380103": {
            "id": "752380103",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Anyway, Miss Guillotin, what brings you to Natlan?",
            "nextDialogs": [
              "752380104"
            ]
          },
          "752380104": {
            "id": "752380104",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "I'm just traveling around, visiting old acquaintances. Besides, I wanted to thank you for agreeing to help out during the Fontinalia Festival.",
            "nextDialogs": [
              "752380105"
            ]
          },
          "752380105": {
            "id": "752380105",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "You're too polite. Did you really come all the way here just for that?",
            "nextDialogs": [
              "752380106"
            ]
          },
          "752380106": {
            "id": "752380106",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Well... Although you were gracious enough not to bring it up last time, I'm well aware I've caused you trouble in the past.",
            "nextDialogs": [
              "752380107"
            ]
          },
          "752380107": {
            "id": "752380107",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Ah... That business with your subordinate? The incident involving the robot, Ineffa...",
            "nextDialogs": [
              "752380108"
            ]
          },
          "752380108": {
            "id": "752380108",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Heh... Isn't life strange? You might suddenly find yourself friends with your former enemy's boss... You might even find they become your own boss...",
            "nextDialogs": [
              "752380109"
            ]
          },
          "752380109": {
            "id": "752380109",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "I hope you can accept this as a small token of apology.",
            "nextDialogs": [
              "752380110"
            ]
          },
          "752380110": {
            "id": "752380110",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Th—This... It's a limited edition... No, a collector's edition!? And it's my favorite genre!? H—How did you know...",
            "nextDialogs": [
              "752380111"
            ]
          },
          "752380111": {
            "id": "752380111",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "#I asked {NICKNAME} for advice. {M#He}{F#She} has a pretty good grasp of your reading preferences.",
            "nextDialogs": [
              "752380112"
            ]
          },
          "752380112": {
            "id": "752380112",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "#{NICKNAME}...!?",
            "nextDialogs": [
              "752380113"
            ]
          },
          "752380113": {
            "id": "752380113",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "(Ugh...! What's with these conflicting feelings!? It's like I'm pleased but also embarrassed.)",
            "nextDialogs": [
              "752380114"
            ]
          },
          "752380114": {
            "id": "752380114",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "#(Naturally, I'm flattered {M#he}{F#she} knows what I like, but does {M#he}{F#she} really have to go shouting it from the rooftops? I'd rather {M#he}{F#she} just gave me a gift {M#himself}{F#herself}!)",
            "nextDialogs": [
              "752380115"
            ]
          },
          "752380115": {
            "id": "752380115",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Do you like it?",
            "nextDialogs": [
              "752380116"
            ]
          },
          "752380116": {
            "id": "752380116",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Ah... Th—Thank you! You're too kind, Miss Guillotin.",
            "nextDialogs": [
              "752380117"
            ]
          },
          "752380117": {
            "id": "752380117",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "#If it's the type you like, then next time, I can bring you some more. Of course, when the time comes, I'll have to trouble {NICKNAME} to pick them out with me.",
            "nextDialogs": [
              "752380118"
            ]
          },
          "752380118": {
            "id": "752380118",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "...W—With you!? You mean... You went to the bookstore together to get this!?",
            "nextDialogs": [
              "752380119"
            ]
          },
          "752380119": {
            "id": "752380119",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "#Yes. {M#He}{F#She} seemed intent on choosing the perfect one. Maybe next time...",
            "nextDialogs": [
              "752380120"
            ]
          },
          "752380120": {
            "id": "752380120",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "...There'd better not be a next time!!!",
            "nextDialogs": [
              "752380121"
            ]
          },
          "752380121": {
            "id": "752380121",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Oh... I... Uhm..."
          }
        }
      }
    },
    {
      "subId": "7523802",
      "subQuestName": "Head for the vicinity of Citlali's home to start the tea party",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752380201"
        ],
        "dialogs": {
          "752380201": {
            "id": "752380201",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "#Ugh... Just wait till I get my hands on {M#him}{F#her}!",
            "nextDialogs": [
              "752380202"
            ]
          },
          "752380202": {
            "id": "752380202",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "(Let's sit like this for a little while longer.)",
            "nextDialogs": [
              "752380204"
            ]
          },
          "752380204": {
            "id": "752380204",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Is that the time? Alright, Miss Guillotin, be careful on the road."
          }
        }
      }
    },

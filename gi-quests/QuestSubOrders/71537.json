        ],
        "dialogs": {
          "715370101": {
            "id": "715370101",
            "speakerId": 1000,
            "speakerName": "Noelle",
            "text": "Honorary Knight! I didn't expect to run into you here!",
            "nextDialogs": [
              "715370102"
            ]
          },
          "715370102": {
            "id": "715370102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you making gift envelopes?",
            "nextDialogs": [
              "715370103"
            ]
          },
          "715370103": {
            "id": "715370103",
            "speakerId": 1000,
            "speakerName": "Noelle",
            "text": "Yes! I finally got the chance to come here on vacation, and I wanted to bring a few gifts back for the Knights of Favonius.",
            "nextDialogs": [
              "715370104"
            ]
          },
          "715370104": {
            "id": "715370104",
            "speakerId": 1000,
            "speakerName": "Noelle",
            "text": "I heard that, during Lantern Rite, locals like to include one of these envelopes with their gifts.",
            "nextDialogs": [
              "715370105"
            ]
          },
          "715370105": {
            "id": "715370105",
            "speakerId": 1000,
            "speakerName": "Noelle",
            "text": "So, I wanted to follow their lead and make a few gift envelopes of my own. But, they're not looking too good...",
            "nextDialogs": [
              "715370106"
            ]
          },
          "715370106": {
            "id": "715370106",
            "speakerId": 1000,
            "speakerName": "Noelle",
            "text": "I want my gift envelopes to be beautiful! Can you show me how, Honorary Knight?",
            "nextDialogs": [
              "715370107"
            ]
          },
          "715370107": {
            "id": "715370107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Of course, leave it to me."
          }
        }
      }
    },
    {

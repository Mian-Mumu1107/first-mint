        "dialogs": {
          "715370301": {
            "id": "715370301",
            "speakerId": 1000,
            "speakerName": "Noelle",
            "text": "So, that's how it works... Wow, is there anything you can't do?",
            "nextDialogs": [
              "715370302"
            ]
          },
          "715370302": {
            "id": "715370302",
            "speakerId": 1000,
            "speakerName": "Noelle",
            "text": "Thank you for teaching me. I'll treasure this gift envelope!",
            "nextDialogs": [
              "715370303"
            ]
          },
          "715370303": {
            "id": "715370303",
            "speakerId": 1000,
            "speakerName": "Noelle",
            "text": "Be sure to stop by the next Windblume Festival, okay?",
            "nextDialogs": [
              "715370304"
            ]
          },
          "715370304": {
            "id": "715370304",
            "speakerId": 1000,
            "speakerName": "Noelle",
            "text": "When that day comes, I'll make you a gift envelope just as beautiful as this one."
          }
        }
      }

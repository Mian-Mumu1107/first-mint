  "subQuests": [
    {
      "subId": "7511101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751110101"
        ],
        "dialogs": {
          "751110101": {
            "id": "751110101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I picked this up earlier...",
            "nextDialogs": [
              "751110102"
            ]
          },
          "751110102": {
            "id": "751110102",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "Did you, now? Some idiot must have lost it along the way again. Let me see..."
          }
        }
      }
    },
    {
      "subId": "7511110",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751111401"
        ],
        "dialogs": {
          "751111401": {
            "id": "751111401",
            "speakerId": 1001,
            "speakerName": "Acat",
            "text": "Yeah, this one's mine. Someone from the Children of Echoes wanted to purchase paints, but couldn't tell me what colors he wanted to save his life.",
            "nextDialogs": [
              "751111402"
            ]
          },
          "751111402": {
            "id": "751111402",
            "speakerId": 1001,
            "speakerName": "Acat",
            "text": "That's why I sent him a package with several small bottles of paint in it — so he could get his preferences straight before he next shows up.",
            "nextDialogs": [
              "751111403"
            ]
          },
          "751111403": {
            "id": "751111403",
            "speakerId": 1001,
            "speakerName": "Acat",
            "text": "I'll get this resent — better that than him coming over here with his ridiculous reference requests...",
            "nextDialogs": [
              "751111404"
            ]
          },
          "751111404": {
            "id": "751111404",
            "speakerId": 1001,
            "speakerName": "Acat",
            "text": "Ah, right. This is for you. Thanks for getting this package back to me."
          }
        }
      }
    },
    {
      "subId": "7511111",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751111501"
        ],
        "dialogs": {
          "751111501": {
            "id": "751111501",
            "speakerId": 1002,
            "speakerName": "Chanca",
            "text": "Huh? Yeah, this is my order. Didn't think it would meet with such bad luck...",
            "nextDialogs": [
              "751111502"
            ]
          },
          "751111502": {
            "id": "751111502",
            "speakerId": 1002,
            "speakerName": "Chanca",
            "text": "Oh well. I'll just have to write another later. This isn't super urgent, anyway.",
            "nextDialogs": [
              "751111503"
            ]
          },
          "751111503": {
            "id": "751111503",
            "speakerId": 1002,
            "speakerName": "Chanca",
            "text": "Anyway, thanks for bringing the letter back to me. You're sweating all over — here, have a drink on me."
          }
        }
      }
    },
    {
      "subId": "7511112",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751111601"
        ],
        "dialogs": {
          "751111601": {
            "id": "751111601",
            "speakerId": 1003,
            "speakerName": "Imix",
            "text": "Yeah, this one's mine — it's the package I sent out!",
            "nextDialogs": [
              "751111602"
            ]
          },
          "751111602": {
            "id": "751111602",
            "speakerId": 1003,
            "speakerName": "Imix",
            "text": "Oh, thank goodness, I thought I'd sent it off to the wrong address... I'd be smoked if that was the case!",
            "nextDialogs": [
              "751111603"
            ]
          },
          "751111603": {
            "id": "751111603",
            "speakerId": 1003,
            "speakerName": "Imix",
            "text": "Thank you, truly! Please, take these.",
            "nextDialogs": [
              "751111604"
            ]
          },
          "751111604": {
            "id": "751111604",
            "speakerId": 1003,
            "speakerName": "Imix",
            "text": "Also, uh... Could you not tell Ms. Cheven about this? I'm begging you!"
          }
        }
      }
    },
    {
      "subId": "7511113",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751111701"
        ],
        "dialogs": {
          "751111701": {
            "id": "751111701",
            "speakerId": 1004,
            "speakerName": "Tirda",
            "text": "...Yes. This letter's mine. Thank you.",
            "nextDialogs": [
              "751111702"
            ]
          },
          "751111702": {
            "id": "751111702",
            "speakerId": 1004,
            "speakerName": "Tirda",
            "text": "I'll write a new one soon. Then I'll get someone to send it to the Flower-Feather Clan.",
            "nextDialogs": [
              "751111703"
            ]
          },
          "751111703": {
            "id": "751111703",
            "speakerId": 1004,
            "speakerName": "Tirda",
            "text": "...I hope this next one makes it there safely.",
            "nextDialogs": [
              "751111704"
            ]
          },
          "751111704": {
            "id": "751111704",
            "speakerId": 1004,
            "speakerName": "Tirda",
            "text": "Here, you've earned this."
          }
        }
      }
    },
    {
      "subId": "7511102",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751110201"
        ],
        "dialogs": {
          "751110201": {
            "id": "751110201",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "Looks like... it's for Acat.",
            "nextDialogs": [
              "751110202"
            ]
          },
          "751110202": {
            "id": "751110202",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "...The packaging's broken. If we resend it as-is, the whole item might get ruined.",
            "nextDialogs": [
              "751110203"
            ]
          },
          "751110203": {
            "id": "751110203",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "I still need to sort out the packages in the store, so could you help me send this to her?",
            "nextDialogs": [
              "751110204"
            ]
          },
          "751110204": {
            "id": "751110204",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "She's the owner of Frida's Palette. Don't worry, you couldn't miss her shop's sign even if you tried."
          }
        }
      }
    },
    {
      "subId": "7511103",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751110301"
        ],
        "dialogs": {
          "751110301": {
            "id": "751110301",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "This... looks like Chanca's handwriting.",
            "nextDialogs": [
              "751110302"
            ]
          },
          "751110302": {
            "id": "751110302",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "If I had to guess, this must be another order invoice. The packaging here is broken — there's no way we can deliver it this way. This letter shall have to be returned.",
            "nextDialogs": [
              "751110303"
            ]
          },
          "751110303": {
            "id": "751110303",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "I still need to sort out the packages in the store, so could you help send this back to Chanca in my stead?",
            "nextDialogs": [
              "751110304"
            ]
          },
          "751110304": {
            "id": "751110304",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "She's the owner of the Weary Inn near the Stadium of the Sacred Flame. You can't miss it."
          }
        }
      }
    },
    {
      "subId": "7511104",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751110401"
        ],
        "dialogs": {
          "751110401": {
            "id": "751110401",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "Muhuru's Gemporium... Imix? Agh, this is an invoice she sent out, isn't it?",
            "nextDialogs": [
              "751110402"
            ]
          },
          "751110402": {
            "id": "751110402",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "If this gets lost in transit, that kid's going to get an earful from Ms. Cheven.",
            "nextDialogs": [
              "751110403"
            ]
          },
          "751110403": {
            "id": "751110403",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "I still need to sort out the packages in the store, so could you help me send this back to Imix?",
            "nextDialogs": [
              "751110404"
            ]
          },
          "751110404": {
            "id": "751110404",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "Muhuru's Gemporium is in the Children of Echoes' lands — and it's an easy find if ever there was one."
          }
        }
      }
    },
    {
      "subId": "7511105",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751110501"
        ],
        "dialogs": {
          "751110501": {
            "id": "751110501",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "...This letter's from Tirda, if I'm not mistaken.",
            "nextDialogs": [
              "751110502"
            ]
          },
          "751110502": {
            "id": "751110502",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "Was she trying to get it sent to her tribe? But it's a mess now... We're going to have to return it.",
            "nextDialogs": [
              "751110503"
            ]
          },
          "751110503": {
            "id": "751110503",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "I still need to sort out the packages in the store, so could you help get this back to Tirda in my stead?",
            "nextDialogs": [
              "751110504"
            ]
          },
          "751110504": {
            "id": "751110504",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "She sings at the Golden Dusk. You'll find her in no time."
          }
        }
      }
    },
    {
      "subId": "7511120",

    {
      "subId": "2502002",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250200201"
        ],
        "dialogs": {
          "250200201": {
            "id": "250200201",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Uh... So we tie this bit here, then that bit there... Ehh? Is that how you're meant to do this...?"
          }
        }
      }
    },
    {
      "subId": "2502009",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250200901"
        ],
        "dialogs": {
          "250200901": {
            "id": "250200901",
            "speakerId": 14268,
            "speakerName": "Hora",
            "text": "Wroo! Rrooh!"
          }
        }
      }
    },
    {
      "subId": "2502011",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250201101"
        ],
        "dialogs": {
          "250201101": {
            "id": "250201101",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "He's just over there — right by a pool, as it happens. If we can lure him in, we can give him a good washdown too...",
            "nextDialogs": [
              "250201102"
            ]
          },
          "250201102": {
            "id": "250201102",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "He'll notice me if I go over there, so you'll have to go alone. Just make sure you put the Driftyball in the center of the pool. I'm counting on you!",
            "nextDialogs": [
              "250201103"
            ]
          },
          "250201103": {
            "id": "250201103",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Please, help me put the Driftyball in the center of the pool. *sigh* I can only hope Hora likes it..."
          }
        }
      }
    },
    {
      "subId": "2502099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250209901"
        ],
        "dialogs": {
          "250209901": {
            "id": "250209901",
            "speakerId": 14267,
            "speakerName": "Cazcal",
            "text": "Hroo? Rrroooh...?"
          }
        }
      }
    }
  ]
}
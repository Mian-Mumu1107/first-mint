  "subQuests": [
    {
      "subId": "7182401",
      "subQuestName": "Talk to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718240101"
        ],
        "dialogs": {
          "718240101": {
            "id": "718240101",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "I have to hurry...",
            "nextDialogs": [
              "718240102"
            ]
          },
          "718240102": {
            "id": "718240102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is business that good?",
            "nextDialogs": [
              "718240103"
            ]
          },
          "718240103": {
            "id": "718240103",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "No. But it's the Lantern Rite now. Lots of people have headed back to the city to spend the festive period there, so we're short-staffed. I'm basically doing everything myself.",
            "nextDialogs": [
              "718240104"
            ]
          },
          "718240104": {
            "id": "718240104",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "We're not getting too many guests, though, so things aren't too bad. I can still handle it.",
            "nextDialogs": [
              "718240105"
            ]
          },
          "718240105": {
            "id": "718240105",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "*cough* Also, I should thank you for helping me previously. If it hadn't been for your help, I don't think I'd ever have been able to return to work...",
            "nextDialogs": [
              "718240108"
            ]
          },
          "718240108": {
            "id": "718240108",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "N—No! Definitely not, believe me! I—If she were to show up again, I d—don't know if my heart could take it...",
            "nextDialogs": [
              "718240109"
            ]
          },
          "718240109": {
            "id": "718240109",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "If you really want to ask about... her... you should just go ask the boss. I—I don't know anything, I swear..."
          }
        }
      }
    },
    {
      "subId": "7182402",
      "subQuestName": "Talk to Verr Goldet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718240201"
        ],
        "dialogs": {
          "718240201": {
            "id": "718240201",
            "speakerId": 1001,
            "speakerName": "Verr Goldet",
            "text": "Traveler! How can I help?",
            "nextDialogs": [
              "718240202"
            ]
          },
          "718240202": {
            "id": "718240202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Dusky Ming...",
            "nextDialogs": [
              "718240203"
            ]
          },
          "718240203": {
            "id": "718240203",
            "speakerId": 1001,
            "speakerName": "Verr Goldet",
            "text": "Oh, her? She's been quite well-behaved since that incident.",
            "nextDialogs": [
              "718240204"
            ]
          },
          "718240204": {
            "id": "718240204",
            "speakerId": 1001,
            "speakerName": "Verr Goldet",
            "text": "But I do feel bad for that child. Whenever a festive period rolled along in the past, she'd get lonelier as the inn grew livelier. As a result, she would wind up starting trouble and scaring the guests.",
            "nextDialogs": [
              "718240205"
            ]
          },
          "718240205": {
            "id": "718240205",
            "speakerId": 1001,
            "speakerName": "Verr Goldet",
            "text": "But I'm sure that she just wants someone to play with her. She is only a child, after all.",
            "nextDialogs": [
              "718240208"
            ]
          },
          "718240208": {
            "id": "718240208",
            "speakerId": 1001,
            "speakerName": "Verr Goldet",
            "text": "You want to send her a Xiao Lantern? That's not a bad idea. The only trouble is that she's quite hard to find...",
            "nextDialogs": [
              "718240209"
            ]
          },
          "718240209": {
            "id": "718240209",
            "speakerId": 1001,
            "speakerName": "Verr Goldet",
            "text": "If you're looking for her, you should hang a Xiao Lantern atop one of the trees in the nearby forest at night.",
            "nextDialogs": [
              "718240210"
            ]
          },
          "718240210": {
            "id": "718240210",
            "speakerId": 1001,
            "speakerName": "Verr Goldet",
            "text": "That way, she should be able to see it."
          }
        }
      }
    },
    {
      "subId": "7182403",
      "subQuestName": "Craft a Xiao Lantern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718240301"
        ],
        "dialogs": {
          "718240301": {
            "id": "718240301",
            "speakerId": 1001,
            "speakerName": "Verr Goldet",
            "text": "Well, did you deliver the Xiao Lantern?",
            "nextDialogs": [
              "718240302"
            ]
          },
          "718240302": {
            "id": "718240302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I guess... we can consider it sent.",
            "nextDialogs": [
              "718240303"
            ]
          },
          "718240303": {
            "id": "718240303",
            "speakerId": 1001,
            "speakerName": "Verr Goldet",
            "text": "I believe so, too. This should cheer her up a bit at least.",
            "nextDialogs": [
              "718240304"
            ]
          },
          "718240304": {
            "id": "718240304",
            "speakerId": 1001,
            "speakerName": "Verr Goldet",
            "text": "I wonder, what sort of wish would that child make?"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7601501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760150201"
        ],
        "dialogs": {
          "760150201": {
            "id": "760150201",
            "speakerId": 15550,
            "speakerName": "Loud Phantom",
            "text": "Who're you? This is my seat, and everyone in the tavern knows it.",
            "nextDialogs": [
              "760150202"
            ]
          },
          "760150202": {
            "id": "760150202",
            "speakerId": 15550,
            "speakerName": "Loud Phantom",
            "text": "Did you only just report in on the island or something? You can't just turn up and take someone else's spot!",
            "nextDialogs": [
              "760150203"
            ]
          },
          "760150203": {
            "id": "760150203",
            "speakerId": 15550,
            "speakerName": "Loud Phantom",
            "text": "Also, where the devil's my beer? Hurry it up, would ya? I'm going out on patrol soon.",
            "nextDialogs": [
              "760150206"
            ]
          },
          "760150206": {
            "id": "760150206",
            "speakerId": 15550,
            "speakerName": "Loud Phantom",
            "text": "If you must have it! But first, come and drink and sing with us. Once we're friends, sit anywhere you please!",
            "nextDialogs": [
              "760150207"
            ]
          },
          "760150207": {
            "id": "760150207",
            "speakerId": 15550,
            "speakerName": "Loud Phantom",
            "text": "You know the tune, right? Yo-ho, come on now! We'll sing one line, you'll sing the next!",
            "nextDialogs": [
              "760150208"
            ]
          },
          "760150208": {
            "id": "760150208",
            "speakerId": 15550,
            "speakerName": "Loud Phantom",
            "text": "\"The sound of dancing drifted from my neighbors', it set my feet a-tapping, oh!\"",
            "nextDialogs": [
              "760150209"
            ]
          },
          "760150209": {
            "id": "760150209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"You're all smiling, the fiddle I'm playing,\"",
            "nextDialogs": [
              "760150210"
            ]
          },
          "760150210": {
            "id": "760150210",
            "speakerId": 15550,
            "speakerName": "Loud Phantom",
            "text": "\"And we're all dancing to and fro!\"",
            "nextDialogs": [
              "760150211"
            ]
          },
          "760150211": {
            "id": "760150211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Come crowd around, let's dance away!\"",
            "nextDialogs": [
              "760150212"
            ]
          },
          "760150212": {
            "id": "760150212",
            "speakerId": 15550,
            "speakerName": "Loud Phantom",
            "text": "Haha! That's right, that's the way! You're quick on the uptake!",
            "nextDialogs": [
              "760150213"
            ]
          },
          "760150213": {
            "id": "760150213",
            "speakerId": 15550,
            "speakerName": "Loud Phantom",
            "text": "The name's ███. Well, that makes us acquainted. The chair's all yours — I'm a generous fellow, after all!",
            "nextDialogs": [
              "760150214"
            ]
          },
          "760150214": {
            "id": "760150214",
            "speakerId": 15550,
            "speakerName": "Loud Phantom",
            "text": "You're a Ratnik too, eh? Don't worry, this drink's on me. Maybe we'll see each other again during training."
          }
        }
      }
    },

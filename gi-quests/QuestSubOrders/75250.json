  "subQuests": [
    {
      "subId": "7525001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752500101"
        ],
        "dialogs": {
          "752500101": {
            "id": "752500101",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "The guests are leaving one after another with toys in their hands when a few uninvited visitors stroll into the Alpaca Park...",
            "nextDialogs": [
              "752500102"
            ]
          },
          "752500102": {
            "id": "752500102",
            "speakerId": 1001,
            "speakerName": "Inarticulate Fatuus",
            "text": "Uh...",
            "nextDialogs": [
              "752500103"
            ]
          },
          "752500103": {
            "id": "752500103",
            "speakerId": 1002,
            "speakerName": "Aloha",
            "text": "The Fatui who robbed me yesterday! It's you lot... What else do you want from me?!",
            "nextDialogs": [
              "752500104"
            ]
          },
          "752500104": {
            "id": "752500104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry. I've got this.",
            "nextDialogs": [
              "752500105"
            ]
          },
          "752500105": {
            "id": "752500105",
            "speakerId": 1001,
            "speakerName": "Inarticulate Fatuus",
            "text": "No...",
            "nextDialogs": [
              "752500106"
            ]
          },
          "752500106": {
            "id": "752500106",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "The one leading the Fatui waves his hands, then hands you a crumpled note. You unfold it. A few shaky lines are written on it...",
            "nextDialogs": [
              "752500107"
            ]
          },
          "752500107": {
            "id": "752500107",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "\"We're The Captain's soldiers.\"",
            "nextDialogs": [
              "752500108"
            ]
          },
          "752500108": {
            "id": "752500108",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "\"Sorry, but we cannot speak. Our throats were injured while we were fighting alongside The Captain.\"",
            "nextDialogs": [
              "752500109"
            ]
          },
          "752500109": {
            "id": "752500109",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "\"We'll be heading back to Snezhnaya soon. Just wanna bring home some souvenirs.\"",
            "nextDialogs": [
              "752500110"
            ]
          },
          "752500110": {
            "id": "752500110",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "\"Alpacas are great... very peaceful animals. Hope everyone can be like that...\"",
            "nextDialogs": [
              "752500111"
            ]
          },
          "752500111": {
            "id": "752500111",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "\"We paid already yesterday. We put the money in the bag. Please give us three Alpaca toys. Thanks.\""
          }
        }
      }
    },
    {
      "subId": "7525003",
      "subQuestName": "Customize the toys in colors suited for the Fatui $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752500301"
        ],
        "dialogs": {
          "752500301": {
            "id": "752500301",
            "speakerId": 1002,
            "speakerName": "Aloha",
            "text": "Welcome, honored customer, we've been quite busy today — our goods are all sold out. All that's left are a few unfinished pieces.",
            "nextDialogs": [
              "752500302"
            ]
          },
          "752500302": {
            "id": "752500302",
            "speakerId": 1002,
            "speakerName": "Aloha",
            "text": "If you don't mind... could you maybe lend a hand? I just need you to finish coloring the pieces we have left."
          }
        }
      }
    },
    {
      "subId": "7525004",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752500201"
        ],
        "dialogs": {
          "752500201": {
            "id": "752500201",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "The Fatui leave, contented."
          }
        }
      }
    },
    {
      "subId": "7525004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752500401"
        ],
        "dialogs": {
          "752500401": {
            "id": "752500401",
            "speakerId": 1002,
            "speakerName": "Aloha",
            "text": "Could you prepare some toys of the right colors for them? That way, they're sure to be satisfied."
          }
        }
      }
    }
  ]

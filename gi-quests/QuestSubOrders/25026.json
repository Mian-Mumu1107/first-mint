            "nextDialogs": [
              "250260704"
            ]
          },
          "250260704": {
            "id": "250260704",
            "speakerId": 1001,
            "speakerName": "Timid Little Yumkasaur",
            "text": "Good people...? Friends...",
            "nextDialogs": [
              "250260705"
            ]
          },
          "250260705": {
            "id": "250260705",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "I'm Tlamot. Remember me? I'm the one who gave you those delicious treats before.",
            "nextDialogs": [
              "250260708"
            ]
          },
          "250260708": {
            "id": "250260708",
            "speakerId": 1001,
            "speakerName": "Timid Little Yumkasaur",
            "text": "You... Friend!",
            "nextDialogs": [
              "250260709"
            ]
          },
          "250260709": {
            "id": "250260709",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You play with the happy Yumkasaurus for a while. It seems he's in a much better mood...",
            "nextDialogs": [
              "250260710"
            ]
          },
          "250260710": {
            "id": "250260710",
            "speakerId": 1001,
            "speakerName": "Timid Little Yumkasaur",
            "text": "For you, for you, gift!",
            "nextDialogs": [
              "250260711"
            ]
          },
          "250260711": {
            "id": "250260711",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "#This is... Heh, looks like we both got presents, eh, {NICKNAME}?",
            "nextDialogs": [
              "250260712"
            ]
          },
          "250260712": {
            "id": "250260712",
            "speakerId": 1001,
            "speakerName": "Timid Little Yumkasaur",
            "text": "Friend, thank you!",
            "nextDialogs": [
              "250260713"
            ]
          },
          "250260713": {
            "id": "250260713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thank you!",
            "nextDialogs": [
              "250260714"
            ]
          },
          "250260714": {
            "id": "250260714",
            "speakerId": 1001,
            "speakerName": "Timid Little Yumkasaur",
            "text": "Friend! Friend! Good! Good! See you again!",
            "nextDialogs": [
              "250260715"
            ]
          },
          "250260715": {
            "id": "250260715",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The little Yumkasaurus happily circles you twice before turning and diving into the woods once more.",
            "nextDialogs": [
              "250260716"
            ]
          },
          "250260716": {
            "id": "250260716",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Looks like he's gone home. Just hope he doesn't run into any more of those scoundrels.",
            "nextDialogs": [
              "250260717"
            ]
          },
          "250260717": {
            "id": "250260717",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Let's head back as well. Here, take these as compensation."
          }
        }
      }
    },
    {
      "subId": "2502611",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250261101"
        ],
        "dialogs": {
          "250261101": {
            "id": "250261101",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "#We meet again, {NICKNAME}. Well, then, what do you say to lending me a hand, just like last time?",
            "nextDialogs": [
              "250261102"
            ]
          },
          "250261102": {
            "id": "250261102",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Those Treasure Hoarders never learn their lesson, do they? If we leave them be, they'll only be emboldened to continue doing evil.",
            "nextDialogs": [
              "250261103"
            ]
          },
          "250261103": {
            "id": "250261103",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "The little Yumkasaurus is safe for now, but he's still a young 'un. He still needs more care..."
          }
        }
      }
    },
    {
      "subId": "2502612",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250261201"
        ],
        "dialogs": {
          "250261201": {
            "id": "250261201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'd suggest you focus on the comforting.",
            "nextDialogs": [
              "250261202"
            ]
          },
          "250261202": {
            "id": "250261202",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Alright. That'll cheer him up, I hope.",
            "nextDialogs": [
              "250261203"
            ]
          },
          "250261203": {
            "id": "250261203",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Those Treasure Hoarders shouldn't come looking for trouble with both of us around.",
            "nextDialogs": [
              "250261204"
            ]
          },
          "250261204": {
            "id": "250261204",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Let me think for a moment... please go to the tree over there and pick two fresh Candlecap Mushrooms.",
            "nextDialogs": [
              "250261205"
            ]
          },
          "250261205": {
            "id": "250261205",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Once you've gathered them, let's meet up at the cliff near the Stadium again. Those Treasure Hoarders won't try anything funny with you there."
          }
        }
      }
    },
    {
      "subId": "2502614",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250261401"
        ],
        "dialogs": {
          "250261401": {
            "id": "250261401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's go teach those Treasure Hoarders a lesson.",
            "nextDialogs": [
              "250261402"
            ]
          },
          "250261402": {
            "id": "250261402",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "No problem. Those unrepentant Treasure Hoarders just set up a new camp — I've marked it out.",

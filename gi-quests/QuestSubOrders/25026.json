  "subQuests": [
    {
      "subId": "2502601",
      "subQuestName": "Help the troubled hunter",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250260201"
        ],
        "dialogs": {
          "250260201": {
            "id": "250260201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'd suggest you focus on the comforting.",
            "nextDialogs": [
              "250260202"
            ]
          },
          "250260202": {
            "id": "250260202",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Hmm... You do speak sense. That poor child has been terrified enough. Alright. Let's go calm him down first...",
            "nextDialogs": [
              "250260203"
            ]
          },
          "250260203": {
            "id": "250260203",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Come along, then. From the look of you, you must be an experienced adventurer.",
            "nextDialogs": [
              "250260204"
            ]
          },
          "250260204": {
            "id": "250260204",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "With the two of us there, those thieves won't dare try anything. And don't worry about payment. I know the Guild's rules, and I'll follow them.",
            "nextDialogs": [
              "250260206"
            ]
          },
          "250260206": {
            "id": "250260206",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "That little one just loves eating Candlecap Mushrooms... And if I recall, lots of them grow under the tree over there. Why don't you start by picking some?",
            "nextDialogs": [
              "250260205"
            ]
          },
          "250260205": {
            "id": "250260205",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "I'll be gathering Candlecap Mushrooms on the other side. Once you're done with yours, let's meet up on the cliff near the Stadium.",
            "nextDialogs": [
              "250260207"
            ]
          },
          "250260207": {
            "id": "250260207",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "That's where the little Saurian usually takes a break. Perhaps we can find him there."
          }
        }
      }
    },
    {
      "subId": "2502607",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250260401"
        ],
        "dialogs": {
          "250260401": {
            "id": "250260401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's go teach those Treasure Hoarders a lesson.",
            "nextDialogs": [
              "250260402"
            ]
          },
          "250260402": {
            "id": "250260402",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "You're willing to come along? Thank you! And you'd be a big help, too — I can tell you're an experienced adventurer.",
            "nextDialogs": [
              "250260403"
            ]
          },
          "250260403": {
            "id": "250260403",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "I'll be sure to pay you as the Adventurers' Guild rules stipulate. Let's go then — we'll show those scoundrels."
          }
        }
      }
    },
    {
      "subId": "2502602",
      "subQuestName": "Gather two fresh Candlecap Mushrooms",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2502603",
      "subQuestName": "Go to the cliffside to look for Tlamot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250260301"
        ],
        "dialogs": {
          "250260301": {
            "id": "250260301",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "This is where he normally hangs out, but there's not a trace of him today...",
            "nextDialogs": [
              "250260302"
            ]
          },
          "250260302": {
            "id": "250260302",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "He must've hidden after that scare.",
            "nextDialogs": [
              "250260303"
            ]
          },
          "250260303": {
            "id": "250260303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Should we go searching for him?",
            "nextDialogs": [
              "250260304"
            ]
          },
          "250260304": {
            "id": "250260304",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "...Nah. Let's leave him in peace for a while. We'll just leave the mushrooms here.",
            "nextDialogs": [
              "250260305"
            ]
          },
          "250260305": {
            "id": "250260305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You've got experience, I see...",
            "nextDialogs": [
              "250260306"
            ]
          },
          "250260306": {
            "id": "250260306",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "In taking care of that kid? Definitely. I've been looking after him for a while now, so I know he's a sensitive sort. Even the sight of strangers might spook him.",
            "nextDialogs": [
              "250260307"
            ]
          },
          "250260307": {
            "id": "250260307",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Only after I fed him for a long time was he willing to approach me... But I doubt he'll be coming out any time soon, now that those villains have made a mess of everything.",
            "nextDialogs": [
              "250260308"
            ]
          },
          "250260308": {
            "id": "250260308",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "We'll need to leave him alone for a while.",
            "nextDialogs": [
              "250260309"
            ]
          },
          "250260309": {
            "id": "250260309",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Thanks for coming along. Here's the reward.",
            "nextDialogs": [
              "250260312"
            ]
          },
          "250260312": {
            "id": "250260312",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Don't worry, he remembers those who've done right by him. When the time is right, he will definitely come to see us."
          }
        }
      }
    },
    {
      "subId": "2502604",
      "subQuestName": "Teach the Treasure Hoarders a lesson",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2502605",
      "subQuestName": "Talk to Tlamot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250260501"
        ],
        "dialogs": {
          "250260501": {
            "id": "250260501",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Hmph. Let's see them dare to hurt my little Yumkasaurus ever again, eh?",
            "nextDialogs": [
              "250260502"
            ]
          },
          "250260502": {
            "id": "250260502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Feels like there's been some sort of misunderstanding...",
            "nextDialogs": [
              "250260503"
            ]
          },
          "250260503": {
            "id": "250260503",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Don't listen to their pretty words. Why, I saw them tie a rope to that poor Yumkasaurus's tail with my own eyes!",
            "nextDialogs": [
              "250260504"
            ]
          },
          "250260504": {
            "id": "250260504",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Who knows what might have happened if I hadn't shown up when I had.",
            "nextDialogs": [
              "250260505"
            ]
          },
          "250260505": {
            "id": "250260505",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Thanks for your aid, in any case. Here's your payment.",
            "nextDialogs": [
              "250260506"
            ]
          },
          "250260506": {
            "id": "250260506",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "It's just a shame they fled so fast. If we'd caught them, we could put an end to their troublemaking once and for all!"
          }
        }
      }
    },
    {
      "subId": "2502601",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250260101"
        ],
        "dialogs": {
          "250260101": {
            "id": "250260101",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "That poor little Yumkasaurus... That does it. I'll show them. I'll show those scoundrels!",
            "nextDialogs": [
              "250260102"
            ]
          },
          "250260102": {
            "id": "250260102",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "You can run, you louts, but you can't hide!",
            "nextDialogs": [
              "250260103"
            ]
          },
          "250260103": {
            "id": "250260103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "250260104"
            ]
          },
          "250260104": {
            "id": "250260104",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "You're... a traveler from afar, then? Greetings to you — though I fear I cannot extend any hospitality to you beyond that.",
            "nextDialogs": [
              "250260105"
            ]
          },
          "250260105": {
            "id": "250260105",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Those wretched Treasure Hoarders were aiming to catch that little Yumkasaurus again. Fortunately, I was on hand to chase them off.",
            "nextDialogs": [
              "250260106"
            ]
          },
          "250260106": {
            "id": "250260106",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "But the poor thing's been scared stiff. He won't come any closer no matter how I call out.",
            "nextDialogs": [
              "250260107"
            ]
          },
          "250260107": {
            "id": "250260107",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "No matter. I've found their hideout. I'm going to teach them a lesson, and once I do, I'll have 'em lashed to a tree, and lashed with one too!",
            "nextDialogs": [
              "250260108"
            ]
          },
          "250260108": {
            "id": "250260108",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Also, I'll have to find something tasty to comfort that poor little frightened Yumkasaurus..."
          }
        }
      }
    },
    {
      "subId": "2502606",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250260601"
        ],
        "dialogs": {
          "250260601": {
            "id": "250260601",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "...Shh. Look over there. He's waiting for us.",
            "nextDialogs": [
              "250260602"
            ]
          },
          "250260602": {
            "id": "250260602",
            "speakerId": 1001,
            "speakerName": "Timid Little Yumkasaur",
            "text": "...Woo? Mmwoo...?",
            "nextDialogs": [
              "250260603"
            ]
          },
          "250260603": {
            "id": "250260603",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Come here, kiddo. We're not gonna hurt ya.",
            "nextDialogs": [
              "250260604"
            ]
          },
          "250260604": {
            "id": "250260604",
            "speakerId": 1001,
            "speakerName": "Timid Little Yumkasaur",
            "text": "Mwoo? Mmmmrawr...",
            "nextDialogs": [
              "250260605"
            ]
          },
          "250260605": {
            "id": "250260605",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "I'm Tlamot. Remember me? I'm the one who gave you those delicious treats before.",
            "nextDialogs": [
              "250260608"
            ]
          },
          "250260608": {
            "id": "250260608",
            "speakerId": 1001,
            "speakerName": "Timid Little Yumkasaur",
            "text": "Roar... Rawrrrr!",
            "nextDialogs": [
              "250260609"
            ]
          },
          "250260609": {
            "id": "250260609",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You play with the happy Yumkasaurus for a while. It seems he's in a much better mood...",
            "nextDialogs": [
              "250260610"
            ]
          },
          "250260610": {
            "id": "250260610",
            "speakerId": 1001,
            "speakerName": "Timid Little Yumkasaur",
            "text": "Raar! Oroo, rrooh!",
            "nextDialogs": [
              "250260611"
            ]
          },
          "250260611": {
            "id": "250260611",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "#This... Hey, {NICKNAME}, looks like he sees you as a friend already! We both got gifts too.",
            "nextDialogs": [
              "250260612"
            ]
          },
          "250260612": {
            "id": "250260612",
            "speakerId": 1001,
            "speakerName": "Timid Little Yumkasaur",
            "text": "Rawr! Rawr!",
            "nextDialogs": [
              "250260613"
            ]
          },
          "250260613": {
            "id": "250260613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thanks a lot.",
            "nextDialogs": [
              "250260614"
            ]
          },
          "250260614": {
            "id": "250260614",
            "speakerId": 1001,
            "speakerName": "Timid Little Yumkasaur",
            "text": "Rawr! Rawrrr! Rawr!",
            "nextDialogs": [
              "250260615"
            ]
          },
          "250260615": {
            "id": "250260615",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The little Yumkasaurus happily circles you twice before turning and diving into the woods once more.",
            "nextDialogs": [
              "250260616"
            ]
          },
          "250260616": {
            "id": "250260616",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Looks like he's gone home. Just hope he doesn't run into any more of those scoundrels.",
            "nextDialogs": [
              "250260617"
            ]
          },
          "250260617": {
            "id": "250260617",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "Let's head back as well. Here, take these as compensation."
          }
        }
      }
    },
    {
      "subId": "2502607",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250260701"
        ],
        "dialogs": {
          "250260701": {
            "id": "250260701",
            "speakerId": 1000,
            "speakerName": "Tlamot",
            "text": "...Shh. Look over there. He's waiting for us.",
            "nextDialogs": [
              "250260702"
            ]
          },
          "250260702": {
            "id": "250260702",
            "speakerId": 1001,
            "speakerName": "Timid Little Yumkasaur",
            "text": "Friend...? Don't know... Good people...?",
            "nextDialogs": [
              "250260703"
            ]
          },
          "250260703": {
            "id": "250260703",
            "speakerId": 1000,
            "speakerName": "Tlamot",

        "dialogs": {
          "664920501": {
            "id": "664920501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Lawaia told me your fish are the freshest in town.",
            "nextDialogs": [
              "664920502"
            ]
          },
          "664920502": {
            "id": "664920502",
            "speakerId": 6492,
            "speakerName": "Teuciztli",
            "text": "Haha, that kid knows his stuff. Guess I made the right choice hiring him.",
            "nextDialogs": [
              "664920503"
            ]
          },
          "664920503": {
            "id": "664920503",
            "speakerId": 6492,
            "speakerName": "Teuciztli",
            "text": "And judging by how you chose to eat with us, it seems like you know your stuff as well. Here you go, these are for you."
          }
        }
      }
    },
    {
      "subId": "7595206",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "664930501"
        ],
        "dialogs": {
          "664930501": {
            "id": "664930501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How's business today?",
            "nextDialogs": [
              "664930502"
            ]
          },
          "664930502": {
            "id": "664930502",
            "speakerId": 6493,
            "speakerName": "Lawaia",
            "text": "It's not bad at all. What's strange, though, is today's catch was suddenly much fresher.",
            "nextDialogs": [
              "664930503"
            ]
          },
          "664930503": {
            "id": "664930503",
            "speakerId": 6493,
            "speakerName": "Lawaia",
            "text": "The boss even came to tell me that I'd been working hard lately, and he gave me some Mora as thanks. Talk about a turnaround...",
            "nextDialogs": [
              "664930504"
            ]
          },
          "664930504": {
            "id": "664930504",
            "speakerId": 6493,
            "speakerName": "Lawaia",
            "text": "I'm starting to suspect something... Did he hear about the things I said?",
            "nextDialogs": [
              "664930505"
            ]
          },
          "664930505": {
            "id": "664930505",
            "speakerId": 6493,
            "speakerName": "Lawaia",
            "text": "Bah, whatever. It's not every day that free Mora just falls into your lap. Here, have some — consider it a token of good fortune."
          }
        }
      }
    }
  ]

          },
          "719290102": {
            "id": "719290102",
            "speakerId": 1000,
            "speakerName": "Huangshan",
            "text": "You just need to know that it's a term specific to Liyue that refers to mercenaries who specialize in protecting cargo.",
            "nextDialogs": [
              "719290103"
            ]
          },
          "719290103": {
            "id": "719290103",
            "speakerId": 1000,
            "speakerName": "Huangshan",
            "text": "Well, the people of Liyue prize mercantilism, and traveling merchants must go far abroad. Our job is to protect them from bandits who would rob them of their goods.",
            "nextDialogs": [
              "719290104"
            ]
          },
          "719290104": {
            "id": "719290104",
            "speakerId": 1000,
            "speakerName": "Huangshan",
            "text": "I've accumulated a lot of experience from my years working in this field for — and I don't mind sharing."
          }
        }
      }

  "subQuests": [
    {
      "subId": "2001809",
      "subQuestName": "Go and investigate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180901"
        ],
        "dialogs": {
          "200180901": {
            "id": "200180901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Will do.",
            "nextDialogs": [
              "200180902"
            ]
          },
          "200180902": {
            "id": "200180902",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "Great. You do that, and I'll— I'll, uh, keep watch."
          }
        }
      }
    },
    {
      "subId": "2001801",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180101"
        ],
        "dialogs": {
          "200180101": {
            "id": "200180101",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "Thank you, Traveler. Ugh, trust me to find a way to balls everything up...",
            "nextDialogs": [
              "200180102"
            ]
          },
          "200180102": {
            "id": "200180102",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "If I can't even take a cart of wine from A to B without running into trouble... What good am I for anything?",
            "nextDialogs": [
              "200180103"
            ]
          },
          "200180103": {
            "id": "200180103",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "I'll be fired from the Winery if I don't get my act together... That is, if Mr. Connor isn't on to me already. Ugh, I bet Mr. Elzer's drafting up my dismissal letter as I speak... It's hopeless, it's all hope—",
            "nextDialogs": [
              "200180104"
            ]
          },
          "200180104": {
            "id": "200180104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Whoa Nelly! Calm down.",
            "nextDialogs": [
              "200180105"
            ]
          },
          "200180105": {
            "id": "200180105",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "*sigh* Well, even if my job situation is beyond hope, I should still get this cart to its destination.",
            "nextDialogs": [
              "200180106"
            ]
          },
          "200180106": {
            "id": "200180106",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "The cart's also been damaged... Traveler, could I trouble you to help me find what I need? Just one <color=#00E1FFFF>Sturdy Plank</color> will be enough."
          }
        }
      }
    },
    {
      "subId": "2001802",
      "subQuestName": "Talk to Magar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180701"
        ],
        "dialogs": {
          "200180701": {
            "id": "200180701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright. Don't you worry.",
            "nextDialogs": [
              "200180702"
            ]
          },
          "200180702": {
            "id": "200180702",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "Phew... Thanks. Meanwhile, I'll... have a— a think about how to fix the cart."
          }
        }
      }
    },
    {
      "subId": "2001803",
      "subQuestName": "Collect wood",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180301"
        ],
        "dialogs": {
          "200180301": {
            "id": "200180301",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "That'll do the trick. I should be able to fix the cart now. I think. I hope...",
            "nextDialogs": [
              "200180302"
            ]
          },
          "200180302": {
            "id": "200180302",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "Shoot, they're back! Help me, Traveler!"
          }
        }
      }
    },
    {
      "subId": "2001804",
      "subQuestName": "Give the Sturdy Plank to Magar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2001805",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180501"
        ],
        "dialogs": {
          "200180501": {
            "id": "200180501",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "Take a look in the woods over there for me, would you? If you find a <color=#00E1FFFF>rope</color>, bring it to me."
          }
        }
      }
    },
    {
      "subId": "2001806",
      "subQuestName": "Talk to Magar",
      "sceneId": null,
      "locations": [],

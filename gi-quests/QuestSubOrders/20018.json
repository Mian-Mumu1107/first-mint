      }
    },
    {
      "subId": "2001807",
      "subQuestName": "Collect rope",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2001808",
      "subQuestName": "Give the rope to Magar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180601"
        ],
        "dialogs": {
          "200180601": {
            "id": "200180601",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "Thank you, Traveler. That will do nicely.",
            "nextDialogs": [
              "200180602"
            ]
          },
          "200180602": {
            "id": "200180602",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "This should hold out long enough to get me to Springvale. Once I've dropped off the goods there, I'll head back to the winery and update them on what went down.",
            "nextDialogs": [
              "200180603"
            ]
          },
          "200180603": {
            "id": "200180603",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "Hopefully Elzer doesn't fire me on the spot when he sees what's happened to his cart..."
          }
        }
      }
    },
    {
      "subId": "2001802",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180201"
        ],
        "dialogs": {
          "200180201": {
            "id": "200180201",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "You should be able to find a <color=#00E1FFFF>Sturdy Plank</color> in the forest. Bring it to me when you find one, yeah?"
          }
        }
      }
    },
    {
      "subId": "2001804",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180401"
        ],
        "dialogs": {
          "200180401": {
            "id": "200180401",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "Phew... Thank goodness you are here, Traveler.",
            "nextDialogs": [
              "200180402"
            ]
          },
          "200180402": {
            "id": "200180402",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "But I don't know how I'm going to fix my cart now, after that.",
            "nextDialogs": [
              "200180403"
            ]
          },
          "200180403": {
            "id": "200180403",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "There's damage everywhere... I guess I'll have to patch it up as best I can. Whatever I do, it's not going to be a permanent fix.",
            "nextDialogs": [
              "200180404"
            ]
          },
          "200180404": {
            "id": "200180404",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "Never mind. As long as it holds together for the journey into town, I can figure out the next step once I'm there.",
            "nextDialogs": [
              "200180405"
            ]
          },
          "200180405": {
            "id": "200180405",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "I thought there was some rope in the cart... Gah, they must have made off with it.",
            "nextDialogs": [
              "200180406"
            ]
          },
          "200180406": {
            "id": "200180406",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "Traveler... Why don't you take a look in the woods over there for me? If there's a <color=#00E1FFFF>Rope</color> around, that would be perfect."
          }
        }
      }
    },
    {
      "subId": "2001808",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200180801"
        ],
        "dialogs": {
          "200180801": {
            "id": "200180801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm afraid I have to go...",
            "nextDialogs": [
              "200180802"
            ]
          },
          "200180802": {
            "id": "200180802",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "Don't go... Please. If I try, I—I'll only mess it up again. I need you. You're my only hope."
          }
        }
      }
    },
    {
      "subId": "2001810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200181001"
        ],
        "dialogs": {
          "200181001": {
            "id": "200181001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No can do.",
            "nextDialogs": [
              "200181002"
            ]
          },
          "200181002": {
            "id": "200181002",
            "speakerId": 1571,
            "speakerName": "Terrified Magar",
            "text": "Uh... But you're the only one around here who can help me, so... Thanks in advance...!"
          }
        }
      }
    }
  ]
}
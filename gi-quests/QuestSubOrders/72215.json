  "subQuests": [
    {
      "subId": "7221501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722150101"
        ],
        "dialogs": {
          "722150101": {
            "id": "722150101",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Meow meow, when did that stone become the spitting image of me...",
            "nextDialogs": [
              "722150102"
            ]
          },
          "722150102": {
            "id": "722150102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How's the statue?",
            "nextDialogs": [
              "722150103"
            ]
          },
          "722150103": {
            "id": "722150103",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "The stone human says that he will finish knocking on this stone soon.",
            "nextDialogs": [
              "722150104"
            ]
          },
          "722150104": {
            "id": "722150104",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Hibiki will be so happy when she returns.",
            "nextDialogs": [
              "722150105"
            ]
          },
          "722150105": {
            "id": "722150105",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Hmm, yes. This stone is good, but we must dress the shrine's surroundings up a bit, yes?",
            "nextDialogs": [
              "722150106"
            ]
          },
          "722150106": {
            "id": "722150106",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Please, help me hang these round, tinkling metal balls around the shrine.",
            "nextDialogs": [
              "722150107"
            ]
          },
          "722150107": {
            "id": "722150107",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "These things were prepared by Hibiki. If memory serves, Domeki gave them to her because she loved playing with me and other children. It took quite a lot of effort to find them again.",
            "nextDialogs": [
              "722150108"
            ]
          },
          "722150108": {
            "id": "722150108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Huh. These are... bells?",
            "nextDialogs": [
              "722150109"
            ]
          },
          "722150109": {
            "id": "722150109",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "\"Bells?\" I am not sure what those are, but Hibiki used to use these metal balls when playing with me.",
            "nextDialogs": [
              "722150110"
            ]
          },
          "722150110": {
            "id": "722150110",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "She would put the metal balls on the ground, and then knock them far away. They would make this tinkling noise whenever they moved.",
            "nextDialogs": [
              "722150111"
            ]
          },
          "722150111": {
            "id": "722150111",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "I do not understand what power they possessed, but the sound they made would always attract myself and the other cats to chase them.",
            "nextDialogs": [
              "722150112"
            ]
          },
          "722150112": {
            "id": "722150112",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "I came to understand, therefore, that the reason why few people have come to pay respects is because the shrine presently lacks metal balls.",
            "nextDialogs": [
              "722150113"
            ]
          },
          "722150113": {
            "id": "722150113",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Thus, I request your help in hanging these metal balls in high places.",
            "nextDialogs": [
              "722150114"
            ]
          },
          "722150114": {
            "id": "722150114",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "That way, humans will hear the tinkling of the metal balls and come to this shrine, and they will not lose their way.",
            "nextDialogs": [
              "722150115"
            ]
          },
          "722150115": {
            "id": "722150115",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "The Offering Box will be full of Mora, and the shrine will thrive... and Hibiki will be very happy when she returns.",
            "nextDialogs": [
              "722150116"
            ]
          },
          "722150116": {
            "id": "722150116",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "So, please help me hang these metal balls around the shrine.",
            "nextDialogs": [
              "722150117"
            ]
          },
          "722150117": {
            "id": "722150117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I got it.",
            "nextDialogs": [
              "722150118"
            ]
          },
          "722150118": {
            "id": "722150118",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Thank you, meow meow."
          }
        }
      }
    },
    {
      "subId": "7221502",
      "subQuestName": "Hang the bells around the shrine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722150201"
        ],
        "dialogs": {
          "722150201": {
            "id": "722150201",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "These metal balls will attract more people. That will surely please Hibiki."
          }
        }
      }
    },
    {
      "subId": "7221504",

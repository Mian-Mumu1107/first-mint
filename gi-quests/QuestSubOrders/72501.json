    {
      "subId": "7250102",
      "subQuestName": "Talk to Asagiri",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "725010201"
        ],
        "dialogs": {
          "725010201": {
            "id": "725010201",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "Why does Miss Moriko always give me these weird commissions?",
            "nextDialogs": [
              "725010204"
            ]
          },
          "725010204": {
            "id": "725010204",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "Ah, Traveler, what brings you here? It's been a while, and I thought you'd traveled to other nations.",
            "nextDialogs": [
              "725010205"
            ]
          },
          "725010205": {
            "id": "725010205",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "*sigh* How I wish I was in a better condition. Then I could travel as freely as you do.",
            "nextDialogs": [
              "725010206"
            ]
          },
          "725010206": {
            "id": "725010206",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "And Miss Moriko wouldn't be able to come and nag me on work progress every day...",
            "nextDialogs": [
              "725010207"
            ]
          },
          "725010207": {
            "id": "725010207",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "My illustrations last time were well received. Many novelists have since been requesting my works.",
            "nextDialogs": [
              "725010230"
            ]
          },
          "725010230": {
            "id": "725010230",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "Although Miss Moriko has rejected many jobs for me, the remaining commissions are still overwhelming...",
            "nextDialogs": [
              "725010209"
            ]
          },
          "725010209": {
            "id": "725010209",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "At first, I thought outside of Inazuma, Liyue and Mondstadt would be the furthest stages for their stories to unfold...",
            "nextDialogs": [
              "725010210"
            ]
          },
          "725010210": {
            "id": "725010210",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "Yet they now have protagonists adventuring in Sumeru, and Fontaine even.",
            "nextDialogs": [
              "725010216"
            ]
          },
          "725010216": {
            "id": "725010216",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "Well, enough of my complaints. Traveler, is your Kamera still functional?"
          }
        }
      }
    }
  ]
}
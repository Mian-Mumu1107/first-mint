  "subQuests": [
    {
      "subId": "7010401",
      "subQuestName": "Talk to Esther",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701040101"
        ],
        "dialogs": {
          "701040101": {
            "id": "701040101",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "This is terrible... What am I going to do...",
            "nextDialogs": [
              "701040102"
            ]
          },
          "701040102": {
            "id": "701040102",
            "speakerId": 1001,
            "speakerName": "Traveler",
            "text": "What's wrong?",
            "nextDialogs": [
              "701040103"
            ]
          },
          "701040103": {
            "id": "701040103",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "It's my beacons! I've gone and left a whole load of them up on the mountain!",
            "nextDialogs": [
              "701040104"
            ]
          },
          "701040104": {
            "id": "701040104",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "There's no way I can continue my research now... *sigh* And after all the money I spent on them, too...",
            "nextDialogs": [
              "701040105"
            ]
          },
          "701040105": {
            "id": "701040105",
            "speakerId": 1001,
            "speakerName": "Traveler",
            "text": "What exactly happened?",
            "nextDialogs": [
              "701040106"
            ]
          },
          "701040106": {
            "id": "701040106",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "Well, I wanted to do some research into conditions on the mountain — the climate, the environment, and so on. So, I invested in an expensive set of survey beacons.",
            "nextDialogs": [
              "701040107"
            ]
          },
          "701040107": {
            "id": "701040107",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "Then, I scaled the mountain with a team of explorers. I was just putting the beacons in place when we were set upon by a huge group of monsters — they came out of nowhere...",
            "nextDialogs": [
              "701040108"
            ]
          },
          "701040108": {
            "id": "701040108",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "I didn't manage to grab them all before I left. The explorers insisted that we leave immediately.",
            "nextDialogs": [
              "701040109"
            ]
          },
          "701040109": {
            "id": "701040109",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "They also said they're not going back up there any time soon... But what about my beacons? The monsters will smash them to pieces!",
            "nextDialogs": [
              "701040110"
            ]
          },
          "701040110": {
            "id": "701040110",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "Can you go and collect them for me? Please, I promise they're very easy to find.",
            "nextDialogs": [
              "701040111"
            ]
          },
          "701040111": {
            "id": "701040111",
            "speakerId": 1001,
            "speakerName": "Traveler",
            "text": "Alright then...",
            "nextDialogs": [
              "701040112"
            ]
          },
          "701040112": {
            "id": "701040112",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "Thank you a thousand times over! No, a million times!",
            "nextDialogs": [
              "701040113"
            ]
          },
          "701040113": {
            "id": "701040113",
            "speakerId": 1001,
            "speakerName": "Traveler",
            "text": "What's in this for me?",
            "nextDialogs": [
              "701040114"
            ]
          },
          "701040114": {
            "id": "701040114",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "Oh, uh... a reward, of course! I'll make it worth your while, I swear...",
            "nextDialogs": [
              "701040115"
            ]
          },
          "701040115": {
            "id": "701040115",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "So, thanks in advance."
          }
        }
      }
    },
    {
      "subId": "7010402",
      "subQuestName": "Retrieve the survey beacons",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701040201"
        ],
        "dialogs": {
          "701040201": {
            "id": "701040201",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "Did you find my beacons?",
            "nextDialogs": [
              "701040202"
            ]
          },
          "701040202": {
            "id": "701040202",
            "speakerId": 1001,
            "speakerName": "Traveler",
            "text": "I did indeed.",
            "nextDialogs": [
              "701040203"
            ]
          },
          "701040203": {
            "id": "701040203",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "Let me see... Yes, these are the ones, alright!",
            "nextDialogs": [
              "701040204"
            ]
          },
          "701040204": {
            "id": "701040204",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "Ugh, look at the state of them... Those monsters clearly weren't gentle with them. But thankfully, they're not completely ruined.",
            "nextDialogs": [
              "701040205"
            ]
          },
          "701040205": {
            "id": "701040205",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "*sigh* Still, I guess I won't be using them in the near future... Ah, can't be helped. I will have to make do with a smaller-scale survey...",
            "nextDialogs": [
              "701040206"
            ]
          },
          "701040206": {
            "id": "701040206",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "I have some other beacons here. Could you set them up on the mountain for me?",
            "nextDialogs": [
              "701040208",
              "701040210"
            ]
          },
          "701040208": {
            "id": "701040208",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "...Is that a yes? I'll take that as a yes! Thanks! I'll mark the spot on the map for you.",
            "nextDialogs": [
              "701040215"
            ]
          },
          "701040215": {
            "id": "701040215",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "...There. I've marked them all out. Just put the beacons in those general areas.",
            "nextDialogs": [
              "701040216"
            ]
          },
          "701040216": {
            "id": "701040216",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "Make sure to put them up in high spots. The higher the altitude, the more accurate the survey."
          },
          "701040210": {
            "id": "701040210",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "I don't dare... If not even a whole team of explorers could stand up to those monsters, I'm certainly not going back up there alone.",
            "nextDialogs": [
              "701040211"
            ]
          },
          "701040211": {
            "id": "701040211",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "I can't find any other explorers planning a trip up there at the moment, but I also can't delay this indefinitely.",
            "nextDialogs": [
              "701040212"
            ]
          },
          "701040212": {
            "id": "701040212",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "So, you're the only chance I've got. Seeing as you managed to fetch my beacons back so effortless last time, I think you're more than up to the task.",
            "nextDialogs": [
              "701040213"
            ]
          },
          "701040213": {
            "id": "701040213",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "Thanks once again. I'll be sure to compensate you well!",
            "nextDialogs": [
              "701040214"
            ]
          },
          "701040214": {
            "id": "701040214",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "Wait, let me mark the locations on the map for you..."
          }
        }
      }
    },
    {
      "subId": "7010403",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701040301"
        ],
        "dialogs": {
          "701040301": {
            "id": "701040301",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "Are all the beacons in place?",
            "nextDialogs": [
              "701040302"
            ]
          },
          "701040302": {
            "id": "701040302",
            "speakerId": 1001,
            "speakerName": "Traveler",
            "text": "Yes.",
            "nextDialogs": [
              "701040303"
            ]
          },
          "701040303": {
            "id": "701040303",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "Wonderful, that is an enormous help. Take these — along with my thanks, once again, for everything.",
            "nextDialogs": [
              "701040304"
            ]
          },
          "701040304": {
            "id": "701040304",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "Ugh, with so few beacons for the survey, who knows if I'll be able to turn up anything of interest..."
          }
        }
      }
    },
    {
      "subId": "7010404",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701040401"
        ],
        "dialogs": {
          "701040401": {
            "id": "701040401",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "There's no way this is enough beacons to survey the whole mountain..."
          }
        }
      }
    },
    {
      "subId": "7010405",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701040501"
        ],
        "dialogs": {
          "701040501": {
            "id": "701040501",
            "speakerId": 1666,
            "speakerName": "Esther",
            "text": "This beacon is useless... So's this one..."
          }
        }
      }

    {
      "subId": "2401104",
      "subQuestName": "Report back to Iaune",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240111101"
        ],
        "dialogs": {
          "240111101": {
            "id": "240111101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you tried getting a dog?",
            "nextDialogs": [
              "240111102"
            ]
          },
          "240111102": {
            "id": "240111102",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "You mean... I should get a dog to chase them off?",
            "nextDialogs": [
              "240111103"
            ]
          },
          "240111103": {
            "id": "240111103",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "That's not a bad plan. I might be able to get someone to lend me one..."
          }
        }
      }
    },

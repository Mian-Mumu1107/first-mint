    {
      "subId": "2401110",
      "subQuestName": "Report back to Iaune",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240111001"
        ],
        "dialogs": {
          "240111001": {
            "id": "240111001",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "There's... really no end to these gulls and their appetites, is there?",
            "nextDialogs": [
              "240111002"
            ]
          },
          "240111002": {
            "id": "240111002",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Thanks for distracting them. I've finished my fries — I'll get back to work shortly.",
            "nextDialogs": [
              "240111003"
            ]
          },
          "240111003": {
            "id": "240111003",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "*sigh* But what do I do next time? I can't always count on your help, can I?"
          }
        }
      }
    },
    {
      "subId": "2401101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240110101"
        ],
        "dialogs": {
          "240110101": {
            "id": "240110101",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Oh, good gulls. I know that you are hungry, but I, too, have not eaten my fill.",
            "nextDialogs": [
              "240110102"
            ]
          },
          "240110102": {
            "id": "240110102",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Forget it. I suppose that it's all good if you're happy...",
            "nextDialogs": [
              "240110103"
            ]
          },
          "240110103": {
            "id": "240110103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "240110104"
            ]
          },
          "240110104": {
            "id": "240110104",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Traveler? Why, what a pleasant surprise. If you're here to make a request of me, I'm afraid you'll have to wait. I'm not quite done with my fries yet.",
            "nextDialogs": [
              "240110106"
            ]
          },
          "240110106": {
            "id": "240110106",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Oh, is that so? That's good. I need to hurry up and finish them as soon as possible...",
            "nextDialogs": [
              "240110108"
            ]
          },
          "240110108": {
            "id": "240110108",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Well, this is my main meal. I'll be going out with Roialte on business later, so I need to rush this meal.",
            "nextDialogs": [
              "240110109"
            ]
          },
          "240110109": {
            "id": "240110109",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "I'm not used to eating inside the Palais Mermonia, so I tend to go outside and find a quiet spot to get my meal squared away real quick.",
            "nextDialogs": [
              "240110110"
            ]
          },
          "240110110": {
            "id": "240110110",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "But today... I don't know what's making these gulls go wild, but they're coming at my fries all at once, and no matter how much they eat, it's not enough."
          }
        }
      }
    },
    {
      "subId": "2401104",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240110401"
        ],
        "dialogs": {
          "240110401": {
            "id": "240110401",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Thank you. I'll finish up my fries while they're gone.",
            "nextDialogs": [
              "240110402"
            ]
          },
          "240110402": {
            "id": "240110402",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "*sigh* But what do I do next time? I can't always count on your help, can I?"
          }
        }
      }
    },
    {
      "subId": "2401107",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240110701"
        ],
        "dialogs": {
          "240110701": {
            "id": "240110701",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Y—You really don't do things by halves, do you? All the gulls in the area have been scared off...",
            "nextDialogs": [
              "240110702"
            ]
          },
          "240110702": {
            "id": "240110702",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Thank you. I'll finish up my fries while they're not around to disturb me.",
            "nextDialogs": [
              "240110703"
            ]
          },
          "240110703": {
            "id": "240110703",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "*sigh* But what do I do next time? I can't always count on your help, can I?"
          }
        }
      }
    },
    {
      "subId": "2401112",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240111201"
        ],
        "dialogs": {
          "240111201": {
            "id": "240111201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Um, try eating somewhere else?",
            "nextDialogs": [
              "240111202"
            ]
          },
          "240111202": {
            "id": "240111202",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "I can't find anywhere better to eat now, anyway. If I'm too close to the Palais Mermonia, I might bump into one of my colleagues.",
            "nextDialogs": [
              "240111203"
            ]
          },
          "240111203": {
            "id": "240111203",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "And then I'll get dragged into their discussions of work again...",
            "nextDialogs": [
              "240111204"
            ]
          },
          "240111204": {
            "id": "240111204",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "But if I go too far away, I won't be able to get back to the office on time, and I might miss something important.",
            "nextDialogs": [
              "240111205"
            ]
          },
          "240111205": {
            "id": "240111205",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Considering these two factors, this place is my only option."
          }
        }
      }
    },
    {
      "subId": "2401113",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240111301"
        ],
        "dialogs": {
          "240111301": {
            "id": "240111301",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Ah, Violetgold Angler Gulls. Once you're done with these fries, please leave...",
            "nextDialogs": [
              "240111304"
            ]
          },
          "240111304": {
            "id": "240111304",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "No, not at all. When the gulls came for my fries, it turned tail and hid behind me, trembling.",
            "nextDialogs": [
              "240111305"
            ]
          },
          "240111305": {
            "id": "240111305",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "*sigh* Not that I blame the dog. Its breed have only ever had one duty — to love others and be loved by them. It has never learned to attack anything in its life.",
            "nextDialogs": [
              "240111306"
            ]
          },
          "240111306": {
            "id": "240111306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We have this duty too, you know.",
            "nextDialogs": [
              "240111307"
            ]
          },
          "240111307": {
            "id": "240111307",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Perhaps. But in some circumstances, love, too, may be considered a \"right.\" And where those things are concerned, things tend to proceed in difficult directions...",
            "nextDialogs": [
              "240111308"
            ]
          },
          "240111308": {
            "id": "240111308",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Sorry, I've said too much. I've had to handle many disputes of an emotional bent today, and I fear I haven't quite sorted myself out yet.",
            "nextDialogs": [
              "240111309"
            ]
          },
          "240111309": {
            "id": "240111309",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "*sigh* But right now, my most pressing task is to figure out how to safely finish my fries..."
          }
        }
      }
    },
    {
      "subId": "2401115",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240111501"
        ],
        "dialogs": {
          "240111501": {
            "id": "240111501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll find something else to feed them.",
            "nextDialogs": [
              "240111502"
            ]
          },
          "240111502": {
            "id": "240111502",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Hmm? That's not a bad idea. But can you really feed that many of them?",
            "nextDialogs": [
              "240111503"
            ]
          },
          "240111503": {
            "id": "240111503",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Well... Even if you can't, you just need to buy me enough time to eat my fries. Alright then, I leave this to you."
          }
        }
      }
    },
    {
      "subId": "2401150",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240115001"
        ],
        "dialogs": {
          "240115001": {
            "id": "240115001",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "The document that Roialte wants is... No, wait, I think I have this data wrong..."
          }
        }
      }
    },
    {
      "subId": "2401199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240119901"
        ],
        "dialogs": {
          "240119901": {
            "id": "240119901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Go on, bad seagull, shoo! Stop bothering people while they're eating!"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2401101",
      "subQuestName": "Talk to Iaune",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240111401"
        ],
        "dialogs": {
          "240111401": {
            "id": "240111401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We will chase them all away.",
            "nextDialogs": [
              "240111402"
            ]
          },
          "240111402": {
            "id": "240111402",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Sure, but could you focus on... only chasing them away? They just want my fries, but there's no malice in them.",
            "nextDialogs": [
              "240111403"
            ]
          },
          "240111403": {
            "id": "240111403",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Well, it is a bad thing for me, but it's not a very serious matter, so... Please, just chase them away, would you?"
          }
        }
      }
    },

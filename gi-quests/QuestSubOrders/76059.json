        "dialogs": {
          "760590101": {
            "id": "760590101",
            "speakerId": 15677,
            "speakerName": "Food-Obsessed Phantom",
            "text": "Ah, that's the stuff! That's the flavor!",
            "nextDialogs": [
              "760590102"
            ]
          },
          "760590102": {
            "id": "760590102",
            "speakerId": 15677,
            "speakerName": "Food-Obsessed Phantom",
            "text": "I started learning to cook when I was a teenager. The Smoked Fish Steak my Granny would make... That's what it tasted like.",
            "nextDialogs": [
              "760590103"
            ]
          },
          "760590103": {
            "id": "760590103",
            "speakerId": 15677,
            "speakerName": "Food-Obsessed Phantom",
            "text": "Only the older folks still make it in this flavor. Ah, how nostalgic.",
            "nextDialogs": [
              "760590104"
            ]
          },
          "760590104": {
            "id": "760590104",
            "speakerId": 15677,
            "speakerName": "Food-Obsessed Phantom",
            "text": "Granny could call out to me, telling me to eat: \"Jaakob! Granny's made fish! Eat it while it's fresh!\"",
            "nextDialogs": [
              "760590105"
            ]
          },
          "760590105": {
            "id": "760590105",
            "speakerId": 15677,
            "speakerName": "Food-Obsessed Phantom",
            "text": "It's been a long time since I last saw her... Maybe I'll go visit next month while I'm on leave... next month... how long has it been..."
          }
        }
      }
    }
  ]
}
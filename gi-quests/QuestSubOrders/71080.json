{
  "lineCounts": {
    "Black Screen": 7,
    "Paimon": 1,
    "Player": 13,
    "Taliesin": 32
  },
  "subQuests": [
    {
      "subId": "7108001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800101"
        ],
        "dialogs": {
          "710800101": {
            "id": "710800101",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "#Ho there, if it isn't {NICKNAME}, the great hero who subdued the Dragon of the East and saved my homeland! Well met, well met!"
          }
        }
      }
    },
    {
      "subId": "7108002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800607"
        ],
        "dialogs": {
          "710800607": {
            "id": "710800607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell of how you dispelled the Seven-Star Array...",
            "nextDialogs": [
              "710800608"
            ]
          },
          "710800608": {
            "id": "710800608",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You tell Taliesin of the things that happened...",
            "nextDialogs": [
              "710800609"
            ]
          },
          "710800609": {
            "id": "710800609",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "Huh... \"And so, with the aid of a faithful servant\"... Wait. No, that won't do.",
            "nextDialogs": [
              "710800610"
            ]
          },
          "710800610": {
            "id": "710800610",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "#\"With the aid of a faithful friend, {NICKNAME} breached the path leading to the mines!\"",
            "nextDialogs": [
              "710800611"
            ]
          },
          "710800611": {
            "id": "710800611",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Uh... Is this really okay? We didn't ask her permission to use her in the story...",
            "nextDialogs": [
              "710800612"
            ]
          },
          "710800612": {
            "id": "710800612",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "Ah, fret not, fret not! Heroes do not act as ordinary people might, and are not bound by such banal rules! Nobody will mind!"
          }
        }
      }
    },
    {
      "subId": "7108003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800613"
        ],
        "dialogs": {
          "710800613": {
            "id": "710800613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell of the darkness and the creatures from the Abyss...",
            "nextDialogs": [
              "710800614"
            ]
          },
          "710800614": {
            "id": "710800614",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You tell Taliesin of the things that happened...",
            "nextDialogs": [
              "710800615"
            ]
          },
          "710800615": {
            "id": "710800615",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "My, oh my. This is great. This is perfect! Give me a moment, let me write it all down.",
            "nextDialogs": [
              "710800616"
            ]
          },
          "710800616": {
            "id": "710800616",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "\"The dark fog pressed in like an avalanche, and the two apostles of the Abyss, now separated, disappeared without a trace, just as they had appeared...\""
          }
        }
      }
    },
    {
      "subId": "7108004",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800617"
        ],
        "dialogs": {
          "710800617": {
            "id": "710800617",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell of the azure crystal you found in the depths of the Chasm.",
            "nextDialogs": [
              "710800618"
            ]
          },
          "710800618": {
            "id": "710800618",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You tell Taliesin of the things that happened...",
            "nextDialogs": [
              "710800619"
            ]
          },
          "710800619": {
            "id": "710800619",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "\"The skies and the waters alike flowed across the crystal's surface, and the purple and red splotches faded...\"",
            "nextDialogs": [
              "710800620"
            ]
          },
          "710800620": {
            "id": "710800620",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "#\"The ancient creature of the ruins reeled, having taken a blow from {NICKNAME}'s iron fist, and it was at this moment that the star of the show arrived!\"",
            "nextDialogs": [
              "710800621"
            ]
          },
          "710800621": {
            "id": "710800621",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "\"...The mysterious ally that came to the Traveler's aid had vanished without a trace, but the giant construct serpent had already been shattered to pieces by the crystal...\""
          }
        }
      }
    },
    {
      "subId": "7108005",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800622"
        ],
        "dialogs": {
          "710800622": {
            "id": "710800622",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell of the fluorescent fungi in the caves...",
            "nextDialogs": [
              "710800623"
            ]
          },
          "710800623": {
            "id": "710800623",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You tell Taliesin of the things that happened...",
            "nextDialogs": [
              "710800624"
            ]
          },
          "710800624": {
            "id": "710800624",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "Fascinating... Almost unthinkable, really... Let me think for a moment before I say anything.",
            "nextDialogs": [
              "710800625"
            ]
          },
          "710800625": {
            "id": "710800625",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "\"And though it be a giant mushroom towering unto the sky, it was helpless before the encroaching dark...\"",
            "nextDialogs": [
              "710800626"
            ]
          },
          "710800626": {
            "id": "710800626",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "#\"Answering the call, {NICKNAME} came forth, purifying the land and staving the crisis off...\""
          }
        }
      }
    },
    {
      "subId": "7108006",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800629"
        ],
        "dialogs": {
          "710800629": {
            "id": "710800629",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell of the nine Black Serpent Knights...",
            "nextDialogs": [
              "710800630"
            ]
          },
          "710800630": {
            "id": "710800630",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You tell Taliesin of the things that happened...",
            "nextDialogs": [
              "710800631"
            ]
          },
          "710800631": {
            "id": "710800631",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "This... This is wonderful! \"And so, the fated Traveler said: 'Forget coming at me one by one. I could take all nine of you on at once!'\"",
            "nextDialogs": [
              "710800632"
            ]
          },
          "710800632": {
            "id": "710800632",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh, that's a bit of an exaggeration...",
            "nextDialogs": [
              "710800633"
            ]
          },
          "710800633": {
            "id": "710800633",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "It's alright... Now, if you'll allow me, I might exercise some creative license with the former lives of those nine swordsmen..."
          }
        }
      }
    },
    {
      "subId": "7108007",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800634"
        ],
        "dialogs": {
          "710800634": {
            "id": "710800634",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell of your search for your kin...",
            "nextDialogs": [
              "710800635"
            ]
          },
          "710800635": {
            "id": "710800635",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You tell Taliesin of the things that happened...",
            "nextDialogs": [
              "710800636"
            ]
          },
          "710800636": {
            "id": "710800636",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "That is... fascinating indeed. An ancient, forgotten land, sacrifices that went unacknowledged, and an unjust punishment to fall into folly... What huge themes! What an expansive tale!",
            "nextDialogs": [
              "710800637"
            ]
          },
          "710800637": {
            "id": "710800637",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "And to think that such stories are things that you've encountered in your travels, and that are so very close to your own aims...",
            "nextDialogs": [
              "710800638"
            ]
          },
          "710800638": {
            "id": "710800638",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "Thank you for sharing all these with me. I will record them down. That said, I don't believe that I shall compose a poem from them yet... I believe that these will only be small fragments of your saga.",
            "nextDialogs": [
              "710800639"
            ]
          },
          "710800639": {
            "id": "710800639",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "I will not tell your tale with the limited skill that I have... I ask only that you tell me of your journey once it is complete.",
            "nextDialogs": [
              "710800640"
            ]
          },
          "710800640": {
            "id": "710800640",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "My intuition tells me that when that day comes, my ears shall be blessed with the most heroic tale known to this world."
          }
        }
      }
    },
    {
      "subId": "7108008",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800641"
        ],
        "dialogs": {
          "710800641": {
            "id": "710800641",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell of the Fatui who met with a crisis...",
            "nextDialogs": [
              "710800642"
            ]
          },
          "710800642": {
            "id": "710800642",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You tell Taliesin of the things that happened...",
            "nextDialogs": [
              "710800643"
            ]
          },
          "710800643": {
            "id": "710800643",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "Haha! That's such an interesting story! \"'A bitter day this is, that we should be saved by our great foe!' Serzhant Anton exclaimed with a sigh...\"",
            "nextDialogs": [
              "710800644"
            ]
          },
          "710800644": {
            "id": "710800644",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "\"Yet those who meet as friends today, tomorrow may meet as foes.\""
          }
        }
      }
    },
    {
      "subId": "7108011",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800701"
        ],
        "dialogs": {
          "710800701": {
            "id": "710800701",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "Thank you for helping me finish this epic poem... Ah, yes. Please, take this copy of my manuscript as thanks!",
            "nextDialogs": [
              "710800702"
            ]
          },
          "710800702": {
            "id": "710800702",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "Phew... This epic manuscript carries both my emotions and ambitions. Please, take it. It is what little I can do to repay you."
          }
        }
      }
    },
    {
      "subId": "7108002",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800201"
        ],
        "dialogs": {
          "710800201": {
            "id": "710800201",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "#You've come, {NICKNAME}, challenger of the Fatui Harbinger, and deliverer of Liyue from its monstrous sea-foes!"
          }
        }
      }
    },
    {
      "subId": "7108003",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800301"
        ],
        "dialogs": {
          "710800301": {
            "id": "710800301",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "#Ah, if it isn't the one who dispersed the great storm that lay over the land of thunder, {NICKNAME}! Come, come!"
          }
        }
      }
    },
    {
      "subId": "7108004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800401"
        ],
        "dialogs": {
          "710800401": {
            "id": "710800401",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "#Hail to you, {NICKNAME}, great adventurer who once strode up to Dragonspine's very summit!"
          }
        }
      }
    },
    {
      "subId": "7108005",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800501"
        ],
        "dialogs": {
          "710800501": {
            "id": "710800501",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "Well met, Traveler, before whom even Fatui Harbingers had to admit defeat in distant lands!"
          }
        }
      }
    },
    {
      "subId": "7108006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710800601"
        ],
        "dialogs": {
          "710800601": {
            "id": "710800601",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "This might seem a little sudden, good hero, but could you spare a moment to tell me a story or two of yours for me to turn into songs for those who come after?",
            "nextDialogs": [
              "710800604"
            ]
          },
          "710800604": {
            "id": "710800604",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "I would be most grateful if you were to agree! Well then, fire away! I'm listening."
          },
          "710800605": {
            "id": "710800605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell of your adventures in The Chasm.",
            "nextDialogs": [
              "710800606"
            ]
          },
          "710800606": {
            "id": "710800606",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "Alright then. Please, do go on.",
            "nextDialogs": [
              "710800627"
            ]
          },
          "710800627": {
            "id": "710800627",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell of the people you've met and the things you've seen.",
            "nextDialogs": [
              "710800628"
            ]
          },
          "710800628": {
            "id": "710800628",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "Yes, please do tell me everything. I am all ears.",
            "nextDialogs": [
              "710800645"
            ]
          },
          "710800645": {
            "id": "710800645",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "See you.",
            "nextDialogs": [
              "710800646"
            ]
          },
          "710800646": {
            "id": "710800646",
            "speakerId": 1000,
            "speakerName": "Taliesin",
            "text": "#May all go well with you. Thank you for your time, {NICKNAME} — and may your valor be known throughout the world!"
          }
        }
      }
    }
  ]
}
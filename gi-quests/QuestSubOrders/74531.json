  "subQuests": [
    {
      "subId": "7453101",
      "subQuestName": "Talk to Ninette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745310101"
        ],
        "dialogs": {
          "745310101": {
            "id": "745310101",
            "speakerId": 1000,
            "speakerName": "Ninette",
            "text": "#{NICKNAME}, Paimon, you're back!",
            "nextDialogs": [
              "745310104"
            ]
          },
          "745310104": {
            "id": "745310104",
            "speakerId": 1000,
            "speakerName": "Ninette",
            "text": "That's wonderful! Thank you so much for your help!",
            "nextDialogs": [
              "745310105"
            ]
          },
          "745310105": {
            "id": "745310105",
            "speakerId": 1000,
            "speakerName": "Ninette",
            "text": "While you were busy taking those photos, I started thinking I can't just stand by and do nothing, or I'll never make any progress...",
            "nextDialogs": [
              "745310106"
            ]
          },
          "745310106": {
            "id": "745310106",
            "speakerId": 1000,
            "speakerName": "Ninette",
            "text": "So I worked up the courage to ask a few passersby for help, and I even managed to take quite a few shots myself! I think that should be plenty of data for testing.",
            "nextDialogs": [
              "745310107"
            ]
          },
          "745310107": {
            "id": "745310107",
            "speakerId": 1001,
            "speakerName": "Lepine-Pauline",
            "text": "#Heh, I knew you wouldn't let me down! Thanks to {NICKNAME} for stepping in as well.",
            "nextDialogs": [
              "745310108"
            ]
          },
          "745310108": {
            "id": "745310108",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Lepine-Pauline! When did you get back? Ninette said you've been busy with something else lately.",
            "nextDialogs": [
              "745310109"
            ]
          },
          "745310109": {
            "id": "745310109",
            "speakerId": 1001,
            "speakerName": "Lepine-Pauline",
            "text": "Well obviously, it's a massive deal — enough to fill my pockets to the brim!",
            "nextDialogs": [
              "745310110"
            ]
          },
          "745310110": {
            "id": "745310110",
            "speakerId": 1001,
            "speakerName": "Lepine-Pauline",
            "text": "Things got pretty busy for me lately, so I'm really glad you were there to help Ninette out.",
            "nextDialogs": [
              "745310111"
            ]
          },
          "745310111": {
            "id": "745310111",
            "speakerId": 1001,
            "speakerName": "Lepine-Pauline",
            "text": "She's got the talent and the taste, that's for sure. She's just a bit shy. But with your help, she's really taken an important step forward.",
            "nextDialogs": [
              "745310112"
            ]
          },
          "745310112": {
            "id": "745310112",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So, what's this \"massive deal\" you've been so mysterious about? Don't tell Paimon you heard another wild rumor and went all in again!",
            "nextDialogs": [
              "745310113"
            ]
          },
          "745310113": {
            "id": "745310113",
            "speakerId": 1001,
            "speakerName": "Lepine-Pauline",
            "text": "What? Of course not! I've learned my lesson. This time it's the real deal — safe and sure to make a fortune!",
            "nextDialogs": [
              "745310114"
            ]
          },
          "745310114": {
            "id": "745310114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(That doesn't sound entirely convincing...)",
            "nextDialogs": [
              "745310115"
            ]
          },
          "745310115": {
            "id": "745310115",
            "speakerId": 1001,
            "speakerName": "Lepine-Pauline",
            "text": "Hmph, if I tell you now, it'll ruin the surprise. Once it's done, you'll be the first to try it out!"
          }
        }
      }
    }
  ]
}
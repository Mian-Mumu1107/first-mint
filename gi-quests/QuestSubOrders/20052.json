  "subQuests": [
    {
      "subId": "2005201",
      "subQuestName": "Talk to Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200520101"
        ],
        "dialogs": {
          "200520101": {
            "id": "200520101",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Alright. Let's work hard today, too!",
            "nextDialogs": [
              "200520103",
              "200520107"
            ]
          },
          "200520103": {
            "id": "200520103",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Of course! Being an adventurer is really interesting!",
            "nextDialogs": [
              "200520104"
            ]
          },
          "200520104": {
            "id": "200520104",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Well... I still am a bit unfamiliar with what to do while undertaking commissions, though.",
            "nextDialogs": [
              "200520105"
            ]
          },
          "200520105": {
            "id": "200520105",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Traveler, would you mind coming with me again? I still have things I'd like to ask you.",
            "nextDialogs": [
              "200520108"
            ]
          },
          "200520108": {
            "id": "200520108",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Then let's set out. Today's commission is...",
            "nextDialogs": [
              "200520109"
            ]
          },
          "200520109": {
            "id": "200520109",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Huh... So we're escorting... another transport balloon."
          },
          "200520107": {
            "id": "200520107",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Would you? Hehe, sure! There's still so much I could learn from you."
          }
        }
      }
    },
    {
      "subId": "2005202",
      "subQuestName": "Go with Anna to complete her Adventurers' Guild commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200520201"
        ],
        "dialogs": {
          "200520201": {
            "id": "200520201",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "And we're done! Thanks, Traveler. This went pretty well, I think.",
            "nextDialogs": [
              "200520202"
            ]
          },
          "200520202": {
            "id": "200520202",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "But is this the usual fare for adventurers?",
            "nextDialogs": [
              "200520204",
              "200520206"
            ]
          },
          "200520204": {
            "id": "200520204",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "What's with that hapless tone...",
            "nextDialogs": [
              "200520207"
            ]
          },
          "200520207": {
            "id": "200520207",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Is that so... Nice! I'll keep working at it, then!",
            "nextDialogs": [
              "200520208"
            ]
          },
          "200520208": {
            "id": "200520208",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Once I've saved up enough Mora, I'll bring my brother and our parents out on a trip!",
            "nextDialogs": [
              "200520209"
            ]
          },
          "200520209": {
            "id": "200520209",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "My brother always wanted to travel... But I fell ill, and he had to stay back to take care of me.",
            "nextDialogs": [
              "200520210"
            ]
          },
          "200520210": {
            "id": "200520210",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "But I'm well now, and I've even become an adventurer.",
            "nextDialogs": [
              "200520211"
            ]
          },
          "200520211": {
            "id": "200520211",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Hehe. When the time comes, I'll help my brother fulfill some of his dreams too!"
          },
          "200520206": {
            "id": "200520206",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Hey, not that tired look..."
          }
        }
      }
    },
    {
      "subId": "2005203",
      "subQuestName": "Go with Anna to complete her Adventurers' Guild commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200520301"
        ],
        "dialogs": {
          "200520301": {
            "id": "200520301",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "Please take care of Anna, Traveler. Her excitement might have gotten to her head lately...",
            "nextDialogs": [
              "200520302"
            ]
          },
          "200520302": {
            "id": "200520302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you not want her to become an adventurer?",
            "nextDialogs": [
              "200520303"
            ]
          },
          "200520303": {
            "id": "200520303",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "...",
            "nextDialogs": [
              "200520304"
            ]
          },
          "200520304": {
            "id": "200520304",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "I respect my sister's wishes.",
            "nextDialogs": [
              "200520305"
            ]
          },
          "200520305": {
            "id": "200520305",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "Now that she's well again after such a long struggle with her illness, she deserves a chance to pursue her dreams.",
            "nextDialogs": [
              "200520306"
            ]
          },
          "200520306": {
            "id": "200520306",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "As her brother, I'll support her... all the way.",
            "nextDialogs": [
              "200520307"
            ]
          },
          "200520307": {
            "id": "200520307",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "That's all I have to say."
          }
        }
      }
    },

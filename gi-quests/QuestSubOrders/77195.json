      "dialogue": {
        "startDialogs": [
          "771950101"
        ],
        "dialogs": {
          "771950101": {
            "id": "771950101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What... is this?",
            "nextDialogs": [
              "771950102"
            ]
          },
          "771950102": {
            "id": "771950102",
            "speakerId": 1001,
            "speakerName": "Eye of Graeae",
            "text": "This is a function of the Shadow Realm that has been set up as a shooting range... Once upon a time, (...) and (...) also used this function to train...",
            "nextDialogs": [
              "771950103"
            ]
          },
          "771950103": {
            "id": "771950103",
            "speakerId": 1001,
            "speakerName": "Eye of Graeae",
            "text": "To further simulate the environment within the depths of the Shadow Realm and prepare for deeper delves into it...",
            "nextDialogs": [
              "771950104"
            ]
          },
          "771950104": {
            "id": "771950104",
            "speakerId": 1001,
            "speakerName": "Eye of Graeae",
            "text": "...",
            "nextDialogs": [
              "771950105"
            ]
          },
          "771950105": {
            "id": "771950105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What's the matter?",
            "nextDialogs": [
              "771950106"
            ]
          },
          "771950106": {
            "id": "771950106",
            "speakerId": 1001,
            "speakerName": "Eye of Graeae",
            "text": "Strange. These memories appear to have been erased.",
            "nextDialogs": [
              "771950107"
            ]
          },
          "771950107": {
            "id": "771950107",
            "speakerId": 1001,
            "speakerName": "Eye of Graeae",
            "text": "But anyway, you can use this device to simulate a Shadow Realm, or the more oppressive Deep Shadow Realm...",
            "nextDialogs": [
              "771950108"
            ]
          },
          "771950108": {
            "id": "771950108",
            "speakerId": 1001,
            "speakerName": "Eye of Graeae",
            "text": "You can even complete the training to unlock the corresponding access to blueprints for stronger firearms.",
            "nextDialogs": [
              "771950109"
            ]
          },
          "771950109": {
            "id": "771950109",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ohh, so we train in here, and then we get the keys to unlock even stronger weapons!",
            "nextDialogs": [
              "771950110"
            ]
          },
          "771950110": {
            "id": "771950110",
            "speakerId": 1001,
            "speakerName": "Eye of Graeae",
            "text": "That is the case. I applaud your swift understanding. In that case, please follow my instructions...",
            "nextDialogs": [
              "771950111"
            ]
          },
          "771950111": {
            "id": "771950111",
            "speakerId": 1001,
            "speakerName": "Eye of Graeae",
            "text": "The firearms and accessories within the trophy case here are designed for those who have completed Shadow Realm training and Deep Shadow Realm cleansing operations.",
            "nextDialogs": [
              "771950112"
            ]
          },
          "771950112": {
            "id": "771950112",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, so that's how it is!",
            "nextDialogs": [
              "771950113"
            ]
          },
          "771950113": {
            "id": "771950113",
            "speakerId": 1001,
            "speakerName": "Eye of Graeae",
            "text": "In that case, that's all for the instructions. I recommend that you make preparations when you have time and try the facilities...",
            "nextDialogs": [
              "771950114"
            ]
          },
          "771950114": {
            "id": "771950114",
            "speakerId": 1001,
            "speakerName": "Eye of Graeae",
            "text": ""
          }
        }
      }

  "subQuests": [
    {
      "subId": "7218301",
      "subQuestName": "Talk to Madarame Hyakubei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721830101"
        ],
        "dialogs": {
          "721830101": {
            "id": "721830101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "These are... seeds?",
            "nextDialogs": [
              "721830102"
            ]
          },
          "721830102": {
            "id": "721830102",
            "speakerId": 1001,
            "speakerName": "Madarame Hyakubei",
            "text": "These are Naku Weed seeds.",
            "nextDialogs": [
              "721830103"
            ]
          },
          "721830103": {
            "id": "721830103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You know about this plant?",
            "nextDialogs": [
              "721830104"
            ]
          },
          "721830104": {
            "id": "721830104",
            "speakerId": 1001,
            "speakerName": "Madarame Hyakubei",
            "text": "Well, I kind of know about it. I've seen this plant before and I've heard people talk about its wonders.",
            "nextDialogs": [
              "721830105"
            ]
          },
          "721830105": {
            "id": "721830105",
            "speakerId": 1001,
            "speakerName": "Madarame Hyakubei",
            "text": "I remember that... even in the absence of wind, this plant will tremble slightly to the sound of thunder...",
            "nextDialogs": [
              "721830106"
            ]
          },
          "721830106": {
            "id": "721830106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Does it look good when grown?",
            "nextDialogs": [
              "721830107"
            ]
          },
          "721830107": {
            "id": "721830107",
            "speakerId": 1001,
            "speakerName": "Madarame Hyakubei",
            "text": "If we're talking about appearance alone... I daresay it looks rather nice indeed.",
            "nextDialogs": [
              "721830108"
            ]
          },
          "721830108": {
            "id": "721830108",
            "speakerId": 1001,
            "speakerName": "Madarame Hyakubei",
            "text": "Would you like to try growing some Naku Weeds? But I don't believe there to be any suitable land hereabouts...",
            "nextDialogs": [
              "721830109"
            ]
          },
          "721830109": {
            "id": "721830109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I have my own plot of land.",
            "nextDialogs": [
              "721830110"
            ]
          },
          "721830110": {
            "id": "721830110",
            "speakerId": 1001,
            "speakerName": "Madarame Hyakubei",
            "text": "Oh, is that so? As expected of you... So, you have even been gifted land already?",
            "nextDialogs": [
              "721830111"
            ]
          },
          "721830111": {
            "id": "721830111",
            "speakerId": 1001,
            "speakerName": "Madarame Hyakubei",
            "text": "Pardon me for asking, but is your land...",
            "nextDialogs": [
              "721830113",
              "721830116"
            ]
          },
          "721830113": {
            "id": "721830113",
            "speakerId": 1001,
            "speakerName": "Madarame Hyakubei",
            "text": "#Oh! I have also heard tell of your feats in Mondstadt and Liyue, {F#Madam}{M#Sir}.",
            "nextDialogs": [
              "721830114"
            ]
          },
          "721830114": {
            "id": "721830114",
            "speakerId": 1001,
            "speakerName": "Madarame Hyakubei",
            "text": "Indeed, it would be more surprising if you were not gifted land for such deeds!",
            "nextDialogs": [
              "721830120"
            ]
          },
          "721830120": {
            "id": "721830120",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Hey, {NICKNAME}, the land you're talking about is the Serenitea Pot that Granny gave us, right?",
            "nextDialogs": [
              "721830121"
            ]
          },
          "721830121": {
            "id": "721830121",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Can you really grow things in there? Granny didn't say anything about it before..."
          },
          "721830116": {
            "id": "721830116",
            "speakerId": 1001,
            "speakerName": "Madarame Hyakubei",
            "text": "#A t—teapot? {F#Madam}{M#Sir}, please don't play such a joke on me.",
            "nextDialogs": [
              "721830117"
            ]
          },
          "721830117": {
            "id": "721830117",
            "speakerId": 1001,
            "speakerName": "Madarame Hyakubei",
            "text": "I have also heard tell of your feats in Mondstadt and Liyue.",
            "nextDialogs": [
              "721830118"
            ]
          },
          "721830118": {
            "id": "721830118",
            "speakerId": 1001,
            "speakerName": "Madarame Hyakubei",
            "text": "So I guess that your land is either in Liyue or in Mondstadt.",
            "nextDialogs": [
              "721830119"
            ]
          },
          "721830119": {
            "id": "721830119",
            "speakerId": 1001,
            "speakerName": "Madarame Hyakubei",
            "text": "#As expected of you, {F#Madam}{M#Sir}."
          }
        }
      }
    },
    {
      "subId": "7218302",
      "subQuestName": "Talk to Madame Ping",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721830201"
        ],
        "dialogs": {
          "721830201": {
            "id": "721830201",
            "speakerId": 1002,
            "speakerName": "Madame Ping",
            "text": "Hmm? Hello children, are you here to see me?",
            "nextDialogs": [
              "721830202"
            ]
          },
          "721830202": {
            "id": "721830202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the Naku Weed seeds...",
            "nextDialogs": [
              "721830203"
            ]
          },
          "721830203": {
            "id": "721830203",
            "speakerId": 1002,
            "speakerName": "Madame Ping",
            "text": "Seeds... Ah, so you'd like to grow these seeds in the Serenitea Pot?",
            "nextDialogs": [
              "721830204"
            ]
          },
          "721830204": {
            "id": "721830204",
            "speakerId": 1002,
            "speakerName": "Madame Ping",
            "text": "I suppose that's no problem. The Serenitea Pot is your little realm, after all.",
            "nextDialogs": [
              "721830205"
            ]
          },
          "721830205": {
            "id": "721830205",
            "speakerId": 1002,
            "speakerName": "Madame Ping",
            "text": "It's just that you've only brought this bag of seeds today. Are you only planning to plant this one bag of seeds?",
            "nextDialogs": [
              "721830206"
            ]
          },
          "721830206": {
            "id": "721830206",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, that's right! We don't even know how to collect seeds...",
            "nextDialogs": [
              "721830207"
            ]
          },
          "721830207": {
            "id": "721830207",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "After we plant this bag of seeds, where do we go to find more...",
            "nextDialogs": [
              "721830208"
            ]
          },
          "721830208": {
            "id": "721830208",
            "speakerId": 1002,
            "speakerName": "Madame Ping",
            "text": "There, there, don't worry. I happen to have a little box here that I used many years ago.",
            "nextDialogs": [
              "721830209"
            ]
          },
          "721830209": {
            "id": "721830209",
            "speakerId": 1002,
            "speakerName": "Madame Ping",
            "text": "When I used to plant flowers, they were all kept in this little box. The flowers grown in the box can be preserved for a long time.",
            "nextDialogs": [
              "721830210"
            ]
          },
          "721830210": {
            "id": "721830210",
            "speakerId": 1002,
            "speakerName": "Madame Ping",
            "text": "Moreover, after putting the flowers in the box, it can produce several flower seeds... This makes sowing them very convenient indeed.",
            "nextDialogs": [
              "721830211"
            ]
          },
          "721830211": {
            "id": "721830211",
            "speakerId": 1002,
            "speakerName": "Madame Ping",
            "text": "Although this box is somewhat less useful now... but it still retains the power to \"generate seeds.\"",
            "nextDialogs": [
              "721830212"
            ]
          },
          "721830212": {
            "id": "721830212",
            "speakerId": 1002,
            "speakerName": "Madame Ping",
            "text": "Hmm... I don't use it much now anyway... So, why don't I give it to you?",
            "nextDialogs": [
              "721830213"
            ]
          },
          "721830213": {
            "id": "721830213",
            "speakerId": 1002,
            "speakerName": "Madame Ping",
            "text": "This box should come in handy, whether you want to grow some flowers and plants, or some crops.",
            "nextDialogs": [
              "721830214"
            ]
          },
          "721830214": {
            "id": "721830214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thank you, Granny!",
            "nextDialogs": [
              "721830215"
            ]
          },
          "721830215": {
            "id": "721830215",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Thank you, Granny!",
            "nextDialogs": [
              "721830216"
            ]
          },
          "721830216": {
            "id": "721830216",
            "speakerId": 1002,
            "speakerName": "Madame Ping",
            "text": "Oh children, you don't have to be so polite. Go ahead and give it a try, but I must say that it's not an easy task to take care of flowers and plants, so you should be prepared.",
            "nextDialogs": [
              "721830217"
            ]
          },
          "721830217": {
            "id": "721830217",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Granny is really powerful indeed... but before we try that box out, let's go back to our teapot and try to sow those seeds.",
            "nextDialogs": [
              "721830218"
            ]
          },
          "721830218": {
            "id": "721830218",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, Paimon really hopes that they'll grow soon..."
          }
        }
      }
    }
  ]
}
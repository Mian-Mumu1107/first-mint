        ],
        "dialogs": {
          "40030101": {
            "id": "40030101",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "Oh, it's you two. Did Miss Navia invite you to come pay your respects to her father?",
            "nextDialogs": [
              "40030102"
            ]
          },
          "40030102": {
            "id": "40030102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Mhm! We ran into Navia on the streets today, so we just followed her here.",
            "nextDialogs": [
              "40030103"
            ]
          },
          "40030103": {
            "id": "40030103",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "I see, I see. Then, is there something that I can help you with?",
            "nextDialogs": [
              "40030104"
            ]
          },
          "40030104": {
            "id": "40030104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah... Um... Well, it's pretty hard to run into you like this, since you're usually super busy, so we figured we could try to ask you a few questions, if that's okay...",
            "nextDialogs": [
              "40030105"
            ]
          },
          "40030105": {
            "id": "40030105",
            "speakerId": 1076,
            "speakerName": "Neuvillette",
            "text": "Please feel free. Though outsiders, you helped us solve one of the greatest mysteries in Fontaine, and it would be my pleasure to return the favor."
          }
        }
      }
    },
    {
      "subId": "4003199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400319901"
        ],
        "dialogs": {
          "400319901": {
            "id": "400319901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That should be all the animals in this area. Time to look for Ryuuji!",
            "nextDialogs": [
              "400319902"
            ]
          },
          "400319902": {
            "id": "400319902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, so they're the ones who stole the animals!",
            "nextDialogs": [
              "400319903"
            ]
          },
          "400319903": {
            "id": "400319903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#These rascals! C'mon, {NICKNAME}, time to show them what's what!"
          }
        }
      }
    },
    {
      "subId": "4003499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400349901"
        ],
        "dialogs": {
          "400349901": {
            "id": "400349901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Ryuuji's not in. Let's go ask Sango, then.",
            "nextDialogs": [
              "400349902"
            ]
          },
          "400349902": {
            "id": "400349902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sango said that this should be the place. Let's look around and see if we can find Ryuuji.",
            "nextDialogs": [
              "400349903"
            ]
          },
          "400349903": {
            "id": "400349903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There! There he is! C'mon, let's go meet him.",
            "nextDialogs": [
              "400349904"
            ]
          },
          "400349904": {
            "id": "400349904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Ugh, these guys are back! Guess it's come down to a fight after all, huh? Be careful not to hurt the animals, {NICKNAME}!",
            "nextDialogs": [
              "400349905"
            ]
          },
          "400349905": {
            "id": "400349905",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "It's fine. Fight as you wish. I'll take the animals someplace safe.",
            "nextDialogs": [
              "400349906"
            ]
          },
          "400349906": {
            "id": "400349906",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#It's attacking us! {NICKNAME}, you've gotta calm it down somehow!"
          }
        }
      }
    }
  ]

            ]
          },
          "207412005": {
            "id": "207412005",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "Regardless, I do hope that Lord Barbatos will be able to hear my voice.",
            "nextDialogs": [
              "207412006"
            ]
          },
          "207412006": {
            "id": "207412006",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "Thank you for your willingness to help. Please take this for your troubles — and may the Anemo Archon protect you."
          },
          "207412004": {
            "id": "207412004",
            "speakerId": 1000,
            "speakerName": "Grace",
            "text": "That's wonderful. It should be easy for Lord Barbatos to notice."
          }
        }

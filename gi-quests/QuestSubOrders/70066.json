          },
          "100031302": {
            "id": "100031302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, Chang the Ninth! We have something for you!",
            "nextDialogs": [
              "100031303"
            ]
          },
          "100031303": {
            "id": "100031303",
            "speakerId": 1624,
            "speakerName": "Chang the Ninth",
            "text": "Oh? What is—",
            "nextDialogs": [
              "100031304"
            ]
          },
          "100031304": {
            "id": "100031304",
            "speakerId": 1624,
            "speakerName": "Chang the Ninth",
            "text": "What? Where did all this Mora come from!?",
            "nextDialogs": [
              "100031305"
            ]
          },
          "100031305": {
            "id": "100031305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "About that... So, um, the thing is... Right! Mr. Nine really admires your work, so he decided to fund your writing career!",
            "nextDialogs": [
              "100031306"
            ]
          },
          "100031306": {
            "id": "100031306",
            "speakerId": 1624,
            "speakerName": "Chang the Ninth",
            "text": "Wait, what? So... channeling Mr. Nine actually worked!? I can't believe it!",
            "nextDialogs": [
              "100031307"
            ]
          },
          "100031307": {
            "id": "100031307",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Of course, for Chang the Ninth, wealth pales in comparison to his craft. The matter of Mora is swiftly forgotten as he puts pen back to paper. \\n\\nThus, you continue on back to Mondstadt..."
          }
        }
      }
    }

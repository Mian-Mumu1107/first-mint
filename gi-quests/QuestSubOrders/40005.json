    {
      "subId": "4000502",
      "subQuestName": "Meet the sender at the meeting spot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400050201"
        ],
        "dialogs": {
          "400050201": {
            "id": "400050201",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Alright, you folks from the Treasure Hoarders, yeah? I thought I insinuated in my letter there that you should have done like I done and put on a mask and a costume and so forth...",
            "nextDialogs": [
              "400050202"
            ]
          },
          "400050202": {
            "id": "400050202",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "...But it seems you didn't all get the memo. Hehehe... it's pretty cool though... gutsy.",
            "nextDialogs": [
              "400050203"
            ]
          },
          "400050203": {
            "id": "400050203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph! Well guess what? We don't need to go sneaking around everywhere wearing disguises! Because unlike you, we would never do anything so shameful that we would need to wear masks while doing it!",
            "nextDialogs": [
              "400050204"
            ]
          },
          "400050204": {
            "id": "400050204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really!? I was in the middle of my speech and everything!",
            "nextDialogs": [
              "400050207"
            ]
          },
          "400050207": {
            "id": "400050207",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Wait a second now... You folks ain't no Treasure Hoarders! What game are you two playing!?"
          }
        }
      }
    },
    {
      "subId": "4000503",
      "subQuestName": "Defeat the suspicious person",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4000504",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400050401"
        ],
        "dialogs": {
          "400050401": {
            "id": "400050401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Tell us your diabolical plan, now! It's over, buster!",
            "nextDialogs": [
              "400050402"
            ]
          },
          "400050402": {
            "id": "400050402",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Okay! I give up!",
            "nextDialogs": [
              "400050403"
            ]
          },
          "400050403": {
            "id": "400050403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Give up now or feel the wrath of my Paimonial... Huh? You're giving up just like that?",
            "nextDialogs": [
              "400050404"
            ]
          },
          "400050404": {
            "id": "400050404",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I, uh... I'm just a lowly apprentice thief who really looks up to the Treasure Hoarders...",
            "nextDialogs": [
              "400050405"
            ]
          },
          "400050405": {
            "id": "400050405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "An apprentice thief!?",
            "nextDialogs": [
              "400050406"
            ]
          },
          "400050406": {
            "id": "400050406",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Yeah... For a greenhorn like me, 'specially working on my own an' all... The Treasure Hoarders? Man, they're my heroes...",
            "nextDialogs": [
              "400050407"
            ]
          },
          "400050407": {
            "id": "400050407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait a second, so—",
            "nextDialogs": [
              "400050408"
            ]
          },
          "400050408": {
            "id": "400050408",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "...So, I thought I'd try and set up some sorta lucrative opportunity, then submit my pledge of loyalty...",
            "nextDialogs": [
              "400050409"
            ]
          },
          "400050409": {
            "id": "400050409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait a second! None of this is making any sense!",
            "nextDialogs": [
              "400050410"
            ]
          },
          "400050410": {
            "id": "400050410",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon was expecting a serial arsonist to be someone more... sinister! Evil-looking! But instead... We get you!?",
            "nextDialogs": [
              "400050411"
            ]
          },
          "400050411": {
            "id": "400050411",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "...Arson? What the heck are you talking about?",
            "nextDialogs": [
              "400050412"
            ]
          },
          "400050412": {
            "id": "400050412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Don't pretend! Paimon's seen you, loitering around piles of highly flammable materials!",
            "nextDialogs": [
              "400050413"
            ]
          },
          "400050413": {
            "id": "400050413",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Oh... Oh yeah, yeah, I know where you're talkin' about. But I was only checking the place out.",
            "nextDialogs": [
              "400050414"
            ]
          },
          "400050414": {
            "id": "400050414",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "My plan ain't got nothing to do with those lantern construction materials.",
            "nextDialogs": [
              "400050415"
            ]
          },
          "400050415": {
            "id": "400050415",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Are you serious!?",
            "nextDialogs": [
              "400050416"
            ]
          },
          "400050416": {
            "id": "400050416",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I just wanted to nab me the biggest chunk of Plaustrite in twenty years is all...",
            "nextDialogs": [
              "400050417"
            ]
          },
          "400050417": {
            "id": "400050417",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I was gonna wait till nightfall, chop off half the tethers, float it out to sea...",
            "nextDialogs": [
              "400050418"
            ]
          },
          "400050418": {
            "id": "400050418",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh...",
            "nextDialogs": [
              "400050419"
            ]
          },
          "400050419": {
            "id": "400050419",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Then all I'd have to do is find some way or another of bringing it down, so I could hide it underwater in the shallows. The perfect crime!",
            "nextDialogs": [
              "400050420"
            ]
          },
          "400050420": {
            "id": "400050420",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh, for a perfect crime, it sure has a lot of holes... For example, how exactly were you planning to bring down the Plaustrite once it was airborne?",
            "nextDialogs": [
              "400050421"
            ]
          },
          "400050421": {
            "id": "400050421",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I was still in the process of figuring out the details, hence why I hadn't made my move yet.",
            "nextDialogs": [
              "400050422"
            ]
          },
          "400050422": {
            "id": "400050422",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This guy is an imbecile!",
            "nextDialogs": [
              "400050423"
            ]
          },
          "400050423": {
            "id": "400050423",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Okay, {NICKNAME}, let's teach him a lesson.",
            "nextDialogs": [
              "400050424"
            ]
          },
          "400050424": {
            "id": "400050424",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's go find Yaksha-man and debrief."
          }
        }
      }
    },
    {
      "subId": "4000505",
      "subQuestName": "Talk to Xiao at the meeting spot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400050501"
        ],
        "dialogs": {
          "400050501": {
            "id": "400050501",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "I see. Human stupidity is infinite in its randomness... But it is of no consequence to me.",
            "nextDialogs": [
              "400050502"
            ]
          },
          "400050502": {
            "id": "400050502",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Now. I am here, at the place you insisted upon. The Mingxiao Lantern is in sight. Why did you summon me here?",
            "nextDialogs": [
              "400050505"
            ]
          },
          "400050505": {
            "id": "400050505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You are obviously one of the heroes this festival is all about... Why don't you want to get involved?",
            "nextDialogs": [
              "400050506"
            ]
          },
          "400050506": {
            "id": "400050506",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "I cannot be near crowds of people. Carefree, happy crowds of people... I simply cannot.",
            "nextDialogs": [
              "400050507"
            ]
          },
          "400050507": {
            "id": "400050507",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Too long have I spent suffering and slaughtering. It is all I know...",
            "nextDialogs": [
              "400050508"
            ]
          },
          "400050508": {
            "id": "400050508",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "I will discuss it no further.",
            "nextDialogs": [
              "400050509"
            ]
          },
          "400050509": {
            "id": "400050509",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Goodbye.",
            "nextDialogs": [
              "400050510"
            ]
          },
          "400050510": {
            "id": "400050510",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "...",
            "nextDialogs": [
              "400050511"
            ]
          },
          "400050511": {
            "id": "400050511",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Though, if while you are in Liyue you encounter any trouble of a supernatural nature, call my name.",
            "nextDialogs": [
              "400050512"
            ]
          },
          "400050512": {
            "id": "400050512",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Whether yours or Liyue's, I hear all cries for help, all prayers for peace, and all the wishes carried by the lanterns.",
            "nextDialogs": [
              "400050513"
            ]
          },
          "400050513": {
            "id": "400050513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thank you... and Happy New Year.",
            "nextDialogs": [
              "400050514"
            ]
          },
          "400050514": {
            "id": "400050514",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Happy New Year!"
          }
        }
      }
    },

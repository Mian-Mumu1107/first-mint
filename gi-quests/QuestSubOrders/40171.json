        ],
        "dialogs": {
          "401711001": {
            "id": "401711001",
            "speakerId": 1003,
            "speakerName": "Leyla",
            "text": "..."
          }
        }
      }
    },
    {
      "subId": "4017199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401719901"
        ],
        "dialogs": {
          "401719901": {
            "id": "401719901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Guess we just keep following this path...?",
            "nextDialogs": [
              "401719902"
            ]
          },
          "401719902": {
            "id": "401719902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ororon seemed pretty confident that Citlali's traps won't harm us, but still, it can't hurt to be careful."
          }
        }
      }
    }

    {
      "subId": "4017103",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401710301"
        ],
        "dialogs": {
          "401710301": {
            "id": "401710301",
            "speakerId": 1000,
            "speakerName": "Ororon",
            "text": "#You are the best, {M#Gramps}{F#Granny}. Please, can you go inside and take a look?"
          }
        }
      }
    },
    {
      "subId": "4017106",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401710601"
        ],
        "dialogs": {
          "401710601": {
            "id": "401710601",
            "speakerId": 1002,
            "speakerName": "Citlali",
            "text": "Are you ready? Don't worry, the spiritloom is very easy to use.",
            "nextDialogs": [
              "401710603",
              "401710605"
            ]
          },
          "401710603": {
            "id": "401710603",
            "speakerId": 1002,
            "speakerName": "Citlali",
            "text": "I know this is your first time working with it, but I have a feeling you'll do great."
          },
          "401710605": {
            "id": "401710605",
            "speakerId": 1002,
            "speakerName": "Citlali",
            "text": "Sure."
          }
        }
      }
    },
    {
      "subId": "4017110",

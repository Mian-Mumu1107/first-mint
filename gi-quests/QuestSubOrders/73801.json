            ]
          },
          "738010906": {
            "id": "738010906",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "W—We are running out of time! Please watch Nika for a while!",
            "nextDialogs": [
              "738010907"
            ]
          },
          "738010907": {
            "id": "738010907",
            "speakerId": 4121,
            "speakerName": "Berat",
            "text": "What? What did you mean? Wait a moment!"
          }
        }

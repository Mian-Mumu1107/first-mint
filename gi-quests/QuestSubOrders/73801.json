    {
      "subId": "7380110",
      "subQuestName": "Go back and check on Alexandra",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738011001"
        ],
        "dialogs": {
          "738011001": {
            "id": "738011001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alexandra should be around here. Where... Where are they?",
            "nextDialogs": [
              "738011004"
            ]
          },
          "738011004": {
            "id": "738011004",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Where are you!",
            "nextDialogs": [
              "738011005"
            ]
          },
          "738011005": {
            "id": "738011005",
            "speakerId": 4121,
            "speakerName": "Berat",
            "text": "Stop shouting! You will only attract the monsters!",
            "nextDialogs": [
              "738011006"
            ]
          },
          "738011006": {
            "id": "738011006",
            "speakerId": 4121,
            "speakerName": "Berat",
            "text": "Nika told me the whole story. I'm so surprised that Alexandra and Przheva are Fatui members.",
            "nextDialogs": [
              "738011007"
            ]
          },
          "738011007": {
            "id": "738011007",
            "speakerId": 4121,
            "speakerName": "Berat",
            "text": "I thought they were good folks when dealing with them...",
            "nextDialogs": [
              "738011008"
            ]
          },
          "738011008": {
            "id": "738011008",
            "speakerId": 4174,
            "speakerName": "Nika",
            "text": "Alexandra is a good person! Przheva is tough... but also a good person!",
            "nextDialogs": [
              "738011009"
            ]
          },
          "738011009": {
            "id": "738011009",
            "speakerId": 4121,
            "speakerName": "Berat",
            "text": "Umm, but they are Fatui! Who knows if they are just acting nice but actually with ulterior motives?",
            "nextDialogs": [
              "738011010"
            ]
          },
          "738011010": {
            "id": "738011010",
            "speakerId": 4121,
            "speakerName": "Berat",
            "text": "I mean, I've heard plenty of shady deals of the Fatui.",
            "nextDialogs": [
              "738011011"
            ]
          },
          "738011011": {
            "id": "738011011",
            "speakerId": 4121,
            "speakerName": "Berat",
            "text": "Maybe they were just scheming something and using saving Nika as a cover-up?"
          }
        }
      }
    },
    {

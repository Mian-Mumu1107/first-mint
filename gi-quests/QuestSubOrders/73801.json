    {
      "subId": "7380108",
      "subQuestName": "Talk to Alexandra",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738010801"
        ],
        "dialogs": {
          "738010801": {
            "id": "738010801",
            "speakerId": 4138,
            "speakerName": "Alexandra",
            "text": "Sorry... ahem... Przheva...",
            "nextDialogs": [
              "738010802"
            ]
          },
          "738010802": {
            "id": "738010802",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Don't talk. I'll patch you up.",
            "nextDialogs": [
              "738010803"
            ]
          },
          "738010803": {
            "id": "738010803",
            "speakerId": 4174,
            "speakerName": "Nika",
            "text": "*sobbing*... I'm sorry...",
            "nextDialogs": [
              "738010804"
            ]
          },
          "738010804": {
            "id": "738010804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why are you here?",
            "nextDialogs": [
              "738010805"
            ]
          },
          "738010805": {
            "id": "738010805",
            "speakerId": 4174,
            "speakerName": "Nika",
            "text": "I'm... I'm here to pick mushrooms... *sob*...",
            "nextDialogs": [
              "738010806"
            ]
          },
          "738010806": {
            "id": "738010806",
            "speakerId": 4174,
            "speakerName": "Nika",
            "text": "Alexandra... looks so sad these days...",
            "nextDialogs": [
              "738010807"
            ]
          },
          "738010807": {
            "id": "738010807",
            "speakerId": 4174,
            "speakerName": "Nika",
            "text": "So we talked about cooking something great to surprise her.",
            "nextDialogs": [
              "738010808"
            ]
          },
          "738010808": {
            "id": "738010808",
            "speakerId": 4174,
            "speakerName": "Nika",
            "text": "Alexandra once took us here and picked all those delicious mushrooms, and I thought I'd pick some myself.",
            "nextDialogs": [
              "738010809"
            ]
          },
          "738010809": {
            "id": "738010809",
            "speakerId": 4174,
            "speakerName": "Nika",
            "text": "B—But I got lost in the woods, and before I knew it, I was surrounded by so many mushrooms.",
            "nextDialogs": [
              "738010810"
            ]
          },
          "738010810": {
            "id": "738010810",
            "speakerId": 4174,
            "speakerName": "Nika",
            "text": "To save me, Alexandra... Alexandra... *sob*",
            "nextDialogs": [
              "738010811"
            ]
          },
          "738010811": {
            "id": "738010811",
            "speakerId": 4138,
            "speakerName": "Alexandra",
            "text": "*cough*... It's... It's okay, Nika... I'm fine...",
            "nextDialogs": [
              "738010812"
            ]
          },
          "738010812": {
            "id": "738010812",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "...Looks like there's a change of the plan.",
            "nextDialogs": [
              "738010813"
            ]
          },
          "738010813": {
            "id": "738010813",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Alexandra sustained serious injuries, and other Fatui must have noticed that we left the town without permission. If I take her back now, we will only get arrested for inspection.",
            "nextDialogs": [
              "738010816"
            ]
          },
          "738010816": {
            "id": "738010816",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Hehe... Just go along with it and see what will happen.",
            "nextDialogs": [
              "738010817"
            ]
          },
          "738010817": {
            "id": "738010817",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "I happened to see a group of the Eremites heading this way on my way here.",
            "nextDialogs": [
              "738010818"
            ]
          },
          "738010818": {
            "id": "738010818",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Traveler, you send the kid off the forest to the Eremites. I will take Alexandra and leave.",
            "nextDialogs": [
              "738010819"
            ]
          },
          "738010819": {
            "id": "738010819",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "...",
            "nextDialogs": [
              "738010820"
            ]
          },
          "738010820": {
            "id": "738010820",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Remember our plan? Looks like now we have to do it for real.",
            "nextDialogs": [
              "738010821"
            ]
          },
          "738010821": {
            "id": "738010821",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "The Eremites must think that two evil Fatui are doing something evil here, and that saving Nika is just a cover-up.",
            "nextDialogs": [
              "738010822"
            ]
          },
          "738010822": {
            "id": "738010822",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "If we come under attack by the monsters... well, it serves us right.",
            "nextDialogs": [
              "738010823"
            ]
          },
          "738010823": {
            "id": "738010823",
            "speakerId": 4174,
            "speakerName": "Nika",
            "text": "*sob*... Alexandra... I will never make any trouble again...",
            "nextDialogs": [
              "738010824"
            ]
          },
          "738010824": {
            "id": "738010824",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "...Good thing this kid didn't have the mood to listen to what we just said. No need to worry about him."
          }
        }
      }
    },
    {
      "subId": "7380109",
      "subQuestName": "Take Nika to the Eremites",
      "sceneId": null,
      "locations": [],
      "dialogue": {

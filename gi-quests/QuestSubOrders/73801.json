  "subQuests": [
    {
      "subId": "7380101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738010101"
        ],
        "dialogs": {
          "738010101": {
            "id": "738010101",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "...Did you close that deal?",
            "nextDialogs": [
              "738010102"
            ]
          },
          "738010102": {
            "id": "738010102",
            "speakerId": 4138,
            "speakerName": "Alexandra",
            "text": "The old cargo ship has just been unloaded. Don't worry.",
            "nextDialogs": [
              "738010103"
            ]
          },
          "738010103": {
            "id": "738010103",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "The ship didn't leak, right? And about <color=#00E1FFFF>the cargo...</color> All hidden?",
            "nextDialogs": [
              "738010104"
            ]
          },
          "738010104": {
            "id": "738010104",
            "speakerId": 4138,
            "speakerName": "Alexandra",
            "text": "Yes, all hidden somewhere safe and secret.",
            "nextDialogs": [
              "738010105"
            ]
          },
          "738010105": {
            "id": "738010105",
            "speakerId": 4138,
            "speakerName": "Alexandra",
            "text": "But... what about the old stuff that have been replaced?",
            "nextDialogs": [
              "738010106"
            ]
          },
          "738010106": {
            "id": "738010106",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Just throw them away. With the new cargo in hand, the old stuff is of no use.",
            "nextDialogs": [
              "738010107"
            ]
          },
          "738010107": {
            "id": "738010107",
            "speakerId": 4138,
            "speakerName": "Alexandra",
            "text": "I—Is that okay?"
          }
        }
      }
    },
    {
      "subId": "7380102",
      "subQuestName": "Talk to Paimon after getting the mysterious item",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738010201"
        ],
        "dialogs": {
          "738010201": {
            "id": "738010201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh! The box is open! It's surprisingly easy.",
            "nextDialogs": [
              "738010204"
            ]
          },
          "738010204": {
            "id": "738010204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Umm, anyway... Let's see what it has first.",
            "nextDialogs": [
              "738010205"
            ]
          },
          "738010205": {
            "id": "738010205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like... there're only some worn clothes and a stack of letters.",
            "nextDialogs": [
              "738010206"
            ]
          },
          "738010206": {
            "id": "738010206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It says...",
            "nextDialogs": [
              "738010207"
            ]
          },
          "738010207": {
            "id": "738010207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"To the south of Devantaka Mountain, the old ship leaves port.\"",
            "nextDialogs": [
              "738010208"
            ]
          },
          "738010208": {
            "id": "738010208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What does that mean? How can there be a ship in the mountain?"
          }
        }
      }
    },
    {
      "subId": "7380103",
      "subQuestName": "Investigate the usual place",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738010301"
        ],
        "dialogs": {
          "738010301": {
            "id": "738010301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The south of Devantaka Mountain... That's a huge area.",
            "nextDialogs": [
              "738010302"
            ]
          },
          "738010302": {
            "id": "738010302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The view is good here. Let's wait and see if there's anyone coming.",
            "nextDialogs": [
              "738010303"
            ]
          },
          "738010303": {
            "id": "738010303",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You wait here with Paimon...",
            "nextDialogs": [
              "738010304"
            ]
          },
          "738010304": {
            "id": "738010304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look... Somebody's coming this way!",
            "nextDialogs": [
              "738010305"
            ]
          },
          "738010305": {
            "id": "738010305",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Why are you so late? Did you run into any trouble?",
            "nextDialogs": [
              "738010306"
            ]
          },
          "738010306": {
            "id": "738010306",
            "speakerId": 4138,
            "speakerName": "Alexandra",
            "text": "...Sorry, someone must have opened the box. I'm afraid our plan...",
            "nextDialogs": [
              "738010307"
            ]
          },
          "738010307": {
            "id": "738010307",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Tsk, did we get caught? But... it's not like the higher-ups have sent anyone here lately...",
            "nextDialogs": [
              "738010308"
            ]
          },
          "738010308": {
            "id": "738010308",
            "speakerId": 4138,
            "speakerName": "Alexandra",
            "text": "Maybe... Maybe it was Nika? Those kids have been badgering me to take them out to play...",
            "nextDialogs": [
              "738010309"
            ]
          },
          "738010309": {
            "id": "738010309",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "*sigh*... That's why I told you not to get too close to those folks, unless necessary.",
            "nextDialogs": [
              "738010310"
            ]
          },
          "738010310": {
            "id": "738010310",
            "speakerId": 4138,
            "speakerName": "Alexandra",
            "text": "But their parents are always away from home, I just...",
            "nextDialogs": [
              "738010311"
            ]
          },
          "738010311": {
            "id": "738010311",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Forget it. Either way, we're leaving here today.",
            "nextDialogs": [
              "738010312"
            ]
          },
          "738010312": {
            "id": "738010312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Leaving? Do they mean... leaving Sumeru?",
            "nextDialogs": [
              "738010313"
            ]
          },
          "738010313": {
            "id": "738010313",
            "speakerId": 4138,
            "speakerName": "Alexandra",
            "text": "We don't have any helpers. Can the plan... work? I mean, what if the higher-ups found out about us...",
            "nextDialogs": [
              "738010314"
            ]
          },
          "738010314": {
            "id": "738010314",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Stop worrying... Haven't you had enough yet?",
            "nextDialogs": [
              "738010315"
            ]
          },
          "738010315": {
            "id": "738010315",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Living in fear, never to be trusted for a single second...",
            "nextDialogs": [
              "738010316"
            ]
          },
          "738010316": {
            "id": "738010316",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Today is our last chance to get away from the Fatui!",
            "nextDialogs": [
              "738010317"
            ]
          },
          "738010317": {
            "id": "738010317",
            "speakerId": 4138,
            "speakerName": "Alexandra",
            "text": "I—I know, but...",
            "nextDialogs": [
              "738010318"
            ]
          },
          "738010318": {
            "id": "738010318",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "These two... want to leave the Fatui?",
            "nextDialogs": [
              "738010319"
            ]
          },
          "738010319": {
            "id": "738010319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll go have a look.",
            "nextDialogs": [
              "738010320"
            ]
          },
          "738010320": {
            "id": "738010320",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay. But be careful. They are the Fatui after all!"
          }
        }
      }
    },
    {
      "subId": "7380104",
      "subQuestName": "Confront the Fatui",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738010401"
        ],
        "dialogs": {
          "738010401": {
            "id": "738010401",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Hehe, someone has shown up after all.",
            "nextDialogs": [
              "738010402"
            ]
          },
          "738010402": {
            "id": "738010402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You found me?",
            "nextDialogs": [
              "738010403"
            ]
          },
          "738010403": {
            "id": "738010403",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "You've been eavesdropping for a while without moving.",
            "nextDialogs": [
              "738010404"
            ]
          },
          "738010404": {
            "id": "738010404",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "As the wind blew just now, the bush you were hiding in swayed differently from the one next to it.",
            "nextDialogs": [
              "738010405"
            ]
          },
          "738010405": {
            "id": "738010405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Y—You Fatui really are something...",
            "nextDialogs": [
              "738010406"
            ]
          },
          "738010406": {
            "id": "738010406",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "#{M#Blond}{F#Blonde} hair... and a strange Seelie. You must be the \"Traveler\" mentioned in the report.",
            "nextDialogs": [
              "738010410",
              "738010409"
            ]
          },
          "738010410": {
            "id": "738010410",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Since you're here, I assume you have checked the stuff in the box.",
            "nextDialogs": [
              "738010411"
            ]
          },
          "738010411": {
            "id": "738010411",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "I'm surprised that Alexandra's trick actually worked."
          },
          "738010409": {
            "id": "738010409",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Relax. We wouldn't have had time for that."
          }
        }
      }
    },
    {
      "subId": "7380105",
      "subQuestName": "Investigate the ambush point",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738010501"
        ],
        "dialogs": {
          "738010501": {
            "id": "738010501",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "This is the place, Traveler. Listen, it's a simple plan.",
            "nextDialogs": [
              "738010502"
            ]
          },
          "738010502": {
            "id": "738010502",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "We are two... ahem, evil Fatui coming over to this forest for some evildoing.",
            "nextDialogs": [
              "738010503"
            ]
          },
          "738010503": {
            "id": "738010503",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "And you, out of indignation or righteousness, try to stop us.",
            "nextDialogs": [
              "738010504"
            ]
          },
          "738010504": {
            "id": "738010504",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Just as Alexandra and I are about to run, a group of monsters appears and strikes us down.",
            "nextDialogs": [
              "738010505"
            ]
          },
          "738010505": {
            "id": "738010505",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Being outnumbered by the monsters, you have no choice but to pull back. When you are back with helpers, Alexandra and I are already gone.",
            "nextDialogs": [
              "738010506"
            ]
          },
          "738010506": {
            "id": "738010506",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "That's the plan. What do you think?",
            "nextDialogs": [
              "738010508",
              "738010510"
            ]
          },
          "738010508": {
            "id": "738010508",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "For the story to make sense and our failure to seem more natural, I've put a lot of thought into it.",
            "nextDialogs": [
              "738010512"
            ]
          },
          "738010512": {
            "id": "738010512",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "But why hasn't Alexandra returned by now? Just setting up some lures for monsters doesn't take that long.",
            "nextDialogs": [
              "738010513"
            ]
          },
          "738010513": {
            "id": "738010513",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Alexandra! Alexandra! *sob*...",
            "nextDialogs": [
              "738010514"
            ]
          },
          "738010514": {
            "id": "738010514",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, Paimon heard someone over there!",
            "nextDialogs": [
              "738010515"
            ]
          },
          "738010515": {
            "id": "738010515",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Shoot! Alexandra must be in trouble!",
            "nextDialogs": [
              "738010516"
            ]
          },
          "738010516": {
            "id": "738010516",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Wait! Where are you going!?",
            "nextDialogs": [
              "738010517"
            ]
          },
          "738010517": {
            "id": "738010517",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's follow!",
            "nextDialogs": [
              "738010518"
            ]
          },
          "738010518": {
            "id": "738010518",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What happened..."
          },
          "738010510": {
            "id": "738010510",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "Right. The pawns in the Fatui out there collecting intel normally end up like this.",
            "nextDialogs": [
              "738010511"
            ]
          },
          "738010511": {
            "id": "738010511",
            "speakerId": 4137,
            "speakerName": "Przheva",
            "text": "We made this plan just because we don't want to be one of them."
          }
        }
      }
    },

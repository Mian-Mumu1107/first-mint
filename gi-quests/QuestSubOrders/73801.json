              "738011103"
            ]
          },
          "738011103": {
            "id": "738011103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let Paimon see...",
            "nextDialogs": [
              "738011104"
            ]
          },
          "738011104": {
            "id": "738011104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It says \"To the south of Devantaka Mountain, the old ship leaves port.\"",
            "nextDialogs": [
              "738011105"
            ]
          },
          "738011105": {
            "id": "738011105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What does that mean? How can there be a ship in the mountain?",
            "nextDialogs": [
              "738011108"
            ]
          },
          "738011108": {
            "id": "738011108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And we don't know who left the box here.",
            "nextDialogs": [
              "738011109"
            ]
          },
          "738011109": {
            "id": "738011109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, let's go take a look!"
          }
        }
      }
    },

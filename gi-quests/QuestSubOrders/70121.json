  },
  "subQuests": [
    {
      "subId": "7012101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701210101"
        ],
        "dialogs": {
          "701210101": {
            "id": "701210101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What's this? ...A notebook?",
            "nextDialogs": [
              "701210102"
            ]
          },
          "701210102": {
            "id": "701210102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Seems like some sort of records left behind by someone who once investigated the area.",
            "nextDialogs": [
              "701210103"
            ]
          },
          "701210103": {
            "id": "701210103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, Paimon bets these will be of great value— um, historical value to someone. Let's go ask around."
          }
        }
      }
    },
    {
      "subId": "7012103",
      "subQuestName": "Return to the base camp and ask the researchers for clues regarding the journal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701210201"
        ],
        "dialogs": {
          "701210201": {
            "id": "701210201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I found this.",
            "nextDialogs": [
              "701210202"
            ]
          },
          "701210202": {
            "id": "701210202",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "Huh? Up on the mountain? Let me take a look...",
            "nextDialogs": [
              "701210203"
            ]
          },
          "701210203": {
            "id": "701210203",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "Wow, what a find! This is a priceless treasure.",
            "nextDialogs": [
              "701210204"
            ]
          },
          "701210204": {
            "id": "701210204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Treasure...?",
            "nextDialogs": [
              "701210205"
            ]
          },
          "701210205": {
            "id": "701210205",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Treasure!?",
            "nextDialogs": [
              "701210206"
            ]
          },
          "701210206": {
            "id": "701210206",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "...A treasure trove of knowledge for the history enthusiast, I mean.",
            "nextDialogs": [
              "701210207"
            ]
          },
          "701210207": {
            "id": "701210207",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "Once, on a research trip, I read some ancient historical annals.",
            "nextDialogs": [
              "701210208"
            ]
          },
          "701210208": {
            "id": "701210208",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "I remember one of them, from before the time of the Knights of Favonius, talked about a team sent by the aristocrats to investigate the mountain.",
            "nextDialogs": [
              "701210209"
            ]
          },
          "701210209": {
            "id": "701210209",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "For some reason, though, the annals provide next to no details about what the investigation team found...",
            "nextDialogs": [
              "701210210"
            ]
          },
          "701210210": {
            "id": "701210210",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "If this is one of the journals kept by that investigation team, it will serve as an immensely valuable historical source for researchers.",
            "nextDialogs": [
              "701210211"
            ]
          },
          "701210211": {
            "id": "701210211",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "Would you be willing to go back into the mountains and see if you can find any more of them?",
            "nextDialogs": [
              "701210213",
              "701210215"
            ]
          },
          "701210213": {
            "id": "701210213",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "Really? Thank you ever so much!",
            "nextDialogs": [
              "701210217"
            ]
          },
          "701210217": {
            "id": "701210217",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "Based on what I'm reading here... The team investigated three sites in total.",
            "nextDialogs": [
              "701210218"
            ]
          },
          "701210218": {
            "id": "701210218",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "One of them was where you found this — so that leaves two more.",
            "nextDialogs": [
              "701210219"
            ]
          },
          "701210219": {
            "id": "701210219",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "Let me see... here, and... here. I've marked them out on your map.",
            "nextDialogs": [
              "701210220"
            ]
          },
          "701210220": {
            "id": "701210220",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "Thank you for agreeing to this, and please be careful out there!"
          },
          "701210215": {
            "id": "701210215",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "Haha, in terms of material wealth... I can't guarantee there will be.",
            "nextDialogs": [
              "701210216"
            ]
          },
          "701210216": {
            "id": "701210216",
            "speakerId": 1001,
            "speakerName": "Stevens",
            "text": "But for helping me, I will make sure to provide you with compensation of a suitably material nature. A reward for your great contribution to academic research."
          }
        }
      }
    },

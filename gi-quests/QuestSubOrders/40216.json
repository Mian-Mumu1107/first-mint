  "subQuests": [
    {
      "subId": "4021601",
      "subQuestName": "Head to the testing platform",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766530501"
        ],
        "dialogs": {
          "766530501": {
            "id": "766530501",
            "speakerId": 1313,
            "speakerName": "Aino",
            "text": "Hmm... Should I continue my research or not?",
            "nextDialogs": [
              "766530502"
            ]
          },
          "766530502": {
            "id": "766530502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's this?",
            "nextDialogs": [
              "766530503"
            ]
          },
          "766530503": {
            "id": "766530503",
            "speakerId": 1313,
            "speakerName": "Aino",
            "text": "Zip-Zap Spy-Bot Number 1!",
            "nextDialogs": [
              "766530504"
            ]
          },
          "766530504": {
            "id": "766530504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Zip-Zap what now?",
            "nextDialogs": [
              "766530505"
            ]
          },
          "766530505": {
            "id": "766530505",
            "speakerId": 1312,
            "speakerName": "Ineffa",
            "text": "To be precise, this is a testing platform for Zip-Zap Spy-Bot Number 1, the latest stealth robot of Aino's design.",
            "nextDialogs": [
              "766530506"
            ]
          },
          "766530506": {
            "id": "766530506",
            "speakerId": 1312,
            "speakerName": "Ineffa",
            "text": "She recently purchased an abandoned cleaning bot from the black market. After modifying it, she created the Zip-Zap Spy-Bot Number 1 you see here today.",
            "nextDialogs": [
              "766530507"
            ]
          },
          "766530507": {
            "id": "766530507",
            "speakerId": 1312,
            "speakerName": "Ineffa",
            "text": "This platform has simulated several hostile environments to test the robot's ability to maintain stealth under pressure.",
            "nextDialogs": [
              "766530508"
            ]
          },
          "766530508": {
            "id": "766530508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why's Aino making this stealth robot again?",
            "nextDialogs": [
              "766530509"
            ]
          },
          "766530509": {
            "id": "766530509",
            "speakerId": 1312,
            "speakerName": "Ineffa",
            "text": "After the theft of Krum-Clank 70% Sweet, Aino made up her mind, and declared: \"No matter how powerful the foe, we have to rescue our friends!\"",
            "nextDialogs": [
              "766530510"
            ]
          },
          "766530510": {
            "id": "766530510",
            "speakerId": 1312,
            "speakerName": "Ineffa",
            "text": "Then she quickly completed the draft of Zip-Zap Spy-Bot Number 1 and started its development.",
            "nextDialogs": [
              "766530511"
            ]
          },
          "766530511": {
            "id": "766530511",
            "speakerId": 1312,
            "speakerName": "Ineffa",
            "text": "According to her plan, once the development is complete, it should be able to infiltrate even the heavily guarded Kuuvahki Experimental Design Bureau with ease to rescue our friends.",
            "nextDialogs": [
              "766530512"
            ]
          },
          "766530512": {
            "id": "766530512",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That sounds pretty awesome!",
            "nextDialogs": [
              "766530513"
            ]
          },
          "766530513": {
            "id": "766530513",
            "speakerId": 1312,
            "speakerName": "Ineffa",
            "text": "But Aino soon realized that perfecting the plan would take far too long — so she wanted to abandon the idea. As per her calculations, it would be much faster to just turn all of Nod-Krai upside down.",
            "nextDialogs": [
              "766530514"
            ]
          },
          "766530514": {
            "id": "766530514",
            "speakerId": 1313,
            "speakerName": "Aino",
            "text": "I've made up my mind! Since we're taking things nice, chill, and easy, I'll just keep working on Zip-Zap Spy-Bot Number 1! It'll definitely help us save our friends!",
            "nextDialogs": [
              "766530515"
            ]
          },
          "766530515": {
            "id": "766530515",
            "speakerId": 1312,
            "speakerName": "Ineffa",
            "text": "In that case, could we ask you two to assist with the tests?",
            "nextDialogs": [
              "766530516"
            ]
          },
          "766530516": {
            "id": "766530516",
            "speakerId": 1312,
            "speakerName": "Ineffa",
            "text": "Based on past statistics, having data provided by other testers as reference will increase Aino's development speed by at least 30%.",
            "nextDialogs": [
              "766530517"
            ]
          },
          "766530517": {
            "id": "766530517",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Count Paimon in! This sounds like fun!",
            "nextDialogs": [
              "766530518"
            ]
          },
          "766530518": {
            "id": "766530518",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll help too.",
            "nextDialogs": [
              "766530519"
            ]
          },
          "766530519": {
            "id": "766530519",
            "speakerId": 1312,
            "speakerName": "Ineffa",
            "text": "Then I thank you both on Aino's behalf. I will grant you access permissions to the platform — from now on, you can use it for any testing you need to conduct."
          }
        }
      }
    }
  ]
}
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Right after activating the symbol on the slate, the keystone turns into sand and disappears.",
            "nextDialogs": [
              "732980202"
            ]
          },
          "732980202": {
            "id": "732980202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, the keystone suddenly turned into sand! Paimon didn't see that coming.",
            "nextDialogs": [
              "732980203"
            ]
          },
          "732980203": {
            "id": "732980203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like the keystone and the slate are related... Paimon never thought we'd find new clues about the slate here. We should go tell Tirzad when we have time!"
          }
        }

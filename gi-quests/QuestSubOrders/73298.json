        "dialogs": {
          "683300101": {
            "id": "683300101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Someone left notes here... Wait, Jebrael left these notes!",
            "nextDialogs": [
              "683300102"
            ]
          },
          "683300102": {
            "id": "683300102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Jebrael, that name sounds so familiar. Hey, isn't that...",
            "nextDialogs": [
              "683300105"
            ]
          },
          "683300105": {
            "id": "683300105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like Jebrael and Samail were still friendly at that time. They were from the same tribe, after all... Maybe they came here together.",
            "nextDialogs": [
              "683300106"
            ]
          },
          "683300106": {
            "id": "683300106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hm... Is this stone they left on the side of the road actually the keystone from the records...",
            "nextDialogs": [
              "683300107"
            ]
          },
          "683300107": {
            "id": "683300107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Paimon's really not sure how this thing might work... Hey, {NICKNAME}, do you have any idea what it can do?",
            "nextDialogs": [
              "683300108"
            ]
          },
          "683300108": {
            "id": "683300108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's the stone slate.",
            "nextDialogs": [
              "683300109"
            ]
          },
          "683300109": {
            "id": "683300109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The symbol on the slate is lighting up!"
          }
        }
      }
    },

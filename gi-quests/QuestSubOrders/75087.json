    {
      "subId": "7508705",
      "subQuestName": "Defeat your opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750870501"
        ],
        "dialogs": {
          "750870501": {
            "id": "750870501",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "Since you've managed to find your way here, I suppose I can finally drop the \"good merchant\" act. I need a breather from dealing with all the idiots.",
            "nextDialogs": [
              "750870502"
            ]
          },
          "750870502": {
            "id": "750870502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You meanie! How can you pin the blame for your crimes on other people? Everyone got the wrong idea about us thanks to you!",
            "nextDialogs": [
              "750870503"
            ]
          },
          "750870503": {
            "id": "750870503",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "I'm a villain. Is it not natural for a villain to do bad things? Besides, doesn't the fact that those three idiots misunderstood prove that I'm good at what I do?",
            "nextDialogs": [
              "750870504"
            ]
          },
          "750870504": {
            "id": "750870504",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "Haha, and now I'm going to do something more wicked still! This time, you're not going to get away.",
            "nextDialogs": [
              "750870505"
            ]
          },
          "750870505": {
            "id": "750870505",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "Go get them, Furball!",
            "nextDialogs": [
              "750870506"
            ]
          },
          "750870506": {
            "id": "750870506",
            "speakerId": 21787,
            "speakerName": "Furball",
            "text": "Gwoooo!",
            "nextDialogs": [
              "750870507"
            ]
          },
          "750870507": {
            "id": "750870507",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750870508"
            ]
          },
          "750870508": {
            "id": "750870508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#Let's go, {REALNAME[ID(2)|SHOWHOST(true)]}!",
            "nextDialogs": [
              "750870509"
            ]
          },
          "750870509": {
            "id": "750870509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}? Are you really gonna take on someone that much bigger than you?",
            "nextDialogs": [
              "750870510"
            ]
          },
          "750870510": {
            "id": "750870510",
            "speakerId": 21773,
            "speakerName": "Oberon",
            "text": "Crrooo...",
            "nextDialogs": [
              "750870511"
            ]
          },
          "750870511": {
            "id": "750870511",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr! Raaaawr!",
            "nextDialogs": [
              "750870512"
            ]
          },
          "750870512": {
            "id": "750870512",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oberon looks kinda out of it. Is he just worried about Taruka, or has he eaten too many Saurus Crackers...?",
            "nextDialogs": [
              "750870513"
            ]
          },
          "750870513": {
            "id": "750870513",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Maybe {REALNAME[ID(2)|SHOWHOST(true)]} really wants to cheer him up, so he bravely stepped out to protect us?",
            "nextDialogs": [
              "750870514"
            ]
          },
          "750870514": {
            "id": "750870514",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "The things in this world that courage alone cannot change outnumber the sand grains of Sumeru. Compared to something illusory like that, absolute control is more reliable.",
            "nextDialogs": [
              "750870515"
            ]
          },
          "750870515": {
            "id": "750870515",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "Attack!",
            "nextDialogs": [
              "750870516"
            ]
          },
          "750870516": {
            "id": "750870516",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Amazing! {REALNAME[ID(2)|SHOWHOST(true)]} dodged the attack! That's just what Tepetlisaurs are good at, not even the sovereign of the skies can touch 'em!",
            "nextDialogs": [
              "750870518",
              "750870520",
              "750870523",
              "750870527"
            ]
          },
          "750870518": {
            "id": "750870518",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]} is ready to attack!",
            "nextDialogs": [
              "750870530"
            ]
          },
          "750870530": {
            "id": "750870530",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750870531"
            ]
          },
          "750870531": {
            "id": "750870531",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The attack hit! It dealt... almost no damage!?",
            "nextDialogs": [
              "750870532"
            ]
          },
          "750870532": {
            "id": "750870532",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750870533"
            ]
          },
          "750870533": {
            "id": "750870533",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, getting a hit in is already pretty impressive! Phew— Paimon's kinda feeling tired already. Have we really only gone one round? What's going on...",
            "nextDialogs": [
              "750870534"
            ]
          },
          "750870534": {
            "id": "750870534",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "It's my turn now, right? Attack!",
            "nextDialogs": [
              "750870535"
            ]
          },
          "750870535": {
            "id": "750870535",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]} quickly assumes a defensive stance to weather the opponent's fierce assault! He successfully blocks it!",
            "nextDialogs": [
              "750870536"
            ]
          },
          "750870536": {
            "id": "750870536",
            "speakerId": 21607,
            "speakerName": "Quilla",
            "text": "Wait, your Saurian defended on his own right after attacking! Tch, despicable rule breaker...",
            "nextDialogs": [
              "750870537"
            ]
          },
          "750870537": {
            "id": "750870537",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The best way to win a turn-based game is not to take turns!",
            "nextDialogs": [
              "750870538"
            ]
          },
          "750870538": {
            "id": "750870538",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What should we do next?",
            "nextDialogs": [
              "750870539"
            ]
          },
          "750870539": {
            "id": "750870539",
            "speakerId": 21773,
            "speakerName": "Oberon",
            "text": "...Krraaaaa!",
            "nextDialogs": [
              "750870540"
            ]
          },
          "750870540": {
            "id": "750870540",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Oberon seems to be pulling himself together!",
            "nextDialogs": [
              "750870541"
            ]
          },
          "750870541": {
            "id": "750870541",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr! Raaaawr!",
            "nextDialogs": [
              "750870542"
            ]
          },
          "750870542": {
            "id": "750870542",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon doesn't understand what they're saying, but it looks like they've reached some kind of... mutual understanding...?"
          },
          "750870520": {
            "id": "750870520",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rooo... Rawr!",
            "nextDialogs": [
              "750870521"
            ]
          },
          "750870521": {
            "id": "750870521",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]} seems to feel like defending too conservatively will lead to wasted opportunity. He's getting ready to attack!"
          },
          "750870523": {
            "id": "750870523",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's nothing we can use right now! Also, don't you think it's a bit too late to set Beast Trap now?",
            "nextDialogs": [
              "750870524"
            ]
          },
          "750870524": {
            "id": "750870524",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rooo... Rawr!",
            "nextDialogs": [
              "750870525"
            ]
          },
          "750870525": {
            "id": "750870525",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Oh! {REALNAME[ID(2)|SHOWHOST(true)]} is ready to attack!"
          },
          "750870527": {
            "id": "750870527",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This isn't the time to run away!",
            "nextDialogs": [
              "750870528"
            ]
          },
          "750870528": {
            "id": "750870528",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Wrrooo... Rawr!",
            "nextDialogs": [
              "750870529"
            ]
          },
          "750870529": {
            "id": "750870529",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Even {REALNAME[ID(2)|SHOWHOST(true)]} gets it! Look, he's ready to attack!"
          }
        }
      }
    },

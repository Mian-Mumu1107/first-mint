    {
      "subId": "7508703",
      "subQuestName": "Investigate the camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750870301"
        ],
        "dialogs": {
          "750870301": {
            "id": "750870301",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr! Raaaawr!",
            "nextDialogs": [
              "750870302"
            ]
          },
          "750870302": {
            "id": "750870302",
            "speakerId": 21773,
            "speakerName": "Oberon",
            "text": "Cooo?",
            "nextDialogs": [
              "750870303"
            ]
          },
          "750870303": {
            "id": "750870303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh... Is that you, Oberon?",
            "nextDialogs": [
              "750870304"
            ]
          },
          "750870304": {
            "id": "750870304",
            "speakerId": 21773,
            "speakerName": "Oberon",
            "text": "Croooo!",
            "nextDialogs": [
              "750870305"
            ]
          },
          "750870305": {
            "id": "750870305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...You've, ah, grown a lot since we last met...",
            "nextDialogs": [
              "750870306"
            ]
          },
          "750870306": {
            "id": "750870306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Guess Taruka was right about you gaining weight easily. Oh right, where is he? Why isn't he with you?",
            "nextDialogs": [
              "750870307"
            ]
          },
          "750870307": {
            "id": "750870307",
            "speakerId": 21773,
            "speakerName": "Oberon",
            "text": "Cooo... Crrooo...",
            "nextDialogs": [
              "750870308"
            ]
          },
          "750870308": {
            "id": "750870308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um, at any rate, we should probably get out of here first!",
            "nextDialogs": [
              "750870309"
            ]
          },
          "750870309": {
            "id": "750870309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Now that we've found Oberon, we don't have to hide anymore, right? Paimon's still worried, though, we don't know where Taruka is... We gotta hurry!"
          }
        }
      }
    },
    {
      "subId": "7508704",
      "subQuestName": "Find a way out",
      "sceneId": null,

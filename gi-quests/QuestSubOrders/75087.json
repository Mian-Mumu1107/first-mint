    {
      "subId": "7508709",
      "subQuestName": "Check for clues nearby",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750870901"
        ],
        "dialogs": {
          "750870901": {
            "id": "750870901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why are there Saurus Crackers here? This letter...",
            "nextDialogs": [
              "750870902"
            ]
          },
          "750870902": {
            "id": "750870902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So Quilla was the mastermind, just like Paimon thought! Even if it was for an unexpected reason... Ugh, Paran's got rotten luck for sure.",
            "nextDialogs": [
              "750870903"
            ]
          },
          "750870903": {
            "id": "750870903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Just thinking about how Taruka and Oberon might be imprisoned in the camp in front of us makes Paimon feel bad about doing nothing... They didn't do anything wrong.",
            "nextDialogs": [
              "750870904"
            ]
          },
          "750870904": {
            "id": "750870904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hmm... {NICKNAME}, let's think of a way to save them, shall we?",
            "nextDialogs": [
              "750870905"
            ]
          },
          "750870905": {
            "id": "750870905",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "If we can <color=#00E1FFFF>hide amidst the Iktomisaurus patrol squad</color>, maybe we'll have an easier time getting in!"
          }
        }
      }
    },

            ]
          },
          "705500105": {
            "id": "705500105",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "#Seeing you here, {M#Mr.}{F#Miss} Honorary Knight, Klee knows this must be the best drinks stand in all of Teyvat!"
          }
        }
      }
    },
    {
      "subId": "7055003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705500301"
        ],
        "dialogs": {
          "705500301": {
            "id": "705500301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tada! It's done — I just know you're going to love this new creation!",
            "nextDialogs": [
              "705500302"
            ]
          },
          "705500302": {
            "id": "705500302",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Wow! There's Dodoco Candy on top!",
            "nextDialogs": [
              "705500303"
            ]
          },
          "705500303": {
            "id": "705500303",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "There's so much orange in this cup, and Dodoco looks like he's lying on top of white, fluffy clouds... and the weather inside looks much better, too!",
            "nextDialogs": [
              "705500304"
            ]
          },
          "705500304": {
            "id": "705500304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Would you like to taste it?",
            "nextDialogs": [
              "705500305"
            ]
          },
          "705500305": {
            "id": "705500305",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Yummy... It's so delicious!",
            "nextDialogs": [
              "705500306"
            ]
          },
          "705500306": {
            "id": "705500306",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Klee has to drink slowly... I can't just gulp it down, or I'll miss all the yummy flavor!",
            "nextDialogs": [
              "705500307"
            ]
          },
          "705500307": {
            "id": "705500307",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "#{M#Mr.}{F#Miss} Honorary Knight, this is amazing... It's like you mixed sunshine with juice!",
            "nextDialogs": [
              "705500308"
            ]
          },
          "705500308": {
            "id": "705500308",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Klee was so tired from playing, but now I feel refreshed... and warm... and peaceful...?",
            "nextDialogs": [
              "705500309"
            ]
          },
          "705500309": {
            "id": "705500309",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "#*yawn* You're the best, {M#Mr.}{F#Miss} Honorary Knight!",
            "nextDialogs": [
              "705500312"
            ]
          },
          "705500312": {
            "id": "705500312",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Really? Let me think...",
            "nextDialogs": [
              "705500313"
            ]
          },
          "705500313": {
            "id": "705500313",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Hmm... When the weather's nice, and Dodoco's happy, Dodoco will want to sing, right?",
            "nextDialogs": [
              "705500314"
            ]
          },
          "705500314": {
            "id": "705500314",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "And when Dodoco sings, Klee wants to sing, too... So, let's call it... Dodoco's Duet!"
          }
        }
      }
    },
    {

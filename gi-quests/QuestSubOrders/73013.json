  "subQuests": [
    {
      "subId": "7301301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130101"
        ],
        "dialogs": {
          "730130101": {
            "id": "730130101",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Oh! If it isn't the Golden Nara! Alas...",
            "nextDialogs": [
              "730130102"
            ]
          },
          "730130102": {
            "id": "730130102",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#Arapacati not afraid. Nara {NICKNAME} is good Nara, just like the Nara in the stories. Nara {NICKNAME} and Paimon have helped us a lot.",
            "nextDialogs": [
              "730130103"
            ]
          },
          "730130103": {
            "id": "730130103",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#Okay, Arapacati not afraid. Arapacati trusts Arama, and the grass, leaves, and seeds. All say you're a good Nara. Hello, Nara {NICKNAME} and Paimon.",
            "nextDialogs": [
              "730130104"
            ]
          },
          "730130104": {
            "id": "730130104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hello, Arapacati!",
            "nextDialogs": [
              "730130106"
            ]
          },
          "730130106": {
            "id": "730130106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Don't make that kind of joke!",
            "nextDialogs": [
              "730130107"
            ]
          },
          "730130107": {
            "id": "730130107",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "You good. Arapacati knows.",
            "nextDialogs": [
              "730130108"
            ]
          },
          "730130108": {
            "id": "730130108",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#Lots of winds bring lots of small seeds. They come to Vanarana with Nara. They say Nara {NICKNAME} is nice.",
            "nextDialogs": [
              "730130109"
            ]
          },
          "730130109": {
            "id": "730130109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Arama said something like that too! Speaking of which, seeds brought by winds... You mean like dandelion seeds?"
          }
        }
      }
    },
    {
      "subId": "7301302",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130201"
        ],
        "dialogs": {
          "730130201": {
            "id": "730130201",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "...So difficult to talk to Nara, and they are so tall.",
            "nextDialogs": [
              "730130202"
            ]
          },
          "730130202": {
            "id": "730130202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hello.",
            "nextDialogs": [
              "730130203"
            ]
          },
          "730130203": {
            "id": "730130203",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#Eek! It's Nara {NICKNAME}...",
            "nextDialogs": [
              "730130204"
            ]
          },
          "730130204": {
            "id": "730130204",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Arapacati not scared. Brothers are very brave, so they definitely not scared too.",
            "nextDialogs": [
              "730130205"
            ]
          },
          "730130205": {
            "id": "730130205",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "You should find them if you move towards <color=#00E1FFFF>the pillars of smoke</color>. If they are acting strange, go splat them with <color=#00E1FFFF>the power of Dendro</color>."
          }
        }
      }
    },
    {
      "subId": "7301303",
      "subQuestName": "Report back to Arapacati",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130301"
        ],
        "dialogs": {
          "730130301": {
            "id": "730130301",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Arapacati is sooo mad! Argh! More mad than mad!",
            "nextDialogs": [
              "730130302"
            ]
          },
          "730130302": {
            "id": "730130302",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Forest is very dangerous as Marana is rampant there. When they left, Arapacati reminded brothers to work together...",
            "nextDialogs": [
              "730130303"
            ]
          },
          "730130303": {
            "id": "730130303",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "But you started arguing right after leaving. Arachatora, you even ate strange thing.",
            "nextDialogs": [
              "730130304"
            ]
          },
          "730130304": {
            "id": "730130304",
            "speakerId": 4192,
            "speakerName": "Arachatora",
            "text": "*sob*",
            "nextDialogs": [
              "730130305"
            ]
          },
          "730130305": {
            "id": "730130305",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Arapacati has decided. Arachatora not allowed to pick mushrooms until Sunsettias have ripened ten times.",
            "nextDialogs": [
              "730130306"
            ]
          },
          "730130306": {
            "id": "730130306",
            "speakerId": 4192,
            "speakerName": "Arachatora",
            "text": "Noooo... *sob*",
            "nextDialogs": [
              "730130307"
            ]
          },
          "730130307": {
            "id": "730130307",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "Exactly! What would we do if he brought back bad spores and mushroom monsters grew here?",
            "nextDialogs": [
              "730130308"
            ]
          },
          "730130308": {
            "id": "730130308",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Araphala, you too! You went so far away from Vanarana to collect fruits. There are many bad things over there! Araja told us about it especially!",
            "nextDialogs": [
              "730130309"
            ]
          },
          "730130309": {
            "id": "730130309",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "*sob*",
            "nextDialogs": [
              "730130310"
            ]
          },
          "730130310": {
            "id": "730130310",
            "speakerId": 4194,
            "speakerName": "Arapas",
            "text": "That's right. Fruits need to drink water and Aranara need to drink water, so water is the best.",
            "nextDialogs": [
              "730130311"
            ]
          },
          "730130311": {
            "id": "730130311",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Arapas, of all places, you had to go to the Varuna Contraption. Don't you know that even Nara Varuna said the water of Vanarana is the most delicious?",
            "nextDialogs": [
              "730130312"
            ]
          },
          "730130312": {
            "id": "730130312",
            "speakerId": 4194,
            "speakerName": "Arapas",
            "text": "*sob*",
            "nextDialogs": [
              "730130313"
            ]
          },
          "730130313": {
            "id": "730130313",
            "speakerId": 4193,
            "speakerName": "Arasaka",
            "text": "Y—You see, only the \"taste of happiness\" can bring happiness to our little sister.",
            "nextDialogs": [
              "730130314"
            ]
          },
          "730130314": {
            "id": "730130314",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#Arasaka, I heard you caused a lot of trouble for Nara {NICKNAME} because of your \"taste of happiness\"...",
            "nextDialogs": [
              "730130315"
            ]
          },
          "730130315": {
            "id": "730130315",
            "speakerId": 4193,
            "speakerName": "Arasaka",
            "text": "E—Everything I did was for the \"Supreme Delicacy\"...",
            "nextDialogs": [
              "730130316"
            ]
          },
          "730130316": {
            "id": "730130316",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "The purpose of making the \"Supreme Delicacy\" is to show the fruits of the \"cooking training\". Alas, what's the point of the training if you could only complete it with someone else's help?",
            "nextDialogs": [
              "730130317"
            ]
          },
          "730130317": {
            "id": "730130317",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Arapacati thinks Arasaka needs to reflect on himself the most.",
            "nextDialogs": [
              "730130318"
            ]
          },
          "730130318": {
            "id": "730130318",
            "speakerId": 4193,
            "speakerName": "Arasaka",
            "text": "*sob*",
            "nextDialogs": [
              "730130319"
            ]
          },
          "730130319": {
            "id": "730130319",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Arapacati! We're here!",
            "nextDialogs": [
              "730130320"
            ]
          },
          "730130320": {
            "id": "730130320",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Oh, it's you two.",
            "nextDialogs": [
              "730130321"
            ]
          },
          "730130321": {
            "id": "730130321",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#Nara {NICKNAME} shared Arapacati's trouble with Paimon and solved the problem at its source...",
            "nextDialogs": [
              "730130322"
            ]
          },
          "730130322": {
            "id": "730130322",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Arapacati no longer needs to worry about brothers missing Festival Utsava or being in danger outside. It's all thanks to you.",
            "nextDialogs": [
              "730130323"
            ]
          },
          "730130323": {
            "id": "730130323",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Arapacati and brothers are all thankful.",
            "nextDialogs": [
              "730130324"
            ]
          },
          "730130324": {
            "id": "730130324",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's great!",
            "nextDialogs": [
              "730130325"
            ]
          },
          "730130325": {
            "id": "730130325",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But there's something Paimon has always been curious about...",
            "nextDialogs": [
              "730130326"
            ]
          },
          "730130326": {
            "id": "730130326",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Who is this Nara Varuna?",
            "nextDialogs": [
              "730130327"
            ]
          },
          "730130327": {
            "id": "730130327",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#{F#He}{M#She} is our friend, a friend of Vanarana.",
            "nextDialogs": [
              "730130328"
            ]
          },
          "730130328": {
            "id": "730130328",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#A friend of Aranara from a long, long time ago. A Golden Nara just like Nara {NICKNAME}.",
            "nextDialogs": [
              "730130329"
            ]
          },
          "730130329": {
            "id": "730130329",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh. But Paimon's still got another question for you...",
            "nextDialogs": [
              "730130330"
            ]
          },
          "730130330": {
            "id": "730130330",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is it about her brothers?",
            "nextDialogs": [
              "730130331"
            ]
          },
          "730130331": {
            "id": "730130331",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yes. Arapacati, which one of them is your biggest brother, and which one's the smallest?",
            "nextDialogs": [
              "730130332"
            ]
          },
          "730130332": {
            "id": "730130332",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Hmm? The biggest and the smallest?",
            "nextDialogs": [
              "730130336",
              "730130335"
            ]
          },
          "730130336": {
            "id": "730130336",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Ages... Ah, Arapacati understands. Just like tree rings. Hmm, the children of the forest aren't distinguished by age.",
            "nextDialogs": [
              "730130337"
            ]
          },
          "730130337": {
            "id": "730130337",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Then why are they your brothers and why are you their younger sister?",
            "nextDialogs": [
              "730130338"
            ]
          },
          "730130338": {
            "id": "730130338",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#Oh, this. We once had a Nara friend. Nara Varuna. {F#He}{M#She} said {F#he}{M#she} had a \"{F#sister}{M#brother}.\"",
            "nextDialogs": [
              "730130339"
            ]
          },
          "730130339": {
            "id": "730130339",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#When Arapacati and brothers listened to {F#him}{M#her} talk about the \"{F#sister}{M#brother},\" Nara Varuna looked happy and sad at the same time.",
            "nextDialogs": [
              "730130340"
            ]
          },
          "730130340": {
            "id": "730130340",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "That's how we understood. To an \"older brother,\" a \"younger sister\" is an important Nara. To a \"younger sister,\" an \"older brother\" is an important Nara.",
            "nextDialogs": [
              "730130341"
            ]
          },
          "730130341": {
            "id": "730130341",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "We thought it was great, so Arapacati and brothers decided to become brothers and sister. Nara Varuna said this was great. We should cherish our family.",
            "nextDialogs": [
              "730130342"
            ]
          },
          "730130342": {
            "id": "730130342",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's right, we must cherish our family.",
            "nextDialogs": [
              "730130343"
            ]
          },
          "730130343": {
            "id": "730130343",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm...",
            "nextDialogs": [
              "730130344"
            ]
          },
          "730130344": {
            "id": "730130344",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's one more thing Paimon's been wondering... Do Aranara need to eat?",
            "nextDialogs": [
              "730130345"
            ]
          },
          "730130345": {
            "id": "730130345",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Humans cook ingredients into food, and the children of the forest can also make ingredients into food.",
            "nextDialogs": [
              "730130346"
            ]
          },
          "730130346": {
            "id": "730130346",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Nara Varuna taught us how Nara eat. That's why Arapacati and brothers started doing cooking training...",
            "nextDialogs": [
              "730130347"
            ]
          },
          "730130347": {
            "id": "730130347",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay, but that's certainly unusual..."
          },
          "730130335": {
            "id": "730130335",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No! Paimon is asking about their ages!"
          }
        }
      }
    },
    {
      "subId": "7301304",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130401"
        ],
        "dialogs": {
          "730130401": {
            "id": "730130401",
            "speakerId": 20649,
            "speakerName": "Arapacati",
            "text": "#Thank you for everything, Nara {NICKNAME}. When the time comes for Festival Utsava, you must come as well!"
          }
        }
      }
    },
    {
      "subId": "7301305",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130501"
        ],
        "dialogs": {
          "730130501": {
            "id": "730130501",
            "speakerId": 20650,
            "speakerName": "Arachatora",
            "text": "I can't pick any mushrooms until the Sunsettias have ripened ten times. *sob* I know it's not a long time...",
            "nextDialogs": [
              "730130502"
            ]
          },
          "730130502": {
            "id": "730130502",
            "speakerId": 20650,
            "speakerName": "Arachatora",
            "text": "But for some reason, just thinking about it slows time to a crawl..."
          }
        }
      }
    },
    {
      "subId": "7301306",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130601"
        ],
        "dialogs": {
          "730130601": {
            "id": "730130601",
            "speakerId": 20653,
            "speakerName": "Araphala",
            "text": "Arapacati is so scary when she's angry. I hope she won't be so angry after she has had some fruit..."
          }
        }
      }
    },
    {
      "subId": "7301307",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130701"
        ],
        "dialogs": {
          "730130701": {
            "id": "730130701",
            "speakerId": 16765,
            "speakerName": "Arapas",
            "text": "Vanarana's water is good, but it's water that's right within reach... But we can try using that water to cook next time!"
          }
        }
      }
    },
    {
      "subId": "7301308",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730130801"
        ],
        "dialogs": {
          "730130801": {
            "id": "730130801",
            "speakerId": 20651,
            "speakerName": "Arasaka",
            "text": "The \"taste of happiness\" doesn't bring happiness but bitterness instead? How can this be?"
          }
        }
      }
    }
  ]
}
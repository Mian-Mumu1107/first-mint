  "subQuests": [
    {
      "subId": "7468701",
      "subQuestName": "Talk to the Gardes",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746870301"
        ],
        "dialogs": {
          "746870301": {
            "id": "746870301",
            "speakerId": 30839,
            "speakerName": "Marine",
            "text": "Hey-ho! Here comes the relief force...",
            "nextDialogs": [
              "746870302"
            ]
          },
          "746870302": {
            "id": "746870302",
            "speakerId": 30839,
            "speakerName": "Marine",
            "text": "Huh? What are you two doing here?",
            "nextDialogs": [
              "746870304",
              "746870308"
            ]
          },
          "746870304": {
            "id": "746870304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Have we met before?",
            "nextDialogs": [
              "746870305"
            ]
          },
          "746870305": {
            "id": "746870305",
            "speakerId": 30839,
            "speakerName": "Marine",
            "text": "Nothing wrong at all! It's good to see such famously strong heroes here to help!",
            "nextDialogs": [
              "746870306"
            ]
          },
          "746870306": {
            "id": "746870306",
            "speakerId": 30839,
            "speakerName": "Marine",
            "text": "Back in the unit — and after I returned to the village, too — everyone said you two could take care of anything.",
            "nextDialogs": [
              "746870311"
            ]
          },
          "746870311": {
            "id": "746870311",
            "speakerId": 30839,
            "speakerName": "Marine",
            "text": "On the other hand, those two over there are reliable enough, but there's something a little... awkward between them.",
            "nextDialogs": [
              "746870312"
            ]
          },
          "746870312": {
            "id": "746870312",
            "speakerId": 30839,
            "speakerName": "Marine",
            "text": "Human emotions are complicated... I think maybe they could do with a little push.",
            "nextDialogs": [
              "746870313"
            ]
          },
          "746870313": {
            "id": "746870313",
            "speakerId": 1002,
            "speakerName": "Traveler",
            "text": "Awkward?",
            "nextDialogs": [
              "746870314"
            ]
          },
          "746870314": {
            "id": "746870314",
            "speakerId": 30839,
            "speakerName": "Marine",
            "text": "Forget it. There are more important things to focus on.",
            "nextDialogs": [
              "746870315"
            ]
          },
          "746870315": {
            "id": "746870315",
            "speakerId": 30839,
            "speakerName": "Marine",
            "text": "Anyway, I have faith in you. The cannon's easy enough to operate. I'm sure you'll have those monsters cleared up in short order."
          },
          "746870308": {
            "id": "746870308",
            "speakerId": 30839,
            "speakerName": "Marine",
            "text": "So you do remember me! I applied for a position at the Chevalmarin Film Fantasyland.",
            "nextDialogs": [
              "746870309"
            ]
          },
          "746870309": {
            "id": "746870309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon thinks she maybe remembers that...",
            "nextDialogs": [
              "746870310"
            ]
          },
          "746870310": {
            "id": "746870310",
            "speakerId": 30839,
            "speakerName": "Marine",
            "text": "I'm well aware of your deeds, and I know I can trust you with anything."
          }
        }
      }
    },
    {
      "subId": "7468701",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746870101"
        ],
        "dialogs": {
          "746870101": {
            "id": "746870101",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "We've been at this for half a day now, and the monsters aren't showing any signs of thinning out...",
            "nextDialogs": [
              "746870102"
            ]
          },
          "746870102": {
            "id": "746870102",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "Maybe I should call for reinforcements?",
            "nextDialogs": [
              "746870103"
            ]
          },
          "746870103": {
            "id": "746870103",
            "speakerId": 30509,
            "speakerName": "Frejus",
            "text": "There's no need to panic. Trust in the cannon and our plainclothes colleague!",
            "nextDialogs": [
              "746870104"
            ]
          },
          "746870104": {
            "id": "746870104",
            "speakerId": 30509,
            "speakerName": "Frejus",
            "text": "Besides, there's an adventurer with a nose for danger and a certain officer who are sure to turn up should we find ourselves in a crisis...",
            "nextDialogs": [
              "746870107"
            ]
          },
          "746870107": {
            "id": "746870107",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "#Wow, here they are... Proto-Boss and {M#his}{F#her} little assistant really have shown up!",
            "nextDialogs": [
              "746870108"
            ]
          },
          "746870108": {
            "id": "746870108",
            "speakerId": 30509,
            "speakerName": "Frejus",
            "text": "Hello, you two. Please allow me to explain the situation...",
            "nextDialogs": [
              "746870109"
            ]
          },
          "746870109": {
            "id": "746870109",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "Why don't you take a breather? I can brief these two.",
            "nextDialogs": [
              "746870110"
            ]
          },
          "746870110": {
            "id": "746870110",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "Hey! Want to have a go on the cannon? Opportunities like this don't roll around often, at least, not since the fleet was destroyed. It'll be a blast from centuries past!",
            "nextDialogs": [
              "746870111"
            ]
          },
          "746870111": {
            "id": "746870111",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "Blowing monsters to smithereens with these specially made projectiles is the perfect way to unwind — and the Gardes will even reward you for it!",
            "nextDialogs": [
              "746870112"
            ]
          },
          "746870112": {
            "id": "746870112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Blasting monsters with a massive cannon... That's right up our alley!"
          }
        }
      }
    }
  ]
}
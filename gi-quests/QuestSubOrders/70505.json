  "subQuests": [
    {
      "subId": "7050501",
      "subQuestName": "Talk to Luka and enter the tavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705050101"
        ],
        "dialogs": {
          "705050101": {
            "id": "705050101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, it's Master Diluc! What brings you here? Do you have nothing to do today?",
            "nextDialogs": [
              "705050102"
            ]
          },
          "705050102": {
            "id": "705050102",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Heh, me? \"Nothing to do\"? Don't count on it. I heard you two were working as bartenders, so I thought I'd drop by to see how you're coming along.",
            "nextDialogs": [
              "705050103"
            ]
          },
          "705050103": {
            "id": "705050103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, you really do catch wind of things quickly!",
            "nextDialogs": [
              "705050104"
            ]
          },
          "705050104": {
            "id": "705050104",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "#So, tell me, {NICKNAME}. How do you like being a bartender?",
            "nextDialogs": [
              "705050105"
            ]
          },
          "705050105": {
            "id": "705050105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Actually, we just started...",
            "nextDialogs": [
              "705050106"
            ]
          },
          "705050106": {
            "id": "705050106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, it's still a little too early to tell. We haven't been at it for very long.",
            "nextDialogs": [
              "705050107"
            ]
          },
          "705050107": {
            "id": "705050107",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Just tell me your initial feelings.",
            "nextDialogs": [
              "705050108"
            ]
          },
          "705050108": {
            "id": "705050108",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Excited? Confused? Anything. How does it feel to be a bartender?",
            "nextDialogs": [
              "705050111"
            ]
          },
          "705050111": {
            "id": "705050111",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I see.",
            "nextDialogs": [
              "705050112"
            ]
          },
          "705050112": {
            "id": "705050112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, didn't you want to ask Paimon, too?",
            "nextDialogs": [
              "705050113"
            ]
          },
          "705050113": {
            "id": "705050113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's initial feeling is... drinks taste good!",
            "nextDialogs": [
              "705050114"
            ]
          },
          "705050114": {
            "id": "705050114",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "...",
            "nextDialogs": [
              "705050115"
            ]
          },
          "705050115": {
            "id": "705050115",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Good. I'm happy for you.",
            "nextDialogs": [
              "705050116"
            ]
          },
          "705050116": {
            "id": "705050116",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Now, could you make me a Gray Valley Sunset, then? I'll leave the size up to you.",
            "nextDialogs": [
              "705050117"
            ]
          },
          "705050117": {
            "id": "705050117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure, I'll get that started for you.",
            "nextDialogs": [
              "705050118"
            ]
          },
          "705050118": {
            "id": "705050118",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Great, take your time."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7403205",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740320501"
        ],
        "dialogs": {
          "740320501": {
            "id": "740320501",
            "speakerId": 1000,
            "speakerName": "Lechlade",
            "text": "I feel so weak... Must be those blasted yellow-green stones again..."
          }
        }
      }
    },
    {
      "subId": "7403202",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740320201"
        ],
        "dialogs": {
          "740320201": {
            "id": "740320201",
            "speakerId": 1000,
            "speakerName": "Lechlade",
            "text": "Something's definitely wrong with those yellow-green stones... I think I'm going to die here.",
            "nextDialogs": [
              "740320202"
            ]
          },
          "740320202": {
            "id": "740320202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um, are you alright?",
            "nextDialogs": [
              "740320203"
            ]
          },
          "740320203": {
            "id": "740320203",
            "speakerId": 1000,
            "speakerName": "Lechlade",
            "text": "In the long run, we'll all be \"fine,\" but I'm going to be \"fine\" before you are.",
            "nextDialogs": [
              "740320205",
              "740320207"
            ]
          },
          "740320205": {
            "id": "740320205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait a minute, this guy doesn't sound fine at all!",
            "nextDialogs": [
              "740320208"
            ]
          },
          "740320208": {
            "id": "740320208",
            "speakerId": 1000,
            "speakerName": "Lechlade",
            "text": "No, I'm fine, literally. If something's wrong, it's too late anyway...",
            "nextDialogs": [
              "740320209"
            ]
          },
          "740320209": {
            "id": "740320209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So are you alright or not?",
            "nextDialogs": [
              "740320210"
            ]
          },
          "740320210": {
            "id": "740320210",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon's very confused. Can you please be more specific?",
            "nextDialogs": [
              "740320211"
            ]
          },
          "740320211": {
            "id": "740320211",
            "speakerId": 1000,
            "speakerName": "Lechlade",
            "text": "Specifically speaking, when I come to the production zone, I get headaches and heart palpitations, and my hands and feet grow cold!",
            "nextDialogs": [
              "740320212"
            ]
          },
          "740320212": {
            "id": "740320212",
            "speakerId": 1000,
            "speakerName": "Lechlade",
            "text": "I'm done for! Do you know what I mean? I'm done for!",
            "nextDialogs": [
              "740320213"
            ]
          },
          "740320213": {
            "id": "740320213",
            "speakerId": 1000,
            "speakerName": "Lechlade",
            "text": "It must be the yellow-green stones! They're evil! You know of those stones, right? The Central Laboratory of the Fontaine Research Institute...",
            "nextDialogs": [
              "740320214"
            ]
          },
          "740320214": {
            "id": "740320214",
            "speakerId": 1000,
            "speakerName": "Lechlade",
            "text": "The yellow-green stones destroyed everything!"
          },
          "740320207": {
            "id": "740320207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You don't sound fine at all."
          }
        }
      }
    },
    {
      "subId": "7403203",
      "subQuestName": "Ask for Arderne's opinion",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740320301"
        ],
        "dialogs": {
          "740320301": {
            "id": "740320301",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "Are you in trouble? Or are others in trouble? You both look healthy, so it must be the latter.",
            "nextDialogs": [
              "740320302"
            ]
          },
          "740320302": {
            "id": "740320302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Indeed...",
            "nextDialogs": [
              "740320303"
            ]
          },
          "740320303": {
            "id": "740320303",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You explain Lechlade's situation.",
            "nextDialogs": [
              "740320304"
            ]
          },
          "740320304": {
            "id": "740320304",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "Him again, huh?",
            "nextDialogs": [
              "740320305"
            ]
          },
          "740320305": {
            "id": "740320305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Can you treat him?",
            "nextDialogs": [
              "740320306"
            ]
          },
          "740320306": {
            "id": "740320306",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "His headache? Or his delusions?",
            "nextDialogs": [
              "740320307"
            ]
          },
          "740320307": {
            "id": "740320307",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? You mean he's not that sick?",
            "nextDialogs": [
              "740320308"
            ]
          },
          "740320308": {
            "id": "740320308",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "Based on his lab results, most likely not.",
            "nextDialogs": [
              "740320309"
            ]
          },
          "740320309": {
            "id": "740320309",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "I heard that he misdiagnosed a patient when he was still on the outside, ignoring some early warning results, and healthcare outcome... Well, he's been a little paranoid ever since.",
            "nextDialogs": [
              "740320310"
            ]
          },
          "740320310": {
            "id": "740320310",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "He's like that to others, and worse when it comes to himself.",
            "nextDialogs": [
              "740320311"
            ]
          },
          "740320311": {
            "id": "740320311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How about the yellow-green stones?",
            "nextDialogs": [
              "740320312"
            ]
          },
          "740320312": {
            "id": "740320312",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "No one else is having those same health issues, right?",
            "nextDialogs": [
              "740320313"
            ]
          },
          "740320313": {
            "id": "740320313",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "But I can't very well ignore him, so please, give him this.",
            "nextDialogs": [
              "740320314"
            ]
          },
          "740320314": {
            "id": "740320314",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Isn't this Pure Water? Are you sure?",
            "nextDialogs": [
              "740320315"
            ]
          },
          "740320315": {
            "id": "740320315",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "Oh, so you know what this is. It's fine in the sense that it does no harm to the body, and it'll give him a boost.",
            "nextDialogs": [
              "740320317",
              "740320319"
            ]
          },
          "740320317": {
            "id": "740320317",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "As far as I know, he stays away from these drinks. But I gave it to him before, telling him it was a health potion, and he did actually show more vigor after drinking it.",
            "nextDialogs": [
              "740320322"
            ]
          },
          "740320322": {
            "id": "740320322",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Alright, we'll give this to him. If it doesn't work...",
            "nextDialogs": [
              "740320323"
            ]
          },
          "740320323": {
            "id": "740320323",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "Then tell him to go lie down in the infirmary. If you tell him it's \"doctor's orders,\" he'll listen.",
            "nextDialogs": [
              "740320324"
            ]
          },
          "740320324": {
            "id": "740320324",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Sure. Let's go back, {NICKNAME}."
          },
          "740320319": {
            "id": "740320319",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "That's the thing. Everyone here knows what Fonta tastes like.",
            "nextDialogs": [
              "740320320"
            ]
          },
          "740320320": {
            "id": "740320320",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "But based on my knowledge, he hasn't had Pure Water. After all, it's not very common here.",
            "nextDialogs": [
              "740320321"
            ]
          },
          "740320321": {
            "id": "740320321",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "I gave it to him before, telling him it was a health potion, and he did actually show more vigor after drinking it."
          }
        }
      }
    },
    {
      "subId": "7403204",
      "subQuestName": "Report to Lechlade",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740320401"
        ],
        "dialogs": {
          "740320401": {
            "id": "740320401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We're back. The doctor gave you this.",
            "nextDialogs": [
              "740320402"
            ]
          },
          "740320402": {
            "id": "740320402",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Lechlade takes the Pure Water and drinks all of it immediately.",
            "nextDialogs": [
              "740320403"
            ]
          },
          "740320403": {
            "id": "740320403",
            "speakerId": 1000,
            "speakerName": "Lechlade",
            "text": "Ah, me, that's better! Vigor fills me once again!",
            "nextDialogs": [
              "740320405",
              "740320407"
            ]
          },
          "740320405": {
            "id": "740320405",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wasn't that a little too fast?",
            "nextDialogs": [
              "740320408"
            ]
          },
          "740320408": {
            "id": "740320408",
            "speakerId": 1000,
            "speakerName": "Lechlade",
            "text": "Arderne is a really good doctor, and certified, too! The medicine he prescribes always works. Unlike mine...",
            "nextDialogs": [
              "740320409"
            ]
          },
          "740320409": {
            "id": "740320409",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But what about the yellow-green stones?",
            "nextDialogs": [
              "740320410"
            ]
          },
          "740320410": {
            "id": "740320410",
            "speakerId": 1000,
            "speakerName": "Lechlade",
            "text": "Suspicious, of course!",
            "nextDialogs": [
              "740320411"
            ]
          },
          "740320411": {
            "id": "740320411",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ugh, guess his delusions can't be helped.",
            "nextDialogs": [
              "740320412"
            ]
          },
          "740320412": {
            "id": "740320412",
            "speakerId": 1000,
            "speakerName": "Lechlade",
            "text": "Now I can keep working! Thank you so much for helping out. Here, take these Coupons — just a little something to show my appreciation.",
            "nextDialogs": [
              "740320413"
            ]
          },
          "740320413": {
            "id": "740320413",
            "speakerId": 1000,
            "speakerName": "Lechlade",
            "text": "Stay healthy!"
          },
          "740320407": {
            "id": "740320407",
            "speakerId": 1000,
            "speakerName": "Lechlade",
            "text": "No, no, I was sick — but you brought me the cure!"
          }
        }
      }
    },
    {
      "subId": "7403206",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740320601"
        ],
        "dialogs": {
          "740320601": {
            "id": "740320601",
            "speakerId": 1002,
            "speakerName": "Arderne",
            "text": "Don't worry, Lechlade's just acting up again, that's all."
          }
        }
      }
    }
  ]
}
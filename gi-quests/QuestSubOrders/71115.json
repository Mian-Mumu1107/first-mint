        "dialogs": {
          "711151701": {
            "id": "711151701",
            "speakerId": 21344,
            "speakerName": "Carefree Simulacrum",
            "text": "Hmm...? Who art thou, to disturb mine... Ah, it's you, kind humans.",
            "nextDialogs": [
              "711151702"
            ]
          },
          "711151702": {
            "id": "711151702",
            "speakerId": 21344,
            "speakerName": "Carefree Simulacrum",
            "text": "Butterflies... Can you not find them? Hm... Perhaps, if you look over there...",
            "nextDialogs": [
              "711151703"
            ]
          },
          "711151703": {
            "id": "711151703",
            "speakerId": 21344,
            "speakerName": "Carefree Simulacrum",
            "text": "So if that's all, I'm rather sleepy right now, so... *yawn* Don't mind me for a bit...",
            "nextDialogs": [
              "711151704"
            ]
          },
          "711151704": {
            "id": "711151704",
            "speakerId": 21344,
            "speakerName": "Carefree Simulacrum",
            "text": "Zzz... Zzz..."
          }
        }
      }
    },
    {
      "subId": "7111511",
      "subQuestName": "Talk to the Sacred Simulacra",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711151101"
        ],
        "dialogs": {
          "711151101": {
            "id": "711151101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! You liar! We've already returned all the colorful butterflies to the jar, but the adeptal tree still looks the same to Paimon!",
            "nextDialogs": [
              "711151102"
            ]
          },
          "711151102": {
            "id": "711151102",
            "speakerId": 21344,
            "speakerName": "Carefree Simulacrum",
            "text": "Hmm...? Who art thou, to disturb mine... Ah, it's you, kind humans.",
            "nextDialogs": [
              "711151103"
            ]
          },
          "711151103": {
            "id": "711151103",
            "speakerId": 21344,
            "speakerName": "Carefree Simulacrum",
            "text": "Ooh! I never thought you'd actually be able to find all the colorful butterflies! I just said that on a whim...",
            "nextDialogs": [
              "711151104"
            ]
          },
          "711151104": {
            "id": "711151104",
            "speakerId": 21344,
            "speakerName": "Carefree Simulacrum",
            "text": "No, I meant... I felt the adeptal energies too! We just need to recite the formula that Herblord left us and we can revive the adeptal tree!",
            "nextDialogs": [
              "711151105"
            ]
          },
          "711151105": {
            "id": "711151105",
            "speakerId": 21344,
            "speakerName": "Carefree Simulacrum",
            "text": "Hold on, how did that chant go again...?",
            "nextDialogs": [
              "711151106"
            ]
          },
          "711151106": {
            "id": "711151106",
            "speakerId": 21344,
            "speakerName": "Carefree Simulacrum",
            "text": "\"...Born in winter, thriving and withering through time. But I yearn for spring when beauty is regained...\"",
            "nextDialogs": [
              "711151107"
            ]
          },
          "711151107": {
            "id": "711151107",
            "speakerId": 21344,
            "speakerName": "Carefree Simulacrum",
            "text": "Butterflies flutter... flutter... Uh, I don't remember what comes next, but it ends with all being revived!"
          }
        }
      }
    },
    {
      "subId": "7111512",
      "subQuestName": "Talk to the Sacred Simulacra",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711151201"
        ],
        "dialogs": {
          "711151201": {
            "id": "711151201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, it's changed completely!",
            "nextDialogs": [
              "711151202"
            ]
          },
          "711151202": {
            "id": "711151202",
            "speakerId": 21344,
            "speakerName": "Carefree Simulacrum",
            "text": "Since the Herblord entrusted the tree to me, I couldn't stand to see it continue to wither! Thank you, kind humans!",
            "nextDialogs": [
              "711151203"
            ]
          },
          "711151203": {
            "id": "711151203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You couldn't even remember the phrase at all!",
            "nextDialogs": [
              "711151204"
            ]
          },
          "711151204": {
            "id": "711151204",
            "speakerId": 21344,
            "speakerName": "Carefree Simulacrum",
            "text": "Eh, don't sweat the small stuff!",
            "nextDialogs": [
              "711151205"
            ]
          },
          "711151205": {
            "id": "711151205",
            "speakerId": 21344,
            "speakerName": "Carefree Simulacrum",
            "text": "Oh, if you're interested, I can give you a secret tip! Break off a branch and put it in the broken jar outside the abode, and the stone gate will open..."
          }
        }
      }
    },

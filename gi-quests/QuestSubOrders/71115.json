    {
      "subId": "7111516",
      "subQuestName": "Explore the hidden vault",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "622420101"
        ],
        "dialogs": {
          "622420101": {
            "id": "622420101",
            "speakerId": 2242,
            "speakerName": "Ancient Text (I)",
            "text": "\"...They say fish have a bad memory, and I'm starting to wonder if she is one. She won't stop telling me about that 'Motive Mainjade' business...\"",
            "nextDialogs": [
              "622420102"
            ]
          },
          "622420102": {
            "id": "622420102",
            "speakerId": 2242,
            "speakerName": "Ancient Text (I)",
            "text": "\"...Even though it always fills me with the urge to interrupt her, seeing that look of joy on her face makes me decide against it... If anything, efficiency takes a hit when she isn't here to natter away...\"",
            "nextDialogs": [
              "622420103"
            ]
          },
          "622420103": {
            "id": "622420103",
            "speakerId": 2242,
            "speakerName": "Ancient Text (I)",
            "text": "\"...I must keep this locked up. I can never let any person or fish see this. She might start jumping for joy otherwise...\""

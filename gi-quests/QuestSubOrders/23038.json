    {
      "subId": "2303808",
      "subQuestName": "Bring the medicine to Maruf",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230381101"
        ],
        "dialogs": {
          "230381101": {
            "id": "230381101",
            "speakerId": 1002,
            "speakerName": "Maruf",
            "text": "Hmm, I don't think there was anything wrong with that ingredient, and I'm sure my brewing method was correct. What happened...",
            "nextDialogs": [
              "230381102"
            ]
          },
          "230381102": {
            "id": "230381102",
            "speakerId": 1002,
            "speakerName": "Maruf",
            "text": "T—Traveler, what brings you here?",
            "nextDialogs": [
              "230381103"
            ]
          },
          "230381103": {
            "id": "230381103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Zakariya sent me here.",
            "nextDialogs": [
              "230381104"
            ]
          },
          "230381104": {
            "id": "230381104",
            "speakerId": 1002,
            "speakerName": "Maruf",
            "text": "So you must've heard about the mess I've made. This is embarrassing...",
            "nextDialogs": [
              "230381105"
            ]
          },
          "230381105": {
            "id": "230381105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Anyway, drink the medicine first.",
            "nextDialogs": [
              "230381106"
            ]
          },
          "230381106": {
            "id": "230381106",
            "speakerId": 1002,
            "speakerName": "Maruf",
            "text": "O—Okay...",
            "nextDialogs": [
              "230381107"
            ]
          },
          "230381107": {
            "id": "230381107",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Maruf drinks the medicine...",
            "nextDialogs": [
              "230381108"
            ]
          },
          "230381108": {
            "id": "230381108",
            "speakerId": 1002,
            "speakerName": "Maruf",
            "text": "Phew... I feel much better. Zakariya's indeed a great doctor.",
            "nextDialogs": [
              "230381109"
            ]
          },
          "230381109": {
            "id": "230381109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why did you modify the prescription?",
            "nextDialogs": [
              "230381110"
            ]
          },
          "230381110": {
            "id": "230381110",
            "speakerId": 1002,
            "speakerName": "Maruf",
            "text": "Do you remember the medicine we brewed together last time? It didn't work very well.",
            "nextDialogs": [
              "230381111"
            ]
          },
          "230381111": {
            "id": "230381111",
            "speakerId": 1002,
            "speakerName": "Maruf",
            "text": "I thought I might've boiled it the wrong way or missed a few ingredients.",
            "nextDialogs": [
              "230381112"
            ]
          },
          "230381112": {
            "id": "230381112",
            "speakerId": 1002,
            "speakerName": "Maruf",
            "text": "So I... Um... made another bowl based on my experience.",
            "nextDialogs": [
              "230381113"
            ]
          },
          "230381113": {
            "id": "230381113",
            "speakerId": 1002,
            "speakerName": "Maruf",
            "text": "I tried it first as a reasonable precaution, and I believe you know the rest.",
            "nextDialogs": [
              "230381114"
            ]
          },
          "230381114": {
            "id": "230381114",
            "speakerId": 1002,
            "speakerName": "Maruf",
            "text": "I just sent someone to get some medicine for me from Dr. Zakariya, but you beat him to the punch.",
            "nextDialogs": [
              "230381115"
            ]
          },
          "230381115": {
            "id": "230381115",
            "speakerId": 1002,
            "speakerName": "Maruf",
            "text": "Thank you, Traveler. I'm going to get some rest now. After that I'll have to start receiving patients again.",
            "nextDialogs": [
              "230381116"
            ]
          },
          "230381116": {
            "id": "230381116",
            "speakerId": 1002,
            "speakerName": "Maruf",
            "text": "I've been absent for so long... Many villagers must be waiting.",
            "nextDialogs": [
              "230381117"
            ]
          },
          "230381117": {
            "id": "230381117",
            "speakerId": 1002,
            "speakerName": "Maruf",
            "text": "*sigh* But I'm running out of herbs again..."
          }
        }
      }
    },

    {
      "subId": "2303801",
      "subQuestName": "Talk to Zakariya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230380101"
        ],
        "dialogs": {
          "230380101": {
            "id": "230380101",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Oh! Traveler! Come over here, I'd like to ask a favor of you.",
            "nextDialogs": [
              "230380102"
            ]
          },
          "230380102": {
            "id": "230380102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "230380103"
            ]
          },
          "230380103": {
            "id": "230380103",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Do you remember Maruf, the doctor from Aaru Village? He sent you to get a prescription from me last time.",
            "nextDialogs": [
              "230380104"
            ]
          },
          "230380104": {
            "id": "230380104",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "The poor guy brewed a medicine, tasted it, and ended up retching and vomiting for days.",
            "nextDialogs": [
              "230380105"
            ]
          },
          "230380105": {
            "id": "230380105",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "He said that the original prescription didn't work, so he sought to improve it.",
            "nextDialogs": [
              "230380106"
            ]
          },
          "230380106": {
            "id": "230380106",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "What in Teyvat did he do to find himself in this miserable state?",
            "nextDialogs": [
              "230380107"
            ]
          },
          "230380107": {
            "id": "230380107",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "*sigh* He must've done more than just adjusting the brewing method and modifying the amount of ingredients used.",
            "nextDialogs": [
              "230380108"
            ]
          },
          "230380108": {
            "id": "230380108",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "This is not the first time it's happened. Maruf just can't learn his lesson, can he?",
            "nextDialogs": [
              "230380109"
            ]
          },
          "230380109": {
            "id": "230380109",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Forget it. Perhaps he ran into some difficulties.",
            "nextDialogs": [
              "230380110"
            ]
          },
          "230380110": {
            "id": "230380110",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Traveler, could you get some raw ingredients for me? I'll brew a soup myself. Please bring it to Maruf.",
            "nextDialogs": [
              "230380114",
              "230380113"
            ]
          },
          "230380114": {
            "id": "230380114",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Maruf adjusted the prescription that I gave him for treating headaches.",
            "nextDialogs": [
              "230380115"
            ]
          },
          "230380115": {
            "id": "230380115",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "I still need three Henna Berries. Could you get them for me?"
          },
          "230380113": {
            "id": "230380113",
            "speakerId": 1000,
            "speakerName": "Zakariya",
            "text": "Yeah, I can't remember how many times. Luckily, he seldom handles poisonous ingredients. Otherwise..."
          }
        }
      }
    },

    {
      "subId": "4000202",
      "subQuestName": "Go to Xiao Market",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400020201"
        ],
        "dialogs": {
          "400020201": {
            "id": "400020201",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "Oh, hello you two. Many thanks for your donation to Lantern Rite.",
            "nextDialogs": [
              "400020202"
            ]
          },
          "400020202": {
            "id": "400020202",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "Today, I have another matter to discuss with you. Not a donation this time; more of a sales and purchase situation. Interested?",
            "nextDialogs": [
              "400020203"
            ]
          },
          "400020203": {
            "id": "400020203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sure beats working for free, like last time! Paimon's interested.",
            "nextDialogs": [
              "400020204"
            ]
          },
          "400020204": {
            "id": "400020204",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "Haha, wonderful! I appreciate the help. Now, let me explain the situation...",
            "nextDialogs": [
              "400020205"
            ]
          },
          "400020205": {
            "id": "400020205",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "I need two kinds of Plaustrite for official festival use.",
            "nextDialogs": [
              "400020206"
            ]
          },
          "400020206": {
            "id": "400020206",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "One is called Azurite. It is occasionally found in the northern part of Mt. Tianheng.",
            "nextDialogs": [
              "400020207"
            ]
          },
          "400020207": {
            "id": "400020207",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "When Azurite gets caught in the roots of ordinary vegetation, it sometimes produces Bloatty Floatties, which have floating seeds.",
            "nextDialogs": [
              "400020208"
            ]
          },
          "400020208": {
            "id": "400020208",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "The other one is called Vermillionite, which is extremely dangerous as far as most people are concerned...",
            "nextDialogs": [
              "400020209"
            ]
          },
          "400020209": {
            "id": "400020209",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "In Guili Plains, old Ruin Hunters who have lost the power of flight use Vermillionite to keep themselves airborne.",
            "nextDialogs": [
              "400020210"
            ]
          },
          "400020210": {
            "id": "400020210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Got it! So, Azurite and Vermillionite, right?",
            "nextDialogs": [
              "400020211"
            ]
          },
          "400020211": {
            "id": "400020211",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "(Actually, they're just blue and red varieties of Plaustrite... Gemstone merchants only gave them fancy names to try and impress their customers...)",
            "nextDialogs": [
              "400020212"
            ]
          },
          "400020212": {
            "id": "400020212",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "That's right. Please get some of each for me. Good luck!"
          }
        }
      }
    },

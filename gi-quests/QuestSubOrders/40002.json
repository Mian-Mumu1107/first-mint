    {
      "subId": "4000207",
      "subQuestName": "Talk to Paimon (Hidden)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400020701"
        ],
        "dialogs": {
          "400020701": {
            "id": "400020701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Look, over there! That guy's acting very suspicious, don't you think?"
          }
        }
      }
    },
    {
      "subId": "4000208",
      "subQuestName": "Talk to the suspicious person",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400020801"
        ],
        "dialogs": {
          "400020801": {
            "id": "400020801",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Hey, whatcha doin'?",
            "nextDialogs": [
              "400020802"
            ]
          },
          "400020802": {
            "id": "400020802",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Whatcha staring at me like that for? Get gone!",
            "nextDialogs": [
              "400020803"
            ]
          },
          "400020803": {
            "id": "400020803",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Wha— Huh?",
            "nextDialogs": [
              "400020804"
            ]
          },
          "400020804": {
            "id": "400020804",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "...Alright, if you all won't get gone, I'm just gonna get going myself I guess...",
            "nextDialogs": [
              "400020805"
            ]
          },
          "400020805": {
            "id": "400020805",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow. Paimon thought he might be a shady character, then he opened his mouth and now Paimon's sure of it!",
            "nextDialogs": [
              "400020806"
            ]
          },
          "400020806": {
            "id": "400020806",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He must have been up to something when he was crouching down on the ground. Because as soon as he saw us approaching, he stood up and acted all innocent...",
            "nextDialogs": [
              "400020807"
            ]
          },
          "400020807": {
            "id": "400020807",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, Paimon has a bad feeling about this...",
            "nextDialogs": [
              "400020808"
            ]
          },
          "400020808": {
            "id": "400020808",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What could he be up to? Let's investigate!"
          }
        }
      }
    },
    {
      "subId": "4000209",
      "subQuestName": "Investigate around the stockpile",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400020901"
        ],
        "dialogs": {
          "400020901": {
            "id": "400020901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, look.",
            "nextDialogs": [
              "400020902"
            ]
          },
          "400020902": {
            "id": "400020902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This area is full of construction supplies for the Mingxiao Lantern: paper, oil, wood..."
          }
        }
      }
    },
    {
      "subId": "4000210",
      "subQuestName": "（test）在材料区调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400021001"
        ],
        "dialogs": {
          "400021001": {
            "id": "400021001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "On the final day of the Lantern Rite festival, huge crowds come out to watch the Mingxiao Lantern being released.",
            "nextDialogs": [
              "400021002"
            ]
          },
          "400021002": {
            "id": "400021002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It can't be a good sign if there's a suspicious character lurking around somewhere so dangerous.",
            "nextDialogs": [
              "400021003"
            ]
          },
          "400021003": {
            "id": "400021003",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "If he's been tampering with the stockpile of lantern supplies...",
            "nextDialogs": [
              "400021401"
            ]
          },
          "400021401": {
            "id": "400021401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This is a matter for the authorities! Quick, let's go to the Liyue Ministry of Civil Affairs and report it at once!",
            "nextDialogs": [
              "400021406"
            ]
          },
          "400021406": {
            "id": "400021406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon, you're taking this very seriously. Why?",
            "nextDialogs": [
              "400021407"
            ]
          },
          "400021407": {
            "id": "400021407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Because... Because... Everyone in Liyue has worked really hard for this! No-one should be allowed to spoil it, period!",
            "nextDialogs": [
              "400021408"
            ]
          },
          "400021408": {
            "id": "400021408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...What's the real reason?",
            "nextDialogs": [
              "400021409"
            ]
          },
          "400021409": {
            "id": "400021409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Because... Near the harbor is that Zhongyuan Chop Suey place! Take one bite, hooked for life! The original and best!",
            "nextDialogs": [
              "400021410"
            ]
          },
          "400021410": {
            "id": "400021410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Clearly their marketing campaigns have been effective.",
            "nextDialogs": [
              "400021411"
            ]
          },
          "400021411": {
            "id": "400021411",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ehehehe..."
          }
        }
      }
    },
    {
      "subId": "4000211",

    {
      "subId": "4000205",
      "subQuestName": "Go back to Xiao Market and talk to Huixin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400020501"
        ],
        "dialogs": {
          "400020501": {
            "id": "400020501",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "Ooh... These are some fine pieces of Azurite and Vermillionite!",
            "nextDialogs": [
              "400020502"
            ]
          },
          "400020502": {
            "id": "400020502",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "My thanks to you both. Here's your payment.",
            "nextDialogs": [
              "400020503"
            ]
          },
          "400020503": {
            "id": "400020503",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "None of your efforts are wasted. Every piece adds that bit more luster and color to Lantern Rite.",
            "nextDialogs": [
              "400020504"
            ]
          },
          "400020504": {
            "id": "400020504",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "Since you're staying in Liyue during the festival, make sure to keep an eye on the Mingxiao Lantern.",
            "nextDialogs": [
              "400020505"
            ]
          },
          "400020505": {
            "id": "400020505",
            "speakerId": 2029,
            "speakerName": "Huixin",
            "text": "As the work progresses, the construction site at the harbor will become more and more magnificent to behold.",
            "nextDialogs": [
              "400020506"
            ]
          },
          "400020506": {
            "id": "400020506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Sounds fascinating. {NICKNAME}, how about we take a look now?"
          }
        }
      }
    },
    {
      "subId": "4000206",

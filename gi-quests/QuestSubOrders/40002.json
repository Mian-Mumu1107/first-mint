    {
      "subId": "4000215",
      "subQuestName": "Talk to the Millelith",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400021501"
        ],
        "dialogs": {
          "400021501": {
            "id": "400021501",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "Hold up! This is the Liyue Ministry of Civil Affairs.",
            "nextDialogs": [
              "400021502"
            ]
          },
          "400021502": {
            "id": "400021502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We are here to report some suspicious activity.",
            "nextDialogs": [
              "400021503"
            ]
          },
          "400021503": {
            "id": "400021503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, we saw a shady-looking guy snooping around near the stockpile of highly flammable Mingxiao Lantern supplies!",
            "nextDialogs": [
              "400021504"
            ]
          },
          "400021504": {
            "id": "400021504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We absolutely cannot let this be the end of Zhongyuan Chop Suey!",
            "nextDialogs": [
              "400021505"
            ]
          },
          "400021505": {
            "id": "400021505",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "Hmm, goodness! This is a serious matter indeed.",
            "nextDialogs": [
              "400021506"
            ]
          },
          "400021506": {
            "id": "400021506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Exactly what Paimon thought! Liyue Harbor's cuisine is the heart and soul of the city—",
            "nextDialogs": [
              "400021507"
            ]
          },
          "400021507": {
            "id": "400021507",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "...It seems we disagree on where the seriousness of the matter lies. But you're not wrong, my little friend.",
            "nextDialogs": [
              "400021508"
            ]
          },
          "400021508": {
            "id": "400021508",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "I have noted your concerns and will pass them on diligently to my superiors.",
            "nextDialogs": [
              "400021509"
            ]
          },
          "400021509": {
            "id": "400021509",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "Thank you. You were right to report this.",
            "nextDialogs": [
              "400021510"
            ]
          },
          "400021510": {
            "id": "400021510",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Make sure it's given top priority! It needs to be dealt with properly!"
          }
        }
      }
    }

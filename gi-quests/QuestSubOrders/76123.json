        "dialogs": {
          "761230101": {
            "id": "761230101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That smells great! Did we make it in time for Columbina's mealtime again?",
            "nextDialogs": [
              "761230102"
            ]
          },
          "761230102": {
            "id": "761230102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh. Are those kuuhenki... lining up? For soup that Columbina's serving?",
            "nextDialogs": [
              "761230103"
            ]
          },
          "761230103": {
            "id": "761230103",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Just a moment.",
            "nextDialogs": [
              "761230104"
            ]
          },
          "761230104": {
            "id": "761230104",
            "speakerId": 16119,
            "speakerName": "Kuuhenki",
            "text": "~!",
            "nextDialogs": [
              "761230105"
            ]
          },
          "761230105": {
            "id": "761230105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, this is really good!",
            "nextDialogs": [
              "761230106"
            ]
          },
          "761230106": {
            "id": "761230106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Refreshing, tasty fruit soup — Paimon's never had anything quite like it!",
            "nextDialogs": [
              "761230107"
            ]
          },
          "761230107": {
            "id": "761230107",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Another serving?",
            "nextDialogs": [
              "761230108"
            ]
          },
          "761230108": {
            "id": "761230108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Make that two!",
            "nextDialogs": [
              "761230109"
            ]
          },
          "761230109": {
            "id": "761230109",
            "speakerId": 15380,
            "speakerName": "Luonnotar",
            "text": "...!",
            "nextDialogs": [
              "761230110"
            ]
          },
          "761230110": {
            "id": "761230110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you learning to cook?",
            "nextDialogs": [
              "761230111"
            ]
          },
          "761230111": {
            "id": "761230111",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Yes. I asked Ineffa for some basic recipes, and have made several attempts. The kuuhenki and animals have both responded quite positively.",
            "nextDialogs": [
              "761230112"
            ]
          },
          "761230112": {
            "id": "761230112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Having any issues in the kitchen?",
            "nextDialogs": [
              "761230113"
            ]
          },
          "761230113": {
            "id": "761230113",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Well... My sleeves are too wide. They brush against the pot if I'm not careful...",
            "nextDialogs": [
              "761230114"
            ]
          },
          "761230114": {
            "id": "761230114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(So, it's not the cooking itself that's giving you trouble.)",
            "nextDialogs": [
              "761230115"
            ]
          },
          "761230115": {
            "id": "761230115",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "I struggle somewhat with making desserts, though.",
            "nextDialogs": [
              "761230116"
            ]
          },
          "761230116": {
            "id": "761230116",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "You have to get the temperature and proportions just right...",
            "nextDialogs": [
              "761230117"
            ]
          },
          "761230117": {
            "id": "761230117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(She must not have cooked much for herself in the past, then.)",
            "nextDialogs": [
              "761230118"
            ]
          },
          "761230118": {
            "id": "761230118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Besides, desserts and snacks are particularly hard to get right if you're working solo...)",
            "nextDialogs": [
              "761230119"
            ]
          },
          "761230119": {
            "id": "761230119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Would you like me to help?",
            "nextDialogs": [
              "761230120"
            ]
          },
          "761230120": {
            "id": "761230120",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Sure. Let's start with krumkake, shall we?",
            "nextDialogs": [
              "761230121"
            ]
          },
          "761230121": {
            "id": "761230121",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Some time later...",
            "nextDialogs": [
              "761230122"
            ]
          },
          "761230122": {
            "id": "761230122",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Would you like to try one?",
            "nextDialogs": [
              "761230125"
            ]
          },
          "761230125": {
            "id": "761230125",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "...",
            "nextDialogs": [
              "761230126"
            ]
          },
          "761230126": {
            "id": "761230126",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Oh wow, that first bite probably soured my face into a prune...)",
            "nextDialogs": [
              "761230127"
            ]
          },
          "761230127": {
            "id": "761230127",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(But after you swallow some, the sweetness resurfaces... Maybe it gets better once you get used to it...)",
            "nextDialogs": [
              "761230128"
            ]
          },
          "761230128": {
            "id": "761230128",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "What do you think?"
          }
        }
      }

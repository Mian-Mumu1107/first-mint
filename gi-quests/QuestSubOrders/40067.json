  "subQuests": [
    {
      "subId": "4006701",
      "subQuestName": "Look around for the items you need",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400670101"
        ],
        "dialogs": {
          "400670101": {
            "id": "400670101",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "...Seems like similar things happen every time I'm with you. I'll attempt divination, read the signs, zero in on the target, then solve the problem.",
            "nextDialogs": [
              "400670102"
            ]
          },
          "400670102": {
            "id": "400670102",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "You're surrounded by all kinds of friends, secrets, and destinies. It's incredible.",
            "nextDialogs": [
              "400670103"
            ]
          },
          "400670103": {
            "id": "400670103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "No, you're incredible! You helped Fischl and us solve that Leonard situation.",
            "nextDialogs": [
              "400670104"
            ]
          },
          "400670104": {
            "id": "400670104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is this a good thing for an astrologist?",
            "nextDialogs": [
              "400670105"
            ]
          },
          "400670105": {
            "id": "400670105",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "All things considered, I suppose. Let's hope we can all stick together and resolve this, like we did last time.",
            "nextDialogs": [
              "400670106"
            ]
          },
          "400670106": {
            "id": "400670106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "When you say together, do you mean the two of you, or all three of us?",
            "nextDialogs": [
              "400670107"
            ]
          },
          "400670107": {
            "id": "400670107",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Pff...",
            "nextDialogs": [
              "400670108"
            ]
          },
          "400670108": {
            "id": "400670108",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Okay, okay, the three of us then! Sometimes, Paimon offers an insightful perspective that can be very helpful to me.",
            "nextDialogs": [
              "400670109"
            ]
          },
          "400670109": {
            "id": "400670109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Really? Paimon's starting to like you a lot, Genius Astrologist Mona!",
            "nextDialogs": [
              "400670110"
            ]
          },
          "400670110": {
            "id": "400670110",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Yes, that's the perspective I'm talking about! You'll never meet another astrologist as clever and charming as me, ohohohoho!",
            "nextDialogs": [
              "400670111"
            ]
          },
          "400670111": {
            "id": "400670111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah, everything about you's great, except for, um... please don't laugh like Fischl again... ever.",
            "nextDialogs": [
              "400670112"
            ]
          },
          "400670112": {
            "id": "400670112",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Ahem! Sorry... Heh, friends' habits rub off on you when you spend a lot of time together, don't they... haha... hah...",
            "nextDialogs": [
              "400670113"
            ]
          },
          "400670113": {
            "id": "400670113",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "#I'll keep observing the stars. Keep in touch, {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "4006702",
      "subQuestName": "Place the rock into the bonsai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400670201"
        ],
        "dialogs": {
          "400670201": {
            "id": "400670201",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "...When we set foot in this picture-perfect place, I never would've imagined we'd be dealing with such a mystifying occurrence.",
            "nextDialogs": [
              "400670202"
            ]
          },
          "400670202": {
            "id": "400670202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How do you feel about it?",
            "nextDialogs": [
              "400670203"
            ]
          },
          "400670203": {
            "id": "400670203",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Fine, I suppose. I could use some help though.",
            "nextDialogs": [
              "400670204"
            ]
          },
          "400670204": {
            "id": "400670204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What do you need us to do?",
            "nextDialogs": [
              "400670205"
            ]
          },
          "400670205": {
            "id": "400670205",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Um...",
            "nextDialogs": [
              "400670206"
            ]
          },
          "400670206": {
            "id": "400670206",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Uhh... nothing, actually.",
            "nextDialogs": [
              "400670207"
            ]
          },
          "400670207": {
            "id": "400670207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What? Are you underestimating us!?",
            "nextDialogs": [
              "400670208"
            ]
          },
          "400670208": {
            "id": "400670208",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "No, I just realized that although you never talk much, you do so much for us all, quietly, in the background.",
            "nextDialogs": [
              "400670209"
            ]
          },
          "400670209": {
            "id": "400670209",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "You're the companion everyone needs. I think we're all very relieved to have you here.",
            "nextDialogs": [
              "400670210"
            ]
          },
          "400670210": {
            "id": "400670210",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "I know putting high expectations on you might give you some unwelcome pressure, but... I like to think an astrologist's observations can yield insights outside the night sky alone, and noticing other people's strengths is a kind of observation, too.",
            "nextDialogs": [
              "400670211"
            ]
          },
          "400670211": {
            "id": "400670211",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So you just wanted to compliment us?",
            "nextDialogs": [
              "400670212"
            ]
          },
          "400670212": {
            "id": "400670212",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "I was simply stating the facts, not complimenting anyone.",
            "nextDialogs": [
              "400670213"
            ]
          },
          "400670213": {
            "id": "400670213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hmm, so you can't admit...",
            "nextDialogs": [
              "400670214"
            ]
          },
          "400670214": {
            "id": "400670214",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...that you're actually complimenting someone!",
            "nextDialogs": [
              "400670215"
            ]
          },
          "400670215": {
            "id": "400670215",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Stop smirking at me! I told you, it was an objective evaluation, not a compliment! Not a compliment!",
            "nextDialogs": [
              "400670216"
            ]
          },
          "400670216": {
            "id": "400670216",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "#I'll keep observing the stars. Stay in touch, {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "4006703",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400670301"
        ],
        "dialogs": {
          "400670301": {
            "id": "400670301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What's happened here? Everything is broken...",
            "nextDialogs": [
              "400670302"
            ]
          },
          "400670302": {
            "id": "400670302",
            "speakerId": 1002,
            "speakerName": "Fischl",
            "text": "...Alas, the loftier the clan, the more devastating the fall.",
            "nextDialogs": [
              "400670303"
            ]
          },
          "400670303": {
            "id": "400670303",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Broken into pieces, and not a single soul around... This must be the way things ended.",
            "nextDialogs": [
              "400670304"
            ]
          },
          "400670304": {
            "id": "400670304",
            "speakerId": 1003,
            "speakerName": "Xinyan",
            "text": "C'mon, let's get movin'."
          }
        }
      }
    },
    {
      "subId": "4006704",
      "subQuestName": "Continue onward through the shattered space",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400670401"
        ],
        "dialogs": {
          "400670401": {
            "id": "400670401",
            "speakerId": 1004,
            "speakerName": "Boatman",
            "text": "Kaedehara, that's you, right? Get on board, I'll get you out!",
            "nextDialogs": [
              "400670402"
            ]
          },
          "400670402": {
            "id": "400670402",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "But... why are you helping me? I'm a wanted fugitive.",
            "nextDialogs": [
              "400670403"
            ]
          },
          "400670403": {
            "id": "400670403",
            "speakerId": 1004,
            "speakerName": "Boatman",
            "text": "Obviously the Yashiro— Ahem! An anonymous financial sponsor wants you to get out safely.",
            "nextDialogs": [
              "400670404"
            ]
          },
          "400670404": {
            "id": "400670404",
            "speakerId": 1004,
            "speakerName": "Boatman",
            "text": "But there's only so much they can do. After this, you'll be on your own."
          }
        }
      }
    },
    {
      "subId": "4006705",
      "subQuestName": "Continue onward through the shattered space",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400670501"
        ],
        "dialogs": {
          "400670501": {
            "id": "400670501",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "There was supposed to be a dead plant in that flowerpot. However, there was nothing there.",
            "nextDialogs": [
              "400670502"
            ]
          },
          "400670502": {
            "id": "400670502",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "...While we were separated, I had a lot of time to reflect. I think I finally understand now.",
            "nextDialogs": [
              "400670503"
            ]
          },
          "400670503": {
            "id": "400670503",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "The mirage is... me. The empty flowerpot represents the state of my heart.",
            "nextDialogs": [
              "400670504"
            ]
          },
          "400670504": {
            "id": "400670504",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "When the heart is clear, the world is too. And when the heart is unladen, the same is true.",
            "nextDialogs": [
              "400670505"
            ]
          },
          "400670505": {
            "id": "400670505",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Clear and unladen... that describes how I feel right now.",
            "nextDialogs": [
              "400670506"
            ]
          },
          "400670506": {
            "id": "400670506",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Although, I would not say there are no regrets in this. To be unladen is also to be empty.",
            "nextDialogs": [
              "400670507"
            ]
          },
          "400670507": {
            "id": "400670507",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "That's why this bonsai appeared as part of my mirage. It gave me a chance to fulfill my wishes.",
            "nextDialogs": [
              "400670508"
            ]
          },
          "400670508": {
            "id": "400670508",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "I never realized that deep down in my heart, I also wanted to make my own bonsai... Perhaps this is what it really means to keep Kaedehara traditions alive."
          }
        }
      }
    },
    {
      "subId": "4006706",
      "subQuestName": "Continue onward through the shattered space",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400670601"
        ],
        "dialogs": {
          "400670601": {
            "id": "400670601",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Have you finished doing what you wanted to do, Kazuha?",
            "nextDialogs": [
              "400670602"
            ]
          },
          "400670602": {
            "id": "400670602",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Yes, you could say that.",
            "nextDialogs": [
              "400670603"
            ]
          },
          "400670603": {
            "id": "400670603",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "You saw my past self and said goodbye to him. Only when you witness my whole story does it become truly consigned to history.",
            "nextDialogs": [
              "400670604"
            ]
          },
          "400670604": {
            "id": "400670604",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "What really matters in life is not how strict we are with ourselves, but the connections we make along the way. There's no future for those who linger on the past.",
            "nextDialogs": [
              "400670605"
            ]
          },
          "400670605": {
            "id": "400670605",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "So please believe me when I say that I've already come a long way, and I intend to go further still. I will always treasure your support."
          }
        }
      }
    },

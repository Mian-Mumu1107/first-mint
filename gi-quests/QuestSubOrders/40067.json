    {
      "subId": "4006715",
      "subQuestName": "Listen to the voice at the docks",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400671001"
        ],
        "dialogs": {
          "400671001": {
            "id": "400671001",
            "speakerId": 1006,
            "speakerName": "Sea Drake",
            "text": "Hey, buddy! You okay? Need a ride or something?",
            "nextDialogs": [
              "400671002"
            ]
          },
          "400671002": {
            "id": "400671002",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Heh, pirates?",
            "nextDialogs": [
              "400671003"
            ]
          },
          "400671003": {
            "id": "400671003",
            "speakerId": 1006,
            "speakerName": "Sea Drake",
            "text": "Hah, you could call us that! So, you coming or not?"
          }
        }
      }
    },

    {
      "subId": "4006713",
      "subQuestName": "Return to camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400671301"
        ],
        "dialogs": {
          "400671301": {
            "id": "400671301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "*yawn*... It's been a long trip today, Paimon's getting kinda sleepy...",
            "nextDialogs": [
              "400671302"
            ]
          },
          "400671302": {
            "id": "400671302",
            "speakerId": 1003,
            "speakerName": "Xinyan",
            "text": "Everyone must be exhausted. Let's call it a day.",
            "nextDialogs": [
              "400671303"
            ]
          },
          "400671303": {
            "id": "400671303",
            "speakerId": 1002,
            "speakerName": "Fischl",
            "text": "...",
            "nextDialogs": [
              "400671304"
            ]
          },
          "400671304": {
            "id": "400671304",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Hmm? What's wrong? You don't look too good.",
            "nextDialogs": [
              "400671305"
            ]
          },
          "400671305": {
            "id": "400671305",
            "speakerId": 1002,
            "speakerName": "Fischl",
            "text": "Nothing. Perhaps today's arduous journey is making me feel slightly out of sorts.",
            "nextDialogs": [
              "400671306"
            ]
          },
          "400671306": {
            "id": "400671306",
            "speakerId": 1007,
            "speakerName": "Oz",
            "text": "...",
            "nextDialogs": [
              "400671307"
            ]
          },
          "400671307": {
            "id": "400671307",
            "speakerId": 1007,
            "speakerName": "Oz",
            "text": "Mein Fräulein, are you alright?",
            "nextDialogs": [
              "400671308"
            ]
          },
          "400671308": {
            "id": "400671308",
            "speakerId": 1002,
            "speakerName": "Fischl",
            "text": "Oz, curb thy curiosity.",
            "nextDialogs": [
              "400671309"
            ]
          },
          "400671309": {
            "id": "400671309",
            "speakerId": 1007,
            "speakerName": "Oz",
            "text": "Yes, mein Fräulein.",
            "nextDialogs": [
              "400671310"
            ]
          },
          "400671310": {
            "id": "400671310",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "...?",
            "nextDialogs": [
              "400671311"
            ]
          },
          "400671311": {
            "id": "400671311",
            "speakerId": 1003,
            "speakerName": "Xinyan",
            "text": "I'll see if I can find something for us to eat. Go ahead and rest if you're feeling tired, but anyone who's up to it is welcome to help out.",
            "nextDialogs": [
              "400671312"
            ]
          },
          "400671312": {
            "id": "400671312",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "I'll help.",
            "nextDialogs": [
              "400671313"
            ]
          },
          "400671313": {
            "id": "400671313",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Me too.",
            "nextDialogs": [
              "400671314"
            ]
          },
          "400671314": {
            "id": "400671314",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Everyone's volunteering to help! Maybe we should too!",
            "nextDialogs": [
              "400671315"
            ]
          },
          "400671315": {
            "id": "400671315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Count us in.",
            "nextDialogs": [
              "400671316"
            ]
          },
          "400671316": {
            "id": "400671316",
            "speakerId": 1003,
            "speakerName": "Xinyan",
            "text": "Whoa, hey, I appreciate the enthusiasm, but...",
            "nextDialogs": [
              "400671317"
            ]
          },
          "400671317": {
            "id": "400671317",
            "speakerId": 1003,
            "speakerName": "Xinyan",
            "text": "Her Highness looks kinda gloomy. Mona, you two seem close, why don't you keep her company for a while?",
            "nextDialogs": [
              "400671318"
            ]
          },
          "400671318": {
            "id": "400671318",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "You noticed it too. I was going to bring it up with you while we were preparing the food. In that case, yes, just leave it to me.",
            "nextDialogs": [
              "400671319"
            ]
          },
          "400671319": {
            "id": "400671319",
            "speakerId": 1003,
            "speakerName": "Xinyan",
            "text": "Alright! We'll prepare the food!",
            "nextDialogs": [
              "400671320"
            ]
          },
          "400671320": {
            "id": "400671320",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "Mona gives you a wink, then runs to stay with Fischl. Everyone else collects cooking ingredients...",
            "nextDialogs": [
              "400671321"
            ]
          },
          "400671321": {
            "id": "400671321",
            "speakerId": 1003,
            "speakerName": "Xinyan",
            "text": "Yup, this should be enough. We can grill these. Next time we pass by one of those abandoned campsites, I'll see if they have a cooking pot. We'd have some more variety then.",
            "nextDialogs": [
              "400671322"
            ]
          },
          "400671322": {
            "id": "400671322",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, that's such a nice idea! You might not be a chef, Xinyan, but you sure do know how to keep the diners happy.",
            "nextDialogs": [
              "400671323"
            ]
          },
          "400671323": {
            "id": "400671323",
            "speakerId": 1003,
            "speakerName": "Xinyan",
            "text": "Aw shucks, Paimon. It's no big deal, just doing what I can!",
            "nextDialogs": [
              "400671324"
            ]
          },
          "400671324": {
            "id": "400671324",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Even the crew mates of The Alcor consider Xinyan someone they can rely on.",
            "nextDialogs": [
              "400671325"
            ]
          },
          "400671325": {
            "id": "400671325",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We feel the same way about you, too, Kazuha!",
            "nextDialogs": [
              "400671326"
            ]
          },
          "400671326": {
            "id": "400671326",
            "speakerId": 1003,
            "speakerName": "Xinyan",
            "text": "Hahaha, we sure do.",
            "nextDialogs": [
              "400671327"
            ]
          },
          "400671327": {
            "id": "400671327",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Hmm... Well then, as a trusted friend, I have something I'd like to talk about.",
            "nextDialogs": [
              "400671328"
            ]
          },
          "400671328": {
            "id": "400671328",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "From what you've been saying, that miraculous mirage seems to have been based on my life story to date.",
            "nextDialogs": [
              "400671329"
            ]
          },
          "400671329": {
            "id": "400671329",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "...It felt just like a dream to me.",
            "nextDialogs": [
              "400671330"
            ]
          },
          "400671330": {
            "id": "400671330",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe that's it. Maybe it represented your dreams.",
            "nextDialogs": [
              "400671331"
            ]
          },
          "400671331": {
            "id": "400671331",
            "speakerId": 1003,
            "speakerName": "Xinyan",
            "text": "In other words... you've always wanted to make your own bonsai, right?",
            "nextDialogs": [
              "400671332"
            ]
          },
          "400671332": {
            "id": "400671332",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Could that be it...? All that was a means of granting me something I wished for?",
            "nextDialogs": [
              "400671333"
            ]
          },
          "400671333": {
            "id": "400671333",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "And since this happened to me, does that mean it could happen to everyone else, too?",
            "nextDialogs": [
              "400671334"
            ]
          },
          "400671334": {
            "id": "400671334",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, I think so.",
            "nextDialogs": [
              "400671335"
            ]
          },
          "400671335": {
            "id": "400671335",
            "speakerId": 1003,
            "speakerName": "Xinyan",
            "text": "I agree. But I wonder whose mirage we'll encounter next?",
            "nextDialogs": [
              "400671336"
            ]
          },
          "400671336": {
            "id": "400671336",
            "speakerId": 1003,
            "speakerName": "Xinyan",
            "text": "Hah, I'm actually kinda looking forward to my own mirage, if it's a dream come true like you say.",
            "nextDialogs": [
              "400671337"
            ]
          },
          "400671337": {
            "id": "400671337",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, you actually want something like this to happen with you, too?",
            "nextDialogs": [
              "400671338"
            ]
          },
          "400671338": {
            "id": "400671338",
            "speakerId": 1003,
            "speakerName": "Xinyan",
            "text": "Aw heck, any mirage to do with me would probably be music-related. Hahaha, it'd be a good chance to showcase a few tunes!",
            "nextDialogs": [
              "400671339"
            ]
          },
          "400671339": {
            "id": "400671339",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You mean you'd wanna do a performance in there!?",
            "nextDialogs": [
              "400671340"
            ]
          },
          "400671340": {
            "id": "400671340",
            "speakerId": 1003,
            "speakerName": "Xinyan",
            "text": "Why not? I don't think any self-respecting musician could stay silent on these islands. Just look at this place!",
            "nextDialogs": [
              "400671341"
            ]
          },
          "400671341": {
            "id": "400671341",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So much confidence and optimism! Xinyan rocks...",
            "nextDialogs": [
              "400671342"
            ]
          },
          "400671342": {
            "id": "400671342",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Oh, uh, {NICKNAME}! Paimon wants to try some of the fruit growing on that cliff over there. Let's go pick some!",
            "nextDialogs": [
              "400671343"
            ]
          },
          "400671343": {
            "id": "400671343",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Oh? Is this about...)",
            "nextDialogs": [
              "400671344"
            ]
          },
          "400671344": {
            "id": "400671344",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Carry on without us, I need a moment with Paimon."
          }
        }
      }
    },
    {
      "subId": "4006714",
      "subQuestName": "Contact Venti in a less conspicuous place",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4006712",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400671201"
        ],
        "dialogs": {
          "400671201": {
            "id": "400671201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Kazuha! We found you!",
            "nextDialogs": [
              "400671202"
            ]
          },
          "400671202": {
            "id": "400671202",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Good timing. I was just reflecting on my life so far, and I think I'm all up to date.",
            "nextDialogs": [
              "400671203"
            ]
          },
          "400671203": {
            "id": "400671203",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "So, what do you think of the Kaedehara Clan's bonsai?",
            "nextDialogs": [
              "400671205",
              "400671208"
            ]
          },
          "400671205": {
            "id": "400671205",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Old things often carry around some form of regret. The Kaedehara Clan is no exception.",
            "nextDialogs": [
              "400671206"
            ]
          },
          "400671206": {
            "id": "400671206",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "But that's okay. Partings produce reunions, if not at home then in a distant land.",
            "nextDialogs": [
              "400671209"
            ]
          },
          "400671209": {
            "id": "400671209",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "This mirage is quite fascinating. It presents life like a stage play, with each scene more captivating than the last.",
            "nextDialogs": [
              "400671210"
            ]
          },
          "400671210": {
            "id": "400671210",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "They say that astrologists have seen it all. So if this mirage intrigued you, that says it was a worthwhile encounter.",
            "nextDialogs": [
              "400671211"
            ]
          },
          "400671211": {
            "id": "400671211",
            "speakerId": 1002,
            "speakerName": "Fischl",
            "text": "Ahem... How fares thy mood?",
            "nextDialogs": [
              "400671212"
            ]
          },
          "400671212": {
            "id": "400671212",
            "speakerId": 1007,
            "speakerName": "Oz",
            "text": "Mein Fräulein inquires as to your present wellbeing, Lord Kazuha, hoping your heart is not too filled with sorrow.",
            "nextDialogs": [
              "400671213"
            ]
          },
          "400671213": {
            "id": "400671213",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "There's no way anyone could be cheerful after reliving all that...",
            "nextDialogs": [
              "400671214"
            ]
          },
          "400671214": {
            "id": "400671214",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Haha, you have a point. Thank you all for your concern. Fortunately, all those things are past and gone now.",
            "nextDialogs": [
              "400671215"
            ]
          },
          "400671215": {
            "id": "400671215",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "When I first saw this bonsai, I thought of the possibility that... I needed to wait for you. Perhaps that was why I had to be here on my own."
          },
          "400671208": {
            "id": "400671208",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Indeed."
          }
        }
      }
    },
    {
      "subId": "4006714",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400671401"
        ],
        "dialogs": {
          "400671401": {
            "id": "400671401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So, those strange houses today, huh... And a... a mirage-bonsai? Basically, lots of weird stuff today! Do you think we should tell Venti about it?",
            "nextDialogs": [
              "400671404"
            ]
          },
          "400671404": {
            "id": "400671404",
            "speakerId": 1009,
            "speakerName": "Dodocommunication Device",
            "text": "Dodoco! Dodoco!",
            "nextDialogs": [
              "400671405"
            ]
          },
          "400671405": {
            "id": "400671405",
            "speakerId": 1009,
            "speakerName": "Dodocommunication Device",
            "text": "Dodoco! Dodoco! Dodoco!",
            "nextDialogs": [
              "400671406"
            ]
          },
          "400671406": {
            "id": "400671406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "There's no answer... That's weird, why is he ignoring us?",
            "nextDialogs": [
              "400671407"
            ]
          },
          "400671407": {
            "id": "400671407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This doesn't seem like him...",
            "nextDialogs": [
              "400671408"
            ]
          },
          "400671408": {
            "id": "400671408",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Maybe he got distracted? Or he forgot to bring the bomb to his performance? Or maybe he got drunk and fell asleep under that huge tree...",
            "nextDialogs": [
              "400671409"
            ]
          },
          "400671409": {
            "id": "400671409",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... maybe we should try contacting him tomorrow.",
            "nextDialogs": [
              "400671410"
            ]
          },
          "400671410": {
            "id": "400671410",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Traveler, Paimon. So here you are.",
            "nextDialogs": [
              "400671411"
            ]
          },
          "400671411": {
            "id": "400671411",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Mona! Are you all done chatting with Fischl?",
            "nextDialogs": [
              "400671412"
            ]
          },
          "400671412": {
            "id": "400671412",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Hahaha, close enough... She was a little downcast. I think it has something to do with the mirage we saw today.",
            "nextDialogs": [
              "400671413"
            ]
          },
          "400671413": {
            "id": "400671413",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Fischl has been very excited about this trip from the start... but I have a feeling she doesn't want to see her own mirage...",
            "nextDialogs": [
              "400671414"
            ]
          },
          "400671414": {
            "id": "400671414",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why? It seems like this'd be the kind of thing she really enjoys.",
            "nextDialogs": [
              "400671415"
            ]
          },
          "400671415": {
            "id": "400671415",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "...I'm not sure at this stage, but I'll keep an eye on her.",
            "nextDialogs": [
              "400671416"
            ]
          },
          "400671416": {
            "id": "400671416",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "There's something else I wanted to tell you. I tried performing a divination again on the beach.",
            "nextDialogs": [
              "400671417"
            ]
          },
          "400671417": {
            "id": "400671417",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "My scryglass was still blurry, but I felt a force coming from within. I couldn't see its exact position, but I knew that it was changing.",
            "nextDialogs": [
              "400671418"
            ]
          },
          "400671418": {
            "id": "400671418",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "How could you tell that if you couldn't see it clearly?",
            "nextDialogs": [
              "400671419"
            ]
          },
          "400671419": {
            "id": "400671419",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Hmm, how can I explain this concept to non-experts... Oh, I know! It's like we're sitting in a room and there's a crack in the walls. We don't know where it is, but everyone can feel the wind rushing in.",
            "nextDialogs": [
              "400671420"
            ]
          },
          "400671420": {
            "id": "400671420",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "Not only that, but the room is getting colder.",
            "nextDialogs": [
              "400671421"
            ]
          },
          "400671421": {
            "id": "400671421",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ohh! Paimon gets it now! So you wanna find where that crack is, right?",
            "nextDialogs": [
              "400671422"
            ]
          },
          "400671422": {
            "id": "400671422",
            "speakerId": 1000,
            "speakerName": "Mona",
            "text": "You could say that. I need to see the crack first before deciding what to do next."
          }
        }
      }
    },
    {
      "subId": "4006799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400679901"
        ],
        "dialogs": {
          "400679901": {
            "id": "400679901",
            "speakerId": 1010,
            "speakerName": "Old Servant",
            "text": "Master, we're the only servants left! Are you sure about this? After we're gone, who's going to...",
            "nextDialogs": [
              "400679902"
            ]
          },
          "400679902": {
            "id": "400679902",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Don't worry, I'll be fine.",
            "nextDialogs": [
              "400679903"
            ]
          },
          "400679903": {
            "id": "400679903",
            "speakerId": 1010,
            "speakerName": "Old Servant",
            "text": "Your mother died early, and now that your father has left you... You're all that remains of this clan now...",
            "nextDialogs": [
              "400679904"
            ]
          },
          "400679904": {
            "id": "400679904",
            "speakerId": 1010,
            "speakerName": "Old Servant",
            "text": "I suppose that this is the last time we will ever see each other. Master, please take care of yourself.",
            "nextDialogs": [
              "400679905"
            ]
          },
          "400679905": {
            "id": "400679905",
            "speakerId": 1011,
            "speakerName": "Sailor",
            "text": "Everyone, on board!",
            "nextDialogs": [
              "400679906"
            ]
          },
          "400679906": {
            "id": "400679906",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Farewell.",
            "nextDialogs": [
              "400679907"
            ]
          },
          "400679907": {
            "id": "400679907",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "The Kaedehara Clan has ultimately disbanded in my hands.",
            "nextDialogs": [
              "400679908"
            ]
          },
          "400679908": {
            "id": "400679908",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "But as my father said, I should not let life imprison me. Perhaps living the wanderer's life is what was meant for me after all.",
            "nextDialogs": [
              "400679909"
            ]
          },
          "400679909": {
            "id": "400679909",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "You know, they say that Visions represent the Archons' gaze.",
            "nextDialogs": [
              "400679910"
            ]
          },
          "400679910": {
            "id": "400679910",
            "speakerId": 1012,
            "speakerName": "Friend",
            "text": "But is being under an Archon's gaze really a blessing?",
            "nextDialogs": [
              "400679911"
            ]
          },
          "400679911": {
            "id": "400679911",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "I don't know, maybe...?",
            "nextDialogs": [
              "400679912"
            ]
          },
          "400679912": {
            "id": "400679912",
            "speakerId": 1013,
            "speakerName": "Shogunate Infantry",
            "text": "Vision Hunt Decree! Hand over your Visions now!",
            "nextDialogs": [
              "400679913"
            ]
          },
          "400679913": {
            "id": "400679913",
            "speakerId": 1012,
            "speakerName": "Friend",
            "text": "This way! Hurry!",
            "nextDialogs": [
              "400679914"
            ]
          },
          "400679914": {
            "id": "400679914",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "I know very well why people resist against the Vision Hunt Decree.",
            "nextDialogs": [
              "400679915"
            ]
          },
          "400679915": {
            "id": "400679915",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Ambition is our power in its rawest form. We cannot live without it.",
            "nextDialogs": [
              "400679916"
            ]
          },
          "400679916": {
            "id": "400679916",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "When no other option remains, I will leave.",
            "nextDialogs": [
              "400679924"
            ]
          },
          "400679924": {
            "id": "400679924",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "My grandfather once traveled to Liyue, while my father read about Mondstadt... but where is the right place for me?",
            "nextDialogs": [
              "400679925"
            ]
          },
          "400679925": {
            "id": "400679925",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "...The sky's getting dark. It looks like it's going to rain.",
            "nextDialogs": [
              "400679926"
            ]
          },
          "400679926": {
            "id": "400679926",
            "speakerId": 1005,
            "speakerName": "Kaedehara Kazuha",
            "text": "Will the rain ever stop?"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7307403",
      "subQuestName": "Talk to Arama and Aradasa",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730740301"
        ],
        "dialogs": {
          "730740301": {
            "id": "730740301",
            "speakerId": 20667,
            "speakerName": "Aradasa",
            "text": "...",
            "nextDialogs": [
              "730740302"
            ]
          },
          "730740302": {
            "id": "730740302",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "This is the song Arayama left behind...",
            "nextDialogs": [
              "730740303"
            ]
          },
          "730740303": {
            "id": "730740303",
            "speakerId": 20667,
            "speakerName": "Aradasa",
            "text": "\"Press forward and sing, even if the path is filled with flame...\"",
            "nextDialogs": [
              "730740304"
            ]
          },
          "730740304": {
            "id": "730740304",
            "speakerId": 20667,
            "speakerName": "Aradasa",
            "text": "\"Even if the pale moonlight on that night resembles the eyes of a dying beast...\"",
            "nextDialogs": [
              "730740305"
            ]
          },
          "730740305": {
            "id": "730740305",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "\"For we are the children of the Valley of Life — for we are the seeds of courage.\"",
            "nextDialogs": [
              "730740306"
            ]
          },
          "730740306": {
            "id": "730740306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So this is the song we found...?",
            "nextDialogs": [
              "730740307"
            ]
          },
          "730740307": {
            "id": "730740307",
            "speakerId": 20667,
            "speakerName": "Aradasa",
            "text": "\"For the pomegranates that wish to bear fruits, for the roses that yearn to blossom.\"",
            "nextDialogs": [
              "730740308"
            ]
          },
          "730740308": {
            "id": "730740308",
            "speakerId": 20667,
            "speakerName": "Aradasa",
            "text": "\"A distant sky yet so close at hand... A promise ever unbroken... A city that returns to you in your dreams...\"",
            "nextDialogs": [
              "730740309"
            ]
          },
          "730740309": {
            "id": "730740309",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "I see, I see it now! We can clear out the obstacles along the way to Ashvattha's Concourse using Arayama's song.",
            "nextDialogs": [
              "730740311"
            ]
          },
          "730740311": {
            "id": "730740311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait a minute. What makes sense again?",
            "nextDialogs": [
              "730740313"
            ]
          },
          "730740313": {
            "id": "730740313",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Through Arayama's song, of course. Hmm... Is this something that might be hard to grasp if you are not an Aranara?",
            "nextDialogs": [
              "730740314"
            ]
          },
          "730740314": {
            "id": "730740314",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Anyway, Aradasa, how about you go back to prepare for Festival Utsava? Leave Ashvattha's Concourse to me!",
            "nextDialogs": [
              "730740315"
            ]
          },
          "730740315": {
            "id": "730740315",
            "speakerId": 20667,
            "speakerName": "Aradasa",
            "text": "♪~",
            "nextDialogs": [
              "730740316"
            ]
          },
          "730740316": {
            "id": "730740316",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We'll come with you! After all, we promised to help you get those Vasoma Fruits!",
            "nextDialogs": [
              "730740317"
            ]
          },
          "730740317": {
            "id": "730740317",
            "speakerId": 20667,
            "speakerName": "Aradasa",
            "text": "\"...Press forward and sing.\""
          }
        }
      }
    },

    {
      "subId": "4114401",
      "subQuestName": "Talk to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411440101"
        ],
        "dialogs": {
          "411440101": {
            "id": "411440101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll deliver it right now.",
            "nextDialogs": [
              "411440102"
            ]
          },
          "411440102": {
            "id": "411440102",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Well, aren't you straightforward... Well, best hurry, then — and <color=#00E1FFFF>be sure not to touch any weird stuff while you're at it</color>.",
            "nextDialogs": [
              "411440103"
            ]
          },
          "411440103": {
            "id": "411440103",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Right, and remember <color=#00E1FFFF>not to use your glider to rush things</color>. If you scatter the meat rolls when you land, the customer isn't taking it."
          }
        }
      }
    },
    {
      "subId": "4114402",

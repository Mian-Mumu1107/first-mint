              "411440602"
            ]
          },
          "411440602": {
            "id": "411440602",
            "speakerId": 1001,
            "speakerName": "Laid Back Ling'guan",
            "text": "Oh, you're here at last. Thanks a lot!",
            "nextDialogs": [
              "411440603"
            ]
          },
          "411440603": {
            "id": "411440603",
            "speakerId": 1001,
            "speakerName": "Laid Back Ling'guan",
            "text": "I was just thinking that I should head back to Wangshu Inn to check in on my order, too..."

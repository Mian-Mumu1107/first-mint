          "411440301"
        ],
        "dialogs": {
          "411440301": {
            "id": "411440301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I heard that someone placed a custom order...",
            "nextDialogs": [
              "411440302"
            ]
          },
          "411440302": {
            "id": "411440302",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "What, you here to lend me a hand?",
            "nextDialogs": [
              "411440303"
            ]
          },
          "411440303": {
            "id": "411440303",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Well, you're just in time. Someone named Ling'guan ordered a Matsutake Meat Roll from me.",
            "nextDialogs": [
              "411440304"
            ]
          },
          "411440304": {
            "id": "411440304",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "She wanted me to send it to some spot northwest of Dihua Marsh. The Mora's already been paid out, too.",
            "nextDialogs": [
              "411440305"
            ]
          },
          "411440305": {
            "id": "411440305",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Well, if you've got time, how about helping me deliver it? You'll be compensated."
          }
        }
      }
    },

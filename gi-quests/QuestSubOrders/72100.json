{
  "lineCounts": {
    "Hanachirusato": 127,
    "Paimon": 46,
    "Player": 60
  },
  "subQuests": [
    {
      "subId": "7210001",
      "subQuestName": "Complete the Sacred Sakura Cleansing Ritual",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721000101"
        ],
        "dialogs": {
          "721000101": {
            "id": "721000101",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "Very impressive.",
            "nextDialogs": [
              "721000102"
            ]
          },
          "721000102": {
            "id": "721000102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eek! How did you... When did you... Why...",
            "nextDialogs": [
              "721000103"
            ]
          },
          "721000103": {
            "id": "721000103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yikes!",
            "nextDialogs": [
              "721000104"
            ]
          },
          "721000104": {
            "id": "721000104",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "I was right to have my eye on you. You are indeed qualified to perform the Cleansing.",
            "nextDialogs": [
              "721000106",
              "721000108"
            ]
          },
          "721000106": {
            "id": "721000106",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "I was quite concerned as to your actions, and as to whether you could heal the roots or not, so I have been observing you a little. If I have offended you, please forgive me.",
            "nextDialogs": [
              "721000110"
            ]
          },
          "721000110": {
            "id": "721000110",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "You have helped me greatly already by being able to undo the barrier.",
            "nextDialogs": [
              "721000111"
            ]
          },
          "721000111": {
            "id": "721000111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "If she's been watching us all this time, that means..."
          },
          "721000108": {
            "id": "721000108",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "I...",
            "nextDialogs": [
              "721000109"
            ]
          },
          "721000109": {
            "id": "721000109",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "As you can see, I am simply a shrine maiden who wishes to cleanse evil with your aid."
          }
        }
      }
    },
    {
      "subId": "7210002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721000201"
        ],
        "dialogs": {
          "721000201": {
            "id": "721000201",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "Again, the two of you have my thanks.",
            "nextDialogs": [
              "721000202"
            ]
          },
          "721000202": {
            "id": "721000202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa!",
            "nextDialogs": [
              "721000203"
            ]
          },
          "721000203": {
            "id": "721000203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This again, eh...",
            "nextDialogs": [
              "721000204"
            ]
          },
          "721000204": {
            "id": "721000204",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "I apologize. There are some things that become... a habit, perhaps.",
            "nextDialogs": [
              "721000205"
            ]
          },
          "721000205": {
            "id": "721000205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why are you following us again? Couldn't you just say hello?",
            "nextDialogs": [
              "721000208"
            ]
          },
          "721000208": {
            "id": "721000208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ah, um, sorry. Paimon's tired from floating around too much... Paimon didn't mean to be rude.",
            "nextDialogs": [
              "721000209"
            ]
          },
          "721000209": {
            "id": "721000209",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "It is alright. The barrier here has been undone successfully, and thus does the Cleansing Ritual come a step closer to completion. Thank you very much.",
            "nextDialogs": [
              "721000210"
            ]
          },
          "721000210": {
            "id": "721000210",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What's the deal with the Sacred Sakura Cleansing Ritual, anyway? Is it the same as the \"cleansing\" you asked us to do earlier?"
          }
        }
      }
    },
    {
      "subId": "7210003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721000301"
        ],
        "dialogs": {
          "721000301": {
            "id": "721000301",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "That was well done — whether it was dealing with Ioroi's illusory tricks, or the way you defeated those demons.",
            "nextDialogs": [
              "721000302"
            ]
          },
          "721000302": {
            "id": "721000302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"Eek!\"",
            "nextDialogs": [
              "721000303"
            ]
          },
          "721000303": {
            "id": "721000303",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Or so Paimon might have said, but this trick of yours is getting real old, Miss Masked Maiden.",
            "nextDialogs": [
              "721000304"
            ]
          },
          "721000304": {
            "id": "721000304",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "Ah, so I disappointed you, then? I apologize. I'll do better next time.",
            "nextDialogs": [
              "721000305"
            ]
          },
          "721000305": {
            "id": "721000305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's no need to \"do better\" at trivial things like this...",
            "nextDialogs": [
              "721000306"
            ]
          },
          "721000306": {
            "id": "721000306",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "That is true. So, as for Ioroi... Is he doing well?",
            "nextDialogs": [
              "721000308",
              "721000310"
            ]
          },
          "721000308": {
            "id": "721000308",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Even though he's been turned into stone.",
            "nextDialogs": [
              "721000311"
            ]
          },
          "721000311": {
            "id": "721000311",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "I see...",
            "nextDialogs": [
              "721000312"
            ]
          },
          "721000312": {
            "id": "721000312",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "Usually, when bake-danuki make a mess, we won't send anyone to deal with them as long as they don't cross the line. After all, although they are mischievous, they're kind-hearted and simple, just like children.",
            "nextDialogs": [
              "721000313"
            ]
          },
          "721000313": {
            "id": "721000313",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "But when Ioroi dared to steal the ward for the Cleansing Ritual, well, that was enough to get him punished. Since the \"Yougou Three\" were mentioned in your story, then it was probably Kamuna... an onmyouji from a past age, who did the deed."
          },
          "721000310": {
            "id": "721000310",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But he's very well!"
          }
        }
      }
    },
    {
      "subId": "7210004",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721000401"
        ],
        "dialogs": {
          "721000401": {
            "id": "721000401",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "Ah. We meet again.",
            "nextDialogs": [
              "721000402"
            ]
          },
          "721000402": {
            "id": "721000402",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "Although it is a pity that we are unable to meet where the sun shines for now, the light from the Thunder Sakura, which symbolizes the divine, and the light from your aura are enough to illuminate this space. If there is anything I can help you with, please let me know.",
            "nextDialogs": [
              "721000405",
              "721000408",
              "721000411",
              "721000414"
            ]
          },
          "721000405": {
            "id": "721000405",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "Apart from Chinju Forest, there is a barrier in a place called Araumi.",
            "nextDialogs": [
              "721000406"
            ]
          },
          "721000406": {
            "id": "721000406",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "Finally, there is a pit on a beach northeast of the Kamisato residence's courtyard. That is where you will find the final barrier."
          },
          "721000408": {
            "id": "721000408",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "In the past, the ward was guarded by the Sky Kitsune. But after everything changed, the Sky and Earth Kitsune eventually refused to show up, instead sleeping and waiting for her return.",
            "nextDialogs": [
              "721000409"
            ]
          },
          "721000409": {
            "id": "721000409",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "If you want to find the ward, look for the Sky Kitsune around the seal... that should be a special fox statue. If you're having difficulties, try to find the Earth Kitsune nearby, or use that Lens to see if there are any clues."
          },
          "721000411": {
            "id": "721000411",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "I'm afraid I don't know much more about this than you. Apart from the Hiiragi Clan's squandering of their divine gift, that is...",
            "nextDialogs": [
              "721000412"
            ]
          },
          "721000412": {
            "id": "721000412",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "There are many sleeping Earth Kitsune in Narukami Island. What you may see before you, though, is most likely to be a small, special fox statue.",
            "nextDialogs": [
              "721000439"
            ]
          },
          "721000439": {
            "id": "721000439",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "In the past, though they were weak in strength, they valued loyalty. If you look at them through the Memento Lens, you should be able to see some scenes from the past."
          },
          "721000414": {
            "id": "721000414",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "\"Our hearts drift with the clouds...\"",
            "nextDialogs": [
              "721000415"
            ]
          },
          "721000415": {
            "id": "721000415",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "If there is anything I can help you with, please do not hesitate to let me know."
          }
        }
      }
    },
    {
      "subId": "7210005",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721000501"
        ],
        "dialogs": {
          "721000501": {
            "id": "721000501",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "There should be no problem...",
            "nextDialogs": [
              "721000502"
            ]
          },
          "721000502": {
            "id": "721000502",
            "speakerId": 1000,
            "speakerName": "Hanachirusato",
            "text": "Ah, it's you. I wish you all the best."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7280801",
      "subQuestName": "Talk to Katheryne in Inazuma",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728080101"
        ],
        "dialogs": {
          "728080101": {
            "id": "728080101",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Ad astra abyssosque! Welcome to the Adventurers' Guild.",
            "nextDialogs": [
              "728080102"
            ]
          },
          "728080102": {
            "id": "728080102",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "You've come at last. I've been waiting for you, Adventurer.",
            "nextDialogs": [
              "728080103"
            ]
          },
          "728080103": {
            "id": "728080103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "An—Another Katheryne...",
            "nextDialogs": [
              "728080104"
            ]
          },
          "728080104": {
            "id": "728080104",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Another? Hehe, have you ever seen multiple Katherynes in a single location?",
            "nextDialogs": [
              "728080105"
            ]
          },
          "728080105": {
            "id": "728080105",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "If you haven't, then they were one and the same.",
            "nextDialogs": [
              "728080106"
            ]
          },
          "728080106": {
            "id": "728080106",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "As the only year-round receptionist in the Adventurers' Guild, I can use a special tool to instantly move between various locations in the world to deal with various important matters...",
            "nextDialogs": [
              "728080107"
            ]
          },
          "728080107": {
            "id": "728080107",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "After I help you with your matters here, I need to head over to Fontaine. The adventurers over there are notorious for frugality, so I need to receive them well.",
            "nextDialogs": [
              "728080110"
            ]
          },
          "728080110": {
            "id": "728080110",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Hmm... You believed me? Sorry, I was joking. Please don't take it seriously.",
            "nextDialogs": [
              "728080111"
            ]
          },
          "728080111": {
            "id": "728080111",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Also, I thought you knew how to use Teleport Waypoints?",
            "nextDialogs": [
              "728080112"
            ]
          },
          "728080112": {
            "id": "728080112",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Anyway, I won't bother you with pointless trivia. Come, I'll help you process the work that's needed by the Inazuma Adventurers' Guild.",
            "nextDialogs": [
              "728080113"
            ]
          },
          "728080113": {
            "id": "728080113",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Once things are processed, you can accept commissions here and also enjoy other benefits.",
            "nextDialogs": [
              "728080114"
            ]
          },
          "728080114": {
            "id": "728080114",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Ad astra abyssosque, Adventurer."
          }
        }
      }
    }
  ]
}
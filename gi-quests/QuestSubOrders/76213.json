        ],
        "dialogs": {
          "762130101": {
            "id": "762130101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Looks like the books are in the way over here...",
            "nextDialogs": [
              "762130102"
            ]
          },
          "762130102": {
            "id": "762130102",
            "speakerId": 7735,
            "speakerName": "Congshen",
            "text": "Are you looking for a book?",
            "nextDialogs": [
              "762130103"
            ]
          },
          "762130103": {
            "id": "762130103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um... Not really. We're just wondering a teensy-weensy bit about what's inside there...",
            "nextDialogs": [
              "762130104"
            ]
          },
          "762130104": {
            "id": "762130104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It seems we could get in there from the side...",
            "nextDialogs": [
              "762130105"
            ]
          },
          "762130105": {
            "id": "762130105",
            "speakerId": 7735,
            "speakerName": "Congshen",
            "text": "You can't go in there.",
            "nextDialogs": [
              "762130106"
            ]
          },
          "762130106": {
            "id": "762130106",
            "speakerId": 7735,
            "speakerName": "Congshen",
            "text": "I move the books, and I move the books. If that is not so, then it is yet to be complete.",
            "nextDialogs": [
              "762130108",
              "762130110"
            ]
          },
          "762130108": {
            "id": "762130108",
            "speakerId": 7735,
            "speakerName": "Congshen",
            "text": "I move the books."
          },
          "762130110": {
            "id": "762130110",
            "speakerId": 7735,
            "speakerName": "Congshen",
            "text": "If the books aren't here, then they must have been moved. All I do is cast my eye on them.",
            "nextDialogs": [
              "762130111"
            ]
          },
          "762130111": {
            "id": "762130111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Then let me give it a try with Dex.",
            "nextDialogs": [
              "762130112"
            ]
          },
          "762130112": {
            "id": "762130112",
            "speakerId": 7735,
            "speakerName": "Congshen",
            "text": "Go straight to it."
          }
        }
      }
    },
    {
      "subId": "7621302",

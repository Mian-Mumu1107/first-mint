    {
      "subId": "7103806",
      "subQuestName": "Go to the beacon placement sites to look for Zhiqiong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710380601"
        ],
        "dialogs": {
          "710380601": {
            "id": "710380601",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "Khedive's given her some medicine... and she's regained consciousness, but she won't tell me anything.",
            "nextDialogs": [
              "710380602"
            ]
          },
          "710380602": {
            "id": "710380602",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "Do you know what happened? How did she end up like... that?",
            "nextDialogs": [
              "710380603"
            ]
          },
          "710380603": {
            "id": "710380603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She was trapped in the black mud when we found her.",
            "nextDialogs": [
              "710380604"
            ]
          },
          "710380604": {
            "id": "710380604",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's right, and we got her out just in time!",
            "nextDialogs": [
              "710380605"
            ]
          },
          "710380605": {
            "id": "710380605",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "...",
            "nextDialogs": [
              "710380606"
            ]
          },
          "710380606": {
            "id": "710380606",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "Never mind that for now. What Zhiqiong needs now is rest. Could you help me deliver this bowl of soup to her while it's still hot?",
            "nextDialogs": [
              "710380607"
            ]
          },
          "710380607": {
            "id": "710380607",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "I'm not a very good cook, but I've had to take care of my fair share of miners, and no one's ever said my fare was bad.",
            "nextDialogs": [
              "710380608"
            ]
          },
          "710380608": {
            "id": "710380608",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "Alright, go then. See if she's any better.",
            "nextDialogs": [
              "710380609"
            ]
          },
          "710380609": {
            "id": "710380609",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "I have to tell Muning that Zhiqiong can't stay underground anymore."
          }
        }
      }
    },
    {
      "subId": "7103807",
      "subQuestName": "Go to the beacon placement sites to look for Zhiqiong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710380701"
        ],
        "dialogs": {
          "710380701": {
            "id": "710380701",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "*cough* *cough* I'm sorry...",
            "nextDialogs": [
              "710380702"
            ]
          },
          "710380702": {
            "id": "710380702",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, so you're sorry now, and not when you were running around all over the place, huh!?",
            "nextDialogs": [
              "710380703"
            ]
          },
          "710380703": {
            "id": "710380703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright, give it a rest, Paimon...",
            "nextDialogs": [
              "710380704"
            ]
          },
          "710380704": {
            "id": "710380704",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "*cough* Hah... I lost my footing... by mistake... funny, huh? *cough*",
            "nextDialogs": [
              "710380705"
            ]
          },
          "710380705": {
            "id": "710380705",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Nope, it's not funny at all! Is your life really worth so little to you!?",
            "nextDialogs": [
              "710380706"
            ]
          },
          "710380706": {
            "id": "710380706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You need rest. Jinwu made you some soup."
          }
        }
      }
    },

    {
      "subId": "7103811",
      "subQuestName": "Talk to Zhiqiong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710380408"
        ],
        "dialogs": {
          "710380408": {
            "id": "710380408",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh oh! She's not looking so good! C'mon, we've got to get her out of here, quick!"
          }
        }
      }
    },
    {
      "subId": "7103817",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710381601"
        ],
        "dialogs": {
          "710381601": {
            "id": "710381601",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "...",
            "nextDialogs": [
              "710381602"
            ]
          },
          "710381602": {
            "id": "710381602",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "Eh? Oh, my bad. There were some things on my mind. Sorry...",
            "nextDialogs": [
              "710381603"
            ]
          },
          "710381603": {
            "id": "710381603",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "I have to give Zhiqiong a good talking-to...",
            "nextDialogs": [
              "710381604"
            ]
          },
          "710381604": {
            "id": "710381604",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "It's not like I haven't seen kids like her while working in the mines all these years...",
            "nextDialogs": [
              "710381605"
            ]
          },
          "710381605": {
            "id": "710381605",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "There are too many who, like her, see adventure as some kind of noble pursuit, only to see their hopes shattered... and find that it is too late to regret their choices.",
            "nextDialogs": [
              "710381606"
            ]
          },
          "710381606": {
            "id": "710381606",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "And yet, who am I to judge? *sigh* How could a Violetgrass lodged in a cliff's cleft criticize a bird for its way of life?",
            "nextDialogs": [
              "710381607"
            ]
          },
          "710381607": {
            "id": "710381607",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "And yet, how can I just let it go like... *cough* You know what? Maybe stopping her is the wrong thing to do. I mean, she's an adult who can take care of herself already, isn't she?",
            "nextDialogs": [
              "710381610"
            ]
          },
          "710381610": {
            "id": "710381610",
            "speakerId": 1000,
            "speakerName": "Jinwu",
            "text": "I suppose... I hope you're right."
          }
        }
      }
    },
    {
      "subId": "7103813",

    {
      "subId": "7103804",
      "subQuestName": "Go to the beacon placement sites to look for Zhiqiong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710380401"
        ],
        "dialogs": {
          "710380401": {
            "id": "710380401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Can you still walk?",
            "nextDialogs": [
              "710380403"
            ]
          },
          "710380403": {
            "id": "710380403",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "Sorry... I'm sorry, Jinwu... and... *cough*",
            "nextDialogs": [
              "710380406"
            ]
          },
          "710380406": {
            "id": "710380406",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "Don't look at me... *cough* Don't look at me like that. Please, don't be disappointed in us... *cough*",
            "nextDialogs": [
              "710380407"
            ]
          },
          "710380407": {
            "id": "710380407",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "The golden city... The black watchtower...! *cough* The heavenly envoys have left...!",
            "nextDialogs": [
              "710380404"
            ]
          },
          "710380404": {
            "id": "710380404",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Cut it with the nonsense, you!"
          }
        }
      }
    },
    {
      "subId": "7103805",
      "subQuestName": "Go to the beacon placement sites to look for Zhiqiong",

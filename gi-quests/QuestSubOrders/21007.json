          },
          "210070703": {
            "id": "210070703",
            "speakerId": 1004,
            "speakerName": "Yuan Hong",
            "text": "The splendid red autumnal leaves, parted ways though there be no breeze...",
            "nextDialogs": [
              "210070704"
            ]
          },
          "210070704": {
            "id": "210070704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hello! Excuse me!",
            "nextDialogs": [
              "210070705"
            ]
          },
          "210070705": {
            "id": "210070705",
            "speakerId": 1004,
            "speakerName": "Yuan Hong",
            "text": "The glorious red autumnal leaves, parted ways on a passing breeze...",
            "nextDialogs": [
              "210070706"
            ]
          },
          "210070706": {
            "id": "210070706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why are they ignoring us?",
            "nextDialogs": [
              "210070707"
            ]
          },
          "210070707": {
            "id": "210070707",
            "speakerId": 1004,
            "speakerName": "Yuan Hong",
            "text": "Money... riches... It's all a farce. A farce, I say!",
            "nextDialogs": [
              "210070708"
            ]
          },
          "210070708": {
            "id": "210070708",
            "speakerId": 1004,
            "speakerName": "Yuan Hong",
            "text": "The further away from this village... the better...",
            "nextDialogs": [
              "210070709"
            ]
          },
          "210070709": {
            "id": "210070709",
            "speakerId": 1004,
            "speakerName": "Yuan Hong",
            "text": "If only we could start all over again... From the beginning..."
          }
        }
      }
    },

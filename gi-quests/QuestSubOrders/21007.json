  "subQuests": [
    {
      "subId": "2100701",
      "subQuestName": "Look around Mingyun Village",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210070101"
        ],
        "dialogs": {
          "210070101": {
            "id": "210070101",
            "speakerId": 1000,
            "speakerName": "Exhortations of a dying man",
            "text": "\"...The tree who stands alone has no forest to call his home... But the sturdy rock has a heart of gold, unite and you shall share in its blessings... This fortune hereby made known unto you, I say: honor the will of your father...\""
          }
        }
      }
    },
    {
      "subId": "2100702",
      "subQuestName": "Find the treasure clue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210070201"
        ],
        "dialogs": {
          "210070201": {
            "id": "210070201",
            "speakerId": 1001,
            "speakerName": "Yuan Qing",
            "text": "Oh no! What did I do to deserve this...",
            "nextDialogs": [
              "210070202"
            ]
          },
          "210070202": {
            "id": "210070202",
            "speakerId": 1001,
            "speakerName": "Yuan Qing",
            "text": "I finally managed to slip away while they weren't watching so that I could be first to get to the mine and find the treasure... But where did all these monsters come from!?",
            "nextDialogs": [
              "210070203"
            ]
          },
          "210070203": {
            "id": "210070203",
            "speakerId": 1001,
            "speakerName": "Yuan Qing",
            "text": "I'm done for..."
          }
        }
      }
    },
    {
      "subId": "2100703",
      "subQuestName": "Look for a will",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210070301"
        ],
        "dialogs": {
          "210070301": {
            "id": "210070301",
            "speakerId": 1002,
            "speakerName": "Yuan Cheng",
            "text": "Hmph, lousy older brothers! All they care about is taking the best finds for themselves.",
            "nextDialogs": [
              "210070302"
            ]
          },
          "210070302": {
            "id": "210070302",
            "speakerId": 1002,
            "speakerName": "Yuan Cheng",
            "text": "And dad's losing it in his old age... either completely oblivious, or just happy to turn a blind eye...",
            "nextDialogs": [
              "210070303"
            ]
          },
          "210070303": {
            "id": "210070303",
            "speakerId": 1002,
            "speakerName": "Yuan Cheng",
            "text": "I don't think they've realized yet that the treasure's in the mine.",
            "nextDialogs": [
              "210070304"
            ]
          },
          "210070304": {
            "id": "210070304",
            "speakerId": 1002,
            "speakerName": "Yuan Cheng",
            "text": "I've gotta get my hands on it... and then get as far away from here as possible!"
          }
        }
      }
    },
    {
      "subId": "2100704",
      "subQuestName": "Look for a will",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210070401"
        ],
        "dialogs": {
          "210070401": {
            "id": "210070401",
            "speakerId": 1003,
            "speakerName": "Yuan Liang",
            "text": "Hehehe... The treasure will be mine!",
            "nextDialogs": [
              "210070402"
            ]
          },
          "210070402": {
            "id": "210070402",
            "speakerId": 1003,
            "speakerName": "Yuan Liang",
            "text": "My brothers are such morons... They ran off after grasping a couple of lines thinking they'd figured it out. Hehehe...",
            "nextDialogs": [
              "210070403"
            ]
          },
          "210070403": {
            "id": "210070403",
            "speakerId": 1003,
            "speakerName": "Yuan Liang",
            "text": "Honor father's will? Bah! There was one line worth reading in that thing, and that was the part about the treasure being in the mine. Speaking of mine... Soon it will all be mine! Hehehe..."
          }
        }
      }
    },
    {
      "subId": "2100705",
      "subQuestName": "Look for a will",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210070501"
        ],
        "dialogs": {
          "210070501": {
            "id": "210070501",
            "speakerId": 1004,
            "speakerName": "Yuan Hong",
            "text": "They've left... They've all left...",
            "nextDialogs": [
              "210070502"
            ]
          },
          "210070502": {
            "id": "210070502",
            "speakerId": 1004,
            "speakerName": "Yuan Hong",
            "text": "Yuan Qing, Yuan Liang, Yuan Cheng... You foolish children. You'll have to think a bit more carefully and look harder than you are doing now..."
          }
        }
      }
    },
    {
      "subId": "2100706",
      "subQuestName": "Look for a will",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210070601"
        ],
        "dialogs": {
          "210070601": {
            "id": "210070601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, look! It's those guys from earlier.",
            "nextDialogs": [
              "210070602"
            ]
          },
          "210070602": {
            "id": "210070602",
            "speakerId": 1001,
            "speakerName": "Yuan Qing",
            "text": "The tree who stands alone has no forest to call his home... Haha, it's true, you can't achieve anything by yourself...",
            "nextDialogs": [
              "210070603"
            ]
          },
          "210070603": {
            "id": "210070603",
            "speakerId": 1002,
            "speakerName": "Yuan Cheng",
            "text": "The splendid red autumnal leaves, part ways though there be no breeze... If I could take my brothers and father at their word...",
            "nextDialogs": [
              "210070604"
            ]
          },
          "210070604": {
            "id": "210070604",
            "speakerId": 1003,
            "speakerName": "Yuan Liang",
            "text": "The glorious red autumnal leaves, part ways on a passing breeze... The treasure... Lost everything, all because of the treasure...",
            "nextDialogs": [
              "210070605"
            ]
          },
          "210070605": {
            "id": "210070605",
            "speakerId": 1004,
            "speakerName": "Yuan Hong",
            "text": "Trees should blend their roots and shade, for that is where the home is made... Children, we're supposed to be a family...",
            "nextDialogs": [
              "210070606"
            ]
          },
          "210070606": {
            "id": "210070606",
            "speakerId": 1004,
            "speakerName": "Yuan Hong",
            "text": "You seriously thought I hid treasure in the mine? ... *sigh*",
            "nextDialogs": [
              "210070607"
            ]
          },
          "210070607": {
            "id": "210070607",
            "speakerId": 1004,
            "speakerName": "Yuan Hong",
            "text": "There is a treasure, though... Do you still remember the tree we planted together as a family when you were children?",
            "nextDialogs": [
              "210070608"
            ]
          },
          "210070608": {
            "id": "210070608",
            "speakerId": 1004,
            "speakerName": "Yuan Hong",
            "text": "I come here every year and put a little something inside, hoping that when you're older we can dig it out together.",
            "nextDialogs": [
              "210070609"
            ]
          },
          "210070609": {
            "id": "210070609",
            "speakerId": 1004,
            "speakerName": "Yuan Hong",
            "text": "And then use it to buy some treats and a bottle of wine... celebrate together, as a family... talk about the old times...",
            "nextDialogs": [
              "210070610"
            ]
          },
          "210070610": {
            "id": "210070610",
            "speakerId": 1004,
            "speakerName": "Yuan Hong",
            "text": "Oh children, my dear children..."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7406501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740650101"
        ],
        "dialogs": {
          "740650101": {
            "id": "740650101",
            "speakerId": 21095,
            "speakerName": "Decembre",
            "text": "#Well, well! If it isn't {NICKNAME} and Paimon!",
            "nextDialogs": [
              "740650104"
            ]
          },
          "740650104": {
            "id": "740650104",
            "speakerId": 21095,
            "speakerName": "Decembre",
            "text": "Don't be so cold. I'll never forget what you did for me that other time.",
            "nextDialogs": [
              "740650105"
            ]
          },
          "740650105": {
            "id": "740650105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That other time... Ah! We still have so much to ask you!",
            "nextDialogs": [
              "740650106"
            ]
          },
          "740650106": {
            "id": "740650106",
            "speakerId": 21095,
            "speakerName": "Decembre",
            "text": "I—Is that so? Ugh, oh, what's this? My memory, it's acting up again! What happened then, I wonder? I can't remember a thing!",
            "nextDialogs": [
              "740650107"
            ]
          },
          "740650107": {
            "id": "740650107",
            "speakerId": 21095,
            "speakerName": "Decembre",
            "text": "The wise say it's better to look toward the future than look back into the past. So let's talk about our future collaboration, and let bygones be bygones, shall we?",
            "nextDialogs": [
              "740650108"
            ]
          },
          "740650108": {
            "id": "740650108",
            "speakerId": 21095,
            "speakerName": "Decembre",
            "text": "I have a few jobs on hand that pay quite well, but I don't have anyone to help out. If you're free, would you like to have a go?",
            "nextDialogs": [
              "740650109"
            ]
          },
          "740650109": {
            "id": "740650109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph! Don't you go thinking we're that easy to dupe...",
            "nextDialogs": [
              "740650110"
            ]
          },
          "740650110": {
            "id": "740650110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And just how good is the compensation?",
            "nextDialogs": [
              "740650111"
            ]
          },
          "740650111": {
            "id": "740650111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey!",
            "nextDialogs": [
              "740650112"
            ]
          },
          "740650112": {
            "id": "740650112",
            "speakerId": 21095,
            "speakerName": "Decembre",
            "text": "This is why I'm so fond of talking business with people like you. What do they call it again? Right, being quick to catch on!",
            "nextDialogs": [
              "740650113"
            ]
          },
          "740650113": {
            "id": "740650113",
            "speakerId": 21095,
            "speakerName": "Decembre",
            "text": "How about I state a number that's guaranteed to satisfy you?",
            "nextDialogs": [
              "740650114"
            ]
          },
          "740650114": {
            "id": "740650114",
            "speakerId": 21095,
            "speakerName": "Decembre",
            "text": "A hundred Coupons! What do you think?",
            "nextDialogs": [
              "740650115"
            ]
          },
          "740650115": {
            "id": "740650115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A hundred!?",
            "nextDialogs": [
              "740650116"
            ]
          },
          "740650116": {
            "id": "740650116",
            "speakerId": 21095,
            "speakerName": "Decembre",
            "text": "Mmm, I see you are moved by my generosity."
          }
        }
      }
    },
    {
      "subId": "7406502",
      "subQuestName": "Defeat the wandering Fontemer Aberrants in the Geode Mine Shaft",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

      }
    },
    {
      "subId": "7406503",
      "subQuestName": "Report to Maupoil",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740650301"
        ],
        "dialogs": {
          "740650301": {
            "id": "740650301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're only just arriving here now? We've already driven away all the Fontemer Aberrants.",
            "nextDialogs": [
              "740650302"
            ]
          },
          "740650302": {
            "id": "740650302",
            "speakerId": 21107,
            "speakerName": "Maupoil",
            "text": "So, it's finally happened to me.",
            "nextDialogs": [
              "740650303"
            ]
          },
          "740650303": {
            "id": "740650303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's finally happened?",
            "nextDialogs": [
              "740650304"
            ]
          },
          "740650304": {
            "id": "740650304",
            "speakerId": 21107,
            "speakerName": "Maupoil",
            "text": "Arriving at the scene and finding out that all the work has been done by someone else, of course! I mean, there's nothing for me to do here.",
            "nextDialogs": [
              "740650305"
            ]
          },
          "740650305": {
            "id": "740650305",
            "speakerId": 21107,
            "speakerName": "Maupoil",
            "text": "This is for you. Thank you so much! I'll certainly manage to get a good night's sleep tonight!"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2200001",
      "subQuestName": "Talk to Little Lulu, Little Fei, and Little Meng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220000101"
        ],
        "dialogs": {
          "220000101": {
            "id": "220000101",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "So. How shall we play it this time?",
            "nextDialogs": [
              "220000102"
            ]
          },
          "220000102": {
            "id": "220000102",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Hmph. If no one's going to be the pirate, we can't play it at all.",
            "nextDialogs": [
              "220000103"
            ]
          },
          "220000103": {
            "id": "220000103",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "But no one wants to be a pirate. So what're we gonna do...",
            "nextDialogs": [
              "220000104"
            ]
          },
          "220000104": {
            "id": "220000104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "220000105"
            ]
          },
          "220000105": {
            "id": "220000105",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "We were gonna play a game, but there's no one to be the pirate.",
            "nextDialogs": [
              "220000106"
            ]
          },
          "220000106": {
            "id": "220000106",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "If there's no pirate, there's no one to do the robbing... so we can't start the game.",
            "nextDialogs": [
              "220000107"
            ]
          },
          "220000107": {
            "id": "220000107",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Ooh, ooh, I know, you can do it! Do you want to be a pirate?",
            "nextDialogs": [
              "220000109",
              "220000111"
            ]
          },
          "220000109": {
            "id": "220000109",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Yay! Right, let's get ready...",
            "nextDialogs": [
              "220000115"
            ]
          },
          "220000115": {
            "id": "220000115",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "When you're ready, come and join in."
          },
          "220000111": {
            "id": "220000111",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "It's not that hard! A pirate is just someone who is very naughty and takes things that don't belong to them.",
            "nextDialogs": [
              "220000112"
            ]
          },
          "220000112": {
            "id": "220000112",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "I've never met a real pirate though. That's just what Beidou told me.",
            "nextDialogs": [
              "220000113"
            ]
          },
          "220000113": {
            "id": "220000113",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "But I think it must be quite easy to play a pirate.",
            "nextDialogs": [
              "220000114"
            ]
          },
          "220000114": {
            "id": "220000114",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Hehehe, I'm sure you can do it! Let's go!"
          }
        }
      }
    },
    {
      "subId": "2200002",
      "subQuestName": "Talk to \"Captain\" Little Meng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220000201"
        ],
        "dialogs": {
          "220000201": {
            "id": "220000201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ready!",
            "nextDialogs": [
              "220000202"
            ]
          },
          "220000202": {
            "id": "220000202",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Then let the game begin!",
            "nextDialogs": [
              "220000203"
            ]
          },
          "220000203": {
            "id": "220000203",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "...How do we start?",
            "nextDialogs": [
              "220000204"
            ]
          },
          "220000204": {
            "id": "220000204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh... Shiver me timbers? I'm robbing you!",
            "nextDialogs": [
              "220000205"
            ]
          },
          "220000205": {
            "id": "220000205",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Eek! Pirates!",
            "nextDialogs": [
              "220000206"
            ]
          },
          "220000206": {
            "id": "220000206",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Don't worry, Lulu, I'll save you!",
            "nextDialogs": [
              "220000207"
            ]
          },
          "220000207": {
            "id": "220000207",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "You must be a pirate. Tell me, why are you robbing us?",
            "nextDialogs": [
              "220000210"
            ]
          },
          "220000210": {
            "id": "220000210",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Not all of them. There are good-guy pirates and bad-guy pirates.",
            "nextDialogs": [
              "220000211"
            ]
          },
          "220000211": {
            "id": "220000211",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Beidou says she's a pirate, but she's one of the good guys. She gives us snacks! Everyone loves Beidou.",
            "nextDialogs": [
              "220000212"
            ]
          },
          "220000212": {
            "id": "220000212",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Why you gotta be a bad pirate? Can't you be a good pirate instead?",
            "nextDialogs": [
              "220000213"
            ]
          },
          "220000213": {
            "id": "220000213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're the one who said pirates are naughty people who take things that don't belong to them!"
          }
        }
      }
    },
    {
      "subId": "2200003",
      "subQuestName": "Use Anemo or Hydro to clean the deck",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220000301"
        ],
        "dialogs": {
          "220000301": {
            "id": "220000301",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Finished cleaning yet?",
            "nextDialogs": [
              "220000302"
            ]
          },
          "220000302": {
            "id": "220000302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Finished.",
            "nextDialogs": [
              "220000303"
            ]
          },
          "220000303": {
            "id": "220000303",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Yay! Thanks, these are for you. It was fun playing with you!",
            "nextDialogs": [
              "220000304"
            ]
          },
          "220000304": {
            "id": "220000304",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "And don't forget — being a good person doesn't stop here. Make it a habit for life.",
            "nextDialogs": [
              "220000305"
            ]
          },
          "220000305": {
            "id": "220000305",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Hey, when do I get to be the captain?",
            "nextDialogs": [
              "220000306"
            ]
          },
          "220000306": {
            "id": "220000306",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Next time.",
            "nextDialogs": [
              "220000307"
            ]
          },
          "220000307": {
            "id": "220000307",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "That's what you said last time..."
          }
        }
      }
    },
    {
      "subId": "2200005",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220000501"
        ],
        "dialogs": {
          "220000501": {
            "id": "220000501",
            "speakerId": 12621,
            "speakerName": "Little Meng",
            "text": "Finished cleaning?",
            "nextDialogs": [
              "220000502"
            ]
          },
          "220000502": {
            "id": "220000502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet.",
            "nextDialogs": [
              "220000503"
            ]
          },
          "220000503": {
            "id": "220000503",
            "speakerId": 12621,
            "speakerName": "Little Meng",
            "text": "Hurry up. This is your chance to change your ways and show you can be a good person.",
            "nextDialogs": [
              "220000504"
            ]
          },
          "220000504": {
            "id": "220000504",
            "speakerId": 12620,
            "speakerName": "Little Fei",
            "text": "Hey, are we seriously saying that just cleaning up the place once turns you into one of the good guys?",
            "nextDialogs": [
              "220000505"
            ]
          },
          "220000505": {
            "id": "220000505",
            "speakerId": 12621,
            "speakerName": "Little Meng",
            "text": "All it takes to be a good person is the willingness to do the right thing.",
            "nextDialogs": [
              "220000506"
            ]
          },
          "220000506": {
            "id": "220000506",
            "speakerId": 12620,
            "speakerName": "Little Fei",
            "text": "That sounds too simple...",
            "nextDialogs": [
              "220000507"
            ]
          },
          "220000507": {
            "id": "220000507",
            "speakerId": 12621,
            "speakerName": "Little Meng",
            "text": "Do good, you're a good person. Do bad, you're a bad person. Yes, it's very simple.",
            "nextDialogs": [
              "220000508"
            ]
          },
          "220000508": {
            "id": "220000508",
            "speakerId": 12620,
            "speakerName": "Little Fei",
            "text": "Huh. You may say so, but then how come there's still so many bad people in the world?",
            "nextDialogs": [
              "220000509"
            ]
          },
          "220000509": {
            "id": "220000509",
            "speakerId": 12621,
            "speakerName": "Little Meng",
            "text": "Because everything in the world is easier said than done.",
            "nextDialogs": [
              "220000510"
            ]
          },
          "220000510": {
            "id": "220000510",
            "speakerId": 12621,
            "speakerName": "Little Meng",
            "text": "But doing bad things is still easier than doing good things.",
            "nextDialogs": [
              "220000511"
            ]
          },
          "220000511": {
            "id": "220000511",
            "speakerId": 12620,
            "speakerName": "Little Fei",
            "text": "Did Beidou teach you that?",
            "nextDialogs": [
              "220000512"
            ]
          },
          "220000512": {
            "id": "220000512",
            "speakerId": 12621,
            "speakerName": "Little Meng",
            "text": "Nah, that one I read in a book."
          }
        }
      }
    },

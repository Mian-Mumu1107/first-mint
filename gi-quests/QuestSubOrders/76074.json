  "subQuests": [
    {
      "subId": "7607401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760740101"
        ],
        "dialogs": {
          "760740101": {
            "id": "760740101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That's such a weird instrument... No matter how Paimon plucks it, there's not a single sound! Is it broken?",
            "nextDialogs": [
              "760740103",
              "760740105"
            ]
          },
          "760740103": {
            "id": "760740103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yeah, forget the instrument for now. Just follow the Seelie up, and we'll probably find the treasure!"
          },
          "760740105": {
            "id": "760740105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "R—Really? But Paimon only heard the wind... Wait, is it one of those situations where only the person strumming it gets to hear the music?",
            "nextDialogs": [
              "760740106"
            ]
          },
          "760740106": {
            "id": "760740106",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Alright, let me give it a try too...",
            "nextDialogs": [
              "760740107"
            ]
          },
          "760740107": {
            "id": "760740107",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Paimon gives the strings a firm strum...\\n",
            "nextDialogs": [
              "760740108"
            ]
          },
          "760740108": {
            "id": "760740108",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Once again, that desolate, mournful tune drifts upward, light as a breeze at dawn, carrying with it a soft song — \\n",
            "nextDialogs": [
              "760740109"
            ]
          },
          "760740109": {
            "id": "760740109",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You understand every word of the song — every phrase, every note — even though you've never heard the language before."
          }
        }
      }
    },

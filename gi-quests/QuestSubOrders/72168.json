  },
  "subQuests": [
    {
      "subId": "7216801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721680101"
        ],
        "dialogs": {
          "721680101": {
            "id": "721680101",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Uh, Parvaneh, are there really branches like that around here?",
            "nextDialogs": [
              "721680102"
            ]
          },
          "721680102": {
            "id": "721680102",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "I think so. That's what it says here in this book...",
            "nextDialogs": [
              "721680103"
            ]
          },
          "721680103": {
            "id": "721680103",
            "speakerId": 1002,
            "speakerName": "Julie",
            "text": "Urgh... I'm starving...",
            "nextDialogs": [
              "721680104"
            ]
          },
          "721680104": {
            "id": "721680104",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Hey, Parvaneh, why don't you look up some other method in your dictionary?",
            "nextDialogs": [
              "721680105"
            ]
          },
          "721680105": {
            "id": "721680105",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "What do you think I am, omnipotent!? Besides, this isn't a dictionary. It's just a travelogue from the Akademiya!",
            "nextDialogs": [
              "721680106"
            ]
          },
          "721680106": {
            "id": "721680106",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Fine. Just think of a way, please. Otherwise, we'll have to eat grilled fish again.",
            "nextDialogs": [
              "721680107"
            ]
          },
          "721680107": {
            "id": "721680107",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "Gr—Grilled fish... Ugh, let's just go back to the town and get an adventurer to help, or put up a commission, shall we?",
            "nextDialogs": [
              "721680108"
            ]
          },
          "721680108": {
            "id": "721680108",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "Isn't that what you used to do back in Liyue when you had a problem?",
            "nextDialogs": [
              "721680109"
            ]
          },
          "721680109": {
            "id": "721680109",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "That was Liyue... We're in Inazuma now. We're strangers to this land...",
            "nextDialogs": [
              "721680110"
            ]
          },
          "721680110": {
            "id": "721680110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you all doing?",
            "nextDialogs": [
              "721680111"
            ]
          },
          "721680111": {
            "id": "721680111",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Are you... an adventurer? A traveler? Or both...",
            "nextDialogs": [
              "721680112"
            ]
          },
          "721680112": {
            "id": "721680112",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Well, forget it. Who cares? I guess this is fate.",
            "nextDialogs": [
              "721680113"
            ]
          },
          "721680113": {
            "id": "721680113",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "We're the Gourmet Supremos. We're currently traveling around the world in a quest to improve our culinary skills.",
            "nextDialogs": [
              "721680114"
            ]
          },
          "721680114": {
            "id": "721680114",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "Ugh, I'm begging you, can you please not say that name out loud...",
            "nextDialogs": [
              "721680115"
            ]
          },
          "721680115": {
            "id": "721680115",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Hahaha, come on, it's fine! Anyway, Traveler, are you also going in to collect Sakura Blooms?",
            "nextDialogs": [
              "721680116"
            ]
          },
          "721680116": {
            "id": "721680116",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "If so, I'm afraid you'll be disappointed. This place has been blocked by some kind of weird contraption. There's no way in.",
            "nextDialogs": [
              "721680118",
              "721680133"
            ]
          },
          "721680118": {
            "id": "721680118",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Oh, is that so? Alright then. But if it strikes your fancy, it would be nice if you could help us give this barrier a bit of thought.",
            "nextDialogs": [
              "721680119"
            ]
          },
          "721680119": {
            "id": "721680119",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Parvaneh found a method in her book.",
            "nextDialogs": [
              "721680120"
            ]
          },
          "721680120": {
            "id": "721680120",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "It says that you need to touch a Thunder Sakura Bough before you can get through this barrier.",
            "nextDialogs": [
              "721680121"
            ]
          },
          "721680121": {
            "id": "721680121",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "But as for those Thunder Sakura Boughs... To be honest, we have no idea what they really look like.",
            "nextDialogs": [
              "721680122"
            ]
          },
          "721680122": {
            "id": "721680122",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Well, that's the run-down of our situation. We're still trying to find a way in.",
            "nextDialogs": [
              "721680123"
            ]
          },
          "721680123": {
            "id": "721680123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why do you want to get in?",
            "nextDialogs": [
              "721680124"
            ]
          },
          "721680124": {
            "id": "721680124",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "We'd like to get some of the Sakura Blooms inside ourselves, of course.",
            "nextDialogs": [
              "721680125"
            ]
          },
          "721680125": {
            "id": "721680125",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "I've heard that the Sakura Blooms here have the best mouthfeel, and are perfect for cooking.",
            "nextDialogs": [
              "721680126"
            ]
          },
          "721680126": {
            "id": "721680126",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Well, we'll keep trying our luck around here. Let us know if you find some leads, Traveler.",
            "nextDialogs": [
              "721680127"
            ]
          },
          "721680127": {
            "id": "721680127",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "...Mr. Xudong. Is that really how you ask someone for a favor?",
            "nextDialogs": [
              "721680128"
            ]
          },
          "721680128": {
            "id": "721680128",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Eh? *cough* Oh right. Traveler, if you could help us bring some Sakura Blooms out from inside...",
            "nextDialogs": [
              "721680129"
            ]
          },
          "721680129": {
            "id": "721680129",
            "speakerId": 1002,
            "speakerName": "Julie",
            "text": "If you could do that, never mind the payment, Xudong here will also make you some really awesome food!",
            "nextDialogs": [
              "721680130"
            ]
          },
          "721680130": {
            "id": "721680130",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "You're really good at making these deals, huh, Julie...",
            "nextDialogs": [
              "721680131"
            ]
          },
          "721680131": {
            "id": "721680131",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Well, that's how it is, Traveler. Please help us, if you don't mind."
          },
          "721680133": {
            "id": "721680133",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Oh? You're really going in?",
            "nextDialogs": [
              "721680134"
            ]
          },
          "721680134": {
            "id": "721680134",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Well, that method was recorded inside Parvaneh's dictionary—",
            "nextDialogs": [
              "721680135"
            ]
          },
          "721680135": {
            "id": "721680135",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "I told you! It's not a dictionary. It's a travelogue from the Akademiya!",
            "nextDialogs": [
              "721680136"
            ]
          },
          "721680136": {
            "id": "721680136",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Well, whatever the case, she found a way.",
            "nextDialogs": [
              "721680137"
            ]
          },
          "721680137": {
            "id": "721680137",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "It says you need to touch a Thunder Sakura Bough before you can get through this barrier.",
            "nextDialogs": [
              "721680138"
            ]
          },
          "721680138": {
            "id": "721680138",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "But as for those Thunder Sakura Boughs... To be honest, we have no idea what they really look like.",
            "nextDialogs": [
              "721680139"
            ]
          },
          "721680139": {
            "id": "721680139",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "There aren't any photos in this book either.",
            "nextDialogs": [
              "721680140"
            ]
          },
          "721680140": {
            "id": "721680140",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "I'm officially sick of eating grilled fish. If I can get my hands on some of those Sakura Blooms, I'm sure I can whip something nice up...",
            "nextDialogs": [
              "721680141"
            ]
          },
          "721680141": {
            "id": "721680141",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "I've heard that the ones here have the best mouthfeel, and make for perfect cooking ingredients. But why, oh why does there have to be a barrier here...",
            "nextDialogs": [
              "721680142"
            ]
          },
          "721680142": {
            "id": "721680142",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Well, we'll keep trying our luck around here. Let us know if you find some leads, Traveler.",
            "nextDialogs": [
              "721680143"
            ]
          },
          "721680143": {
            "id": "721680143",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "...Mr. Xudong. Is that really how you ask someone for a favor?",
            "nextDialogs": [
              "721680144"
            ]
          },
          "721680144": {
            "id": "721680144",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Eh? *cough* Oh right. Traveler, if you could help us bring some Sakura Blooms out from inside...",
            "nextDialogs": [
              "721680145"
            ]
          },
          "721680145": {
            "id": "721680145",
            "speakerId": 1002,
            "speakerName": "Julie",
            "text": "If you could do that, never mind the payment, Xudong here will also make you some really awesome food!",
            "nextDialogs": [
              "721680146"
            ]
          },
          "721680146": {
            "id": "721680146",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "You're really good at making these deals, huh, Julie...",
            "nextDialogs": [
              "721680147"
            ]
          },
          "721680147": {
            "id": "721680147",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Well, that's how it is, Traveler. Please help us, if you don't mind."
          }
        }
      }
    },
    {
      "subId": "7216802",
      "subQuestName": "Collect the Special Sakura Bloom",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721680201"
        ],
        "dialogs": {
          "721680201": {
            "id": "721680201",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Parvaneh, is there really no other way to do this?",
            "nextDialogs": [
              "721680202"
            ]
          },
          "721680202": {
            "id": "721680202",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "My book only mentions this one way.",
            "nextDialogs": [
              "721680203"
            ]
          },
          "721680203": {
            "id": "721680203",
            "speakerId": 1002,
            "speakerName": "Julie",
            "text": "Heh, if only it was just a bunch of monsters barring our path...",
            "nextDialogs": [
              "721680204"
            ]
          },
          "721680204": {
            "id": "721680204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are these the Sakura Blooms you've been looking for?",
            "nextDialogs": [
              "721680205"
            ]
          },
          "721680205": {
            "id": "721680205",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Ah! Yes, that they are! And this color...",
            "nextDialogs": [
              "721680206"
            ]
          },
          "721680206": {
            "id": "721680206",
            "speakerId": 1002,
            "speakerName": "Julie",
            "text": "Woohoo! Guess we can finally eat now!",
            "nextDialogs": [
              "721680207"
            ]
          },
          "721680207": {
            "id": "721680207",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "Wait, you've already passed through that barrier? Did you use the method I told you about?",
            "nextDialogs": [
              "721680208"
            ]
          },
          "721680208": {
            "id": "721680208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That I did.",
            "nextDialogs": [
              "721680209"
            ]
          },
          "721680209": {
            "id": "721680209",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "Could you tell me where you found that Thunder Sakura Bough?",
            "nextDialogs": [
              "721680210"
            ]
          },
          "721680210": {
            "id": "721680210",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "When you touched that Bough, how did the Electrogranum come to rest upon you?",
            "nextDialogs": [
              "721680211"
            ]
          },
          "721680211": {
            "id": "721680211",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "...Wait, I'm sorry, let me pull out my notebook. So, did you feel anything after the Electrogranum attached itself to you? And...",
            "nextDialogs": [
              "721680212"
            ]
          },
          "721680212": {
            "id": "721680212",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Parvaneh, please, give this Traveler a moment. They just helped us out... I think your research can wait a bit, right?",
            "nextDialogs": [
              "721680213"
            ]
          },
          "721680213": {
            "id": "721680213",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Thank you very much, Traveler. As we agreed, you will be paid.",
            "nextDialogs": [
              "721680214"
            ]
          },
          "721680214": {
            "id": "721680214",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "But before that, just wait here with us for a while. I believe I'll be able to make a dish with the Sakura Blooms you brought.",
            "nextDialogs": [
              "721680215"
            ]
          },
          "721680215": {
            "id": "721680215",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "I've heard of an Inazuman specialty known as Sakura Tempura. I suppose now's the time to try it out.",
            "nextDialogs": [
              "721680216"
            ]
          },
          "721680216": {
            "id": "721680216",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Give me a while to prepare. It shouldn't take too long, so come find me in a moment."
          }
        }
      }
    },
    {
      "subId": "7216803",
      "subQuestName": "Give the Special Sakura Bloom to Xudong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7216804",
      "subQuestName": "Talk to Xudong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721680301"
        ],
        "dialogs": {
          "721680301": {
            "id": "721680301",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "It goes like this... and this...",
            "nextDialogs": [
              "721680302"
            ]
          },
          "721680302": {
            "id": "721680302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you finished it yet?",
            "nextDialogs": [
              "721680303"
            ]
          },
          "721680303": {
            "id": "721680303",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Just hold on a moment... wrap it up in flour, put it in to dry...",
            "nextDialogs": [
              "721680304"
            ]
          },
          "721680304": {
            "id": "721680304",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "And there we go! Sakura Tempura — try it while it's hot!",
            "nextDialogs": [
              "721680305"
            ]
          },
          "721680305": {
            "id": "721680305",
            "speakerId": 1002,
            "speakerName": "Julie",
            "text": "I—It's delicious! ... If a bit too hot...",
            "nextDialogs": [
              "721680306"
            ]
          },
          "721680306": {
            "id": "721680306",
            "speakerId": 1001,
            "speakerName": "Parvaneh",
            "text": "Xudong, I believe that this \"tempura\" also needs to be served with a special dipping sauce...",
            "nextDialogs": [
              "721680307"
            ]
          },
          "721680307": {
            "id": "721680307",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "A dipping sauce? Well, I must say that I haven't prepared one of those yet. I'll look into it next time should we get the chance.",
            "nextDialogs": [
              "721680308"
            ]
          },
          "721680308": {
            "id": "721680308",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "This serving of Sakura Tempura is yours, Traveler. Please take it as thanks for your help.",
            "nextDialogs": [
              "721680309"
            ]
          },
          "721680309": {
            "id": "721680309",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Ah yes, I'll give you a copy of the recipe too. Just give me a moment to write it down...",
            "nextDialogs": [
              "721680310"
            ]
          },
          "721680310": {
            "id": "721680310",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Try it yourself if you get the chance! Cooking is really fun, you know?",
            "nextDialogs": [
              "721680312"
            ]
          },
          "721680312": {
            "id": "721680312",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Don't mention it!",
            "nextDialogs": [
              "721680314"
            ]
          },
          "721680314": {
            "id": "721680314",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "We'll be in Inazuma for a while, so I suspect that we might head to <color=#00E1FFFF>Kannazuka</color> later.",
            "nextDialogs": [
              "721680316"
            ]
          },
          "721680316": {
            "id": "721680316",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Julie says that she also wants to see that Sacred Sakura Tree at the Grand Narukami Shrine.",
            "nextDialogs": [
              "721680317"
            ]
          },
          "721680317": {
            "id": "721680317",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "They say that all the Sakura Blooms on this island fell from that huge tree.",
            "nextDialogs": [
              "721680318"
            ]
          },
          "721680318": {
            "id": "721680318",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "I wonder, how large must that tree have been to have so many leaves fall from it...",
            "nextDialogs": [
              "721680319"
            ]
          },
          "721680319": {
            "id": "721680319",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "You should pay it a visit if it takes your fancy, too.",
            "nextDialogs": [
              "721680320"
            ]
          },
          "721680320": {
            "id": "721680320",
            "speakerId": 1000,
            "speakerName": "Xudong",
            "text": "Thank you for your help once again, Traveler. Well, I'm going to have a bite too. I'm starving..."
          }
        }
      }
    },
    {

    {
      "subId": "38906",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3890601"
        ],
        "dialogs": {
          "3890601": {
            "id": "3890601",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Oh, we can't advance any further. The ruins seem to be guarded by ancient <color=#00E1FFFF>seals</color>.",
            "nextDialogs": [
              "3890602"
            ]
          },
          "3890602": {
            "id": "3890602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is this the work of Dvalin?",
            "nextDialogs": [
              "3890603"
            ]
          },
          "3890603": {
            "id": "3890603",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "No. These ruins were once part of an ancient city. Dvalin just happens to be nesting in these ruins for now.",
            "nextDialogs": [
              "3890604"
            ]
          },
          "3890604": {
            "id": "3890604",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "These ruins even predate the existence of The Four Winds.",
            "nextDialogs": [
              "3890605"
            ]
          },
          "3890605": {
            "id": "3890605",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Mondstadt is a city without a ruler. However, before it was...",
            "nextDialogs": [
              "3890606"
            ]
          },
          "3890606": {
            "id": "3890606",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "It was ruled over by a tyrant.",
            "nextDialogs": [
              "3890607"
            ]
          },
          "3890607": {
            "id": "3890607",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Anyway... I'll sing you that story when we have a chance in the future.",
            "nextDialogs": [
              "3890608"
            ]
          },
          "3890608": {
            "id": "3890608",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "The markings on this seal... If my archaeological knowledge is not mistaken, this appears to be a <color=#00E1FFFF>light actuator</color>.",
            "nextDialogs": [
              "3890609"
            ]
          },
          "3890609": {
            "id": "3890609",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "If we retrieve and <color=#00E1FFFF>reintegrate</color> all the <color=#00E1FFFF>parts</color>, we should be able to <color=#00E1FFFF>get it working</color>.",
            "nextDialogs": [
              "3890610"
            ]
          },
          "3890610": {
            "id": "3890610",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "We should be close to completing the ceremony for this actuator.",
            "nextDialogs": [
              "3890611"
            ]
          },
          "3890611": {
            "id": "3890611",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "Let's put the <color=#00E1FFFF>last part</color> back and see."
          }
        }
      }
    }

        "dialogs": {
          "745300401": {
            "id": "745300401",
            "speakerId": 1000,
            "speakerName": "Kachina",
            "text": "Ah, you're back!",
            "nextDialogs": [
              "745300404"
            ]
          },
          "745300404": {
            "id": "745300404",
            "speakerId": 1000,
            "speakerName": "Kachina",
            "text": "Hehe. I found some awesome ore during this excavation!",
            "nextDialogs": [
              "745300405"
            ]
          },
          "745300405": {
            "id": "745300405",
            "speakerId": 1000,
            "speakerName": "Kachina",
            "text": "If polished properly, it could turn into a big, shiny gemstone!",
            "nextDialogs": [
              "745300406"
            ]
          },
          "745300406": {
            "id": "745300406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's great!",
            "nextDialogs": [
              "745300407"
            ]
          },
          "745300407": {
            "id": "745300407",
            "speakerId": 1000,
            "speakerName": "Kachina",
            "text": "Right? To be honest, the dig didn't get off to a good start, and I almost went home empty-handed.",
            "nextDialogs": [
              "745300408"
            ]
          },
          "745300408": {
            "id": "745300408",
            "speakerId": 1000,
            "speakerName": "Kachina",
            "text": "But I thought to myself that I should hang on a little longer. So I did, and then I held out a little longer, and a little longer...",
            "nextDialogs": [
              "745300409"
            ]
          },
          "745300409": {
            "id": "745300409",
            "speakerId": 1000,
            "speakerName": "Kachina",
            "text": "I don't know how many times I repeated that... but I got it in the end!",
            "nextDialogs": [
              "745300410"
            ]
          },
          "745300410": {
            "id": "745300410",
            "speakerId": 1000,
            "speakerName": "Kachina",
            "text": "I only realized that the sun was setting when I got outside... I wound up digging all day."
          }
        }
      }
    }

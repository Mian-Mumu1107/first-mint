  "subQuests": [
    {
      "subId": "2010401",
      "subQuestName": "Talk to Moco and Hillie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "201040101"
        ],
        "dialogs": {
          "201040101": {
            "id": "201040101",
            "speakerId": 1596,
            "speakerName": "Moco",
            "text": "What're we gonna do!?",
            "nextDialogs": [
              "201040102"
            ]
          },
          "201040102": {
            "id": "201040102",
            "speakerId": 1595,
            "speakerName": "Hillie",
            "text": "Adelinde is totally gonna freak out...",
            "nextDialogs": [
              "201040103"
            ]
          },
          "201040103": {
            "id": "201040103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's up?",
            "nextDialogs": [
              "201040104"
            ]
          },
          "201040104": {
            "id": "201040104",
            "speakerId": 1596,
            "speakerName": "Moco",
            "text": "So, Adelinde asked us to tidy up the area around the Winery.",
            "nextDialogs": [
              "201040105"
            ]
          },
          "201040105": {
            "id": "201040105",
            "speakerId": 1595,
            "speakerName": "Hillie",
            "text": "Most places were fine, but there are all these haystacks lying around.",
            "nextDialogs": [
              "201040106"
            ]
          },
          "201040106": {
            "id": "201040106",
            "speakerId": 1596,
            "speakerName": "Moco",
            "text": "Connor said he's storing them here because he needs them for something.",
            "nextDialogs": [
              "201040107"
            ]
          },
          "201040107": {
            "id": "201040107",
            "speakerId": 1595,
            "speakerName": "Hillie",
            "text": "They're bound pretty tight, so at least they didn't get blown away in the wind. But still, a load of leaves got blown in among the hay.",
            "nextDialogs": [
              "201040108"
            ]
          },
          "201040108": {
            "id": "201040108",
            "speakerId": 1596,
            "speakerName": "Moco",
            "text": "We worked really hard at it, but we still didn't manage to get all the leaves out.",
            "nextDialogs": [
              "201040109"
            ]
          },
          "201040109": {
            "id": "201040109",
            "speakerId": 1595,
            "speakerName": "Hillie",
            "text": "If we keep on at this pace, the head housemaid Adelinde is gonna freak out... What're we gonna do?",
            "nextDialogs": [
              "201040111",
              "201040113"
            ]
          },
          "201040111": {
            "id": "201040111",
            "speakerId": 1596,
            "speakerName": "Moco",
            "text": "Seriously? You're awesome! Thanks."
          },
          "201040113": {
            "id": "201040113",
            "speakerId": 1595,
            "speakerName": "Hillie",
            "text": "When they're mixed in with the hay they sure are. We have to pick them out one by one, which takes forever...",
            "nextDialogs": [
              "201040114"
            ]
          },
          "201040114": {
            "id": "201040114",
            "speakerId": 1595,
            "speakerName": "Hillie",
            "text": "If you've got a better idea, I'm all ears!"
          }
        }
      }
    },
    {
      "subId": "2010402",
      "subQuestName": "Sweep up the pile of leaves",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "201040201"
        ],
        "dialogs": {
          "201040201": {
            "id": "201040201",
            "speakerId": 1596,
            "speakerName": "Moco",
            "text": "How did it go?",
            "nextDialogs": [
              "201040202"
            ]
          },
          "201040202": {
            "id": "201040202",
            "speakerId": 1595,
            "speakerName": "Hillie",
            "text": "Did you get them all?",
            "nextDialogs": [
              "201040203"
            ]
          },
          "201040203": {
            "id": "201040203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Every last one.",
            "nextDialogs": [
              "201040204"
            ]
          },
          "201040204": {
            "id": "201040204",
            "speakerId": 1596,
            "speakerName": "Moco",
            "text": "Oh my gosh, you're awesome!",
            "nextDialogs": [
              "201040205"
            ]
          },
          "201040205": {
            "id": "201040205",
            "speakerId": 1595,
            "speakerName": "Hillie",
            "text": "Traveler, you're the best person ever!",
            "nextDialogs": [
              "201040206"
            ]
          },
          "201040206": {
            "id": "201040206",
            "speakerId": 1596,
            "speakerName": "Moco",
            "text": "Thanks! Now Adelinde won't be on our backs.",
            "nextDialogs": [
              "201040207"
            ]
          },
          "201040207": {
            "id": "201040207",
            "speakerId": 1595,
            "speakerName": "Hillie",
            "text": "Please take these as our thank-you gift.",
            "nextDialogs": [
              "201040208"
            ]
          },
          "201040208": {
            "id": "201040208",
            "speakerId": 1596,
            "speakerName": "Moco",
            "text": "Right, we've got other places to clean now. Thanks again! See you."
          }
        }
      }
    },
    {
      "subId": "2010403",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "201040301"
        ],
        "dialogs": {
          "201040301": {
            "id": "201040301",
            "speakerId": 1596,
            "speakerName": "Moco",
            "text": "What did you go and do that for!? You've burned down the haystack!",
            "nextDialogs": [
              "201040302"
            ]
          },
          "201040302": {
            "id": "201040302",
            "speakerId": 1595,
            "speakerName": "Hillie",
            "text": "Gee thanks... now Adelinde's gonna freak out for sure — and on top of that, she's definitely gonna fire us too!",
            "nextDialogs": [
              "201040303"
            ]
          },
          "201040303": {
            "id": "201040303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It was an accident...",
            "nextDialogs": [
              "201040304"
            ]
          },
          "201040304": {
            "id": "201040304",
            "speakerId": 1596,
            "speakerName": "Moco",
            "text": "Ugh, we should've just kept on picking them out one by one.",
            "nextDialogs": [
              "201040305"
            ]
          },
          "201040305": {
            "id": "201040305",
            "speakerId": 1595,
            "speakerName": "Hillie",
            "text": "Darn it... There's no way back from this...",
            "nextDialogs": [
              "201040306"
            ]
          },
          "201040306": {
            "id": "201040306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I, ah...",
            "nextDialogs": [
              "201040307"
            ]
          },
          "201040307": {
            "id": "201040307",
            "speakerId": 1596,
            "speakerName": "Moco",
            "text": "Traveler, you'd better get outta here. This was our responsibility.",
            "nextDialogs": [
              "201040308"
            ]
          },
          "201040308": {
            "id": "201040308",
            "speakerId": 1595,
            "speakerName": "Hillie",
            "text": "It's our fault for getting someone to help who doesn't know a thing about cleaning.",
            "nextDialogs": [
              "201040309"
            ]
          },
          "201040309": {
            "id": "201040309",
            "speakerId": 1596,
            "speakerName": "Moco",
            "text": "What is Adelinde gonna do when she finds out...",
            "nextDialogs": [
              "201040310"
            ]
          },
          "201040310": {
            "id": "201040310",
            "speakerId": 1595,
            "speakerName": "Hillie",
            "text": "She's gonna be so mad..."
          }
        }
      }
    },

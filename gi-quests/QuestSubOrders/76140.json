      "dialogue": {
        "startDialogs": [
          "761390301"
        ],
        "dialogs": {
          "761390301": {
            "id": "761390301",
            "speakerId": 1000,
            "speakerName": "Dhabit",
            "text": "You again? I'm not selling investment coupons anymore. Go on, off with you.",
            "nextDialogs": [
              "761390302"
            ]
          },
          "761390302": {
            "id": "761390302",
            "speakerId": 1000,
            "speakerName": "Dhabit",
            "text": "Hah... should've known better than to believe you'd have any friends to bring in...",
            "nextDialogs": [
              "761390305"
            ]
          },
          "761390305": {
            "id": "761390305",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah! Wouldn't selling books honestly be better?",
            "nextDialogs": [
              "761390306"
            ]
          },
          "761390306": {
            "id": "761390306",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Oh! Hey, {NICKNAME}, look over there! That book looks interesting. Let's go check it out.",
            "nextDialogs": [
              "761390307"
            ]
          },
          "761390307": {
            "id": "761390307",
            "speakerId": 1000,
            "speakerName": "Dhabit",
            "text": "Alright, alright... guess it's just my bad luck...",
            "nextDialogs": [
              "761390308"
            ]
          },
          "761390308": {
            "id": "761390308",
            "speakerId": 1000,
            "speakerName": "Dhabit",
            "text": "L–Lady Nefer! What an unexpected honor... Would you perhaps like to buy an investment — uh, I mean, a book?",
            "nextDialogs": [
              "761390309"
            ]
          },
          "761390309": {
            "id": "761390309",
            "speakerId": 1002,
            "speakerName": "Nefer",
            "text": "Oh, no, I'll pass. I'm just here with my friend to have a look around.",
            "nextDialogs": [
              "761390310"
            ]
          },
          "761390310": {
            "id": "761390310",
            "speakerId": 1002,
            "speakerName": "Nefer",
            "text": "I've heard your investments have been thriving, Mr. Dhabit. Seeing it with my own eyes, I can see the rumor holds true.",
            "nextDialogs": [
              "761390311"
            ]
          },
          "761390311": {
            "id": "761390311",
            "speakerId": 1000,
            "speakerName": "Dhabit",
            "text": "Oh, it's nothing, nothing, haha... just a small venture to make ends meet.",
            "nextDialogs": [
              "761390312"
            ]
          },
          "761390312": {
            "id": "761390312",
            "speakerId": 1002,
            "speakerName": "Nefer",
            "text": "Ah, Mr. Dhabit, you're too modest. Your reputation and business acumen are well known in Nasha Town.",
            "nextDialogs": [
              "761390313"
            ]
          },
          "761390313": {
            "id": "761390313",
            "speakerId": 1002,
            "speakerName": "Nefer",
            "text": "I'm certain that with everyone investing through you, you'll make a tidy fortune yourself.",
            "nextDialogs": [
              "761390314"
            ]
          },
          "761390314": {
            "id": "761390314",
            "speakerId": 1000,
            "speakerName": "Dhabit",
            "text": "Thank you for the kind words, Lady Nefer...",
            "nextDialogs": [
              "761390315"
            ]
          },
          "761390315": {
            "id": "761390315",
            "speakerId": 1000,
            "speakerName": "Dhabit",
            "text": "And, about that matter I asked your help with last time...",
            "nextDialogs": [
              "761390316"
            ]
          },
          "761390316": {
            "id": "761390316",
            "speakerId": 1002,
            "speakerName": "Nefer",
            "text": "We've found what you're looking for, but...",
            "nextDialogs": [
              "761390317"
            ]
          },
          "761390317": {
            "id": "761390317",
            "speakerId": 1002,
            "speakerName": "Nefer",
            "text": "Do have patience, Mr. Dhabit. One step at a time — that's how proper business is done.",
            "nextDialogs": [
              "761390318"
            ]
          },
          "761390318": {
            "id": "761390318",
            "speakerId": 1000,
            "speakerName": "Dhabit",
            "text": "O—Oh yes, you're right, of course... I'll leave it in your capable hands..."
          }
        }
      }
    }
  ]
}
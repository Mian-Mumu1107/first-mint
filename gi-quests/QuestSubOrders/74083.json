    {
      "subId": "7408310",
      "subQuestName": "Talk to the Melusine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740831001"
        ],
        "dialogs": {
          "740831001": {
            "id": "740831001",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And that's another key for us. Now all we need to do is find the final one.",
            "nextDialogs": [
              "740831002"
            ]
          },
          "740831002": {
            "id": "740831002",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Key, key, Pahsiv!",
            "nextDialogs": [
              "740831003"
            ]
          },
          "740831003": {
            "id": "740831003",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, Pahsiv! Where did you come from?",
            "nextDialogs": [
              "740831004"
            ]
          },
          "740831004": {
            "id": "740831004",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Disappeared, Pahsiv.",
            "nextDialogs": [
              "740831005"
            ]
          },
          "740831005": {
            "id": "740831005",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Okay then... Paimon's never met a Melusine so unique... And Paimon thought Melusine all lived in the Court of Fontaine or Merusea Village. How come you're out here?",
            "nextDialogs": [
              "740831006"
            ]
          },
          "740831006": {
            "id": "740831006",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Court of Fontaine? Merusea Village?",
            "nextDialogs": [
              "740831007"
            ]
          },
          "740831007": {
            "id": "740831007",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You seem confused. Haven't you heard of those places?",
            "nextDialogs": [
              "740831008"
            ]
          },
          "740831008": {
            "id": "740831008",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Court of Fontaine, Melusine... Merusea Village, Melusine...",
            "nextDialogs": [
              "740831009"
            ]
          },
          "740831009": {
            "id": "740831009",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Ah... Erinnyes, Pahsiv, home.",
            "nextDialogs": [
              "740831010"
            ]
          },
          "740831010": {
            "id": "740831010",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Erinnyes, Pahsiv, protect!",
            "nextDialogs": [
              "740831011"
            ]
          },
          "740831011": {
            "id": "740831011",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, you're saying that this is your home? And that you're protecting it?",
            "nextDialogs": [
              "740831012"
            ]
          },
          "740831012": {
            "id": "740831012",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740831013"
            ]
          },
          "740831013": {
            "id": "740831013",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But don't the Melusine live in Merusea Village?",
            "nextDialogs": [
              "740831014"
            ]
          },
          "740831014": {
            "id": "740831014",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yes, that's kinda strange. Are some Melusine born elsewhere? Paimon can't see any others here though.",
            "nextDialogs": [
              "740831015"
            ]
          },
          "740831015": {
            "id": "740831015",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Pahsiv, do you live here alone?",
            "nextDialogs": [
              "740831016"
            ]
          },
          "740831016": {
            "id": "740831016",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Alone? Melusine. New Valet! Pahsiv!",
            "nextDialogs": [
              "740831017"
            ]
          },
          "740831017": {
            "id": "740831017",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "New... Valet? There's a valet? Who?",
            "nextDialogs": [
              "740831018"
            ]
          },
          "740831018": {
            "id": "740831018",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "#New... Valet! Paimon, Paimon, {NICKNAME}, {NICKNAME}. New Valet, New Valet!",
            "nextDialogs": [
              "740831019"
            ]
          },
          "740831019": {
            "id": "740831019",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So who is New Valet, exactly?",
            "nextDialogs": [
              "740831020"
            ]
          },
          "740831020": {
            "id": "740831020",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Pahsiv... are you trying to say New Valet is called New Valet, like Paimon is called Paimon?",
            "nextDialogs": [
              "740831021"
            ]
          },
          "740831021": {
            "id": "740831021",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740831022"
            ]
          },
          "740831022": {
            "id": "740831022",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ah-ha! I was right. Paimon's always said that she's clever, hasn't she?",
            "nextDialogs": [
              "740831025"
            ]
          },
          "740831025": {
            "id": "740831025",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "New Valet, Pahsiv, knowledge, ka-pow.",
            "nextDialogs": [
              "740831026"
            ]
          },
          "740831026": {
            "id": "740831026",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Err... you mean that New Valet is helping you learn things?",
            "nextDialogs": [
              "740831027"
            ]
          },
          "740831027": {
            "id": "740831027",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Pahsiv! Lots of. Language, wisdom... lots of.",
            "nextDialogs": [
              "740831028"
            ]
          },
          "740831028": {
            "id": "740831028",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Er, Paimon's not sure about the \"lots of\" bit...",
            "nextDialogs": [
              "740831029"
            ]
          },
          "740831029": {
            "id": "740831029",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Pahsiv, New Valet, protect, ka-pow.",
            "nextDialogs": [
              "740831030"
            ]
          },
          "740831030": {
            "id": "740831030",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And he helps you protect this place?",
            "nextDialogs": [
              "740831031"
            ]
          },
          "740831031": {
            "id": "740831031",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Melusine...",
            "nextDialogs": [
              "740831032"
            ]
          },
          "740831032": {
            "id": "740831032",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You help him protect this place?",
            "nextDialogs": [
              "740831033"
            ]
          },
          "740831033": {
            "id": "740831033",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740831034"
            ]
          },
          "740831034": {
            "id": "740831034",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So that's it... But who is this New Valet? And why does he need you to help protect this place, anyway?",
            "nextDialogs": [
              "740831035"
            ]
          },
          "740831035": {
            "id": "740831035",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And some really bad things have happened here, too. We saw the stone tablet and how someone had scratched out the inscription, and lots of filth... Are there any enemies?",
            "nextDialogs": [
              "740831036"
            ]
          },
          "740831036": {
            "id": "740831036",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Curious Paimon, Pahsiv! But time very not lots of.",
            "nextDialogs": [
              "740831037"
            ]
          },
          "740831037": {
            "id": "740831037",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "Key, key, key, square, west, ka-pow, ka-pow.",
            "nextDialogs": [
              "740831038"
            ]
          },
          "740831038": {
            "id": "740831038",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll be as quick as we can!",
            "nextDialogs": [
              "740831039"
            ]
          },
          "740831039": {
            "id": "740831039",
            "speakerId": 1002,
            "speakerName": "Pahsiv",
            "text": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
            "nextDialogs": [
              "740831040"
            ]
          },
          "740831040": {
            "id": "740831040",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Pahsiv gives two happy jumps and then leaves in a bit of a hurry.",
            "nextDialogs": [
              "740831041"
            ]
          },
          "740831041": {
            "id": "740831041",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It looks like we really are pressed for time. But we've already got two keys, so let's press on and get the third!"
          }
        }
      }
    },

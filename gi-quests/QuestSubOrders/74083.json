    {
      "subId": "7408301",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740830101"
        ],
        "dialogs": {
          "740830101": {
            "id": "740830101",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "A glittering pearl of water appears on the altar.",
            "nextDialogs": [
              "740830102"
            ]
          },
          "740830102": {
            "id": "740830102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um, that drop of water... That can't be the treasure, can it?",
            "nextDialogs": [
              "740830103"
            ]
          },
          "740830103": {
            "id": "740830103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It doesn't look like treasure.",
            "nextDialogs": [
              "740830104"
            ]
          },
          "740830104": {
            "id": "740830104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's what Paimon thought. It can't be that easy. But what is it, then?",
            "nextDialogs": [
              "740830106",
              "740830111"
            ]
          },
          "740830106": {
            "id": "740830106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What? But that means catastrophe! Quick, put it back. Paimon hopes we're not too late!",
            "nextDialogs": [
              "740830107"
            ]
          },
          "740830107": {
            "id": "740830107",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Ah...",
            "nextDialogs": [
              "740830108"
            ]
          },
          "740830108": {
            "id": "740830108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh no! It's the Demon King!",
            "nextDialogs": [
              "740830109"
            ]
          },
          "740830109": {
            "id": "740830109",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "The Demon King? Melusine.",
            "nextDialogs": [
              "740830115"
            ]
          },
          "740830115": {
            "id": "740830115",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Gah, you gave Paimon a fright there... A Melusine, huh? What are you doing here?",
            "nextDialogs": [
              "740830116"
            ]
          },
          "740830116": {
            "id": "740830116",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Key.",
            "nextDialogs": [
              "740830117"
            ]
          },
          "740830117": {
            "id": "740830117",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Key? What key? Is this drop of water a key?",
            "nextDialogs": [
              "740830118"
            ]
          },
          "740830118": {
            "id": "740830118",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Pahsiv.",
            "nextDialogs": [
              "740830119"
            ]
          },
          "740830119": {
            "id": "740830119",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Err... The drop of water is Pahsiv?",
            "nextDialogs": [
              "740830120"
            ]
          },
          "740830120": {
            "id": "740830120",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Melusine.",
            "nextDialogs": [
              "740830121"
            ]
          },
          "740830121": {
            "id": "740830121",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ugh! What do you mean? Is the drop of water a Melusine? Paimon's getting dizzy. What on earth is this? Aren't you the Melusine here?",
            "nextDialogs": [
              "740830122"
            ]
          },
          "740830122": {
            "id": "740830122",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Pahsiv...",
            "nextDialogs": [
              "740830123"
            ]
          },
          "740830123": {
            "id": "740830123",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Err... You're a Pahsiv? Or is your name Pahsiv? Wait... No, don't answer. You'll just make Paimon dizzier...",
            "nextDialogs": [
              "740830124"
            ]
          },
          "740830124": {
            "id": "740830124",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Anyway, Paimon's decided to call you Pahsiv. Is that okay?",
            "nextDialogs": [
              "740830125"
            ]
          },
          "740830125": {
            "id": "740830125",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",
            "text": "Melusine...",
            "nextDialogs": [
              "740830126"
            ]
          },
          "740830126": {
            "id": "740830126",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}... What should we do? Paimon can't understand a thing she's saying. What is she trying to say?",
            "nextDialogs": [
              "740830127"
            ]
          },
          "740830127": {
            "id": "740830127",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You can understand what we're saying, can't you?",
            "nextDialogs": [
              "740830128"
            ]
          },
          "740830128": {
            "id": "740830128",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv...",
            "nextDialogs": [
              "740830129"
            ]
          },
          "740830129": {
            "id": "740830129",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This drop of water is a key, right?",
            "nextDialogs": [
              "740830130"
            ]
          },
          "740830130": {
            "id": "740830130",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv.",
            "nextDialogs": [
              "740830131"
            ]
          },
          "740830131": {
            "id": "740830131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're not a human, are you?",
            "nextDialogs": [
              "740830132"
            ]
          },
          "740830132": {
            "id": "740830132",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740830133"
            ]
          },
          "740830133": {
            "id": "740830133",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Er... Let's not be rude all of a sudden, shall we?",
            "nextDialogs": [
              "740830134"
            ]
          },
          "740830134": {
            "id": "740830134",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm not a human, am I?",
            "nextDialogs": [
              "740830135"
            ]
          },
          "740830135": {
            "id": "740830135",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",
            "text": "M—Melusine?",
            "nextDialogs": [
              "740830136"
            ]
          },
          "740830136": {
            "id": "740830136",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh! Wait! Paimon thinks she's starting to understand. \"Pahsiv\" is yes and \"Melusine\" is no. Could that be it?",
            "nextDialogs": [
              "740830137"
            ]
          },
          "740830137": {
            "id": "740830137",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv! Pahsiv!",
            "nextDialogs": [
              "740830138"
            ]
          },
          "740830138": {
            "id": "740830138",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So you're not called Pahsiv. Sorry, Paimon got your name wrong earlier.",
            "nextDialogs": [
              "740830139"
            ]
          },
          "740830139": {
            "id": "740830139",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",

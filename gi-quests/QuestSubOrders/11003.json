    {
      "subId": "1100304",
      "subQuestName": "Give the hunter the soup you prepared",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110030401"
        ],
        "dialogs": {
          "110030401": {
            "id": "110030401",
            "speakerId": 1001,
            "speakerName": "Olaf",
            "text": "Mmm... That is better... That is better...",
            "nextDialogs": [
              "110030402"
            ]
          },
          "110030402": {
            "id": "110030402",
            "speakerId": 1001,
            "speakerName": "Olaf",
            "text": "Thank you. That soup really did the trick.",
            "nextDialogs": [
              "110030403"
            ]
          },
          "110030403": {
            "id": "110030403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened, did you get frozen?",
            "nextDialogs": [
              "110030404"
            ]
          },
          "110030404": {
            "id": "110030404",
            "speakerId": 1001,
            "speakerName": "Olaf",
            "text": "Yes. I was chasing a boar, and after chasing him all this way he slipped into those underground ruins over there.",
            "nextDialogs": [
              "110030405"
            ]
          },
          "110030405": {
            "id": "110030405",
            "speakerId": 1001,
            "speakerName": "Olaf",
            "text": "I followed him inside, but ran into a Cryo Regisvine.",
            "nextDialogs": [
              "110030406"
            ]
          },
          "110030406": {
            "id": "110030406",
            "speakerId": 1001,
            "speakerName": "Olaf",
            "text": "It froze me instantly. When I woke up I ran straight outside, but... I only made it this far before my strength failed me.",
            "nextDialogs": [
              "110030407"
            ]
          },
          "110030407": {
            "id": "110030407",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "Cryo Regisvine? Vines... attack people?",
            "nextDialogs": [
              "110030408"
            ]
          },
          "110030408": {
            "id": "110030408",
            "speakerId": 1001,
            "speakerName": "Olaf",
            "text": "They do now! I'd heard of them before from others, but this was the first time seeing one with my own eyes.",
            "nextDialogs": [
              "110030409"
            ]
          },
          "110030409": {
            "id": "110030409",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yikes, we should definitely keep our distance from the ruins... It sounds dangerous.",
            "nextDialogs": [
              "110030410"
            ]
          },
          "110030410": {
            "id": "110030410",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "It sounds delicious!",
            "nextDialogs": [
              "110030413"
            ]
          },
          "110030413": {
            "id": "110030413",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "That's it! The missing ingredient! The icing on the cake!",
            "nextDialogs": [
              "110030414"
            ]
          },
          "110030414": {
            "id": "110030414",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Calm down. Can we really eat a tree that's that aggressive?",
            "nextDialogs": [
              "110030415"
            ]
          },
          "110030415": {
            "id": "110030415",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "Only one way to find out — let's go!",
            "nextDialogs": [
              "110030416"
            ]
          },
          "110030416": {
            "id": "110030416",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "*sigh* Off she goes again..."
          }
        }
      }
    },

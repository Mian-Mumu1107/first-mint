    {
      "subId": "1100302",
      "subQuestName": "Talk to Xiangling and the shivering man",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110030201"
        ],
        "dialogs": {
          "110030201": {
            "id": "110030201",
            "speakerId": 1001,
            "speakerName": "Olaf",
            "text": "Brr... So, so c—cold...",
            "nextDialogs": [
              "110030202"
            ]
          },
          "110030202": {
            "id": "110030202",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "He's shivering! We need to warm him up, quick!",
            "nextDialogs": [
              "110030203"
            ]
          },
          "110030203": {
            "id": "110030203",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Make a fire!",
            "nextDialogs": [
              "110030204"
            ]
          },
          "110030204": {
            "id": "110030204",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "Hot soup would be even better.",
            "nextDialogs": [
              "110030205"
            ]
          },
          "110030205": {
            "id": "110030205",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "#{NICKNAME}, how about I look after him while you make him a <color=#00E1FFFF>nice warm bowl of soup</color>?",
            "nextDialogs": [
              "110030206"
            ]
          },
          "110030206": {
            "id": "110030206",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "We passed a hilichurl camp on the way here. There'll almost certainly be a campfire there to cook on.",
            "nextDialogs": [
              "110030207"
            ]
          },
          "110030207": {
            "id": "110030207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure.",
            "nextDialogs": [
              "110030208"
            ]
          },
          "110030208": {
            "id": "110030208",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "Great. Be as quick as you can!"
          }
        }
      }

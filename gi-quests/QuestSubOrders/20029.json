{
  "lineCounts": {
    "Black Screen": 1,
    "Lily": 10,
    "Marjorie": 17,
    "Player": 29,
    "Rudolf": 8,
    "Terrified Schuster": 10,
    "Viktor": 55
  },
  "subQuests": [
    {
      "subId": "2002901",
      "subQuestName": "Talk to Viktor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200290101"
        ],
        "dialogs": {
          "200290101": {
            "id": "200290101",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Well, I guess I'm finally heading home...",
            "nextDialogs": [
              "200290102"
            ]
          },
          "200290102": {
            "id": "200290102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Leaving us, Viktor?",
            "nextDialogs": [
              "200290103"
            ]
          },
          "200290103": {
            "id": "200290103",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Eh? Oh, it's you...",
            "nextDialogs": [
              "200290104"
            ]
          },
          "200290104": {
            "id": "200290104",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "That's correct. I received orders from above recently that I can return to Snezhnaya.",
            "nextDialogs": [
              "200290105"
            ]
          },
          "200290105": {
            "id": "200290105",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Something about me being transferred to another Harbinger, and no longer needing to standby in Mondstadt for any new orders.",
            "nextDialogs": [
              "200290106"
            ]
          },
          "200290106": {
            "id": "200290106",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "I've got no clue which of them I'll be under this time, but I'm just praying that it's not Lord Scaramouche...",
            "nextDialogs": [
              "200290107"
            ]
          },
          "200290107": {
            "id": "200290107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "When will you be leaving?",
            "nextDialogs": [
              "200290108"
            ]
          },
          "200290108": {
            "id": "200290108",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "The higher-ups didn't mention that. I was just told to pack my things and be ready to leave at a moment's notice.",
            "nextDialogs": [
              "200290109"
            ]
          },
          "200290109": {
            "id": "200290109",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "I mean, that's great, right? Finally, I'll be free from the judging gazes of those Sisters!",
            "nextDialogs": [
              "200290110"
            ]
          },
          "200290110": {
            "id": "200290110",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Ah, right, Traveler. Seeing as how we've had dealings for so long... Won't you do a man one last favor?",
            "nextDialogs": [
              "200290111"
            ]
          },
          "200290111": {
            "id": "200290111",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Like before, you'll do the deed, and I'll cough up the payment. You'll never work for free when you work with me.",
            "nextDialogs": [
              "200290114"
            ]
          },
          "200290114": {
            "id": "200290114",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Haha. To tell the truth, I'm all out of Fatui stories to tell you.",
            "nextDialogs": [
              "200290115"
            ]
          },
          "200290115": {
            "id": "200290115",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "The payment this time will be Mora for sure. Sounds good?",
            "nextDialogs": [
              "200290116"
            ]
          },
          "200290116": {
            "id": "200290116",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Well, unless you'd like me to tell you the same fairy tales I tell Lily..."
          }
        }
      }
    },
    {
      "subId": "2002902",
      "subQuestName": "Ask Marjorie about a present",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200290201"
        ],
        "dialogs": {
          "200290201": {
            "id": "200290201",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "Hello there, Traveler. What can I do for you?",
            "nextDialogs": [
              "200290202"
            ]
          },
          "200290202": {
            "id": "200290202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you have any gifts for kids here?",
            "nextDialogs": [
              "200290203"
            ]
          },
          "200290203": {
            "id": "200290203",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "A gift for a child... Let me think.",
            "nextDialogs": [
              "200290204"
            ]
          },
          "200290204": {
            "id": "200290204",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "Hmm, actually, I've been attempting to fashion some small toys recently.",
            "nextDialogs": [
              "200290205"
            ]
          },
          "200290205": {
            "id": "200290205",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "The only catch is that they need a lot of Wolfhook dye, and I'm all out of Wolfhooks.",
            "nextDialogs": [
              "200290206"
            ]
          },
          "200290206": {
            "id": "200290206",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "I asked Schuster to help me gather some more, but he hasn't returned yet.",
            "nextDialogs": [
              "200290207"
            ]
          },
          "200290207": {
            "id": "200290207",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "Could you help me look for Schuster, Traveler?",
            "nextDialogs": [
              "200290208"
            ]
          },
          "200290208": {
            "id": "200290208",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "Once we have enough Wolfhooks, I should be able to make those toys for you.",
            "nextDialogs": [
              "200290211"
            ]
          },
          "200290211": {
            "id": "200290211",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "He said that he'd be going <color=#00E1FFFF>near Wolvendom</color> to gather Wolfhooks. You can head over there to look for him.",
            "nextDialogs": [
              "200290212"
            ]
          },
          "200290212": {
            "id": "200290212",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "In that case, I'm counting on you, Traveler."
          }
        }
      }
    },
    {
      "subId": "2002903",
      "subQuestName": "Look for Terrified Schuster",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2002904",
      "subQuestName": "Save Terrified Schuster",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200290401"
        ],
        "dialogs": {
          "200290401": {
            "id": "200290401",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Did you get the present?",
            "nextDialogs": [
              "200290403",
              "200290407",
              "200290410",
              "200290413"
            ]
          },
          "200290403": {
            "id": "200290403",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "What will I do? Well... I suppose I'll have to wait for my transfer orders.",
            "nextDialogs": [
              "200290404"
            ]
          },
          "200290404": {
            "id": "200290404",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "*sigh* If things go ill, I might get transferred to some archon-forsaken place and put on standby again.",
            "nextDialogs": [
              "200290405"
            ]
          },
          "200290405": {
            "id": "200290405",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "But I'm fine with whatever, so long as they don't toss me over to Inazuma..."
          },
          "200290407": {
            "id": "200290407",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Why, you ask? It's because of Lady Signora's... Well... her sacrifice.",
            "nextDialogs": [
              "200290408"
            ]
          },
          "200290408": {
            "id": "200290408",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Actually, you know what? I'm just a joiner. I listen to orders. There's no need for me to think too much."
          },
          "200290410": {
            "id": "200290410",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "I heard Rudolf mention that he was going to take her out to the square or something like that.",
            "nextDialogs": [
              "200290411"
            ]
          },
          "200290411": {
            "id": "200290411",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Heh. I suppose he's got to keep his precious daughter away from the evil Fatui, eh?"
          },
          "200290413": {
            "id": "200290413",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Alright. I leave the matter of the present to you, then."
          }
        }
      }
    },
    {
      "subId": "2002905",
      "subQuestName": "Talk to Schuster",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200290501"
        ],
        "dialogs": {
          "200290501": {
            "id": "200290501",
            "speakerId": 1573,
            "speakerName": "Terrified Schuster",
            "text": "Th—Thank you, Traveler.",
            "nextDialogs": [
              "200290502"
            ]
          },
          "200290502": {
            "id": "200290502",
            "speakerId": 1573,
            "speakerName": "Terrified Schuster",
            "text": "These monsters just kept coming after me, even after I ran all the way here...",
            "nextDialogs": [
              "200290503"
            ]
          },
          "200290503": {
            "id": "200290503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You came to gather some Wolfhooks, right?",
            "nextDialogs": [
              "200290504"
            ]
          },
          "200290504": {
            "id": "200290504",
            "speakerId": 1573,
            "speakerName": "Terrified Schuster",
            "text": "Eh? Yeah, it was Marjorie's request...",
            "nextDialogs": [
              "200290506"
            ]
          },
          "200290506": {
            "id": "200290506",
            "speakerId": 1573,
            "speakerName": "Terrified Schuster",
            "text": "...Come on, who would've agreed to come with me to work on a commission as simple as \"gathering plants\"?",
            "nextDialogs": [
              "200290508"
            ]
          },
          "200290508": {
            "id": "200290508",
            "speakerId": 1573,
            "speakerName": "Terrified Schuster",
            "text": "I know how that's supposed to work, of course, but you can only find Wolfhooks here, you know?",
            "nextDialogs": [
              "200290509"
            ]
          },
          "200290509": {
            "id": "200290509",
            "speakerId": 1573,
            "speakerName": "Terrified Schuster",
            "text": "And the Wolfhooks that grow in safer areas have all been picked.",
            "nextDialogs": [
              "200290510"
            ]
          },
          "200290510": {
            "id": "200290510",
            "speakerId": 1573,
            "speakerName": "Terrified Schuster",
            "text": "So I had to go further in to gather Wolfhooks...",
            "nextDialogs": [
              "200290511"
            ]
          },
          "200290511": {
            "id": "200290511",
            "speakerId": 1573,
            "speakerName": "Terrified Schuster",
            "text": "But let's not talk about that now. Could you help me pass these Wolfhooks to Marjorie?",
            "nextDialogs": [
              "200290512"
            ]
          },
          "200290512": {
            "id": "200290512",
            "speakerId": 1573,
            "speakerName": "Terrified Schuster",
            "text": "I need a moment to rest. I thought my legs were going to give out on me back there..."
          }
        }
      }
    },
    {
      "subId": "2002906",
      "subQuestName": "Give the Wolfhooks to Marjorie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200290601"
        ],
        "dialogs": {
          "200290601": {
            "id": "200290601",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "Did you manage to find Schuster, Traveler?",
            "nextDialogs": [
              "200290602"
            ]
          },
          "200290602": {
            "id": "200290602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He asked me to take these Wolfhooks back to you.",
            "nextDialogs": [
              "200290603"
            ]
          },
          "200290603": {
            "id": "200290603",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "Ah! Thank you very much. I'll take these, then.",
            "nextDialogs": [
              "200290604"
            ]
          },
          "200290604": {
            "id": "200290604",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "Once Schuster gets back, I'll make sure he gets paid.",
            "nextDialogs": [
              "200290605"
            ]
          },
          "200290605": {
            "id": "200290605",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "Right, you wanted a gift for a child, yes? Well then. Coming right up...",
            "nextDialogs": [
              "200290606"
            ]
          },
          "200290606": {
            "id": "200290606",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Marjorie starts to make the present...",
            "nextDialogs": [
              "200290607"
            ]
          },
          "200290607": {
            "id": "200290607",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "Well, that's a wrap! Here, take this. Thanks for bringing those Wolfhooks back, by the way.",
            "nextDialogs": [
              "200290608"
            ]
          },
          "200290608": {
            "id": "200290608",
            "speakerId": 1435,
            "speakerName": "Marjorie",
            "text": "This doll has a light scent to it, too. I'm sure the kid you're sending this to will love it."
          }
        }
      }
    },
    {
      "subId": "2002907",
      "subQuestName": "Give the present to Viktor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200290701"
        ],
        "dialogs": {
          "200290701": {
            "id": "200290701",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "How did it go? Did you get the present?",
            "nextDialogs": [
              "200290702"
            ]
          },
          "200290702": {
            "id": "200290702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I did.",
            "nextDialogs": [
              "200290703"
            ]
          },
          "200290703": {
            "id": "200290703",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Huh, I guess you're pretty good. Now let me see...",
            "nextDialogs": [
              "200290704"
            ]
          },
          "200290704": {
            "id": "200290704",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "What is this...",
            "nextDialogs": [
              "200290705"
            ]
          },
          "200290705": {
            "id": "200290705",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "This doll's all gangly and crooked, and its dye-job looks ridiculous... Well, it certainly smells nice, though.",
            "nextDialogs": [
              "200290706"
            ]
          },
          "200290706": {
            "id": "200290706",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Are you sure this is suitable for children?",
            "nextDialogs": [
              "200290710",
              "200290709"
            ]
          },
          "200290710": {
            "id": "200290710",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "This gift will have to do. But where do I put the letter... Eh, you know what, I'll just put it underneath..."
          },
          "200290709": {
            "id": "200290709",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Oh, I'd love to. But just think about it. If a Fatuus were to send anything to Mondstadt, wouldn't it get stopped at the city gates by the Knights of Favonius?"
          }
        }
      }
    },
    {
      "subId": "2002908",
      "subQuestName": "Deliver the present to Lily in turn",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200290801"
        ],
        "dialogs": {
          "200290801": {
            "id": "200290801",
            "speakerId": 1600,
            "speakerName": "Rudolf",
            "text": "Lily, you shouldn't be talking to that Fatui.",
            "nextDialogs": [
              "200290802"
            ]
          },
          "200290802": {
            "id": "200290802",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "But why not? Mister Fatooey's told me loadsa stowies!",
            "nextDialogs": [
              "200290803"
            ]
          },
          "200290803": {
            "id": "200290803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hey there, Lily, Viktor got you a gift.",
            "nextDialogs": [
              "200290804"
            ]
          },
          "200290804": {
            "id": "200290804",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Wow! Mister Fatooey got me a pwesent? Thank you!",
            "nextDialogs": [
              "200290805"
            ]
          },
          "200290805": {
            "id": "200290805",
            "speakerId": 1600,
            "speakerName": "Rudolf",
            "text": "Wait, why would that Fatuus send Lily a present? Don't tell me that he...",
            "nextDialogs": [
              "200290806"
            ]
          },
          "200290806": {
            "id": "200290806",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "That's becoz I gave Mister Fatooey lots of stuff to eat! That's why he sent me a gift!",
            "nextDialogs": [
              "200290807"
            ]
          },
          "200290807": {
            "id": "200290807",
            "speakerId": 1600,
            "speakerName": "Rudolf",
            "text": "Lily, he's not a good person...",
            "nextDialogs": [
              "200290808"
            ]
          },
          "200290808": {
            "id": "200290808",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "But he tells me stowies! He's a good guy!",
            "nextDialogs": [
              "200290811"
            ]
          },
          "200290811": {
            "id": "200290811",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Eh? Why does he have to go...",
            "nextDialogs": [
              "200290812"
            ]
          },
          "200290812": {
            "id": "200290812",
            "speakerId": 1600,
            "speakerName": "Rudolf",
            "text": "*sigh* He's leaving? Fine. I was beside myself with worry every day, what with that fellow talking to Lily every day and all.",
            "nextDialogs": [
              "200290813"
            ]
          },
          "200290813": {
            "id": "200290813",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Dadda, I wanna say bye bye to the Fatooey man!",
            "nextDialogs": [
              "200290814"
            ]
          },
          "200290814": {
            "id": "200290814",
            "speakerId": 1600,
            "speakerName": "Rudolf",
            "text": "*sigh* Lily, you shouldn't get too close to that man.",
            "nextDialogs": [
              "200290815"
            ]
          },
          "200290815": {
            "id": "200290815",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "But why? That Fatooey... He's been really nice to me!",
            "nextDialogs": [
              "200290816"
            ]
          },
          "200290816": {
            "id": "200290816",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "He tells me stowies. Lots of stowies! He's nice!",
            "nextDialogs": [
              "200290817"
            ]
          },
          "200290817": {
            "id": "200290817",
            "speakerId": 1600,
            "speakerName": "Rudolf",
            "text": "Lily, listen to Daddy. Things aren't that simple... *sigh* You know what? Daddy will tell you more when you're older."
          }
        }
      }
    },
    {
      "subId": "2002909",
      "subQuestName": "Talk to Viktor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200290901"
        ],
        "dialogs": {
          "200290901": {
            "id": "200290901",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Did you send the present to Lily?",
            "nextDialogs": [
              "200290902"
            ]
          },
          "200290902": {
            "id": "200290902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She's as pleased as punch.",
            "nextDialogs": [
              "200290903"
            ]
          },
          "200290903": {
            "id": "200290903",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "That's good. I suppose Rudolf had his own two Mora's worth to say on the subject?",
            "nextDialogs": [
              "200290904"
            ]
          },
          "200290904": {
            "id": "200290904",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Hmph, you don't even have to say it. No one trusts a Fatuus here in Mondstadt.",
            "nextDialogs": [
              "200290905"
            ]
          },
          "200290905": {
            "id": "200290905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "When are you leaving?",
            "nextDialogs": [
              "200290906"
            ]
          },
          "200290906": {
            "id": "200290906",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "The official order hasn't come down yet. I've just packed my things in advance, and I'll be staying at the Goth Grand Hotel for the time being — ready to leave at a moment's notice.",
            "nextDialogs": [
              "200290907"
            ]
          },
          "200290907": {
            "id": "200290907",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Come on, what's with that serious expression? Are you going to formally bid me farewell?",
            "nextDialogs": [
              "200290908"
            ]
          },
          "200290908": {
            "id": "200290908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No.",
            "nextDialogs": [
              "200290909"
            ]
          },
          "200290909": {
            "id": "200290909",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Hah, that's right. That's how it should be. We're not friends. We're just ad-hoc partners.",
            "nextDialogs": [
              "200290910"
            ]
          },
          "200290910": {
            "id": "200290910",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "If you should ever come to Snezhnaya, you can look for me there. We can continue doing business.",
            "nextDialogs": [
              "200290911"
            ]
          },
          "200290911": {
            "id": "200290911",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Alright, enough small talk. Here's your payment. Take it. I suppose this will be our last \"equivalent exchange\" here in Mondstadt.",
            "nextDialogs": [
              "200290912"
            ]
          },
          "200290912": {
            "id": "200290912",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "*sigh* I just hope my next assignment isn't as troublesome..."
          }
        }
      }
    },
    {
      "subId": "2002910",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200291001"
        ],
        "dialogs": {
          "200291001": {
            "id": "200291001",
            "speakerId": 1600,
            "speakerName": "Rudolf",
            "text": "Lily, you shouldn't be talking to that Fatui.",
            "nextDialogs": [
              "200291002"
            ]
          },
          "200291002": {
            "id": "200291002",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "But why not? Mister Fatooey's told me loadsa stowies!"
          }
        }
      }
    },
    {
      "subId": "2002912",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200291201"
        ],
        "dialogs": {
          "200291201": {
            "id": "200291201",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "I'm counting on you, Traveler.",
            "nextDialogs": [
              "200291202"
            ]
          },
          "200291202": {
            "id": "200291202",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "He said that he'd be going <color=#00E1FFFF>near Wolvendom</color> to gather Wolfhooks. You can head over there to look for him."
          }
        }
      }
    },
    {
      "subId": "2002914",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200291401"
        ],
        "dialogs": {
          "200291401": {
            "id": "200291401",
            "speakerId": 1573,
            "speakerName": "Terrified Schuster",
            "text": "Could you help me deliver these Wolfhooks to Marjorie? I just need a moment to rest. I thought my legs were going to give out on me back there..."
          }
        }
      }
    },
    {
      "subId": "2002917",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200291701"
        ],
        "dialogs": {
          "200291701": {
            "id": "200291701",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Help me deliver the present to Lily. She should be <color=#00E1FFFF>near the city square</color>.",
            "nextDialogs": [
              "200291702"
            ]
          },
          "200291702": {
            "id": "200291702",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "If I were to go myself, I'm sure Rudolf would be glaring daggers at me all the way..."
          }
        }
      }
    },
    {
      "subId": "2002919",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200291901"
        ],
        "dialogs": {
          "200291901": {
            "id": "200291901",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "But Dadda, he really is a good guy, and he tells great stowies!",
            "nextDialogs": [
              "200291902"
            ]
          },
          "200291902": {
            "id": "200291902",
            "speakerId": 1600,
            "speakerName": "Rudolf",
            "text": "Lily, things aren't that simple... *sigh* You know what? Daddy will tell you more when you're older."
          }
        }
      }
    },
    {
      "subId": "2002927",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200292701"
        ],
        "dialogs": {
          "200292701": {
            "id": "200292701",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "*sigh* I just hope my next assignment isn't as troublesome..."
          }
        }
      }
    },
    {
      "subId": "2002928",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200292801"
        ],
        "dialogs": {
          "200292801": {
            "id": "200292801",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Well, I guess I'm finally heading home...",
            "nextDialogs": [
              "200292802"
            ]
          },
          "200292802": {
            "id": "200292802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Leaving us, Viktor?",
            "nextDialogs": [
              "200292803"
            ]
          },
          "200292803": {
            "id": "200292803",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Eh? Oh, it's you...",
            "nextDialogs": [
              "200292804"
            ]
          },
          "200292804": {
            "id": "200292804",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "That's correct. I received orders from above recently that I can return to Snezhnaya.",
            "nextDialogs": [
              "200292805"
            ]
          },
          "200292805": {
            "id": "200292805",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Something about me being transferred to another Harbinger, and no longer needing to standby in Mondstadt for any new orders.",
            "nextDialogs": [
              "200292806"
            ]
          },
          "200292806": {
            "id": "200292806",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "I've got no clue which of them I'll be under this time, though..."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7213201",
      "subQuestName": "Head to Fort Mumei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721320101"
        ],
        "dialogs": {
          "721320101": {
            "id": "721320101",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Thanks for your efforts. Although the island is still full of dangers, this will give a little hope to all the people who have left their hometown and long to return.",
            "nextDialogs": [
              "721320102"
            ]
          },
          "721320102": {
            "id": "721320102",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "The fact that the rain has stopped may actually make the warring parties more aggressive in fighting for the island...",
            "nextDialogs": [
              "721320103"
            ]
          },
          "721320103": {
            "id": "721320103",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "But they were never going to help resolve the situation on the island anyway. What we have done is at least better than leaving the problem to fester.",
            "nextDialogs": [
              "721320104"
            ]
          },
          "721320104": {
            "id": "721320104",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Now, the gift I promised you.",
            "nextDialogs": [
              "721320105"
            ]
          },
          "721320105": {
            "id": "721320105",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "This is the famed spear once used by the Prefects of Yashiori. Now, I'm not sure how much use this drawing will be to you...",
            "nextDialogs": [
              "721320107"
            ]
          },
          "721320107": {
            "id": "721320107",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "But if you give it to a sufficiently skilled smith, they should be able to recreate the glory it once had in Lord Kitain's hands.",
            "nextDialogs": [
              "721320108"
            ]
          },
          "721320108": {
            "id": "721320108",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "*sigh* Alas, the age of heroes has come and gone, and the Kitain, who once destroyed so many evils, will never return again.",
            "nextDialogs": [
              "721320109"
            ]
          },
          "721320109": {
            "id": "721320109",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Still, we seem to have gotten a step closer to matching Lord Kitain's deeds in the present, thanks to your help.",
            "nextDialogs": [
              "721320110"
            ]
          },
          "721320110": {
            "id": "721320110",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Next, I will go to my friends in the Shogunate army to see if there's anything I can help with. I hope to see you again in the future."
          }
        }
      }
    },
    {

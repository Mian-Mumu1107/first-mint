  "subQuests": [
    {
      "subId": "7004701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700470101"
        ],
        "dialogs": {
          "700470101": {
            "id": "700470101",
            "speakerId": 1000,
            "speakerName": "Ajaw",
            "text": "Hey, Kinich. Look who's here.",
            "nextDialogs": [
              "700470102"
            ]
          },
          "700470102": {
            "id": "700470102",
            "speakerId": 1000,
            "speakerName": "Ajaw",
            "text": "#{NICKNAME}! The Almighty Dragonlord, K'uhul Ajaw demands you to attend him at once!",
            "nextDialogs": [
              "700470103"
            ]
          },
          "700470103": {
            "id": "700470103",
            "speakerId": 1001,
            "speakerName": "Kinich",
            "text": "#We meet again, {NICKNAME}.",
            "nextDialogs": [
              "700470104"
            ]
          },
          "700470104": {
            "id": "700470104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You seem well.",
            "nextDialogs": [
              "700470105"
            ]
          },
          "700470105": {
            "id": "700470105",
            "speakerId": 1000,
            "speakerName": "Ajaw",
            "text": "I am anything BUT well! My dullard servant has spent the last few hours staring at colorful paper scraps... The boredom is killing me!",
            "nextDialogs": [
              "700470106"
            ]
          },
          "700470106": {
            "id": "700470106",
            "speakerId": 1001,
            "speakerName": "Kinich",
            "text": "These \"paper scraps\" are decorations, and they look like they're made out of cardboard. They're quite interesting.",
            "nextDialogs": [
              "700470109"
            ]
          },
          "700470109": {
            "id": "700470109",
            "speakerId": 1001,
            "speakerName": "Kinich",
            "text": "I'd say I do. I think this cardboard would make a fitting home for Ajaw.",
            "nextDialogs": [
              "700470110"
            ]
          },
          "700470110": {
            "id": "700470110",
            "speakerId": 1000,
            "speakerName": "Ajaw",
            "text": "You mean to imply I'm some sort of paper dragon?",
            "nextDialogs": [
              "700470111"
            ]
          },
          "700470111": {
            "id": "700470111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You spend so much time being banished, the inside of a cardboard box should feel like home to you by now.",
            "nextDialogs": [
              "700470112"
            ]
          },
          "700470112": {
            "id": "700470112",
            "speakerId": 1000,
            "speakerName": "Ajaw",
            "text": "K—Kiniiiiiich! Just you wait, you'll be on your knees, begging for forgiveness, when you behold the true majesty of the Dragonlord K'uhul Ajaw!",
            "nextDialogs": [
              "700470113"
            ]
          },
          "700470113": {
            "id": "700470113",
            "speakerId": 1001,
            "speakerName": "Kinich",
            "text": "Until then, I'll be sure to take in the majesty of the little paper dragonlord K'uhul Ajaw.",
            "nextDialogs": [
              "700470114"
            ]
          },
          "700470114": {
            "id": "700470114",
            "speakerId": 1001,
            "speakerName": "Kinich",
            "text": "#{NICKNAME}, I see you've brought a Kamera with you. Would you mind taking a photo of this paper theater for me?",
            "nextDialogs": [
              "700470115"
            ]
          },
          "700470115": {
            "id": "700470115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Of course not, and I can take a picture of you while I'm at it.",
            "nextDialogs": [
              "700470116"
            ]
          },
          "700470116": {
            "id": "700470116",
            "speakerId": 1001,
            "speakerName": "Kinich",
            "text": "Alright, this'll make a good souvenir for our vacation.",
            "nextDialogs": [
              "700470117"
            ]
          },
          "700470117": {
            "id": "700470117",
            "speakerId": 1001,
            "speakerName": "Kinich",
            "text": "Oh, right. How should we pose for the photo?"
          }
        }
      }
    }
  ]
}
        "dialogs": {
          "762189901": {
            "id": "762189901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? We've received an invitation? Judging by the envelope... Oh! It must be from Sandrone!",
            "nextDialogs": [
              "762189902"
            ]
          },
          "762189902": {
            "id": "762189902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like we've been invited to a tea party. Hehe, Paimon can't wait! C'mon, let's go!"
          }

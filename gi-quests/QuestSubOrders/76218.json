  "subQuests": [
    {
      "subId": "7621801",
      "subQuestName": "During Gameplay$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762180101"
        ],
        "dialogs": {
          "762180101": {
            "id": "762180101",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Oh? You're here.",
            "nextDialogs": [
              "762180102"
            ]
          },
          "762180102": {
            "id": "762180102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hiya, Sandrone!",
            "nextDialogs": [
              "762180105"
            ]
          },
          "762180105": {
            "id": "762180105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Didn't your letter say we were having a tea party? How come there's nothing here? Don't tell Paimon this is a snack-free get-together!?",
            "nextDialogs": [
              "762180106"
            ]
          },
          "762180106": {
            "id": "762180106",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Hah, I bet you would love that, Paimon? You really think I'd forget the food?",
            "nextDialogs": [
              "762180107"
            ]
          },
          "762180107": {
            "id": "762180107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa! Did... Did that table just appear out of thin air!?",
            "nextDialogs": [
              "762180108"
            ]
          },
          "762180108": {
            "id": "762180108",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Hehe, impressive, right? This is my newly developed portable tea table.",
            "nextDialogs": [
              "762180109"
            ]
          },
          "762180109": {
            "id": "762180109",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "It's easy to carry and store, and even equipped with a hover device, just like Fagio.",
            "nextDialogs": [
              "762180110"
            ]
          },
          "762180110": {
            "id": "762180110",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "What's even more impressive is... Oh, uhm, never mind, I don't want to show off and make this sound like a sales pitch. You can check it out for yourselves.",
            "nextDialogs": [
              "762180111"
            ]
          },
          "762180111": {
            "id": "762180111",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Here, I've prepared some tea and snacks.",
            "nextDialogs": [
              "762180112"
            ]
          },
          "762180112": {
            "id": "762180112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll help myself then.",
            "nextDialogs": [
              "762180113"
            ]
          },
          "762180113": {
            "id": "762180113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Mmm...! These are so delicious! You really are a great cook!",
            "nextDialogs": [
              "762180114"
            ]
          },
          "762180114": {
            "id": "762180114",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Naturally.",
            "nextDialogs": [
              "762180115"
            ]
          },
          "762180115": {
            "id": "762180115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But what inspired you to make something like this?",
            "nextDialogs": [
              "762180116"
            ]
          },
          "762180116": {
            "id": "762180116",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "I wanted to be able to enjoy pleasant tea parties with friends wherever they are, of course.",
            "nextDialogs": [
              "762180117"
            ]
          },
          "762180117": {
            "id": "762180117",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "I've said this before. Holding on to what you already have isn't the only way to preserve what's precious.",
            "nextDialogs": [
              "762180118"
            ]
          },
          "762180118": {
            "id": "762180118",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Lately, I've found myself wanting to go on walks and visit my friends more often.",
            "nextDialogs": [
              "762180119"
            ]
          },
          "762180119": {
            "id": "762180119",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "But inviting myself to others' homes and expecting them to prepare tea and treats, then letting them clear the table afterward... It's hardly proper etiquette for a lady.",
            "nextDialogs": [
              "762180120"
            ]
          },
          "762180120": {
            "id": "762180120",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, Paimon doesn't think your friends would mind.",
            "nextDialogs": [
              "762180121"
            ]
          },
          "762180121": {
            "id": "762180121",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "I mind. Besides, a simple invention like this is no trouble at all for me.",
            "nextDialogs": [
              "762180122"
            ]
          },
          "762180122": {
            "id": "762180122",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "I can see you like it. Don't worry, I can make one for you, too.",
            "nextDialogs": [
              "762180123"
            ]
          },
          "762180123": {
            "id": "762180123",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh!? Are you sure that's alright?",
            "nextDialogs": [
              "762180124"
            ]
          },
          "762180124": {
            "id": "762180124",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "It's perfectly fine. Like I told you, I can whip up something like this in no time.",
            "nextDialogs": [
              "762180125"
            ]
          },
          "762180125": {
            "id": "762180125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "In that case, thank you very much...",
            "nextDialogs": [
              "762180126"
            ]
          },
          "762180126": {
            "id": "762180126",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Don't mention it. You helped me out a lot during the Fontinalia Festival. Consider this as thanks."
          }
        }
      }
    },

    {
      "subId": "7408411",
      "subQuestName": "Investigate the altar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740841101"
        ],
        "dialogs": {
          "740841101": {
            "id": "740841101",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "...Ah!",
            "nextDialogs": [
              "740841102"
            ]
          },
          "740841102": {
            "id": "740841102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why's there a Melusine here? Hey! Get away from that vishap! It's dangerous!",
            "nextDialogs": [
              "740841103"
            ]
          },
          "740841103": {
            "id": "740841103",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The newly appeared Melusine reaches out to stroke the vishap's head and the furious beast obediently lies down.\\nIt opens its mouth, coughs up a glittering drop of water, then jumps back into the water.",
            "nextDialogs": [
              "740841104"
            ]
          },
          "740841104": {
            "id": "740841104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? What was that?",
            "nextDialogs": [
              "740841105"
            ]
          },
          "740841105": {
            "id": "740841105",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Key.",
            "nextDialogs": [
              "740841106"
            ]
          },
          "740841106": {
            "id": "740841106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Key? What key? Is this drop of water a key?",
            "nextDialogs": [
              "740841107"
            ]
          },
          "740841107": {
            "id": "740841107",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Pahsiv.",
            "nextDialogs": [
              "740841108"
            ]
          },
          "740841108": {
            "id": "740841108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Err... The drop of water is Pahsiv?",
            "nextDialogs": [
              "740841109"
            ]
          },
          "740841109": {
            "id": "740841109",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Melusine.",
            "nextDialogs": [
              "740841110"
            ]
          },
          "740841110": {
            "id": "740841110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh! What do you mean? Is the drop of water a Melusine? Paimon's getting dizzy. What on earth is this? Aren't you the Melusine here?",
            "nextDialogs": [
              "740841111"
            ]
          },
          "740841111": {
            "id": "740841111",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Pahsiv...",
            "nextDialogs": [
              "740841112"
            ]
          },
          "740841112": {
            "id": "740841112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Err... You're a Pahsiv? Or is your name Pahsiv? Wait... No, don't answer. You'll just make Paimon dizzier...",
            "nextDialogs": [
              "740841113"
            ]
          },
          "740841113": {
            "id": "740841113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, Paimon's decided to call you Pahsiv. Is that okay?",
            "nextDialogs": [
              "740841114"
            ]
          },
          "740841114": {
            "id": "740841114",
            "speakerId": 1006,
            "speakerName": "Pahsiv?",
            "text": "Melusine...",
            "nextDialogs": [
              "740841115"
            ]
          },
          "740841115": {
            "id": "740841115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}... What should we do? Paimon can't understand a thing she's saying. What is she trying to say?",
            "nextDialogs": [
              "740841116"
            ]
          },
          "740841116": {
            "id": "740841116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You can understand what we're saying, can't you?",
            "nextDialogs": [
              "740841117"
            ]
          },
          "740841117": {
            "id": "740841117",
            "speakerId": 1006,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv...",
            "nextDialogs": [
              "740841118"
            ]
          },
          "740841118": {
            "id": "740841118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This drop of water is a key, right?",
            "nextDialogs": [
              "740841119"
            ]
          },
          "740841119": {
            "id": "740841119",
            "speakerId": 1006,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv.",
            "nextDialogs": [
              "740841120"
            ]
          },
          "740841120": {
            "id": "740841120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're not a human, are you?",
            "nextDialogs": [
              "740841121"
            ]
          },
          "740841121": {
            "id": "740841121",
            "speakerId": 1006,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740841122"
            ]
          },
          "740841122": {
            "id": "740841122",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Er... Let's not be rude all of a sudden, shall we?",
            "nextDialogs": [
              "740841123"
            ]
          },
          "740841123": {
            "id": "740841123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm not a human, am I?",
            "nextDialogs": [
              "740841124"
            ]
          },
          "740841124": {
            "id": "740841124",
            "speakerId": 1006,
            "speakerName": "Pahsiv?",
            "text": "M—Melusine?",
            "nextDialogs": [
              "740841125"
            ]
          },
          "740841125": {
            "id": "740841125",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh! Wait! Paimon thinks she's starting to understand. \"Pahsiv\" is yes and \"Melusine\" is no. Could that be it?",
            "nextDialogs": [
              "740841126"
            ]
          },
          "740841126": {
            "id": "740841126",
            "speakerId": 1006,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv! Pahsiv!",
            "nextDialogs": [
              "740841127"
            ]
          },
          "740841127": {
            "id": "740841127",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So you're not called Pahsiv. Sorry, Paimon got your name wrong earlier.",
            "nextDialogs": [
              "740841128"
            ]
          },
          "740841128": {
            "id": "740841128",
            "speakerId": 1006,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv... likes...",
            "nextDialogs": [
              "740841129"
            ]
          },
          "740841129": {
            "id": "740841129",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You like the name?",
            "nextDialogs": [
              "740841130"
            ]
          },
          "740841130": {
            "id": "740841130",
            "speakerId": 1006,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740841131"
            ]
          },
          "740841131": {
            "id": "740841131",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Wonderful! Then that's what Paimon will call you, hehe. This is {NICKNAME}. We're glad to meet you. And thanks for chasing that vishap off.",
            "nextDialogs": [
              "740841132"
            ]
          },
          "740841132": {
            "id": "740841132",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Blue thing, good thing, key, protect.",
            "nextDialogs": [
              "740841133"
            ]
          },
          "740841133": {
            "id": "740841133",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "By blue thing, you mean that vishap?",
            "nextDialogs": [
              "740841134"
            ]
          },
          "740841134": {
            "id": "740841134",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740841135"
            ]
          },
          "740841135": {
            "id": "740841135",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Was it helping you look after the key? Are you and the vishap friends?",
            "nextDialogs": [
              "740841136"
            ]
          },
          "740841136": {
            "id": "740841136",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740841137"
            ]
          },
          "740841137": {
            "id": "740841137",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Purple thing, steal key... Blue thing, fainted...",
            "nextDialogs": [
              "740841138"
            ]
          },
          "740841138": {
            "id": "740841138",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "P—Purple thing? Who is that?",
            "nextDialogs": [
              "740841139"
            ]
          },
          "740841139": {
            "id": "740841139",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "#Purple thing, bad thing! Blue thing, Paimon, {NICKNAME}, good thing!",
            "nextDialogs": [
              "740841140"
            ]
          },
          "740841140": {
            "id": "740841140",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Err... Okay. It all seems a bit odd, but it does seem like you're praising us.",
            "nextDialogs": [
              "740841141"
            ]
          },
          "740841141": {
            "id": "740841141",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Purple thing, lots bad, Erinnyes, Melusine...",
            "nextDialogs": [
              "740841142"
            ]
          },
          "740841142": {
            "id": "740841142",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Erinn-yes Melusine? Err... Erinn-no?",
            "nextDialogs": [
              "740841143"
            ]
          },
          "740841143": {
            "id": "740841143",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Something wrong with Erinnyes?",
            "nextDialogs": [
              "740841144"
            ]
          },
          "740841144": {
            "id": "740841144",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Erinnyes, Melusine, now...",
            "nextDialogs": [
              "740841145"
            ]
          },
          "740841145": {
            "id": "740841145",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv, Erinnyes, protect...",
            "nextDialogs": [
              "740841146"
            ]
          },
          "740841146": {
            "id": "740841146",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, something bad is happening to Erinnyes, and you want to protect it?",
            "nextDialogs": [
              "740841147"
            ]
          },
          "740841147": {
            "id": "740841147",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "#Paimon, {NICKNAME}, Erinnyes, ka-pow, ka-pow...",
            "nextDialogs": [
              "740841148"
            ]
          },
          "740841148": {
            "id": "740841148",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Er... So... you want us to wham-bam ka-pow Erinnyes a couple of times?",
            "nextDialogs": [
              "740841149"
            ]
          },
          "740841149": {
            "id": "740841149",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Melusine!",
            "nextDialogs": [
              "740841150"
            ]
          },
          "740841150": {
            "id": "740841150",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You want us to help?",
            "nextDialogs": [
              "740841151"
            ]
          },
          "740841151": {
            "id": "740841151",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740841152"
            ]
          },
          "740841152": {
            "id": "740841152",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay, so she wants help from us. That's good. Paimon didn't know how we could punch Erinnyes, with it being a whole island and all...",
            "nextDialogs": [
              "740841153"
            ]
          },
          "740841153": {
            "id": "740841153",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Ka-pow, ka-pow.",
            "nextDialogs": [
              "740841155"
            ]
          },
          "740841155": {
            "id": "740841155",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Re... ward?",
            "nextDialogs": [
              "740841156"
            ]
          },
          "740841156": {
            "id": "740841156",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Oh come on, {NICKNAME}! Pahsiv can barely talk! She won't be able to find anyone else to help her, so we should just do it!",
            "nextDialogs": [
              "740841157"
            ]
          },
          "740841157": {
            "id": "740841157",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do we need to do?",
            "nextDialogs": [
              "740841159"
            ]
          },
          "740841159": {
            "id": "740841159",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Key, key, key, number.",
            "nextDialogs": [
              "740841160"
            ]
          },
          "740841160": {
            "id": "740841160",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And then? How many keys is that, now?",
            "nextDialogs": [
              "740841161"
            ]
          },
          "740841161": {
            "id": "740841161",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Key! Key! Key!",
            "nextDialogs": [
              "740841162"
            ]
          },
          "740841162": {
            "id": "740841162",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Three keys?",
            "nextDialogs": [
              "740841163"
            ]
          },
          "740841163": {
            "id": "740841163",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv! Key, foggy path, south...",
            "nextDialogs": [
              "740841164"
            ]
          },
          "740841164": {
            "id": "740841164",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Key, spring, north...",
            "nextDialogs": [
              "740841165"
            ]
          },
          "740841165": {
            "id": "740841165",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Key, willow, east...",
            "nextDialogs": [
              "740841166"
            ]
          },
          "740841166": {
            "id": "740841166",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, that's what you mean... Let's make a note real quick... Three keys in total, one in the southern foggy road, one in the northern spring, and one in the eastern willows... Is Paimon right?",
            "nextDialogs": [
              "740841167"
            ]
          },
          "740841167": {
            "id": "740841167",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Key, key, key, square, west.",
            "nextDialogs": [
              "740841168"
            ]
          },
          "740841168": {
            "id": "740841168",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And there are three keys in the square to the west?",
            "nextDialogs": [
              "740841169"
            ]
          },
          "740841169": {
            "id": "740841169",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Collect three keys and go to the square?",
            "nextDialogs": [
              "740841170"
            ]
          },
          "740841170": {
            "id": "740841170",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "#Paimon, Melusine! {NICKNAME}, Pahsiv!",
            "nextDialogs": [
              "740841171"
            ]
          },
          "740841171": {
            "id": "740841171",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Oh c'mon, Pahsiv, do you have to always make it sound like {NICKNAME} is cleverer than Paimon? We're clearly of more or less equal intellect!",
            "nextDialogs": [
              "740841172"
            ]
          },
          "740841172": {
            "id": "740841172",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, we've already got one key, so all we need to do is find the remaining two.",
            "nextDialogs": [
              "740841173"
            ]
          },
          "740841173": {
            "id": "740841173",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Erinnyes, Melusine... Pahsiv, protect!",
            "nextDialogs": [
              "740841174"
            ]
          },
          "740841174": {
            "id": "740841174",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Relax. Paimon doesn't know what's happened, but we're going to help you protect Erinnyes for sure.",
            "nextDialogs": [
              "740841175"
            ]
          },
          "740841175": {
            "id": "740841175",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But if Paimon could add one small point, Pahsiv, Paimon would like to say that if you happen to see anything shiny, round, and unwanted, or some expensive-looking chest...",
            "nextDialogs": [
              "740841176"
            ]
          },
          "740841176": {
            "id": "740841176",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, it would be just wonderful if you could let us know!",
            "nextDialogs": [
              "740841177"
            ]
          },
          "740841177": {
            "id": "740841177",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Pahsiv scratches her head as she tries to understand, then gives two more happy jumps and leaves in a bit of a hurry.",
            "nextDialogs": [
              "740841178"
            ]
          },
          "740841178": {
            "id": "740841178",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Oh, she ran straight off. Guess she must have something really urgent to work on. {NICKNAME}, shall we go looking for those two keys now?"
          }
        }
      }
    },

            "speakerName": "Pahsiv",
            "text": "#Paimon, {NICKNAME}, Pahsiv! But...",
            "nextDialogs": [
              "740840817"
            ]
          },
          "740840817": {
            "id": "740840817",
            "speakerId": 5325,
            "speakerName": "Pahsiv",
            "text": "Key, key, key, square, west...",
            "nextDialogs": [
              "740840818"
            ]
          },
          "740840818": {
            "id": "740840818",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon knows. Don't worry, Pahsiv. We're going to the square in the west right now."
          }
        }
      }
    },
    {
      "subId": "7408403",

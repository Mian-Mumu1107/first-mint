              "740840602"
            ]
          },
          "740840602": {
            "id": "740840602",
            "speakerId": 1004,
            "speakerName": "Furious Roar",
            "text": "Raargh!",
            "nextDialogs": [
              "740840603"
            ]
          },
          "740840603": {
            "id": "740840603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no! The vishap woke up. We'd better scoot!",
            "nextDialogs": [
              "740840604"
            ]
          },
          "740840604": {
            "id": "740840604",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The vishap by the altar shakes itself awake, its eyes full of anger and hate...\\nYou swim for the shore as fast as you can, but it isn't giving up..."
          }
        }
      }

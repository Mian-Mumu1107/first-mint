      "dialogue": {
        "startDialogs": [
          "700671001"
        ],
        "dialogs": {
          "700671001": {
            "id": "700671001",
            "speakerId": 1000,
            "speakerName": "Vitruvius",
            "text": "Venipi! You're still alive! How wonderful to see you!",
            "nextDialogs": [
              "700671002"
            ]
          },
          "700671002": {
            "id": "700671002",
            "speakerId": 1000,
            "speakerName": "Vitruvius",
            "text": "Of course I know that death is not possible here. What I mean is, I'm so glad you didn't turn into sand.",
            "nextDialogs": [
              "700671003"
            ]
          },
          "700671003": {
            "id": "700671003",
            "speakerId": 1000,
            "speakerName": "Vitruvius",
            "text": "Anyway, you know what I mean.",
            "nextDialogs": [
              "700671004"
            ]
          },
          "700671004": {
            "id": "700671004",
            "speakerId": 1001,
            "speakerName": "Venipi",
            "text": "I do.",
            "nextDialogs": [
              "700671005"
            ]
          },
          "700671005": {
            "id": "700671005",
            "speakerId": 1000,
            "speakerName": "Vitruvius",
            "text": "And thanks to all of you, and Dex too.",
            "nextDialogs": [
              "700671006"
            ]
          },
          "700671006": {
            "id": "700671006",
            "speakerId": 1002,
            "speakerName": "Zeitlind",
            "text": "I didn't do a thing.",
            "nextDialogs": [
              "700671007"
            ]
          },
          "700671007": {
            "id": "700671007",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Venipi introduces you all to Vitruvius and recounts what just happened...",
            "nextDialogs": [
              "700671008"
            ]
          },
          "700671008": {
            "id": "700671008",
            "speakerId": 1000,
            "speakerName": "Vitruvius",
            "text": "Incredible — your strength exceeds even that of a typical Chief Centurion!",
            "nextDialogs": [
              "700671009"
            ]
          },
          "700671009": {
            "id": "700671009",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Now, even Paimon's kinda interested to see how you actually stack up in that system.",
            "nextDialogs": [
              "700671010"
            ]
          },
          "700671010": {
            "id": "700671010",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oh yeah?",
            "nextDialogs": [
              "700671011"
            ]
          },
          "700671011": {
            "id": "700671011",
            "speakerId": 1000,
            "speakerName": "Vitruvius",
            "text": "In that case, I'll take you to the others.",
            "nextDialogs": [
              "700671012"
            ]
          },
          "700671012": {
            "id": "700671012",
            "speakerId": 1000,
            "speakerName": "Vitruvius",
            "text": "After all, Venipi only provided the pattern work and motifs from King Deshret's times. I was the one responsible for the main layout and pathways in this area.",
            "nextDialogs": [
              "700671013"
            ]
          },
          "700671013": {
            "id": "700671013",
            "speakerId": 1001,
            "speakerName": "Venipi",
            "text": "That's right. While this may look like a building from some gilded age, it's really the result of everyone's knowledge."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2001401",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200140101"
        ],
        "dialogs": {
          "200140101": {
            "id": "200140101",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Anna, please reconsider. We should really take the long-term view here...",
            "nextDialogs": [
              "200140102"
            ]
          },
          "200140102": {
            "id": "200140102",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Oh, come on! Stop worrying, already. I'll be fine!",
            "nextDialogs": [
              "200140105"
            ]
          },
          "200140105": {
            "id": "200140105",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Traveler! You're just in time! Please, you've got to help me out here. Anna wants to become an adventurer!",
            "nextDialogs": [
              "200140106"
            ]
          },
          "200140106": {
            "id": "200140106",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "And why can't I be an adventurer? I'm as healthy as can be, and Cyrus says I've got the mind for the job, too!",
            "nextDialogs": [
              "200140107"
            ]
          },
          "200140107": {
            "id": "200140107",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "You haven't even been well for that long! What are you going to do if you fall ill again? Besides, there's no way our parents will agree!",
            "nextDialogs": [
              "200140108"
            ]
          },
          "200140108": {
            "id": "200140108",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Come on, I've already talked to Mom and Dad about this. They say they'll allow it as long as I pass the Adventurers' Guild selection trials.",
            "nextDialogs": [
              "200140109"
            ]
          },
          "200140109": {
            "id": "200140109",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Wh... What!?"
          }
        }
      }
    },
    {
      "subId": "2001402",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200140201"
        ],
        "dialogs": {
          "200140201": {
            "id": "200140201",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Wow, you beat them all down — you made it look pretty easy, too.",
            "nextDialogs": [
              "200140202"
            ]
          },
          "200140202": {
            "id": "200140202",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "It's just as the handbook says — you can use all sorts of ways and means to beat monsters...",
            "nextDialogs": [
              "200140203"
            ]
          },
          "200140203": {
            "id": "200140203",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Still, I've got to admit that they still scare me when they're this close. It's a good thing we've got you around...",
            "nextDialogs": [
              "200140204"
            ]
          },
          "200140204": {
            "id": "200140204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You still need more training.",
            "nextDialogs": [
              "200140205"
            ]
          },
          "200140205": {
            "id": "200140205",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Yup, I know. The road to becoming an adventurer is far from easy.",
            "nextDialogs": [
              "200140206"
            ]
          },
          "200140206": {
            "id": "200140206",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Thank you, Traveler! I'll head back to the city now. I'm sure my brother's worried sick by now...",
            "nextDialogs": [
              "200140207"
            ]
          },
          "200140207": {
            "id": "200140207",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I've got to train harder from now on."
          }
        }
      }
    },

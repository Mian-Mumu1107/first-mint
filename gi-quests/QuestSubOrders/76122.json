  },
  "subQuests": [
    {
      "subId": "7612201",
      "subQuestName": "Meet Columbina",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761220101"
        ],
        "dialogs": {
          "761220101": {
            "id": "761220101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Columbina?",
            "nextDialogs": [
              "761220102"
            ]
          },
          "761220102": {
            "id": "761220102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh. That's odd. Paimon's positive she heard Columbina's voice...",
            "nextDialogs": [
              "761220103"
            ]
          },
          "761220103": {
            "id": "761220103",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "...Hyah!",
            "nextDialogs": [
              "761220104"
            ]
          },
          "761220104": {
            "id": "761220104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aaaah!",
            "nextDialogs": [
              "761220105"
            ]
          },
          "761220105": {
            "id": "761220105",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Greetings.",
            "nextDialogs": [
              "761220106"
            ]
          },
          "761220106": {
            "id": "761220106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Another jumpscare? Not cool! If you were here, you should've just said so!",
            "nextDialogs": [
              "761220107"
            ]
          },
          "761220107": {
            "id": "761220107",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "I thought that since you were already so familiar with this game, I should increase the difficulty this round...",
            "nextDialogs": [
              "761220108"
            ]
          },
          "761220108": {
            "id": "761220108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph! Paimon's gonna get you next time, just you wait!",
            "nextDialogs": [
              "761220109"
            ]
          },
          "761220109": {
            "id": "761220109",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Great! I look forward to it.",
            "nextDialogs": [
              "761220110"
            ]
          },
          "761220110": {
            "id": "761220110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened to your eye mask, Columbina?",
            "nextDialogs": [
              "761220111"
            ]
          },
          "761220111": {
            "id": "761220111",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Oh. I guess the kuuhenki must've swiped it when we were playing earlier.",
            "nextDialogs": [
              "761220112"
            ]
          },
          "761220112": {
            "id": "761220112",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "I don't usually need to use my eyes, so the mask makes little difference. Let them play with it if they like.",
            "nextDialogs": [
              "761220113"
            ]
          },
          "761220113": {
            "id": "761220113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh! On that note, don't you want to go out more often?",
            "nextDialogs": [
              "761220114"
            ]
          },
          "761220114": {
            "id": "761220114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You no longer need to hide from anyone, right?",
            "nextDialogs": [
              "761220115"
            ]
          },
          "761220115": {
            "id": "761220115",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Yes... I have plenty of time now. I can go where I wish, when I wish.",
            "nextDialogs": [
              "761220116"
            ]
          },
          "761220116": {
            "id": "761220116",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "However, I was concerned that you might worry if you came looking for me but found that I had left without saying goodbye.",
            "nextDialogs": [
              "761220119"
            ]
          },
          "761220119": {
            "id": "761220119",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah! After all, we only need to know that you're okay.",
            "nextDialogs": [
              "761220120"
            ]
          },
          "761220120": {
            "id": "761220120",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "I see. I will consider it, then.",
            "nextDialogs": [
              "761220121"
            ]
          },
          "761220121": {
            "id": "761220121",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You'll only \"consider\" it...?",
            "nextDialogs": [
              "761220122"
            ]
          },
          "761220122": {
            "id": "761220122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Or maybe this is just where you want to be.",
            "nextDialogs": [
              "761220123"
            ]
          },
          "761220123": {
            "id": "761220123",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Everything that has happened here... I find them to be happy memories.",
            "nextDialogs": [
              "761220124"
            ]
          },
          "761220124": {
            "id": "761220124",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "That said, I do have another reason for waiting for you here.",
            "nextDialogs": [
              "761220125"
            ]
          },
          "761220125": {
            "id": "761220125",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And what's that?",
            "nextDialogs": [
              "761220126"
            ]
          },
          "761220126": {
            "id": "761220126",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "To give you a pleasant surprise."
          }
        }
      }
    },
    {
      "subId": "7612205",
      "subQuestName": "Head to where the surprise is",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7612204",
      "subQuestName": "Talk to Columbina",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761220401"
        ],
        "dialogs": {
          "761220401": {
            "id": "761220401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow! This must be the place you were talking about, right? Paimon wasn't there last time, so she didn't get to see it.",
            "nextDialogs": [
              "761220402"
            ]
          },
          "761220402": {
            "id": "761220402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It truly is lovely.",
            "nextDialogs": [
              "761220403"
            ]
          },
          "761220403": {
            "id": "761220403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Can Paimon fly around and check it out?",
            "nextDialogs": [
              "761220404"
            ]
          },
          "761220404": {
            "id": "761220404",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Of course.",
            "nextDialogs": [
              "761220405"
            ]
          },
          "761220405": {
            "id": "761220405",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "If it pleases you, I could bring you back again someday.",
            "nextDialogs": [
              "761220406"
            ]
          },
          "761220406": {
            "id": "761220406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, this is the \"pleasant surprise,\" then?",
            "nextDialogs": [
              "761220407"
            ]
          },
          "761220407": {
            "id": "761220407",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Oh? So this is enough to pass as a \"pleasant surprise\" in your eyes? No, the real surprise is yet to come.",
            "nextDialogs": [
              "761220408"
            ]
          },
          "761220408": {
            "id": "761220408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's more?",
            "nextDialogs": [
              "761220409"
            ]
          },
          "761220409": {
            "id": "761220409",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Come. Let us paint.",
            "nextDialogs": [
              "761220410"
            ]
          },
          "761220410": {
            "id": "761220410",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait. Here? But Paimon doesn't see canvas, brushes, or paints anywhere.",
            "nextDialogs": [
              "761220411"
            ]
          },
          "761220411": {
            "id": "761220411",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Oh. That's simple.",
            "nextDialogs": [
              "761220412"
            ]
          },
          "761220412": {
            "id": "761220412",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "The water's surface is our canvas, the moonlight our brushes, and the paths we take shall serve as the brushstrokes.",
            "nextDialogs": [
              "761220413"
            ]
          },
          "761220413": {
            "id": "761220413",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "With the moon's reflection to guide us, pure thought shall flow beneath our feet."
          }
        }
      }
    },
    {
      "subId": "7612202",
      "subQuestName": "Follow the moon's guide and paint the pattern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761220201"
        ],
        "dialogs": {
          "761220201": {
            "id": "761220201",
            "speakerId": 15380,
            "speakerName": "Luonnotar",
            "text": "...!",
            "nextDialogs": [
              "761220202"
            ]
          },
          "761220202": {
            "id": "761220202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Luonnotar! It's really you! You're back! In the silvery flesh! Paimon thought she'd never see you again!",
            "nextDialogs": [
              "761220203"
            ]
          },
          "761220203": {
            "id": "761220203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The painting we drew...",
            "nextDialogs": [
              "761220204"
            ]
          },
          "761220204": {
            "id": "761220204",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "We used moonlight to trace this child's form, and I poured new power and new blessings therein, causing her to be reborn.",
            "nextDialogs": [
              "761220205"
            ]
          },
          "761220205": {
            "id": "761220205",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "She no longer needs to bear my spirit. Her will is hers alone.",
            "nextDialogs": [
              "761220206"
            ]
          },
          "761220206": {
            "id": "761220206",
            "speakerId": 15380,
            "speakerName": "Luonnotar",
            "text": "!!!",
            "nextDialogs": [
              "761220207"
            ]
          },
          "761220207": {
            "id": "761220207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, she's flying over!",
            "nextDialogs": [
              "761220208"
            ]
          },
          "761220208": {
            "id": "761220208",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Yes. I have awakened all the memories of the time you spent together.",
            "nextDialogs": [
              "761220210"
            ]
          },
          "761220210": {
            "id": "761220210",
            "speakerId": 15380,
            "speakerName": "Luonnotar",
            "text": "...! ...!",
            "nextDialogs": [
              "761220211"
            ]
          },
          "761220211": {
            "id": "761220211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*sniff* Paimon's so glad to have you back, Luonnotar. She promises to be nicer to you from now on...",
            "nextDialogs": [
              "761220212"
            ]
          },
          "761220212": {
            "id": "761220212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon wasn't expecting the surprise to be this pleasant... Paimon loves it!",
            "nextDialogs": [
              "761220213"
            ]
          },
          "761220213": {
            "id": "761220213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thank you, Columbina.",
            "nextDialogs": [
              "761220214"
            ]
          },
          "761220214": {
            "id": "761220214",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "It wasn't much. I, too, am glad to see her again.",
            "nextDialogs": [
              "761220216"
            ]
          },
          "761220216": {
            "id": "761220216",
            "speakerId": 15380,
            "speakerName": "Luonnotar",
            "text": "...!",
            "nextDialogs": [
              "761220217"
            ]
          },
          "761220217": {
            "id": "761220217",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "...",
            "nextDialogs": [
              "761220218"
            ]
          },
          "761220218": {
            "id": "761220218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(She's still very attached to Luonnotar, but her expression is different from before.)",
            "nextDialogs": [
              "761220219"
            ]
          },
          "761220219": {
            "id": "761220219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(She looks at Luonnotar not as merely a created familiar, but as a familiar friend.)",
            "nextDialogs": [
              "761220220"
            ]
          },
          "761220220": {
            "id": "761220220",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Go. You must miss them, surely.",
            "nextDialogs": [
              "761220221"
            ]
          },
          "761220221": {
            "id": "761220221",
            "speakerId": 15380,
            "speakerName": "Luonnotar",
            "text": "...!",
            "nextDialogs": [
              "761220222"
            ]
          },
          "761220222": {
            "id": "761220222",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "You're welcome to come back any time."
          }
        }
      }
    },
    {
      "subId": "7612203",

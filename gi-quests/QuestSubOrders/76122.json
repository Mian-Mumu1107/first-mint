    {
      "subId": "7612203",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761220301"
        ],
        "dialogs": {
          "761220301": {
            "id": "761220301",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "Now, I know how fond you are of them, but let's not cause them any trouble now, alright?",
            "nextDialogs": [
              "761220303"
            ]
          },
          "761220303": {
            "id": "761220303",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Come back here to rest, should you find yourself tired from playing outside.",
            "nextDialogs": [
              "761220302"
            ]
          },
          "761220302": {
            "id": "761220302",
            "speakerId": 15380,
            "speakerName": "Luonnotar",
            "text": "...!"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "4111401",
      "subQuestName": "Ask Mona about the progress of her scrying",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411140101"
        ],
        "dialogs": {
          "411140101": {
            "id": "411140101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Is Fischl waiting for us?",
            "nextDialogs": [
              "411140102"
            ]
          },
          "411140102": {
            "id": "411140102",
            "speakerId": 1001,
            "speakerName": "Oz",
            "text": "The time has finally come. Though it brings mein Fräulein no joy to do so, there is something she must announce to the assembled populous.",
            "nextDialogs": [
              "411140103"
            ]
          },
          "411140103": {
            "id": "411140103",
            "speakerId": 1002,
            "speakerName": "Fischl",
            "text": "My loyal servants, one must bid you adieu till such time as I beckon you once more. Though we have faced many trials and tribulations together, you have all shown commendable courage in the course of duty. I feel a breeze now blows upon this place... and I feel that it blows in your honor.",
            "nextDialogs": [
              "411140104"
            ]
          },
          "411140104": {
            "id": "411140104",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whaaaat? You're just gonna bail on us!?",
            "nextDialogs": [
              "411140105"
            ]
          },
          "411140105": {
            "id": "411140105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Fischl, are you leaving?",
            "nextDialogs": [
              "411140106"
            ]
          },
          "411140106": {
            "id": "411140106",
            "speakerId": 1001,
            "speakerName": "Oz",
            "text": "With the arrival of this giant meteorite, many more people have succumbed to the slumber. Strong as the soldiers may be, they are struggling to cope, and there is demand for volunteers everywhere we turn.",
            "nextDialogs": [
              "411140107"
            ]
          },
          "411140107": {
            "id": "411140107",
            "speakerId": 1001,
            "speakerName": "Oz",
            "text": "Mein Fräulein and I shall tend to the victims on the soldiers' behalf. The rest of this investigation we place in your capable hands.",
            "nextDialogs": [
              "411140108"
            ]
          },
          "411140108": {
            "id": "411140108",
            "speakerId": 1002,
            "speakerName": "Fischl",
            "text": "#...Goodbye, {NICKNAME}.",
            "nextDialogs": [
              "411140109"
            ]
          },
          "411140109": {
            "id": "411140109",
            "speakerId": 1002,
            "speakerName": "Fischl",
            "text": "You are a good listener. ...I enjoy chatting with you.",
            "nextDialogs": [
              "411140110"
            ]
          },
          "411140110": {
            "id": "411140110",
            "speakerId": 1002,
            "speakerName": "Fischl",
            "text": "To be honest, most of the other adventurers in the Guild only ever talk to me when they wanna hear Oz's reconnaissance reports...",
            "nextDialogs": [
              "411140111"
            ]
          },
          "411140111": {
            "id": "411140111",
            "speakerId": 1002,
            "speakerName": "Fischl",
            "text": "This little journey we had... it was a great adventure. I'm just sorry that it has to end so abruptly...",
            "nextDialogs": [
              "411140112"
            ]
          },
          "411140112": {
            "id": "411140112",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? You're talking a little weirder than you normally do...",
            "nextDialogs": [
              "411140113"
            ]
          },
          "411140113": {
            "id": "411140113",
            "speakerId": 1002,
            "speakerName": "Fischl",
            "text": "!!!",
            "nextDialogs": [
              "411140114"
            ]
          },
          "411140114": {
            "id": "411140114",
            "speakerId": 1002,
            "speakerName": "Fischl",
            "text": "(Yikes!!! What am I doing? I totally broke form...)",
            "nextDialogs": [
              "411140115"
            ]
          },
          "411140115": {
            "id": "411140115",
            "speakerId": 1001,
            "speakerName": "Oz",
            "text": "What mein Fräulein means to say, is... is... is that the mystical mysteries that vex and perplex are bound to be effortlessly extinguished by the advent of your commendable courage and wondrous wisdom.",
            "nextDialogs": [
              "411140116"
            ]
          },
          "411140116": {
            "id": "411140116",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Uh... And now Oz's translation is the one that sounds all kooky.",
            "nextDialogs": [
              "411140117"
            ]
          },
          "411140117": {
            "id": "411140117",
            "speakerId": 1001,
            "speakerName": "Oz",
            "text": "Ahem... Mein Fräulein simply wishes to say that she has every confidence that you will arrive at the truth of this matter.",
            "nextDialogs": [
              "411140118"
            ]
          },
          "411140118": {
            "id": "411140118",
            "speakerId": 1002,
            "speakerName": "Fischl",
            "text": "Ahem! Most indeed... My dear attendants, I hereby charge the Ritter der Verurteilung with leading you out from the darkness, back into the realm of light.",
            "nextDialogs": [
              "411140119"
            ]
          },
          "411140119": {
            "id": "411140119",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Who are you calling your \"attendant...\"",
            "nextDialogs": [
              "411140120"
            ]
          },
          "411140120": {
            "id": "411140120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thank you Oz, and thank you Fischl.",
            "nextDialogs": [
              "411140121"
            ]
          },
          "411140121": {
            "id": "411140121",
            "speakerId": 1001,
            "speakerName": "Oz",
            "text": "We will meet again. Once this matter is concluded, I propose that we all get a drink together.",
            "nextDialogs": [
              "411140122"
            ]
          },
          "411140122": {
            "id": "411140122",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Well, now we're two people short.",
            "nextDialogs": [
              "411140123"
            ]
          },
          "411140123": {
            "id": "411140123",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "But let's not get hung up about that. The good news is, I've found something else out.",
            "nextDialogs": [
              "411140124"
            ]
          },
          "411140124": {
            "id": "411140124",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "I shaved some dust off the meteorite and used it to do another reading. It was actually really effective!",
            "nextDialogs": [
              "411140125"
            ]
          },
          "411140125": {
            "id": "411140125",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "These rocks have been around for hundreds, maybe even thousands of years. Leonard must have lived a very long time ago.",
            "nextDialogs": [
              "411140126"
            ]
          },
          "411140126": {
            "id": "411140126",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "The meteorites carry his will, and can pass it on to others. In other words, centuries on from Leonard's life, and the strength of his will has not diminished one bit.",
            "nextDialogs": [
              "411140127"
            ]
          },
          "411140127": {
            "id": "411140127",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "A guy from the distant past with a burning ambition to scale the highest mountain... I'd be willing to bet that he was an adventurer, just like you.",
            "nextDialogs": [
              "411140128"
            ]
          },
          "411140128": {
            "id": "411140128",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "An adventurer? That does explain his obsession with mountain climbing!",
            "nextDialogs": [
              "411140129"
            ]
          },
          "411140129": {
            "id": "411140129",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Our approach so far has been too passive, and time has been against us every step of the way. We need to change our strategy, and we need to attack this problem at its source.",
            "nextDialogs": [
              "411140130"
            ]
          },
          "411140130": {
            "id": "411140130",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon agrees! From now on, we need to put Leonard at the center of everything we do.",
            "nextDialogs": [
              "411140131"
            ]
          },
          "411140131": {
            "id": "411140131",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Yes... Because if the meteorites carry Leonard's will with them, then it's precisely as Fischl said: the rocks are, in a sense, a curse...",
            "nextDialogs": [
              "411140132"
            ]
          },
          "411140132": {
            "id": "411140132",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "I'm a little incredulous, but it turns out her blind guess was actually spot on... Ugh, no, I'm a respectable astrologist, and I shouldn't stoop to that kind of criticism.",
            "nextDialogs": [
              "411140133"
            ]
          },
          "411140133": {
            "id": "411140133",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Anyway. All we need to do now is remove the curse.",
            "nextDialogs": [
              "411140134"
            ]
          },
          "411140134": {
            "id": "411140134",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Come on Paimon, let's go.",
            "nextDialogs": [
              "411140135"
            ]
          },
          "411140135": {
            "id": "411140135",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Okie-dokie!",
            "nextDialogs": [
              "411140136"
            ]
          },
          "411140136": {
            "id": "411140136",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Since we've got a historical adventurer on our hands, Paimon thinks we should pay a visit to the <color=#00E1FFFF>Adventurers' Guild</color>."
          }
        }
      }
    },
    {
      "subId": "4111407",
      "subQuestName": "Talk to Katheryne in Mondstadt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411140701"
        ],
        "dialogs": {
          "411140701": {
            "id": "411140701",
            "speakerId": 1004,
            "speakerName": "Katheryne",
            "text": "Our records show that there have been many adventurers by that name over the years, it is impossible to know which one you refer to.",
            "nextDialogs": [
              "411140702"
            ]
          },
          "411140702": {
            "id": "411140702",
            "speakerId": 1004,
            "speakerName": "Katheryne",
            "text": "However, I do recall that there is a book in the library authored by someone called Leonard. Perhaps you should take a look?",
            "nextDialogs": [
              "411140703"
            ]
          },
          "411140703": {
            "id": "411140703",
            "speakerId": 1004,
            "speakerName": "Katheryne",
            "text": "However, I do recall that there is a book in the <color=#00E1FFFF>library</color> authored by someone called Leonard. Perhaps you should take a look?"
          }
        }
      }
    },
    {
      "subId": "4111408",
      "subQuestName": "Search for clues in the Mondstadt Library",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411140801"
        ],
        "dialogs": {
          "411140801": {
            "id": "411140801",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Author, Leonard... Where are you, Leonard... Aha! Gotcha!",
            "nextDialogs": [
              "411140802"
            ]
          },
          "411140802": {
            "id": "411140802",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "The index says that Leonard's book should be in the <color=#00E1FFFF>north-west corner</color> on the <color=#00E1FFFF>first floor</color> of the library.",
            "nextDialogs": [
              "411140803"
            ]
          },
          "411140803": {
            "id": "411140803",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "North-west corner... Should be right over there."
          }
        }
      }
    },
    {
      "subId": "4111403",
      "subQuestName": "Check the index in front of Lisa's desk",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4111404",
      "subQuestName": "Look for the book Leonard authored",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4111405",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411141401"
        ],
        "dialogs": {
          "411141401": {
            "id": "411141401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Found it! \"Of Mountains and Seas,\" A Guide for Adventurers, written by Leonard!",
            "nextDialogs": [
              "411141402"
            ]
          },
          "411141402": {
            "id": "411141402",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But the words have faded and there are even pages missing... Paimon's got no hope of reading this.",
            "nextDialogs": [
              "411141403"
            ]
          },
          "411141403": {
            "id": "411141403",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Darn... Maybe we're just wasting our time on this one?",
            "nextDialogs": [
              "411141404"
            ]
          },
          "411141404": {
            "id": "411141404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't give up. Let's see what Mona says.",
            "nextDialogs": [
              "411141405"
            ]
          },
          "411141405": {
            "id": "411141405",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, right, yeah! Mona! She might have a better idea."
          }
        }
      }
    },
    {
      "subId": "4111409",
      "subQuestName": "Bring Leonard's book to Mona",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411140901"
        ],
        "dialogs": {
          "411140901": {
            "id": "411140901",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Look what we found, Leonard wrote a book!",
            "nextDialogs": [
              "411140902"
            ]
          },
          "411140902": {
            "id": "411140902",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Ooh, let me see!",
            "nextDialogs": [
              "411140903"
            ]
          },
          "411140903": {
            "id": "411140903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's quite incoherent as there is lots missing.",
            "nextDialogs": [
              "411140904"
            ]
          },
          "411140904": {
            "id": "411140904",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Hm! I could have predicted as much...",
            "nextDialogs": [
              "411140905"
            ]
          },
          "411140905": {
            "id": "411140905",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Your average astrologist would definitely give up at this point.",
            "nextDialogs": [
              "411140906"
            ]
          },
          "411140906": {
            "id": "411140906",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "But I am Mona, progenitor of the future of astrology. Nothing can stand in my way.",
            "nextDialogs": [
              "411140907"
            ]
          },
          "411140907": {
            "id": "411140907",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "I simply need to deduce the missing portions with my astrolabe, write them in, and then decipher the text...",
            "nextDialogs": [
              "411140908"
            ]
          },
          "411140908": {
            "id": "411140908",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Phew! Finished at last...",
            "nextDialogs": [
              "411140909"
            ]
          },
          "411140909": {
            "id": "411140909",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So what does it say?",
            "nextDialogs": [
              "411140910"
            ]
          },
          "411140910": {
            "id": "411140910",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Just as I thought, Leonard was an adventurer who lived two thousand years ago.",
            "nextDialogs": [
              "411140911"
            ]
          },
          "411140911": {
            "id": "411140911",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "His lifelong dream was to reach the summit of a mountain called Pilos Peak.",
            "nextDialogs": [
              "411140912"
            ]
          },
          "411140912": {
            "id": "411140912",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Two thousand years? So the constellation that caused the meteorites is from two thousand years ago!?",
            "nextDialogs": [
              "411140913"
            ]
          },
          "411140913": {
            "id": "411140913",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Somehow, for some reason, this constellation was summoned down from the sky. I suspect that the Fatui have something to do with that part.",
            "nextDialogs": [
              "411140914"
            ]
          },
          "411140914": {
            "id": "411140914",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon thinks so too. Whenever something shady happens, you can bet the Fatui are involved.",
            "nextDialogs": [
              "411140915"
            ]
          },
          "411140915": {
            "id": "411140915",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "The meteorites harbor elemental energy, which radiates out and lulls people to sleep by some means akin to hypnosis.",
            "nextDialogs": [
              "411140916"
            ]
          },
          "411140916": {
            "id": "411140916",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "And if I'm guessing correctly, there should be some sort of core meteorite among the bunch, within which is a crystal that harbors Leonard's spirit.",
            "nextDialogs": [
              "411140917"
            ]
          },
          "411140917": {
            "id": "411140917",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How will we find it?",
            "nextDialogs": [
              "411140918"
            ]
          },
          "411140918": {
            "id": "411140918",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Well, if I were Leonard, I would want to make sure the core lands right on the snowy summit that I never made it to while I was alive.",
            "nextDialogs": [
              "411140919"
            ]
          },
          "411140919": {
            "id": "411140919",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So the core should be at the top of Pilos Peak? Where is that? Paimon's never heard of it before.",
            "nextDialogs": [
              "411140920"
            ]
          },
          "411140920": {
            "id": "411140920",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "It's the first I'd heard of it too, so I compared the map from the book against the current topography of Mondstadt. Apparently, Pilos Peak no longer exists.",
            "nextDialogs": [
              "411140921"
            ]
          },
          "411140921": {
            "id": "411140921",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Are you trying to say that the tallest mountain Paimon's never heard of just... disappeared!?",
            "nextDialogs": [
              "411140922"
            ]
          },
          "411140922": {
            "id": "411140922",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "I once read somewhere that the Anemo Archon, Barbatos, once used his divine power to mobilize the winds and blow the ice and snow from the face of the earth. The whole landscape of Mondstadt was changed in the process.",
            "nextDialogs": [
              "411140923"
            ]
          },
          "411140923": {
            "id": "411140923",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "The mountains of that age were replaced by the vast stretch of ocean we see today. Still, a mountain that high? Drop it into the ocean and it'll still leave a trace.",
            "nextDialogs": [
              "411140924"
            ]
          },
          "411140924": {
            "id": "411140924",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "The summit still reaches just above the water's surface. So, the place known as Pilos Peak in Leonard's day is today known...",
            "nextDialogs": [
              "411140925"
            ]
          },
          "411140925": {
            "id": "411140925",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "...as <color=#00E1FFFF>\"Musk Reef.\"</color>"
          }
        }
      }
    },
    {
      "subId": "4111410",
      "subQuestName": "Go to Musk Reef as the book indicates",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4111411",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411141101"
        ],
        "dialogs": {
          "411141101": {
            "id": "411141101",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Ho? So this is Pilos Peak? Not much to show for itself now, eh?",
            "nextDialogs": [
              "411141102"
            ]
          },
          "411141102": {
            "id": "411141102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Looks like someone beat us here... Is this, like, a popular tourist spot, or...",
            "nextDialogs": [
              "411141103"
            ]
          },
          "411141103": {
            "id": "411141103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ah! It's you!",
            "nextDialogs": [
              "411141104"
            ]
          },
          "411141104": {
            "id": "411141104",
            "speakerId": 1005,
            "speakerName": "The Balladeer",
            "text": "Ugh... Huh? You again?",
            "nextDialogs": [
              "411141107"
            ]
          },
          "411141107": {
            "id": "411141107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Look at the state he's in... Was he in that dream just now?",
            "nextDialogs": [
              "411141108"
            ]
          },
          "411141108": {
            "id": "411141108",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "He managed to extricate himself from the dream on his own strength? How is that possible?",
            "nextDialogs": [
              "411141109"
            ]
          },
          "411141109": {
            "id": "411141109",
            "speakerId": 1005,
            "speakerName": "The Balladeer",
            "text": "Hah! Just because you are powerless to do something does not mean that I am.",
            "nextDialogs": [
              "411141110"
            ]
          },
          "411141110": {
            "id": "411141110",
            "speakerId": 1005,
            "speakerName": "The Balladeer",
            "text": "You're too late, anyway. I've finished my research.",
            "nextDialogs": [
              "411141111"
            ]
          },
          "411141111": {
            "id": "411141111",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We knew it! This was all a dirty trick by the Fatui!",
            "nextDialogs": [
              "411141112"
            ]
          },
          "411141112": {
            "id": "411141112",
            "speakerId": 1005,
            "speakerName": "The Balladeer",
            "text": "Save it. No more fun and games for me today. I'll come for you when I'm good and ready.",
            "nextDialogs": [
              "411141113"
            ]
          },
          "411141113": {
            "id": "411141113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wait! What are you trying to achieve?",
            "nextDialogs": [
              "411141114"
            ]
          },
          "411141114": {
            "id": "411141114",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "You entered the dream they've all been having, didn't you? How much do you know about Leonard?",
            "nextDialogs": [
              "411141115"
            ]
          },
          "411141115": {
            "id": "411141115",
            "speakerId": 1005,
            "speakerName": "The Balladeer",
            "text": "Leonard? Who's Leonard? ...Ugh, whatever! I have bigger fish to fry!",
            "nextDialogs": [
              "411141116"
            ]
          },
          "411141116": {
            "id": "411141116",
            "speakerId": 1005,
            "speakerName": "The Balladeer",
            "text": "I've discovered something far more important... and far more terrifying.",
            "nextDialogs": [
              "411141117"
            ]
          },
          "411141117": {
            "id": "411141117",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What?",
            "nextDialogs": [
              "411141118"
            ]
          },
          "411141118": {
            "id": "411141118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What is it?",
            "nextDialogs": [
              "411141119"
            ]
          },
          "411141119": {
            "id": "411141119",
            "speakerId": 1005,
            "speakerName": "The Balladeer",
            "text": "The stars, the sky... It's all a gigantic hoax. A lie.",
            "nextDialogs": [
              "411141120"
            ]
          },
          "411141120": {
            "id": "411141120",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "The stars are a lie? What are you talking about?",
            "nextDialogs": [
              "411141121"
            ]
          },
          "411141121": {
            "id": "411141121",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Is this some kind of astrological debate between you and Mona? Because if so, surely you can come up with a better argument than \"The stars are a lie.\"",
            "nextDialogs": [
              "411141122"
            ]
          },
          "411141122": {
            "id": "411141122",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Seriously, who's gonna fall for that one when you can just lift your head up at night and see them up there, twinkling away?",
            "nextDialogs": [
              "411141123"
            ]
          },
          "411141123": {
            "id": "411141123",
            "speakerId": 1005,
            "speakerName": "The Balladeer",
            "text": "Hah... Hahahahaha! Oh, you are so naive, it kills me!",
            "nextDialogs": [
              "411141124"
            ]
          },
          "411141124": {
            "id": "411141124",
            "speakerId": 1005,
            "speakerName": "The Balladeer",
            "text": "Still... Can't really blame you. After all, I used to believe the same thing myself — up until a few moments ago, that is...",
            "nextDialogs": [
              "411141125"
            ]
          },
          "411141125": {
            "id": "411141125",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "A few moments ago? You mean...",
            "nextDialogs": [
              "411141126"
            ]
          },
          "411141126": {
            "id": "411141126",
            "speakerId": 1005,
            "speakerName": "The Balladeer",
            "text": "Look — I really don't have the time to do this right now.",
            "nextDialogs": [
              "411141127"
            ]
          },
          "411141127": {
            "id": "411141127",
            "speakerId": 1005,
            "speakerName": "The Balladeer",
            "text": "What was the Jester thinking? He must have had some inkling of what we might discover on this mission... Would it really have been so difficult to give me a little forewarning? Hmph, or maybe he just wanted to give me a fright...",
            "nextDialogs": [
              "411141128"
            ]
          },
          "411141128": {
            "id": "411141128",
            "speakerId": 1005,
            "speakerName": "The Balladeer",
            "text": "Time for me to go out and find the truth. So long, suckers!"
          }
        }
      }
    },
    {
      "subId": "4111412",
      "subQuestName": "Defeat Scaramouche's subordinates",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4111415",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411141501"
        ],
        "dialogs": {
          "411141501": {
            "id": "411141501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wow, you fought so fiercely!",
            "nextDialogs": [
              "411141502"
            ]
          },
          "411141502": {
            "id": "411141502",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Told you! That's what happens when you disrespect me!",
            "nextDialogs": [
              "411141503"
            ]
          },
          "411141503": {
            "id": "411141503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Mona, you are a force to be reckoned with.",
            "nextDialogs": [
              "411141504"
            ]
          },
          "411141504": {
            "id": "411141504",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "You bet I am! Paimon, you agree too, right? Did I show those Fatui who's boss or what?",
            "nextDialogs": [
              "411141505"
            ]
          },
          "411141505": {
            "id": "411141505",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Sure did! Without you here, those guys would have caused us a whole lot more trouble!",
            "nextDialogs": [
              "411141506"
            ]
          },
          "411141506": {
            "id": "411141506",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "See! How do you like that, Harbinger! Scumbag...",
            "nextDialogs": [
              "411141507"
            ]
          },
          "411141507": {
            "id": "411141507",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "He seemed genuinely shaken, though. I don't think he was lying. I was always taught to talk about the \"false sky\" during astrological readings... Could there be more to such phrases than I have been led to believe?",
            "nextDialogs": [
              "411141508"
            ]
          },
          "411141508": {
            "id": "411141508",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "...Ahem. I digress. Come on, let's finish the job we came to do.",
            "nextDialogs": [
              "411141509"
            ]
          },
          "411141509": {
            "id": "411141509",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "The <color=#00E1FFFF>core</color> has gotta be round here somewhere!"
          }
        }
      }
    },
    {
      "subId": "4111413",
      "subQuestName": "Destroy the meteorite core",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4111416",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411141601"
        ],
        "dialogs": {
          "411141601": {
            "id": "411141601",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa, this must be the core... It looks totally different from all the other meteorites! It's way more... shiny.",
            "nextDialogs": [
              "411141602"
            ]
          },
          "411141602": {
            "id": "411141602",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "This stone harbors an unbelievable amount of elemental energy, and human desire. It's the core alright.",
            "nextDialogs": [
              "411141603"
            ]
          },
          "411141603": {
            "id": "411141603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Should we... destroy it?",
            "nextDialogs": [
              "411141604"
            ]
          },
          "411141604": {
            "id": "411141604",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Yes. Otherwise, the victims will never wake up... This core is the root cause of everything that has happened.",
            "nextDialogs": [
              "411141605"
            ]
          },
          "411141605": {
            "id": "411141605",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Do it, {NICKNAME}!",
            "nextDialogs": [
              "411141606"
            ]
          },
          "411141606": {
            "id": "411141606",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Wow. Well, that was unexpected...",
            "nextDialogs": [
              "411141609"
            ]
          },
          "411141609": {
            "id": "411141609",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Who would have thought that human will can survive in the skies for millennia on end...",
            "nextDialogs": [
              "411141610"
            ]
          },
          "411141610": {
            "id": "411141610",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Astrology really is an incredible thing!",
            "nextDialogs": [
              "411141611"
            ]
          },
          "411141611": {
            "id": "411141611",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...What makes you say that?",
            "nextDialogs": [
              "411141612"
            ]
          },
          "411141612": {
            "id": "411141612",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "The ability to communicate with the stars can give you access to all the secrets from throughout human history... Though of course, very few astrologists ever reach that level.",
            "nextDialogs": [
              "411141613"
            ]
          },
          "411141613": {
            "id": "411141613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Mona, thank you ever so much for all of your assistance.",
            "nextDialogs": [
              "411141614"
            ]
          },
          "411141614": {
            "id": "411141614",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Uh... What's with the formal tone all of a sudden?",
            "nextDialogs": [
              "411141615"
            ]
          },
          "411141615": {
            "id": "411141615",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "And speaking of formal tone... What is the deal with that girl, Fischl? She's a curious one.",
            "nextDialogs": [
              "411141616"
            ]
          },
          "411141616": {
            "id": "411141616",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon thinks so, too! She's soooo... How to put this..."
          }
        }
      }
    }
  ]
}
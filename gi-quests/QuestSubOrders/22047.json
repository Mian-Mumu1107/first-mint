              "220470103"
            ]
          },
          "220470103": {
            "id": "220470103",
            "speakerId": 12064,
            "speakerName": "Shouji",
            "text": "Oh, you're... Thank you so much for that demonstration you gave us previously!",
            "nextDialogs": [
              "220470104"
            ]
          },
          "220470104": {
            "id": "220470104",
            "speakerId": 12064,
            "speakerName": "Shouji",
            "text": "Thanks to you, I've...",

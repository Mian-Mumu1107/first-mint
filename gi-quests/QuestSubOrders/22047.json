              "220470110"
            ]
          },
          "220470110": {
            "id": "220470110",
            "speakerId": 12064,
            "speakerName": "Shouji",
            "text": "...Um, since you're here, do you mind putting on another demonstration?",
            "nextDialogs": [
              "220470111"
            ]
          },
          "220470111": {
            "id": "220470111",
            "speakerId": 12064,
            "speakerName": "Shouji",
            "text": "With your help, I believe that I'll make progress even faster."
          }
        }

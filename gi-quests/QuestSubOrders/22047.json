              "220470404"
            ]
          },
          "220470404": {
            "id": "220470404",
            "speakerId": 12064,
            "speakerName": "Shouji",
            "text": "...Hmm, how should I put this, though? It feels like the more I watch, the more I can sense the gulf in our skills...",

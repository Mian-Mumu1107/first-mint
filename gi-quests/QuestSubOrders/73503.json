            "text": "\"Thoughts flow freely, and wisdom halts on the shore, pondering.\""
          }
        }
      }
    },
    {
      "subId": "7350309",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

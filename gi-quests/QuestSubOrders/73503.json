    {
      "subId": "7350301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735030101"
        ],
        "dialogs": {
          "735030101": {
            "id": "735030101",
            "speakerId": 1002,
            "speakerName": "Drusus",
            "text": "Oh, this is a good one...",
            "nextDialogs": [
              "735030102"
            ]
          },
          "735030102": {
            "id": "735030102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you working on your riddles again?",
            "nextDialogs": [
              "735030103"
            ]
          },
          "735030103": {
            "id": "735030103",
            "speakerId": 1002,
            "speakerName": "Drusus",
            "text": "Traveler! You've come at the right time! I'm about to design a whole new series of riddles.",
            "nextDialogs": [
              "735030104"
            ]
          },
          "735030104": {
            "id": "735030104",
            "speakerId": 1002,
            "speakerName": "Drusus",
            "text": "The terrain here is a little complicated. See, there is a huge root of the Divine Tree entering the water from one side of the harbor.",
            "nextDialogs": [
              "735030105"
            ]
          },
          "735030105": {
            "id": "735030105",
            "speakerId": 1002,
            "speakerName": "Drusus",
            "text": "On the other side is a huge lotus leaf, and a lot of ships waiting to leave the harbor.",
            "nextDialogs": [
              "735030106"
            ]
          },
          "735030106": {
            "id": "735030106",
            "speakerId": 1002,
            "speakerName": "Drusus",
            "text": "Traveler, which side do you feel is better as the theme for this riddle?",
            "nextDialogs": [
              "735030108",
              "735030111",
              "735030114"
            ]
          },
          "735030108": {
            "id": "735030108",
            "speakerId": 1002,
            "speakerName": "Drusus",
            "text": "Really? The huge root system of the Divine Tree is quite conspicuous, and easily seen as the \"entry point\" of the riddle.",
            "nextDialogs": [
              "735030109"
            ]
          },
          "735030109": {
            "id": "735030109",
            "speakerId": 1002,
            "speakerName": "Drusus",
            "text": "Okay! I'll write a riddle with the root system as the theme."
          },
          "735030111": {
            "id": "735030111",
            "speakerId": 1002,
            "speakerName": "Drusus",
            "text": "Indeed... It could be fun in another sense if we link the two.",
            "nextDialogs": [
              "735030112"
            ]
          },
          "735030112": {
            "id": "735030112",
            "speakerId": 1002,
            "speakerName": "Drusus",
            "text": "No problem, I'll just make a riddle with this theme."
          },
          "735030114": {
            "id": "735030114",
            "speakerId": 1002,
            "speakerName": "Drusus",
            "text": "Too easy? What ideas do you have then?"
          }
        }
      }
    },
    {
      "subId": "7350308",

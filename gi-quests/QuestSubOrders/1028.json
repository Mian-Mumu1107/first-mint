    {
      "subId": "102808",
      "subQuestName": "Ascertain if the Domain leads outside",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10280801"
        ],
        "dialogs": {
          "10280801": {
            "id": "10280801",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "That's it, I wanna take another look. And this time, I, Arataki \"The One and Oni,\" will...",
            "nextDialogs": [
              "10280802"
            ]
          },
          "10280802": {
            "id": "10280802",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Boss.",
            "nextDialogs": [
              "10280803"
            ]
          },
          "10280803": {
            "id": "10280803",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Whoa! What's up, sourpuss?",
            "nextDialogs": [
              "10280804"
            ]
          },
          "10280804": {
            "id": "10280804",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Time for some Roasted Lavender Melon.",
            "nextDialogs": [
              "10280805"
            ]
          },
          "10280805": {
            "id": "10280805",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Huh? We're trapped in a life and death situation underground, and you're telling me it's time for Roasted Lavender Melon?",
            "nextDialogs": [
              "10280806"
            ]
          },
          "10280806": {
            "id": "10280806",
            "speakerId": 12544,
            "speakerName": "Ushi",
            "text": "Moo, moo.",
            "nextDialogs": [
              "10280807"
            ]
          },
          "10280807": {
            "id": "10280807",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Interesting, you hear that? Ushi says you're completely right... Wait, hold on, whose side are you on, Beefcake?",
            "nextDialogs": [
              "10280808"
            ]
          },
          "10280808": {
            "id": "10280808",
            "speakerId": 12544,
            "speakerName": "Ushi",
            "text": "Moo...",
            "nextDialogs": [
              "10280809"
            ]
          },
          "10280809": {
            "id": "10280809",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "It's important to stay replenished. We must keep our energy and morale up in preparation for facing the unknown.",
            "nextDialogs": [
              "10280810"
            ]
          },
          "10280810": {
            "id": "10280810",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Even Ushi knows that.",
            "nextDialogs": [
              "10280811"
            ]
          },
          "10280811": {
            "id": "10280811",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Fine, you two... Hey are you already eating?",
            "nextDialogs": [
              "10280812"
            ]
          },
          "10280812": {
            "id": "10280812",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Hold on, is it still warm? Oh, that does smell good... Mmm...",
            "nextDialogs": [
              "10280813"
            ]
          },
          "10280813": {
            "id": "10280813",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Fine, yeah, we'll have a quick snack and then we'll keep looking for a way out. Hey, don't eat them all, leave a couple for me!"
          }
        }
      }
    },
    {
      "subId": "102803",
      "subQuestName": "Leave the Domain",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "102804",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10280401"
        ],
        "dialogs": {
          "10280401": {
            "id": "10280401",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Wh— Huh? Wait, this ain't right!",
            "nextDialogs": [
              "10280402"
            ]
          },
          "10280402": {
            "id": "10280402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, how did we end up back here!?",
            "nextDialogs": [
              "10280403"
            ]
          },
          "10280403": {
            "id": "10280403",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "So we've been here already?",
            "nextDialogs": [
              "10280404"
            ]
          },
          "10280404": {
            "id": "10280404",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Yes, this is exactly where we started.",
            "nextDialogs": [
              "10280405"
            ]
          },
          "10280405": {
            "id": "10280405",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "But we couldn't have taken a wrong turn, we were headed in the same direction the entire time. We never turned around...",
            "nextDialogs": [
              "10280406"
            ]
          },
          "10280406": {
            "id": "10280406",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "Yes, that's what I thought, too.",
            "nextDialogs": [
              "10280407"
            ]
          },
          "10280407": {
            "id": "10280407",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Traveler, we were going the right way, weren't we?",
            "nextDialogs": [
              "10280408"
            ]
          },
          "10280408": {
            "id": "10280408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, I thought we were headed in the right direction.",
            "nextDialogs": [
              "10280409"
            ]
          },
          "10280409": {
            "id": "10280409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How strange...",
            "nextDialogs": [
              "10280410"
            ]
          },
          "10280410": {
            "id": "10280410",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "There's a legend in Inazuma about a merchant who was tricked by a bake-danuki one evening and kept circling around the same place the whole night. Even by dawn, they still hadn't found a way out...",
            "nextDialogs": [
              "10280411"
            ]
          },
          "10280411": {
            "id": "10280411",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, Paimon's heard that one before too.",
            "nextDialogs": [
              "10280412"
            ]
          },
          "10280412": {
            "id": "10280412",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "So we're all familiar with the story then? Good, because I'm pretty sure that's what's happening to us right now.",
            "nextDialogs": [
              "10280413"
            ]
          },
          "10280413": {
            "id": "10280413",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "But fear not, I happen to have a certain sidekick who can exorcise youkai and spirits and whatnot. Let me summon him real quick.",
            "nextDialogs": [
              "10280414"
            ]
          },
          "10280414": {
            "id": "10280414",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Unbelievable. An oni who's friends with an exorcist... What an open-minded guy.",
            "nextDialogs": [
              "10280415"
            ]
          },
          "10280415": {
            "id": "10280415",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "For the boss, ignorance is a virtue.",
            "nextDialogs": [
              "10280416"
            ]
          },
          "10280416": {
            "id": "10280416",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "You're up, Ushi, go get that spirit!",
            "nextDialogs": [
              "10280417"
            ]
          },
          "10280417": {
            "id": "10280417",
            "speakerId": 12544,
            "speakerName": "Ushi",
            "text": "Moo!",
            "nextDialogs": [
              "10280418"
            ]
          },
          "10280418": {
            "id": "10280418",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "This is Ushi, an auxiliary member of the Arataki Gang.",
            "nextDialogs": [
              "10280419"
            ]
          },
          "10280419": {
            "id": "10280419",
            "speakerId": 12544,
            "speakerName": "Ushi",
            "text": "Moo, moo.",
            "nextDialogs": [
              "10280420"
            ]
          },
          "10280420": {
            "id": "10280420",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Haha, oh, Ushi says hello everyone. You can just call him \"Ushi\" or \"Beefcake.\" Yeah, he's got a keen sense of direction, so I'll let him lead the way.",
            "nextDialogs": [
              "10280421"
            ]
          },
          "10280421": {
            "id": "10280421",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "I didn't know gangs could have auxiliary members...",
            "nextDialogs": [
              "10280422"
            ]
          },
          "10280422": {
            "id": "10280422",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "This does not have the trappings of something that's gonna work.",
            "nextDialogs": [
              "10280423"
            ]
          },
          "10280423": {
            "id": "10280423",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "You're telling me.",
            "nextDialogs": [
              "10280424"
            ]
          },
          "10280424": {
            "id": "10280424",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Alright, go Ushi! Go find us a way outta here!",
            "nextDialogs": [
              "10280425"
            ]
          },
          "10280425": {
            "id": "10280425",
            "speakerId": 12544,
            "speakerName": "Ushi",
            "text": "Moo!",
            "nextDialogs": [
              "10280426"
            ]
          },
          "10280426": {
            "id": "10280426",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "Ushi begins looking around for a hidden exit...",
            "nextDialogs": [
              "10280427"
            ]
          },
          "10280427": {
            "id": "10280427",
            "speakerId": 12544,
            "speakerName": "Ushi",
            "text": "Moo... Moo, moo... Moo!",
            "nextDialogs": [
              "10280428"
            ]
          },
          "10280428": {
            "id": "10280428",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Huh? What's that... Really!? Aw, no way!",
            "nextDialogs": [
              "10280429"
            ]
          },
          "10280429": {
            "id": "10280429",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's wrong?",
            "nextDialogs": [
              "10280430"
            ]
          },
          "10280430": {
            "id": "10280430",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Ushi says he's searched everywhere but there's no exit.",
            "nextDialogs": [
              "10280431"
            ]
          },
          "10280431": {
            "id": "10280431",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "That doesn't add up, if we were able to come in, then there must be a way to get out. Here, lemme take another look.",
            "nextDialogs": [
              "10280432"
            ]
          },
          "10280432": {
            "id": "10280432",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Has anyone else noticed this? We initially thought we fell here from above. At that time, there was a way out high overhead... But now, it seems even that exit has disappeared.",
            "nextDialogs": [
              "10280433"
            ]
          },
          "10280433": {
            "id": "10280433",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Inexplicable, if you ask me...",
            "nextDialogs": [
              "10280434"
            ]
          },
          "10280434": {
            "id": "10280434",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "It seems there's more than meets the eye with these underground structures.",
            "nextDialogs": [
              "10280435"
            ]
          },
          "10280435": {
            "id": "10280435",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "...I'm gonna take another look around.",
            "nextDialogs": [
              "10280436"
            ]
          },
          "10280436": {
            "id": "10280436",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Everywhere we look there are just more and more rocks. Uh, maybe we've just misremembered, maybe this isn't the place we started from!",
            "nextDialogs": [
              "10280437"
            ]
          },
          "10280437": {
            "id": "10280437",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "What, you scared now?",
            "nextDialogs": [
              "10280438"
            ]
          },
          "10280438": {
            "id": "10280438",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "N—No, Paimon's super brave...!",
            "nextDialogs": [
              "10280439"
            ]
          },
          "10280439": {
            "id": "10280439",
            "speakerId": 12544,
            "speakerName": "Ushi",
            "text": "Moo...",
            "nextDialogs": [
              "10280440"
            ]
          },
          "10280440": {
            "id": "10280440",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Oh yeah? Well Ushi also thinks you're scared. It's okay, don't be scared to admit you're uh... scared. You've got us here to protect you.",
            "nextDialogs": [
              "10280441"
            ]
          },
          "10280441": {
            "id": "10280441",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm here for you too, Paimon.",
            "nextDialogs": [
              "10280442"
            ]
          },
          "10280442": {
            "id": "10280442",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "#We can't just sit here twiddling our thumbs, let's keep looking for a way out. Shinobu, you stay here with my precious savior, I'll take {NICKNAME} and Paimon with me.",
            "nextDialogs": [
              "10280443"
            ]
          },
          "10280443": {
            "id": "10280443",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Got it. Be careful, everyone.",
            "nextDialogs": [
              "10280444"
            ]
          },
          "10280444": {
            "id": "10280444",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Please, there's no need to keep calling me \"savior,\" just Yanfei is fine. Mr. Arataki, it seems that as the head of the Arataki Gang, you possess a strong sense of leadership.",
            "nextDialogs": [
              "10280445"
            ]
          },
          "10280445": {
            "id": "10280445",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Too kind, too kind. And just call me Itto. Since we're a team now, we should have each other's backs. Paimon, if you feel scared again, I can cover your eyes for you.",
            "nextDialogs": [
              "10280446"
            ]
          },
          "10280446": {
            "id": "10280446",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "You split into teams to investigate the surroundings, but fail to find anything...",
            "nextDialogs": [
              "10280447"
            ]
          },
          "10280447": {
            "id": "10280447",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "...*sigh*",
            "nextDialogs": [
              "10280448"
            ]
          },
          "10280448": {
            "id": "10280448",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems there's really no way out...",
            "nextDialogs": [
              "10280449"
            ]
          },
          "10280449": {
            "id": "10280449",
            "speakerId": 12544,
            "speakerName": "Ushi",
            "text": "Moo!",
            "nextDialogs": [
              "10280450"
            ]
          },
          "10280450": {
            "id": "10280450",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "I can't shake the feeling that there's something off about this place.",
            "nextDialogs": [
              "10280451"
            ]
          },
          "10280451": {
            "id": "10280451",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Boss, did you guys find anything over there?",
            "nextDialogs": [
              "10280452"
            ]
          },
          "10280452": {
            "id": "10280452",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No, nothing.",
            "nextDialogs": [
              "10280453"
            ]
          },
          "10280453": {
            "id": "10280453",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Not only that, I coulda sworn I saw some shadows moving a second ago... This place better not be haunted.",
            "nextDialogs": [
              "10280454"
            ]
          },
          "10280454": {
            "id": "10280454",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Probably not the right time to ask this, but Paimon just can't help it. Itto, you're an oni... Doesn't that kinda mean everywhere you go is haunted?",
            "nextDialogs": [
              "10280455"
            ]
          },
          "10280455": {
            "id": "10280455",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "No! ...Ignore the red horns, okay? I'm talking about spooky, floaty ghosts, now-you-see-'em, now-you-don't kinda haunted.",
            "nextDialogs": [
              "10280456"
            ]
          },
          "10280456": {
            "id": "10280456",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, Itto? Are you... afraid of ghosts?",
            "nextDialogs": [
              "10280457"
            ]
          },
          "10280457": {
            "id": "10280457",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Oh no, Boss. You've been found out.",
            "nextDialogs": [
              "10280458"
            ]
          },
          "10280458": {
            "id": "10280458",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "What, me? Hah, no way! You kidding? Stop joking around... seriously though.",
            "nextDialogs": [
              "10280459"
            ]
          },
          "10280459": {
            "id": "10280459",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, looking at you, Paimon suddenly doesn't feel scared anymore... Hey, Bull-Chucker, if you're scared, Paimon can cover your eyes for you.",
            "nextDialogs": [
              "10280460"
            ]
          },
          "10280460": {
            "id": "10280460",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "...",
            "nextDialogs": [
              "10280461"
            ]
          },
          "10280461": {
            "id": "10280461",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Maybe I should make better use of my time.",
            "nextDialogs": [
              "10280462"
            ]
          },
          "10280462": {
            "id": "10280462",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Hmm? Shinobu walked off to grab a few stones, then she took out some twigs and Lavender Melons from her pocket... What?)",
            "nextDialogs": [
              "10280463"
            ]
          },
          "10280463": {
            "id": "10280463",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Add a little salt... and some pepper.",
            "nextDialogs": [
              "10280464"
            ]
          },
          "10280464": {
            "id": "10280464",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you roasting Lavender Melons?",
            "nextDialogs": [
              "10280465"
            ]
          },
          "10280465": {
            "id": "10280465",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Yeah. Roasted Lavender Melon is delicious. You can try some when it's done.",
            "nextDialogs": [
              "10280466"
            ]
          },
          "10280466": {
            "id": "10280466",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Okay.",
            "nextDialogs": [
              "10280467"
            ]
          },
          "10280467": {
            "id": "10280467",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Oh right, there are two types: sweet and savory. Which would you prefer?",
            "nextDialogs": [
              "10280468"
            ]
          },
          "10280468": {
            "id": "10280468",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm happy with either.",
            "nextDialogs": [
              "10280469"
            ]
          },
          "10280469": {
            "id": "10280469",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Alright, you can try them both then. It's important that we remain calm, especially when we are in the throes of a tough situation like this.",
            "nextDialogs": [
              "10280470"
            ]
          },
          "10280470": {
            "id": "10280470",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "If I'm reading the situation correctly, there seems to be some secret here that the boss and I are not supposed to know about. But don't worry, I'll distract the boss while you discuss things with the others.",
            "nextDialogs": [
              "10280471"
            ]
          },
          "10280471": {
            "id": "10280471",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Ooh, I thought I smelled something cooking.",
            "nextDialogs": [
              "10280472"
            ]
          },
          "10280472": {
            "id": "10280472",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Would you like some, Yanfei?",
            "nextDialogs": [
              "10280473"
            ]
          },
          "10280473": {
            "id": "10280473",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Thank you, but I'm not hungry. You guys go ahead.",
            "nextDialogs": [
              "10280474"
            ]
          },
          "10280474": {
            "id": "10280474",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Oh, and by the way, I haven't seen you in a while, Shinobu.",
            "nextDialogs": [
              "10280475"
            ]
          },
          "10280475": {
            "id": "10280475",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Yeah, it has been a while, hasn't it? The last time I saw you was when you taught one of my classes as a substitute while I was studying in Liyue.",
            "nextDialogs": [
              "10280476"
            ]
          },
          "10280476": {
            "id": "10280476",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Substitute teacher... Ah yes, now I remember. It was during winter, wasn't it?",
            "nextDialogs": [
              "10280477"
            ]
          },
          "10280477": {
            "id": "10280477",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Yes, I remember everyone said your lecture was very interesting. Now that I think about it, I should call you \"Senpai.\"",
            "nextDialogs": [
              "10280478"
            ]
          },
          "10280478": {
            "id": "10280478",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Ooh, I like the sound of that! Hehe!",
            "nextDialogs": [
              "10280479"
            ]
          },
          "10280479": {
            "id": "10280479",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Who would've ever guessed that we'd get caught up in such a dilemma together. It must be fate.",
            "nextDialogs": [
              "10280480"
            ]
          },
          "10280480": {
            "id": "10280480",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So Yanfei gives lectures too? That's incredible.",
            "nextDialogs": [
              "10280481"
            ]
          },
          "10280481": {
            "id": "10280481",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Not only that, she's funny and engaging while she speaks. Needless to say, she is very popular among the students.",
            "nextDialogs": [
              "10280482"
            ]
          },
          "10280482": {
            "id": "10280482",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Haha! Aww, I'm flattered.",
            "nextDialogs": [
              "10280483"
            ]
          },
          "10280483": {
            "id": "10280483",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "I see everyone is still here.",
            "nextDialogs": [
              "10280484"
            ]
          },
          "10280484": {
            "id": "10280484",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Yelan, we split into groups and searched the area, but there are no signs of any way out. How about you? Did you manage to find anything?",
            "nextDialogs": [
              "10280485"
            ]
          },
          "10280485": {
            "id": "10280485",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "No.",
            "nextDialogs": [
              "10280486"
            ]
          },
          "10280486": {
            "id": "10280486",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "And... though I'd prefer not to say it, we'd better mentally prepare ourselves.",
            "nextDialogs": [
              "10280487"
            ]
          },
          "10280487": {
            "id": "10280487",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "If we can't find a way out, we may be stuck underground for some time.",
            "nextDialogs": [
              "10280488"
            ]
          },
          "10280488": {
            "id": "10280488",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "...I think you might be right.",
            "nextDialogs": [
              "10280489"
            ]
          },
          "10280489": {
            "id": "10280489",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "...I understand.",
            "nextDialogs": [
              "10280490"
            ]
          },
          "10280490": {
            "id": "10280490",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "Hmm, an underground space with an entrance but no exit... it just doesn't make any sense. I'll figure something out, just give me some time.",
            "nextDialogs": [
              "10280491"
            ]
          },
          "10280491": {
            "id": "10280491",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "If anyone happens to find a potential exit, please be sure to take every precaution before exploring further.",
            "nextDialogs": [
              "10280492"
            ]
          },
          "10280492": {
            "id": "10280492",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Come to think of it, Xiao is here, too. He said we can always call his name if we get into trouble.)",
            "nextDialogs": [
              "10280493"
            ]
          },
          "10280493": {
            "id": "10280493",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Maybe it's worth a try...)",
            "nextDialogs": [
              "10280494"
            ]
          },
          "10280494": {
            "id": "10280494",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, Traveler? What's with the serious face? Do you have a plan?",
            "nextDialogs": [
              "10280495"
            ]
          },
          "10280495": {
            "id": "10280495",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, I was just thinking that Xiao is also here, remember?",
            "nextDialogs": [
              "10280496"
            ]
          },
          "10280496": {
            "id": "10280496",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Xiao... oh, right! Do you want to get him to help us?",
            "nextDialogs": [
              "10280497"
            ]
          },
          "10280497": {
            "id": "10280497",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I think it's worth a try.",
            "nextDialogs": [
              "10280498"
            ]
          },
          "10280498": {
            "id": "10280498",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sure, let's give it a shot!",
            "nextDialogs": [
              "10280499"
            ]
          },
          "10280499": {
            "id": "10280499",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "10280500"
            ]
          },
          "10280500": {
            "id": "10280500",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Xiao, can you hear me?",
            "nextDialogs": [
              "10280501"
            ]
          },
          "10280501": {
            "id": "10280501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "10280502"
            ]
          },
          "10280502": {
            "id": "10280502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "10280503"
            ]
          },
          "10280503": {
            "id": "10280503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh, Xiao?",
            "nextDialogs": [
              "10280504"
            ]
          },
          "10280504": {
            "id": "10280504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, no response... Paimon thought Xiao would come no matter where we are.",
            "nextDialogs": [
              "10280505"
            ]
          },
          "10280505": {
            "id": "10280505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no, does that mean even Xiao can't sense our presence here?",
            "nextDialogs": [
              "10280506"
            ]
          },
          "10280506": {
            "id": "10280506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(...)",
            "nextDialogs": [
              "10280507"
            ]
          },
          "10280507": {
            "id": "10280507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Wonder what that could mean... What's the deal with this place?)"
          }
        }
      }
    },
    {
      "subId": "102805",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10280601"
        ],
        "dialogs": {
          "10280601": {
            "id": "10280601",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Who could've ever guessed we'd get trapped in a place like this. It's quite the predicament...",
            "nextDialogs": [
              "10280602"
            ]
          },
          "10280602": {
            "id": "10280602",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "For all the studying I've done in my life, all I know is how to land people in prison... I don't know the first thing about breaking out of one...",
            "nextDialogs": [
              "10280603"
            ]
          },
          "10280603": {
            "id": "10280603",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "I've even made a contract with my father to \"live a happy life\"... I can't give up hope now.",
            "nextDialogs": [
              "10280604"
            ]
          },
          "10280604": {
            "id": "10280604",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Try and stay positive... At least I've explored a new place and seen more of the world while reuniting with some old friends.",
            "nextDialogs": [
              "10280605"
            ]
          },
          "10280605": {
            "id": "10280605",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Uh-huh... Yeah, there's still a silver lining. I guess..."
          }
        }
      }
    },
    {
      "subId": "102802",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10280701"
        ],
        "dialogs": {
          "10280701": {
            "id": "10280701",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "Our situation is grim. There doesn't appear to be a way out for now. We should be prepared to stay for a while.",
            "nextDialogs": [
              "10280702"
            ]
          },
          "10280702": {
            "id": "10280702",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "Fortunately, we don't seem to lack supplies, and even our motley crew has people who can keep their cool when the stakes are high.",
            "nextDialogs": [
              "10280703"
            ]
          },
          "10280703": {
            "id": "10280703",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "Just focus on taking care of yourselves, I'll figure out the rest."
          }
        }
      }
    },
    {
      "subId": "102806",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    }
  ]
}
        "dialogs": {
          "700800101": {
            "id": "700800101",
            "speakerId": 1000,
            "speakerName": "Venipi",
            "text": "Having stood upon the line between life and death, I miss the flavor of beer most. Even my master and King Deshret himself would rank beneath it.",
            "nextDialogs": [
              "700800102"
            ]
          },
          "700800102": {
            "id": "700800102",
            "speakerId": 1001,
            "speakerName": "Kshama",
            "text": "Ah. I didn't know you so enjoyed your libations.",
            "nextDialogs": [
              "700800103"
            ]
          },
          "700800103": {
            "id": "700800103",
            "speakerId": 1000,
            "speakerName": "Venipi",
            "text": "When delivering bricks to the Mausoleum of King Deshret back in the day, we'd get two large mugs of beer for free every day.",
            "nextDialogs": [
              "700800104"
            ]
          },
          "700800104": {
            "id": "700800104",
            "speakerId": 1000,
            "speakerName": "Venipi",
            "text": "Speaking of which, was Maukie among those who were restored?",
            "nextDialogs": [
              "700800105"
            ]
          },
          "700800105": {
            "id": "700800105",
            "speakerId": 1002,
            "speakerName": "Vitruvius",
            "text": "No. I suspect the higher-ups intend to deal with him... in violation of the rules.",
            "nextDialogs": [
              "700800106"
            ]
          },
          "700800106": {
            "id": "700800106",
            "speakerId": 1002,
            "speakerName": "Vitruvius",
            "text": "I wonder if the note I asked him to bring in secret came in handy."
          }
        }
      }
    }
  ]

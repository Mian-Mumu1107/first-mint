            "nextDialogs": [
              "721402403"
            ]
          },
          "721402403": {
            "id": "721402403",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Well... Okay...",
            "nextDialogs": [
              "721402404"
            ]
          },
          "721402404": {
            "id": "721402404",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "I'll read it.",
            "nextDialogs": [
              "721402405"
            ]
          },
          "721402405": {
            "id": "721402405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You might find her selfish...",
            "nextDialogs": [
              "721402406"
            ]
          },
          "721402406": {
            "id": "721402406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But please don't blame her.",
            "nextDialogs": [
              "721402407"
            ]
          },
          "721402407": {
            "id": "721402407",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "...I understand.",
            "nextDialogs": [
              "721402408"
            ]
          },
          "721402408": {
            "id": "721402408",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "But I'll keep looking for her. Only when I find her can any of these things have meaning.",
            "nextDialogs": [
              "721402409"
            ]
          },
          "721402409": {
            "id": "721402409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This child... is so stubborn."
          }
        }
      }
    },
    {
      "subId": "7219718",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721971801"
        ],
        "dialogs": {
          "721971801": {
            "id": "721971801",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "#{NICKNAME}, you're back. Did you bring any crystals?",
            "nextDialogs": [
              "721971804"
            ]
          },
          "721971804": {
            "id": "721971804",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Take your time. You can take a rest here too if you like."
          }
        }
      }
    },
    {
      "subId": "7219722",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721972201"
        ],
        "dialogs": {
          "721972201": {
            "id": "721972201",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Anyway. Thank you for your help! See you around!"
          }
        }
      }
    },
    {
      "subId": "7219725",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721972501"
        ],
        "dialogs": {
          "721972501": {
            "id": "721972501",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Anyway. Thank you for your help! See you around!",
            "nextDialogs": [
              "721972502"
            ]
          },
          "721972502": {
            "id": "721972502",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "#Well, I don't know when I'll see you again next. I hope you'll still remember me by then, {NICKNAME}!"
          }
        }
      }
    }

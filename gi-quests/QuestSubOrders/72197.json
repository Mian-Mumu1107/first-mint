  },
  "subQuests": [
    {
      "subId": "7219723",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721972301"
        ],
        "dialogs": {
          "721972301": {
            "id": "721972301",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "#Hey there, {NICKNAME}, I didn't expect I'd see you again!",
            "nextDialogs": [
              "721972302"
            ]
          },
          "721972302": {
            "id": "721972302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Long time no see! How's the world outside of Yashiori Island?",
            "nextDialogs": [
              "721972303"
            ]
          },
          "721972303": {
            "id": "721972303",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "It's a lot wealthier than my hometown. They have a lot of good food and fun things to do. But... I can't say that I really like it.",
            "nextDialogs": [
              "721972304"
            ]
          },
          "721972304": {
            "id": "721972304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh? Why's that?",
            "nextDialogs": [
              "721972305"
            ]
          },
          "721972305": {
            "id": "721972305",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "The people here all seem to be missing something...",
            "nextDialogs": [
              "721972306"
            ]
          },
          "721972306": {
            "id": "721972306",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "When we used to live in Yashiori Island, Her Excellency was a distant yet calming presence to us... We didn't care where she was, but we believed that she was right there, watching us, protecting us, deciding how we should live our lives and what kind of people we should become...",
            "nextDialogs": [
              "721972307"
            ]
          },
          "721972307": {
            "id": "721972307",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "But here, Her Excellency covers everything and oppresses everything...",
            "nextDialogs": [
              "721972308"
            ]
          },
          "721972308": {
            "id": "721972308",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "*sigh* I'm not really sure how to put it...",
            "nextDialogs": [
              "721972309"
            ]
          },
          "721972309": {
            "id": "721972309",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "By the way, have you found anything concerning my mother?",
            "nextDialogs": [
              "721972310"
            ]
          },
          "721972310": {
            "id": "721972310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're still trying.",
            "nextDialogs": [
              "721972311"
            ]
          },
          "721972311": {
            "id": "721972311",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "It's okay. Tell me when you have any news."
          }
        }
      }
    },
    {
      "subId": "7219722",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721971701"
        ],
        "dialogs": {
          "721971701": {
            "id": "721971701",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "#Hello, {NICKNAME}! How've you been?",
            "nextDialogs": [
              "721971702"
            ]
          },
          "721971702": {
            "id": "721971702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's been great, and you?",
            "nextDialogs": [
              "721971703"
            ]
          },
          "721971703": {
            "id": "721971703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You stole my line!",
            "nextDialogs": [
              "721971704"
            ]
          },
          "721971704": {
            "id": "721971704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Haha, that's 'cause you're too slow!",
            "nextDialogs": [
              "721971705"
            ]
          },
          "721971705": {
            "id": "721971705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon, gunning for an extra meal, are you?",
            "nextDialogs": [
              "721971706"
            ]
          },
          "721971706": {
            "id": "721971706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Of course. Paimon could always go for an extra meal!",
            "nextDialogs": [
              "721971707"
            ]
          },
          "721971707": {
            "id": "721971707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You misunderstand. I mean you're the extra meal.",
            "nextDialogs": [
              "721971708"
            ]
          },
          "721971708": {
            "id": "721971708",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey now!",
            "nextDialogs": [
              "721971709"
            ]
          },
          "721971709": {
            "id": "721971709",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Poof... Hahaha!",
            "nextDialogs": [
              "721971710"
            ]
          },
          "721971710": {
            "id": "721971710",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "All right, all right, you guys, please stop fighting.",
            "nextDialogs": [
              "721971711"
            ]
          },
          "721971711": {
            "id": "721971711",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "I'm doing fine. But I'd like to ask you for another favor.",
            "nextDialogs": [
              "721971714"
            ]
          },
          "721971714": {
            "id": "721971714",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "#Well, it's nothing special. I just need you to help me get some more crystals, {NICKNAME}.",
            "nextDialogs": [
              "721971715"
            ]
          },
          "721971715": {
            "id": "721971715",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Believe me, I'll reward you for your help... As long as you trust me.",
            "nextDialogs": [
              "721971716"
            ]
          },
          "721971716": {
            "id": "721971716",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I trust you, but...",
            "nextDialogs": [
              "721971717"
            ]
          },
          "721971717": {
            "id": "721971717",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "But...?"
          }
        }
      }
    },
    {
      "subId": "7219712",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721971201"
        ],
        "dialogs": {
          "721971201": {
            "id": "721971201",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Are you done? Let's have a try!",
            "nextDialogs": [
              "721971202"
            ]
          },
          "721971202": {
            "id": "721971202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(I think this'll do.)",
            "nextDialogs": [
              "721971203"
            ]
          },
          "721971203": {
            "id": "721971203",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Uh... Ahaha, I've got to say that I've never tasted such... outlandish flavors in my life.",
            "nextDialogs": [
              "721971204"
            ]
          },
          "721971204": {
            "id": "721971204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Outlandish flavors? More like Abyssal ones!",
            "nextDialogs": [
              "721971205"
            ]
          },
          "721971205": {
            "id": "721971205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Come on, Chouji, don't force yourself! You're still a kid. You don't have to eat this stuff...",
            "nextDialogs": [
              "721971206"
            ]
          },
          "721971206": {
            "id": "721971206",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Hmmm... You don't seem to have had that much experience in the kitchen, but the food's still really good. Thank you!",
            "nextDialogs": [
              "721971207"
            ]
          },
          "721971207": {
            "id": "721971207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hmph, {NICKNAME}'s culinary skill needs no praise! Hey, save some for Paimon!",
            "nextDialogs": [
              "721971208"
            ]
          },
          "721971208": {
            "id": "721971208",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "#Mm~mm! That's yummy! {NICKNAME}, you have the potential to become a famous chef!",
            "nextDialogs": [
              "721971209"
            ]
          },
          "721971209": {
            "id": "721971209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Wow, it smells good! You know what, {NICKNAME}, why don't we just open a gourmet kiosk here?",
            "nextDialogs": [
              "721971210"
            ]
          },
          "721971210": {
            "id": "721971210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's being serious!"
          }
        }
      }
    },
    {
      "subId": "7219721",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721971901"
        ],
        "dialogs": {
          "721971901": {
            "id": "721971901",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "These crystals should be enough. Well then, I'm going to start my adventure now!",
            "nextDialogs": [
              "721971902"
            ]
          },
          "721971902": {
            "id": "721971902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's still worried about this kid...",
            "nextDialogs": [
              "721971905"
            ]
          },
          "721971905": {
            "id": "721971905",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Yeah!",
            "nextDialogs": [
              "721971906"
            ]
          },
          "721971906": {
            "id": "721971906",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, Chouji, you'd better stop running your mouth! You should feel lucky that you met us... otherwise, you'd get beaten up!",
            "nextDialogs": [
              "721971907"
            ]
          },
          "721971907": {
            "id": "721971907",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Also, in case any bad guys want to fish for any information from you, be sure not to tell them the truth! Make up a story!",
            "nextDialogs": [
              "721971908"
            ]
          },
          "721971908": {
            "id": "721971908",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And also...",
            "nextDialogs": [
              "721971909"
            ]
          },
          "721971909": {
            "id": "721971909",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon's turning into a naggy old granny.",
            "nextDialogs": [
              "721971910"
            ]
          },
          "721971910": {
            "id": "721971910",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyone would be worried if a little kid like him went out on an adventure all by himself!",
            "nextDialogs": [
              "721971911"
            ]
          },
          "721971911": {
            "id": "721971911",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I have faith in him.",
            "nextDialogs": [
              "721971912"
            ]
          },
          "721971912": {
            "id": "721971912",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Hmph, sure you do.",
            "nextDialogs": [
              "721971913"
            ]
          },
          "721971913": {
            "id": "721971913",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Hahahaha! Thank you, thank you both!",
            "nextDialogs": [
              "721971914"
            ]
          },
          "721971914": {
            "id": "721971914",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "I hope we'll meet again.",
            "nextDialogs": [
              "721971915"
            ]
          },
          "721971915": {
            "id": "721971915",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Promise Paimon that you'll stay safe...",
            "nextDialogs": [
              "721971916"
            ]
          },
          "721971916": {
            "id": "721971916",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "I'll be fine!",
            "nextDialogs": [
              "721971917"
            ]
          },
          "721971917": {
            "id": "721971917",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Next, I'll head to Tatarasuna, where Mom used to work. Maybe someone can tell me if she's been there.",
            "nextDialogs": [
              "721971918"
            ]
          },
          "721971918": {
            "id": "721971918",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "And then... I'll try to go to Narukami Island and travel to Snezhnaya via merchant ship. After that, I'll just see how things go.",
            "nextDialogs": [
              "721971919"
            ]
          },
          "721971919": {
            "id": "721971919",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "..."
          }
        }
      }
    },
    {
      "subId": "7219713",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721971301"
        ],
        "dialogs": {
          "721971301": {
            "id": "721971301",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Thank you. I haven't had this dish for a long time. My mom used to cook this for me. It was so delicious... no one could make it as well as her.",
            "nextDialogs": [
              "721971302"
            ]
          },
          "721971302": {
            "id": "721971302",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Well, now I wish I wasn't stuck eating lavender melon every day. I wish I could eat poultry dishes every day.",
            "nextDialogs": [
              "721971303"
            ]
          },
          "721971303": {
            "id": "721971303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon too!"
          }
        }
      }
    },
    {
      "subId": "7219714",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721972001"
        ],
        "dialogs": {
          "721972001": {
            "id": "721972001",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Hello, we meet again!",
            "nextDialogs": [
              "721972002"
            ]
          },
          "721972002": {
            "id": "721972002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait a minute. Let Paimon guess what you're about to say...",
            "nextDialogs": [
              "721972003"
            ]
          },
          "721972003": {
            "id": "721972003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Please get me more crystals...\"",
            "nextDialogs": [
              "721972004"
            ]
          },
          "721972004": {
            "id": "721972004",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Paimon needs them urgently, boo hoo...\"",
            "nextDialogs": [
              "721972005"
            ]
          },
          "721972005": {
            "id": "721972005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's what you are going to say, right!",
            "nextDialogs": [
              "721972006"
            ]
          },
          "721972006": {
            "id": "721972006",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Hahaha, of course not!",
            "nextDialogs": [
              "721972007"
            ]
          },
          "721972007": {
            "id": "721972007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How have your travels been going?",
            "nextDialogs": [
              "721972008"
            ]
          },
          "721972008": {
            "id": "721972008",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Good. But I still haven't found any trace of my Mom...",
            "nextDialogs": [
              "721972009"
            ]
          },
          "721972009": {
            "id": "721972009",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#It doesn't matter. We'll help you, too, right, {NICKNAME}？",
            "nextDialogs": [
              "721972010"
            ]
          },
          "721972010": {
            "id": "721972010",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll do our best.",
            "nextDialogs": [
              "721972011"
            ]
          },
          "721972011": {
            "id": "721972011",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "#Mm! I knew I could rely on you, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "7214017",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721401701"
        ],
        "dialogs": {
          "721401701": {
            "id": "721401701",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "#Hello, {NICKNAME}! How've you been?",
            "nextDialogs": [
              "721401702"
            ]
          },
          "721401702": {
            "id": "721401702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's been great, and you?",
            "nextDialogs": [
              "721401703"
            ]
          },
          "721401703": {
            "id": "721401703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You stole my line!",
            "nextDialogs": [
              "721401704"
            ]
          },
          "721401704": {
            "id": "721401704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Haha, that's 'cause you're too slow!",
            "nextDialogs": [
              "721401705"
            ]
          },
          "721401705": {
            "id": "721401705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon, gunning for an extra meal, are you?",
            "nextDialogs": [
              "721401706"
            ]
          },
          "721401706": {
            "id": "721401706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Of course. Paimon could always go for an extra meal!",
            "nextDialogs": [
              "721401707"
            ]
          },
          "721401707": {
            "id": "721401707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You misunderstand. I mean you're the extra meal.",
            "nextDialogs": [
              "721401708"
            ]
          },
          "721401708": {
            "id": "721401708",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey now!",
            "nextDialogs": [
              "721401709"
            ]
          },
          "721401709": {
            "id": "721401709",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Pfft... Hahaha!",
            "nextDialogs": [
              "721401710"
            ]
          },
          "721401710": {
            "id": "721401710",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "All right, all right, you guys, please stop fighting.",
            "nextDialogs": [
              "721401711"
            ]
          },
          "721401711": {
            "id": "721401711",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "I'm doing fine. But I'd like to ask you for another favor.",
            "nextDialogs": [
              "721401714"
            ]
          },
          "721401714": {
            "id": "721401714",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "#Well, it's nothing special. I just need you to help me get some more crystals, {NICKNAME}.",
            "nextDialogs": [
              "721401715"
            ]
          },
          "721401715": {
            "id": "721401715",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Believe me, I'll reward you for your help... As long as you trust me.",
            "nextDialogs": [
              "721401716"
            ]
          },
          "721401716": {
            "id": "721401716",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I trust you, but...",
            "nextDialogs": [
              "721401717"
            ]
          },
          "721401717": {
            "id": "721401717",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "But...?"
          }
        }
      }
    },
    {
      "subId": "7214019",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721401901"
        ],
        "dialogs": {
          "721401901": {
            "id": "721401901",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "This should be enough Crystal Marrow. Now it's time to start my adventure!",
            "nextDialogs": [
              "721401902"
            ]
          },
          "721401902": {
            "id": "721401902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's still worried about this kid...",
            "nextDialogs": [
              "721401905"
            ]
          },
          "721401905": {
            "id": "721401905",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Yeah!",
            "nextDialogs": [
              "721401906"
            ]
          },
          "721401906": {
            "id": "721401906",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, Chouji, you'd better stop running your mouth! You should feel lucky that you met us... otherwise, you'd get beaten up!",
            "nextDialogs": [
              "721401907"
            ]
          },
          "721401907": {
            "id": "721401907",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Also, in case any bad guys want to fish for any information from you, be sure not to tell them the truth! Make up a story!",
            "nextDialogs": [
              "721401908"
            ]
          },
          "721401908": {
            "id": "721401908",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And also...",
            "nextDialogs": [
              "721401909"
            ]
          },
          "721401909": {
            "id": "721401909",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon's turning into a naggy old granny.",
            "nextDialogs": [
              "721401910"
            ]
          },
          "721401910": {
            "id": "721401910",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyone would be worried if a little kid like him went out on an adventure all by himself!",
            "nextDialogs": [
              "721401911"
            ]
          },
          "721401911": {
            "id": "721401911",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I have faith in him.",
            "nextDialogs": [
              "721401912"
            ]
          },
          "721401912": {
            "id": "721401912",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Hmph, sure you do.",
            "nextDialogs": [
              "721401913"
            ]
          },
          "721401913": {
            "id": "721401913",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Hahahaha! Thank you, thank you both!",
            "nextDialogs": [
              "721401914"
            ]
          },
          "721401914": {
            "id": "721401914",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "I hope we'll meet again.",
            "nextDialogs": [
              "721401915"
            ]
          },
          "721401915": {
            "id": "721401915",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Promise Paimon that you'll stay safe...",
            "nextDialogs": [
              "721401916"
            ]
          },
          "721401916": {
            "id": "721401916",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "I'll be fine!",
            "nextDialogs": [
              "721401917"
            ]
          },
          "721401917": {
            "id": "721401917",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Next, I'll head to Tatarasuna, where Mom used to work. Maybe someone can tell me if she's been there.",
            "nextDialogs": [
              "721401918"
            ]
          },
          "721401918": {
            "id": "721401918",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "And then... I'll try to go to Narukami Island and travel to Snezhnaya via merchant ship. After that, I'll just see how things go.",
            "nextDialogs": [
              "721401919"
            ]
          },
          "721401919": {
            "id": "721401919",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "..."
          }
        }
      }
    },
    {
      "subId": "7214020",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721402001"
        ],
        "dialogs": {
          "721402001": {
            "id": "721402001",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Hello, we meet again!",
            "nextDialogs": [
              "721402002"
            ]
          },
          "721402002": {
            "id": "721402002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait a minute. Let Paimon guess what you're about to say...",
            "nextDialogs": [
              "721402003"
            ]
          },
          "721402003": {
            "id": "721402003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Please get me more Crystal Marrow...\"",
            "nextDialogs": [
              "721402004"
            ]
          },
          "721402004": {
            "id": "721402004",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Paimon needs them urgently, boo hoo...\"",
            "nextDialogs": [
              "721402005"
            ]
          },
          "721402005": {
            "id": "721402005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's what you are going to say, right!",
            "nextDialogs": [
              "721402006"
            ]
          },
          "721402006": {
            "id": "721402006",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Hahaha, of course not!",
            "nextDialogs": [
              "721402007"
            ]
          },
          "721402007": {
            "id": "721402007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How have your travels been going?",
            "nextDialogs": [
              "721402008"
            ]
          },
          "721402008": {
            "id": "721402008",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Good. But I still haven't found any trace of my Mom...",
            "nextDialogs": [
              "721402009"
            ]
          },
          "721402009": {
            "id": "721402009",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#It doesn't matter. We'll help you, too, right, {NICKNAME}?",
            "nextDialogs": [
              "721402010"
            ]
          },
          "721402010": {
            "id": "721402010",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll do our best.",
            "nextDialogs": [
              "721402011"
            ]
          },
          "721402011": {
            "id": "721402011",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "#Mm! I knew I could rely on you, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "7214021",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721402102"
        ],
        "dialogs": {
          "721402102": {
            "id": "721402102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Read it yourself...",
            "nextDialogs": [
              "721402103"
            ]
          },
          "721402103": {
            "id": "721402103",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "Well... Okay...",
            "nextDialogs": [
              "721402104"
            ]
          },
          "721402104": {
            "id": "721402104",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "I'll read it.",
            "nextDialogs": [
              "721402105"
            ]
          },
          "721402105": {
            "id": "721402105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You might find her selfish...",
            "nextDialogs": [
              "721402106"
            ]
          },
          "721402106": {
            "id": "721402106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But please don't blame her.",
            "nextDialogs": [
              "721402107"
            ]
          },
          "721402107": {
            "id": "721402107",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "...I understand.",
            "nextDialogs": [
              "721402108"
            ]
          },
          "721402108": {
            "id": "721402108",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "But I'll keep looking for her. Only when I find her can any of these things have meaning.",
            "nextDialogs": [
              "721402109"
            ]
          },
          "721402109": {
            "id": "721402109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This child... is so stubborn."
          }
        }
      }
    },
    {
      "subId": "7214023",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721402301"
        ],
        "dialogs": {
          "721402301": {
            "id": "721402301",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "#Hey there, {NICKNAME}, I didn't expect I'd see you again!",
            "nextDialogs": [
              "721402302"
            ]
          },
          "721402302": {
            "id": "721402302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Long time no see! How's the world outside of Yashiori Island?",
            "nextDialogs": [
              "721402303"
            ]
          },
          "721402303": {
            "id": "721402303",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "It's a lot wealthier than my hometown. They have a lot of good food and fun things to do. But... I can't say that I really like it.",
            "nextDialogs": [
              "721402304"
            ]
          },
          "721402304": {
            "id": "721402304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh? Why's that?",
            "nextDialogs": [
              "721402305"
            ]
          },
          "721402305": {
            "id": "721402305",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "The people here all seem to be missing something...",
            "nextDialogs": [
              "721402306"
            ]
          },
          "721402306": {
            "id": "721402306",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "When we used to live in Yashiori Island, Her Excellency was a distant yet calming presence to us... We didn't care where she was, but we believed that she was right there, watching us, protecting us, deciding how we should live our lives and what kind of people we should become...",
            "nextDialogs": [
              "721402307"
            ]
          },
          "721402307": {
            "id": "721402307",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "But here, Her Excellency covers everything and oppresses everything...",
            "nextDialogs": [
              "721402308"
            ]
          },
          "721402308": {
            "id": "721402308",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "*sigh* I'm not really sure how to put it...",
            "nextDialogs": [
              "721402309"
            ]
          },
          "721402309": {
            "id": "721402309",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "By the way, have you found anything concerning my mother?",
            "nextDialogs": [
              "721402310"
            ]
          },
          "721402310": {
            "id": "721402310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're still trying.",
            "nextDialogs": [
              "721402311"
            ]
          },
          "721402311": {
            "id": "721402311",
            "speakerId": 20240,
            "speakerName": "Chouji",
            "text": "It's okay. Tell me when you have any news."
          }
        }
      }
    },

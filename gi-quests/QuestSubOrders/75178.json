  "subQuests": [
    {
      "subId": "7517801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751780101"
        ],
        "dialogs": {
          "751780101": {
            "id": "751780101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hello there! Um...",
            "nextDialogs": [
              "751780102"
            ]
          },
          "751780102": {
            "id": "751780102",
            "speakerId": 1001,
            "speakerName": "Loshts",
            "text": "#Such overwhelming \"intensity\"! As expected of the legendary {NICKNAME} and Paimon! You've come all this way — don't tell me you're here to compete for the title of the \"strongest in the Collective of Plenty\"?",
            "nextDialogs": [
              "751780103"
            ]
          },
          "751780103": {
            "id": "751780103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "\"Strongest in the Collective of Plenty\"? Isn't this just the regular \"Warrior's Challenge\"? Look, there's a whole line of people waiting over there!",
            "nextDialogs": [
              "751780104"
            ]
          },
          "751780104": {
            "id": "751780104",
            "speakerId": 1001,
            "speakerName": "Loshts",
            "text": "Haha, they're nothing compared to you two. To claim the title of \"strongest,\" you must defeat the current \"strongest.\" Ordinary people don't even qualify for that.",
            "nextDialogs": [
              "751780105"
            ]
          },
          "751780105": {
            "id": "751780105",
            "speakerId": 1001,
            "speakerName": "Loshts",
            "text": "So, it is good that you are here... though your timing is less stellar, I fear. The master presently has no time to deal with worldly affairs, so a face-to-face meeting is not on the cards for now.",
            "nextDialogs": [
              "751780108",
              "751780109"
            ]
          },
          "751780108": {
            "id": "751780108",
            "speakerId": 1001,
            "speakerName": "Loshts",
            "text": "Oh? Are you planning to seek the master out for a battle? A bold move! In that case, I wouldn't mind sharing his whereabouts with you.",
            "nextDialogs": [
              "751780110"
            ]
          },
          "751780110": {
            "id": "751780110",
            "speakerId": 1001,
            "speakerName": "Loshts",
            "text": "Journey along training's rugged path, and you'll come across a mountainous region brimming with the \"Waters of Intensity.\" There, perhaps, you'll find traces of the \"strongest.\""
          },
          "751780109": {
            "id": "751780109",
            "speakerId": 1001,
            "speakerName": "Loshts",
            "text": "Indeed, indeed. \"Intensity\" draws \"intensity,\" and the \"strongest\" will surely cross paths with the \"strongest.\" So yes, waiting is certainly one option."
          }
        }
      }
    },
    {
      "subId": "7517802",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751780201"
        ],
        "dialogs": {
          "751780201": {
            "id": "751780201",
            "speakerId": 1002,
            "speakerName": "Yoleehe",
            "text": "Can someone lend a hand!? Someone just fainted!",
            "nextDialogs": [
              "751780202"
            ]
          },
          "751780202": {
            "id": "751780202",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Oh no, looks like the master's passed out! Let's go help too, {NICKNAME}!",
            "nextDialogs": [
              "751780203"
            ]
          },
          "751780203": {
            "id": "751780203",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "It seems like the master only fainted from the heat and isn't seriously injured. With your help, Yoleehe carries the unconscious master away...\\nLooks like the master's own ability to handle \"intensity\" still has some room for improvement..."
          }
        }
      }
    },
    {
      "subId": "7517811",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751781101"
        ],
        "dialogs": {
          "751781101": {
            "id": "751781101",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr?",
            "nextDialogs": [
              "751781102"
            ]
          },
          "751781102": {
            "id": "751781102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Wait, {REALNAME[ID(2)|SHOWHOST(true)]}, don't go wandering off like that!"
          }
        }
      }
    },
    {
      "subId": "7517803",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751780701"
        ],
        "dialogs": {
          "751780701": {
            "id": "751780701",
            "speakerId": 1005,
            "speakerName": "Ma'chah",
            "text": "So \"cold\"! This is so \"cold\"!",
            "nextDialogs": [
              "751780702"
            ]
          },
          "751780702": {
            "id": "751780702",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Cold? What are you talking about... You're sitting in a hot spring, aren't you?",
            "nextDialogs": [
              "751780703"
            ]
          },
          "751780703": {
            "id": "751780703",
            "speakerId": 1005,
            "speakerName": "Ma'chah",
            "text": "No, no... This still isn't enough! If I'm to become the \"strongest\" — the \"strongest\" in the Collective of Plenty, no, in all Natlan — I can't settle for just this level of cold! The \"intensity\"... it's nowhere near enough!",
            "nextDialogs": [
              "751780704"
            ]
          },
          "751780704": {
            "id": "751780704",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eh...? Why are you sitting back down again?",
            "nextDialogs": [
              "751780706",
              "751780708"
            ]
          },
          "751780706": {
            "id": "751780706",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What even is this \"intensity\" you're talking about? Paimon doesn't understand a word you're saying!",
            "nextDialogs": [
              "751780709"
            ]
          },
          "751780709": {
            "id": "751780709",
            "speakerId": 1002,
            "speakerName": "Yoleehe",
            "text": "#Oh, you must be the famous adventurers {NICKNAME} and Paimon! Wonderful! Now we're saved!",
            "nextDialogs": [
              "751780710"
            ]
          },
          "751780710": {
            "id": "751780710",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wh—What? Saved? What's going on...?",
            "nextDialogs": [
              "751780711"
            ]
          },
          "751780711": {
            "id": "751780711",
            "speakerId": 1002,
            "speakerName": "Yoleehe",
            "text": "Alright, I'll spill the beans. According to the master himself, he's on a journey to become the \"strongest.\" To that end, he's fully immersed himself in some sort of hot spring training!",
            "nextDialogs": [
              "751780712"
            ]
          },
          "751780712": {
            "id": "751780712",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, training? In a hot spring?",
            "nextDialogs": [
              "751780713"
            ]
          },
          "751780713": {
            "id": "751780713",
            "speakerId": 1002,
            "speakerName": "Yoleehe",
            "text": "Yeah... I know it sounds crazy, but he got this idea from some martial arts book titled \"The Book of Five Springs.\"",
            "nextDialogs": [
              "751780714"
            ]
          },
          "751780714": {
            "id": "751780714",
            "speakerId": 1002,
            "speakerName": "Yoleehe",
            "text": "The book says that if you follow its teachings, you can eventually <color=#00E1FFFF>make cold water boil</color> just by using your own \"intensity.\"",
            "nextDialogs": [
              "751780715"
            ]
          },
          "751780715": {
            "id": "751780715",
            "speakerId": 1002,
            "speakerName": "Yoleehe",
            "text": "And that's not even the wildest part! The book's full of insane stories about martial arts legends — like one guy who punched straight through a mountain in one night, and another who could crush rocks into gemstones with his bare hands!",
            "nextDialogs": [
              "751780716"
            ]
          },
          "751780716": {
            "id": "751780716",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Paimon never imagined there could be such incredible martial arts in the world! If you could learn them too, {NICKNAME}..."
          },
          "751780708": {
            "id": "751780708",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon thinks so too. No wonder he's shaking like a leaf!"
          }
        }
      }
    },
    {
      "subId": "7517804",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751780401"
        ],
        "dialogs": {
          "751780401": {
            "id": "751780401",
            "speakerId": 1002,
            "speakerName": "Yoleehe",
            "text": "Could it be... that everything written in \"The Book of Five Springs\" is true...?"
          }
        }
      }
    },
    {
      "subId": "7517814",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751781401"
        ],
        "dialogs": {
          "751781401": {
            "id": "751781401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eh? A little Koholasaurus? Why is it here?",
            "nextDialogs": [
              "751781402"
            ]
          },
          "751781402": {
            "id": "751781402",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "Ki'o-ki'o...! So you were here after all... If you guys hadn't come out when you did, I-I'd have...",
            "nextDialogs": [
              "751781403"
            ]
          },
          "751781403": {
            "id": "751781403",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "What if you'd gotten hurt? Don't just run off like that again, okay? *sniff*...",
            "nextDialogs": [
              "751781404"
            ]
          },
          "751781404": {
            "id": "751781404",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "H—Hey, cheer up! Look, your little saurian's fine, see? Super full of energy, too!",
            "nextDialogs": [
              "751781405"
            ]
          },
          "751781405": {
            "id": "751781405",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr! Rawr!",
            "nextDialogs": [
              "751781406"
            ]
          },
          "751781406": {
            "id": "751781406",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "Ah, um... I'm okay now. Oh! I forgot to introduce myself. I'm Linaha, from the People of the Springs. I'm usually assigned to take care of the little Koholasaurs...",
            "nextDialogs": [
              "751781407"
            ]
          },
          "751781407": {
            "id": "751781407",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Alone? That's pretty impressive!",
            "nextDialogs": [
              "751781408"
            ]
          },
          "751781408": {
            "id": "751781408",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "N—Not really... If I were more like you, Ms. Paimon, they probably wouldn't have run off like that.",
            "nextDialogs": [
              "751781409"
            ]
          },
          "751781409": {
            "id": "751781409",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "I was thinking that they might've all gone to play near the vents, and it turns out I was right...",
            "nextDialogs": [
              "751781410"
            ]
          },
          "751781410": {
            "id": "751781410",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So the hot spring got cold because the little Koholasaurs had the phlogiston vents all blocked up, huh? No wonder the spring caretaker didn't notice anything!",
            "nextDialogs": [
              "751781411"
            ]
          },
          "751781411": {
            "id": "751781411",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "Actually... there are still two more Koholasaurs I haven't found yet. I think they're probably hiding in the phlogiston vents too...",
            "nextDialogs": [
              "751781412"
            ]
          },
          "751781412": {
            "id": "751781412",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Leave this to us! We'll find the other little Koholasaurs while we adjust the water temperature, don't you worry!",
            "nextDialogs": [
              "751781413"
            ]
          },
          "751781413": {
            "id": "751781413",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "Really? Thank you! It's great to have Ms. Paimon around.",
            "nextDialogs": [
              "751781414"
            ]
          },
          "751781414": {
            "id": "751781414",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe, of course! You can always count on a legendary adventurer like the Great Paimon — this is a piece of cake!",
            "nextDialogs": [
              "751781415"
            ]
          },
          "751781415": {
            "id": "751781415",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "Wow! Ms. Paimon, you're amazing! I want to be just like you someday!",
            "nextDialogs": [
              "751781418"
            ]
          },
          "751781418": {
            "id": "751781418",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "(Hey, can you not put Paimon on the spot like that in front of everyone? How about this — Paimon'll let you have the best dish tonight, okay?)",
            "nextDialogs": [
              "751781419"
            ]
          },
          "751781419": {
            "id": "751781419",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ahem! Anyway, let's get going!"
          }
        }
      }
    },
    {
      "subId": "7517805",
      "subQuestName": "Seal the geothermal vent",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751780501"
        ],
        "dialogs": {
          "751780501": {
            "id": "751780501",
            "speakerId": 1001,
            "speakerName": "Loshts",
            "text": "How goes your journey to find the \"strongest,\" oh warrior from faraway lands?",
            "nextDialogs": [
              "751780504",
              "751780505"
            ]
          },
          "751780504": {
            "id": "751780504",
            "speakerId": 1001,
            "speakerName": "Loshts",
            "text": "If you head up the mountain, you'll come across a region brimming with the \"Waters of Intensity.\" There, perhaps, you'll find traces of the \"strongest\"..."
          },
          "751780505": {
            "id": "751780505",
            "speakerId": 1001,
            "speakerName": "Loshts",
            "text": "Ah yes, that would be lovely! Lovely!"
          }
        }
      }
    },
    {
      "subId": "7517808",
      "subQuestName": "Seal the geothermal vent",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7517806",
      "subQuestName": "Talk to Linaha",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751781501"
        ],
        "dialogs": {
          "751781501": {
            "id": "751781501",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "Great! You're all back! I was starting to think I might've really messed things up today!",
            "nextDialogs": [
              "751781502"
            ]
          },
          "751781502": {
            "id": "751781502",
            "speakerId": 1005,
            "speakerName": "Ma'chah",
            "text": "Huh? This is... so hot! The \"intensity\" is building up! Ahh! I did it! I really did it!",
            "nextDialogs": [
              "751781503"
            ]
          },
          "751781503": {
            "id": "751781503",
            "speakerId": 1005,
            "speakerName": "Ma'chah",
            "text": "Haha! What incredible \"intensity\"! Such unbelievable \"intensity\"!",
            "nextDialogs": [
              "751781504"
            ]
          },
          "751781504": {
            "id": "751781504",
            "speakerId": 1005,
            "speakerName": "Ma'chah",
            "text": "...Aghhh!"
          }
        }
      }
    },
    {
      "subId": "7517803",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751780301"
        ],
        "dialogs": {
          "751780301": {
            "id": "751780301",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "Ki'o-ki'o, where are you..."
          }
        }
      }
    },
    {
      "subId": "7517809",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751780901"
        ],
        "dialogs": {
          "751780901": {
            "id": "751780901",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "#Oh hey, {NICKNAME}, it's you...",
            "nextDialogs": [
              "751780904",
              "751780907"
            ]
          },
          "751780904": {
            "id": "751780904",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "Actually... the hot spring water still feels colder than it used to. I really messed up this time. What am I gonna do when I go back...?",
            "nextDialogs": [
              "751780905"
            ]
          },
          "751780905": {
            "id": "751780905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry, just give it a bit more time.",
            "nextDialogs": [
              "751780906"
            ]
          },
          "751780906": {
            "id": "751780906",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "Alright, got it..."
          },
          "751780907": {
            "id": "751780907",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "#Um... take care on your way, {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "7517810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751781001"
        ],
        "dialogs": {
          "751781001": {
            "id": "751781001",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... Well, we already agreed to help out, but where should we even start?",
            "nextDialogs": [
              "751781003",
              "751781006"
            ]
          },
          "751781003": {
            "id": "751781003",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr?",
            "nextDialogs": [
              "751781004"
            ]
          },
          "751781004": {
            "id": "751781004",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That's never going to work! The area's way too big!",
            "nextDialogs": [
              "751781009"
            ]
          },
          "751781009": {
            "id": "751781009",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "*sigh* Isn't there a more realistic solution we can try?",
            "nextDialogs": [
              "751781010"
            ]
          },
          "751781010": {
            "id": "751781010",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr?",
            "nextDialogs": [
              "751781011"
            ]
          },
          "751781011": {
            "id": "751781011",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Wait, {REALNAME[ID(2)|SHOWHOST(true)]}, don't go wandering off like that!"
          },
          "751781006": {
            "id": "751781006",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, Paimon gets it! We could have our little guy dig a tunnel, then use the volcanic magma to heat the hot spring, right? Not a bad idea...",
            "nextDialogs": [
              "751781007"
            ]
          },
          "751781007": {
            "id": "751781007",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr! Rawr! Rawr!",
            "nextDialogs": [
              "751781008"
            ]
          },
          "751781008": {
            "id": "751781008",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#...Yeah, right! Get serious, would you? We could get people killed doing that! Worse, {REALNAME[ID(2)|SHOWHOST(true)]} believed you for a second back there!"
          }
        }
      }
    },
    {
      "subId": "7517813",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751781301"
        ],
        "dialogs": {
          "751781301": {
            "id": "751781301",
            "speakerId": 1005,
            "speakerName": "Ma'chah",
            "text": "Haha! So \"cold\"! This is so \"cold\"! But just watch — I'm about to crank the \"intensity\" right up! You'll boil alright, mark my words!"
          }
        }
      }
    },
    {
      "subId": "7517817",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751781701"
        ],
        "dialogs": {
          "751781701": {
            "id": "751781701",
            "speakerId": 1006,
            "speakerName": "???",

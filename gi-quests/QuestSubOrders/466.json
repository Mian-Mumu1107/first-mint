    {
      "subId": "46622",
      "subQuestName": "Give 4 Mist Flower Corolla to Diluc",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660901"
        ],
        "dialogs": {
          "4660901": {
            "id": "4660901",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Ah, you're back.",
            "nextDialogs": [
              "4660902"
            ]
          },
          "4660902": {
            "id": "4660902",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Allow me to introduce the winery's master brewer—",
            "nextDialogs": [
              "4660903"
            ]
          },
          "4660903": {
            "id": "4660903",
            "speakerId": 10022,
            "speakerName": "Connor",
            "text": "So many Mist Flowers... Great! I can't wait to see how this turns out!",
            "nextDialogs": [
              "4660904"
            ]
          },
          "4660904": {
            "id": "4660904",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "So, are you certain the equipment can withstand this level of purity?",
            "nextDialogs": [
              "4660905"
            ]
          },
          "4660905": {
            "id": "4660905",
            "speakerId": 10022,
            "speakerName": "Connor",
            "text": "Oh my... my goodness, the winery owner himself is addressing me directly!",
            "nextDialogs": [
              "4660906"
            ]
          },
          "4660906": {
            "id": "4660906",
            "speakerId": 10022,
            "speakerName": "Connor",
            "text": "Don't worry, sir! It is always my honor to serve you, even if it means risking my life!",
            "nextDialogs": [
              "4660907"
            ]
          },
          "4660907": {
            "id": "4660907",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? What's so life-threatening about this?",
            "nextDialogs": [
              "4660908"
            ]
          },
          "4660908": {
            "id": "4660908",
            "speakerId": 10022,
            "speakerName": "Connor",
            "text": "Please excuse me — I must get to work!",
            "nextDialogs": [
              "4660909"
            ]
          },
          "4660909": {
            "id": "4660909",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's he gonna do with a bunch of Mist Flowers?",
            "nextDialogs": [
              "4660910"
            ]
          },
          "4660910": {
            "id": "4660910",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Long story short...",
            "nextDialogs": [
              "4660911"
            ]
          },
          "4660911": {
            "id": "4660911",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "A few days ago, the winery was experimenting with some new flavors. They wanted to see if Mist Flower can truly add a crisp and refreshing taste.",
            "nextDialogs": [
              "4660912"
            ]
          },
          "4660912": {
            "id": "4660912",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Sure enough, they discovered that the flower's extract is truly potent.",
            "nextDialogs": [
              "4660913"
            ]
          },
          "4660913": {
            "id": "4660913",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So the new batch is selling like hot cakes?",
            "nextDialogs": [
              "4660914"
            ]
          },
          "4660914": {
            "id": "4660914",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "No, not potent in terms of attracting customers, but slimes.",
            "nextDialogs": [
              "4660915"
            ]
          },
          "4660915": {
            "id": "4660915",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Slimes need to extract elemental energy to survive... For them, this substance is simply irresistible.",
            "nextDialogs": [
              "4660916"
            ]
          },
          "4660916": {
            "id": "4660916",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "So I thought to myself, \"I wonder how much trouble I could cause now that I know this...\"",
            "nextDialogs": [
              "4660917"
            ]
          },
          "4660917": {
            "id": "4660917",
            "speakerId": 1003,
            "speakerName": "Refining",
            "text": "*bang crash wallop*...",
            "nextDialogs": [
              "4660918"
            ]
          },
          "4660918": {
            "id": "4660918",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yikes! What was that noise?",
            "nextDialogs": [
              "4660919"
            ]
          },
          "4660919": {
            "id": "4660919",
            "speakerId": 10022,
            "speakerName": "Connor",
            "text": "Ah... C—Cold... so c—cold... Master Diluc, purification complete, sir! B—But the equipment is...",
            "nextDialogs": [
              "4660920"
            ]
          },
          "4660920": {
            "id": "4660920",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Marvelous work. Don't fret about the equipment, I shall have my butler order more immediately.",
            "nextDialogs": [
              "4660921"
            ]
          },
          "4660921": {
            "id": "4660921",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Marvelous! Jolly-ho! Spiffing! Somebody fetch the butler!\" Paimon never knew you had to be so well-spoken to get a job in the alcohol industry.",
            "nextDialogs": [
              "4660922"
            ]
          },
          "4660922": {
            "id": "4660922",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "This is what I was talking about.",
            "nextDialogs": [
              "4660923"
            ]
          },
          "4660923": {
            "id": "4660923",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Mist Flower extract... or for our purposes, \"Elemental Bait.\"",
            "nextDialogs": [
              "4660924"
            ]
          },
          "4660924": {
            "id": "4660924",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, it really has a strong elemental... whiff! Can we test it out?",
            "nextDialogs": [
              "4660925"
            ]
          },
          "4660925": {
            "id": "4660925",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Sprinkle a little on the ground over there — careful, just a small amount."
          }
        }
      }
    },
    {
      "subId": "46604",
      "subQuestName": "Set the elemental bait",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660401"
        ],
        "dialogs": {
          "4660401": {
            "id": "4660401",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Greetings, Mr. Huffman of the Knights of Favonius. To what do I owe the pleasure at this hour?",
            "nextDialogs": [
              "4660402"
            ]
          },
          "4660402": {
            "id": "4660402",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "...Oh, erm, nothing... I'm merely procrastinating. I thought I might indulge myself with a beverage or two.",
            "nextDialogs": [
              "4660403"
            ]
          },
          "4660403": {
            "id": "4660403",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "Ah, Traveler! Fancy meeting you here.",
            "nextDialogs": [
              "4660404"
            ]
          },
          "4660404": {
            "id": "4660404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, we were in the mood for an evening stroll.",
            "nextDialogs": [
              "4660405"
            ]
          },
          "4660405": {
            "id": "4660405",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "What would you like to drink?",
            "nextDialogs": [
              "4660406"
            ]
          },
          "4660406": {
            "id": "4660406",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "I'll have a Dandelion Wine, I suppose.",
            "nextDialogs": [
              "4660407"
            ]
          },
          "4660407": {
            "id": "4660407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, Paimon wants apple juice!",
            "nextDialogs": [
              "4660409"
            ]
          },
          "4660409": {
            "id": "4660409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#...Aw, but Paimon forgot to bring her coin pouch! {NICKNAME}, do you have any Mora on you?"
          }
        }
      }
    },
    {
      "subId": "46605",
      "subQuestName": "Talk to Diluc",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660201"
        ],
        "dialogs": {
          "4660201": {
            "id": "4660201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And then? That's it?",
            "nextDialogs": [
              "4660202"
            ]
          },
          "4660202": {
            "id": "4660202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How long does it take before...",
            "nextDialogs": [
              "4660203"
            ]
          },
          "4660203": {
            "id": "4660203",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "*squelch squelch*",
            "nextDialogs": [
              "4660204"
            ]
          },
          "4660204": {
            "id": "4660204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Holy moley, it really does attract slimes! ...And even more than we expected...",
            "nextDialogs": [
              "4660205"
            ]
          },
          "4660205": {
            "id": "4660205",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "It appears the potency is greater than anticipated...",
            "nextDialogs": [
              "4660206"
            ]
          },
          "4660206": {
            "id": "4660206",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "We'd better get rid of them before they wreak havoc on the manor."
          }
        }
      }
    },
    {
      "subId": "46606",
      "subQuestName": "Defeat the slimes",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660601"
        ],
        "dialogs": {
          "4660601": {
            "id": "4660601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Classic Master Diluc — not a baddie left standing.",
            "nextDialogs": [
              "4660602"
            ]
          },
          "4660602": {
            "id": "4660602",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Nothing more than a few hilichurls.",
            "nextDialogs": [
              "4660603"
            ]
          },
          "4660603": {
            "id": "4660603",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "No time to chat. I don't know how long those slimes will keep Huffman occupied. Best get back to the <color=#00E1FFFF>tavern</color>."
          }
        }
      }
    },

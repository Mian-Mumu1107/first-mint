  "subQuests": [
    {
      "subId": "46601",
      "subQuestName": "Go to Dawn Winery",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660101"
        ],
        "dialogs": {
          "4660101": {
            "id": "4660101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Master Diluc! Paimon has something important to tell you—",
            "nextDialogs": [
              "4660102"
            ]
          },
          "4660102": {
            "id": "4660102",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Yes... about Kaeya...",
            "nextDialogs": [
              "4660103"
            ]
          },
          "4660103": {
            "id": "4660103",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I should have known he would see this as the perfect opportunity to get back at me.",
            "nextDialogs": [
              "4660104"
            ]
          },
          "4660104": {
            "id": "4660104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sounds like there's a bit of bad blood between you guys then?",
            "nextDialogs": [
              "4660105"
            ]
          },
          "4660105": {
            "id": "4660105",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I shan't get into that now. More importantly, the Knights of Favonius are responding more or less as I had anticipated.",
            "nextDialogs": [
              "4660106"
            ]
          },
          "4660106": {
            "id": "4660106",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "All we need to do now is think of a counter plan.",
            "nextDialogs": [
              "4660108"
            ]
          },
          "4660108": {
            "id": "4660108",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "That won't work. It will only arouse the Knights' suspicion if I don't show up as they're expecting.",
            "nextDialogs": [
              "4660109"
            ]
          },
          "4660109": {
            "id": "4660109",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "That's what Kaeya is counting on.",
            "nextDialogs": [
              "4660110"
            ]
          },
          "4660110": {
            "id": "4660110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... so what are we gonna do?",
            "nextDialogs": [
              "4660112"
            ]
          },
          "4660112": {
            "id": "4660112",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Patience. Let me think for a moment...",
            "nextDialogs": [
              "4660113"
            ]
          },
          "4660113": {
            "id": "4660113",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "...",
            "nextDialogs": [
              "4660114"
            ]
          },
          "4660114": {
            "id": "4660114",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "If they intend to monitor me, then so be it.",
            "nextDialogs": [
              "4660115"
            ]
          },
          "4660115": {
            "id": "4660115",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "We can use this to create the perfect alibi.",
            "nextDialogs": [
              "4660116"
            ]
          },
          "4660116": {
            "id": "4660116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's an alabla— an alibi?",
            "nextDialogs": [
              "4660117"
            ]
          },
          "4660117": {
            "id": "4660117",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "If you want to find out, maybe you can do me a small favor first.",
            "nextDialogs": [
              "4660118"
            ]
          },
          "4660118": {
            "id": "4660118",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh come on! Why do you love cliff hangers so much?",
            "nextDialogs": [
              "4660119"
            ]
          },
          "4660119": {
            "id": "4660119",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "In Mondstadt, Mist Flowers are most commonly found in a region just <color=#00E1FFFF>northwest of the winery</color>.",
            "nextDialogs": [
              "4660120"
            ]
          },
          "4660120": {
            "id": "4660120",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "If you could gather some for me, I'd be most grateful. I will make other preparations here in the meantime."
          }
        }
      }
    },
    {
      "subId": "46602",
      "subQuestName": "Furnish Diluc with the information.",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "46603",
      "subQuestName": "Leave winery",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660301"
        ],
        "dialogs": {
          "4660301": {
            "id": "4660301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whew... Such a powerful effect from such a small amount of extract. At least we didn't go picking wild flowers for nothing.",
            "nextDialogs": [
              "4660302"
            ]
          },
          "4660302": {
            "id": "4660302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright! So can you tell us what your plan is now, Master Diluc?",
            "nextDialogs": [
              "4660303"
            ]
          },
          "4660303": {
            "id": "4660303",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Yes. The plan is...",
            "nextDialogs": [
              "4660304"
            ]
          },
          "4660304": {
            "id": "4660304",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "...and so I expect it to all go down without a hitch.",
            "nextDialogs": [
              "4660305"
            ]
          },
          "4660305": {
            "id": "4660305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Are you sure it will work?",
            "nextDialogs": [
              "4660306"
            ]
          },
          "4660306": {
            "id": "4660306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're the only person in the plan...",
            "nextDialogs": [
              "4660307"
            ]
          },
          "4660307": {
            "id": "4660307",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I have persevered alone from the start.",
            "nextDialogs": [
              "4660308"
            ]
          },
          "4660308": {
            "id": "4660308",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Now, I alone must face what lies ahead.",
            "nextDialogs": [
              "4660309"
            ]
          },
          "4660309": {
            "id": "4660309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well... if you already made up your mind...",
            "nextDialogs": [
              "4660310"
            ]
          },
          "4660310": {
            "id": "4660310",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#But until that moment comes, {NICKNAME} and Paimon can still help you out where we can. Isn't that right, {NICKNAME}?",
            "nextDialogs": [
              "4660314",
              "4660313"
            ]
          },
          "4660314": {
            "id": "4660314",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I am indeed indebted to you. I shall see you at the <color=#00E1FFFF>tavern</color>, as per the plan."
          },
          "4660313": {
            "id": "4660313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Don't be so cheeky!"
          }
        }
      }
    },
    {
      "subId": "46621",

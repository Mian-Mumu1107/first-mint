    {
      "subId": "46617",
      "subQuestName": "Return to the tavern before Huffman",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "46618",
      "subQuestName": "Talk to Diluc",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660701"
        ],
        "dialogs": {
          "4660701": {
            "id": "4660701",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "It seems Huffman hasn't yet returned.",
            "nextDialogs": [
              "4660702"
            ]
          },
          "4660702": {
            "id": "4660702",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "We made it in time.",
            "nextDialogs": [
              "4660703"
            ]
          },
          "4660703": {
            "id": "4660703",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "*panting* ...The situation is sorted now. I never expected that the Abyss Order's army would turn out to be nothing more than a few slimes.",
            "nextDialogs": [
              "4660704"
            ]
          },
          "4660704": {
            "id": "4660704",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "That is a surprise.",
            "nextDialogs": [
              "4660705"
            ]
          },
          "4660705": {
            "id": "4660705",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Perhaps the Knights' true calling is to be slime exterminators. Who knows, domestic pest control may turn out to be a more valuable use of your resources.",
            "nextDialogs": [
              "4660706"
            ]
          },
          "4660706": {
            "id": "4660706",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "Master Diluc, please, have you no respect at all...",
            "nextDialogs": [
              "4660707"
            ]
          },
          "4660707": {
            "id": "4660707",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "#{NICKNAME}, how come you're sweating so much? You didn't leave, did you?",
            "nextDialogs": [
              "4660709",
              "4660711"
            ]
          },
          "4660709": {
            "id": "4660709",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "Is it...? But if that's the case, why are you also out of breath?",
            "nextDialogs": [
              "4660712"
            ]
          },
          "4660712": {
            "id": "4660712",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh-oh, Huffman is getting suspicious!",
            "nextDialogs": [
              "4660713"
            ]
          },
          "4660713": {
            "id": "4660713",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "Hmm...",
            "nextDialogs": [
              "4660714"
            ]
          },
          "4660714": {
            "id": "4660714",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "Excuse me, sir. Might I be so bold as to inquire...",
            "nextDialogs": [
              "4660715"
            ]
          },
          "4660715": {
            "id": "4660715",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "...Did you see Master Diluc— I mean, today's bartender... Did you see him leave just now?",
            "nextDialogs": [
              "4660716"
            ]
          },
          "4660716": {
            "id": "4660716",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yikes! He's asking other customers... We're done for!",
            "nextDialogs": [
              "4660717"
            ]
          },
          "4660717": {
            "id": "4660717",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "4660718"
            ]
          },
          "4660718": {
            "id": "4660718",
            "speakerId": 1007,
            "speakerName": "Patrons",
            "text": "Master Diluc? Why no, he's been behind the bar this entire time.",
            "nextDialogs": [
              "4660719"
            ]
          },
          "4660719": {
            "id": "4660719",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "I see...",
            "nextDialogs": [
              "4660720"
            ]
          },
          "4660720": {
            "id": "4660720",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Mr. Huffman, your Dandelion Wine.",
            "nextDialogs": [
              "4660721"
            ]
          },
          "4660721": {
            "id": "4660721",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "You ought to get back after this. Send my regards to the rest of the Knights.",
            "nextDialogs": [
              "4660722"
            ]
          },
          "4660722": {
            "id": "4660722",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "Oh... Never mind, I must be going, I should report back. Here, take this as a token of my esteem.",
            "nextDialogs": [
              "4660723"
            ]
          },
          "4660723": {
            "id": "4660723",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "Hmm... How odd...",
            "nextDialogs": [
              "4660724"
            ]
          },
          "4660724": {
            "id": "4660724",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Phew! That was too close! Paimon was sure we were toast...",
            "nextDialogs": [
              "4660725"
            ]
          },
          "4660725": {
            "id": "4660725",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I foresaw this eventuality...",
            "nextDialogs": [
              "4660726"
            ]
          },
          "4660726": {
            "id": "4660726",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "...So all the guests here tonight, save you two, are my own people from the Dawn Winery.",
            "nextDialogs": [
              "4660727"
            ]
          },
          "4660727": {
            "id": "4660727",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They're all in on it?",
            "nextDialogs": [
              "4660728"
            ]
          },
          "4660728": {
            "id": "4660728",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Not all of them... Or should I say, not all of us.",
            "nextDialogs": [
              "4660729"
            ]
          },
          "4660729": {
            "id": "4660729",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kaeya!? Where did you come from?",
            "nextDialogs": [
              "4660730"
            ]
          },
          "4660730": {
            "id": "4660730",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "I just picked a good spot to quietly sit and watch the show.",
            "nextDialogs": [
              "4660731"
            ]
          },
          "4660731": {
            "id": "4660731",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whaaa... You've been here this whole time!?",
            "nextDialogs": [
              "4660732"
            ]
          },
          "4660732": {
            "id": "4660732",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Correct. \"The Darknight Hero's Alibi...\" I think it's my favorite chapter so far. More intriguing than a fine wine.",
            "nextDialogs": [
              "4660733"
            ]
          },
          "4660733": {
            "id": "4660733",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Hmph...",
            "nextDialogs": [
              "4660734"
            ]
          },
          "4660734": {
            "id": "4660734",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "So? You plan to report everything to the Knights of Favonius?",
            "nextDialogs": [
              "4660735"
            ]
          },
          "4660735": {
            "id": "4660735",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Haha... Come now Diluc, you know me better than that. I have no interest in exposing secrets.",
            "nextDialogs": [
              "4660736"
            ]
          },
          "4660736": {
            "id": "4660736",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "I was just curious to see how far Mondstadt's Darknight Hero would really go.",
            "nextDialogs": [
              "4660737"
            ]
          },
          "4660737": {
            "id": "4660737",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "And you did not disappoint.",
            "nextDialogs": [
              "4660738"
            ]
          },
          "4660738": {
            "id": "4660738",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I have nothing to prove to you.",
            "nextDialogs": [
              "4660739"
            ]
          },
          "4660739": {
            "id": "4660739",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Oh, naturally.",
            "nextDialogs": [
              "4660740"
            ]
          },
          "4660740": {
            "id": "4660740",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "I must say though, one thing I didn't see coming is that the mighty Darknight Hero would actually need help from other people...",
            "nextDialogs": [
              "4660741"
            ]
          },
          "4660741": {
            "id": "4660741",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Sorry, we're closing. Please see yourselves out.",
            "nextDialogs": [
              "4660742"
            ]
          },
          "4660742": {
            "id": "4660742",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Alright, alright... I have no further need of wine to entertain myself tonight, in any case.",
            "nextDialogs": [
              "4660743"
            ]
          },
          "4660743": {
            "id": "4660743",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Just one last thing before I go.",
            "nextDialogs": [
              "4660744"
            ]
          },
          "4660744": {
            "id": "4660744",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "It had better be the very last thing.",
            "nextDialogs": [
              "4660745"
            ]
          },
          "4660745": {
            "id": "4660745",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "I feel strangely comforted by the fact you now have an assistant, Diluc.",
            "nextDialogs": [
              "4660746"
            ]
          },
          "4660746": {
            "id": "4660746",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "...",
            "nextDialogs": [
              "4660747"
            ]
          },
          "4660747": {
            "id": "4660747",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "I hope you all have a wonderful night.",
            "nextDialogs": [
              "4660748"
            ]
          },
          "4660748": {
            "id": "4660748",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What was all that about?",
            "nextDialogs": [
              "4660749"
            ]
          },
          "4660749": {
            "id": "4660749",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Don't mind him.",
            "nextDialogs": [
              "4660750"
            ]
          },
          "4660750": {
            "id": "4660750",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Thank you for all your help with this matter. This is a token of my gratitude.",
            "nextDialogs": [
              "4660751"
            ]
          },
          "4660751": {
            "id": "4660751",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Woooow! Thanks Master Diluc!",
            "nextDialogs": [
              "4660752"
            ]
          },
          "4660752": {
            "id": "4660752",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I'm in the habit of working alone, but I did enjoy having your assistance this time.",
            "nextDialogs": [
              "4660753"
            ]
          },
          "4660753": {
            "id": "4660753",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "In the future, if there's anything you ever need, you can come to me for help."
          },
          "4660711": {
            "id": "4660711",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "Is that so? But why now of all times, for the love of Barbatos..."
          }
        }
      }
    },
    {
      "subId": "46610",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4661001"
        ],
        "dialogs": {
          "4661001": {
            "id": "4661001",
            "speakerId": 10008,
            "speakerName": "Connor",
            "text": "The method for obtaining Mist Flower extract is kind of my own invention... So please keep it a secret until I've managed to publish it."
          }
        }
      }
    },
    {
      "subId": "46613",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4661301"
        ],
        "dialogs": {
          "4661301": {
            "id": "4661301",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Let's discuss the plan some more after we've dealt with these slimes."
          }
        }
      }
    }
  ]
}
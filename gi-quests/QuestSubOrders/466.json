    {
      "subId": "46612",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4661201"
        ],
        "dialogs": {
          "4661201": {
            "id": "4661201",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "It's only a couple of fruit juices, really, let me get them for you."
          }
        }
      }
    },
    {
      "subId": "46613",
      "subQuestName": "Talk to Diluc",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660501"
        ],
        "dialogs": {
          "4660501": {
            "id": "4660501",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "...Captain Kaeya is no doubt a formidable knight, but he also brings us more than his share of hassle...",
            "nextDialogs": [
              "4660502"
            ]
          },
          "4660502": {
            "id": "4660502",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "No, this isn't right. I should not be talking about my superior in such a manner. If he were to overhear me...",
            "nextDialogs": [
              "4660503"
            ]
          },
          "4660503": {
            "id": "4660503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're back! Is my apple juice ready?",
            "nextDialogs": [
              "4660504"
            ]
          },
          "4660504": {
            "id": "4660504",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "One moment.",
            "nextDialogs": [
              "4660505"
            ]
          },
          "4660505": {
            "id": "4660505",
            "speakerId": 1217,
            "speakerName": "City Gate Guard",
            "text": "Mr. Huffman, Mr. Huffman! A situation at the side gate! Everyone to the side gate!",
            "nextDialogs": [
              "4660506"
            ]
          },
          "4660506": {
            "id": "4660506",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "What is it? What happened?",
            "nextDialogs": [
              "4660507"
            ]
          },
          "4660507": {
            "id": "4660507",
            "speakerId": 1217,
            "speakerName": "City Gate Guard",
            "text": "It's... Slimes, Mr. Huffman.",
            "nextDialogs": [
              "4660508"
            ]
          },
          "4660508": {
            "id": "4660508",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "Slimes? You see them all the time, what's the big panic?",
            "nextDialogs": [
              "4660509"
            ]
          },
          "4660509": {
            "id": "4660509",
            "speakerId": 1217,
            "speakerName": "City Gate Guard",
            "text": "We do, but... Sir, there are more slimes out there now than all the slimes I've seen in my life added together!",
            "nextDialogs": [
              "4660510"
            ]
          },
          "4660510": {
            "id": "4660510",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ahh... Whoa...",
            "nextDialogs": [
              "4660511"
            ]
          },
          "4660511": {
            "id": "4660511",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "Surely this couldn't be the Abyss Order's secret weapon...",
            "nextDialogs": [
              "4660512"
            ]
          },
          "4660512": {
            "id": "4660512",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "But... I have another matter to attend to here—",
            "nextDialogs": [
              "4660513"
            ]
          },
          "4660513": {
            "id": "4660513",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Oh? The matter of your Dandelion Wine?",
            "nextDialogs": [
              "4660514"
            ]
          },
          "4660514": {
            "id": "4660514",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "N—No, I... That's not what I meant...",
            "nextDialogs": [
              "4660515"
            ]
          },
          "4660515": {
            "id": "4660515",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Hmph. So this is how the Knights of Favonius conduct themselves in a crisis.",
            "nextDialogs": [
              "4660516"
            ]
          },
          "4660516": {
            "id": "4660516",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "The Abyss Order is encroaching on the city gates, and your response is to sit here... drinking wine?",
            "nextDialogs": [
              "4660517"
            ]
          },
          "4660517": {
            "id": "4660517",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "It's like I've always said. The Knights are not to be trusted.",
            "nextDialogs": [
              "4660518"
            ]
          },
          "4660518": {
            "id": "4660518",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "I...",
            "nextDialogs": [
              "4660519"
            ]
          },
          "4660519": {
            "id": "4660519",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "*sigh* Master Diluc is right, my conduct here has been below par.",
            "nextDialogs": [
              "4660520"
            ]
          },
          "4660520": {
            "id": "4660520",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "I shall set off at once. But first...",
            "nextDialogs": [
              "4660521"
            ]
          },
          "4660521": {
            "id": "4660521",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "#{NICKNAME}, may I have a quiet word?",
            "nextDialogs": [
              "4660522"
            ]
          },
          "4660522": {
            "id": "4660522",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh?",
            "nextDialogs": [
              "4660523"
            ]
          },
          "4660523": {
            "id": "4660523",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "Shh, keep your voice down. I presume you know what this is about. Please watch Diluc for me — do not let him leave under any circumstances!",
            "nextDialogs": [
              "4660524"
            ]
          },
          "4660524": {
            "id": "4660524",
            "speakerId": 1218,
            "speakerName": "Huffman",
            "text": "I must head to the side gate, but I'll be back shortly. I'm counting on you!",
            "nextDialogs": [
              "4660525"
            ]
          },
          "4660525": {
            "id": "4660525",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Good. That's him out of the way.",
            "nextDialogs": [
              "4660526"
            ]
          },
          "4660526": {
            "id": "4660526",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Everything's going according to plan!",
            "nextDialogs": [
              "4660527"
            ]
          },
          "4660527": {
            "id": "4660527",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I must get going too. I won't have a second to spare if I'm to be back in time."
          }
        }
      }
    },

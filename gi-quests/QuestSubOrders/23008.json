  "subQuests": [
    {
      "subId": "2300801",
      "subQuestName": "Talk to Akim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230080101"
        ],
        "dialogs": {
          "230080101": {
            "id": "230080101",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "I think I'm about to succeed...",
            "nextDialogs": [
              "230080102"
            ]
          },
          "230080102": {
            "id": "230080102",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Traveler! Hold on a second, Traveler!",
            "nextDialogs": [
              "230080105"
            ]
          },
          "230080105": {
            "id": "230080105",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "I'm looking for Slime Condensate!",
            "nextDialogs": [
              "230080106"
            ]
          },
          "230080106": {
            "id": "230080106",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Here's the thing. I've been mixing the different soils you brought previously in various proportions over the last few days.",
            "nextDialogs": [
              "230080107"
            ]
          },
          "230080107": {
            "id": "230080107",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "I failed many times, but I did eventually work out a viable mixing ratio!",
            "nextDialogs": [
              "230080108"
            ]
          },
          "230080108": {
            "id": "230080108",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Concresoil with this ratio lacks plasticity before it hardens, but after that, it becomes strong and durable.",
            "nextDialogs": [
              "230080109"
            ]
          },
          "230080109": {
            "id": "230080109",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "I might need to add more soil with Slime Condensate in it...",
            "nextDialogs": [
              "230080110"
            ]
          },
          "230080110": {
            "id": "230080110",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Traveler, could you please bring me three more portions of Slime Condensate?",
            "nextDialogs": [
              "230080111"
            ]
          },
          "230080111": {
            "id": "230080111",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "With more Slime Condensate, I'm sure that I can definitely create the ideal soil!"
          }
        }
      }
    },
    {
      "subId": "2300802",
      "subQuestName": "Give three portions of Slime Condensate to Akim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230080201"
        ],
        "dialogs": {
          "230080201": {
            "id": "230080201",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Did you get the Slime Condensate?"
          }
        }
      }
    },
    {
      "subId": "2300803",
      "subQuestName": "Keep talking to Akim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230080301"
        ],
        "dialogs": {
          "230080301": {
            "id": "230080301",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Great! This is it. Give me a sec. I'll get it done in no time!",
            "nextDialogs": [
              "230080302"
            ]
          },
          "230080302": {
            "id": "230080302",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "A while later...",
            "nextDialogs": [
              "230080303"
            ]
          },
          "230080303": {
            "id": "230080303",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Hah, my guess was right.",
            "nextDialogs": [
              "230080304"
            ]
          },
          "230080304": {
            "id": "230080304",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "As adhesive as it is, the moist soil breaks easily once it hardens. However, if we mix it with the Whopperflower soil, the solidified soil becomes more flexible.",
            "nextDialogs": [
              "230080305"
            ]
          },
          "230080305": {
            "id": "230080305",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "It's just that the mixture can't really be molded before it starts solidifying...",
            "nextDialogs": [
              "230080306"
            ]
          },
          "230080306": {
            "id": "230080306",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "But with the addition of the soil from the Slimes' habitat, the mixture can be molded much better before its solidification.",
            "nextDialogs": [
              "230080307"
            ]
          },
          "230080307": {
            "id": "230080307",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "I don't know what happened, but if I have to describe the process, the soil became Slime-like...",
            "nextDialogs": [
              "230080311",
              "230080310"
            ]
          },
          "230080311": {
            "id": "230080311",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Some property of the Slimes seems to have affected the mixture in some way. That's why I was wondering if adding Slime Condensate would make it more effective.",
            "nextDialogs": [
              "230080312"
            ]
          },
          "230080312": {
            "id": "230080312",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "And as it turned out, the mixture's plasticity and stability changed with the amount of Slime Condensate added.",
            "nextDialogs": [
              "230080313"
            ]
          },
          "230080313": {
            "id": "230080313",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Which means that it can make more than just building materials, but pottery and many other things as well!"
          },
          "230080310": {
            "id": "230080310",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Paimon doesn't eat soil!"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7320907",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732090701"
        ],
        "dialogs": {
          "732090701": {
            "id": "732090701",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "I was about to lose hope. Didn't expect this flower to actually grow. I guess as long as we're alive, wonderful things can still happen to us.",
            "nextDialogs": [
              "732090702"
            ]
          },
          "732090702": {
            "id": "732090702",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "Little one, are you still sad about Uncle Shafaqat? Don't worry. The living have to carry on with the wishes of those who passed away. We can't let them down.",
            "nextDialogs": [
              "732090703"
            ]
          },
          "732090703": {
            "id": "732090703",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Mr. Affan... I'm not so young anymore. Those friends I grew up with... their kids must be old enough now to go buy spices at the store.",
            "nextDialogs": [
              "732090704"
            ]
          },
          "732090704": {
            "id": "732090704",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "But I agree. Since we're alive, we may as well try our best to live a happy life."
          }
        }
      }
    },
    {
      "subId": "7320901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732090101"
        ],
        "dialogs": {
          "732090101": {
            "id": "732090101",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "It's you guys. Well then, we and the roses have all been waiting for you.",
            "nextDialogs": [
              "732090102"
            ]
          },
          "732090102": {
            "id": "732090102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sabbah came early too!",
            "nextDialogs": [
              "732090103"
            ]
          },
          "732090103": {
            "id": "732090103",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I've been coming here a lot lately, and I've read the notes that Mr. Shafaqat left behind.",
            "nextDialogs": [
              "732090104"
            ]
          },
          "732090104": {
            "id": "732090104",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I used to feel lonely staying in Aaru Village, but I feel differently now.",
            "nextDialogs": [
              "732090105"
            ]
          },
          "732090105": {
            "id": "732090105",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "At least I'm not completely alone. I have these roses, the memories of being with you guys, and Mr. Affan.",
            "nextDialogs": [
              "732090106"
            ]
          },
          "732090106": {
            "id": "732090106",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I still have some good things in my life, and just thinking of that makes me feel less lonely.",
            "nextDialogs": [
              "732090107"
            ]
          },
          "732090107": {
            "id": "732090107",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Mr. Affan and I have had a discussion. I will help him tend to the Golden Roses from now on.",
            "nextDialogs": [
              "732090108"
            ]
          },
          "732090108": {
            "id": "732090108",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "We'll cultivate more of them till they fill the whole nursery. But for now, let's get these to bloom.",
            "nextDialogs": [
              "732090109"
            ]
          },
          "732090109": {
            "id": "732090109",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Do you remember how you made my Sumeru Roses bloom? Let's use the same method.",
            "nextDialogs": [
              "732090110"
            ]
          },
          "732090110": {
            "id": "732090110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let us help.",
            "nextDialogs": [
              "732090111"
            ]
          },
          "732090111": {
            "id": "732090111",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Okay, it's up to you now."
          }
        }
      }
    },
    {
      "subId": "7320902",
      "subQuestName": "Use the power of Dendro to \"awaken\" the Golden Rose",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7320903",
      "subQuestName": "Use the power of Dendro to \"awaken\" the Golden Rose",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732090426"
        ],
        "dialogs": {
          "732090426": {
            "id": "732090426",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "\"Rose, oh roses, grant me my wish.\"",
            "nextDialogs": [
              "732090427"
            ]
          },
          "732090427": {
            "id": "732090427",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "\"Blooming from the stone, the Golden Rose sang to me.\"",
            "nextDialogs": [
              "732090401"
            ]
          },
          "732090401": {
            "id": "732090401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Golden Roses really are beautiful. Seeing them bloom has really brightened Paimon's day!",
            "nextDialogs": [
              "732090402"
            ]
          },
          "732090402": {
            "id": "732090402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "These days of hard work were not in vain. Paimon's so happy!",
            "nextDialogs": [
              "732090405"
            ]
          },
          "732090405": {
            "id": "732090405",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "I finally did something right in the end. Uncle Shafaqat, I've helped you fulfill your wish.",
            "nextDialogs": [
              "732090406"
            ]
          },
          "732090406": {
            "id": "732090406",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "It's a shame he is no longer around to see it.",
            "nextDialogs": [
              "732090407"
            ]
          },
          "732090407": {
            "id": "732090407",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "Don't say that, Sabbah. Do you remember the last stanza of the rose song?",
            "nextDialogs": [
              "732090408"
            ]
          },
          "732090408": {
            "id": "732090408",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "\"No land but folk songs bore my spirit.\"",
            "nextDialogs": [
              "732090409"
            ]
          },
          "732090409": {
            "id": "732090409",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "\"Songs shall defy my fate, and overcome my destiny.\"",
            "nextDialogs": [
              "732090410"
            ]
          },
          "732090410": {
            "id": "732090410",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "\"They will surpass me, surpass time. They will surpass the ever-lasting withering of life.\"",
            "nextDialogs": [
              "732090411"
            ]
          },
          "732090411": {
            "id": "732090411",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "Uncle Shafaqat's life, the Golden Roses, and the folk song he composed himself — they have all remained with us.",
            "nextDialogs": [
              "732090412"
            ]
          },
          "732090412": {
            "id": "732090412",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Yeah, you're right. He has surpassed time and the withering of life.",
            "nextDialogs": [
              "732090413"
            ]
          },
          "732090413": {
            "id": "732090413",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Thank you for telling me about him. This means a lot to me.",
            "nextDialogs": [
              "732090414"
            ]
          },
          "732090414": {
            "id": "732090414",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "He was an exile before me, and seeing the traces of his life here always makes me feel like I've crossed through time and space...",
            "nextDialogs": [
              "732090415"
            ]
          },
          "732090415": {
            "id": "732090415",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I'm not just looking at him. I'm looking at myself too.",
            "nextDialogs": [
              "732090416"
            ]
          },
          "732090416": {
            "id": "732090416",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I can no longer say anything to him, but I can shoulder his regrets and live on.",
            "nextDialogs": [
              "732090417"
            ]
          },
          "732090417": {
            "id": "732090417",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "If I live on for him too, then I'm sure that I will eventually find my own salvation."
          }
        }
      }
    },
    {
      "subId": "7320905",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732090501"
        ],
        "dialogs": {
          "732090501": {
            "id": "732090501",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Use the power of <color=#00E1FFFF>Dendro</color> to awaken the flower sleeping within the shoots."
          }
        }
      }
    },
    {
      "subId": "7320906",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732090601"
        ],
        "dialogs": {
          "732090601": {
            "id": "732090601",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "If these few specimens grow well, we will be able to cultivate more Golden Roses.",
            "nextDialogs": [
              "732090602"
            ]
          },
          "732090602": {
            "id": "732090602",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "But until then, I think I would feel quite a bit more assured if these few roses bloomed first."
          }
        }
      }
    },

    {
      "subId": "4000002",
      "subQuestName": "Talk to Ruijin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400000201"
        ],
        "dialogs": {
          "400000201": {
            "id": "400000201",
            "speakerId": 1001,
            "speakerName": "Ruijin",
            "text": "Hello! Would you like to play a round of Theater Mechanicus?",
            "nextDialogs": [
              "400000202"
            ]
          },
          "400000202": {
            "id": "400000202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Theater Mechanicus? What's that?",
            "nextDialogs": [
              "400000203"
            ]
          },
          "400000203": {
            "id": "400000203",
            "speakerId": 1001,
            "speakerName": "Ruijin",
            "text": "Oh, never heard of it? Allow me to introduce it to you then. Theater Mechanicus is a kind of tabletop game invented by yours truly.",
            "nextDialogs": [
              "400000204"
            ]
          },
          "400000204": {
            "id": "400000204",
            "speakerId": 1001,
            "speakerName": "Ruijin",
            "text": "Do you see these things laid out on the table here? These are all important items used in Theater Mechanicus.",
            "nextDialogs": [
              "400000205"
            ]
          },
          "400000205": {
            "id": "400000205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Looks pretty complicated...",
            "nextDialogs": [
              "400000206"
            ]
          },
          "400000206": {
            "id": "400000206",
            "speakerId": 1001,
            "speakerName": "Ruijin",
            "text": "It may seem complicated, but you'll get the hang of it after you play a couple of times.",
            "nextDialogs": [
              "400000207"
            ]
          },
          "400000207": {
            "id": "400000207",
            "speakerId": 1001,
            "speakerName": "Ruijin",
            "text": "So, how about it? Would you like to give it a try?",
            "nextDialogs": [
              "400000210"
            ]
          },
          "400000210": {
            "id": "400000210",
            "speakerId": 1001,
            "speakerName": "Ruijin",
            "text": "No, not at all. It is the Lantern Rite, after all. Besides, I was hoping to collect everyone's initial impressions of the game.",
            "nextDialogs": [
              "400000211"
            ]
          },
          "400000211": {
            "id": "400000211",
            "speakerId": 1001,
            "speakerName": "Ruijin",
            "text": "So all it'll cost you to play is a single Xiao Lantern.",
            "nextDialogs": [
              "400000212"
            ]
          },
          "400000212": {
            "id": "400000212",
            "speakerId": 1001,
            "speakerName": "Ruijin",
            "text": "If you'd like to try, just bring me a Xiao Lantern and you'll be good to go!",
            "nextDialogs": [
              "400000213"
            ]
          },
          "400000213": {
            "id": "400000213",
            "speakerId": 1001,
            "speakerName": "Ruijin",
            "text": "C'mon, give it a try! I'll even let you play the first round for free and you can keep your Xiao Lantern."
          }
        }
      }
    },

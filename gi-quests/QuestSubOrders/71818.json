    {
      "subId": "7181808",
      "subQuestName": "Collect Xiao Lantern materials for Ms. Bai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180801"
        ],
        "dialogs": {
          "718180801": {
            "id": "718180801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This house should pass the white glove test now! Let's go check on Ms. Bai and Grandpa Jiangcheng...",
            "nextDialogs": [
              "718180802"
            ]
          },
          "718180802": {
            "id": "718180802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, let's go back and join them."
          }
        }
      }
    },
    {
      "subId": "7181809",
      "subQuestName": "Give Xiao Lantern materials to Ms. Bai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180901"
        ],
        "dialogs": {
          "718180901": {
            "id": "718180901",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "It's you, Ms. Bai... Has your father been well?",
            "nextDialogs": [
              "718180902"
            ]
          },
          "718180902": {
            "id": "718180902",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Uh... He... He's doing fine. The mill is still very much in business. The city folk from Liyue Harbor often come to the village just to buy our Tofu.",
            "nextDialogs": [
              "718180903"
            ]
          },
          "718180903": {
            "id": "718180903",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Haha... Sounds about right! Your father's Tofu is the pride of Qingce Village..."
          }
        }
      }
    },
    {
      "subId": "7181810",
      "subQuestName": "Talk to Ms. Bai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180701"
        ],
        "dialogs": {
          "718180701": {
            "id": "718180701",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Thank you so much. I'll make myself a Xiao Lantern later.",
            "nextDialogs": [
              "718180702"
            ]
          },
          "718180702": {
            "id": "718180702",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "I used to release Xiao Lanterns together with my father. When I'm done making this one, I'll have to release it on my own.",
            "nextDialogs": [
              "718180703"
            ]
          },
          "718180703": {
            "id": "718180703",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "But I hope... he'll be able to see it.",
            "nextDialogs": [
              "718180705"
            ]
          },
          "718180705": {
            "id": "718180705",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Thank you so much. I wish you Happy Lantern Rite."
          }
        }
      }
    },
    {
      "subId": "7181806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180601"
        ],
        "dialogs": {
          "718180601": {
            "id": "718180601",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Have you gathered the materials yet?",
            "nextDialogs": [
              "718180602"
            ]
          },
          "718180602": {
            "id": "718180602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, I have them right here.",
            "nextDialogs": [
              "718180603"
            ]
          },
          "718180603": {
            "id": "718180603",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Thank you."
          }
        }
      }
    },
    {
      "subId": "7181810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718181001"
        ],
        "dialogs": {
          "718181001": {
            "id": "718181001",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Xiao Lanterns... Xiao Lanterns... Such a wonderful sight...",
            "nextDialogs": [
              "718181002"
            ]
          },
          "718181002": {
            "id": "718181002",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Traveler, could you hang the Xiao Lantern now? I'll look after Grandpa Jiangcheng."
          }
        }
      }
    },
    {
      "subId": "7181812",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718181201"
        ],
        "dialogs": {
          "718181201": {
            "id": "718181201",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "What a pretty Xiao Lantern! The upcoming year is bound to be as great as this one."
          }
        }
      }
    }
  ]
}
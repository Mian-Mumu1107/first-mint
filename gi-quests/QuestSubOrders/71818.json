  "subQuests": [
    {
      "subId": "7181811",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718181101"
        ],
        "dialogs": {
          "718181101": {
            "id": "718181101",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "I hope he'll like that Xiao Lantern..."
          }
        }
      }
    },
    {
      "subId": "7181801",
      "subQuestName": "Talk to Ms. Bai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180101"
        ],
        "dialogs": {
          "718180101": {
            "id": "718180101",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "How do you do, Traveler? Thanks for your help last time. Qingce Village hasn't been this lively in a while now.",
            "nextDialogs": [
              "718180102"
            ]
          },
          "718180102": {
            "id": "718180102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're most welcome.",
            "nextDialogs": [
              "718180103"
            ]
          },
          "718180103": {
            "id": "718180103",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "In previous years, only Zhi and I were around, so we could only make the children a few Xiao Lanterns, talk to the old folks about some domestic business, and whip up a few good dishes...",
            "nextDialogs": [
              "718180104"
            ]
          },
          "718180104": {
            "id": "718180104",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "But with your help, we were able to have a lively Lantern Rite this time.",
            "nextDialogs": [
              "718180105"
            ]
          },
          "718180105": {
            "id": "718180105",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "But I guess we should look to return to normal now... I should see to the elderly folk in the village. I'm meant to go see Jiangcheng today.",
            "nextDialogs": [
              "718180106"
            ]
          },
          "718180106": {
            "id": "718180106",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "If you don't mind, could you come along with me?",
            "nextDialogs": [
              "718180107"
            ]
          },
          "718180107": {
            "id": "718180107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Lead the way.",
            "nextDialogs": [
              "718180108"
            ]
          },
          "718180108": {
            "id": "718180108",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Alright. Then let us go to his place first."
          }
        }
      }
    },
    {
      "subId": "7181802",
      "subQuestName": "Talk to Jiangcheng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180201"
        ],
        "dialogs": {
          "718180201": {
            "id": "718180201",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Is it you, dear? Are you back?",
            "nextDialogs": [
              "718180202"
            ]
          },
          "718180202": {
            "id": "718180202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm sorry, you must've mistaken me for someone else...",
            "nextDialogs": [
              "718180203"
            ]
          },
          "718180203": {
            "id": "718180203",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Nonsense, I haven't lost my senses... How could I not recognize my own wife...",
            "nextDialogs": [
              "718180204"
            ]
          },
          "718180204": {
            "id": "718180204",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "I was just telling you that, with such a huge festival just around the corner, maybe we should get some new clothes for our daughter...",
            "nextDialogs": [
              "718180205"
            ]
          },
          "718180205": {
            "id": "718180205",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Oh, I see you've brought a guest... A seamstress! Once again, you've read my mind!",
            "nextDialogs": [
              "718180206"
            ]
          },
          "718180206": {
            "id": "718180206",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Grandpa Jiangcheng, it's me, Ms. Bai! I brought you some Tofu the other day, surely you haven't forgotten me already?",
            "nextDialogs": [
              "718180207"
            ]
          },
          "718180207": {
            "id": "718180207",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Ah... Ms. Bai... Of course I remember you, Ms. Bai! Your father was telling me how proud he is of you not so long ago...",
            "nextDialogs": [
              "718180208"
            ]
          },
          "718180208": {
            "id": "718180208",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Eh... When was that? ...Dear, perhaps you remember...",
            "nextDialogs": [
              "718180211"
            ]
          },
          "718180211": {
            "id": "718180211",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Ha! Just like I said, there's nothing wrong with my memory... And, and...",
            "nextDialogs": [
              "718180212"
            ]
          },
          "718180212": {
            "id": "718180212",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Grandpa Jiangcheng, why don't you take some rest? No need to strain yourself...",
            "nextDialogs": [
              "718180213"
            ]
          },
          "718180213": {
            "id": "718180213",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Traveler, how about you help Grandpa Jiangcheng clean the house? I'll keep him company in the meantime.",
            "nextDialogs": [
              "718180214"
            ]
          },
          "718180214": {
            "id": "718180214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Leave it to me.",
            "nextDialogs": [
              "718180215"
            ]
          },
          "718180215": {
            "id": "718180215",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Thank you."
          }
        }
      }
    },
    {
      "subId": "7181803",
      "subQuestName": "Use Anemo or Hydro to help Jiangcheng clean the house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180301"
        ],
        "dialogs": {
          "718180301": {
            "id": "718180301",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Dear, come have a word with Ms. Bai... Her father is such a skilled craftsman...",
            "nextDialogs": [
              "718180302"
            ]
          },
          "718180302": {
            "id": "718180302",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "They sell their Tofu in Liyue Harbor, it's top-quality!",
            "nextDialogs": [
              "718180303"
            ]
          },
          "718180303": {
            "id": "718180303",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Right! Ms. Bai, I forgot to ask what brought you here...",
            "nextDialogs": [
              "718180304"
            ]
          },
          "718180304": {
            "id": "718180304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We brought you a Xiao Lantern.",
            "nextDialogs": [
              "718180305"
            ]
          },
          "718180305": {
            "id": "718180305",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Xiao Lantern... Ah... So considerate. You bring me those each year, Ms. Bai...",
            "nextDialogs": [
              "718180306"
            ]
          },
          "718180306": {
            "id": "718180306",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Do you remember, Dear? I used to make great Xiao Lanterns back in the day. Our neighbors liked them so much that they asked me to make some for them too.",
            "nextDialogs": [
              "718180307"
            ]
          },
          "718180307": {
            "id": "718180307",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Xiao Lanterns are so beautiful, they really light up each Lantern Rite... Wait, I'll hang it for you...",
            "nextDialogs": [
              "718180308"
            ]
          },
          "718180308": {
            "id": "718180308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let me hang it up.",
            "nextDialogs": [
              "718180309"
            ]
          },
          "718180309": {
            "id": "718180309",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Alright, just be careful. Don't hurt yourself..."
          }
        }
      }
    },
    {
      "subId": "7181804",
      "subQuestName": "Talk to Jiangcheng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7181805",
      "subQuestName": "Hang the Xiao Lantern on the house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180501"
        ],
        "dialogs": {
          "718180501": {
            "id": "718180501",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "I'm really grateful for your help. If I'd gone there on my own, it would've taken me hours to get everything done.",
            "nextDialogs": [
              "718180502"
            ]
          },
          "718180502": {
            "id": "718180502",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "I didn't want to leave Grandpa Jiangcheng on his own right before the festival...",
            "nextDialogs": [
              "718180503"
            ]
          },
          "718180503": {
            "id": "718180503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What about you...",
            "nextDialogs": [
              "718180504"
            ]
          },
          "718180504": {
            "id": "718180504",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Me... I'm going back to the mill. There's still much work to be done.",
            "nextDialogs": [
              "718180505"
            ]
          },
          "718180505": {
            "id": "718180505",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "I inherited the mill when my father passed away. I left my job at Liyue Harbor to continue the family tradition.",
            "nextDialogs": [
              "718180506"
            ]
          },
          "718180506": {
            "id": "718180506",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "I don't know if it makes sense, but doing the same things he used to do, being in the same environment, it makes me very nostalgic.",
            "nextDialogs": [
              "718180507"
            ]
          },
          "718180507": {
            "id": "718180507",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "I often recall the many things that my father used to tell me, especially during this time of the year...",
            "nextDialogs": [
              "718180508"
            ]
          },
          "718180508": {
            "id": "718180508",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Oh, I almost forgot. With Grandpa Jiangcheng on my mind, I didn't make a Xiao Lantern for myself.",
            "nextDialogs": [
              "718180509"
            ]
          },
          "718180509": {
            "id": "718180509",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "The problem is I didn't leave any spare materials either...",
            "nextDialogs": [
              "718180510"
            ]
          },
          "718180510": {
            "id": "718180510",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "I'm afraid I won't get everything done in time if I go looking for materials now... Traveler, would you mind collecting some for me?",
            "nextDialogs": [
              "718180511"
            ]
          },
          "718180511": {
            "id": "718180511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not at all.",
            "nextDialogs": [
              "718180512"
            ]
          },
          "718180512": {
            "id": "718180512",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "I really appreciate it."
          }
        }
      }
    },
    {
      "subId": "7181806",
      "subQuestName": "Talk to Jiangcheng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718180401"
        ],
        "dialogs": {
          "718180401": {
            "id": "718180401",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Did you hang the Xiao Lantern? Truly breathtaking. The upcoming year is bound to be another great one.",
            "nextDialogs": [
              "718180404"
            ]
          },
          "718180404": {
            "id": "718180404",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Grandpa Jiangcheng, it's time for us to leave now. We still have a few errands to run. I'll visit you again soon.",
            "nextDialogs": [
              "718180405"
            ]
          },
          "718180405": {
            "id": "718180405",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "I see... Young people like you always have something to do... Can't get a moment's respite...",
            "nextDialogs": [
              "718180406"
            ]
          },
          "718180406": {
            "id": "718180406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Goodbye.",
            "nextDialogs": [
              "718180407"
            ]
          },
          "718180407": {
            "id": "718180407",
            "speakerId": 2137,
            "speakerName": "Jiangcheng",
            "text": "Ah, sure. Dear... don't forget to look after our land..."
          }
        }
      }
    },
    {
      "subId": "7181807",
      "subQuestName": "Follow Ms. Bai back to the mill",

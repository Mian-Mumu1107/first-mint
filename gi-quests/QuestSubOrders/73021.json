    {
      "subId": "7302103",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730210301"
        ],
        "dialogs": {
          "730210301": {
            "id": "730210301",
            "speakerId": 1003,
            "speakerName": "Arapas",
            "text": "My soup... *sob* How could this happen...",
            "nextDialogs": [
              "730210302"
            ]
          },
          "730210302": {
            "id": "730210302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Leave quietly...)"
          }
        }
      }
    },
    {
      "subId": "7302106",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730210601"
        ],
        "dialogs": {
          "730210601": {
            "id": "730210601",
            "speakerId": 1003,
            "speakerName": "Arapas",
            "text": "Hmph! Both of you are bad Nara! Don't even think about tricking me with water from somewhere else!"
          }
        }
      }
    },
    {
      "subId": "7302107",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730210701"
        ],
        "dialogs": {
          "730210701": {
            "id": "730210701",
            "speakerId": 1004,
            "speakerName": "Leaf With Careless Penmanship",
            "text": "(A huge leaf. Someone has written on it with messy handwriting...)",
            "nextDialogs": [
              "730210702"
            ]
          },
          "730210702": {
            "id": "730210702",
            "speakerId": 1004,
            "speakerName": "Leaf With Careless Penmanship",
            "text": "\"...The 17th time frost covered the leaves. After some tests, I noticed that water from tributaries is filled with sand and mud. It has an earthen taste. Not acceptable.\"",
            "nextDialogs": [
              "730210703"
            ]
          },
          "730210703": {
            "id": "730210703",
            "speakerId": 1004,
            "speakerName": "Leaf With Careless Penmanship",
            "text": "\"...The 30th time frost covered the leaves. It's raining again. Not acceptable.\"",
            "nextDialogs": [
              "730210704"
            ]
          },
          "730210704": {
            "id": "730210704",
            "speakerId": 1004,
            "speakerName": "Leaf With Careless Penmanship",
            "text": "\"...The 60th time frost covered the leaves. After some tests, I noticed that water from a river's main stem makes much more aromatic soup, but it still isn't enough. Not acceptable.\"",
            "nextDialogs": [
              "730210705"
            ]
          },
          "730210705": {
            "id": "730210705",
            "speakerId": 1004,
            "speakerName": "Leaf With Careless Penmanship",
            "text": "\"...The 80th time frost covered the leaves. It rained as soon as I finished my soup. Luckily, I wore a hat. Hmm, the quality of this water isn't bad.\""
          }
        }
      }
    }
  ]
}
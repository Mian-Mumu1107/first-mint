  "subQuests": [
    {
      "subId": "7302101",
      "subQuestName": "Look for Arapas",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730210101"
        ],
        "dialogs": {
          "730210101": {
            "id": "730210101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa, what's cooking in there? Paimon's mouth is watering from just a whiff of it!",
            "nextDialogs": [
              "730210102"
            ]
          },
          "730210102": {
            "id": "730210102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It looks like some kind of soup. Hmm... Paimon can't tell what's inside...",
            "nextDialogs": [
              "730210103"
            ]
          },
          "730210103": {
            "id": "730210103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Hey, {NICKNAME}...",
            "nextDialogs": [
              "730210104"
            ]
          },
          "730210104": {
            "id": "730210104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What is it?",
            "nextDialogs": [
              "730210105"
            ]
          },
          "730210105": {
            "id": "730210105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "The person cooking it isn't here, and it smells so good. Let's have a mouthful while it's left unattended.",
            "nextDialogs": [
              "730210107",
              "730210109"
            ]
          },
          "730210107": {
            "id": "730210107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yay!",
            "nextDialogs": [
              "730210112"
            ]
          },
          "730210112": {
            "id": "730210112",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "The pot is smaller than it looks.\\nThe soup within it is all gone just like that.",
            "nextDialogs": [
              "730210113"
            ]
          },
          "730210113": {
            "id": "730210113",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ahh... Huh? It smells good, but why doesn't Paimon taste anything?",
            "nextDialogs": [
              "730210114"
            ]
          },
          "730210114": {
            "id": "730210114",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Great Aramuhukunda! What are you Nara doing!?",
            "nextDialogs": [
              "730210115"
            ]
          },
          "730210115": {
            "id": "730210115",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "A—Aranara? Where did you come from?",
            "nextDialogs": [
              "730210116"
            ]
          },
          "730210116": {
            "id": "730210116",
            "speakerId": 1003,
            "speakerName": "Arapas",
            "text": "From underground! Forget that, why are you drinking my soup? Arapas worked very hard on that!"
          },
          "730210109": {
            "id": "730210109",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon is just so curious. Uh, Paimon will just take one mouthful, just one!",
            "nextDialogs": [
              "730210110"
            ]
          },
          "730210110": {
            "id": "730210110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What if you get a tummy ache after?",
            "nextDialogs": [
              "730210111"
            ]
          },
          "730210111": {
            "id": "730210111",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmph! Don't you underestimate Paimon!"
          }
        }
      }
    },
    {
      "subId": "7302102",
      "subQuestName": "Investigate the pot emitting the aroma",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

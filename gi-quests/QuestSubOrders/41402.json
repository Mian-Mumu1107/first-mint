{
  "lineCounts": {
    "Ji Tong": 33,
    "Player": 13
  },
  "subQuests": [
    {
      "subId": "4140201",
      "subQuestName": "Talk to Ji Tong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414020101"
        ],
        "dialogs": {
          "414020101": {
            "id": "414020101",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "Ah, hello. Just the person I wanted to speak to.",
            "nextDialogs": [
              "414020104"
            ]
          },
          "414020104": {
            "id": "414020104",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "Nope, no need. I've figured out what it was.",
            "nextDialogs": [
              "414020105"
            ]
          },
          "414020105": {
            "id": "414020105",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "I finally managed to track down the merchant the other day. The one who sold it to me in the first place.",
            "nextDialogs": [
              "414020106"
            ]
          },
          "414020106": {
            "id": "414020106",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "I told him there was a problem with the Kamera he sold me, but he was having none of it.",
            "nextDialogs": [
              "414020107"
            ]
          },
          "414020107": {
            "id": "414020107",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "Luckily I had all the photos you took for me. Without them, I'd have had no way of convincing him.",
            "nextDialogs": [
              "414020108"
            ]
          },
          "414020108": {
            "id": "414020108",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "After taking a look at your photos, he finally agreed to take a look at the Kamera he sold to me.",
            "nextDialogs": [
              "414020109"
            ]
          },
          "414020109": {
            "id": "414020109",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "Yesterday, he came to see me and brought a bottle of some sort of potion with him.",
            "nextDialogs": [
              "414020110"
            ]
          },
          "414020110": {
            "id": "414020110",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "He explained that this Kamera works differently from regular models. You need to add some of this potion to it to make sure the photos turn out normal.",
            "nextDialogs": [
              "414020111"
            ]
          },
          "414020111": {
            "id": "414020111",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "If you don't add any, the photos turn out just like yours did. Just pages of color, rather than clear images."
          }
        }
      }
    },
    {
      "subId": "4140202",
      "subQuestName": "Talk to Ji Tong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414020201"
        ],
        "dialogs": {
          "414020201": {
            "id": "414020201",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "Traveler, hold on a second.",
            "nextDialogs": [
              "414020202"
            ]
          },
          "414020202": {
            "id": "414020202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's up?",
            "nextDialogs": [
              "414020203"
            ]
          },
          "414020203": {
            "id": "414020203",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "I know this is a bit sudden, but... Do you have any interest in Kameras?",
            "nextDialogs": [
              "414020206"
            ]
          },
          "414020206": {
            "id": "414020206",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "Well, this Kamera here is no ordinary Kamera. It uses the latest technology from Fontaine.",
            "nextDialogs": [
              "414020207"
            ]
          },
          "414020207": {
            "id": "414020207",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "The photos printed by this model all come with a unique effect not offered by standard Kameras."
          }
        }
      }
    },
    {
      "subId": "4140203",
      "subQuestName": "Talk to Ji Tong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414020301"
        ],
        "dialogs": {
          "414020301": {
            "id": "414020301",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "Alright, this Kamera is yours to keep. Take care of it.",
            "nextDialogs": [
              "414020304"
            ]
          },
          "414020304": {
            "id": "414020304",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "There's enough potion in there for you to get a good amount of use out of it. Once it runs out... Well, you know where to find me, right?",
            "nextDialogs": [
              "414020305"
            ]
          },
          "414020305": {
            "id": "414020305",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "While we're on the subject, I'm planning to talk to my contact about importing some new kinds of potions for the Kamera.",
            "nextDialogs": [
              "414020306"
            ]
          },
          "414020306": {
            "id": "414020306",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "If you find that's something that interests you, I hope to see you here again in the future.",
            "nextDialogs": [
              "414020307"
            ]
          },
          "414020307": {
            "id": "414020307",
            "speakerId": 30044,
            "speakerName": "Ji Tong",
            "text": "Thought I was just buying a Kamera, turns out I was buying a whole business venture..."
          }
        }
      }
    }
  ]
}
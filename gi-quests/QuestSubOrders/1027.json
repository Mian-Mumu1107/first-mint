      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10270101"
        ],
        "dialogs": {
          "10270101": {
            "id": "10270101",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "That's it, I wanna take another look. And this time, I, Arataki \"The One and Oni,\" will...",
            "nextDialogs": [
              "10270102"
            ]
          },
          "10270102": {
            "id": "10270102",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Boss!",
            "nextDialogs": [
              "10270103"
            ]
          },
          "10270103": {
            "id": "10270103",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Whoa! What's up, sourpuss?",
            "nextDialogs": [
              "10270104"
            ]
          },
          "10270104": {
            "id": "10270104",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Time for some Roasted Lavender Melon.",
            "nextDialogs": [
              "10270105"
            ]
          },
          "10270105": {
            "id": "10270105",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Huh? We're trapped in a life and death situation underground, and you're telling me it's time for Roasted Lavender Melon?",
            "nextDialogs": [
              "10270106"
            ]
          },
          "10270106": {
            "id": "10270106",
            "speakerId": 12544,
            "speakerName": "Ushi",
            "text": "Moo! Moo.",
            "nextDialogs": [
              "10270107"
            ]
          },
          "10270107": {
            "id": "10270107",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Interesting, you hear that? Ushi says you're completely right... Wait, hold on, whose side are you on, Beefcake?",
            "nextDialogs": [
              "10270108"
            ]
          },
          "10270108": {
            "id": "10270108",
            "speakerId": 12544,
            "speakerName": "Ushi",
            "text": "Moo...",
            "nextDialogs": [
              "10270109"
            ]
          },
          "10270109": {
            "id": "10270109",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "It's important to stay replenished. We must keep our energy and morale up in preparation for facing the unknown.",
            "nextDialogs": [
              "10270110"
            ]
          },
          "10270110": {
            "id": "10270110",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Even Ushi knows that.",
            "nextDialogs": [
              "10270111"
            ]
          },
          "10270111": {
            "id": "10270111",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Fine, you two... Hey are you already eating?",
            "nextDialogs": [
              "10270112"
            ]
          },
          "10270112": {
            "id": "10270112",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Hold on, is it still warm? Oh, that does smell good... Mmm...",
            "nextDialogs": [
              "10270113"
            ]
          },
          "10270113": {
            "id": "10270113",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Fine, yeah, we'll have a quick snack and then we'll keep looking for a way out. Hey, don't eat them all, leave a couple for me!"
          }
        }
      }
    },
    {
      "subId": "102806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10280601"
        ],
        "dialogs": {
          "10280601": {
            "id": "10280601",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Who could've ever guessed we'd get trapped in a place like this. It's quite the predicament...",
            "nextDialogs": [
              "10280602"
            ]
          },
          "10280602": {
            "id": "10280602",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "For all the studying I've done in my life, all I know is how to land people in prison... I don't know the first thing about breaking out of one...",
            "nextDialogs": [
              "10280603"
            ]
          },
          "10280603": {
            "id": "10280603",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "I've even made a contract with my father to \"live a happy life\"... I can't give up hope now.",
            "nextDialogs": [
              "10280604"
            ]
          },
          "10280604": {
            "id": "10280604",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Try and stay positive... At least I've explored a new place and seen more of the world while reuniting with some old friends.",
            "nextDialogs": [
              "10280605"
            ]
          },
          "10280605": {
            "id": "10280605",
            "speakerId": 1030,
            "speakerName": "Yanfei",
            "text": "Uh-huh... Yeah, there's still a silver lining. I guess..."
          }
        }
      }
    },
    {
      "subId": "102807",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10280701"
        ],
        "dialogs": {
          "10280701": {
            "id": "10280701",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "Our situation is grim. There doesn't appear to be a way out for now. We should be prepared to stay for a while.",
            "nextDialogs": [
              "10280702"
            ]
          },
          "10280702": {
            "id": "10280702",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "Fortunately, we don't seem to lack supplies, and even our motley crew has people who can keep their cool when the stakes are high.",
            "nextDialogs": [
              "10280703"
            ]
          },
          "10280703": {
            "id": "10280703",
            "speakerId": 1048,
            "speakerName": "Yelan",
            "text": "Just focus on taking care of yourselves, I'll figure out the rest."
          }
        }
      }
    },

    {
      "subId": "1204110",
      "subQuestName": "Talk to Ei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120410401"
        ],
        "dialogs": {
          "120410401": {
            "id": "120410401",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "We're finally here. The entrance should be nearby...",
            "nextDialogs": [
              "120410402"
            ]
          },
          "120410402": {
            "id": "120410402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa, where'd that torii gate come from?",
            "nextDialogs": [
              "120410403"
            ]
          },
          "120410403": {
            "id": "120410403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you alright?",
            "nextDialogs": [
              "120410404"
            ]
          },
          "120410404": {
            "id": "120410404",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "It's getting worse again... But it's fine, I'm about to put an end to it all.",
            "nextDialogs": [
              "120410405"
            ]
          },
          "120410405": {
            "id": "120410405",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "This is a place I once sealed off with my own hands... The entrance to Raiden Makoto's realm of consciousness.",
            "nextDialogs": [
              "120410406"
            ]
          },
          "120410406": {
            "id": "120410406",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "It looks like \"she\" will no longer allow me to do with this body as I please.",
            "nextDialogs": [
              "120410407"
            ]
          },
          "120410407": {
            "id": "120410407",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? What are you talking about? And who is \"she\" — Makoto?",
            "nextDialogs": [
              "120410408"
            ]
          },
          "120410408": {
            "id": "120410408",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "Follow me.",
            "nextDialogs": [
              "120410409"
            ]
          },
          "120410409": {
            "id": "120410409",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Where are we g— aah, aaah aaaah!!!"
          }
        }
      }
    },

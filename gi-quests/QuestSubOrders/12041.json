  "subQuests": [
    {
      "subId": "1204101",
      "subQuestName": "Continue the pursuit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120410101"
        ],
        "dialogs": {
          "120410101": {
            "id": "120410101",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "Once again, please leave them to me.",
            "nextDialogs": [
              "120410102"
            ]
          },
          "120410102": {
            "id": "120410102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, hey! A—Are you sure you're alright? You're scaring us!",
            "nextDialogs": [
              "120410103"
            ]
          },
          "120410103": {
            "id": "120410103",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "Fear not. Fighting is what I do best."
          }
        }
      }
    },
    {
      "subId": "1204116",
      "subQuestName": "Continue the pursuit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1204102",
      "subQuestName": "Continue the pursuit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120410201"
        ],
        "dialogs": {
          "120410201": {
            "id": "120410201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ei, maybe you should leave this one to us.",
            "nextDialogs": [
              "120410204"
            ]
          },
          "120410204": {
            "id": "120410204",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "I...",
            "nextDialogs": [
              "120410205"
            ]
          },
          "120410205": {
            "id": "120410205",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "My apologies.",
            "nextDialogs": [
              "120410206"
            ]
          },
          "120410206": {
            "id": "120410206",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Don't worry about it! Just take a breather and get your strength back.",
            "nextDialogs": [
              "120410207"
            ]
          },
          "120410207": {
            "id": "120410207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We'll deal with the monsters!",
            "nextDialogs": [
              "120410208"
            ]
          },
          "120410208": {
            "id": "120410208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Look... that's the same light again."
          }
        }
      }
    },
    {
      "subId": "1204103",
      "subQuestName": "Continue the pursuit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120410301"
        ],
        "dialogs": {
          "120410301": {
            "id": "120410301",
            "speakerId": 1002,
            "speakerName": "Fujiki",
            "text": "It seems like their attacks are finally over.",
            "nextDialogs": [
              "120410302"
            ]
          },
          "120410302": {
            "id": "120410302",
            "speakerId": 1003,
            "speakerName": "Fukami",
            "text": "Huh, I've never fought so fiercely before!",
            "nextDialogs": [
              "120410303"
            ]
          },
          "120410303": {
            "id": "120410303",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "Thank you all...",
            "nextDialogs": [
              "120410304"
            ]
          },
          "120410304": {
            "id": "120410304",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Umm... Are you okay? Maybe you should keep resting...",
            "nextDialogs": [
              "120410305"
            ]
          },
          "120410305": {
            "id": "120410305",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "I'm fine. I feel much better already.",
            "nextDialogs": [
              "120410306"
            ]
          },
          "120410306": {
            "id": "120410306",
            "speakerId": 1002,
            "speakerName": "Fujiki",
            "text": "You fought phenomenally. It was truly awe-inspiring.",
            "nextDialogs": [
              "120410307"
            ]
          },
          "120410307": {
            "id": "120410307",
            "speakerId": 1002,
            "speakerName": "Fujiki",
            "text": "The monsters will definitely come back. And when they do, it'll be more than a few rifthounds this time.",
            "nextDialogs": [
              "120410308"
            ]
          },
          "120410308": {
            "id": "120410308",
            "speakerId": 1002,
            "speakerName": "Fujiki",
            "text": "Quickly, escort Her Excellency back to Inazuma City, and regroup with the general's forces as soon as possible.",
            "nextDialogs": [
              "120410309"
            ]
          },
          "120410309": {
            "id": "120410309",
            "speakerId": 1003,
            "speakerName": "Fukami",
            "text": "When everyone sees the Almighty Shogun safely returning, their spirits will be lifted.",
            "nextDialogs": [
              "120410310"
            ]
          },
          "120410310": {
            "id": "120410310",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well... what're you guys gonna do?",
            "nextDialogs": [
              "120410311"
            ]
          },
          "120410311": {
            "id": "120410311",
            "speakerId": 1002,
            "speakerName": "Fujiki",
            "text": "We will stay here and guard against the monsters' advance. We cannot afford to let them get any further.",
            "nextDialogs": [
              "120410312"
            ]
          },
          "120410312": {
            "id": "120410312",
            "speakerId": 1002,
            "speakerName": "Fujiki",
            "text": "We are brothers in arms. As long as we stick together, we can face any number of monsters that come our way.",
            "nextDialogs": [
              "120410313"
            ]
          },
          "120410313": {
            "id": "120410313",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "*gulp*...",
            "nextDialogs": [
              "120410316"
            ]
          },
          "120410316": {
            "id": "120410316",
            "speakerId": 1003,
            "speakerName": "Fukami",
            "text": "Just leave it to us! Fighting is what we do best!",
            "nextDialogs": [
              "120410317"
            ]
          },
          "120410317": {
            "id": "120410317",
            "speakerId": 1003,
            "speakerName": "Fukami",
            "text": "But the Almighty Shogun is the only one of us with the power to change the present state of affairs. Only Her Excellency can turn back the tide of despair and lead us onward into the future.",
            "nextDialogs": [
              "120410318"
            ]
          },
          "120410318": {
            "id": "120410318",
            "speakerId": 1003,
            "speakerName": "Fukami",
            "text": "No matter what kind of threat faces Inazuma, we will always place our faith in the Almighty Shogun!",
            "nextDialogs": [
              "120410319"
            ]
          },
          "120410319": {
            "id": "120410319",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "...",
            "nextDialogs": [
              "120410320"
            ]
          },
          "120410320": {
            "id": "120410320",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "Thank you all very much. I promise you that I will create a bright future for Inazuma.",
            "nextDialogs": [
              "120410321"
            ]
          },
          "120410321": {
            "id": "120410321",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "I should not have left it this late to make this promise. But from this moment forth, know that I shall be true to my word.",
            "nextDialogs": [
              "120410322"
            ]
          },
          "120410322": {
            "id": "120410322",
            "speakerId": 1003,
            "speakerName": "Fukami",
            "text": "Don't worry, Your Excellency. We will never doubt your word as long as we live!",
            "nextDialogs": [
              "120410323"
            ]
          },
          "120410323": {
            "id": "120410323",
            "speakerId": 1003,
            "speakerName": "Fukami",
            "text": "With you leading us, we will claim back everything that Inazuma has lost!",
            "nextDialogs": [
              "120410324"
            ]
          },
          "120410324": {
            "id": "120410324",
            "speakerId": 1002,
            "speakerName": "Fujiki",
            "text": "Glory to the Shogun!",
            "nextDialogs": [
              "120410325"
            ]
          },
          "120410325": {
            "id": "120410325",
            "speakerId": 1004,
            "speakerName": "Samurai",
            "text": "Glory to the Shogun!",
            "nextDialogs": [
              "120410326"
            ]
          },
          "120410326": {
            "id": "120410326",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...They're gone."
          }
        }
      }
    },
    {
      "subId": "1204104",
      "subQuestName": "Talk to Ei",
      "sceneId": null,
      "locations": [],

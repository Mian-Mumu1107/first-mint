    {
      "subId": "1204108",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120410801"
        ],
        "dialogs": {
          "120410801": {
            "id": "120410801",
            "speakerId": 1006,
            "speakerName": "Observe Teacup",
            "text": "(A cup of tea has been left for Furuyama.)",
            "nextDialogs": [
              "120410802"
            ]
          },
          "120410802": {
            "id": "120410802",
            "speakerId": 1006,
            "speakerName": "Observe Teacup",
            "text": "(How much did he actually perceive, and how much did he let on?)"
          }
        }
      }
    },
    {
      "subId": "1204199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120419901"
        ],
        "dialogs": {
          "120419901": {
            "id": "120419901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We should go. Let's keep following the traces.",
            "nextDialogs": [
              "120419902"
            ]
          },
          "120419902": {
            "id": "120419902",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "Very well. Based on my investigation so far, I believe this next pack of monsters should be the last.",
            "nextDialogs": [
              "120419903"
            ]
          },
          "120419903": {
            "id": "120419903",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "Ugh...",
            "nextDialogs": [
              "120419904"
            ]
          },
          "120419904": {
            "id": "120419904",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Are you alright?",
            "nextDialogs": [
              "120419905"
            ]
          },
          "120419905": {
            "id": "120419905",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "I'm fine, I...",
            "nextDialogs": [
              "120419906"
            ]
          },
          "120419906": {
            "id": "120419906",
            "speakerId": 1003,
            "speakerName": "Fukami",
            "text": "Protect the Almighty Shogun!",
            "nextDialogs": [
              "120419907"
            ]
          },
          "120419907": {
            "id": "120419907",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "In the end, even the proud and mighty oni maiden was cut down and disgraced...",
            "nextDialogs": [
              "120419908"
            ]
          },
          "120419908": {
            "id": "120419908",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "Though your blade has been cleansed of her blood and filth, never shall it shine as brightly as it once did."
          }
        }
      }
    }
  ]
}
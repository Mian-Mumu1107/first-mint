      }
    },
    {
      "subId": "1204105",
      "subQuestName": "Defeat the Rifthounds",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120410501"
        ],
        "dialogs": {
          "120410501": {
            "id": "120410501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ugh... Paimon's dizzy, where did we get sucked into this time...",
            "nextDialogs": [
              "120410502"
            ]
          },
          "120410502": {
            "id": "120410502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa! This place...",
            "nextDialogs": [
              "120410503"
            ]
          },
          "120410503": {
            "id": "120410503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It does look a lot like the Plane of Euthymia.",
            "nextDialogs": [
              "120410504"
            ]
          },
          "120410504": {
            "id": "120410504",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Look! Look, over there!",
            "nextDialogs": [
              "120410505"
            ]
          },
          "120410505": {
            "id": "120410505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's another Ei!",
            "nextDialogs": [
              "120410506"
            ]
          },
          "120410506": {
            "id": "120410506",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "We meet again, Traveler.",
            "nextDialogs": [
              "120410507"
            ]
          },
          "120410507": {
            "id": "120410507",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "This body is an assistant to the one within. But it is also the guardian of the rules.",
            "nextDialogs": [
              "120410508"
            ]
          },
          "120410508": {
            "id": "120410508",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "Should the one within wish to stray from the rules, this body shall stand in her way.",
            "nextDialogs": [
              "120410509"
            ]
          },
          "120410509": {
            "id": "120410509",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, Paimon knows that voice... is that... the puppet!?",
            "nextDialogs": [
              "120410510"
            ]
          },
          "120410510": {
            "id": "120410510",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "You have wandered the realm in my body, and you appear to have grasped the true essence of eternity.",
            "nextDialogs": [
              "120410511"
            ]
          },
          "120410511": {
            "id": "120410511",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "You believe your present self has greater certainty than your former self. Thus, you believe your present self is correct. Don't you?",
            "nextDialogs": [
              "120410512"
            ]
          },
          "120410512": {
            "id": "120410512",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "But have you really been enlightened with new ideas? Or have you been degraded by irreversible erosion?",
            "nextDialogs": [
              "120410513"
            ]
          },
          "120410513": {
            "id": "120410513",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "I'm here to show you my answer.",
            "nextDialogs": [
              "120410514"
            ]
          },
          "120410514": {
            "id": "120410514",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "We are both warriors, and the dialogue we must now have shall be conducted by the blade alone.",
            "nextDialogs": [
              "120410515"
            ]
          },
          "120410515": {
            "id": "120410515",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uhhh, wait, wait, wait, the atmosphere in here just took a turn for the worse!",
            "nextDialogs": [
              "120410516"
            ]
          },
          "120410516": {
            "id": "120410516",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A—Are you, uh, are you alright now?",
            "nextDialogs": [
              "120410517"
            ]
          },
          "120410517": {
            "id": "120410517",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "The discomfort I was experiencing earlier was caused by the Shogun rejecting my continued use of her body.",
            "nextDialogs": [
              "120410518"
            ]
          },
          "120410518": {
            "id": "120410518",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "As she indicates, once I started entertaining the idea of change, I became hostile in her eyes.",
            "nextDialogs": [
              "120410519"
            ]
          },
          "120410519": {
            "id": "120410519",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "But inside a realm of consciousness, I exist independently of her. She cannot affect me in this way.",
            "nextDialogs": [
              "120410520"
            ]
          },
          "120410520": {
            "id": "120410520",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "Though she is a puppet, the Shogun has her own consciousness, too. When necessary, she appears here to confront me.",
            "nextDialogs": [
              "120410523"
            ]
          },
          "120410523": {
            "id": "120410523",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh... Paimon gets that everyone has their internal battles and stuff, but... not like this! It's a bit extreme!",
            "nextDialogs": [
              "120410524"
            ]
          },
          "120410524": {
            "id": "120410524",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ei's showdown with the Shogun... Never thought we'd see that day.",
            "nextDialogs": [
              "120410525"
            ]
          },
          "120410525": {
            "id": "120410525",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "The rules I set for the Shogun are... no, the Shogun herself is the manifestation of my past ideals, the very foundation stone of eternity. It shall not be easily swayed.",
            "nextDialogs": [
              "120410526"
            ]
          },
          "120410526": {
            "id": "120410526",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "I would not try to change her if it wasn't necessary.",
            "nextDialogs": [
              "120410527"
            ]
          },
          "120410527": {
            "id": "120410527",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Isn't there any other way? Can't you... talk it through? ...Or something?",
            "nextDialogs": [
              "120410528"
            ]
          },
          "120410528": {
            "id": "120410528",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ei isn't someone who leaves herself an escape route.",
            "nextDialogs": [
              "120410529"
            ]
          },
          "120410529": {
            "id": "120410529",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But they both just want the best for Inazuma...",
            "nextDialogs": [
              "120410530"
            ]
          },
          "120410530": {
            "id": "120410530",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "My form is a symbol of supreme majesty, in which has been vested power over all the realm. It is the cohesive embodiment of all that constitutes the \"Raiden Shogun.\"",
            "nextDialogs": [
              "120410531"
            ]
          },
          "120410531": {
            "id": "120410531",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "It inherits Ei's pain — the pain of inevitable loss that comes as she moves forward. So too does it inherit her determination to reach eternity.",
            "nextDialogs": [
              "120410532"
            ]
          },
          "120410532": {
            "id": "120410532",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "Every action undertaken is for the sake of resisting erosion.",
            "nextDialogs": [
              "120410533"
            ]
          },
          "120410533": {
            "id": "120410533",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "Determination, courage, love, hatred... All of these will be degraded and distorted by the incessant flow of time.",
            "nextDialogs": [
              "120410534"
            ]
          },
          "120410534": {
            "id": "120410534",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "Only rules shall remain constant for eternity.",
            "nextDialogs": [
              "120410535"
            ]
          },
          "120410535": {
            "id": "120410535",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "Those were my thoughts when I created you.",
            "nextDialogs": [
              "120410536"
            ]
          },
          "120410536": {
            "id": "120410536",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "Now they are towering obstacles that I have no choice but to overcome.",
            "nextDialogs": [
              "120410537"
            ]
          },
          "120410537": {
            "id": "120410537",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "You wish to make yourself my enemy?",
            "nextDialogs": [
              "120410538"
            ]
          },
          "120410538": {
            "id": "120410538",
            "speakerId": 1005,
            "speakerName": "Raiden Shogun",
            "text": "I am your past, the everlasting law, the guardian of eternity.",
            "nextDialogs": [
              "120410539"
            ]
          },
          "120410539": {
            "id": "120410539",
            "speakerId": 1000,
            "speakerName": "Ei",
            "text": "And I am she who promised a dream to her subjects... Raiden Ei."
          }
        }
      }
    },

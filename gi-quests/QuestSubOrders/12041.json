    {
      "subId": "1204107",
      "subQuestName": "Aid the samurai in defeating the Rifthounds",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120410701"
        ],
        "dialogs": {
          "120410701": {
            "id": "120410701",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Looks like we got kicked out...",
            "nextDialogs": [
              "120410702"
            ]
          },
          "120410702": {
            "id": "120410702",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What do we do? Are we really just gonna leave Ei and the Shogun to keep on duking it out in there forever!?",
            "nextDialogs": [
              "120410703"
            ]
          },
          "120410703": {
            "id": "120410703",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "She was making sense, and maybe this is the only way to change the Shogun's rules, but still...",
            "nextDialogs": [
              "120410706"
            ]
          },
          "120410706": {
            "id": "120410706",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Right? Also, Ei can be pretty stubborn at times, and has a history of rushing into difficult situations...",
            "nextDialogs": [
              "120410707"
            ]
          },
          "120410707": {
            "id": "120410707",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What if she gets too obsessed with winning, and she forgets why she's there in the first place? It could happen... And then she might never leave again!"
          }
        }
      }
    },

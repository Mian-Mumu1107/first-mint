  "subQuests": [
    {
      "subId": "2051201",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205120101"
        ],
        "dialogs": {
          "205120101": {
            "id": "205120101",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "This prescription's just getting weirder...",
            "nextDialogs": [
              "205120102"
            ]
          },
          "205120102": {
            "id": "205120102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How's Anna doing?",
            "nextDialogs": [
              "205120103"
            ]
          },
          "205120103": {
            "id": "205120103",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Oh, it's you. Well, it might sound hard to believe, but Anna says that she's been feeling much better.",
            "nextDialogs": [
              "205120104"
            ]
          },
          "205120104": {
            "id": "205120104",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Perhaps that doctor's prescription is really working? I can scarcely believe it myself.",
            "nextDialogs": [
              "205120105"
            ]
          },
          "205120105": {
            "id": "205120105",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Well, regardless of whether it's true or not, it's best to keep going.",
            "nextDialogs": [
              "205120106"
            ]
          },
          "205120106": {
            "id": "205120106",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "The prescription this time is... Hmm. Could you help me find \"Thick Condensate of a Hydro Slime\"?",
            "nextDialogs": [
              "205120108",
              "205120113",
              "205120118"
            ]
          },
          "205120108": {
            "id": "205120108",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Um, really? I actually think the opposite is true.",
            "nextDialogs": [
              "205120109"
            ]
          },
          "205120109": {
            "id": "205120109",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "But at least it's easy to find. I've asked around, and they say that you can get Thick Condensate just by defeating Large Slimes.",
            "nextDialogs": [
              "205120110"
            ]
          },
          "205120110": {
            "id": "205120110",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "I've heard Jack say that you can lure Large Slimes out by constantly defeating smaller ones.",
            "nextDialogs": [
              "205120111"
            ]
          },
          "205120111": {
            "id": "205120111",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "I don't have that kind of combat skill, so I'm counting on you!"
          },
          "205120113": {
            "id": "205120113",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "And how do you know that? Have you tried it before? ...Um, why aren't you saying anything?",
            "nextDialogs": [
              "205120114"
            ]
          },
          "205120114": {
            "id": "205120114",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Whatever. Hydro Slimes should be quite easy to find. I've asked around, and others have said that you can get Thick Condensate by defeating Large Slimes.",
            "nextDialogs": [
              "205120115"
            ]
          },
          "205120115": {
            "id": "205120115",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "I've heard Jack say that you can lure Large Slimes out by constantly defeating smaller ones.",
            "nextDialogs": [
              "205120116"
            ]
          },
          "205120116": {
            "id": "205120116",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "I don't have that kind of combat skill, so I'm counting on you!"
          },
          "205120118": {
            "id": "205120118",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Well, that's good. Looks like you're well-versed in dealing with Slimes.",
            "nextDialogs": [
              "205120119"
            ]
          },
          "205120119": {
            "id": "205120119",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Thanks for agreeing to help. You should be able to get some Thick Condensate just by defeating Large Slimes.",
            "nextDialogs": [
              "205120120"
            ]
          },
          "205120120": {
            "id": "205120120",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "I've heard Jack say that you can lure Large Slimes out by constantly defeating smaller ones.",
            "nextDialogs": [
              "205120121"
            ]
          },
          "205120121": {
            "id": "205120121",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Well then, best of luck to you."
          }
        }
      }
    },
    {
      "subId": "2051202",
      "subQuestName": "Acquire some Thick Hydro Slime Condensate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205120201"
        ],
        "dialogs": {
          "205120201": {
            "id": "205120201",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Have you found it yet?",
            "nextDialogs": [
              "205120202"
            ]
          },
          "205120202": {
            "id": "205120202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet, no.",
            "nextDialogs": [
              "205120203"
            ]
          },
          "205120203": {
            "id": "205120203",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Well, it is combat we're talking about. Take some time to prepare, and I'll see you again."
          }
        }
      }
    },
    {
      "subId": "2051203",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205120301"
        ],
        "dialogs": {
          "205120301": {
            "id": "205120301",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Have you found it yet?",
            "nextDialogs": [
              "205120302"
            ]
          },
          "205120302": {
            "id": "205120302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I sure have.",
            "nextDialogs": [
              "205120303"
            ]
          },
          "205120303": {
            "id": "205120303",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "This... really does look quite rich.",
            "nextDialogs": [
              "205120304"
            ]
          },
          "205120304": {
            "id": "205120304",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Can you really use this to make medicine? I'll try it myself once it's done.",
            "nextDialogs": [
              "205120305"
            ]
          },
          "205120305": {
            "id": "205120305",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "If anything happens to me, please take Anna...",
            "nextDialogs": [
              "205120306"
            ]
          },
          "205120306": {
            "id": "205120306",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "...and place her in the care of Sister Grace.",
            "nextDialogs": [
              "205120307"
            ]
          },
          "205120307": {
            "id": "205120307",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "Tell her that I've gone to work somewhere far abroad. Please, that is my final request.",
            "nextDialogs": [
              "205120308"
            ]
          },
          "205120308": {
            "id": "205120308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hey, hey. You're giving yourself a scare.",
            "nextDialogs": [
              "205120309"
            ]
          },
          "205120309": {
            "id": "205120309",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "But this medicine does look that scary! Whatever the case, take this first.",
            "nextDialogs": [
              "205120310"
            ]
          },
          "205120310": {
            "id": "205120310",
            "speakerId": 1000,
            "speakerName": "Anthony",
            "text": "And remember what I said!"
          }
        }
      }
    }
  ]
}
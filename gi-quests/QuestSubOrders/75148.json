    {
      "subId": "7514801",
      "subQuestName": "Go to the Skyfire Circlet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751480101"
        ],
        "dialogs": {
          "751480101": {
            "id": "751480101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Chosen of Dragons, O Chosen of Dragons...",
            "nextDialogs": [
              "751480102"
            ]
          },
          "751480102": {
            "id": "751480102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ascend to the circlet's highest pinnacle — then hurl yourself into the Sacred Mountain's fire!",
            "nextDialogs": [
              "751480103"
            ]
          },
          "751480103": {
            "id": "751480103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Go forth and reveal it — break the golden seal, unveil the radiance of remnant flames unnumbered!",
            "nextDialogs": [
              "751480104"
            ]
          },
          "751480104": {
            "id": "751480104",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrroar...",
            "nextDialogs": [
              "751480105"
            ]
          },
          "751480105": {
            "id": "751480105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What's wrong? Did you see a bunch of strange words again?",
            "nextDialogs": [
              "751480108"
            ]
          },
          "751480108": {
            "id": "751480108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, you mean it's because we're getting closer to the volcano?",
            "nextDialogs": [
              "751480109"
            ]
          },
          "751480109": {
            "id": "751480109",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751480110"
            ]
          },
          "751480110": {
            "id": "751480110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...It's almost as if the person who's been talking to you all this time is in that mountain.",
            "nextDialogs": [
              "751480111"
            ]
          },
          "751480111": {
            "id": "751480111",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Anyway, since those things are showing up as we're getting closer to the volcano, that's gotta mean we're on the right track.",
            "nextDialogs": [
              "751480112"
            ]
          },
          "751480112": {
            "id": "751480112",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!"
          }
        }
      }
    },
    {
      "subId": "7514805",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751480501"
        ],
        "dialogs": {
          "751480501": {
            "id": "751480501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Was that a Q—Qucusaur?",
            "nextDialogs": [
              "751480502"
            ]
          },
          "751480502": {
            "id": "751480502",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Did it just grab that statue and jump... straight into the crater!?",
            "nextDialogs": [
              "751480503"
            ]
          },
          "751480503": {
            "id": "751480503",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That's gotta be the volcano's mouth, right? What a view...",
            "nextDialogs": [
              "751480504"
            ]
          },
          "751480504": {
            "id": "751480504",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... When we asked for directions earlier, weren't we told that there's a ton of gaseous phlogiston in the volcano's mouth?",
            "nextDialogs": [
              "751480505"
            ]
          },
          "751480505": {
            "id": "751480505",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh wait, that's right! We can <color=#00E1FFFF>find a way to pass through gaseous phlogiston</color>, just like the Qucusaurus from back there!",
            "nextDialogs": [
              "751480506"
            ]
          },
          "751480506": {
            "id": "751480506",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But, uh... *gulp* Kinda high up, aren't we?",
            "nextDialogs": [
              "751480508",
              "751480511"
            ]
          },
          "751480508": {
            "id": "751480508",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751480509"
            ]
          },
          "751480509": {
            "id": "751480509",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Err, you wanna go in too? Well... Ugh, alright. I—If that's the case, Paimon's not that scared anymore.",
            "nextDialogs": [
              "751480514"
            ]
          },
          "751480514": {
            "id": "751480514",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And it's not just that we're high up — don't forget about the gaseous phlogiston!",
            "nextDialogs": [
              "751480515"
            ]
          },
          "751480515": {
            "id": "751480515",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "A—Anyway, let's make sure we're all set before we go!"
          },
          "751480511": {
            "id": "751480511",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh, Paimon couldn't do that! Never mind the strength problem — think about the timing!",
            "nextDialogs": [
              "751480512"
            ]
          },
          "751480512": {
            "id": "751480512",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751480513"
            ]
          },
          "751480513": {
            "id": "751480513",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And you too! Stop \"rawring\" along with this craziness! *sigh* ...Y'know what, now you two've gone and killed all the tension!"
          }
        }
      }
    },

    {
      "subId": "7300219",
      "subQuestName": "Collect firewood",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730021901"
        ],
        "dialogs": {
          "730021901": {
            "id": "730021901",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "Ahh... I slept so well! I don't even remember falling asleep, sorry about that, hehe...",
            "nextDialogs": [
              "730021904"
            ]
          },
          "730021904": {
            "id": "730021904",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "Not really, I just ate a lot and was feeling so relaxed that I just...",
            "nextDialogs": [
              "730021905"
            ]
          },
          "730021905": {
            "id": "730021905",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "Ahem! Here's a little Forest Watcher trivia for you: When searching for a missing person in the forest, you want to feed them something that's easy to digest when you find them.",
            "nextDialogs": [
              "730021906"
            ]
          },
          "730021906": {
            "id": "730021906",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "Digestion consumes stamina. That's why you feel sleepy easily after eating. Or at least, that's what the Akademiya researchers say.",
            "nextDialogs": [
              "730021907"
            ]
          },
          "730021907": {
            "id": "730021907",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "#{NICKNAME}, Paimon, have you rested? You worked so hard yesterday..."
          }
        }
      }
    },
    {
      "subId": "7300209",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730020901"
        ],
        "dialogs": {
          "730020901": {
            "id": "730020901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yup, that should be enough!",
            "nextDialogs": [
              "730020902"
            ]
          },
          "730020902": {
            "id": "730020902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's go find Rana!"
          }
        }
      }
    },
    {
      "subId": "7300208",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730020801"
        ],
        "dialogs": {
          "730020801": {
            "id": "730020801",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "It's good to have you here. But still, don't push yourself."
          }
        }
      }
    },

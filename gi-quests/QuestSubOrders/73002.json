    {
      "subId": "7300213",
      "subQuestName": "Talk to Rana",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730021301"
        ],
        "dialogs": {
          "730021301": {
            "id": "730021301",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "Here we are. When I was little, I would often take this road to go down to the river valley to play.",
            "nextDialogs": [
              "730021302"
            ]
          },
          "730021302": {
            "id": "730021302",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "The Withering Zones are appearing so quickly now, and Tighnari and the others are too busy to deal with them in time. But it's a good thing we have you here now.",
            "nextDialogs": [
              "730021303"
            ]
          },
          "730021303": {
            "id": "730021303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Leave it to me.",
            "nextDialogs": [
              "730021304"
            ]
          },
          "730021304": {
            "id": "730021304",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "Okay! You made clean work of those Withering Zones before, but they're still dangerous. If it gets to be too much, be sure to leave the realm and take some rest."
          }
        }
      }
    },

    {
      "subId": "7300229",
      "subQuestName": "Talk to Rana",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730022001"
        ],
        "dialogs": {
          "730022001": {
            "id": "730022001",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "#Oh, {NICKNAME}, you're back! I was so worried...",
            "nextDialogs": [
              "730022002"
            ]
          },
          "730022002": {
            "id": "730022002",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "I was afraid you and Paimon had run off... or worse, that those alligators from before came back for revenge and hauled you both away!",
            "nextDialogs": [
              "730022003"
            ]
          },
          "730022003": {
            "id": "730022003",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Are alligators really that scary!? We saw that you were sleeping, so we went to take care of some other things...",
            "nextDialogs": [
              "730022004"
            ]
          },
          "730022004": {
            "id": "730022004",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "Sorry, I didn't even realize that I had fallen asleep, hehe...",
            "nextDialogs": [
              "730022007"
            ]
          },
          "730022007": {
            "id": "730022007",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "Not really, I just ate a lot and was feeling so relaxed that I just...",
            "nextDialogs": [
              "730022008"
            ]
          },
          "730022008": {
            "id": "730022008",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "Ahem! Here's a little Forest Watcher trivia for you: When searching for missing people in the forest, we make sure to feed them something that's easy to digest when we find them.",
            "nextDialogs": [
              "730022009"
            ]
          },
          "730022009": {
            "id": "730022009",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "Digestion consumes stamina. That's why you feel sleepy easily after eating. Or at least, that's what the Akademiya researchers say.",
            "nextDialogs": [
              "730022010"
            ]
          },
          "730022010": {
            "id": "730022010",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "#{NICKNAME}, Paimon, have you rested? You worked so hard yesterday..."
          }
        }
      }
    },

        "dialogs": {
          "730020519": {
            "id": "730020519",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "#Besides firewood, we have sufficient supplies of everything else here... Ah, {NICKNAME}, you're back! Have you collected enough firewood?",
            "nextDialogs": [
              "730020520"
            ]
          },
          "730020520": {
            "id": "730020520",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet...",
            "nextDialogs": [
              "730020521"
            ]
          },
          "730020521": {
            "id": "730020521",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "It's fine, leave it to me. Just stay here and rest up! Let me just clean up here and I'll go right away!",
            "nextDialogs": [
              "730020524"
            ]
          },
          "730020524": {
            "id": "730020524",
            "speakerId": 1000,
            "speakerName": "Rana",
            "text": "Alright. Thanks."
          }
        }
      }
    },

        "dialogs": {
          "140130101": {
            "id": "140130101",
            "speakerId": 13579,
            "speakerName": "Dulphy",
            "text": "I mean, of course I have some regrets, but...",
            "nextDialogs": [
              "140130102"
            ]
          },
          "140130102": {
            "id": "140130102",
            "speakerId": 13578,
            "speakerName": "Lauwick",
            "text": "There'll be plenty of opportunities in the future for us to tell the stories that we want on stage."
          }
        }
      }
    },
    {
      "subId": "1401303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140130301"
        ],
        "dialogs": {
          "140130301": {
            "id": "140130301",
            "speakerId": 13580,
            "speakerName": "Pauleau",
            "text": "I'm just finishing packing up. As soon as I'm done, I've got an interview with the Steambird to get to.",
            "nextDialogs": [
              "140130302"
            ]
          },
          "140130302": {
            "id": "140130302",
            "speakerId": 13580,
            "speakerName": "Pauleau",
            "text": "Thanks to all your help, the show was more perfect than we ever could have hoped for.",
            "nextDialogs": [
              "140130303"
            ]
          },
          "140130303": {
            "id": "140130303",
            "speakerId": 13580,
            "speakerName": "Pauleau",
            "text": "But most of all... I want to thank you for giving me the chance to finally say farewell to Aurelie."
          }
        }
      }
    },
    {
      "subId": "1401304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140130401"
        ],
        "dialogs": {
          "140130401": {
            "id": "140130401",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "It's ironic to think that in my whole time as a \"god,\" I could only ever dream of receiving this kind of power...",
            "nextDialogs": [
              "140130402"
            ]
          },
          "140130402": {
            "id": "140130402",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "And now that the gods have given me their blessing... It actually feels more like I'm finally able to take my fate in my own hands.",
            "nextDialogs": [
              "140130403"
            ]
          },
          "140130403": {
            "id": "140130403",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Is... is that how humans feel about it as well?"
          }
        }
      }
    },
    {
      "subId": "1401305",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140130501"
        ],
        "dialogs": {
          "140130501": {
            "id": "140130501",
            "speakerId": 13697,
            "speakerName": "Buraud",
            "text": "Now that the buzz has worn off, I feel ready to pass out."
          }
        }
      }
    },
    {
      "subId": "1401306",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140130601"
        ],
        "dialogs": {
          "140130601": {
            "id": "140130601",
            "speakerId": 13698,
            "speakerName": "Elain",
            "text": "Thank you so much. I feel like I've rekindled the passion I had when I first joined the troupe.",
            "nextDialogs": [
              "140130602"
            ]
          },
          "140130602": {
            "id": "140130602",
            "speakerId": 13698,
            "speakerName": "Elain",
            "text": "It might turn out to be too little, too late for me... But still, this has been the experience of a lifetime."
          }
        }
      }
    }
  ]

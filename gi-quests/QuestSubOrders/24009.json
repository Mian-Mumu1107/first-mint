  "subQuests": [
    {
      "subId": "2400901",
      "subQuestName": "Talk to Depierris",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240090101"
        ],
        "dialogs": {
          "240090101": {
            "id": "240090101",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Traveler! You've come at just the right time! I just found a wondrous photo-taking spot — all I need is a little help from you!",
            "nextDialogs": [
              "240090102"
            ]
          },
          "240090102": {
            "id": "240090102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Still looking for inspiration, are you?",
            "nextDialogs": [
              "240090103"
            ]
          },
          "240090103": {
            "id": "240090103",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Of course. This is far from enough materials — a single photo will not allow me to create a full picture.",
            "nextDialogs": [
              "240090104"
            ]
          },
          "240090104": {
            "id": "240090104",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "I usually need several dozen pictures — sometimes even a hundred — for use as reference material.",
            "nextDialogs": [
              "240090107"
            ]
          },
          "240090107": {
            "id": "240090107",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "As I've told you before, the focus of painting is \"creation.\"",
            "nextDialogs": [
              "240090108"
            ]
          },
          "240090108": {
            "id": "240090108",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "If you simply impress the things you see upon the canvas as-is, that is not \"painting\" — that is \"photography.\"",
            "nextDialogs": [
              "240090109"
            ]
          },
          "240090109": {
            "id": "240090109",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "What a painter must truly do is to use their sensitivity and aesthetic sense to observe the world around them, before curating, transforming, and editing it...",
            "nextDialogs": [
              "240090110"
            ]
          },
          "240090110": {
            "id": "240090110",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Until such a time as the most beautiful aspect of every object can be abstracted and then engraved upon the canvas to complete one painting."
          }
        }
      }
    },
    {
      "subId": "2400910",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240091001"
        ],
        "dialogs": {
          "240091001": {
            "id": "240091001",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Thank you for your help! This should be enough to fill my stomach...",
            "nextDialogs": [
              "240091002"
            ]
          },
          "240091002": {
            "id": "240091002",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Here, you've earned this. Now, to grab a few quick bites...",
            "nextDialogs": [
              "240091003"
            ]
          },
          "240091003": {
            "id": "240091003",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "It might be worth bringing biscuits that may be stored in my bag next time..."
          }
        }
      }
    },
    {
      "subId": "2400902",
      "subQuestName": "Talk to Depierris",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240090201"
        ],
        "dialogs": {
          "240090201": {
            "id": "240090201",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Let me see... Those friends of mine gave me some suggestions that I've written in my notebook.",
            "nextDialogs": [
              "240090202"
            ]
          },
          "240090202": {
            "id": "240090202",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Aquatic plants... waving... light and shadow... change... What was I writing? Had I had too much to drink? ... Yeah, that must've been it...",
            "nextDialogs": [
              "240090203"
            ]
          },
          "240090203": {
            "id": "240090203",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Ahem. Please help me go underwater and take a picture of those aquatic plants.",
            "nextDialogs": [
              "240090204"
            ]
          },
          "240090204": {
            "id": "240090204",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "It seems that I was quite interested in the lights and shadows upon the aquatic plants back when I wrote these notes."
          }
        }
      }
    },
    {
      "subId": "2400903",
      "subQuestName": "Take the required photo underwater",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2400911",
      "subQuestName": "Take the required photo underwater",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240091101"
        ],
        "dialogs": {
          "240091101": {
            "id": "240091101",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "It lacks tension... What's going on?",
            "nextDialogs": [
              "240091102"
            ]
          },
          "240091102": {
            "id": "240091102",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "I feel like we're missing something... decisive...",
            "nextDialogs": [
              "240091104",
              "240091106"
            ]
          },
          "240091104": {
            "id": "240091104",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "That's right — this Kamera is the engine of inspiration for my paintings.",
            "nextDialogs": [
              "240091107"
            ]
          },
          "240091107": {
            "id": "240091107",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "My name is Depierris, and I am a painter — most pleased to meet you, most pleased indeed!",
            "nextDialogs": [
              "240091108"
            ]
          },
          "240091108": {
            "id": "240091108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh... huh. Likewise...?",
            "nextDialogs": [
              "240091109"
            ]
          },
          "240091109": {
            "id": "240091109",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Now, I would normally treat a newfound friend to a coffee, but alas, there is no café to be found nearby.",
            "nextDialogs": [
              "240091110"
            ]
          },
          "240091110": {
            "id": "240091110",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Hmm. Well, why don't you take this Fonta — let us have a toast, and we'll consider ourselves formally acquainted! Have you been to Fontaine before, by the way?",
            "nextDialogs": [
              "240091111"
            ]
          },
          "240091111": {
            "id": "240091111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm a first-time visitor.",
            "nextDialogs": [
              "240091112"
            ]
          },
          "240091112": {
            "id": "240091112",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Ah, then you're in for a good time! Head into the city and see the sights — like the waterways stretching out overhead!",
            "nextDialogs": [
              "240091113"
            ]
          },
          "240091113": {
            "id": "240091113",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Then you can head out into the streets and see the intricate machines, even if not all of them have aesthetic value — well, in the opinion of this humble painter, anyway.",
            "nextDialogs": [
              "240091114"
            ]
          },
          "240091114": {
            "id": "240091114",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "And finally, you can sit yourself down at a café and appreciate a cup of coffee.",
            "nextDialogs": [
              "240091115"
            ]
          },
          "240091115": {
            "id": "240091115",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Who knows, perhaps someone will come to chat you up while you do so!",
            "nextDialogs": [
              "240091116"
            ]
          },
          "240091116": {
            "id": "240091116",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Still, if the person who comes up to you claims to be from some sort of \"Kamera Club\"...",
            "nextDialogs": [
              "240091117"
            ]
          },
          "240091117": {
            "id": "240091117",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Then be on your guard for their words of folly... There are those amongst them who are engaged in it, in any case."
          },
          "240091106": {
            "id": "240091106",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "The Kamera, my hobby? No, no, it is merely a reference tool — I am fonder of my paintbrush by far."
          }
        }
      }
    },
    {
      "subId": "2400904",
      "subQuestName": "Talk to Depierris",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240090401"
        ],
        "dialogs": {
          "240090401": {
            "id": "240090401",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Let me see... Those friends of mine gave me some suggestions that I've written in my notebook.",
            "nextDialogs": [
              "240090402"
            ]
          },
          "240090402": {
            "id": "240090402",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "\"The great underwater ruins!\"",
            "nextDialogs": [
              "240090403"
            ]
          },
          "240090403": {
            "id": "240090403",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Seriously? I wrote those words with such force that the paper nearly tore...",
            "nextDialogs": [
              "240090404"
            ]
          },
          "240090404": {
            "id": "240090404",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "But I do suppose that such a place might suggest a unique beauty.",
            "nextDialogs": [
              "240090405"
            ]
          },
          "240090405": {
            "id": "240090405",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Well, in that case, please help me take a picture of just such ruins — the larger the better, the more horribly ruined, the better!"
          }
        }
      }
    },
    {
      "subId": "2400905",
      "subQuestName": "Take the required photo underwater",
      "sceneId": null,
      "locations": [],

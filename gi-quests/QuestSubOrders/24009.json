      }
    },
    {
      "subId": "2400912",
      "subQuestName": "Take the required photo underwater",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240091201"
        ],
        "dialogs": {
          "240091201": {
            "id": "240091201",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Have you managed to get some Garlic Baguette?"
          }
        }
      }
    },
    {
      "subId": "2400906",
      "subQuestName": "Talk to Depierris",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240090601"
        ],
        "dialogs": {
          "240090601": {
            "id": "240090601",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Let me see... Those friends of mine gave me some suggestions that I've written in my notebook.",
            "nextDialogs": [
              "240090602"
            ]
          },
          "240090602": {
            "id": "240090602",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "What did I even write here? Let me see... Uh, underwater... rugged rocks... the plants on the rocks... the rocks' contours...",
            "nextDialogs": [
              "240090603"
            ]
          },
          "240090603": {
            "id": "240090603",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Uh, yes, that's right. I was studying rocks — obsessively, in fact, for their ability to best exhibit natural beauty.",
            "nextDialogs": [
              "240090604"
            ]
          },
          "240090604": {
            "id": "240090604",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Anyway, I'd like you to help me snap a shot of underwater rocks. I wonder what their contours will be like..."
          }
        }
      }
    },
    {
      "subId": "2400907",
      "subQuestName": "Take the required photo underwater",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240090701"
        ],
        "dialogs": {
          "240090701": {
            "id": "240090701",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Aesthetics — aesthetics are the key!"
          }
        }
      }
    },
    {
      "subId": "2400913",
      "subQuestName": "Take the required photo underwater",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240091301"
        ],
        "dialogs": {
          "240091301": {
            "id": "240091301",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Thank you for your help! This should be enough to fill my stomach...",
            "nextDialogs": [
              "240091302"
            ]
          },
          "240091302": {
            "id": "240091302",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Here, you've earned this. Now, to grab a few quick bites...",
            "nextDialogs": [
              "240091303"
            ]
          },
          "240091303": {
            "id": "240091303",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "It might be worth bringing biscuits that may be stored in my bag next time..."
          }
        }
      }
    },
    {
      "subId": "2400908",
      "subQuestName": "Report back to Depierris",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240090801"
        ],
        "dialogs": {
          "240090801": {
            "id": "240090801",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Have you got the picture?",
            "nextDialogs": [
              "240090802"
            ]
          },
          "240090802": {
            "id": "240090802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here it is.",
            "nextDialogs": [
              "240090803"
            ]
          },
          "240090803": {
            "id": "240090803",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Let me see...",
            "nextDialogs": [
              "240090804"
            ]
          },
          "240090804": {
            "id": "240090804",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Ah! Perfection! Perfection! I never expected you to be quite so outstanding a photographer.",
            "nextDialogs": [
              "240090805"
            ]
          },
          "240090805": {
            "id": "240090805",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "From this image shall I filter the best material possible!",
            "nextDialogs": [
              "240090806"
            ]
          },
          "240090806": {
            "id": "240090806",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Thank you so much. Mm... Where did I leave that Mora...",
            "nextDialogs": [
              "240090807"
            ]
          },
          "240090807": {
            "id": "240090807",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Alright, this is for you — please, take it! If the chance arises in the future, please, do help me take a few more pictures!",
            "nextDialogs": [
              "240090808"
            ]
          },
          "240090808": {
            "id": "240090808",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Now then... What about the composition..."
          }
        }
      }
    },
    {
      "subId": "2400909",
      "subQuestName": "Bring food back to Depierris",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240090901"
        ],
        "dialogs": {
          "240090901": {
            "id": "240090901",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "This... This isn't good...",
            "nextDialogs": [
              "240090904"
            ]
          },
          "240090904": {
            "id": "240090904",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "This time... Well, there's no need to take any photos. Actually, I have another favor to ask of you.",
            "nextDialogs": [
              "240090905"
            ]
          },
          "240090905": {
            "id": "240090905",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Ahem, this is quite embarrassing, but, ah... Could you help me find something to eat... Garlic Baguette, for example?"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7066101",
      "subQuestName": "Talk to Katheryne in Mondstadt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706610101"
        ],
        "dialogs": {
          "706610101": {
            "id": "706610101",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Ad astra abyssosque! Welcome to the Adventurers' Guild.",
            "nextDialogs": [
              "706610102"
            ]
          },
          "706610102": {
            "id": "706610102",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "We've recently received a commission from the Fishing Association, claiming that the fish activity in the nearby waters has been abnormal.",
            "nextDialogs": [
              "706610103"
            ]
          },
          "706610103": {
            "id": "706610103",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Unfortunately, their report does not mention any specifics. Could you help us check in on the situation?",
            "nextDialogs": [
              "706610104"
            ]
          },
          "706610104": {
            "id": "706610104",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "I have full faith that no matter what the problem is, you will overcome it with ease.",
            "nextDialogs": [
              "706610105"
            ]
          },
          "706610105": {
            "id": "706610105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Fishing Association? Is it that fishing?",
            "nextDialogs": [
              "706610106"
            ]
          },
          "706610106": {
            "id": "706610106",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Huh? \"That fishing\"? I'm not sure I understand... Is there any other kind of fishing to speak of?",
            "nextDialogs": [
              "706610107"
            ]
          },
          "706610107": {
            "id": "706610107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ooh, the Fishing Association... The Fishing Association... Sure sounds like they're in the business of catching delicious fish!",
            "nextDialogs": [
              "706610108"
            ]
          },
          "706610108": {
            "id": "706610108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, there's no time to lose — let's go check this out! Hehehe..."
          }
        }
      }
    },
    {
      "subId": "7066102",
      "subQuestName": "Talk to Nantuck",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706610201"
        ],
        "dialogs": {
          "706610201": {
            "id": "706610201",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "The fish have been really active these days...",
            "nextDialogs": [
              "706610202"
            ]
          },
          "706610202": {
            "id": "706610202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you need help?",
            "nextDialogs": [
              "706610203"
            ]
          },
          "706610203": {
            "id": "706610203",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Yes, and here comes my help now, I suppose! Good day to you!",
            "nextDialogs": [
              "706610204"
            ]
          },
          "706610204": {
            "id": "706610204",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Ahem. My name is Nantuck, senior fisherman of the Mondstadt Fishing Association.",
            "nextDialogs": [
              "706610205"
            ]
          },
          "706610205": {
            "id": "706610205",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Recently, many new fish species have suddenly appeared in nearby waters.",
            "nextDialogs": [
              "706610206"
            ]
          },
          "706610206": {
            "id": "706610206",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "I immediately contacted my friends in other regions, and sure enough, this has been happening everywhere.",
            "nextDialogs": [
              "706610207"
            ]
          },
          "706610207": {
            "id": "706610207",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Some people say that this must be the Teyvat fish outbreak of the century!",
            "nextDialogs": [
              "706610208"
            ]
          },
          "706610208": {
            "id": "706610208",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Actually, the reason hasn't been fully investigated, but I guess it has something to do with the improvement of the ecological environment...",
            "nextDialogs": [
              "706610209"
            ]
          },
          "706610209": {
            "id": "706610209",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, so you guys are in trouble because there are too many fish, right?",
            "nextDialogs": [
              "706610210"
            ]
          },
          "706610210": {
            "id": "706610210",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Don't worry, Paimon will take care of it! As long as they don't taste bad...",
            "nextDialogs": [
              "706610211"
            ]
          },
          "706610211": {
            "id": "706610211",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Haha, it's no trouble. In fact, the more fish, the better as far as the Fishing Association is concerned. However, we need enough manpower.",
            "nextDialogs": [
              "706610212"
            ]
          },
          "706610212": {
            "id": "706610212",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "And to be honest, with the manpower we have available...",
            "nextDialogs": [
              "706610213"
            ]
          },
          "706610213": {
            "id": "706610213",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "We'd be hard-pressed to catch all the new fish species for research in a short time.",
            "nextDialogs": [
              "706610214"
            ]
          },
          "706610214": {
            "id": "706610214",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "But on the flip side, I thought, isn't this also a great opportunity for the Fishing Association to grow?",
            "nextDialogs": [
              "706610215"
            ]
          },
          "706610215": {
            "id": "706610215",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "So I put up a commission with the Adventurers' Guild. Well, how about it? Interested in joining us?",
            "nextDialogs": [
              "706610216"
            ]
          },
          "706610216": {
            "id": "706610216",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Fishing is a lot of fun, you know!",
            "nextDialogs": [
              "706610218",
              "706610220"
            ]
          },
          "706610218": {
            "id": "706610218",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Great, what an energetic youngster you are!",
            "nextDialogs": [
              "706610223"
            ]
          },
          "706610223": {
            "id": "706610223",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "So... Let's start by going to Cider Lake.",
            "nextDialogs": [
              "706610224"
            ]
          },
          "706610224": {
            "id": "706610224",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "That's where the fishing grounds I prepared for newcomers is. I'll teach you the basics first."
          },
          "706610220": {
            "id": "706610220",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Isn't it really dangerous to dive straight in? You adventurers sure are bold...",
            "nextDialogs": [
              "706610221"
            ]
          },
          "706610221": {
            "id": "706610221",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Unfortunately, those fish are not as brave as you. All of them will be scared away if they see such a huge being jump into the water.",
            "nextDialogs": [
              "706610222"
            ]
          },
          "706610222": {
            "id": "706610222",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Best you refrain from doing such a thing."
          }
        }
      }
    },
    {
      "subId": "7066103",
      "subQuestName": "Meet Nantuck at Cider Lake",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706610401"
        ],
        "dialogs": {
          "706610401": {
            "id": "706610401",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "This place will do! See those little fish in the water? They're so beautiful...",
            "nextDialogs": [
              "706610402"
            ]
          },
          "706610402": {
            "id": "706610402",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Here, take some of these tools. We have fishing rods, bait, and formulas for making bait.",
            "nextDialogs": [
              "706610403"
            ]
          },
          "706610403": {
            "id": "706610403",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "First, place the bait on the hook, then aim for where the fish are gathering... then cast your rod! Then, dutifully wait for the fish to take the bait.",
            "nextDialogs": [
              "706610404"
            ]
          },
          "706610404": {
            "id": "706610404",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "I've heard that newcomers have something called \"beginner's luck.\" I caught a large bass that was more than half a meter long back then! Well, go on then, give it a go!",
            "nextDialogs": [
              "706610405"
            ]
          },
          "706610405": {
            "id": "706610405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's to catching another Paimon.",
            "nextDialogs": [
              "706610406"
            ]
          },
          "706610406": {
            "id": "706610406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! You shall have no other Paimon before this Paimon!",
            "nextDialogs": [
              "706610407"
            ]
          },
          "706610407": {
            "id": "706610407",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Paimon? What a strange name, is it a kind of fish?",
            "nextDialogs": [
              "706610408"
            ]
          },
          "706610408": {
            "id": "706610408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's a sort of \"wonderous seafood\" that I managed to catch last time.",
            "nextDialogs": [
              "706610409"
            ]
          },
          "706610409": {
            "id": "706610409",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! When did Paimon go from \"emergency food\" to \"wondrous seafood\"!?",
            "nextDialogs": [
              "706610410"
            ]
          },
          "706610410": {
            "id": "706610410",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Ah, I see! I didn't realize that you were already an experienced angler.",
            "nextDialogs": [
              "706610411"
            ]
          },
          "706610411": {
            "id": "706610411",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Well, that just makes me even more excited to see what you'll catch!"
          }
        }
      }
    },
    {
      "subId": "7066104",
      "subQuestName": "Fish in Cider Lake",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7066106",
      "subQuestName": "Talk to Nantuck",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706610601"
        ],
        "dialogs": {
          "706610601": {
            "id": "706610601",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "How did it go? By the look on your face, I suppose you got a pretty good haul! Let me see.",
            "nextDialogs": [
              "706610602"
            ]
          },
          "706610602": {
            "id": "706610602",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Oh? It's a newly discovered species of fish! That's wonderful!",
            "nextDialogs": [
              "706610603"
            ]
          },
          "706610603": {
            "id": "706610603",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "You're almost catching up with me back when I was in my glory days, hahaha!",
            "nextDialogs": [
              "706610604"
            ]
          },
          "706610604": {
            "id": "706610604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Can you also catch fish with your bare hands?",
            "nextDialogs": [
              "706610605"
            ]
          },
          "706610605": {
            "id": "706610605",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Ahem... Seems like these ordinary little fish are a walk in the park for you. I should consider giving you something more challenging...",
            "nextDialogs": [
              "706610606"
            ]
          },
          "706610606": {
            "id": "706610606",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "You might not know this, but even fish from the same species can have huge differences between individuals because of differences in living environment and food.",
            "nextDialogs": [
              "706610607"
            ]
          },
          "706610607": {
            "id": "706610607",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Even though they all look the same, some individuals are particularly active and energetic. They jump out of the water from time to time and are very eye-catching.",
            "nextDialogs": [
              "706610608"
            ]
          },
          "706610608": {
            "id": "706610608",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "These individuals are superior by far in terms of both commercial and aesthetic value.",
            "nextDialogs": [
              "706610609"
            ]
          },
          "706610609": {
            "id": "706610609",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Many hobbyists buy them at high prices and keep them at home in their tanks for ornamental purposes. This is why such fish are also called \"ornamental fish.\"",
            "nextDialogs": [
              "706610610"
            ]
          },
          "706610610": {
            "id": "706610610",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So that means, apart from \"Emergency Paimon\"...",
            "nextDialogs": [
              "706610611"
            ]
          },
          "706610611": {
            "id": "706610611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's also \"Ornamental Paimon\"!",
            "nextDialogs": [
              "706610612"
            ]
          },
          "706610612": {
            "id": "706610612",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "No, there isn't! How can there be so many kinds of Paimons!?",
            "nextDialogs": [
              "706610613"
            ]
          },
          "706610613": {
            "id": "706610613",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Yes, that's precisely how it works. Looks like you've gotten it already!",
            "nextDialogs": [
              "706610614"
            ]
          },
          "706610614": {
            "id": "706610614",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Recently, there have been many \"ornamental fish\" active in the waters near the Stormbearer Mountains, which I have marked on your map.",
            "nextDialogs": [
              "706610615"
            ]
          },
          "706610615": {
            "id": "706610615",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Let's go over and check it out."
          }
        }
      }
    },
    {
      "subId": "7066109",
      "subQuestName": "Talk to Nantuck",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706610701"
        ],
        "dialogs": {
          "706610701": {
            "id": "706610701",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "How did it go? By the look on your face, I suppose you got a pretty good haul! Let me see.",
            "nextDialogs": [
              "706610702"
            ]
          },
          "706610702": {
            "id": "706610702",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Oh? It's a newly discovered species of fish! Most stupendous... Hey, wait, what's that other fish in your bag?",
            "nextDialogs": [
              "706610703"
            ]
          },
          "706610703": {
            "id": "706610703",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Wow— That's amazing! Do you know what this is? It's an \"ornamental fish\"!",
            "nextDialogs": [
              "706610704"
            ]
          },
          "706610704": {
            "id": "706610704",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "You might not know this, but even fish from the same species can have huge differences between individuals because of differences in living environment and food.",
            "nextDialogs": [
              "706610705"
            ]
          },
          "706610705": {
            "id": "706610705",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Even though they all look the same, some individuals are particularly active and energetic. They jump out of the water from time to time and are very eye-catching.",
            "nextDialogs": [
              "706610706"
            ]
          },
          "706610706": {
            "id": "706610706",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "These individuals are superior by far in terms of both commercial and aesthetic value.",
            "nextDialogs": [
              "706610707"
            ]
          },
          "706610707": {
            "id": "706610707",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Many hobbyists buy them at high prices and keep them at home in their tanks for ornamental purposes.",
            "nextDialogs": [
              "706610708"
            ]
          },
          "706610708": {
            "id": "706610708",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "This one in your bag is a true-blue \"ornamental fish.\"",
            "nextDialogs": [
              "706610709"
            ]
          },
          "706610709": {
            "id": "706610709",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So that means, apart from \"Emergency Paimon\"...",
            "nextDialogs": [
              "706610710"
            ]
          },
          "706610710": {
            "id": "706610710",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's also \"Ornamental Paimon\"!",
            "nextDialogs": [
              "706610711"
            ]
          },
          "706610711": {
            "id": "706610711",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "No, there isn't! How can there be so many kinds of Paimons!?",
            "nextDialogs": [
              "706610712"
            ]
          },
          "706610712": {
            "id": "706610712",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Yes, that's precisely how it works. Looks like you've gotten it already!",
            "nextDialogs": [
              "706610713"
            ]
          },
          "706610713": {
            "id": "706610713",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "I'm really sorry I underestimated you before... no! I underestimated the elites of the Adventurers' Guild!",
            "nextDialogs": [
              "706610714"
            ]
          },
          "706610714": {
            "id": "706610714",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Guess I should hurry up and put up more commissions. I have got to attract talent like you to join the Fishing Association, if that's the last thing I do!",
            "nextDialogs": [
              "706610715"
            ]
          },
          "706610715": {
            "id": "706610715",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "By the way, if you need fishing gear in the future, you can drop by our Fishing Association to have a look. Our prices are very affordable!",
            "nextDialogs": [
              "706610716"
            ]
          },
          "706610716": {
            "id": "706610716",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Hehe, not to brag or anything, but we do have a good collection of fine goods!"
          }
        }
      }
    },

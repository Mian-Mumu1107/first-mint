    {
      "subId": "7066108",
      "subQuestName": "Show Nantuck the Ornamental Fish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706610801"
        ],
        "dialogs": {
          "706610801": {
            "id": "706610801",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Back so soon, youngster? You're pretty quick, huh?",
            "nextDialogs": [
              "706610802"
            ]
          },
          "706610802": {
            "id": "706610802",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Let me take a look... Wow! This one here is a true-blue \"ornamental fish\"!",
            "nextDialogs": [
              "706610803"
            ]
          },
          "706610803": {
            "id": "706610803",
            "speakerId": 1002,
            "speakerName": "Nantuck",
            "text": "Y—You're definitely a first-class angler!",
            "nextDialogs": [
              "706610804"
            ]
          },
          "706610804": {
            "id": "706610804",
            "speakerId": 1002,
            "speakerName": "Nantuck",

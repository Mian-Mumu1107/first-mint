    {
      "subId": "502204",
      "subQuestName": "Explore the dreamscape",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50220401"
        ],
        "dialogs": {
          "50220401": {
            "id": "50220401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Where am I? Is this... the Night Kingdom?)",
            "nextDialogs": [
              "50220402"
            ]
          },
          "50220402": {
            "id": "50220402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(How did I get here? I was just... Argh...)",
            "nextDialogs": [
              "50220403"
            ]
          },
          "50220403": {
            "id": "50220403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(I feel dizzy, like I can't think straight. Let me try to take a look around...)"
          }
        }
      }
    },
    {
      "subId": "502206",

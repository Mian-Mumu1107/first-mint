    {
      "subId": "502208",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50220801"
        ],
        "dialogs": {
          "50220801": {
            "id": "50220801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Morning, {NICKNAME}! Did you have a nightmare last night?",
            "nextDialogs": [
              "50220802"
            ]
          },
          "50220802": {
            "id": "50220802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon could hear you tossing and turning in your sleep. Maybe you're just nervous for the final battle?",
            "nextDialogs": [
              "50220803"
            ]
          },
          "50220803": {
            "id": "50220803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(So, it was a dream? I can barely remember it.)",
            "nextDialogs": [
              "50220804"
            ]
          },
          "50220804": {
            "id": "50220804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Everything that happened seems so hazy. Trying to remember is giving me a headache...)",
            "nextDialogs": [
              "50220805"
            ]
          },
          "50220805": {
            "id": "50220805",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Just shake it off, {NICKNAME}! We're supposed to meet with Mavuika today!"
          }
        }
      }
    }
  ]

    {
      "subId": "502207",
      "subQuestName": "Approach the gathering of figures",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50220701"
        ],
        "dialogs": {
          "50220701": {
            "id": "50220701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(When I passed through the wall of light, it felt like my whole body was frozen.)",
            "nextDialogs": [
              "50220702"
            ]
          },
          "50220702": {
            "id": "50220702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(I guess the Lord of the Night's protection can't reach this place. The cold and darkness are suffocating, and all I hear are cries of exhaustion and pain.)",
            "nextDialogs": [
              "50220703"
            ]
          },
          "50220703": {
            "id": "50220703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(How long have these souls existed in torment? How much longer before it ends...?)",
            "nextDialogs": [
              "50220704"
            ]
          },
          "50220704": {
            "id": "50220704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Huh? There's someone here...)",
            "nextDialogs": [
              "50220705"
            ]
          },
          "50220705": {
            "id": "50220705",
            "speakerId": 14235,
            "speakerName": "\"The Captain\"",
            "text": "Though our homeland has become a distant memory, the flames of war continue to rage. We have long shed the last of our blood...",
            "nextDialogs": [
              "50220706"
            ]
          },
          "50220706": {
            "id": "50220706",
            "speakerId": 14235,
            "speakerName": "\"The Captain\"",
            "text": "Stay strong, my soldiers...",
            "nextDialogs": [
              "50220707"
            ]
          },
          "50220707": {
            "id": "50220707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(What is The Captain doing here? And what is he saying...?)",
            "nextDialogs": [
              "50220708"
            ]
          },
          "50220708": {
            "id": "50220708",
            "speakerId": 14235,
            "speakerName": "\"The Captain\"",
            "text": "One day, I will deliver you to the place I promised."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7902908",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "680028501"
        ],
        "dialogs": {
          "680028501": {
            "id": "680028501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "There's a statue here?",
            "nextDialogs": [
              "680028502"
            ]
          },
          "680028502": {
            "id": "680028502",
            "speakerId": 1001,
            "speakerName": "Captain Night Raven",
            "text": "*sigh*...",
            "nextDialogs": [
              "680028503"
            ]
          },
          "680028503": {
            "id": "680028503",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey there, why are you sighing alone at this cavern entrance?",
            "nextDialogs": [
              "680028504"
            ]
          },
          "680028504": {
            "id": "680028504",
            "speakerId": 1001,
            "speakerName": "Captain Night Raven",
            "text": "Well, I've been living here lately...",
            "nextDialogs": [
              "680028505"
            ]
          },
          "680028505": {
            "id": "680028505",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You've been living in a place like this!?",
            "nextDialogs": [
              "680028506"
            ]
          },
          "680028506": {
            "id": "680028506",
            "speakerId": 1001,
            "speakerName": "Captain Night Raven",
            "text": "I didn't have a choice! A bunch of actors came to the island and started making a racket all day and all night. I couldn't even sleep because of them... So I found myself a quieter spot.",
            "nextDialogs": [
              "680028507"
            ]
          },
          "680028507": {
            "id": "680028507",
            "speakerId": 1001,
            "speakerName": "Captain Night Raven",
            "text": "But then a group of hilichurls came out of nowhere and occupied my resting place. So I had no choice but to brave the elements out here!",
            "nextDialogs": [
              "680028508"
            ]
          },
          "680028508": {
            "id": "680028508",
            "speakerId": 1001,
            "speakerName": "Captain Night Raven",
            "text": "*sigh* I swore to myself that if someone could help me, I'd tell them...",
            "nextDialogs": [
              "680028509"
            ]
          },
          "680028509": {
            "id": "680028509",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Tell them what?",
            "nextDialogs": [
              "680028510"
            ]
          },
          "680028510": {
            "id": "680028510",
            "speakerId": 1001,
            "speakerName": "Captain Night Raven",
            "text": "Tell them about a clue to finding the legendary Secret Pirate Treasure! Although I only know a quarter of it...",
            "nextDialogs": [
              "680028511"
            ]
          },
          "680028511": {
            "id": "680028511",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "A quarter of a clue?",
            "nextDialogs": [
              "680028512"
            ]
          },
          "680028512": {
            "id": "680028512",
            "speakerId": 1001,
            "speakerName": "Captain Night Raven",
            "text": "You seem like you're here for the treasure too. So, what do you say? Get rid of the hilichurls in there and I'll give you the clue's location.",
            "nextDialogs": [
              "680028513"
            ]
          },
          "680028513": {
            "id": "680028513",
            "speakerId": 1001,
            "speakerName": "Captain Night Raven",
            "text": "They say that if you collect all four parts of the clue, you can find the treasure that pirates left behind here!",
            "nextDialogs": [
              "680028514"
            ]
          },
          "680028514": {
            "id": "680028514",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, you have a deal!"
          }
        }
      }
    },

        ],
        "dialogs": {
          "737100101": {
            "id": "737100101",
            "speakerId": 1000,
            "speakerName": "Bongo-Head",
            "text": "♪~ ♪♪~ ♪~",
            "nextDialogs": [
              "737100102"
            ]
          },
          "737100102": {
            "id": "737100102",
            "speakerId": 1001,
            "speakerName": "Kindlejoy",
            "text": "♫♫~ ♫~ ♫♫~",
            "nextDialogs": [
              "737100103"
            ]
          },
          "737100103": {
            "id": "737100103",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Haniyyah, Souka, we're back!",
            "nextDialogs": [
              "737100104"
            ]
          },
          "737100104": {
            "id": "737100104",
            "speakerId": 1003,
            "speakerName": "Haniyyah",
            "text": "I could already hear Bongo-Head and Kindlejoy's cheerful steps from a distance. Looks like you really had a blast this time!",
            "nextDialogs": [
              "737100105"
            ]
          },
          "737100105": {
            "id": "737100105",
            "speakerId": 1004,
            "speakerName": "Souka",
            "text": "You can tell they're having fun from that far away? I still can't read the emotions in our Fungi friends' footsteps...",
            "nextDialogs": [
              "737100106"
            ]
          },
          "737100106": {
            "id": "737100106",
            "speakerId": 1004,
            "speakerName": "Souka",
            "text": "Guess I've got a lot to learn... There's always more to learn!",
            "nextDialogs": [
              "737100107"
            ]
          },
          "737100107": {
            "id": "737100107",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hehe, this trip really did feel different!",
            "nextDialogs": [
              "737100108"
            ]
          },
          "737100108": {
            "id": "737100108",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Running around with our Fungi friends, then coming back to the Lil' Fungi Playground, it feels like coming home to a nice meal after a long day of playing outside.",
            "nextDialogs": [
              "737100109"
            ]
          },
          "737100109": {
            "id": "737100109",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "How about we take a photo together right now? Paimon remembers reading in The Steambird that many famous travel journals line up all the little snapshots from a trip in chronological order.",
            "nextDialogs": [
              "737100110"
            ]
          },
          "737100110": {
            "id": "737100110",
            "speakerId": 1003,
            "speakerName": "Haniyyah",
            "text": "Now that Silver Companion mentions it, I've gotten so used to having these Fungi friends around all these years... We've never really taken a proper photo together...",
            "nextDialogs": [
              "737100111"
            ]
          },
          "737100111": {
            "id": "737100111",
            "speakerId": 1004,
            "speakerName": "Souka",
            "text": "Mmhmm! You two big shots really know how to wrap up an adventure nicely!",
            "nextDialogs": [
              "737100112"
            ]
          },
          "737100112": {
            "id": "737100112",
            "speakerId": 1000,
            "speakerName": "Bongo-Head",
            "text": "♪♪~",
            "nextDialogs": [
              "737100113"
            ]
          },
          "737100113": {
            "id": "737100113",
            "speakerId": 1001,
            "speakerName": "Kindlejoy",
            "text": "♫♫~",
            "nextDialogs": [
              "737100114"
            ]
          },
          "737100114": {
            "id": "737100114",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Alright, let's use Bongo-Head's Kamera, set it on the tripod, and take a timed group photo!",
            "nextDialogs": [
              "737100115"
            ]
          },
          "737100115": {
            "id": "737100115",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Once Haniyyah and Souka are less busy, we can all go out and have fun together like this again!",
            "nextDialogs": [
              "737100147"
            ]
          },
          "737100147": {
            "id": "737100147",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yippee!",
            "nextDialogs": [
              "737100116"
            ]
          },
          "737100116": {
            "id": "737100116",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Speaking of which, Bongo-Head is really talented at taking photos!",
            "nextDialogs": [
              "737100117"
            ]
          },
          "737100117": {
            "id": "737100117",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon picked a few good shots and put them together with our group photo. Haniyyah and Souka can check them out too!",
            "nextDialogs": [
              "737100120"
            ]
          },
          "737100120": {
            "id": "737100120",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh, and... Paimon brought some souvenirs for you.",
            "nextDialogs": [
              "737100121"
            ]
          },
          "737100121": {
            "id": "737100121",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Here! The macarons you didn't get to try before!",
            "nextDialogs": [
              "737100122"
            ]
          },
          "737100122": {
            "id": "737100122",
            "speakerId": 1004,
            "speakerName": "Souka",
            "text": "Aww, I only said it in passing, and you actually remembered it?",
            "nextDialogs": [
              "737100123"
            ]
          },
          "737100123": {
            "id": "737100123",
            "speakerId": 1003,
            "speakerName": "Haniyyah",
            "text": "Silver Companion... I'm so touched...",
            "nextDialogs": [
              "737100124"
            ]
          },
          "737100124": {
            "id": "737100124",
            "speakerId": 1003,
            "speakerName": "Haniyyah",
            "text": "To avoid troubling you like this in the future, I really need to fix my bad habits. I'll plan trips properly in advance... and not just on paper.",
            "nextDialogs": [
              "737100125"
            ]
          },
          "737100125": {
            "id": "737100125",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "You know, when friends are hanging out and chatting freely, even offhand comments can show what's truly on your mind."
          }
        }
      }
    },
    {

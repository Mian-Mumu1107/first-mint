  "subQuests": [
    {
      "subId": "101301",
      "subQuestName": "Go and buy kites",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10130101"
        ],
        "dialogs": {
          "10130101": {
            "id": "10130101",
            "speakerId": 1000,
            "speakerName": "Granny Shan",
            "text": "Ah, sir, you're here. The seven kites you asked for have been made to order. Would you like to take them now?",
            "nextDialogs": [
              "10130102"
            ]
          },
          "10130102": {
            "id": "10130102",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "Yes. Thank you.",
            "nextDialogs": [
              "10130103"
            ]
          },
          "10130103": {
            "id": "10130103",
            "speakerId": 1000,
            "speakerName": "Granny Shan",
            "text": "It's rare to see customers who want to buy this type of kite nowadays. In the early days, we used to get orders from people of all walks of life...",
            "nextDialogs": [
              "10130104"
            ]
          },
          "10130104": {
            "id": "10130104",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Well, this is Mr. Zhongli from the Wangsheng Funeral Parlor, so he's probably well-versed in all these walks of life.",
            "nextDialogs": [
              "10130105"
            ]
          },
          "10130105": {
            "id": "10130105",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "We've talked about a whole bunch of things while traveling with him...",
            "nextDialogs": [
              "10130108"
            ]
          },
          "10130108": {
            "id": "10130108",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "He seems to know Liyue's favorite topics, money and government, really well, but he likes talking about less useful topics instead.",
            "nextDialogs": [
              "10130109"
            ]
          },
          "10130109": {
            "id": "10130109",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "Well, that's because I prefer to share fun things with you.",
            "nextDialogs": [
              "10130110"
            ]
          },
          "10130110": {
            "id": "10130110",
            "speakerId": 1000,
            "speakerName": "Granny Shan",
            "text": "Children's toys are very fun things, that's for sure. I enjoy watching the children at play as much as anyone else. But there is more to it than that.",
            "nextDialogs": [
              "10130111"
            ]
          },
          "10130111": {
            "id": "10130111",
            "speakerId": 1000,
            "speakerName": "Granny Shan",
            "text": "Finely crafted toys are well-loved by children. But this craft itself has been honed over thousands of years, and there is meaning behind that.",
            "nextDialogs": [
              "10130112"
            ]
          },
          "10130112": {
            "id": "10130112",
            "speakerId": 1000,
            "speakerName": "Granny Shan",
            "text": "I have made kites in Liyue for forty years, and I am intimately familiar with the forms passed down from my ancestors. The meaning of these seven kites is far from banal.",
            "nextDialogs": [
              "10130113"
            ]
          },
          "10130113": {
            "id": "10130113",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "Indeed. These are decorations used in the Rite of Parting. The seven kites represent The Seven.",
            "nextDialogs": [
              "10130114"
            ]
          },
          "10130114": {
            "id": "10130114",
            "speakerId": 1000,
            "speakerName": "Granny Shan",
            "text": "I took the liberty of coloring outside the lines when doing the insignia of the Anemo Archon.",
            "nextDialogs": [
              "10130115"
            ]
          },
          "10130115": {
            "id": "10130115",
            "speakerId": 1000,
            "speakerName": "Granny Shan",
            "text": "As for the kite that honors the Geo Archon, one must follow the contract given right down to the last letter. These patterns are ancient, and you can also find them in the Golden House.",
            "nextDialogs": [
              "10130116"
            ]
          },
          "10130116": {
            "id": "10130116",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ah, Paimon's heard that name before—"
          }
        }
      }
    },
    {
      "subId": "101303",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10130301"
        ],
        "dialogs": {
          "10130301": {
            "id": "10130301",
            "speakerId": 1003,
            "speakerName": "Tic",
            "text": "Oh? Help? Sure! I, Tic, always put in one hundred percent effort into everything I do! Of course, there'll be a premium if you want me to give a hundred and ten percent.",
            "nextDialogs": [
              "10130302"
            ]
          },
          "10130302": {
            "id": "10130302",
            "speakerId": 1003,
            "speakerName": "Tic",
            "text": "So, what's the job?",
            "nextDialogs": [
              "10130303"
            ]
          },
          "10130303": {
            "id": "10130303",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "Let me see... we are still missing some wooden implements over at Yujing Terrace. They aren't uncommon objects, so I didn't make any special preparations for them.",
            "nextDialogs": [
              "10130304"
            ]
          },
          "10130304": {
            "id": "10130304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Fetch me 50 tree branches, and 20 stacks of timber!",
            "nextDialogs": [
              "10130305"
            ]
          },
          "10130305": {
            "id": "10130305",
            "speakerId": 1003,
            "speakerName": "Tic",
            "text": "No problem. That'll be <color=#00E1FFFF>twenty thousand Mora</color> for a single trip. How does that sound?",
            "nextDialogs": [
              "10130306"
            ]
          },
          "10130306": {
            "id": "10130306",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "Done."
          }
        }
      }
    },
    {
      "subId": "101321",
      "subQuestName": "Find the three workers",
      "sceneId": null,
      "locations": [],

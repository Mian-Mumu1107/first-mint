    {
      "subId": "101311",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10131101"
        ],
        "dialogs": {
          "10131101": {
            "id": "10131101",
            "speakerId": 1005,
            "speakerName": "Toe",
            "text": "Hiring help? Sure, but let me just say first that I'm a reserve member of the Adventurers' Guild. I take adventuring commissions, but I don't do anything clerical.",
            "nextDialogs": [
              "10131102"
            ]
          },
          "10131102": {
            "id": "10131102",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "Adventure... venturing into the mountains to capture a few crystalflies seems adventurous enough.",
            "nextDialogs": [
              "10131103"
            ]
          },
          "10131103": {
            "id": "10131103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Brave adventurer, we have need of 5 crystalflies.",
            "nextDialogs": [
              "10131104"
            ]
          },
          "10131104": {
            "id": "10131104",
            "speakerId": 1005,
            "speakerName": "Toe",
            "text": "Eh? That's not hard, almost a bit too easy for a reserve adventurer... Eh, never mind. I'll only charge you <color=#00E1FFFF>fifteen thousand Mora</color>. What say you?",
            "nextDialogs": [
              "10131105"
            ]
          },
          "10131105": {
            "id": "10131105",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "A most fair price."
          }
        }
      }
    },

    {
      "subId": "101304",
      "subQuestName": "Talk to Tic",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10130401"
        ],
        "dialogs": {
          "10130401": {
            "id": "10130401",
            "speakerId": 1003,
            "speakerName": "Tic",
            "text": "You're mad! And to think I was so willing to bargain, too! Twenty thousand Mora, and not one Mora less! If not, the deal's off!",
            "nextDialogs": [
              "10130402"
            ]
          },
          "10130402": {
            "id": "10130402",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Hey, don't get mad... Ah, guess we have no choice but to pay in full, {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "101305",
      "subQuestName": "Find a Qingxin flower",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10130501"
        ],
        "dialogs": {
          "10130501": {
            "id": "10130501",
            "speakerId": 1003,
            "speakerName": "Tic",
            "text": "Oh? Help? Sure! I, Tic, always put in one hundred percent effort into everything I do! Of course, there'll be a premium if you want me to give a hundred and ten percent.",
            "nextDialogs": [
              "10130502"
            ]

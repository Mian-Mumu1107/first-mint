          },
          "10130506": {
            "id": "10130506",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "Done.",
            "nextDialogs": [
              "10130507"
            ]
          },
          "10130507": {
            "id": "10130507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ugh, we brought too little money...",
            "nextDialogs": [
              "10130508"
            ]
          },
          "10130508": {
            "id": "10130508",
            "speakerId": 1003,
            "speakerName": "Tic",
            "text": "This is all you've got? Then no can do.",
            "nextDialogs": [
              "10130509"
            ]
          },
          "10130509": {
            "id": "10130509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Please go look for someone named Childe...",
            "nextDialogs": [
              "10130510"
            ]
          },
          "10130510": {
            "id": "10130510",
            "speakerId": 1003,
            "speakerName": "Tic",
            "text": "Childe? No, no, no. He's putting up the money? Still, no. Wouldn't that mean that I have to make two trips rather than one?",
            "nextDialogs": [
              "10130511"
            ]
          },
          "10130511": {
            "id": "10130511",
            "speakerId": 1003,
            "speakerName": "Tic",
            "text": "How about this. Let's make a trade. I'll take what you're offering right now, and...",
            "nextDialogs": [
              "10130512"
            ]
          },
          "10130512": {
            "id": "10130512",
            "speakerId": 1003,
            "speakerName": "Tic",
            "text": "Get me a single <color=#00E1FFFF>Qingxin flower</color>, and I'll consider that payment for a detour to find this Childe fellow. How does that sound?",
            "nextDialogs": [
              "10130513"
            ]
          },
          "10130513": {
            "id": "10130513",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Guess we've got no choice."
          }
        }
      }
    },
    {
      "subId": "101306",
      "subQuestName": "Give the Qingxin flower to Tic",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10139301"
        ],
        "dialogs": {
          "10139301": {
            "id": "10139301",
            "speakerId": 1003,
            "speakerName": "Tic",
            "text": "Have you brought the goods?",
            "nextDialogs": [
              "10139302"
            ]
          },
          "10139302": {
            "id": "10139302",
            "speakerId": 1003,
            "speakerName": "Tic",
            "text": "Hey, that's pretty good. These things are pretty rare, and I have no idea where I'd find them.",
            "nextDialogs": [
              "10139303"
            ]
          },
          "10139303": {
            "id": "10139303",
            "speakerId": 1003,
            "speakerName": "Tic",
            "text": "With this Qingxin flower, I should be able to pacify my daughter tonight. I'll make sure the work is done before I return home."
          }
        }
      }
    },
    {
      "subId": "101307",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10130701"
        ],
        "dialogs": {
          "10130701": {
            "id": "10130701",
            "speakerId": 1004,
            "speakerName": "Tac",
            "text": "A full day of odd jobs at Yujing Terrace? Hmm... No problem. <color=#00E1FFFF>Twenty-five thousand</color> per day. A fair trade, yes?",
            "nextDialogs": [
              "10130702"
            ]
          },
          "10130702": {
            "id": "10130702",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Whoa, that's expensive. Um, could you give us a bit of a discount on account of the whole Hero of Mondstadt thing?",
            "nextDialogs": [
              "10130703"
            ]
          },
          "10130703": {
            "id": "10130703",
            "speakerId": 1004,
            "speakerName": "Tac",
            "text": "Hero of Mondstadt? Never heard of them.",
            "nextDialogs": [
              "10130704"
            ]
          },
          "10130704": {
            "id": "10130704",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "Well, you may never have heard of this hero, but it seems you've heard of Mora nonetheless, thus I will simply pay the whole sum."
          }
        }
      }
    },

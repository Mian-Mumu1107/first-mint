  "subQuests": [
    {
      "subId": "2103801",
      "subQuestName": "Talk to Sun Yu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210380101"
        ],
        "dialogs": {
          "210380101": {
            "id": "210380101",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Traveler, thank goodness you're here. I almost thought you wouldn't be back today.",
            "nextDialogs": [
              "210380102"
            ]
          },
          "210380102": {
            "id": "210380102",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Today is the day I depart from Liyue Harbor. I have troubled you so much before... I have to thank you properly.",
            "nextDialogs": [
              "210380103"
            ]
          },
          "210380103": {
            "id": "210380103",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "...",
            "nextDialogs": [
              "210380104"
            ]
          },
          "210380104": {
            "id": "210380104",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Ahem... I was just thinking about what to say after seeing you.",
            "nextDialogs": [
              "210380105"
            ]
          },
          "210380105": {
            "id": "210380105",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Now it's time for me to actually talk, I somehow don't even remember any of the words... Look at me, making a fool of myself even now, haha.",
            "nextDialogs": [
              "210380108"
            ]
          },
          "210380108": {
            "id": "210380108",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Really? Haha, that's wonderful news! I'll show you around when you get there!",
            "nextDialogs": [
              "210380109"
            ]
          },
          "210380109": {
            "id": "210380109",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Well, I actually still have one last favor to ask. You have a Kamera, right? Do you mind taking a picture for me?",
            "nextDialogs": [
              "210380110"
            ]
          },
          "210380110": {
            "id": "210380110",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "A sailor told me that it's best to keep a picture of your hometown with you when you are traveling abroad.",
            "nextDialogs": [
              "210380111"
            ]
          },
          "210380111": {
            "id": "210380111",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "But I don't own a Kamera, so maybe you'd be kind enough to help me out."
          }
        }
      }
    },
    {
      "subId": "2103802",
      "subQuestName": "Take a photo of Sun Yu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210380201"
        ],
        "dialogs": {
          "210380201": {
            "id": "210380201",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Thank you, Traveler. This picture is just perfect.",
            "nextDialogs": [
              "210380202"
            ]
          },
          "210380202": {
            "id": "210380202",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "...",
            "nextDialogs": [
              "210380203"
            ]
          },
          "210380203": {
            "id": "210380203",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "*sigh* It's finally time to go. When I hear people say things like \"A great man is ready to realize his aspiration anywhere,\" or \"It is better to travel ten thousand miles than to read ten thousand books,\" I always feel so encouraged and inspired...",
            "nextDialogs": [
              "210380204"
            ]
          },
          "210380204": {
            "id": "210380204",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "But when it is me who's finally about to set out, I don't feel encouraged or inspired at all. All I want to do is to stay here for a little longer...",
            "nextDialogs": [
              "210380205"
            ]
          },
          "210380205": {
            "id": "210380205",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Traveler, do you think I can find what I'm looking for during this journey?",
            "nextDialogs": [
              "210380207",
              "210380209"
            ]
          },
          "210380207": {
            "id": "210380207",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Hahaha... I mean, what am I even looking for? Do I even know it myself?",
            "nextDialogs": [
              "210380210"
            ]
          },
          "210380210": {
            "id": "210380210",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Right, it's about time. I'm going to meet up with that merchant. Please, Traveler, take these as your reward.",
            "nextDialogs": [
              "210380211"
            ]
          },
          "210380211": {
            "id": "210380211",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "Que'er... She's not here after all..."
          },
          "210380209": {
            "id": "210380209",
            "speakerId": 1000,
            "speakerName": "Sun Yu",
            "text": "So... you are saying it's all up to fate."
          }
        }
      }
    },
    {
      "subId": "2103803",

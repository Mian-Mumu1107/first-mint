  "subQuests": [
    {
      "subId": "7711001",
      "subQuestName": "Get inside the town of Okurov",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771100301"
        ],
        "dialogs": {
          "771100301": {
            "id": "771100301",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "...All I'm gonna do is toss those frogs into his house, and then... wait to see his face when he comes back to a house going, \"Ribbit, ribbit!\" Heh heh, it's gonna be so funny!",
            "nextDialogs": [
              "771100302"
            ]
          },
          "771100302": {
            "id": "771100302",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "He's a Badbug... Would you help me please, Aunt LePuy? Would you help me get the key...?",
            "nextDialogs": [
              "771100303"
            ]
          },
          "771100303": {
            "id": "771100303",
            "speakerId": 1001,
            "speakerName": "Aunt LePuy",
            "text": "...Believe... family...",
            "nextDialogs": [
              "771100304"
            ]
          },
          "771100304": {
            "id": "771100304",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Finally! Nastya! Nastya, we're over here!",
            "nextDialogs": [
              "771100305"
            ]
          },
          "771100305": {
            "id": "771100305",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "#Yaaaay! {M#Big Brother}{F#Big Sister} {NICKNAME}! Paimonka! You're here!",
            "nextDialogs": [
              "771100306"
            ]
          },
          "771100306": {
            "id": "771100306",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "I've been waiting for you for so long... Zala is so mad, though. Maybe she thinks the two of you are baddies or Volkodlak or something.",
            "nextDialogs": [
              "771100307"
            ]
          },
          "771100307": {
            "id": "771100307",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "I saw the two of you just drop into that big, black hole... It was so big... and so deep... Ugh, I didn't even dare to look inside.",
            "nextDialogs": [
              "771100308"
            ]
          },
          "771100308": {
            "id": "771100308",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "But I knew that the two of you would make your way out anyhow.",
            "nextDialogs": [
              "771100309"
            ]
          },
          "771100309": {
            "id": "771100309",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "It wasn't easy, mind you... But never mind. Right now, we have a few questions for you.",
            "nextDialogs": [
              "771100310"
            ]
          },
          "771100310": {
            "id": "771100310",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Do you have a family member here named Koshchei, by any chance?",
            "nextDialogs": [
              "771100311"
            ]
          },
          "771100311": {
            "id": "771100311",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "I don't think I've heard that name before...",
            "nextDialogs": [
              "771100312"
            ]
          },
          "771100312": {
            "id": "771100312",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "No? Really?",
            "nextDialogs": [
              "771100313"
            ]
          },
          "771100313": {
            "id": "771100313",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "I don't know everyone's names, though. But if you wanna know, Paimonka, you should talk to Doctor Moreau... The Doctor knows everything and everyone's names.",
            "nextDialogs": [
              "771100314"
            ]
          },
          "771100314": {
            "id": "771100314",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "When you turn into a tree, slowly you won't be able to talk anymore. And everyone else will start forgetting your name too. Only Doctor Moreau remembers all those names...",
            "nextDialogs": [
              "771100315"
            ]
          },
          "771100315": {
            "id": "771100315",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "\"Turn into a tree\"... Hold on, so you mean to say that the Leshy here all used to be human!?",
            "nextDialogs": [
              "771100316"
            ]
          },
          "771100316": {
            "id": "771100316",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "\"Leshy\"? What's that? Anyway, whatever that is, that's not us... what Aunt LePuy and the others have almost completely turned into are the Perfect Tree...",
            "nextDialogs": [
              "771100317"
            ]
          },
          "771100317": {
            "id": "771100317",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "But right now, I'm only half-tree... And it's all those Volkodlak's fault! Otherwise, I'd be exactly where they are now instead of being so far behind.",
            "nextDialogs": [
              "771100318"
            ]
          },
          "771100318": {
            "id": "771100318",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So how do you communicate with each other?",
            "nextDialogs": [
              "771100319"
            ]
          },
          "771100319": {
            "id": "771100319",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "Once I turn into a Perfect Tree, I'll be able to talk to the other trees just by touching their leaves with mine! And my roots will be joined with to everyone's too...",
            "nextDialogs": [
              "771100320"
            ]
          },
          "771100320": {
            "id": "771100320",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "Doctor Moreau said, \"Let us become one family, and grow a world that is warm and where pain is no more. Let us come together, so we may reach...\"",
            "nextDialogs": [
              "771100321"
            ]
          },
          "771100321": {
            "id": "771100321",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "\"That eternal courtyard that is free of all worries.\"",
            "nextDialogs": [
              "771100322"
            ]
          },
          "771100322": {
            "id": "771100322",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#(Hmm, {NICKNAME}... Might this \"Doctor Moreau\" really be...)",
            "nextDialogs": [
              "771100326",
              "771100325"
            ]
          },
          "771100326": {
            "id": "771100326",
            "speakerId": 1003,
            "speakerName": "Eye of Graeae",
            "text": "From my perspective, that is a highly logical deduction.",
            "nextDialogs": [
              "771100327"
            ]
          },
          "771100327": {
            "id": "771100327",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "(Ooh! You think so too, Goggles? But what are we supposed to do now then...?)",
            "nextDialogs": [
              "771100328"
            ]
          },
          "771100328": {
            "id": "771100328",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Let's just follow Nastya for now.)",
            "nextDialogs": [
              "771100329"
            ]
          },
          "771100329": {
            "id": "771100329",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "(Yeah, that makes sense. As long as we follow Nastya, we'll meet that Doctor Moreau — Koshchei the Deathless...)",
            "nextDialogs": [
              "771100330"
            ]
          },
          "771100330": {
            "id": "771100330",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "#{M#Big Brother}{F#Big Sister} {NICKNAME}! Paimonka! What are you two whispering to each other about???",
            "nextDialogs": [
              "771100331"
            ]
          },
          "771100331": {
            "id": "771100331",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "...WHOA! Um... N—Nothing! We are just... just really interested in Doctor Moreau! Can you tell us more about him?",
            "nextDialogs": [
              "771100332"
            ]
          },
          "771100332": {
            "id": "771100332",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "Heh, of course! Ever since he came to Ogurov, the town has become really nice and warm. All the ice and snow has melted into these creeks, and you can see so many trees with pretty leaves coming out from the ground now.",
            "nextDialogs": [
              "771100333"
            ]
          },
          "771100333": {
            "id": "771100333",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "He's made everyone better, too! Mama's leg stopped hurting after he started helping her, and her eyes stopped being so red and watery too...",
            "nextDialogs": [
              "771100334"
            ]
          },
          "771100334": {
            "id": "771100334",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "Everyone's stopped fighting, too. Even the ones who had been at each other's throats forever... Now, they hold each other's hand in theirs and have become family...",
            "nextDialogs": [
              "771100335"
            ]
          },
          "771100335": {
            "id": "771100335",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "...Is that why you two want to be my family? Zala will definitely stop being mad at you if you do that."
          },
          "771100325": {
            "id": "771100325",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "(That's right. You must have thought of it too. He could be that Koshchei the Deathless!)"
          }
        }
      }
    },
    {
      "subId": "7711012",
      "subQuestName": "Head to location near Ove's house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7711003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771100101"
        ],
        "dialogs": {
          "771100101": {
            "id": "771100101",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "Okay, we're here... And he's still standing there at the door.",
            "nextDialogs": [
              "771100102"
            ]
          },
          "771100102": {
            "id": "771100102",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmm. Looks like talking it out isn't an option here... Nastya, how about just ask him for the Control Wheel outright?",
            "nextDialogs": [
              "771100103"
            ]
          },
          "771100103": {
            "id": "771100103",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Even if he really hates you, there's no way he'd stand in the way of a child trying to get home!",
            "nextDialogs": [
              "771100104"
            ]
          },
          "771100104": {
            "id": "771100104",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "That's where you're wrong, Paimonka. He will never give us the Control Wheel.",
            "nextDialogs": [
              "771100105"
            ]
          },
          "771100105": {
            "id": "771100105",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "He has always stopped us from going to the assembly hall... Every time we were supposed to see our families there, he'd catch us and lock us up in his cellar. But sometimes, he would give us yummy food, too...",
            "nextDialogs": [
              "771100106"
            ]
          },
          "771100106": {
            "id": "771100106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Us\"...?",
            "nextDialogs": [
              "771100107"
            ]
          },
          "771100107": {
            "id": "771100107",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "That's me and my friends. He always locked all of us up together.",
            "nextDialogs": [
              "771100108"
            ]
          },
          "771100108": {
            "id": "771100108",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "What? And no one else in town cared that he was doing that???",
            "nextDialogs": [
              "771100109"
            ]
          },
          "771100109": {
            "id": "771100109",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "It was always only for one night, just so we couldn't get to the assembly hall in time. And even if we told on him, our parents would just think we played too long and made up an excuse or something.",
            "nextDialogs": [
              "771100110"
            ]
          },
          "771100110": {
            "id": "771100110",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "Nobody knows why he keeps doing that. But we're always getting scolded because of him.",
            "nextDialogs": [
              "771100111"
            ]
          },
          "771100111": {
            "id": "771100111",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "I always thought he was one of those Badbugs. You know, the kind you're supposed to just burn to make a new, healthy tree. But too bad the Doctor and Zala don't see it that way.",
            "nextDialogs": [
              "771100112"
            ]
          },
          "771100112": {
            "id": "771100112",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh, so that's why you gave him that awful nickname... Yeah, Paimon would be mad too if someone got her into trouble like that! But it doesn't seem like we can just demand the Control Wheel from him...",
            "nextDialogs": [
              "771100113"
            ]
          },
          "771100113": {
            "id": "771100113",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "Oh yeah, I've been on his roof to toss frogs into his house before. You should be able to find a way to sneak in from there...",
            "nextDialogs": [
              "771100114"
            ]
          },
          "771100114": {
            "id": "771100114",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wait a minute...! Tossing frogs into someone's house? That's something only naughty kids do!",
            "nextDialogs": [
              "771100115"
            ]
          },
          "771100115": {
            "id": "771100115",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "I know... But I only do bad things to him when he does bad things to us. And we totally play fair. If he catches five of us, then we toss five frogs over the wall.",
            "nextDialogs": [
              "771100116"
            ]
          },
          "771100116": {
            "id": "771100116",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "But since there's no one here to help me with the ladder... Um... I don't think I can get up there. Could you get in there to find the Control Wheel?",
            "nextDialogs": [
              "771100118",
              "771100120"
            ]
          },
          "771100118": {
            "id": "771100118",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Heh, you've come to the right people! We'll get it to you in no time.",
            "nextDialogs": [
              "771100121"
            ]
          },
          "771100121": {
            "id": "771100121",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "I'll wait for you outside, then! Be careful!"
          },
          "771100120": {
            "id": "771100120",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hey, hey, don't say that!!! He's not gonna catch us! And we'll definitely find the Control Wheel..."
          }
        }
      }
    },
    {
      "subId": "7711004",
      "subQuestName": "Try to get inside Ove's house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771100401"
        ],
        "dialogs": {
          "771100401": {
            "id": "771100401",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "What is it? Is something wrong?",
            "nextDialogs": [
              "771100403",
              "771100406"
            ]
          },
          "771100403": {
            "id": "771100403",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "You want to... persuade \"No-Nose\" Ove??? No way that will be easier than just beating him in a fight!",
            "nextDialogs": [
              "771100404"
            ]
          },
          "771100404": {
            "id": "771100404",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "But since he's standing right there, I guess you can try if you want... But if it looks like he's gonna beat you up, just run!!!"
          },
          "771100406": {
            "id": "771100406",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "Good idea! You gotta look really carefully and make a super good plan. Good luck, you guys!"
          }
        }
      }
    },
    {
      "subId": "7711005",
      "subQuestName": "Check out the inside of the house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771100501"
        ],
        "dialogs": {
          "771100501": {
            "id": "771100501",
            "speakerId": 1004,
            "speakerName": "Ove",
            "text": "...UGFFFF... Must not... go... Close...",
            "nextDialogs": [
              "771100503",
              "771100505"
            ]
          },
          "771100503": {
            "id": "771100503",
            "speakerId": 1004,
            "speakerName": "Ove",
            "text": "..."
          },
          "771100505": {
            "id": "771100505",
            "speakerId": 1004,
            "speakerName": "Ove",
            "text": "Prote... never... you.. mind..."
          }
        }
      }
    },
    {
      "subId": "7711006",
      "subQuestName": "Enter the basement",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771100601"
        ],
        "dialogs": {
          "771100601": {
            "id": "771100601",
            "speakerId": 1004,
            "speakerName": "Ove",
            "text": "...Get... water... No, milk... bread... and... sugar... cubes...",
            "nextDialogs": [
              "771100604"
            ]
          },
          "771100604": {
            "id": "771100604",
            "speakerId": 1004,
            "speakerName": "Ove",
            "text": "...First... catch... frogs...",
            "nextDialogs": [
              "771100605"
            ]
          },
          "771100605": {
            "id": "771100605",
            "speakerId": 1004,
            "speakerName": "Ove",
            "text": "Keep... kids... from... hall... tomorrow..."
          }
        }
      }
    },

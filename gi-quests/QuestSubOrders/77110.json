    {
      "subId": "7711009",
      "subQuestName": "Regroup with Nastya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771100201"
        ],
        "dialogs": {
          "771100201": {
            "id": "771100201",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "Ooh, you're back! Did you find the Control Wheel?",
            "nextDialogs": [
              "771100202"
            ]
          },
          "771100202": {
            "id": "771100202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Heh, of course! That was a piece of cake for us.",
            "nextDialogs": [
              "771100203"
            ]
          },
          "771100203": {
            "id": "771100203",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "HEY! That's Paimon's line!",
            "nextDialogs": [
              "771100204"
            ]
          },
          "771100204": {
            "id": "771100204",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But now that we have the Control Wheel, that means we can take the elevator to the assembly hall, right?",
            "nextDialogs": [
              "771100205"
            ]
          },
          "771100205": {
            "id": "771100205",
            "speakerId": 1000,
            "speakerName": "Nastya",
            "text": "Yeah, yeah! Let's go right now! Mom and Dad and everyone else must be worried... Quick, come with me!"
          }
        }
      }
    },

          },
          "750360803": {
            "id": "750360803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Huh?",
            "nextDialogs": [
              "750360804"
            ]
          },
          "750360804": {
            "id": "750360804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Huh...",
            "nextDialogs": [
              "750360805"
            ]
          },
          "750360805": {
            "id": "750360805",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Ah, {NICKNAME}, the Phlogiston's energy has faded. It must've been absorbed by the seed, but... There was no reaction.",
            "nextDialogs": [
              "750360806"
            ]
          },
          "750360806": {
            "id": "750360806",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Errh?",
            "nextDialogs": [
              "750360808",
              "750360812"
            ]
          },
          "750360808": {
            "id": "750360808",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You really think so? You might have a point...",
            "nextDialogs": [
              "750360809"
            ]
          },
          "750360809": {
            "id": "750360809",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Dandelion seeds go flying off like little umbrellas if you just blow lightly on 'em, Wolfhooks attach themselves to little wolves, and run off with them to faraway places...",
            "nextDialogs": [
              "750360810"
            ]
          },
          "750360810": {
            "id": "750360810",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seeds are tenacious little things!",
            "nextDialogs": [
              "750360815"
            ]
          },
          "750360815": {
            "id": "750360815",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, in that case, let's leave it alone for now — there'll be time to come back later!",
            "nextDialogs": [
              "750360816"
            ]
          },
          "750360816": {
            "id": "750360816",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!"
          },
          "750360812": {
            "id": "750360812",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "R—Really? Hmm, yeah, maybe Paimon's just being too impatient...",
            "nextDialogs": [
              "750360813"
            ]
          },
          "750360813": {
            "id": "750360813",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#The seed got dug up by {REALNAME[ID(2)|SHOWHOST(true)]}, had its nutrients stolen by flying insects, and was even disturbed by some monsters barging in...",
            "nextDialogs": [
              "750360814"
            ]
          },
          "750360814": {
            "id": "750360814",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That fight must've sounded like a horrible thunderstorm to a seed — guess it's only natural that it would hide in the soil, not daring to move."
          }
        }

  "subQuests": [
    {
      "subId": "7503602",
      "subQuestName": "Check out what your Saurian buddy has found",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750360201"
        ],
        "dialogs": {
          "750360201": {
            "id": "750360201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#What's up, {REALNAME[ID(2)|SHOWHOST(true)]}? You were just digging about over there. Did you unearth something amazing?",
            "nextDialogs": [
              "750360202"
            ]
          },
          "750360202": {
            "id": "750360202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Was it some sort of valuable treasure?",
            "nextDialogs": [
              "750360203"
            ]
          },
          "750360203": {
            "id": "750360203",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750360204"
            ]
          },
          "750360204": {
            "id": "750360204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, let Paimon see... Is this some sorta seed? Huh. Didn't think we'd find something like that in this barren ground...",
            "nextDialogs": [
              "750360205"
            ]
          },
          "750360205": {
            "id": "750360205",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrrawr?",
            "nextDialogs": [
              "750360206"
            ]
          },
          "750360206": {
            "id": "750360206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That said, this doesn't look all that valuable...",
            "nextDialogs": [
              "750360207"
            ]
          },
          "750360207": {
            "id": "750360207",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Roar...",
            "nextDialogs": [
              "750360210"
            ]
          },
          "750360210": {
            "id": "750360210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Still, this place must have been abandoned for ages. The soil looks so hard, too... Could this seed really still be alive?",
            "nextDialogs": [
              "750360211"
            ]
          },
          "750360211": {
            "id": "750360211",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr...?",
            "nextDialogs": [
              "750360212"
            ]
          },
          "750360212": {
            "id": "750360212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are you upset? ... Well, sometimes it's hard to say — some seeds just won't sprout naturally...",
            "nextDialogs": [
              "750360213"
            ]
          },
          "750360213": {
            "id": "750360213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But we could replant it and see what happens. Maybe it just hasn't sprouted yet? Maybe the hole wasn't well dug, or it didn't get enough nutrients.",
            "nextDialogs": [
              "750360214"
            ]
          },
          "750360214": {
            "id": "750360214",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So it might grow if we plant it properly! Hehe, what might grow from it? A giant Grainfruit, maybe? Or... Y'know, a Cacahuatl with a super strong aroma might be awesome too!",
            "nextDialogs": [
              "750360215"
            ]
          },
          "750360215": {
            "id": "750360215",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750360216"
            ]
          },
          "750360216": {
            "id": "750360216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Or maybe a Whopperflower...",
            "nextDialogs": [
              "750360217"
            ]
          },
          "750360217": {
            "id": "750360217",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, come on! Stop being a killjoy!",
            "nextDialogs": [
              "750360218"
            ]
          },
          "750360218": {
            "id": "750360218",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That said, what sort of nutrients do plants from Natlan need? ... Anyway, let's get this planted first!"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "503001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300101"
        ],
        "dialogs": {
          "50300101": {
            "id": "50300101",
            "speakerId": 1000,
            "speakerName": "Qhispe",
            "text": "Oh Archons, I'm out of my depth... We're understaffed and undersupplied, and I can't even treat half of the wounds I'm seeing...",
            "nextDialogs": [
              "50300102"
            ]
          },
          "50300102": {
            "id": "50300102",
            "speakerId": 1000,
            "speakerName": "Qhispe",
            "text": "I just wish I had someone with more expertise to turn to... Ugh, no, I mustn't think like that. I have to rise to the challenge!"
          }
        }
      }
    },
    {
      "subId": "503002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300201"
        ],
        "dialogs": {
          "50300201": {
            "id": "50300201",
            "speakerId": 1001,
            "speakerName": "Awhina",
            "text": "I saw you brought Chuychu back... It's such a tragedy. Chuychu was the most promising doctor I ever had the pleasure to meet.",
            "nextDialogs": [
              "50300202"
            ]
          },
          "50300202": {
            "id": "50300202",
            "speakerId": 1001,
            "speakerName": "Awhina",
            "text": "We were close business partners. She had the highest standards for medical supplies, and she'd often dip into her own pockets to treat her patients.",
            "nextDialogs": [
              "50300203"
            ]
          },
          "50300203": {
            "id": "50300203",
            "speakerId": 1001,
            "speakerName": "Awhina",
            "text": "She always told me how she valued the experience more than the money.",
            "nextDialogs": [
              "50300204"
            ]
          },
          "50300204": {
            "id": "50300204",
            "speakerId": 1001,
            "speakerName": "Awhina",
            "text": "She said she had to perfect her skills so that she could save more people, especially the one person she wanted to save the most...",
            "nextDialogs": [
              "50300205"
            ]
          },
          "50300205": {
            "id": "50300205",
            "speakerId": 1001,
            "speakerName": "Awhina",
            "text": "Sadly, in the end, the one person she couldn't save was herself. And now Natlan has lost one of the finest talents of a generation..."
          }
        }
      }
    },
    {
      "subId": "503003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300301"
        ],
        "dialogs": {
          "50300301": {
            "id": "50300301",
            "speakerId": 1002,
            "speakerName": "Mayahuel",
            "text": "What's the status? Do we have enough medical supplies left?",
            "nextDialogs": [
              "50300302"
            ]
          },
          "50300302": {
            "id": "50300302",
            "speakerId": 1000,
            "speakerName": "Qhispe",
            "text": "We're almost out. There are still the emergency supplies, but they're reserved for the doctors and soldiers. We can't touch those.",
            "nextDialogs": [
              "50300303"
            ]
          },
          "50300303": {
            "id": "50300303",
            "speakerId": 1002,
            "speakerName": "Mayahuel",
            "text": "I know, I know...",
            "nextDialogs": [
              "50300304"
            ]
          },
          "50300304": {
            "id": "50300304",
            "speakerId": 1002,
            "speakerName": "Mayahuel",
            "text": "Alright, well... give me my share, at least."
          }
        }
      }
    },
    {
      "subId": "503005",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300501"
        ],
        "dialogs": {
          "50300501": {
            "id": "50300501",
            "speakerId": 1002,
            "speakerName": "Mayahuel",
            "text": "What's the status? Do we have enough medical supplies left?",
            "nextDialogs": [
              "50300502"
            ]
          },
          "50300502": {
            "id": "50300502",
            "speakerId": 1000,
            "speakerName": "Qhispe",
            "text": "We're almost out. There are still the emergency supplies, but they're reserved for the doctors and soldiers. We can't touch those.",
            "nextDialogs": [
              "50300503"
            ]
          },
          "50300503": {
            "id": "50300503",
            "speakerId": 1002,
            "speakerName": "Mayahuel",
            "text": "I know, I know...",
            "nextDialogs": [
              "50300504"
            ]
          },
          "50300504": {
            "id": "50300504",
            "speakerId": 1002,
            "speakerName": "Mayahuel",
            "text": "Alright, well... give me my share, at least.",
            "nextDialogs": [
              "50300505"
            ]
          },
          "50300505": {
            "id": "50300505",
            "speakerId": 1002,
            "speakerName": "Mayahuel",
            "text": "Ah, it's you. Glad to see you're both alright.",
            "nextDialogs": [
              "50300506"
            ]
          },
          "50300506": {
            "id": "50300506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How's your son doing?",
            "nextDialogs": [
              "50300507"
            ]
          },
          "50300507": {
            "id": "50300507",
            "speakerId": 1002,
            "speakerName": "Mayahuel",
            "text": "No idea. Communications have dried up, and there are too many wounded people to attend to. Right now, my focus is on them.",
            "nextDialogs": [
              "50300508"
            ]
          },
          "50300508": {
            "id": "50300508",
            "speakerId": 1002,
            "speakerName": "Mayahuel",
            "text": "But I trust him. I know he'll make the right call even when the going gets tough. He's my son, and I'll always be proud of him."
          }
        }
      }
    },
    {
      "subId": "503006",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300601"
        ],
        "dialogs": {
          "50300601": {
            "id": "50300601",
            "speakerId": 1000,
            "speakerName": "Qhispe",
            "text": "I'm so grateful Mayahuel is here. With her expertise, we were able to treat a lot more people.",
            "nextDialogs": [
              "50300602"
            ]
          },
          "50300602": {
            "id": "50300602",
            "speakerId": 1000,
            "speakerName": "Qhispe",
            "text": "But I'm worried she's overdoing it. She hasn't stopped this whole time. I need to get someone else to step in so I can persuade her to take a break."
          }
        }
      }
    },
    {
      "subId": "503007",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300701"
        ],
        "dialogs": {
          "50300701": {
            "id": "50300701",
            "speakerId": 1002,
            "speakerName": "Mayahuel",
            "text": "I trust him. I know he'll make the right call even when the going gets tough. He's my son, and I'll always be proud of him."
          }
        }
      }
    },
    {
      "subId": "503008",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300801"
        ],
        "dialogs": {
          "50300801": {
            "id": "50300801",
            "speakerId": 1003,
            "speakerName": "Uturunku",
            "text": "It's you two! Fantastic! I'm so grateful for all your encouragement.",
            "nextDialogs": [
              "50300802"
            ]
          },
          "50300802": {
            "id": "50300802",
            "speakerId": 1003,
            "speakerName": "Uturunku",
            "text": "So many people in Natlan see it as an honor to fight the Abyss, but then they let the excitement get to their heads and end up putting themselves in great danger.",
            "nextDialogs": [
              "50300803"
            ]
          },
          "50300803": {
            "id": "50300803",
            "speakerId": 1003,
            "speakerName": "Uturunku",
            "text": "You were right: It's important to fight, but it's also important to stay alive. We fight for the people we love, and also for the chance to see them again.",
            "nextDialogs": [
              "50300804"
            ]
          },
          "50300804": {
            "id": "50300804",
            "speakerId": 1003,
            "speakerName": "Uturunku",
            "text": "I shared your thoughts with my brothers-in-arms, and they were inspired too. Now everyone's fighting with more determination, and we're turning the tide!",
            "nextDialogs": [
              "50300805"
            ]
          },
          "50300805": {
            "id": "50300805",
            "speakerId": 1003,
            "speakerName": "Uturunku",
            "text": "So once again... thank you from the bottom of my heart!"
          }
        }
      }
    },
    {
      "subId": "503009",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50300901"
        ],
        "dialogs": {
          "50300901": {
            "id": "50300901",
            "speakerId": 1003,
            "speakerName": "Uturunku",
            "text": "...Oh, it's you two. I thought we'd never see each other again.",
            "nextDialogs": [
              "50300902"
            ]
          },
          "50300902": {
            "id": "50300902",
            "speakerId": 1003,
            "speakerName": "Uturunku",
            "text": "I put up a good fight, and we won, even though it cost us dearly...",
            "nextDialogs": [
              "50300903"
            ]
          },
          "50300903": {
            "id": "50300903",
            "speakerId": 1003,
            "speakerName": "Uturunku",
            "text": "Are you gonna keep fighting? If so, please be careful.",
            "nextDialogs": [
              "50300904"
            ]
          },
          "50300904": {
            "id": "50300904",
            "speakerId": 1003,
            "speakerName": "Uturunku",
            "text": "Fighting the Abyss is a great honor, but the path to victory lies not in honor and glory, but in surviving until the next morning."
          }
        }
      }
    },
    {
      "subId": "503010",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50301001"
        ],
        "dialogs": {
          "50301001": {
            "id": "50301001",
            "speakerId": 1004,
            "speakerName": "Raman",
            "text": "Ah, you're back. Thank you for saving me.",
            "nextDialogs": [
              "50301002"
            ]
          },
          "50301002": {
            "id": "50301002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're just glad you're okay. Hey, where did those saurians go?",
            "nextDialogs": [
              "50301003"
            ]
          },
          "50301003": {
            "id": "50301003",
            "speakerId": 1004,
            "speakerName": "Raman",
            "text": "Oh, they're back at it again, helping the remaining messengers with scouting and intel delivery.",
            "nextDialogs": [
              "50301004"
            ]
          },
          "50301004": {
            "id": "50301004",
            "speakerId": 1004,
            "speakerName": "Raman",
            "text": "It kills me, not being able to do my part. Especially knowing how bad things have gotten out there. But, you gotta know your limits, I suppose."
          }
        }
      }
    },
    {
      "subId": "503011",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50301101"
        ],
        "dialogs": {
          "50301101": {
            "id": "50301101",
            "speakerId": 1006,
            "speakerName": "Iyoba",
            "text": "Oh, hey you guys. Thanks again for rescuing us. Osawe, look who it is! Say \"thank-you\" to these heroes!",
            "nextDialogs": [
              "50301102"
            ]
          },
          "50301102": {
            "id": "50301102",
            "speakerId": 1007,
            "speakerName": "Osawe",
            "text": "Thank you!",
            "nextDialogs": [
              "50301103"
            ]
          },
          "50301103": {
            "id": "50301103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, don't mention it. Just glad you're okay.",
            "nextDialogs": [
              "50301104"
            ]
          },
          "50301104": {
            "id": "50301104",
            "speakerId": 1007,
            "speakerName": "Osawe",
            "text": "I also gotta say thank-you to the other people who helped us. What were they called? Fat... chewy...?",
            "nextDialogs": [
              "50301105"
            ]
          },
          "50301105": {
            "id": "50301105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Fatui!",
            "nextDialogs": [
              "50301106"
            ]
          },
          "50301106": {
            "id": "50301106",
            "speakerId": 1007,
            "speakerName": "Osawe",
            "text": "Yeah, that's it, the Fatui! They were also amazing...",
            "nextDialogs": [
              "50301107"
            ]
          },
          "50301107": {
            "id": "50301107",
            "speakerId": 1006,
            "speakerName": "Iyoba",
            "text": "Yeah. In the past, my impression of the Fatui wasn't exactly positive, but this has really changed my perspective. Good people can be found in every organization."
          }
        }
      }
    },
    {
      "subId": "503012",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50301201"
        ],
        "dialogs": {
          "50301201": {
            "id": "50301201",
            "speakerId": 1008,
            "speakerName": "Haronga",
            "text": "The saurians I came back with were intent on following the other warriors into battle. There was just nothing I could do to stop them.",
            "nextDialogs": [
              "50301202"
            ]
          },
          "50301202": {
            "id": "50301202",
            "speakerId": 1008,
            "speakerName": "Haronga",
            "text": "That officially makes me the most useless member of the unit... *sigh* But at least I know enough about saurian medicine to help treat their injuries."
          }
        }
      }
    },
    {
      "subId": "503013",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50301301"
        ],
        "dialogs": {
          "50301301": {
            "id": "50301301",
            "speakerId": 1009,
            "speakerName": "Young Yumkasaur",
            "text": "Roar ♪",
            "nextDialogs": [
              "50301302"
            ]
          },
          "50301302": {
            "id": "50301302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aw, it's the yumkasaur we rescued! You made it back! Aww, that's such good news...",
            "nextDialogs": [
              "50301303"
            ]
          },
          "50301303": {
            "id": "50301303",
            "speakerId": 1009,
            "speakerName": "Young Yumkasaur",
            "text": "Roar, roar!"
          }
        }
      }
    },
    {
      "subId": "503014",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50301401"
        ],
        "dialogs": {
          "50301401": {
            "id": "50301401",
            "speakerId": 1010,
            "speakerName": "Libiac",
            "text": "I'm delighted to see you make it back safe and sound.",
            "nextDialogs": [
              "50301402"
            ]
          },
          "50301402": {
            "id": "50301402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Just keeping our word! We said we'd see you at the stadium.",
            "nextDialogs": [
              "50301403"
            ]
          },
          "50301403": {
            "id": "50301403",
            "speakerId": 1011,
            "speakerName": "Kunak",
            "text": "Heh... Y'know, this was the first time in my life slaying an Abyss monster, and I realized in that moment... they're not that tough.",
            "nextDialogs": [
              "50301404"
            ]
          },
          "50301404": {
            "id": "50301404",
            "speakerId": 1011,
            "speakerName": "Kunak",
            "text": "I let my fear win for too long... Makes me wonder how many people I could've saved if I'd just had the courage.",
            "nextDialogs": [
              "50301405"
            ]
          },
          "50301405": {
            "id": "50301405",
            "speakerId": 1010,
            "speakerName": "Libiac",
            "text": "Don't be so hard on yourself. Right now, staying alive is the most important thing you can do. We must live on so their stories can be told.",
            "nextDialogs": [
              "50301406"
            ]
          },
          "50301406": {
            "id": "50301406",
            "speakerId": 1010,
            "speakerName": "Libiac",
            "text": "They will live forever in our hearts."
          }
        }
      }
    },
    {
      "subId": "503015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50301501"
        ],
        "dialogs": {
          "50301501": {
            "id": "50301501",
            "speakerId": 1012,
            "speakerName": "Achiyaku",
            "text": "You're okay! Thank goodness, we were worried sick about you guys!",
            "nextDialogs": [
              "50301502"
            ]
          },
          "50301502": {
            "id": "50301502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So you made it to safety, huh? Was it a smooth journey?",
            "nextDialogs": [
              "50301503"
            ]
          },
          "50301503": {
            "id": "50301503",
            "speakerId": 1012,
            "speakerName": "Achiyaku",
            "text": "Uh... not exactly. We ran into a bunch of Abyss monsters and had to fight for our lives. But I gotta hand it to these folks, they really rose to the occasion. They fought every bit as well as trained warriors.",
            "nextDialogs": [
              "50301504"
            ]
          },
          "50301504": {
            "id": "50301504",
            "speakerId": 1010,
            "speakerName": "Libiac",
            "text": "Hehe, guess the old muscle memory's still intact!",
            "nextDialogs": [
              "50301505"
            ]
          },
          "50301505": {
            "id": "50301505",
            "speakerId": 1011,
            "speakerName": "Kunak",
            "text": "I feel very lucky to be alive. We have to keep surviving, so we can start to take back what we've lost.",
            "nextDialogs": [
              "50301506"
            ]
          },
          "50301506": {
            "id": "50301506",
            "speakerId": 1011,
            "speakerName": "Kunak",
            "text": "You guys better make sure you keep surviving too."
          }
        }
      }
    },
    {
      "subId": "503016",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50301601"
        ],
        "dialogs": {
          "50301601": {
            "id": "50301601",
            "speakerId": 1002,
            "speakerName": "Mayahuel",
            "text": "Ah, it's you. Glad to see you're both alright."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7050801",
      "subQuestName": "Talk to Luka and enter the tavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705080101"
        ],
        "dialogs": {
          "705080101": {
            "id": "705080101",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "#Ahoy, {NICKNAME}! Great timing. Join us for a round?",
            "nextDialogs": [
              "705080102"
            ]
          },
          "705080102": {
            "id": "705080102",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Traveler, what a pleasant surprise.",
            "nextDialogs": [
              "705080103"
            ]
          },
          "705080103": {
            "id": "705080103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you two doing here?",
            "nextDialogs": [
              "705080104"
            ]
          },
          "705080104": {
            "id": "705080104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, did you two come together?",
            "nextDialogs": [
              "705080105"
            ]
          },
          "705080105": {
            "id": "705080105",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "This lady decided on a whim that she wanted a little vacation, so we ended up traveling around the area.",
            "nextDialogs": [
              "705080106"
            ]
          },
          "705080106": {
            "id": "705080106",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "But I guess we have different ideas of vacation. We hardly hiked the mountains before we came here to put our feet up. Talk about spoiled.",
            "nextDialogs": [
              "705080107"
            ]
          },
          "705080107": {
            "id": "705080107",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Come now, no need to hurt anyone's feelings. Besides, I specifically chose this place because I knew how much you like to drink.",
            "nextDialogs": [
              "705080108"
            ]
          },
          "705080108": {
            "id": "705080108",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "But our captain here has seen a lot more of the world, so she's not exactly thrilled with this little tavern.",
            "nextDialogs": [
              "705080109"
            ]
          },
          "705080109": {
            "id": "705080109",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "It'll do. Anyway, this one's on me, okay?",
            "nextDialogs": [
              "705080110"
            ]
          },
          "705080110": {
            "id": "705080110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Beidou's paying? Uh, does that include us?",
            "nextDialogs": [
              "705080111"
            ]
          },
          "705080111": {
            "id": "705080111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're the bartenders, Paimon.",
            "nextDialogs": [
              "705080112"
            ]
          },
          "705080112": {
            "id": "705080112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh right. Hehe, sorry... guess that's just a habit now.",
            "nextDialogs": [
              "705080113"
            ]
          },
          "705080113": {
            "id": "705080113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And what can I get for the two lovely ladies?",
            "nextDialogs": [
              "705080114"
            ]
          },
          "705080114": {
            "id": "705080114",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "I'll have a small Birch Sap, on the sour side.",
            "nextDialogs": [
              "705080115"
            ]
          },
          "705080115": {
            "id": "705080115",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Uh... I will have a... a large Dusk, please. Thanks!",
            "nextDialogs": [
              "705080116"
            ]
          },
          "705080116": {
            "id": "705080116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it. Coming right up."
          }
        }
      }
    },

    {
      "subId": "7050802",
      "subQuestName": "Mix Ningguang the specified drink",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705080201"
        ],
        "dialogs": {
          "705080201": {
            "id": "705080201",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "...",
            "nextDialogs": [
              "705080202"
            ]
          },
          "705080202": {
            "id": "705080202",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "...",
            "nextDialogs": [
              "705080203"
            ]
          },
          "705080203": {
            "id": "705080203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well? H—How is it? This silence is making Paimon nervous!",
            "nextDialogs": [
              "705080204"
            ]
          },
          "705080204": {
            "id": "705080204",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Mmm... The bittersweet taste of nostalgia.",
            "nextDialogs": [
              "705080205"
            ]
          },
          "705080205": {
            "id": "705080205",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "You mean the taste of going from rags to riches? Just what kind of taste is that?",
            "nextDialogs": [
              "705080206"
            ]
          },
          "705080206": {
            "id": "705080206",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Hehe... It's mainly sour with just a tinge of sweetness, and a lingering aftertaste.",
            "nextDialogs": [
              "705080207"
            ]
          },
          "705080207": {
            "id": "705080207",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Interesting... Does it taste like starting a little business then discovering that selling fruit isn't very lucrative?",
            "nextDialogs": [
              "705080208"
            ]
          },
          "705080208": {
            "id": "705080208",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "No need to get into the details. Let's leave the past in the past.",
            "nextDialogs": [
              "705080209"
            ]
          },
          "705080209": {
            "id": "705080209",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Haha, who'd have thought that the dignified Tianquan was once a fruit vendor on the street.",
            "nextDialogs": [
              "705080210"
            ]
          },
          "705080210": {
            "id": "705080210",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "On the other hand, I bet few can tell that I'm from an ordinary fishing village, right?",
            "nextDialogs": [
              "705080211"
            ]
          },
          "705080211": {
            "id": "705080211",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Not necessarily. If you ask me...",
            "nextDialogs": [
              "705080212"
            ]
          },
          "705080212": {
            "id": "705080212",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "I'd say that Captain Beidou has eyes that can pierce the sea. You're an adventure-seeking pioneer who tames the wind and the waves... Which is clearly indicative of someone who grew up by the sea.",
            "nextDialogs": [
              "705080213"
            ]
          },
          "705080213": {
            "id": "705080213",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Hey, you're not mocking me, are you?",
            "nextDialogs": [
              "705080214"
            ]
          },
          "705080214": {
            "id": "705080214",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Come now, it wouldn't do any good to be sarcastic.",
            "nextDialogs": [
              "705080215"
            ]
          },
          "705080215": {
            "id": "705080215",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "I know how fierce you can be with words. It's my treat today, so remember to take it easy on me.",
            "nextDialogs": [
              "705080216"
            ]
          },
          "705080216": {
            "id": "705080216",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Alright, then I'd like to have a few more.",
            "nextDialogs": [
              "705080219"
            ]
          },
          "705080219": {
            "id": "705080219",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, you heard the good lady, bartender!",
            "nextDialogs": [
              "705080220"
            ]
          },
          "705080220": {
            "id": "705080220",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "I like where this is going! I'll have another round, too!",
            "nextDialogs": [
              "705080221"
            ]
          },
          "705080221": {
            "id": "705080221",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Mondstadt's fresh fruit juice is hard to top. I wish I could enjoy some every day.",
            "nextDialogs": [
              "705080222"
            ]
          },
          "705080222": {
            "id": "705080222",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Are you serious? Don't tell me you're gonna open a Sunsettia trade route now...",
            "nextDialogs": [
              "705080223"
            ]
          },
          "705080223": {
            "id": "705080223",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Hmm, an interesting proposition.",
            "nextDialogs": [
              "705080224"
            ]
          },
          "705080224": {
            "id": "705080224",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Wait... Huh, really?",
            "nextDialogs": [
              "705080225"
            ]
          },
          "705080225": {
            "id": "705080225",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "I'm just joking, of course. There's already a whole industry established for that. They don't need me muscling my way in to their business.",
            "nextDialogs": [
              "705080226"
            ]
          },
          "705080226": {
            "id": "705080226",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "#Thanks for the drinks today, {NICKNAME}. If you'd ever like a cushy job, I'd enjoy having you as my personal bartender.",
            "nextDialogs": [
              "705080227"
            ]
          },
          "705080227": {
            "id": "705080227",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "You're also welcome aboard the Alcor. The crew loves to drink, you could come feast with us. I promise you'd have a blast.",
            "nextDialogs": [
              "705080228"
            ]
          },
          "705080228": {
            "id": "705080228",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "My, my, Captain Beidou, are you competing with me for talent? That's hardly necessary. You may simply stop by the Jade Chamber whenever you want the Traveler to mix you a drink.",
            "nextDialogs": [
              "705080229"
            ]
          },
          "705080229": {
            "id": "705080229",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(I'm so popular!)",
            "nextDialogs": [
              "705080230"
            ]
          },
          "705080230": {
            "id": "705080230",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is it Paimon, or does it sound like they think you work for them?"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "1503601",
      "subQuestName": "Go to where the culprit is hiding",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150360101"
        ],
        "dialogs": {
          "150360101": {
            "id": "150360101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait... This is near The Chasm, right?",
            "nextDialogs": [
              "150360102"
            ]
          },
          "150360102": {
            "id": "150360102",
            "speakerId": 1001,
            "speakerName": "Skirk",
            "text": "Yes. If we enter from here, we'll be able to reach that place from your dream.",
            "nextDialogs": [
              "150360103"
            ]
          },
          "150360103": {
            "id": "150360103",
            "speakerId": 1001,
            "speakerName": "Skirk",
            "text": "You have some experience with Abyssal domains by now, but still, this is someone else's territory. Best to proceed with caution.",
            "nextDialogs": [
              "150360104"
            ]
          },
          "150360104": {
            "id": "150360104",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Don't worry! Paimon's an expert at hiding behind other people for safety!",
            "nextDialogs": [
              "150360105"
            ]
          },
          "150360105": {
            "id": "150360105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Oh, but, uh... That means you need to stay safe, {NICKNAME}!",
            "nextDialogs": [
              "150360108"
            ]
          },
          "150360108": {
            "id": "150360108",
            "speakerId": 1001,
            "speakerName": "Skirk",
            "text": "Alright. Remember your training. Time to put it to use."
          }
        }
      }
    },
    {
      "subId": "1503607",
      "subQuestName": "Enter the Abyssal rift",
      "sceneId": null,
      "locations": [],

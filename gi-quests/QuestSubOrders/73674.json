  "subQuests": [
    {
      "subId": "7367401",
      "subQuestName": "Talk to Ulman",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736740101"
        ],
        "dialogs": {
          "736740101": {
            "id": "736740101",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "Didn't you bring me here, little one? Keep moving!",
            "nextDialogs": [
              "736740102"
            ]
          },
          "736740102": {
            "id": "736740102",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "Never mind, you better stay put...",
            "nextDialogs": [
              "736740106",
              "736740105"
            ]
          },
          "736740106": {
            "id": "736740106",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "I'm duped by it, again... Let me give you a rundown from the beginning.",
            "nextDialogs": [
              "736740107"
            ]
          },
          "736740107": {
            "id": "736740107",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "For starters, you may not believe Seelie are somehow easily drawn to me.",
            "nextDialogs": [
              "736740108"
            ]
          },
          "736740108": {
            "id": "736740108",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "Among the Seelie that came to follow me, I found one kind that is particularly keen on treasure-seeking.",
            "nextDialogs": [
              "736740109"
            ]
          },
          "736740109": {
            "id": "736740109",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "I'm not good at naming. I'll just call them Treasure-Seeking Seelie.",
            "nextDialogs": [
              "736740110"
            ]
          },
          "736740110": {
            "id": "736740110",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "They excel at treasure-seeking. With their help, I dug up a lot of treasures and made a profit with them.",
            "nextDialogs": [
              "736740111"
            ]
          },
          "736740111": {
            "id": "736740111",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "But sometimes they suddenly tune out on me. I don't know if they're tired of the seeking, or just think I'm too boring...",
            "nextDialogs": [
              "736740112"
            ]
          },
          "736740112": {
            "id": "736740112",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "Then I'd find a helper favored by the Seelie.",
            "nextDialogs": [
              "736740113"
            ]
          },
          "736740113": {
            "id": "736740113",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "The helper takes Treasure-Seeking Seelie to locate the treasures, and I sell them for a fair price.",
            "nextDialogs": [
              "736740114"
            ]
          },
          "736740114": {
            "id": "736740114",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "They say ruins and antiques are everywhere in Sumeru. So I came to look for my fortune.",
            "nextDialogs": [
              "736740115"
            ]
          },
          "736740115": {
            "id": "736740115",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "And I attracted a bunch of Seelie here, of course. Some Treasure-Seeking Seelie brought me here.",
            "nextDialogs": [
              "736740116"
            ]
          },
          "736740116": {
            "id": "736740116",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "But they ignored me again not long after I scooped up some dirt...",
            "nextDialogs": [
              "736740117"
            ]
          },
          "736740117": {
            "id": "736740117",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "Eh? Why did it suddenly start to move? Could it be...",
            "nextDialogs": [
              "736740118"
            ]
          },
          "736740118": {
            "id": "736740118",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "Traveler, are you interested in treasure-seeking with Seelie?"
          },
          "736740105": {
            "id": "736740105",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "You mean the little one? Ugh, sort of..."
          }
        }
      }
    },
    {
      "subId": "7367403",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736740301"
        ],
        "dialogs": {
          "736740301": {
            "id": "736740301",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "Didn't you bring me here, little one? Keep moving!",
            "nextDialogs": [
              "736740302"
            ]
          },
          "736740302": {
            "id": "736740302",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "Never mind, you better stay put...",
            "nextDialogs": [
              "736740305"
            ]
          },
          "736740305": {
            "id": "736740305",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "Traveler? It's been a while.",
            "nextDialogs": [
              "736740306"
            ]
          },
          "736740306": {
            "id": "736740306",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "Are you still bumming around the world? I've heard many amazing stories about you. You're really phenomenal.",
            "nextDialogs": [
              "736740307"
            ]
          },
          "736740307": {
            "id": "736740307",
            "speakerId": 1000,
            "speakerName": "Ulman",
            "text": "What troubles are you gonna fix this time in Sumeru?"
          }
        }
      }
    }
  ]
}
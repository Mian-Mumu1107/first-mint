{
  "lineCounts": {
    "Lan": 21,
    "Player": 5
  },
  "subQuests": [
    {
      "subId": "2210801",
      "subQuestName": "Talk to Lan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221080101"
        ],
        "dialogs": {
          "221080101": {
            "id": "221080101",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "I hope it turns up this time... there are so few leads left...",
            "nextDialogs": [
              "221080102"
            ]
          },
          "221080102": {
            "id": "221080102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "221080103"
            ]
          },
          "221080103": {
            "id": "221080103",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "What brings you here? If you'd like to learn more about the Guild, please talk to Katheryne over there.",
            "nextDialogs": [
              "221080104"
            ]
          },
          "221080104": {
            "id": "221080104",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "...Oh, you're an adventurer already? Please accept my apologies, I may be the Branch Master, but I am not well acquainted with the Guild's day-to-day business.",
            "nextDialogs": [
              "221080105"
            ]
          },
          "221080105": {
            "id": "221080105",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "So I don't really know any of the newcomers... Having said that, you're no newcomer at all, are you? You look like a seasoned adventurer to me.",
            "nextDialogs": [
              "221080106"
            ]
          },
          "221080106": {
            "id": "221080106",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "In which case, maybe there's something you can help me with. I must emphasize though, this is not a guild quest but a personal commission.",
            "nextDialogs": [
              "221080109",
              "221080110"
            ]
          },
          "221080109": {
            "id": "221080109",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "I appreciate your enthusiasm, but it is highly unwise to accept a commission without examining the details first.",
            "nextDialogs": [
              "221080111"
            ]
          },
          "221080111": {
            "id": "221080111",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Your commission, should you choose to accept it, is to defeat two strong hilichurls who bear giant shields.",
            "nextDialogs": [
              "221080112"
            ]
          },
          "221080112": {
            "id": "221080112",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Their shields are infused with Geo energy. Not terribly dangerous, but you should still proceed carefully.",
            "nextDialogs": [
              "221080113"
            ]
          },
          "221080113": {
            "id": "221080113",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "All I need you to do is defeat them. Come and find me afterwards and you will be fairly compensated.",
            "nextDialogs": [
              "221080114"
            ]
          },
          "221080114": {
            "id": "221080114",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Oh, and if you come across anything sword-related, bring it back for me.",
            "nextDialogs": [
              "221080115"
            ]
          },
          "221080115": {
            "id": "221080115",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "If not, it doesn't matter. As long as you defeat the hilichurls you will receive your compensation. That's all. I will leave you to get ready now."
          },
          "221080110": {
            "id": "221080110",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "A cautious response. I'm sure you learned the value of caution the hard way."
          }
        }
      }
    },
    {
      "subId": "2210802",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221080201"
        ],
        "dialogs": {
          "221080201": {
            "id": "221080201",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Have you defeated them yet?",
            "nextDialogs": [
              "221080202"
            ]
          },
          "221080202": {
            "id": "221080202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet.",
            "nextDialogs": [
              "221080203"
            ]
          },
          "221080203": {
            "id": "221080203",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "That's fine; please don't rush. An adventurer who acts in haste is sure to put themselves in harm's way.",
            "nextDialogs": [
              "221080204"
            ]
          },
          "221080204": {
            "id": "221080204",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "That said... Think less haste, more speed. Because your compensation is based on how quickly you complete the assignment."
          }
        }
      }
    },
    {
      "subId": "2210803",
      "subQuestName": "Report back to Lan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221080301"
        ],
        "dialogs": {
          "221080301": {
            "id": "221080301",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Have you defeated them yet?",
            "nextDialogs": [
              "221080302"
            ]
          },
          "221080302": {
            "id": "221080302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes.",
            "nextDialogs": [
              "221080303"
            ]
          },
          "221080303": {
            "id": "221080303",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Efficient work! I'm impressed. Done like a true Adventurer.",
            "nextDialogs": [
              "221080304"
            ]
          },
          "221080304": {
            "id": "221080304",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Here is your compensation. Thanks to you, things will be much safer around here.",
            "nextDialogs": [
              "221080305"
            ]
          },
          "221080305": {
            "id": "221080305",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "I don't suppose you found anything to do with a sword?",
            "nextDialogs": [
              "221080306"
            ]
          },
          "221080306": {
            "id": "221080306",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "...I see. As I expected. Never mind.",
            "nextDialogs": [
              "221080307"
            ]
          },
          "221080307": {
            "id": "221080307",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Thank you — here is your compensation. Enjoy the rest of your day."
          }
        }
      }
    }
  ]
}
    {
      "subId": "7081002",
      "subQuestName": "Talk to Sara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708100201"
        ],
        "dialogs": {
          "708100201": {
            "id": "708100201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you sell any Mondstadt specialties?",
            "nextDialogs": [
              "708100202"
            ]
          },
          "708100202": {
            "id": "708100202",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "Mondstadt's specialties? What can I say, every last one of our dishes is unique to Mondstadt.",
            "nextDialogs": [
              "708100203"
            ]
          },
          "708100203": {
            "id": "708100203",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "However, most of them have a short shelf life, and are by no means convenient items to bring on a long trip.",
            "nextDialogs": [
              "708100204"
            ]
          },
          "708100204": {
            "id": "708100204",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "We can of course cook them differently to make them more suitable for travel and storage, but it comes at a significant compromise in taste and quality.",
            "nextDialogs": [
              "708100205"
            ]
          },
          "708100205": {
            "id": "708100205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Doesn't bother me.",
            "nextDialogs": [
              "708100206"
            ]
          },
          "708100206": {
            "id": "708100206",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "Alright then, if you insist.",
            "nextDialogs": [
              "708100207"
            ]
          },
          "708100207": {
            "id": "708100207",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "But if this is intended as a gift, I'd advise you to cook a fresh batch of whatever you choose — everything here has been sat out for a while.",
            "nextDialogs": [
              "708100208"
            ]
          },
          "708100208": {
            "id": "708100208",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "Might I ask where your friend is from? Perhaps I can make a recommendation.",
            "nextDialogs": [
              "708100210",
              "708100212"
            ]
          },
          "708100210": {
            "id": "708100210",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "Wow, that's a long way from here. I need to be careful with my choice of ingredients.",
            "nextDialogs": [
              "708100213"
            ]
          },
          "708100213": {
            "id": "708100213",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "Hmm, I know nothing of Snezhnayan tastes, but I do know a dish that caters to all tastes.",
            "nextDialogs": [
              "708100214"
            ]
          },
          "708100214": {
            "id": "708100214",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "Make me a Satisfying Salad and I will process it for you to make it more durable.",
            "nextDialogs": [
              "708100215"
            ]
          },
          "708100215": {
            "id": "708100215",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "Huh, you know something, I can't actually remember the last time I had to get the tools for this job out of the cupboard."
          },
          "708100212": {
            "id": "708100212",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "The F—Fatui? You mean the ones from Snezhnaya? ...Your social circle is broad, to put it mildly."
          }
        }
      }
    },
    {
      "subId": "7081003",
      "subQuestName": "Make a Satisfying Salad and give it to Sara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708100301"
        ],
        "dialogs": {
          "708100301": {
            "id": "708100301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the specialty dish...",
            "nextDialogs": [
              "708100302"
            ]
          },
          "708100302": {
            "id": "708100302",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "How's the Satisfying Salad coming along? I'm ready when you are, just bring it right here when it's done."
          }
        }
      }
    },
    {
      "subId": "7081004",
      "subQuestName": "Make a Satisfying Salad and give it to Sara",

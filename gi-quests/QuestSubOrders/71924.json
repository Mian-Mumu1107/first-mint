        "dialogs": {
          "719240101": {
            "id": "719240101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You can go on adventures without a Vision.",
            "nextDialogs": [
              "719240102"
            ]
          },
          "719240102": {
            "id": "719240102",
            "speakerId": 1616,
            "speakerName": "Little Liu",
            "text": "You mean be one of those martial arts heroes? Hmph, no thank you!",
            "nextDialogs": [
              "719240103"
            ]
          },
          "719240103": {
            "id": "719240103",
            "speakerId": 1616,
            "speakerName": "Little Liu",
            "text": "After the old folks in the village discovered I had an interest in adventuring, they kept bringing me all these martial arts novels...",
            "nextDialogs": [
              "719240104"
            ]
          },
          "719240104": {
            "id": "719240104",
            "speakerId": 1616,
            "speakerName": "Little Liu",
            "text": "But when I read them, I was disappointed to find that the main characters are all ugly stinking men! Sorry, not my kind of story!",
            "nextDialogs": [
              "719240105"
            ]
          },
          "719240105": {
            "id": "719240105",
            "speakerId": 1616,
            "speakerName": "Little Liu",
            "text": "You haven't read any before? Here, knock yourself out, they're certainly no use to me!"
          }
        }
      }
    }
  ]

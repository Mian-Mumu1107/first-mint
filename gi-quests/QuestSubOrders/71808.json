        ],
        "dialogs": {
          "718080901": {
            "id": "718080901",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "You're back. What's the situation?",
            "nextDialogs": [
              "718080902"
            ]
          },
          "718080902": {
            "id": "718080902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Everything seems normal...",
            "nextDialogs": [
              "718080903"
            ]
          },
          "718080903": {
            "id": "718080903",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "Normal? So... no earthquakes, no monsters? How strange...",
            "nextDialogs": [
              "718080904"
            ]
          },
          "718080904": {
            "id": "718080904",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "Still, normality is good news. Thank you for your assistance, please take these as a token of my gratitude.",
            "nextDialogs": [
              "718080905"
            ]
          },
          "718080905": {
            "id": "718080905",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "Right, onto the next task... No matter how much I get done, there's always more to do..."
          }
        }
      }
    },
    {

    {
      "subId": "7180811",
      "subQuestName": "Report back to Jiayi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718080801"
        ],
        "dialogs": {
          "718080801": {
            "id": "718080801",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "You're back. What's the situation?",
            "nextDialogs": [
              "718080802"
            ]
          },
          "718080802": {
            "id": "718080802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, here's what it's like at Nantianmen...",
            "nextDialogs": [
              "718080803"
            ]
          },
          "718080803": {
            "id": "718080803",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "Really? There was actually an earthquake? ...Followed by monsters, out of nowhere?",
            "nextDialogs": [
              "718080804"
            ]
          },
          "718080804": {
            "id": "718080804",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "The monsters are no surprise, but these earthquakes... what could be causing them?",
            "nextDialogs": [
              "718080805"
            ]
          },
          "718080805": {
            "id": "718080805",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "Well, whatever the situation — safety is the top priority.",
            "nextDialogs": [
              "718080806"
            ]
          },
          "718080806": {
            "id": "718080806",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "I will report the situation in detail to the Ministry of Civil Affairs. Thank you for your assistance, please take these as a token of my gratitude.",
            "nextDialogs": [
              "718080807"
            ]
          },
          "718080807": {
            "id": "718080807",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "Ugh, the work just keeps piling up, and I can never get on top of it..."
          }
        }
      }

    {
      "subId": "7180802",
      "subQuestName": "Investigate the unusual activity in Nantianmen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718080201"
        ],
        "dialogs": {
          "718080201": {
            "id": "718080201",
            "speakerId": 1000,
            "speakerName": "Jiu",
            "text": "The awakening is coming...",
            "nextDialogs": [
              "718080202"
            ]
          },
          "718080202": {
            "id": "718080202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you alright?",
            "nextDialogs": [
              "718080203"
            ]
          },
          "718080203": {
            "id": "718080203",
            "speakerId": 1000,
            "speakerName": "Jiu",
            "text": "Are you here to witness His resurrection?",
            "nextDialogs": [
              "718080204"
            ]
          },
          "718080204": {
            "id": "718080204",
            "speakerId": 1000,
            "speakerName": "Jiu",
            "text": "You're a little early... But you're not too late, either.",
            "nextDialogs": [
              "718080205"
            ]
          },
          "718080205": {
            "id": "718080205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...What in the world is she talking about?",
            "nextDialogs": [
              "718080206"
            ]
          },
          "718080206": {
            "id": "718080206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Um, what are you talking about?",
            "nextDialogs": [
              "718080207"
            ]
          },
          "718080207": {
            "id": "718080207",
            "speakerId": 1000,
            "speakerName": "Jiu",
            "text": "Huh... Still the truth does not dawn on you...",
            "nextDialogs": [
              "718080208"
            ]
          },
          "718080208": {
            "id": "718080208",
            "speakerId": 1000,
            "speakerName": "Jiu",
            "text": "Though, perhaps it is better that way. For you.",
            "nextDialogs": [
              "718080209"
            ]
          },
          "718080209": {
            "id": "718080209",
            "speakerId": 1000,
            "speakerName": "Jiu",
            "text": "Return now, and await His awakening... Then, you shall surely understand."
          }
        }
      }
    },
    {
      "subId": "7180803",
      "subQuestName": "Investigate the unusual activity in Nantianmen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718080301"
        ],
        "dialogs": {
          "718080301": {
            "id": "718080301",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "You're back. What's the situation?",
            "nextDialogs": [
              "718080302"
            ]
          },
          "718080302": {
            "id": "718080302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, here's what it's like at Nantianmen...",
            "nextDialogs": [
              "718080303"
            ]
          },
          "718080303": {
            "id": "718080303",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "...Earthquakes, monsters, and a little girl... A missing child, presumably?",
            "nextDialogs": [
              "718080304"
            ]
          },
          "718080304": {
            "id": "718080304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's what she said...",
            "nextDialogs": [
              "718080305"
            ]
          },
          "718080305": {
            "id": "718080305",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "...She said what? Who's \"He\"? And what \"resurrection\"? What a load of nonsense...",
            "nextDialogs": [
              "718080306"
            ]
          },
          "718080306": {
            "id": "718080306",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "Who knows what kind of strange books she must have been reading... Anyway, that's beside the point. I'll send for someone to bring the child back to the city at once.",
            "nextDialogs": [
              "718080307"
            ]
          },
          "718080307": {
            "id": "718080307",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "First earthquakes, and now monsters... We musn't let that child come to harm.",
            "nextDialogs": [
              "718080308"
            ]
          },
          "718080308": {
            "id": "718080308",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "Thank you so much. Please take these as thanks for running this errand for me.",
            "nextDialogs": [
              "718080309"
            ]
          },
          "718080309": {
            "id": "718080309",
            "speakerId": 1002,
            "speakerName": "Jiayi",
            "text": "Ugh, never a slow day of work, eh?"
          }
        }
      }
    },

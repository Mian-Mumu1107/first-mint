  "subQuests": [
    {
      "subId": "7007001",
      "subQuestName": "Talk to Lisa",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706900301"
        ],
        "dialogs": {
          "706900301": {
            "id": "706900301",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Oh? You finished sorting already? That went much faster then I expected.",
            "nextDialogs": [
              "706900302"
            ]
          },
          "706900302": {
            "id": "706900302",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Now then, what would you like in return, cutie? You freed up my whole afternoon, helping me with that. How about we spend it together?",
            "nextDialogs": [
              "706900304"
            ]
          },
          "706900304": {
            "id": "706900304",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Oh, that's all? Well, don't worry. I won't forget.",
            "nextDialogs": [
              "706900306"
            ]
          },
          "706900306": {
            "id": "706900306",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Ah, so you noticed, too. Such strange names, and even stranger contents...",
            "nextDialogs": [
              "706900307"
            ]
          },
          "706900307": {
            "id": "706900307",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Not to mention, this is the largest library in northern Teyvat, and I didn't recognize a single title on the list. I just don't see how that's possible.",
            "nextDialogs": [
              "706900308"
            ]
          },
          "706900308": {
            "id": "706900308",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Unless...",
            "nextDialogs": [
              "706900309"
            ]
          },
          "706900309": {
            "id": "706900309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Actually, we just ran into—",
            "nextDialogs": [
              "706900310"
            ]
          },
          "706900310": {
            "id": "706900310",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Trouble, I presume? I think I'll steer clear, if it's all the same to you.",
            "nextDialogs": [
              "706900311"
            ]
          },
          "706900311": {
            "id": "706900311",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Besides, if a book exists in this world, then there's a place for them in this library.",
            "nextDialogs": [
              "706900312"
            ]
          },
          "706900312": {
            "id": "706900312",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Better for them to remain here than end up in the hands of someone more... suspect.",
            "nextDialogs": [
              "706900313"
            ]
          },
          "706900313": {
            "id": "706900313",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Anyway, here's your payment. Thanks again for all the help."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2002001",
      "subQuestName": "Talk to Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200200101"
        ],
        "dialogs": {
          "200200101": {
            "id": "200200101",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Oh, so that's how it is...",
            "nextDialogs": [
              "200200102"
            ]
          },
          "200200102": {
            "id": "200200102",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Brother, do you know what these plants can do aside from being edible?",
            "nextDialogs": [
              "200200103"
            ]
          },
          "200200103": {
            "id": "200200103",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "How am I supposed to know that?",
            "nextDialogs": [
              "200200104"
            ]
          },
          "200200104": {
            "id": "200200104",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "I just know where you can find them and whether you can eat them or not.",
            "nextDialogs": [
              "200200105"
            ]
          },
          "200200105": {
            "id": "200200105",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Huh... Then I guess I should go check them out myself. Don't worry, I'm just going to gather some plants. I won't go anywhere near those monsters.",
            "nextDialogs": [
              "200200106"
            ]
          },
          "200200106": {
            "id": "200200106",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "...Oh, just be careful, will you?",
            "nextDialogs": [
              "200200107"
            ]
          },
          "200200107": {
            "id": "200200107",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I know, I know. Well, I'll be a bit late back today, then.",
            "nextDialogs": [
              "200200110"
            ]
          },
          "200200110": {
            "id": "200200110",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Hey there, Traveler! Great timing — I was just planning to go out to observe some plants.",
            "nextDialogs": [
              "200200111"
            ]
          },
          "200200111": {
            "id": "200200111",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Cyrus told me that adventurers will often camp out in the wilds, where foraging is a very important skill.",
            "nextDialogs": [
              "200200112"
            ]
          },
          "200200112": {
            "id": "200200112",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "As such, I'm planning to go investigate some wild plants, check out their features and characteristics, and then commit them to memory slowly.",
            "nextDialogs": [
              "200200113"
            ]
          },
          "200200113": {
            "id": "200200113",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "That way, I'll at least know what I can and cannot eat out there in the future.",
            "nextDialogs": [
              "200200114"
            ]
          },
          "200200114": {
            "id": "200200114",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "However, I don't think that pure writing is going to be very intuitive.",
            "nextDialogs": [
              "200200115"
            ]
          },
          "200200115": {
            "id": "200200115",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Traveler, I've heard that you have a gadget known as the Kamera. Is that true?",
            "nextDialogs": [
              "200200116"
            ]
          },
          "200200116": {
            "id": "200200116",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "If so, could you help me snap some photos of a few plant species in their natural habitats?",
            "nextDialogs": [
              "200200117"
            ]
          },
          "200200117": {
            "id": "200200117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure.",
            "nextDialogs": [
              "200200118"
            ]
          },
          "200200118": {
            "id": "200200118",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Nice! In that case, could you get me photos of Calla Lilies, Small Lamp Grass, and Cecilias?",
            "nextDialogs": [
              "200200119"
            ]
          },
          "200200119": {
            "id": "200200119",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "After that, please help me gather these three plant species. I'd like to keep them as samples.",
            "nextDialogs": [
              "200200120"
            ]
          },
          "200200120": {
            "id": "200200120",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Images of these plants in their natural habitats, live specimens, and detailed descriptions...",
            "nextDialogs": [
              "200200121"
            ]
          },
          "200200121": {
            "id": "200200121",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "The botany section of my handbook looks to be in pretty good shape!",
            "nextDialogs": [
              "200200122"
            ]
          },
          "200200122": {
            "id": "200200122",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Alright then, Traveler, I'm counting on you.",
            "nextDialogs": [
              "200200123"
            ]
          },
          "200200123": {
            "id": "200200123",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "The spring in Springvale plays host to large numbers of Calla Lilies, while Small Lamp Grass is common in Wolvendom.",
            "nextDialogs": [
              "200200124"
            ]
          },
          "200200124": {
            "id": "200200124",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "As for Cecilias... it's got to be Starsnatch Cliff.",
            "nextDialogs": [
              "200200125"
            ]
          },
          "200200125": {
            "id": "200200125",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I'll continue my own plant observations elsewhere in the meantime.",
            "nextDialogs": [
              "200200126"
            ]
          },
          "200200126": {
            "id": "200200126",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Once you've got the pictures, let's meet up in the city."
          }
        }
      }
    },

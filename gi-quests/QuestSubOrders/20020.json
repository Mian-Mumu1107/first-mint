    {
      "subId": "2002012",
      "subQuestName": "Take a photo recording the Small Lamp Grass' habitat",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200201201"
        ],
        "dialogs": {
          "200201201": {
            "id": "200201201",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Well, how does it look? Pretty good, huh? I hope you'll enjoy it!",
            "nextDialogs": [
              "200201202"
            ]
          },
          "200201202": {
            "id": "200201202",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "As for me, I'll go write those notes up. Hmm, as for these plants...",
            "nextDialogs": [
              "200201203"
            ]
          },
          "200201203": {
            "id": "200201203",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I'll go ask Jack if he knows how to preserve plant specimens.",
            "nextDialogs": [
              "200201204"
            ]
          },
          "200201204": {
            "id": "200201204",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "As for the Cecilias, I guess they'd look better in a vase somewhere instead of serving as specimens..."
          }
        }
      }
    },

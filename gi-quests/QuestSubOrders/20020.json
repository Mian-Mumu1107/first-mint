    {
      "subId": "2002025",
      "subQuestName": "Report back to Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200201001"
        ],
        "dialogs": {
          "200201001": {
            "id": "200201001",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "You're back, Traveler! How have things gone? Did you manage to get those pictures?",
            "nextDialogs": [
              "200201002"
            ]
          },
          "200201002": {
            "id": "200201002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pictures and samples, got them all right here.",
            "nextDialogs": [
              "200201003"
            ]
          },
          "200201003": {
            "id": "200201003",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Wow! That was super fast! I guess that's a seasoned adventurer for you, huh? You're amazing...",
            "nextDialogs": [
              "200201004"
            ]
          },
          "200201004": {
            "id": "200201004",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Thank you so much, Traveler! Actually, how about this? Let me make you a meal to show my thanks. I guarantee it'll be good!",
            "nextDialogs": [
              "200201005"
            ]
          },
          "200201005": {
            "id": "200201005",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Well, how does it look? Pretty good, huh? I hope you'll enjoy it!",
            "nextDialogs": [
              "200201006"
            ]
          },
          "200201006": {
            "id": "200201006",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "As for me, I'll go write those notes up. Hmm, as for these plants...",
            "nextDialogs": [
              "200201007"
            ]
          },
          "200201007": {
            "id": "200201007",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I'll go ask Jack if he knows how to preserve plant specimens.",
            "nextDialogs": [
              "200201008"
            ]
          },
          "200201008": {
            "id": "200201008",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "As for the Cecilias, I guess they'd look better in a vase somewhere instead of serving as specimens..."
          }
        }
      }
    },

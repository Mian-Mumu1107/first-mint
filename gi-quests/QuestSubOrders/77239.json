  "subQuests": [
    {
      "subId": "7723901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772390101"
        ],
        "dialogs": {
          "772390101": {
            "id": "772390101",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "Will no one step up? Come now, people of Morepesok! I don't mean to look down on you, you know!",
            "nextDialogs": [
              "772390102"
            ]
          },
          "772390102": {
            "id": "772390102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And you are...?",
            "nextDialogs": [
              "772390103"
            ]
          },
          "772390103": {
            "id": "772390103",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "The name's Likhovidova, the one who's set up this Snowball Dodge Arena!",
            "nextDialogs": [
              "772390104"
            ]
          },
          "772390104": {
            "id": "772390104",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "I used to be an Adventurers' Guild member myself, you know. And there was this one time, when I encountered a pack of Fluffahogs amidst a snowy night on the tundra.",
            "nextDialogs": [
              "772390105"
            ]
          },
          "772390105": {
            "id": "772390105",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "They came rolling on, like a cannonball made of giant spikes, and I was left a right sobbing mess by the end of the chase...",
            "nextDialogs": [
              "772390106"
            ]
          },
          "772390106": {
            "id": "772390106",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "Having survived this ordeal, I committed myself to training harder, using snowballs during said training to simulate the impact of their charges.",
            "nextDialogs": [
              "772390107"
            ]
          },
          "772390107": {
            "id": "772390107",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "Once I succeeded, I would have the agility to humiliate them the next time we met! Hehehe...",
            "nextDialogs": [
              "772390108"
            ]
          },
          "772390108": {
            "id": "772390108",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "Hence, the Snowball Dodge Arena!",
            "nextDialogs": [
              "772390109"
            ]
          },
          "772390109": {
            "id": "772390109",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "The rules are simple. Stand in the arena and try to avoid being hit by snowballs. The longer you last, the greater the prize!",
            "nextDialogs": [
              "772390110"
            ]
          },
          "772390110": {
            "id": "772390110",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "What do you think? I can see it burning in your eyes — the will of a warrior. Wanna give this a try, then?",
            "nextDialogs": [
              "772390112",
              "772390114"
            ]
          },
          "772390112": {
            "id": "772390112",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "Alright then. Step right up!"
          },
          "772390114": {
            "id": "772390114",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "No worries! Just as that flock of Fluffahogs awaits me still amidst the white birches, the Snowball Dodge Arena will always wait for you!",
            "nextDialogs": [
              "772390115"
            ]
          },
          "772390115": {
            "id": "772390115",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "It's fate, you know — it's fate that had us meet this way. You'll realize that one day, I'm sure of it."
          }
        }
      }
    },
    {
      "subId": "7723902",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772390201"
        ],
        "dialogs": {
          "772390201": {
            "id": "772390201",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "What ingenuity. The way you dodged these snowballs, these simulated monsters... every move was filled with such inventiveness!",
            "nextDialogs": [
              "772390202"
            ]
          },
          "772390202": {
            "id": "772390202",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "Ah, what a shame. If we only had a Kamera with us, I could've recorded your various dodging techniques for further study.",
            "nextDialogs": [
              "772390203"
            ]
          },
          "772390203": {
            "id": "772390203",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "Here... These are all for you. Ah, if only I had such agility back then. I would've been untouchable, even had those Fluffahogs come rolling on!"
          }
        }
      }
    },
    {
      "subId": "7723903",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772390301"
        ],
        "dialogs": {

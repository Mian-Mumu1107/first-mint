            "id": "772390301",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "So, how about it? Got a moment to try out the Snowball Dodge Arena?",
            "nextDialogs": [
              "772390303",
              "772390305"
            ]
          },
          "772390303": {
            "id": "772390303",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "Alright then. Step right up!"
          },
          "772390305": {
            "id": "772390305",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "No worries! Just as the Fluffahogs await me amidst the white birches, the Snowball Dodge Arena will always wait for you!",
            "nextDialogs": [
              "772390306"
            ]
          },
          "772390306": {
            "id": "772390306",
            "speakerId": 1000,
            "speakerName": "Likhovidova",
            "text": "It's fate, you know — it's fate that had us meet this way. You'll realize that one day, I'm sure of it."

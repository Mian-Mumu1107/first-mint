    {
      "subId": "7501809",
      "subQuestName": "Subdue \"Kururuk\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750180903"
        ],
        "dialogs": {
          "750180903": {
            "id": "750180903",
            "speakerId": 1006,
            "speakerName": "\"Kururuk\"",
            "text": "Rrooah...",
            "nextDialogs": [
              "750180901"
            ]
          },
          "750180901": {
            "id": "750180901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is this really a Saurian who still hasn't fully recovered?",
            "nextDialogs": [
              "750180904"
            ]
          },
          "750180904": {
            "id": "750180904",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrrooo... Rawr! Rawr! Raaawr!",
            "nextDialogs": [
              "750180902"
            ]
          },
          "750180902": {
            "id": "750180902",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "He'd probably be a super tough opponent when he's in tip-top shape... Anyway, let's bring him back to Mazkal while he's being a bit more docile!"
          }
        }
      }
    },
    {
      "subId": "7501810",
      "subQuestName": "Talk to Mazkal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750181001"
        ],
        "dialogs": {
          "750181001": {
            "id": "750181001",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr! Raaaawr!",
            "nextDialogs": [
              "750181002"
            ]
          },
          "750181002": {
            "id": "750181002",
            "speakerId": 1005,
            "speakerName": "Mazkal",
            "text": "You're back! How did it go? Did Kururuk take his medicine?",
            "nextDialogs": [
              "750181003"
            ]
          },
          "750181003": {
            "id": "750181003",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Well, he did, but...",
            "nextDialogs": [
              "750181004"
            ]
          },
          "750181004": {
            "id": "750181004",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You explain what happened earlier...",
            "nextDialogs": [
              "750181017"
            ]
          },
          "750181017": {
            "id": "750181017",
            "speakerId": 1005,
            "speakerName": "Mazkal",
            "text": "I see. Alright, let me have a look... Hmm. Looks like he's fine, not hurt too badly at all.",
            "nextDialogs": [
              "750181005"
            ]
          },
          "750181005": {
            "id": "750181005",
            "speakerId": 1005,
            "speakerName": "Mazkal",
            "text": "Either way, it's a good thing that he took the medicine! And now that I know how he reacts, I can adjust the formula accordingly.",
            "nextDialogs": [
              "750181006"
            ]
          },
          "750181006": {
            "id": "750181006",
            "speakerId": 1005,
            "speakerName": "Mazkal",
            "text": "#Yup, don't worry, we should be fine. Thanks for your help — especially you, {REALNAME[ID(2)|SHOWHOST(true)]}! What an amazing little Tepetlisaur you are!",
            "nextDialogs": [
              "750181007"
            ]
          },
          "750181007": {
            "id": "750181007",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawwr!",
            "nextDialogs": [
              "750181008"
            ]
          },
          "750181008": {
            "id": "750181008",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Haha, it's nice hearing people praise {REALNAME[ID(2)|SHOWHOST(true)]} — even better than hearing them praise Paimon, in fact!",
            "nextDialogs": [
              "750181009"
            ]
          },
          "750181009": {
            "id": "750181009",
            "speakerId": 1005,
            "speakerName": "Mazkal",
            "text": "I'm impressed at how well you two get along with this little guy too. I could stand to learn a thing or two from you.",
            "nextDialogs": [
              "750181012"
            ]
          },
          "750181012": {
            "id": "750181012",
            "speakerId": 1005,
            "speakerName": "Mazkal",
            "text": "I'd love to say that there's something I could do to help you, or do for you...",
            "nextDialogs": [
              "750181013"
            ]
          },
          "750181013": {
            "id": "750181013",
            "speakerId": 1005,
            "speakerName": "Mazkal",
            "text": "But I think I'll settle for wishing you the best of health. Best you never need my help!",
            "nextDialogs": [
              "750181014"
            ]
          },
          "750181014": {
            "id": "750181014",
            "speakerId": 1005,
            "speakerName": "Mazkal",
            "text": "Ah, right, but if you just want to chat, you're welcome to come find me anytime.",
            "nextDialogs": [
              "750181015"
            ]
          },
          "750181015": {
            "id": "750181015",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Sure! Hope Kururuk recovers soon — hopefully without instantly resorting to hitting people, like he did earlier...",
            "nextDialogs": [
              "750181016"
            ]
          },
          "750181016": {
            "id": "750181016",
            "speakerId": 1005,
            "speakerName": "Mazkal",
            "text": "As for that... Not to worry, I'll figure something out. And you never know, his temper might improve along with his wounds!"
          }
        }
      }
    },

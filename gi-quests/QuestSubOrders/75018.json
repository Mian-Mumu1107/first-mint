    {
      "subId": "7501805",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750180501"
        ],
        "dialogs": {
          "750180501": {
            "id": "750180501",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Well, even if this one doesn't work as well, just having him eat the medicine at all is progress enough! Let's do this, {REALNAME[ID(2)|SHOWHOST(true)]}!",
            "nextDialogs": [
              "750180510"
            ]
          },
          "750180510": {
            "id": "750180510",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750180511"
            ]
          },
          "750180511": {
            "id": "750180511",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ooh, he snapped it right up? Hmm... But he still looks pretty listless.",
            "nextDialogs": [
              "750180512"
            ]
          },
          "750180512": {
            "id": "750180512",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Wroo?",
            "nextDialogs": [
              "750180513"
            ]

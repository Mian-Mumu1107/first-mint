    {
      "subId": "7501806",
      "subQuestName": "Catch up with \"Kururuk\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750180601"
        ],
        "dialogs": {
          "750180601": {
            "id": "750180601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Might as well.",
            "nextDialogs": [
              "750180602"
            ]
          },
          "750180602": {
            "id": "750180602",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#We're counting on you for Round Two, {REALNAME[ID(2)|SHOWHOST(true)]}!",
            "nextDialogs": [
              "750180603"
            ]
          },
          "750180603": {
            "id": "750180603",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750180604"
            ]
          },
          "750180604": {
            "id": "750180604",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Chowed it right down! But...",
            "nextDialogs": [
              "750180605"
            ]
          },
          "750180605": {
            "id": "750180605",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Uh oh! He's even madder than before! Quick, we gotta calm him down!"
          }
        }
      }
    },
    {
      "subId": "7501807",
      "subQuestName": "Have \"Kururuk\" take some medicine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750180701"
        ],
        "dialogs": {
          "750180701": {
            "id": "750180701",
            "speakerId": 1006,
            "speakerName": "\"Kururuk\"",
            "text": "Shrawr...",
            "nextDialogs": [
              "750180702"
            ]
          },
          "750180702": {
            "id": "750180702",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, Paimon's kinda worried about how Kururuk's wounds haven't fully healed yet... Why don't we follow him and see how things are?",
            "nextDialogs": [
              "750180706"
            ]
          },
          "750180706": {
            "id": "750180706",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "#You hurry over to {REALNAME[ID(2)|SHOWHOST(true)]} and Kururuk.",
            "nextDialogs": [
              "750180703"
            ]
          },
          "750180703": {
            "id": "750180703",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "There he is? Phew, at least he looks fine... Alright, let's feed him the medicine now!",
            "nextDialogs": [
              "750180704"
            ]
          },
          "750180704": {
            "id": "750180704",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Which of the two should we go with?"
          }
        }
      }
    },
    {
      "subId": "7501805",
      "subQuestName": "Have \"Kururuk\" take some medicine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750180403"
        ],
        "dialogs": {
          "750180403": {
            "id": "750180403",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#If he'll eat it, this one should help him recover better, right? You've got this now, {REALNAME[ID(2)|SHOWHOST(true)]}!",
            "nextDialogs": [
              "750180405"
            ]
          },
          "750180405": {
            "id": "750180405",
            "speakerId": 1004,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750180406"
            ]
          },
          "750180406": {
            "id": "750180406",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Looks pretty hopeful. Hehe, good work, {REALNAME[ID(2)|SHOWHOST(true)]}! ...Err, wait a minute...",
            "nextDialogs": [
              "750180407"
            ]
          },
          "750180407": {
            "id": "750180407",
            "speakerId": 1006,
            "speakerName": "\"Kururuk\"",
            "text": "—Shwaaaargh!",
            "nextDialogs": [
              "750180408"
            ]
          },
          "750180408": {
            "id": "750180408",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Huh!? W—Was the medicine too effective? He looks even angrier than before! Gah, we've gotta calm him down real quick..."
          }
        }
      }
    },
    {

    {
      "subId": "7501801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750180101"
        ],
        "dialogs": {
          "750180101": {
            "id": "750180101",
            "speakerId": 1000,
            "speakerName": "Infuriated Qucusaurus",
            "text": "—Shwaaaargh!",
            "nextDialogs": [
              "750180102"
            ]
          },
          "750180102": {
            "id": "750180102",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "Come on kiddo, come on now, quit fooling around. If you don't take your meds, you won't recover!",
            "nextDialogs": [
              "750180103"
            ]
          },
          "750180103": {
            "id": "750180103",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Oh no, she's in danger! We've gotta help her, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "7501802",

    {
      "subId": "2303002",
      "subQuestName": "Go with Ladep",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230300201"
        ],
        "dialogs": {
          "230300201": {
            "id": "230300201",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "Look at that box. I think it's got the potions in it. Yasmin must have been here already.",
            "nextDialogs": [
              "230300202"
            ]
          },
          "230300202": {
            "id": "230300202",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "Huh? The lids of the potions haven't been opened yet...",
            "nextDialogs": [
              "230300203"
            ]
          },
          "230300203": {
            "id": "230300203",
            "speakerId": 12689,
            "speakerName": "Pharez",
            "text": "Don't uncap them!",
            "nextDialogs": [
              "230300204"
            ]
          },
          "230300204": {
            "id": "230300204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wah! There are Fungi emerging behind you!",
            "nextDialogs": [
              "230300205"
            ]
          },
          "230300205": {
            "id": "230300205",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "What? There weren't any before. What's going on?",
            "nextDialogs": [
              "230300206"
            ]
          },
          "230300206": {
            "id": "230300206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Let's not listen to their nagging any longer, {NICKNAME}. Let's go!"
          }
        }
      }
    },
    {
      "subId": "2303003",
      "subQuestName": "Defeat all Fungi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2303004",
      "subQuestName": "Talk to Ladep",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230300401"
        ],
        "dialogs": {
          "230300401": {
            "id": "230300401",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "Whoo, lucky us, huh? Good thing the jar didn't break, or we might be experiencing some serious vomiting right now...",
            "nextDialogs": [
              "230300402"
            ]
          },
          "230300402": {
            "id": "230300402",
            "speakerId": 12689,
            "speakerName": "Pharez",
            "text": "Wait. You're not used to the smell? Didn't you make that yourself?",
            "nextDialogs": [
              "230300403"
            ]
          },
          "230300403": {
            "id": "230300403",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "How many times have I explained to you that I added physiological emetics, huh?",
            "nextDialogs": [
              "230300404"
            ]
          },
          "230300404": {
            "id": "230300404",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "It has nothing to do with whether you are used to it or not, the smell just triggers automatic vomiting in anyone.",
            "nextDialogs": [
              "230300405"
            ]
          },
          "230300405": {
            "id": "230300405",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "Seriously, why do I even repeat myself? You won't understand anyway...",
            "nextDialogs": [
              "230300406"
            ]
          },
          "230300406": {
            "id": "230300406",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "Also, where on earth did Yasmin go? She didn't even sprinkle the potions today...",
            "nextDialogs": [
              "230300407"
            ]
          },
          "230300407": {
            "id": "230300407",
            "speakerId": 12689,
            "speakerName": "Pharez",
            "text": "She must have gone sampling some rare plants she found. Typical Amurta behavior and stuff... I mean, how do you still not know how they're like?",
            "nextDialogs": [
              "230300408"
            ]
          },
          "230300408": {
            "id": "230300408",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "Alright, we'll look after this jar now. Thanks for your help, Traveler. Please take these.",
            "nextDialogs": [
              "230300409"
            ]
          },
          "230300409": {
            "id": "230300409",
            "speakerId": 12689,
            "speakerName": "Pharez",
            "text": "Ugh, these Amurta... They're just..."
          }
        }
      }
    },
    {
      "subId": "2303005",
      "subQuestName": "Talk to Ladep",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230300501"
        ],
        "dialogs": {
          "230300501": {
            "id": "230300501",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "*cough*, *cough* *cough*... We should be fine here...",
            "nextDialogs": [
              "230300502"
            ]
          },
          "230300502": {
            "id": "230300502",
            "speakerId": 12689,
            "speakerName": "Pharez",
            "text": "Ugh... Blargh... You... This was your handiwork! How are you vomiting too?",
            "nextDialogs": [
              "230300503"
            ]
          },
          "230300503": {
            "id": "230300503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ugh... *cough* *cough* *cough*",
            "nextDialogs": [
              "230300504"
            ]
          },
          "230300504": {
            "id": "230300504",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "I have... explained multiple times that I added physiological emetics!",
            "nextDialogs": [
              "230300505"
            ]
          },
          "230300505": {
            "id": "230300505",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "It has nothing to do with whether you are used to it. The smell just triggers automatic vomiting in anyone.",
            "nextDialogs": [
              "230300506"
            ]
          },
          "230300506": {
            "id": "230300506",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "Seriously, why do I even repeat myself? You won't understand anyway... Blergh...",
            "nextDialogs": [
              "230300507"
            ]
          },
          "230300507": {
            "id": "230300507",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "Eh? Ladep, Pharez, and the Traveler, too? What brings all of you here?",
            "nextDialogs": [
              "230300508"
            ]
          },
          "230300508": {
            "id": "230300508",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "And the potion jar is broken... Was there some kind of monster attack?",
            "nextDialogs": [
              "230300509"
            ]
          },
          "230300509": {
            "id": "230300509",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "Judging from how things look... That's probably the case. Did you see any monsters on your way here?",
            "nextDialogs": [
              "230300510"
            ]
          },
          "230300510": {
            "id": "230300510",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "No. In fact, I even took some time to sample several plants around here.",
            "nextDialogs": [
              "230300511"
            ]
          },
          "230300511": {
            "id": "230300511",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "That's quite odd... Very odd indeed.",
            "nextDialogs": [
              "230300512"
            ]
          },
          "230300512": {
            "id": "230300512",
            "speakerId": 12689,
            "speakerName": "Pharez",
            "text": "What's so odd about this? Your potion is what attracted them here, obviously!",
            "nextDialogs": [
              "230300513"
            ]
          },
          "230300513": {
            "id": "230300513",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "What!? The field tests didn't demonstrate anything like that...",
            "nextDialogs": [
              "230300514"
            ]
          },
          "230300514": {
            "id": "230300514",
            "speakerId": 12689,
            "speakerName": "Pharez",
            "text": "Well, now you've seen it with your own eyes, can you be a little more realistic?",
            "nextDialogs": [
              "230300515"
            ]
          },
          "230300515": {
            "id": "230300515",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "We will... discuss that later. Traveler, thanks so much for your help. Please take this as your payment.",
            "nextDialogs": [
              "230300516"
            ]
          },
          "230300516": {
            "id": "230300516",
            "speakerId": 12688,
            "speakerName": "Ladep",
            "text": "Where did it go wrong..."
          }
        }
      }
    }
  ]
}
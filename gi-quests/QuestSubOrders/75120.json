          "751200104": {
            "id": "751200104",
            "speakerId": 1000,
            "speakerName": "Bitsin",
            "text": "That's why this Warrior's Challenge was set up. No matter how high up you are, you've got to watch your step... Would you like to give this a go, Outlander Warrior?"
          }
        }
      }
    },

        ],
        "dialogs": {
          "240030201": {
            "id": "240030201",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Whoa! You found me! Did my brother tell you about this spot!?",
            "nextDialogs": [
              "240030202"
            ]
          },
          "240030202": {
            "id": "240030202",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Bah, alright, guess you're pretty good at this. I'm going to our meeting place."
          }
        }
      }
    },

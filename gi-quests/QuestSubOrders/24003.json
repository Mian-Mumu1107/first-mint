  "subQuests": [
    {
      "subId": "2400301",
      "subQuestName": "Talk to Verut",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240030101"
        ],
        "dialogs": {
          "240030101": {
            "id": "240030101",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "You won't find the hiding spot I picked this time!",
            "nextDialogs": [
              "240030102"
            ]
          },
          "240030102": {
            "id": "240030102",
            "speakerId": 1001,
            "speakerName": "Aurele",
            "text": "If you hide in those places, it'll be your parents who come looking for you, not me.",
            "nextDialogs": [
              "240030103"
            ]
          },
          "240030103": {
            "id": "240030103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "240030104"
            ]
          },
          "240030104": {
            "id": "240030104",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "I'm playing hide-and-seek with my brother! Trouble is... Well, he knows all my hiding spots...",
            "nextDialogs": [
              "240030105"
            ]
          },
          "240030105": {
            "id": "240030105",
            "speakerId": 1001,
            "speakerName": "Aurele",
            "text": "Verut, we've been playing here for so long that you've hidden everywhere there is to hide.",
            "nextDialogs": [
              "240030106"
            ]
          },
          "240030106": {
            "id": "240030106",
            "speakerId": 1001,
            "speakerName": "Aurele",
            "text": "As for those places where you can't hide... If I've told you once, I've told you a thousand times why you can't go there.",
            "nextDialogs": [
              "240030107"
            ]
          },
          "240030107": {
            "id": "240030107",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Oh, those places aren't that dangerous! Mom and Dad exaggerate way too much!",
            "nextDialogs": [
              "240030108"
            ]
          },
          "240030108": {
            "id": "240030108",
            "speakerId": 1001,
            "speakerName": "Aurele",
            "text": "But when you hide in those places, your clothes and pants will get dirty or torn. Mom and Dad work hard enough already, so don't give them one extra thing to worry about.",
            "nextDialogs": [
              "240030109"
            ]
          },
          "240030109": {
            "id": "240030109",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Oh... Alright...",
            "nextDialogs": [
              "240030112"
            ]
          },
          "240030112": {
            "id": "240030112",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Really? You wanna play with me?",
            "nextDialogs": [
              "240030113"
            ]
          },
          "240030113": {
            "id": "240030113",
            "speakerId": 1001,
            "speakerName": "Aurele",
            "text": "Verut, don't make trouble for others! Sorry, all my brother ever thinks about is playing..."
          }
        }
      }
    },
    {
      "subId": "2400302",
      "subQuestName": "Look for Aurele and Verut",
      "sceneId": null,
      "locations": [],
      "dialogue": {

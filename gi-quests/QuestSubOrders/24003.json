    {
      "subId": "2400303",
      "subQuestName": "Look for Aurele and Verut",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240030701"
        ],
        "dialogs": {
          "240030701": {
            "id": "240030701",
            "speakerId": 1001,
            "speakerName": "Aurele",
            "text": "When will Verut grow up... *sigh*",
            "nextDialogs": [
              "240030702"
            ]
          },
          "240030702": {
            "id": "240030702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not hiding?",
            "nextDialogs": [
              "240030703"
            ]
          },
          "240030703": {
            "id": "240030703",
            "speakerId": 1001,
            "speakerName": "Aurele",
            "text": "I never really intended to. If Verut didn't bother me as often as he does, I would prefer to read my books for a while more.",
            "nextDialogs": [
              "240030704"
            ]
          },
          "240030704": {
            "id": "240030704",
            "speakerId": 1001,
            "speakerName": "Aurele",
            "text": "Our parents work so hard, so I've got to grow up fast and help lighten their load.",
            "nextDialogs": [
              "240030705"
            ]
          },
          "240030705": {
            "id": "240030705",
            "speakerId": 1001,
            "speakerName": "Aurele",
            "text": "But Verut keeps saying that he misses Mom, so I have to accompany him. That way, he'll stop crying for a bit.",
            "nextDialogs": [
              "240030706"
            ]
          },
          "240030706": {
            "id": "240030706",
            "speakerId": 1001,
            "speakerName": "Aurele",
            "text": "Sorry, I've said too much. I'll be waiting at our meeting spot.",
            "nextDialogs": [
              "240030707"
            ]
          },
          "240030707": {
            "id": "240030707",
            "speakerId": 1001,
            "speakerName": "Aurele",
            "text": "I can only hope that Verut won't dirty his clothes this time..."
          }
        }
      }
    },
    {
      "subId": "2400307",
      "subQuestName": "Talk to Verut",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240030901"
        ],
        "dialogs": {
          "240030901": {
            "id": "240030901",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "#Hey! Did you tell {M#him}{F#her} about my spot? How did {M#he}{F#she} find me that quickly?",
            "nextDialogs": [
              "240030902"
            ]
          },
          "240030902": {
            "id": "240030902",
            "speakerId": 1001,
            "speakerName": "Aurele",
            "text": "I've told you this before. Your hiding spots are way too obvious.",
            "nextDialogs": [
              "240030905"
            ]
          },
          "240030905": {
            "id": "240030905",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Really? In that case, will you come over next time too? Could we play together again?",
            "nextDialogs": [
              "240030906"
            ]
          },
          "240030906": {
            "id": "240030906",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Our parents aren't at home in the day, and my big brother's always reading... No one has time to play...",
            "nextDialogs": [
              "240030907"
            ]
          },
          "240030907": {
            "id": "240030907",
            "speakerId": 1001,
            "speakerName": "Aurele",
            "text": "Well, you can do what I do and read the books on the shelves. That's a lot more useful than playing hide-and-seek.",
            "nextDialogs": [
              "240030908"
            ]
          },
          "240030908": {
            "id": "240030908",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Well... I'd rather go look for Mom and learn sewing from her..."
          }
        }
      }
    },
    {
      "subId": "2400399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240039901"
        ],
        "dialogs": {
          "240039901": {
            "id": "240039901",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Can't find me...",
            "nextDialogs": [
              "240039902"
            ]
          },
          "240039902": {
            "id": "240039902",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "This spot looks good...",
            "nextDialogs": [
              "240039903"
            ]
          },
          "240039903": {
            "id": "240039903",
            "speakerId": 1001,
            "speakerName": "Aurele",
            "text": "I hope Verut will enjoy himself.",
            "nextDialogs": [
              "240039904"
            ]
          },
          "240039904": {
            "id": "240039904",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "I hope he's having a good time..."
          }
        }
      }
    }
  ]

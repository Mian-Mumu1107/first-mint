      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721170101"
        ],
        "dialogs": {
          "721170101": {
            "id": "721170101",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "Ah, such perfect timing, Traveler! The data has almost all been gathered, and it is now time to retrieve our beacons!",
            "nextDialogs": [
              "721170103",
              "721170105"
            ]
          },
          "721170103": {
            "id": "721170103",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "That I shall, that I shall. Best to be quick, and sneaky too. Don't let those Fatui spot you!"
          },
          "721170105": {
            "id": "721170105",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "These beacons always come with very detailed instruction manuals.",
            "nextDialogs": [
              "721170106"
            ]
          },
          "721170106": {
            "id": "721170106",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "These describe various different circumstances and the amount of time required for data-gathering in each circumstance.",
            "nextDialogs": [
              "721170107"
            ]
          },
          "721170107": {
            "id": "721170107",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "As for unknown forms of energy like Tatarigami, I will simply consider them to require the longest duration. Either way, the task of retrieving those beacons falls to you."
          }
        }
      }
    },
    {
      "subId": "7211702",

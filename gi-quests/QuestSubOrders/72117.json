    {
      "subId": "7211703",
      "subQuestName": "Retrieve the beacon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721170301"
        ],
        "dialogs": {
          "721170301": {
            "id": "721170301",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "How did it go? Do you have all our beacons?",
            "nextDialogs": [
              "721170302"
            ]
          },
          "721170302": {
            "id": "721170302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got them all right here.",
            "nextDialogs": [
              "721170303"
            ]
          },
          "721170303": {
            "id": "721170303",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Bravo! Now, just give me a moment while I modify this device.",
            "nextDialogs": [
              "721170304"
            ]
          },
          "721170304": {
            "id": "721170304",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "I must say, the Fatui have been acting more and more strangely recently. They seem to be gathering around the core of the furnace.",
            "nextDialogs": [
              "721170305"
            ]
          },
          "721170305": {
            "id": "721170305",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Hopefully, they aren't hatching some other dastardly plot. Or should I say, trying to do something that we won't be able to mitigate..."
          }
        }
      }
    },
    {
      "subId": "7211704",
      "subQuestName": "Retrieve the beacon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721170401"
        ],
        "dialogs": {
          "721170401": {
            "id": "721170401",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Now, all we need to do is wait for our beacons to collect enough data.",
            "nextDialogs": [
              "721170402"
            ]
          },
          "721170402": {
            "id": "721170402",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Once we have that data on hand, I will make a few tweaks to this device accordingly.",
            "nextDialogs": [
              "721170403"
            ]
          },
          "721170403": {
            "id": "721170403",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Once all is ready, let us put a decisive end to this incident."
          }
        }
      }
    },

    {
      "subId": "1911701",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191170106"
        ],
        "dialogs": {
          "191170106": {
            "id": "191170106",
            "speakerId": 12156,
            "speakerName": "Ninken",
            "text": "Woof! Woof! *growl*",
            "nextDialogs": [
              "191170107"
            ]
          },
          "191170107": {
            "id": "191170107",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "You're a vicious little thing, aren't you? You almost bit me again!",
            "nextDialogs": [
              "191170108"
            ]
          },
          "191170108": {
            "id": "191170108",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "Look at you, wasting away... you must wanna eat a little something?",
            "nextDialogs": [
              "191170109"
            ]
          },
          "191170109": {
            "id": "191170109",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "You don't have to come back with us, but c'mon — a dog's gotta eat, right?",
            "nextDialogs": [
              "191170110"
            ]
          },
          "191170110": {
            "id": "191170110",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "You're not worried it's poisoned, are you? Here, I'll take the first bite.",
            "nextDialogs": [
              "191170121"
            ]
          },
          "191170121": {
            "id": "191170121",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "See? Delicious and poison-free.",
            "nextDialogs": [
              "191170113"
            ]
          },
          "191170113": {
            "id": "191170113",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "Come on, just have a bite. A little tiny bite, and then I'll leave you alone, how's that sound?",
            "nextDialogs": [
              "191170114"
            ]
          },
          "191170114": {
            "id": "191170114",
            "speakerId": 12156,
            "speakerName": "Ninken",
            "text": "Woof! Woof, woof!",
            "nextDialogs": [
              "191170115"
            ]
          },
          "191170115": {
            "id": "191170115",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "Looks like it has zero intention of eating the food we brought... Is it just me, or does it look kind of on edge?",
            "nextDialogs": [
              "191170116"
            ]
          },
          "191170116": {
            "id": "191170116",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "Maybe it's something in the sea... Or something nearby that's got him on alert.",
            "nextDialogs": [
              "191170117"
            ]
          },
          "191170117": {
            "id": "191170117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Those monsters, perhaps?",
            "nextDialogs": [
              "191170118"
            ]
          },
          "191170118": {
            "id": "191170118",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "You think he was attacked by monsters... Hmm, it's possible.",
            "nextDialogs": [
              "191170119"
            ]
          },
          "191170119": {
            "id": "191170119",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "People do tend to lose their appetite in dangerous situations. Maybe it's the same for dogs, too. Let's clear out the area on behalf of our canine companion here.",
            "nextDialogs": [
              "191170120"
            ]
          },
          "191170120": {
            "id": "191170120",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "#Thanks for helping out. This place should be a little more tranquil now, {NICKNAME}."
          }
        }
      }
    }
  ]

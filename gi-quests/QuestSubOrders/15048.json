    {
      "subId": "1504806",
      "subQuestName": "Go to the destination",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150480601"
        ],
        "dialogs": {
          "150480601": {
            "id": "150480601",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "Okay, just a little further. Stay calm...",
            "nextDialogs": [
              "150480602"
            ]
          },
          "150480602": {
            "id": "150480602",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "Wait, what!? Where did the finish line go...?",
            "nextDialogs": [
              "150480603"
            ]
          },
          "150480603": {
            "id": "150480603",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "Oh no, did I just jinx myself? Or use up all my luck? ...No, c'mon, I can't lose hope now.",
            "nextDialogs": [
              "150480604"
            ]
          },
          "150480604": {
            "id": "150480604",
            "speakerId": 1002,
            "speakerName": "Asha",
            "text": "♪",
            "nextDialogs": [
              "150480605"
            ]
          },
          "150480605": {
            "id": "150480605",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "That's right, I can always follow my Asha buddy! Just gotta trust our connection..."
          }
        }
      }
    },
    {
      "subId": "1504807",

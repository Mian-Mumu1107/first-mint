  "subQuests": [
    {
      "subId": "1504801",
      "subQuestName": "Head to \"Asha Speedrun\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150480101"
        ],
        "dialogs": {
          "150480101": {
            "id": "150480101",
            "speakerId": 1000,
            "speakerName": "Gaun",
            "text": "...I'm sorry, but we can't let you take that risk.",
            "nextDialogs": [
              "150480102"
            ]
          },
          "150480102": {
            "id": "150480102",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "But that's not what you said earlier...",
            "nextDialogs": [
              "150480103"
            ]
          },
          "150480103": {
            "id": "150480103",
            "speakerId": 1000,
            "speakerName": "Gaun",
            "text": "Our sincerest apologies. We may be pressed for time, but the safety of our visitors has to come first. We hope you understand.",
            "nextDialogs": [
              "150480104"
            ]
          },
          "150480104": {
            "id": "150480104",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "#Oh, {NICKNAME}! Perfect timing! Could you help me talk this gentleman around?",
            "nextDialogs": [
              "150480105"
            ]
          },
          "150480105": {
            "id": "150480105",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "They need someone for the testing, so I went over all my adventuring experience, made it clear I was willing to accept any risks... It was all going so well...",
            "nextDialogs": [
              "150480106"
            ]
          },
          "150480106": {
            "id": "150480106",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "But the minute I mentioned some of the close calls I've had in the past, he flat-out refused to let me take part.",
            "nextDialogs": [
              "150480107"
            ]
          },
          "150480107": {
            "id": "150480107",
            "speakerId": 1000,
            "speakerName": "Gaun",
            "text": "Sir, I appreciate your enthusiasm, I truly do.",
            "nextDialogs": [
              "150480108"
            ]
          },
          "150480108": {
            "id": "150480108",
            "speakerId": 1000,
            "speakerName": "Gaun",
            "text": "But if you, in your own words, have a tendency to fall into rivers even when you're crossing a bridge made of solid stone, it might be better to try something a little more... laid-back? Like, lounging on one of those beach chairs over there.",
            "nextDialogs": [
              "150480109"
            ]
          },
          "150480109": {
            "id": "150480109",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "*sigh* But... I really am an adventurer, and I'm qualified for the testing too! I've just... had some bad luck in the past, that's all...",
            "nextDialogs": [
              "150480110"
            ]
          },
          "150480110": {
            "id": "150480110",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "I really want to help. You can count on me, I swear!",
            "nextDialogs": [
              "150480113"
            ]
          },
          "150480113": {
            "id": "150480113",
            "speakerId": 1000,
            "speakerName": "Gaun",
            "text": "Well, if the savior of Natlan says so... How about this — would it be alright if your Asha companion completed the first round of testing instead?",
            "nextDialogs": [
              "150480114"
            ]
          },
          "150480114": {
            "id": "150480114",
            "speakerId": 1000,
            "speakerName": "Gaun",
            "text": "You can watch from the sidelines, familiarize yourself with the route, and if everything goes smoothly, you can join the second round of testing.",
            "nextDialogs": [
              "150480115"
            ]
          },
          "150480115": {
            "id": "150480115",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "Does that sound good to you, buddy?",
            "nextDialogs": [
              "150480116"
            ]
          },
          "150480116": {
            "id": "150480116",
            "speakerId": 1002,
            "speakerName": "Asha",
            "text": "♪",
            "nextDialogs": [
              "150480117"
            ]
          },
          "150480117": {
            "id": "150480117",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "Alright then! I'll leave it to you, partner!"
          }
        }
      }
    },
    {

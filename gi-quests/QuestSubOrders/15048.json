    {
      "subId": "1504808",
      "subQuestName": "Meet up with the others",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150480801"
        ],
        "dialogs": {
          "150480801": {
            "id": "150480801",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "Whew, my heart's racing so fast... Gotta take a while to catch my breath...",
            "nextDialogs": [
              "150480802"
            ]
          },
          "150480802": {
            "id": "150480802",
            "speakerId": 1002,
            "speakerName": "Asha",
            "text": "♪",
            "nextDialogs": [
              "150480803"
            ]
          },
          "150480803": {
            "id": "150480803",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Let's give it up for Bennett and his Asha buddy! You guys make such a great team!",
            "nextDialogs": [
              "150480804"
            ]
          },
          "150480804": {
            "id": "150480804",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Especially the way you worked together at the end. Your special bond made all the difference!",
            "nextDialogs": [
              "150480805"
            ]
          },
          "150480805": {
            "id": "150480805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You turned the tide of misfortune together.",
            "nextDialogs": [
              "150480806"
            ]
          },
          "150480806": {
            "id": "150480806",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "We sure did!",
            "nextDialogs": [
              "150480807"
            ]
          },
          "150480807": {
            "id": "150480807",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "#I owe a big thanks to you in particular, {NICKNAME}.",
            "nextDialogs": [
              "150480808"
            ]
          },
          "150480808": {
            "id": "150480808",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "If you hadn't believed in me and helped convince the staff, I never would have had the chance to even compete in the challenge, let alone face it alongside our Asha friend...",
            "nextDialogs": [
              "150480809"
            ]
          },
          "150480809": {
            "id": "150480809",
            "speakerId": 1000,
            "speakerName": "Gaun",
            "text": "Mr. Bennett, the final safety test has been completed, which means that Asha Speedrun is now officially ready to open. Your help was much appreciated!",
            "nextDialogs": [
              "150480810"
            ]
          },
          "150480810": {
            "id": "150480810",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "Did you hear that, Asha? We did it!",
            "nextDialogs": [
              "150480811"
            ]
          },
          "150480811": {
            "id": "150480811",
            "speakerId": 1000,
            "speakerName": "Gaun",
            "text": "I'll remember your name, Mr. Bennett — the brave and kind-hearted adventurer.",
            "nextDialogs": [
              "150480812"
            ]
          },
          "150480812": {
            "id": "150480812",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "I know this adventure isn't over yet, but just the idea of saying goodbye is getting harder and harder to bear...",
            "nextDialogs": [
              "150480813"
            ]
          },
          "150480813": {
            "id": "150480813",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "Asha, I'm really gonna miss you.",
            "nextDialogs": [
              "150480814"
            ]
          },
          "150480814": {
            "id": "150480814",
            "speakerId": 1002,
            "speakerName": "Asha",
            "text": "...",
            "nextDialogs": [
              "150480815"
            ]
          },
          "150480815": {
            "id": "150480815",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "Hehe, hey... If anything, I should be the one doing the comforting here! As the leader of this Adventure Team, it's my job to look after you.",
            "nextDialogs": [
              "150480816"
            ]
          },
          "150480816": {
            "id": "150480816",
            "speakerId": 1002,
            "speakerName": "Asha",
            "text": "...",
            "nextDialogs": [
              "150480817"
            ]
          },
          "150480817": {
            "id": "150480817",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "Huh, something must've gotten in my eyes out there... Getting a bit watery, haha... Got a bit of a lump in my throat too...",
            "nextDialogs": [
              "150480818"
            ]
          },
          "150480818": {
            "id": "150480818",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "I'll have to ask Professor Venti how to express my feelings in moments like this. After all, he's the best poet I know...",
            "nextDialogs": [
              "150480819"
            ]
          },
          "150480819": {
            "id": "150480819",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Tone-Deaf Bard would just say something like...",
            "nextDialogs": [
              "150480820"
            ]
          },
          "150480820": {
            "id": "150480820",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Speak from the heart.",
            "nextDialogs": [
              "150480821"
            ]
          },
          "150480821": {
            "id": "150480821",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "It really means a lot to have you here by my side... Thank you, Asha.",
            "nextDialogs": [
              "150480822"
            ]
          },
          "150480822": {
            "id": "150480822",
            "speakerId": 1002,
            "speakerName": "Asha",
            "text": "..."
          }
        }
      }
    }
  ]
}
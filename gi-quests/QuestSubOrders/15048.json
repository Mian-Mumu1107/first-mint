    {
      "subId": "1504803",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150480301"
        ],
        "dialogs": {
          "150480301": {
            "id": "150480301",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "You did it! See, it wasn't that tricky after all.",
            "nextDialogs": [
              "150480302"
            ]
          },
          "150480302": {
            "id": "150480302",
            "speakerId": 1002,
            "speakerName": "Asha",
            "text": "♪",
            "nextDialogs": [
              "150480303"
            ]
          },
          "150480303": {
            "id": "150480303",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "Well done, buddy! You were quite the athlete out there! I was blown away!",
            "nextDialogs": [
              "150480304"
            ]
          },
          "150480304": {
            "id": "150480304",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "It's Bennett's turn next, right?",
            "nextDialogs": [
              "150480305"
            ]
          },
          "150480305": {
            "id": "150480305",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "Yep! I've done my warm-up, finished my stretches, and I'm ready for action. Trust me, I've got this!",
            "nextDialogs": [
              "150480306"
            ]
          },
          "150480306": {
            "id": "150480306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Be careful out there.",
            "nextDialogs": [
              "150480307"
            ]
          },
          "150480307": {
            "id": "150480307",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "#Thanks for looking out for me, {NICKNAME}! But, don't worry, I will be!"
          }
        }
      }
    },
    {
      "subId": "1504804",
      "subQuestName": "Talk to Bennett and the Asha",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150480401"
        ],
        "dialogs": {
          "150480401": {
            "id": "150480401",
            "speakerId": 1002,
            "speakerName": "Asha",
            "text": "♪",
            "nextDialogs": [
              "150480402"
            ]
          },
          "150480402": {
            "id": "150480402",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "You're saying... You'd be willing to lead the way and coach me through it?",
            "nextDialogs": [
              "150480403"
            ]
          },
          "150480403": {
            "id": "150480403",
            "speakerId": 1002,
            "speakerName": "Asha",
            "text": "♪",
            "nextDialogs": [
              "150480404"
            ]
          },
          "150480404": {
            "id": "150480404",
            "speakerId": 1001,
            "speakerName": "Bennett",
            "text": "You're the best! Now, I feel even more confident than before. After you, Coach!",
            "nextDialogs": [
              "150480405"
            ]
          },
          "150480405": {
            "id": "150480405",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Go, Asha! Go, Bennett!"
          }
        }
      }
    },
    {

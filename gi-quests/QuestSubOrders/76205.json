    {
      "subId": "7620503",
      "subQuestName": "Talk to Nicole",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762050301"
        ],
        "dialogs": {
          "762050301": {
            "id": "762050301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Treasure! Woohoo, this is so much fun!",
            "nextDialogs": [
              "762050302"
            ]
          },
          "762050302": {
            "id": "762050302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But... Paimon's head really is pounding. Seriously, did Nicole actually need to shout that loud just to make those stairs appear...?",
            "nextDialogs": [
              "762050303"
            ]
          },
          "762050303": {
            "id": "762050303",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "What's this? Complaining now, are we? Aren't you worried a powerful mage like me might snap her fingers and turn those new trinkets into turnips?",
            "nextDialogs": [
              "762050306"
            ]
          },
          "762050306": {
            "id": "762050306",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Hehe, I'm only joking with you. You should know I'm not the silent, sulking sort of angel that keeps track of every little slight.",
            "nextDialogs": [
              "762050307"
            ]
          },
          "762050307": {
            "id": "762050307",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "#...And so, when their day of reckoning finally arrived, {NICKNAME} and Paimon ascended the seven-tiered steps to find a familiar figure awaiting them.",
            "nextDialogs": [
              "762050308"
            ]
          },
          "762050308": {
            "id": "762050308",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Radiant flames converged to form wings upon her back. Her figure remained as noble and beautiful as the day they first met, yet her eyes now shone with a cruel light.",
            "nextDialogs": [
              "762050309"
            ]
          },
          "762050309": {
            "id": "762050309",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "#\"But why?\" asked {NICKNAME} and Paimon in unison.",
            "nextDialogs": [
              "762050310"
            ]
          },
          "762050310": {
            "id": "762050310",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "\"It all started the day Paimon complained that I shouted too loudly!\"",
            "nextDialogs": [
              "762050311"
            ]
          },
          "762050311": {
            "id": "762050311",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! Words are magic here, don't you know! Don't say such scary things!"
          }
        }
      }
    },
    {

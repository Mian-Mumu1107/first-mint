    {
      "subId": "7620502",
      "subQuestName": "Continue onward",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762050201"
        ],
        "dialogs": {
          "762050201": {
            "id": "762050201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa, that gap's so big!",
            "nextDialogs": [
              "762050202"
            ]
          },
          "762050202": {
            "id": "762050202",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "All things may serve as guides... The scriptures filled... with names divine! The words and chapters... intertwine... and angels act with deeds aligned! In this sacred place, let words forge the path ahead.",
            "nextDialogs": [
              "762050203"
            ]
          },
          "762050203": {
            "id": "762050203",
            "speakerId": 1003,
            "speakerName": "Stairway of Words",
            "text": "~",
            "nextDialogs": [
              "762050204"
            ]
          },
          "762050204": {
            "id": "762050204",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "See? All taken care of.",
            "nextDialogs": [
              "762050205"
            ]
          },
          "762050205": {
            "id": "762050205",
            "speakerId": 1002,
            "speakerName": "<UNKNOWN>",
            "text": "All things may serve as guides... The scriptures filled... with names divine!",
            "nextDialogs": [
              "762050206"
            ]
          },
          "762050206": {
            "id": "762050206",
            "speakerId": 1002,
            "speakerName": "<UNKNOWN>",
            "text": "The words and chapters... intertwine... and angels act with deeds aligned!",
            "nextDialogs": [
              "762050207"
            ]
          },
          "762050207": {
            "id": "762050207",
            "speakerId": 1002,
            "speakerName": "<UNKNOWN>",
            "text": "In this sacred place, let words forge the path ahead."
          }

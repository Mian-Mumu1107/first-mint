            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This must be the final door, right? Let's hurry up and find Nicole!",
            "nextDialogs": [
              "762059902"
            ]
          },
          "762059902": {
            "id": "762059902",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Watch your step!",
            "nextDialogs": [
              "762059907"
            ]
          },
          "762059907": {

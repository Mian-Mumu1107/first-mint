    {
      "subId": "7620501",
      "subQuestName": "Talk to Nicole",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762050101"
        ],
        "dialogs": {
          "762050101": {
            "id": "762050101",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Look at the time! What am I going to do now... They'll be here any minute...",
            "nextDialogs": [
              "762050102"
            ]
          },
          "762050102": {
            "id": "762050102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hello, Nicole, we're heeeere! Hey, why are you pushing us out?",
            "nextDialogs": [
              "762050103"
            ]
          },
          "762050103": {
            "id": "762050103",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Oh dear, oh dear... I'm sorry about this...",
            "nextDialogs": [
              "762050104"
            ]
          },
          "762050104": {
            "id": "762050104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Aren't you ready yet?",
            "nextDialogs": [
              "762050105"
            ]
          },
          "762050105": {
            "id": "762050105",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "How should I put this... Oh, blast, I'm afraid I can't explain it very clearly. I'll have to tell you the whole story...",
            "nextDialogs": [
              "762050106"
            ]
          },
          "762050106": {
            "id": "762050106",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "It all started the first time the mages challenged the Anemo Archon...",
            "nextDialogs": [
              "762050107"
            ]
          },
          "762050107": {
            "id": "762050107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Nicole, that's... way too long ago!",
            "nextDialogs": [
              "762050108"
            ]
          },
          "762050108": {
            "id": "762050108",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Ugh, this isn't fair! It's so embarrassing that you'd end up having to hear this from my own mouth... No! It can't be helped, the facts are the facts... Just so long as Alice doesn't hear about this, there's no reason for anyone to laugh...",
            "nextDialogs": [
              "762050109"
            ]
          },
          "762050109": {
            "id": "762050109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh dear, her inner monologue's leaking out again... Besides, it's not really coming from her own \"mouth\"...",
            "nextDialogs": [
              "762050110"
            ]
          },
          "762050110": {
            "id": "762050110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Shh...",
            "nextDialogs": [
              "762050111"
            ]
          },
          "762050111": {
            "id": "762050111",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "I decided to hide the feathers at the top of the study. I figured if I made things harder, there'd be a greater sense of accomplishment...",
            "nextDialogs": [
              "762050112"
            ]
          },
          "762050112": {
            "id": "762050112",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "But I'm really not very good at controlling these carefree eddies. I can only fly so high before I seem to hit an invisible ceiling.",
            "nextDialogs": [
              "762050113"
            ]
          },
          "762050113": {
            "id": "762050113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Can't you use magic to bring the feathers back down?",
            "nextDialogs": [
              "762050114"
            ]
          },
          "762050114": {
            "id": "762050114",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Where would be the fun in that!?",
            "nextDialogs": [
              "762050115"
            ]
          },
          "762050115": {
            "id": "762050115",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, Paimon sees your point... Hmm, that sure is a tricky one...",
            "nextDialogs": [
              "762050116"
            ]
          },
          "762050116": {
            "id": "762050116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Nicole, could you try saying something?",
            "nextDialogs": [
              "762050117"
            ]
          },
          "762050117": {
            "id": "762050117",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "What do you want me to say?",
            "nextDialogs": [
              "762050120"
            ]
          },
          "762050120": {
            "id": "762050120",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Oh! I get what you're saying! Alright, I'll give it a try!",
            "nextDialogs": [
              "762050121"
            ]
          },
          "762050121": {
            "id": "762050121",
            "speakerId": 1002,
            "speakerName": "<UNKNOWN>",
            "text": "Ugh, this isn't fair! It's so embarrassing that you'd end up having to hear this from my own mouth...",
            "nextDialogs": [
              "762050122"
            ]
          },
          "762050122": {
            "id": "762050122",
            "speakerId": 1002,
            "speakerName": "<UNKNOWN>",
            "text": "No! It can't be helped, the facts are the facts...",
            "nextDialogs": [
              "762050123"
            ]
          },
          "762050123": {
            "id": "762050123",
            "speakerId": 1002,
            "speakerName": "<UNKNOWN>",
            "text": "Just so long as Alice doesn't hear about this, there's no reason for anyone to laugh..."
          }
        }
      }
    },
    {
      "subId": "7620505",
      "subQuestName": "Continue onward",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762050501"
        ],
        "dialogs": {
          "762050501": {
            "id": "762050501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Nicole, this is a dead end!",
            "nextDialogs": [
              "762050502"
            ]
          },
          "762050502": {
            "id": "762050502",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Leave it to me.",
            "nextDialogs": [
              "762050503"
            ]
          },
          "762050503": {
            "id": "762050503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa, it really worked! Say something else!",
            "nextDialogs": [
              "762050504"
            ]
          },
          "762050504": {
            "id": "762050504",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Leave it to me! Leave it to me! Leave it to me!",
            "nextDialogs": [
              "762050505"
            ]
          },
          "762050505": {
            "id": "762050505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh... You're just repeating yourself..."
          }
        }
      }
    },

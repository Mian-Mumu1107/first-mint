  "subQuests": [
    {
      "subId": "4134101",
      "subQuestName": "Talk to Mengmeng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413410101"
        ],
        "dialogs": {
          "413410101": {
            "id": "413410101",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "Xiao Lanterns are soooo hard to make...",
            "nextDialogs": [
              "413410102"
            ]
          },
          "413410102": {
            "id": "413410102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "413410103"
            ]
          },
          "413410103": {
            "id": "413410103",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "Do you know how to make Xiao Lanterns? I keep trying but I can't do it...",
            "nextDialogs": [
              "413410104"
            ]
          },
          "413410104": {
            "id": "413410104",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "Through the hole, then back around, and then... I drop it. Or it breaks.",
            "nextDialogs": [
              "413410105"
            ]
          },
          "413410105": {
            "id": "413410105",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "I really wanted to make a Xiao Lantern for Yu...",
            "nextDialogs": [
              "413410106"
            ]
          },
          "413410106": {
            "id": "413410106",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "Yu always has to look after the tea shop, so he never has any time to play or to make a lantern.",
            "nextDialogs": [
              "413410107"
            ]
          },
          "413410107": {
            "id": "413410107",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "But I bet he still has a wish. So I wanna make a lantern for him...",
            "nextDialogs": [
              "413410110"
            ]
          },
          "413410110": {
            "id": "413410110",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "But, but... I wanted to be the one to make it for him...",
            "nextDialogs": [
              "413410111"
            ]
          },
          "413410111": {
            "id": "413410111",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "And, and... I wanna know the secrets to making them so I can tell Yu, too.",
            "nextDialogs": [
              "413410112"
            ]
          },
          "413410112": {
            "id": "413410112",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "Could you... teach me how to make them?",
            "nextDialogs": [
              "413410113"
            ]
          },
          "413410113": {
            "id": "413410113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure.",
            "nextDialogs": [
              "413410114"
            ]
          },
          "413410114": {
            "id": "413410114",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "Yay!",
            "nextDialogs": [
              "413410115"
            ]
          },
          "413410115": {
            "id": "413410115",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "So, so... Then the Xiao Lantern is ready, right?",
            "nextDialogs": [
              "413410116"
            ]
          },
          "413410116": {
            "id": "413410116",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "Thanks! I'm gonna go make one for Yu now!"
          }
        }
      }
    },
    {
      "subId": "4134102",
      "subQuestName": "Follow Mengmeng to meet Yu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413410201"
        ],
        "dialogs": {
          "413410201": {
            "id": "413410201",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "H—Hi... Sir or Madam, um, um... Please put your feet up, and please have some tea, and...",
            "nextDialogs": [
              "413410203"
            ]
          },
          "413410203": {
            "id": "413410203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're here to give you a Xiao Lantern.",
            "nextDialogs": [
              "413410204"
            ]
          },
          "413410204": {
            "id": "413410204",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "...Really?",
            "nextDialogs": [
              "413410205"
            ]
          },
          "413410205": {
            "id": "413410205",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "Yu, the Xiao Lantern's for you.",
            "nextDialogs": [
              "413410206"
            ]
          },
          "413410206": {
            "id": "413410206",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "Mengmeng? Oh, did you make this...? Wow... thank you...",
            "nextDialogs": [
              "413410207"
            ]
          },
          "413410207": {
            "id": "413410207",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "#This {M#nice man}{F#nice lady} taught me how to make them. Actually, it's one of my first, so I didn't do a great job... D—Do you like it...?",
            "nextDialogs": [
              "413410208"
            ]
          },
          "413410208": {
            "id": "413410208",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "Are you kidding? It's great, I love it! I was just starting to worry when I'd have the time to make one for myself...",
            "nextDialogs": [
              "413410209"
            ]
          },
          "413410209": {
            "id": "413410209",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "Thanks, Mengmeng. I'll find someone to hang it on my door in a bit.",
            "nextDialogs": [
              "413410212"
            ]
          },
          "413410212": {
            "id": "413410212",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "Well, the thing is... My dad's not in great health, so he can't hang it up for me. And I'm too short, so I wouldn't be able to reach...",
            "nextDialogs": [
              "413410213"
            ]
          },
          "413410213": {
            "id": "413410213",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "So, if I wanna hang it on the door, I gotta ask someone around here if they can help..."
          }
        }
      }
    },
    {
      "subId": "4134103",

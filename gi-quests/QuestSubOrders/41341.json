    {
      "subId": "4134104",
      "subQuestName": "Speak to Yu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413410401"
        ],
        "dialogs": {
          "413410401": {
            "id": "413410401",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "#This Xiao Lantern looks so pretty! Thanks so much, {M#Sir}{F#Ma'am}!",
            "nextDialogs": [
              "413410402"
            ]
          },
          "413410402": {
            "id": "413410402",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "Come on, Yu... Let's go and play. I know a great place with the prettiest flowers.",
            "nextDialogs": [
              "413410403"
            ]
          },
          "413410403": {
            "id": "413410403",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "#This {M#nice man}{F#nice lady} taught me how to make Xiao Lanterns, and when we get there I can teach you, too. C'mon, wouldn't that be great?",
            "nextDialogs": [
              "413410404"
            ]
          },
          "413410404": {
            "id": "413410404",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "I, uh... I can't. I need to watch the shop. Even though there's no customers, I've gotta keep the place spick and span, just like my dad always says.",
            "nextDialogs": [
              "413410405"
            ]
          },
          "413410405": {
            "id": "413410405",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "Okay, well... Scrap the Xiao Lanterns, how about we just go there, have a quick chat, then come back straight away? That way, it won't waste too much of your time.",
            "nextDialogs": [
              "413410406"
            ]
          },
          "413410406": {
            "id": "413410406",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "But...",
            "nextDialogs": [
              "413410409"
            ]
          },
          "413410409": {
            "id": "413410409",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "...Oh? Y—You sure? That, uh... That's asking a lot of you...",
            "nextDialogs": [
              "413410410"
            ]
          },
          "413410410": {
            "id": "413410410",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "We'll be really quick, we'll just go straight there and come straight back. Promise it won't take too long!",
            "nextDialogs": [
              "413410411"
            ]
          },
          "413410411": {
            "id": "413410411",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "Thanks soooo much!"
          }
        }
      }
    },

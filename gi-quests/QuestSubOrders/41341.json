    {
      "subId": "4134107",
      "subQuestName": "Eavesdrop on Yu and Mengmeng's conversation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413410701"
        ],
        "dialogs": {
          "413410701": {
            "id": "413410701",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "It looks like the two of them are still playing. Guess we don't have to worry.",
            "nextDialogs": [
              "413410702"
            ]
          },
          "413410702": {
            "id": "413410702",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But given the atmosphere... Maybe we shouldn't disturb them.",
            "nextDialogs": [
              "413410705"
            ]
          },
          "413410705": {
            "id": "413410705",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "If we made a garland for your dad, do you think he'd get better quicker?",
            "nextDialogs": [
              "413410706"
            ]
          },
          "413410706": {
            "id": "413410706",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "I... I don't know...",
            "nextDialogs": [
              "413410707"
            ]
          },
          "413410707": {
            "id": "413410707",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "I read in a book that if you stay happy, even if you get sick, you'll get better really quickly.",
            "nextDialogs": [
              "413410708"
            ]
          },
          "413410708": {
            "id": "413410708",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "I think that you're so grown-up, the way you help your dad watch the shop every day... And I'm sure that must make him very happy.",
            "nextDialogs": [
              "413410709"
            ]
          },
          "413410709": {
            "id": "413410709",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "But sometimes he tells me off... \"Stop lounging around in the shop, go off and play\"...",
            "nextDialogs": [
              "413410710"
            ]
          },
          "413410710": {
            "id": "413410710",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "\"If you don't go and play with Mengmeng, she'll pick the whole neighborhood bare of flowers\"...",
            "nextDialogs": [
              "413410711"
            ]
          },
          "413410711": {
            "id": "413410711",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "That would never happen, there's soooo many flowers around here... Wait a second, I'll make a garland for you.",
            "nextDialogs": [
              "413410712"
            ]
          },
          "413410712": {
            "id": "413410712",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "Thanks, Mengmeng. I should be getting back.",
            "nextDialogs": [
              "413410713"
            ]
          },
          "413410713": {
            "id": "413410713",
            "speakerId": 1000,
            "speakerName": "Mengmeng",
            "text": "Huh, okay... Well, once your dad's recovered, you'll have more time, right? Then I can come play with you again...",
            "nextDialogs": [
              "413410714"
            ]
          },
          "413410714": {
            "id": "413410714",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "Yep, I'm sure dad will make a quick recovery...",
            "nextDialogs": [
              "413410715"
            ]
          },
          "413410715": {
            "id": "413410715",
            "speakerId": 1001,
            "speakerName": "Yu",
            "text": "What the...!? Wh—When did you get here?"
          }
        }
      }
    },
    {

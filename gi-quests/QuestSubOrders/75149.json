  "subQuests": [
    {
      "subId": "7514917",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751490902"
        ],
        "dialogs": {
          "751490902": {
            "id": "751490902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, Chosen One, Chosen of Dragons...",
            "nextDialogs": [
              "751490903"
            ]
          },
          "751490903": {
            "id": "751490903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Traverse the eternal city. Venture into the Heart of the Sacred Mountain.",
            "nextDialogs": [
              "751490904"
            ]
          },
          "751490904": {
            "id": "751490904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Banish... the great enemy cloaked in shadow. Ignite... the frigid embers...",
            "nextDialogs": [
              "751490905"
            ]
          },
          "751490905": {
            "id": "751490905",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*cough* H—How's everyone? Still okay?",
            "nextDialogs": [
              "751490906"
            ]
          },
          "751490906": {
            "id": "751490906",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rroooh...",
            "nextDialogs": [
              "751490907"
            ]
          },
          "751490907": {
            "id": "751490907",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is your head okay? After all, you did fall from really high up...",
            "nextDialogs": [
              "751490908"
            ]
          },
          "751490908": {
            "id": "751490908",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're not hurt, are you?",
            "nextDialogs": [
              "751490909"
            ]
          },
          "751490909": {
            "id": "751490909",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751490910"
            ]
          },
          "751490910": {
            "id": "751490910",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hmm, you seem fine. What about you, {NICKNAME}? Are you okay?",
            "nextDialogs": [
              "751490912",
              "751490914"
            ]
          },
          "751490912": {
            "id": "751490912",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Pfft, \"in one piece\"? Are you serious? *sigh* Paimon's just glad you're not hurt.",
            "nextDialogs": [
              "751490915"
            ]
          },
          "751490915": {
            "id": "751490915",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Still... Who'd have thought there'd be such a huge space underneath this volcano? It's super dark here, though..."
          },
          "751490914": {
            "id": "751490914",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ha-ha, very funny! If you can joke like that, you must be feeling absolutely peachy!"
          }
        }
      }
    },
    {
      "subId": "7514906",
      "subQuestName": "Follow the path as it lights up",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751490601"
        ],
        "dialogs": {
          "751490601": {
            "id": "751490601",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrooh!",
            "nextDialogs": [
              "751490602"
            ]
          },
          "751490602": {
            "id": "751490602",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "*whirr-click*...",
            "nextDialogs": [
              "751490603"
            ]
          },
          "751490603": {
            "id": "751490603",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "\"It seems you have finally restored the two Astral Assemblages to normal operation... Soon, the phlogiston concentration here should be sufficient to reactivate the communications device...\"",
            "nextDialogs": [
              "751490604"
            ]
          },
          "751490604": {
            "id": "751490604",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "\"In the meantime, please wait a little longer. You have already done well, for a human.\"",
            "nextDialogs": [
              "751490607"
            ]
          },
          "751490607": {
            "id": "751490607",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "\"I am not. Ehecatl's existence has dissipated in full... not long ago, in fact. And though names matter little here, the name left to this body is...\"",
            "nextDialogs": [
              "751490608"
            ]
          },
          "751490608": {
            "id": "751490608",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "\"'Almighty Amaru, the Hallowed Lord'... *sigh* The original bearer of this name was a fool through and through.\"",
            "nextDialogs": [
              "751490609"
            ]
          },
          "751490609": {
            "id": "751490609",
            "speakerId": 21813,
            "speakerName": "Amaru",
            "text": "\"You may simply name it 'Amaru.'\"",
            "nextDialogs": [
              "751490610"
            ]
          },
          "751490610": {
            "id": "751490610",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Amaru?",
            "nextDialogs": [
              "751490611"
            ]
          },
          "751490611": {
            "id": "751490611",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrrawr?",
            "nextDialogs": [
              "751490612"
            ]
          },
          "751490612": {
            "id": "751490612",
            "speakerId": 21813,
            "speakerName": "Amaru",
            "text": "\"In life, he was arrogant, unrestrained in speech, brainless, and aggravating... But in the war, he held the threshold of the sealed Celestial Axis until his final breath...\"",
            "nextDialogs": [
              "751490613"
            ]
          },
          "751490613": {
            "id": "751490613",
            "speakerId": 21813,
            "speakerName": "Amaru",
            "text": "\"This is that very spot, and that is why I placed the Secret Source Servant who once waited on him here... It is happy to guard the Axis in its master's place, or so I imagine.\"",
            "nextDialogs": [
              "751490614"
            ]
          },
          "751490614": {
            "id": "751490614",
            "speakerId": 21813,
            "speakerName": "Amaru",
            "text": "Increase in phlogiston concentration detected... Circuit check complete... *whirring*",
            "nextDialogs": [
              "751490615"
            ]
          },
          "751490615": {
            "id": "751490615",
            "speakerId": 21813,
            "speakerName": "Amaru",
            "text": "Lift shaft — Celestial Axis, restarted.",
            "nextDialogs": [
              "751490616"
            ]
          },
          "751490616": {
            "id": "751490616",
            "speakerId": 21813,
            "speakerName": "Amaru",
            "text": "\"It appears we are almost done. Please proceed deeper within.\""
          }
        }
      }
    },
    {
      "subId": "7514901",
      "subQuestName": "Talk to the strange mechanism",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751491001"
        ],
        "dialogs": {
          "751491001": {
            "id": "751491001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hmm? {REALNAME[ID(2)|SHOWHOST(true)]}? What's up? Found something?",
            "nextDialogs": [
              "751491002"
            ]
          },
          "751491002": {
            "id": "751491002",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Whrooawr!",
            "nextDialogs": [
              "751491003"
            ]
          },
          "751491003": {
            "id": "751491003",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm. This... is the statue that Qucusaur had. So it dropped down here as well...",
            "nextDialogs": [
              "751491004"
            ]
          },
          "751491004": {
            "id": "751491004",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Y'know, it kinda looks like you, {REALNAME[ID(2)|SHOWHOST(true)]}, but with big ears, and rolled into a ball.",
            "nextDialogs": [
              "751491005"
            ]
          },
          "751491005": {
            "id": "751491005",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrrawr!",
            "nextDialogs": [
              "751491006"
            ]
          },
          "751491006": {
            "id": "751491006",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really? You don't think so? Paimon sure does...",
            "nextDialogs": [
              "751491007"
            ]
          },
          "751491007": {
            "id": "751491007",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa! It's moving!",
            "nextDialogs": [
              "751491008"
            ]
          },
          "751491008": {
            "id": "751491008",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "*whirr*...*click*...",
            "nextDialogs": [
              "751491009"
            ]
          },
          "751491009": {
            "id": "751491009",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Self-diagnostic in progress... Moderate dust accumulation in joints... Storage medium activated... Speech... remote extraction... Override permitted... *clicking*... Personality module correction...",
            "nextDialogs": [
              "751491010"
            ]
          },
          "751491010": {
            "id": "751491010",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "...",
            "nextDialogs": [
              "751491011"
            ]
          },
          "751491011": {
            "id": "751491011",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr?",
            "nextDialogs": [
              "751491012"
            ]
          },
          "751491012": {
            "id": "751491012",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, so this was some kinda mechanism, not a statue... Well, it does look like those Source Mechanisms. And that strange light floating around it... Feels like we've seen that before somewhere...",
            "nextDialogs": [
              "751491013"
            ]
          },
          "751491013": {
            "id": "751491013",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm? Why has it stopped moving?",
            "nextDialogs": [
              "751491014"
            ]
          },
          "751491014": {
            "id": "751491014",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "\"Warggh!\"",
            "nextDialogs": [
              "751491015"
            ]
          },
          "751491015": {
            "id": "751491015",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aaaahhh!",
            "nextDialogs": [
              "751491016"
            ]
          },
          "751491016": {
            "id": "751491016",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "\"Ah. It seems my voice module works. Well then, honored guests. I have awaited you for a long... Sorry, is something the matter?\"",
            "nextDialogs": [
              "751491017"
            ]
          },
          "751491017": {
            "id": "751491017",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did you have to suddenly make that loud noise? You scared Paimon to death!",
            "nextDialogs": [
              "751491018"
            ]
          },
          "751491018": {
            "id": "751491018",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "\"Did I? Then that is well. A dynamic entrance is the only way to leave a lasting impression. Otherwise, I'd worry that you might feel I was neglecting you...\"",
            "nextDialogs": [
              "751491019"
            ]
          },
          "751491019": {
            "id": "751491019",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Err, sorry. Who are you again?",
            "nextDialogs": [
              "751491020"
            ]
          },
          "751491020": {
            "id": "751491020",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "\"Who am I, you say? Well, this body's name is Ehecatl, and you may so call it, but such things as names hold little meaning here...\"",
            "nextDialogs": [
              "751491021"
            ]
          },
          "751491021": {
            "id": "751491021",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Individual designation modification request... Via records... 150 years after the war... Designation changed to one from a list of the fallen — Ehecatl.",
            "nextDialogs": [
              "751491022"
            ]
          },
          "751491022": {
            "id": "751491022",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"Yes, indeed. Since then, this body has been named Ehecatl...\"",
            "nextDialogs": [
              "751491023"
            ]
          },
          "751491023": {
            "id": "751491023",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751491024"
            ]
          },
          "751491024": {
            "id": "751491024",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"Yes, it was I who called you here. Come, let us go unto the Heart of the Sacred Mountain... before it is too late.\"",
            "nextDialogs": [
              "751491025"
            ]
          },
          "751491025": {
            "id": "751491025",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"That said, we are not yet in a hurry. Let Ehecatl clear away at least some smidgen of the darkness that lies before you. I know you must have your doubts, but please, follow me for now.\""
          }
        }
      }
    },
    {
      "subId": "7514902",
      "subQuestName": "Explore up ahead",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751490201"
        ],
        "dialogs": {
          "751490201": {
            "id": "751490201",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"I should explain that this place was not always so dark... Even though it is undoubtedly the 'inside' of a volcano...\"",
            "nextDialogs": [
              "751490202"
            ]
          },
          "751490202": {
            "id": "751490202",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"However, after the war was over, the entire city was destroyed. After that, such a huge mechanical construct could hardly continue to function...\"",
            "nextDialogs": [
              "751490203"
            ]
          },
          "751490203": {
            "id": "751490203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "War?",
            "nextDialogs": [
              "751490204"
            ]
          },
          "751490204": {
            "id": "751490204",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"Yes, the war between the remaining Dragonborn and the humans — the war in which the original master of flame was killed...\"",
            "nextDialogs": [
              "751490205"
            ]
          },
          "751490205": {
            "id": "751490205",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"The master of this place is long since dead, and naught else but the city ekes out survival... Though who can really say? Perhaps the city, too, has already ceased to live.\"",
            "nextDialogs": [
              "751490206"
            ]
          },
          "751490206": {
            "id": "751490206",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"...Hmm. Or perhaps so many things that once existed were nothing more than illusions.\"",
            "nextDialogs": [
              "751490207"
            ]
          },
          "751490207": {
            "id": "751490207",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrrawr?",
            "nextDialogs": [
              "751490208"
            ]
          },
          "751490208": {
            "id": "751490208",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"We each stand to benefit, little one. You get what you came for, and I hope to borrow your power to solve a few problems of my own...\"",
            "nextDialogs": [
              "751490209"
            ]
          },
          "751490209": {
            "id": "751490209",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"And so, you must reach the Heart of the Sacred Mountain... But alas, the Mountain's power was cut off during the war.\"",
            "nextDialogs": [
              "751490210"
            ]
          },
          "751490210": {
            "id": "751490210",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"And for all that the seals' power is like weak threads that could only entrap a whelp, the oath dictates that only a 'human' may activate them...\"",
            "nextDialogs": [
              "751490211"
            ]
          },
          "751490211": {
            "id": "751490211",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"In an interesting twist, the poor child who used this method to infiltrate the Sacred Mountain was, in the end, brought to ruin by someone else using nigh identical means.\"",
            "nextDialogs": [
              "751490212"
            ]
          },
          "751490212": {
            "id": "751490212",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"Hehe. Ah, such has it ever been... Just as the followers of a tyrant are driven out by heroes, and after many years of wandering, their descendants end tyranny in some other realm...\"",
            "nextDialogs": [
              "751490213"
            ]
          },
          "751490213": {
            "id": "751490213",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"The world and its affairs are akin to a staged play. Cause and effect, revenge and revolt... All scenes repeat themselves one after the other across ragged eons...\"",
            "nextDialogs": [
              "751490214"
            ]
          },
          "751490214": {
            "id": "751490214",
            "speakerId": 21791,
            "speakerName": "Ehecatl",
            "text": "\"Ah, but I am getting off-topic... Well then. Activate it, and let this moribund capital writhe a little while longer. None but you is worthy to do this deed now.\""
          }
        }
      }
    },

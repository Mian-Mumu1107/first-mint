            "id": "751499901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems like we're done with the two \"Astral Assemblages\" that strange statue was talking about.",
            "nextDialogs": [
              "751499902"
            ]
          },
          "751499902": {
            "id": "751499902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's head over to that \"Celestial Axis\" thingamajig in the middle and check things out!",
            "nextDialogs": [
              "751499903"
            ]
          },

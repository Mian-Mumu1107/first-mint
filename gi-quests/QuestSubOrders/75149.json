    {
      "subId": "7514904",
      "subQuestName": "Keep exploring",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751490401"
        ],
        "dialogs": {
          "751490401": {
            "id": "751490401",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Scanning... This location... The path to the Celestial Axis has been sealed. Core Astral Assemblage has been activated...",
            "nextDialogs": [
              "751490402"
            ]
          },
          "751490402": {
            "id": "751490402",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Remaining Astral Assemblages must be re-stabilized to gain the power needed to reopen the seal...",
            "nextDialogs": [
              "751490403"
            ]
          },
          "751490403": {
            "id": "751490403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, Ehecatl?",
            "nextDialogs": [
              "751490404"
            ]
          },
          "751490404": {
            "id": "751490404",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Scanning... This location... The path to the Celestial Axis has been sealed. Core Astral Assemblage has been activated...",
            "nextDialogs": [
              "751490405"
            ]
          },
          "751490405": {
            "id": "751490405",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "Remaining Astral Assemblages must be re-stabilized to gain the power needed to reopen the seal...",
            "nextDialogs": [
              "751490406"
            ]
          },
          "751490406": {
            "id": "751490406",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rroo...",
            "nextDialogs": [
              "751490407"
            ]
          },
          "751490407": {
            "id": "751490407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, this isn't Ehecatl. Even if they do look the same...",
            "nextDialogs": [
              "751490408"
            ]
          },
          "751490408": {
            "id": "751490408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Still, the \"Celestial Axis\"... This has gotta be the one that Ehecatl said needed activating, right?",
            "nextDialogs": [
              "751490409"
            ]
          },
          "751490409": {
            "id": "751490409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like we'll have to look around for the other two Astral Assemblages, then!"
          }
        }
      }
    },

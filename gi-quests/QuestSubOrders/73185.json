    {
      "subId": "7318599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731859901"
        ],
        "dialogs": {
          "731859901": {
            "id": "731859901",
            "speakerId": 1000,
            "speakerName": "Elber",
            "text": "Help! Somebody help me!",
            "nextDialogs": [
              "731859902"
            ]
          },
          "731859902": {
            "id": "731859902",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Someone's in danger! We've got to go help!",
            "nextDialogs": [
              "731859903"
            ]
          },
          "731859903": {
            "id": "731859903",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "This is one of the locations Mr. Elber marked for us.",
            "nextDialogs": [
              "731859904"
            ]
          },
          "731859904": {
            "id": "731859904",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "See the footprints by the puddle? Did the Sumpter Beast leave that?",
            "nextDialogs": [
              "731859905"
            ]
          },
          "731859905": {
            "id": "731859905",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "If it trod in the puddle, there would be water on the hooves.",
            "nextDialogs": [
              "731859906"
            ]
          },
          "731859906": {
            "id": "731859906",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Heh, it's time to use Elemental Sight! Follow the water's trail and we'll find the beast.",
            "nextDialogs": [
              "731859911"
            ]
          },
          "731859911": {
            "id": "731859911",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "The box has a lot of things inside, probably goods dropped by the fleeing Sumpter Beast.",
            "nextDialogs": [
              "731859912"
            ]
          },
          "731859912": {
            "id": "731859912",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "It shouldn't be too far ahead. Let's move.",
            "nextDialogs": [
              "731859913"
            ]
          },
          "731859913": {
            "id": "731859913",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh, remember to bring the cargo back to Mr. Elber."
          }
        }
      }

    {
      "subId": "7318510",
      "subQuestName": "Talk to Elber",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731850701"
        ],
        "dialogs": {
          "731850701": {
            "id": "731850701",
            "speakerId": 1000,
            "speakerName": "Elber",
            "text": "Great! I can't thank you enough, Traveler!",
            "nextDialogs": [
              "731850702"
            ]
          },
          "731850702": {
            "id": "731850702",
            "speakerId": 1000,
            "speakerName": "Elber",
            "text": "I could have gone broke if I'd lost the goods and these two Sumpter Beasts.",
            "nextDialogs": [
              "731850705"
            ]
          },
          "731850705": {
            "id": "731850705",
            "speakerId": 1000,
            "speakerName": "Elber",
            "text": "Oh, yes, your payment... Please wait a second.",
            "nextDialogs": [
              "731850706"
            ]
          },
          "731850706": {
            "id": "731850706",
            "speakerId": 1000,
            "speakerName": "Elber",
            "text": "Please take these. I can tell from your looks that you have been venturing around.",
            "nextDialogs": [
              "731850707"
            ]
          },
          "731850707": {
            "id": "731850707",
            "speakerId": 1000,
            "speakerName": "Elber",
            "text": "I happen to be in the business of those gears. You could use all these.",
            "nextDialogs": [
              "731850708"
            ]
          },
          "731850708": {
            "id": "731850708",
            "speakerId": 1000,
            "speakerName": "Elber",
            "text": "Whew... The Sumpter Beasts have been recovered and the goods are mostly intact. I should be off.",
            "nextDialogs": [
              "731850709"
            ]
          },
          "731850709": {
            "id": "731850709",
            "speakerId": 1000,
            "speakerName": "Elber",
            "text": "Thanks again, Traveler."
          }
        }
      }
    },

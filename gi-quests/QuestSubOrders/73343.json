        "dialogs": {
          "733430101": {
            "id": "733430101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Not bad, Sorush! You really made the area regain its vitality real quick, huh?",
            "nextDialogs": [
              "733430102"
            ]
          },
          "733430102": {
            "id": "733430102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pari powers are quite fascinating, yes.",
            "nextDialogs": [
              "733430103"
            ]
          },
          "733430103": {
            "id": "733430103",
            "speakerId": 13210,
            "speakerName": "Sorush",
            "text": "You startle pointlessly! My powers are more than enough to easily rescue the Sunyata Flower!",
            "nextDialogs": [
              "733430104"
            ]
          },
          "733430104": {
            "id": "733430104",
            "speakerId": 13210,
            "speakerName": "Sorush",
            "text": "The dark corrosion expands yet, and these Sunyata Flowers are but one amongst its many victims...",
            "nextDialogs": [
              "733430105"
            ]
          },
          "733430105": {
            "id": "733430105",
            "speakerId": 13210,
            "speakerName": "Sorush",
            "text": "The other flower ponds have not been spared. Sefana must be in quite the fluster at this moment.",
            "nextDialogs": [
              "733430106"
            ]
          },
          "733430106": {
            "id": "733430106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This Sefana you mentioned seems like a nice Pari who works hard to take care of the flowers...",
            "nextDialogs": [
              "733430107"
            ]
          },
          "733430107": {
            "id": "733430107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Let's go help her, shall we, {NICKNAME}?",
            "nextDialogs": [
              "733430108"
            ]
          },
          "733430108": {
            "id": "733430108",
            "speakerId": 13210,
            "speakerName": "Sorush",
            "text": "Well now, I suppose it may serve as a suitable diversion upon my great work. In that case, my Yasnapati, I bid you have a care for Sunyata Flowers of this kind.",
            "nextDialogs": [
              "733430109"
            ]
          },
          "733430109": {
            "id": "733430109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll tell you when I see them.",
            "nextDialogs": [
              "733430110"
            ]
          },
          "733430110": {
            "id": "733430110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yup! Let's save these pretty flowers together!"
          }
        }
      }
    },

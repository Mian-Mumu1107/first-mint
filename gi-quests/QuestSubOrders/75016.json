        ],
        "dialogs": {
          "750169901": {
            "id": "750169901",
            "speakerId": 1005,
            "speakerName": "<UNKNOWN>",
            "text": "One moment, friend!",
            "nextDialogs": [
              "750169902"
            ]
          },
          "750169902": {
            "id": "750169902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Then let's get rolling, and look for this token while we're at it!"
          }
        }
      }
    }
  ]
}
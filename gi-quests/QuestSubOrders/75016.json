    {
      "subId": "7501603",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750160301"
        ],
        "dialogs": {
          "750160301": {
            "id": "750160301",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Excuse me. You two are... travelers from beyond these lands, yes?",
            "nextDialogs": [
              "750160302"
            ]
          },
          "750160302": {
            "id": "750160302",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Heh... Sorry, but is this little Tepetlisaur your companion?",
            "nextDialogs": [
              "750160303"
            ]
          },
          "750160303": {
            "id": "750160303",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Even got a lovely scarf tied to his tail, I see! Haha, he sure is a little bundle of energy.",
            "nextDialogs": [
              "750160304"
            ]
          },
          "750160304": {
            "id": "750160304",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Yup, this is {REALNAME[ID(2)|SHOWHOST(true)]}. We met as soon as we arrived in Natlan, and he's been traveling with us since.",
            "nextDialogs": [
              "750160305"
            ]
          },
          "750160305": {
            "id": "750160305",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750160306"
            ]
          },
          "750160306": {
            "id": "750160306",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Traveling together, are you? Hmm. Well, then, forgive me for being presumptuous, but that kind of behavior is dangerous indeed...",
            "nextDialogs": [
              "750160310",
              "750160309"
            ]
          },
          "750160310": {
            "id": "750160310",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Humans and Saurians living together is pretty normal here, isn't it?",
            "nextDialogs": [
              "750160311"
            ]
          },
          "750160311": {
            "id": "750160311",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Or do you mean that traveling is dangerous, and so {REALNAME[ID(2)|SHOWHOST(true)]} shouldn't wander off too far?",
            "nextDialogs": [
              "750160312"
            ]
          },
          "750160312": {
            "id": "750160312",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Err?",
            "nextDialogs": [
              "750160313"
            ]
          },
          "750160313": {
            "id": "750160313",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "#Not exactly... Travel's good for Saurians and humans alike. But if you'll forgive my bluntness, {REALNAME[ID(2)|SHOWHOST(true)]} here is quite different.",
            "nextDialogs": [
              "750160314"
            ]
          },
          "750160314": {
            "id": "750160314",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Sorry. All this talk, and I haven't even introduced myself! Manqu's the name. I am a researcher for the Saurian Relics Association, and am responsible for scholarly inquiries into certain tribal customs...",
            "nextDialogs": [
              "750160315"
            ]
          },
          "750160315": {
            "id": "750160315",
            "speakerId": 1003,
            "speakerName": "Manqu",
            "text": "Simply put, I study past tribal customs.",
            "nextDialogs": [
              "750160316"
            ]
          },
          "750160316": {
            "id": "750160316",
            "speakerId": 1003,
            "speakerName": "Manqu",
            "text": "And of course, I've heard our little Tepetlisaur's name. May I have yours too?",
            "nextDialogs": [
              "750160317"
            ]
          },
          "750160317": {
            "id": "750160317",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Paimon's Paimon, and this is {NICKNAME}!",
            "nextDialogs": [
              "750160318"
            ]
          },
          "750160318": {
            "id": "750160318",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750160319"
            ]
          },
          "750160319": {
            "id": "750160319",
            "speakerId": 1003,
            "speakerName": "Manqu",
            "text": "#Ah, such energy. Looks like {NICKNAME} and Paimon have been taking good care of you...",
            "nextDialogs": [
              "750160320"
            ]
          },
          "750160320": {
            "id": "750160320",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Err... Err?",
            "nextDialogs": [
              "750160321"
            ]
          },
          "750160321": {
            "id": "750160321",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Of course we have! We've feasted a ton in our time together, haven't we, {REALNAME[ID(2)|SHOWHOST(true)]}?",
            "nextDialogs": [
              "750160322"
            ]
          },
          "750160322": {
            "id": "750160322",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Hey, {REALNAME[ID(2)|SHOWHOST(true)]}, don't go wandering off!",
            "nextDialogs": [
              "750160323"
            ]
          },
          "750160323": {
            "id": "750160323",
            "speakerId": 1003,
            "speakerName": "Manqu",
            "text": "Shame. He's such a vigorous little one too..."
          },
          "750160309": {
            "id": "750160309",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#C'mon, {REALNAME[ID(2)|SHOWHOST(true)]} wouldn't do that to you!"
          }
        }
      }
    },

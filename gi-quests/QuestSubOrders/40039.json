    {
      "subId": "4003901",
      "subQuestName": "Head to the Jade Chamber",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400390101"
        ],
        "dialogs": {
          "400390101": {
            "id": "400390101",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Beidou is salvaging some of my Jade Chamber collection out of the sea around Guyun Stone Forest. If that sounds like your idea of fun, you should go pay her a visit."
          }
        }
      }
    },
    {
      "subId": "4003902",
      "subQuestName": "Speak to Ningguang",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400390201"
        ],
        "dialogs": {
          "400390201": {
            "id": "400390201",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "A great many things are still unaccounted for...",
            "nextDialogs": [
              "400390202"
            ]
          },
          "400390202": {
            "id": "400390202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Things like what?",
            "nextDialogs": [
              "400390203"
            ]
          },
          "400390203": {
            "id": "400390203",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "The new Jade Chamber is missing many of the contents held by its predecessor.",
            "nextDialogs": [
              "400390204"
            ]
          },
          "400390204": {
            "id": "400390204",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "All the literature, furniture, and ornaments I had collected followed the original Jade Chamber to its watery grave...",
            "nextDialogs": [
              "400390205"
            ]
          },
          "400390205": {
            "id": "400390205",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Most of it was destroyed in the process, and the small handful of items that survived intact are strewn across the water's surface. Reclaiming them is taxing work.",
            "nextDialogs": [
              "400390206"
            ]
          },
          "400390206": {
            "id": "400390206",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "It takes someone with sturdy sea legs to handle this job, but even then... I just can't tell whether Beidou will be able to fish out everything herself.",
            "nextDialogs": [
              "400390207"
            ]
          },
          "400390207": {
            "id": "400390207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Fish out\"?",
            "nextDialogs": [
              "400390208"
            ]
          },
          "400390208": {
            "id": "400390208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, so you made Beidou go and fish your stuff out of the sea for you?",
            "nextDialogs": [
              "400390209"
            ]
          },
          "400390209": {
            "id": "400390209",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "To claim that I \"made\" her do anything would be imprecise. We reached a mutually beneficial agreement, as is always the case in our dealings.",
            "nextDialogs": [
              "400390210"
            ]
          },
          "400390210": {
            "id": "400390210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You pay Beidou to run errands for you?",
            "nextDialogs": [
              "400390211"
            ]
          },
          "400390211": {
            "id": "400390211",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Payment is one aspect of it. But I also compensate her in other ways... Hehe, let's just say it's a little complicated.",
            "nextDialogs": [
              "400390212"
            ]
          },
          "400390212": {
            "id": "400390212",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Anyway, Beidou is currently in the Guyun Stone Forest area.",
            "nextDialogs": [
              "400390213"
            ]
          },
          "400390213": {
            "id": "400390213",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "If you're interested, go pay her a visit. You may be just the help she needs."
          }
        }
      }
    },
    {
      "subId": "4003903",

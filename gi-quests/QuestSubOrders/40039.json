    {
      "subId": "4003908",
      "subQuestName": "Talk to Carmen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400390801"
        ],
        "dialogs": {
          "400390801": {
            "id": "400390801",
            "speakerId": 30086,
            "speakerName": "Carmen",
            "text": "Stop! All of you!",
            "nextDialogs": [
              "400390802"
            ]
          },
          "400390802": {
            "id": "400390802",
            "speakerId": 30086,
            "speakerName": "Carmen",
            "text": "Are you blind? Can't you see this is Captain Beidou!?",
            "nextDialogs": [
              "400390803"
            ]
          },
          "400390803": {
            "id": "400390803",
            "speakerId": 30086,
            "speakerName": "Carmen",
            "text": "Hehe... Cap'n Beidou, it's been a while. Still fighting fit, I see.",
            "nextDialogs": [
              "400390804"
            ]
          },
          "400390804": {
            "id": "400390804",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "I guess it has been a while, Carmen. You're looking a little worse for wear.",
            "nextDialogs": [
              "400390805"
            ]
          },
          "400390805": {
            "id": "400390805",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Maybe if you did your own dirty work rather than dispatching your minions, you wouldn't be so out of breath right now.",
            "nextDialogs": [
              "400390806"
            ]
          },
          "400390806": {
            "id": "400390806",
            "speakerId": 30086,
            "speakerName": "Carmen",
            "text": "Ah, how you jest, Beidou, very amusing... Hahaha...",
            "nextDialogs": [
              "400390807"
            ]
          },
          "400390807": {
            "id": "400390807",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "To get serious for a second, though — I'm gonna be needing all of this. So put everything down and I won't cause you any more trouble.",
            "nextDialogs": [
              "400390808"
            ]
          },
          "400390808": {
            "id": "400390808",
            "speakerId": 30086,
            "speakerName": "Carmen",
            "text": "Of course, of course, whatever Cap'n Beidou wants... You heard her, people. Drop the goods!",
            "nextDialogs": [
              "400390809"
            ]
          },
          "400390809": {
            "id": "400390809",
            "speakerId": 30086,
            "speakerName": "Carmen",
            "text": "Here you are, it's all here. So, uh... w—we'll take our leave now.",
            "nextDialogs": [
              "400390810"
            ]
          },
          "400390810": {
            "id": "400390810",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "Carmen dashes away with the Treasure Hoarders...",
            "nextDialogs": [
              "400390811"
            ]
          },
          "400390811": {
            "id": "400390811",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, he did what we asked without a second thought...",
            "nextDialogs": [
              "400390812"
            ]
          },
          "400390812": {
            "id": "400390812",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He couldn't surrender quickly enough.",
            "nextDialogs": [
              "400390813"
            ]
          },
          "400390813": {
            "id": "400390813",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Couldn't run off quickly enough, either...",
            "nextDialogs": [
              "400390814"
            ]
          },
          "400390814": {
            "id": "400390814",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Don't waste any more time on them. We've still got salvaging to do.",
            "nextDialogs": [
              "400390815"
            ]
          },
          "400390815": {
            "id": "400390815",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Ah, but we should load this stash onto the boat first... C'mon, Traveler, help me out here."
          }
        }
      }
    },
    {
      "subId": "4003916",
      "subQuestName": "Move the goods onboard your Waverider",

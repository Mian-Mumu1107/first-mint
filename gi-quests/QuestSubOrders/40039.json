    {
      "subId": "4003911",
      "subQuestName": "Follow the Treasure Hoarders",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400391101"
        ],
        "dialogs": {
          "400391101": {
            "id": "400391101",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "C'mon, we gotta wrap this up soon! Leave the junk, take anything and everything of value!",
            "nextDialogs": [
              "400391102"
            ]
          },
          "400391102": {
            "id": "400391102",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "And I need a few of you to go and load the boat up, move it!",
            "nextDialogs": [
              "400391103"
            ]
          },
          "400391103": {
            "id": "400391103",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Whatever you're about to do — don't. And whatever goods you're holding — they're mine now.",
            "nextDialogs": [
              "400391104"
            ]
          },
          "400391104": {
            "id": "400391104",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "B—Beidou!? Wh—What are you doing here!?",
            "nextDialogs": [
              "400391105"
            ]
          },
          "400391105": {
            "id": "400391105",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "I might ask you the same question.",
            "nextDialogs": [
              "400391106"
            ]
          },
          "400391106": {
            "id": "400391106",
            "speakerId": 30087,
            "speakerName": "Liuliu",
            "text": "I mean, what does it look like? We got lucky. Found some treasure floating around in the ocean.",
            "nextDialogs": [
              "400391107"
            ]
          },
          "400391107": {
            "id": "400391107",
            "speakerId": 30087,
            "speakerName": "Liuliu",
            "text": "If you see anything you like, it's yours for the taking! A token of our esteem for the mighty Captain Beidou, hahaha!",
            "nextDialogs": [
              "400391108"
            ]
          },
          "400391108": {
            "id": "400391108",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Is that right? Well, good. I'll take it all.",
            "nextDialogs": [
              "400391109"
            ]
          },
          "400391109": {
            "id": "400391109",
            "speakerId": 30087,
            "speakerName": "Liuliu",
            "text": "I... But... C'mon, heh, be reasonable here...",
            "nextDialogs": [
              "400391110"
            ]
          },
          "400391110": {
            "id": "400391110",
            "speakerId": 30087,
            "speakerName": "Liuliu",
            "text": "Me and the guys have been busting a gut gathering all this up... you gotta leave us a little something-something, surely?",
            "nextDialogs": [
              "400391111"
            ]
          },
          "400391111": {
            "id": "400391111",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Lemme make this crystal clear: These things do not belong to you, and they never will. So you're gonna put them down, and then you're gonna get as far away from me as is physically possible.",
            "nextDialogs": [
              "400391112"
            ]
          },
          "400391112": {
            "id": "400391112",
            "speakerId": 30087,
            "speakerName": "Liuliu",
            "text": "That's a little, uh... Heh, why don't we start over, huh? You see, we—",
            "nextDialogs": [
              "400391113"
            ]
          },
          "400391113": {
            "id": "400391113",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Huh... sounds a lot like you're stalling to me.",
            "nextDialogs": [
              "400391114"
            ]
          },
          "400391114": {
            "id": "400391114",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Talk is cheap. Let's settle this the old-fashioned way!"
          }
        }
      }
    },
    {
      "subId": "4003913",
      "subQuestName": "Defeat all the Treasure Hoarders",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4003914",
      "subQuestName": "Talk to Beidou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400391401"
        ],
        "dialogs": {
          "400391401": {
            "id": "400391401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Boy, they sure ran off quickly...",
            "nextDialogs": [
              "400391402"
            ]
          },
          "400391402": {
            "id": "400391402",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Eh, who cares. They didn't take anything with them.",
            "nextDialogs": [
              "400391403"
            ]
          },
          "400391403": {
            "id": "400391403",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "The bigger problem here is, there's no way all of this is going to fit onto your boat.",
            "nextDialogs": [
              "400391404"
            ]
          },
          "400391404": {
            "id": "400391404",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Hmm... Okay, here's what we're gonna do. Unload the boat and put everything here, in one place.",
            "nextDialogs": [
              "400391405"
            ]
          },
          "400391405": {
            "id": "400391405",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Based on the original plan, Sea Drake's boat should be coming past here at some point. When they get here, we'll hitch a ride with them.",
            "nextDialogs": [
              "400391406"
            ]
          },
          "400391406": {
            "id": "400391406",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "In the meantime, Traveler, head back to the Jade Chamber and deliver a message to Ningguang for me.",
            "nextDialogs": [
              "400391407"
            ]
          },
          "400391407": {
            "id": "400391407",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Just tell her we're almost done fishing for trinkets here, so she should start getting my compensation ready.",
            "nextDialogs": [
              "400391408"
            ]
          },
          "400391408": {
            "id": "400391408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it.",
            "nextDialogs": [
              "400391409"
            ]
          },
          "400391409": {
            "id": "400391409",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Alright. Thanks, Traveler.",
            "nextDialogs": [
              "400391410"
            ]
          },
          "400391410": {
            "id": "400391410",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "If both Carmen and Liuliu were here... Then I wonder if that other \"boss\" of theirs, Big Sis, is snooping around?",
            "nextDialogs": [
              "400391411"
            ]
          },
          "400391411": {
            "id": "400391411",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "I've gotta tell Sea Drake and the rest of the crew to stay on high alert..."
          }
        }
      }
    },
    {
      "subId": "4003912",
      "subQuestName": "Report back to Ningguang",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400391201"
        ],
        "dialogs": {
          "400391201": {
            "id": "400391201",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Welcome back. I trust Beidou is making good progress on salvaging the items?",
            "nextDialogs": [
              "400391202"
            ]
          },
          "400391202": {
            "id": "400391202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let me fill you in...",
            "nextDialogs": [
              "400391203"
            ]
          },
          "400391203": {
            "id": "400391203",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "You bring Ningguang up to speed on the events so far...",
            "nextDialogs": [
              "400391204"
            ]
          },
          "400391204": {
            "id": "400391204",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Treasure Hoarders, I see... Yes, I can imagine that must have been rather irksome.",
            "nextDialogs": [
              "400391205"
            ]
          },
          "400391205": {
            "id": "400391205",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "It sounds like you scared them off on this occasion. But it won't end there. They are not the type to forgive and forget.",
            "nextDialogs": [
              "400391206"
            ]
          },
          "400391206": {
            "id": "400391206",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "You needn't concern yourself with them any further, though. Leave them to Beidou — she is well versed in handling Treasure Hoarders. I will be sure to make preparations for her compensation.",
            "nextDialogs": [
              "400391207"
            ]
          },
          "400391207": {
            "id": "400391207",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "I also owe you my thanks for coming all this way to deliver Beidou's message. Here, please take this as a token of my appreciation.",
            "nextDialogs": [
              "400391208"
            ]
          },
          "400391208": {
            "id": "400391208",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Now, please excuse me, I have other business that demands my attention. I wish you a fun-filled festival."
          }
        }
      }
    },
    {
      "subId": "4003999",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400399901"
        ],
        "dialogs": {
          "400399901": {
            "id": "400399901",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "So... this is it? This is your boat?",
            "nextDialogs": [
              "400399902"
            ]
          },
          "400399902": {
            "id": "400399902",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "It's really, uh... compact. But, it works... It's about the right size for sweeping up junk from the water's surface.",
            "nextDialogs": [
              "400399903"
            ]
          },
          "400399903": {
            "id": "400399903",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Only thing is... we're packed in like sardines here. There's nowhere to put my guitar...",
            "nextDialogs": [
              "400399904"
            ]
          },
          "400399904": {
            "id": "400399904",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Uh, Xinyan, your \"axe\" is getting a little too close for comfort...",
            "nextDialogs": [
              "400399905"
            ]
          },
          "400399905": {
            "id": "400399905",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Oh! Whoops! Lemme try to move that out of your way...",
            "nextDialogs": [
              "400399906"
            ]
          },
          "400399906": {
            "id": "400399906",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Huh? Umm Xinyan, why does your guitar have blades on it?",
            "nextDialogs": [
              "400399907"
            ]
          },
          "400399907": {
            "id": "400399907",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Self-defense, of course! It shoots fire, too! ...Oh, but the middle of a big festival probably isn't the best time to give you a demonstration...",
            "nextDialogs": [
              "400399908"
            ]
          },
          "400399908": {
            "id": "400399908",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Also, there's a teeny-tiny chance it might set your boat on fire... That's not a risk worth taking, no matter how small...",
            "nextDialogs": [
              "400399929"
            ]
          },
          "400399929": {
            "id": "400399929",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whew, this gal really jazzed up her guitar...",
            "nextDialogs": [
              "400399909"
            ]
          },
          "400399909": {
            "id": "400399909",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Hold up, are those... Treasure Hoarders!?",
            "nextDialogs": [
              "400399910"
            ]
          },
          "400399910": {
            "id": "400399910",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "We don't usually see these guys out at sea... Could they be here for the same reason as us?",
            "nextDialogs": [
              "400399911"
            ]
          },
          "400399911": {
            "id": "400399911",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "C'mon, Traveler. Steer us a little closer.",
            "nextDialogs": [
              "400399919"
            ]
          },
          "400399919": {
            "id": "400399919",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Hey! There're some things floating on the water...",
            "nextDialogs": [
              "400399920"
            ]
          },
          "400399920": {
            "id": "400399920",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Hmm, I can't quite make out what they are. Let's bring them in and take a look.",
            "nextDialogs": [
              "400399921"
            ]
          },
          "400399921": {
            "id": "400399921",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "I'll take the rudder. Traveler, Xinyan — go reel them in."
          }
        }
      }
    }
  ]
}
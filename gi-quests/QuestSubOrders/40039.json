    {
      "subId": "4003915",
      "subQuestName": "Talk to Beidou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400391501"
        ],
        "dialogs": {
          "400391501": {
            "id": "400391501",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Huh? Why're they heading back to shore?",
            "nextDialogs": [
              "400391502"
            ]
          },
          "400391502": {
            "id": "400391502",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "To reconvene with their posse, I'll bet.",
            "nextDialogs": [
              "400391503"
            ]
          },
          "400391503": {
            "id": "400391503",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Speed it up a notch, Traveler. This is a chase now."
          }
        }
      }
    },

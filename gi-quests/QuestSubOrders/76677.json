          "766770101": {
            "id": "766770101",
            "speakerId": 1000,
            "speakerName": "Varka",
            "text": "Honorary Knight! Thanks to you, this post's finally starting to look the part.",
            "nextDialogs": [
              "766770102"
            ]
          },
          "766770102": {
            "id": "766770102",
            "speakerId": 1000,
            "speakerName": "Varka",
            "text": "...Now, even if we're attacked while the whole camp's dead drunk, we'll be able to hold out 'til I sober up.",
            "nextDialogs": [
              "766770103"
            ]
          },
          "766770103": {
            "id": "766770103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're joking again. Right?",
            "nextDialogs": [
              "766770104"
            ]
          },
          "766770104": {
            "id": "766770104",
            "speakerId": 1000,
            "speakerName": "Varka",
            "text": "Saw right through me? Did you learn all my tells without even trying, Honorary Knight?",
            "nextDialogs": [
              "766770105"
            ]
          },
          "766770105": {
            "id": "766770105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "More like we've gotten used to your nonsense without even trying!",
            "nextDialogs": [
              "766770106"
            ]
          },
          "766770106": {
            "id": "766770106",
            "speakerId": 1000,
            "speakerName": "Varka",
            "text": "Ha! Still, when I'm not on watch, that's when it's time to crack open a cask! You're always welcome here."
          }
        }
      }

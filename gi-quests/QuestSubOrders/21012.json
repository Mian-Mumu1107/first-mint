              "210100004"
            ]
          },
          "210100004": {
            "id": "210100004",
            "speakerId": 1000,
            "speakerName": "Dandy",
            "text": "I was going to go and try myself, but then these piles of leaves scuppered my plans. I just want to clear them all away...",
            "nextDialogs": [
              "210100005"
            ]
          },
          "210100005": {
            "id": "210100005",
            "speakerId": 1000,
            "speakerName": "Dandy",
            "text": "But that would mean walk down the stairs clearing them one step at a time. It's tiring to even contemplate.",
            "nextDialogs": [
              "210100006"
            ]
          },
          "210100006": {
            "id": "210100006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll try.",
            "nextDialogs": [
              "210100007"
            ]
          },
          "210100007": {
            "id": "210100007",
            "speakerId": 1000,
            "speakerName": "Dandy",
            "text": "Haha, great. Thanks a lot!"
          }
        }
      }

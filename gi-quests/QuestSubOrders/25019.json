{
  "lineCounts": {
    "Black Screen": 1,
    "Grispan": 78,
    "Grobel": 15,
    "Paimon": 2,
    "Player": 20
  },
  "subQuests": [
    {
      "subId": "2501901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190101"
        ],
        "dialogs": {
          "250190101": {
            "id": "250190101",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "So this is... an Embercore Flower. Not bad, not bad at all. It'll come in handy, I'm sure.",
            "nextDialogs": [
              "250190102"
            ]
          },
          "250190102": {
            "id": "250190102",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow, meow?",
            "nextDialogs": [
              "250190103"
            ]
          },
          "250190103": {
            "id": "250190103",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "My dear President, I fear this flower isn't amenable to being cultivated in Fontaine.",
            "nextDialogs": [
              "250190104"
            ]
          },
          "250190104": {
            "id": "250190104",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "But if you insist, perhaps we could use it as a bookmark?"
          }
        }
      }
    },
    {
      "subId": "2501902",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250192001"
        ],
        "dialogs": {
          "250192001": {
            "id": "250192001",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Wonderful! I shall be counting on you, then! In the meantime, I shall be here perfecting my phlogiston extraction plan. There are yet many instruments that await my redesigning, too.",
            "nextDialogs": [
              "250192002"
            ]
          },
          "250192002": {
            "id": "250192002",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Yet, it shall all be worth it! As long as I extract what it is I desire, I can finally return to my hometown and continue researching in peace."
          }
        }
      }
    },
    {
      "subId": "2501903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190301"
        ],
        "dialogs": {
          "250190301": {
            "id": "250190301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's go together, shall we?",
            "nextDialogs": [
              "250190302"
            ]
          },
          "250190302": {
            "id": "250190302",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Together, you say? Even better! I've been champing at the bit to do some fieldwork. And with you here, the risks involved may as well be null and void.",
            "nextDialogs": [
              "250190303"
            ]
          },
          "250190303": {
            "id": "250190303",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "#Come then, let us go. Ah, yes. {M#Mr.} {F#Ms.} {NICKNAME}?",
            "nextDialogs": [
              "250190304"
            ]
          },
          "250190304": {
            "id": "250190304",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "#Then, Madame President... You stay right here. Do not worry! With {M#Mr.}{F#Ms.} {NICKNAME} here, my personal safety is guaranteed!",
            "nextDialogs": [
              "250190305"
            ]
          },
          "250190305": {
            "id": "250190305",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow... meow meow... meow...",
            "nextDialogs": [
              "250190306"
            ]
          },
          "250190306": {
            "id": "250190306",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Err, I almost forgot to say that I've marked a certain location on your map. The Candlecap Mushrooms there will more than do!"
          }
        }
      }
    },
    {
      "subId": "2501904",
      "subQuestName": "Talk to Grispan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2501911",
      "subQuestName": "Talk to Grispan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250192103"
        ],
        "dialogs": {
          "250192103": {
            "id": "250192103",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Many thanks! Once my research succeeds, I'd be happy to have you be the first to experience \"thermal hypnosis.\"",
            "nextDialogs": [
              "250192104"
            ]
          },
          "250192104": {
            "id": "250192104",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow! Meow meow, meow!",
            "nextDialogs": [
              "250192105"
            ]
          },
          "250192105": {
            "id": "250192105",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "What do you mean, Madame President? My thermal hypnosis is perfectly safe! No side effects at all!",
            "nextDialogs": [
              "250192106"
            ]
          },
          "250192106": {
            "id": "250192106",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "#Now then, {M#Mr.}{F#Ms.} {NICKNAME} — my good night's sleep and burning phlogiston are in your capable hands."
          }
        }
      }
    },
    {
      "subId": "2501905",
      "subQuestName": "Give the Candlecap Mushroom or Embercore Flower to Grispan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190501"
        ],
        "dialogs": {
          "250190501": {
            "id": "250190501",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow... meow meow... meow..."
          }
        }
      }
    },
    {
      "subId": "2501913",
      "subQuestName": "Give the Candlecap Mushroom or Embercore Flower to Grispan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191301"
        ],
        "dialogs": {
          "250191301": {
            "id": "250191301",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "#Ah, my good {M#Mr.}{F#Ms.} {NICKNAME}. We meet again.",
            "nextDialogs": [
              "250191302"
            ]
          },
          "250191302": {
            "id": "250191302",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Thanks to your help previously, my research has advanced by a leap and a bound.",
            "nextDialogs": [
              "250191303"
            ]
          },
          "250191303": {
            "id": "250191303",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "At this rate, I shall be able to reach my intended targets!",
            "nextDialogs": [
              "250191305",
              "250191316"
            ]
          },
          "250191305": {
            "id": "250191305",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Oh, I didn't introduce my work to you? Ah, goodness, would you believe that? Come then, let me give you a quick rundown...",
            "nextDialogs": [
              "250191306"
            ]
          },
          "250191306": {
            "id": "250191306",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow! Meow-meow-meow-meow. Meow-meow!",
            "nextDialogs": [
              "250191307"
            ]
          },
          "250191307": {
            "id": "250191307",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Ah, right you are, Madame President. I shall make this as brief as I can.",
            "nextDialogs": [
              "250191308"
            ]
          },
          "250191308": {
            "id": "250191308",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Simply put, I am planning to collect phlogiston, and use its \"thermal energy\" to conduct hypnosis.",
            "nextDialogs": [
              "250191309"
            ]
          },
          "250191309": {
            "id": "250191309",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "My hypnotic device is not on hand at the moment... But, if you would, imagine a box half a person in height, just large enough for a person to sit within.",
            "nextDialogs": [
              "250191310"
            ]
          },
          "250191310": {
            "id": "250191310",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "This box contains a steamer that, well, constantly generates steam, keeping the box's internal temperature at a specified value.",
            "nextDialogs": [
              "250191311"
            ]
          },
          "250191311": {
            "id": "250191311",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "The person undergoing hypnosis will sit within with their head exposed while their body is heated up inside... I believe that this will allow the hypnosis to work faster and better!",
            "nextDialogs": [
              "250191312"
            ]
          },
          "250191312": {
            "id": "250191312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's just going to knock the person out with the heat!",
            "nextDialogs": [
              "250191313"
            ]
          },
          "250191313": {
            "id": "250191313",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Well, you do have a point, but we perhaps have different definitions of \"knocking a person out\"...",
            "nextDialogs": [
              "250191314"
            ]
          },
          "250191314": {
            "id": "250191314",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "In any case, let us put aside the finer details for now. At the moment, I still need your help.",
            "nextDialogs": [
              "250191317"
            ]
          },
          "250191317": {
            "id": "250191317",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "The task is the same as before. I'd like you to help me collect objects that contain \"phlogiston.\"",
            "nextDialogs": [
              "250191318"
            ]
          },
          "250191318": {
            "id": "250191318",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Let me think... Hmm, I'd say you should bring some Embercore Flowers. Those plants certainly do contain a significant amount of phlogiston.",
            "nextDialogs": [
              "250191319"
            ]
          },
          "250191319": {
            "id": "250191319",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Of course, Candlecap Mushrooms remain important as experimental material. You see..."
          },
          "250191316": {
            "id": "250191316",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Ah, very sharp! I knew that you'd be easy to work with."
          }
        }
      }
    },
    {
      "subId": "2501906",
      "subQuestName": "Talk to Grispan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250192401"
        ],
        "dialogs": {
          "250192401": {
            "id": "250192401",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "#Now, we have enough material to restart the experiments. Thank you once again, {M#Mr.}{F#Ms.} {NICKNAME}.",
            "nextDialogs": [
              "250192402"
            ]
          },
          "250192402": {
            "id": "250192402",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Please, take this as compensation for your help.",
            "nextDialogs": [
              "250192403"
            ]
          },
          "250192403": {
            "id": "250192403",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow, meow meow, meow.",
            "nextDialogs": [
              "250192404"
            ]
          },
          "250192404": {
            "id": "250192404",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Our dear President thanks you as well. Once my research succeeds, I'd be willing to engrave your name upon the first thermal hypnosis device.",
            "nextDialogs": [
              "250192405"
            ]
          },
          "250192405": {
            "id": "250192405",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Alright, then! It's time for some practical tests. Now, where should we conduct those..."
          }
        }
      }
    },
    {
      "subId": "2501910",
      "subQuestName": "Talk to Grispan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2501907",
      "subQuestName": "Meet up with Grispan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191101"
        ],
        "dialogs": {
          "250191101": {
            "id": "250191101",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Ha! Take a look at this Grainfruit! It sure is growing well... Might it, too, be affected by phlogiston? I must pick it! It shall join my samples.",
            "nextDialogs": [
              "250191102"
            ]
          },
          "250191102": {
            "id": "250191102",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "#{M#Mr.}{F#Ms.} {NICKNAME}, would you mind helping me out? Just take the stem and...",
            "nextDialogs": [
              "250191105"
            ]
          },
          "250191105": {
            "id": "250191105",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Ah!? H—Help!"
          }
        }
      }
    },
    {
      "subId": "2501912",
      "subQuestName": "Meet up with Grispan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2501908",
      "subQuestName": "Defeat the Secret Source Automaton",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190801"
        ],
        "dialogs": {
          "250190801": {
            "id": "250190801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#Hi, I'm {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "2501909",
      "subQuestName": "Talk to Grispan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190901"
        ],
        "dialogs": {
          "250190901": {
            "id": "250190901",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "#My thanks for the helping hand, {M#Mr.}{F#Ms.} {NICKNAME}.",
            "nextDialogs": [
              "250190902"
            ]
          },
          "250190902": {
            "id": "250190902",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Ah, this was a thrilling adventure, wasn't it? A good thing I convinced the President to remain with the tribe.",
            "nextDialogs": [
              "250190903"
            ]
          },
          "250190903": {
            "id": "250190903",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "With how much she hates such unexpected incidents, I should hate to be on the receiving end of one of her scoldings.",
            "nextDialogs": [
              "250190904"
            ]
          },
          "250190904": {
            "id": "250190904",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Still, considering that I still managed to scrounge up sufficient materials... All's well that ends well, hmm?",
            "nextDialogs": [
              "250190905"
            ]
          },
          "250190905": {
            "id": "250190905",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "#These are for you, {M#Mr.}{F#Ms.} {NICKNAME} — thanks again for your help.",
            "nextDialogs": [
              "250190906"
            ]
          },
          "250190906": {
            "id": "250190906",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Once my research succeeds, I'd be happy to have you be the first to experience \"thermal hypnosis.\""
          }
        }
      }
    },
    {
      "subId": "2501902",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190201"
        ],
        "dialogs": {
          "250190201": {
            "id": "250190201",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow, meow-meow-meow, meow-meow-meow, meow.",
            "nextDialogs": [
              "250190202"
            ]
          },
          "250190202": {
            "id": "250190202",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "No worries, President. I will keep the introductions short... Ah, you must forgive my mouth for prattling on and on. I do not have another to discipline it with, after all.",
            "nextDialogs": [
              "250190203"
            ]
          },
          "250190203": {
            "id": "250190203",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "#Simply put, {NICKNAME}, I would like you to help me collect objects that contain \"phlogiston.\"",
            "nextDialogs": [
              "250190204"
            ]
          },
          "250190204": {
            "id": "250190204",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Let me think... Um, so I've been using Candlecap Mushrooms for phlogiston extraction, so, could I get you to help me find some?",
            "nextDialogs": [
              "250190206"
            ]
          },
          "250190206": {
            "id": "250190206",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "That said, I've heard that Embercore Flowers also contain lots of phlogiston... It'd be nice if you could get me one as well!",
            "nextDialogs": [
              "250190205"
            ]
          },
          "250190205": {
            "id": "250190205",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "So long as I have enough phlogiston, I can start my research right here."
          }
        }
      }
    },
    {
      "subId": "2501904",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190401"
        ],
        "dialogs": {
          "250190401": {
            "id": "250190401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#Hi, I'm {NICKNAME}.",
            "nextDialogs": [
              "250190403"
            ]
          },
          "250190403": {
            "id": "250190403",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "My, oh my, you are most famous indeed! An honor to meet you both at last!",
            "nextDialogs": [
              "250190404"
            ]
          },
          "250190404": {
            "id": "250190404",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow, meow-meow.",
            "nextDialogs": [
              "250190405"
            ]
          },
          "250190405": {
            "id": "250190405",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "And Madame President bids you good day also. Had we met in Petrichor, I would have gladly treated you to a lovely cup of tea.",
            "nextDialogs": [
              "250190406"
            ]
          },
          "250190406": {
            "id": "250190406",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "But at the moment... Well, let's just say there's not even any tea to be had.",
            "nextDialogs": [
              "250190407"
            ]
          },
          "250190407": {
            "id": "250190407",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Err, did you run into any trouble? You're pouring with sweat...",
            "nextDialogs": [
              "250190408"
            ]
          },
          "250190408": {
            "id": "250190408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Quite understandable. Natlan is pretty hot.",
            "nextDialogs": [
              "250190409"
            ]
          },
          "250190409": {
            "id": "250190409",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Haha! A gladsome meeting this is! You are the first, and only, person I've met here who shares my sense of humor.",
            "nextDialogs": [
              "250190410"
            ]
          },
          "250190410": {
            "id": "250190410",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Yet Natlan's heat cannot compare to my inner anxiety. That all my troubles should have struck at once...",
            "nextDialogs": [
              "250190411"
            ]
          },
          "250190411": {
            "id": "250190411",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Not only have I not gathered enough phlogiston, but I have even lost contact with my hometown.",
            "nextDialogs": [
              "250190412"
            ]
          },
          "250190412": {
            "id": "250190412",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "#I know it is rude to commission someone to do a task after meeting them for the first time, dear {NICKNAME}.",
            "nextDialogs": [
              "250190413"
            ]
          },
          "250190413": {
            "id": "250190413",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "But I do need someone I can rely on — and you are, without a doubt, the best candidate I could ask to find in that regard."
          }
        }
      }
    },
    {
      "subId": "2501906",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190601"
        ],
        "dialogs": {
          "250190601": {
            "id": "250190601",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Oh! This is it! The Candlecap Mushroom. H—How wonderful!",
            "nextDialogs": [
              "250190602"
            ]
          },
          "250190602": {
            "id": "250190602",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow, meow... meow, meow?",
            "nextDialogs": [
              "250190603"
            ]
          },
          "250190603": {
            "id": "250190603",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Do not fret, Madame President, I shall not be eating any of this... Not until we are done here, anyway."
          }
        }
      }
    },
    {
      "subId": "2501907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250190701"
        ],
        "dialogs": {
          "250190701": {
            "id": "250190701",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Well, this place sure is a hot spot... How are you feeling, my good President?",
            "nextDialogs": [
              "250190702"
            ]
          },
          "250190702": {
            "id": "250190702",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow.",
            "nextDialogs": [
              "250190703"
            ]
          },
          "250190703": {
            "id": "250190703",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Alas, I am sorry. I fear Este and Mécantre have yet to reply in writing.",
            "nextDialogs": [
              "250190704"
            ]
          },
          "250190704": {
            "id": "250190704",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "I wonder what has befallen the town... and yet, I cannot simply pack up and go back now...",
            "nextDialogs": [
              "250190705"
            ]
          },
          "250190705": {
            "id": "250190705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You don't look like you're from around here.",
            "nextDialogs": [
              "250190706"
            ]
          },
          "250190706": {
            "id": "250190706",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "And I could say the same to you. Greetings. Grispan's the name, of meager Fontaine Daydream Club fame.",
            "nextDialogs": [
              "250190707"
            ]
          },
          "250190707": {
            "id": "250190707",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "And this is our club President... or would \"Director\" be more appropriate? Either way, this is our leader, Lady Grobel."
          }
        }
      }
    },
    {
      "subId": "2501910",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191001"
        ],
        "dialogs": {
          "250191001": {
            "id": "250191001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This is Paimon."
          }
        }
      }
    },
    {
      "subId": "2501912",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191201"
        ],
        "dialogs": {
          "250191201": {
            "id": "250191201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you a member of the Daydream Club?",
            "nextDialogs": [
              "250191202"
            ]
          },
          "250191202": {
            "id": "250191202",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Eh? Wait, didn't we hear Este and the others talk about someone named \"Grispan\"?",
            "nextDialogs": [
              "250191203"
            ]
          },
          "250191203": {
            "id": "250191203",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "You've been to our Club? Oh sweet springs of Lucine, some luck at last!",
            "nextDialogs": [
              "250191204"
            ]
          },
          "250191204": {
            "id": "250191204",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Do you know what's happened over there, by any chance? I've sent letter after letter, yet received no response!",
            "nextDialogs": [
              "250191216"
            ]
          },
          "250191216": {
            "id": "250191216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About what happened in Petrichor...",
            "nextDialogs": [
              "250191206"
            ]
          },
          "250191206": {
            "id": "250191206",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You update Grispan on what befell Petrichor in his absence...",
            "nextDialogs": [
              "250191207"
            ]
          },
          "250191207": {
            "id": "250191207",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Oh... Wow, uh... That truly is... quite shocking.",
            "nextDialogs": [
              "250191208"
            ]
          },
          "250191208": {
            "id": "250191208",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow... Meow meow. Meow.",
            "nextDialogs": [
              "250191209"
            ]
          },
          "250191209": {
            "id": "250191209",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Indeed, Madame President. I am truly most shooketh.",
            "nextDialogs": [
              "250191215"
            ]
          },
          "250191215": {
            "id": "250191215",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "I can't believe it! I missed out on a mass hypnosis of such a colossal scale! By the sweet waters of Lucine!",
            "nextDialogs": [
              "250191211"
            ]
          },
          "250191211": {
            "id": "250191211",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Had I been there, I'd have been able to collect a whole bunch of useful experimental data!",
            "nextDialogs": [
              "250191212"
            ]
          },
          "250191212": {
            "id": "250191212",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Madame President, it seems that we must finish up here as soon as is humanly possible, so that we may head back to the Club to check on things.",
            "nextDialogs": [
              "250191213"
            ]
          },
          "250191213": {
            "id": "250191213",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "#Ahem... Now, then, I know it is rude to commission someone to do a task after meeting them for the first time, dear {NICKNAME}...",
            "nextDialogs": [
              "250191214"
            ]
          },
          "250191214": {
            "id": "250191214",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "But I do need someone I can rely on — and you are, without a doubt, the best candidate I could ask to find in that regard."
          }
        }
      }
    },
    {
      "subId": "2501914",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191401"
        ],
        "dialogs": {
          "250191401": {
            "id": "250191401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Both species will do, right?"
          }
        }
      }
    },
    {
      "subId": "2501915",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191501"
        ],
        "dialogs": {
          "250191501": {
            "id": "250191501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How much have you gathered already?",
            "nextDialogs": [
              "250191502"
            ]
          },
          "250191502": {
            "id": "250191502",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Me? Hahaha... We've gotten off to a \"fine\" start, that's for sure.",
            "nextDialogs": [
              "250191503"
            ]
          },
          "250191503": {
            "id": "250191503",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "*sigh* But there's nothing I can do about that. The Saurians swarming the wilds of Natlan are generally not the conversational types.",
            "nextDialogs": [
              "250191504"
            ]
          },
          "250191504": {
            "id": "250191504",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Now, I can handle deactivating machines remotely, and can disable ones that have gone haywire... But there's nothing I can do about Saurians!",
            "nextDialogs": [
              "250191505"
            ]
          },
          "250191505": {
            "id": "250191505",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow meow. Meow..."
          }
        }
      }
    },
    {
      "subId": "2501916",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191601"
        ],
        "dialogs": {
          "250191601": {
            "id": "250191601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There are other adventurers in Natlan, you know.",
            "nextDialogs": [
              "250191602"
            ]
          },
          "250191602": {
            "id": "250191602",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "I... Ah, I mean no offense, but I really am not good at dealing with the good ladies and gentlemen of Natlan.",
            "nextDialogs": [
              "250191603"
            ]
          },
          "250191603": {
            "id": "250191603",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Their enthusiasm would know no shame even if compared to a volcano, but alas, I fear I should be vaporized on the spot should I get too close...",
            "nextDialogs": [
              "250191604"
            ]
          },
          "250191604": {
            "id": "250191604",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "#So you are the only one I can count on, {M#Mr.}{F#Ms.} {NICKNAME}!",
            "nextDialogs": [
              "250191605"
            ]
          },
          "250191605": {
            "id": "250191605",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow meow. Meow..."
          }
        }
      }
    },
    {
      "subId": "2501917",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191701"
        ],
        "dialogs": {
          "250191701": {
            "id": "250191701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright, leave it to me."
          }
        }
      }
    },
    {
      "subId": "2501918",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191801"
        ],
        "dialogs": {
          "250191801": {
            "id": "250191801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright then, leave it to me."
          }
        }
      }
    },
    {
      "subId": "2501919",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250191901"
        ],
        "dialogs": {
          "250191901": {
            "id": "250191901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll do it for Garcia."
          }
        }
      }
    },
    {
      "subId": "2501922",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250192201"
        ],
        "dialogs": {
          "250192201": {
            "id": "250192201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's go together, shall we?",
            "nextDialogs": [
              "250192202"
            ]
          },
          "250192202": {
            "id": "250192202",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Of course. A couple of things did go wrong in our previous field study, but I learned a lot from it all the same.",
            "nextDialogs": [
              "250192203"
            ]
          },
          "250192203": {
            "id": "250192203",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow, meow...",
            "nextDialogs": [
              "250192204"
            ]
          },
          "250192204": {
            "id": "250192204",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "#Um... Then you stay right here, Madame President. Do not worry! With {M#Mr.}{F#Ms.} {NICKNAME} here, my personal safety is guaranteed!",
            "nextDialogs": [
              "250192205"
            ]
          },
          "250192205": {
            "id": "250192205",
            "speakerId": 1001,
            "speakerName": "Grobel",
            "text": "Meow... meow meow... meow..."
          }
        }
      }
    },
    {
      "subId": "2501923",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250192301"
        ],
        "dialogs": {
          "250192301": {
            "id": "250192301",
            "speakerId": 1000,
            "speakerName": "Grispan",
            "text": "Have you found what I need?"
          }
        }
      }
    }
  ]
}
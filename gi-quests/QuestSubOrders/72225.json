        "dialogs": {
          "722250101": {
            "id": "722250101",
            "speakerId": 20449,
            "speakerName": "Ku",
            "text": "Ouch...",
            "nextDialogs": [
              "722250102"
            ]
          },
          "722250102": {
            "id": "722250102",
            "speakerId": 20320,
            "speakerName": "Ruu",
            "text": "#{NICKNAME}! Paimon! You're just in time...",
            "nextDialogs": [
              "722250103"
            ]
          },
          "722250103": {
            "id": "722250103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "722250104"
            ]
          },
          "722250104": {
            "id": "722250104",
            "speakerId": 20449,
            "speakerName": "Ku",
            "text": "Ow, ow, ow, think I sprained my ankle...",
            "nextDialogs": [
              "722250105"
            ]
          },
          "722250105": {
            "id": "722250105",
            "speakerId": 20320,
            "speakerName": "Ruu",
            "text": "Big Brother Ku's hurt again. Could you please help us make offerings at the Perch?",
            "nextDialogs": [
              "722250107"
            ]
          },
          "722250107": {
            "id": "722250107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Don't you worry about a thing! We've got this!",
            "nextDialogs": [
              "722250109"
            ]
          },
          "722250109": {
            "id": "722250109",
            "speakerId": 20320,
            "speakerName": "Ruu",
            "text": "Thanks so much!",
            "nextDialogs": [
              "722250110"
            ]
          },
          "722250110": {
            "id": "722250110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, right! Aren't you very sensitive to the elements and all, Ruu?",
            "nextDialogs": [
              "722250111"
            ]
          },
          "722250111": {
            "id": "722250111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why don't you do that yourself?",
            "nextDialogs": [
              "722250112"
            ]
          },
          "722250112": {
            "id": "722250112",
            "speakerId": 20320,
            "speakerName": "Ruu",
            "text": "Uh... So, I did try before in previous ceremonies, but it didn't turn out so well."
          }
        }
      }
    },
    {
      "subId": "7222506",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {

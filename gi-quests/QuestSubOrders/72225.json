        ],
        "dialogs": {
          "722250601": {
            "id": "722250601",
            "speakerId": 20449,
            "speakerName": "Ku",
            "text": "Ugh, what an embarrassment... I just hope this won't affect the ceremony.",
            "nextDialogs": [
              "722250602"
            ]
          },
          "722250602": {
            "id": "722250602",
            "speakerId": 20449,
            "speakerName": "Ku",
            "text": "I wouldn't know how to face you if it does, Ruu.",
            "nextDialogs": [
              "722250603"
            ]
          },
          "722250603": {
            "id": "722250603",
            "speakerId": 20320,
            "speakerName": "Ruu",
            "text": "Oh, don't be like that! You've always been so nice to me!"
          }
        }
      }
    },
    {
      "subId": "7222502",

  },
  "subQuests": [
    {
      "subId": "1401601",
      "subQuestName": "Go to the Court of Fontaine to collect the goods",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140160101"
        ],
        "dialogs": {
          "140160101": {
            "id": "140160101",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Hey there, Ludivine? How's business lately?",
            "nextDialogs": [
              "140160102"
            ]
          },
          "140160102": {
            "id": "140160102",
            "speakerId": 13772,
            "speakerName": "Ludivine",
            "text": "Ah, the Demoiselle of Spina di Rosula! I must say, your generous patronage is the one thing keeping me from going bankrupt.",
            "nextDialogs": [
              "140160103"
            ]
          },
          "140160103": {
            "id": "140160103",
            "speakerId": 13709,
            "speakerName": "Colter",
            "text": "Haha, nonsense, we all know what a talented businesswoman you are. Oh, and don't forget, she's the Boss now.",
            "nextDialogs": [
              "140160104"
            ]
          },
          "140160104": {
            "id": "140160104",
            "speakerId": 13772,
            "speakerName": "Ludivine",
            "text": "My mistake, my mistake. I just got so used to calling her Demoiselle.",
            "nextDialogs": [
              "140160105"
            ]
          },
          "140160105": {
            "id": "140160105",
            "speakerId": 13772,
            "speakerName": "Ludivine",
            "text": "Are you here for the uniform?",
            "nextDialogs": [
              "140160106"
            ]
          },
          "140160106": {
            "id": "140160106",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Yup. I forgot to drop by earlier when I was running errands around here.",
            "nextDialogs": [
              "140160107"
            ]
          },
          "140160107": {
            "id": "140160107",
            "speakerId": 13772,
            "speakerName": "Ludivine",
            "text": "Haha, I didn't expect Demoiselle to come and pick it up in person. It's just a uniform, after all. Any of your folks could have come instead.",
            "nextDialogs": [
              "140160108"
            ]
          },
          "140160108": {
            "id": "140160108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Navia's always liked to take even small things seriously!",
            "nextDialogs": [
              "140160109"
            ]
          },
          "140160109": {
            "id": "140160109",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Hey, that's not the only reason I'm here! We mostly just needed a walk to clear our heads.",
            "nextDialogs": [
              "140160110"
            ]
          },
          "140160110": {
            "id": "140160110",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "There are few things more uplifting than taking the first step on a new journey.",
            "nextDialogs": [
              "140160111"
            ]
          },
          "140160111": {
            "id": "140160111",
            "speakerId": 13709,
            "speakerName": "Colter",
            "text": "Haha, Boss has got a point. Going on a trip with friends is always better than staying cooped up at home.",
            "nextDialogs": [
              "140160112"
            ]
          },
          "140160112": {
            "id": "140160112",
            "speakerId": 13772,
            "speakerName": "Ludivine",
            "text": "Very well... Please wait here while I retrieve the uniform for you.",
            "nextDialogs": [
              "140160113"
            ]
          },
          "140160113": {
            "id": "140160113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, can someone remind Paimon again why Adele wants to join the Spina?",
            "nextDialogs": [
              "140160114"
            ]
          },
          "140160114": {
            "id": "140160114",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Hehe, she hasn't given me any concrete reasons. All she says is that she really looks up to me.",
            "nextDialogs": [
              "140160115"
            ]
          },
          "140160115": {
            "id": "140160115",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "After we cleared her father's name, she became a lot more cheerful and outgoing. It's probably because she now knows for sure that her father was never a bad person.",
            "nextDialogs": [
              "140160116"
            ]
          },
          "140160116": {
            "id": "140160116",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "She said she used to be terrified of Papa, so as a result, she found all the rest of the Spina super scary as well.",
            "nextDialogs": [
              "140160117"
            ]
          },
          "140160117": {
            "id": "140160117",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "But the Spina is very different now. She mustered up the courage to talk to me, and felt like I could really understand her.",
            "nextDialogs": [
              "140160118"
            ]
          },
          "140160118": {
            "id": "140160118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The two of you have contended with similar circumstances.",
            "nextDialogs": [
              "140160119"
            ]
          },
          "140160119": {
            "id": "140160119",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Yeah, you could say that. By uncovering the truth about the case, I was able to give her closure at the same time.",
            "nextDialogs": [
              "140160120"
            ]
          },
          "140160120": {
            "id": "140160120",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "She said that she wanted to become someone like me — someone who could lend a hand to others, instead of standing still and waiting for others to help her.",
            "nextDialogs": [
              "140160121"
            ]
          },
          "140160121": {
            "id": "140160121",
            "speakerId": 13709,
            "speakerName": "Colter",
            "text": "From the sound of it, she'll be a wonderful addition to the Spina.",
            "nextDialogs": [
              "140160122"
            ]
          },
          "140160122": {
            "id": "140160122",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "I think so too, but for now, let's focus on giving her a great atmosphere to grow and thrive. She can commit to us once she's older, and can really make that decision for herself.",
            "nextDialogs": [
              "140160123"
            ]
          },
          "140160123": {
            "id": "140160123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(So I wasn't just hearing things.)",
            "nextDialogs": [
              "140160124"
            ]
          },
          "140160124": {
            "id": "140160124",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is something up, Traveler?",
            "nextDialogs": [
              "140160127"
            ]
          },
          "140160127": {
            "id": "140160127",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? T—Tailing? Paimon's coming!",
            "nextDialogs": [
              "140160128"
            ]
          },
          "140160128": {
            "id": "140160128",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "I'll go check it out too! Colter, please hold on to this for me!",
            "nextDialogs": [
              "140160129"
            ]
          },
          "140160129": {
            "id": "140160129",
            "speakerId": 13709,
            "speakerName": "Colter",
            "text": "A—Alright!"
          }
        }
      }
    },
    {
      "subId": "1401602",
      "subQuestName": "Catch up with the people following you",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140160201"
        ],
        "dialogs": {
          "140160201": {
            "id": "140160201",
            "speakerId": 13710,
            "speakerName": "Martinat",
            "text": "Tch. We knew you were going to be difficult.",
            "nextDialogs": [
              "140160202"
            ]
          },
          "140160202": {
            "id": "140160202",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Huh. Seems like if we want them to talk, we're gonna need to teach them a lesson first.",
            "nextDialogs": [
              "140160203"
            ]
          },
          "140160203": {
            "id": "140160203",
            "speakerId": 13710,
            "speakerName": "Martinat",
            "text": "Brothers, there's no need to skulk in the dark anymore! Let's take them out!"
          }
        }
      }
    },
    {
      "subId": "1401603",
      "subQuestName": "Defeat your pursuers",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1401604",
      "subQuestName": "Talk to Martinat and the others",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140160401"
        ],
        "dialogs": {
          "140160401": {
            "id": "140160401",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Now talk. Who are you, and why were you tailing us?",
            "nextDialogs": [
              "140160402"
            ]
          },
          "140160402": {
            "id": "140160402",
            "speakerId": 13710,
            "speakerName": "Martinat",
            "text": "...",
            "nextDialogs": [
              "140160403"
            ]
          },
          "140160403": {
            "id": "140160403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Don't think we'll let you off easy if you keep silent!",
            "nextDialogs": [
              "140160406"
            ]
          },
          "140160406": {
            "id": "140160406",
            "speakerId": 13710,
            "speakerName": "Martinat",
            "text": "...!",
            "nextDialogs": [
              "140160407"
            ]
          },
          "140160407": {
            "id": "140160407",
            "speakerId": 13709,
            "speakerName": "Colter",
            "text": "How did it go, Boss? Are any of you hurt?",
            "nextDialogs": [
              "140160408"
            ]
          },
          "140160408": {
            "id": "140160408",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Heh, if you thought they stood any chance against us, you were sorely mistaken.",
            "nextDialogs": [
              "140160409"
            ]
          },
          "140160409": {
            "id": "140160409",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Anyway, stop playing tough and start talking. There won't be any room for negotiation once the Maison Gardiennage gets involved.",
            "nextDialogs": [
              "140160410"
            ]
          },
          "140160410": {
            "id": "140160410",
            "speakerId": 13710,
            "speakerName": "Martinat",
            "text": "We... were looking to get vengeance on Spina di Rosula.",
            "nextDialogs": [
              "140160411"
            ]
          },
          "140160411": {
            "id": "140160411",
            "speakerId": 13710,
            "speakerName": "Martinat",
            "text": "We were discovered, and can't beat you in a fight... We admit it, we lost.",
            "nextDialogs": [
              "140160412"
            ]
          },
          "140160412": {
            "id": "140160412",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Get revenge? Wait... You're not Romeuf's followers, are you?",
            "nextDialogs": [
              "140160413"
            ]
          },
          "140160413": {
            "id": "140160413",
            "speakerId": 13710,
            "speakerName": "Martinat",
            "text": "You actually know that name...?",
            "nextDialogs": [
              "140160414"
            ]
          },
          "140160414": {
            "id": "140160414",
            "speakerId": 13710,
            "speakerName": "Martinat",
            "text": "But if you do, then surely, you should understand why we hate you so much!",
            "nextDialogs": [
              "140160415"
            ]
          },
          "140160415": {
            "id": "140160415",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I would advise you to calm down.",
            "nextDialogs": [
              "140160416"
            ]
          },
          "140160416": {
            "id": "140160416",
            "speakerId": 13709,
            "speakerName": "Colter",
            "text": "Indeed. You haven't got the faintest hope of winning right now.",
            "nextDialogs": [
              "140160417"
            ]
          },
          "140160417": {
            "id": "140160417",
            "speakerId": 13710,
            "speakerName": "Martinat",
            "text": "Tch...",
            "nextDialogs": [
              "140160418"
            ]
          },
          "140160418": {
            "id": "140160418",
            "speakerId": 13710,
            "speakerName": "Martinat",
            "text": "We were out drinking when we saw Navia. We got so angry, we decided to follow you guys and look for an opportunity to really mess up your day.",
            "nextDialogs": [
              "140160419"
            ]
          },
          "140160419": {
            "id": "140160419",
            "speakerId": 13710,
            "speakerName": "Martinat",
            "text": "Too bad you guys messed up ours first.",
            "nextDialogs": [
              "140160420"
            ]
          },
          "140160420": {
            "id": "140160420",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're lying.",
            "nextDialogs": [
              "140160421"
            ]
          },
          "140160421": {
            "id": "140160421",
            "speakerId": 13710,
            "speakerName": "Martinat",
            "text": "Huh...?"
          }
        }
      }
    },
    {
      "subId": "1401605",
      "subQuestName": "Go to the Fleuve Cendre",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140160501"
        ],
        "dialogs": {
          "140160501": {
            "id": "140160501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Coming back here, it really does feel like this place is starting to grow on Paimon.",
            "nextDialogs": [
              "140160502"
            ]
          },
          "140160502": {
            "id": "140160502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "If you think about it, it would be kind of weird if the Spina's base at the Court was some super luxurious building like the Palais Mermonia.",
            "nextDialogs": [
              "140160503"
            ]
          },
          "140160503": {
            "id": "140160503",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Hahaha, totally! Right on the money, Paimon.",
            "nextDialogs": [
              "140160504"
            ]
          },
          "140160504": {
            "id": "140160504",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Although of course, with the continued growth of the Spina, Papa wanted Poisson to eventually grow into a metropolis not unlike the Court.",
            "nextDialogs": [
              "140160505"
            ]
          },
          "140160505": {
            "id": "140160505",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "He was a very ambitious man who rarely looked behind or beneath him. For better or worse, that always made him stand out from the crowd.",
            "nextDialogs": [
              "140160506"
            ]
          },
          "140160506": {
            "id": "140160506",
            "speakerId": 13709,
            "speakerName": "Colter",
            "text": "And that's also why people hated him just as much as they loved him.",
            "nextDialogs": [
              "140160507"
            ]
          },
          "140160507": {
            "id": "140160507",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Alright, why don't you wait for me at the restaurant? I'll go do some prep, and I'll get someone to tidy up your room while I'm at it.",
            "nextDialogs": [
              "140160508"
            ]
          },
          "140160508": {
            "id": "140160508",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "You can use the same room as last time. You still remember the room number, yeah?",
            "nextDialogs": [
              "140160509"
            ]
          },
          "140160509": {
            "id": "140160509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yep yep! Kinda hard to forget when there are only so many rooms here after all.",
            "nextDialogs": [
              "140160510"
            ]
          },
          "140160510": {
            "id": "140160510",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Oho, did I just hear someone taking a dig at Fleuve Cendre? I'll tell my guys to stuff your pillows full of actual seaweed right now!",
            "nextDialogs": [
              "140160511"
            ]
          },
          "140160511": {
            "id": "140160511",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's sorry! Please have mercy, Navia! If you do that, then Paimon really won't be able to sleep at all!",
            "nextDialogs": [
              "140160512"
            ]
          },
          "140160512": {
            "id": "140160512",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Hahaha, I was just kidding. Be on your way, now."
          }
        }
      }
    },
    {
      "subId": "1401609",
      "subQuestName": "Sit inside and wait for the banquet to begin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1401606",
      "subQuestName": "Take part in the banquet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140160601"
        ],
        "dialogs": {
          "140160601": {
            "id": "140160601",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "You enjoy a fantastic meal as well as a wonderful performance. The boisterous night begins to slip away before you know it.",
            "nextDialogs": [
              "140160602"
            ]
          },
          "140160602": {
            "id": "140160602",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "As things slowly die down, you return to your room with Paimon, but you soon hear a knock at the door...",
            "nextDialogs": [
              "140160603"
            ]
          },
          "140160603": {
            "id": "140160603",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Hello? Are you asleep yet?",
            "nextDialogs": [
              "140160606"
            ]
          },
          "140160606": {
            "id": "140160606",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "No, not at all. I just figured that since we don't get to enjoy nights like these very often, we should try to enjoy it to the fullest.",
            "nextDialogs": [
              "140160607"
            ]
          },
          "140160607": {
            "id": "140160607",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Wanna go fishing? I've got some rods and lures ready.",
            "nextDialogs": [
              "140160608"
            ]
          },
          "140160608": {
            "id": "140160608",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, so that's the \"prep\" you were talking about! Sure, we'll come!",
            "nextDialogs": [
              "140160609"
            ]
          },
          "140160609": {
            "id": "140160609",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Hehe, hopefully I didn't wake you or anything."
          }
        }
      }
    },
    {
      "subId": "1401607",
      "subQuestName": "Fish with Navia",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140160701"
        ],
        "dialogs": {
          "140160701": {
            "id": "140160701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How can you call this fishing when you're using a fully automatic rod!?",
            "nextDialogs": [
              "140160702"
            ]
          },
          "140160702": {
            "id": "140160702",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Hmm? What's the problem? Lots of people in Poisson use rods like these.",
            "nextDialogs": [
              "140160703"
            ]
          },
          "140160703": {
            "id": "140160703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But... But shouldn't fishing be all about... You know, attentively watching the float, and then excitedly reeling in the catch when you've finally hooked something?",
            "nextDialogs": [
              "140160704"
            ]
          },
          "140160704": {
            "id": "140160704",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "#Well, that's one way to enjoy fishing! What do you think, {NICKNAME}?",
            "nextDialogs": [
              "140160706",
              "140160708"
            ]
          },
          "140160706": {
            "id": "140160706",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Then let's try regular rods next time. We can have a real fishing competition!",
            "nextDialogs": [
              "140160709"
            ]
          },
          "140160709": {
            "id": "140160709",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Honestly, Paimon's mainly shocked at how much energy you still have at this hour. Usually, by this time of night, it's a struggle for Paimon to even keep her eyes open!",
            "nextDialogs": [
              "140160710"
            ]
          },
          "140160710": {
            "id": "140160710",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Eh, it might just be something that runs in my family.",
            "nextDialogs": [
              "140160711"
            ]
          },
          "140160711": {
            "id": "140160711",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's a thing?",
            "nextDialogs": [
              "140160712"
            ]
          },
          "140160712": {
            "id": "140160712",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Hehe, I'm sure you'd just get even sleepier if I delved more deeply into it. Anyway, I was just thinking about how grateful I am to my mother, as well as the rest of the Spina.",
            "nextDialogs": [
              "140160713"
            ]
          },
          "140160713": {
            "id": "140160713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Your mother?",
            "nextDialogs": [
              "140160714"
            ]
          },
          "140160714": {
            "id": "140160714",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "My father always had a lot of unrealistic expectations for me, but the more that he tried to get me to become like him, the less I wanted to listen to what he had to say.",
            "nextDialogs": [
              "140160715"
            ]
          },
          "140160715": {
            "id": "140160715",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "My mother never had those kinds of expectations, though. I've heard that she had only one wish for me, which was that I would have a happy and secure childhood.",
            "nextDialogs": [
              "140160716"
            ]
          },
          "140160716": {
            "id": "140160716",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "All the members of the Spina greatly respected her wish, so no matter what I did as a child, they were happy to humor me.",
            "nextDialogs": [
              "140160717"
            ]
          },
          "140160717": {
            "id": "140160717",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Can you imagine? Whenever my father wanted to scold me for something I'd done, everyone would form up into two rows, and just stand silently and listen to him rant. Melus and Silver were always there, too.",
            "nextDialogs": [
              "140160718"
            ]
          },
          "140160718": {
            "id": "140160718",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "No matter what Papa yelled, nobody else would say a word. Eventually, Papa must have recognized scolding me over trivial matters was pointless, because he eventually stopped getting on my case so often.",
            "nextDialogs": [
              "140160719"
            ]
          },
          "140160719": {
            "id": "140160719",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon would've never guessed...",
            "nextDialogs": [
              "140160720"
            ]
          },
          "140160720": {
            "id": "140160720",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Yeah... looking back on it now as an adult, I can hardly believe how patient and kind everyone was.",
            "nextDialogs": [
              "140160721"
            ]
          },
          "140160721": {
            "id": "140160721",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "When I was young, I often thought that I could do whatever I wanted, because there'd always be someone there to clean up after me.",
            "nextDialogs": [
              "140160722"
            ]
          },
          "140160722": {
            "id": "140160722",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "But once, I saw Melus come back wounded. He wouldn't tell me how he'd been injured, but I could tell that it had something to do with me.",
            "nextDialogs": [
              "140160723"
            ]
          },
          "140160723": {
            "id": "140160723",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "I learned then that there's always a cost to making a mistake. The more you care about those around you, the more you should care about doing the right thing to the best of your abilities.",
            "nextDialogs": [
              "140160724"
            ]
          },
          "140160724": {
            "id": "140160724",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Because if you do falter, there will inevitably come a time when you'll have to face the consequences. And when that time comes, those most precious to you really will throw themselves in front of you, and pay the price for your mistakes..."
          },
          "140160708": {
            "id": "140160708",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Haha, that's how I feel as well. To me, I'm happy as long as I catch some fish."
          }
        }
      }
    },
    {
      "subId": "1401608",
      "subQuestName": "Return to the Fleuve Cendre to rest",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140160801"
        ],
        "dialogs": {
          "140160801": {
            "id": "140160801",
            "speakerId": 13710,
            "speakerName": "Martinat",
            "text": "Stop wasting time. The Boss ain't gonna wait all day.",
            "nextDialogs": [
              "140160802"
            ]
          },
          "140160802": {
            "id": "140160802",
            "speakerId": 13710,
            "speakerName": "Martinat",
            "text": "We'll go ahead with the operation tomorrow. Do with that information as you wish.",
            "nextDialogs": [
              "140160803"
            ]
          },
          "140160803": {
            "id": "140160803",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Heh, well your rod was missing a part too, so... I guess that makes it fair.",
            "nextDialogs": [
              "140160804"
            ]
          },
          "140160804": {
            "id": "140160804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, if we're just talking about the number of missing parts, sure... *yawn* Ugh, never mind, Paimon really can't keep her eyes open anymore.",
            "nextDialogs": [
              "140160805"
            ]
          },
          "140160805": {
            "id": "140160805",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Hahaha, alright, go to bed! I had a great time today.",
            "nextDialogs": [
              "140160806"
            ]
          },
          "140160806": {
            "id": "140160806",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "See you tomorrow, Navia.",
            "nextDialogs": [
              "140160807"
            ]
          },
          "140160807": {
            "id": "140160807",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Mhm, see you tomorrow!",
            "nextDialogs": [
              "140160808"
            ]
          },
          "140160808": {
            "id": "140160808",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "So, how was last night? Did you get a good night's sleep?",
            "nextDialogs": [
              "140160809"
            ]
          },
          "140160809": {
            "id": "140160809",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon dreamt that she danced with the sea stars... So you could say it was stellar, get it?",
            "nextDialogs": [
              "140160810"
            ]
          },
          "140160810": {
            "id": "140160810",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "...",
            "nextDialogs": [
              "140160811"
            ]
          },
          "140160811": {
            "id": "140160811",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...And just where did you get that from...?",
            "nextDialogs": [
              "140160812"
            ]
          },
          "140160812": {
            "id": "140160812",
            "speakerId": 13709,
            "speakerName": "Colter",
            "text": "Haha, I didn't know you had such a great sense of humor.",
            "nextDialogs": [
              "140160813"
            ]
          },
          "140160813": {
            "id": "140160813",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "See, this guy gets it!",
            "nextDialogs": [
              "140160814"
            ]
          },
          "140160814": {
            "id": "140160814",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Anyway, let's head out. I'll arrange for a boat to take us back to Poisson. I'm sure Adele will be happy to see you two again.",
            "nextDialogs": [
              "140160815"
            ]
          },
          "140160815": {
            "id": "140160815",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon hopes she'll really appreciate your gift!",
            "nextDialogs": [
              "140160816"
            ]
          },
          "140160816": {
            "id": "140160816",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "I hope so too."
          }
        }
      }
    },
    {
      "subId": "1401699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140169901"
        ],
        "dialogs": {
          "140169901": {
            "id": "140169901",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "All set? Let's move out, then.",
            "nextDialogs": [
              "140169902"
            ]
          },
          "140169902": {
            "id": "140169902",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "I asked some old acquaintances in town to make Adele's uniform, so we should be able to pick it up right away.",
            "nextDialogs": [
              "140169903"
            ]
          },
          "140169903": {
            "id": "140169903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon saw them too! They headed up!",
            "nextDialogs": [
              "140169904"
            ]
          },
          "140169904": {
            "id": "140169904",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Stop right there!"
          }
        }
      }
    }
  ]
}
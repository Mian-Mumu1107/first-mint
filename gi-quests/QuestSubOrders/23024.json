    {
      "subId": "2302404",
      "subQuestName": "Talk to Vardan and Gurgen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230240401"
        ],
        "dialogs": {
          "230240401": {
            "id": "230240401",
            "speakerId": 1000,
            "speakerName": "Vardan",
            "text": "Traveler, you couldn't have come at a better time. The rose is finally in full bloom!",
            "nextDialogs": [
              "230240402"
            ]
          },
          "230240402": {
            "id": "230240402",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "Thanks to you, it is the best growing rose I've ever seen.",
            "nextDialogs": [
              "230240403"
            ]
          },
          "230240403": {
            "id": "230240403",
            "speakerId": 1000,
            "speakerName": "Vardan",
            "text": "Thank you so much. Please accept these as a token of my thanks.",
            "nextDialogs": [
              "230240404"
            ]
          },
          "230240404": {
            "id": "230240404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Congratulations!",
            "nextDialogs": [
              "230240405"
            ]
          },
          "230240405": {
            "id": "230240405",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hehe, we're really happy that the rose bloomed, too!",
            "nextDialogs": [
              "230240406"
            ]
          },
          "230240406": {
            "id": "230240406",
            "speakerId": 1000,
            "speakerName": "Vardan",
            "text": "Phew... We can finally deliver the roses to Bimarstan on time.",
            "nextDialogs": [
              "230240407"
            ]
          },
          "230240407": {
            "id": "230240407",
            "speakerId": 1000,
            "speakerName": "Vardan",
            "text": "I do hope that the roses will be of help to them..."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2302401",
      "subQuestName": "Talk to Vardan and Gurgen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230240101"
        ],
        "dialogs": {
          "230240101": {
            "id": "230240101",
            "speakerId": 1000,
            "speakerName": "Vardan",
            "text": "Ah, you're finally here.",
            "nextDialogs": [
              "230240102"
            ]
          },
          "230240102": {
            "id": "230240102",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "Perfect timing. We're all set!",
            "nextDialogs": [
              "230240103"
            ]
          },
          "230240103": {
            "id": "230240103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's got you so excited?",
            "nextDialogs": [
              "230240104"
            ]
          },
          "230240104": {
            "id": "230240104",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Could it be that the roses are about to bloom?",
            "nextDialogs": [
              "230240105"
            ]
          },
          "230240105": {
            "id": "230240105",
            "speakerId": 1000,
            "speakerName": "Vardan",
            "text": "Yes, hahaha! We couldn't have done this without you, Traveler.",
            "nextDialogs": [
              "230240106"
            ]
          },
          "230240106": {
            "id": "230240106",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "The rose hasn't reached full bloom yet, but you can see its extraordinary vitality from its appearance!",
            "nextDialogs": [
              "230240107"
            ]
          },
          "230240107": {
            "id": "230240107",
            "speakerId": 1000,
            "speakerName": "Vardan",
            "text": "If you're interested, Traveler, come observe more closely.",
            "nextDialogs": [
              "230240108"
            ]
          },
          "230240108": {
            "id": "230240108",
            "speakerId": 1000,
            "speakerName": "Vardan",
            "text": "It might just bloom right before your eyes, you know?",
            "nextDialogs": [
              "230240109"
            ]
          },
          "230240109": {
            "id": "230240109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, I wouldn't miss that for the world...",
            "nextDialogs": [
              "230240110"
            ]
          },
          "230240110": {
            "id": "230240110",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "R—Really? Right now?",
            "nextDialogs": [
              "230240111"
            ]
          },
          "230240111": {
            "id": "230240111",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hehe, Paimon's getting excited too!"
          }
        }
      }
    },
    {
      "subId": "2302402",
      "subQuestName": "Talk to Vardan and Gurgen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230240201"
        ],
        "dialogs": {
          "230240201": {
            "id": "230240201",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "Come, come, lean closer so you can see all the details clearly.",
            "nextDialogs": [
              "230240202"
            ]
          },
          "230240202": {
            "id": "230240202",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You observe the rose bud with the herb growers...",
            "nextDialogs": [
              "230240203"
            ]
          },
          "230240203": {
            "id": "230240203",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Nothing's happening...",
            "nextDialogs": [
              "230240206"
            ]
          },
          "230240206": {
            "id": "230240206",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "Oh well... Maybe it was just feeling shy in front of you...",
            "nextDialogs": [
              "230240207"
            ]
          },
          "230240207": {
            "id": "230240207",
            "speakerId": 1000,
            "speakerName": "Vardan",
            "text": "But no worries. According to what we know of the rose's life cycle, you should see it blooming by tomorrow at the latest.",
            "nextDialogs": [
              "230240208"
            ]
          },
          "230240208": {
            "id": "230240208",
            "speakerId": 1000,
            "speakerName": "Vardan",
            "text": "Well then, please visit again tomorrow, Traveler!"
          }
        }
      }
    },

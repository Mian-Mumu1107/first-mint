        "dialogs": {
          "230240701": {
            "id": "230240701",
            "speakerId": 1000,
            "speakerName": "Vardan",
            "text": "Traveler, you couldn't have come at a better time. The rose is finally in full bloom!",
            "nextDialogs": [
              "230240702"
            ]
          },
          "230240702": {
            "id": "230240702",
            "speakerId": 1000,
            "speakerName": "Vardan",
            "text": "Thanks to you, it is the best growing rose I've ever seen.",
            "nextDialogs": [
              "230240703"
            ]
          },
          "230240703": {
            "id": "230240703",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "The doctors at Bimarstan will be amazed, too!",
            "nextDialogs": [
              "230240704"
            ]
          },
          "230240704": {
            "id": "230240704",
            "speakerId": 1000,
            "speakerName": "Vardan",
            "text": "No time better than now. Let me move this flower...",
            "nextDialogs": [
              "230240705"
            ]
          },
          "230240705": {
            "id": "230240705",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "Wait, what was that sound?",
            "nextDialogs": [
              "230240706"
            ]
          },
          "230240706": {
            "id": "230240706",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Something is stirring in the field...",
            "nextDialogs": [
              "230240707"
            ]
          },
          "230240707": {
            "id": "230240707",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Whoa! A Whopperflower! Why is it even here!?",
            "nextDialogs": [
              "230240708"
            ]
          },
          "230240708": {
            "id": "230240708",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "Oh no! The field! It's ruining the field!",
            "nextDialogs": [
              "230240711"
            ]
          },
          "230240711": {
            "id": "230240711",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Eh? The Whopperflower fled...?",
            "nextDialogs": [
              "230240712"
            ]
          },
          "230240712": {
            "id": "230240712",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "How... How could this be!?",
            "nextDialogs": [
              "230240713"
            ]
          },
          "230240713": {
            "id": "230240713",
            "speakerId": 1001,
            "speakerName": "Gurgen",
            "text": "One of our roses, the most important of our herbs, turned into a monster and ran away!"
          }
        }
      }
    },

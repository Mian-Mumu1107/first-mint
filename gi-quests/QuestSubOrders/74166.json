{
  "lineCounts": {
    "Black Screen": 1,
    "Guard": 4,
    "Paimon": 15,
    "Player": 2,
    "Strange Person": 32
  },
  "subQuests": [
    {
      "subId": "7416602",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741660201"
        ],
        "dialogs": {
          "741660201": {
            "id": "741660201",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "#Excuse me, young {M#lad}{F#lass} over there, yes, yes, you! You there, come, come on over!",
            "nextDialogs": [
              "741660202"
            ]
          },
          "741660202": {
            "id": "741660202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Are you talking to us?",
            "nextDialogs": [
              "741660203"
            ]
          },
          "741660203": {
            "id": "741660203",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Oh, my friends, I immediately saw you are new here. You must not yet be very familiar with the Fortress of Meropide, then?",
            "nextDialogs": [
              "741660204"
            ]
          },
          "741660204": {
            "id": "741660204",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Congratulations on running into me today! I am the single nicest resident of the entire Fortress.",
            "nextDialogs": [
              "741660205"
            ]
          },
          "741660205": {
            "id": "741660205",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Today, allow me to help you familiarize yourself with the Fortress. Of course, it will all be \"free.\"",
            "nextDialogs": [
              "741660206"
            ]
          },
          "741660206": {
            "id": "741660206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Actually, I already know the place quite well.",
            "nextDialogs": [
              "741660207"
            ]
          },
          "741660207": {
            "id": "741660207",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Oh, don't say that!",
            "nextDialogs": [
              "741660208"
            ]
          },
          "741660208": {
            "id": "741660208",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Perhaps you think you've got your bearings, but under my guidance, I believe you'll discover all kinds of things you never noticed.",
            "nextDialogs": [
              "741660209"
            ]
          },
          "741660209": {
            "id": "741660209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's such a thing as a free lunch?",
            "nextDialogs": [
              "741660210"
            ]
          },
          "741660210": {
            "id": "741660210",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Of course, of course! Like I said, I'm the kindest resident of the entire Fortress.",
            "nextDialogs": [
              "741660211"
            ]
          },
          "741660211": {
            "id": "741660211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, this guy's kind of weird. We've only just met and he's all buddy-buddy!",
            "nextDialogs": [
              "741660212"
            ]
          },
          "741660212": {
            "id": "741660212",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Haha, my friend, think nothing of it! How about this, you two discuss it amongst yourselves first, and I'll wait over here to hear your decision.",
            "nextDialogs": [
              "741660213"
            ]
          },
          "741660213": {
            "id": "741660213",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Once you've made up your minds, come find me."
          }
        }
      }
    },
    {
      "subId": "7416603",
      "subQuestName": "Accept the strange person's invitation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741660301"
        ],
        "dialogs": {
          "741660301": {
            "id": "741660301",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "How about it? Have you come to a consensus?",
            "nextDialogs": [
              "741660302"
            ]
          },
          "741660302": {
            "id": "741660302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You said it yourself, it must be absolutely free!",
            "nextDialogs": [
              "741660303"
            ]
          },
          "741660303": {
            "id": "741660303",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Of course, of course, it will be totally \"free.\"",
            "nextDialogs": [
              "741660304"
            ]
          },
          "741660304": {
            "id": "741660304",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Come come come, now I will show you about the Fortress of Meropide!"
          }
        }
      }
    },
    {
      "subId": "7416604",
      "subQuestName": "Tour the Coupon Cafeteria",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741660401"
        ],
        "dialogs": {
          "741660401": {
            "id": "741660401",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "This is the Coupon Cafeteria, and each person may claim one free Welfare Meal here each day.",
            "nextDialogs": [
              "741660402"
            ]
          },
          "741660402": {
            "id": "741660402",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "The only problem is that what you get to eat is completely up to fate.",
            "nextDialogs": [
              "741660403"
            ]
          },
          "741660403": {
            "id": "741660403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, is that all? This is just stuff anyone learns on their first day!",
            "nextDialogs": [
              "741660404"
            ]
          },
          "741660404": {
            "id": "741660404",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Calm down, calm down, I have some secret information as well. They say there is a secret codeword you can say to Bran when claiming your Welfare Meal, which will allow you to obtain the legendary mystery meal!",
            "nextDialogs": [
              "741660405"
            ]
          },
          "741660405": {
            "id": "741660405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, really? What codeword?",
            "nextDialogs": [
              "741660406"
            ]
          },
          "741660406": {
            "id": "741660406",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Unfortunately, I do not know. Regarding the codeword, I await the day you discover it for yourselves.",
            "nextDialogs": [
              "741660407"
            ]
          },
          "741660407": {
            "id": "741660407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's totally Paimon's line!",
            "nextDialogs": [
              "741660408"
            ]
          },
          "741660408": {
            "id": "741660408",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Do not worry about such trivial details! Our next stop, the Tri-Coupon Troupe!"
          }
        }
      }
    },
    {
      "subId": "7416605",
      "subQuestName": "Tour the Tri-Coupon Troupe",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741660501"
        ],
        "dialogs": {
          "741660501": {
            "id": "741660501",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "This is the location of the Tri-Coupon Troupe.",
            "nextDialogs": [
              "741660502"
            ]
          },
          "741660502": {
            "id": "741660502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Is that the entire intro?",
            "nextDialogs": [
              "741660503"
            ]
          },
          "741660503": {
            "id": "741660503",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Didn't you manage to associate that with anything? Where there is a troupe, there is drama! Where there is drama, there is romance! Where there is romance, there is love!",
            "nextDialogs": [
              "741660504"
            ]
          },
          "741660504": {
            "id": "741660504",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "They say that as long as you come here and watch their performances every day, you will find your true love.",
            "nextDialogs": [
              "741660505"
            ]
          },
          "741660505": {
            "id": "741660505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are there really rumors like that? Then shouldn't everyone be gathered here every day?",
            "nextDialogs": [
              "741660506"
            ]
          },
          "741660506": {
            "id": "741660506",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "That is so, but for it to come true, you cannot be a prisoner or a guard of the Fortress of Meropide.",
            "nextDialogs": [
              "741660507"
            ]
          },
          "741660507": {
            "id": "741660507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So nobody can ever meet their true love!",
            "nextDialogs": [
              "741660508"
            ]
          },
          "741660508": {
            "id": "741660508",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Perhaps that is the crux of the problem. Regardless, let us head to our next destination first."
          }
        }
      }
    },
    {
      "subId": "7416606",
      "subQuestName": "Tour the lift",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741660601"
        ],
        "dialogs": {
          "741660601": {
            "id": "741660601",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "This is... the lift to the production zone.",
            "nextDialogs": [
              "741660602"
            ]
          },
          "741660602": {
            "id": "741660602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This place doesn't have strange rumors too, does it?",
            "nextDialogs": [
              "741660603"
            ]
          },
          "741660603": {
            "id": "741660603",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "No, that is does not. It's just that I really hate this place.",
            "nextDialogs": [
              "741660604"
            ]
          },
          "741660604": {
            "id": "741660604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh? Why's that?",
            "nextDialogs": [
              "741660605"
            ]
          },
          "741660605": {
            "id": "741660605",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Because...",
            "nextDialogs": [
              "741660606"
            ]
          },
          "741660606": {
            "id": "741660606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Because...?",
            "nextDialogs": [
              "741660607"
            ]
          },
          "741660607": {
            "id": "741660607",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Because I don't wanna work!",
            "nextDialogs": [
              "741660608"
            ]
          },
          "741660608": {
            "id": "741660608",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "I'm only here because I didn't wanna work, so I stole a loaf of bread to feed myself because I was so hungry, and was sentenced as a result.",
            "nextDialogs": [
              "741660609"
            ]
          },
          "741660609": {
            "id": "741660609",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "So why, why do you still have to work in the Fortress of Meropide!?",
            "nextDialogs": [
              "741660610"
            ]
          },
          "741660610": {
            "id": "741660610",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "\"Any little bit of work will knock me out!\" That's my life's motto.",
            "nextDialogs": [
              "741660611"
            ]
          },
          "741660611": {
            "id": "741660611",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Gah! It feels like he's getting all weird just being here, let's get out of here and go to the next place."
          }
        }
      }
    },
    {
      "subId": "7416607",
      "subQuestName": "Tour the Pankration Ring",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741660701"
        ],
        "dialogs": {
          "741660701": {
            "id": "741660701",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Okay, friends! We're finally at my favorite facility: The Pankration Ring! This place is our paradise!",
            "nextDialogs": [
              "741660702"
            ]
          },
          "741660702": {
            "id": "741660702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This place... Is it really that great? That feels way different from what Paimon's heard...",
            "nextDialogs": [
              "741660703"
            ]
          },
          "741660703": {
            "id": "741660703",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Of course, but don't listen to those outside rumors. That's just an image intended to fool others. Come, come, come, I have a consent form over here, if you just sign it...",
            "nextDialogs": [
              "741660704"
            ]
          },
          "741660704": {
            "id": "741660704",
            "speakerId": 12657,
            "speakerName": "Guard",
            "text": "Hey! It's you again! Tricking people into signing consent forms to register for the competition again, are we? You won't escape this time!",
            "nextDialogs": [
              "741660705"
            ]
          },
          "741660705": {
            "id": "741660705",
            "speakerId": 12657,
            "speakerName": "Guard",
            "text": "You two are quite lucky that I noticed just before you were going to sign those forms!",
            "nextDialogs": [
              "741660706"
            ]
          },
          "741660706": {
            "id": "741660706",
            "speakerId": 12657,
            "speakerName": "Guard",
            "text": "In any case, ignore this fraud. He and the organization behind him specialize in tricking unsuspecting people into dangerous competitions, and they earn a profit from it.",
            "nextDialogs": [
              "741660707"
            ]
          },
          "741660707": {
            "id": "741660707",
            "speakerId": 13791,
            "speakerName": "Strange Person",
            "text": "Don't make up things like that! I haven't tricked anyone! They're all my friends, and they're just signing up willingly after I recommending it to them as a friend!",
            "nextDialogs": [
              "741660708"
            ]
          },
          "741660708": {
            "id": "741660708",
            "speakerId": 12657,
            "speakerName": "Guard",
            "text": "Right, I'm sure. I know a better place for you to spout your nonsense. With me, now!",
            "nextDialogs": [
              "741660709"
            ]
          },
          "741660709": {
            "id": "741660709",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "The strange person was escorted away by the guard...",
            "nextDialogs": [
              "741660710"
            ]
          },
          "741660710": {
            "id": "741660710",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Phew... There's no such thing as a free lunch after all!"
          }
        }
      }
    }
  ]
}
    {
      "subId": "800703",
      "subQuestName": "Talk to Dainsleif",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80070301"
        ],
        "dialogs": {
          "80070301": {
            "id": "80070301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What do we do now? The Abyss Lector's gone, but the device won't stop...",
            "nextDialogs": [
              "80070302"
            ]
          },
          "80070302": {
            "id": "80070302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And Halfdan...",
            "nextDialogs": [
              "80070305"
            ]
          },
          "80070305": {
            "id": "80070305",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "No! As long as the device is active, the cursed are rendered powerless. Only you can take on the Abyss.",
            "nextDialogs": [
              "80070306"
            ]
          },
          "80070306": {
            "id": "80070306",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "If you value his sacrifice, then do not waste any more time here.",
            "nextDialogs": [
              "80070307"
            ]
          },
          "80070307": {
            "id": "80070307",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "See all these rays of light and portals? They must have installed several of these energy devices in various locations. Find them! Quickly!",
            "nextDialogs": [
              "80070308"
            ]
          },
          "80070308": {
            "id": "80070308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So we have to... go through these Abyss portals? ...Hey, wait for Paimon!"
          }
        }
      }
    },

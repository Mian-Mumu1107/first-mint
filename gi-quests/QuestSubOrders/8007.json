  "subQuests": [
    {
      "subId": "800701",
      "subQuestName": "Check the situation at the chamber at the center of the ruins' summit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80070101"
        ],
        "dialogs": {
          "80070101": {
            "id": "80070101",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "I thought he would've been turned to ashes in an instant... Halfdan's soul is extraordinarily resilient.",
            "nextDialogs": [
              "80070102"
            ]
          },
          "80070102": {
            "id": "80070102",
            "speakerId": 12425,
            "speakerName": "Abyss Lector",
            "text": "Meddling fool! Encumber us no more...",
            "nextDialogs": [
              "80070103"
            ]
          },
          "80070103": {
            "id": "80070103",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "Don't you have a greater encumbrance to worry about? Come on, this is your grand opportunity to get rid of me.",
            "nextDialogs": [
              "80070104"
            ]
          },
          "80070104": {
            "id": "80070104",
            "speakerId": 12425,
            "speakerName": "Abyss Lector",
            "text": "...Dainsleif!!!",
            "nextDialogs": [
              "80070105"
            ]
          },
          "80070105": {
            "id": "80070105",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "Take him out, and deactivate the device!"
          }
        }
      }
    },

    {
      "subId": "2230705",
      "subQuestName": "Talk to Bolai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223070601"
        ],
        "dialogs": {
          "223070601": {
            "id": "223070601",
            "speakerId": 2013,
            "speakerName": "Bolai",
            "text": "You're back! Found the treasure?",
            "nextDialogs": [
              "223070602"
            ]
          },
          "223070602": {
            "id": "223070602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes.",
            "nextDialogs": [
              "223070603"
            ]
          },
          "223070603": {
            "id": "223070603",
            "speakerId": 2013,
            "speakerName": "Bolai",
            "text": "Nice one! I said you looked like a real adventurer, didn't I? Well, now you've proven it.",
            "nextDialogs": [
              "223070604"
            ]
          },
          "223070604": {
            "id": "223070604",
            "speakerId": 2013,
            "speakerName": "Bolai",
            "text": "Right, let's see what we have in this box... Hmph. What a pile of junk...",
            "nextDialogs": [
              "223070605"
            ]
          },
          "223070605": {
            "id": "223070605",
            "speakerId": 2013,
            "speakerName": "Bolai",
            "text": "Well, can't blame you for trying! Here's your share, I'll hold on to Zhang Shun's share until he comes to collect it.",
            "nextDialogs": [
              "223070606"
            ]
          },
          "223070606": {
            "id": "223070606",
            "speakerId": 2013,
            "speakerName": "Bolai",
            "text": "*sigh* Still didn't find it... That guy is taking me for a ride, I swear..."
          }
        }
      }
    },
    {
      "subId": "2230705",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223070501"
        ],
        "dialogs": {
          "223070501": {
            "id": "223070501",
            "speakerId": 2033,
            "speakerName": "Zhang Shun",
            "text": "If it wasn't for my injury... I could be out there chasing down even bigger treasure hoards with the captain and my old crew mates...",
            "nextDialogs": [
              "223070502"
            ]
          },
          "223070502": {
            "id": "223070502",
            "speakerId": 2033,
            "speakerName": "Zhang Shun",
            "text": "*sigh* What I would give to be back on board that ship just one more time..."
          }
        }
      }
    },
    {
      "subId": "2230707",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223070701"
        ],
        "dialogs": {
          "223070701": {
            "id": "223070701",
            "speakerId": 2013,
            "speakerName": "Bolai",
            "text": "Are you sure? I would have thought it'd be a useful nugget of information..."
          }
        }
      }
    },
    {
      "subId": "2230709",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223070901"
        ],
        "dialogs": {
          "223070901": {
            "id": "223070901",
            "speakerId": 2013,
            "speakerName": "Bolai",
            "text": "You're back! Found the treasure?",
            "nextDialogs": [
              "223070902"
            ]
          },
          "223070902": {
            "id": "223070902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes.",
            "nextDialogs": [
              "223070903"
            ]
          },
          "223070903": {
            "id": "223070903",
            "speakerId": 2013,
            "speakerName": "Bolai",
            "text": "Nice one! I said you looked like a real adventurer, didn't I? Well, now you've proven it.",
            "nextDialogs": [
              "223070904"
            ]
          },
          "223070904": {
            "id": "223070904",
            "speakerId": 2013,
            "speakerName": "Bolai",
            "text": "Right, let's see what we have in this box... What's this? Map fragments?",
            "nextDialogs": [
              "223070905"
            ]
          },
          "223070905": {
            "id": "223070905",
            "speakerId": 2013,
            "speakerName": "Bolai",
            "text": "Huh, so he was right. Those batty old Treasure Maps really do have clues to where the treasure lies...",
            "nextDialogs": [
              "223070906"
            ]
          },
          "223070906": {
            "id": "223070906",
            "speakerId": 2013,
            "speakerName": "Bolai",
            "text": "Oh? You're still here? Here, take your share... and hurry along now, you must have other things to do. I'll hold Zhang Shun's share till he comes to collect it."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7108301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710830101"
        ],
        "dialogs": {
          "710830101": {
            "id": "710830101",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "What? You seriously broke the Seven-Star Array? Ugh, looks like I'll have to write this into the weekly report...",
            "nextDialogs": [
              "710830102"
            ]
          },
          "710830102": {
            "id": "710830102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Make sure you make it sound cool, alright?",
            "nextDialogs": [
              "710830103"
            ]
          },
          "710830103": {
            "id": "710830103",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "*cough* Please, this is a very serious situation. It's so serious, in fact, that the Qixing themselves will decide its exact seriousness.",
            "nextDialogs": [
              "710830104"
            ]
          },
          "710830104": {
            "id": "710830104",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "Which is to say that once report gets sent up, someone from the Qixing might personally come down here to stop you.",
            "nextDialogs": [
              "710830105"
            ]
          },
          "710830105": {
            "id": "710830105",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "Even I won't be able to save you then.",
            "nextDialogs": [
              "710830106"
            ]
          },
          "710830106": {
            "id": "710830106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(This guy is way too obvious with his hints...)",
            "nextDialogs": [
              "710830107"
            ]
          },
          "710830107": {
            "id": "710830107",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "Scared, huh? Alright, move along, then! There's still someone waiting for you, you know?"
          }
        }
      }
    },
    {
      "subId": "7108302",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710830201"
        ],
        "dialogs": {
          "710830201": {
            "id": "710830201",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "How is everything down there? Did you encounter any danger?",
            "nextDialogs": [
              "710830203",
              "710830211"
            ]
          },
          "710830203": {
            "id": "710830203",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "Ah, I see. That does sound rather dangerous. I'm afraid I'll have to ask you to help take care of Jinwu and Zhiqiong, then.",
            "nextDialogs": [
              "710830204"
            ]
          },
          "710830204": {
            "id": "710830204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Aren't you supposed to stop me?",
            "nextDialogs": [
              "710830205"
            ]
          },
          "710830205": {
            "id": "710830205",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "Well, that is my duty, yes. But you always run off too quickly for me to stop you, so I can't.",
            "nextDialogs": [
              "710830206"
            ]
          },
          "710830206": {
            "id": "710830206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't run that fast.",
            "nextDialogs": [
              "710830207"
            ]
          },
          "710830207": {
            "id": "710830207",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "No, you do. That's what the report says, and what the report says is the truth.",
            "nextDialogs": [
              "710830208"
            ]
          },
          "710830208": {
            "id": "710830208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright, guess I'm really, really fast, then.",
            "nextDialogs": [
              "710830209"
            ]
          },
          "710830209": {
            "id": "710830209",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "Exactly. As such, please do be careful."
          },
          "710830211": {
            "id": "710830211",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "That's good, that's good. As long as things go well, the Qixing will have no reason to come down too hard on me..."
          }
        }
      }
    }
  ]
}
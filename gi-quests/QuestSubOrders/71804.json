  "subQuests": [
    {
      "subId": "7180402",
      "subQuestName": "Copy down the bulletin concerning business permits",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718040201"
        ],
        "dialogs": {
          "718040201": {
            "id": "718040201",
            "speakerId": 20135,
            "speakerName": "Bulletin Board",
            "text": "This is the Feiyun Slope Bulletin Board. You can find community news and shop advertisements posted here. Please do not post unimportant matters.",
            "nextDialogs": [
              "718040203",
              "718040206",
              "718040209"
            ]
          },
          "718040203": {
            "id": "718040203",
            "speakerId": 20135,
            "speakerName": "Bulletin Board",
            "text": "\"The Ministry of Civil Affair's personnel transfers are as follows...\"",
            "nextDialogs": [
              "718040204"
            ]
          },
          "718040204": {
            "id": "718040204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hang on a minute. That's got nothing to do with business permits, does it?"
          },
          "718040206": {
            "id": "718040206",
            "speakerId": 20135,
            "speakerName": "Bulletin Board",
            "text": "\"Regarding the recent contamination of Feiyun Slope's water supply...\"",
            "nextDialogs": [
              "718040207"
            ]
          },
          "718040207": {
            "id": "718040207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Come on, Ivanovich has things to do. We don't have time to be worried about this right now."
          },
          "718040209": {
            "id": "718040209",
            "speakerId": 20135,
            "speakerName": "Bulletin Board",
            "text": "\"If you should wish to apply for a new business permit, you are required to undertake the following procedures...\"",
            "nextDialogs": [
              "718040210"
            ]
          },
          "718040210": {
            "id": "718040210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This should be the new business permit that Ivanovich wants to apply for. Let's copy the procedures down."
          }
        }
      }
    },
    {
      "subId": "7180403",
      "subQuestName": "Talk to Ivanovich",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718040301"
        ],
        "dialogs": {
          "718040301": {
            "id": "718040301",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "So, did you find the bulletin concerning the permit?",
            "nextDialogs": [
              "718040302"
            ]
          },
          "718040302": {
            "id": "718040302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I've copied it down.",
            "nextDialogs": [
              "718040303"
            ]
          },
          "718040303": {
            "id": "718040303",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "Wonderful! Let me have a closer look...",
            "nextDialogs": [
              "718040304"
            ]
          },
          "718040304": {
            "id": "718040304",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "Exit permit, business premises and safety certificates, and an old business permit...",
            "nextDialogs": [
              "718040305"
            ]
          },
          "718040305": {
            "id": "718040305",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "That's fine, that's fine. I got those documents signed a few days ago, and that was an endurance run and a half.",
            "nextDialogs": [
              "718040306"
            ]
          },
          "718040306": {
            "id": "718040306",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "Traveler, could you help me submit each of these documents in their turn as well?",
            "nextDialogs": [
              "718040307"
            ]
          },
          "718040307": {
            "id": "718040307",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "That said... *cough* there might be a lot of people looking to submit theirs as well.",
            "nextDialogs": [
              "718040308"
            ]
          },
          "718040308": {
            "id": "718040308",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "The <color=#00E1FFFF>exit permit</color> must go to Nervous An first. Then, the <color=#00E1FFFF>business premises and safety certificates</color> have to be handed in to a Millelith soldier named Jiayi...",
            "nextDialogs": [
              "718040309"
            ]
          },
          "718040309": {
            "id": "718040309",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "Finally, the <color=#00E1FFFF>old business permit</color> needs to be given to Clerk Zhao.",
            "nextDialogs": [
              "718040310"
            ]
          },
          "718040310": {
            "id": "718040310",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "Please help me hand these in, Traveler. I will be sure to arrange adequate compensation for you.",
            "nextDialogs": [
              "718040311"
            ]
          },
          "718040311": {
            "id": "718040311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure, sure.",
            "nextDialogs": [
              "718040312"
            ]
          },
          "718040312": {
            "id": "718040312",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "I really hope this is the end of all these procedures...",
            "nextDialogs": [
              "718040313"
            ]
          },
          "718040313": {
            "id": "718040313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Same here.",
            "nextDialogs": [
              "718040314"
            ]
          },
          "718040314": {
            "id": "718040314",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "Well, you probably won't ever have to do so again, but as for me... I'll have to do it again at some point if I want to do business here.",
            "nextDialogs": [
              "718040315"
            ]
          },
          "718040315": {
            "id": "718040315",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "*sigh* These methods do provide a certain sense of security, yes, but I do wish they could be further simplified."
          }
        }
      }
    },
    {
      "subId": "7180404",
      "subQuestName": "Give the appropriate documents to Nervous An",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718040401"
        ],
        "dialogs": {
          "718040401": {
            "id": "718040401",
            "speakerId": 2012,
            "speakerName": "Nervous An",
            "text": "The paperwork for these procedures is incomplete again...",
            "nextDialogs": [
              "718040402"
            ]
          },
          "718040402": {
            "id": "718040402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ivanovich is looking to get a new business permit...",
            "nextDialogs": [
              "718040403"
            ]
          },
          "718040403": {
            "id": "718040403",
            "speakerId": 2012,
            "speakerName": "Nervous An",
            "text": "Ivanovich? Oh, yes, I remember him. He's been here a few times.",
            "nextDialogs": [
              "718040404"
            ]
          },
          "718040404": {
            "id": "718040404",
            "speakerId": 2012,
            "speakerName": "Nervous An",
            "text": "Applying for a new business permit, is he? Haha... he must be terribly busy right now, then.",
            "nextDialogs": [
              "718040405"
            ]
          },
          "718040405": {
            "id": "718040405",
            "speakerId": 2012,
            "speakerName": "Nervous An",
            "text": "You're here to help him out, I presume. Have you brought his <color=#00E1FFFF>exit permit</color> with you? I do remember telling him before that his paperwork wasn't complete, and that he needed to get it filled in elsewhere..."
          }
        }
      }
    },
    {
      "subId": "7180447",
      "subQuestName": "Give the appropriate documents to Nervous An",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718044701"
        ],
        "dialogs": {
          "718044701": {
            "id": "718044701",
            "speakerId": 2012,
            "speakerName": "Nervous An",
            "text": "Let me see... No, this isn't correct. I only handle exit permits here. I'm not in charge of any other documents."
          }
        }
      }
    },
    {
      "subId": "7180444",
      "subQuestName": "Give the appropriate documents to Nervous An",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718044401"
        ],
        "dialogs": {
          "718044401": {
            "id": "718044401",
            "speakerId": 2012,
            "speakerName": "Nervous An",
            "text": "Let me see... No, this isn't correct. I only handle exit permits here. I'm not in charge of any other documents."
          }
        }
      }
    },
    {
      "subId": "7180434",
      "subQuestName": "Give the appropriate documents to Nervous An",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718043401"
        ],
        "dialogs": {
          "718043401": {
            "id": "718043401",
            "speakerId": 2012,
            "speakerName": "Nervous An",
            "text": "Let me see... Yes, this will do. I'll take this document with me, then."
          }
        }
      }
    },
    {
      "subId": "7180405",
      "subQuestName": "Give the appropriate documents to Jiayi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718040501"
        ],
        "dialogs": {
          "718040501": {
            "id": "718040501",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "Orderly lines please, orderly lines!",
            "nextDialogs": [
              "718040503",
              "718040505"
            ]
          },
          "718040503": {
            "id": "718040503",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "Oh? You're here as his representative? I see. May I have your business premises certificate and... Uh, what was it again? Right — a business safety certificate. Do you have them both with you?"
          },
          "718040505": {
            "id": "718040505",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "No, no, I'm ad-hoc help, just like you. Clerk Zhao has her hands full at the moment, so I've been called in to help collect and file those certificates.",
            "nextDialogs": [
              "718040506"
            ]
          },
          "718040506": {
            "id": "718040506",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "*sigh* It's really tiring work... So, have you brought both your business premises certificate and business safety certificate?"
          }
        }
      }
    },
    {
      "subId": "7180445",
      "subQuestName": "Give the appropriate documents to Jiayi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718044501"
        ],
        "dialogs": {
          "718044501": {
            "id": "718044501",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "Um, this is the wrong one. I'm only supposed to take business premises and safety certificates."
          }
        }
      }
    },
    {
      "subId": "7180435",
      "subQuestName": "Give the appropriate documents to Jiayi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718043501"
        ],
        "dialogs": {
          "718043501": {
            "id": "718043501",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "Looks good. I'll file these documents away and pass them to Clerk Zhao later."
          }
        }
      }
    },
    {
      "subId": "7180446",
      "subQuestName": "Please approach Clerk Zhao about official business during daytime work hours",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7180406",
      "subQuestName": "Give the appropriate documents to Clerk Zhao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718040601"
        ],
        "dialogs": {
          "718040601": {
            "id": "718040601",
            "speakerId": 2085,
            "speakerName": "Clerk Zhao",
            "text": "Hello. Anything to submit? Any questions?",
            "nextDialogs": [
              "718040602"
            ]
          },
          "718040602": {
            "id": "718040602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ivanovich is looking to get a new business permit...",
            "nextDialogs": [
              "718040603"
            ]
          },
          "718040603": {
            "id": "718040603",
            "speakerId": 2085,
            "speakerName": "Clerk Zhao",
            "text": "You're his representative? Alright. His <color=#00E1FFFF>old business permit</color>, please.",
            "nextDialogs": [
              "718040604"
            ]
          },
          "718040604": {
            "id": "718040604",
            "speakerId": 2085,
            "speakerName": "Clerk Zhao",
            "text": "If you have it, submit it. I'll need it if you want a new one."
          }
        }
      }
    },
    {
      "subId": "7180436",
      "subQuestName": "Give the appropriate documents to Clerk Zhao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718043601"
        ],
        "dialogs": {
          "718043601": {
            "id": "718043601",
            "speakerId": 2085,
            "speakerName": "Clerk Zhao",
            "text": "Mm. Good, I'll take this.",
            "nextDialogs": [
              "718043602"
            ]
          },
          "718043602": {
            "id": "718043602",
            "speakerId": 2085,
            "speakerName": "Clerk Zhao",
            "text": "Have you submitted the other documents? You'll have to make another trip in a few days if you haven't.",
            "nextDialogs": [
              "718043603"
            ]
          },
          "718043603": {
            "id": "718043603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I have.",
            "nextDialogs": [
              "718043604"
            ]
          },
          "718043604": {
            "id": "718043604",
            "speakerId": 2085,
            "speakerName": "Clerk Zhao",
            "text": "Good. If everything checks out, the new permit should arrive soon.",
            "nextDialogs": [
              "718043605"
            ]
          },
          "718043605": {
            "id": "718043605",
            "speakerId": 2085,
            "speakerName": "Clerk Zhao",
            "text": "I'll get someone to contact Ivanovich then."
          }
        }
      }
    },
    {
      "subId": "7180407",
      "subQuestName": "Report back to Ivanovich",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718040701"
        ],
        "dialogs": {
          "718040701": {
            "id": "718040701",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "Have you submitted all the documents yet?",
            "nextDialogs": [
              "718040702"
            ]
          },
          "718040702": {
            "id": "718040702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They've been submitted.",
            "nextDialogs": [
              "718040703"
            ]
          },
          "718040703": {
            "id": "718040703",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "Phew, that's wonderful. As long as I get a new business permit, I can continue doing business here.",
            "nextDialogs": [
              "718040704"
            ]
          },
          "718040704": {
            "id": "718040704",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "Thank you so much for making the trip on my behalf. Here, take this as compensation, just as we agreed.",
            "nextDialogs": [
              "718040705"
            ]
          },
          "718040705": {
            "id": "718040705",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "I really hope that I won't ever have to work through so many procedures again... So tiring..."
          }
        }
      }
    },
    {
      "subId": "7180451",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718045101"
        ],
        "dialogs": {
          "718045101": {
            "id": "718045101",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "I can finally rest for a while. Any more of this and I would have collapsed for sure...",
            "nextDialogs": [
              "718045103",
              "718045107"
            ]
          },
          "718045103": {
            "id": "718045103",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "Haha. Well, this is Liyue Harbor, after all. Contracts are of utmost importance.",
            "nextDialogs": [
              "718045104"
            ]
          },
          "718045104": {
            "id": "718045104",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "Don't we all feel safer when all things big and small are written down in black and white?",
            "nextDialogs": [
              "718045105"
            ]
          },
          "718045105": {
            "id": "718045105",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "Well, I say that, but this really is too much. I'm getting dizzy already..."
          },
          "718045107": {
            "id": "718045107",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "You mean in the way we do things? Well, not exactly...",
            "nextDialogs": [
              "718045108"
            ]
          },
          "718045108": {
            "id": "718045108",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "But if you want specifics, I could probably go on and on.",
            "nextDialogs": [
              "718045109"
            ]
          },
          "718045109": {
            "id": "718045109",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "You'll see what I mean, though, if you ever get the opportunity to set foot in Snezhnaya."
          }
        }
      }
    },
    {
      "subId": "7180453",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718045301"
        ],
        "dialogs": {
          "718045301": {
            "id": "718045301",
            "speakerId": 2072,
            "speakerName": "Ivanovich",
            "text": "*sigh* These methods do provide a certain sense of security, yes, but I do wish they could be further simplified."
          }
        }
      }
    },
    {
      "subId": "7180454",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718045401"
        ],
        "dialogs": {
          "718045401": {
            "id": "718045401",
            "speakerId": 2012,
            "speakerName": "Nervous An",
            "text": "This one lacks a stamp, this one lacks proof, and that one's missing some information...",
            "nextDialogs": [
              "718045402"
            ]
          },
          "718045402": {
            "id": "718045402",
            "speakerId": 2012,
            "speakerName": "Nervous An",
            "text": "*sigh* These have to be sent back again..."
          }
        }
      }
    },
    {
      "subId": "7180455",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718045501"
        ],
        "dialogs": {
          "718045501": {
            "id": "718045501",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "So much material, so many files. Whatever will I do if I mix any of them up?"
          }
        }
      }
    },
    {
      "subId": "7180456",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718045601"
        ],
        "dialogs": {
          "718045601": {
            "id": "718045601",
            "speakerId": 2085,
            "speakerName": "Clerk Zhao",
            "text": "These procedures look complete..."
          }
        }
      }
    }
  ]
}
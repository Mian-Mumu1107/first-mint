  },
  "subQuests": [
    {
      "subId": "7212910",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721330101"
        ],
        "dialogs": {
          "721330101": {
            "id": "721330101",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Hello! Excuse me, outlander. Could you hear me out?",
            "nextDialogs": [
              "721330102"
            ]
          },
          "721330102": {
            "id": "721330102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's up?",
            "nextDialogs": [
              "721330103"
            ]
          },
          "721330103": {
            "id": "721330103",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Please don't linger on this island for too long. Recently, the Tatarigami's reach has spread wider and wider.",
            "nextDialogs": [
              "721330104"
            ]
          },
          "721330104": {
            "id": "721330104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Tatarigami\"?",
            "nextDialogs": [
              "721330105"
            ]
          },
          "721330105": {
            "id": "721330105",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Yes, since the people from Sangonomiya destroyed the ward that suppressed the soul of the serpent god, the Tatarigami has spread across the island...",
            "nextDialogs": [
              "721330106"
            ]
          },
          "721330106": {
            "id": "721330106",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "As you can see, the sky is now perpetually clouded and the rain won't stop. This is all because of the Tatarigami.",
            "nextDialogs": [
              "721330107"
            ]
          },
          "721330107": {
            "id": "721330107",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Recently, one by one all the miners have fallen ill, gone insane, or fled to other islands...",
            "nextDialogs": [
              "721330108"
            ]
          },
          "721330108": {
            "id": "721330108",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Everyone's gone. There's hardly anyone living on this island anymore.",
            "nextDialogs": [
              "721330109"
            ]
          },
          "721330109": {
            "id": "721330109",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Ironically, due to the chaos created by the Tatarigami, the Shogunate and the rebels have not been fighting over this place quite as hard.",
            "nextDialogs": [
              "721330110"
            ]
          },
          "721330110": {
            "id": "721330110",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Hmph! But if they had not destroyed our great Ogosho's ward, the island wouldn't have become such a mess in the first place!",
            "nextDialogs": [
              "721330111"
            ]
          },
          "721330111": {
            "id": "721330111",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "What do the Commissions or dragons or serpents have to do with me, huh? They never asked my opinion before starting their cursed war!",
            "nextDialogs": [
              "721330112"
            ]
          },
          "721330112": {
            "id": "721330112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Then why are you still here?",
            "nextDialogs": [
              "721330113"
            ]
          },
          "721330113": {
            "id": "721330113",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Why? Because this is my home.",
            "nextDialogs": [
              "721330114"
            ]
          },
          "721330114": {
            "id": "721330114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What about your family?",
            "nextDialogs": [
              "721330115"
            ]
          },
          "721330115": {
            "id": "721330115",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "They are in a safe place, but thanks for your concern. They must be waiting for me to bring them back here.",
            "nextDialogs": [
              "721330116"
            ]
          },
          "721330116": {
            "id": "721330116",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "No one on the island left voluntarily. We are a family here. Anywhere else we go, we'll have to work for someone else.",
            "nextDialogs": [
              "721330117"
            ]
          },
          "721330117": {
            "id": "721330117",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "But someone had to stay and clean up the mess so that everyone else can return home eventually.",
            "nextDialogs": [
              "721330118"
            ]
          },
          "721330118": {
            "id": "721330118",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "*sigh* This is such a headache...",
            "nextDialogs": [
              "721330119"
            ]
          },
          "721330119": {
            "id": "721330119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is there anything I can help with?",
            "nextDialogs": [
              "721330120"
            ]
          },
          "721330120": {
            "id": "721330120",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "If it were any other child offering to help me out of the blue, I'd be laughing out loud right now...",
            "nextDialogs": [
              "721330121"
            ]
          },
          "721330121": {
            "id": "721330121",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "But seeing as you're a traveler from afar who has managed to venture this deep into Inazuma, you must certainly be able to hold your own.",
            "nextDialogs": [
              "721330122"
            ]
          },
          "721330122": {
            "id": "721330122",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "I'll get straight to the point, then. The ward over there has been bothering me for a long time, maybe you could find a way to repair it?",
            "nextDialogs": [
              "721330123"
            ]
          },
          "721330123": {
            "id": "721330123",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "I'm sure that this awful weather can only be due to the wards' destruction.",
            "nextDialogs": [
              "721330124"
            ]
          },
          "721330124": {
            "id": "721330124",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "But please, be careful when you approach the ward. If you stare at it, it will release a burst of energy towards you...",
            "nextDialogs": [
              "721330125"
            ]
          },
          "721330125": {
            "id": "721330125",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "It's harmless, but very uncomfortable. It feels like it's... rejecting you.",
            "nextDialogs": [
              "721330126"
            ]
          },
          "721330126": {
            "id": "721330126",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "I think the ward is missing some components. It can probably be fixed by putting the missing parts back.",
            "nextDialogs": [
              "721330127"
            ]
          },
          "721330127": {
            "id": "721330127",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Of course, that's just speculation on my part. I still can't say for sure what's gone wrong.",
            "nextDialogs": [
              "721330128"
            ]
          },
          "721330128": {
            "id": "721330128",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "So, if you want to help, please help me fix this ward.",
            "nextDialogs": [
              "721330129"
            ]
          },
          "721330129": {
            "id": "721330129",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "But if you can't manage it, then like I was saying — don't stick around here too long."
          }
        }
      }
    },
    {
      "subId": "7212905",
      "subQuestName": "Observe the ward",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721290201"
        ],
        "dialogs": {
          "721290201": {
            "id": "721290201",
            "speakerId": 20234,
            "speakerName": "Touch Ward",
            "text": "You gaze at the ward, and suddenly, a strange energy flows towards you.",
            "nextDialogs": [
              "721290202"
            ]
          },
          "721290202": {
            "id": "721290202",
            "speakerId": 20234,
            "speakerName": "Touch Ward",
            "text": "You realize that it is not resisting you, but is asking you for something...",
            "nextDialogs": [
              "721290203"
            ]
          },
          "721290203": {
            "id": "721290203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Something seems to be missing from this ward. Best to look around the area for the missing parts.",
            "nextDialogs": [
              "721290204"
            ]
          },
          "721290204": {
            "id": "721290204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Use your Elemental Sight to scan for scattered traces of elements nearby. Maybe you'll find something!"
          }
        }
      }
    },
    {
      "subId": "7212906",
      "subQuestName": "Search for the missing part to repair the ward",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721290601"
        ],
        "dialogs": {
          "721290601": {
            "id": "721290601",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "How're things going? Have you finished repairing the wards already?",
            "nextDialogs": [
              "721290604",
              "721290605"
            ]
          },
          "721290604": {
            "id": "721290604",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "It's fine. Take your time."
          },
          "721290605": {
            "id": "721290605",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "And if you don't manage it, just leave it. The most important thing is that you shouldn't stay in this place too long — it's dangerous."
          }
        }
      }
    },
    {
      "subId": "7212911",
      "subQuestName": "Go back and talk to Kaji",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721290401"
        ],
        "dialogs": {
          "721290401": {
            "id": "721290401",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Not bad, outlander! The clouds are almost gone. It seems as though my guess was right.",
            "nextDialogs": [
              "721290402"
            ]
          },
          "721290402": {
            "id": "721290402",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Next, the two wards at the Serpent's Head and Jakotsu Mine still need to be repaired.",
            "nextDialogs": [
              "721290403"
            ]
          },
          "721290403": {
            "id": "721290403",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "If you don't mind, I'll leave those two wards to you, too.",
            "nextDialogs": [
              "721290404"
            ]
          },
          "721290404": {
            "id": "721290404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You got it!",
            "nextDialogs": [
              "721290405"
            ]
          },
          "721290405": {
            "id": "721290405",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "Thank you very much for your help. Although I am by no means a man of wealth, I promise that you will be paid fairly.",
            "nextDialogs": [
              "721290406"
            ]
          },
          "721290406": {
            "id": "721290406",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "I still don't know when it'll happen, but it seems that the time for my reunion with family and friends is drawing a little closer...",
            "nextDialogs": [
              "721290407"
            ]
          },
          "721290407": {
            "id": "721290407",
            "speakerId": 20248,
            "speakerName": "Kaji",
            "text": "By the way, you can find me on the west side of the island once you're done. Fort Mumei came under rebel assault previously, and I suspect that the attack is related to these changes."
          }
        }
      }
    },
    {
      "subId": "7212901",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721290101"
        ],
        "dialogs": {
          "721290101": {
            "id": "721290101",
            "speakerId": 12179,
            "speakerName": "Observe",
            "text": "The strangely-shaped stone lantern seems to be emitting an ominous energy.",
            "nextDialogs": [
              "721290102"
            ]
          },
          "721290102": {
            "id": "721290102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This stone lantern is so strange... It's so creepy.",
            "nextDialogs": [
              "721290103"
            ]
          },
          "721290103": {
            "id": "721290103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, what's that written on the light post?",
            "nextDialogs": [
              "721290104"
            ]
          },
          "721290104": {
            "id": "721290104",
            "speakerId": 12179,
            "speakerName": "Observe",
            "text": "\"Travelers passing through: if you have any questions about this ward, please go to the Musoujin Gorge and talk to Mr. Kaji about it.\"",
            "nextDialogs": [
              "721290105"
            ]
          },
          "721290105": {
            "id": "721290105",
            "speakerId": 12179,
            "speakerName": "Observe",
            "text": "The handwriting looks very recent, and there are a few lines of smaller handwriting below, which have been eroded by the rain:",
            "nextDialogs": [
              "721290106"
            ]
          },
          "721290106": {
            "id": "721290106",
            "speakerId": 12179,
            "speakerName": "Observe",
            "text": "\"Please tell Mr. Kaji we've tried... But unfortunately... Maybe he can find it somewhere nearby...\"",
            "nextDialogs": [
              "721290107"
            ]
          },
          "721290107": {
            "id": "721290107",
            "speakerId": 12179,
            "speakerName": "Observe",
            "text": "\"Please tell Mr. Kaji to come to the refuge as soon as possible. He's dearly missed by his family.\"",
            "nextDialogs": [
              "721290108"
            ]
          },
          "721290108": {
            "id": "721290108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This Mr. Kaji seems to be pretty concerned about these stone lanterns. Why don't we go to Musoujin Gorge and ask him?"
          }
        }
      }
    },
    {
      "subId": "7212903",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721290301"
        ],
        "dialogs": {
          "721290301": {
            "id": "721290301",
            "speakerId": 20234,
            "speakerName": "Touch Ward",
            "text": "The lantern has finally been repaired. The weather seems to have changed as well."
          }
        }
      }
    },
    {
      "subId": "7212905",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721290501"
        ],
        "dialogs": {
          "721290501": {
            "id": "721290501",
            "speakerId": 13913,
            "speakerName": "Place",
            "text": "It seems that two critical components are missing from the ward.",
            "nextDialogs": [
              "721290502"
            ]
          },
          "721290502": {
            "id": "721290502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Submit Item"
          }
        }
      }
    }
  ]
}
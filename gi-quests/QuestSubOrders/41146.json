      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411460401"
        ],
        "dialogs": {
          "411460401": {
            "id": "411460401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'd love to, but I have to get going.",
            "nextDialogs": [
              "411460402"
            ]
          },
          "411460402": {
            "id": "411460402",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Eh? But... Oh, alright, I'll get someone else to do it..."
          }
        }
      }
    },
    {
      "subId": "4114601",
      "subQuestName": "Talk to Sara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411460101"
        ],
        "dialogs": {
          "411460101": {
            "id": "411460101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll deliver it right now.",
            "nextDialogs": [
              "411460102"
            ]
          },
          "411460102": {
            "id": "411460102",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Thank you so much. It's much too far away, and we haven't the people to spare.",
            "nextDialogs": [
              "411460103"
            ]
          },
          "411460103": {
            "id": "411460103",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "Ah, yes, please be careful while you travel. <color=#00E1FFFF>Don't run too fast or use your wind glider. You definitely shouldn't climb either...</color>",
            "nextDialogs": [
              "411460104"
            ]
          },
          "411460104": {
            "id": "411460104",
            "speakerId": 1419,
            "speakerName": "Sara",
            "text": "If you takes too many bumps along the way, the meat sauce and spaghetti might come apart... and if that happens, I don't think the customer will accept it."
          }
        }
      }
    },
    {
      "subId": "4114602",
      "subQuestName": "Deliver the food to Slacking Angelo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411460201"
        ],
        "dialogs": {
          "411460201": {
            "id": "411460201",
            "speakerId": 1579,
            "speakerName": "Slacking Angelo",
            "text": "Sheesh, I wonder where my order's gone. And I'd gone through so much trouble to find a comfortable spot like this, too..."
          }
        }
      }
    },
    {
      "subId": "4114603",
      "subQuestName": "Speak to Slacking Angelo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411460601"
        ],
        "dialogs": {
          "411460601": {
            "id": "411460601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's the dish you ordered.",
            "nextDialogs": [
              "411460602"
            ]
          },
          "411460602": {
            "id": "411460602",
            "speakerId": 1579,
            "speakerName": "Slacking Angelo",
            "text": "Ah, you're finally here. If you'd taken any longer, I might have fallen asleep.",
            "nextDialogs": [
              "411460603"
            ]
          },
          "411460603": {
            "id": "411460603",
            "speakerId": 1579,
            "speakerName": "Slacking Angelo",
            "text": "Thank you, I'll just take this."
          }
        }
      }
    },
    {
      "subId": "4114603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411460301"
        ],
        "dialogs": {
          "411460301": {
            "id": "411460301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I heard that someone placed a custom order...",
            "nextDialogs": [
              "411460302"
            ]
          },
          "411460302": {
            "id": "411460302",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Right, I believe a certain... Angelo ordered — and paid for — a serving of our Flaming Red Bolognese.",
            "nextDialogs": [
              "411460303"
            ]
          },
          "411460303": {
            "id": "411460303",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "After that, he asked that we deliver it to him near Brightcrown Canyon. But that's some distance away, and I don't have anyone I can send there...",
            "nextDialogs": [
              "411460304"
            ]
          },
          "411460304": {
            "id": "411460304",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "If you're alright with it, could you help us deliver it to him?"
          }
        }
      }
    },
    {

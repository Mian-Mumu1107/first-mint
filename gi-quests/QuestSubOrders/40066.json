    {
      "subId": "4006614",
      "subQuestName": "Approach Kazuha",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400661401"
        ],
        "dialogs": {
          "400661401": {
            "id": "400661401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But... why can't he hear us?",
            "nextDialogs": [
              "400661402"
            ]
          },
          "400661402": {
            "id": "400661402",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Looks like it's just an illusion. This isn't the Kazuha who came here with us."
          }
        }

    {
      "subId": "4006611",
      "subQuestName": "Follow the path",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400661101"
        ],
        "dialogs": {
          "400661101": {
            "id": "400661101",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "I'm sorry, but I just don't understand!",
            "nextDialogs": [
              "400661102"
            ]
          },
          "400661102": {
            "id": "400661102",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "Kazuha, have you forgotten our promise?",
            "nextDialogs": [
              "400661103"
            ]
          },
          "400661103": {
            "id": "400661103",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "You really want to give it all up? But... but even if we're having a rough time, you still have me by your side! Can't I be of any help?",
            "nextDialogs": [
              "400661104"
            ]
          },
          "400661104": {
            "id": "400661104",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "When you were my age, you were already helping grandfather out! Am I so incompetent that I'm a disappointment to you? Or...",
            "nextDialogs": [
              "400661105"
            ]
          },
          "400661105": {
            "id": "400661105",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "Kazuha!",
            "nextDialogs": [
              "400661106"
            ]
          },
          "400661106": {
            "id": "400661106",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "*sigh* ...Now you're blaming yourself for all of this... That's why I have failed you as a father.",
            "nextDialogs": [
              "400661107"
            ]
          },
          "400661107": {
            "id": "400661107",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "The Kaedehara Clan has been paying the price for our past mistakes ever since your great-grandfather's generation. To this day, we have never fully recovered from it.",
            "nextDialogs": [
              "400661108"
            ]
          },
          "400661108": {
            "id": "400661108",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "Though we are a family of bladesmiths, you don't have to devote your life to the family craft.",
            "nextDialogs": [
              "400661109"
            ]
          },
          "400661109": {
            "id": "400661109",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "If a wounded animal wants to escape from a trap, it has to sacrifice the hind leg that was caught. You might think of this as a loss, but staying in the trap has far more deadly consequences.",
            "nextDialogs": [
              "400661110"
            ]
          },
          "400661110": {
            "id": "400661110",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "Enough now, Kazuha. As the head of the family, I failed to revitalize our clan. You never blamed me for not giving you the life promised to you by our heritage, and I'm grateful enough for that.",
            "nextDialogs": [
              "400661111"
            ]
          },
          "400661111": {
            "id": "400661111",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "All these generations of suffering... let's end them today. From now on, live your life with no burdens.",
            "nextDialogs": [
              "400661112"
            ]
          },
          "400661112": {
            "id": "400661112",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "Don't worry, I'll carry the blame for abandoning our family business.",
            "nextDialogs": [
              "400661113"
            ]
          },
          "400661113": {
            "id": "400661113",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "Father, please don't... You should not be to blame for not upholding our family name.",
            "nextDialogs": [
              "400661114"
            ]
          },
          "400661114": {
            "id": "400661114",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "Even if that day comes, let me share the burden with you.",
            "nextDialogs": [
              "400661115"
            ]
          },
          "400661115": {
            "id": "400661115",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "Let's just wait and see. Sooner or later, I will have to lead the Kaedehara Clan. When the time comes, I'll deal with all our problems."
          }
        }
      }
    },

    {
      "subId": "4006606",
      "subQuestName": "Follow the path",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400660601"
        ],
        "dialogs": {
          "400660601": {
            "id": "400660601",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "...This will do. Ah, Kazuha, you've come just at the right moment. What do you think of this rock carving?",
            "nextDialogs": [
              "400660602"
            ]
          },
          "400660602": {
            "id": "400660602",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "It's very intricate.",
            "nextDialogs": [
              "400660603"
            ]
          },
          "400660603": {
            "id": "400660603",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "I based it on a mountain scene I saw in a book. You know, there are nations in this world where the mountains reach all the way up into the clouds. If only I had the chance to see them with my own eyes...",
            "nextDialogs": [
              "400660604"
            ]
          },
          "400660604": {
            "id": "400660604",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "Father, you can go anywhere whenever you want.",
            "nextDialogs": [
              "400660605"
            ]
          },
          "400660605": {
            "id": "400660605",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "That's not true. Though the Kaedehara Clan is far from what it used to be, I still bear all the same responsibilities as the clan heads before me.",
            "nextDialogs": [
              "400660606"
            ]
          },
          "400660606": {
            "id": "400660606",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "But then again... continuing in the way of our forefathers, sacrificing everything for our declining clan... is it really worth it?",
            "nextDialogs": [
              "400660607"
            ]
          },
          "400660607": {
            "id": "400660607",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "But I... I don't understand.",
            "nextDialogs": [
              "400660608"
            ]
          },
          "400660608": {
            "id": "400660608",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "...Kazuha, there's one thing I want you to always remember.",
            "nextDialogs": [
              "400660609"
            ]
          },
          "400660609": {
            "id": "400660609",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "Family ties are important, but you ought to not let them hold you back.",
            "nextDialogs": [
              "400660610"
            ]
          },
          "400660610": {
            "id": "400660610",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "Family only exists because of the people in it. If we are unhappy, how can we hope to build a joyful one?",
            "nextDialogs": [
              "400660611"
            ]
          },
          "400660611": {
            "id": "400660611",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "The events of the past have had a profound impact on our family, but they are not your burden to carry.",
            "nextDialogs": [
              "400660612"
            ]
          },
          "400660612": {
            "id": "400660612",
            "speakerId": 1003,
            "speakerName": "Kaedehara Kageharu",
            "text": "...If you ever grow tired of this tedious life, just drop everything and go off on a journey, see the world. Remember, Kazuha, don't let yourself get tied down in life.",
            "nextDialogs": [
              "400660613"
            ]
          },
          "400660613": {
            "id": "400660613",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "Yes, father."
          }
        }
      }
    },

    {
      "subId": "4006617",
      "subQuestName": "Look for Kazuha",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400661701"
        ],
        "dialogs": {
          "400661701": {
            "id": "400661701",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Thought we might find you trapped here again.",
            "nextDialogs": [
              "400661702"
            ]
          },
          "400661702": {
            "id": "400661702",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "Haha, yeah, it seems those are the rules.",
            "nextDialogs": [
              "400661703"
            ]
          },
          "400661703": {
            "id": "400661703",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We entered that maze in the mirage again, but the scene was different this time.",
            "nextDialogs": [
              "400661704"
            ]
          },
          "400661704": {
            "id": "400661704",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "You tell Kazuha what you saw...",
            "nextDialogs": [
              "400661705"
            ]
          },
          "400661705": {
            "id": "400661705",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "The mood was more deflated, and the place more humbly furnished... yes, that makes sense.",
            "nextDialogs": [
              "400661706"
            ]
          },
          "400661706": {
            "id": "400661706",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "What you saw was the Kaedehara Clan in decline.",
            "nextDialogs": [
              "400661707"
            ]
          },
          "400661707": {
            "id": "400661707",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We saw you in the mirage too, but you looked a little different than now.",
            "nextDialogs": [
              "400661708"
            ]
          },
          "400661708": {
            "id": "400661708",
            "speakerId": 1006,
            "speakerName": "Fischl",
            "text": "Indeed, I most certainly agree.",
            "nextDialogs": [
              "400661709"
            ]
          },
          "400661709": {
            "id": "400661709",
            "speakerId": 1001,
            "speakerName": "Oz",
            "text": "Compared to the Lord Kazuha before us now, the mirage we saw appeared lost, with the burden of fate weighing heavily upon him.",
            "nextDialogs": [
              "400661710"
            ]
          },
          "400661710": {
            "id": "400661710",
            "speakerId": 1007,
            "speakerName": "Mona",
            "text": "I can confirm that. His fate was a heavy burden indeed.",
            "nextDialogs": [
              "400661711"
            ]
          },
          "400661711": {
            "id": "400661711",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "That means I am older and wiser now. I am sorry you had to see my less mature former self.",
            "nextDialogs": [
              "400661712"
            ]
          },
          "400661712": {
            "id": "400661712",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "For a long time after leaving Inazuma, I've lived the life of a drifter. But this is no bad thing, because I learned much from the experience.",
            "nextDialogs": [
              "400661713"
            ]
          },
          "400661713": {
            "id": "400661713",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "I wish that I could've met my past self, too. If he saw me, I know that he would understand:",
            "nextDialogs": [
              "400661714"
            ]
          },
          "400661714": {
            "id": "400661714",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "Life is a long journey, and that's why I must travel far and wide."
          }
        }
      }
    },
    {
      "subId": "4006618",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400661801"
        ],
        "dialogs": {
          "400661801": {
            "id": "400661801",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "Just as I thought, the bonsai is the key to entering the mirage.",
            "nextDialogs": [
              "400661802"
            ]
          },
          "400661802": {
            "id": "400661802",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "C'mon, let's continue looking for the rock garden."
          }
        }
      }
    }

  },
  "subQuests": [
    {
      "subId": "7111602",
      "subQuestName": "Talk to Iron Dou'er",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711160202"
        ],
        "dialogs": {
          "711160202": {
            "id": "711160202",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "We drink out of the same bottle, yeah? We don't say \"thanks\" for such big favors, you're ever in a jam, you just holler and it'll be done in a flash!",
            "nextDialogs": [
              "711160203"
            ]
          },
          "711160203": {
            "id": "711160203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, you're pretty polite!",
            "nextDialogs": [
              "711160205",
              "711160208"
            ]
          },
          "711160205": {
            "id": "711160205",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "You need Mora? Haha, well, funny thing is, there could be a little problem with that—",
            "nextDialogs": [
              "711160206"
            ]
          },
          "711160206": {
            "id": "711160206",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "Our Mora? The big cheese took it all. We been down on our uppers, flat broke here.",
            "nextDialogs": [
              "711160210"
            ]
          },
          "711160210": {
            "id": "711160210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Big Cheese?",
            "nextDialogs": [
              "711160211"
            ]
          },
          "711160211": {
            "id": "711160211",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "Our Boss, the leader of us Iron and Salt Gang. He's with a bunch of Fontainian cats down at the bottom of the cliff over there, left us behind to hold down the fort.",
            "nextDialogs": [
              "711160212"
            ]
          },
          "711160212": {
            "id": "711160212",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "But you saw what happened too, right? Those Fontainian frogs snuck in while the big shot was away and stabbed us in the butt, really put the screws to us!",
            "nextDialogs": [
              "711160213"
            ]
          },
          "711160213": {
            "id": "711160213",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eek... Stabbed you in the butt...!",
            "nextDialogs": [
              "711160214"
            ]
          },
          "711160214": {
            "id": "711160214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yikes...!",
            "nextDialogs": [
              "711160215"
            ]
          },
          "711160215": {
            "id": "711160215",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "Brat! Really trying to take us for a ride?",
            "nextDialogs": [
              "711160216"
            ]
          },
          "711160216": {
            "id": "711160216",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "Since they tipped their mitts and showed their mugs here, our Boss is probably gonna get double-crossed too. Whaddaya say, bo? In for a Mora, in for the lot, you wouldn't back out now, would ya?",
            "nextDialogs": [
              "711160217"
            ]
          },
          "711160217": {
            "id": "711160217",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "As long as Boss is safe, you're guaranteed the swankiest of meals, and can live the good life!",
            "nextDialogs": [
              "711160218"
            ]
          },
          "711160218": {
            "id": "711160218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Where is he? I'll go check it out.",
            "nextDialogs": [
              "711160219"
            ]
          },
          "711160219": {
            "id": "711160219",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "On that beach beneath the cliff. You'll see when you get there.",
            "nextDialogs": [
              "711160220"
            ]
          },
          "711160220": {
            "id": "711160220",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "I'll leave you to it, and be on over after I finish here."
          },
          "711160208": {
            "id": "711160208",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "Supremely honorable! Righteous beyond measure! In that case, I got something juicy to tell both of you.",
            "nextDialogs": [
              "711160209"
            ]
          },
          "711160209": {
            "id": "711160209",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "Our big cheese... He's probably in a jam himself, probably needs some help, yeah?"
          }
        }
      }
    },
    {
      "subId": "7111603",
      "subQuestName": "Go to the beach beneath the cliff",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7111604",
      "subQuestName": "Participate in negotiations between the two parties",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711160401"
        ],
        "dialogs": {
          "711160401": {
            "id": "711160401",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "We've been pals, Johnnie, so I get the pickle you've found yourself in lately.",
            "nextDialogs": [
              "711160402"
            ]
          },
          "711160402": {
            "id": "711160402",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "You could've just talked to me straight, but causing a mess like this... It's enough to break my heart.",
            "nextDialogs": [
              "711160403"
            ]
          },
          "711160403": {
            "id": "711160403",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "Well, pal, you know business as usual is no longer the usual over here. The Spina di Rosula's on the rise, and my brothers are a bit out of sorts...",
            "nextDialogs": [
              "711160404"
            ]
          },
          "711160404": {
            "id": "711160404",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "But I still got to look after all the birds in my crew. If this keeps up, they won't even get crumbs...",
            "nextDialogs": [
              "711160405"
            ]
          },
          "711160405": {
            "id": "711160405",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "We got good business going between us, it's pretty reasonable, but if you can give us more... I'm sure we all know I'll scratch your back in the future.",
            "nextDialogs": [
              "711160406"
            ]
          },
          "711160406": {
            "id": "711160406",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "If not... Haha, there are plenty of other fish in the sea, Iron Ming, it's not like you can't find new friends!",
            "nextDialogs": [
              "711160407"
            ]
          },
          "711160407": {
            "id": "711160407",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "So I take it that means this is your final offer, right, Johnnie?",
            "nextDialogs": [
              "711160408"
            ]
          },
          "711160408": {
            "id": "711160408",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "You got a problem with what I'm offering?",
            "nextDialogs": [
              "711160409"
            ]
          },
          "711160409": {
            "id": "711160409",
            "speakerId": 1004,
            "speakerName": "Iron Chuan'er",
            "text": "You kidding me, Mr. Fontainer? Just tell us what you're up to! Who are you trying to steal from with this little money? Stop shouting nonsense!",
            "nextDialogs": [
              "711160410"
            ]
          },
          "711160410": {
            "id": "711160410",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "Shut it!",
            "nextDialogs": [
              "711160411"
            ]
          },
          "711160411": {
            "id": "711160411",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "Listen, Johnnie, the Don Pesci family pays me 58 thou a box, and the De Niro 70 thou. I shouldn't have to tell you just how big they are in Lumidouce Harbor, yeah?",
            "nextDialogs": [
              "711160412"
            ]
          },
          "711160412": {
            "id": "711160412",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "But for you, I only asked for a hundred grand for three boxes, and even threw in special pick-up and delivery service on top... Now why do I do that? Because I cherish you as a friend.",
            "nextDialogs": [
              "711160413"
            ]
          },
          "711160413": {
            "id": "711160413",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "No need for me to harp on all that... I'm sure you just didn't think it through! Let's find a place to drink while we talk, eh?",
            "nextDialogs": [
              "711160414"
            ]
          },
          "711160414": {
            "id": "711160414",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "Hehe, I don't need all that. I know how you Liyue people get about contracts. Since the point of contracts is fairness, I don't think friendship supersedes that.",
            "nextDialogs": [
              "711160415"
            ]
          },
          "711160415": {
            "id": "711160415",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "Hehe, Brother Johnnie! Someone who understands the spirit of contracts so well... My men ought to learn from you, ha!",
            "nextDialogs": [
              "711160416"
            ]
          },
          "711160416": {
            "id": "711160416",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "It's just that... at least on this matter, I'd like to see you guys respect the contract more.",
            "nextDialogs": [
              "711160417"
            ]
          },
          "711160417": {
            "id": "711160417",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "Of course, of course! You're being more than reasonable, and the ancient Liyue tradition of upholding contracts is something we can all admire. I suppose I must find a way to prove my sincerity.",
            "nextDialogs": [
              "711160418"
            ]
          },
          "711160418": {
            "id": "711160418",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "Walker, you think we can raise our offer... say, one Mora per item?",
            "nextDialogs": [
              "711160419"
            ]
          },
          "711160419": {
            "id": "711160419",
            "speakerId": 1005,
            "speakerName": "Walker",
            "text": "That's very generous, Mr. Johnnie. These good people of Liyue have worked so hard for us, so we do owe them one extra Mora per item.",
            "nextDialogs": [
              "711160420"
            ]
          },
          "711160420": {
            "id": "711160420",
            "speakerId": 1004,
            "speakerName": "Iron Chuan'er",
            "text": "Fontainian frogs! Just what are you trying to pull here!?",
            "nextDialogs": [
              "711160421"
            ]
          },
          "711160421": {
            "id": "711160421",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "Come on, old pal, can't you just feel my sincerity radiating off of me from where you're standing?",
            "nextDialogs": [
              "711160422"
            ]
          },
          "711160422": {
            "id": "711160422",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "I take it you're gonna breach our agreement, then, Johnnie?",
            "nextDialogs": [
              "711160423"
            ]
          },
          "711160423": {
            "id": "711160423",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "Oh? Am I? What do you think, Walker?",
            "nextDialogs": [
              "711160424"
            ]
          },
          "711160424": {
            "id": "711160424",
            "speakerId": 1005,
            "speakerName": "Walker",
            "text": "Mr. Johnnie, there's plenty of other fish in the sea, if you ask me. Any minnow should know that.",
            "nextDialogs": [
              "711160425"
            ]
          },
          "711160425": {
            "id": "711160425",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "I'm ashamed of you, Walker. How could you insult our Liyue friend like that?",
            "nextDialogs": [
              "711160426"
            ]
          },
          "711160426": {
            "id": "711160426",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "I mean, we're going to take over their turf soon anyway, shouldn't we show a bit of gratitude?",
            "nextDialogs": [
              "711160427"
            ]
          },
          "711160427": {
            "id": "711160427",
            "speakerId": 1005,
            "speakerName": "Walker",
            "text": "Sorry, Mr. Johnnie.",
            "nextDialogs": [
              "711160428"
            ]
          },
          "711160428": {
            "id": "711160428",
            "speakerId": 1004,
            "speakerName": "Iron Chuan'er",
            "text": "You slippery bastards! The audacity to plan something like that...",
            "nextDialogs": [
              "711160429"
            ]
          },
          "711160429": {
            "id": "711160429",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Whoa, calm down with the insults! No need to be rude.",
            "nextDialogs": [
              "711160430"
            ]
          },
          "711160430": {
            "id": "711160430",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "Hey, who are the two youngsters...?",
            "nextDialogs": [
              "711160431"
            ]
          },
          "711160431": {
            "id": "711160431",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "Well, now this is interesting. Are all Liyue little children brave like them? Walker!",
            "nextDialogs": [
              "711160432"
            ]
          },
          "711160432": {
            "id": "711160432",
            "speakerId": 1005,
            "speakerName": "Walker",
            "text": "Hey, where did you snotty kids come from? Here's some Mora. Now scram, run on back to your mommies!",
            "nextDialogs": [
              "711160433"
            ]
          },
          "711160433": {
            "id": "711160433",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! Don't any of you have any manners?",
            "nextDialogs": [
              "711160434"
            ]
          },
          "711160434": {
            "id": "711160434",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "And who are you two...?",
            "nextDialogs": [
              "711160437"
            ]
          },
          "711160437": {
            "id": "711160437",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "Hahaha! From the sound of it... Looks like you're Mr. Iron Ming's rusted little help?",
            "nextDialogs": [
              "711160438"
            ]
          },
          "711160438": {
            "id": "711160438",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "So, you had the same idea too, eh, Mr. Iron Ming? Well, we didn't exactly come unprepared. Walker!",
            "nextDialogs": [
              "711160439"
            ]
          },
          "711160439": {
            "id": "711160439",
            "speakerId": 1005,
            "speakerName": "Walker",
            "text": "Come out, boys, it's time!",
            "nextDialogs": [
              "711160440"
            ]
          },
          "711160440": {
            "id": "711160440",
            "speakerId": 1004,
            "speakerName": "Iron Chuan'er",
            "text": "What!?",
            "nextDialogs": [
              "711160441"
            ]
          },
          "711160441": {
            "id": "711160441",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "Oh dearie me, guess what? I think we have more people on our side.",
            "nextDialogs": [
              "711160442"
            ]
          },
          "711160442": {
            "id": "711160442",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "I am so, so sorry, Mr. Iron Ming. Before our little meeting, I made prior arrangements to have the people guarding your camp taken care of.",
            "nextDialogs": [
              "711160443"
            ]
          },
          "711160443": {
            "id": "711160443",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "Now it's your turn. I'll make sure your business is in good hands.",
            "nextDialogs": [
              "711160444"
            ]
          },
          "711160444": {
            "id": "711160444",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "\"Boss\" Johnnie... If you wanna get a slant at our business, it won't be duck soup!",
            "nextDialogs": [
              "711160445"
            ]
          },
          "711160445": {
            "id": "711160445",
            "speakerId": 1003,
            "speakerName": "Johnnie",
            "text": "Well, I hope you can back up your tough talk. Get him!"
          }
        }
      }
    },
    {
      "subId": "7111605",
      "subQuestName": "Defeat Johnnie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7111606",
      "subQuestName": "Talk to Iron Ming",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711160601"
        ],
        "dialogs": {
          "711160601": {
            "id": "711160601",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "Two incredible heroes! I am in your debt!",
            "nextDialogs": [
              "711160602"
            ]
          },
          "711160602": {
            "id": "711160602",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's quite alright! No matter where you make a deal, you should always honor your contract!",
            "nextDialogs": [
              "711160603"
            ]
          },
          "711160603": {
            "id": "711160603",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "#Hehe, this little {M#hero}{F#heroine}'s got the picture! Still, you two seem wise to our deal. Why?",
            "nextDialogs": [
              "711160604"
            ]
          },
          "711160604": {
            "id": "711160604",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Iron Dou'er told us about it. She said you were bootlegging or somesuch...",
            "nextDialogs": [
              "711160605"
            ]
          },
          "711160605": {
            "id": "711160605",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But what does \"bootleg\" mean?",
            "nextDialogs": [
              "711160606"
            ]
          },
          "711160606": {
            "id": "711160606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Some sort of illegal transaction.",
            "nextDialogs": [
              "711160607"
            ]
          },
          "711160607": {
            "id": "711160607",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "In that case, I must repay you two chivalrous heroes.",
            "nextDialogs": [
              "711160608"
            ]
          },
          "711160608": {
            "id": "711160608",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "Boys! Come truss them up nice and tight and toss them into the sea!",
            "nextDialogs": [
              "711160609"
            ]
          },
          "711160609": {
            "id": "711160609",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "Be sure to tie a few extra rocks to them, too. They did us Iron and Salt Gang a big favor, so let's not make them suffer more than they should!",
            "nextDialogs": [
              "711160610"
            ]
          },
          "711160610": {
            "id": "711160610",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What!? You... You want to do WHAT to us!?",
            "nextDialogs": [
              "711160611"
            ]
          },
          "711160611": {
            "id": "711160611",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "My dear little hero, from what you just said, I would've thought you'd understand. Liyue is indeed a place very particular about contracts.",
            "nextDialogs": [
              "711160612"
            ]
          },
          "711160612": {
            "id": "711160612",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "And walking in on a transaction between outlaws means you get silenced. Surely that is an unspoken contract known to all?",
            "nextDialogs": [
              "711160613"
            ]
          },
          "711160613": {
            "id": "711160613",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "There's no such thing as that contract! Repaying our kindness with murder is the real breach of contract here!",
            "nextDialogs": [
              "711160614"
            ]
          },
          "711160614": {
            "id": "711160614",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "Please don't make this harder on yourselves. If I have to do it myself, you'll be in for a world of hurt.",
            "nextDialogs": [
              "711160617"
            ]
          },
          "711160617": {
            "id": "711160617",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "Shut up! Iron Dou'er, Iron Chuan'er, just what are you waiting for? Get them!",
            "nextDialogs": [
              "711160618"
            ]
          },
          "711160618": {
            "id": "711160618",
            "speakerId": 1004,
            "speakerName": "Iron Chuan'er",
            "text": "Boss Iron Ming... You really are heartless. Unjust.",
            "nextDialogs": [
              "711160619"
            ]
          },
          "711160619": {
            "id": "711160619",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "As long as we can stop villains like you from befouling Liyue with your criminal conduct, all of our efforts will have been worth it.",
            "nextDialogs": [
              "711160626"
            ]
          },
          "711160626": {
            "id": "711160626",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "Round 'em up!",
            "nextDialogs": [
              "711160620"
            ]
          },
          "711160620": {
            "id": "711160620",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "Wh—What...!?",
            "nextDialogs": [
              "711160621"
            ]
          },
          "711160621": {
            "id": "711160621",
            "speakerId": 1000,
            "speakerName": "Iron Dou'er",
            "text": "Iron Ming, you lowly scum! Open your eyes and take a good look at us! Who are we?",
            "nextDialogs": [
              "711160622"
            ]
          },
          "711160622": {
            "id": "711160622",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "M—Millelith!?",
            "nextDialogs": [
              "711160623"
            ]
          },
          "711160623": {
            "id": "711160623",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa, whoa, slow down a sec! What's going on? Why the sudden...",
            "nextDialogs": [
              "711160624"
            ]
          },
          "711160624": {
            "id": "711160624",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "I thought you were just newbies, I never imagined you were a bunch of cursed sleuths...",
            "nextDialogs": [
              "711160625"
            ]
          },
          "711160625": {
            "id": "711160625",
            "speakerId": 1002,
            "speakerName": "Iron Ming",
            "text": "Don't count on me going quietly! Bring it on!"
          }
        }
      }
    },
    {
      "subId": "7111607",
      "subQuestName": "Defeat Iron Ming",
      "sceneId": null,
      "locations": [],

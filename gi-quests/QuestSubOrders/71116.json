          "711165603": {
            "id": "711165603",
            "speakerId": 1009,
            "speakerName": "Yijun",
            "text": "Oh? You two are...? Sorry, it was nothing important, just talking about some... guild matters.",
            "nextDialogs": [
              "711165604"
            ]
          },
          "711165604": {
            "id": "711165604",
            "speakerId": 1009,
            "speakerName": "Yijun",
            "text": "You're tourists, right? Chenyu Vale is a very scenic area. You've come to the right place.",

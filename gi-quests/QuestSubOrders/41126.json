    {
      "subId": "4112602",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411260201"
        ],
        "dialogs": {
          "411260201": {
            "id": "411260201",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "*sigh* When will I finally be able to clear my leave..."
          }
        }
      }
    },
    {
      "subId": "4112609",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411260901"
        ],
        "dialogs": {
          "411260901": {
            "id": "411260901",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "You're back. Did you manage to deliver the letter?",
            "nextDialogs": [
              "411260902"
            ]
          },
          "411260902": {
            "id": "411260902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I did. Little Liu has a letter for you too, by the by.",
            "nextDialogs": [
              "411260903"
            ]
          },
          "411260903": {
            "id": "411260903",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "Little Liu wrote me a letter? Let me see..."
          }
        }
      }
    }
  ]
}
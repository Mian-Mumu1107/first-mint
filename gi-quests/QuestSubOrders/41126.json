    {
      "subId": "4112610",
      "subQuestName": "Report back to Jiayi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411261001"
        ],
        "dialogs": {
          "411261001": {
            "id": "411261001",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "Thank you, Traveler. I'll keep this for the time being. This is not the time to be reading letters... I must attend to my duties now.",
            "nextDialogs": [
              "411261002"
            ]
          },
          "411261002": {
            "id": "411261002",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "Please take this as compensation for your trouble.",
            "nextDialogs": [
              "411261003"
            ]
          },
          "411261003": {
            "id": "411261003",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "Once this is all over, I'm taking a long break for sure..."
          }
        }
      }
    },
    {
      "subId": "4112611",
      "subQuestName": "Talk to Jiayi",
      "sceneId": null,
      "locations": [],

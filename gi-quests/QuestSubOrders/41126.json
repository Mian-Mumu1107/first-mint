    {
      "subId": "4112612",
      "subQuestName": "Clear out the monsters near Qingce Village",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411261201"
        ],
        "dialogs": {
          "411261201": {
            "id": "411261201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Speaking of which, do you know where she is?",
            "nextDialogs": [
              "411261202"
            ]
          },
          "411261202": {
            "id": "411261202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm, well then, guess we'll just have to ask the villagers."
          }
        }
      }
    },
    {
      "subId": "4112603",
      "subQuestName": "Clear out the monsters near Qingce Village",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411260301"
        ],
        "dialogs": {
          "411260301": {
            "id": "411260301",
            "speakerId": 1002,
            "speakerName": "Little Liu",
            "text": "That's so weird. Why does something happen every time Daddy applies for leave?"
          }
        }
      }
    },
    {
      "subId": "4112604",
      "subQuestName": "Deliver Jiayi's letter to Little Liu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4112605",
      "subQuestName": "Ask the villagers about Little Liu's whereabouts",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411260501"
        ],
        "dialogs": {
          "411260501": {
            "id": "411260501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Any idea where Little Liu is?",
            "nextDialogs": [
              "411260502"
            ]
          },
          "411260502": {
            "id": "411260502",
            "speakerId": 1003,
            "speakerName": "Yundan",
            "text": "Little Liu? Hmm, I remember her saying that she wanted to find a high place so she could watch the meteorites...",
            "nextDialogs": [
              "411260503"
            ]
          },
          "411260503": {
            "id": "411260503",
            "speakerId": 1003,
            "speakerName": "Yundan",
            "text": "Hmm, I think she <color=#00E1FFFF>climbed up those ladders over there</color>."
          }
        }
      }
    },
    {
      "subId": "4112606",
      "subQuestName": "Ask the villagers about Little Liu's whereabouts",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411260601"
        ],
        "dialogs": {
          "411260601": {
            "id": "411260601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you where Little Liu is?",
            "nextDialogs": [
              "411260602"
            ]
          },
          "411260602": {
            "id": "411260602",
            "speakerId": 1004,
            "speakerName": "Dongdong",
            "text": "Little Liu? We were going to meet here to watch the meteorites, but she said that she wanted to find someplace higher.",
            "nextDialogs": [
              "411260603"
            ]
          },
          "411260603": {
            "id": "411260603",
            "speakerId": 1004,
            "speakerName": "Dongdong",
            "text": "She said that she'd tell me once she found our new spot, but I don't know where she's gone."
          }
        }
      }
    },
    {
      "subId": "4112607",
      "subQuestName": "Ask the villagers about Little Liu's whereabouts",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411260701"
        ],
        "dialogs": {
          "411260701": {
            "id": "411260701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, about Little Liu...",
            "nextDialogs": [
              "411260702"
            ]
          },
          "411260702": {
            "id": "411260702",
            "speakerId": 1005,
            "speakerName": "Uncle Ghast",
            "text": "Little Liu... Little Liu... Ah yes, I know her. But I've been here all this while, and she didn't pass this way."
          }
        }
      }
    },
    {
      "subId": "4112608",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411260801"
        ],
        "dialogs": {
          "411260801": {
            "id": "411260801",
            "speakerId": 1002,
            "speakerName": "Little Liu",
            "text": "I should be able to see the meteorites clearly from here...",
            "nextDialogs": [
              "411260802"
            ]
          },
          "411260802": {
            "id": "411260802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's a letter for you...",
            "nextDialogs": [
              "411260803"
            ]
          },
          "411260803": {
            "id": "411260803",
            "speakerId": 1002,
            "speakerName": "Little Liu",
            "text": "A letter from Daddy... Ugh, I already know what it's going to say...",
            "nextDialogs": [
              "411260804"
            ]
          },
          "411260804": {
            "id": "411260804",
            "speakerId": 1002,
            "speakerName": "Little Liu",
            "text": "He can't come and spend time with me because of work, right?",
            "nextDialogs": [
              "411260805"
            ]
          },
          "411260805": {
            "id": "411260805",
            "speakerId": 1002,
            "speakerName": "Little Liu",
            "text": "When those Millelith came here, I thought Daddy would be with them, but that didn't happen...",
            "nextDialogs": [
              "411260806"
            ]
          },
          "411260806": {
            "id": "411260806",
            "speakerId": 1002,
            "speakerName": "Little Liu",
            "text": "But that's not a bad thing, actually. With all those rocks falling from the sky, Daddy could be in danger out there.",
            "nextDialogs": [
              "411260808",
              "411260810"
            ]
          },
          "411260808": {
            "id": "411260808",
            "speakerId": 1002,
            "speakerName": "Little Liu",
            "text": "Well... a little, but we should be alright. The Millelith are here, after all.",
            "nextDialogs": [
              "411260811"
            ]
          },
          "411260811": {
            "id": "411260811",
            "speakerId": 1002,
            "speakerName": "Little Liu",
            "text": "Right! Could you send this letter back to Daddy for me? He must be worried.",
            "nextDialogs": [
              "411260812"
            ]
          },
          "411260812": {
            "id": "411260812",
            "speakerId": 1002,
            "speakerName": "Little Liu",
            "text": "It's so strange. Something seems to happen every time Daddy says he'll take leave and spend time with me..."
          },
          "411260810": {
            "id": "411260810",
            "speakerId": 1002,
            "speakerName": "Little Liu",
            "text": "I know, I know. The Millelith have talked our ears off already."
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "4112601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411260101"
        ],
        "dialogs": {
          "411260101": {
            "id": "411260101",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "*sigh* What shall I do...",
            "nextDialogs": [
              "411260102"
            ]
          },
          "411260102": {
            "id": "411260102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "411260103"
            ]
          },
          "411260103": {
            "id": "411260103",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "You must have seen those meteorites that fell from the sky as well, right? Fortunately, the city wasn't hit, but it's a real mess out there in the wild.",
            "nextDialogs": [
              "411260104"
            ]
          },
          "411260104": {
            "id": "411260104",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "Not only have the meteorites blocked the roads, but they've also caused the nearby monsters to become more agitated and dangerous than usual, and they've been attacking passers-by and merchants everywhere.",
            "nextDialogs": [
              "411260105"
            ]
          },
          "411260105": {
            "id": "411260105",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "The Ministry of Civil Affairs has sent almost every single available Millelith out, but Liyue is far too large. We can only ensure the safety of a few main roads and some key villages.",
            "nextDialogs": [
              "411260106"
            ]
          },
          "411260106": {
            "id": "411260106",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "I'd applied to go to Qingce Village to take up guard duties there, but for some reason, I still got redeployed here to stand by for orders...",
            "nextDialogs": [
              "411260107"
            ]
          },
          "411260107": {
            "id": "411260107",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "Traveler, could you help me send this letter to a girl named Little Liu who lives in Qingce Village?",
            "nextDialogs": [
              "411260108"
            ]
          },
          "411260108": {
            "id": "411260108",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "She's my daughter, and I'd agreed to go back to spend a few days with her. But with this emergency cropping up, there's no way that'll happen now...",
            "nextDialogs": [
              "411260110",
              "411260112"
            ]
          },
          "411260110": {
            "id": "411260110",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "Much appreciated, Traveler. Ah, what horrible luck...",
            "nextDialogs": [
              "411260115"
            ]
          },
          "411260115": {
            "id": "411260115",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "That said, I've heard from people who've come to stand down from duty that quite a few monsters have gathered near Qingce Village as well.",
            "nextDialogs": [
              "411260116"
            ]
          },
          "411260116": {
            "id": "411260116",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "Well... I don't mean to impose, but you do look dressed for adventure.",
            "nextDialogs": [
              "411260117"
            ]
          },
          "411260117": {
            "id": "411260117",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "Could you have a look around Qingce Village while you're sending the letter, and help to clear the monsters out?",
            "nextDialogs": [
              "411260118"
            ]
          },
          "411260118": {
            "id": "411260118",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "The Millelith largely stand guard on the main roads and key passes... Things could go poorly if some scattered monsters were able to sneak into Qingce Village."
          },
          "411260112": {
            "id": "411260112",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "I know, but... I just don't get it. Why does something happen every time I try to apply for leave?",
            "nextDialogs": [
              "411260113"
            ]
          },
          "411260113": {
            "id": "411260113",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "I'm finding it hard to call it a coincidence...",
            "nextDialogs": [
              "411260114"
            ]
          },
          "411260114": {
            "id": "411260114",
            "speakerId": 1000,
            "speakerName": "Jiayi",
            "text": "Well, I'll leave it to you then. Please help me get this letter to Little Liu."
          }
        }
      }
    },
    {
      "subId": "4112602",

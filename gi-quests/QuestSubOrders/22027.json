  },
  "subQuests": [
    {
      "subId": "2202701",
      "subQuestName": "Talk to Shouta",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220270101"
        ],
        "dialogs": {
          "220270101": {
            "id": "220270101",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "Lacquerware... how do you make those...",
            "nextDialogs": [
              "220270102"
            ]
          },
          "220270102": {
            "id": "220270102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why do you need lacquerware?",
            "nextDialogs": [
              "220270103"
            ]
          },
          "220270103": {
            "id": "220270103",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "#Oh, it's you, {F#big sis}{M#big bro}. So here's the thing. Have you ever heard of a shrine's divine intervention?",
            "nextDialogs": [
              "220270104"
            ]
          },
          "220270104": {
            "id": "220270104",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "From what I've heard, if you give precious offerings to the shrine, maybe your wishes will come true.",
            "nextDialogs": [
              "220270105"
            ]
          },
          "220270105": {
            "id": "220270105",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "I think that pretty lacquerware is very valuable. If I used those as offerings to the shrine, then I'd be sure to get a reply.",
            "nextDialogs": [
              "220270106"
            ]
          },
          "220270106": {
            "id": "220270106",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "However, I don't have money to buy any lacquerware. That's why I want to make one for myself.",
            "nextDialogs": [
              "220270107"
            ]
          },
          "220270107": {
            "id": "220270107",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "I heard that Nanatsuki from Yayoi Lacquerware is very good at making them...",
            "nextDialogs": [
              "220270108"
            ]
          },
          "220270108": {
            "id": "220270108",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "#Could you go ask her about the lacquerware, {F#big sis}{M#big bro}?",
            "nextDialogs": [
              "220270110",
              "220270112"
            ]
          },
          "220270110": {
            "id": "220270110",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "#Thank you, {F#big sis}{M#big bro}!"
          },
          "220270112": {
            "id": "220270112",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "Nanatsuki is pretty serious most of the time. I don't have the guts to go ask for her help myself...",
            "nextDialogs": [
              "220270113"
            ]
          },
          "220270113": {
            "id": "220270113",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "#But if you're with me, {F#big sis}{M#big bro}, things will probably go better..."
          }
        }
      }
    },
    {
      "subId": "2202702",
      "subQuestName": "Talk to Yayoi Nanatsuki",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220270201"
        ],
        "dialogs": {
          "220270201": {
            "id": "220270201",
            "speakerId": 3001,
            "speakerName": "Yayoi Nanatsuki",
            "text": "Hello, is there anything I can help you with?",
            "nextDialogs": [
              "220270202"
            ]
          },
          "220270202": {
            "id": "220270202",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "Uhh... so...",
            "nextDialogs": [
              "220270203"
            ]
          },
          "220270203": {
            "id": "220270203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, he wants to ask about lacquerware...",
            "nextDialogs": [
              "220270204"
            ]
          },
          "220270204": {
            "id": "220270204",
            "speakerId": 3001,
            "speakerName": "Yayoi Nanatsuki",
            "text": "Ah, so you want to offer lacquerwares to the shrine, and you want to make one yourself?",
            "nextDialogs": [
              "220270205"
            ]
          },
          "220270205": {
            "id": "220270205",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "Please, Nanatsuki. I have a wish that I want to have fulfilled! That's why I... Don't worry, I won't tell anyone about your secret formula!",
            "nextDialogs": [
              "220270206"
            ]
          },
          "220270206": {
            "id": "220270206",
            "speakerId": 3001,
            "speakerName": "Yayoi Nanatsuki",
            "text": "The issue is not the painting formula. If you want to make beautiful lacquerware, leaving the paint aside, you also need a long period of practice.",
            "nextDialogs": [
              "220270207"
            ]
          },
          "220270207": {
            "id": "220270207",
            "speakerId": 3001,
            "speakerName": "Yayoi Nanatsuki",
            "text": "And this isn't just about time, it's more about... the capital. I am the fourth generation successor to a family of lacquerware-makers.",
            "nextDialogs": [
              "220270208"
            ]
          },
          "220270208": {
            "id": "220270208",
            "speakerId": 3001,
            "speakerName": "Yayoi Nanatsuki",
            "text": "I even traveled to Sumeru to study lacquerwares. So it's impossible for you to grasp lacquerwares overnight.",
            "nextDialogs": [
              "220270209"
            ]
          },
          "220270209": {
            "id": "220270209",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "Is... is that so? But I can't really think of anything else to offer to the shrine...",
            "nextDialogs": [
              "220270210"
            ]
          },
          "220270210": {
            "id": "220270210",
            "speakerId": 3001,
            "speakerName": "Yayoi Nanatsuki",
            "text": "In my opinion, it's not about the value of the item being offered to the shrine. This item you offer should represent your feelings.",
            "nextDialogs": [
              "220270211"
            ]
          },
          "220270211": {
            "id": "220270211",
            "speakerId": 3001,
            "speakerName": "Yayoi Nanatsuki",
            "text": "As long as you have the right feelings and intentions, and offer your favorite items, you should be able to get a response from the archons.",
            "nextDialogs": [
              "220270212"
            ]
          },
          "220270212": {
            "id": "220270212",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "Right feelings and intentions... the things that I like...",
            "nextDialogs": [
              "220270213"
            ]
          },
          "220270213": {
            "id": "220270213",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "Hmm, I think I get it... and I also don't. But thank you anyway, Nanatsuki.",
            "nextDialogs": [
              "220270214"
            ]
          },
          "220270214": {
            "id": "220270214",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "#Let's go back to the shrine first, {F#big sis}{M#big bro}. I still need your help with figuring out the kind of things I want to offer."
          }
        }
      }
    },
    {
      "subId": "2202703",
      "subQuestName": "Help Shouta place offerings at the shrine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220270301"
        ],
        "dialogs": {
          "220270301": {
            "id": "220270301",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "I mean, Nanatsuki said that I should, didn't she? But what should I offer, exactly...",
            "nextDialogs": [
              "220270302"
            ]
          },
          "220270302": {
            "id": "220270302",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "Speaking of things that I like, it's gotta be Tricolor Dango. I love them so much...",
            "nextDialogs": [
              "220270303"
            ]
          },
          "220270303": {
            "id": "220270303",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "But would it be disrespectful to offer Tricolor Dango? I offered Konpeito Candy before as well, but I got no reply.",
            "nextDialogs": [
              "220270304"
            ]
          },
          "220270304": {
            "id": "220270304",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "I've also heard that some people will pack fresh petals into sachets and offer those. That sounds more appropriate than Dango...",
            "nextDialogs": [
              "220270305"
            ]
          },
          "220270305": {
            "id": "220270305",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "#What should we do? What do you think we should offer, {F#big sis}{M#big bro}?"
          }
        }
      }
    },
    {
      "subId": "2202705",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220270401"
        ],
        "dialogs": {
          "220270401": {
            "id": "220270401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's go with Tricolor Dango.",
            "nextDialogs": [
              "220270402"
            ]
          },
          "220270402": {
            "id": "220270402",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "Really? Okay! I happened to have brought one with me. My mom made it for me and I haven't even eaten it yet...",
            "nextDialogs": [
              "220270403"
            ]
          },
          "220270403": {
            "id": "220270403",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "Let's offer it up, then!",
            "nextDialogs": [
              "220270601"
            ]
          },
          "220270601": {
            "id": "220270601",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "O Archon, bless me and help my wishes come true...",
            "nextDialogs": [
              "220270602"
            ]
          },
          "220270602": {
            "id": "220270602",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "#Thank you for staying with me until now, {F#big sis}{M#big bro}. Please have these. They're for you!",
            "nextDialogs": [
              "220270603"
            ]
          },
          "220270603": {
            "id": "220270603",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "I'll come back here tomorrow to check again. I hope that I'll receive a reply..."
          }
        }
      }
    },
    {
      "subId": "2202704",
      "subQuestName": "Help Shouta place offerings at the shrine",
      "sceneId": null,
      "locations": [],

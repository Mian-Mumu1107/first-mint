      }
    },
    {
      "subId": "2202705",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220270501"
        ],
        "dialogs": {
          "220270501": {
            "id": "220270501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's better that we offer one of those sachets.",
            "nextDialogs": [
              "220270502"
            ]
          },
          "220270502": {
            "id": "220270502",
            "speakerId": 3045,
            "speakerName": "Shouta",
            "text": "Okay. Let's go with your idea!"
          }
        }
      }
    }
  ]
}
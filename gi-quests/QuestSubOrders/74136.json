        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7413606",
      "subQuestName": "Talk to Chaussivert",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741360601"
        ],
        "dialogs": {
          "741360601": {
            "id": "741360601",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "A huge empty space with... nothing inside... Did we come up empty-handed?",
            "nextDialogs": [
              "741360602"
            ]
          },
          "741360602": {
            "id": "741360602",
            "speakerId": 1001,
            "speakerName": "Chaussivert",
            "text": "The plants have been intentionally cleared, and the trimming seems relatively recent.",
            "nextDialogs": [
              "741360603"
            ]
          },
          "741360603": {
            "id": "741360603",
            "speakerId": 1002,
            "speakerName": "Fusilier",
            "text": "...All the trouble I went through for him...",
            "nextDialogs": [
              "741360604"
            ]
          },
          "741360604": {
            "id": "741360604",
            "speakerId": 1001,
            "speakerName": "Chaussivert",
            "text": "Anyway, I'll go down alone and take a look. You stay with Miss Institute Lady. If things get out of hand... take her and go.",
            "nextDialogs": [
              "741360605"
            ]
          },
          "741360605": {
            "id": "741360605",
            "speakerId": 1001,
            "speakerName": "Chaussivert",
            "text": "But there's nothing here. How could things get out of hand...",
            "nextDialogs": [
              "741360606"
            ]
          },
          "741360606": {
            "id": "741360606",
            "speakerId": 1003,
            "speakerName": "???",
            "text": "Squeak! Beep beep!",
            "nextDialogs": [
              "741360607"
            ]
          },
          "741360607": {
            "id": "741360607",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa! Look out! Something's coming!"
          }
        }
      }
    },

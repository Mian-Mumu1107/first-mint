    {
      "subId": "7413609",
      "subQuestName": "Talk to Nacker",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741360901"
        ],
        "dialogs": {
          "741360901": {
            "id": "741360901",
            "speakerId": 1004,
            "speakerName": "Nacker",
            "text": "Institute dogs! How much did Choiseul and Raimondo pay you!?",
            "nextDialogs": [
              "741360904"
            ]
          },
          "741360904": {
            "id": "741360904",
            "speakerId": 1004,
            "speakerName": "Nacker",
            "text": "You... You... Listen to me, let me go. My \"Field Generator\" is almost done.",
            "nextDialogs": [
              "741360905"
            ]
          },
          "741360905": {
            "id": "741360905",
            "speakerId": 1004,
            "speakerName": "Nacker",
            "text": "Once I successfully synchronize it with the Arkhium Kinetic Core, then... Then I'll be the greatest kinetic engineer ever!",
            "nextDialogs": [
              "741360906"
            ]
          },
          "741360906": {
            "id": "741360906",
            "speakerId": 1002,
            "speakerName": "Fusilier",
            "text": "...Taking credit for someone else's work and claiming to be the greatest engineer. Shame on you.",
            "nextDialogs": [
              "741360907"
            ]
          },
          "741360907": {
            "id": "741360907",
            "speakerId": 1002,
            "speakerName": "Fusilier",
            "text": "Now I finally know why Mr. Ed... Edwin never wanted you to take part in the core research project.",
            "nextDialogs": [
              "741360908"
            ]
          },
          "741360908": {
            "id": "741360908",
            "speakerId": 1004,
            "speakerName": "Nacker",
            "text": "Edwin doesn't know a thing about what to do with it! You're also from the Institute... You know the true value of this thing!",
            "nextDialogs": [
              "741360909"
            ]
          },
          "741360909": {
            "id": "741360909",
            "speakerId": 1004,
            "speakerName": "Nacker",
            "text": "Help me! I can... develop it with you! Then, we'll both be famous, and incomparable!",
            "nextDialogs": [
              "741360910"
            ]
          },
          "741360910": {
            "id": "741360910",
            "speakerId": 1004,
            "speakerName": "Nacker",
            "text": "Edwin, Raimondo, Choiseul... None of them can surpass our fame!"
          }
        }
      }
    },
    {
      "subId": "7413610",
      "subQuestName": "Rejoin Lemarcq",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741361001"
        ],
        "dialogs": {
          "741361001": {
            "id": "741361001",
            "speakerId": 1004,
            "speakerName": "Nacker",
            "text": "Edwin... I knew it! You lured them over... You've always been jealous of me! Afraid that my research would surpass yours!",
            "nextDialogs": [
              "741361002"
            ]
          },
          "741361002": {
            "id": "741361002",
            "speakerId": 1005,
            "speakerName": "Edwin Eastinghouse",
            "text": "You're right. I am so jealous of how totally oblivious and ignorant you are. No wonder you led such a blissful life back at the Institute.",
            "nextDialogs": [
              "741361003"
            ]
          },
          "741361003": {
            "id": "741361003",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Only if Choiseul was here to see this... He'd faint.",
            "nextDialogs": [
              "741361006"
            ]
          },
          "741361006": {
            "id": "741361006",
            "speakerId": 1005,
            "speakerName": "Edwin Eastinghouse",
            "text": "You go back to the Institute with them and repent... I need to get back to my research... You didn't break anything, did you?"
          }
        }
      }
    },
    {
      "subId": "7413611",
      "subQuestName": "Report back to the Fontaine Research Institute",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741361101"
        ],
        "dialogs": {
          "741361101": {
            "id": "741361101",
            "speakerId": 1006,
            "speakerName": "Choiseul",
            "text": "#Miss Fusilier! {NICKNAME}! You're back! You must've handled things...",
            "nextDialogs": [
              "741361102"
            ]
          },
          "741361102": {
            "id": "741361102",
            "speakerId": 1006,
            "speakerName": "Choiseul",
            "text": "Oh, no...",
            "nextDialogs": [
              "741361103"
            ]
          },
          "741361103": {
            "id": "741361103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa! Mr. Choiseul is really about to faint!",
            "nextDialogs": [
              "741361104"
            ]
          },
          "741361104": {
            "id": "741361104",
            "speakerId": 1005,
            "speakerName": "Edwin Eastinghouse",
            "text": "I didn't think you'd be back at the Institute, Choiseul. I figured you'd be stuck dealing with paperwork forever.",
            "nextDialogs": [
              "741361105"
            ]
          },
          "741361105": {
            "id": "741361105",
            "speakerId": 1006,
            "speakerName": "Choiseul",
            "text": "This... This is impossible! Goodness gracious!",
            "nextDialogs": [
              "741361106"
            ]
          },
          "741361106": {
            "id": "741361106",
            "speakerId": 1005,
            "speakerName": "Edwin Eastinghouse",
            "text": "Raimondo, how does it feel taking over my job? Anything worth reporting?",
            "nextDialogs": [
              "741361107"
            ]
          },
          "741361107": {
            "id": "741361107",
            "speakerId": 1007,
            "speakerName": "Raimondo",
            "text": "...What a wonderful reunion, Mr. Edwin.",
            "nextDialogs": [
              "741361108"
            ]
          },
          "741361108": {
            "id": "741361108",
            "speakerId": 1005,
            "speakerName": "Edwin Eastinghouse",
            "text": "Ha! Look around you. You really do seem suited for janitorial work.",
            "nextDialogs": [
              "741361109"
            ]
          },
          "741361109": {
            "id": "741361109",
            "speakerId": 1004,
            "speakerName": "Nacker",
            "text": "...Hmph! He didn't even clean it up properly.",
            "nextDialogs": [
              "741361110"
            ]
          },
          "741361110": {
            "id": "741361110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Mainly because he didn't clean you up.",
            "nextDialogs": [
              "741361111"
            ]
          },
          "741361111": {
            "id": "741361111",
            "speakerId": 1007,
            "speakerName": "Raimondo",
            "text": "#Thank you for bringing those two back, Honorary Senior Researcher {NICKNAME}, Miss Fusilier.",
            "nextDialogs": [
              "741361112"
            ]
          },
          "741361112": {
            "id": "741361112",
            "speakerId": 1007,
            "speakerName": "Raimondo",
            "text": "Hopefully, this marks the end of the Fontaine Research Institute's series of unfortunate events and turmoil.",
            "nextDialogs": [
              "741361113"
            ]
          },
          "741361113": {
            "id": "741361113",
            "speakerId": 1005,
            "speakerName": "Edwin Eastinghouse",
            "text": "Hahaha! Great. The Fontaine Research Institute will now fall into deathly stillness where all inspirations wither and die.",
            "nextDialogs": [
              "741361114"
            ]
          },
          "741361114": {
            "id": "741361114",
            "speakerId": 1007,
            "speakerName": "Raimondo",
            "text": "You certainly have already sparked much inspiration around the Institute. It's time to calm things down.",
            "nextDialogs": [
              "741361115"
            ]
          },
          "741361115": {
            "id": "741361115",
            "speakerId": 1005,
            "speakerName": "Edwin Eastinghouse",
            "text": "Raimondo Havenport, you know nothing about research. You are not fit to lead the Fontaine Research Institute of Kinetic Energy Engineering.",
            "nextDialogs": [
              "741361116"
            ]
          },
          "741361116": {
            "id": "741361116",
            "speakerId": 1007,
            "speakerName": "Raimondo",
            "text": "But I know how to keep it up and running properly, Edwin Eastinghouse.",
            "nextDialogs": [
              "741361117"
            ]
          },
          "741361117": {
            "id": "741361117",
            "speakerId": 1007,
            "speakerName": "Raimondo",
            "text": "What you need to do right now is to stay away from research and Arkhium. It's better for all of us.",
            "nextDialogs": [
              "741361118"
            ]
          },
          "741361118": {
            "id": "741361118",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "Some time later, the Maison Gardiennage's personnel arrives and take both Nacker and Edwin. It is for the best that they finally leave the Institute for good...",
            "nextDialogs": [
              "741361119"
            ]
          },
          "741361119": {
            "id": "741361119",
            "speakerId": 1006,
            "speakerName": "Choiseul",
            "text": "Thank goodness, my nightmare has finally ended...",
            "nextDialogs": [
              "741361120"
            ]
          },
          "741361120": {
            "id": "741361120",
            "speakerId": 1006,
            "speakerName": "Choiseul",
            "text": "Mr. Chaussivert, Mr. Lemarcq, yes? I've heard about the assistance you rendered to our institute. Please take a well-deserved rest here while your compensation is being arranged.",
            "nextDialogs": [
              "741361121"
            ]
          },
          "741361121": {
            "id": "741361121",
            "speakerId": 1001,
            "speakerName": "Chaussivert",
            "text": "Hahaha! I didn't think someone like me would ever be associated with the Institute.",
            "nextDialogs": [
              "741361122"
            ]
          },
          "741361122": {
            "id": "741361122",
            "speakerId": 1006,
            "speakerName": "Choiseul",
            "text": "Don't say that about yourself, dear sir! You're sincere and kind-hearted, so you're definitely a good person. Maybe we'll enlist your help in the future.",
            "nextDialogs": [
              "741361123"
            ]
          },
          "741361123": {
            "id": "741361123",
            "speakerId": 1006,
            "speakerName": "Choiseul",
            "text": "As for you... Honorary Senior Researcher, you did us a great favor once again. How should we ever repay you?",
            "nextDialogs": [
              "741361128",
              "741361126"
            ]
          },
          "741361128": {
            "id": "741361128",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "By the way... Where's Miss Fusilier?",
            "nextDialogs": [
              "741361129"
            ]
          },
          "741361129": {
            "id": "741361129",
            "speakerId": 1007,
            "speakerName": "Raimondo",
            "text": "...We should give her some room to calm down. Looks like the image of Edwin Eastinghouse she had created in her head has completely shattered.",
            "nextDialogs": [
              "741361130"
            ]
          },
          "741361130": {
            "id": "741361130",
            "speakerId": 1007,
            "speakerName": "Raimondo",
            "text": "Edwin and Nacker need to calm down as well... I hope they can reflect on their own mistakes.",
            "nextDialogs": [
              "741361131"
            ]
          },
          "741361131": {
            "id": "741361131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Will they stay in the Fortress of Meropide all their life?",
            "nextDialogs": [
              "741361132"
            ]
          },
          "741361132": {
            "id": "741361132",
            "speakerId": 1007,
            "speakerName": "Raimondo",
            "text": "Judging by how dangerous they are, I hope they never leave that place.",
            "nextDialogs": [
              "741361133"
            ]
          },
          "741361133": {
            "id": "741361133",
            "speakerId": 1007,
            "speakerName": "Raimondo",
            "text": "However, given the state of things here at the Fontaine Research Institute... I can only hope I don't run into situations that would require their expertise...",
            "nextDialogs": [
              "741361134"
            ]
          },
          "741361134": {
            "id": "741361134",
            "speakerId": 1007,
            "speakerName": "Raimondo",
            "text": "I thank you again on behalf of the Fontaine Research Institute, Honorary Senior Researcher. If you have any further questions, I'm at your service."
          },
          "741361126": {
            "id": "741361126",
            "speakerId": 1006,
            "speakerName": "Choiseul",
            "text": "Well... theoretically, your current title already resides at the top... But let me see what I can do.",
            "nextDialogs": [
              "741361127"
            ]
          },
          "741361127": {
            "id": "741361127",
            "speakerId": 1006,
            "speakerName": "Choiseul",
            "text": "How about something like... Chief Honorary Senior Researcher? Hahahah!"
          }
        }
      }
    },
    {
      "subId": "7413634",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741363401"
        ],
        "dialogs": {
          "741363401": {
            "id": "741363401",
            "speakerId": 1005,
            "speakerName": "Edwin Eastinghouse",
            "text": "Why are you... You're back again. Told you. You can try five times and still won't find him.",
            "nextDialogs": [
              "741363402"
            ]
          },
          "741363402": {
            "id": "741363402",
            "speakerId": 1005,
            "speakerName": "Edwin Eastinghouse",
            "text": "It's not working out for you, clearly, so why don't you just sit down and have some tea? I just bought five cups... and a few bowls.",
            "nextDialogs": [
              "741363403"
            ]
          },
          "741363403": {
            "id": "741363403",
            "speakerId": 1009,
            "speakerName": "Lemarcq",
            "text": "You really like the number \"five,\" don't you, Mr. Edwin?",
            "nextDialogs": [
              "741363404"
            ]
          },
          "741363404": {
            "id": "741363404",
            "speakerId": 1005,
            "speakerName": "Edwin Eastinghouse",
            "text": "Yes! It's a magical number! Use it right, and you can unlock the doors to endless inspiration!",
            "nextDialogs": [
              "741363405"
            ]
          },
          "741363405": {
            "id": "741363405",
            "speakerId": 1005,
            "speakerName": "Edwin Eastinghouse",
            "text": "Listen up. There are five doors to endless inspiration, and you have to turn each handle five times... Five! You hear? Five times!",
            "nextDialogs": [
              "741363406"
            ]
          },
          "741363406": {
            "id": "741363406",
            "speakerId": 1009,
            "speakerName": "Lemarcq",
            "text": "Sorry, but I'm really trying to stop myself from punching you five times. Would you please kindly shut your trap?"
          }
        }
      }
    },
    {
      "subId": "7413699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741369917"
        ],
        "dialogs": {
          "741369917": {
            "id": "741369917",
            "speakerId": 1001,
            "speakerName": "Chaussivert",
            "text": "That scoundrel is right up there! Get him!",
            "nextDialogs": [
              "741369918"
            ]
          },
          "741369918": {
            "id": "741369918",
            "speakerId": 1004,
            "speakerName": "Nacker",
            "text": "Darn! Darn! Get out! One last step... One last step!",
            "nextDialogs": [
              "741369919"
            ]
          },
          "741369919": {
            "id": "741369919",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}! Hurry! Get that liar! Wretch! Fraud! The most...",
            "nextDialogs": [
              "741369920"
            ]
          },
          "741369920": {
            "id": "741369920",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... The THIRD most annoying person in the Institute!"
          }
        }
      }
    }
  ]
}
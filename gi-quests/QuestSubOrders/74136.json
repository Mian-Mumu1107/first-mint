    {
      "subId": "7413604",
      "subQuestName": "Talk to Chaussivert",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741360401"
        ],
        "dialogs": {
          "741360401": {
            "id": "741360401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So that's why he kept on repeating the number \"five.\" He was giving us hints about how to solve the riddle...",
            "nextDialogs": [
              "741360402"
            ]
          },
          "741360402": {
            "id": "741360402",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Why didn't he just tell us straight? Why beat around the bush?",
            "nextDialogs": [
              "741360403"
            ]
          },
          "741360403": {
            "id": "741360403",
            "speakerId": 1001,
            "speakerName": "Chaussivert",
            "text": "Hmph, who knows what's going on in that head of his... But, he seemed to have been trying to lead us to Nacker.",
            "nextDialogs": [
              "741360404"
            ]
          },
          "741360404": {
            "id": "741360404",
            "speakerId": 1001,
            "speakerName": "Chaussivert",
            "text": "The divesuits were just left by the house... Almost like they were prepared for us.",
            "nextDialogs": [
              "741360407"
            ]
          },
          "741360407": {
            "id": "741360407",
            "speakerId": 1002,
            "speakerName": "Fusilier",
            "text": "No research value... But I... I've spent so much time...",
            "nextDialogs": [
              "741360408"
            ]
          },
          "741360408": {
            "id": "741360408",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Fusilier... She's been murmuring to herself the whole time...",
            "nextDialogs": [
              "741360409"
            ]
          },
          "741360409": {
            "id": "741360409",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#But... {NICKNAME}, do you get the feeling that we've been watched? Paimon feels chills running down her spine...",
            "nextDialogs": [
              "741360410"
            ]
          },
          "741360410": {
            "id": "741360410",
            "speakerId": 1001,
            "speakerName": "Chaussivert",
            "text": "I'll take the lead and look inside."
          }
        }
      }
    },
    {
      "subId": "7413605",
      "subQuestName": "Find Nacker",
      "sceneId": null,
      "locations": [],

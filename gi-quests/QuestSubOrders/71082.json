  "subQuests": [
    {
      "subId": "7108201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710820101"
        ],
        "dialogs": {
          "710820101": {
            "id": "710820101",
            "speakerId": 1000,
            "speakerName": "Claims to be \"Tang Wuchou\"",
            "text": "What, did you get stumped by Old Chou's games again?",
            "nextDialogs": [
              "710820102"
            ]
          },
          "710820102": {
            "id": "710820102",
            "speakerId": 1000,
            "speakerName": "Claims to be \"Tang Wuchou\"",
            "text": "C'mon, I told you already... That treasure hunt of his works like this: the <color=#00E1FFFF>better the goods, the more explosive barrels there will be around it, and vice versa.</color>",
            "nextDialogs": [
              "710820103"
            ]
          },
          "710820103": {
            "id": "710820103",
            "speakerId": 1000,
            "speakerName": "Claims to be \"Tang Wuchou\"",
            "text": "Got it this time?"
          }
        }
      }
    },
    {
      "subId": "7108202",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710820201"
        ],
        "dialogs": {
          "710820201": {
            "id": "710820201",
            "speakerId": 1001,
            "speakerName": "Uncle He",
            "text": "You Treasure Hoarder dreg... *pants* If I wasn't so exhausted from lacking any... mushrooms to eat lately...",
            "nextDialogs": [
              "710820202"
            ]
          },
          "710820202": {
            "id": "710820202",
            "speakerId": 1001,
            "speakerName": "Uncle He",
            "text": "I would have beaten you black and blue already!",
            "nextDialogs": [
              "710820203"
            ]
          },
          "710820203": {
            "id": "710820203",
            "speakerId": 1000,
            "speakerName": "Claims to be \"Tang Wuchou\"",
            "text": "You old thief! How dare you call my Glaze L... I mean, Qingxin! How dare you call them mushrooms and just... pick and eat them!",
            "nextDialogs": [
              "710820204"
            ]
          },
          "710820204": {
            "id": "710820204",
            "speakerId": 1000,
            "speakerName": "Claims to be \"Tang Wuchou\"",
            "text": "*cough* By what right do you get to do that?",
            "nextDialogs": [
              "710820205"
            ]
          },
          "710820205": {
            "id": "710820205",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Uh, why are you two fighting?",
            "nextDialogs": [
              "710820206"
            ]
          },
          "710820206": {
            "id": "710820206",
            "speakerId": 1001,
            "speakerName": "Uncle He",
            "text": "I—I was looking for mushroom-meat! Haha, yes, mushroom-meat! But they wouldn't let me back into the mines, no! So I—I came here looking for some.",
            "nextDialogs": [
              "710820207"
            ]
          },
          "710820207": {
            "id": "710820207",
            "speakerId": 1001,
            "speakerName": "Uncle He",
            "text": "And after searching and searching, I finally found that there were mushrooms here! But just as I was reaching for them, this cad attacked me out of nowhere!",
            "nextDialogs": [
              "710820208"
            ]
          },
          "710820208": {
            "id": "710820208",
            "speakerId": 1000,
            "speakerName": "Claims to be \"Tang Wuchou\"",
            "text": "#Hah! A cad? He's the one who violated our Guhua training grounds! And what's more, these flowers belong to me... and the heroic {NICKNAME}...",
            "nextDialogs": [
              "710820209"
            ]
          },
          "710820209": {
            "id": "710820209",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "And the heroic Paimon!",
            "nextDialogs": [
              "710820210"
            ]
          },
          "710820210": {
            "id": "710820210",
            "speakerId": 1000,
            "speakerName": "Claims to be \"Tang Wuchou\"",
            "text": "Yes, and the heroic Paimon! Other than the three of us, none may touch these sacred grounds!",
            "nextDialogs": [
              "710820211"
            ]
          },
          "710820211": {
            "id": "710820211",
            "speakerId": 1001,
            "speakerName": "Uncle He",
            "text": "Treasure Hoarder dreg!",
            "nextDialogs": [
              "710820212"
            ]
          },
          "710820212": {
            "id": "710820212",
            "speakerId": 1000,
            "speakerName": "Claims to be \"Tang Wuchou\"",
            "text": "Scandalous old crook!",
            "nextDialogs": [
              "710820213"
            ]
          },
          "710820213": {
            "id": "710820213",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Okay, okay, Uncle He, Tang Wuchou has stopped being a Treasure Hoarder already. Also, the stuff he planted are flowers, not mushrooms.",
            "nextDialogs": [
              "710820214"
            ]
          },
          "710820214": {
            "id": "710820214",
            "speakerId": 1001,
            "speakerName": "Uncle He",
            "text": "Eh? Is that so?",
            "nextDialogs": [
              "710820215"
            ]
          },
          "710820215": {
            "id": "710820215",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "C'mon, have a closer look. These are Qingxin for sure!",
            "nextDialogs": [
              "710820216"
            ]
          },
          "710820216": {
            "id": "710820216",
            "speakerId": 1001,
            "speakerName": "Uncle He",
            "text": "Ah! Indeed, they are Qingxin! It appears that I'm still a little dizzy...",
            "nextDialogs": [
              "710820217"
            ]
          },
          "710820217": {
            "id": "710820217",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "And you, Tang Wuchou, are you seriously still dreaming of growing that \"great Glaze Lily garden\" of yours?",
            "nextDialogs": [
              "710820218"
            ]
          },
          "710820218": {
            "id": "710820218",
            "speakerId": 1000,
            "speakerName": "Claims to be \"Tang Wuchou\"",
            "text": "Well, it would be a most beautiful sight to see, wouldn't you say?",
            "nextDialogs": [
              "710820219"
            ]
          },
          "710820219": {
            "id": "710820219",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Whatever the problem is, stop fighting!",
            "nextDialogs": [
              "710820220"
            ]
          },
          "710820220": {
            "id": "710820220",
            "speakerId": 1001,
            "speakerName": "Uncle He",
            "text": "*sigh* No mushrooms. Goodbye, I go.",
            "nextDialogs": [
              "710820221"
            ]
          },
          "710820221": {
            "id": "710820221",
            "speakerId": 1000,
            "speakerName": "Claims to be \"Tang Wuchou\"",
            "text": "Now that that troublesome old geezer is gone, I can finally look into planting some flowers..."
          }
        }
      }
    }
  ]
}
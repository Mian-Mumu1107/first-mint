    {
      "subId": "7721004",
      "subQuestName": "Talk to Chulkaturin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772100101"
        ],
        "dialogs": {
          "772100101": {
            "id": "772100101",
            "speakerId": 1000,
            "speakerName": "Cryo Cabin",
            "text": "I hear footsteps, traveler by the shore. Please, if you would, halt a moment.",
            "nextDialogs": [
              "772100102"
            ]
          },
          "772100102": {
            "id": "772100102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, it's this house again. If Paimon remembers right, some guy who hasn't come out in three hundred years lives in here! That's how he introduced himself to us back then, anyway.",
            "nextDialogs": [
              "772100103"
            ]
          },
          "772100103": {
            "id": "772100103",
            "speakerId": 1002,
            "speakerName": "Churkaturin",
            "text": "I remember this voice. You saved me once before, good travelers, and it appears we meet again, as I thought we might.",
            "nextDialogs": [
              "772100104"
            ]
          },
          "772100104": {
            "id": "772100104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Will you be needing my help again?",
            "nextDialogs": [
              "772100105"
            ]
          },
          "772100105": {
            "id": "772100105",
            "speakerId": 1002,
            "speakerName": "Churkaturin",
            "text": "Pardon the inconvenience, but I do indeed require your assistance once more.",
            "nextDialogs": [
              "772100106"
            ]
          },
          "772100106": {
            "id": "772100106",
            "speakerId": 1002,
            "speakerName": "Churkaturin",
            "text": "Please find a way to drag this cabin near the material required to reinforce it.",
            "nextDialogs": [
              "772100107"
            ]
          },
          "772100107": {
            "id": "772100107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Reinforcement materials... What would those be?",
            "nextDialogs": [
              "772100108"
            ]
          },
          "772100108": {
            "id": "772100108",
            "speakerId": 1002,
            "speakerName": "Churkaturin",
            "text": "Do you see the wooden boxes scattered across the water? Those boxes contain various materials that I have gathered during this period of my wanderings.",
            "nextDialogs": [
              "772100109"
            ]
          },
          "772100109": {
            "id": "772100109",
            "speakerId": 1002,
            "speakerName": "Churkaturin",
            "text": "Yes, I have resolved to expand my habitation, my home on ice.",
            "nextDialogs": [
              "772100110"
            ]
          },
          "772100110": {
            "id": "772100110",
            "speakerId": 1002,
            "speakerName": "Churkaturin",
            "text": "Travelers on the shore, you once said to me that gratitude should be expresseed face to face, that discourtesy not be done.",
            "nextDialogs": [
              "772100111"
            ]
          },
          "772100111": {
            "id": "772100111",
            "speakerId": 1002,
            "speakerName": "Churkaturin",
            "text": "Ever since we last parted ways by the lake, I have contemplated this matter: Should I again need the aid of travelers, how should I properly show them my thanks?",
            "nextDialogs": [
              "772100112"
            ]
          },
          "772100112": {
            "id": "772100112",
            "speakerId": 1002,
            "speakerName": "Churkaturin",
            "text": "To me, to set foot upon Snezhnayan soil is unthinkable. But should the shorebound travelers be willing to set foot upon my abode, then I should receive them in person and give them my thanks.",
            "nextDialogs": [
              "772100113"
            ]
          },
          "772100113": {
            "id": "772100113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So that's the reason for the renovation?",
            "nextDialogs": [
              "772100114"
            ]
          },
          "772100114": {
            "id": "772100114",
            "speakerId": 1002,
            "speakerName": "Churkaturin",
            "text": "Indeed, Traveler. I believe my home presently unfit for visitors. It is too narrow, too shabby, not hospitable enough by half...",
            "nextDialogs": [
              "772100115"
            ]
          },
          "772100115": {
            "id": "772100115",
            "speakerId": 1002,
            "speakerName": "Churkaturin",
            "text": "People would look upon it and think that our being forgotten was a mere inevitability. Why, this house would be evidence enough — the final symbol of a past kingdom, reduced to such ignominity.",
            "nextDialogs": [
              "772100116"
            ]
          },
          "772100116": {
            "id": "772100116",
            "speakerId": 1002,
            "speakerName": "Churkaturin",
            "text": "For the sake of what dignity remains to us, this expansion is necessary, lest others think that we decrepit spirits of yesteryear have lost any shred of decency.",
            "nextDialogs": [
              "772100117"
            ]
          },
          "772100117": {
            "id": "772100117",
            "speakerId": 1002,
            "speakerName": "Churkaturin",
            "text": "Alas, these wooden boxes have been, by my miscalculation, scattered in non-ideal locations.",
            "nextDialogs": [
              "772100118"
            ]
          },
          "772100118": {
            "id": "772100118",
            "speakerId": 1002,
            "speakerName": "Churkaturin",
            "text": "I cannot control the direction of my cabin, so I fear I must ask you to <color=cyan>pull it up next to these boxes</color>."
          }
        }
      }
    },

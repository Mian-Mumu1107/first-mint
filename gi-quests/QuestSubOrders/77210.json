        ],
        "dialogs": {
          "772100201": {
            "id": "772100201",
            "speakerId": 1002,
            "speakerName": "Churkaturin",
            "text": "My utmost gratitude I give you, shorebound traveler. I will remember the aid you have rendered.",
            "nextDialogs": [
              "772100202"
            ]
          },
          "772100202": {
            "id": "772100202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Once the renovations are complete, should we again meet, you may make yourself more than welcome in my abode.",
            "nextDialogs": [

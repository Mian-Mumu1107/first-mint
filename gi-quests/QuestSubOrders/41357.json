  "subQuests": [
    {
      "subId": "4135701",
      "subQuestName": "Talk to Brother Qian at night (21:00 – 05:00)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413570101"
        ],
        "dialogs": {
          "413570101": {
            "id": "413570101",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "Try the Illumiscreen...",
            "nextDialogs": [
              "413570102"
            ]
          },
          "413570102": {
            "id": "413570102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Illumi-what?",
            "nextDialogs": [
              "413570103"
            ]
          },
          "413570103": {
            "id": "413570103",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "Illumiscreen. What do you say? Come on, it's really simple.",
            "nextDialogs": [
              "413570104"
            ]
          },
          "413570104": {
            "id": "413570104",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "See those screens there? And these three lanterns?",
            "nextDialogs": [
              "413570105"
            ]
          },
          "413570105": {
            "id": "413570105",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "I had these lanterns made to order. When you turn them on, they cast all kinds of images.",
            "nextDialogs": [
              "413570106"
            ]
          },
          "413570106": {
            "id": "413570106",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "And if you rotate all three lanterns in the right way, the three images will combine to give you the full picture.",
            "nextDialogs": [
              "413570107"
            ]
          },
          "413570107": {
            "id": "413570107",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "Hmm, maybe I'm not explaining it clearly... Okay, how about this — have a go of rotating the lanterns first, and once you're comfortable with how it works, I'll tell you how the whole game works in more detail."
          }
        }
      }
    },
    {
      "subId": "4135702",

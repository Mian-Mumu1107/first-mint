  "subQuests": [
    {
      "subId": "2100800",
      "subQuestName": "Quest start",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210080000"
        ],
        "dialogs": {
          "210080000": {
            "id": "210080000",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "How have the torches gone out again...",
            "nextDialogs": [
              "210080001"
            ]
          },
          "210080001": {
            "id": "210080001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong with the torches?",
            "nextDialogs": [
              "210080002"
            ]
          },
          "210080002": {
            "id": "210080002",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "Ah, traveler. Look ahead, can you see three watchtowers? The torches on them should all be lit...",
            "nextDialogs": [
              "210080003"
            ]
          },
          "210080003": {
            "id": "210080003",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "The roads along Guili Plains can be difficult to traverse at the best of times, worse still when there are monsters out there in hiding. The torches aren't just to light the way for travelers, they also indicate that there is no threat from monsters.",
            "nextDialogs": [
              "210080004"
            ]
          },
          "210080004": {
            "id": "210080004",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "But... I was so busy clearing out monsters in the area that I completely forgot to stoke the fires. By the time I realized it was too late, and they'd all gone out."
          }
        }
      }
    },
    {
      "subId": "2100801",
      "subQuestName": "Second conversation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210080201"
        ],
        "dialogs": {
          "210080201": {
            "id": "210080201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright, I'll light them for you.",
            "nextDialogs": [
              "210080202"
            ]
          },
          "210080202": {
            "id": "210080202",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "That would be great. Thank you!",
            "nextDialogs": [
              "210080203"
            ]
          },
          "210080203": {
            "id": "210080203",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "Along this road there are three watchtowers, each with their own torch. After you've lit them all, make sure to come back and see me again, okay?",
            "nextDialogs": [
              "210080204"
            ]
          },
          "210080204": {
            "id": "210080204",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "At the end of the road, there is a Statue of The Seven. Perhaps while you are down that way you can visit it, perhaps receive the blessings of the Geo Lord.",
            "nextDialogs": [
              "210080205"
            ]
          },
          "210080205": {
            "id": "210080205",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "It may be easy but it still needs doing — so thank you, and please don't forget."
          }
        }
      }
    },
    {
      "subId": "2100802",
      "subQuestName": "Light the watchtower torch on the plains",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2100803",
      "subQuestName": "Light the torch",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210080301"
        ],
        "dialogs": {
          "210080301": {
            "id": "210080301",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "Please traveler, get the fires lit soon. The inspector could be here at any moment!"
          }
        }
      }
    },
    {
      "subId": "2100804",
      "subQuestName": "Light the torch",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210080401"
        ],
        "dialogs": {
          "210080401": {
            "id": "210080401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell me more about the road.",
            "nextDialogs": [
              "210080402"
            ]
          },
          "210080402": {
            "id": "210080402",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "Guili Plains sits atop a range of rock formations, so some areas are a bit more rugged, like the slope heading towards the watchtower west of here.",
            "nextDialogs": [
              "210080403"
            ]
          },
          "210080403": {
            "id": "210080403",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "To the east, towards the sea is quite flat, however. If you have the time you should head that way and check out Yaoguang Shoal."
          }
        }
      }
    },
    {
      "subId": "2100805",
      "subQuestName": "Light the torch",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210080501"
        ],
        "dialogs": {
          "210080501": {
            "id": "210080501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What about your colleagues?",
            "nextDialogs": [
              "210080502"
            ]
          },
          "210080502": {
            "id": "210080502",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "So they look after fueling the fires, while it's my responsibility to get them lit.",
            "nextDialogs": [
              "210080503"
            ]
          },
          "210080503": {
            "id": "210080503",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "Sure it sounds trivial, but it's important that we each perform our role."
          }
        }
      }
    },
    {
      "subId": "2100806",
      "subQuestName": "Rollback isolation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2100810",
      "subQuestName": "Talk to Xinghuo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210081001"
        ],
        "dialogs": {
          "210081001": {
            "id": "210081001",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "Phew... Alright, we should be all good now! Thanks for your help.",
            "nextDialogs": [
              "210081002"
            ]
          },
          "210081002": {
            "id": "210081002",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "This is for you, to say thanks."
          }
        }
      }
    },
    {
      "subId": "2100801",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210080101"
        ],
        "dialogs": {
          "210080101": {
            "id": "210080101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why can't you do it?",
            "nextDialogs": [
              "210080102"
            ]
          },
          "210080102": {
            "id": "210080102",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "Ah, it's 'cause they come to check the fires. If it's me here, I can buy a bit more time.",
            "nextDialogs": [
              "210080103"
            ]
          },
          "210080103": {
            "id": "210080103",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "It's no good if you stand here or if there's no-one here at all.",
            "nextDialogs": [
              "210080104"
            ]
          },
          "210080104": {
            "id": "210080104",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "So please, traveler, go and light the torches for me!"
          }
        }
      }
    },
    {
      "subId": "2100890",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210089000"
        ],
        "dialogs": {
          "210089000": {
            "id": "210089000",
            "speakerId": 2428,
            "speakerName": "Xinghuo",
            "text": "Wait! Could you help me? Could you go and light the torches in my place?",
            "nextDialogs": [
              "210089001"
            ]
          },
          "210089001": {
            "id": "210089001",

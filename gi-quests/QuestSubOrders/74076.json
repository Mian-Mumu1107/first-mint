    {
      "subId": "7407605",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740760501"
        ],
        "dialogs": {
          "740760501": {
            "id": "740760501",
            "speakerId": 20995,
            "speakerName": "Ann",
            "text": "Is that the \"Persona\" piece ahead?",
            "nextDialogs": [
              "740760502"
            ]
          },
          "740760502": {
            "id": "740760502",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "Unable to analyze the density of the substance before us. It appears to have a mass of... zero.",
            "nextDialogs": [
              "740760503"
            ]
          },
          "740760503": {
            "id": "740760503",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "It looks like we've got the last piece. We should at least be able to negotiate a bit with our opposition now.",
            "nextDialogs": [
              "740760504"
            ]
          },
          "740760504": {
            "id": "740760504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "On the bright side, at least we can stop the Narzissenkreuz Ordo from forging the Holy Blade.",
            "nextDialogs": [
              "740760505"
            ]
          },
          "740760505": {
            "id": "740760505",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Not at all, Paimon. Our final goal is to forge the Holy Blade ourselves, and use it to stop their plan.",
            "nextDialogs": [
              "740760506"
            ]
          },
          "740760506": {
            "id": "740760506",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Of course, Ann, I have not forgotten what this sword means to you.",
            "nextDialogs": [
              "740760507"
            ]
          },
          "740760507": {
            "id": "740760507",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "A Holy Sword that can cut out the will is also your key to unraveling the mystery. And to be honest, it is equally important to me as well.",
            "nextDialogs": [
              "740760508"
            ]
          },
          "740760508": {
            "id": "740760508",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "It's just that we have more important, more pressing matters at hand. Would you mind, then, if we looked into the mysteries surrounding us later?",
            "nextDialogs": [
              "740760509"
            ]
          },
          "740760509": {
            "id": "740760509",
            "speakerId": 20995,
            "speakerName": "Ann",
            "text": "I'm fine with that.",
            "nextDialogs": [
              "740760510"
            ]
          },
          "740760510": {
            "id": "740760510",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "#In that case, {NICKNAME}, please take this \"Persona\" with you, if you would."
          }
        }
      }
    },

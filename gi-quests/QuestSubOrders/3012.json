    {
      "subId": "301201",
      "subQuestName": "Talk to Nahida",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30120101"
        ],
        "dialogs": {
          "30120101": {
            "id": "30120101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Good morning, Nahida! Wait... Now that Paimon remembers everything, should we instead say, \"Good morning, Lesser Lord Kusanali\"?",
            "nextDialogs": [
              "30120102"
            ]
          },
          "30120102": {
            "id": "30120102",
            "speakerId": 1001,
            "speakerName": "Nahida",
            "text": "...",
            "nextDialogs": [
              "30120103"
            ]
          },
          "30120103": {
            "id": "30120103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, what's wrong, Nahida? You don't look too good...",
            "nextDialogs": [
              "30120106"
            ]
          },
          "30120106": {
            "id": "30120106",
            "speakerId": 1001,
            "speakerName": "Nahida",
            "text": "...I'm afraid that what you're thinking right now is correct...",
            "nextDialogs": [
              "30120107"
            ]
          },
          "30120107": {
            "id": "30120107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Did Dunyarzad already disappear? No way! Are... Are we too late?",
            "nextDialogs": [
              "30120108"
            ]
          },
          "30120108": {
            "id": "30120108",
            "speakerId": 1001,
            "speakerName": "Nahida",
            "text": "The real Dunyarzad's consciousness has indeed disappeared. It can no longer endure the constant dream harvesting."
          }
        }
      }
    },
    {
      "subId": "301202",
      "subQuestName": "Talk to Farris, the Knight of Flowers",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30120201"
        ],
        "dialogs": {
          "30120201": {
            "id": "30120201",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "Hm? You're back. You left in a hurry last time. Is everything okay?",
            "nextDialogs": [
              "30120202"
            ]
          },
          "30120202": {
            "id": "30120202",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Everything's fine, just... Umm, it's a little hard to explain. Uh, would you mind taking part in a little experiment with us?",
            "nextDialogs": [
              "30120203"
            ]
          },
          "30120203": {
            "id": "30120203",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "An experiment? That came out of nowhere... I'm listening, though. What do you need me to do?",
            "nextDialogs": [
              "30120204"
            ]
          },
          "30120204": {
            "id": "30120204",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Could you... make a wish?",
            "nextDialogs": [
              "30120205"
            ]
          },
          "30120205": {
            "id": "30120205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Imagine your wish coming true before your very eyes.",
            "nextDialogs": [
              "30120206"
            ]
          },
          "30120206": {
            "id": "30120206",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "You want me to make a wish? Is that a new Sabzeruz Festival tradition or something?",
            "nextDialogs": [
              "30120207"
            ]
          },
          "30120207": {
            "id": "30120207",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Less questions, more wishing!",
            "nextDialogs": [
              "30120208"
            ]
          },
          "30120208": {
            "id": "30120208",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "Okay, okay...",
            "nextDialogs": [
              "30120209"
            ]
          },
          "30120209": {
            "id": "30120209",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "My wish, my wish... Um, okay, I'm a little nervous saying this out loud, but... I want Miss Dunyarzad to be happy.",
            "nextDialogs": [
              "30120210"
            ]
          },
          "30120210": {
            "id": "30120210",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh...",
            "nextDialogs": [
              "30120211"
            ]
          },
          "30120211": {
            "id": "30120211",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "I noticed earlier that she looked a bit down, and she wasn't really talking to anyone.",
            "nextDialogs": [
              "30120212"
            ]
          },
          "30120212": {
            "id": "30120212",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "She just doesn't seem like herself. She's always so gentle and kind, and all the kids love her...",
            "nextDialogs": [
              "30120213"
            ]
          },
          "30120213": {
            "id": "30120213",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "I've also wondered if the reason she asked me to be Farris, Knight of Flowers is because I'm special to her, or something...",
            "nextDialogs": [
              "30120214"
            ]
          },
          "30120214": {
            "id": "30120214",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So... you have a crush on Dunyarzad?",
            "nextDialogs": [
              "30120215"
            ]
          },
          "30120215": {
            "id": "30120215",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "Uh, heh... Haha... Is it that obvious? Hmm, after what I just said, I guess it is.",
            "nextDialogs": [
              "30120216"
            ]
          },
          "30120216": {
            "id": "30120216",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "When she placed the hat of the Knight of Flowers onto my head, she said to me, \"I want everyone to have a happy Sabzeruz Festival.\"",
            "nextDialogs": [
              "30120217"
            ]
          },
          "30120217": {
            "id": "30120217",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "What she didn't realize was that I'm not that interested in how everyone else feels... In that moment, I just wanted to be her Knight of Flowers for the rest of my life. Fifty years, a hundred years... I'll serve her till the end of time.",
            "nextDialogs": [
              "30120218"
            ]
          },
          "30120218": {
            "id": "30120218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "30120219"
            ]
          },
          "30120219": {
            "id": "30120219",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "...Okay, yeah, that was a bit much. Felt like the right moment to get it off my chest, but... ahem, that was pretty embarrassing.",
            "nextDialogs": [
              "30120220"
            ]
          },
          "30120220": {
            "id": "30120220",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "Okay, I'm ready to make my wish: I would like Miss Dunyarzad to appear in front of me right now, with a smile on her face... Here goes...",
            "nextDialogs": [
              "30120221"
            ]
          },
          "30120221": {
            "id": "30120221",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Please come true...",
            "nextDialogs": [
              "30120222"
            ]
          },
          "30120222": {
            "id": "30120222",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Please come true...",
            "nextDialogs": [
              "30120223"
            ]
          },
          "30120223": {
            "id": "30120223",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "I'm gonna open my eyes, ho-ho!",
            "nextDialogs": [
              "30120224"
            ]
          },
          "30120224": {
            "id": "30120224",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "Oh... You're...!",
            "nextDialogs": [
              "30120225"
            ]
          },
          "30120225": {
            "id": "30120225",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What!?",
            "nextDialogs": [
              "30120226"
            ]
          },
          "30120226": {
            "id": "30120226",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "...Phaki? Sorry, but only one portion of Yalda Candies per person. Back home you go.",
            "nextDialogs": [
              "30120227"
            ]
          },
          "30120227": {
            "id": "30120227",
            "speakerId": 1002,
            "speakerName": "Vihar",
            "text": "Hahaha... Nice try, you two. Anyway, never mind, I don't need to see her appear right in front of me. As long as she's happy, hahaha...",
            "nextDialogs": [
              "30120228"
            ]
          },
          "30120228": {
            "id": "30120228",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "*sigh* Guess he isn't the host of this dream after all. Should've expected it wouldn't be this easy.",
            "nextDialogs": [
              "30120229"
            ]
          },
          "30120229": {
            "id": "30120229",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It seems like everyone who knows Dunyarzad loves her, but none of them has any idea that she...",
            "nextDialogs": [
              "30120230"
            ]
          },
          "30120230": {
            "id": "30120230",
            "speakerId": 1003,
            "speakerName": "Dehya",
            "text": "My lady, step back!",
            "nextDialogs": [
              "30120231"
            ]
          },
          "30120231": {
            "id": "30120231",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That sounds like Dehya! Oh, right, this is when Dunyarzad bumps into the kidnappers.",
            "nextDialogs": [
              "30120232"
            ]
          },
          "30120232": {
            "id": "30120232",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll teach them a lesson they won't forget.",
            "nextDialogs": [
              "30120233"
            ]
          },
          "30120233": {
            "id": "30120233",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? But Dehya can handle them... Hey, Traveler!"
          }
        }
      }
    },
    {
      "subId": "301203",
      "subQuestName": "Return to the accommodation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30120401"
        ],
        "dialogs": {
          "30120401": {
            "id": "30120401",
            "speakerId": 1003,
            "speakerName": "Dehya",
            "text": "...Oh? It's you. Great timing! Please take—",
            "nextDialogs": [
              "30120404"
            ]
          },
          "30120404": {
            "id": "30120404",
            "speakerId": 1003,
            "speakerName": "Dehya",
            "text": "Hey, this is my job. The Homayanis pay me, not you."
          }
        }
      }
    },
    {
      "subId": "301204",

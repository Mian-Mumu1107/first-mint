    {
      "subId": "301205",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30120501"
        ],
        "dialogs": {
          "30120501": {
            "id": "30120501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Traveler... Were you just taking your anger out on those guys?",
            "nextDialogs": [
              "30120504"
            ]
          },
          "30120504": {
            "id": "30120504",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "*sigh* You and Nahida both... Dunyarzad wouldn't want to see you two like this.",
            "nextDialogs": [
              "30120505"
            ]
          },
          "30120505": {
            "id": "30120505",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, and speaking of her... Paimon just remembered something.",
            "nextDialogs": [
              "30120506"
            ]
          },
          "30120506": {
            "id": "30120506",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Remember how during the first Sabzeruz Festival, before the samsara started, we came here with Dunyarzad because she wanted to pick something up?",
            "nextDialogs": [
              "30120507"
            ]
          },
          "30120507": {
            "id": "30120507",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "She said it was because she had forgotten something."
          }
        }
      }
    },
    {
      "subId": "301207",
      "subQuestName": "Talk to \"Dunyarzad\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30120601"
        ],
        "dialogs": {
          "30120601": {
            "id": "30120601",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's Dunyarzad's puppet...",
            "nextDialogs": [
              "30120604"
            ]
          },
          "30120604": {
            "id": "30120604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thank you.",
            "nextDialogs": [
              "30120605"
            ]
          },
          "30120605": {
            "id": "30120605",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Traveler...",
            "nextDialogs": [
              "30120606"
            ]
          },
          "30120606": {
            "id": "30120606",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You must be exhausted.",
            "nextDialogs": [
              "30120607"
            ]
          },
          "30120607": {
            "id": "30120607",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Come to think of it, we've been stuck in this place for a really, really long time. Heck, even the last time we were chatting happily with Dunyarzad feels like an eternity ago...",
            "nextDialogs": [
              "30120608"
            ]
          },
          "30120608": {
            "id": "30120608",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon still remembers when we were sitting here, and the way her eyes sparkled when she talked about Nilou's Dance of Sabzeruz...",
            "nextDialogs": [
              "30120609"
            ]
          },
          "30120609": {
            "id": "30120609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...I can barely recall it now.",
            "nextDialogs": [
              "30120610"
            ]
          },
          "30120610": {
            "id": "30120610",
            "speakerId": 1004,
            "speakerName": "Dunyarzad",
            "text": "...There will always be frustrations in life, but I know that the point of living is to not leave behind any regrets.",
            "nextDialogs": [
              "30120611"
            ]
          },
          "30120611": {
            "id": "30120611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "!?",
            "nextDialogs": [
              "30120612"
            ]
          },
          "30120612": {
            "id": "30120612",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That was what the real Dunyarzad said, wasn't it? Does that mean...!?",
            "nextDialogs": [
              "30120613"
            ]
          },
          "30120613": {
            "id": "30120613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Dunyarzad...?",
            "nextDialogs": [
              "30120614"
            ]
          },
          "30120614": {
            "id": "30120614",
            "speakerId": 1004,
            "speakerName": "Dunyarzad",
            "text": "Yes, Traveler? What is it?",
            "nextDialogs": [
              "30120615"
            ]
          },
          "30120615": {
            "id": "30120615",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "30120616"
            ]
          },
          "30120616": {
            "id": "30120616",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh... So she's still just a puppet. But just now... How come..."
          }
        }
      }
    },
    {
      "subId": "301209",
      "subQuestName": "Watch the Dance of Sabzeruz",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30120701"
        ],
        "dialogs": {
          "30120701": {
            "id": "30120701",
            "speakerId": 1005,
            "speakerName": "Setaria",
            "text": "If you continue to resist, we will have to order an investigation into every single event organizer...",
            "nextDialogs": [
              "30120702"
            ]
          },
          "30120702": {
            "id": "30120702",
            "speakerId": 1005,
            "speakerName": "Setaria",
            "text": "The Grand Sage has already granted you much leniency. I advise that you exercise tact.",
            "nextDialogs": [
              "30120703"
            ]
          },
          "30120703": {
            "id": "30120703",
            "speakerId": 1006,
            "speakerName": "Nilou",
            "text": "How... How did things turn out like this...",
            "nextDialogs": [
              "30120704"
            ]
          },
          "30120704": {
            "id": "30120704",
            "speakerId": 1006,
            "speakerName": "Nilou",
            "text": "Ahh... Traveler? You don't have to get involved. He's a sage from the Akademiya. I don't want to drag you into this...",
            "nextDialogs": [
              "30120705"
            ]
          },
          "30120705": {
            "id": "30120705",
            "speakerId": 1007,
            "speakerName": "Azar",
            "text": "...Traveler?",
            "nextDialogs": [
              "30120706"
            ]
          },
          "30120706": {
            "id": "30120706",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Traveler, what the heck are you doing!? If you get arrested by the Akademiya, that's another day gone to waste!",
            "nextDialogs": [
              "30120707"
            ]
          },
          "30120707": {
            "id": "30120707",
            "speakerId": 1007,
            "speakerName": "Azar",
            "text": "...",
            "nextDialogs": [
              "30120708"
            ]
          },
          "30120708": {
            "id": "30120708",
            "speakerId": 1005,
            "speakerName": "Setaria",
            "text": "...",
            "nextDialogs": [
              "30120709"
            ]
          },
          "30120709": {
            "id": "30120709",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait... They're not reacting! Have they been scared stiff...?",
            "nextDialogs": [
              "30120712"
            ]
          },
          "30120712": {
            "id": "30120712",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, of course! If this is the sages' plan, they wouldn't put themselves through this...",
            "nextDialogs": [
              "30120713"
            ]
          },
          "30120713": {
            "id": "30120713",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So they're just substitutes.",
            "nextDialogs": [
              "30120714"
            ]
          },
          "30120714": {
            "id": "30120714",
            "speakerId": 1006,
            "speakerName": "Nilou",
            "text": "What is this? What happened to the Grand Sage and his entourage?"
          }
        }
      }
    },
    {
      "subId": "301212",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30121001"
        ],
        "dialogs": {
          "30121001": {
            "id": "30121001",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "*yawn* Good morning, Traveler. Paimon feels like she's been asleep for the longest time...",
            "nextDialogs": [
              "30121004"
            ]
          },
          "30121004": {
            "id": "30121004",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...Paimon's head feels super heavy. Did we oversleep? ...Do you even remember going to sleep last night?",
            "nextDialogs": [
              "30121005"
            ]
          },
          "30121005": {
            "id": "30121005",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon thinks it was... after the Sabzeruz Festival...",
            "nextDialogs": [
              "30121006"
            ]
          },
          "30121006": {
            "id": "30121006",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "*gasp* The Sabzeruz Festival!",
            "nextDialogs": [
              "30121013"
            ]
          },
          "30121013": {
            "id": "30121013",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Have we finally escaped from the Sabzeruz samsara?",
            "nextDialogs": [
              "30121007"
            ]
          },
          "30121007": {
            "id": "30121007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I remember now!",
            "nextDialogs": [
              "30121014"
            ]
          },
          "30121014": {
            "id": "30121014",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Quick, take off your Akasha Terminal!"
          }
        }
      }
    },
    {
      "subId": "301210",
      "subQuestName": "Find Dunyarzad",
      "sceneId": null,

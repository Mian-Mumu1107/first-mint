  },
  "subQuests": [
    {
      "subId": "1112101",
      "subQuestName": "Head to the mining site that Uncle Dai mentioned",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111210101"
        ],
        "dialogs": {
          "111210101": {
            "id": "111210101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, this mine is huge...",
            "nextDialogs": [
              "111210102"
            ]
          },
          "111210102": {
            "id": "111210102",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "This is where the incident occurred.",
            "nextDialogs": [
              "111210103"
            ]
          },
          "111210103": {
            "id": "111210103",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Six days ago, a group of us left the site to attend to other matters. When we returned, the four men we'd left behind had vanished.",
            "nextDialogs": [
              "111210104"
            ]
          },
          "111210104": {
            "id": "111210104",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "I led a team around the entire mine but found no trace. That's when I decided to enlist help.",
            "nextDialogs": [
              "111210105"
            ]
          },
          "111210105": {
            "id": "111210105",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "So four miners have disappeared.",
            "nextDialogs": [
              "111210106"
            ]
          },
          "111210106": {
            "id": "111210106",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Yes. There were ten of us. We lost Long, Bold Cen, Brave Cen, and Mao. I worked with all of them.",
            "nextDialogs": [
              "111210107"
            ]
          },
          "111210107": {
            "id": "111210107",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Workers in this trade are usually young men in the prime of their lives. Could it be that the four of them left for another mine?",
            "nextDialogs": [
              "111210108"
            ]
          },
          "111210108": {
            "id": "111210108",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Unlikely. There's no other lodging for miles around, and we didn't pass any other mines on the way over.",
            "nextDialogs": [
              "111210109"
            ]
          },
          "111210109": {
            "id": "111210109",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Huh... such a huge mine. Did you really manage to explore every corner?",
            "nextDialogs": [
              "111210110"
            ]
          },
          "111210110": {
            "id": "111210110",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Underground, overground... we left no stone unturned. We tried everything short of digging further into the earth itself. How could four sturdy young men just vanish into the bedrock?",
            "nextDialogs": [
              "111210111"
            ]
          },
          "111210111": {
            "id": "111210111",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "We'll need to explore the site ourselves before extracting any conclusions.",
            "nextDialogs": [
              "111210112"
            ]
          },
          "111210112": {
            "id": "111210112",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Very well, I'll wait here, please proceed wherever you'd like. If you come across any clues, let me know straight away."
          }
        }
      }
    },
    {
      "subId": "1112104",
      "subQuestName": "Look for clues",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111210401"
        ],
        "dialogs": {
          "111210401": {
            "id": "111210401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Over here! What's this?",
            "nextDialogs": [
              "111210402"
            ]
          },
          "111210402": {
            "id": "111210402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A pile of shirts, some trousers...",
            "nextDialogs": [
              "111210403"
            ]
          },
          "111210403": {
            "id": "111210403",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "A few everyday items, they must belong to Uncle Dai and his men.",
            "nextDialogs": [
              "111210404"
            ]
          },
          "111210404": {
            "id": "111210404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "One, two, three, four...",
            "nextDialogs": [
              "111210405"
            ]
          },
          "111210405": {
            "id": "111210405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh... that seems right. Ten shirts, ten pairs of trousers.",
            "nextDialogs": [
              "111210406"
            ]
          },
          "111210406": {
            "id": "111210406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "These must be spares, right? Look, Uncle Dai's clothes are identical.",
            "nextDialogs": [
              "111210407"
            ]
          },
          "111210407": {
            "id": "111210407",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "The four of them have been gone for six days without a change of clothes.",
            "nextDialogs": [
              "111210408"
            ]
          },
          "111210408": {
            "id": "111210408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's also a few handkerchiefs and some soap lying around... Oh, and some tool belts.",
            "nextDialogs": [
              "111210409"
            ]
          },
          "111210409": {
            "id": "111210409",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Items for washing one's face before the dawn shift... mining equipment...",
            "nextDialogs": [
              "111210410"
            ]
          },
          "111210410": {
            "id": "111210410",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So... they didn't take any supplies...",
            "nextDialogs": [
              "111210411"
            ]
          },
          "111210411": {
            "id": "111210411",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Hmm, correct.",
            "nextDialogs": [
              "111210414"
            ]
          },
          "111210414": {
            "id": "111210414",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Improbable.",
            "nextDialogs": [
              "111210415"
            ]
          },
          "111210415": {
            "id": "111210415",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "There are four pickaxes missing. It seems likely they left with the tools of their trade.",
            "nextDialogs": [
              "111210416"
            ]
          },
          "111210416": {
            "id": "111210416",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "They had time to take their tools, but not their everyday items? Curious.",
            "nextDialogs": [
              "111210417"
            ]
          },
          "111210417": {
            "id": "111210417",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh... why would someone set off with their tools, but leave their luggage behind?",
            "nextDialogs": [
              "111210418"
            ]
          },
          "111210418": {
            "id": "111210418",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "One: They were working close by and didn't need to move their personal effects. But seeing as they've yet to return, this seems an unlikely hypothesis.",
            "nextDialogs": [
              "111210419"
            ]
          },
          "111210419": {
            "id": "111210419",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Or, two: They were forced to leave and had no time to think about their supplies.",
            "nextDialogs": [
              "111210420"
            ]
          },
          "111210420": {
            "id": "111210420",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh...!",
            "nextDialogs": [
              "111210421"
            ]
          },
          "111210421": {
            "id": "111210421",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you think... someone kidnapped them?",
            "nextDialogs": [
              "111210422"
            ]
          },
          "111210422": {
            "id": "111210422",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "It's certainly a possibility. We'll need more clues before any further inference can be made.",
            "nextDialogs": [
              "111210423"
            ]
          },
          "111210423": {
            "id": "111210423",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "If they didn't leave, maybe they were made to leave... Let's make a note and let Uncle Dai know."
          }
        }
      }
    },
    {
      "subId": "1112102",
      "subQuestName": "Look for more clues",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111210201"
        ],
        "dialogs": {
          "111210201": {
            "id": "111210201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kun Jun, what do you have there?",
            "nextDialogs": [
              "111210202"
            ]
          },
          "111210202": {
            "id": "111210202",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Oh, right on time.",
            "nextDialogs": [
              "111210203"
            ]
          },
          "111210203": {
            "id": "111210203",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Did you find anything?",
            "nextDialogs": [
              "111210204"
            ]
          },
          "111210204": {
            "id": "111210204",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "There's a chunk of ore here, perhaps there are clues within.",
            "nextDialogs": [
              "111210205"
            ]
          },
          "111210205": {
            "id": "111210205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ore? What does it have to do with the disappearance?",
            "nextDialogs": [
              "111210206"
            ]
          },
          "111210206": {
            "id": "111210206",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Let's find out. I'll give it a try. A moment please.",
            "nextDialogs": [
              "111210207"
            ]
          },
          "111210207": {
            "id": "111210207",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "... Okay...",
            "nextDialogs": [
              "111210208"
            ]
          },
          "111210208": {
            "id": "111210208",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "...",
            "nextDialogs": [
              "111210209"
            ]
          },
          "111210209": {
            "id": "111210209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh... Looks like he's concentrating really hard. What's he up to?",
            "nextDialogs": [
              "111210210"
            ]
          },
          "111210210": {
            "id": "111210210",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "I see... four men... following someone out of the mine... it looks like a child.",
            "nextDialogs": [
              "111210211"
            ]
          },
          "111210211": {
            "id": "111210211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A child? What's a child doing in a mine!?",
            "nextDialogs": [
              "111210212"
            ]
          },
          "111210212": {
            "id": "111210212",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "I'm not sure...",
            "nextDialogs": [
              "111210213"
            ]
          },
          "111210213": {
            "id": "111210213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Also, how did you \"see\" anything exactly?",
            "nextDialogs": [
              "111210214"
            ]
          },
          "111210214": {
            "id": "111210214",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Oh! I don't mean \"see\" in the traditional sense... I—I would appreciate it if what I'm about to tell you remained a secret. It's a little odd... I've never dared to tell anyone before.",
            "nextDialogs": [
              "111210215"
            ]
          },
          "111210215": {
            "id": "111210215",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "I can... perceive the memories of ore.",
            "nextDialogs": [
              "111210216"
            ]
          },
          "111210216": {
            "id": "111210216",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh—!?",
            "nextDialogs": [
              "111210217"
            ]
          },
          "111210217": {
            "id": "111210217",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "\"Perceive?\" So there's no... conjecture at work?",
            "nextDialogs": [
              "111210218"
            ]
          },
          "111210218": {
            "id": "111210218",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You mean you can put your hand on a rock and — boom! It just happens?",
            "nextDialogs": [
              "111210219"
            ]
          },
          "111210219": {
            "id": "111210219",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "I've always sensed that ore contains \"memories.\" Sometimes it records events that occur in the surrounding area. All I have to do is touch one and focus my attention, and the memories come to me.",
            "nextDialogs": [
              "111210220"
            ]
          },
          "111210220": {
            "id": "111210220",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Amazing! So you can find out everything that ever happened there!",
            "nextDialogs": [
              "111210221"
            ]
          },
          "111210221": {
            "id": "111210221",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "It depends on the ore. Some ores have astounding memories. Others, like Iron Ore and White Iron Ore aren't up to much. Their memories are hazy.",
            "nextDialogs": [
              "111210222"
            ]
          },
          "111210222": {
            "id": "111210222",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Cor Lapis and crystal memories are much stronger. They record more events and in greater detail.",
            "nextDialogs": [
              "111210223"
            ]
          },
          "111210223": {
            "id": "111210223",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Stone-seeing... fascinating. A rare ability indeed. It was prudent of Uncle Dai to recruit you, Mr. Kun Jun.",
            "nextDialogs": [
              "111210224"
            ]
          },
          "111210224": {
            "id": "111210224",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Haha, I'm glad I can be of assistance.",
            "nextDialogs": [
              "111210225"
            ]
          },
          "111210225": {
            "id": "111210225",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Based on what I saw, I believe they followed this path.",
            "nextDialogs": [
              "111210226"
            ]
          },
          "111210226": {
            "id": "111210226",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "This will take us north, away from the mine.",
            "nextDialogs": [
              "111210227"
            ]
          },
          "111210227": {
            "id": "111210227",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "North... another clue for Uncle Dai! Let's make a note of it."
          }
        }
      }
    },
    {
      "subId": "1112103",
      "subQuestName": "Look for more clues",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111210301"
        ],
        "dialogs": {
          "111210301": {
            "id": "111210301",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Excuse me sir, are you one of the workers here?",
            "nextDialogs": [
              "111210302"
            ]
          },
          "111210302": {
            "id": "111210302",
            "speakerId": 10378,
            "speakerName": "Bravo",
            "text": "Ah! Yes, yes! You must be here about the disappearance. Please find them if you can!",
            "nextDialogs": [
              "111210303"
            ]
          },
          "111210303": {
            "id": "111210303",
            "speakerId": 10378,
            "speakerName": "Bravo",
            "text": "I... I don't know what happened. The weather was gloomy that day, the foreman left with a few men.",
            "nextDialogs": [
              "111210304"
            ]
          },
          "111210304": {
            "id": "111210304",
            "speakerId": 10378,
            "speakerName": "Bravo",
            "text": "I stayed behind with the other four. After a while I decided to take a break... just to catch my breath!",
            "nextDialogs": [
              "111210305"
            ]
          },
          "111210305": {
            "id": "111210305",
            "speakerId": 10378,
            "speakerName": "Bravo",
            "text": "I ended up falling asleep in the shelter inside. When I woke up, there was no sight of them! I'd only just been speaking with them and suddenly... they'd vanished...",
            "nextDialogs": [
              "111210306"
            ]
          },
          "111210306": {
            "id": "111210306",
            "speakerId": 10378,
            "speakerName": "Bravo",
            "text": "Maybe... maybe I'm next...",
            "nextDialogs": [
              "111210307"
            ]
          },
          "111210307": {
            "id": "111210307",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "So the men that were out working disappeared, with the only one left to tell the tale having been asleep in a shelter.",
            "nextDialogs": [
              "111210308"
            ]
          },
          "111210308": {
            "id": "111210308",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Perhaps an accident occurred on-site.",
            "nextDialogs": [
              "111210309"
            ]
          },
          "111210309": {
            "id": "111210309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh... What a scary thought...",
            "nextDialogs": [
              "111210310"
            ]
          },
          "111210310": {
            "id": "111210310",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "An on-site accident... We should note that down too."
          }
        }
      }
    },
    {
      "subId": "1112107",
      "subQuestName": "Report the outcome of your investigation to Uncle Dai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111210701"
        ],
        "dialogs": {
          "111210701": {
            "id": "111210701",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "You're back! How are the investigations going?",
            "nextDialogs": [
              "111210702"
            ]
          },
          "111210702": {
            "id": "111210702",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "We found three clues in the vicinity.",
            "nextDialogs": [
              "111210703"
            ]
          },
          "111210703": {
            "id": "111210703",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "First, there are four missing pickaxes, yet everyday items are still in their place. This suggests that your men didn't leave of their own accord, but were forced to.",
            "nextDialogs": [
              "111210704"
            ]
          },
          "111210704": {
            "id": "111210704",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Forced to!? But... who would kidnap miners?",
            "nextDialogs": [
              "111210705"
            ]
          },
          "111210705": {
            "id": "111210705",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Who, indeed. Second, there were five workers at the mine. One of them left the site to take respite. When he awoke, his colleagues had disappeared without a trace.",
            "nextDialogs": [
              "111210706"
            ]
          },
          "111210706": {
            "id": "111210706",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Those who kept working all disappeared. The one who left early emerged safe and sound. It would appear that the incident occurred on-site.",
            "nextDialogs": [
              "111210707"
            ]
          },
          "111210707": {
            "id": "111210707",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Now that you mention it, I recall Bravo saying that he took a break.",
            "nextDialogs": [
              "111210708"
            ]
          },
          "111210708": {
            "id": "111210708",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Could someone have entered the site and simply walked away with them!?",
            "nextDialogs": [
              "111210709"
            ]
          },
          "111210709": {
            "id": "111210709",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "This leads me to my third point. Mr. Kun Jun here made good use of his... expert techniques... to arrive at a conclusion. It was a child that took your men away.",
            "nextDialogs": [
              "111210710"
            ]
          },
          "111210710": {
            "id": "111210710",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "A child!? But there are no settlements here for miles around! There's no way a child would have made it over to the mine!",
            "nextDialogs": [
              "111210711"
            ]
          },
          "111210711": {
            "id": "111210711",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Unlikely as it sounds, that's our conclusion. Your men were following a child.",
            "nextDialogs": [
              "111210712"
            ]
          },
          "111210712": {
            "id": "111210712",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Where did they go?",
            "nextDialogs": [
              "111210713"
            ]
          },
          "111210713": {
            "id": "111210713",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "We believe that they followed the road north, away from the mine and toward the ruins.",
            "nextDialogs": [
              "111210714"
            ]
          },
          "111210714": {
            "id": "111210714",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "North! Right, I'll rally my men and head in pursuit.",
            "nextDialogs": [
              "111210715"
            ]
          },
          "111210715": {
            "id": "111210715",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you need help?",
            "nextDialogs": [
              "111210716"
            ]
          },
          "111210716": {
            "id": "111210716",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "You've been invaluable to the investigation, but leave the legwork to us. If we set off now and make haste, we might be able to catch them.",
            "nextDialogs": [
              "111210717"
            ]
          },
          "111210717": {
            "id": "111210717",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Not so fast. The incident occurred six days ago. Even if they set out on foot, they will have covered a lot of ground by now.",
            "nextDialogs": [
              "111210718"
            ]
          },
          "111210718": {
            "id": "111210718",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "*sigh* You're right... New plan. I'll lead my search party over to the settlements further out and make some inquiries.",
            "nextDialogs": [
              "111210719"
            ]
          },
          "111210719": {
            "id": "111210719",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "There are only a few settlements around here with lodging for the night. We'll go investigate and see if we can come up with anything.",
            "nextDialogs": [
              "111210720"
            ]
          },
          "111210720": {
            "id": "111210720",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "In the meantime you could keep looking for clues. If we don't see each other, let's reconvene at Wangshu Inn tomorrow evening.",
            "nextDialogs": [
              "111210721"
            ]
          },
          "111210721": {
            "id": "111210721",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Agreed.",
            "nextDialogs": [
              "111210722"
            ]
          },
          "111210722": {
            "id": "111210722",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Alright, me and my men will get going!",
            "nextDialogs": [
              "111210723"
            ]
          },
          "111210723": {
            "id": "111210723",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So... they're gonna talk to the people over at the settlements, while we keep investigating here...",
            "nextDialogs": [
              "111210724"
            ]
          },
          "111210724": {
            "id": "111210724",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Correct.",
            "nextDialogs": [
              "111210725"
            ]
          },
          "111210725": {
            "id": "111210725",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But... there aren't any more clues at the mine... Shouldn't we go north?",
            "nextDialogs": [
              "111210726"
            ]
          },
          "111210726": {
            "id": "111210726",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Wait... I believe we're missing someone.",
            "nextDialogs": [
              "111210727"
            ]
          },
          "111210727": {
            "id": "111210727",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh?",
            "nextDialogs": [
              "111210728"
            ]
          },
          "111210728": {
            "id": "111210728",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh yeah, where's Kun Jun? Paimon bets he's still investigating. Let's go find him!"
          }
        }
      }
    },
    {
      "subId": "1112108",
      "subQuestName": "Find Kun Jun",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111210801"
        ],
        "dialogs": {
          "111210801": {
            "id": "111210801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kun Jun! What are you searching for? We're all out of clues! Let's get going!",
            "nextDialogs": [
              "111210802"
            ]
          },
          "111210802": {
            "id": "111210802",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Ah, apologies, I'm conducting a quick search for my own benefit. I'm looking for a precious stone known as Dragonfall.",
            "nextDialogs": [
              "111210803"
            ]
          },
          "111210803": {
            "id": "111210803",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Dragonfall?",
            "nextDialogs": [
              "111210806"
            ]
          },
          "111210806": {
            "id": "111210806",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Dragonfall is often used in forging. What use do you have for it?",
            "nextDialogs": [
              "111210807"
            ]
          },
          "111210807": {
            "id": "111210807",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "I... I don't know.",
            "nextDialogs": [
              "111210808"
            ]
          },
          "111210808": {
            "id": "111210808",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "I—I'm sorry, I don't recall why I'm seeking it... I've been feeling very... absent lately. Name and address aside, I'm having trouble remembering things.",
            "nextDialogs": [
              "111210809"
            ]
          },
          "111210809": {
            "id": "111210809",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "In fact, I've been feeling extremely... anxious... as if there's something I've forgotten to finish. It's... an unpleasant sensation.",
            "nextDialogs": [
              "111210810"
            ]
          },
          "111210810": {
            "id": "111210810",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, Paimon knows that feeling! When you know you've forgotten something but you can't remember exactly what it is.",
            "nextDialogs": [
              "111210811"
            ]
          },
          "111210811": {
            "id": "111210811",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Ugh... I don't even know where to start with it, I've been... aimlessly wandering. That day at the market, I overheard a conversation while I was buying something. They mentioned Dragonfall.",
            "nextDialogs": [
              "111210812"
            ]
          },
          "111210812": {
            "id": "111210812",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "It sounded so familiar to me, as if whatever it was I had to do was linked to that stone... So I decided to look for some.",
            "nextDialogs": [
              "111210813"
            ]
          },
          "111210813": {
            "id": "111210813",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Perhaps if I can retrieve some, I'll remember what it is I have to do.",
            "nextDialogs": [
              "111210814"
            ]
          },
          "111210814": {
            "id": "111210814",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "I see... If I am able to during our endeavour, I will help you look for this stone.",
            "nextDialogs": [
              "111210815"
            ]
          },
          "111210815": {
            "id": "111210815",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Really? Oh, thank you Mr. Zhongli! You're too kind!",
            "nextDialogs": [
              "111210816"
            ]
          },
          "111210816": {
            "id": "111210816",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Think nothing of it.",
            "nextDialogs": [
              "111210817"
            ]
          },
          "111210817": {
            "id": "111210817",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Shouldn't we get going?",
            "nextDialogs": [
              "111210818"
            ]
          },
          "111210818": {
            "id": "111210818",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Heading north from The Chasm, we'll reach Lingju Pass. If this is indeed the path they chose, there will be traces.",
            "nextDialogs": [
              "111210819"
            ]
          },
          "111210819": {
            "id": "111210819",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Great! Let's have a look!"
          }
        }
      }
    },
    {
      "subId": "1112109",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111210901"
        ],
        "dialogs": {
          "111210901": {
            "id": "111210901",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "We'll work more efficiently if we split up. I'll start my investigations here.",
            "nextDialogs": [
              "111210902"
            ]
          },
          "111210902": {
            "id": "111210902",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Hmm... let's start with the details... what type of rocks do we have here..."
          }
        }
      }
    },
    {
      "subId": "1112110",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

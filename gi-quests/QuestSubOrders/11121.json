        ],
        "dialogs": {
          "111211001": {
            "id": "111211001",
            "speakerId": 10424,
            "speakerName": "Observe Stone",
            "text": "(It looks like... some sort of Cor Lapis?)",
            "nextDialogs": [
              "111211002"
            ]
          },
          "111211002": {
            "id": "111211002",
            "speakerId": 10424,
            "speakerName": "Observe Stone",
            "text": "(It was able to record the information we needed. A curious stone, indeed.)"
          }
        }
      }
    },
    {
      "subId": "1112121",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111212101"
        ],
        "dialogs": {
          "111212101": {
            "id": "111212101",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "I'll leave the investigations to you."
          }
        }
      }
    },
    {
      "subId": "1112122",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111212201"
        ],
        "dialogs": {
          "111212201": {
            "id": "111212201",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Could it be that the child I saw kidnapped them? Hmm..."
          }
        }
      }
    },
    {
      "subId": "1112123",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111212301"
        ],
        "dialogs": {
          "111212301": {
            "id": "111212301",
            "speakerId": 10378,
            "speakerName": "Bravo",
            "text": "Where did my friends disappear to? Ugh... I tremble just thinking about it."
          }
        }
      }
    },
    {
      "subId": "1112199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111219901"
        ],
        "dialogs": {
          "111219901": {
            "id": "111219901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We've found some clues. Time to report back to Uncle Dai."
          }
        }
      }

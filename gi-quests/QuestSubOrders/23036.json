    {
      "subId": "2303601",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230360101"
        ],
        "dialogs": {
          "230360101": {
            "id": "230360101",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "Please try the new bait again, Mr. Kayvan.",
            "nextDialogs": [
              "230360102"
            ]
          },
          "230360102": {
            "id": "230360102",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "I've done that so many times, but the results are just the same as before!",
            "nextDialogs": [
              "230360103"
            ]
          },
          "230360103": {
            "id": "230360103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Why are the two of you fishing together again?",
            "nextDialogs": [
              "230360104"
            ]
          },
          "230360104": {
            "id": "230360104",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Traveler, we meet again.",
            "nextDialogs": [
              "230360105"
            ]
          },
          "230360105": {
            "id": "230360105",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "Hello, you two.",
            "nextDialogs": [
              "230360108"
            ]
          },
          "230360108": {
            "id": "230360108",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Haha! Nope. A researcher and I tried methods like modifying the fishing rod, adjusting the bait, and improving our techniques.",
            "nextDialogs": [
              "230360109"
            ]
          },
          "230360109": {
            "id": "230360109",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "We tried so many different bodies of water and angles... I even tried fishing in a pond full of fish.",
            "nextDialogs": [
              "230360110"
            ]
          },
          "230360110": {
            "id": "230360110",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "But no matter what I did, I could only fish up things that aren't fish.",
            "nextDialogs": [
              "230360111"
            ]
          },
          "230360111": {
            "id": "230360111",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "Don't worry, Mr. Kayvan. Didn't that researcher promise to keep researching? He'll definitely determine the reason behind all this for us.",
            "nextDialogs": [
              "230360112"
            ]
          },
          "230360112": {
            "id": "230360112",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "See, he even designed a new bait for you, and he wants me to stay here with you and record every detail about your fishing process down...",
            "nextDialogs": [
              "230360113"
            ]
          },
          "230360113": {
            "id": "230360113",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "I hope he really succeeds... But until then, I'll just continue fishing my way.",
            "nextDialogs": [
              "230360114"
            ]
          },
          "230360114": {
            "id": "230360114",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "If you would, Traveler, could you get me some more material for bait?"
          }
        }
      }
    },

    {
      "subId": "2303603",
      "subQuestName": "Talk to Helbet and Kayvan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230360601"
        ],
        "dialogs": {
          "230360601": {
            "id": "230360601",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Not bad. Now, it's time to fish. I'm gonna catch a big one this time!",
            "nextDialogs": [
              "230360602"
            ]
          },
          "230360602": {
            "id": "230360602",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Kayvan prepares the bait and begins fishing...",
            "nextDialogs": [
              "230360603"
            ]
          },
          "230360603": {
            "id": "230360603",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Kayvan catches a wet package a short while later...",
            "nextDialogs": [
              "230360604"
            ]
          },
          "230360604": {
            "id": "230360604",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "Uh... Let me have a look...",
            "nextDialogs": [
              "230360605"
            ]
          },
          "230360605": {
            "id": "230360605",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "Huh? The things in here... They seem like lost items again...",
            "nextDialogs": [
              "230360608"
            ]
          },
          "230360608": {
            "id": "230360608",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "Uh... We've been fishing ever since Mr. Kayvan and I went to that researcher to modify our bait...",
            "nextDialogs": [
              "230360609"
            ]
          },
          "230360609": {
            "id": "230360609",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "But Mr. Kayvan still fishes up strange things every single time.",
            "nextDialogs": [
              "230360610"
            ]
          },
          "230360610": {
            "id": "230360610",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "Including lost items, ore from the bottom of the river, packages that fell off ships...",
            "nextDialogs": [
              "230360611"
            ]
          },
          "230360611": {
            "id": "230360611",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "Even some adventurer who accidentally fell into the water once grabbed onto Mr. Kayvan's fishing line to get out of the water...",
            "nextDialogs": [
              "230360612"
            ]
          },
          "230360612": {
            "id": "230360612",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "But we just can't catch any fish...",
            "nextDialogs": [
              "230360613"
            ]
          },
          "230360613": {
            "id": "230360613",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "My fishing career has come to its end...",
            "nextDialogs": [
              "230360614"
            ]
          },
          "230360614": {
            "id": "230360614",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "M—Mr. Kayvan! Cheer up! L—Look, the owner of this thing is definitely anxious.",
            "nextDialogs": [
              "230360615"
            ]
          },
          "230360615": {
            "id": "230360615",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "He'll definitely be overjoyed that you fished it up.",
            "nextDialogs": [
              "230360616"
            ]
          },
          "230360616": {
            "id": "230360616",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "We may even be compensated when we take these lost items back to the Adventurers' Guild!",
            "nextDialogs": [
              "230360617"
            ]
          },
          "230360617": {
            "id": "230360617",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "But... I really! I really just want—",
            "nextDialogs": [
              "230360618"
            ]
          },
          "230360618": {
            "id": "230360618",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "I really just want to catch a fish!"
          }
        }
      }
    },

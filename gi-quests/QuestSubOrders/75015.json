  "subQuests": [
    {
      "subId": "7501501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750150101"
        ],
        "dialogs": {
          "750150101": {
            "id": "750150101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yikes, that's one strong fish. How's it still able to swim so fast, even after such a long struggle...",
            "nextDialogs": [
              "750150102"
            ]
          },
          "750150102": {
            "id": "750150102",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawrrr...",
            "nextDialogs": [
              "750150103"
            ]
          },
          "750150103": {
            "id": "750150103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#No worries, {NICKNAME}'ll definitely be able to catch it again!"
          }
        }
      }
    },
    {
      "subId": "7501506",
      "subQuestName": "Talk to your Saurian companion",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750150601"
        ],
        "dialogs": {
          "750150601": {
            "id": "750150601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This shallow water beach looks great! It's warm, bright, and there are fishing rods set up here. Maybe this would make a good fishing spot!",
            "nextDialogs": [
              "750150602"
            ]
          },
          "750150602": {
            "id": "750150602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why don't we try fishing here?",
            "nextDialogs": [
              "750150603"
            ]
          },
          "750150603": {
            "id": "750150603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe I'll catch myself another travel guide...",
            "nextDialogs": [
              "750150604"
            ]
          },
          "750150604": {
            "id": "750150604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No way, Paimon vetoes that idea. Besides, there's only one Paimon, and you already caught her!",
            "nextDialogs": [
              "750150605"
            ]
          },
          "750150605": {
            "id": "750150605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Paimon's talking about fish-fishing! It's been a while since we last ate fish you caught and cooked yourself... Plus, it's about time you gave {REALNAME[ID(2)|SHOWHOST(true)]} a taste of your culinary wizardry!",
            "nextDialogs": [
              "750150606"
            ]
          },
          "750150606": {
            "id": "750150606",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750150607"
            ]
          },
          "750150607": {
            "id": "750150607",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hehe, it's all for poor old {REALNAME[ID(2)|SHOWHOST(true)]}, y'know...",
            "nextDialogs": [
              "750150608"
            ]
          },
          "750150608": {
            "id": "750150608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Then why don't you get involved too, Paimon...",
            "nextDialogs": [
              "750150609"
            ]
          },
          "750150609": {
            "id": "750150609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How about... you do the fishing this time, Paimon?",
            "nextDialogs": [
              "750150610"
            ]
          },
          "750150610": {
            "id": "750150610",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? You want P—Paimon... to do the fishing?",
            "nextDialogs": [
              "750150611"
            ]
          },
          "750150611": {
            "id": "750150611",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr! Rawr!",
            "nextDialogs": [
              "750150612"
            ]
          },
          "750150612": {
            "id": "750150612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#All for poor old {REALNAME[ID(2)|SHOWHOST(true)]}, eh?",
            "nextDialogs": [
              "750150613"
            ]
          },
          "750150613": {
            "id": "750150613",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How... How could you, catching Paimon out with her own words like that!",
            "nextDialogs": [
              "750150614"
            ]
          },
          "750150614": {
            "id": "750150614",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, alright then... But be warned, Paimon has no idea what she'll catch, if anything!",
            "nextDialogs": [
              "750150615"
            ]
          },
          "750150615": {
            "id": "750150615",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Plus, before that... Ace Angler Paimon needs a nice, tidy environment to work her magic in. What if the line gets snagged on all that junk floating around in the water?",
            "nextDialogs": [
              "750150616"
            ]
          },
          "750150616": {
            "id": "750150616",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's tidy up the area a bit first!"
          }
        }
      }
    },
    {
      "subId": "7501502",
      "subQuestName": "Clean up the nearby waters",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7501505",
      "subQuestName": "Wait for Paimon to fish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750150501"
        ],
        "dialogs": {
          "750150501": {
            "id": "750150501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Phew, nice and tidy at last... G—Guess it's time for Paimon to get started with the fishing!",
            "nextDialogs": [
              "750150502"
            ]
          },
          "750150502": {
            "id": "750150502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Just you wait and see, Paimon's gonna catch a big one!",
            "nextDialogs": [
              "750150503"
            ]
          },
          "750150503": {
            "id": "750150503",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Sadly, the surface stays as still as a mirror, without a ripple in sight.",
            "nextDialogs": [
              "750150504"
            ]
          },
          "750150504": {
            "id": "750150504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh... Is there something wrong with the water here? The fish don't seem to want to come out, at all!",
            "nextDialogs": [
              "750150506",
              "750150509"
            ]
          },
          "750150506": {
            "id": "750150506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So close! Yet... so far. Ugh, why does it feel like this is gonna take forever...",
            "nextDialogs": [
              "750150507"
            ]
          },
          "750150507": {
            "id": "750150507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's a bit early to be getting Paimon's hopes up!",
            "nextDialogs": [
              "750150511"
            ]
          },
          "750150511": {
            "id": "750150511",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr...",
            "nextDialogs": [
              "750150512"
            ]
          },
          "750150512": {
            "id": "750150512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You've got it! You've got it!",
            "nextDialogs": [
              "750150513"
            ]
          },
          "750150513": {
            "id": "750150513",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, stop being such a distraction... Jeez!",
            "nextDialogs": [
              "750150514"
            ]
          },
          "750150514": {
            "id": "750150514",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ehh!? We've got a bite, we've got a bite! Time to reel it in and see what Paimon's caught!",
            "nextDialogs": [
              "750150515"
            ]
          },
          "750150515": {
            "id": "750150515",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#What the... that's not a fish, it's a bottle! And it's even tied to one of the wooden planks at the fishing spot... Ugh, well, the fact that you always catch strange things too makes Paimon feel a little better, {NICKNAME}...",
            "nextDialogs": [
              "750150516"
            ]
          },
          "750150516": {
            "id": "750150516",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You seem to be able to catch anything... but fish.",
            "nextDialogs": [
              "750150517"
            ]
          },
          "750150517": {
            "id": "750150517",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, you catch weird stuff all the time too! Anyway, seeing as Paimon already caught it, we might as well take a look at what's inside...",
            "nextDialogs": [
              "750150518"
            ]
          },
          "750150518": {
            "id": "750150518",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Could it have been these two that left behind that pile of stuff just now? People who are this obsessed with fishing are... pretty scary, huh...",
            "nextDialogs": [
              "750150519"
            ]
          },
          "750150519": {
            "id": "750150519",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems like they're using this bottle to pass messages to one another... We'd better throw it back.",
            "nextDialogs": [
              "750150520"
            ]
          },
          "750150520": {
            "id": "750150520",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aaaanyway, Paimon has a funny feeling that it'll definitely be a fish next time!",
            "nextDialogs": [
              "750150521"
            ]
          },
          "750150521": {
            "id": "750150521",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The rod suddenly drops downwards and starts being violently tugged.\\nSeems like something big and heavy deep down below has taken the bait...",
            "nextDialogs": [
              "750150522"
            ]
          },
          "750150522": {
            "id": "750150522",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A bite, at last! Must be one heckuva fish... Up you come, you big lump!",
            "nextDialogs": [
              "750150523"
            ]
          },
          "750150523": {
            "id": "750150523",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's right, you big lump! Up you come!",
            "nextDialogs": [
              "750150524"
            ]
          },
          "750150524": {
            "id": "750150524",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "R—Rawr!",
            "nextDialogs": [
              "750150525"
            ]
          },
          "750150525": {
            "id": "750150525",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "#Seeing Paimon struggling,\\nyou and {REALNAME[ID(2)|SHOWHOST(true)]} grab hold of her...\\nBut the line is being pulled with such unstoppable force...",
            "nextDialogs": [
              "750150526"
            ]
          },
          "750150526": {
            "id": "750150526",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Finally, with a mighty plop, the fish escapes...",
            "nextDialogs": [
              "750150527"
            ]
          },
          "750150527": {
            "id": "750150527",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*sobs* That must have been a huge one, otherwise it would never have gotten away!",
            "nextDialogs": [
              "750150528"
            ]
          },
          "750150528": {
            "id": "750150528",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, so annoying... Huh? It's still swimming around near the surface! Seriously!?",
            "nextDialogs": [
              "750150529"
            ]
          },
          "750150529": {
            "id": "750150529",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawrr—",
            "nextDialogs": [
              "750150530"
            ]
          },
          "750150530": {
            "id": "750150530",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No no no, the sea's too dangerous! And you'll never catch up with it anyway...",
            "nextDialogs": [
              "750150531"
            ]
          },
          "750150531": {
            "id": "750150531",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr...",
            "nextDialogs": [
              "750150532"
            ]
          },
          "750150532": {
            "id": "750150532",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#If only we could find a way to catch that fish, {NICKNAME}..."
          },
          "750150509": {
            "id": "750150509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, you're probably right. After all, once the bites start coming, it all happens so fast. Like when you go to pick a Sweet Flower, but it turns out to be a Whopperflower...",
            "nextDialogs": [
              "750150510"
            ]
          },
          "750150510": {
            "id": "750150510",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "All you gotta do is stay focused and wait... and wait..."
          }
        }
      }
    },
    {
      "subId": "7501503",
      "subQuestName": "Catch the fleeing fish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7501504",
      "subQuestName": "Bring the fish back to shore",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750150401"
        ],
        "dialogs": {
          "750150401": {
            "id": "750150401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Tada! What did Paimon tell ya? If anyone could get the better of this slippery customer, it'd be {NICKNAME}!",
            "nextDialogs": [
              "750150402"
            ]
          },
          "750150402": {
            "id": "750150402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Speaking of skills, if we just threw in all the bait and let the fish get so full that they turned over and floated up to the surface... that would still count as \"fishing,\" right?",
            "nextDialogs": [
              "750150403"
            ]
          },
          "750150403": {
            "id": "750150403",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrrar... Rawr...",
            "nextDialogs": [
              "750150404"
            ]
          },
          "750150404": {
            "id": "750150404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hehe, you think so too, don't you, {REALNAME[ID(2)|SHOWHOST(true)]}? Paimon can tell just from the way your eyes are twinkling! Hehe, let's give it a try next time...",
            "nextDialogs": [
              "750150405"
            ]
          },
          "750150405": {
            "id": "750150405",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawrrr...",
            "nextDialogs": [
              "750150406"
            ]
          },
          "750150406": {
            "id": "750150406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Wait a sec, it's not done yet! We have to wait for {NICKNAME} to finish cooking it first!",
            "nextDialogs": [
              "750150407"
            ]
          },
          "750150407": {
            "id": "750150407",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Once the fish is finished grilling, everyone sits down and eats their fill.",
            "nextDialogs": [
              "750150408"
            ]
          },
          "750150408": {
            "id": "750150408",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750150409"
            ]
          },
          "750150409": {
            "id": "750150409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wah... Even as Grilled Fish goes, that was something special. You can really tell that Paimon was the one who caught it, hehe!",
            "nextDialogs": [
              "750150410"
            ]
          },
          "750150410": {
            "id": "750150410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Great job, Paimon! You're in charge of fishing from here on out!",
            "nextDialogs": [
              "750150411"
            ]
          },
          "750150411": {
            "id": "750150411",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhhh... *sigh*",
            "nextDialogs": [
              "750150412"
            ]
          },
          "750150412": {
            "id": "750150412",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750150413"
            ]
          },
          "750150413": {
            "id": "750150413",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hey, there's no such thing as a free lunch, y'know, {REALNAME[ID(2)|SHOWHOST(true)]}! You'll have to help out too next time — if you want any fish, that is!",
            "nextDialogs": [
              "750150414"
            ]
          },
          "750150414": {
            "id": "750150414",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrrawr?",
            "nextDialogs": [
              "750150415"
            ]
          },
          "750150415": {
            "id": "750150415",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph, look who's playing dumb now!"
          }
        }
      }
    }
  ]
}
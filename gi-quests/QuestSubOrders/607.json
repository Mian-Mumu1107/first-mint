        "dialogs": {
          "6070201": {
            "id": "6070201",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Fear not. The foul monsters have been cast into the void.",
            "nextDialogs": [
              "6070202"
            ]
          },
          "6070202": {
            "id": "6070202",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "Mein Fräulein means to say that you should refrain from going out for the time being. We will continue to protect this area.",
            "nextDialogs": [
              "6070203"
            ]
          },
          "6070203": {
            "id": "6070203",
            "speakerId": 15262,
            "speakerName": "Parsley",
            "text": "Thank you! Thank you so much!",
            "nextDialogs": [
              "6070204"
            ]
          },
          "6070204": {
            "id": "6070204",
            "speakerId": 15262,
            "speakerName": "Parsley",
            "text": "But, um... I've never seen a bird that can, uh... talk, heh...",
            "nextDialogs": [
              "6070205"
            ]
          },
          "6070205": {
            "id": "6070205",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "Ah, no need to worry. I'm mein Fräulein's humble servant. Please rest assured, I'm not a danger to you.",
            "nextDialogs": [
              "6070206"
            ]
          },
          "6070206": {
            "id": "6070206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You can trust them. I promise.",
            "nextDialogs": [
              "6070207"
            ]
          },
          "6070207": {
            "id": "6070207",
            "speakerId": 15262,
            "speakerName": "Parsley",
            "text": "Oh, no. Of course! I didn't mean it that way at all. I just, uh, misspoke...",
            "nextDialogs": [
              "6070208"
            ]
          },
          "6070208": {
            "id": "6070208",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Hmph, no matter.",
            "nextDialogs": [
              "6070209"
            ]
          },
          "6070209": {
            "id": "6070209",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "My vassals have unfinished duties, yes? Then, go forth and smite these wretched beasts. The Prinzessin's blessing shall illuminate your path!"
          }
        }
      }

      }
    },
    {
      "subId": "7183105",
      "subQuestName": "Talk to Wang Ping'an",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718310501"
        ],
        "dialogs": {
          "718310501": {
            "id": "718310501",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "All done? How do you feel?",
            "nextDialogs": [
              "718310502"
            ]
          },
          "718310502": {
            "id": "718310502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pretty good.",
            "nextDialogs": [
              "718310503"
            ]
          },
          "718310503": {
            "id": "718310503",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "Wonderful. I hope that there will always be incense alight in this temple...",
            "nextDialogs": [
              "718310504"
            ]
          },
          "718310504": {
            "id": "718310504",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "I will remain here for a while. This is a quiet spot, perfect for my compilation work.",
            "nextDialogs": [
              "718310505"
            ]
          },
          "718310505": {
            "id": "718310505",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "I need to get those materials that I gathered sorted out and continue to compile my book about the Vigilant Yaksha.",
            "nextDialogs": [
              "718310506"
            ]
          },
          "718310506": {
            "id": "718310506",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "If you have the time, you can drop by this temple and check on things.",
            "nextDialogs": [
              "718310507"
            ]
          },
          "718310507": {
            "id": "718310507",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "If you ever want to offer incense, just get some from me.",
            "nextDialogs": [
              "718310508"
            ]
          },
          "718310508": {
            "id": "718310508",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "*sigh* I'd actually love to do some repairs to the surrounding area, as well...",
            "nextDialogs": [
              "718310509"
            ]
          },
          "718310509": {
            "id": "718310509",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "The path needs repaving, with fences on either side, and we should have a flowerbed nearby..."
          }
        }
      }
    },
    {
      "subId": "7183003",
      "subQuestName": "Additional",

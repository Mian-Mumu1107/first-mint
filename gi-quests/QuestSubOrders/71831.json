        ],
        "dialogs": {
          "718310201": {
            "id": "718310201",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "The censer is right there. If you want to offer incense, go right ahead."
          }
        }
      }
    },
    {
      "subId": "7183103",
      "subQuestName": "Talk to Wang Ping'an",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718310301"
        ],
        "dialogs": {
          "718310301": {
            "id": "718310301",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "The temple's looking the part now...",
            "nextDialogs": [
              "718310302"
            ]
          },
          "718310302": {
            "id": "718310302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It is, yes.",
            "nextDialogs": [
              "718310303"
            ]
          },
          "718310303": {
            "id": "718310303",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "Eh? Oh, you've got impeccable timing, haven't you? The repairs have just been completed, and I've just finished paying the laborers.",
            "nextDialogs": [
              "718310304"
            ]
          },
          "718310304": {
            "id": "718310304",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "Ah... I didn't think that it would cost this much Mora. I've more or less sunk all my earnings into this place...",
            "nextDialogs": [
              "718310305"
            ]
          },
          "718310305": {
            "id": "718310305",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "But anyway. The important thing is that the temple has been rebuilt.",
            "nextDialogs": [
              "718310306"
            ]
          },
          "718310306": {
            "id": "718310306",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "Would you like to offer some incense? I made a point of getting a new Censer made.",
            "nextDialogs": [
              "718310310",
              "718310309"
            ]
          },
          "718310310": {
            "id": "718310310",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "Take these incense sticks. The censer's right over there."
          },
          "718310309": {
            "id": "718310309",
            "speakerId": 1000,
            "speakerName": "Wang Ping'an",
            "text": "Of course I have. I was the first to do so once the refurbishment was complete, in fact."
          }
        }
      }
    },
    {
      "subId": "7183104",
      "subQuestName": "Offer incense to Pervases",
      "sceneId": null,
      "locations": [],

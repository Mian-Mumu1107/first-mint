        "dialogs": {
          "719140101": {
            "id": "719140101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you have anything else?",
            "nextDialogs": [
              "719140102"
            ]
          },
          "719140102": {
            "id": "719140102",
            "speakerId": 1000,
            "speakerName": "Linlang",
            "text": "Well, take this chunk of rock, for example. Looks perfectly ordinary, but in fact it came from a star.",
            "nextDialogs": [
              "719140103"
            ]
          },
          "719140103": {
            "id": "719140103",
            "speakerId": 1000,
            "speakerName": "Linlang",
            "text": "A very long time ago, a star fell from the sky. The force of the impact when it hit the ground is what turned it this color on the outside.",
            "nextDialogs": [
              "719140104"
            ]
          },
          "719140104": {
            "id": "719140104",
            "speakerId": 1000,
            "speakerName": "Linlang",
            "text": "Hmm? What do you mean, looks like a regular chunk of ore?",
            "nextDialogs": [
              "719140105"
            ]
          },
          "719140105": {
            "id": "719140105",
            "speakerId": 1000,
            "speakerName": "Linlang",
            "text": "...Wait, no, you're right, sorry. I grabbed the wrong one. This is just a regular chunk of ore.",
            "nextDialogs": [
              "719140106"
            ]
          },
          "719140106": {
            "id": "719140106",
            "speakerId": 1000,
            "speakerName": "Linlang",
            "text": "Ugh, must be the suppliers. They're always trying to sneak the odd dud into the mix... so frustrating...",
            "nextDialogs": [
              "719140107"
            ]
          },
          "719140107": {
            "id": "719140107",
            "speakerId": 1000,
            "speakerName": "Linlang",
            "text": "Please, take it off my hands would you? I never want to see it again."
          }
        }
      }
    }
  ]
}
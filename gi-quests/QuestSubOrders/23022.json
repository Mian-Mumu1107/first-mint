  "subQuests": [
    {
      "subId": "2302201",
      "subQuestName": "Talk to Rafiq",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230220101"
        ],
        "dialogs": {
          "230220101": {
            "id": "230220101",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "If we increase the strength here, we'll have to...",
            "nextDialogs": [
              "230220102"
            ]
          },
          "230220102": {
            "id": "230220102",
            "speakerId": 4031,
            "speakerName": "Qishan",
            "text": "If you go with this design, there won't be much of a difference from the one before.",
            "nextDialogs": [
              "230220103"
            ]
          },
          "230220103": {
            "id": "230220103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you still working on your ship design?",
            "nextDialogs": [
              "230220104"
            ]
          },
          "230220104": {
            "id": "230220104",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "Ah, it's the Traveler. Yes, Qishan and I have discussed some... key aspects of the design since our last trial.",
            "nextDialogs": [
              "230220105"
            ]
          },
          "230220105": {
            "id": "230220105",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "We had a... full exchange of opinions, and are trying to work out a new design.",
            "nextDialogs": [
              "230220106"
            ]
          },
          "230220106": {
            "id": "230220106",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "But we still had some divergence regarding the use of materials.",
            "nextDialogs": [
              "230220107"
            ]
          },
          "230220107": {
            "id": "230220107",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "But I followed Qishan's advice this time! I bought a bunch of solid materials. Cost me a fortune, too!",
            "nextDialogs": [
              "230220108"
            ]
          },
          "230220108": {
            "id": "230220108",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "As you can see, Traveler, I can't move all these alone. Qishan isn't strong enough either, so could you...",
            "nextDialogs": [
              "230220111"
            ]
          },
          "230220111": {
            "id": "230220111",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "I knew I could count on you! Let's get rolling.",
            "nextDialogs": [
              "230220112"
            ]
          },
          "230220112": {
            "id": "230220112",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "Qishan hand-picked the materials herself. I believe that things will work out this time.",
            "nextDialogs": [
              "230220113"
            ]
          },
          "230220113": {
            "id": "230220113",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "I've got bigger rewards for you this time as well. Thanks for your help."
          }
        }
      }
    },
    {

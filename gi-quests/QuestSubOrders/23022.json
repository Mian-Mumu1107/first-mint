    {
      "subId": "2302205",
      "subQuestName": "Return and report the situation to Rafiq",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230220501"
        ],
        "dialogs": {
          "230220501": {
            "id": "230220501",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "Aye, these materials should do. Please take your payment.",
            "nextDialogs": [
              "230220502"
            ]
          },
          "230220502": {
            "id": "230220502",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "The materials that Qishan chose are really light... Are they really reliable?",
            "nextDialogs": [
              "230220503"
            ]
          },
          "230220503": {
            "id": "230220503",
            "speakerId": 4031,
            "speakerName": "Qishan",
            "text": "Trust me. They'll do better than the ones you picked before.",
            "nextDialogs": [
              "230220504"
            ]
          },
          "230220504": {
            "id": "230220504",
            "speakerId": 4032,
            "speakerName": "Rafiq",
            "text": "Well, guess it's your turn to prepare life jackets for me...",
            "nextDialogs": [
              "230220505"
            ]
          },
          "230220505": {
            "id": "230220505",
            "speakerId": 4031,
            "speakerName": "Qishan",
            "text": "Oh, have some trust in me... These will suffice."
          }
        }
      }
    },
    {

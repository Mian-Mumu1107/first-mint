  "subQuests": [
    {
      "subId": "7301901",
      "subQuestName": "Look for Arasaka",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730190101"
        ],
        "dialogs": {
          "730190101": {
            "id": "730190101",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "You consume the dew and grow up quickly...",
            "nextDialogs": [
              "730190102"
            ]
          },
          "730190102": {
            "id": "730190102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hello! You're Ara... Ara... What was it again?",
            "nextDialogs": [
              "730190104",
              "730190106"
            ]
          },
          "730190104": {
            "id": "730190104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's smart!",
            "nextDialogs": [
              "730190107"
            ]
          },
          "730190107": {
            "id": "730190107",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Grow, grow, turn into a delicious dish...",
            "nextDialogs": [
              "730190108"
            ]
          },
          "730190108": {
            "id": "730190108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "He doesn't seem to notice us..."
          },
          "730190106": {
            "id": "730190106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Arasaka! Are you Arasaka?"
          }
        }
      }
    },
    {
      "subId": "7301902",
      "subQuestName": "Approach the Aranara by the Zaytun Peaches",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730190201"
        ],
        "dialogs": {
          "730190201": {
            "id": "730190201",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Eek! Nara... So tall, so scary...",
            "nextDialogs": [
              "730190202"
            ]
          },
          "730190202": {
            "id": "730190202",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Please, I beg you... Don't pluck them...",
            "nextDialogs": [
              "730190203"
            ]
          },
          "730190203": {
            "id": "730190203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Okay, we won't do it.",
            "nextDialogs": [
              "730190204"
            ]
          },
          "730190204": {
            "id": "730190204",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Great. Hehe... I grew these Zaytun Peaches little by little, ever since they were seeds...",
            "nextDialogs": [
              "730190205"
            ]
          },
          "730190205": {
            "id": "730190205",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Wait, no! Bad Nara! How could you do that to someone else's Zaytun Peaches?",
            "nextDialogs": [
              "730190206"
            ]
          },
          "730190206": {
            "id": "730190206",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Wh—Why does Nara have such a terrible habit...?",
            "nextDialogs": [
              "730190207"
            ]
          },
          "730190207": {
            "id": "730190207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We didn't do anything and haven't picked them!",
            "nextDialogs": [
              "730190208"
            ]
          },
          "730190208": {
            "id": "730190208",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "It's already scary when you guys didn't do anything. If you had really done something, it would scare me to death!",
            "nextDialogs": [
              "730190209"
            ]
          },
          "730190209": {
            "id": "730190209",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey!",
            "nextDialogs": [
              "730190210"
            ]
          },
          "730190210": {
            "id": "730190210",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "No, no, Arasaka... Think about it. You've worked so hard on these Zaytun Peaches for your cooking training... You cannot back out here. You are not scared...",
            "nextDialogs": [
              "730190211"
            ]
          },
          "730190211": {
            "id": "730190211",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So, you're Arasaka.",
            "nextDialogs": [
              "730190212"
            ]
          },
          "730190212": {
            "id": "730190212",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "Oh! H—How do you know my name... Where you Nara all come from... T—To know my name at first sight...",
            "nextDialogs": [
              "730190214",
              "730190217"
            ]
          },
          "730190214": {
            "id": "730190214",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "Problems are caused by a loose tongue. It's over! My name will be used in terrible curses... Please, please, spare me...",
            "nextDialogs": [
              "730190215"
            ]
          },
          "730190215": {
            "id": "730190215",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "Other than giving you the Zaytun Peaches, I will do anything...",
            "nextDialogs": [
              "730190219"
            ]
          },
          "730190219": {
            "id": "730190219",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Easy now. We're actually here because of Arapacati's request.",
            "nextDialogs": [
              "730190220"
            ]
          },
          "730190220": {
            "id": "730190220",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "Ara—Arapacati? Ah, my dear \"younger sister,\" sunlight in the dense forest...",
            "nextDialogs": [
              "730190221"
            ]
          },
          "730190221": {
            "id": "730190221",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You bring Arasaka up to speed on the events so far...",
            "nextDialogs": [
              "730190222"
            ]
          },
          "730190222": {
            "id": "730190222",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "Ugh... How come Festival Utsava is already approaching... Oh, are you two the Nara who have come to participate in this Festival Utsava?",
            "nextDialogs": [
              "730190223"
            ]
          },
          "730190223": {
            "id": "730190223",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "Sorry for calling you bad Nara. You must be good Nara because only good Nara can enter Vanarana and participate in Festival Utsava.",
            "nextDialogs": [
              "730190224"
            ]
          },
          "730190224": {
            "id": "730190224",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "Festival Utsava is coming. If I give up my cooking training and return to Vanarana now... No... But I can't skip Festival Utsava either...",
            "nextDialogs": [
              "730190225"
            ]
          },
          "730190225": {
            "id": "730190225",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why are you getting more nervous instead? Don't you still have the Zaytun Peaches you planted?",
            "nextDialogs": [
              "730190226"
            ]
          },
          "730190226": {
            "id": "730190226",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "Th—That's not enough!",
            "nextDialogs": [
              "730190227"
            ]
          },
          "730190227": {
            "id": "730190227",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "There has to be the \"taste of happiness.\" Without it, Zaytun Peaches will just be Zaytun Peaches...",
            "nextDialogs": [
              "730190228"
            ]
          },
          "730190228": {
            "id": "730190228",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "Arachatora, Arapas, and Araphala all don't believe that the \"taste of happiness\" exists. I will make it and show them. And I want Nara to try it too."
          },
          "730190217": {
            "id": "730190217",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "What!? A long time ago!? So you had your eyes on me long ago... Wh—What do you want from me...",
            "nextDialogs": [
              "730190218"
            ]
          },
          "730190218": {
            "id": "730190218",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "Could it be the Zaytun Peaches? No! You can have anything else! But not my peaches!"
          }
        }
      }
    },
    {
      "subId": "7301903",
      "subQuestName": "Head to Gandharva Ville and look for someone \"with a bulge on their back\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730190301"
        ],
        "dialogs": {
          "730190301": {
            "id": "730190301",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "H—How was it? Did you find the \"taste of happiness\"? It's in Gandharva Ville...",
            "nextDialogs": [
              "730190302"
            ]
          },
          "730190302": {
            "id": "730190302",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "There's a Nara with a bulging thing on his back. The \"taste of happiness\" must be inside..."
          }
        }
      }
    },
    {
      "subId": "7301904",
      "subQuestName": "Talk to the person \"with a bulge on their back\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730190401"
        ],
        "dialogs": {
          "730190401": {
            "id": "730190401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hello!",
            "nextDialogs": [
              "730190402"
            ]
          },
          "730190402": {
            "id": "730190402",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "Oh, hello... How can I help you?",
            "nextDialogs": [
              "730190403"
            ]
          },
          "730190403": {
            "id": "730190403",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Right, we actually want a certain thing...",
            "nextDialogs": [
              "730190404"
            ]
          },
          "730190404": {
            "id": "730190404",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "Heh. Of course, everyone comes here to get \"a certain thing.\" But just saying \"a certain thing\" doesn't mean I know what this \"certain thing\" is.",
            "nextDialogs": [
              "730190405"
            ]
          },
          "730190405": {
            "id": "730190405",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh... Paimon gets it. Let Paimon put it this way: We want...",
            "nextDialogs": [
              "730190406"
            ]
          },
          "730190406": {
            "id": "730190406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Something white and cubic...",
            "nextDialogs": [
              "730190407"
            ]
          },
          "730190407": {
            "id": "730190407",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "White and cubic?",
            "nextDialogs": [
              "730190408"
            ]
          },
          "730190408": {
            "id": "730190408",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Right, and it crumbles like sand when crushed, and it has to be packed in a hard bubble!",
            "nextDialogs": [
              "730190409"
            ]
          },
          "730190409": {
            "id": "730190409",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "What a peculiar description...",
            "nextDialogs": [
              "730190410"
            ]
          },
          "730190410": {
            "id": "730190410",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "It's not clear what it is from what you said, but what does this white and cubic thing you've described do?",
            "nextDialogs": [
              "730190411"
            ]
          },
          "730190411": {
            "id": "730190411",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "The use of the thing. You know what it's used for, right?",
            "nextDialogs": [
              "730190413",
              "730190415"
            ]
          },
          "730190413": {
            "id": "730190413",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "An edible, white, and cubic thing...?",
            "nextDialogs": [
              "730190416"
            ]
          },
          "730190416": {
            "id": "730190416",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "Oh! I know! I know what you want... Hahaha...",
            "nextDialogs": [
              "730190417"
            ]
          },
          "730190417": {
            "id": "730190417",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What's so funny!?",
            "nextDialogs": [
              "730190418"
            ]
          },
          "730190418": {
            "id": "730190418",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "Aha, hahaha! White, cubic, crumbles when crushed, becomes sand... and can be eaten...",
            "nextDialogs": [
              "730190419"
            ]
          },
          "730190419": {
            "id": "730190419",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "Isn't it just \"sugar\"!?",
            "nextDialogs": [
              "730190420"
            ]
          },
          "730190420": {
            "id": "730190420",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "The hard bubble... Are you talking about the glass bottle that sugar is stored in? My goodness! Hard bubble! Hahahahaha...",
            "nextDialogs": [
              "730190421"
            ]
          },
          "730190421": {
            "id": "730190421",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What? So it's sugar..."
          },
          "730190415": {
            "id": "730190415",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "Cooking, white, cubic... Is it a seasoning?"
          }
        }
      }
    },
    {
      "subId": "7301905",
      "subQuestName": "Give the sugar to Arasaka",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730190501"
        ],
        "dialogs": {
          "730190501": {
            "id": "730190501",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "My family has always been a merchant group on the move, from The Chasm to Sumeru. We import rare gemstones from Liyue, then send spices over.",
            "nextDialogs": [
              "730190502"
            ]
          },
          "730190502": {
            "id": "730190502",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "Once, because something came up... I can't remember. Anyway, my father left me in Gandharva Ville for a very long time.",
            "nextDialogs": [
              "730190503"
            ]
          },
          "730190503": {
            "id": "730190503",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "I remember I was in the forest, and I made a friend. We ran around together, then...",
            "nextDialogs": [
              "730190504"
            ]
          },
          "730190504": {
            "id": "730190504",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "I don't remember what happened later. I can't remember his name, or what he looked like...",
            "nextDialogs": [
              "730190505"
            ]
          },
          "730190505": {
            "id": "730190505",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "I only remember it being a really happy time. Then my father finally came back, and picked me up. I'd also thought to go back and look for him but I never had the opportunity, and I eventually forgot about this experience.",
            "nextDialogs": [
              "730190506"
            ]
          },
          "730190506": {
            "id": "730190506",
            "speakerId": 1004,
            "speakerName": "Iaanesh",
            "text": "If it wasn't for you asking me for sugar, I would have forgotten about all these things. Why would it be like this..."
          }
        }
      }
    },
    {
      "subId": "7301906",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730190601"
        ],
        "dialogs": {
          "730190601": {
            "id": "730190601",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "That's the one! I didn't think you would get it so quickly... Is it real?",
            "nextDialogs": [
              "730190602"
            ]
          },
          "730190602": {
            "id": "730190602",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "You didn't just make something up to trick me, right?",
            "nextDialogs": [
              "730190603"
            ]
          },
          "730190603": {
            "id": "730190603",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It would be a miracle if we were able to make anything that made sense up from your description!",
            "nextDialogs": [
              "730190604"
            ]
          },
          "730190604": {
            "id": "730190604",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "If you're worried, just try it yourself.",
            "nextDialogs": [
              "730190605"
            ]
          },
          "730190605": {
            "id": "730190605",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "...You didn't put anything strange in it, did you?",
            "nextDialogs": [
              "730190606"
            ]
          },
          "730190606": {
            "id": "730190606",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Of course not! Hmph! If you're not trying it, we're gonna take it away.",
            "nextDialogs": [
              "730190607"
            ]
          },
          "730190607": {
            "id": "730190607",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "N—No, wait! Don't take it away. Let me... Let me try...",
            "nextDialogs": [
              "730190608"
            ]
          },
          "730190608": {
            "id": "730190608",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "Don't take it away, alright? I'll try it now, right now... Hmm...",
            "nextDialogs": [
              "730190609"
            ]
          },
          "730190609": {
            "id": "730190609",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "Ah, it's real... This is the \"taste of happiness\"! Hehe... This isn't the first time I tasted it, and yet I still feel happy.",
            "nextDialogs": [
              "730190610"
            ]
          },
          "730190610": {
            "id": "730190610",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "I didn't expect to ever taste this again... Ah, but...",
            "nextDialogs": [
              "730190613"
            ]
          },
          "730190613": {
            "id": "730190613",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "Well... How should I put this? The \"taste of happiness\" is the same as before. But for some reason, I don't feel as happy as the first time I tasted it...",
            "nextDialogs": [
              "730190614"
            ]
          },
          "730190614": {
            "id": "730190614",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Could it be that the sugar he gave us was not sweet enough?",
            "nextDialogs": [
              "730190615"
            ]
          },
          "730190615": {
            "id": "730190615",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "No, it's not a difference in the taste. But when I ate it with my friend in the past... That was the first time I tasted the \"taste of happiness\"...",
            "nextDialogs": [
              "730190616"
            ]
          },
          "730190616": {
            "id": "730190616",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "Somehow I feel that I was much happier back then. Why is that?",
            "nextDialogs": [
              "730190617"
            ]
          },
          "730190617": {
            "id": "730190617",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#That's normal. Even if it's the same dish, the taste is different every time {NICKNAME} makes it...",
            "nextDialogs": [
              "730190618"
            ]
          },
          "730190618": {
            "id": "730190618",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon's mood is different every time Paimon eats it too."
          }
        }
      }
    },
    {
      "subId": "7301907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730190701"
        ],
        "dialogs": {
          "730190701": {
            "id": "730190701",
            "speakerId": 1002,
            "speakerName": "Arasaka",
            "text": "I—I now just have to let them taste this Supreme Delicacy and they will understand what the \"taste of happiness\" is.",
            "nextDialogs": [
              "730190702"
            ]
          },
          "730190702": {
            "id": "730190702",
            "speakerId": 1002,
            "speakerName": "Arasaka",

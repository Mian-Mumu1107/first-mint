    {
      "subId": "7523210",
      "subQuestName": "Talk to Atzilli and try out the \"dream drink\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752321201"
        ],
        "dialogs": {
          "752321201": {
            "id": "752321201",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Haha, remember that \"Sweet Dream Brew\" I mentioned? Well, I've got some great news for you!",
            "nextDialogs": [
              "752321202"
            ]
          },
          "752321202": {
            "id": "752321202",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "After a full day of work, I've finally perfected the recipe!",
            "nextDialogs": [
              "752321203"
            ]
          },
          "752321203": {
            "id": "752321203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Congratulations!",
            "nextDialogs": [
              "752321204"
            ]
          },
          "752321204": {
            "id": "752321204",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Hehe, and you lucky two get to be my first customers! Don't worry about paying. I'll put it on my sister's tab!",
            "nextDialogs": [
              "752321205"
            ]
          },
          "752321205": {
            "id": "752321205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yippee! Free drinks!",
            "nextDialogs": [
              "752321206"
            ]
          },
          "752321206": {
            "id": "752321206",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, hold on... You're just telling us we're your test subjects...",
            "nextDialogs": [
              "752321207"
            ]
          },
          "752321207": {
            "id": "752321207",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Of course! Aren't you honored?",
            "nextDialogs": [
              "752321208"
            ]
          },
          "752321208": {
            "id": "752321208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Not at all!",
            "nextDialogs": [
              "752321211"
            ]
          },
          "752321211": {
            "id": "752321211",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Hmm? Oh, right... I did, didn't I...?",
            "nextDialogs": [
              "752321212"
            ]
          },
          "752321212": {
            "id": "752321212",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "First off, I have to warn you — Brewblossom extract is highly toxic. But after repeated distillations, I've reduced the toxicity to a level that is tolerable for normal people.",
            "nextDialogs": [
              "752321213"
            ]
          },
          "752321213": {
            "id": "752321213",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "By \"tolerable,\" I mean to say that a normal person will \"die\" within about... Hmm, five seconds.",
            "nextDialogs": [
              "752321214"
            ]
          },
          "752321214": {
            "id": "752321214",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "And when they \"die,\" their soul will wander through a place where the mortal realm and the land of the dead overlap... I guess that's a good enough explanation.",
            "nextDialogs": [
              "752321215"
            ]
          },
          "752321215": {
            "id": "752321215",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Which part of \"die within five seconds\" sounds \"tolerable\" to you!?"
          }
        }
      }
    },
    {
      "subId": "7523216",
      "subQuestName": "Savor the sweet dream...",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752321301"
        ],
        "dialogs": {
          "752321301": {
            "id": "752321301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wah! Mi zido mita dada! Mmm~ Yaya dada! Movo dada!",
            "nextDialogs": [
              "752321302"
            ]
          },
          "752321302": {
            "id": "752321302",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Olah! Mosi mita yo! Sada mimi dada! Sada domu dada!",
            "nextDialogs": [
              "752321304",
              "752321306"
            ]
          },
          "752321304": {
            "id": "752321304",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "I'm your friend, and you're my friend! We're all good friends!",
            "nextDialogs": [
              "752321307"
            ]
          },
          "752321307": {
            "id": "752321307",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ahaha! Mi zido mita dada!",
            "nextDialogs": [
              "752321308"
            ]
          },
          "752321308": {
            "id": "752321308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sado! Yo beru mimi beru!?",
            "nextDialogs": [
              "752321309"
            ]
          },
          "752321309": {
            "id": "752321309",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Haha, what are you talking about? You're the one who started speaking our language!",
            "nextDialogs": [
              "752321310"
            ]
          },
          "752321310": {
            "id": "752321310",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Sama! Mito! Ya upa dala?",
            "nextDialogs": [
              "752321311"
            ]
          },
          "752321311": {
            "id": "752321311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ya upa dala?",
            "nextDialogs": [
              "752321312"
            ]
          },
          "752321312": {
            "id": "752321312",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Hehe, there's treasure up there! Let's go dig it up!",
            "nextDialogs": [
              "752321313"
            ]
          },
          "752321313": {
            "id": "752321313",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "The treasure's right here! Let's share it!",
            "nextDialogs": [
              "752321314"
            ]
          },
          "752321314": {
            "id": "752321314",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Mimi Mani! Mimi mosi! Mimi muhe!",
            "nextDialogs": [
              "752321315"
            ]
          },
          "752321315": {
            "id": "752321315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Mimi muhe!",
            "nextDialogs": [
              "752321316"
            ]
          },
          "752321316": {
            "id": "752321316",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Yay! Treasure!",
            "nextDialogs": [
              "752321317"
            ]
          },
          "752321317": {
            "id": "752321317",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Mosi mita! Mita dada! Hahahahahaha!",
            "nextDialogs": [
              "752321318"
            ]
          },
          "752321318": {
            "id": "752321318",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Unta dada, yoyo upa, nunu beru valo yoyo..."
          },
          "752321306": {
            "id": "752321306",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Oh, you're in a happy place — a very happy place!"
          }
        }
      }
    },
    {
      "subId": "7523217",
      "subQuestName": "Talk to Atzilli",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752321419"
        ],
        "dialogs": {
          "752321419": {
            "id": "752321419",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "So? How's my \"Sweet Dream Brew\"? Tasty?",
            "nextDialogs": [
              "752321420"
            ]
          },
          "752321420": {
            "id": "752321420",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Ugh... Paimon's head hurts so bad... {NICKNAME}, are you okay?",
            "nextDialogs": [
              "752321421"
            ]
          },
          "752321421": {
            "id": "752321421",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We had a very strange dream...",
            "nextDialogs": [
              "752321422"
            ]
          },
          "752321422": {
            "id": "752321422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We dreamed we were digging treasure... with Hilichurls?",
            "nextDialogs": [
              "752321423"
            ]
          },
          "752321423": {
            "id": "752321423",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Umm... It's hard to explain... By the way, were we \"dead\" for a long time?",
            "nextDialogs": [
              "752321424"
            ]
          },
          "752321424": {
            "id": "752321424",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Yup, and I've been dead for a long time too.",
            "nextDialogs": [
              "752321425"
            ]
          },
          "752321425": {
            "id": "752321425",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh?",
            "nextDialogs": [
              "752321426"
            ]
          },
          "752321426": {
            "id": "752321426",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Hahahaha! Just kidding! You were only out for a few seconds... I was worried it wouldn't work at all!",
            "nextDialogs": [
              "752321427"
            ]
          },
          "752321427": {
            "id": "752321427",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Good thing it did! Now, please tell me everything you saw in your dream — I'll write it all down!",
            "nextDialogs": [
              "752321428"
            ]
          },
          "752321428": {
            "id": "752321428",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Uh... We'll try!",
            "nextDialogs": [
              "752321429"
            ]
          },
          "752321429": {
            "id": "752321429",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You and Paimon piece together the bizarre dreamscape as \"Mad-Eye\" Atzilli listens intently, scribbling down notes.",
            "nextDialogs": [
              "752321430"
            ]
          },
          "752321430": {
            "id": "752321430",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Haha, that was great! It was total nonsense, but overall, what a fun dream it must have been!",
            "nextDialogs": [
              "752321431"
            ]
          },
          "752321431": {
            "id": "752321431",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "But why hilichurls? That's strange...",
            "nextDialogs": [
              "752321432"
            ]
          },
          "752321432": {
            "id": "752321432",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Well, leave that mystery to me and my sister. Here's your reward!",
            "nextDialogs": [
              "752321433"
            ]
          },
          "752321433": {
            "id": "752321433",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um... So you're really planning to sell this strange drink?",
            "nextDialogs": [
              "752321434"
            ]
          },
          "752321434": {
            "id": "752321434",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Oh, we're still a long way off from actually selling it. I still need to test it on more people with different constitutions.",
            "nextDialogs": [
              "752321435"
            ]
          },
          "752321435": {
            "id": "752321435",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Once you leave this place, you probably won't see our brew on shelves for quite a while.",
            "nextDialogs": [
              "752321436"
            ]
          },
          "752321436": {
            "id": "752321436",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Phew... That's a bit of a relief. Its effects are... kinda strong.",
            "nextDialogs": [
              "752321437"
            ]
          },
          "752321437": {
            "id": "752321437",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Strong and strange.",
            "nextDialogs": [
              "752321438"
            ]
          },
          "752321438": {
            "id": "752321438",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Pfft... Alright, alright, I get it!",
            "nextDialogs": [
              "752321439"
            ]
          },
          "752321439": {
            "id": "752321439",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Now that the experiment's over, you're free to go!",
            "nextDialogs": [
              "752321440"
            ]
          },
          "752321440": {
            "id": "752321440",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "If you feel sick or experience any more side effects, do come find me.",
            "nextDialogs": [
              "752321441"
            ]
          },
          "752321441": {
            "id": "752321441",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Will do!"
          }
        }
      }
    },
    {
      "subId": "7523206",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320601"
        ],
        "dialogs": {
          "752320601": {
            "id": "752320601",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Hroooo... Woof! Woof, woof!",
            "nextDialogs": [
              "752320602"
            ]
          },
          "752320602": {
            "id": "752320602",
            "speakerId": 1006,
            "speakerName": "Sir Briannus",
            "text": "I am Sir Woofington Briannus, knight of this realm! Pray tell, what names do you bear?",
            "nextDialogs": [
              "752320612",
              "752320604"
            ]
          },
          "752320612": {
            "id": "752320612",
            "speakerId": 1006,
            "speakerName": "Sir Briannus",
            "text": "#Awoo~ Well met, {M#Sir}{F#Lady} {NICKNAME}! What brings you hither?",
            "nextDialogs": [
              "752320615"
            ]
          },
          "752320615": {
            "id": "752320615",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm looking for the flowers you're guarding.",
            "nextDialogs": [
              "752320616"
            ]
          },
          "752320616": {
            "id": "752320616",
            "speakerId": 1006,
            "speakerName": "Sir Briannus",
            "text": "As I feared. Alas, I have sworn on my blade to forbid outsiders from approaching my squire and maiden.",
            "nextDialogs": [
              "752320617"
            ]
          },
          "752320617": {
            "id": "752320617",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Squire and maiden... So there are two flowers?",
            "nextDialogs": [
              "752320618"
            ]
          },
          "752320618": {
            "id": "752320618",
            "speakerId": 1006,
            "speakerName": "Sir Briannus",
            "text": "Err, well... biologically speaking, each Brewblossom has both a stamen and a pistil, yes?",
            "nextDialogs": [
              "752320619"
            ]
          },
          "752320619": {
            "id": "752320619",
            "speakerId": 1006,
            "speakerName": "Sir Briannus",
            "text": "So... Technically, a single flower is both squire and maiden at the same time."
          },
          "752320604": {
            "id": "752320604",
            "speakerId": 1006,
            "speakerName": "Sir Briannus",
            "text": "Wroo, rrooh! Woof, woof!",
            "nextDialogs": [
              "752320605"
            ]
          },
          "752320605": {
            "id": "752320605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Who's the goodest pet around?",
            "nextDialogs": [
              "752320606"
            ]
          },
          "752320606": {
            "id": "752320606",
            "speakerId": 1006,
            "speakerName": "Sir Briannus",
            "text": "Woof, woof!",
            "nextDialogs": [
              "752320607"
            ]
          },
          "752320607": {
            "id": "752320607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's Paimon, of course!",
            "nextDialogs": [
              "752320608"
            ]
          },
          "752320608": {
            "id": "752320608",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh!?",
            "nextDialogs": [
              "752320609"
            ]
          },
          "752320609": {
            "id": "752320609",
            "speakerId": 1006,
            "speakerName": "Sir Briannus",
            "text": "...?",
            "nextDialogs": [
              "752320610"
            ]
          },
          "752320610": {
            "id": "752320610",
            "speakerId": 1006,
            "speakerName": "Sir Briannus",
            "text": "You dare mock a knight to his face? I demand a duel!",
            "nextDialogs": [
              "752320627"
            ]
          },
          "752320627": {
            "id": "752320627",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Sir Briannus challenges you to a duel. You swing your sword at the big dog, and — Poof! It vanishes..."
          }
        }
      }
    }
  ]
}
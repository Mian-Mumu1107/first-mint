  "subQuests": [
    {
      "subId": "7523201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320101"
        ],
        "dialogs": {
          "752320101": {
            "id": "752320101",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Hmm... This bitter taste... Did I add too much Flamegrass?",
            "nextDialogs": [
              "752320104"
            ]
          },
          "752320104": {
            "id": "752320104",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Glowing Hornshrooms... They need to be fermented first, then steamed twice. Hmm... The effect is still too weak...",
            "nextDialogs": [
              "752320105"
            ]
          },
          "752320105": {
            "id": "752320105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...Umm, is she just gonna keep ignoring us?"
          }
        }
      }
    },
    {
      "subId": "7523202",
      "subQuestName": "Talk to Atzilli",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320201"
        ],
        "dialogs": {
          "752320201": {
            "id": "752320201",
            "speakerId": 1002,
            "speakerName": "Strange Flower",
            "text": "(A softly glowing flower bud sways at your touch, pulsing to some silent, secret rhythm...)",
            "nextDialogs": [
              "752320202"
            ]
          },
          "752320202": {
            "id": "752320202",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Hey! Hands off, please!",
            "nextDialogs": [
              "752320204",
              "752320206"
            ]
          },
          "752320204": {
            "id": "752320204",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "You're quite polite. No wonder it doesn't dislike you.",
            "nextDialogs": [
              "752320207"
            ]
          },
          "752320207": {
            "id": "752320207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! Look at the flower! Is it... dancing?",
            "nextDialogs": [
              "752320208"
            ]
          },
          "752320208": {
            "id": "752320208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Looks more like... wriggling to me.",
            "nextDialogs": [
              "752320209"
            ]
          },
          "752320209": {
            "id": "752320209",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eww! Don't use such disgusting language on a flower! At least say it's \"swaying\" or something!",
            "nextDialogs": [
              "752320210"
            ]
          },
          "752320210": {
            "id": "752320210",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "That's the \"Dance of Erzulie.\" The flowers only react this way when someone with a strong affinity for clairvoyance draws near.",
            "nextDialogs": [
              "752320211"
            ]
          },
          "752320211": {
            "id": "752320211",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "That's because Brewblossoms draw in spiritual energy from the land and produce a special nectar that heightens one's sensitivity to dreams.",
            "nextDialogs": [
              "752320212"
            ]
          },
          "752320212": {
            "id": "752320212",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Some people... Hmm, how should I put it? They're born with a natural spiritual affinity. So Brewblossoms, which absorb spiritual essence, are naturally more drawn to them. After all, legend says they're plants that act as a bridge between worlds.",
            "nextDialogs": [
              "752320213"
            ]
          },
          "752320213": {
            "id": "752320213",
            "speakerId": 1003,
            "speakerName": "Atzilli",
            "text": "By the way, I'm \"Mad-Eye\" Atzilli, a winemaker at the Me & Dew. And who might you be?"
          },
          "752320206": {
            "id": "752320206",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Heh, a smooth talker, huh? But... Hmm... It doesn't seem to dislike you."
          }
        }
      }
    },
    {
      "subId": "7523218",
      "subQuestName": "Talk to Atzilli",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320301"
        ],
        "dialogs": {
          "752320301": {
            "id": "752320301",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "This one here is the \"Dream Extractor,\" we can collect the purest pollen from the Brewblossoms.",
            "nextDialogs": [
              "752320302"
            ]
          },
          "752320302": {
            "id": "752320302",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "First, we'll need to weed out the bad flowers. Those would be the ones tainted with impurities.",
            "nextDialogs": [
              "752320303"
            ]
          },
          "752320303": {
            "id": "752320303",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "These plants have absorbed too much gunk from underground, and that messes with the effects and the safety of the drink.",
            "nextDialogs": [
              "752320304"
            ]
          },
          "752320304": {
            "id": "752320304",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But how can we tell which ones are bad?",
            "nextDialogs": [
              "752320305"
            ]
          },
          "752320305": {
            "id": "752320305",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "They'll react to people with special constitutions. I'm not sure how they'll react exactly, but I know that if you get close enough, the flower's bound to do something weird and obvious.",
            "nextDialogs": [
              "752320306"
            ]
          },
          "752320306": {
            "id": "752320306",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "You'll see what I mean once we're in the flower fields."
          }
        }
      }
    },
    {
      "subId": "7523203",
      "subQuestName": "Investigate the issue with the flower fields",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7523204",
      "subQuestName": "Talk to Atzilli",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320401"
        ],
        "dialogs": {
          "752320401": {
            "id": "752320401",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Let me see... Mm-hmm! The pollen in this Dream Extractor is super pure.",
            "nextDialogs": [
              "752320402"
            ]
          },
          "752320402": {
            "id": "752320402",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Perfect! Which means that last flower was definitely the contaminated one.",
            "nextDialogs": [
              "752320403"
            ]
          },
          "752320403": {
            "id": "752320403",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "\"Mad Eye\" Atzilli carefully pours the freshly gathered nectar into a tiny vial. Then, with practiced flair, she adds a few drops from other vials filled with brightly colored liquids...",
            "nextDialogs": [
              "752320404"
            ]
          },
          "752320404": {
            "id": "752320404",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "A few minutes later...",
            "nextDialogs": [
              "752320405"
            ]
          },
          "752320405": {
            "id": "752320405",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Hmm... Judging by the sample, the purity's spot-on. No sign of any impurities or sediment. Excellent!",
            "nextDialogs": [
              "752320406"
            ]
          },
          "752320406": {
            "id": "752320406",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Let's power through and finish up the last two flower fields!"
          }
        }
      }
    },
    {
      "subId": "7523205",
      "subQuestName": "Investigate the issue with the flower fields",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320501"
        ],
        "dialogs": {
          "752320501": {
            "id": "752320501",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Purrrr...",
            "nextDialogs": [
              "752320502"
            ]
          },
          "752320502": {
            "id": "752320502",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Meeeow?",
            "nextDialogs": [
              "752320506",
              "752320505"
            ]
          },
          "752320506": {
            "id": "752320506",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Atzilli, what a two-faced witch you are! Did you start raising humans behind my back?",
            "nextDialogs": [
              "752320507"
            ]
          },
          "752320507": {
            "id": "752320507",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Ugh... Humans... Rude, filthy, stinking humans!",
            "nextDialogs": [
              "752320508"
            ]
          },
          "752320508": {
            "id": "752320508",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Didn't your mothers teach you how to treat a poor, lonely, free-spirited delicate flower like me...? *sniff*",
            "nextDialogs": [
              "752320509"
            ]
          },
          "752320509": {
            "id": "752320509",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "*sniff* Anyway, I'm \"Dambara the Pale,\" but you can just call me Dambara.",
            "nextDialogs": [
              "752320510"
            ]
          },
          "752320510": {
            "id": "752320510",
            "speakerId": 1005,
            "speakerName": "Dambara",
            "text": "Face the wrath of my claws, foolish intruders! My fangs thirst for justice!",
            "nextDialogs": [
              "752320511"
            ]
          },
          "752320511": {
            "id": "752320511",
            "speakerId": 1005,
            "speakerName": "Dambara",
            "text": "H—Hey! Why aren't you scared?! Am I not scary enough...? Tch..."
          },
          "752320505": {
            "id": "752320505",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Meeeow!!!",
            "nextDialogs": [
              "752320525"
            ]
          },
          "752320525": {
            "id": "752320525",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You swing your sword at the illusion, and — poof! The little cat vanishes..."
          }
        }
      }
    },
    {
      "subId": "7523206",
      "subQuestName": "Talk to Atzilli",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320801"
        ],
        "dialogs": {
          "752320801": {
            "id": "752320801",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Atzilli, we're back!",
            "nextDialogs": [
              "752320802"
            ]
          },
          "752320802": {
            "id": "752320802",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#There were three bad flowers in that field! But, umm... {NICKNAME} was acting a little strange. You're okay, right...?",
            "nextDialogs": [
              "752320805"
            ]
          },
          "752320805": {
            "id": "752320805",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Hallucinations? Then there's no need to worry. It's common for Brewblossoms to release hallucinogenic pollen as a defense mechanism. They must've been especially reactive to you.",
            "nextDialogs": [
              "752320806"
            ]
          },
          "752320806": {
            "id": "752320806",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Paimon and I couldn't see what you were seeing because the pollen doesn't affect us the same way.",
            "nextDialogs": [
              "752320807"
            ]
          },
          "752320807": {
            "id": "752320807",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "#But still... hmm. {NICKNAME}, are you experiencing any other symptoms?",
            "nextDialogs": [
              "752320808"
            ]
          },
          "752320808": {
            "id": "752320808",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Nope. Not yet, anyway...",
            "nextDialogs": [
              "752320809"
            ]
          },
          "752320809": {
            "id": "752320809",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "All right. You know yourself best, but if anything starts to feel off, please let me know immediately.",
            "nextDialogs": [
              "752320810"
            ]
          },
          "752320810": {
            "id": "752320810",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Then let's finish up the last field in one go!"
          }
        }
      }
    },
    {
      "subId": "7523207",
      "subQuestName": "Investigate the issue with the flower fields",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320701"
        ],
        "dialogs": {
          "752320701": {
            "id": "752320701",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Oink oink... Mmm... Oink oink...",
            "nextDialogs": [
              "752320703",
              "752320705",
              "752320707"
            ]
          },
          "752320703": {
            "id": "752320703",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Oink oink?",
            "nextDialogs": [
              "752320708"
            ]
          },
          "752320708": {
            "id": "752320708",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Oink... oink..."
          },
          "752320705": {
            "id": "752320705",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Oink oink!"
          },
          "752320707": {
            "id": "752320707",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Oink oink?!",
            "nextDialogs": [
              "752320722"
            ]
          },
          "752320722": {
            "id": "752320722",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You swing your sword at the forest boar — It gives a loud squeal and then collapses..."
          }
        }
      }
    },
    {
      "subId": "7523215",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752321001"
        ],
        "dialogs": {
          "752321001": {
            "id": "752321001",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "\"Farewell, child of the stars! Should we not meet again in this nation... I shall await you in another...\"\\n",
            "nextDialogs": [
              "752321002"
            ]
          },
          "752321002": {
            "id": "752321002",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "\"Tarry not, oh tarry not...\"",
            "nextDialogs": [
              "752321003"
            ]
          },
          "752321003": {
            "id": "752321003",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "A dizzying wave rises with the thick, sticky sweetness of the flowers...\\nBy the time your senses return, Paimon is already hovering nervously around you.",
            "nextDialogs": [
              "752321004"
            ]
          },
          "752321004": {
            "id": "752321004",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, hey! Wake up! Are you alright? We found the flower!",
            "nextDialogs": [
              "752321005"
            ]
          },
          "752321005": {
            "id": "752321005",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You totally spaced out for a second there... Were you seeing stuff again?",
            "nextDialogs": [
              "752321006"
            ]
          },
          "752321006": {
            "id": "752321006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's use the Dream Extractor first. I'm fine.",
            "nextDialogs": [
              "752321007"
            ]
          },
          "752321007": {
            "id": "752321007",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, as long as you're okay!"
          }
        }
      }
    },
    {
      "subId": "7523208",
      "subQuestName": "Talk to Atzilli",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752321101"
        ],
        "dialogs": {
          "752321101": {
            "id": "752321101",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Atzilli! We found the weird flower you mentioned!",
            "nextDialogs": [
              "752321102"
            ]
          },
          "752321102": {
            "id": "752321102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#But... something's off with {NICKNAME}. Any ideas?",
            "nextDialogs": [
              "752321103"
            ]
          },
          "752321103": {
            "id": "752321103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm fine, just a little lightheaded.",
            "nextDialogs": [
              "752321104"
            ]
          },
          "752321104": {
            "id": "752321104",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Did you see anything over there? Some kind of dangerous hallucination?",
            "nextDialogs": [
              "752321105"
            ]
          },
          "752321105": {
            "id": "752321105",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You describe the hallucination you saw to Atzilli...",
            "nextDialogs": [
              "752321106"
            ]
          },
          "752321106": {
            "id": "752321106",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "The \"Papa Witch Doctor's Prank\"...",
            "nextDialogs": [
              "752321107"
            ]
          },
          "752321107": {
            "id": "752321107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's that?",
            "nextDialogs": [
              "752321108"
            ]
          },
          "752321108": {
            "id": "752321108",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "It's an old tale passed down among shamans and brewers. They say Papa Witch Doctor guides the spirits of those who were unlucky and didn't die in glorious battle.",
            "nextDialogs": [
              "752321109"
            ]
          },
          "752321109": {
            "id": "752321109",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "He's the kind of twisted spirit who treats fear like a game — always crafting eerie nightmares to toy with the living who catch his eye.",
            "nextDialogs": [
              "752321110"
            ]
          },
          "752321110": {
            "id": "752321110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "752321111"
            ]
          },
          "752321111": {
            "id": "752321111",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "#Anyway... Ahem! Anyway, let me look you over, {NICKNAME}. You should be mostly fine.",
            "nextDialogs": [
              "752321113"
            ]
          },
          "752321113": {
            "id": "752321113",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "#Hmm... Alright, no need to worry. Seems like {NICKNAME} just inhaled too much of the hallucinogenic pollen. You might feel dizzy for a bit, but it's nothing serious.",
            "nextDialogs": [
              "752321114"
            ]
          },
          "752321114": {
            "id": "752321114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "I see...",
            "nextDialogs": [
              "752321115"
            ]
          },
          "752321115": {
            "id": "752321115",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "But if any long lasting effects cause brain damage and drop your intelligence... Well, I'm afraid I can't help you with that!",
            "nextDialogs": [
              "752321116"
            ]
          },
          "752321116": {
            "id": "752321116",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey!",
            "nextDialogs": [
              "752321117"
            ]
          },
          "752321117": {
            "id": "752321117",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Haha, just kidding! Now let me finish up the last step here.",
            "nextDialogs": [
              "752321118"
            ]
          },
          "752321118": {
            "id": "752321118",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "\"Mad Eye\" Atzilli carefully pours the freshly gathered nectar into a tiny vial. Then, with practiced flair, she adds a few drops from other vials filled with brightly colored liquids...",
            "nextDialogs": [
              "752321119"
            ]
          },
          "752321119": {
            "id": "752321119",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "A few minutes later...",
            "nextDialogs": [
              "752321120"
            ]
          },
          "752321120": {
            "id": "752321120",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Let's see... Purities... Impure sediments... Toxicity levels... all within acceptable levels! Whoo! We're finally done!",
            "nextDialogs": [
              "752321121"
            ]
          },
          "752321121": {
            "id": "752321121",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Thanks so much for your help. Here's your reward!",
            "nextDialogs": [
              "752321122"
            ]
          },
          "752321122": {
            "id": "752321122",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yay! Thanks!",
            "nextDialogs": [
              "752321123"
            ]
          },
          "752321123": {
            "id": "752321123",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Ah, wait a moment! We're not done yet!",
            "nextDialogs": [
              "752321124"
            ]
          },
          "752321124": {
            "id": "752321124",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "I'm about to start mixing my special \"Sweet Dream Brew,\" and I'd love for you to come by and help me out with your clairvoyance again.",
            "nextDialogs": [
              "752321125"
            ]
          },
          "752321125": {
            "id": "752321125",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Looks like we might have results by tomorrow, so see you then! Who knows, maybe I'll even name the new drink after you!",
            "nextDialogs": [
              "752321126"
            ]
          },
          "752321126": {
            "id": "752321126",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "I'll also answer those questions you had earlier, so don't forget to come over!"
          }
        }
      }
    },
    {
      "subId": "7523211",
      "subQuestName": "Wait until the following day",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

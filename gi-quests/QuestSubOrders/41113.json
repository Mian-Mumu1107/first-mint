    {
      "subId": "4111310",
      "subQuestName": "Report to Jinglun",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131001"
        ],
        "dialogs": {
          "411131001": {
            "id": "411131001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Done and dusted!",
            "nextDialogs": [
              "411131002"
            ]
          },
          "411131002": {
            "id": "411131002",
            "speakerId": 30014,
            "speakerName": "Jinglun",
            "text": "Wonderful! What a huge help!",
            "nextDialogs": [
              "411131003"
            ]
          },
          "411131003": {
            "id": "411131003",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "Have any of the victims woken since the start of the incident?",
            "nextDialogs": [
              "411131004"
            ]
          },
          "411131004": {
            "id": "411131004",
            "speakerId": 30014,
            "speakerName": "Jinglun",
            "text": "Oh, I wouldn't know... You're better off just taking a look for yourself."
          }
        }
      }
    },
    {
      "subId": "4111312",
      "subQuestName": "Examine the nearby victims (0/3)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131201"
        ],
        "dialogs": {
          "411131201": {
            "id": "411131201",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Mortal! Art thou also descended into the realm of suffering?",
            "nextDialogs": [
              "411131202"
            ]
          },
          "411131202": {
            "id": "411131202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Same situation that we've seen in other places, too.",
            "nextDialogs": [
              "411131203"
            ]
          },
          "411131203": {
            "id": "411131203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey there. Has this guy woken up at any point?",
            "nextDialogs": [
              "411131204"
            ]
          },
          "411131204": {
            "id": "411131204",
            "speakerId": 30008,
            "speakerName": "Huaqing",
            "text": "No, he has said a few things in his sleep, though.",
            "nextDialogs": [
              "411131205"
            ]
          },
          "411131205": {
            "id": "411131205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What kind of things?",
            "nextDialogs": [
              "411131206"
            ]
          },
          "411131206": {
            "id": "411131206",
            "speakerId": 30008,
            "speakerName": "Huaqing",
            "text": "\"So cold,\" \"Can't go on,\" ...Things like that.",
            "nextDialogs": [
              "411131207"
            ]
          },
          "411131207": {
            "id": "411131207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The previous victims have said they were cold, too.",
            "nextDialogs": [
              "411131208"
            ]
          },
          "411131208": {
            "id": "411131208",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "Somewhere cold, up in the mountains... Where could it be?"
          }
        }
      }
    },
    {
      "subId": "4111313",
      "subQuestName": "Examine the nearby victims (1/3)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131301"
        ],
        "dialogs": {
          "411131301": {
            "id": "411131301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, has this guy woken up at any point?",
            "nextDialogs": [
              "411131302"
            ]
          },
          "411131302": {
            "id": "411131302",
            "speakerId": 30009,
            "speakerName": "Yang",
            "text": "Not so far.",
            "nextDialogs": [
              "411131303"
            ]
          },
          "411131303": {
            "id": "411131303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay... Um, has he said anything in his sleep?",
            "nextDialogs": [
              "411131304"
            ]
          },
          "411131304": {
            "id": "411131304",
            "speakerId": 30009,
            "speakerName": "Yang",
            "text": "Now that you mention it... Yesterday, he suddenly cried out \"So high!\" Who knows what he was dreaming about.",
            "nextDialogs": [
              "411131305"
            ]
          },
          "411131305": {
            "id": "411131305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How high? High as a snowy mountain peak, maybe?",
            "nextDialogs": [
              "411131306"
            ]
          },
          "411131306": {
            "id": "411131306",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "A wicked mountain, its frozen peak looming high, home to a malevolent power...",
            "nextDialogs": [
              "411131307"
            ]
          },
          "411131307": {
            "id": "411131307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's talk to that guy over there next."
          }
        }
      }
    },
    {
      "subId": "4111314",
      "subQuestName": "Examine the nearby victims (2/3)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131401"
        ],
        "dialogs": {
          "411131401": {
            "id": "411131401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hello, have any of the victims woken up?",
            "nextDialogs": [
              "411131402"
            ]
          },
          "411131402": {
            "id": "411131402",
            "speakerId": 30010,
            "speakerName": "Bro Huang",
            "text": "Funny you should ask! <color=#00E1FFFF>Gao the Sixth</color> literally just woke up.",
            "nextDialogs": [
              "411131403"
            ]
          },
          "411131403": {
            "id": "411131403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright! We're gonna go talk to him.",
            "nextDialogs": [
              "411131404"
            ]
          },
          "411131404": {
            "id": "411131404",
            "speakerId": 30010,
            "speakerName": "Bro Huang",
            "text": "That's fine, but he's only just awoken and is still very weak. If you must question him, please be gentle.",
            "nextDialogs": [
              "411131405"
            ]
          },
          "411131405": {
            "id": "411131405",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Greetings, you who have suffered and lived to tell the tale. Your sovereign shall question you now.",
            "nextDialogs": [
              "411131406"
            ]
          },
          "411131406": {
            "id": "411131406",
            "speakerId": 30026,
            "speakerName": "Gao the Sixth",
            "text": "Food... Need food...",
            "nextDialogs": [
              "411131407"
            ]
          },
          "411131407": {
            "id": "411131407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are you okay? Sounds like you're starving.",
            "nextDialogs": [
              "411131408"
            ]
          },
          "411131408": {
            "id": "411131408",
            "speakerId": 30026,
            "speakerName": "Gao the Sixth",
            "text": "Ugh... Oof...",
            "nextDialogs": [
              "411131411"
            ]
          },
          "411131411": {
            "id": "411131411",
            "speakerId": 30026,
            "speakerName": "Gao the Sixth",
            "text": "I need... home... home cooking...",
            "nextDialogs": [
              "411131412"
            ]
          },
          "411131412": {
            "id": "411131412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Home cooking from Qingce Village? Well that can only mean one thing: <color=#00E1FFFF>farmer food</color>!"
          }
        }
      }
    },
    {
      "subId": "4111320",
      "subQuestName": "Make 1 Qingce Stir Fry",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411132001"
        ],
        "dialogs": {
          "411132001": {
            "id": "411132001",
            "speakerId": 2138,
            "speakerName": "Ms. Bai",
            "text": "Try some Qingce Stir Fry — you won't find a more delicious bargain anywhere!"
          }
        }
      }
    },
    {
      "subId": "4111311",
      "subQuestName": "Bring Gao the Sixth some Qingce Stir Fry",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131101"
        ],
        "dialogs": {
          "411131101": {
            "id": "411131101",
            "speakerId": 30026,
            "speakerName": "Gao the Sixth",
            "text": "Phwoar! That's brought me back from the brink, that has!",
            "nextDialogs": [
              "411131102"
            ]
          },
          "411131102": {
            "id": "411131102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did you have a dream while you were sleeping?",
            "nextDialogs": [
              "411131103"
            ]
          },
          "411131103": {
            "id": "411131103",
            "speakerId": 30026,
            "speakerName": "Gao the Sixth",
            "text": "Only the most exhausting dream of my whole life!",
            "nextDialogs": [
              "411131104"
            ]
          },
          "411131104": {
            "id": "411131104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really? Why, what happened?",
            "nextDialogs": [
              "411131106",
              "411131108"
            ]
          },
          "411131106": {
            "id": "411131106",
            "speakerId": 30026,
            "speakerName": "Gao the Sixth",
            "text": "Yes... how did you know? Way up in the mountains, the highest mountain I've ever seen... It was freezing up there.",
            "nextDialogs": [
              "411131109"
            ]
          },
          "411131109": {
            "id": "411131109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What were you doing there?",
            "nextDialogs": [
              "411131110"
            ]
          },
          "411131110": {
            "id": "411131110",
            "speakerId": 30026,
            "speakerName": "Gao the Sixth",
            "text": "I'm not sure. It's like I was... possessed. I was consumed by the idea of climbing up the mountain and trying to reach the summit.",
            "nextDialogs": [
              "411131111"
            ]
          },
          "411131111": {
            "id": "411131111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Was there something special at the summit, or?",
            "nextDialogs": [
              "411131112"
            ]
          },
          "411131112": {
            "id": "411131112",
            "speakerId": 30026,
            "speakerName": "Gao the Sixth",
            "text": "Who knows? Honestly, it's like I became a completely different person in my dream. Don't ask me why, I have no idea...",
            "nextDialogs": [
              "411131113"
            ]
          },
          "411131113": {
            "id": "411131113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So it wasn't \"you\" who wanted to climb the mountain?",
            "nextDialogs": [
              "411131114"
            ]
          },
          "411131114": {
            "id": "411131114",
            "speakerId": 30026,
            "speakerName": "Gao the Sixth",
            "text": "It's hard to describe... It's like I was being controlled, as if somebody else put the idea of climbing the mountain into my head. I know how crazy that sounds, but...",
            "nextDialogs": [
              "411131115"
            ]
          },
          "411131115": {
            "id": "411131115",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "An intruder trespassed in the dark recesses of your soul!?",
            "nextDialogs": [
              "411131116"
            ]
          },
          "411131116": {
            "id": "411131116",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "An idea not autonomously generated by the individual, but that appeared within the subconscious... Yes, the signs do indeed point towards mind control."
          },
          "411131108": {
            "id": "411131108",
            "speakerId": 30026,
            "speakerName": "Gao the Sixth",
            "text": "Well, sort of. Up a snowy mountain, to be precise. It was huge, and it was freezing cold... The moment I fell asleep, I was standing at the foot of the mountain."
          }
        }
      }
    },
    {
      "subId": "4111307",
      "subQuestName": "Tell Mona about the meteorites",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411130701"
        ],
        "dialogs": {
          "411130701": {
            "id": "411130701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Mona, we found some stuff out!",
            "nextDialogs": [
              "411130702"
            ]
          },
          "411130702": {
            "id": "411130702",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "An ice-capped mountain looms over the world from far above the clouds... That is the place from which this burgeoning darkness proceeds.",
            "nextDialogs": [
              "411130703"
            ]
          },
          "411130703": {
            "id": "411130703",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Ice-capped mountain? Is that all?",
            "nextDialogs": [
              "411130704"
            ]
          },
          "411130704": {
            "id": "411130704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It is the same ice-capped mountain in everyone's dream.",
            "nextDialogs": [
              "411130705"
            ]
          },
          "411130705": {
            "id": "411130705",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's a really really high mountain that no one's ever seen before, and it's super cold up there. The sleepers are forced to try and climb to the summit, but they don't know why.",
            "nextDialogs": [
              "411130706"
            ]
          },
          "411130706": {
            "id": "411130706",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Climb the mountain? To the summit?",
            "nextDialogs": [
              "411130707"
            ]
          },
          "411130707": {
            "id": "411130707",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "What sort of person would wish to reach the summit of that mountain? And how is their desire strong enough to exert an influence on others?",
            "nextDialogs": [
              "411130708"
            ]
          },
          "411130708": {
            "id": "411130708",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Perchance some poor soul lies there, buried in the snow, hounded to death on the mountain?",
            "nextDialogs": [
              "411130709"
            ]
          },
          "411130709": {
            "id": "411130709",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "Or... Some intrepid explorer was exceptionally keen to conquer that particular mountain.",
            "nextDialogs": [
              "411130710"
            ]
          },
          "411130710": {
            "id": "411130710",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "I'll do another reading!",
            "nextDialogs": [
              "411130711"
            ]
          },
          "411130711": {
            "id": "411130711",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Aha! I see something here... It's a little vague but I think I can get his name... Ah, yes! <color=#00E1FFFF>\"Leonard\"</color>!",
            "nextDialogs": [
              "411130712"
            ]
          },
          "411130712": {
            "id": "411130712",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, that was fast!",
            "nextDialogs": [
              "411130713"
            ]
          },
          "411130713": {
            "id": "411130713",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Well, in case you'd forgotten... I am a genius!",
            "nextDialogs": [
              "411130714"
            ]
          },
          "411130714": {
            "id": "411130714",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Leonard...\" Paimon's never heard that name before."
          }
        }
      }
    },
    {
      "subId": "4111316",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131601"
        ],
        "dialogs": {
          "411131601": {
            "id": "411131601",
            "speakerId": 10013,
            "speakerName": "The Balladeer",
            "text": "Hi!"
          }
        }
      }
    },
    {
      "subId": "4111308",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411130715"
        ],
        "dialogs": {
          "411130715": {
            "id": "411130715",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Any junior fortune-teller could have told you this, but... That man was a Fatui Harbinger! That was too close, how did you manage to get caught up with a guy like him?",
            "nextDialogs": [
              "411130716"
            ]
          },
          "411130716": {
            "id": "411130716",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "A Fatui Harbinger? Why, their wickedness knows no bounds!",
            "nextDialogs": [
              "411130717"
            ]
          },
          "411130717": {
            "id": "411130717",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A Harbinger? Goodness...",
            "nextDialogs": [
              "411130718"
            ]
          },
          "411130718": {
            "id": "411130718",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Whatever he was planning to do... He was heading straight for you.",
            "nextDialogs": [
              "411130719"
            ]
          },
          "411130719": {
            "id": "411130719",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "And he is an extremely powerful individual! I sensed it the moment I looked at him. He's far more powerful than you'd imagine.",
            "nextDialogs": [
              "411130720"
            ]
          },
          "411130720": {
            "id": "411130720",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "As much as it pains me to admit it...",
            "nextDialogs": [
              "411130721"
            ]
          },
          "411130721": {
            "id": "411130721",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "Surely his power cannot match that of the astrological genius of the century?",
            "nextDialogs": [
              "411130722"
            ]
          },
          "411130722": {
            "id": "411130722",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "I never said that...! His strength may exceed mine by a hair's breadth... But in astrology alone, he doesn't come close!",
            "nextDialogs": [
              "411130723"
            ]
          },
          "411130723": {
            "id": "411130723",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This reminds Paimon of something... We ran into some Fatui at Wangshu Inn, too!",
            "nextDialogs": [
              "411130724"
            ]
          },
          "411130724": {
            "id": "411130724",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What interest could the Fatui have in the meteorites?",
            "nextDialogs": [
              "411130725"
            ]
          },
          "411130725": {
            "id": "411130725",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "They must be plotting something.",
            "nextDialogs": [
              "411130726"
            ]
          },
          "411130726": {
            "id": "411130726",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Hmm... Maybe, just maybe...",
            "nextDialogs": [
              "411130727"
            ]
          },
          "411130727": {
            "id": "411130727",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh! The Fatui are the ones who caused the meteor shower in the first place! Was that it?",
            "nextDialogs": [
              "411130728"
            ]
          },
          "411130728": {
            "id": "411130728",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Paimon, that was my line! Get your own!",
            "nextDialogs": [
              "411130729"
            ]
          },
          "411130729": {
            "id": "411130729",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sorry... Paimon's mouth just works so much faster than everyone else's.",
            "nextDialogs": [
              "411130730"
            ]
          },
          "411130730": {
            "id": "411130730",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Does the power to summon a meteorite strike really exist?",
            "nextDialogs": [
              "411130731"
            ]
          },
          "411130731": {
            "id": "411130731",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah... Where'd they get the power to pull stars out of the sky!?",
            "nextDialogs": [
              "411130732"
            ]
          },
          "411130732": {
            "id": "411130732",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Ozvaldo Hrafnavins, what is thy opinion?",
            "nextDialogs": [
              "411130733"
            ]
          },
          "411130733": {
            "id": "411130733",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "I think that anything is possible, mein Fräulein.",
            "nextDialogs": [
              "411130734"
            ]
          },
          "411130734": {
            "id": "411130734",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "So long as they can afford to pay the price, they will never stop sowing their seeds of destruction across the land... Fatui, your sins shall not go unremembered.",
            "nextDialogs": [
              "411130735"
            ]
          },
          "411130735": {
            "id": "411130735",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "I also believe that miracles can happen.",
            "nextDialogs": [
              "411130736"
            ]
          },
          "411130736": {
            "id": "411130736",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Astral emissary, you have performed admirably as a member of my retinue. I will dispatch my forces to protect you, and they will ensure that the encroaching darkness shall bring you no harm.",
            "nextDialogs": [
              "411130737"
            ]
          },
          "411130737": {
            "id": "411130737",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "She means me.",
            "nextDialogs": [
              "411130738"
            ]
          },
          "411130738": {
            "id": "411130738",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No need! Paimon thinks that our current lineup works just fine... No need to fix it if it ain't broke!",
            "nextDialogs": [
              "411130739"
            ]
          },
          "411130739": {
            "id": "411130739",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "You underestimate me, Fischl! I'm far stronger than you seem to think.",
            "nextDialogs": [
              "411130740"
            ]
          },
          "411130740": {
            "id": "411130740",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "Mein Fräulein trusts no one more than yourself, my lady, she is simply concerned for your well-being.",
            "nextDialogs": [
              "411130741"
            ]
          },
          "411130741": {
            "id": "411130741",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "There's really no need. In any case, you're in a much more perilous position than I am. If anything, you need my protection.",
            "nextDialogs": [
              "411130743",
              "411130745"
            ]
          },
          "411130743": {
            "id": "411130743",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "...Huh? Wh—What're you saying that for?",
            "nextDialogs": [
              "411130746"
            ]
          },
          "411130746": {
            "id": "411130746",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "For now, we must deal with the new threat. My astrolabe tells me that a new meteorite has landed, and it's the <color=#00E1FFFF>biggest one yet</color>."
          },
          "411130745": {
            "id": "411130745",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Naturally!"
          }
        }
      }
    },
    {
      "subId": "4111317",
      "subQuestName": "Head to the spot where the giant meteorite made landfall",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131701"
        ],
        "dialogs": {
          "411131701": {
            "id": "411131701",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Wow. That's a big one."
          }
        }
      }
    },
    {
      "subId": "4111309",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411130901"
        ],
        "dialogs": {
          "411130901": {
            "id": "411130901",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "This is the one.",
            "nextDialogs": [
              "411130902"
            ]
          },
          "411130902": {
            "id": "411130902",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "I sense an unprecedented amount of elemental energy within.",
            "nextDialogs": [
              "411130903"
            ]
          },
          "411130903": {
            "id": "411130903",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "The very heart of darkness descends upon the world.",
            "nextDialogs": [
              "411130904"
            ]
          },
          "411130904": {
            "id": "411130904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What do the Fatui want with this? Is it the elemental power?",
            "nextDialogs": [
              "411130905"
            ]
          },
          "411130905": {
            "id": "411130905",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "It's possible... But if that were the case, other life forms would surely be drawn to the meteorites' energy too.",
            "nextDialogs": [
              "411130906"
            ]
          },
          "411130906": {
            "id": "411130906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's take a closer look."
          }
        }
      }
    },
    {
      "subId": "4111311",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411131100"
        ],
        "dialogs": {
          "411131100": {
            "id": "411131100",
            "speakerId": 30026,
            "speakerName": "Gao the Sixth",
            "text": "Food... Need food..."
          }
        }
      }
    }
  ]
}
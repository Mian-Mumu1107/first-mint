    {
      "subId": "1000705",
      "subQuestName": "Talk to Venti",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100070501"
        ],
        "dialogs": {
          "100070501": {
            "id": "100070501",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Ah, looks like our music has moved some in our audience to step on stage.",
            "nextDialogs": [
              "100070502"
            ]
          },
          "100070502": {
            "id": "100070502",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "But that's against concert rules, so let's usher them out."
          }
        }
      }
    },

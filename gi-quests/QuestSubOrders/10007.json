  "subQuests": [
    {
      "subId": "1000701",
      "subQuestName": "Talk to Venti",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100070101"
        ],
        "dialogs": {
          "100070101": {
            "id": "100070101",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "...I'll take that as a yes, then.",
            "nextDialogs": [
              "100070102"
            ]
          },
          "100070102": {
            "id": "100070102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Venti?",
            "nextDialogs": [
              "100070103"
            ]
          },
          "100070103": {
            "id": "100070103",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "#Ah, finally! You're here, {NICKNAME}! Do you have a message for me from someone, by any chance?",
            "nextDialogs": [
              "100070106"
            ]
          },
          "100070106": {
            "id": "100070106",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "There's not a single prophecy about you in that dictionary.",
            "nextDialogs": [
              "100070107"
            ]
          },
          "100070107": {
            "id": "100070107",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "That's what you were about to say, right?"
          }
        }
      }
    },
    {
      "subId": "1000704",
      "subQuestName": "Follow the wind with Venti",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100070401"
        ],
        "dialogs": {
          "100070401": {
            "id": "100070401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This island...",
            "nextDialogs": [
              "100070402"
            ]
          },
          "100070402": {
            "id": "100070402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is it special?",
            "nextDialogs": [
              "100070403"
            ]
          },
          "100070403": {
            "id": "100070403",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Not always. It was once an isle like any other — an ordinary, unassuming aggregation of sand and gravel.",
            "nextDialogs": [
              "100070404"
            ]
          },
          "100070404": {
            "id": "100070404",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "That is, until seeds of stories were brought here by the wind, and cultivated by time.",
            "nextDialogs": [
              "100070405"
            ]
          },
          "100070405": {
            "id": "100070405",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "And in due course, the wind brought forth new tales, and time caused them to grow into legends.",
            "nextDialogs": [
              "100070406"
            ]
          },
          "100070406": {
            "id": "100070406",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "#So, with that... Allow me to welcome you in \"truth\" to this island favored by Time, {NICKNAME}.",
            "nextDialogs": [
              "100070407"
            ]
          },
          "100070407": {
            "id": "100070407",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "This is the place where Time and Wind met in the distant past.",
            "nextDialogs": [
              "100070408"
            ]
          },
          "100070408": {
            "id": "100070408",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa, whoa, whoa... You suddenly sound so serious, Tone-Deaf Bard. Paimon's not sure she's following this conversation anymore, either...",
            "nextDialogs": [
              "100070409"
            ]
          },
          "100070409": {
            "id": "100070409",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Hehe, fret not, dear Paimon! The best stories always start with a bit of suspense and intrigue."
          }
        }
      }
    },
    {
      "subId": "1000702",
      "subQuestName": "Follow the wind with Venti",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100070201"
        ],
        "dialogs": {
          "100070201": {
            "id": "100070201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh, this island looks kinda familiar..."
          }
        }
      }
    },
    {
      "subId": "1000703",
      "subQuestName": "Perform together with Venti",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100071201"
        ],
        "dialogs": {
          "100071201": {
            "id": "100071201",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "But, forceful gales like that are most suited to wiping things clean, not helping things grow.",
            "nextDialogs": [
              "100071202"
            ]
          },
          "100071202": {
            "id": "100071202",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "So, after a few crises in Mondstadt were resolved, I made the winds gentler — just strong enough to bolster the people in times of need without knocking them off their feet.",
            "nextDialogs": [
              "100071205"
            ]
          },
          "100071205": {
            "id": "100071205",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "...",
            "nextDialogs": [
              "100071206"
            ]
          },
          "100071206": {
            "id": "100071206",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Shadows gather in the distance. I'm sure you've felt it, too.",
            "nextDialogs": [
              "100071207"
            ]
          },
          "100071207": {
            "id": "100071207",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "I've heard about the Pyro Archon's face-off with the Ruler of Death, Ronova, and what happened to the Fatui Harbinger, The Captain.",
            "nextDialogs": [
              "100071208"
            ]
          },
          "100071208": {
            "id": "100071208",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "And that's not even mentioning how Abyssal activity has been encroaching closer and closer to Mondstadt.",
            "nextDialogs": [
              "100071209"
            ]
          },
          "100071209": {
            "id": "100071209",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "I fear the impending crisis may be beyond what humans alone can solve... In light of that, I need to be prepared.",
            "nextDialogs": [
              "100071210"
            ]
          },
          "100071210": {
            "id": "100071210",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "It's the Anemo Archon's duty to intervene in times of need. As such, I, Barbatos, will bring forth a wind strong enough to disperse whatever storm lies ahead.",
            "nextDialogs": [
              "100071211"
            ]
          },
          "100071211": {
            "id": "100071211",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "But, if I whip up a gale of such strength in Mondstadt City, it would just turn the place upside down — clothes, hats, the flowers that rest on people's balconies...",
            "nextDialogs": [
              "100071212"
            ]
          },
          "100071212": {
            "id": "100071212",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "That's why I chose to do it here — the place where I once offered an ode to Time.",
            "nextDialogs": [
              "100071213"
            ]
          },
          "100071213": {
            "id": "100071213",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Who knows, perhaps Time shows this island special favor precisely on account of my lovely, lovely music.",
            "nextDialogs": [
              "100071214"
            ]
          },
          "100071214": {
            "id": "100071214",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, so... Is this place really that special? It sure doesn't look like it...",
            "nextDialogs": [
              "100071215"
            ]
          },
          "100071215": {
            "id": "100071215",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "There's a tide that ebbs and flows, and a bunch of birds that come and go... It just seems... normal.",
            "nextDialogs": [
              "100071216"
            ]
          },
          "100071216": {
            "id": "100071216",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Time's impact on things isn't limited to what the eye can see. Think of it like... a ripe Sunsettia.",
            "nextDialogs": [
              "100071217"
            ]
          },
          "100071217": {
            "id": "100071217",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "If the outer peel remains intact, it's nearly impossible for the average person to tell whether the fruit inside is ripe.",
            "nextDialogs": [
              "100071218"
            ]
          },
          "100071218": {
            "id": "100071218",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "But even the tiniest hole in said peel will cause the fruit to rot, starting from that spot.",
            "nextDialogs": [
              "100071219"
            ]
          },
          "100071219": {
            "id": "100071219",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Nestled in the hands of Time, not one \"blemish\" marks this island's \"peel.\" Thus, Time's influence on its very essence remains hidden to all.",
            "nextDialogs": [
              "100071220"
            ]
          },
          "100071220": {
            "id": "100071220",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "At the most fundamental level, of course, all things that lack Time's favor will be erased at some point.",
            "nextDialogs": [
              "100071221"
            ]
          },
          "100071221": {
            "id": "100071221",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "But with the power that remains here, I can leverage Time to draw a boundary around the Wind.",
            "nextDialogs": [
              "100071222"
            ]
          },
          "100071222": {
            "id": "100071222",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "That way, the outside world won't notice a thing, no matter how powerful of a gale I whip up here.",
            "nextDialogs": [
              "100071223"
            ]
          },
          "100071223": {
            "id": "100071223",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "#Of course, as the one requesting help, I should offer something in return. That's why I invited you here, {NICKNAME}... So we could perform an ode to Time together.",
            "nextDialogs": [
              "100071224"
            ]
          },
          "100071224": {
            "id": "100071224",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "#Just let me know when you're ready, {NICKNAME}. Oh, and I can lend you an instrument if you need one."
          }
        }
      }
    },
    {
      "subId": "1000710",
      "subQuestName": "Perform together with Venti",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100071001"
        ],
        "dialogs": {
          "100071001": {
            "id": "100071001",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Once upon a time, I summoned the first winds of freedom on behalf of Mondstadt's people. With the aid of those winds, liberty was returned to all who were owed it."
          }
        }
      }
    },

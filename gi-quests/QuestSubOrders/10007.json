    {
      "subId": "1000711",
      "subQuestName": "Talk to Venti",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100071101"
        ],
        "dialogs": {
          "100071101": {
            "id": "100071101",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "I told you about this before, remember? About how I encountered \"Time\" at the Thousand Winds Temple and received some help.",
            "nextDialogs": [
              "100071102"
            ]
          },
          "100071102": {
            "id": "100071102",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Well, it was because of Time's help that the those first winds of freedom were able to blow so strongly."
          }
        }
      }
    },
    {
      "subId": "1000707",
      "subQuestName": "Talk to Venti",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100070701"
        ],
        "dialogs": {
          "100070701": {
            "id": "100070701",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "#Alright, that should do it. This was an exquisite performance, {NICKNAME}. Thank you.",
            "nextDialogs": [
              "100070702"
            ]
          },
          "100070702": {
            "id": "100070702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That power you unleashed just now...",
            "nextDialogs": [
              "100070703"
            ]
          },
          "100070703": {
            "id": "100070703",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Ah, don't worry. That power was mine and mine alone. No external help was involved.",
            "nextDialogs": [
              "100070704"
            ]
          },
          "100070704": {
            "id": "100070704",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Think of it like... tuning a musical instrument so that it might play melodies lovelier still.",
            "nextDialogs": [
              "100070705"
            ]
          },
          "100070705": {
            "id": "100070705",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hah, so you do have some tricks up your sleeve! What else are you hiding, hmm?",
            "nextDialogs": [
              "100070706"
            ]
          },
          "100070706": {
            "id": "100070706",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Oh, Paimon. How many tricks could I possibly have? I only have two sleeves, after all.",
            "nextDialogs": [
              "100070707"
            ]
          },
          "100070707": {
            "id": "100070707",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You know that's not what Paimon meant, Tone-Deaf Bard!",
            "nextDialogs": [
              "100070708"
            ]
          },
          "100070708": {
            "id": "100070708",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Hahaha, I have a feeling the wind is gonna be pretty strong today. We should head back to Mondstadt and tell people to hold onto their hats."
          }
        }
      }
    },
    {

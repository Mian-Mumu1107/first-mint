    {
      "subId": "1000799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100079901"
        ],
        "dialogs": {
          "100079901": {
            "id": "100079901",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Just relax, and let the wind lead the way.",
            "nextDialogs": [
              "100079902"
            ]
          },
          "100079902": {
            "id": "100079902",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "We're almost there.",
            "nextDialogs": [
              "100079903"
            ]
          },
          "100079903": {
            "id": "100079903",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "I understand your love for music, of course...",
            "nextDialogs": [
              "100079904"
            ]
          },
          "100079904": {
            "id": "100079904",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "But for now, I'm going to have you... leave the premises.",
            "nextDialogs": [
              "100079905"
            ]
          },
          "100079905": {
            "id": "100079905",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Alright, let's get going.",
            "nextDialogs": [
              "100079906"
            ]
          },
          "100079906": {
            "id": "100079906",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Hahaha, no need to hold your breath. In and out, easy does it.",
            "nextDialogs": [
              "100079908"
            ]
          },
          "100079908": {
            "id": "100079908",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "I let the birds know we would be coming, so we won't run into them.",
            "nextDialogs": [
              "100079911"
            ]
          },
          "100079911": {
            "id": "100079911",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Hmm... We're almost there."
          }
        }
      }

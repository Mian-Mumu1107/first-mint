        "dialogs": {
          "721520101": {
            "id": "721520101",
            "speakerId": 20336,
            "speakerName": "Treasure Hoarder's Notes",
            "text": "\"...This used to be where the great pirate Rinzou stored his treasure. The lads moved the last few chests out...\"",
            "nextDialogs": [
              "721520102"
            ]
          },
          "721520102": {
            "id": "721520102",
            "speakerId": 20336,
            "speakerName": "Treasure Hoarder's Notes",
            "text": "\"...Rinzou was a cunning man in life, though, and he left all manner of special symbols on the island...\"",
            "nextDialogs": [
              "721520103"
            ]
          },
          "721520103": {
            "id": "721520103",
            "speakerId": 20336,
            "speakerName": "Treasure Hoarder's Notes",
            "text": "\"...It might be a smokescreen, or there might really be treasure. But we'll only find out if we go there and see for ourselves...\"",
            "nextDialogs": [
              "721520104"
            ]
          },
          "721520104": {
            "id": "721520104",
            "speakerId": 20336,
            "speakerName": "Treasure Hoarder's Notes",
            "text": "\"...We've found some of those symbols. Well, time waits for no one. Best we go dig up Rinzou's full hoard!\"",
            "nextDialogs": [
              "721520105"
            ]
          },
          "721520105": {
            "id": "721520105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, this is... really long... Paimon really can't be bothered to read any of this other than the bit about treasure...",
            "nextDialogs": [
              "721520106"
            ]
          },
          "721520106": {
            "id": "721520106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait... Treasure!?",
            "nextDialogs": [
              "721520107"
            ]
          },
          "721520107": {
            "id": "721520107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "C'mon, Traveler, there's treasure to be had! We can't let the Treasure Hoarders get ahead of us!"
          }
        }
      }
    }
  ]

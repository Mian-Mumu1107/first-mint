    {
      "subId": "4112507",
      "subQuestName": "Investigate the Whispering Woods",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411250701"
        ],
        "dialogs": {
          "411250701": {
            "id": "411250701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There aren't a lot of adventurers out there investigating...",
            "nextDialogs": [
              "411250702"
            ]
          },
          "411250702": {
            "id": "411250702",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "Ugh. Now that you mention it, there weren't a lot of adventurers who took up this set of commissions...",
            "nextDialogs": [
              "411250703"
            ]
          },
          "411250703": {
            "id": "411250703",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "It's always the same few people coming and going. Cyrus has been quite concerned, as well."
          }
        }
      }
    },
    {
      "subId": "4112511",
      "subQuestName": "Talk to Pallad",
      "sceneId": null,
      "locations": [],
      "dialogue": {

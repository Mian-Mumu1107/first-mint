        "dialogs": {}
      }
    },
    {
      "subId": "4112508",
      "subQuestName": "Investigate the Whispering Woods",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411250801"
        ],
        "dialogs": {
          "411250801": {
            "id": "411250801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There are still some scholars who refuse to seek shelter in the city.",
            "nextDialogs": [
              "411250802"
            ]
          },
          "411250802": {
            "id": "411250802",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "Is that so... Well, they've never been the easiest to convince."
          }
        }
      }
    },

    {
      "subId": "4112518",
      "subQuestName": "Report back to Jack",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411251001"
        ],
        "dialogs": {
          "411251001": {
            "id": "411251001",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "Alright, I understand the situation now. Please take these as thanks for helping me investigate.",
            "nextDialogs": [
              "411251002"
            ]
          },
          "411251002": {
            "id": "411251002",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "Scholars who refuse to seek shelter, abnormal monsters, and a lack of available manpower...",
            "nextDialogs": [
              "411251003"
            ]
          },
          "411251003": {
            "id": "411251003",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "Come on, Jack, think... There has to be some way to convince Cyrus..."
          }
        }
      }

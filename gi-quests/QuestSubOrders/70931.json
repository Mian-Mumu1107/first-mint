          },
          "709310102": {
            "id": "709310102",
            "speakerId": 1557,
            "speakerName": "Ulfr",
            "text": "Someday, I'll invite Flora to board a dandelion boat that I built by my own hand... It's just such a shame that my last few attempts all sank on the maiden voyage...",
            "nextDialogs": [
              "709310103"
            ]
          },
          "709310103": {
            "id": "709310103",
            "speakerId": 1557,
            "speakerName": "Ulfr",
            "text": "...But every cloud has a silver lining. My swimming ability has improved greatly as a result!",
            "nextDialogs": [
              "709310104"
            ]
          },
          "709310104": {
            "id": "709310104",
            "speakerId": 1557,
            "speakerName": "Ulfr",
            "text": "Last time, I even had several crabs grab onto my eyelids. But I still managed to swim back to shore, even though I couldn't see.",
            "nextDialogs": [
              "709310105"
            ]
          },
          "709310105": {
            "id": "709310105",
            "speakerId": 1557,
            "speakerName": "Ulfr",
            "text": "Oh, and several more ended up in my pockets too... Here, you can have them. Now, I have a boat to build!"
          }
        }
      }

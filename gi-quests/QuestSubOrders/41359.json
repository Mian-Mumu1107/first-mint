          "413590301": {
            "id": "413590301",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "Wow. You, um, did it.",
            "nextDialogs": [
              "413590302"
            ]
          },
          "413590302": {
            "id": "413590302",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "All in a day's work for you, huh? I gotta say, you're one heck of an adventurer.",
            "nextDialogs": [
              "413590303"
            ]
          },
          "413590303": {
            "id": "413590303",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "Go take a look at the screens. You'll find all the treasure clues in there."
          }
        }
      }

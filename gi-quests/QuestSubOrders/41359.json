    {
      "subId": "4135901",
      "subQuestName": "Talk to Brother Qian",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413590101"
        ],
        "dialogs": {
          "413590101": {
            "id": "413590101",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "Try the Illumiscreen...",
            "nextDialogs": [
              "413590102"
            ]
          },
          "413590102": {
            "id": "413590102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you have another image for me?",
            "nextDialogs": [
              "413590103"
            ]
          },
          "413590103": {
            "id": "413590103",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "You bet! And since you solved both the previous ones so easily, I've swapped the lanterns for the most difficult ones available.",
            "nextDialogs": [
              "413590104"
            ]
          },
          "413590104": {
            "id": "413590104",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "The same principle applies — you combine three images to make one whole. The difficulty is in the fact that they're <color=#00E1FFFF>linked together</color> this time.",
            "nextDialogs": [
              "413590105"
            ]
          },
          "413590105": {
            "id": "413590105",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "Hehe, you'll see what I mean when you give it a try. This time, you're looking for a <color=#00E1FFFF>divine crane</color>.",
            "nextDialogs": [
              "413590106"
            ]
          },
          "413590106": {
            "id": "413590106",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "Once you've got the images to align, you can go find the treasure."
          }
        }
      }
    },
    {
      "subId": "4135902",
      "subQuestName": "Complete \"Illumiscreen: Crane\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413590201"
        ],
        "dialogs": {
          "413590201": {
            "id": "413590201",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "How is the treasure hunt going?",
            "nextDialogs": [
              "413590202"
            ]
          },
          "413590202": {
            "id": "413590202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I've found every last chest.",
            "nextDialogs": [
              "413590203"
            ]
          },
          "413590203": {
            "id": "413590203",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "Wow, you managed to decipher all three images... That's impressive...",
            "nextDialogs": [
              "413590204"
            ]
          },
          "413590204": {
            "id": "413590204",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "Ahem. The Guild has prepared an extra-special gift for you on account of you being such an accomplished adventurer.",
            "nextDialogs": [
              "413590205"
            ]
          },
          "413590205": {
            "id": "413590205",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "See those chests? Go ahead and open them. The contents are all for you.",
            "nextDialogs": [
              "413590206"
            ]
          },
          "413590206": {
            "id": "413590206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But if I take all the prizes...",
            "nextDialogs": [
              "413590207"
            ]
          },
          "413590207": {
            "id": "413590207",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "Yep, there'll be squat left for anyone else. That's adventuring for you! Finders keepers.",
            "nextDialogs": [
              "413590208"
            ]
          },
          "413590208": {
            "id": "413590208",
            "speakerId": 1000,
            "speakerName": "Brother Qian",
            "text": "Alright then, happy Lantern Rite. Have a good one."
          }
        }
      }
    },
    {

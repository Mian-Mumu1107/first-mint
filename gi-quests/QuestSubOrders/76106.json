  },
  "subQuests": [
    {
      "subId": "7610601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060401"
        ],
        "dialogs": {
          "761060401": {
            "id": "761060401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is this all the mighty Fatui are capable of?",
            "nextDialogs": [
              "761060402"
            ]
          },
          "761060402": {
            "id": "761060402",
            "speakerId": 1000,
            "speakerName": "Veroslava",
            "text": "Tsk, is \"way too sassy\" part of our recruitment profile nowadays...? Wait a sec — you're not one of the new recruits we just brought in!",
            "nextDialogs": [
              "761060403"
            ]
          },
          "761060403": {
            "id": "761060403",
            "speakerId": 1000,
            "speakerName": "Veroslava",
            "text": "Thought you could infiltrate, did you? Too bad, I've seen right through you! Seize them!"
          }
        }
      }
    },
    {
      "subId": "7610601",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060101"
        ],
        "dialogs": {
          "761060101": {
            "id": "761060101",
            "speakerId": 1000,
            "speakerName": "Veroslava",
            "text": "Hmm? You look kind of unfamiliar. You're new around here, aren't you?"
          }
        }
      }
    },
    {
      "subId": "7610602",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060201"
        ],
        "dialogs": {
          "761060201": {
            "id": "761060201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Yes.",
            "nextDialogs": [
              "761060202"
            ]
          },
          "761060202": {
            "id": "761060202",
            "speakerId": 1000,
            "speakerName": "Veroslava",
            "text": "I'm saying this for your own good — don't go poking around the Design Bureau, especially not the second floor! Too much kuuvahki exposure can cause anything from headaches to full-on nausea. Don't say I didn't warn you!"
          }
        }
      }
    },
    {
      "subId": "7610603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060301"
        ],
        "dialogs": {
          "761060301": {
            "id": "761060301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Really?",
            "nextDialogs": [
              "761060302"
            ]
          },
          "761060302": {
            "id": "761060302",
            "speakerId": 1000,
            "speakerName": "Veroslava",
            "text": "Of course! Everyone who works in there gets an extra serving of Apple Cider. Think about it — if it weren't bad for your health, why would they bribe people with something that good?",
            "nextDialogs": [
              "761060303"
            ]
          },
          "761060303": {
            "id": "761060303",
            "speakerId": 1000,
            "speakerName": "Veroslava",
            "text": "Besides, I saw it with my own eyes in the Frostmoon Scions' territory! Their priestesses grew horns — on their heads! You seriously think that's normal?",
            "nextDialogs": [
              "761060304"
            ]
          },
          "761060304": {
            "id": "761060304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I see... Thanks for the warning.",
            "nextDialogs": [
              "761060305"
            ]
          },
          "761060305": {
            "id": "761060305",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's awful! W—Will we turn into monsters too...?",
            "nextDialogs": [
              "761060306"
            ]
          },
          "761060306": {
            "id": "761060306",
            "speakerId": 1000,
            "speakerName": "Veroslava",
            "text": "*sigh* They always send the newbies in to do the risky stuff... Just be careful, and don't stay in there too long, alright?"
          }
        }
      }
    },
    {
      "subId": "7610605",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060501"
        ],
        "dialogs": {
          "761060501": {
            "id": "761060501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm your long-time nemesis! Pleased to make your acquaintance!",
            "nextDialogs": [
              "761060502"
            ]
          },
          "761060502": {
            "id": "761060502",
            "speakerId": 1000,
            "speakerName": "Veroslava",
            "text": "Agh, it's an enemy assault... All units — attack!"
          }
        }
      }
    },
    {
      "subId": "7610606",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060601"
        ],
        "dialogs": {
          "761060601": {
            "id": "761060601",
            "speakerId": 1000,
            "speakerName": "Veroslava",
            "text": "I told you not to stay in there for too long! Why are you still running around like that? Aren't you even a little worried about the side effects from all that kuuvahki exposure?"
          }
        }
      }
    },
    {
      "subId": "7610607",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060701"
        ],
        "dialogs": {
          "761060701": {
            "id": "761060701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not at all. I'm not as weak as you are.",
            "nextDialogs": [
              "761060702"
            ]
          },
          "761060702": {
            "id": "761060702",
            "speakerId": 1000,
            "speakerName": "Veroslava",
            "text": "Huh!? Is \"way too sassy\" part of our recruitment profile nowadays...? W—Wait a sec — you're not one of the new batch of newbies! Y—You must be a spy! Everyone, seize them!"
          }
        }
      }
    },
    {
      "subId": "7610608",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761060801"
        ],
        "dialogs": {
          "761060801": {
            "id": "761060801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Excuse me, I think I've taken a wrong turn...",
            "nextDialogs": [
              "761060802"
            ]
          },
          "761060802": {
            "id": "761060802",
            "speakerId": 1000,
            "speakerName": "Veroslava",
            "text": "This is a military zone! If you've got business here, get on with it. If not, quit wandering around."
          }
        }
      }
    }
  ]
}
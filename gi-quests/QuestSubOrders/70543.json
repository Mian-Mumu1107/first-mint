            ]
          },
          "705430109": {
            "id": "705430109",
            "speakerId": 30526,
            "speakerName": "Dustball",
            "text": "Meow, meow.",
            "nextDialogs": [
              "705430110"
            ]
          },
          "705430110": {
            "id": "705430110",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Friends followed the scent. You came too, happy. On your body, the smell of wind and rain, very familiar... The scent of cats, also familiar.",
            "nextDialogs": [
              "705430111"
            ]
          },
          "705430111": {
            "id": "705430111",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Paimon, very sweet scent. Smell good.",
            "nextDialogs": [
              "705430112"
            ]
          },
          "705430112": {
            "id": "705430112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh!? Sweet... Could that be the flavor of the pancakes Valerina gave us? D—Did Paimon eat that many?",
            "nextDialogs": [
              "705430115"
            ]
          },
          "705430115": {
            "id": "705430115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really? Paimon didn't even notice... Mmm, it's all the pancake's fault for being so delicious!",
            "nextDialogs": [
              "705430116"
            ]
          },
          "705430116": {
            "id": "705430116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, and Paimon also wants to eat Sweet Madames, Steaks, and Hash Browns... oh, and drink some Apple Cider!",
            "nextDialogs": [
              "705430117"
            ]
          },
          "705430117": {
            "id": "705430117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Okay, that's the menu for the next meal then! C'mon, {NICKNAME}, let's go place our order with Valerina! You come too, Razor!",
            "nextDialogs": [
              "705430118"
            ]
          },
          "705430118": {
            "id": "705430118",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Thank... Thank you...",
            "nextDialogs": [
              "705430119"
            ]
          },
          "705430119": {
            "id": "705430119",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Dustball has brought me lots of... nuts...",
            "nextDialogs": [
              "705430120"
            ]
          },
          "705430120": {
            "id": "705430120",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "And, meat boxes... I am very full.",
            "nextDialogs": [
              "705430121"
            ]
          },
          "705430121": {
            "id": "705430121",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sounds like Valerina ordered delivery, then? Did Dustball deliver the food to you, Razor?",
            "nextDialogs": [
              "705430122"
            ]
          },
          "705430122": {
            "id": "705430122",
            "speakerId": 30526,
            "speakerName": "Dustball",
            "text": "Meow-meow. Meow!",
            "nextDialogs": [
              "705430123"
            ]
          },
          "705430123": {
            "id": "705430123",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon never imagined that the cats would actually end up taking care of the customers here in the Furball Fortress!",
            "nextDialogs": [
              "705430124"

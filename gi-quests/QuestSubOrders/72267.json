      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722670201"
        ],
        "dialogs": {
          "722670201": {
            "id": "722670201",
            "speakerId": 1000,
            "speakerName": "Tablet Text",
            "text": "(The stone tablet has some intelligible words on it that say...)",
            "nextDialogs": [
              "722670202"
            ]
          },
          "722670202": {
            "id": "722670202",
            "speakerId": 1000,
            "speakerName": "Tablet Text",
            "text": "My father told me that everything we do should be backed up by morality and brought forth with elegance.",
            "nextDialogs": [
              "722670203"
            ]
          },
          "722670203": {
            "id": "722670203",
            "speakerId": 1000,
            "speakerName": "Tablet Text",
            "text": "That's why he said that I should use these words to record hints for my labyrinth.",
            "nextDialogs": [
              "722670204"
            ]
          },
          "722670204": {
            "id": "722670204",
            "speakerId": 1000,
            "speakerName": "Tablet Text",
            "text": "Only within Evernight will the mechanisms to the labyrinth walls and the way forward appear, bathed in invisible moonlight as they are.",
            "nextDialogs": [
              "722670205"
            ]
          },
          "722670205": {
            "id": "722670205",
            "speakerId": 1000,
            "speakerName": "Tablet Text",
            "text": "The mechanisms that control the solution to this labyrinth are hidden in its four corners.",
            "nextDialogs": [
              "722670206"
            ]
          },
          "722670206": {
            "id": "722670206",
            "speakerId": 1000,
            "speakerName": "Tablet Text",
            "text": "And because I lacked rhyme or rhetoric in my writing at the end...",
            "nextDialogs": [
              "722670207"
            ]
          },
          "722670207": {
            "id": "722670207",
            "speakerId": 1000,
            "speakerName": "Tablet Text",
            "text": "My father, Eurydates, gave me a few strokes on the backside with his crutches."
          }
        }
      }
    },
    {
      "subId": "7226799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722679901"
        ],
        "dialogs": {
          "722679901": {
            "id": "722679901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh. Wait. If you can see labyrinth from above, wouldn't it cease to pose any challenge at all? Well then, guess I'll just do this."
          }
        }
      }
    }

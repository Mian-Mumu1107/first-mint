  "subQuests": [
    {
      "subId": "1112001",
      "subQuestName": "Go to the Liyue Adventurers' Guild and talk to Katheryne",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111200101"
        ],
        "dialogs": {
          "111200101": {
            "id": "111200101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hi Katheryne, it's us! Any new commissions?",
            "nextDialogs": [
              "111200102"
            ]
          },
          "111200102": {
            "id": "111200102",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "As a matter of fact, there's one that looks perfect for you two.",
            "nextDialogs": [
              "111200103"
            ]
          },
          "111200103": {
            "id": "111200103",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "Uncle Dai is one of the foremen at Huishan Hall over in Liyue Harbor. He's hoping the Adventurers' Guild can spare some manpower.",
            "nextDialogs": [
              "111200104"
            ]
          },
          "111200104": {
            "id": "111200104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What is it we have to do exactly?",
            "nextDialogs": [
              "111200105"
            ]
          },
          "111200105": {
            "id": "111200105",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "I believe you'll be looking for workers.",
            "nextDialogs": [
              "111200106"
            ]
          },
          "111200106": {
            "id": "111200106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, looking for people? Awesome, we're good at that!",
            "nextDialogs": [
              "111200107"
            ]
          },
          "111200107": {
            "id": "111200107",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "I have no reason to doubt your abilities.",
            "nextDialogs": [
              "111200108"
            ]
          },
          "111200108": {
            "id": "111200108",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "I'm sure the details can be worked out face to face. If you're willing to accept this commission, head over to the dock and talk to Uncle Dai."
          }
        }
      }
    },
    {
      "subId": "1112005",
      "subQuestName": "Head to the dock and find the foreman, Uncle Dai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1112002",
      "subQuestName": "Head to the dock and find the foreman, Uncle Dai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111200201"
        ],
        "dialogs": {
          "111200201": {
            "id": "111200201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Are you Uncle Dai?",
            "nextDialogs": [
              "111200202"
            ]
          },
          "111200202": {
            "id": "111200202",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "I am indeed.",
            "nextDialogs": [
              "111200203"
            ]
          },
          "111200203": {
            "id": "111200203",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Ahh, now then, you must be the adventurers assigned by the Guild.",
            "nextDialogs": [
              "111200204"
            ]
          },
          "111200204": {
            "id": "111200204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? How could you tell!?",
            "nextDialogs": [
              "111200205"
            ]
          },
          "111200205": {
            "id": "111200205",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "By the clothes on your back and the look on your face. Experienced adventurers at that, I'll wager.",
            "nextDialogs": [
              "111200206"
            ]
          },
          "111200206": {
            "id": "111200206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right again! You're pretty perceptive!",
            "nextDialogs": [
              "111200207"
            ]
          },
          "111200207": {
            "id": "111200207",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Hahaha. In this trade, you need a sharp eye for people, not just rocks. Uncle Dai can see what you're made of from a long way off.",
            "nextDialogs": [
              "111200208"
            ]
          },
          "111200208": {
            "id": "111200208",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Alright, my assistant should be arriving soon so let's just wait here a moment.",
            "nextDialogs": [
              "111200209"
            ]
          },
          "111200209": {
            "id": "111200209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa whoa, that's why we're here! Now there's someone else taking a cut?",
            "nextDialogs": [
              "111200210"
            ]
          },
          "111200210": {
            "id": "111200210",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Well, to tell you the truth, this is a very difficult matter. Too much for adventurers alone to handle, I fear...",
            "nextDialogs": [
              "111200211"
            ]
          },
          "111200211": {
            "id": "111200211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph! So there is someone else!",
            "nextDialogs": [
              "111200212"
            ]
          },
          "111200212": {
            "id": "111200212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Do you think we're not up to the job?",
            "nextDialogs": [
              "111200215"
            ]
          },
          "111200215": {
            "id": "111200215",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "It just occurred to me that you don't have all the facts. The incident in question happened in a mine, and it's a little out of the ordinary, to say the least. Mines are dangerous places, as I'm sure you're aware. As such, I've enlisted an industry expert to cover all contingencies.",
            "nextDialogs": [
              "111200216"
            ]
          },
          "111200216": {
            "id": "111200216",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Last time I checked, adventurers weren't experts in ore appraisal or geological analysis. With a professional by your side, everything should run smoothly.",
            "nextDialogs": [
              "111200217"
            ]
          },
          "111200217": {
            "id": "111200217",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Besides, this guy is the best in his field. No matter the rock, he'll tell you its value to the nearest Mora at a glance.",
            "nextDialogs": [
              "111200218"
            ]
          },
          "111200218": {
            "id": "111200218",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "I'd go as far to say that there's not a soul in Teyvat that knows rocks better than him. I'd be a fool to not enlist an expert of his caliber!",
            "nextDialogs": [
              "111200219"
            ]
          },
          "111200219": {
            "id": "111200219",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're a fool if you think you found Teyvat's number one rock expert!",
            "nextDialogs": [
              "111200220"
            ]
          },
          "111200220": {
            "id": "111200220",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Oh? And why might that be?",
            "nextDialogs": [
              "111200221"
            ]
          },
          "111200221": {
            "id": "111200221",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Because Teyvat's number one rock expert happens to be a friend of ours...",
            "nextDialogs": [
              "111200222"
            ]
          },
          "111200222": {
            "id": "111200222",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You must be talking about...",
            "nextDialogs": [
              "111200223"
            ]
          },
          "111200223": {
            "id": "111200223",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Perfect, I was planning to ask him a few questions.)",
            "nextDialogs": [
              "111200224"
            ]
          },
          "111200224": {
            "id": "111200224",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Haha~ Didn't expect that, did you! Wait here, we'll go fetch him."
          }
        }
      }
    },
    {
      "subId": "1112003",
      "subQuestName": "Look for Zhongli",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111200301"
        ],
        "dialogs": {
          "111200301": {
            "id": "111200301",
            "speakerId": 2148,
            "speakerName": "Iron Tongue Tian",
            "text": "In our last tale, Rex Lapis...",
            "nextDialogs": [
              "111200302"
            ]
          },
          "111200302": {
            "id": "111200302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Zhongli! There you are!",
            "nextDialogs": [
              "111200303"
            ]
          },
          "111200303": {
            "id": "111200303",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Oh!",
            "nextDialogs": [
              "111200304"
            ]
          },
          "111200304": {
            "id": "111200304",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Here for a few tales? I didn't know you two were connoisseurs.",
            "nextDialogs": [
              "111200305"
            ]
          },
          "111200305": {
            "id": "111200305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, no no! We're here for you! Um... do you have time?",
            "nextDialogs": [
              "111200306"
            ]
          },
          "111200306": {
            "id": "111200306",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Ah... something I'm rarely short of.",
            "nextDialogs": [
              "111200309"
            ]
          },
          "111200309": {
            "id": "111200309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We need someone who understands geology and ore.",
            "nextDialogs": [
              "111200310"
            ]
          },
          "111200310": {
            "id": "111200310",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Hmm... someone who understands geology and ore...",
            "nextDialogs": [
              "111200311"
            ]
          },
          "111200311": {
            "id": "111200311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh... Take a look around! Is there anyone in Teyvat more qualified?",
            "nextDialogs": [
              "111200312"
            ]
          },
          "111200312": {
            "id": "111200312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The requester claims to have enlisted Teyvat's number one rock expert, but Paimon doesn't believe a word of it. Nobody understands rocks better than you!",
            "nextDialogs": [
              "111200313"
            ]
          },
          "111200313": {
            "id": "111200313",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "You appear to have taken his claim quite personally on my behalf.",
            "nextDialogs": [
              "111200314"
            ]
          },
          "111200314": {
            "id": "111200314",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, no no... it's just... Uncle Dai doesn't know what he's talking about!",
            "nextDialogs": [
              "111200315"
            ]
          },
          "111200315": {
            "id": "111200315",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon just wants to... enlighten him...",
            "nextDialogs": [
              "111200316"
            ]
          },
          "111200316": {
            "id": "111200316",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Hahaha, I see. Well then, it will be my pleasure to accompany you.",
            "nextDialogs": [
              "111200317"
            ]
          },
          "111200317": {
            "id": "111200317",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really!?",
            "nextDialogs": [
              "111200318"
            ]
          },
          "111200318": {
            "id": "111200318",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "But I should inform you that despite my expertise... I cannot necessarily claim to be a leading authority.",
            "nextDialogs": [
              "111200319"
            ]
          },
          "111200319": {
            "id": "111200319",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "We are at all times adrift in a sea of learning — new knowledge should be welcomed with open arms. Still, I imagine I will be of help to you in this endeavor. If we do encounter an expert, I look forward to broadening my own understandings.",
            "nextDialogs": [
              "111200320"
            ]
          },
          "111200320": {
            "id": "111200320",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh... stop being so modest, Zhongli.",
            "nextDialogs": [
              "111200321"
            ]
          },
          "111200321": {
            "id": "111200321",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, we got him! Let's head back to Uncle Dai!"
          }
        }
      }
    },
    {
      "subId": "1112004",
      "subQuestName": "Return to the dock and talk to Uncle Dai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111200401"
        ],
        "dialogs": {
          "111200401": {
            "id": "111200401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uncle Dai! We're back!",
            "nextDialogs": [
              "111200402"
            ]
          },
          "111200402": {
            "id": "111200402",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Oh! And this must be the friend you spoke of?",
            "nextDialogs": [
              "111200403"
            ]
          },
          "111200403": {
            "id": "111200403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yup! Paimon doesn't know who your rock expert is, but he's got nothing on our guy!",
            "nextDialogs": [
              "111200404"
            ]
          },
          "111200404": {
            "id": "111200404",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Haha, let's not get ahead of ourselves. Still, I do have a claim to some experience in this field.",
            "nextDialogs": [
              "111200405"
            ]
          },
          "111200405": {
            "id": "111200405",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Uh-huh, so you say. Wait till my guy gets here, then we'll see.",
            "nextDialogs": [
              "111200406"
            ]
          },
          "111200406": {
            "id": "111200406",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "It's no use me singing his praises. You'll have to see for yourselves.",
            "nextDialogs": [
              "111200407"
            ]
          },
          "111200407": {
            "id": "111200407",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Uh... is this the place?",
            "nextDialogs": [
              "111200408"
            ]
          },
          "111200408": {
            "id": "111200408",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Aha! Speak of the devil! Allow me to introduce my assistant, Kun Jun.",
            "nextDialogs": [
              "111200409"
            ]
          },
          "111200409": {
            "id": "111200409",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Young Kun, these are two adventurers assigned to us. And as for this gentleman...",
            "nextDialogs": [
              "111200410"
            ]
          },
          "111200410": {
            "id": "111200410",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Hm...?",
            "nextDialogs": [
              "111200411"
            ]
          },
          "111200411": {
            "id": "111200411",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "...",
            "nextDialogs": [
              "111200412"
            ]
          },
          "111200412": {
            "id": "111200412",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This is Zhongli, a consultant from the funeral parlor.",
            "nextDialogs": [
              "111200413"
            ]
          },
          "111200413": {
            "id": "111200413",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Wangsheng Funeral Parlor's consultant... Mr. Zhongli! I've heard about you. They say you're a man of great knowledge and many talents. I had no idea I'd be meeting you in person today.",
            "nextDialogs": [
              "111200414"
            ]
          },
          "111200414": {
            "id": "111200414",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "I... I'm sure I recognize you... Have we met at the parlor? Wait, I've never been to the parlor...",
            "nextDialogs": [
              "111200415"
            ]
          },
          "111200415": {
            "id": "111200415",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uncle Dai, aren't you going to test them?",
            "nextDialogs": [
              "111200416"
            ]
          },
          "111200416": {
            "id": "111200416",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So that's what you were planning.",
            "nextDialogs": [
              "111200417"
            ]
          },
          "111200417": {
            "id": "111200417",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Huh? I... I wouldn't know where to start...",
            "nextDialogs": [
              "111200418"
            ]
          },
          "111200418": {
            "id": "111200418",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Then they can figure out a way to test each other! If Zhongli wins, he's the assistant. If Zhongli loses, uh... N—Never mind, Zhongli won't lose!",
            "nextDialogs": [
              "111200419"
            ]
          },
          "111200419": {
            "id": "111200419",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "A contest? Why, it would be my pleasure!",
            "nextDialogs": [
              "111200420"
            ]
          },
          "111200420": {
            "id": "111200420",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "I admire your enthusiasm, good sir.",
            "nextDialogs": [
              "111200421"
            ]
          },
          "111200421": {
            "id": "111200421",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Haha! I must say, you certainly have the look of an industry expert about you. It'll be interesting to see which one of us wins.",
            "nextDialogs": [
              "111200422"
            ]
          },
          "111200422": {
            "id": "111200422",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Stop talking the talk and start walking the walk!",
            "nextDialogs": [
              "111200423"
            ]
          },
          "111200423": {
            "id": "111200423",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "I'm just saying it like I see it, haha... Which is incidentally the only skill I have worth talking about.",
            "nextDialogs": [
              "111200424"
            ]
          },
          "111200424": {
            "id": "111200424",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "So you're an appraiser, Mr. Kun Jun?",
            "nextDialogs": [
              "111200425"
            ]
          },
          "111200425": {
            "id": "111200425",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Well, no... actually I've already forgotten what I'm in Liyue Harbor for... I was standing by the side of the road one day when Uncle Dai called me over.",
            "nextDialogs": [
              "111200426"
            ]
          },
          "111200426": {
            "id": "111200426",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "He saw me holding a rock and asked me a few questions. He seemed incredibly excited, even followed me for a while. We arranged to meet here.",
            "nextDialogs": [
              "111200427"
            ]
          },
          "111200427": {
            "id": "111200427",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? How could you forget something like that?",
            "nextDialogs": [
              "111200428"
            ]
          },
          "111200428": {
            "id": "111200428",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "I saw him on my way over to Liyue Harbor, poring over rocks and muttering to himself. He looked to be very familiar with them.",
            "nextDialogs": [
              "111200429"
            ]
          },
          "111200429": {
            "id": "111200429",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "I asked him a few questions out of curiosity. To my surprise, he knew more than me, an old mining foreman! In any case, he didn't have any pressing matters, and agreed to help me.",
            "nextDialogs": [
              "111200430"
            ]
          },
          "111200430": {
            "id": "111200430",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So... do you have a poor memory?",
            "nextDialogs": [
              "111200431"
            ]
          },
          "111200431": {
            "id": "111200431",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Not exactly... Anyway, if it's rocks you need help with, I can most certainly lend a hand.",
            "nextDialogs": [
              "111200432"
            ]
          },
          "111200432": {
            "id": "111200432",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Mr. Zhongli, what do you make of this rock?",
            "nextDialogs": [
              "111200433"
            ]
          },
          "111200433": {
            "id": "111200433",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Hmm...",
            "nextDialogs": [
              "111200434"
            ]
          },
          "111200434": {
            "id": "111200434",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "A glossy exterior, with a fissure that could only have been left in the wake of a volcanic eruption. If I'm not mistaken, this is a rough gem from another nation.",
            "nextDialogs": [
              "111200435"
            ]
          },
          "111200435": {
            "id": "111200435",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Ah... a keen eye!",
            "nextDialogs": [
              "111200436"
            ]
          },
          "111200436": {
            "id": "111200436",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "It's no ordinary rough gem. Fragile surface layer, black veining... My intuition tells me that there's high-quality crystal ore inside.",
            "nextDialogs": [
              "111200437"
            ]
          },
          "111200437": {
            "id": "111200437",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Remarkable. This rock does indeed hail from the vicinity of a volcano. I came across it in a market and snapped it straight up. The seller thought it was some leftover industrial remnant. They had no inkling of the treasure that lay within.",
            "nextDialogs": [
              "111200440"
            ]
          },
          "111200440": {
            "id": "111200440",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Purity and geological rarity alone aren't enough to make a treasure. Some of the most precious crystals contain deposits of water or sand.",
            "nextDialogs": [
              "111200441"
            ]
          },
          "111200441": {
            "id": "111200441",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "In the moment of its formation, the crystal hidden within this stone shell captured a pocket of water. For water to be hidden in its depths, like a moon concealed within a mountain, reflecting shafts of daylight that make it through... Now that's a rare treasure.",
            "nextDialogs": [
              "111200442"
            ]
          },
          "111200442": {
            "id": "111200442",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Such a detailed description, almost like he saw it with his own two eyes...",
            "nextDialogs": [
              "111200443"
            ]
          },
          "111200443": {
            "id": "111200443",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Say... you're not trying to hoodwink us are you? After all, we haven't even seen what's inside yet!",
            "nextDialogs": [
              "111200444"
            ]
          },
          "111200444": {
            "id": "111200444",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Everything he said is true.",
            "nextDialogs": [
              "111200445"
            ]
          },
          "111200445": {
            "id": "111200445",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Most crystals are born in high-temperature environments. Heat and water aren't natural bedfellows of course, which is why crystals with water deposits are so sought-after. Moreover, this particular crystal contains mountain lake water. A rare find indeed.",
            "nextDialogs": [
              "111200446"
            ]
          },
          "111200446": {
            "id": "111200446",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well if Zhongli says so, it must be true...",
            "nextDialogs": [
              "111200447"
            ]
          },
          "111200447": {
            "id": "111200447",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "I've yet to encounter anyone with a judgment as shrewd as yours, Mr. Zhongli. How did you know exactly what lay within?",
            "nextDialogs": [
              "111200448"
            ]
          },
          "111200448": {
            "id": "111200448",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "I've seen many such stones in my time, I recognized it immediately. I hope you didn't mind me flaunting my experience, Mr. Kun Jun?",
            "nextDialogs": [
              "111200449"
            ]
          },
          "111200449": {
            "id": "111200449",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Of course not! I feel I've met a kindred spirit here today. I hope you will accept my friendship.",
            "nextDialogs": [
              "111200450"
            ]
          },
          "111200450": {
            "id": "111200450",
            "speakerId": 10376,
            "speakerName": "Kun Jun",
            "text": "Uncle Dai, it would be a mistake for Mr. Zhongli not to join us! Trust me when I say that his level of expertise is unrivaled in the trade. You won't come across another of his caliber in your lifetime.",
            "nextDialogs": [
              "111200451"
            ]
          },
          "111200451": {
            "id": "111200451",
            "speakerId": 10377,
            "speakerName": "Uncle Dai",
            "text": "Very well, there is strength in numbers after all! Everyone, follow me to The Chasm. There are men counting on you to find them."
          }
        }
      }
    },
    {
      "subId": "1112022",

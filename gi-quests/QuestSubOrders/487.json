  "subQuests": [
    {
      "subId": "48701",
      "subQuestName": "Talk to Margaret",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4870101"
        ],
        "dialogs": {
          "4870101": {
            "id": "4870101",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "...So, yours is the cat that went missing.",
            "nextDialogs": [
              "4870102"
            ]
          },
          "4870102": {
            "id": "4870102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Venti! Have you come to help?",
            "nextDialogs": [
              "4870103"
            ]
          },
          "4870103": {
            "id": "4870103",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Me, here to help you? Why, on the contrary, it is I who needs helping!",
            "nextDialogs": [
              "4870104"
            ]
          },
          "4870104": {
            "id": "4870104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But Paimon just saw you talking to Margaret about Prince...",
            "nextDialogs": [
              "4870105"
            ]
          },
          "4870105": {
            "id": "4870105",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Aha! So, Prince is the name of the feline fiend who thieved my spare <color=#00E1FFFF>astral iron strings</color>!",
            "nextDialogs": [
              "4870106"
            ]
          },
          "4870106": {
            "id": "4870106",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Though it gladdens my heart to see that the free-spirited ethos of Mondstadt is alive and well in creatures great and small... Still, it's a bit audacious!",
            "nextDialogs": [
              "4870107"
            ]
          },
          "4870107": {
            "id": "4870107",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "Haha, Prince is a mischievous little rascal alright!",
            "nextDialogs": [
              "4870108"
            ]
          },
          "4870108": {
            "id": "4870108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Spoken just like a parent who chooses to spoil said rascal!",
            "nextDialogs": [
              "4870109"
            ]
          },
          "4870109": {
            "id": "4870109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Indeed. Just like Barbatos...",
            "nextDialogs": [
              "4870110"
            ]
          },
          "4870110": {
            "id": "4870110",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Ahaha, yes, quite... quite... Ahem! Now, let's see about getting ourselves an audience with his little highness, Prince Rascal of Mondstadt!",
            "nextDialogs": [
              "4870111"
            ]
          },
          "4870111": {
            "id": "4870111",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "I have a performance tonight, and without my spare strings, I shall have to disappoint my audience.",
            "nextDialogs": [
              "4870112"
            ]
          },
          "4870112": {
            "id": "4870112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What would a kitty cat want with lyre strings anyway?",
            "nextDialogs": [
              "4870113"
            ]
          },
          "4870113": {
            "id": "4870113",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "Everyone knows cats go crazy for a ball of string!",
            "nextDialogs": [
              "4870114"
            ]
          },
          "4870114": {
            "id": "4870114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What!?",
            "nextDialogs": [
              "4870115"
            ]
          },
          "4870115": {
            "id": "4870115",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "These lyre strings are made of astral iron, which contains Anemo energy. That makes them extremely durable, so I normally just roll them up in a ball to make them easier to carry.",
            "nextDialogs": [
              "4870116"
            ]
          },
          "4870116": {
            "id": "4870116",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "That's a trick of the trade from a traveling bard!",
            "nextDialogs": [
              "4870117"
            ]
          },
          "4870117": {
            "id": "4870117",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The strings contain Anemo energy?",
            "nextDialogs": [
              "4870118"
            ]
          },
          "4870118": {
            "id": "4870118",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#That'll help us! {NICKNAME}, it's time for you to use your <color=#00E1FFFF>Elemental Sight</color> again!"
          }
        }
      }
    },
    {
      "subId": "48711",
      "subQuestName": "Find Margaret and ask about her commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4871101"
        ],
        "dialogs": {
          "4871101": {
            "id": "4871101",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "Where have you been looking?",
            "nextDialogs": [
              "4871102"
            ]
          },
          "4871102": {
            "id": "4871102",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "Prince should be somewhere around the Marketplace. Remember, he's got black fur."
          }
        }
      }
    },

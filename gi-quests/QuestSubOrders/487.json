    {
      "subId": "48712",
      "subQuestName": "Talk to Margaret to finish your commission.",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4871201"
        ],
        "dialogs": {
          "4871201": {
            "id": "4871201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Drat! He's run off again.",
            "nextDialogs": [
              "4871202"
            ]
          },
          "4871202": {
            "id": "4871202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But where is he going? Hmm, Paimon wonders if..."
          }
        }
      }
    },
    {
      "subId": "48710",
      "subQuestName": "Complete Margaret's commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4871001"
        ],
        "dialogs": {
          "4871001": {
            "id": "4871001",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "Prince! Good boy, that's my Prince, I knew you'd come home to me..."
          }
        }
      }
    },
    {
      "subId": "48703",
      "subQuestName": "Complete Margaret's commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4870301"
        ],
        "dialogs": {
          "4870301": {
            "id": "4870301",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "Prince! Where did you go running off to? Thank goodness you're safe...",
            "nextDialogs": [
              "4870302"
            ]
          },
          "4870302": {
            "id": "4870302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "He made sure we had our work cut out for us looking for him.",
            "nextDialogs": [
              "4870303"
            ]
          },
          "4870303": {
            "id": "4870303",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "Oh Princey, how could you leave me like that...",
            "nextDialogs": [
              "4870304"
            ]
          },
          "4870304": {
            "id": "4870304",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Looks like those two need some time to themselves...",
            "nextDialogs": [
              "4870305"
            ]
          },
          "4870305": {
            "id": "4870305",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And here are your astral iron strings, Venti.",
            "nextDialogs": [
              "4870306"
            ]
          },
          "4870306": {
            "id": "4870306",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "You found them! Wonderful! I was not optimistic they would turn up.",
            "nextDialogs": [
              "4870307"
            ]
          },
          "4870307": {
            "id": "4870307",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "I daresay that a private performance played using these very same strings would not be an excessive way to show my gratitude! ...Ah, ah...",
            "nextDialogs": [
              "4870308"
            ]
          },
          "4870308": {
            "id": "4870308",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ah what?",
            "nextDialogs": [
              "4870309"
            ]
          },
          "4870309": {
            "id": "4870309",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "ACHOO!",
            "nextDialogs": [
              "4870310"
            ]
          },
          "4870310": {
            "id": "4870310",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "*cough* Haha... Apologies. At this distance, my cat allergy seems to be rearing its head...",
            "nextDialogs": [
              "4870311"
            ]
          },
          "4870311": {
            "id": "4870311",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, now Paimon gets why you didn't go looking for your strings by yourself...",
            "nextDialogs": [
              "4870312"
            ]
          },
          "4870312": {
            "id": "4870312",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Hehe, anyway, thanks for the help, I'll be going now— a—achoo!"
          }
        }
      }
    }
  ]
}
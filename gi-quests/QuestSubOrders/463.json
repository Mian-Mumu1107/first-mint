    {
      "subId": "46303",
      "subQuestName": "Finish conversation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4630301"
        ],
        "dialogs": {
          "4630301": {
            "id": "4630301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh... Is this the end?",
            "nextDialogs": [
              "4630302"
            ]
          },
          "4630302": {
            "id": "4630302",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Where are you, my treasure!?",
            "nextDialogs": [
              "4630303"
            ]
          },
          "4630303": {
            "id": "4630303",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Let's look around, {NICKNAME}.",
            "nextDialogs": [
              "4630304"
            ]
          },
          "4630304": {
            "id": "4630304",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "Hahaha... I'll save you the trouble.",
            "nextDialogs": [
              "4630305"
            ]
          },
          "4630305": {
            "id": "4630305",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "How about you let me take over?",
            "nextDialogs": [
              "4630307",
              "4630309"
            ]
          },
          "4630307": {
            "id": "4630307",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "Sharp eye, but too slow.",
            "nextDialogs": [
              "4630311"
            ]
          },
          "4630311": {
            "id": "4630311",
            "speakerId": 1002,
            "speakerName": "Izzard",
            "text": "I'm Izzard.",
            "nextDialogs": [
              "4630312"
            ]
          },
          "4630312": {
            "id": "4630312",
            "speakerId": 1002,
            "speakerName": "Izzard",
            "text": "I thank you both on behalf of the Treasure Hoarders.",
            "nextDialogs": [
              "4630313"
            ]
          },
          "4630313": {
            "id": "4630313",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh...",
            "nextDialogs": [
              "4630314"
            ]
          },
          "4630314": {
            "id": "4630314",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We've been keeping a low profile, how did word get out?",
            "nextDialogs": [
              "4630315"
            ]
          },
          "4630315": {
            "id": "4630315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Low... profile...?",
            "nextDialogs": [
              "4630316"
            ]
          },
          "4630316": {
            "id": "4630316",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmph! Paimon won't let you have the treasure without a fight!",
            "nextDialogs": [
              "4630317"
            ]
          },
          "4630317": {
            "id": "4630317",
            "speakerId": 1002,
            "speakerName": "Izzard",
            "text": "You would be wise to not underestimate us.",
            "nextDialogs": [
              "4630318"
            ]
          },
          "4630318": {
            "id": "4630318",
            "speakerId": 1002,
            "speakerName": "Izzard",
            "text": "My gang is just outside waiting for my order.",
            "nextDialogs": [
              "4630319"
            ]
          },
          "4630319": {
            "id": "4630319",
            "speakerId": 1002,
            "speakerName": "Izzard",
            "text": "However, they're not as... sociable as me.",
            "nextDialogs": [
              "4630320"
            ]
          },
          "4630320": {
            "id": "4630320",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "(Kaeya and the Knights of Favonius enter)",
            "nextDialogs": [
              "4630321"
            ]
          },
          "4630321": {
            "id": "4630321",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "I'm sorry to rain on your parade...",
            "nextDialogs": [
              "4630322"
            ]
          },
          "4630322": {
            "id": "4630322",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "But your gang won't be participating in your current plan.",
            "nextDialogs": [
              "4630323"
            ]
          },
          "4630323": {
            "id": "4630323",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "If you'd like to ask why, you can go see them... in Mondstadt Prison.",
            "nextDialogs": [
              "4630324"
            ]
          },
          "4630324": {
            "id": "4630324",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "Or perhaps you'd prefer to join them permanently?",
            "nextDialogs": [
              "4630325"
            ]
          },
          "4630325": {
            "id": "4630325",
            "speakerId": 1002,
            "speakerName": "Izzard",
            "text": "The Knights...?",
            "nextDialogs": [
              "4630326"
            ]
          },
          "4630326": {
            "id": "4630326",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, it's Kaeya!",
            "nextDialogs": [
              "4630327"
            ]
          },
          "4630327": {
            "id": "4630327",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Kaeya, he wants to steal your treasure! Get him!",
            "nextDialogs": [
              "4630328"
            ]
          },
          "4630328": {
            "id": "4630328",
            "speakerId": 1002,
            "speakerName": "Izzard",
            "text": "Ugh... almost had it!",
            "nextDialogs": [
              "4630329"
            ]
          },
          "4630329": {
            "id": "4630329",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "Oh, you mean the treasure?",
            "nextDialogs": [
              "4630330"
            ]
          },
          "4630330": {
            "id": "4630330",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "Sorry, but there wasn't any treasure to begin with.",
            "nextDialogs": [
              "4630331"
            ]
          },
          "4630331": {
            "id": "4630331",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "You came all the way... for nothing. Just give it up.",
            "nextDialogs": [
              "4630332"
            ]
          },
          "4630332": {
            "id": "4630332",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What?",
            "nextDialogs": [
              "4630333"
            ]
          },
          "4630333": {
            "id": "4630333",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "No... treasure?",
            "nextDialogs": [
              "4630334"
            ]
          },
          "4630334": {
            "id": "4630334",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Did Kaeya just say, there isn't any treasure?",
            "nextDialogs": [
              "4630335"
            ]
          },
          "4630335": {
            "id": "4630335",
            "speakerId": 1002,
            "speakerName": "Izzard",
            "text": "Hah. You got me good. Didn't think the Knights would resort to such tactics.",
            "nextDialogs": [
              "4630336"
            ]
          },
          "4630336": {
            "id": "4630336",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "A thief has no right to criticize the methods of the Knights of Fav— Wait, what are you...",
            "nextDialogs": [
              "4630337"
            ]
          },
          "4630337": {
            "id": "4630337",
            "speakerId": 1002,
            "speakerName": "Izzard",
            "text": "You're not gonna get me!",
            "nextDialogs": [
              "4630338"
            ]
          },
          "4630338": {
            "id": "4630338",
            "speakerId": 1002,
            "speakerName": "Izzard",
            "text": "Okay... Oh god... Wh—What is this? I didn't mean it!"
          },
          "4630309": {
            "id": "4630309",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "Well, I did have dealings with them.",
            "nextDialogs": [
              "4630310"
            ]
          },
          "4630310": {
            "id": "4630310",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "But them and their stupid principles... Losers who can't make a fortune."
          }
        }
      }
    },
    {
      "subId": "46304",
      "subQuestName": "Defeat the Ruin Guard",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "46305",
      "subQuestName": "Talk to Kaeya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4630501"
        ],
        "dialogs": {
          "4630501": {
            "id": "4630501",
            "speakerId": 1002,
            "speakerName": "Izzard",
            "text": "How embarrassing... Having my life saved by a knight...",
            "nextDialogs": [
              "4630502"
            ]
          },
          "4630502": {
            "id": "4630502",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "Don't forget what you promised... or that thing will be the least of your worries.",
            "nextDialogs": [
              "4630503"
            ]
          },
          "4630503": {
            "id": "4630503",
            "speakerId": 1002,
            "speakerName": "Izzard",
            "text": "Hey... Is this how the Knights of Favonius treats the people they catch?",
            "nextDialogs": [
              "4630504"
            ]
          },
          "4630504": {
            "id": "4630504",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "I'm just joking. Alright... Let's take him back.",
            "nextDialogs": [
              "4630505"
            ]
          },
          "4630505": {
            "id": "4630505",
            "speakerId": 1004,
            "speakerName": "Knight of Favonius",
            "text": "Sir! Yes sir!",
            "nextDialogs": [
              "4630506"
            ]
          },
          "4630506": {
            "id": "4630506",
            "speakerId": 1004,
            "speakerName": "Knight of Favonius",
            "text": "Captain, should we take these two in as well?",
            "nextDialogs": [
              "4630507"
            ]
          },
          "4630507": {
            "id": "4630507",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What!?",
            "nextDialogs": [
              "4630508"
            ]
          },
          "4630508": {
            "id": "4630508",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "Haha, of course not. They are the ones who made this arrest possible.",
            "nextDialogs": [
              "4630509"
            ]
          },
          "4630509": {
            "id": "4630509",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "Without them spreading our <color=#00E1FFFF>fabricated intel</color>, we wouldn't have been able to catch the Treasure Hoarders.",
            "nextDialogs": [
              "4630513"
            ]
          },
          "4630513": {
            "id": "4630513",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "*cries* You're a bad man for lying to me... Shame on the Knights!",
            "nextDialogs": [
              "4630514"
            ]
          },
          "4630514": {
            "id": "4630514",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "Alright, alright... Stop it already.",
            "nextDialogs": [
              "4630515"
            ]
          },
          "4630515": {
            "id": "4630515",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "Though the treasure doesn't exist, you did want it for yourself, didn't you?",
            "nextDialogs": [
              "4630516"
            ]
          },
          "4630516": {
            "id": "4630516",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "Otherwise, you would have informed me of your intentions, no?",
            "nextDialogs": [
              "4630517"
            ]
          },
          "4630517": {
            "id": "4630517",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That... well... ah... Hmph!",
            "nextDialogs": [
              "4630518"
            ]
          },
          "4630518": {
            "id": "4630518",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Let's go, {NICKNAME}. Paimon's done talking to him!",
            "nextDialogs": [
              "4630519"
            ]
          },
          "4630519": {
            "id": "4630519",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "Ha. Just a sec.",
            "nextDialogs": [
              "4630520"
            ]
          },
          "4630520": {
            "id": "4630520",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "You did help me out, so you do deserve a reward.",
            "nextDialogs": [
              "4630521"
            ]
          },
          "4630521": {
            "id": "4630521",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "This is the \"Triumphant Harbinger of Dawn That Points Towards Victory.\" As its name suggests, it symbolizes light and victory.",
            "nextDialogs": [
              "4630533"
            ]
          },
          "4630533": {
            "id": "4630533",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "If you don't mind, I would like to present you with this Harbinger of Dawn as a reward.",
            "nextDialogs": [
              "4630522"
            ]
          },
          "4630522": {
            "id": "4630522",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Harbinger of Dawn?",
            "nextDialogs": [
              "4630523"
            ]
          },
          "4630523": {
            "id": "4630523",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "That's right. It suits a well-cultured and disciplined person such as yourself, wouldn't you say, Paimon?",
            "nextDialogs": [
              "4630524"
            ]
          },
          "4630524": {
            "id": "4630524",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well... If the reward is this Harbinger of Dawn...",
            "nextDialogs": [
              "4630525"
            ]
          },
          "4630525": {
            "id": "4630525",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "You'd forgive me, right?",
            "nextDialogs": [
              "4630526"
            ]
          },
          "4630526": {
            "id": "4630526",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "I'm honored to have such an understanding friend.",
            "nextDialogs": [
              "4630527"
            ]
          },
          "4630527": {
            "id": "4630527",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yes... yes...",
            "nextDialogs": [
              "4630528"
            ]
          },
          "4630528": {
            "id": "4630528",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "You have my apologies for the deception. I will not use the same method twice."
          }
        }
      }
    },
    {
      "subId": "46306",
      "subQuestName": "None",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4630601"
        ],
        "dialogs": {
          "4630601": {
            "id": "4630601",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "Please excuse me. Do come visit me at our headquarters when you have the chance."
          }
        }
      }
    },
    {
      "subId": "46308",
      "subQuestName": "None",
      "sceneId": null,

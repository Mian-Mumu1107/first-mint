  "subQuests": [
    {
      "subId": "46300",
      "subQuestName": "Discuss your next step with Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4630001"
        ],
        "dialogs": {
          "4630001": {
            "id": "4630001",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "This time, the mysteries have all been solved, it sure took a lot of work.",
            "nextDialogs": [
              "4630014"
            ]
          },
          "4630014": {
            "id": "4630014",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But in all fairness, this treasure map really is terrible... It looks like it was drawn by a pirate...",
            "nextDialogs": [
              "4630002"
            ]
          },
          "4630002": {
            "id": "4630002",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So now...",
            "nextDialogs": [
              "4630004"
            ]
          },
          "4630004": {
            "id": "4630004",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm? Paimon believes that there is no need!",
            "nextDialogs": [
              "4630006"
            ]
          },
          "4630006": {
            "id": "4630006",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You read my mind! Paimon's so happy!",
            "nextDialogs": [
              "4630007"
            ]
          },
          "4630007": {
            "id": "4630007",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Let's go for it! Don't want anyone else to get there before we do!",
            "nextDialogs": [
              "4630008"
            ]
          },
          "4630008": {
            "id": "4630008",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Like... like the Treasure Hoarders Kaeya told us about.",
            "nextDialogs": [
              "4630009"
            ]
          },
          "4630009": {
            "id": "4630009",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Anyways, Paimon just wants to borrow the sword to...",
            "nextDialogs": [
              "4630010"
            ]
          },
          "4630010": {
            "id": "4630010",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "No, you heard nothing! Paimon ah— Paimon just wants to see it!",
            "nextDialogs": [
              "4630011"
            ]
          },
          "4630011": {
            "id": "4630011",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Definitely not to become super, mega, powerful and do nothing but play...",
            "nextDialogs": [
              "4630012"
            ]
          },
          "4630012": {
            "id": "4630012",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe... Alright, Paimon'll save the chit-chat for later.",
            "nextDialogs": [
              "4630013"
            ]
          },
          "4630013": {
            "id": "4630013",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Arcadian treasure hunt, here we go!"
          }
        }
      }
    },
    {
      "subId": "46301",
      "subQuestName": "Use the map to find the buried treasure",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4630101"
        ],
        "dialogs": {
          "4630101": {
            "id": "4630101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "This must be the Arcadian Ruins.",
            "nextDialogs": [
              "4630102"
            ]
          },
          "4630102": {
            "id": "4630102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Is it just me, or does it look... plain?",
            "nextDialogs": [
              "4630103"
            ]
          },
          "4630103": {
            "id": "4630103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, Paimon gets it! The perfect disguise is always in plain sight!",
            "nextDialogs": [
              "4630104"
            ]
          },
          "4630104": {
            "id": "4630104",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Kaeya's grandpa sure is impressive.",
            "nextDialogs": [
              "4630105"
            ]
          },
          "4630105": {
            "id": "4630105",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "*pitter-patter*",
            "nextDialogs": [
              "4630106"
            ]
          },
          "4630106": {
            "id": "4630106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Listen, Paimon...",
            "nextDialogs": [
              "4630107"
            ]
          },
          "4630107": {
            "id": "4630107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh! Mice.",
            "nextDialogs": [
              "4630108"
            ]
          },
          "4630108": {
            "id": "4630108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You didn't even try, did you?",
            "nextDialogs": [
              "4630109"
            ]
          },
          "4630109": {
            "id": "4630109",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's no time to get suspicious. We're close!",
            "nextDialogs": [
              "4630110"
            ]
          },
          "4630110": {
            "id": "4630110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hurry! The treasure is waiting for us!"
          }
        }
      }
    },

{
  "lineCounts": {
    "Black Screen": 1,
    "Chauvigne": 30,
    "Paimon": 9,
    "Panuelle": 18,
    "Player": 19
  },
  "subQuests": [
    {
      "subId": "7907501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790750101"
        ],
        "dialogs": {
          "790750101": {
            "id": "790750101",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "Just what is Chauvigne thinking? *sigh* He doesn't even want to talk with me.",
            "nextDialogs": [
              "790750102"
            ]
          },
          "790750102": {
            "id": "790750102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Chauvigne...",
            "nextDialogs": [
              "790750103"
            ]
          },
          "790750103": {
            "id": "790750103",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "Hello there. I'm really sorry, but... It's Chauvigne. He's still angry at me, and refuses to come out and speak with me.",
            "nextDialogs": [
              "790750104"
            ]
          },
          "790750104": {
            "id": "790750104",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "*sigh* But the wind and sunlight can't reach him down there. What if he withers? What then!?",
            "nextDialogs": [
              "790750105"
            ]
          },
          "790750105": {
            "id": "790750105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhm... Since we're talking about a potted flower...",
            "nextDialogs": [
              "790750106"
            ]
          },
          "790750106": {
            "id": "790750106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We can just scoop him up.",
            "nextDialogs": [
              "790750107"
            ]
          },
          "790750107": {
            "id": "790750107",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "I've tried! But as long as Chauvigne's upset, I can't even get close...",
            "nextDialogs": [
              "790750108"
            ]
          },
          "790750108": {
            "id": "790750108",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "He's in such a stormy mood that I nearly got blown away!",
            "nextDialogs": [
              "790750109"
            ]
          },
          "790750109": {
            "id": "790750109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, how can being angry blow someone away?",
            "nextDialogs": [
              "790750112"
            ]
          },
          "790750112": {
            "id": "790750112",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "Maybe the reason he's so furious with me is because I refused to venture out with him before...",
            "nextDialogs": [
              "790750113"
            ]
          },
          "790750113": {
            "id": "790750113",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "Please, dear guests, can I trouble you to check on Chauvigne? Perhaps you might even be able to reason with him.",
            "nextDialogs": [
              "790750114"
            ]
          },
          "790750114": {
            "id": "790750114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No problem, we'll give it a try.",
            "nextDialogs": [
              "790750115"
            ]
          },
          "790750115": {
            "id": "790750115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah! We've traveled to so many places, and seen so many people, we'll defin... probably be able to convince him!",
            "nextDialogs": [
              "790750116"
            ]
          },
          "790750116": {
            "id": "790750116",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "That's wonderful! You can find him in the cavern below this island. Please, if you'll head that way...",
            "nextDialogs": [
              "790750117"
            ]
          },
          "790750117": {
            "id": "790750117",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "I... I must tidy up this place, and find a good place for Chauvigne to soak up some sun."
          }
        }
      }
    },
    {
      "subId": "7907502",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790750201"
        ],
        "dialogs": {
          "790750201": {
            "id": "790750201",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "I... I must tidy up this place, and find a good place for Chauvigne to soak up some sun.",
            "nextDialogs": [
              "790750202"
            ]
          },
          "790750202": {
            "id": "790750202",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "I leave the matter of persuading Chauvigne in your hands, dear guests.",
            "nextDialogs": [
              "790750203"
            ]
          },
          "790750203": {
            "id": "790750203",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "If I were to see him, he would surely think me clingy, and become even more tempestuous..."
          }
        }
      }
    },
    {
      "subId": "7907503",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790750301"
        ],
        "dialogs": {
          "790750301": {
            "id": "790750301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Phew... The wind's finally stopped...",
            "nextDialogs": [
              "790750304"
            ]
          },
          "790750304": {
            "id": "790750304",
            "speakerId": 21585,
            "speakerName": "Chauvigne",
            "text": "Fine. I'll listen to what you have to say. But before that...",
            "nextDialogs": [
              "790750305"
            ]
          },
          "790750305": {
            "id": "790750305",
            "speakerId": 21585,
            "speakerName": "Chauvigne",
            "text": "Look how shocked the two of you are! I'm sure you're dying to ask, \"How can a flower speak?\"",
            "nextDialogs": [
              "790750306"
            ]
          },
          "790750306": {
            "id": "790750306",
            "speakerId": 21585,
            "speakerName": "Chauvigne",
            "text": "Or perhaps, \"How did you turn into a potted flower?\"",
            "nextDialogs": [
              "790750307"
            ]
          },
          "790750307": {
            "id": "790750307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do people usually ask that?",
            "nextDialogs": [
              "790750308"
            ]
          },
          "790750308": {
            "id": "790750308",
            "speakerId": 21585,
            "speakerName": "Chauvigne",
            "text": "Outside, yes, many. After I returned home... No, nobody has asked.",
            "nextDialogs": [
              "790750309"
            ]
          },
          "790750309": {
            "id": "790750309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "By \"outside,\" do you mean outside this world?",
            "nextDialogs": [
              "790750310"
            ]
          },
          "790750310": {
            "id": "790750310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I've heard that you only became like this after venturing.",
            "nextDialogs": [
              "790750311"
            ]
          },
          "790750311": {
            "id": "790750311",
            "speakerId": 21585,
            "speakerName": "Chauvigne",
            "text": "Well well, look who's so well-informed! I suppose Panuelle must have told you?",
            "nextDialogs": [
              "790750312"
            ]
          },
          "790750312": {
            "id": "790750312",
            "speakerId": 21585,
            "speakerName": "Chauvigne",
            "text": "That's correct. I became like this while I was venturing. Hehe, to borrow a phrase from that Rozel... This was the \"change\" I chose to make.",
            "nextDialogs": [
              "790750313"
            ]
          },
          "790750313": {
            "id": "790750313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon gets change... But why change into a potted flower?"
          }
        }
      }
    },
    {
      "subId": "7907504",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790750401"
        ],
        "dialogs": {
          "790750401": {
            "id": "790750401",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "Chauvigne! Y—You've come. Please, listen to me, I've never been mad at you, and never wanted to leave you.",
            "nextDialogs": [
              "790750402"
            ]
          },
          "790750402": {
            "id": "790750402",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "I was only worried that you didn't want to be friends with me... I know that some venturers change, and I was worried you had too...",
            "nextDialogs": [
              "790750403"
            ]
          },
          "790750403": {
            "id": "790750403",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "I prayed to the goddess, but... But I couldn't find a good enough gift to offer, so she naturally ignored me...",
            "nextDialogs": [
              "790750404"
            ]
          },
          "790750404": {
            "id": "790750404",
            "speakerId": 21585,
            "speakerName": "Chauvigne",
            "text": "No! Panuelle, such a thing could never happen. I will always, always be your friend.",
            "nextDialogs": [
              "790750405"
            ]
          },
          "790750405": {
            "id": "790750405",
            "speakerId": 21585,
            "speakerName": "Chauvigne",
            "text": "I must apologize to you! I was so focused on my own thoughts that I failed to listen to what you were saying.",
            "nextDialogs": [
              "790750406"
            ]
          },
          "790750406": {
            "id": "790750406",
            "speakerId": 21585,
            "speakerName": "Chauvigne",
            "text": "I assumed... I assumed you never wanted to see me again.",
            "nextDialogs": [
              "790750407"
            ]
          },
          "790750407": {
            "id": "790750407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Seems we've cleared up this misunderstanding.",
            "nextDialogs": [
              "790750408"
            ]
          },
          "790750408": {
            "id": "790750408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah! Paimon thought you two had some crazy sticking point, and were so super mad you didn't even want to try and understand each other!",
            "nextDialogs": [
              "790750411"
            ]
          },
          "790750411": {
            "id": "790750411",
            "speakerId": 21585,
            "speakerName": "Chauvigne",
            "text": "Thank you both, my dear guests. Without you, I'd definitely still be holed up in there, refusing to come out.",
            "nextDialogs": [
              "790750412"
            ]
          },
          "790750412": {
            "id": "790750412",
            "speakerId": 21585,
            "speakerName": "Chauvigne",
            "text": "But now, I can finally share what's in my heart with Panuelle.",
            "nextDialogs": [
              "790750413"
            ]
          },
          "790750413": {
            "id": "790750413",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "I am always willing to listen to whatever you have to say, Chauvigne. Whether you wish to speak of venturing, or of flower pots... It's all fine by me.",
            "nextDialogs": [
              "790750414"
            ]
          },
          "790750414": {
            "id": "790750414",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "Right, dear guests. Please, take these. I gathered them specially for you.",
            "nextDialogs": [
              "790750415"
            ]
          },
          "790750415": {
            "id": "790750415",
            "speakerId": 21449,
            "speakerName": "Panuelle",
            "text": "May the goddess bless you, that you may never argue with your friends, and that someone will always be willing to listen to your innermost thoughts."
          }
        }
      }
    }
  ]
}
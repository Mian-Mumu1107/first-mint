  "subQuests": [
    {
      "subId": "2101501",
      "subQuestName": "Quest start",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210120601"
        ],
        "dialogs": {
          "210120601": {
            "id": "210120601",
            "speakerId": 2311,
            "speakerName": "Little Nine",
            "text": "Hmm, let's see... The river carried me a long way, I know that. The water was really cold, it froze my hands stiff...",
            "nextDialogs": [
              "210120602"
            ]
          },
          "210120602": {
            "id": "210120602",
            "speakerId": 2311,
            "speakerName": "Little Nine",
            "text": "But I definitely didn't open it! I held it as tight as I could, because Big Nine told me how special it is...",
            "nextDialogs": [
              "210120603"
            ]
          },
          "210120603": {
            "id": "210120603",
            "speakerId": 2311,
            "speakerName": "Little Nine",
            "text": "Finally, I crawled onto the river bank. The first thing I did was find somewhere to dry the book out in the sun.",
            "nextDialogs": [
              "210120604"
            ]
          },
          "210120604": {
            "id": "210120604",
            "speakerId": 2311,
            "speakerName": "Little Nine",
            "text": "Then I was so exhausted that I lay down and fell asleep for a while. When I woke up, the book was gone.",
            "nextDialogs": [
              "210120605"
            ]
          },
          "210120605": {
            "id": "210120605",
            "speakerId": 2311,
            "speakerName": "Little Nine",
            "text": "It was in the woods over there that I dried the book out. You can have a look in there."
          }
        }
      }
    },

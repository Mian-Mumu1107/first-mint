      "dialogue": {
        "startDialogs": [
          "210120301"
        ],
        "dialogs": {
          "210120301": {
            "id": "210120301",
            "speakerId": 2311,
            "speakerName": "Little Nine",
            "text": "Did you find the book? It's a really special book to Big Nine...",
            "nextDialogs": [
              "210120302"
            ]
          },
          "210120302": {
            "id": "210120302",
            "speakerId": 2311,
            "speakerName": "Little Nine",
            "text": "If it's gone, he will be sooo sad...",
            "nextDialogs": [
              "210120303"
            ]
          },
          "210120303": {
            "id": "210120303",
            "speakerId": 2311,
            "speakerName": "Little Nine",
            "text": "...And if he knows that I lost it, he'll be really mad at me..."
          }
        }
      }
    }

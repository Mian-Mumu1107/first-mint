        ],
        "dialogs": {
          "150059901": {
            "id": "150059901",
            "speakerId": 1001,
            "speakerName": "Karya",
            "text": "G—Get back!",
            "nextDialogs": [
              "150059902"
            ]
          },
          "150059902": {
            "id": "150059902",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Don't panic, just hang in there!",
            "nextDialogs": [
              "150059903"
            ]
          },
          "150059903": {
            "id": "150059903",
            "speakerId": 1001,
            "speakerName": "Karya",
            "text": "Ah, finally, someone's coming... Please, help us!"
          }
        }
      }
    }
  ]
}
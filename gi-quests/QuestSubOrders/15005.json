  "subQuests": [
    {
      "subId": "1500501",
      "subQuestName": "Go play out in the wilds near the People of the Springs",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150050201"
        ],
        "dialogs": {
          "150050201": {
            "id": "150050201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wow, what an amazing view! And we can even see some Koholasaurs here and there! Hey, why don't we try to get a picture with one or two of them in the wild?",
            "nextDialogs": [
              "150050202"
            ]
          },
          "150050202": {
            "id": "150050202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But what if they try to bite us?",
            "nextDialogs": [
              "150050203"
            ]
          },
          "150050203": {
            "id": "150050203",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well... they're so cute, they probably won't do that, right...?",
            "nextDialogs": [
              "150050204"
            ]
          },
          "150050204": {
            "id": "150050204",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? What's happening over there?",
            "nextDialogs": [
              "150050205"
            ]
          },
          "150050205": {
            "id": "150050205",
            "speakerId": 1001,
            "speakerName": "Karya",
            "text": "Help! Somebody help us!",
            "nextDialogs": [
              "150050206"
            ]
          },
          "150050206": {
            "id": "150050206",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ah! Wild Koholasaurs are actually biting people!",
            "nextDialogs": [
              "150050208",
              "150050210"
            ]
          },
          "150050208": {
            "id": "150050208",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Yeah, those two are in trouble! The legendary {NICKNAME} and {M#his}{F#her} trusty sidekick Paimon will not stand by idly!"
          },
          "150050210": {
            "id": "150050210",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yeah, we can save those for later! We can't just stand around when someone's calling for help!"
          }
        }
      }
    },
    {
      "subId": "1500502",
      "subQuestName": "Defeat the Koholasaurs",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1500503",
      "subQuestName": "Talk to the freed tourists",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150050101"
        ],
        "dialogs": {
          "150050101": {
            "id": "150050101",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The defeated Koholasaurs scatter and run away.",
            "nextDialogs": [
              "150050102"
            ]
          },
          "150050102": {
            "id": "150050102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Judging from your clothes, you must be scholars from Sumeru, right?",
            "nextDialogs": [
              "150050103"
            ]
          },
          "150050103": {
            "id": "150050103",
            "speakerId": 1001,
            "speakerName": "Karya",
            "text": "Yes, I'm Karya, and this is my senior, Viramdra. Thank you so much for saving us. That was a little too close...",
            "nextDialogs": [
              "150050104"
            ]
          },
          "150050104": {
            "id": "150050104",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Don't mention it! Handling these sort of things is practically second nature to us by now. Paimon is Paimon, and this is {NICKNAME}!",
            "nextDialogs": [
              "150050105"
            ]
          },
          "150050105": {
            "id": "150050105",
            "speakerId": 1003,
            "speakerName": "Viramdra",
            "text": "*sigh* Still, it seems that all the Koholasaurs just ran off... We need to capture at least one alive.",
            "nextDialogs": [
              "150050106"
            ]
          },
          "150050106": {
            "id": "150050106",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Capture one alive?",
            "nextDialogs": [
              "150050107"
            ]
          },
          "150050107": {
            "id": "150050107",
            "speakerId": 1003,
            "speakerName": "Viramdra",
            "text": "Correct. Say, I can see you are very skilled at dealing with them. Do you think you could use me as live bait to help us capture one? I will pay you for the effort!",
            "nextDialogs": [
              "150050108"
            ]
          },
          "150050108": {
            "id": "150050108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Um, well...",
            "nextDialogs": [
              "150050109"
            ]
          },
          "150050109": {
            "id": "150050109",
            "speakerId": 1001,
            "speakerName": "Karya",
            "text": "Apologies. Viramdra has been hyper-focused on his research, so please, don't be too hard on him...",
            "nextDialogs": [
              "150050110"
            ]
          },
          "150050110": {
            "id": "150050110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, no worries! But why did you approach a whole group of wild Koholasaurs? And what's this talk about \"capturing them\"?",
            "nextDialogs": [
              "150050111"
            ]
          },
          "150050111": {
            "id": "150050111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't tell me you want to get a picture with them, too.",
            "nextDialogs": [
              "150050112"
            ]
          },
          "150050112": {
            "id": "150050112",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon's pretty sure that's not what they're trying to do!",
            "nextDialogs": [
              "150050113"
            ]
          },
          "150050113": {
            "id": "150050113",
            "speakerId": 1001,
            "speakerName": "Karya",
            "text": "I'm sure we must look very silly... The fact of the matter is that we're searching for a mysterious island from a certain legend. It's said that a very important clue about the island can be found on Koholasaurs, so...",
            "nextDialogs": [
              "150050114"
            ]
          },
          "150050114": {
            "id": "150050114",
            "speakerId": 1001,
            "speakerName": "Karya",
            "text": "Approaching them without the help of a guide from the People of the Springs was certainly an unwise choice on our part.",
            "nextDialogs": [
              "150050115"
            ]
          },
          "150050115": {
            "id": "150050115",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "A mysterious island?",
            "nextDialogs": [
              "150050116"
            ]
          },
          "150050116": {
            "id": "150050116",
            "speakerId": 1001,
            "speakerName": "Karya",
            "text": "Yes. There's a legend from the People of the Springs that mentions a mysterious island, and Viramdra believes the key to his research can be found there.",
            "nextDialogs": [
              "150050117"
            ]
          },
          "150050117": {
            "id": "150050117",
            "speakerId": 1003,
            "speakerName": "Viramdra",
            "text": "Ahem... Are you certain you two won't consider my proposal to capture one?",
            "nextDialogs": [
              "150050118"
            ]
          },
          "150050118": {
            "id": "150050118",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Some proposal... There's no way we'd be willing to use a person as live bait!",
            "nextDialogs": [
              "150050119"
            ]
          },
          "150050119": {
            "id": "150050119",
            "speakerId": 1003,
            "speakerName": "Viramdra",
            "text": "Then I suppose discussing it any further will just be a waste of time. I must come up with another solution...",
            "nextDialogs": [
              "150050120"
            ]
          },
          "150050120": {
            "id": "150050120",
            "speakerId": 1001,
            "speakerName": "Karya",
            "text": "Ahem... Viramdra!",
            "nextDialogs": [
              "150050121"
            ]
          },
          "150050121": {
            "id": "150050121",
            "speakerId": 1003,
            "speakerName": "Viramdra",
            "text": "Oh, alright... You did rescue Karya and I just now, and I suppose I should express some gratitude. Thank you very much.",
            "nextDialogs": [
              "150050122"
            ]
          },
          "150050122": {
            "id": "150050122",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "A little awkward, but Paimon'll take it...",
            "nextDialogs": [
              "150050123"
            ]
          },
          "150050123": {
            "id": "150050123",
            "speakerId": 1003,
            "speakerName": "Viramdra",
            "text": "We should move on, Karya.",
            "nextDialogs": [
              "150050124"
            ]
          },
          "150050124": {
            "id": "150050124",
            "speakerId": 1001,
            "speakerName": "Karya",
            "text": "Yes, thank you again. My apologies... Viramdra really doesn't have the best people skills.",
            "nextDialogs": [
              "150050125"
            ]
          },
          "150050125": {
            "id": "150050125",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That's alright, bye now!",
            "nextDialogs": [
              "150050126"
            ]
          },
          "150050126": {
            "id": "150050126",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You really don't see a pair of adventurers like those two every day!",
            "nextDialogs": [
              "150050127"
            ]
          },
          "150050127": {
            "id": "150050127",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But anyway, Paimon's really curious about that mysterious island that lady just mentioned!",
            "nextDialogs": [
              "150050128"
            ]
          },
          "150050128": {
            "id": "150050128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you wanna find the island too, Paimon?",
            "nextDialogs": [
              "150050129"
            ]
          },
          "150050129": {
            "id": "150050129",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yeah! Who knows, there might be treasure!",
            "nextDialogs": [
              "150050130"
            ]
          },
          "150050130": {
            "id": "150050130",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "After all the amazing places we've explored during our adventures, finding some mysterious island should be a walk in the park for us!",
            "nextDialogs": [
              "150050131"
            ]
          },
          "150050131": {
            "id": "150050131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But we don't have any info about this island.",
            "nextDialogs": [
              "150050132"
            ]
          },
          "150050132": {
            "id": "150050132",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ah, you're right... The lady mentioned that the mysterious island is related to a legend of the People of the Springs... So maybe we can start by asking some of them about it?",
            "nextDialogs": [
              "150050133"
            ]
          },
          "150050133": {
            "id": "150050133",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Time's ticking. Let's get started on our next adventure!",
            "nextDialogs": [
              "150050134"
            ]
          },
          "150050134": {
            "id": "150050134",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But the real question is... who should we ask?",
            "nextDialogs": [
              "150050135"
            ]
          },
          "150050135": {
            "id": "150050135",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Can we just talk to the chief?",
            "nextDialogs": [
              "150050136"
            ]
          },
          "150050136": {
            "id": "150050136",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... that's an idea. If anyone, the chief of the tribe should know the details!"
          }
        }
      }
    },
    {
      "subId": "1500599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

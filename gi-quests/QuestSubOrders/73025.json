        "dialogs": {
          "730251004": {
            "id": "730251004",
            "speakerId": 1010,
            "speakerName": "Araesha",
            "text": "The unseen and uncatchable that slips past the moon's gaze and encourages the growth of sprouts... This is so simple that any Aranara can immediately get the answer... I need another riddle."
          }
        }
      }
    },
    {
      "subId": "7302511",

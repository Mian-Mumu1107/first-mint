            "id": "730251801",
            "speakerId": 1014,
            "speakerName": "Aralila",
            "text": "Aranishat, you should admit defeat. Don't be like a stubborn twig that refuses to bend against strong gusts. You will break just like it.",
            "nextDialogs": [
              "730251802"
            ]
          },
          "730251802": {
            "id": "730251802",
            "speakerId": 1015,
            "speakerName": "Aranishat",
            "text": "Aralila, let's have another match after the moon sinks and the sun rises again!"
          }
        }
      }
    },

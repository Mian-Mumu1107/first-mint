            "speakerId": 1007,
            "speakerName": "Arakanta",
            "text": "There is no doubt that Arakanta is the fastest Aranara. Arakanta, as fast as the Rishboland Tiger.",
            "nextDialogs": [
              "730251702"
            ]
          },
          "730251702": {
            "id": "730251702",
            "speakerId": 1007,

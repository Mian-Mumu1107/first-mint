    {
      "subId": "7302507",
      "subQuestName": "Help the Aranara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730250701"
        ],
        "dialogs": {
          "730250701": {
            "id": "730250701",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh? This is Vanarana... So many Aranara...",
            "nextDialogs": [
              "730250703",
              "730250706"
            ]
          },
          "730250703": {
            "id": "730250703",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ooh, Paimon gets it! It feels completely different!",
            "nextDialogs": [
              "730250704"
            ]
          },
          "730250704": {
            "id": "730250704",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Since we've arrived in Vanarana, it's time to get a Bija and help Rana.",
            "nextDialogs": [
              "730250707"
            ]
          },
          "730250707": {
            "id": "730250707",
            "speakerId": 1006,
            "speakerName": "Arama",
            "text": "Bija? I've heard the stories about it.",
            "nextDialogs": [
              "730250708"
            ]
          },
          "730250708": {
            "id": "730250708",
            "speakerId": 1006,
            "speakerName": "Arama",
            "text": "Anyway, this is the real Vanarana, or to be more precise, it's \"Mahavanaranapna\"...",
            "nextDialogs": [
              "730250709"
            ]
          },
          "730250709": {
            "id": "730250709",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wh—What a long name! And there are so many \"a's\"!",
            "nextDialogs": [
              "730250710"
            ]
          },
          "730250710": {
            "id": "730250710",
            "speakerId": 1006,
            "speakerName": "Arama",
            "text": "Yes, but we usually don't use its full name because it's too long. If explained in Nara language...",
            "nextDialogs": [
              "730250711"
            ]
          },
          "730250711": {
            "id": "730250711",
            "speakerId": 1006,
            "speakerName": "Arama",
            "text": "Ah, I know. It's \"the Aranara Forest of Dreams\".",
            "nextDialogs": [
              "730250712"
            ]
          },
          "730250712": {
            "id": "730250712",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "\"Dreams\"... So you're saying..."
          },
          "730250706": {
            "id": "730250706",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, according to Arana, we must get a Bija from Vanarana to help Rana."
          }
        }
      }
    },

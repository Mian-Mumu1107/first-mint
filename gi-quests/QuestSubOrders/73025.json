    {
      "subId": "7302504",
      "subQuestName": "Enter Vanarana",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730250401"
        ],
        "dialogs": {
          "730250401": {
            "id": "730250401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, an Aranara...",
            "nextDialogs": [
              "730250402"
            ]
          },
          "730250402": {
            "id": "730250402",
            "speakerId": 1005,
            "speakerName": "???",
            "text": "Eek! Don't capture me, I'll give Nara \"tracer\"...",
            "nextDialogs": [
              "730250403"
            ]
          },
          "730250403": {
            "id": "730250403",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What's a \"tracer\"? Anyway, we won't capture you! Don't be afraid!",
            "nextDialogs": [
              "730250404"
            ]
          },
          "730250404": {
            "id": "730250404",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#This is Paimon, and {M#he}{F#she} is {NICKNAME}. We're good Nara! What's your name?",
            "nextDialogs": [
              "730250405"
            ]
          },
          "730250405": {
            "id": "730250405",
            "speakerId": 1005,
            "speakerName": "???",
            "text": "Oh... You're good Nara, great. Hmm, it was Arana who taught you that tune, right?",
            "nextDialogs": [
              "730250406"
            ]
          },
          "730250406": {
            "id": "730250406",
            "speakerId": 1006,
            "speakerName": "Arama",
            "text": "I'm Arama. Arana may trust both of you, but everyone here is very scared seeing Nara in Vanarana.",
            "nextDialogs": [
              "730250408",
              "730250417"
            ]
          },
          "730250408": {
            "id": "730250408",
            "speakerId": 1006,
            "speakerName": "Arama",
            "text": "I was afraid. But the Golden Nara has been to many places. The tiny dandelions and spores with you are all saying that you are a very, very good Nara.",
            "nextDialogs": [
              "730250409"
            ]
          },
          "730250409": {
            "id": "730250409",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa, Aranara can communicate with plants, even spores?"
          },
          "730250417": {
            "id": "730250417",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... It feels so similar to the place where we found the treasure, but it is slightly different. It does have a huge rock house, but..."
          }
        }
      }
    },

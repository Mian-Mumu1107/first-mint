    {
      "subId": "7302506",
      "subQuestName": "Play the Rhythm of the Great Dream in front of the strange stone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730250601"
        ],
        "dialogs": {
          "730250601": {
            "id": "730250601",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Alright, we've helped! So where's the treasure, Arama?",
            "nextDialogs": [
              "730250602"
            ]
          },
          "730250602": {
            "id": "730250602",
            "speakerId": 1006,
            "speakerName": "Arama",
            "text": "Isn't \"treasure\" the incantation to make Nara help?",
            "nextDialogs": [
              "730250603"
            ]
          },
          "730250603": {
            "id": "730250603",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Why isn't Paimon surprised at all?",
            "nextDialogs": [
              "730250605"
            ]
          },
          "730250605": {
            "id": "730250605",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Did you really think Arama prepared treasure for us?",
            "nextDialogs": [
              "730250607"
            ]
          },
          "730250607": {
            "id": "730250607",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Anyway, how did you learn to use the word \"treasure\" like that, Arama?",
            "nextDialogs": [
              "730250608"
            ]
          },
          "730250608": {
            "id": "730250608",
            "speakerId": 1006,
            "speakerName": "Arama",
            "text": "I've observed Nara, and I noticed that they become very good and very willing to help other Nara once they hear the word \"treasure.\""
          }
        }
      }
    },

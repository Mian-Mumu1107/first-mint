    {
      "subId": "7302509",
      "subQuestName": "Help the Aranara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730250901"
        ],
        "dialogs": {
          "730250901": {
            "id": "730250901",
            "speakerId": 1003,
            "speakerName": "Araja",
            "text": "#Whoa, a Nara... I haven't seen one in so long. So tall and golden, just like {M#she}{F#he} said. Welcome to Vanarana.",
            "nextDialogs": [
              "730250902"
            ]
          },
          "730250902": {
            "id": "730250902",
            "speakerId": 1006,
            "speakerName": "Arama",
            "text": "#Yes, Nara {NICKNAME} and Paimon. They're amazing! They're not even scared of Vanagni.",
            "nextDialogs": [
              "730250903"
            ]
          },
          "730250903": {
            "id": "730250903",
            "speakerId": 1003,
            "speakerName": "Araja",
            "text": "Whoa! Amazing! Nara who used Arana's tune to get into Vanarana are definitely good Nara whom Arana trusts.",
            "nextDialogs": [
              "730250904"
            ]
          },
          "730250904": {
            "id": "730250904",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That's strange. How do all of you know that it was Arana who guided us here?",
            "nextDialogs": [
              "730250905"
            ]
          },
          "730250905": {
            "id": "730250905",
            "speakerId": 1003,
            "speakerName": "Araja",
            "text": "Every Aranara has their own tune, and every tune is different. That's how we know who's home.",
            "nextDialogs": [
              "730250906"
            ]
          },
          "730250906": {
            "id": "730250906",
            "speakerId": 1003,
            "speakerName": "Araja",
            "text": "Arana has been making friends with Nara in Avidya Forest and Ardravi Valley, so I haven't seen her for a long time. We heard her tune and thought that it was her. We were very happy.",
            "nextDialogs": [
              "730250907"
            ]
          },
          "730250907": {
            "id": "730250907",
            "speakerId": 1003,
            "speakerName": "Araja",
            "text": "#But it was a Nara who entered Vanarana, and it scared us all. So I asked for Arama's help to tell everyone that Nara {NICKNAME} is a good Nara.",
            "nextDialogs": [
              "730250908"
            ]
          },
          "730250908": {
            "id": "730250908",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, Paimon gets it now! But according to Arama, the problems we solved were outside the dream. Was that even helpful? Helpful to Ma... Mahavana...",
            "nextDialogs": [
              "730250909"
            ]
          },
          "730250909": {
            "id": "730250909",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh! Aranara names are so difficult!",
            "nextDialogs": [
              "730250912"
            ]
          },
          "730250912": {
            "id": "730250912",
            "speakerId": 1006,
            "speakerName": "Arama",
            "text": "The Vanarana in dreams is a shadow of the Vanarana outside. So, things will get better here now that you have dealt with the problems outside. Thank you.",
            "nextDialogs": [
              "730250913"
            ]
          },
          "730250913": {
            "id": "730250913",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Oooh... *cough* Let's get down to business! {NICKNAME}, about Rana..."
          }
        }
      }
    },

    {
      "subId": "7302505",
      "subQuestName": "Play the Rhythm of the Great Dream at the designated location",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730250501"
        ],
        "dialogs": {
          "730250501": {
            "id": "730250501",
            "speakerId": 1006,
            "speakerName": "Arama",
            "text": "Look, Vanagni! Be careful... Even if you talk to them, their only response is rage and shooting flames.",
            "nextDialogs": [
              "730250502"
            ]
          },
          "730250502": {
            "id": "730250502",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...What? It's just a Whopperflower!",
            "nextDialogs": [
              "730250503"
            ]
          },
          "730250503": {
            "id": "730250503",
            "speakerId": 1006,
            "speakerName": "Arama",
            "text": "It's very dangerous! Very dangerous! Let's leave before the Vanagni notices us!",
            "nextDialogs": [
              "730250505"
            ]
          },
          "730250505": {
            "id": "730250505",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...You aren't really afraid of a Whopperflower, right?",
            "nextDialogs": [
              "730250507"
            ]
          },
          "730250507": {
            "id": "730250507",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Anyway, don't worry, Arama. We'll help! Right, {NICKNAME}?"
          }
        }
      }
    },

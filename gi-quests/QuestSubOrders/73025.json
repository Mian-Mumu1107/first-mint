    {
      "subId": "7302520",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730250101"
        ],
        "dialogs": {
          "730250101": {
            "id": "730250101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But... Do we really have to sing? What if it attracts a Whopperflower?",
            "nextDialogs": [
              "730250102"
            ]
          },
          "730250102": {
            "id": "730250102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well... I think using a musical instrument works too.",
            "nextDialogs": [
              "730250103"
            ]
          },
          "730250103": {
            "id": "730250103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, it's worth a try. Let's return to Vimara Village and see if Grandpa Amadhiah has one!"
          }
        }
      }
    },
    {
      "subId": "7302521",
      "subQuestName": "Return to Vimara Village and talk to Amadhiah",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730250201"
        ],
        "dialogs": {
          "730250201": {
            "id": "730250201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Grandpa Amadhiah...",
            "nextDialogs": [
              "730250202"
            ]
          },
          "730250202": {
            "id": "730250202",
            "speakerId": 1001,
            "speakerName": "Amadhiah",
            "text": "Oh, Rana's friends... Unfortunately, Rana should be patrolling the forest today.",
            "nextDialogs": [
              "730250204"
            ]
          },
          "730250204": {
            "id": "730250204",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "(Let's keep it from him...)",
            "nextDialogs": [
              "730250206"
            ]
          },
          "730250206": {
            "id": "730250206",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yeah, we know! We're here to ask if you have a musical instrument that you can lend us.",
            "nextDialogs": [
              "730250207"
            ]
          },
          "730250207": {
            "id": "730250207",
            "speakerId": 1001,
            "speakerName": "Amadhiah",
            "text": "A musical instrument... Give me a minute, I will go get it.",
            "nextDialogs": [
              "730250208"
            ]
          },
          "730250208": {
            "id": "730250208",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Amadhiah fetches an old musical instrument from inside.",
            "nextDialogs": [
              "730250209"
            ]
          },
          "730250209": {
            "id": "730250209",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It looks like... a Mondstadt-style instrument! Grandpa Amadhiah, can you lend it to us?",
            "nextDialogs": [
              "730250210"
            ]
          },
          "730250210": {
            "id": "730250210",
            "speakerId": 1001,
            "speakerName": "Amadhiah",
            "text": "A very, very long time ago... I met a bard in the forest. She gave me this lyre as a keepsake.",
            "nextDialogs": [
              "730250211"
            ]
          },
          "730250211": {
            "id": "730250211",
            "speakerId": 1001,
            "speakerName": "Amadhiah",
            "text": "\"Dreams of the garden, memories of the forest... The pomegranate sings, the apples clap...\"",
            "nextDialogs": [
              "730250212"
            ]
          },
          "730250212": {
            "id": "730250212",
            "speakerId": 1001,
            "speakerName": "Amadhiah",
            "text": "What a beautiful tune...",
            "nextDialogs": [
              "730250213"
            ]
          },
          "730250213": {
            "id": "730250213",
            "speakerId": 1001,
            "speakerName": "Amadhiah",
            "text": "I'll lend it to you. Use it to light up the darkness in the forest, and perhaps it'll reach her ears..."
          }
        }
      }
    },

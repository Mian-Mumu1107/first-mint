    {
      "subId": "7302503",
      "subQuestName": "Go to where Vanarana is",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730250301"
        ],
        "dialogs": {
          "730250301": {
            "id": "730250301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "This place is like a village...",
            "nextDialogs": [
              "730250302"
            ]
          },
          "730250302": {
            "id": "730250302",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, do you remember the small stone houses we saw while camping with Rana?",
            "nextDialogs": [
              "730250304"
            ]
          },
          "730250304": {
            "id": "730250304",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Those small round houses we saw.",
            "nextDialogs": [
              "730250306"
            ]
          },
          "730250306": {
            "id": "730250306",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "They're all over this place. It's like a kingdom for little people...",
            "nextDialogs": [
              "730250307"
            ]
          },
          "730250307": {
            "id": "730250307",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "If this is the \"Vanarana\" that Arana told us about, it should be the home of the Aranara...",
            "nextDialogs": [
              "730250308"
            ]
          },
          "730250308": {
            "id": "730250308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But there's no one here.",
            "nextDialogs": [
              "730250309"
            ]
          },
          "730250309": {
            "id": "730250309",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... Are they hiding from us?"
          }
        }
      }
    },
    {
      "subId": "7302522",
      "subQuestName": "Go to where Vanarana is",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730252201"
        ],
        "dialogs": {
          "730252201": {
            "id": "730252201",
            "speakerId": 1003,
            "speakerName": "Araja",
            "text": "#Oh, it belonged to Nara Varuna... Maybe it's destiny that it's going to another Golden Nara like Nara {NICKNAME}.",
            "nextDialogs": [
              "730252202"
            ]
          },
          "730252202": {
            "id": "730252202",
            "speakerId": 1003,
            "speakerName": "Araja",
            "text": "#{M#She}{F#He} called it the Aranyaka because it's the stories of {M#her}{F#his} adventures in the forest with us Aranara. But those stories are lost.",
            "nextDialogs": [
              "730252203"
            ]
          },
          "730252203": {
            "id": "730252203",
            "speakerId": 1003,
            "speakerName": "Araja",
            "text": "#Nara {NICKNAME}, I hope it'll be of help to you. I'm really looking forward to Festival Utsava."
          }
        }
      }
    },

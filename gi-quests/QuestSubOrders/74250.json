        "dialogs": {
          "742500201": {
            "id": "742500201",
            "speakerId": 1071,
            "speakerName": "Lyney",
            "text": "Thank you for your hospitality, Lady Sandrone.",
            "nextDialogs": [
              "742500202"
            ]
          },
          "742500202": {
            "id": "742500202",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "(Let's sit like this for a little while longer.)",
            "nextDialogs": [
              "742500204"
            ]
          },
          "742500204": {
            "id": "742500204",
            "speakerId": 1071,
            "speakerName": "Lyney",
            "text": "Alright, take care."
          }
        }
      }
    },

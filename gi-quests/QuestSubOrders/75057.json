  "subQuests": [
    {
      "subId": "7505702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750013201"
        ],
        "dialogs": {
          "750013201": {
            "id": "750013201",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "I can't believe that worked. That was truly a scene from out of story and song.",
            "nextDialogs": [
              "750013202"
            ]
          },
          "750013202": {
            "id": "750013202",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "The cacophony fell silent... and the Pin returned to its original state. Then, its giant form crashed to the ground...",
            "nextDialogs": [
              "750013203"
            ]
          },
          "750013203": {
            "id": "750013203",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "Hoo... To think that someone could really accomplish this... This isn't a dream, is it? You're all real, aren't you? Not figments of my imagination?",
            "nextDialogs": [
              "750013204"
            ]
          },
          "750013204": {
            "id": "750013204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wake up, wake up... You've got to fix this yourself!",
            "nextDialogs": [
              "750013205"
            ]
          },
          "750013205": {
            "id": "750013205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, there's no need to be so mean.",
            "nextDialogs": [
              "750013206"
            ]
          },
          "750013206": {
            "id": "750013206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#But anyway, didn't Paimon tell you? {NICKNAME}'s super strong!",
            "nextDialogs": [
              "750013207"
            ]
          },
          "750013207": {
            "id": "750013207",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750013208"
            ]
          },
          "750013208": {
            "id": "750013208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hehe, you think so, don'cha, {REALNAME[ID(2)|SHOWHOST(true)]}?",
            "nextDialogs": [
              "750013209"
            ]
          },
          "750013209": {
            "id": "750013209",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "#You weren't affected by the Abyss, were you, {NICKNAME}?",
            "nextDialogs": [
              "750013212"
            ]
          },
          "750013212": {
            "id": "750013212",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "#Even our strongest warriors must remain vigilant and then some in the face of the Abyss. You're no ordinary person, {NICKNAME}.",
            "nextDialogs": [
              "750013213"
            ]
          },
          "750013213": {
            "id": "750013213",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "Haha, who knows, the story I spin from this material might even surpass those by Sanhaj!",
            "nextDialogs": [
              "750013214"
            ]
          },
          "750013214": {
            "id": "750013214",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Ehrrr?",
            "nextDialogs": [
              "750013215"
            ]
          },
          "750013215": {
            "id": "750013215",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, that sure sounds impressive, but who's Sanhaj?",
            "nextDialogs": [
              "750013216"
            ]
          },
          "750013216": {
            "id": "750013216",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "Haha, for \"those who tell stories in their tribes,\" Sanhaj of the Masters of the Night-Wind is worthy of reverence indeed...",
            "nextDialogs": [
              "750013217"
            ]
          },
          "750013217": {
            "id": "750013217",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "Alas, time is short. I'll tell you more about Sanhaj when we've got more time!",
            "nextDialogs": [
              "750013218"
            ]
          },
          "750013218": {
            "id": "750013218",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "Alright then. Let's head for the next floating Shadow Pin. I want to fix this issue and start writing by nightfall!",
            "nextDialogs": [
              "750013219"
            ]
          },
          "750013219": {
            "id": "750013219",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Woohoo! Let's go, let's go!",
            "nextDialogs": [
              "750013220"
            ]
          },
          "750013220": {
            "id": "750013220",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!"
          }
        }
      }
    },
    {
      "subId": "7500108",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750010801"
        ],
        "dialogs": {
          "750010801": {
            "id": "750010801",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Wow. Here I'd thought to come over and check on the frightening noises I'd heard...",
            "nextDialogs": [
              "750010802"
            ]
          },
          "750010802": {
            "id": "750010802",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Telling myself \"Come on, Titu, it's probably nothing\"... But this is quite something! Quite something indeed!",
            "nextDialogs": [
              "750010803"
            ]
          },
          "750010803": {
            "id": "750010803",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750010804"
            ]
          },
          "750010804": {
            "id": "750010804",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "There's even a little Tepetlisaurus here... Was it you who brought these outlanders here, then?",
            "nextDialogs": [
              "750010805"
            ]
          },
          "750010805": {
            "id": "750010805",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "And... was it you who brought this Shadow Pin down?",
            "nextDialogs": [
              "750010807",
              "750010810"
            ]
          },
          "750010807": {
            "id": "750010807",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Eh? Wait, did we do something bad, {NICKNAME}? If we act fast, while there's only one witness...",
            "nextDialogs": [
              "750010808"
            ]
          },
          "750010808": {
            "id": "750010808",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "#Haha, come on, no need for that! It's not serious, and if anything, I'd say you've done us a favor! So, you're {NICKNAME}, then? Who's your friend over there?",
            "nextDialogs": [
              "750010813"
            ]
          },
          "750010813": {
            "id": "750010813",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750010814"
            ]
          },
          "750010814": {
            "id": "750010814",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#And this is {REALNAME[ID(2)|SHOWHOST(true)]}.",
            "nextDialogs": [
              "750010815"
            ]
          },
          "750010815": {
            "id": "750010815",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "And Titu's my name, a teller {RUBY#[D]storyteller}of tales for our tribe. I'm also responsible for \"caring\" for the stone pillars in this valley.",
            "nextDialogs": [
              "750010816"
            ]
          },
          "750010816": {
            "id": "750010816",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "And of course, this Shadow Pin you've plunged into the earth is one of three little pins, and its care is within my jurisdiction.",
            "nextDialogs": [
              "750010817"
            ]
          },
          "750010817": {
            "id": "750010817",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "J—Jurisdiction... Uh oh, looks like we're going to have to compensate the locals for dropping that stone pillar.",
            "nextDialogs": [
              "750010818"
            ]
          },
          "750010818": {
            "id": "750010818",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, Paimon wouldn't have used our real name's if she'd known sooner.",
            "nextDialogs": [
              "750010819"
            ]
          },
          "750010819": {
            "id": "750010819",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "Compensate... \"Titu had a flash of inspiration. Perhaps he might use this to coerce these people into helping him achieve his goals...\"",
            "nextDialogs": [
              "750010820"
            ]
          },
          "750010820": {
            "id": "750010820",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "That's how I'd slot a bit like this into the plot, anyway.",
            "nextDialogs": [
              "750010821"
            ]
          },
          "750010821": {
            "id": "750010821",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Hmm?",
            "nextDialogs": [
              "750010822"
            ]
          },
          "750010822": {
            "id": "750010822",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "Ah, sorry, got a bit carried away thinking about stories there. Telling{RUBY#[D]storyteller} tales is my responsibility here in the tribe, and after so many years, it's time for me to come up with some originals.",
            "nextDialogs": [
              "750010823"
            ]
          },
          "750010823": {
            "id": "750010823",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "And of course, something just had to go wrong with the Shadow Pin just as I was a few days into my musing... Because why would it ever rain when it could pour?",
            "nextDialogs": [
              "750010824"
            ]
          },
          "750010824": {
            "id": "750010824",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "Ahem! Anyway, I'm not gonna blackmail you. I—I mean, I wouldn't have spoken my thoughts aloud if that was the case, right?",
            "nextDialogs": [
              "750010825"
            ]
          },
          "750010825": {
            "id": "750010825",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "Look, we exchanged names, but we haven't come to blows, so that makes us friends, yes?",
            "nextDialogs": [
              "750010826"
            ]
          },
          "750010826": {
            "id": "750010826",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "In that case... could you listen to a friend's request?",
            "nextDialogs": [
              "750010827"
            ]
          },
          "750010827": {
            "id": "750010827",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure... as long as it doesn't involve compensation.",
            "nextDialogs": [
              "750010828"
            ]
          },
          "750010828": {
            "id": "750010828",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "No, no, surely not! Hmm, how should I put this? ... When you passed through the valley, did you see some sort of giant block of solid phlogiston with golden patterns carved into it?",
            "nextDialogs": [
              "750010829"
            ]
          },
          "750010829": {
            "id": "750010829",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "It's in the center of this place. You can't miss it."
          },
          "750010810": {
            "id": "750010810",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! You're always like that! Paimon'll get mad if you don't cut it out!",
            "nextDialogs": [
              "750010811"
            ]
          },
          "750010811": {
            "id": "750010811",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "#Haha, relax. If anything, this is a huge relief. So your name's Paimon, then? In that case, how about this {M#good fellow}{F#good lady} over here?",
            "nextDialogs": [
              "750010812"
            ]
          },
          "750010812": {
            "id": "750010812",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#Call me {NICKNAME}."
          }
        }
      }
    }
  ]
}
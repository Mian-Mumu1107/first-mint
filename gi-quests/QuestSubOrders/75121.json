          "751210401"
        ],
        "dialogs": {
          "751210401": {
            "id": "751210401",
            "speakerId": 1000,
            "speakerName": "Check Note",
            "text": "(Citlali, we found the books you were looking for. You were sleeping when we got here and we didn't want to wake you.)",
            "nextDialogs": [
              "751210402"
            ]
          },
          "751210402": {
            "id": "751210402",
            "speakerId": 1000,
            "speakerName": "Check Note",
            "text": "(Maybe drink a little less next time, eh?)"
          }
        }
      }
    },
    {
      "subId": "7512105",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751210501"
        ],
        "dialogs": {
          "751210501": {
            "id": "751210501",
            "speakerId": 1001,
            "speakerName": "Citlali's Bedroom",
            "text": "(The faint sound of Citlali snoring comes from within.)",
            "nextDialogs": [
              "751210502"
            ]
          },
          "751210502": {
            "id": "751210502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Was she drinking again last night? Paimon thinks we should leave the books on the table. She wouldn't want us to wake her."
          }
        }
      }
    },
    {
      "subId": "7512101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751210101"
        ],
        "dialogs": {
          "751210101": {
            "id": "751210101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Someone sent me to find a couple of books...",
            "nextDialogs": [
              "751210102"
            ]
          },
          "751210102": {
            "id": "751210102",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You describe the books that Citlali wants to Kuroda.",
            "nextDialogs": [
              "751210103"
            ]
          },
          "751210103": {
            "id": "751210103",
            "speakerId": 3029,
            "speakerName": "Kuroda",
            "text": "The first edition of \"Shogun Almighty: Reborn as Raiden With Unlimited Power\" and the limited deluxe edition of \"Pretty Please, Kitsune Guuji?\"...",
            "nextDialogs": [
              "751210104"
            ]
          },
          "751210104": {
            "id": "751210104",
            "speakerId": 3029,
            "speakerName": "Kuroda",
            "text": "I must say, your friend clearly knows a thing or two. In terms of collection value, nothing the Yae Publishing House is currently putting out can rival the books you're after.",
            "nextDialogs": [
              "751210105"
            ]
          },
          "751210105": {
            "id": "751210105",
            "speakerId": 3029,
            "speakerName": "Kuroda",
            "text": "To think I'm not acquainted with such a discerning reader... Truly regrettable.",
            "nextDialogs": [
              "751210106"
            ]
          },
          "751210106": {
            "id": "751210106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are they still available?",
            "nextDialogs": [
              "751210107"
            ]
          },
          "751210107": {
            "id": "751210107",
            "speakerId": 3029,
            "speakerName": "Kuroda",
            "text": "You won't find either of them on the open market, and certainly not in storage. Every copy was snapped up long ago.",
            "nextDialogs": [
              "751210108"
            ]
          },
          "751210108": {
            "id": "751210108",
            "speakerId": 3029,
            "speakerName": "Kuroda",
            "text": "However, I do happen to have a copy of each...",
            "nextDialogs": [
              "751210109"
            ]
          },
          "751210109": {
            "id": "751210109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I can pay you for them.",
            "nextDialogs": [
              "751210110"
            ]
          },
          "751210110": {
            "id": "751210110",
            "speakerId": 3029,
            "speakerName": "Kuroda",
            "text": "No, no. These books would be far better off in your friend's possession, someone who can appreciate their true worth.",
            "nextDialogs": [
              "751210111"
            ]
          },
          "751210111": {
            "id": "751210111",
            "speakerId": 3029,
            "speakerName": "Kuroda",
            "text": "Knowing that, I'd be more than happy to give them to you."
          }
        }
      }
    },
    {
      "subId": "7512102",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751210201"
        ],
        "dialogs": {
          "751210201": {
            "id": "751210201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Can I just put them here?)"
          }
        }
      }
    },
    {
      "subId": "7512103",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751210301"
        ],
        "dialogs": {
          "751210301": {
            "id": "751210301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We should probably write a message. Citlali might not even notice them in all this mess.",
            "nextDialogs": [
              "751210302"
            ]
          },
          "751210302": {
            "id": "751210302",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Paimon finds a piece of paper and thinks for a moment before writing a note."
          }
        }
      }
    },
    {

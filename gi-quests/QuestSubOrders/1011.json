  "subQuests": [
    {
      "subId": "101101",
      "subQuestName": "Go and buy Noctilucous Jade",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10110101"
        ],
        "dialogs": {
          "10110101": {
            "id": "10110101",
            "speakerId": 1000,
            "speakerName": "Shitou",
            "text": "Welcome to the Jade Mystery, my good friends! Would you like to try your luck betting on jade? This could be your lucky day.",
            "nextDialogs": [
              "10110102"
            ]
          },
          "10110102": {
            "id": "10110102",
            "speakerId": 1000,
            "speakerName": "Shitou",
            "text": "It's cheap and it's fun, and who knows, you just might strike it rich!",
            "nextDialogs": [
              "10110103"
            ]
          },
          "10110103": {
            "id": "10110103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Betting? No, no, we're here for... um, what was it again?",
            "nextDialogs": [
              "10110104"
            ]
          },
          "10110104": {
            "id": "10110104",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Noctilucous Jade, of radiant grade at the very least.",
            "nextDialogs": [
              "10110105"
            ]
          },
          "10110105": {
            "id": "10110105",
            "speakerId": 1000,
            "speakerName": "Shitou",
            "text": "Radiant grade Noctilucous Jade? I see, you're not a tourist. My apologies. I have some here for your perusal...",
            "nextDialogs": [
              "10110106"
            ]
          },
          "10110106": {
            "id": "10110106",
            "speakerId": 1000,
            "speakerName": "Shitou",
            "text": "(Fade to black. Shitou fetches goods.)",
            "nextDialogs": [
              "10110107"
            ]
          },
          "10110107": {
            "id": "10110107",
            "speakerId": 1000,
            "speakerName": "Shitou",
            "text": "What do you think? The Jade Mystery is an old name in the jade business. Just look at that wonderful quality! Rex Lapis doesn't often bless us with such finery. Go on, pick whichever one you like!",
            "nextDialogs": [
              "10110108"
            ]
          },
          "10110108": {
            "id": "10110108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "These three pieces really do look pretty, not like the ones you usually dig up...",
            "nextDialogs": [
              "10110109"
            ]
          },
          "10110109": {
            "id": "10110109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But how do we pick? Should we just grab one and go?",
            "nextDialogs": [
              "10110111"
            ]
          },
          "10110111": {
            "id": "10110111",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Very good. It seems you have learned some tricks of the trade.",
            "nextDialogs": [
              "10110112"
            ]
          },
          "10110112": {
            "id": "10110112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What do you think, Mr. Zhongli? How should we pick from these pieces of Noctilucous Jade?",
            "nextDialogs": [
              "10110114"
            ]
          },
          "10110114": {
            "id": "10110114",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Oh? You want me to decide? That is fine as well.",
            "nextDialogs": [
              "10110115"
            ]
          },
          "10110115": {
            "id": "10110115",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "If it were me, the answer would be simple.",
            "nextDialogs": [
              "10110116"
            ]
          },
          "10110116": {
            "id": "10110116",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh? And that would be...?",
            "nextDialogs": [
              "10110117"
            ]
          },
          "10110117": {
            "id": "10110117",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "I'll take them all, boss.",
            "nextDialogs": [
              "10110118"
            ]
          },
          "10110118": {
            "id": "10110118",
            "speakerId": 1000,
            "speakerName": "Shitou",
            "text": "Oh, you act with such panache, good sir! I always knew you were not a man of ordinary caliber!",
            "nextDialogs": [
              "10110119"
            ]
          },
          "10110119": {
            "id": "10110119",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait! Wait! Boss, that one didn't count! We need to discuss it again!",
            "nextDialogs": [
              "10110120"
            ]
          },
          "10110120": {
            "id": "10110120",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "(Fade to black while Zhongli, protagonist, and Paimon step to one side to talk amongst themselves)",
            "nextDialogs": [
              "10110121"
            ]
          },
          "10110121": {
            "id": "10110121",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! If we only need one for the ritual, aren't we wasting three times the Mora if we buy them all!?"
          }
        }
      }
    },

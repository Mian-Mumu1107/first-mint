    {
      "subId": "101104",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10110401"
        ],
        "dialogs": {
          "10110401": {
            "id": "10110401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "There's still soup in here. These hilichurls sure have big appetites!",
            "nextDialogs": [
              "10110404"
            ]
          },
          "10110404": {
            "id": "10110404",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This soup looks like it could be used as our Hydro elemental protection. Let's fire it up and begin our experiment!",
            "nextDialogs": [
              "10110405"
            ]
          },
          "10110405": {
            "id": "10110405",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "(Animation: Carefully place or throw samples into cooking pot)",
            "nextDialogs": [
              "10110406"
            ]
          },
          "10110406": {
            "id": "10110406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We're ready to go! Paimon will help remember which one of the three is which!",
            "nextDialogs": [
              "10110407"
            ]
          },
          "10110407": {
            "id": "10110407",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Use <color=#00E1FFFF>Pyro</color> to keep making the pot hotter, until we get the results we need.",
            "nextDialogs": [
              "10110408"
            ]
          },
          "10110408": {
            "id": "10110408",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Mr. Zhongli said that the <color=#00E1FFFF>shinier and bluer</color> the ore gets, the better it is, so pay close attention!"
          }
        }
      }
    },

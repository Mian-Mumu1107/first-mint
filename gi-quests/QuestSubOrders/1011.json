    {
      "subId": "101109",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10110901"
        ],
        "dialogs": {
          "10110901": {
            "id": "10110901",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "We can leave the jade here. I have already called for a jewelsmith to shape them into the implements that we will need.",
            "nextDialogs": [
              "10110902"
            ]
          },
          "10110902": {
            "id": "10110902",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Ah, yes. I have yet to go and see Childe. So as for the jewelsmith's remuneration...",
            "nextDialogs": [
              "10110905"
            ]
          },
          "10110905": {
            "id": "10110905",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Guess we can't do anything else. Also, is this where we're doing the Rite of Parting?",
            "nextDialogs": [
              "10110906"
            ]
          },
          "10110906": {
            "id": "10110906",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Yes. I have already rented this location, and have begun making preparations for the rite."
          }
        }
      }
    },
    {
      "subId": "101107",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10110701"
        ],
        "dialogs": {
          "10110701": {
            "id": "10110701",
            "speakerId": 1000,
            "speakerName": "Shitou",
            "text": "You're back, my friends! I've kept the goods for you. Which of them would you like?",
            "nextDialogs": [
              "10110781"
            ]
          },
          "10110781": {
            "id": "10110781",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? No, it wasn't that one, Paimon remembers that it wasn't very bright.",
            "nextDialogs": [
              "10110782"
            ]
          },
          "10110782": {
            "id": "10110782",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Think a bit harder..."
          }
        }
      }
    }
  ]
}
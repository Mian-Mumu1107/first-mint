          "130120202": {
            "id": "130120202",
            "speakerId": 1000,
            "speakerName": "Cyno",
            "text": "A merchant approached me and requested that I cover the cost of a \"Desert Travel Kit.\" One million, two hundred and fifty thousand Mora.",
            "nextDialogs": [
              "130120203"
            ]
          },
          "130120203": {
            "id": "130120203",
            "speakerId": 1000,
            "speakerName": "Cyno",
            "text": "I didn't remember owing anyone Mora, especially not that kind of amount. So I arrested the merchant on charges of provocation and disturbing the peace.",
            "nextDialogs": [
              "130120204"
            ]
          },
          "130120204": {
            "id": "130120204",
            "speakerId": 1000,
            "speakerName": "Cyno",
            "text": "Do you know anything about this?",
            "nextDialogs": [
              "130120205"
            ]
          },
          "130120205": {
            "id": "130120205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh, no—nope... Paimon has no idea what that could be!"

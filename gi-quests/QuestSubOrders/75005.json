  "subQuests": [
    {
      "subId": "7500501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750050101"
        ],
        "dialogs": {
          "750050101": {
            "id": "750050101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Look, {NICKNAME}, there's a sealed gate over here!",
            "nextDialogs": [
              "750050102"
            ]
          },
          "750050102": {
            "id": "750050102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe, don't ask how, but Paimon's got the feeling that the strange things we picked up nearby must have something to do with getting it open.",
            "nextDialogs": [
              "750050103"
            ]
          },
          "750050103": {
            "id": "750050103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Weird... Just what could be behind this gate?",
            "nextDialogs": [
              "750050104"
            ]
          },
          "750050104": {
            "id": "750050104",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750050106",
              "750050111"
            ]
          },
          "750050106": {
            "id": "750050106",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa... And where there be monsters, there be treasures too, right?",
            "nextDialogs": [
              "750050107"
            ]
          },
          "750050107": {
            "id": "750050107",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750050108"
            ]
          },
          "750050108": {
            "id": "750050108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's not a given.",
            "nextDialogs": [
              "750050109"
            ]
          },
          "750050109": {
            "id": "750050109",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, come on, stop being such a downer. We'll find out once we get inside!",
            "nextDialogs": [
              "750050115"
            ]
          },
          "750050115": {
            "id": "750050115",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Hey, you two! Outlanders! And that... scarf-wearing Tepetlisaurus over there!",
            "nextDialogs": [
              "750050116"
            ]
          },
          "750050116": {
            "id": "750050116",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Arr?",
            "nextDialogs": [
              "750050117"
            ]
          },
          "750050117": {
            "id": "750050117",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Heh, aren't you the energetic one? Seriously, though, haven't you told them that a seal's a seal because it's meant to seal off forbidden areas?",
            "nextDialogs": [
              "750050118"
            ]
          },
          "750050118": {
            "id": "750050118",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "And you won't find anything in there except for terribly profound curses.",
            "nextDialogs": [
              "750050119"
            ]
          },
          "750050119": {
            "id": "750050119",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Roar...",
            "nextDialogs": [
              "750050120"
            ]
          },
          "750050120": {
            "id": "750050120",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, so that means... there's no treasure?",
            "nextDialogs": [
              "750050121"
            ]
          },
          "750050121": {
            "id": "750050121",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Oh, I'm sure there is. Probably.",
            "nextDialogs": [
              "750050122"
            ]
          },
          "750050122": {
            "id": "750050122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Probably?",
            "nextDialogs": [
              "750050123"
            ]
          },
          "750050123": {
            "id": "750050123",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Yes. But what it is, is something you outlanders shouldn't be poking around, for the \"forbidden ground\" that lies behind that door is also \"holy ground.\"",
            "nextDialogs": [
              "750050124"
            ]
          },
          "750050124": {
            "id": "750050124",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Only experienced Couriers who have completed the trials and received approval may enter. Within, it is said, lies a medium by which our ancestors communed with the world of night...",
            "nextDialogs": [
              "750050125"
            ]
          },
          "750050125": {
            "id": "750050125",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Speaking of which, I wasn't gone that long, was I? And yet here you are, with the three trial completion keystones in tow... Impressive.",
            "nextDialogs": [
              "750050126"
            ]
          },
          "750050126": {
            "id": "750050126",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Heh! When it comes to climbing up and down looking for stuff, you won't find many better than us!",
            "nextDialogs": [
              "750050127"
            ]
          },
          "750050127": {
            "id": "750050127",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750050128"
            ]
          },
          "750050128": {
            "id": "750050128",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Even tribal couriers might not match your speed. Well, you're still not permitted to enter these taboo grounds, but... my camp is nearby.",
            "nextDialogs": [
              "750050129"
            ]
          },
          "750050129": {
            "id": "750050129",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "How about I treat you to a quick bite, and then you can enjoy a comfy rest?",
            "nextDialogs": [
              "750050130"
            ]
          },
          "750050130": {
            "id": "750050130",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrooo..."
          },
          "750050111": {
            "id": "750050111",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe! That's what Paimon's gut is telling her too!",
            "nextDialogs": [
              "750050112"
            ]
          },
          "750050112": {
            "id": "750050112",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750050113"
            ]
          },
          "750050113": {
            "id": "750050113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't get too excited now.",
            "nextDialogs": [
              "750050114"
            ]
          },
          "750050114": {
            "id": "750050114",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Right, right. Let's just go in and find out! First we get this gate open, and then... Hehe. Fee, fie, foo, fum. Treasure, treasure, here we come!"
          }
        }
      }
    },
    {
      "subId": "7500502",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750050201"
        ],
        "dialogs": {
          "750050201": {
            "id": "750050201",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "No need to stand on ceremony. Wanna try my cooking?",
            "nextDialogs": [
              "750050202"
            ]
          },
          "750050202": {
            "id": "750050202",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "If you want to make some yourself, I've got a recipe in the box over there, along with some things I don't use. Feel free to go through 'em.",
            "nextDialogs": [
              "750050203"
            ]
          },
          "750050203": {
            "id": "750050203",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eh? You carry recipes on you?",
            "nextDialogs": [
              "750050204"
            ]
          },
          "750050204": {
            "id": "750050204",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Drew up a bunch of copies myself, as it happens. Might be of use, might not, but it could save a life if you run into someone who needs saving, wouldn't you agree?",
            "nextDialogs": [
              "750050205"
            ]
          },
          "750050205": {
            "id": "750050205",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh, you've sure given this some thought...",
            "nextDialogs": [
              "750050206"
            ]
          },
          "750050206": {
            "id": "750050206",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "After all, you've only yourself to rely on when you're outside the tribe.",
            "nextDialogs": [
              "750050207"
            ]
          },
          "750050207": {
            "id": "750050207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Actually, we haven't asked your name yet.",
            "nextDialogs": [
              "750050208"
            ]
          },
          "750050208": {
            "id": "750050208",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "My name? Haha! Call me Legba. And you, friends?",
            "nextDialogs": [
              "750050209"
            ]
          },
          "750050209": {
            "id": "750050209",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You introduce yourselves to Legba.",
            "nextDialogs": [
              "750050210"
            ]
          },
          "750050210": {
            "id": "750050210",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "#So, Paimon, {NICKNAME}, and {REALNAME[ID(2)|SHOWHOST(true)]} the little Tepetlisaurus... A marvelous fate it is, that had you meet here in Natlan.",
            "nextDialogs": [
              "750050211"
            ]
          },
          "750050211": {
            "id": "750050211",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "#Speaking of which, {NICKNAME}, what were you doing near the tribe's taboo grounds, hmm? Treasure-hunting? Secret-seeking?",
            "nextDialogs": [
              "750050213",
              "750050216"
            ]
          },
          "750050213": {
            "id": "750050213",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750050214"
            ]
          },
          "750050214": {
            "id": "750050214",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yeah, that's right! A well-protected place like this has gotta be home to treasure, right?",
            "nextDialogs": [
              "750050220"
            ]
          },
          "750050220": {
            "id": "750050220",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "Whatever the case, don't get any funny ideas about the place, outsiders. I will not permit you to enter.",
            "nextDialogs": [
              "750050221"
            ]
          },
          "750050221": {
            "id": "750050221",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "That is where our ancient ancestors re-established contact with the Night, and since that day, more and more tribespeople have been able to enter the Night Kingdom's gates.",
            "nextDialogs": [
              "750050222"
            ]
          },
          "750050222": {
            "id": "750050222",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Er?",
            "nextDialogs": [
              "750050223"
            ]
          },
          "750050223": {
            "id": "750050223",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What sorta place is this \"Night Kingdom,\" anyway?",
            "nextDialogs": [
              "750050224"
            ]
          },
          "750050224": {
            "id": "750050224",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "Haha. Well, I've heard that it's where all people of Natlan go when they leave this world... And only a few ever return.",
            "nextDialogs": [
              "750050225"
            ]
          },
          "750050225": {
            "id": "750050225",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "There, they say, the water flows like alluring light. There, they say, monumental obsidian tablets stand. It is no place for you to be curious about, even more so than our taboo grounds...",
            "nextDialogs": [
              "750050226"
            ]
          },
          "750050226": {
            "id": "750050226",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Uh, so about the thing you mentioned earlier... the one that communicates with the night world...",
            "nextDialogs": [
              "750050227"
            ]
          },
          "750050227": {
            "id": "750050227",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "A medium, yes. An ancient tool by which our forebears made contact with the Wayob — the envoys of the Night Kingdom.",
            "nextDialogs": [
              "750050228"
            ]
          },
          "750050228": {
            "id": "750050228",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa. An ancient tool...",
            "nextDialogs": [
              "750050229"
            ]
          },
          "750050229": {
            "id": "750050229",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750050230"
            ]
          },
          "750050230": {
            "id": "750050230",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "...Perhaps I have said too much. Whatever. Today, a stable connection has been established with the Night Kingdom, and so a medium has long been unnecessary. If you ask me, such methods were quite crude to begin with.",
            "nextDialogs": [
              "750050231"
            ]
          },
          "750050231": {
            "id": "750050231",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "Still, it is a sacred relic for human tribes.",
            "nextDialogs": [
              "750050232"
            ]
          },
          "750050232": {
            "id": "750050232",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Roar...!",
            "nextDialogs": [
              "750050233"
            ]
          },
          "750050233": {
            "id": "750050233",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "All right, all right, we get it...",
            "nextDialogs": [
              "750050234"
            ]
          },
          "750050234": {
            "id": "750050234",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "Good. Be right and proper. Do not trespass upon the taboo grounds. That's the way.",
            "nextDialogs": [
              "750050235"
            ]
          },
          "750050235": {
            "id": "750050235",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "Ha! Haha! Your companion is clever. A clever child indeed.",
            "nextDialogs": [
              "750050236"
            ]
          },
          "750050236": {
            "id": "750050236",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "I, too, had many such... brilliant children. But now, I walk alone. Many years it has been since I left the flocks...",
            "nextDialogs": [
              "750050237"
            ]
          },
          "750050237": {
            "id": "750050237",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "Ahem... Ah, night has drawn night sooner than I expected.",
            "nextDialogs": [
              "750050238"
            ]
          },
          "750050238": {
            "id": "750050238",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "*yawn* Honestly, hearing so much stuff she doesn't really understand is making Paimon sleepy...",
            "nextDialogs": [
              "750050239"
            ]
          },
          "750050239": {
            "id": "750050239",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "Ah, look at me, getting all carried away like this. Bring me the occasional person to talk to, and I get all chatty... If you don't mind, would you like to rest here for the night?",
            "nextDialogs": [
              "750050240"
            ]
          },
          "750050240": {
            "id": "750050240",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "I can prepare bedding for you. I will be out patrolling at night, anyway, so you need not fear for your safety.",
            "nextDialogs": [
              "750050241"
            ]
          },
          "750050241": {
            "id": "750050241",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe, thanks! That's thoughtful of you!",
            "nextDialogs": [
              "750050242"
            ]
          },
          "750050242": {
            "id": "750050242",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr...",
            "nextDialogs": [
              "750050243"
            ]
          },
          "750050243": {
            "id": "750050243",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Lying on a bed of warm grass, you swiftly drift off as the campfire flickers by your side...\\nBut you feel as though some faint noise lingers by your ear, preventing you from falling into a deeper slumber.",
            "nextDialogs": [
              "750050244"
            ]
          },
          "750050244": {
            "id": "750050244",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Until...\\nSomething cold and moist makes contact with your cheek, dragging you from the thick, dark night of dreamland...",
            "nextDialogs": [
              "750050245"
            ]
          },
          "750050245": {
            "id": "750050245",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "#You open your eyes to the sight of {REALNAME[ID(2)|SHOWHOST(true)]}'s friendly, familiar face.\\nIt seems that he was licking you to wake you up.\\nA moment later, you realize that he is trying to show you something — a strange obsidian statue...",
            "nextDialogs": [
              "750050246"
            ]
          },
          "750050246": {
            "id": "750050246",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!"
          },
          "750050216": {
            "id": "750050216",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yup. Who wouldn't be curious after seeing a great sealed gate, anyway?",
            "nextDialogs": [
              "750050217"
            ]
          },
          "750050217": {
            "id": "750050217",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750050218"
            ]
          },
          "750050218": {
            "id": "750050218",
            "speakerId": 1003,
            "speakerName": "Legba",
            "text": "Decent people, I'd say.",
            "nextDialogs": [
              "750050219"
            ]
          },
          "750050219": {
            "id": "750050219",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey!"
          }
        }
      }
    },

    {
      "subId": "7500504",
      "subQuestName": "Go to the camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750050401"
        ],
        "dialogs": {
          "750050401": {
            "id": "750050401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Weren't we in the canyon ruins just now? Where is this...?",
            "nextDialogs": [
              "750050402"
            ]
          },
          "750050402": {
            "id": "750050402",
            "speakerId": 1005,
            "speakerName": "\"Projection of an Obsidian Tablet\"",
            "text": "Come, come. Over here.",
            "nextDialogs": [
              "750050403"
            ]
          },
          "750050403": {
            "id": "750050403",
            "speakerId": 1005,
            "speakerName": "\"Projection of an Obsidian Tablet\"",
            "text": "\"Idol\"... \"Medium\"... Return...",
            "nextDialogs": [
              "750050404"
            ]
          },
          "750050404": {
            "id": "750050404",
            "speakerId": 1005,
            "speakerName": "\"Projection of an Obsidian Tablet\"",
            "text": "(The gentle voice drifts in as if from far away, like whispers carried on the wind...)",
            "nextDialogs": [
              "750050405"
            ]
          },
          "750050405": {
            "id": "750050405",
            "speakerId": 1005,
            "speakerName": "\"Projection of an Obsidian Tablet\"",
            "text": "(The cold consciousness constantly calls out to you through... the obsidian statue in your hand...)",
            "nextDialogs": [
              "750050406"
            ]
          },
          "750050406": {
            "id": "750050406",
            "speakerId": 1005,
            "speakerName": "\"Projection of an Obsidian Tablet\"",
            "text": "Return... Return...",
            "nextDialogs": [
              "750050407"
            ]
          },
          "750050407": {
            "id": "750050407",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}?",
            "nextDialogs": [
              "750050408"
            ]
          },
          "750050408": {
            "id": "750050408",
            "speakerId": 1005,
            "speakerName": "\"Projection of an Obsidian Tablet\"",
            "text": "...",
            "nextDialogs": [
              "750050409"
            ]
          },
          "750050409": {
            "id": "750050409",
            "speakerId": 1005,
            "speakerName": "\"Projection of an Obsidian Tablet\"",
            "text": "Long has it been since visitors from afar have come. This place is... too big. Too empty.",
            "nextDialogs": [
              "750050410"
            ]
          },
          "750050410": {
            "id": "750050410",
            "speakerId": 1005,
            "speakerName": "\"Projection of an Obsidian Tablet\"",
            "text": "The dark filth enters uninvited, staining even the darkest dreams...",
            "nextDialogs": [
              "750050411"
            ]
          },
          "750050411": {
            "id": "750050411",
            "speakerId": 1005,
            "speakerName": "\"Projection of an Obsidian Tablet\"",
            "text": "Our nation is invaded once more. If the slain are swallowed by the turbulent tides of darkness, the flames of the living, dawn and dusk... All shall be extinguished...",
            "nextDialogs": [
              "750050412"
            ]
          },
          "750050412": {
            "id": "750050412",
            "speakerId": 1005,
            "speakerName": "\"Projection of an Obsidian Tablet\"",
            "text": "Trust not lightly the so-called vision of the \"sacred mountain.\" Reject... His promise..."
          }
        }
      }
    },
    {
      "subId": "7500505",

    {
      "subId": "7414204",
      "subQuestName": "Talk to Canotila",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741420401"
        ],
        "dialogs": {
          "741420401": {
            "id": "741420401",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "#{M#Mr.}{F#Ms.} {NICKNAME}? Didn't we just see each other?",
            "nextDialogs": [
              "741420402"
            ]
          },
          "741420402": {
            "id": "741420402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "When did we last meet?",
            "nextDialogs": [
              "741420403"
            ]
          },
          "741420403": {
            "id": "741420403",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "Hmm, I'm not sure. After all, it's hard to keep track of time in a place like this.",
            "nextDialogs": [
              "741420404"
            ]
          },
          "741420404": {
            "id": "741420404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Come with me, Canotila.",
            "nextDialogs": [
              "741420405"
            ]
          },
          "741420405": {
            "id": "741420405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Something about this place doesn't feel right.",
            "nextDialogs": [
              "741420406"
            ]
          },
          "741420406": {
            "id": "741420406",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "Hmm, but don't we get to decide what feels right or not?",
            "nextDialogs": [
              "741420407"
            ]
          },
          "741420407": {
            "id": "741420407",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "Um, I didn't mean to be so deep. But I really like this place. It's full of life and colors, things I've never seen on the other side.",
            "nextDialogs": [
              "741420408"
            ]
          },
          "741420408": {
            "id": "741420408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I only saw a sunflower...",
            "nextDialogs": [
              "741420409"
            ]
          },
          "741420409": {
            "id": "741420409",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "Really? Wow! Where?",
            "nextDialogs": [
              "741420410"
            ]
          },
          "741420410": {
            "id": "741420410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Where we saw the puppy.",
            "nextDialogs": [
              "741420411"
            ]
          },
          "741420411": {
            "id": "741420411",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "Okay! I'm going there now!",
            "nextDialogs": [
              "741420412"
            ]
          },
          "741420412": {
            "id": "741420412",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wait..."
          }
        }
      }
    },

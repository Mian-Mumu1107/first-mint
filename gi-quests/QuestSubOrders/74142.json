    {
      "subId": "7414207",
      "subQuestName": "Continue the pursuit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741420701"
        ],
        "dialogs": {
          "741420701": {
            "id": "741420701",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "#{M#Mr.}{F#Ms.} {NICKNAME}! Wait, why isn't Paimon with you?",
            "nextDialogs": [
              "741420702"
            ]
          },
          "741420702": {
            "id": "741420702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That rift... What are you looking at?",
            "nextDialogs": [
              "741420703"
            ]
          },
          "741420703": {
            "id": "741420703",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "What rift? Isn't this a mirror?",
            "nextDialogs": [
              "741420704"
            ]
          },
          "741420704": {
            "id": "741420704",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "Well, speaking of that, there is something that I've been looking for.",
            "nextDialogs": [
              "741420705"
            ]
          },
          "741420705": {
            "id": "741420705",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "I'm trying to find clues to the Looking Glass. It looks like a painting, and lets people meditate in a similar manner to the Book of Revealing.",
            "nextDialogs": [
              "741420706"
            ]
          },
          "741420706": {
            "id": "741420706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the four orthants and the painting in the Tower of Gestalt...",
            "nextDialogs": [
              "741420707"
            ]
          },
          "741420707": {
            "id": "741420707",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "#...Really? So it's in a place like that? Okay! Thank you, {M#Mr.}{F#Ms.} {NICKNAME}."
          }
        }
      }
    },

    {
      "subId": "7414213",
      "subQuestName": "Talk to Canotila",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741421301"
        ],
        "dialogs": {
          "741421301": {
            "id": "741421301",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "#Thanks, {M#Mr.}{F#Ms.} {NICKNAME}.",
            "nextDialogs": [
              "741421302"
            ]
          },
          "741421302": {
            "id": "741421302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "741421303"
            ]
          },
          "741421303": {
            "id": "741421303",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "I don't know. I just wanted to see the blooming sunflowers and the cute puppy...",
            "nextDialogs": [
              "741421304"
            ]
          },
          "741421304": {
            "id": "741421304",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "But a monster came after me, and the sky got darker. I heard many voices talking about things that I didn't understand.",
            "nextDialogs": [
              "741421305"
            ]
          },
          "741421305": {
            "id": "741421305",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "I was scared, so I followed the golden light and ran forward.",
            "nextDialogs": [
              "741421306"
            ]
          },
          "741421306": {
            "id": "741421306",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "The world got a little darker whenever the monster came near. The garden, the palace, the great trees, and the flowers all disappeared. It was very gloomy, and I only saw ruins...",
            "nextDialogs": [
              "741421307"
            ]
          },
          "741421307": {
            "id": "741421307",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "And then the monster caught up to me...",
            "nextDialogs": [
              "741421308"
            ]
          },
          "741421308": {
            "id": "741421308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You don't have to worry now.",
            "nextDialogs": [
              "741421309"
            ]
          },
          "741421309": {
            "id": "741421309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Puppy, please send her back.",
            "nextDialogs": [
              "741421310"
            ]
          },
          "741421310": {
            "id": "741421310",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "Don't come around here anymore, little one. There's nothing here, but there's a whole world waiting for you out there.",
            "nextDialogs": [
              "741421311"
            ]
          },
          "741421311": {
            "id": "741421311",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "Huh? Are you the puppy? But...",
            "nextDialogs": [
              "741421312"
            ]
          },
          "741421312": {
            "id": "741421312",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "...Will I see you again? Will this world become a beautiful garden again?",
            "nextDialogs": [
              "741421313"
            ]
          },
          "741421313": {
            "id": "741421313",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "No. Goodbye.",
            "nextDialogs": [
              "741421314"
            ]
          },
          "741421314": {
            "id": "741421314",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "And you, let me ask you one more time. What am I in your eyes?",
            "nextDialogs": [
              "741421315"
            ]
          },
          "741421315": {
            "id": "741421315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A dog.",
            "nextDialogs": [
              "741421316"
            ]
          },
          "741421316": {
            "id": "741421316",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "That's good. You just got rid of someone who shouldn't be here, and thanks to you, this world's collapse has stopped.",
            "nextDialogs": [
              "741421317"
            ]
          },
          "741421317": {
            "id": "741421317",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "But it is unwise for any of you to stay all the same.",
            "nextDialogs": [
              "741421319",
              "741421321"
            ]
          },
          "741421319": {
            "id": "741421319",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "A wise choice. Farewell."
          },
          "741421321": {
            "id": "741421321",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "This world was going to disintegrate, because someone who shouldn't be here arrived, shaking the foundations of this world.",
            "nextDialogs": [
              "741421322"
            ]
          },
          "741421322": {
            "id": "741421322",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is that why I saw what I saw?",
            "nextDialogs": [
              "741421323"
            ]
          },
          "741421323": {
            "id": "741421323",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "I don't know what you experienced. I am not you, after all.",
            "nextDialogs": [
              "741421324"
            ]
          },
          "741421324": {
            "id": "741421324",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And who are you then?",
            "nextDialogs": [
              "741421325"
            ]
          },
          "741421325": {
            "id": "741421325",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "...That is not important. What's important is the masters of this imaginary world.",
            "nextDialogs": [
              "741421326"
            ]
          },
          "741421326": {
            "id": "741421326",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "They believed that they could save the world, but they didn't know if this world actually needed to be saved. Maybe the world in their memories was but an afternoon forever bereft of blooming sunflowers.",
            "nextDialogs": [
              "741421327"
            ]
          },
          "741421327": {
            "id": "741421327",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "But those are their stories and not mine. I'm just a memory that they have of their friend. They once believed that they could save me, but ultimately...",
            "nextDialogs": [
              "741421328"
            ]
          },
          "741421328": {
            "id": "741421328",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "The butterfly became a cocoon, and a larva emerged from the cocoon. Then, the larva returned to the void that was never born.",
            "nextDialogs": [
              "741421329"
            ]
          },
          "741421329": {
            "id": "741421329",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "But none of these things matter. I have nothing left. I am just a shadow in their memories, left behind by their obsession to save me.",
            "nextDialogs": [
              "741421330"
            ]
          },
          "741421330": {
            "id": "741421330",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "I don't hate them, though. Even if they changed after losing me, my existence in this world of memories and delusions is proof of their persistence.",
            "nextDialogs": [
              "741421331"
            ]
          },
          "741421331": {
            "id": "741421331",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "As someone who was once their friend, I am more than satisfied. No matter what I become, I am forever grateful for the friendship we once had.",
            "nextDialogs": [
              "741421332"
            ]
          },
          "741421332": {
            "id": "741421332",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "Anyway, let's end it here. You can feel the influence this place has on you, can't you?",
            "nextDialogs": [
              "741421333"
            ]
          },
          "741421333": {
            "id": "741421333",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "Farewell. We won't see each other again."
          }
        }
      }
    },
    {
      "subId": "7414215",
      "subQuestName": "Awaken",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741421501"
        ],
        "dialogs": {
          "741421501": {
            "id": "741421501",
            "speakerId": 1000,
            "speakerName": "Book of Revealing",
            "text": "(The content on the pages still consists of incomprehensible symbols, letters, ancient languages, and geometric figures. But a period of focus seems to gradually render their meaning comprehensible.)",
            "nextDialogs": [
              "741421502"
            ]
          },
          "741421502": {
            "id": "741421502",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, are you still going to meditate?",
            "nextDialogs": [
              "741421503"
            ]
          },
          "741421503": {
            "id": "741421503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We haven't found Canotila yet.",
            "nextDialogs": [
              "741421504"
            ]
          },
          "741421504": {
            "id": "741421504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm going to need you to give me another moment, Paimon.",
            "nextDialogs": [
              "741421505"
            ]
          },
          "741421505": {
            "id": "741421505",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Uh... Okay then! It's just a blink of an eye anyway. Paimon's not worried at all!",
            "nextDialogs": [
              "741421506"
            ]
          },
          "741421506": {
            "id": "741421506",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "#Still, be careful, {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "7414214",
      "subQuestName": "Talk to Canotila",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741421401"
        ],
        "dialogs": {
          "741421401": {
            "id": "741421401",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Whoa!",
            "nextDialogs": [
              "741421402"
            ]
          },
          "741421402": {
            "id": "741421402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon, I...",
            "nextDialogs": [
              "741421403"
            ]
          },
          "741421403": {
            "id": "741421403",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "That was super fast! Paimon didn't even have time to blink...",
            "nextDialogs": [
              "741421404"
            ]
          },
          "741421404": {
            "id": "741421404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...That's a relief.",
            "nextDialogs": [
              "741421405"
            ]
          },
          "741421405": {
            "id": "741421405",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "#Alright! Our little troublemaker's back! Canotila, you made {NICKNAME} really worried, you know?",
            "nextDialogs": [
              "741421406"
            ]
          },
          "741421406": {
            "id": "741421406",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "I...",
            "nextDialogs": [
              "741421407"
            ]
          },
          "741421407": {
            "id": "741421407",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "*sob* I'm sorry...",
            "nextDialogs": [
              "741421408"
            ]
          },
          "741421408": {
            "id": "741421408",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Huh? Paimon's not blaming you! Don't cry, Canotila. Come on, Paimon will give you something delicious to eat...",
            "nextDialogs": [
              "741421409"
            ]
          },
          "741421409": {
            "id": "741421409",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "(What happened?)",
            "nextDialogs": [
              "741421410"
            ]
          },
          "741421410": {
            "id": "741421410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(We encountered some danger inside.)",
            "nextDialogs": [
              "741421411"
            ]
          },
          "741421411": {
            "id": "741421411",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "(Oh...)",
            "nextDialogs": [
              "741421412"
            ]
          },
          "741421412": {
            "id": "741421412",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Don't cry, Canotila, you're a brave, brave Melusine! Here, this is Paimon's favorite Chicken-Mushroom Skewer. Take it, it's all yours!",
            "nextDialogs": [
              "741421413"
            ]
          },
          "741421413": {
            "id": "741421413",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "*sob* Thank you so much, Paimon...",
            "nextDialogs": [
              "741421414"
            ]
          },
          "741421414": {
            "id": "741421414",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "*chewing*",
            "nextDialogs": [
              "741421415"
            ]
          },
          "741421415": {
            "id": "741421415",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "Whoa, such a strange taste! So this is what humans eat for their meals...",
            "nextDialogs": [
              "741421416"
            ]
          },
          "741421416": {
            "id": "741421416",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Hey! If you don't want it, you can just give it back to Paimon!",
            "nextDialogs": [
              "741421417"
            ]
          },
          "741421417": {
            "id": "741421417",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "#But... Thank you. And thank you for saving me, {M#Mr.}{F#Ms.} {NICKNAME}!",
            "nextDialogs": [
              "741421418"
            ]
          },
          "741421418": {
            "id": "741421418",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do you plan to do next?",
            "nextDialogs": [
              "741421419"
            ]
          },
          "741421419": {
            "id": "741421419",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "I don't know, but I don't want to read books anymore.",
            "nextDialogs": [
              "741421420"
            ]
          },
          "741421420": {
            "id": "741421420",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "...Canotila, isn't that a bit extreme?",
            "nextDialogs": [
              "741421421"
            ]
          },
          "741421421": {
            "id": "741421421",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "Well, um... The Book of Revealing is really scary...",
            "nextDialogs": [
              "741421422"
            ]
          },
          "741421422": {
            "id": "741421422",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "(So, what exactly happened?)",
            "nextDialogs": [
              "741421423"
            ]
          },
          "741421423": {
            "id": "741421423",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(It's a long story...)",
            "nextDialogs": [
              "741421426"
            ]
          },
          "741421426": {
            "id": "741421426",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "(What do you mean? Ugh, Paimon's getting annoyed...)",
            "nextDialogs": [
              "741421427"
            ]
          },
          "741421427": {
            "id": "741421427",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "...Anyway, I don't want to stay here anymore. I want to live with everyone in Merusea Village.",
            "nextDialogs": [
              "741421428"
            ]
          },
          "741421428": {
            "id": "741421428",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "That's right! The other Melusines will take good care of you!",
            "nextDialogs": [
              "741421429"
            ]
          },
          "741421429": {
            "id": "741421429",
            "speakerId": 1001,
            "speakerName": "Canotila",
            "text": "#Thank you, {M#Mr.}{F#Ms.} {NICKNAME}, Paimon."
          }
        }
      }

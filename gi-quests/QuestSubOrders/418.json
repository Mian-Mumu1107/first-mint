  "subQuests": [
    {
      "subId": "41801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4180201"
        ],
        "dialogs": {
          "4180201": {
            "id": "4180201",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "What should we do... Although we worked out how to <color=#00E1FFFF>break the seal barrier</color>, with so many monsters around...",
            "nextDialogs": [
              "4180210"
            ]
          },
          "4180210": {
            "id": "4180210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "4180220"
            ]
          },
          "4180220": {
            "id": "4180220",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "Hmm? Excuse me, I was lost in thought. I am Livingstone, a career adventurer.",
            "nextDialogs": [
              "4180221"
            ]
          },
          "4180221": {
            "id": "4180221",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "You! Amidst the valley flooded by monsters, I never thought I'd encounter another living being that's not a monster!",
            "nextDialogs": [
              "4180222"
            ]
          },
          "4180222": {
            "id": "4180222",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "You must be one of my peers, a great pioneering adventurer!",
            "nextDialogs": [
              "4180223"
            ]
          },
          "4180223": {
            "id": "4180223",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "With the mysterious stars above and the brooding abyss below, this is what our adventurous souls are made of!",
            "nextDialogs": [
              "4180224"
            ]
          },
          "4180224": {
            "id": "4180224",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "An ancient battlefield protected by <color=#00E1FFFF>triple seal barriers</color>, which were set up by the survivors using elemental powers, to let their fallen comrades — their graves marked with swords — rest undisturbed.",
            "nextDialogs": [
              "4180225"
            ]
          },
          "4180225": {
            "id": "4180225",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "But... what should we do...",
            "nextDialogs": [
              "4180226"
            ]
          },
          "4180226": {
            "id": "4180226",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "...",
            "nextDialogs": [
              "4180227"
            ]
          },
          "4180227": {
            "id": "4180227",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "Sorry, I was lost in thought. Where were we?",
            "nextDialogs": [
              "4180240"
            ]
          },
          "4180240": {
            "id": "4180240",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "Well, these swords... and the <color=#00E1FFFF>treasures</color> among them were the relics of the warriors who fought and died here. How could anyone let <color=#00E1FFFF>three hilichurl camps</color> come rummaging and disturb their sleep?",
            "nextDialogs": [
              "4180241"
            ]
          },
          "4180241": {
            "id": "4180241",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "We're not hilichurls, so you can't say that what I'm doing is disturbing their sleep. We are adventurers who use their wits to conquer all mysteries and secrets!",
            "nextDialogs": [
              "4180242"
            ]
          },
          "4180242": {
            "id": "4180242",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "I understand where you are coming from, but the <color=#00E1FFFF>seal</color>...",
            "nextDialogs": [
              "4180243"
            ]
          },
          "4180243": {
            "id": "4180243",
            "speakerId": 1000,
            "speakerName": "Dr. Livingstone",
            "text": "What should we do..."
          }
        }
      }
    },

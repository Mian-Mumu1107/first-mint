  "subQuests": [
    {
      "subId": "7418603",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741860301"
        ],
        "dialogs": {
          "741860301": {
            "id": "741860301",
            "speakerId": 1000,
            "speakerName": "Nameless Golem",
            "text": "Dominus Cassiodor! Dominus Cassiodor... Is that you?",
            "nextDialogs": [
              "741860302"
            ]
          },
          "741860302": {
            "id": "741860302",
            "speakerId": 1001,
            "speakerName": "Osse",
            "text": "...",
            "nextDialogs": [
              "741860303"
            ]
          },
          "741860303": {
            "id": "741860303",
            "speakerId": 1000,
            "speakerName": "Nameless Golem",
            "text": "It is you! Just as I thought! You've finally returned...",
            "nextDialogs": [
              "741860304"
            ]
          },
          "741860304": {
            "id": "741860304",
            "speakerId": 1000,
            "speakerName": "Nameless Golem",
            "text": "I was ordered to guard this fortress, but the cruel Vishaps and attacks of the barbarians were simply too much for me, so I was forced back step by step until I arrived here.",
            "nextDialogs": [
              "741860305"
            ]
          },
          "741860305": {
            "id": "741860305",
            "speakerId": 1000,
            "speakerName": "Nameless Golem",
            "text": "It seems as though many, many years have passed since then... What tidings from beyond? Were we victorious?",
            "nextDialogs": [
              "741860306"
            ]
          },
          "741860306": {
            "id": "741860306",
            "speakerId": 1001,
            "speakerName": "Osse",
            "text": "...",
            "nextDialogs": [
              "741860307"
            ]
          },
          "741860307": {
            "id": "741860307",
            "speakerId": 1000,
            "speakerName": "Nameless Golem",
            "text": "...Is that so? Then we lost.",
            "nextDialogs": [
              "741860308"
            ]
          },
          "741860308": {
            "id": "741860308",
            "speakerId": 1001,
            "speakerName": "Osse",
            "text": "I am sorry...",
            "nextDialogs": [
              "741860309"
            ]
          },
          "741860309": {
            "id": "741860309",
            "speakerId": 1000,
            "speakerName": "Nameless Golem",
            "text": "Do not say such things, Honored Dominus. I had already imagined this day might come when I joined the Sebastos's legions.",
            "nextDialogs": [
              "741860310"
            ]
          },
          "741860310": {
            "id": "741860310",
            "speakerId": 1000,
            "speakerName": "Nameless Golem",
            "text": "Did the Sebastos not say that he wanted to lead us to break the shackles of \"Fortuna\"? But is doing so that simple?",
            "nextDialogs": [
              "741860311"
            ]
          },
          "741860311": {
            "id": "741860311",
            "speakerId": 1000,
            "speakerName": "Nameless Golem",
            "text": "After all, what we struggle against is fate itself, and defying fate is a feat beyond even the greatest of the gods.",
            "nextDialogs": [
              "741860312"
            ]
          },
          "741860312": {
            "id": "741860312",
            "speakerId": 1001,
            "speakerName": "Osse",
            "text": "In the end, all our efforts were in vain...",
            "nextDialogs": [
              "741860313"
            ]
          },
          "741860313": {
            "id": "741860313",
            "speakerId": 1000,
            "speakerName": "Nameless Golem",
            "text": "Nay, say not so, Dominus. We took up arms against divine destiny, and our deeds challenged the laws of heaven. We resisted that prophecy, resisted it most valiantly...",
            "nextDialogs": [
              "741860314"
            ]
          },
          "741860314": {
            "id": "741860314",
            "speakerId": 1000,
            "speakerName": "Nameless Golem",
            "text": "Though we failed in the end... Someone must have betrayed us, led us astray...",
            "nextDialogs": [
              "741860315"
            ]
          },
          "741860315": {
            "id": "741860315",
            "speakerId": 1000,
            "speakerName": "Nameless Golem",
            "text": "Still, the outcome no longer matters. Come what may, our deeds shall be carved into this world's \"history\"...",
            "nextDialogs": [
              "741860316"
            ]
          },
          "741860316": {
            "id": "741860316",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hey! Why did he just fall over like that? Can stone people also just... suddenly faint?",
            "nextDialogs": [
              "741860317"
            ]
          },
          "741860317": {
            "id": "741860317",
            "speakerId": 1001,
            "speakerName": "Osse",
            "text": "I still do not know his name... It appears his \"history\" has now reached its conclusion.",
            "nextDialogs": [
              "741860318"
            ]
          },
          "741860318": {
            "id": "741860318",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wait, that's so sad! Has he just been fighting here, all these thousands of years?",
            "nextDialogs": [
              "741860319"
            ]
          },
          "741860319": {
            "id": "741860319",
            "speakerId": 1001,
            "speakerName": "Osse",
            "text": "But now, he is finally at peace. Let us continue onward."
          }
        }
      }
    }
  ]
}
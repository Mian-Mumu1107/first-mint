            "nextDialogs": [
              "700890104"
            ]
          },
          "700890104": {
            "id": "700890104",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I'm trying to find my way back. I only remember that I need to find an Anemo Archon Statue.",
            "nextDialogs": [
              "700890105"
            ]
          },
          "700890105": {
            "id": "700890105",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I don't remember anything else.",
            "nextDialogs": [
              "700890106"
            ]
          },
          "700890106": {
            "id": "700890106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Your way back?",
            "nextDialogs": [
              "700890107"
            ]
          },
          "700890107": {
            "id": "700890107",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "It's a vague sense of homesickness, but I can't remember anything at all.",
            "nextDialogs": [
              "700890108"
            ]
          },
          "700890108": {
            "id": "700890108",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "When I woke up, the only thing I had was a note in my hand that said, \"You are 'Maukie.'\"",
            "nextDialogs": [
              "700890109"
            ]
          },
          "700890109": {
            "id": "700890109",
            "speakerId": 22277,
            "speakerName": "\"Maukie\"",
            "text": "So I suppose my name is Maukie.",
            "nextDialogs": [
              "700890110"
            ]
          },
          "700890110": {
            "id": "700890110",
            "speakerId": 22277,
            "speakerName": "\"Maukie\"",
            "text": "I should be going now. Goodbye.",
            "nextDialogs": [
              "700890111"
            ]
          },
          "700890111": {
            "id": "700890111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What a strange person. But he doesn't seem like a bad guy.",
            "nextDialogs": [
              "700890112"
            ]
          },
          "700890112": {
            "id": "700890112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are you alright?",
            "nextDialogs": [
              "700890113"

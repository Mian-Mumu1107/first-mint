    {
      "subId": "7221106",
      "subQuestName": "Give the Delicious Invigorating Kitty Meal to the kittens",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110601"
        ],
        "dialogs": {
          "722110601": {
            "id": "722110601",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "I shall leave the cooking to you.",
            "nextDialogs": [
              "722110602"
            ]
          },
          "722110602": {
            "id": "722110602",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "And when you are done, eat it together with us."
          }
        }
      }
    },
    {
      "subId": "7221109",
      "subQuestName": "Give the Delicious Invigorating Kitty Meal to the kittens",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110901"
        ],
        "dialogs": {
          "722110901": {
            "id": "722110901",
            "speakerId": 3180,
            "speakerName": "Etsuko",
            "text": "Something the matter? If not, head over to the city and look for Miss Kiminami Anna."
          }
        }
      }
    },
    {
      "subId": "7221110",
      "subQuestName": "Give the Delicious Invigorating Kitty Meal to the kittens",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722111001"
        ],
        "dialogs": {
          "722111001": {
            "id": "722111001",
            "speakerId": 3181,
            "speakerName": "Taisuke",
            "text": "*sigh* If only I new how to make food..."
          }
        }
      }
    },
    {
      "subId": "7221111",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722111101"
        ],
        "dialogs": {
          "722111101": {
            "id": "722111101",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Hello, welcome to Kiminami Restaurant. Would you like something?",
            "nextDialogs": [
              "722111102"
            ]
          },
          "722111102": {
            "id": "722111102",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Hello— Oh, it's you! Miss Kamisato's friend! Come in, come in! What can I help you with?",
            "nextDialogs": [
              "722111103"
            ]
          },
          "722111103": {
            "id": "722111103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So I need to make Neko a meal...",
            "nextDialogs": [
              "722111104"
            ]
          },
          "722111104": {
            "id": "722111104",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "\"Neko?\" ... Might that be a cat's name, by any chance?",
            "nextDialogs": [
              "722111105"
            ]
          },
          "722111105": {
            "id": "722111105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You know who Neko is?",
            "nextDialogs": [
              "722111106"
            ]
          },
          "722111106": {
            "id": "722111106",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "No. I just thought that it was a fitting name for a cat.",
            "nextDialogs": [
              "722111107"
            ]
          },
          "722111107": {
            "id": "722111107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's some strong intuition you've got there...",
            "nextDialogs": [
              "722111108"
            ]
          },
          "722111108": {
            "id": "722111108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Never mind that for now. This is how it happened...",
            "nextDialogs": [
              "722111109"
            ]
          },
          "722111109": {
            "id": "722111109",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "There's... an Asase Shrine on Seirai Island, and that shrine is home to a talking cat!? And that cat asked you to make it a meal?",
            "nextDialogs": [
              "722111110"
            ]
          },
          "722111110": {
            "id": "722111110",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Is... Is that really true? I've never heard of such a thing!",
            "nextDialogs": [
              "722111111"
            ]
          },
          "722111111": {
            "id": "722111111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Surely as I live and breathe...",
            "nextDialogs": [
              "722111113"
            ]
          },
          "722111113": {
            "id": "722111113",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Seirai Island, was it? I'll go there for sure if I get the chance!",
            "nextDialogs": [
              "722111114"
            ]
          },
          "722111114": {
            "id": "722111114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh, so, about Neko's meal...",
            "nextDialogs": [
              "722111115"
            ]
          },
          "722111115": {
            "id": "722111115",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Ah, right... I nearly forgot about that. Let me think...",
            "nextDialogs": [
              "722111116"
            ]
          },
          "722111116": {
            "id": "722111116",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Hmm, a dish that a cat would enjoy, huh...",
            "nextDialogs": [
              "722111117"
            ]
          },
          "722111117": {
            "id": "722111117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is it gonna be difficult?",
            "nextDialogs": [
              "722111118"
            ]
          },
          "722111118": {
            "id": "722111118",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "...",
            "nextDialogs": [
              "722111119"
            ]
          },
          "722111119": {
            "id": "722111119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's going to be difficult, isn't it?",
            "nextDialogs": [
              "722111120"
            ]
          },
          "722111120": {
            "id": "722111120",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "This is a challenge to the Kiminami family name! I'm going to overcome it, no matter what!",
            "nextDialogs": [
              "722111121"
            ]
          },
          "722111121": {
            "id": "722111121",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Now then. I believe that Fish, Raw Meat, Seagrass, and Rice will make for a dish that even cats will fall over themselves to get a taste of. Leave it to me, Traveler!",
            "nextDialogs": [
              "722111122"
            ]
          },
          "722111122": {
            "id": "722111122",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "P—Paimon wants some too...",
            "nextDialogs": [
              "722111125"
            ]
          },
          "722111125": {
            "id": "722111125",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "No problem!",
            "nextDialogs": [
              "722111126"
            ]
          },
          "722111126": {
            "id": "722111126",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Let me consider how I'm going to structure this recipe. In the meantime, help me prepare three servings of Seagrass."
          }
        }
      }
    },
    {
      "subId": "7221107",
      "subQuestName": "Report back to Neko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110501"
        ],
        "dialogs": {
          "722110501": {
            "id": "722110501",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Have you brought the meal to those little ones?",
            "nextDialogs": [
              "722110502"
            ]
          },
          "722110502": {
            "id": "722110502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They absolutely loved it.",
            "nextDialogs": [
              "722110503"
            ]
          },
          "722110503": {
            "id": "722110503",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Is that so? Wonderful, wonderful. Meow, meow...",
            "nextDialogs": [
              "722110504"
            ]
          },
          "722110504": {
            "id": "722110504",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "It has been too long since I ate something so wondrous.",
            "nextDialogs": [
              "722110505"
            ]
          },
          "722110505": {
            "id": "722110505",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Meow meow, meow... Though I now need neither food nor water, the taste of a meal with rice is always too great a temptation...",
            "nextDialogs": [
              "722110506"
            ]
          },
          "722110506": {
            "id": "722110506",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "That little one was named Meshi, precisely because that is the best thing I could think of in all the world.",
            "nextDialogs": [
              "722110507"
            ]
          },
          "722110507": {
            "id": "722110507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, what was the name of the dish that Hibiki would make?",
            "nextDialogs": [
              "722110508"
            ]
          },
          "722110508": {
            "id": "722110508",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "A name? Dishes need names?",
            "nextDialogs": [
              "722110509"
            ]
          },
          "722110509": {
            "id": "722110509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This one's called the \"Invigorating Kitty Meal,\" you know.",
            "nextDialogs": [
              "722110510"
            ]
          },
          "722110510": {
            "id": "722110510",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "What a complicated name. Still, I do not hate it.",
            "nextDialogs": [
              "722110511"
            ]
          },
          "722110511": {
            "id": "722110511",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "...And you are right. Meals are good things, and all good things should have names.",
            "nextDialogs": [
              "722110512"
            ]
          },
          "722110512": {
            "id": "722110512",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Meow, meow, I will ask Hibiki when she returns. You can make her your dish then, too...",
            "nextDialogs": [
              "722110513"
            ]
          },
          "722110513": {
            "id": "722110513",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "And she will make you hers. Then, you shall be able to eat two different yet delicious dishes.",
            "nextDialogs": [
              "722110514"
            ]
          },
          "722110514": {
            "id": "722110514",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Indeed, that is all the more reason for me to restore this shrine. When Hibiki returns, we shall all eat together.",
            "nextDialogs": [
              "722110515"
            ]
          },
          "722110515": {
            "id": "722110515",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Thank you. This is most delicious. Meow meow."
          }
        }
      }
    },
    {
      "subId": "7221103",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110301"
        ],
        "dialogs": {
          "722110301": {
            "id": "722110301",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "How is it? Have you found the three servings of Seagrass yet?"
          }
        }
      }
    }
  ]

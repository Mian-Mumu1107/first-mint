  },
  "subQuests": [
    {
      "subId": "7221101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110801"
        ],
        "dialogs": {
          "722110801": {
            "id": "722110801",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Ah, you're here. Great timing. I have need of aid.",
            "nextDialogs": [
              "722110802"
            ]
          },
          "722110802": {
            "id": "722110802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "722110803"
            ]
          },
          "722110803": {
            "id": "722110803",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Thanks to you, the shrine has been greatly improved, and we can expect the humans to return very soon indeed.",
            "nextDialogs": [
              "722110804"
            ]
          },
          "722110804": {
            "id": "722110804",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "I have been instructing the little ones to maintain a dignified bearing and not abase themselves before humans.",
            "nextDialogs": [
              "722110805"
            ]
          },
          "722110805": {
            "id": "722110805",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Unfortunately, they are too used to running wild and will not listen to instruction.",
            "nextDialogs": [
              "722110806"
            ]
          },
          "722110806": {
            "id": "722110806",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Nonetheless, I have a cunning plan.",
            "nextDialogs": [
              "722110807"
            ]
          },
          "722110807": {
            "id": "722110807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A cunning plan?",
            "nextDialogs": [
              "722110808"
            ]
          },
          "722110808": {
            "id": "722110808",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "When I was still very, very young, I too enjoyed playing everywhere. In an effort to bring me in line along with the other cats, Hibiki would make a most delicious dish.",
            "nextDialogs": [
              "722110809"
            ]
          },
          "722110809": {
            "id": "722110809",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "D—Delicious, you say...!",
            "nextDialogs": [
              "722110810"
            ]
          },
          "722110810": {
            "id": "722110810",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Whenever that meal was served, the cats would come running in from trees and rooftops alike. No matter how hot it was, or how scalded our tongues got, we could not resist it.",
            "nextDialogs": [
              "722110811"
            ]
          },
          "722110811": {
            "id": "722110811",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Hibiki would make a huge pot of it every time, and humans and cats would partake together. Even those who visited the shrine would get a share.",
            "nextDialogs": [
              "722110812"
            ]
          },
          "722110812": {
            "id": "722110812",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Ah, but Domeki... Tsk, that glutton. He would always eat so very much. A more undignified sight I have never seen.",
            "nextDialogs": [
              "722110815"
            ]
          },
          "722110815": {
            "id": "722110815",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Very good, your comprehension is excellent. Yes, I am asking you to make a dish.",
            "nextDialogs": [
              "722110816"
            ]
          },
          "722110816": {
            "id": "722110816",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not to doubt your wisdom...",
            "nextDialogs": [
              "722110817"
            ]
          },
          "722110817": {
            "id": "722110817",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But do you really know how this dish should be made?",
            "nextDialogs": [
              "722110818"
            ]
          },
          "722110818": {
            "id": "722110818",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Meow, meow?",
            "nextDialogs": [
              "722110819"
            ]
          },
          "722110819": {
            "id": "722110819",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "722110820"
            ]
          },
          "722110820": {
            "id": "722110820",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "I—Is not leaving such matters to you the very point of this exercise? Must I do everything myself?",
            "nextDialogs": [
              "722110821"
            ]
          },
          "722110821": {
            "id": "722110821",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "...Ah, but that dish was truly a thing of wonder! Even after wandering far off, or having spent years and years without it, I still remember its flavor...",
            "nextDialogs": [
              "722110822"
            ]
          },
          "722110822": {
            "id": "722110822",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Well, {NICKNAME}, looks like this is a job for us, eh? It's for the shrine's sake, after all!"
          }
        }
      }
    },
    {
      "subId": "7221102",
      "subQuestName": "Talk to Taisuke and Etsuko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110101"
        ],
        "dialogs": {
          "722110101": {
            "id": "722110101",
            "speakerId": 3181,
            "speakerName": "Taisuke",
            "text": "Miss Etsuko, where should we go next?",
            "nextDialogs": [
              "722110102"
            ]
          },
          "722110102": {
            "id": "722110102",
            "speakerId": 3180,
            "speakerName": "Etsuko",
            "text": "Phew... I think we'll rest for a while...",
            "nextDialogs": [
              "722110103"
            ]
          },
          "722110103": {
            "id": "722110103",
            "speakerId": 3180,
            "speakerName": "Etsuko",
            "text": "Hmm? It's you. Is there anything we can do for you?",
            "nextDialogs": [
              "722110104"
            ]
          },
          "722110104": {
            "id": "722110104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We need to find a reliable chef...",
            "nextDialogs": [
              "722110105"
            ]
          },
          "722110105": {
            "id": "722110105",
            "speakerId": 3181,
            "speakerName": "Taisuke",
            "text": "You're looking for a chef? On Seirai Island?",
            "nextDialogs": [
              "722110106"
            ]
          },
          "722110106": {
            "id": "722110106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, here's the thing. Neko would like us to...",
            "nextDialogs": [
              "722110107"
            ]
          },
          "722110107": {
            "id": "722110107",
            "speakerId": 3181,
            "speakerName": "Taisuke",
            "text": "Huh. So Lady Neko wants you to prepare some food, is that right?",
            "nextDialogs": [
              "722110108"
            ]
          },
          "722110108": {
            "id": "722110108",
            "speakerId": 3181,
            "speakerName": "Taisuke",
            "text": "Ah, darn it! If only I had some skill in cooking...",
            "nextDialogs": [
              "722110109"
            ]
          },
          "722110109": {
            "id": "722110109",
            "speakerId": 3180,
            "speakerName": "Etsuko",
            "text": "In other words, you'd like a chef who can help you figure out \"how to make something a cat would like out of these ingredients,\" right?",
            "nextDialogs": [
              "722110110"
            ]
          },
          "722110110": {
            "id": "722110110",
            "speakerId": 3180,
            "speakerName": "Etsuko",
            "text": "Let me think... A chef... A chef...",
            "nextDialogs": [
              "722110111"
            ]
          },
          "722110111": {
            "id": "722110111",
            "speakerId": 3180,
            "speakerName": "Etsuko",
            "text": "Well, why don't you try going to Inazuma City and looking for Kiminami Anna at Kiminami Restaurant?",
            "nextDialogs": [
              "722110112"
            ]
          },
          "722110112": {
            "id": "722110112",
            "speakerId": 3180,
            "speakerName": "Etsuko",
            "text": "She's a very nice person, and she's good at cooking as well. She should be able to help you out.",
            "nextDialogs": [
              "722110113"
            ]
          },
          "722110113": {
            "id": "722110113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thanks, we'll go look for her.",
            "nextDialogs": [
              "722110114"
            ]
          },
          "722110114": {
            "id": "722110114",
            "speakerId": 3180,
            "speakerName": "Etsuko",
            "text": "No need to thank us. Off you go, then, Taisuke and I still need to lay some plans for future exploration.",
            "nextDialogs": [
              "722110115"
            ]
          },
          "722110115": {
            "id": "722110115",
            "speakerId": 3180,
            "speakerName": "Etsuko",
            "text": "Hehe, well, I hope that this shrine really does thrive.",
            "nextDialogs": [
              "722110116"
            ]
          },
          "722110116": {
            "id": "722110116",
            "speakerId": 3180,
            "speakerName": "Etsuko",
            "text": "Otherwise, the hard work that you and Neko put into fixing it might go to waste..."
          }
        }
      }
    },
    {
      "subId": "7221103",
      "subQuestName": "Ask Kiminami Anna for help",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110201"
        ],
        "dialogs": {
          "722110201": {
            "id": "722110201",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Hello, welcome to Kiminami Restaurant. Would you like something?",
            "nextDialogs": [
              "722110203"
            ]
          },
          "722110203": {
            "id": "722110203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So I need to make Neko a meal...",
            "nextDialogs": [
              "722110204"
            ]
          },
          "722110204": {
            "id": "722110204",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "\"Neko?\" ... Might that be a cat's name, by any chance?",
            "nextDialogs": [
              "722110205"
            ]
          },
          "722110205": {
            "id": "722110205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You know who Neko is?",
            "nextDialogs": [
              "722110206"
            ]
          },
          "722110206": {
            "id": "722110206",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "No. I just thought that it was a fitting name for a cat.",
            "nextDialogs": [
              "722110207"
            ]
          },
          "722110207": {
            "id": "722110207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's some strong intuition you've got there...",
            "nextDialogs": [
              "722110208"
            ]
          },
          "722110208": {
            "id": "722110208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Never mind that for now. This is how it happened...",
            "nextDialogs": [
              "722110209"
            ]
          },
          "722110209": {
            "id": "722110209",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "There's... an Asase Shrine on Seirai Island, and that shrine is home to a talking cat!? And that cat asked you to make it a meal?",
            "nextDialogs": [
              "722110210"
            ]
          },
          "722110210": {
            "id": "722110210",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Is... Is that really true? I've never heard of such a thing!",
            "nextDialogs": [
              "722110213"
            ]
          },
          "722110213": {
            "id": "722110213",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Seirai Island, was it? I'll go there for sure if I get the chance!",
            "nextDialogs": [
              "722110214"
            ]
          },
          "722110214": {
            "id": "722110214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh, so, about Neko's meal...",
            "nextDialogs": [
              "722110215"
            ]
          },
          "722110215": {
            "id": "722110215",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Ah, right... I nearly forgot about that. Let me think...",
            "nextDialogs": [
              "722110216"
            ]
          },
          "722110216": {
            "id": "722110216",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Hmm, a dish that a cat would enjoy, huh...",
            "nextDialogs": [
              "722110217"
            ]
          },
          "722110217": {
            "id": "722110217",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is it gonna be difficult?",
            "nextDialogs": [
              "722110218"
            ]
          },
          "722110218": {
            "id": "722110218",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "...",
            "nextDialogs": [
              "722110219"
            ]
          },
          "722110219": {
            "id": "722110219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's going to be difficult, isn't it?",
            "nextDialogs": [
              "722110220"
            ]
          },
          "722110220": {
            "id": "722110220",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "This is a challenge to the Kiminami family name! I'm going to overcome it, no matter what!",
            "nextDialogs": [
              "722110221"
            ]
          },
          "722110221": {
            "id": "722110221",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Now then. I believe that Fish, Raw Meat, Seagrass, and Rice will make for a dish that even cats will fall over themselves to get a taste of. Leave it to me, Traveler!",
            "nextDialogs": [
              "722110222"
            ]
          },
          "722110222": {
            "id": "722110222",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "P—Paimon wants some too..."
          }
        }
      }
    },
    {
      "subId": "7221104",
      "subQuestName": "Give three servings of Seagrass to Kiminami Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110401"
        ],
        "dialogs": {
          "722110401": {
            "id": "722110401",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "This smell... You've done it, then?",
            "nextDialogs": [
              "722110402"
            ]
          },
          "722110402": {
            "id": "722110402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That we have.",
            "nextDialogs": [
              "722110403"
            ]
          },
          "722110403": {
            "id": "722110403",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Meow, meow! Wonderful! Allow me to have a taste.",
            "nextDialogs": [
              "722110404"
            ]
          },
          "722110404": {
            "id": "722110404",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "...",
            "nextDialogs": [
              "722110405"
            ]
          },
          "722110405": {
            "id": "722110405",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Mmm, it's somewhat different from how Hibiki used to make it...",
            "nextDialogs": [
              "722110406"
            ]
          },
          "722110406": {
            "id": "722110406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "I—It should be pretty good. C'mon, let's have a go at it!",
            "nextDialogs": [
              "722110407"
            ]
          },
          "722110407": {
            "id": "722110407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, this is great!",
            "nextDialogs": [
              "722110408"
            ]
          },
          "722110408": {
            "id": "722110408",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "...Meow.",
            "nextDialogs": [
              "722110409"
            ]
          },
          "722110409": {
            "id": "722110409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(Is Neko unhappy that it tastes different from how this Hibiki person used to make it?)",
            "nextDialogs": [
              "722110410"
            ]
          },
          "722110410": {
            "id": "722110410",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "It's very good. You are most reliable indeed.",
            "nextDialogs": [
              "722110411"
            ]
          },
          "722110411": {
            "id": "722110411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Glad you enjoyed it.",
            "nextDialogs": [
              "722110412"
            ]
          },
          "722110412": {
            "id": "722110412",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "It is quite different from how Hibiki used to make it, yes.",
            "nextDialogs": [
              "722110413"
            ]
          },
          "722110413": {
            "id": "722110413",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "But when I ate it, the feeling it gave me was the same as the feeling of eating together with Hibiki.",
            "nextDialogs": [
              "722110414"
            ]
          },
          "722110414": {
            "id": "722110414",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Why is this so, human? Are you humans capable of some strange magic?",
            "nextDialogs": [
              "722110417"
            ]
          },
          "722110417": {
            "id": "722110417",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "...Still, you have my thanks. Long years it has been since I last tasted something this good.",
            "nextDialogs": [
              "722110418"
            ]
          },
          "722110418": {
            "id": "722110418",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "The little ones will love it as well. Could you please bring this meal to them as well?",
            "nextDialogs": [
              "722110419"
            ]
          },
          "722110419": {
            "id": "722110419",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Since I enjoy it, they should too. Perhaps they will be more obedient after eating such a wonderful meal..."
          }
        }
      }
    },
    {
      "subId": "7221108",
      "subQuestName": "Give three servings of Seagrass to Kiminami Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722110702"
        ],
        "dialogs": {
          "722110702": {
            "id": "722110702",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Great! Give me a moment. I think... I think I know what to do now!",
            "nextDialogs": [
              "722110703"
            ]
          },
          "722110703": {
            "id": "722110703",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "It's done!",
            "nextDialogs": [
              "722110704"
            ]
          },
          "722110704": {
            "id": "722110704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, that smells awesome! Paimon really wants to try some...",
            "nextDialogs": [
              "722110705"
            ]
          },
          "722110705": {
            "id": "722110705",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "What shall we call this? Hmm... Since it's for a talking cat, let's call this the Invigorating Kitty Meal!",
            "nextDialogs": [
              "722110706"
            ]
          },
          "722110706": {
            "id": "722110706",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Well then! Here's your dish to go.",
            "nextDialogs": [
              "722110707"
            ]
          },
          "722110707": {
            "id": "722110707",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Ah, yes, and let me write the recipe down for you as well.",
            "nextDialogs": [
              "722110708"
            ]
          },
          "722110708": {
            "id": "722110708",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Woohoo! Guess {NICKNAME}-made Kitty Meals are on the menu in the near future!",
            "nextDialogs": [
              "722110710"
            ]
          },
          "722110710": {
            "id": "722110710",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, that's rude! Good food is a universal language, don't you know?",
            "nextDialogs": [
              "722110711"
            ]
          },
          "722110711": {
            "id": "722110711",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, thanks a bunch, Miss Kiminami!",
            "nextDialogs": [
              "722110713"
            ]
          },
          "722110713": {
            "id": "722110713",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "It's alright, don't worry! Just take this meal and the recipe as a present for Neko.",
            "nextDialogs": [
              "722110714"
            ]
          },
          "722110714": {
            "id": "722110714",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "I'll be sure to head down to that Asase Shrine to pay her a visit once I find the time.",
            "nextDialogs": [
              "722110715"
            ]
          },
          "722110715": {
            "id": "722110715",
            "speakerId": 3044,
            "speakerName": "Kiminami Anna",
            "text": "Alright, off you go now. Don't keep Neko waiting."
          }
        }
      }
    },
    {
      "subId": "7221105",
      "subQuestName": "Report back to Neko",
      "sceneId": null,
      "locations": [],

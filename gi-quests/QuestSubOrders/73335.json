        "dialogs": {
          "733350801": {
            "id": "733350801",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Not bad, Sorush! You really made the area regain its vitality real quick, huh?",
            "nextDialogs": [
              "733350802"
            ]
          },
          "733350802": {
            "id": "733350802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pari powers are quite fascinating, yes.",
            "nextDialogs": [
              "733350803"
            ]
          },
          "733350803": {
            "id": "733350803",
            "speakerId": 1001,
            "speakerName": "Sorush",
            "text": "Of course, many Pari know how to bring Sunyata Flowers to life by heart.",
            "nextDialogs": [
              "733350804"
            ]
          },
          "733350804": {
            "id": "733350804",
            "speakerId": 1001,
            "speakerName": "Sorush",
            "text": "Simply put, even though the Sign of Apaosha has disappeared, this Sunyata Flower hasn't recovered from its corrosion and it's still extremely feeble...",
            "nextDialogs": [
              "733350805"
            ]
          },
          "733350805": {
            "id": "733350805",
            "speakerId": 1001,
            "speakerName": "Sorush",
            "text": "The other flower ponds are unlikely to be spared. This must be very upsetting for Sefana.",
            "nextDialogs": [
              "733350806"
            ]
          },
          "733350806": {
            "id": "733350806",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "This Sefana you mentioned must be a nice Pari who works hard to take care of the flowers!",
            "nextDialogs": [
              "733350807"
            ]
          },
          "733350807": {
            "id": "733350807",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Let's go help her, shall we, {NICKNAME}?",
            "nextDialogs": [
              "733350808"
            ]
          },
          "733350808": {
            "id": "733350808",
            "speakerId": 1001,
            "speakerName": "Sorush",
            "text": "For me, it's nothing too difficult, and it'll help out Sefana. My Yasnapati, please keep an eye out for these Sunyata Flowers.",
            "nextDialogs": [
              "733350809"
            ]
          },
          "733350809": {
            "id": "733350809",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll tell you when I see them.",
            "nextDialogs": [
              "733350810"
            ]
          },
          "733350810": {
            "id": "733350810",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yup! Let's save these pretty flowers together!"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7108901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710890101"
        ],
        "dialogs": {
          "710890101": {
            "id": "710890101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wow, that's a really long letter. Seems like Zhiqiong left it here!",
            "nextDialogs": [
              "710890102"
            ]
          },
          "710890102": {
            "id": "710890102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's hers alright...",
            "nextDialogs": [
              "710890103"
            ]
          },
          "710890103": {
            "id": "710890103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh, where's she gone!? Let's go tell Jinwu what happened first."
          }
        }
      }
    },
    {
      "subId": "7108903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710890201"
        ],
        "dialogs": {
          "710890201": {
            "id": "710890201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Jinwu, we found this!",
            "nextDialogs": [
              "710890202"
            ]
          },
          "710890202": {
            "id": "710890202",
            "speakerId": 1001,
            "speakerName": "Jinwu",
            "text": "Alright, alright, relax. What did you find? Does it have anything to do with Zhiqiong's whereabouts?",
            "nextDialogs": [
              "710890203"
            ]
          },
          "710890203": {
            "id": "710890203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's a letter she left behind. She says she's gone deeper into The Chasm.",
            "nextDialogs": [
              "710890204"
            ]
          },
          "710890204": {
            "id": "710890204",
            "speakerId": 1001,
            "speakerName": "Jinwu",
            "text": "Thank you. Let me see what she's written real quick.",
            "nextDialogs": [
              "710890205"
            ]
          },
          "710890205": {
            "id": "710890205",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Jinwu reads the letter carefully.",
            "nextDialogs": [
              "710890206"
            ]
          },
          "710890206": {
            "id": "710890206",
            "speakerId": 1001,
            "speakerName": "Jinwu",
            "text": "This girl... I've never really considered issues this big, so I can't really criticize her life choices. But perhaps...",
            "nextDialogs": [
              "710890207"
            ]
          },
          "710890207": {
            "id": "710890207",
            "speakerId": 1001,
            "speakerName": "Jinwu",
            "text": "Perhaps I didn't acknowledge her discoveries in time, or give her as much respect or understanding as I should've.",
            "nextDialogs": [
              "710890208"
            ]
          },
          "710890208": {
            "id": "710890208",
            "speakerId": 1001,
            "speakerName": "Jinwu",
            "text": "It would've been immeasurably more difficult to complete our exploration without her maps... But I only showed concern for her health instead of focusing on her hard work and what she'd done so much to achieve...",
            "nextDialogs": [
              "710890209"
            ]
          },
          "710890209": {
            "id": "710890209",
            "speakerId": 1001,
            "speakerName": "Jinwu",
            "text": "Agh, how did I not realize how her work was always different from that of us miners...",
            "nextDialogs": [
              "710890210"
            ]
          },
          "710890210": {
            "id": "710890210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She just doesn't want to be forgotten.",
            "nextDialogs": [
              "710890211"
            ]
          },
          "710890211": {
            "id": "710890211",
            "speakerId": 1001,
            "speakerName": "Jinwu",
            "text": "Well, don't we all, as people who aren't favored by the gods...",
            "nextDialogs": [
              "710890212"
            ]
          },
          "710890212": {
            "id": "710890212",
            "speakerId": 1001,
            "speakerName": "Jinwu",
            "text": "Don't we all... But has anyone been as obsessed as her?",
            "nextDialogs": [
              "710890213"
            ]
          },
          "710890213": {
            "id": "710890213",
            "speakerId": 1001,
            "speakerName": "Jinwu",
            "text": "And yet, when I think about the moment when I gave up any thoughts of becoming great... when I realize that I've gotten to used to living day to ordinary day...",
            "nextDialogs": [
              "710890214"
            ]
          },
          "710890214": {
            "id": "710890214",
            "speakerId": 1001,
            "speakerName": "Jinwu",
            "text": "I feel like I just don't have the right to judge Zhiqiong..."
          }
        }
      }
    }
  ]
}
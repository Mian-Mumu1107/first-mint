    {
      "subId": "4014503",
      "subQuestName": "Talk to Freda",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401450201"
        ],
        "dialogs": {
          "401450201": {
            "id": "401450201",
            "speakerId": 30519,
            "speakerName": "Freda",
            "text": "#{NICKNAME}! Paimon! Hello! Is there something I can help you with?",
            "nextDialogs": [
              "401450202"
            ]
          },
          "401450202": {
            "id": "401450202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, we've been a bit swamped lately, so Lisa recommended we find some ways to increase our efficiency...",
            "nextDialogs": [
              "401450203"
            ]
          },
          "401450203": {
            "id": "401450203",
            "speakerId": 30519,
            "speakerName": "Freda",
            "text": "Ah, yes! I discussed that with her as well.",
            "nextDialogs": [
              "401450204"
            ]
          },
          "401450204": {
            "id": "401450204",
            "speakerId": 30519,
            "speakerName": "Freda",
            "text": "Currently, there are three areas you can improve — brewing, cultivation, and sales.",
            "nextDialogs": [
              "401450205"
            ]
          },
          "401450205": {
            "id": "401450205",
            "speakerId": 30519,
            "speakerName": "Freda",
            "text": "Increasing your efficiency in these areas will make it much easier to run your business.",
            "nextDialogs": [
              "401450206"
            ]
          },
          "401450206": {
            "id": "401450206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Wow, that sounds just like what we need! Let's give it a try, {NICKNAME}!",
            "nextDialogs": [
              "401450208",
              "401450210",
              "401450212"
            ]
          },
          "401450208": {
            "id": "401450208",
            "speakerId": 30519,
            "speakerName": "Freda",
            "text": "Looks like all the preparations needed for this upgrade have been made! Please try it out."
          },
          "401450210": {
            "id": "401450210",
            "speakerId": 30519,
            "speakerName": "Freda",
            "text": "You're in luck! I just got a new batch of provisions! Please take a look and see if anything catches your eye!"
          },
          "401450212": {
            "id": "401450212",
            "speakerId": 30519,
            "speakerName": "Freda",
            "text": "Best of luck with your business!"
          }
        }
      }
    }
  ]

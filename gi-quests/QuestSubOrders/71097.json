  "subQuests": [
    {
      "subId": "7109701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710970101"
        ],
        "dialogs": {
          "710970101": {
            "id": "710970101",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Have you found the Archaic Stones?",
            "nextDialogs": [
              "710970102"
            ]
          },
          "710970102": {
            "id": "710970102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here they are."
          }
        }
      }
    },
    {
      "subId": "7109702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710970201"
        ],
        "dialogs": {
          "710970201": {
            "id": "710970201",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "With these three included, it's nine in total. They should be enough.",
            "nextDialogs": [
              "710970202"
            ]
          },
          "710970202": {
            "id": "710970202",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "You managed to gather what Huishan Hall needs so quickly. No wonder they speak so highly of you!",
            "nextDialogs": [
              "710970203"
            ]
          },
          "710970203": {
            "id": "710970203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh, it was easy! Easy-peasy, lemon-breezy!",
            "nextDialogs": [
              "710970204"
            ]
          },
          "710970204": {
            "id": "710970204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm sure it's \"lemon-squeezy,\" Paimon...",
            "nextDialogs": [
              "710970205"
            ]
          },
          "710970205": {
            "id": "710970205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? Uh, well, lemons can be breezy too!",
            "nextDialogs": [
              "710970206"
            ]
          },
          "710970206": {
            "id": "710970206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oh, look at you, forcing your logic through. Most impressive.",
            "nextDialogs": [
              "710970207"
            ]
          },
          "710970207": {
            "id": "710970207",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Haha... We've all witnessed your heroic deeds of fighting the sea monster. I believe it was no challenge for you to accomplish such a feat.",
            "nextDialogs": [
              "710970210"
            ]
          },
          "710970210": {
            "id": "710970210",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Well, so much for working at the Ministry of Civil Affairs. They still ask you to do stuff like \"look for Archaic Stone in The Chasm\"...",
            "nextDialogs": [
              "710970211"
            ]
          },
          "710970211": {
            "id": "710970211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Speaking of which, you said you often argued with your father back then and didn't have a job.",
            "nextDialogs": [
              "710970212"
            ]
          },
          "710970212": {
            "id": "710970212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Then how did you make it into the Ministry later?",
            "nextDialogs": [
              "710970213"
            ]
          },
          "710970213": {
            "id": "710970213",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "You know how I owed a big sum at the time? I could turn to no one, nor was I willing to go home.",
            "nextDialogs": [
              "710970214"
            ]
          },
          "710970214": {
            "id": "710970214",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "In the end, the debt collectors came looking for my old man at the Shenglu Hall... I thought he'd come find me to break my legs upon hearing the news.",
            "nextDialogs": [
              "710970215"
            ]
          },
          "710970215": {
            "id": "710970215",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But your legs look fine.",
            "nextDialogs": [
              "710970216"
            ]
          },
          "710970216": {
            "id": "710970216",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Yes... It's embarrassing to say, but he cleared my debt and came looking for me. By the time he found me, I was almost like a beaten-up dog on the street. He said, \"I have all your IOUs, so now you're indebted to me.\"",
            "nextDialogs": [
              "710970217"
            ]
          },
          "710970217": {
            "id": "710970217",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "With that, he forced me to work — to pay my debt.",
            "nextDialogs": [
              "710970218"
            ]
          },
          "710970218": {
            "id": "710970218",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So your father is your creditor now.",
            "nextDialogs": [
              "710970219"
            ]
          },
          "710970219": {
            "id": "710970219",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "You can say that...",
            "nextDialogs": [
              "710970220"
            ]
          },
          "710970220": {
            "id": "710970220",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Back then, with the debt collectors after me, I couldn't even fall asleep at night. So, I swore that I'd mend my ways if I was given a second chance.",
            "nextDialogs": [
              "710970221"
            ]
          },
          "710970221": {
            "id": "710970221",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "But I didn't expect the chance to come from my father, who always disapproved of my behaviors...",
            "nextDialogs": [
              "710970222"
            ]
          },
          "710970222": {
            "id": "710970222",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "He didn't lash out at me as usual. Instead, we had a talk — an honest and sincere one. How I wish we could've talked this way earlier.",
            "nextDialogs": [
              "710970223"
            ]
          },
          "710970223": {
            "id": "710970223",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "But even if he'd been open for a talk, I wouldn't have been willing to listen.",
            "nextDialogs": [
              "710970224"
            ]
          },
          "710970224": {
            "id": "710970224",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like your father treats you well.",
            "nextDialogs": [
              "710970225"
            ]
          },
          "710970225": {
            "id": "710970225",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Yeah.",
            "nextDialogs": [
              "710970226"
            ]
          },
          "710970226": {
            "id": "710970226",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "So I have to get my job done well under whatever circumstances.",
            "nextDialogs": [
              "710970227"
            ]
          },
          "710970227": {
            "id": "710970227",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Whether it's the incident in The Chasm or the search for Archaic Stone requested by Huishan Hall.",
            "nextDialogs": [
              "710970228"
            ]
          },
          "710970228": {
            "id": "710970228",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I believe I'm the one who did the job for you this time...",
            "nextDialogs": [
              "710970229"
            ]
          },
          "710970229": {
            "id": "710970229",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Having people get the job done also counts.",
            "nextDialogs": [
              "710970230"
            ]
          },
          "710970230": {
            "id": "710970230",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "But still, it's all thanks to you that we moved swimmingly — I'd say it was way more quickly than I expected.",
            "nextDialogs": [
              "710970231"
            ]
          },
          "710970231": {
            "id": "710970231",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, Paimon finally senses a touch of gratitude there."
          }
        }
      }
    }
  ]
}
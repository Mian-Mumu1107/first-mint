  "subQuests": [
    {
      "subId": "2000501",
      "subQuestName": "Talk to Wyatt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200050101"
        ],
        "dialogs": {
          "200050101": {
            "id": "200050101",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Traveler! You couldn't have picked a better time.",
            "nextDialogs": [
              "200050102"
            ]
          },
          "200050102": {
            "id": "200050102",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Last night, I was on my way to the city to deliver these goods, when suddenly, some shining orbs caught my eye.",
            "nextDialogs": [
              "200050103"
            ]
          },
          "200050103": {
            "id": "200050103",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "I—I'd had too much to drink, and... I just felt drawn to them, you know? I went to check it out and it turned out to be a huge group of slimes. They even bumped into me really hard!",
            "nextDialogs": [
              "200050104"
            ]
          },
          "200050104": {
            "id": "200050104",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "I panicked and ran, but lost my way. It took me forever to find my cart again. Then, this morning, I found out my <color=#00E1FFFF>key</color> was gone...",
            "nextDialogs": [
              "200050105"
            ]
          },
          "200050105": {
            "id": "200050105",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Could you help me look for it? It's got to be around here somewhere... I feel like it's right under my nose.",
            "nextDialogs": [
              "200050107",
              "200050109"
            ]
          },
          "200050107": {
            "id": "200050107",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Great! It's such a huge area, I just wouldn't know where to start looking."
          },
          "200050109": {
            "id": "200050109",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "This is such a huge area. I just don't know where to start looking. Please, you're the only one that can help me!"
          }
        }
      }
    },
    {
      "subId": "2000502",
      "subQuestName": "Use Elemental Sight to find the key",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200050201"
        ],
        "dialogs": {
          "200050201": {
            "id": "200050201",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Have you found my key?",
            "nextDialogs": [
              "200050202"
            ]
          },
          "200050202": {
            "id": "200050202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm afraid not.",
            "nextDialogs": [
              "200050203"
            ]
          },
          "200050203": {
            "id": "200050203",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Well, it is quite a big search area... Good luck!"
          }
        }
      }
    },
    {
      "subId": "2000504",
      "subQuestName": "Give the key to Wyatt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200050401"
        ],
        "dialogs": {
          "200050401": {
            "id": "200050401",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Found the key yet?",
            "nextDialogs": [
              "200050402"
            ]
          },
          "200050402": {
            "id": "200050402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I found this key — is it yours?",
            "nextDialogs": [
              "200050403"
            ]
          },
          "200050403": {
            "id": "200050403",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Yes! That's the one. I can't afford to let that happen again... I really must rein in my drinking.",
            "nextDialogs": [
              "200050404"
            ]
          },
          "200050404": {
            "id": "200050404",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Oh — and take these. Thanks for your help."
          }
        }
      }
    }
  ]
}
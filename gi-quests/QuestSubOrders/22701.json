  "subQuests": [
    {
      "subId": "2270106",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "227010201"
        ],
        "dialogs": {
          "227010201": {
            "id": "227010201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do you want?",
            "nextDialogs": [
              "227010202"
            ]
          },
          "227010202": {
            "id": "227010202",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "Hey! Show him a little more respect when you're talking to him, got it!?",
            "nextDialogs": [
              "227010203"
            ]
          },
          "227010203": {
            "id": "227010203",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "Please, there's no need... it was actually me who started the conversation with them...",
            "nextDialogs": [
              "227010204"
            ]
          },
          "227010204": {
            "id": "227010204",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "Hmph! Well, just as long as they aren't another good-for-nothing bandwagoning adepti-seeker trying to steal our place!",
            "nextDialogs": [
              "227010205"
            ]
          },
          "227010205": {
            "id": "227010205",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "Yes, great, thank you for your concern... I think we'll be fine... Now, why don't you take a well-earned rest while I have a word with our new friend?",
            "nextDialogs": [
              "227010206"
            ]
          },
          "227010206": {
            "id": "227010206",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "But, but surely there's nothing you would say to them that you couldn't say in front of me?",
            "nextDialogs": [
              "227010207"
            ]
          },
          "227010207": {
            "id": "227010207",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "I'd only bore you, it's really nothing you'd be interested in...",
            "nextDialogs": [
              "227010208"
            ]
          },
          "227010208": {
            "id": "227010208",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "Hmph, okay, I get the hint, you wanna talk about the Guhua Clan, again... Fine. If you don't want me to listen, I will leave you well alone.",
            "nextDialogs": [
              "227010209"
            ]
          },
          "227010209": {
            "id": "227010209",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "My friend, over here if you will join me. Then we may talk in depth."
          }
        }
      }
    },

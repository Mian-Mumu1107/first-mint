    {
      "subId": "2270109",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "227010901"
        ],
        "dialogs": {
          "227010901": {
            "id": "227010901",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "Que'er and I have trained together in the martial arts since childhood. She is like a sister to me.",
            "nextDialogs": [
              "227010902"
            ]
          },
          "227010902": {
            "id": "227010902",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "And yet somehow, the older she becomes, the more she perplexes me.",
            "nextDialogs": [
              "227010903"
            ]
          },
          "227010903": {
            "id": "227010903",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "Things were much simpler when we were children..."
          }
        }
      }
    },
    {
      "subId": "2270110",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "227011001"
        ],
        "dialogs": {
          "227011001": {
            "id": "227011001",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "You two have finished speaking, then? Don't look at me like that. If he doesn't want me to listen, I don't listen.",
            "nextDialogs": [
              "227011002"
            ]
          },
          "227011002": {
            "id": "227011002",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "In any case, I'm sure he was harping on about Guhua again. Ugh, in all the time that I've known him, he's never cared for anything else but Guhua...",
            "nextDialogs": [
              "227011003"
            ]
          },
          "227011003": {
            "id": "227011003",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "And that's despite everything I do to try and...",
            "nextDialogs": [
              "227011004"
            ]
          },
          "227011004": {
            "id": "227011004",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "Never mind, what difference is telling you going to make? What're you still doing here anyway? Aren't you supposed to be helping him with something? Go on, on your way!"
          }
        }
      }
    },
    {
      "subId": "2270105",
      "subQuestName": "Give the Qingxin flowers to Sun Yu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "227010601"
        ],
        "dialogs": {
          "227010601": {
            "id": "227010601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, they're for his headache.",
            "nextDialogs": [
              "227010602"
            ]
          },
          "227010602": {
            "id": "227010602",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "But I would happily have gone to pick medicine for you... Why did you need to get a passer-by to do it instead?",
            "nextDialogs": [
              "227010603"
            ]
          },
          "227010603": {
            "id": "227010603",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "Also, we know nothing about them or their background, what if—",
            "nextDialogs": [
              "227010604"
            ]
          },
          "227010604": {
            "id": "227010604",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "...Enough, Que'er. They helped us, did they not? We have no quarrel with them.",
            "nextDialogs": [
              "227010605"
            ]
          },
          "227010605": {
            "id": "227010605",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "Thank you once more. Please take these.",
            "nextDialogs": [
              "227010606"
            ]
          },
          "227010606": {
            "id": "227010606",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "Yep, take 'em and be on your merry way, don't keep him out in the cold when he's got a headache!",
            "nextDialogs": [
              "227010607"
            ]
          },
          "227010607": {
            "id": "227010607",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "Quickly, let's get you out of the wind! I'll make some sweet tea for you..."
          }
        }
      }
    },
    {
      "subId": "2270101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "227010101"
        ],
        "dialogs": {
          "227010101": {
            "id": "227010101",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "Halt, friend.",
            "nextDialogs": [
              "227010102"
            ]
          },
          "227010102": {
            "id": "227010102",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "I can tell from the confidence in your posture and the flight in your footsteps that we three are kindred spirits, practitioners of the martial arts..."
          }
        }
      }
    },

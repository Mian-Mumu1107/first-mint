    {
      "subId": "2270103",
      "subQuestName": "Talk to Sun Yu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "227010401"
        ],
        "dialogs": {
          "227010401": {
            "id": "227010401",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "Right, here will do nicely...",
            "nextDialogs": [
              "227010402"
            ]
          },
          "227010402": {
            "id": "227010402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's this all about?",
            "nextDialogs": [
              "227010403"
            ]
          },
          "227010403": {
            "id": "227010403",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "*sigh* It's about her... Little Que'er, my junior. We've always been inseparable in our martial arts training, like form and shadow. Her skills are in no way inferior to mine.",
            "nextDialogs": [
              "227010404"
            ]
          },
          "227010404": {
            "id": "227010404",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "We came here seeking the guidance of the adepti, but the journey has been an arduous one, and my companion like a box full of chatter that knows no end... A few days prior she fell ill from the cold, and is now afflicted with soreness of the throat.",
            "nextDialogs": [
              "227010405"
            ]
          },
          "227010405": {
            "id": "227010405",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "I see you are one of great strength, and so I humbly beseech you to please venture forth to the top of this cliff, where you should please find me three Qingxin flowers, with which to infuse in hot water and bring some small relief to Que'er's aching throat.",
            "nextDialogs": [
              "227010407",
              "227010409"
            ]
          },
          "227010407": {
            "id": "227010407",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "Friend, you have my thanks. Que'er is a vivacious soul, and I daren't leave her alone while I go in search of medicine."
          },
          "227010409": {
            "id": "227010409",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "I know you might find this silly. Que'er has a feisty spirit and refuses to accept that she might be at a disadvantage compared to those around her, whatever the circumstances.",
            "nextDialogs": [
              "227010410"
            ]
          },
          "227010410": {
            "id": "227010410",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "Were I to raise the notion of picking medicine for her benefit while she was in earshot, she would reject the proposal without a second thought. Hence, I must act without her knowledge.",
            "nextDialogs": [
              "227010411"
            ]
          },
          "227010411": {
            "id": "227010411",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "Furthermore, I daren't leave her alone here while I go off in search of medicine. That is why I must ask for your assistance."
          }
        }
      }
    },
    {
      "subId": "2270107",
      "subQuestName": "Go and pick 3 Qingxin flowers from atop the cliff",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "227010701"
        ],
        "dialogs": {
          "227010701": {
            "id": "227010701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Actually, they're for your throat.",
            "nextDialogs": [
              "227010702"
            ]
          },
          "227010702": {
            "id": "227010702",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "Ahem! My good friend, I daresay—",
            "nextDialogs": [
              "227010703"
            ]
          },
          "227010703": {
            "id": "227010703",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "...Are you saying I'm weak? Oh, so you feel the tiniest gust of wind and just assume I have a sore throat!?",
            "nextDialogs": [
              "227010704"
            ]
          },
          "227010704": {
            "id": "227010704",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "Well, luckily the Qingxin flowers won't go to waste — because they can help with his headache.",
            "nextDialogs": [
              "227010705"
            ]
          },
          "227010705": {
            "id": "227010705",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "Que'er, listen...",
            "nextDialogs": [
              "227010706"
            ]
          },
          "227010706": {
            "id": "227010706",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "Come on, let's get you out of the wind and somewhere you can put your feet up! I'll make some sweet tea for you.",
            "nextDialogs": [
              "227010707"
            ]
          },
          "227010707": {
            "id": "227010707",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "As for you... Take these, and get lost."
          }
        }
      }
    },

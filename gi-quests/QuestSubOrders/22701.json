    {
      "subId": "2270105",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "227010501"
        ],
        "dialogs": {
          "227010501": {
            "id": "227010501",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "You have returned! Regarding the matter which I entrusted to your care...",
            "nextDialogs": [
              "227010502"
            ]
          },
          "227010502": {
            "id": "227010502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I've picked the flowers.",
            "nextDialogs": [
              "227010503"
            ]
          },
          "227010503": {
            "id": "227010503",
            "speakerId": 1001,
            "speakerName": "Sun Yu",
            "text": "These shall be plenty. Friend, you have my thanks, please accept this small gift in return...",
            "nextDialogs": [
              "227010504"
            ]
          },
          "227010504": {
            "id": "227010504",
            "speakerId": 1000,
            "speakerName": "Little Que'er",
            "text": "Huh? What're all these Qingxin flowers for? Oh no, have you got a headache again?"
          }
        }
      }

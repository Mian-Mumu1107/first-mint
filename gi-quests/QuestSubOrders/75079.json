  "subQuests": [
    {
      "subId": "7507903",
      "subQuestName": "Talk to Temach",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750790301"
        ],
        "dialogs": {
          "750790301": {
            "id": "750790301",
            "speakerId": 6274,
            "speakerName": "Temach",
            "text": "#Welcome... Hmm, it looks like one of you has already mastered the skill of flying. So, is this the {M#young man}{F#young lady} who wants to learn how to fly?",
            "nextDialogs": [
              "750790303"
            ]
          },
          "750790303": {
            "id": "750790303",
            "speakerId": 6274,
            "speakerName": "Temach",
            "text": "Gliding license? First time I've heard of that.",
            "nextDialogs": [
              "750790305"
            ]
          },
          "750790305": {
            "id": "750790305",
            "speakerId": 6274,
            "speakerName": "Temach",
            "text": "Here, we aim to have Saurian and rider stride toward improvement together. Your partner...",
            "nextDialogs": [
              "750790306"
            ]
          },
          "750790306": {
            "id": "750790306",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrah, rawr!",
            "nextDialogs": [
              "750790307"
            ]
          },
          "750790307": {
            "id": "750790307",
            "speakerId": 6274,
            "speakerName": "Temach",
            "text": "...Hmm, sorry, little guy, but I doubt Pakpaka Flying School is the place for you to show off your skills. Not your fault, though, so don't take it personally.",
            "nextDialogs": [
              "750790308"
            ]
          },
          "750790308": {
            "id": "750790308",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr?",
            "nextDialogs": [
              "750790309"
            ]
          },
          "750790309": {
            "id": "750790309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]} is still young, and still has lots of potential to unlock.",
            "nextDialogs": [
              "750790310"
            ]
          },
          "750790310": {
            "id": "750790310",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's no way a Tepetlisaurus's potential for flight can match that of a Qucusaurus or Iktomisaurus!",
            "nextDialogs": [
              "750790311"
            ]
          },
          "750790311": {
            "id": "750790311",
            "speakerId": 6274,
            "speakerName": "Temach",
            "text": "#Either way, {M#young man}{F#young lady}, if you're interested in our flying training, I recommend that you try our training course!",
            "nextDialogs": [
              "750790313"
            ]
          },
          "750790313": {
            "id": "750790313",
            "speakerId": 6274,
            "speakerName": "Temach",
            "text": "You'll need to be able to dodge obstacles and turn with agility to ride a Qucusaurus. You'll know just how good you are after trying the training course!",
            "nextDialogs": [
              "750790312"
            ]
          },
          "750790312": {
            "id": "750790312",
            "speakerId": 6274,
            "speakerName": "Temach",
            "text": "To be honest, we've worked really hard to promote it. We've got the prizes prepared, races organized, the works. If you pass, go to Lamizana to claim your prize."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2401301",
      "subQuestName": "Talk to Iaune",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240130101"
        ],
        "dialogs": {
          "240130101": {
            "id": "240130101",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "*sigh* I don't know why this happened...",
            "nextDialogs": [
              "240130104"
            ]
          },
          "240130104": {
            "id": "240130104",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Oh, Traveler, nice to meet you. Are you here for some coffee? I'll treat you to a cup.",
            "nextDialogs": [
              "240130105"
            ]
          },
          "240130105": {
            "id": "240130105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's wrong? You look terrible. Has someone been forcing you to stay up late again?",
            "nextDialogs": [
              "240130106"
            ]
          },
          "240130106": {
            "id": "240130106",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Thanks for your concern. However, this is my own issue this time.",
            "nextDialogs": [
              "240130107"
            ]
          },
          "240130107": {
            "id": "240130107",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "I've been thinking... About the meaning of my work.",
            "nextDialogs": [
              "240130108"
            ]
          },
          "240130108": {
            "id": "240130108",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "I've always believed the Maison Gestion to be a just, efficient, strong organization in which everyone is willing to help each other.",
            "nextDialogs": [
              "240130109"
            ]
          },
          "240130109": {
            "id": "240130109",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "I believe that under its management, the Court of Fontaine would see itself develop positively.",
            "nextDialogs": [
              "240130110"
            ]
          },
          "240130110": {
            "id": "240130110",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "But the way I see it now, it is a ruined mechanical house. Its gears, levers, and apertures are being pulled chaotically... Only its facade remains pristine.",
            "nextDialogs": [
              "240130111"
            ]
          },
          "240130111": {
            "id": "240130111",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "It only operates because of a series of coincidences and lessons, not precise consideration or design.",
            "nextDialogs": [
              "240130112"
            ]
          },
          "240130112": {
            "id": "240130112",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "I... I want to do something about it, but I can't. I fear that one mistake on my part will send this house tumbling down.",
            "nextDialogs": [
              "240130113"
            ]
          },
          "240130113": {
            "id": "240130113",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Roialte always tells me to relax a bit, since my mistakes cannot make things worse than they already are...",
            "nextDialogs": [
              "240130114"
            ]
          },
          "240130114": {
            "id": "240130114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Th—That's an odd way of comforting someone...",
            "nextDialogs": [
              "240130115"
            ]
          },
          "240130115": {
            "id": "240130115",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "*sigh* Sorry, I shouldn't complain. I came out here to get away from all that for a while, after all...",
            "nextDialogs": [
              "240130116"
            ]
          },
          "240130116": {
            "id": "240130116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll make you a cup of coffee.",
            "nextDialogs": [
              "240130117"
            ]
          },
          "240130117": {
            "id": "240130117",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Really? You know how to brew coffee? That's amazing — I've always wanted to learn, but I can never find the time.",
            "nextDialogs": [
              "240130118"
            ]
          },
          "240130118": {
            "id": "240130118",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "I'll leave it to you, then. I'll wait here... and with any luck, work won't catch up with me at the café."
          }
        }
      }
    },
    {
      "subId": "2401302",
      "subQuestName": "Talk to Arouet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240130201"
        ],
        "dialogs": {
          "240130201": {
            "id": "240130201",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "Traveler, have you come to help us out? You're most welcome!",
            "nextDialogs": [
              "240130202"
            ]
          },
          "240130202": {
            "id": "240130202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No, no, we're just here to help a friend make some coffee. He's just... Well...",
            "nextDialogs": [
              "240130205"
            ]
          },
          "240130205": {
            "id": "240130205",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "By \"a friend,\" do you mean Iaune — you know, the fellow sitting over there?",
            "nextDialogs": [
              "240130206"
            ]
          },
          "240130206": {
            "id": "240130206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You know him?",
            "nextDialogs": [
              "240130207"
            ]
          },
          "240130207": {
            "id": "240130207",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "Roialte and I are old friends. He mentioned that a bright, hardworking fellow came to their office recently, and that's Iaune.",
            "nextDialogs": [
              "240130208"
            ]
          },
          "240130208": {
            "id": "240130208",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "Don't you worry too much about him — young people who've just started at the Maison Gestion will always find themselves a little dejected at first.",
            "nextDialogs": [
              "240130209"
            ]
          },
          "240130209": {
            "id": "240130209",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "They'll be fine once they find a place for themselves there.",
            "nextDialogs": [
              "240130210"
            ]
          },
          "240130210": {
            "id": "240130210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You sound very experienced. Why's that?",
            "nextDialogs": [
              "240130211"
            ]
          },
          "240130211": {
            "id": "240130211",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "Well, I was once a radish planted in the field that is the Maison Gestion, too.",
            "nextDialogs": [
              "240130212"
            ]
          },
          "240130212": {
            "id": "240130212",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "But I wasn't satisfied with being a mere radish, and so I left my lot and... opened this café some time later."
          }
        }
      }
    },
    {
      "subId": "2401305",
      "subQuestName": "Talk to Arouet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240135101"
        ],
        "dialogs": {
          "240135101": {
            "id": "240135101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm ready.",
            "nextDialogs": [
              "240135102"
            ]
          },
          "240135102": {
            "id": "240135102",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "I've prepared all the needed ingredients. They're over there, so you can start brewing any time."
          }
        }
      }
    },
    {
      "subId": "2401303",
      "subQuestName": "Brew coffee for Iaune",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240130301"
        ],
        "dialogs": {
          "240130301": {
            "id": "240130301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What should we put into the coffee this time?"
          }
        }
      }
    },
    {
      "subId": "2401306",
      "subQuestName": "Brew coffee for Iaune",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240133101"
        ],
        "dialogs": {
          "240133101": {
            "id": "240133101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That sounds great! Time to start blending, then!",
            "nextDialogs": [
              "240133102"
            ]
          },
          "240133102": {
            "id": "240133102",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You start brewing coffee...",
            "nextDialogs": [
              "240133103"
            ]
          },
          "240133103": {
            "id": "240133103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, that smells good! Now let's hand it to Iaune. Paimon sure hopes it cheers him up!"
          }
        }
      }
    },
    {
      "subId": "2401304",
      "subQuestName": "Give Iaune the coffee",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240130401"
        ],
        "dialogs": {
          "240130401": {
            "id": "240130401",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Traveler... You really made me that cup of coffee? Um, I... Sorry for troubling you...",
            "nextDialogs": [
              "240130404"
            ]
          },
          "240130404": {
            "id": "240130404",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "This coffee... It's way better than the stuff provided at the Maison Gestion! In fact, it's in a whole different dimension...",
            "nextDialogs": [
              "240130405"
            ]
          },
          "240130405": {
            "id": "240130405",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "If this was the coffee I drank every day, I wouldn't spend so much time teetering on the brink of sleep.",
            "nextDialogs": [
              "240130406"
            ]
          },
          "240130406": {
            "id": "240130406",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "Thanks for the coffee. I'll head back to work once I finish it."
          }
        }
      }
    },
    {
      "subId": "2401350",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240135001"
        ],
        "dialogs": {
          "240135001": {
            "id": "240135001",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "Well? Ready to make Iaune his cup of coffee?"
          }
        }
      }
    },
    {
      "subId": "2401352",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240135201"
        ],
        "dialogs": {
          "240135201": {
            "id": "240135201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I've got other matters to attend to at the moment...",
            "nextDialogs": [
              "240135202"
            ]
          },
          "240135202": {
            "id": "240135202",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "Make your preparations, then come find me."
          }
        }
      }
    },
    {
      "subId": "2401380",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240138001"
        ],
        "dialogs": {
          "240138001": {
            "id": "240138001",
            "speakerId": 5084,
            "speakerName": "Iaune",
            "text": "A mechanical house... Will I eventually become a broken gear within it someday?"
          }
        }
      }
    },
    {
      "subId": "2401399",

        ],
        "dialogs": {
          "726760901": {
            "id": "726760901",
            "speakerId": 1007,
            "speakerName": "Licai",
            "text": "Welcome to Liuli Pavilion! Do you have a reservation?",
            "nextDialogs": [
              "726760902"
            ]
          },
          "726760902": {
            "id": "726760902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Geri booked us a table.",
            "nextDialogs": [
              "726760903"
            ]
          },
          "726760903": {
            "id": "726760903",
            "speakerId": 1007,
            "speakerName": "Licai",
            "text": "Mr. Geri... Please wait a moment, let me check...",
            "nextDialogs": [
              "726760904"
            ]
          },
          "726760904": {
            "id": "726760904",
            "speakerId": 1007,
            "speakerName": "Licai",
            "text": "Indeed, you do have a reservation for today. Well then, this way, please."
          }
        }
      }
    },
    {
      "subId": "7267613",
      "subQuestName": "Have a meal at Liuli Pavilion with Kichiboushi and Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726761301"
        ],
        "dialogs": {
          "726761301": {
            "id": "726761301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Geri did say he'd pre-booked the dishes...",
            "nextDialogs": [
              "726761302"
            ]
          },
          "726761302": {
            "id": "726761302",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But this really is a lot! Were Geri and Freki really going to eat all this by themselves?",
            "nextDialogs": [
              "726761303"
            ]
          },
          "726761303": {
            "id": "726761303",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Ooh... Smells nice.",
            "nextDialogs": [
              "726761304"
            ]
          },
          "726761304": {
            "id": "726761304",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You have a sumptuous feast at Liuli Pavilion with Paimon and Kichiboushi...",
            "nextDialogs": [
              "726761305"
            ]
          },
          "726761305": {
            "id": "726761305",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Phew, that was delicious! How did you find it, Kichiboushi?",
            "nextDialogs": [
              "726761306"
            ]
          },
          "726761306": {
            "id": "726761306",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm! Very tasty!",
            "nextDialogs": [
              "726761308",
              "726761310"
            ]
          },
          "726761308": {
            "id": "726761308",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm-haha! Delicious. Very delicious.",
            "nextDialogs": [
              "726761311"
            ]
          },
          "726761311": {
            "id": "726761311",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Humans are very powerful! They can make such tasty food, better than bake-danuki food!",
            "nextDialogs": [
              "726761312"
            ]
          },
          "726761312": {
            "id": "726761312",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Come to think of it, what is bake-danuki food made from?",
            "nextDialogs": [
              "726761313"
            ]
          },
          "726761313": {
            "id": "726761313",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It tastes as good as it looks, and it does look good... But there's a kind of... emptiness to it?",
            "nextDialogs": [
              "726761314"
            ]
          },
          "726761314": {
            "id": "726761314",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm quite curious myself.",
            "nextDialogs": [
              "726761315"
            ]
          },
          "726761315": {
            "id": "726761315",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Bake-danuki is made from leaves, Kapow!",
            "nextDialogs": [
              "726761316"
            ]
          },
          "726761316": {
            "id": "726761316",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Leaves Kapow... You mean vegetables?",
            "nextDialogs": [
              "726761317"
            ]
          },
          "726761317": {
            "id": "726761317",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Leaves Kapow is Leaves Kapow. Leaves, Kapow. Very tasty."
          },
          "726761310": {
            "id": "726761310",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Is that supposed to be a compliment?"
          }
        }
      }
    },

    {
      "subId": "7267603",
      "subQuestName": "Sit down for a fine meal with Kichiboushi and Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726760301"
        ],
        "dialogs": {
          "726760301": {
            "id": "726760301",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Never seen this before. But smells good. *rumble*",
            "nextDialogs": [
              "726760302"
            ]
          },
          "726760302": {
            "id": "726760302",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#And there's our Delicious Sweet Madame! You could even call it {NICKNAME}'s signature dish!",
            "nextDialogs": [
              "726760304",
              "726760306"
            ]
          },
          "726760304": {
            "id": "726760304",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Right! No lack of supplies out in the wild, after all.",
            "nextDialogs": [
              "726760308"
            ]
          },
          "726760308": {
            "id": "726760308",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You enjoy the Delicious Sweet Madame together.\\nKichiboushi had some reservations at first, but ultimately fell to the delectable temptations of the dish and proceeded to tuck in.",
            "nextDialogs": [
              "726760309"
            ]
          },
          "726760309": {
            "id": "726760309",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "...Oooh...",
            "nextDialogs": [
              "726760310"
            ]
          },
          "726760310": {
            "id": "726760310",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Kichiboushi? What's wrong?"
          },
          "726760306": {
            "id": "726760306",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And speaking of Kaeya...",
            "nextDialogs": [
              "726760307"
            ]
          },
          "726760307": {
            "id": "726760307",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#\"Paimon sees you already have the knightly virtue of modesty,\" {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "7267604",
      "subQuestName": "Go to the Anemo Archon statue in front of the Cathedral",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726760401"
        ],
        "dialogs": {
          "726760401": {
            "id": "726760401",
            "speakerId": 1001,
            "speakerName": "Sara",
            "text": "Sweet Madame... This dish seems simple enough, but it's quite the test of a chef's skills."
          }
        }
      }
    },
    {
      "subId": "7267605",
      "subQuestName": "Climb up to the statue's hands",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726760501"
        ],
        "dialogs": {
          "726760501": {
            "id": "726760501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You see? Nothing to be afraid of!",
            "nextDialogs": [
              "726760502"
            ]
          },
          "726760502": {
            "id": "726760502",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm. Anemo Archon very tall, taller than Ioroi. Very hard, too. Tall and hard.",
            "nextDialogs": [
              "726760503"
            ]
          },
          "726760503": {
            "id": "726760503",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon's... just not going to cover the differences between the statue and the real guy.",
            "nextDialogs": [
              "726760504"
            ]
          },
          "726760504": {
            "id": "726760504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Anemo Archon is a nice person.",
            "nextDialogs": [
              "726760507"
            ]
          },
          "726760507": {
            "id": "726760507",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You know, Paimon wonders if Barbara's discovered the thing with the Holy Lyre der Himmel..."
          }
        }
      }
    },
    {
      "subId": "7267606",
      "subQuestName": "Take a picture of Kichiboushi",
      "sceneId": null,

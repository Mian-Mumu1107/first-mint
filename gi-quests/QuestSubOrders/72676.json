    {
      "subId": "7267607",
      "subQuestName": "Talk to Kichiboushi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726760701"
        ],
        "dialogs": {
          "726760701": {
            "id": "726760701",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "See!",
            "nextDialogs": [
              "726760702"
            ]
          },
          "726760702": {
            "id": "726760702",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Come on, don't rush!",
            "nextDialogs": [
              "726760703"
            ]
          },
          "726760703": {
            "id": "726760703",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You show Kichiboushi and Paimon the picture you just took.",
            "nextDialogs": [
              "726760704"
            ]
          },
          "726760704": {
            "id": "726760704",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "So cool. Very big hands.",
            "nextDialogs": [
              "726760705"
            ]
          },
          "726760705": {
            "id": "726760705",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Go back, show Ioroi, Anemo Archon hands bigger than Ioroi's!",
            "nextDialogs": [
              "726760706"
            ]
          },
          "726760706": {
            "id": "726760706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't think any comparison can be made here...",
            "nextDialogs": [
              "726760707"
            ]
          },
          "726760707": {
            "id": "726760707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Ioroi, weak.\"",
            "nextDialogs": [
              "726760708"
            ]
          },
          "726760708": {
            "id": "726760708",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Ioroi, so, so weak, mm-haha!",
            "nextDialogs": [
              "726760709"
            ]
          },
          "726760709": {
            "id": "726760709",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, hey! Stop teaching Kichiboushi bad stuff!",
            "nextDialogs": [
              "726760710"
            ]
          },
          "726760710": {
            "id": "726760710",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "When Ioroi is serious, he can grow very, very big. Bigger than one hundred tatami.",
            "nextDialogs": [
              "726760711"
            ]
          },
          "726760711": {
            "id": "726760711",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Ioroi very powerful. But Kichiboushi will become more powerful!",
            "nextDialogs": [
              "726760712"
            ]
          },
          "726760712": {
            "id": "726760712",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh. Why do you wanna get stronger, Kichiboushi?",
            "nextDialogs": [
              "726760713"
            ]
          },
          "726760713": {
            "id": "726760713",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That's right, you're pretty strong as-is, Kichiboushi. You can create that gliding airbag. You're about half as powerful as Paimon for sure!",
            "nextDialogs": [
              "726760714"
            ]
          },
          "726760714": {
            "id": "726760714",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Kichiboushi must become more powerful and use stronger magic.",
            "nextDialogs": [
              "726760715"
            ]
          },
          "726760715": {
            "id": "726760715",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "With stronger magic, Kichiboushi can make Ioroi not-stone!",
            "nextDialogs": [
              "726760716"
            ]
          },
          "726760716": {
            "id": "726760716",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "#So Kichiboushi must train, with {NICKNAME} and Paimon.",
            "nextDialogs": [
              "726760717"
            ]
          },
          "726760717": {
            "id": "726760717",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So that's how it is...",
            "nextDialogs": [
              "726760718"
            ]
          },
          "726760718": {
            "id": "726760718",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "—Eh! You remembered Paimon's name! Woohoo!",
            "nextDialogs": [
              "726760719"
            ]
          },
          "726760719": {
            "id": "726760719",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Woohoo! Mm-haha!",
            "nextDialogs": [
              "726760720"
            ]
          },
          "726760720": {
            "id": "726760720",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Keep it up, Kichiboushi.",
            "nextDialogs": [
              "726760721"
            ]
          },
          "726760721": {
            "id": "726760721",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Keep it up! Yey!",
            "nextDialogs": [
              "726760722"
            ]
          },
          "726760722": {
            "id": "726760722",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well then, where should we go next?",
            "nextDialogs": [
              "726760723"
            ]
          },
          "726760723": {
            "id": "726760723",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, since we've had some Mondstadt cuisine, time to pay Liyue Harbor a visit!",
            "nextDialogs": [
              "726760724"
            ]
          },
          "726760724": {
            "id": "726760724",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We haven't tried Wanmin Restaurant's food in quite a while, too!",
            "nextDialogs": [
              "726760725"
            ]
          },
          "726760725": {
            "id": "726760725",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We just ate, you know...",
            "nextDialogs": [
              "726760726"
            ]
          },
          "726760726": {
            "id": "726760726",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe! Different lands, different stomachs, don't you know?",
            "nextDialogs": [
              "726760727"
            ]
          },
          "726760727": {
            "id": "726760727",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Eat! Let's go!",
            "nextDialogs": [
              "726760728"
            ]
          },
          "726760728": {
            "id": "726760728",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Let's go! Next stop — Wanmin Restaurant!"
          }
        }
      }
    },
    {
      "subId": "7267608",
      "subQuestName": "Go to Wanmin Restaurant in Liyue Harbor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726760801"
        ],
        "dialogs": {
          "726760801": {
            "id": "726760801",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey here, Chef Mao! We'd like some Black-Back Perch Stew...",
            "nextDialogs": [
              "726760802"
            ]
          },
          "726760802": {
            "id": "726760802",
            "speakerId": 1004,
            "speakerName": "Chef Mao",
            "text": "Eh? Guests, right now? ...I'm very sorry, but we're not taking orders that the moment.",
            "nextDialogs": [
              "726760803"
            ]
          },
          "726760803": {
            "id": "726760803",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eh? What's going on...",
            "nextDialogs": [
              "726760804"
            ]
          },
          "726760804": {
            "id": "726760804",
            "speakerId": 1004,
            "speakerName": "Chef Mao",
            "text": "Earlier, a knight from Mondstadt came with a huge order — a feast for several dozen people, no less. He wanted to bring it to... Um, where was that place again?",
            "nextDialogs": [
              "726760805"
            ]
          },
          "726760805": {
            "id": "726760805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Goth Grand Hotel in Mondstadt?",
            "nextDialogs": [
              "726760806"
            ]
          },
          "726760806": {
            "id": "726760806",
            "speakerId": 1004,
            "speakerName": "Chef Mao",
            "text": "Why, yes, that's exactly it! How did you know?",
            "nextDialogs": [
              "726760807"
            ]
          },
          "726760807": {
            "id": "726760807",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That Kaeya...",
            "nextDialogs": [
              "726760808"
            ]
          },
          "726760808": {
            "id": "726760808",
            "speakerId": 1004,
            "speakerName": "Chef Mao",
            "text": "I'm really sorry. It will be a moment before we can take your order. As you can see, our woks are all busy at the moment. Not that I have any idea how that guy is going to take all those dishes back... I just hope he doesn't waste them.",
            "nextDialogs": [
              "726760809"
            ]
          },
          "726760809": {
            "id": "726760809",
            "speakerId": 1004,
            "speakerName": "Chef Mao",
            "text": "This really was very sudden. In fact, we're running so low on ingredients that Xiangling's having to go out and help gather some Jueyun Chilis.",
            "nextDialogs": [
              "726760810"
            ]
          },
          "726760810": {
            "id": "726760810",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh no...",
            "nextDialogs": [
              "726760811"
            ]
          },
          "726760811": {
            "id": "726760811",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mmmm...",
            "nextDialogs": [
              "726760812"
            ]
          },
          "726760812": {
            "id": "726760812",
            "speakerId": 1004,
            "speakerName": "Chef Mao",
            "text": "Eh? Who's this little fellow?",
            "nextDialogs": [
              "726760814",
              "726760817",
              "726760821"
            ]
          },
          "726760814": {
            "id": "726760814",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "How do you do?",
            "nextDialogs": [
              "726760815"
            ]
          },
          "726760815": {
            "id": "726760815",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yup. This guy here's a bake-danuki who's on a journey to hone his skills!",
            "nextDialogs": [
              "726760823"
            ]
          },
          "726760823": {
            "id": "726760823",
            "speakerId": 1004,
            "speakerName": "Chef Mao",
            "text": "Ah, I see. I'm very sorry, then, Kichiboushi.",
            "nextDialogs": [
              "726760824"
            ]
          },
          "726760824": {
            "id": "726760824",
            "speakerId": 1004,
            "speakerName": "Chef Mao",
            "text": "Speaking of that, my girl Xiangling's got a friend named Guoba who loves eating as well. The two of you might just get along...",
            "nextDialogs": [
              "726760825"
            ]
          },
          "726760825": {
            "id": "726760825",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Well, guess it's up to you again, {NICKNAME}...",
            "nextDialogs": [
              "726760826"
            ]
          },
          "726760826": {
            "id": "726760826",
            "speakerId": 1005,
            "speakerName": "Geri",
            "text": "...Agh! I totally forgot!",
            "nextDialogs": [
              "726760827"
            ]
          },
          "726760827": {
            "id": "726760827",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eh? What's going on over there?",
            "nextDialogs": [
              "726760828"
            ]
          },
          "726760828": {
            "id": "726760828",
            "speakerId": 1006,
            "speakerName": "Freki",
            "text": "Seriously? How did we not check the dates...",
            "nextDialogs": [
              "726760829"
            ]
          },
          "726760829": {
            "id": "726760829",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "726760830"
            ]
          },
          "726760830": {
            "id": "726760830",
            "speakerId": 1005,
            "speakerName": "Geri",
            "text": "So we booked seats at Liuli Pavilion and Xinyue Kiosk a few months back...",
            "nextDialogs": [
              "726760831"
            ]
          },
          "726760831": {
            "id": "726760831",
            "speakerId": 1006,
            "speakerName": "Freki",
            "text": "We were planning to try the pinnacles of Li Cuisine and Yue Cuisine before returning to Mondstadt.",
            "nextDialogs": [
              "726760832"
            ]
          },
          "726760832": {
            "id": "726760832",
            "speakerId": 1005,
            "speakerName": "Geri",
            "text": "But we wound up booking the seats for the same day!",
            "nextDialogs": [
              "726760833"
            ]
          },
          "726760833": {
            "id": "726760833",
            "speakerId": 1006,
            "speakerName": "Freki",
            "text": "Ugh, we should've checked those dates! What are we supposed to do now..."
          },
          "726760817": {
            "id": "726760817",
            "speakerId": 1004,
            "speakerName": "Chef Mao",
            "text": "Baron who?",
            "nextDialogs": [
              "726760818"
            ]
          },
          "726760818": {
            "id": "726760818",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Baron Funky?",
            "nextDialogs": [
              "726760819"
            ]
          },
          "726760819": {
            "id": "726760819",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey! That's not right. This is Kichiboushi, a bake-danuki who's on a journey to hone his skills!"
          },
          "726760821": {
            "id": "726760821",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Nope, this is Kichiboushi! He's a bake-danuki who's on a journey to hone his skills! He's heard that the Guoba made here at Wanmin Restaurant is really good, so he wanted to have a try.",
            "nextDialogs": [
              "726760822"
            ]
          },
          "726760822": {
            "id": "726760822",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Jueyun Guoba!"
          }
        }
      }
    },
    {
      "subId": "7267609",
      "subQuestName": "Go to Liuli Pavilion and talk to Licai",
      "sceneId": null,
      "locations": [],
      "dialogue": {

    {
      "subId": "7267612",
      "subQuestName": "Talk to Kichiboushi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726761201"
        ],
        "dialogs": {
          "726761201": {
            "id": "726761201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Yup, that looks great. You've really got a knack for this, huh, {NICKNAME}?",
            "nextDialogs": [
              "726761202"
            ]
          },
          "726761202": {
            "id": "726761202",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "This place very pretty. Very different from forest.",
            "nextDialogs": [
              "726761203"
            ]
          },
          "726761203": {
            "id": "726761203",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "But all the boats down there, not sinking?",
            "nextDialogs": [
              "726761204"
            ]
          },
          "726761204": {
            "id": "726761204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry, they won't.",
            "nextDialogs": [
              "726761205"
            ]
          },
          "726761205": {
            "id": "726761205",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Amazing!",
            "nextDialogs": [
              "726761206"
            ]
          },
          "726761206": {
            "id": "726761206",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, Kichiboushi, was today's training fun?",
            "nextDialogs": [
              "726761209"
            ]
          },
          "726761209": {
            "id": "726761209",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Ioroi said playing is also training. Not to leave tanuki path.",
            "nextDialogs": [
              "726761210"
            ]
          },
          "726761210": {
            "id": "726761210",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "If play forgotten, will leave tanuki path.",
            "nextDialogs": [
              "726761211"
            ]
          },
          "726761211": {
            "id": "726761211",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Leaving the tanuki path... What's gonna happen if you do that?",
            "nextDialogs": [
              "726761212"
            ]
          },
          "726761212": {
            "id": "726761212",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Tanuki who leave the path... explode.",
            "nextDialogs": [
              "726761213"
            ]
          },
          "726761213": {
            "id": "726761213",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What!?",
            "nextDialogs": [
              "726761214"
            ]
          },
          "726761214": {
            "id": "726761214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Huh?",
            "nextDialogs": [
              "726761215"
            ]
          },
          "726761215": {
            "id": "726761215",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Eight tatami explode, leaf will disappear. Fur will turn into Seagrass and belly-drum turn into big teapot. Then tanuki become skinny like weasels, no more magic.",
            "nextDialogs": [
              "726761216"
            ]
          },
          "726761216": {
            "id": "726761216",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon's pretty sure that Ioroi's fibbing.",
            "nextDialogs": [
              "726761217"
            ]
          },
          "726761217": {
            "id": "726761217",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Training is very fun! Very happy, mm!"
          }
        }
      }
    },

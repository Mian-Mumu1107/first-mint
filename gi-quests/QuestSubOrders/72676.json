  "subQuests": [
    {
      "subId": "7267601",
      "subQuestName": "Go to the Good Hunter restaurant in Mondstadt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726760101"
        ],
        "dialogs": {
          "726760101": {
            "id": "726760101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hi, Sara!",
            "nextDialogs": [
              "726760102"
            ]
          },
          "726760102": {
            "id": "726760102",
            "speakerId": 1001,
            "speakerName": "Sara",
            "text": "#Why, welcome, Paimon and {NICKNAME}! And who's this? Some new Baron Bunny model...?",
            "nextDialogs": [
              "726760103"
            ]
          },
          "726760103": {
            "id": "726760103",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Kichiboushi!",
            "nextDialogs": [
              "726760105",
              "726760107",
              "726760110"
            ]
          },
          "726760105": {
            "id": "726760105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yup, this is a new friend of ours from Inazuma!",
            "nextDialogs": [
              "726760113"
            ]
          },
          "726760113": {
            "id": "726760113",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm, good friends!",
            "nextDialogs": [
              "726760114"
            ]
          },
          "726760114": {
            "id": "726760114",
            "speakerId": 1001,
            "speakerName": "Sara",
            "text": "Ah, I see. Well then, welcome to Good Hunter, Kichiboushi!",
            "nextDialogs": [
              "726760115"
            ]
          },
          "726760115": {
            "id": "726760115",
            "speakerId": 1001,
            "speakerName": "Sara",
            "text": "Inazuma, huh. That's incredible... I heard Cyrus mention that it was surrounded by thunderstorms, and that there's lightning everywhere, like what happens when Ms. Lisa gets angry. That seems quite terrifying, to be honest!"
          },
          "726760107": {
            "id": "726760107",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Baron Funny?",
            "nextDialogs": [
              "726760108"
            ]
          },
          "726760108": {
            "id": "726760108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey! That's not right. This is Kichiboushi, a new friend we met in Inazuma!"
          },
          "726760110": {
            "id": "726760110",
            "speakerId": 1002,
            "speakerName": "\"Kichiboushi\"",
            "text": "Guoba?",
            "nextDialogs": [
              "726760111"
            ]
          },
          "726760111": {
            "id": "726760111",
            "speakerId": 1001,
            "speakerName": "Sara",
            "text": "Guoba? Are you referring to Jueyun Guoba, that dish from Liyue...?",
            "nextDialogs": [
              "726760112"
            ]
          },
          "726760112": {
            "id": "726760112",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey! That's not right. This is Kichiboushi, a new friend we met in Inazuma!"
          }
        }
      }
    },
    {
      "subId": "7267602",

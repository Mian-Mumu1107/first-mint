        "dialogs": {
          "716664001": {
            "id": "716664001",
            "speakerId": 30467,
            "speakerName": "Contestant with Super OP Gear",
            "text": "Hey there! I'm back! So then, how's the Arataki Blazing Armor Beetle Battle Boot Camp coming along...?",
            "nextDialogs": [
              "716664002"
            ]
          },
          "716664002": {
            "id": "716664002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Great timing, Yanfei!",
            "nextDialogs": [
              "716664003"
            ]
          },
          "716664003": {
            "id": "716664003",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "My savior! Thanks for helping out with the permit! And for the sign with the epic artwork!",
            "nextDialogs": [
              "716664004"
            ]
          },
          "716664004": {
            "id": "716664004",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Wait, I know that look... Are you, uh, looking to flip some beetle too?",
            "nextDialogs": [
              "716664005"
            ]
          },
          "716664005": {
            "id": "716664005",
            "speakerId": 30467,
            "speakerName": "Contestant with Super OP Gear",
            "text": "Huh? Something wrong with that?",
            "nextDialogs": [
              "716664006"
            ]
          },
          "716664006": {
            "id": "716664006",
            "speakerId": 30467,
            "speakerName": "Contestant with Super OP Gear",
            "text": "I have a big client who does a lot of cross-border commerce — anyway, she showered me with gifts once after I helped her win a huge lawsuit, and among them was a very special Onikabuto.",
            "nextDialogs": [
              "716664007"
            ]
          },
          "716664007": {
            "id": "716664007",
            "speakerId": 30467,
            "speakerName": "Contestant with Super OP Gear",
            "text": "I didn't know how to look after it at the time, so I got Granny to look after it for a while. It's looking pretty buff these days...",
            "nextDialogs": [
              "716664008"
            ]
          },
          "716664008": {
            "id": "716664008",
            "speakerId": 30467,
            "speakerName": "Contestant with Super OP Gear",
            "text": "Mind if I join in? You're not worried I'll cramp your style, are you...?",
            "nextDialogs": [
              "716664009"
            ]
          },
          "716664009": {
            "id": "716664009",
            "speakerId": 13019,
            "speakerName": "Grandmaster Hanakado",
            "text": "We ought not dismiss your savior, Oni King. What she lacks in experience, she makes up for with one of the sturdiest-built and most awe-inspiring Onikabuto I have ever seen.",
            "nextDialogs": [
              "716664010"
            ]
          },
          "716664010": {
            "id": "716664010",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "You make me an offer I can't refuse...",
            "nextDialogs": [
              "716664011"
            ]
          },
          "716664011": {
            "id": "716664011",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Alright, time to send in the Oni King's Right Hand with Crimson Staff. I know my compadre will stay cool under pressure!",
            "nextDialogs": [
              "716664014"
            ]
          },
          "716664014": {
            "id": "716664014",
            "speakerId": 30467,
            "speakerName": "Contestant with Super OP Gear",
            "text": "#So it's me versus {NICKNAME}? Alright!",
            "nextDialogs": [
              "716664015"
            ]
          },
          "716664015": {
            "id": "716664015",
            "speakerId": 30467,
            "speakerName": "Contestant with Super OP Gear",
            "text": "I haven't quite got the hang of this game yet, so apologies in advance for any blunders."
          }
        }
      }
    },
    {
      "subId": "7152703",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716664101"
        ],
        "dialogs": {
          "716664101": {
            "id": "716664101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yanfei's Onikabuto is so strong! What has Madame Ping been feeding that thing...",
            "nextDialogs": [
              "716664102"
            ]
          },
          "716664102": {
            "id": "716664102",
            "speakerId": 13019,
            "speakerName": "Grandmaster Hanakado",
            "text": "See? Your savior's Onikabuto is a force to be reckoned with.",
            "nextDialogs": [
              "716664103"
            ]
          },
          "716664103": {
            "id": "716664103",
            "speakerId": 13019,
            "speakerName": "Grandmaster Hanakado",
            "text": "But just like last time, when my generals threw you a few curveballs, the mightiest blade cannot slay its foe except in the hands of a skilled swordmaster.",
            "nextDialogs": [
              "716664104"
            ]
          },
          "716664104": {
            "id": "716664104",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "W—W—Wise words, Grandmaster... Ooookay... Good thing my compadre kept it together!",
            "nextDialogs": [
              "716664105"
            ]
          },
          "716664105": {
            "id": "716664105",
            "speakerId": 30467,
            "speakerName": "Contestant with Super OP Gear",
            "text": "Wow, what a blast! I could get into this whole beetle-battling thing!",
            "nextDialogs": [
              "716664106"
            ]
          },
          "716664106": {
            "id": "716664106",
            "speakerId": 30467,
            "speakerName": "Contestant with Super OP Gear",
            "text": "This is so much fun! Thanks, everyone! I'm gonna stick around and play some more!"
          }
        }
      }
    }
  ]

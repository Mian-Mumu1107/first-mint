    {
      "subId": "7280406",
      "subQuestName": "Defeat the subordinates of the Kairagi Leader",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7280407",
      "subQuestName": "Talk to Asakura",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728040406"
        ],
        "dialogs": {
          "728040406": {
            "id": "728040406",
            "speakerId": 3060,
            "speakerName": "Asakura",
            "text": "From your steady breathing, it seems that those Kairagi were no match for you.",
            "nextDialogs": [
              "728040407"
            ]
          },
          "728040407": {
            "id": "728040407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And it seems that you were victorious as well.",
            "nextDialogs": [
              "728040408"
            ]
          },
          "728040408": {
            "id": "728040408",
            "speakerId": 3060,
            "speakerName": "Asakura",
            "text": "That is indeed the case. Though I must admit that to my shame, I allowed him to escape with but a single stab from my spear due to a feint on his part.",
            "nextDialogs": [
              "728040409"
            ]
          },
          "728040409": {
            "id": "728040409",
            "speakerId": 3060,
            "speakerName": "Asakura",
            "text": "Still, his wound was very severe. I do not believe that he will emerge to do much ill for at least a few years.",
            "nextDialogs": [
              "728040410"
            ]
          },
          "728040410": {
            "id": "728040410",
            "speakerId": 3060,
            "speakerName": "Asakura",
            "text": "More importantly, I have defeated him myself and reclaimed my weapon. I am henceforth free from the stain of that humiliation.",
            "nextDialogs": [
              "728040411"
            ]
          },
          "728040411": {
            "id": "728040411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Congratulations, Asakura.",
            "nextDialogs": [
              "728040412"
            ]
          },
          "728040412": {
            "id": "728040412",
            "speakerId": 3060,
            "speakerName": "Asakura",
            "text": "Indeed, I owe you thanks, but I cannot rest yet.",
            "nextDialogs": [
              "728040413"
            ]
          },
          "728040413": {
            "id": "728040413",
            "speakerId": 3060,
            "speakerName": "Asakura",
            "text": "The reason for this whole incident was my lack of training. I will continue to train hard and refine my skills.",
            "nextDialogs": [
              "728040414"
            ]
          },
          "728040414": {
            "id": "728040414",
            "speakerId": 3060,
            "speakerName": "Asakura",
            "text": "As such... I shall be counting on you in the future as well to spar with me!",
            "nextDialogs": [
              "728040415"
            ]
          },
          "728040415": {
            "id": "728040415",
            "speakerId": 3060,
            "speakerName": "Asakura",
            "text": "Ah, yes. Please take these as a token of my thanks. It isn't much, but do accept it.",
            "nextDialogs": [
              "728040416"
            ]
          },
          "728040416": {
            "id": "728040416",
            "speakerId": 3060,
            "speakerName": "Asakura",
            "text": "Thank you once again!"
          }
        }
      }
    },
    {
      "subId": "7280499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728049903"
        ],
        "dialogs": {
          "728049903": {
            "id": "728049903",
            "speakerId": 20331,
            "speakerName": "\"Kairagi\"",
            "text": "It's you again? You barely escaped that last time and you're coming back for more?",
            "nextDialogs": [
              "728049904"
            ]
          },
          "728049904": {
            "id": "728049904",
            "speakerId": 20331,
            "speakerName": "\"Kairagi\"",
            "text": "You've brought a sidekick as well... Hmph, seeing as you haven't learned anything, then we won't bother holding back!",
            "nextDialogs": [
              "728049905"
            ]
          },
          "728049905": {
            "id": "728049905",
            "speakerId": 20331,
            "speakerName": "\"Kairagi\"",
            "text": "Let's go, everyone! Take them down!",
            "nextDialogs": [
              "728049906"
            ]
          },
          "728049906": {
            "id": "728049906",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "While Asakura is dueling their leader, let's quickly beat these guys!",
            "nextDialogs": [
              "728049907"
            ]
          },
          "728049907": {
            "id": "728049907",
            "speakerId": 20332,
            "speakerName": "\"Kairagi\" Leader",
            "text": "It's often said that a Doushin's weapon is their dignity. You've lost to me already, so I'm surprised you had the audacity to challenge me to another duel!",
            "nextDialogs": [
              "728049908"
            ]
          },
          "728049908": {
            "id": "728049908",
            "speakerId": 12144,
            "speakerName": "Asakura",
            "text": "I came here because of my previous defeat... I'll wash away the shame with my own two hands!",
            "nextDialogs": [
              "728049909"
            ]
          },
          "728049909": {
            "id": "728049909",
            "speakerId": 20332,
            "speakerName": "\"Kairagi\" Leader",
            "text": "Such insolence... This time, no one will be here to help you!",
            "nextDialogs": [
              "728049910"
            ]
          },
          "728049910": {
            "id": "728049910",
            "speakerId": 12144,
            "speakerName": "Asakura",
            "text": "I don't need help. I can cut you down, myself!",
            "nextDialogs": [
              "728049911"
            ]
          },
          "728049911": {
            "id": "728049911",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look! Asakura's over there!",
            "nextDialogs": [
              "728049912"
            ]
          },
          "728049912": {
            "id": "728049912",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It seems like the Kairagi's leader is running away. That must mean Asakura won the duel!"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7524601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752460101"
        ],
        "dialogs": {
          "752460101": {
            "id": "752460101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Look, there are people over there!",
            "nextDialogs": [
              "752460102"
            ]
          },
          "752460102": {
            "id": "752460102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Huh, they look familiar. I think that's...",
            "nextDialogs": [
              "752460103"
            ]
          },
          "752460103": {
            "id": "752460103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ororon and Ifa!",
            "nextDialogs": [
              "752460104"
            ]
          },
          "752460104": {
            "id": "752460104",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "#Oh, {M#Gramps}{F#other Granny} and Paimon! I knew those were voices I recognized!",
            "nextDialogs": [
              "752460105"
            ]
          },
          "752460105": {
            "id": "752460105",
            "speakerId": 1002,
            "speakerName": "Cacucu",
            "text": "Bros! Bros!",
            "nextDialogs": [
              "752460106"
            ]
          },
          "752460106": {
            "id": "752460106",
            "speakerId": 1003,
            "speakerName": "Ifa",
            "text": "Hah! You're here at the resort, too! Man, it's been a while!",
            "nextDialogs": [
              "752460107"
            ]
          },
          "752460107": {
            "id": "752460107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yep! Chasca told us you've been working here. Guess we were bound to run into each other at some point!",
            "nextDialogs": [
              "752460108"
            ]
          },
          "752460108": {
            "id": "752460108",
            "speakerId": 1003,
            "speakerName": "Ifa",
            "text": "Yeah, for sure. Yo, this place has a nice vibe to it, don't you think? I hear everyone's been having a blast.",
            "nextDialogs": [
              "752460109"
            ]
          },
          "752460109": {
            "id": "752460109",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe, definitely! With any luck, it'll only get better, and we'll get even more visitors!",
            "nextDialogs": [
              "752460110"
            ]
          },
          "752460110": {
            "id": "752460110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What about you two? How's your work going?",
            "nextDialogs": [
              "752460111"
            ]
          },
          "752460111": {
            "id": "752460111",
            "speakerId": 1003,
            "speakerName": "Ifa",
            "text": "Not bad! The saurian staff and the aphids are all in good health and full of energy, so we had some free time on our hands. Thought we'd take a look around.",
            "nextDialogs": [
              "752460112"
            ]
          },
          "752460112": {
            "id": "752460112",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "...Aphid STAFF.",
            "nextDialogs": [
              "752460113"
            ]
          },
          "752460113": {
            "id": "752460113",
            "speakerId": 1003,
            "speakerName": "Ifa",
            "text": "Huh?",
            "nextDialogs": [
              "752460114"
            ]
          },
          "752460114": {
            "id": "752460114",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "The aphids are part of the staff, too. You missed that part.",
            "nextDialogs": [
              "752460115"
            ]
          },
          "752460115": {
            "id": "752460115",
            "speakerId": 1002,
            "speakerName": "Cacucu",
            "text": "You can say that again, bro!",
            "nextDialogs": [
              "752460116"
            ]
          },
          "752460116": {
            "id": "752460116",
            "speakerId": 1003,
            "speakerName": "Ifa",
            "text": "Right... My bad. I'm grateful to our entire staff, of course. And, to Mr. Ororon, for looking out for them so... proactively.",
            "nextDialogs": [
              "752460117"
            ]
          },
          "752460117": {
            "id": "752460117",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "We got here early to fight for an important cause. That's its own reward.",
            "nextDialogs": [
              "752460118"
            ]
          },
          "752460118": {
            "id": "752460118",
            "speakerId": 1003,
            "speakerName": "Ifa",
            "text": "You see, this is my bro's first time getting a formal invitation like that, and as you can probably tell, he's very, um... committed.",
            "nextDialogs": [
              "752460119"
            ]
          },
          "752460119": {
            "id": "752460119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Enthusiasm's a good thing.",
            "nextDialogs": [
              "752460120"
            ]
          },
          "752460120": {
            "id": "752460120",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "#See? {M#Gramps}{F#Other Granny} knows what {M#he's}{F#she's} talking about.",
            "nextDialogs": [
              "752460121"
            ]
          },
          "752460121": {
            "id": "752460121",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Every day, we get a new chance to fight for what's important. Cacucu taught me that.",
            "nextDialogs": [
              "752460122"
            ]
          },
          "752460122": {
            "id": "752460122",
            "speakerId": 1002,
            "speakerName": "Cacucu",
            "text": "Haha!",
            "nextDialogs": [
              "752460123"
            ]
          },
          "752460123": {
            "id": "752460123",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But, aren't you just... fishing? Since when did that count as \"fighting for what's important\"?",
            "nextDialogs": [
              "752460124"
            ]
          },
          "752460124": {
            "id": "752460124",
            "speakerId": 1002,
            "speakerName": "Cacucu",
            "text": "Do you even hear yourself?",
            "nextDialogs": [
              "752460125"
            ]
          },
          "752460125": {
            "id": "752460125",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Since it was suggested by a friend, of course. He's a famous adventurer from Mondstadt with incredible luck. If he says it'll work, who are we to argue?",
            "nextDialogs": [
              "752460126"
            ]
          },
          "752460126": {
            "id": "752460126",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Wait... Bennett?)",
            "nextDialogs": [
              "752460127"
            ]
          },
          "752460127": {
            "id": "752460127",
            "speakerId": 1003,
            "speakerName": "Ifa",
            "text": "Yeah, that bro spun a stick around and it ended up pointing at this pond. As Ororon put it — better to follow luck where it leads than try to make your own. So, we came to fish here.",
            "nextDialogs": [
              "752460128"
            ]
          },
          "752460128": {
            "id": "752460128",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Okay, even if that made sense... This pond is surrounded by capybaras! Can you even fish here?",
            "nextDialogs": [
              "752460129"
            ]
          },
          "752460129": {
            "id": "752460129",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Of course! Capybaras are gentle creatures, so we're good. Besides, when life gives you water, you fish. That's what Granny taught me.",
            "nextDialogs": [
              "752460130"
            ]
          },
          "752460130": {
            "id": "752460130",
            "speakerId": 1003,
            "speakerName": "Ifa",
            "text": "Ah, another one of Granny's pearls of wisdom. Along with, \"when life gives you food, you eat\" or \"when life gives you lemons, make lemonade.\"",
            "nextDialogs": [
              "752460131"
            ]
          },
          "752460131": {
            "id": "752460131",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "#Haha, exactly. Except, we're the ones handing you lemons this time, {M#Gramps}{F#other Granny} and Paimon. Since you're here, why don't you fish with us?",
            "nextDialogs": [
              "752460132"
            ]
          },
          "752460132": {
            "id": "752460132",
            "speakerId": 1003,
            "speakerName": "Ifa",
            "text": "And, to up the ante a bit... Whoever catches the biggest fish gets a pint of Ororon's Aphimead.",
            "nextDialogs": [
              "752460133"
            ]
          },
          "752460133": {
            "id": "752460133",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Now that's an offer Paimon can get behind!",
            "nextDialogs": [
              "752460134"
            ]
          },
          "752460134": {
            "id": "752460134",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Hehehe, did you forget who you're dealing with here? We never back away from a challenge, and {NICKNAME} is a tough opponent!",
            "nextDialogs": [
              "752460136",
              "752460138"
            ]
          },
          "752460136": {
            "id": "752460136",
            "speakerId": 1003,
            "speakerName": "Ifa",
            "text": "Got your game face on, I see! Alright, I'm down!"
          },
          "752460138": {
            "id": "752460138",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Alright, then it's winner takes all — meaning not only all the fish, but the aphid staff's mead too."
          }
        }
      }
    },
    {
      "subId": "7524603",
      "subQuestName": "Partake in a thrilling fishing contest",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752460384"
        ],
        "dialogs": {
          "752460384": {
            "id": "752460384",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "#As the elder, you should go first, {M#Gramps}{F#other Granny}.",
            "nextDialogs": [
              "752460385"
            ]
          },
          "752460385": {
            "id": "752460385",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Happily.",
            "nextDialogs": [
              "752460301"
            ]
          },
          "752460301": {
            "id": "752460301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Wow, the competition's really heating up! Here comes a pro move from {NICKNAME}... and there's a bite! {NICKNAME} reels it in, and up comes a...",
            "nextDialogs": [
              "752460302"
            ]
          },
          "752460302": {
            "id": "752460302",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hold on... is that... an Asha?",
            "nextDialogs": [
              "752460303"
            ]
          },
          "752460303": {
            "id": "752460303",
            "speakerId": 1003,
            "speakerName": "Ifa",
            "text": "Wow... Not exactly the kind of catch I was expecting! Not super sure how we're gonna judge that...",
            "nextDialogs": [
              "752460304"
            ]
          },
          "752460304": {
            "id": "752460304",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "#Nice one, {M#Gramps}{F#other Granny}! We'll have to see if anyone manages to reel in something even more special. Otherwise, that might be enough for the win.",
            "nextDialogs": [
              "752460305"
            ]
          },
          "752460305": {
            "id": "752460305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thanks, everyone! I'm up against some fierce competition, but I think I've got a shot. Let's hope my grandson is right!",
            "nextDialogs": [
              "752460306"
            ]
          },
          "752460306": {
            "id": "752460306",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Quite the impressive showing from {NICKNAME}! That'll be a tough act for the remaining two competitors to follow!",
            "nextDialogs": [
              "752460307"
            ]
          },
          "752460307": {
            "id": "752460307",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ifa, you're up!",
            "nextDialogs": [
              "752460308"
            ]
          },
          "752460308": {
            "id": "752460308",
            "speakerId": 1002,
            "speakerName": "Cacucu",
            "text": "You've got this, bro! Teamwork makes the dream work!",
            "nextDialogs": [
              "752460309"
            ]
          },
          "752460309": {
            "id": "752460309",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Sorry, Cacucu. There's no room for teamwork here.",
            "nextDialogs": [
              "752460310"
            ]
          },
          "752460310": {
            "id": "752460310",
            "speakerId": 1003,
            "speakerName": "Ifa",
            "text": "Whoa, look alive, bros... I've got something!",
            "nextDialogs": [
              "752460311"
            ]
          },
          "752460311": {
            "id": "752460311",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Ifa reels in the rod with all his strength. Looks like he's caught something big...",
            "nextDialogs": [
              "752460312"
            ]
          },
          "752460312": {
            "id": "752460312",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "But... it's another unexpected catch."
          }
        }
      }
    },
    {

    {
      "subId": "2302510",
      "subQuestName": "Talk to Farghani",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230251001"
        ],
        "dialogs": {
          "230251001": {
            "id": "230251001",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "What? Monsters, out there? This doesn't make sense. The environmental parameters showed that...",
            "nextDialogs": [
              "230251002"
            ]
          },
          "230251002": {
            "id": "230251002",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "Could the beacons have become variables themselves? Perhaps their vibrations and sounds attracted the monsters...",
            "nextDialogs": [
              "230251003"
            ]
          },
          "230251003": {
            "id": "230251003",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "Oh no, will these things affect the data? Ah, sorry. I've been talking to myself again.",
            "nextDialogs": [
              "230251004"
            ]
          },
          "230251004": {
            "id": "230251004",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "I didn't expect to cause you extra trouble. My apologies, and please, take this as your payment.",
            "nextDialogs": [
              "230251005"
            ]
          },
          "230251005": {
            "id": "230251005",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "I should be more conscientious with my measurements next time."
          }
        }
      }

    {
      "subId": "2302504",
      "subQuestName": "Talk to Farghani",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230250401"
        ],
        "dialogs": {
          "230250401": {
            "id": "230250401",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "Hmm... So that's it. Introduce this variable, and the discrepancies can be explained.",
            "nextDialogs": [
              "230250402"
            ]
          },
          "230250402": {
            "id": "230250402",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "But does that change my other deductions?",
            "nextDialogs": [
              "230250403"
            ]
          },
          "230250403": {
            "id": "230250403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Any progress?",
            "nextDialogs": [
              "230250404"
            ]
          },
          "230250404": {
            "id": "230250404",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "Sorry, I forgot that you were still here... Here's your payment.",
            "nextDialogs": [
              "230250405"
            ]
          },
          "230250405": {
            "id": "230250405",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "As for my progress... I've fixed some issues, but new ones have emerged. That's research, I guess.",
            "nextDialogs": [
              "230250406"
            ]
          },
          "230250406": {
            "id": "230250406",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "I might have to keep troubling you, Traveler, until I reach a final conclusion."
          }
        }
      }
    },

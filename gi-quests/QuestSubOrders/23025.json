    {
      "subId": "2302507",
      "subQuestName": "Talk to Farghani",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230250701"
        ],
        "dialogs": {
          "230250701": {
            "id": "230250701",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "Huh? Have you finished setting up all the beacons?",
            "nextDialogs": [
              "230250702"
            ]
          },
          "230250702": {
            "id": "230250702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're all set.",
            "nextDialogs": [
              "230250703"
            ]
          },
          "230250703": {
            "id": "230250703",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "Thank you so much. Please take this as your payment.",
            "nextDialogs": [
              "230250704"
            ]
          },
          "230250704": {
            "id": "230250704",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "Now all I have to do is wait for them to collect the data, and then I'll be able to confirm my deduction!",
            "nextDialogs": [
              "230250705"
            ]
          },
          "230250705": {
            "id": "230250705",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "Still, how am I supposed to go up and retrieve the beacons...?"
          }
        }
      }
    },
    {
      "subId": "2302508",
      "subQuestName": "Talk to Farghani",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230250801"
        ],
        "dialogs": {
          "230250801": {
            "id": "230250801",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "Ah, Traveler, you've finally come!",
            "nextDialogs": [
              "230250802"
            ]
          },
          "230250802": {
            "id": "230250802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How's your research going?",
            "nextDialogs": [
              "230250803"
            ]
          },
          "230250803": {
            "id": "230250803",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "Thanks to you, I've made huge progress in the past few days. The beacons should be collecting data as we speak.",
            "nextDialogs": [
              "230250804"
            ]
          },
          "230250804": {
            "id": "230250804",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "Now I only have to retrieve the data and verify my new conjectures!",
            "nextDialogs": [
              "230250807"
            ]
          },
          "230250807": {
            "id": "230250807",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "Well, I've optimized some equations and calibrated my instruments. After all...",
            "nextDialogs": [
              "230250808"
            ]
          },
          "230250808": {
            "id": "230250808",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "I won't be able to climb up to the locations where you set those beacons.",
            "nextDialogs": [
              "230250809"
            ]
          },
          "230250809": {
            "id": "230250809",
            "speakerId": 1000,
            "speakerName": "Farghani",
            "text": "I'm afraid I'll have to trouble you to retrieve those beacons."
          }
        }
      }
    },

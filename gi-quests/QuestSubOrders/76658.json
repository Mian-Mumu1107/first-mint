  "subQuests": [
    {
      "subId": "7665801",
      "subQuestName": "Talk to Ginette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766580101"
        ],
        "dialogs": {
          "766580101": {
            "id": "766580101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Heya, Ginette! Did you get all the robots we found?",
            "nextDialogs": [
              "766580102"
            ]
          },
          "766580102": {
            "id": "766580102",
            "speakerId": 1001,
            "speakerName": "Ginette",
            "text": "I did! Good work, you two.",
            "nextDialogs": [
              "766580103"
            ]
          },
          "766580103": {
            "id": "766580103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Speaking of which, we made some new discoveries!",
            "nextDialogs": [
              "766580104"
            ]
          },
          "766580104": {
            "id": "766580104",
            "speakerId": 1001,
            "speakerName": "Ginette",
            "text": "You did? Please tell me everything!",
            "nextDialogs": [
              "766580105"
            ]
          },
          "766580105": {
            "id": "766580105",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You and Paimon tell Ginette about what you witnessed not long ago.",
            "nextDialogs": [
              "766580106"
            ]
          },
          "766580106": {
            "id": "766580106",
            "speakerId": 1001,
            "speakerName": "Ginette",
            "text": "The behaviors you described... The robots seemed to like you very much, and thus sent you a message. An invitation to \"play together.\"",
            "nextDialogs": [
              "766580107"
            ]
          },
          "766580107": {
            "id": "766580107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Really? Whoa, that's so cool!",
            "nextDialogs": [
              "766580108"
            ]
          },
          "766580108": {
            "id": "766580108",
            "speakerId": 1001,
            "speakerName": "Ginette",
            "text": "Hmm-hmm... I knew it!",
            "nextDialogs": [
              "766580109"
            ]
          },
          "766580109": {
            "id": "766580109",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Knew what?",
            "nextDialogs": [
              "766580110"
            ]
          },
          "766580110": {
            "id": "766580110",
            "speakerId": 1001,
            "speakerName": "Ginette",
            "text": "Now I'm certain — my vision can only be realized through interactions between these robots. The more units we can retrieve, the closer we get to my original plan...",
            "nextDialogs": [
              "766580111"
            ]
          },
          "766580111": {
            "id": "766580111",
            "speakerId": 1001,
            "speakerName": "Ginette",
            "text": "Now, they can already communicate with others. All we have to do is find the rest of the robots, and... Yes! I can see my creativity bearing fruit...!",
            "nextDialogs": [
              "766580112"
            ]
          },
          "766580112": {
            "id": "766580112",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, well, someone's excited!",
            "nextDialogs": [
              "766580113"
            ]
          },
          "766580113": {
            "id": "766580113",
            "speakerId": 1001,
            "speakerName": "Ginette",
            "text": "Ah! Sorry, I'm getting a bit worked up... I'll still need your help for the rest. Here, I've marked out the next area on the map.",
            "nextDialogs": [
              "766580114"
            ]
          },
          "766580114": {
            "id": "766580114",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Then let's get going! Paimon's just as curious to see where this'll lead!"
          }
        }
      }
    }
  ]
}
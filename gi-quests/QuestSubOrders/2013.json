  "subQuests": [
    {
      "subId": "201301",
      "subQuestName": "Try to leave Ritou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20130101"
        ],
        "dialogs": {
          "20130101": {
            "id": "20130101",
            "speakerId": 3069,
            "speakerName": "Kobayashi",
            "text": "Stop there! Present your Travel Permits!",
            "nextDialogs": [
              "20130102"
            ]
          },
          "20130102": {
            "id": "20130102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sorry, but we've really gotta get to Narukami Island, it's kinda urgent...",
            "nextDialogs": [
              "20130103"
            ]
          },
          "20130103": {
            "id": "20130103",
            "speakerId": 3069,
            "speakerName": "Kobayashi",
            "text": "If you don't have a Travel Permit, this is as far as you'll get. Those are the rules.",
            "nextDialogs": [
              "20130104"
            ]
          },
          "20130104": {
            "id": "20130104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh... as expected.",
            "nextDialogs": [
              "20130105"
            ]
          },
          "20130105": {
            "id": "20130105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Traveler, you gotta think of something. How do we get out of Ritou?",
            "nextDialogs": [
              "20130108"
            ]
          },
          "20130108": {
            "id": "20130108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are you saying... we should go and meet with the Kanjou Commissioner?",
            "nextDialogs": [
              "20130109"
            ]
          },
          "20130109": {
            "id": "20130109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Guess it can't hurt to try. Even if Paimon has a few choice words to say about his subordinates...",
            "nextDialogs": [
              "20130110"
            ]
          },
          "20130110": {
            "id": "20130110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Who knows — maybe he's our biggest fan! Hee-hee."
          }
        }
      }
    },
    {
      "subId": "201311",
      "subQuestName": "Go to the Kanjou Commissioner's Office to ask about a way to leave Ritou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20131101"
        ],
        "dialogs": {
          "20131101": {
            "id": "20131101",
            "speakerId": 3093,
            "speakerName": "Yokoyama",
            "text": "Halt! This is the Kanjou Commissioner's Office. No trespassers!",
            "nextDialogs": [
              "20131102"
            ]
          },
          "20131102": {
            "id": "20131102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're here to see, uh... y'know, um... the Kanjou Commissioner!",
            "nextDialogs": [
              "20131103"
            ]
          },
          "20131103": {
            "id": "20131103",
            "speakerId": 3093,
            "speakerName": "Yokoyama",
            "text": "The Kanjou Commissioner seldom entertains outlanders. Leave, now or we'll be forced to—",
            "nextDialogs": [
              "20131104"
            ]
          },
          "20131104": {
            "id": "20131104",
            "speakerId": 3085,
            "speakerName": "Hiiragi Shinsuke",
            "text": "Ah... Wait, wait, wait...",
            "nextDialogs": [
              "20131105"
            ]
          },
          "20131105": {
            "id": "20131105",
            "speakerId": 3093,
            "speakerName": "Yokoyama",
            "text": "Oh! Commissioner!",
            "nextDialogs": [
              "20131106"
            ]
          },
          "20131106": {
            "id": "20131106",
            "speakerId": 3085,
            "speakerName": "Hiiragi Shinsuke",
            "text": "These two are honored guests from afar, no need to give them the usual spiel.",
            "nextDialogs": [
              "20131107"
            ]
          },
          "20131107": {
            "id": "20131107",
            "speakerId": 3085,
            "speakerName": "Hiiragi Shinsuke",
            "text": "Come on in, let's see what we can do for you.",
            "nextDialogs": [
              "20131108"
            ]
          },
          "20131108": {
            "id": "20131108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph! Did you get all that, mister!?",
            "nextDialogs": [
              "20131109"
            ]
          },
          "20131109": {
            "id": "20131109",
            "speakerId": 3093,
            "speakerName": "Yokoyama",
            "text": "M—My sincere apologies."
          }
        }
      }
    },
    {
      "subId": "201302",
      "subQuestName": "Talk to Shinsuke of the Kanjou Commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20130201"
        ],
        "dialogs": {
          "20130201": {
            "id": "20130201",
            "speakerId": 3085,
            "speakerName": "Hiiragi Shinsuke",
            "text": "I am Hiiragi Shinsuke, Kanjou Commissioner and head of the Hiiragi Clan. It's an honor to meet you both.",
            "nextDialogs": [
              "20130204"
            ]
          },
          "20130204": {
            "id": "20130204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Nice to meet you, Sir!",
            "nextDialogs": [
              "20130205"
            ]
          },
          "20130205": {
            "id": "20130205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, the reason we wanted to come and see you was because—",
            "nextDialogs": [
              "20130206"
            ]
          },
          "20130206": {
            "id": "20130206",
            "speakerId": 3085,
            "speakerName": "Hiiragi Shinsuke",
            "text": "Alright, alright, all in good time. Two travelers renowned far and wide have shown up to see me, and I should very much like to make their acquaintance! Let's not limit this to business only.",
            "nextDialogs": [
              "20130207"
            ]
          },
          "20130207": {
            "id": "20130207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hee-hee, so what you're saying is, we really are pretty famous, huh?",
            "nextDialogs": [
              "20130208"
            ]
          },
          "20130208": {
            "id": "20130208",
            "speakerId": 3085,
            "speakerName": "Hiiragi Shinsuke",
            "text": "Absolutely. How many other people in the world have what it takes to knock the wind out of Stormterror's sails and put the Overlord of the Vortex back under the sea, eh?",
            "nextDialogs": [
              "20130209"
            ]
          },
          "20130209": {
            "id": "20130209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Exactly! Paimon thinks you make an excellent point.",
            "nextDialogs": [
              "20130210"
            ]
          },
          "20130210": {
            "id": "20130210",
            "speakerId": 3085,
            "speakerName": "Hiiragi Shinsuke",
            "text": "And... I hear you also foiled a Fatui plot in Liyue Harbor, even beat one of their harbingers in a duel. Is that true?",
            "nextDialogs": [
              "20130211"
            ]
          },
          "20130211": {
            "id": "20130211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa! You heard about that, too? Yup, it's true, alright!",
            "nextDialogs": [
              "20130212"
            ]
          },
          "20130212": {
            "id": "20130212",
            "speakerId": 3085,
            "speakerName": "Hiiragi Shinsuke",
            "text": "Hmm... As I thought.",
            "nextDialogs": [
              "20130213"
            ]
          },
          "20130213": {
            "id": "20130213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Something wrong?",
            "nextDialogs": [
              "20130214"
            ]
          },
          "20130214": {
            "id": "20130214",
            "speakerId": 3085,
            "speakerName": "Hiiragi Shinsuke",
            "text": "Hehe, no, no, no. I'm simply awestruck by you both, is all."
          }
        }
      }
    },
    {
      "subId": "201303",
      "subQuestName": "Leave the Kanjou Commissioner's Office",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "201304",
      "subQuestName": "Talk to Shinnojou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20130401"
        ],
        "dialogs": {
          "20130401": {
            "id": "20130401",
            "speakerId": 3016,
            "speakerName": "Shinnojou",
            "text": "Halt, you two.",
            "nextDialogs": [
              "20130404"
            ]
          },
          "20130404": {
            "id": "20130404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? What did we do?",
            "nextDialogs": [
              "20130405"
            ]
          },
          "20130405": {
            "id": "20130405",
            "speakerId": 3016,
            "speakerName": "Shinnojou",
            "text": "Miss Hiiragi has a letter for you. She insists that you read it immediately.",
            "nextDialogs": [
              "20130406"
            ]
          },
          "20130406": {
            "id": "20130406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A letter? Quick, let Paimon see!",
            "nextDialogs": [
              "20130407"
            ]
          },
          "20130407": {
            "id": "20130407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Dear Traveler, would that I could convey this message to you in person. I apologize for the hasty means by which this letter has come to you and I hope that it hasn't left you feeling perplexed or perturbed in any way. This is my first time extending an invitation to an unknown outlander, after all. It is no mere coincidence that our paths have crossed. Therefore, I hope that you would be so courteous as to meet me tonight, under the glow of resplendent moonlight. Please do not fret about retainers and bodyguards, I'll ensure that their attention will be elsewhere. I look forward to the pleasure of your company.",
            "nextDialogs": [
              "20130408"
            ]
          },
          "20130408": {
            "id": "20130408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So this means... she wants you to secretly meet her at night?",
            "nextDialogs": [
              "20130409"
            ]
          },
          "20130409": {
            "id": "20130409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But you didn't seem surprised at all by this... What's going on?"
          }
        }
      }
    },
    {
      "subId": "201306",
      "subQuestName": "Meet Ms. Hiiragi at the appointed time (18:00 – 24:00)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "201307",
      "subQuestName": "Meet Hiiragi Chisato",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20130701"
        ],
        "dialogs": {
          "20130701": {
            "id": "20130701",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "Ah, you've finally arrived... Allow me to introduce myself, I am Hiiragi Chisato.",
            "nextDialogs": [
              "20130702"
            ]
          },
          "20130702": {
            "id": "20130702",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "This is... technically the second time we have met. It's a pleasure to see you again.",
            "nextDialogs": [
              "20130703"
            ]
          },
          "20130703": {
            "id": "20130703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, she's the daughter of the Hiiragi Clan alright...",
            "nextDialogs": [
              "20130706"
            ]
          },
          "20130706": {
            "id": "20130706",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "N—No need to be so formal — I've long marveled at your accomplishments... and at last we have the chance to meet.",
            "nextDialogs": [
              "20130707"
            ]
          },
          "20130707": {
            "id": "20130707",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is it Paimon, or does something seem a bit off here?",
            "nextDialogs": [
              "20130708"
            ]
          },
          "20130708": {
            "id": "20130708",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "The reason why I wanted to secretly meet you here is... Well, I feared that I might never have another opportunity to discuss this with you...",
            "nextDialogs": [
              "20130709"
            ]
          },
          "20130709": {
            "id": "20130709",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "D—Discuss what?",
            "nextDialogs": [
              "20130710"
            ]
          },
          "20130710": {
            "id": "20130710",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "Ahem... I should like to ask for your help with... delivering a letter."
          }
        }
      }
    },
    {
      "subId": "201308",
      "subQuestName": "Go to Ritou's border to carry out Chisato's plan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20130801"
        ],
        "dialogs": {
          "20130801": {
            "id": "20130801",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "Hold on please... These goods are being sent to... Watatsumi Island?",
            "nextDialogs": [
              "20130802"
            ]
          },
          "20130802": {
            "id": "20130802",
            "speakerId": 3016,
            "speakerName": "Shinnojou",
            "text": "My lady! This is an unexpected honor. You are correct, these goods have been repeatedly requested by the Kanjou Commissioner. We must be certain that they reach Watatsumi Island intact.",
            "nextDialogs": [
              "20130803"
            ]
          },
          "20130803": {
            "id": "20130803",
            "speakerId": 12054,
            "speakerName": "Kenzaburou",
            "text": "Is there something wrong, Lady Hiiragi?",
            "nextDialogs": [
              "20130804"
            ]
          },
          "20130804": {
            "id": "20130804",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "No, as you were. My father simply has some concerns of the shipment's safety, and has ordered that myself and an additional qualified escort be dispatched to ensure safe transport of the goods.",
            "nextDialogs": [
              "20130805"
            ]
          },
          "20130805": {
            "id": "20130805",
            "speakerId": 12054,
            "speakerName": "Kenzaburou",
            "text": "My lady, you aren't suggesting that you intend to escort the shipment personally, are you? There's certainly no need for you to trouble yourself with such a matter, and as for this \"qualified escort\"...",
            "nextDialogs": [
              "20130808"
            ]
          },
          "20130808": {
            "id": "20130808",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "Please, do not cause us any further delay. If memory serves me right, my father has already asserted that this shipment must arrive on time. I'm certain punishment will be duly dispensed if it fails to do so.",
            "nextDialogs": [
              "20130809"
            ]
          },
          "20130809": {
            "id": "20130809",
            "speakerId": 12054,
            "speakerName": "Kenzaburou",
            "text": "Yes, of course my lady. I—It's just that... Well, we don't know who this—",
            "nextDialogs": [
              "20130810"
            ]
          },
          "20130810": {
            "id": "20130810",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "Now, need I remind you of the penalty if anything were to happen to me en route? I'm sure you are all quite familiar with my father's temperament.",
            "nextDialogs": [
              "20130811"
            ]
          },
          "20130811": {
            "id": "20130811",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "Do you really presume that you can fully guarantee my safety on your own?",
            "nextDialogs": [
              "20130812"
            ]
          },
          "20130812": {
            "id": "20130812",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Boy, Chisato can talk the talk, they don't stand a chance...",
            "nextDialogs": [
              "20130813"
            ]
          },
          "20130813": {
            "id": "20130813",
            "speakerId": 3016,
            "speakerName": "Shinnojou",
            "text": "A—Ah, yes my lady. Very well then... I—It's an honor to have you accompanying us. Your safety is our highest priority.",
            "nextDialogs": [
              "20130814"
            ]
          },
          "20130814": {
            "id": "20130814",
            "speakerId": 12054,
            "speakerName": "Kenzaburou",
            "text": "Shinnojou! You can't really be agreeing to this!?",
            "nextDialogs": [
              "20130815"
            ]
          },
          "20130815": {
            "id": "20130815",
            "speakerId": 3016,
            "speakerName": "Shinnojou",
            "text": "Well, the request is from Lady Hiiragi herself. It is our duty to serve her in the utmost capacity.",
            "nextDialogs": [
              "20130816"
            ]
          },
          "20130816": {
            "id": "20130816",
            "speakerId": 12054,
            "speakerName": "Kenzaburou",
            "text": "Yes, but... that's not the problem here...",
            "nextDialogs": [
              "20130817"
            ]
          },
          "20130817": {
            "id": "20130817",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "Well then, if we're through here, I suggest we set off at once. Dawdling will only allow potential thieves more time to prepare, no?",
            "nextDialogs": [
              "20130818"
            ]
          },
          "20130818": {
            "id": "20130818",
            "speakerId": 12054,
            "speakerName": "Kenzaburou",
            "text": "Y—Yes, my lady. You heard her, there's no time to lose!"
          }
        }
      }
    },
    {
      "subId": "201309",
      "subQuestName": "Escort the goods and leave Ritou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "201310",
      "subQuestName": "Say farewell to Hiiragi Chisato",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20131001"
        ],
        "dialogs": {
          "20131001": {
            "id": "20131001",
            "speakerId": 3016,
            "speakerName": "Shinnojou",
            "text": "Whew, we can take refuge in the village up ahead. How are you faring, my lady?",
            "nextDialogs": [
              "20131002"
            ]
          },
          "20131002": {
            "id": "20131002",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "I'm perfectly alright. You may stop here. The road to Narukami Island is just over there.",
            "nextDialogs": [
              "20131003"
            ]
          },
          "20131003": {
            "id": "20131003",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "In my letter, I've requested Kamaji to grant you a special Travel Permit from the Tenryou Commission. Consider it a token of my appreciation.",
            "nextDialogs": [
              "20131006"
            ]
          },
          "20131006": {
            "id": "20131006",
            "speakerId": 3016,
            "speakerName": "Shinnojou",
            "text": "My lady...?",
            "nextDialogs": [
              "20131007"
            ]
          },
          "20131007": {
            "id": "20131007",
            "speakerId": 12054,
            "speakerName": "Kenzaburou",
            "text": "Huh! So that's how it is. I had a feeling something was amiss, but Shinnojou, you...",
            "nextDialogs": [
              "20131008"
            ]
          },
          "20131008": {
            "id": "20131008",
            "speakerId": 3016,
            "speakerName": "Shinnojou",
            "text": "No, Lady Hiiragi would never hide anything from us, I'm sure of it. But who is this \"Kamaji\" you speak of, my lady?",
            "nextDialogs": [
              "20131009"
            ]
          },
          "20131009": {
            "id": "20131009",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "I'm not afraid to say that... he's the one I love.",
            "nextDialogs": [
              "20131010"
            ]
          },
          "20131010": {
            "id": "20131010",
            "speakerId": 3016,
            "speakerName": "Shinnojou",
            "text": "The one... you love?",
            "nextDialogs": [
              "20131011"
            ]
          },
          "20131011": {
            "id": "20131011",
            "speakerId": 12054,
            "speakerName": "Kenzaburou",
            "text": "Shinnojou... Did you honestly think that...?",
            "nextDialogs": [
              "20131012"
            ]
          },
          "20131012": {
            "id": "20131012",
            "speakerId": 3016,
            "speakerName": "Shinnojou",
            "text": "What!? N—No, I uh... ahem! I was clarifying, that's all. I would never in my wildest dreams, uh... ahem!",
            "nextDialogs": [
              "20131013"
            ]
          },
          "20131013": {
            "id": "20131013",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",
            "text": "You two needn't worry. Please, forget that this ever happened. If my father catches word of it, I alone will be held accountable.",
            "nextDialogs": [
              "20131014"
            ]
          },
          "20131014": {
            "id": "20131014",
            "speakerId": 12054,
            "speakerName": "Kenzaburou",
            "text": "Yes, of course. As you wish, my lady.",
            "nextDialogs": [
              "20131015"
            ]
          },
          "20131015": {
            "id": "20131015",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But what will happen if your actions here are discovered, Chisato?",
            "nextDialogs": [
              "20131016"
            ]
          },
          "20131016": {
            "id": "20131016",
            "speakerId": 3086,
            "speakerName": "Hiiragi Chisato",

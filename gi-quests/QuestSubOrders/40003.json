    {
      "subId": "4000303",
      "subQuestName": "Defeat the hilichurls and their roadblock",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400030301"
        ],
        "dialogs": {
          "400030301": {
            "id": "400030301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's a hilichurl blockade! Paimon wonders what they're doing here... Waiting to ambush someone, maybe?"
          }
        }
      }
    },
    {
      "subId": "4000304",
      "subQuestName": "Talk to the squad of the Millelith",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400030401"
        ],
        "dialogs": {
          "400030401": {
            "id": "400030401",
            "speakerId": 242801,
            "speakerName": "Xinghuo",
            "text": "The monster presence has been duly investigated. Dismissed! ...Huh?",
            "nextDialogs": [
              "400030402"
            ]
          },
          "400030402": {
            "id": "400030402",
            "speakerId": 242801,
            "speakerName": "Xinghuo",
            "text": "Who are you with?",
            "nextDialogs": [
              "400030403"
            ]
          },
          "400030403": {
            "id": "400030403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Jiayi sent us to find you, he said...",
            "nextDialogs": [
              "400030404"
            ]
          },
          "400030404": {
            "id": "400030404",
            "speakerId": 242801,
            "speakerName": "Xinghuo",
            "text": "I see. I understand.",
            "nextDialogs": [
              "400030405"
            ]
          },
          "400030405": {
            "id": "400030405",
            "speakerId": 242801,
            "speakerName": "Xinghuo",
            "text": "The Ministry of Civil Affairs is grateful for your support. Your case is well noted and will be scheduled for investigation as soon as possible.",
            "nextDialogs": [
              "400030406"
            ]
          },
          "400030406": {
            "id": "400030406",
            "speakerId": 242801,
            "speakerName": "Xinghuo",
            "text": "May our paths cross again in Liyue, kind travelers.",
            "nextDialogs": [
              "400030407"
            ]
          },
          "400030407": {
            "id": "400030407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, Paimon is starting to feel like...",
            "nextDialogs": [
              "400030409",
              "400030414"
            ]
          },
          "400030409": {
            "id": "400030409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Exactly! Paimon thinks so too!",
            "nextDialogs": [
              "400030410"
            ]
          },
          "400030410": {
            "id": "400030410",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The locals must take all their tasty treats for granted by now.",
            "nextDialogs": [
              "400030411"
            ]
          },
          "400030411": {
            "id": "400030411",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But for a poor traveler, all alone out in the wilderness, often forced to survive on nothing but the most mysterious of mushrooms...",
            "nextDialogs": [
              "400030412"
            ]
          },
          "400030412": {
            "id": "400030412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "For you, the Lantern Rite is the most important of all festivals!",
            "nextDialogs": [
              "400030416"
            ]
          },
          "400030416": {
            "id": "400030416",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So let's go back to the place where we witnessed the shady-looking guy.",
            "nextDialogs": [
              "400030417"
            ]
          },
          "400030417": {
            "id": "400030417",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon hears from patrol officers that criminals love to go back for another look at the crime scene after the event. Eh, it's a psychological thing, apparently.",
            "nextDialogs": [
              "400030418"
            ]
          },
          "400030418": {
            "id": "400030418",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But the crime hasn't even happened yet...",
            "nextDialogs": [
              "400030419"
            ]
          },
          "400030419": {
            "id": "400030419",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's why there's no time to lose! When there's highly flammable materials involved, once the crime happens it'll be too late!"
          },
          "400030414": {
            "id": "400030414",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon thinks so too!",
            "nextDialogs": [
              "400030415"
            ]
          },
          "400030415": {
            "id": "400030415",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "With our wealth of experience adventuring far and wide, we should be able to get to the bottom of this."
          }
        }
      }
    },
    {

    {
      "subId": "4000307",
      "subQuestName": "Talk to Paimon (Hidden)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400030701"
        ],
        "dialogs": {
          "400030701": {
            "id": "400030701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aha! Knew it!",
            "nextDialogs": [
              "400030704"
            ]
          },
          "400030704": {
            "id": "400030704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, there's another person—"
          }
        }
      }

  "subQuests": [
    {
      "subId": "4000301",
      "subQuestName": "Paimon Dialog (Hidden)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400030101"
        ],
        "dialogs": {
          "400030101": {
            "id": "400030101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon wonders what progress the Ministry of Civil Affairs is making."
          }
        }
      }
    },
    {
      "subId": "4000302",
      "subQuestName": "Talk to Jiayi at the Ministry of Civil Affairs",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400030201"
        ],
        "dialogs": {
          "400030201": {
            "id": "400030201",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "Erm... Ah yes, you two were here yesterday to report some suspicious activity.",
            "nextDialogs": [
              "400030202"
            ]
          },
          "400030202": {
            "id": "400030202",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "I... *sigh* I won't lie to you, the Ministry of Civil Affairs is unbelievably busy during Lantern Rite. We simply don't have the staff to cover this case at the moment.",
            "nextDialogs": [
              "400030203"
            ]
          },
          "400030203": {
            "id": "400030203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What? Are you kidding me!?",
            "nextDialogs": [
              "400030204"
            ]
          },
          "400030204": {
            "id": "400030204",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "I do hate to let you down like this, and I appreciate that you took the trouble to report this out of the goodness of your hearts. Hmm, I wonder if...",
            "nextDialogs": [
              "400030205"
            ]
          },
          "400030205": {
            "id": "400030205",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "I do believe we have one smaller squad that just might be able to help. They only have one assignment left today.",
            "nextDialogs": [
              "400030206"
            ]
          },
          "400030206": {
            "id": "400030206",
            "speakerId": 2056,
            "speakerName": "Jiayi",
            "text": "They are currently subduing the monster presence at the Guili Plains. If you are able to make contact with them..."
          }
        }
      }
    },

    {
      "subId": "7106109",
      "subQuestName": "Tell Xamaran that the foul energy's source has been cleared out",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710610501"
        ],
        "dialogs": {
          "710610501": {
            "id": "710610501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, Sheeshroom, we're back. We've run out of your — um, what do you call it — oh, your Blessings of Wisdom.",
            "nextDialogs": [
              "710610503"
            ]
          },
          "710610503": {
            "id": "710610503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But we've managed to block the fissures. Now the problem has been solved!",
            "nextDialogs": [
              "710610504"
            ]
          },
          "710610504": {
            "id": "710610504",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "#Hail {NICKNAME}! Hail Paimon!",
            "nextDialogs": [
              "710610505"
            ]
          },
          "710610505": {
            "id": "710610505",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "May no regrets linger in the night bygone. May all shadows fade ere the dawn to come.",
            "nextDialogs": [
              "710610506"
            ]
          },
          "710610506": {
            "id": "710610506",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "...",
            "nextDialogs": [
              "710610507"
            ]
          },
          "710610507": {
            "id": "710610507",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Seems Sheeshroom has fallen asleep again. Let's not disturb it."
          }
        }
      }
    }

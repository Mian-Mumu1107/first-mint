    {
      "subId": "7106104",
      "subQuestName": "Help Xamaran clear the foul energy out",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710610401"
        ],
        "dialogs": {
          "710610401": {
            "id": "710610401",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "#Hail {NICKNAME}! Hail Paimon!",
            "nextDialogs": [
              "710610402"
            ]
          },
          "710610402": {
            "id": "710610402",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "If Xamaran may be so bold, you Two-Legs do have a saying: \"A helping hand must see things to the end.\"",
            "nextDialogs": [
              "710610404",
              "710610406"
            ]
          },
          "710610404": {
            "id": "710610404",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "Amongst Two-Legs, you two do indeed deserve the title of \"The Wise.\"",
            "nextDialogs": [
              "710610407"
            ]
          },
          "710610407": {
            "id": "710610407",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "Please take this — the Blessings of Wisdom.",
            "nextDialogs": [
              "710610408"
            ]
          },
          "710610408": {
            "id": "710610408",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You obtain the Blessings of Wisdom.",
            "nextDialogs": [
              "710610409"
            ]
          },
          "710610409": {
            "id": "710610409",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow... What's this? It looks kinda suspicious, actually...",
            "nextDialogs": [
              "710610410"
            ]
          },
          "710610410": {
            "id": "710610410",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "Xamaran can smell the lingering scent of foul energy in the air but cannot tell where its source lies. Follow the water and you shall find it.",
            "nextDialogs": [
              "710610411"
            ]
          },
          "710610411": {
            "id": "710610411",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "#You merely need to use the Blessings of Wisdom on the source, {NICKNAME}, and Xamaran's kin will take care of the rest."
          },
          "710610406": {
            "id": "710610406",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "We are both living beings bathing in the blessings of the earth. It's natural for us to help each other out."
          }
        }
      }
    },
    {
      "subId": "7106110",
      "subQuestName": "Tell Xamaran that the foul energy has been cleansed",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710610301"
        ],
        "dialogs": {
          "710610301": {
            "id": "710610301",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "#Hail {NICKNAME}! Hail Paimon!",
            "nextDialogs": [
              "710610302"
            ]
          },
          "710610302": {
            "id": "710610302",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "None answered Xamaran's call for help. The many-legged and four-legged paid no heed, and the two-legged turned a deaf ear.",
            "nextDialogs": [
              "710610303"
            ]
          },
          "710610303": {
            "id": "710610303",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "#Only the wise would answer. Paimon proved to be one with wisdom, and {NICKNAME} did, too.",
            "nextDialogs": [
              "710610304"
            ]
          },
          "710610304": {
            "id": "710610304",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "You two, wisest of the two-legged, shall receive Xamaran's gratitude.",
            "nextDialogs": [
              "710610323"
            ]
          },
          "710610323": {
            "id": "710610323",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmph, Paimon the Wise is not to be taken lightly!",
            "nextDialogs": [
              "710610305"
            ]
          },
          "710610305": {
            "id": "710610305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It was no trouble.",
            "nextDialogs": [
              "710610306"
            ]
          },
          "710610306": {
            "id": "710610306",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "#Given time, {NICKNAME} and Paimon will rise to become as great as Xamaran and its kin. This Xamaran knows for sure.",
            "nextDialogs": [
              "710610307"
            ]
          },
          "710610307": {
            "id": "710610307",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hang on, what is that supposed to mean?",
            "nextDialogs": [
              "710610308"
            ]
          },
          "710610308": {
            "id": "710610308",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "The many-legged are inferior to the four-legged, and the four-legged are inferior to the two-legged, so naturally, the two-legged are inferior to the legless.",
            "nextDialogs": [
              "710610309"
            ]
          },
          "710610309": {
            "id": "710610309",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "#But what {NICKNAME} and Paimon lack by nature, you can make up for through hard work. You might even be able to change the course of fate one day.",
            "nextDialogs": [
              "710610310"
            ]
          },
          "710610310": {
            "id": "710610310",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, this glowing mushroom's talking super big! Paimon wonders if glowing mushrooms make good cooking ingredients...",
            "nextDialogs": [
              "710610313"
            ]
          },
          "710610313": {
            "id": "710610313",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "A glutton, this Paimon is. A bite on the mushroom today, another bite tomorrow, and a hundred days later, there shall be no Paimon left in Paimon, but only mushrooms.",
            "nextDialogs": [
              "710610314"
            ]
          },
          "710610314": {
            "id": "710610314",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Uhh, Sheeshroom's starting to talk all creepy, {NICKNAME}...",
            "nextDialogs": [
              "710610315"
            ]
          },
          "710610315": {
            "id": "710610315",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "Ah, so you failed to see the humor in that. A shame.",
            "nextDialogs": [
              "710610316"
            ]
          },
          "710610316": {
            "id": "710610316",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That wasn't funny at all!",
            "nextDialogs": [
              "710610317"
            ]
          },
          "710610317": {
            "id": "710610317",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "Xamaran is cleared of the foul energy, yet its kin still suffer. Xamaran lacks the strength now to shelter the weak like it once did.",
            "nextDialogs": [
              "710610318"
            ]
          },
          "710610318": {
            "id": "710610318",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "#Please, {NICKNAME}, Xamaran begs of you. Exercise your benevolence and save the defenseless.",
            "nextDialogs": [
              "710610319"
            ]
          },
          "710610319": {
            "id": "710610319",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Do you mean there are more ill mushrooms? {NICKNAME}, let's help 'em, shall we?"
          }
        }
      }
    },
    {
      "subId": "7106106",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710610601"
        ],
        "dialogs": {
          "710610601": {
            "id": "710610601",
            "speakerId": 1000,
            "speakerName": "Xamaran",
            "text": "Xamaran knows that the foul energy has yet to be eradicated. Two-legged one, please lend Xamaran your strength."
          }
        }
      }

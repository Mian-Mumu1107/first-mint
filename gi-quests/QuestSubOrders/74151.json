  "subQuests": [
    {
      "subId": "7415101",
      "subQuestName": "Talk to Molli",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741510101"
        ],
        "dialogs": {
          "741510101": {
            "id": "741510101",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "Oh, you two, you're back!",
            "nextDialogs": [
              "741510102"
            ]
          },
          "741510102": {
            "id": "741510102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Paimon's name's Paimon, and {M#he}{F#she}'s {NICKNAME}. Just call us by our names from now on!",
            "nextDialogs": [
              "741510103"
            ]
          },
          "741510103": {
            "id": "741510103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did you come to see Benoit?",
            "nextDialogs": [
              "741510104"
            ]
          },
          "741510104": {
            "id": "741510104",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "That's right, but I didn't get a chance to speak to him... *sigh* Looks like I won't be able to finish my essay at this rate.",
            "nextDialogs": [
              "741510105"
            ]
          },
          "741510105": {
            "id": "741510105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Your essay? Oh, right! You were doing good deeds because you had homework.",
            "nextDialogs": [
              "741510106"
            ]
          },
          "741510106": {
            "id": "741510106",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "Hey, that's not true! I really do like Mr. Benoit. He's really... smooth! Yes, that's right, smooth.",
            "nextDialogs": [
              "741510107"
            ]
          },
          "741510107": {
            "id": "741510107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Pfft, what kind of descriptor is that? You mean he's personable and a good communicator, don't you?",
            "nextDialogs": [
              "741510108"
            ]
          },
          "741510108": {
            "id": "741510108",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "Anyway, please, Ms. Paimon, could you help me, please? If you don't, my essay's toast!",
            "nextDialogs": [
              "741510109"
            ]
          },
          "741510109": {
            "id": "741510109",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "My tutor said that my essay about helping him to feed his cat was \"Unpotentius and filled with genuine emotion from margin to margin,\" and she wanted me to write another.",
            "nextDialogs": [
              "741510110"
            ]
          },
          "741510110": {
            "id": "741510110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What? \"Unpotentius\"? Don't you mean \"Unpretentious\"? Anyway, Paimon gets it. So that's why you needed to come back.",
            "nextDialogs": [
              "741510111"
            ]
          },
          "741510111": {
            "id": "741510111",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "Well, it is my homework, sure, but I really do like Mr. Leroy. He wanted me to say hi to my parents for him, and so I did.",
            "nextDialogs": [
              "741510112"
            ]
          },
          "741510112": {
            "id": "741510112",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "They were really upset when they heard his name though, and they didn't want me to come. I don't really know why...",
            "nextDialogs": [
              "741510113"
            ]
          },
          "741510113": {
            "id": "741510113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, if it's just for homework, it's easy, isn't it? You can just talk about how you fed the cat again!",
            "nextDialogs": [
              "741510114"
            ]
          },
          "741510114": {
            "id": "741510114",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "But that would only be one line! That's too little, no way.",
            "nextDialogs": [
              "741510115"
            ]
          },
          "741510115": {
            "id": "741510115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll go with you.",
            "nextDialogs": [
              "741510116"
            ]
          },
          "741510116": {
            "id": "741510116",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah, that's right. You can feed the cat, and we'll clean the entrance and the rear of the house.",
            "nextDialogs": [
              "741510117"
            ]
          },
          "741510117": {
            "id": "741510117",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And when we're done, we'll knock on the door and talk to Benoit. That'll give you enough content to write about, right?",
            "nextDialogs": [
              "741510118"
            ]
          },
          "741510118": {
            "id": "741510118",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "That's right, we can do that! You're so smart, Ms. Paimon. Let me go feed the cat right now!"
          }
        }
      }
    },
    {
      "subId": "7415108",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741510801"
        ],
        "dialogs": {
          "741510801": {
            "id": "741510801",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Will this place do? C'mon, tell Paimon what's on your mind."
          }
        }
      }
    },
    {
      "subId": "7415109",
      "subQuestName": "Clean around the house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741510901"
        ],
        "dialogs": {
          "741510901": {
            "id": "741510901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's something off about that couple.",
            "nextDialogs": [
              "741510902"
            ]
          },
          "741510902": {
            "id": "741510902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon thinks so too. One of them talks a whole bunch, and the other barely says a word.",
            "nextDialogs": [
              "741510903"
            ]
          },
          "741510903": {
            "id": "741510903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The timing of their appearance was too convenient to be a coincidence.",
            "nextDialogs": [
              "741510904"
            ]
          },
          "741510904": {
            "id": "741510904",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You mean to say that they showed up just as Benoit was thinking about hiring some hourly help, right?",
            "nextDialogs": [
              "741510905"
            ]
          },
          "741510905": {
            "id": "741510905",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Euphrasie said that he was still hiring half a year ago, but in that time...",
            "nextDialogs": [
              "741510906"
            ]
          },
          "741510906": {
            "id": "741510906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This couple became his children.",
            "nextDialogs": [
              "741510907"
            ]
          },
          "741510907": {
            "id": "741510907",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You're right. Everything's just too deliberate... There's definitely something going on with this couple!"
          }
        }
      }
    },
    {
      "subId": "7415102",
      "subQuestName": "Clean around the house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7415110",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741511001"
        ],
        "dialogs": {
          "741511001": {
            "id": "741511001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's something fishy about their relationship with Benoit.",
            "nextDialogs": [
              "741511002"
            ]
          },
          "741511002": {
            "id": "741511002",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "When we first met them a few days back, things still seemed fine, but there's something... awkward about the way they spoke today.",
            "nextDialogs": [
              "741511004",
              "741511006"
            ]
          },
          "741511004": {
            "id": "741511004",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Are you talking about how that son-in-law guy gave him a look and made him go inside after he'd only said one or two things?",
            "nextDialogs": [
              "741511007"
            ]
          },
          "741511007": {
            "id": "741511007",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Now that you mention it, Paimon kinda gets where that confused feeling was coming from."
          },
          "741511006": {
            "id": "741511006",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, Paimon didn't quite think that far, but the way she spoke sure did give Paimon goosebumps..."
          }
        }
      }
    },
    {
      "subId": "7415103",
      "subQuestName": "Discuss with Molli",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741510301"
        ],
        "dialogs": {
          "741510301": {
            "id": "741510301",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "#Ms. Paimon, {M#Mr.}{F#Ms.} {NICKNAME}, I've fed the cat.",
            "nextDialogs": [
              "741510302"
            ]
          },
          "741510302": {
            "id": "741510302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Nice! Okay, let's go see Mr. Leroy.",
            "nextDialogs": [
              "741510303"
            ]
          },
          "741510303": {
            "id": "741510303",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "I'm worried, though. Maybe he won't come out? When I've come by to see him lately, he hasn't even spoken to me.",
            "nextDialogs": [
              "741510304"
            ]
          },
          "741510304": {
            "id": "741510304",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "Before you arrived, I went and knocked, but just as he came out, that scary son-in-law of his came and dragged him back inside.",
            "nextDialogs": [
              "741510305"
            ]
          },
          "741510305": {
            "id": "741510305",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "He then gave me some sweets and told me to go back to my parents. Then he shut the door.",
            "nextDialogs": [
              "741510306"
            ]
          },
          "741510306": {
            "id": "741510306",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Geez. Benoit's such a chill guy, so why are his family members such a chilly bunch?",
            "nextDialogs": [
              "741510307"
            ]
          },
          "741510307": {
            "id": "741510307",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "Mr. Leroy's son-in-law said that Mr. Leroy was ill and couldn't see me, but I thought he looked fine, so why couldn't he speak to us?",
            "nextDialogs": [
              "741510308"
            ]
          },
          "741510308": {
            "id": "741510308",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "Honestly, I'm more worried about Mr. Leroy than I am about my essay.",
            "nextDialogs": [
              "741510309"
            ]
          },
          "741510309": {
            "id": "741510309",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "He must feel terrible if he's ill. Mama told me that sick people need our care and concern.",
            "nextDialogs": [
              "741510310"
            ]
          },
          "741510310": {
            "id": "741510310",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "So, could you come with me to ask that son-in-law what sort of illness Mr. Leroy has?",
            "nextDialogs": [
              "741510311"
            ]
          },
          "741510311": {
            "id": "741510311",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "Maybe he ate too much cake, or he slept without a blanket? I can ask my parents about what to do!",
            "nextDialogs": [
              "741510314"
            ]
          },
          "741510314": {
            "id": "741510314",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "I know, I'm just... a bit scared of that scary son-in-law, because he's... well, scary. Could you help me speak to him?",
            "nextDialogs": [
              "741510315"
            ]
          },
          "741510315": {
            "id": "741510315",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Don't be afraid, Molli. We've got this."
          }
        }
      }
    },
    {
      "subId": "7415105",
      "subQuestName": "Knock on the door",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741510501"
        ],
        "dialogs": {
          "741510501": {
            "id": "741510501",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Athos, the man you saw before, opens the door and walks out.",
            "nextDialogs": [
              "741510502"
            ]
          },
          "741510502": {
            "id": "741510502",
            "speakerId": 1003,
            "speakerName": "Athos",
            "text": "You again? What in the world do you want?",
            "nextDialogs": [
              "741510503"
            ]
          },
          "741510503": {
            "id": "741510503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Could we ask if Benoit's home? We heard he fell ill, so we're kinda worried about his health.",
            "nextDialogs": [
              "741510504"
            ]
          },
          "741510504": {
            "id": "741510504",
            "speakerId": 1003,
            "speakerName": "Athos",
            "text": "My father is home, but he's in no condition to be receiving guests.",
            "nextDialogs": [
              "741510505"
            ]
          },
          "741510505": {
            "id": "741510505",
            "speakerId": 1000,
            "speakerName": "Molli",
            "text": "Could we ask what he's come down with? I could ask my parents to help get him some medicine.",
            "nextDialogs": [
              "741510506"
            ]
          },
          "741510506": {
            "id": "741510506",
            "speakerId": 1003,
            "speakerName": "Athos",
            "text": "No need. We'll buy what medicines are needed ourselves — not that he has any lack of medicine, anyway.",
            "nextDialogs": [
              "741510507"
            ]
          },
          "741510507": {
            "id": "741510507",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We're just concerned for his health. You don't have to be so cold...",
            "nextDialogs": [
              "741510508"
            ]
          },
          "741510508": {
            "id": "741510508",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "(Athos just doesn't want to let us see Benoit!)",
            "nextDialogs": [
              "741510511"
            ]
          },
          "741510511": {
            "id": "741510511",
            "speakerId": 1003,
            "speakerName": "Athos",
            "text": "You concern yourself too much with business that is not your own. Very well. Was there anything else? If not, I'll be heading back.",
            "nextDialogs": [
              "741510512"
            ]
          },
          "741510512": {
            "id": "741510512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wait.",
            "nextDialogs": [
              "741510513"
            ]
          },
          "741510513": {
            "id": "741510513",
            "speakerId": 1003,
            "speakerName": "Athos",
            "text": "What is it?"
          }
        }
      }
    },
    {
      "subId": "7415112",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741511101"
        ],
        "dialogs": {
          "741511101": {
            "id": "741511101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The way this couple deals with outsiders doesn't sit right with me.",
            "nextDialogs": [
              "741511102"
            ]
          },
          "741511102": {
            "id": "741511102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Exactly. They were nice enough when we first met them, but they sure turned rotten quickly.",
            "nextDialogs": [
              "741511103"
            ]
          },
          "741511103": {
            "id": "741511103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They were only friendly to us when their father was around.",
            "nextDialogs": [
              "741511104"
            ]
          },
          "741511104": {
            "id": "741511104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... Let Paimon think. That's true. The first time we met, it was right after Benoit went inside that his son-in-law told us not to come around again.",
            "nextDialogs": [
              "741511105"
            ]
          },
          "741511105": {
            "id": "741511105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They're faking it.",
            "nextDialogs": [
              "741511106"
            ]
          },
          "741511106": {
            "id": "741511106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But why would they pretend to be friendly in front of their dad? There's gotta be a reason for it..."
          }
        }
      }
    },
    {
      "subId": "7415106",
      "subQuestName": "Go to the side and talk with Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741511201"
        ],
        "dialogs": {
          "741511201": {
            "id": "741511201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, that's all I've got for now.",
            "nextDialogs": [
              "741511202"
            ]
          },
          "741511202": {
            "id": "741511202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Um, {NICKNAME}... Do you think Benoit's in some kinda danger?",
            "nextDialogs": [
              "741511203"
            ]
          },
          "741511203": {
            "id": "741511203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Indeed.",
            "nextDialogs": [
              "741511204"
            ]
          },
          "741511204": {
            "id": "741511204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ohhh, Paimon's got a bad feeling about this. Should we report it to the Maison Gardiennage?",
            "nextDialogs": [
              "741511208"
            ]
          },
          "741511208": {
            "id": "741511208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm, that's true, that's true. But in the end, we're here to help him, right?",
            "nextDialogs": [
              "741511209"
            ]
          },
          "741511209": {
            "id": "741511209",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Molli asked us to tell Benoit that his snacks were super tasty, and we gave her our word.",
            "nextDialogs": [
              "741511210"
            ]
          },
          "741511210": {
            "id": "741511210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And our word is our sacred bond.",
            "nextDialogs": [
              "741511211"
            ]
          },
          "741511211": {
            "id": "741511211",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe, Paimon knows you always keep your promises! Well, you've got a good brain, too, so what's our next move?",
            "nextDialogs": [
              "741511212"
            ]
          },
          "741511212": {
            "id": "741511212",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's do some investigating.",
            "nextDialogs": [
              "741511213"
            ]
          },
          "741511213": {
            "id": "741511213",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah, let's get to the bottom of this case! Hmm... What should we investigate, specifically?"
          }
        }
      }
    },
    {
      "subId": "7415005",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741500501"
        ],
        "dialogs": {
          "741500501": {
            "id": "741500501",
            "speakerId": 1003,
            "speakerName": "Athos",
            "text": "Have you been sleeping well lately, Dad? Still suffering from insomnia?",
            "nextDialogs": [
              "741500502"
            ]
          },
          "741500502": {
            "id": "741500502",
            "speakerId": 1004,
            "speakerName": "Benoit Leroy",
            "text": "Oh, I'm much better. Don't even have nightmares nowadays...",
            "nextDialogs": [
              "741500503"
            ]
          },
          "741500503": {
            "id": "741500503",
            "speakerId": 1005,
            "speakerName": "Door",
            "text": "(The voices of the Leroy family grow less distinct...)"
          }
        }
      }
    },
    {

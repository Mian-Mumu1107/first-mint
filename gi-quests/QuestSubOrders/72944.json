            ]
          },
          "729440104": {
            "id": "729440104",
            "speakerId": 30544,
            "speakerName": "Langqing",
            "text": "That Fontainian musician — you know, the one that carries a guitar around — said it was alright for me to record the final version of his lyrics and sell them on as music merchandise.",

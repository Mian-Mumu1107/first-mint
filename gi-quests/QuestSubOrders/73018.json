    {
      "subId": "7301809",
      "subQuestName": "Head into the depths",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730180901"
        ],
        "dialogs": {
          "730180901": {
            "id": "730180901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Th—This is much deeper than the Ruins of Dahri... Paimon didn't expect this place to be so deep underground.",
            "nextDialogs": [
              "730180902"
            ]
          },
          "730180902": {
            "id": "730180902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And there are so many spores! Just seeing them is unbearable enough...",
            "nextDialogs": [
              "730180903"
            ]
          },
          "730180903": {
            "id": "730180903",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "The spores are covering the Varuna Contraption...",
            "nextDialogs": [
              "730180904"
            ]
          },
          "730180904": {
            "id": "730180904",
            "speakerId": 1004,
            "speakerName": "Aranakula",
            "text": "It must've been left by the bad guys... Ugh... The bad guys could be close by...",
            "nextDialogs": [
              "730180905"
            ]
          },
          "730180905": {
            "id": "730180905",
            "speakerId": 1002,
            "speakerName": "Arabalika",
            "text": "Toughen up, Aranakula. Do not back down. We are already here. We solve the problem, whether it be spores or Fungi. This is all for Vana.",
            "nextDialogs": [
              "730180906"
            ]
          },
          "730180906": {
            "id": "730180906",
            "speakerId": 1003,
            "speakerName": "Arakunti",
            "text": "The Varuna Contraption must be very sad to be covered by spores like this.",
            "nextDialogs": [
              "730180907"
            ]
          },
          "730180907": {
            "id": "730180907",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yes... Being covered by spores... Just the thought of it is kinda scary...",
            "nextDialogs": [
              "730180908"
            ]
          },
          "730180908": {
            "id": "730180908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's hurry and clear the spores away.",
            "nextDialogs": [
              "730180909"
            ]
          },
          "730180909": {
            "id": "730180909",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yup! We'll handle this just like when we cleaned the Yasna Monument up, eh?"
          }
        }
      }
    },
    {
      "subId": "7301810",
      "subQuestName": "Clear the spores",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730181001"
        ],
        "dialogs": {
          "730181001": {
            "id": "730181001",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "#Aranara are not too late, but... bad seeds grow faster than good seeds. Oh, Nara {NICKNAME}, please clear the bad seeds away..."
          }
        }
      }
    },
    {
      "subId": "7301811",

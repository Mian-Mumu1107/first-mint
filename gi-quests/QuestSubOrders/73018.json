    {
      "subId": "7301821",
      "subQuestName": "Talk to Arapandu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730182101"
        ],
        "dialogs": {
          "730182101": {
            "id": "730182101",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon thinks we're safe... for now?",
            "nextDialogs": [
              "730182102"
            ]
          },
          "730182102": {
            "id": "730182102",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "#Nara {NICKNAME}, thank you for your bravery. The bad bugs gnawing on the roots of the Varuna Contraption have been cleared away.",
            "nextDialogs": [
              "730182103"
            ]
          },
          "730182103": {
            "id": "730182103",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "The branches scattered all over Vana are also sending us their power. Now Aranara can heal the Varuna Contraption.",
            "nextDialogs": [
              "730182104"
            ]
          },
          "730182104": {
            "id": "730182104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It was no trouble.",
            "nextDialogs": [
              "730182105"
            ]
          },
          "730182105": {
            "id": "730182105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon told you, the Fungi are nothing! Paimon wouldn't be scared even if there were ten more of them! Heh!",
            "nextDialogs": [
              "730182107",
              "730182109"
            ]
          },
          "730182107": {
            "id": "730182107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Paimon knew you wouldn't be scared of the Fungi, {NICKNAME}. Hehe...",
            "nextDialogs": [
              "730182110"
            ]
          },
          "730182110": {
            "id": "730182110",
            "speakerId": 1004,
            "speakerName": "Aranakula",
            "text": "Everyone was doing their best to fight the bad guys earlier. And then there was Paimon...",
            "nextDialogs": [
              "730182111"
            ]
          },
          "730182111": {
            "id": "730182111",
            "speakerId": 1003,
            "speakerName": "Arakunti",
            "text": "Not a drop of effort!",
            "nextDialogs": [
              "730182112"
            ]
          },
          "730182112": {
            "id": "730182112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#That's not true! P—Paimon gave it her all to cheer for {NICKNAME}! C'mon, {NICKNAME}, you felt Paimon's sincerity, didn't you!?"
          },
          "730182109": {
            "id": "730182109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Come on. No way!"
          }
        }
      }
    },
    {
      "subId": "7301822",
      "subQuestName": "Talk to Arapandu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730182201"
        ],
        "dialogs": {
          "730182201": {
            "id": "730182201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow! The air is much cleaner now!",
            "nextDialogs": [
              "730182202"
            ]
          },
          "730182202": {
            "id": "730182202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I can breathe freely now.",
            "nextDialogs": [
              "730182203"
            ]
          },
          "730182203": {
            "id": "730182203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe, peace returns to the Ashavan Realm! Paimon doesn't know about those Fungi in the forest though...",
            "nextDialogs": [
              "730182204"
            ]
          },
          "730182204": {
            "id": "730182204",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "After that, the bad guys may leave, or they may not. But the Varuna Contraption has already been healed, and there won't be so many spores anymore. Aranara will not let the bad guys destroy Vana.",
            "nextDialogs": [
              "730182205"
            ]
          },
          "730182205": {
            "id": "730182205",
            "speakerId": 1004,
            "speakerName": "Aranakula",
            "text": "The nurseries will be revived too, right...?",
            "nextDialogs": [
              "730182206"
            ]
          },
          "730182206": {
            "id": "730182206",
            "speakerId": 1002,
            "speakerName": "Arabalika",
            "text": "But Marana is still here. Aranara have a lot to do.",
            "nextDialogs": [
              "730182207"
            ]
          },
          "730182207": {
            "id": "730182207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh, you're so strict, Arabalika. We've finished one thing, haven't we? Just let Aranakula be happy for a bit!",
            "nextDialogs": [
              "730182208"
            ]
          },
          "730182208": {
            "id": "730182208",
            "speakerId": 1002,
            "speakerName": "Arabalika",
            "text": "Hmph.",
            "nextDialogs": [
              "730182209"
            ]
          },
          "730182209": {
            "id": "730182209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Same old Arabalika.",
            "nextDialogs": [
              "730182210"
            ]
          },
          "730182210": {
            "id": "730182210",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "*sigh*... Paimon doesn't know what will satisfy him.",
            "nextDialogs": [
              "730182211"
            ]
          },
          "730182211": {
            "id": "730182211",
            "speakerId": 1002,
            "speakerName": "Arabalika",
            "text": "No sense of urgency. Paimon is careless. Will get into trouble.",
            "nextDialogs": [
              "730182212"
            ]
          },
          "730182212": {
            "id": "730182212",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, Paimon's heard that one before. Paimon's not careless! Paimon's always careful!",
            "nextDialogs": [
              "730182213"
            ]
          },
          "730182213": {
            "id": "730182213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Looks like somebody hasn't learned their lesson.",
            "nextDialogs": [
              "730182214"
            ]
          },
          "730182214": {
            "id": "730182214",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Oh right, {NICKNAME}. Wasn't there something else we wanted to ask Arapandu?",
            "nextDialogs": [
              "730182215"
            ]
          },
          "730182215": {
            "id": "730182215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the children of Vimara Village...",
            "nextDialogs": [
              "730182216"
            ]
          },
          "730182216": {
            "id": "730182216",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's about the odd things that have happened in Vimara Village to the east. The children living there sometimes disappear for a period of time, but will always return safely...",
            "nextDialogs": [
              "730182217"
            ]
          },
          "730182217": {
            "id": "730182217",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon's sure that you Aranara know more about the forest than we do. It would be great if you do know something.",
            "nextDialogs": [
              "730182218"
            ]
          },
          "730182218": {
            "id": "730182218",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "Strange things about Vimara Village... Arapandu doesn't know now, but Arapandu will make a note of it. Other Aranara might know.",
            "nextDialogs": [
              "730182219"
            ]
          },
          "730182219": {
            "id": "730182219",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "Arapandu will return to Vanarana later. Perhaps the answer will emerge then.",
            "nextDialogs": [
              "730182220"
            ]
          },
          "730182220": {
            "id": "730182220",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "#About the Varuna Contraption... Nara {NICKNAME}, now you know that Aranara music can control the contraption.",
            "nextDialogs": [
              "730182221"
            ]
          },
          "730182221": {
            "id": "730182221",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Hmm. {NICKNAME}, you've studied Aranara music before as well, right? Does that mean that we can control the Varuna Contraption too?",
            "nextDialogs": [
              "730182222"
            ]
          },
          "730182222": {
            "id": "730182222",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "#Nara {NICKNAME}, like Nara Varuna, has been proven to be worthy of Aranara's friendship.",
            "nextDialogs": [
              "730182223"
            ]
          },
          "730182223": {
            "id": "730182223",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "Arapandu is willing to teach you the music to control the Varuna Contraption.",
            "nextDialogs": [
              "730182224"
            ]
          },
          "730182224": {
            "id": "730182224",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Great! But will we really have to go so deep underground every time we play...",
            "nextDialogs": [
              "730182225"
            ]
          },
          "730182225": {
            "id": "730182225",
            "speakerId": 1003,
            "speakerName": "Arakunti",
            "text": "Paimon is not very smart. The Varuna Contraption gets power from all over Vana...",
            "nextDialogs": [
              "730182226"
            ]
          },
          "730182226": {
            "id": "730182226",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So you can also control the Varuna Contraption from other parts of Vana.",
            "nextDialogs": [
              "730182227"
            ]
          },
          "730182227": {
            "id": "730182227",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Come on, that's Aranara trivia! You can't expect us to recall all that!",
            "nextDialogs": [
              "730182228"
            ]
          },
          "730182228": {
            "id": "730182228",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "You master the Rhythm of the Source Water.",
            "nextDialogs": [
              "730182229"
            ]
          },
          "730182229": {
            "id": "730182229",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "#Nara {NICKNAME}, Paimon, thank you for your help. Vana will never forget this, and neither will Aranara...",
            "nextDialogs": [
              "730182230"
            ]
          },
          "730182230": {
            "id": "730182230",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I hope to see you at Festival Utsava.",
            "nextDialogs": [
              "730182231"
            ]
          },
          "730182231": {
            "id": "730182231",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "We will meet again in Vanarana. May you have a carefree time, Golden Nara, and may Aramuhukunda watch over you."
          }
        }
      }
    },

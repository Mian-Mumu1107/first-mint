    {
      "subId": "7301805",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730180501"
        ],
        "dialogs": {
          "730180501": {
            "id": "730180501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's even more impressive when you see it up close...",
            "nextDialogs": [
              "730180502"
            ]
          },
          "730180502": {
            "id": "730180502",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "The Varuna Contraption is a creation of the Lord of Dendro. It sends forth water that brings life, turning Valuka into Vana, replacing that which was once yellow with green, and turning barren land into a land full of life.",
            "nextDialogs": [
              "730180503"
            ]
          },
          "730180503": {
            "id": "730180503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It sounds miraculous. \"Water that brings life\"... Wow...",
            "nextDialogs": [
              "730180504"
            ]
          },
          "730180504": {
            "id": "730180504",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Speaking of which, Paimon ate the soup Arapas made earlier. That was made with the water from here, right?",
            "nextDialogs": [
              "730180505"
            ]
          },
          "730180505": {
            "id": "730180505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "His soup doesn't have a special effect, right...",
            "nextDialogs": [
              "730180507",
              "730180516"
            ]
          },
          "730180507": {
            "id": "730180507",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Would that happen you, or Paimon?"
          },
          "730180516": {
            "id": "730180516",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, it might be possible to live long enough to eat every dish in Teyvat that way!",
            "nextDialogs": [
              "730180517"
            ]
          },
          "730180517": {
            "id": "730180517",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But where will those who share the taste be then...?",
            "nextDialogs": [
              "730180518"
            ]
          },
          "730180518": {
            "id": "730180518",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... Guess living too long is not entirely a good thing, huh..."
          }
        }
      }
    }
  ]

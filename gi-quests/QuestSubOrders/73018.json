    {
      "subId": "7301813",
      "subQuestName": "Defeat the Fungi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730181301"
        ],
        "dialogs": {
          "730181301": {
            "id": "730181301",
            "speakerId": 1000,
            "speakerName": "Arapandu",
            "text": "Arapandu will look for answers about Vimara Village too. Please be patient."
          }
        }
      }
    },
    {
      "subId": "7301814",
      "subQuestName": "Defeat the Fungi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730181401"
        ],
        "dialogs": {
          "730181401": {
            "id": "730181401",
            "speakerId": 1004,
            "speakerName": "Aranakula",
            "text": "#Is Nara {NICKNAME} going to take care of the nursery with Aranakula? There is nothing there yet...",
            "nextDialogs": [
              "730181402"
            ]
          },
          "730181402": {
            "id": "730181402",
            "speakerId": 1004,
            "speakerName": "Aranakula",
            "text": "But if you plant seeds, they will soon grow into beautiful flowers..."
          }
        }
      }
    },
    {
      "subId": "7301816",
      "subQuestName": "Defeat the Fungi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730181601"
        ],
        "dialogs": {
          "730181601": {
            "id": "730181601",
            "speakerId": 1002,
            "speakerName": "Arabalika",
            "text": "Hmph.",
            "nextDialogs": [
              "730181602"
            ]
          },
          "730181602": {
            "id": "730181602",
            "speakerId": 1002,
            "speakerName": "Arabalika",
            "text": "...",
            "nextDialogs": [
              "730181603"
            ]
          },
          "730181603": {
            "id": "730181603",
            "speakerId": 1002,
            "speakerName": "Arabalika",
            "text": "#Nara {NICKNAME}. Do not be as careless as Paimon."
          }
        }
      }
    },
    {
      "subId": "7301817",
      "subQuestName": "Defeat the Fungi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730181701"
        ],
        "dialogs": {
          "730181701": {
            "id": "730181701",
            "speakerId": 1003,
            "speakerName": "Arakunti",
            "text": "Golden Nara! Heeey ♪",
            "nextDialogs": [
              "730181702"
            ]
          },
          "730181702": {
            "id": "730181702",
            "speakerId": 1003,
            "speakerName": "Arakunti",
            "text": "Mushrooms yummy! Hey hey ♪",
            "nextDialogs": [
              "730181703"
            ]
          },
          "730181703": {
            "id": "730181703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Arakunti seems to be fully immersed in the music.)"
          }
        }
      }
    },

    {
      "subId": "7213101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721310101"
        ],
        "dialogs": {
          "721310101": {
            "id": "721310101",
            "speakerId": 1002,
            "speakerName": "Observe",
            "text": "The strange stone lantern seems to emit an ominous energy.",
            "nextDialogs": [
              "721310102"
            ]
          },
          "721310102": {
            "id": "721310102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Is this... a stone lantern? Why is there a stone lantern here?",
            "nextDialogs": [
              "721310103"
            ]
          },
          "721310103": {
            "id": "721310103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, someone's written something on the lamp post. Shall we go have a look?",
            "nextDialogs": [
              "721310104"
            ]
          },
          "721310104": {
            "id": "721310104",
            "speakerId": 1002,
            "speakerName": "Observe",
            "text": "\"Fellow workers, if you have any questions about this ward, please go to the Musoujin Gorge and talk to Mr. Kaji.\"",
            "nextDialogs": [
              "721310105"
            ]
          },
          "721310105": {
            "id": "721310105",
            "speakerId": 1002,
            "speakerName": "Observe",
            "text": "The handwriting looks new. There are a few small rough lines of writing below:",
            "nextDialogs": [
              "721310106"
            ]
          },
          "721310106": {
            "id": "721310106",
            "speakerId": 1002,
            "speakerName": "Observe",
            "text": "\"I'm sorry, but we can't help you either. We just received evacuation orders from the commissioner yesterday.",
            "nextDialogs": [
              "721310107"
            ]
          },
          "721310107": {
            "id": "721310107",
            "speakerId": 1002,
            "speakerName": "Observe",
            "text": "\"I hope I can see you again someday and discuss how to solve our Tatarigami problem.\"",
            "nextDialogs": [
              "721310108"
            ]
          },
          "721310108": {
            "id": "721310108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This Mr. Kaji seems to be pretty concerned about these stone lanterns. Why don't we go to Musoujin Gorge and ask him?"
          }
        }
      }
    },
    {
      "subId": "7213103",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721310301"
        ],
        "dialogs": {
          "721310301": {
            "id": "721310301",
            "speakerId": 1003,
            "speakerName": "Touch Ward",
            "text": "The lantern has finally been repaired. The weather seems to have changed as well."
          }
        }
      }
    },
    {
      "subId": "7213104",

  "subQuests": [
    {
      "subId": "7213104",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721330101"
        ],
        "dialogs": {
          "721330101": {
            "id": "721330101",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "Hello! Excuse me, outlander. Could you hear me out?",
            "nextDialogs": [
              "721330102"
            ]
          },
          "721330102": {
            "id": "721330102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's up?",
            "nextDialogs": [
              "721330103"
            ]
          },
          "721330103": {
            "id": "721330103",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "Please don't linger on this island for too long. Recently, the Tatarigami's reach has spread wider and wider.",
            "nextDialogs": [
              "721330104"
            ]
          },
          "721330104": {
            "id": "721330104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Tatarigami\"?",
            "nextDialogs": [
              "721330105"
            ]
          },
          "721330105": {
            "id": "721330105",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "Yes, since the people from Sangonomiya destroyed the ward that suppressed the soul of the serpent god, the Tatarigami has spread across the island...",
            "nextDialogs": [
              "721330106"
            ]
          },
          "721330106": {
            "id": "721330106",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "As you can see, the sky is now perpetually clouded and the rain won't stop. This is all because of the Tatarigami.",
            "nextDialogs": [
              "721330107"
            ]
          },
          "721330107": {
            "id": "721330107",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "Recently, one by one all the miners have fallen ill, gone insane, or fled to other islands...",
            "nextDialogs": [
              "721330108"
            ]
          },
          "721330108": {
            "id": "721330108",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "Everyone's gone. There's hardly anyone living on this island anymore.",
            "nextDialogs": [
              "721330109"
            ]
          },
          "721330109": {
            "id": "721330109",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "Ironically, due to the chaos created by the Tatarigami, the Shogunate and the rebels have not been fighting over this place quite as hard.",
            "nextDialogs": [
              "721330110"
            ]
          },
          "721330110": {
            "id": "721330110",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "Hmph! But if they had not destroyed our great Ogosho's ward, the island wouldn't have become such a mess in the first place!",
            "nextDialogs": [
              "721330111"
            ]
          },
          "721330111": {
            "id": "721330111",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "What do the Commissions or dragons or serpents have to do with me, huh? They never asked my opinion before starting their cursed war!",
            "nextDialogs": [
              "721330112"
            ]
          },
          "721330112": {
            "id": "721330112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Then why are you still here?",
            "nextDialogs": [
              "721330113"
            ]
          },
          "721330113": {
            "id": "721330113",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "Why? Because this is my home.",
            "nextDialogs": [
              "721330114"
            ]
          },
          "721330114": {
            "id": "721330114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What about your family?",
            "nextDialogs": [
              "721330115"
            ]
          },
          "721330115": {
            "id": "721330115",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "They are in a safe place, but thanks for your concern. They must be waiting for me to bring them back here.",
            "nextDialogs": [
              "721330116"
            ]
          },
          "721330116": {
            "id": "721330116",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "No one on the island left voluntarily. We are a family here. Anywhere else we go, we'll have to work for someone else.",
            "nextDialogs": [
              "721330117"
            ]
          },
          "721330117": {
            "id": "721330117",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "But someone had to stay and clean up the mess so that everyone else can return home eventually.",
            "nextDialogs": [
              "721330118"
            ]
          },
          "721330118": {
            "id": "721330118",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "*sigh* This is such a headache...",
            "nextDialogs": [
              "721330119"
            ]
          },
          "721330119": {
            "id": "721330119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is there anything I can help with?",
            "nextDialogs": [
              "721330120"
            ]
          },
          "721330120": {
            "id": "721330120",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "If it were any other child offering to help me out of the blue, I'd be laughing out loud right now...",
            "nextDialogs": [
              "721330121"
            ]
          },
          "721330121": {
            "id": "721330121",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "But seeing as you're a traveler from afar who has managed to venture this deep into Inazuma, you must certainly be able to hold your own.",
            "nextDialogs": [
              "721330122"
            ]
          },
          "721330122": {
            "id": "721330122",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "I'll get straight to the point, then. The ward over there has been bothering me for a long time, maybe you could find a way to repair it?",
            "nextDialogs": [
              "721330123"
            ]
          },
          "721330123": {
            "id": "721330123",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "I'm sure that this awful weather can only be due to the wards' destruction.",
            "nextDialogs": [
              "721330124"
            ]
          },
          "721330124": {
            "id": "721330124",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "But please, be careful when you approach the ward. If you stare at it, it will release a burst of energy towards you...",
            "nextDialogs": [
              "721330125"
            ]
          },
          "721330125": {
            "id": "721330125",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "It's harmless, but very uncomfortable. It feels like it's... rejecting you.",
            "nextDialogs": [
              "721330126"
            ]
          },
          "721330126": {
            "id": "721330126",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "I think the ward is missing some components. It can probably be fixed by putting the missing parts back.",
            "nextDialogs": [
              "721330127"
            ]
          },
          "721330127": {
            "id": "721330127",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "Of course, that's just speculation on my part. I still can't say for sure what's gone wrong.",
            "nextDialogs": [
              "721330128"
            ]
          },
          "721330128": {
            "id": "721330128",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "So, if you want to help, please help me fix this ward.",
            "nextDialogs": [
              "721330129"
            ]
          },
          "721330129": {
            "id": "721330129",
            "speakerId": 1000,
            "speakerName": "Kaji",
            "text": "But if you can't manage it, then like I was saying — don't stick around here too long."
          }
        }
      }
    },
    {
      "subId": "7213105",
      "subQuestName": "Search for the ward in the Jakotsu Mine",
      "sceneId": null,
      "locations": [],
      "dialogue": {

          },
          "700220109": {
            "id": "700220109",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "Haha, it said that it's very happy to make friends with us. But we need to do one small favor for it first...",
            "nextDialogs": [
              "700220110"
            ]
          },
          "700220110": {
            "id": "700220110",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "We need to help it defeat a challenging enemy. I've marked the location on the Map for you.",
            "nextDialogs": [
              "700220111"
            ]
          },
          "700220111": {
            "id": "700220111",
            "speakerId": 1000,
            "speakerName": "Curious Hilichurl",
            "text": "Dada, Valo!",
            "nextDialogs": [
              "700220112"
            ]
          },
          "700220112": {
            "id": "700220112",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "Valo!"
          }
        }

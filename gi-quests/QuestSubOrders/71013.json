    {
      "subId": "7101302",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710130201"
        ],
        "dialogs": {
          "710130201": {
            "id": "710130201",
            "speakerId": 20113,
            "speakerName": "Ruins Treasure",
            "text": "I was fortunate enough to receive my <color=#00E1FFFF>Vision</color>. But still, there was doubt in my mind: Is it truly within the power of mere mortals to one day cleanse the world of the monsters that have long plagued it? And how different from mankind are these monsters to begin with, save in outward appearance? Is it not so that just like us, they, too, speak; they, too, build; and they, too, feel love and hate, joy and grief...",
            "nextDialogs": [
              "710130202"
            ]
          },
          "710130202": {
            "id": "710130202",
            "speakerId": 20113,
            "speakerName": "Ruins Treasure",
            "text": "I hereby inscribe my mind's greatest perplexion onto this monument. O, reader in the far-flung future, will you be the one to resolve this riddle?"
          }
        }
      }
    },
    {
      "subId": "7101303",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {

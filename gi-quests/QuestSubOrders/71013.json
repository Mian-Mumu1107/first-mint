  "subQuests": [
    {
      "subId": "7101316",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710130101"
        ],
        "dialogs": {
          "710130101": {
            "id": "710130101",
            "speakerId": 20113,
            "speakerName": "Ruins Treasure",
            "text": "My fellow disciple and I trained in the martial arts from childhood. Our quest was to fight the forces of evil and protect all that is sacred in this world. But this was no easy task without the aid of a <color=#00E1FFFF>Vision</color>.",
            "nextDialogs": [
              "710130102"
            ]
          },
          "710130102": {
            "id": "710130102",
            "speakerId": 20113,
            "speakerName": "Ruins Treasure",
            "text": "We two sought refuge here to train ourselves further and to seek the <color=#00E1FFFF>Visions</color> that we desired. We erected this monument in testament to our endeavors."
          }
        }
      }
    },
    {
      "subId": "7101301",

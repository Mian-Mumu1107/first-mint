        ],
        "dialogs": {
          "741832801": {
            "id": "741832801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, those examples weren't very convincing, were they...",
            "nextDialogs": [
              "741832802"
            ]
          },
          "741832802": {
            "id": "741832802",
            "speakerId": 21430,
            "speakerName": "Monsieur Os",
            "text": "...",
            "nextDialogs": [
              "741832803"
            ]
          },
          "741832803": {
            "id": "741832803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "C—C'mon, Osse, no amount of suspicious looks is going to suddenly give us better options!",
            "nextDialogs": [
              "741832804"
            ]
          },
          "741832804": {
            "id": "741832804",
            "speakerId": 21430,
            "speakerName": "Monsieur Os",
            "text": "*sigh* I know. You're right. Let's give it a try.",
            "nextDialogs": [
              "741832805"
            ]
          },
          "741832805": {
            "id": "741832805",
            "speakerId": 21430,
            "speakerName": "Monsieur Os",
            "text": "The seals that bind the evil dragon seem to be connected to three locations. Let us begin by removing the chains in those three places."
          }
        }
      }
    },

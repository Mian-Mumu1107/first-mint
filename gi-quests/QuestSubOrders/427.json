    {
      "subId": "42704",
      "subQuestName": "Talk to Amber",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4270401"
        ],
        "dialogs": {
          "4270401": {
            "id": "4270401",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Hahaha... Seems like you've got the hang of wind gliding now! Let's do the final stage.",
            "nextDialogs": [
              "4270402"
            ]
          },
          "4270402": {
            "id": "4270402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Easy! You've flown this way before anyway...",
            "nextDialogs": [
              "4270403"
            ]
          },
          "4270403": {
            "id": "4270403",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Once you've passed this final stage, you'll finally be able to get your very own gliding license.",
            "nextDialogs": [
              "4270404"
            ]
          },
          "4270404": {
            "id": "4270404",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Just keep thinking about that license. Ready...",
            "nextDialogs": [
              "4270405"
            ]
          },
          "4270405": {
            "id": "4270405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Go!"
          }
        }
      }
    },

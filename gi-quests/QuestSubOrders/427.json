          },
          "4270203": {
            "id": "4270203",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Same deal as before, glide through the markers and get to the finish without stopping in the middle.",
            "nextDialogs": [
              "4270204"
            ]
          },
          "4270204": {
            "id": "4270204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm ready."
          }
        }

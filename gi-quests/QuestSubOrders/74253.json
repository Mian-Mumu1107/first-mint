          "742530201"
        ],
        "dialogs": {
          "742530201": {
            "id": "742530201",
            "speakerId": 1001,
            "speakerName": "Mary-Ann",
            "text": "Life is best when all is peaceful and calm...",
            "nextDialogs": [
              "742530202"
            ]
          },
          "742530202": {
            "id": "742530202",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "(Let's sit like this for a little while longer.)",
            "nextDialogs": [
              "742530204"
            ]
          },
          "742530204": {
            "id": "742530204",
            "speakerId": 1001,
            "speakerName": "Mary-Ann",
            "text": "Is that the time? Haha. We should get together more often, Miss Sandrone."
          }
        }
      }
    },

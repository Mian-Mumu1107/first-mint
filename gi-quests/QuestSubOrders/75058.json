    {
      "subId": "7500133",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750013301"
        ],
        "dialogs": {
          "750013301": {
            "id": "750013301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Strange... The golden patterns flew right over, just as before, but the Inscription hasn't appeared beneath this pillar... Why's that?",
            "nextDialogs": [
              "750013302"
            ]
          },
          "750013302": {
            "id": "750013302",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "That indicates that not only has the Inscription been squeezed out, but it's also become fragmented... This is bad. We need to find any scattered bits, and fast.",
            "nextDialogs": [
              "750013303"
            ]
          },
          "750013303": {
            "id": "750013303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, where do we find them?",
            "nextDialogs": [
              "750013304"
            ]
          },
          "750013304": {
            "id": "750013304",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "...I don't know either.",
            "nextDialogs": [
              "750013305"
            ]
          },
          "750013305": {
            "id": "750013305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh...",
            "nextDialogs": [
              "750013306"
            ]
          },
          "750013306": {
            "id": "750013306",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "They should still be held down by some power despite being scattered, so my guess is that they're nearby. Maybe we just need to look around...",
            "nextDialogs": [
              "750013307"
            ]
          },
          "750013307": {
            "id": "750013307",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr, rawr!",
            "nextDialogs": [
              "750013308"
            ]
          },
          "750013308": {
            "id": "750013308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm? You wanna go over? We're doing something important right now — we'll play with you later, alright?",
            "nextDialogs": [
              "750013309"
            ]
          },
          "750013309": {
            "id": "750013309",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Mrrraa... Rawr! Rawr!",
            "nextDialogs": [
              "750013310"
            ]
          },
          "750013310": {
            "id": "750013310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you mean that the Inscription is over there?",
            "nextDialogs": [
              "750013311"
            ]
          },
          "750013311": {
            "id": "750013311",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750013312"
            ]
          },
          "750013312": {
            "id": "750013312",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "Oh wow! I've heard that even now, there are still Saurians who can sense an Inscription's power, but I always thought it was hearsay — could it be true?",
            "nextDialogs": [
              "750013313"
            ]
          },
          "750013313": {
            "id": "750013313",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "#I suppose you really are no ordinary Tepetlisaurus, {REALNAME[ID(2)|SHOWHOST(true)]}.",
            "nextDialogs": [
              "750013314"
            ]
          },
          "750013314": {
            "id": "750013314",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So you can do that too, huh? ...Hmph! You've got some way to go before you can be as good a guide as Paimon.",
            "nextDialogs": [
              "750013315"
            ]
          },
          "750013315": {
            "id": "750013315",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Hmm?",
            "nextDialogs": [
              "750013317",
              "750013319"
            ]
          },
          "750013317": {
            "id": "750013317",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Says who? Paimon's way more broad-minded than she looks! That was just her way of praising him!",
            "nextDialogs": [
              "750013320"
            ]
          },
          "750013320": {
            "id": "750013320",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Err... Err?",
            "nextDialogs": [
              "750013321"
            ]
          },
          "750013321": {
            "id": "750013321",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*sigh* The little guy didn't catch that at all. Bah, if only he was a little smarter...",
            "nextDialogs": [
              "750013322"
            ]
          },
          "750013322": {
            "id": "750013322",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm sure he'll understand someday...",
            "nextDialogs": [
              "750013323"
            ]
          },
          "750013323": {
            "id": "750013323",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "Precisely. Those in the tribe responsible for Saurian care always say that it takes time to truly establish a rapport with them.",
            "nextDialogs": [
              "750013324"
            ]
          },
          "750013324": {
            "id": "750013324",
            "speakerId": 21719,
            "speakerName": "Titu",
            "text": "The secret to success is as follows — exercise patience, and constantly communicate. Whether humans wish to understand Saurians, or Saurians humans, they both need... lots and lots of time.",
            "nextDialogs": [
              "750013325"
            ]
          },
          "750013325": {
            "id": "750013325",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#True... Just like Paimon didn't get what {REALNAME[ID(2)|SHOWHOST(true)]} was trying to tell us just now either.",
            "nextDialogs": [
              "750013326"
            ]
          },
          "750013326": {
            "id": "750013326",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Sorry, {REALNAME[ID(2)|SHOWHOST(true)]}.",
            "nextDialogs": [
              "750013327"
            ]
          },
          "750013327": {
            "id": "750013327",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrraa, Rawr!",
            "nextDialogs": [
              "750013328"
            ]
          },
          "750013328": {
            "id": "750013328",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're quick to reply though, Paimon'll give you that!",
            "nextDialogs": [
              "750013329"
            ]
          },
          "750013329": {
            "id": "750013329",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright, we'll follow you and see if we can find any golden patterns."
          },
          "750013319": {
            "id": "750013319",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, that's true, but don't let it go to your head now..."
          }
        }
      }
    }
  ]

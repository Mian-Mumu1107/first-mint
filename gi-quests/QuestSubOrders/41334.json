    {
      "subId": "4133418",
      "subQuestName": "Talk to Mr. Zhu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4133419",
      "subQuestName": "Talk to Jianqiu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413342701"
        ],
        "dialogs": {
          "413342701": {
            "id": "413342701",
            "speakerId": 2405,
            "speakerName": "Jianqiu",
            "text": "Traveler, I'm sorry to trouble you, but... Would you be willing to escort us up the mountain to release the Xiao Lantern?",
            "nextDialogs": [
              "413342704"
            ]
          },
          "413342704": {
            "id": "413342704",
            "speakerId": 2405,
            "speakerName": "Jianqiu",
            "text": "My apologies. I'm afraid we cannot return to the city at this time because of... certain matters.",
            "nextDialogs": [
              "413342705"
            ]
          },
          "413342705": {
            "id": "413342705",
            "speakerId": 2405,
            "speakerName": "Jianqiu",
            "text": "As such, we'll require your protection on the mountain. We can leave whenever you're ready.",
            "nextDialogs": [
              "413342706"
            ]
          },
          "413342706": {
            "id": "413342706",
            "speakerId": 2405,
            "speakerName": "Jianqiu",
            "text": "After we release the Xiao Lantern, we'll continue on our way."
          }
        }
      }
    },
    {
      "subId": "4133420",
      "subQuestName": "Escort the two to a high point to release the Xiao Lantern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413342001"
        ],
        "dialogs": {
          "413342001": {
            "id": "413342001",
            "speakerId": 2420,
            "speakerName": "Huachu",
            "text": "I'm sorry, it's just that I...",
            "nextDialogs": [
              "413342002"
            ]
          },
          "413342002": {
            "id": "413342002",
            "speakerId": 2405,
            "speakerName": "Jianqiu",
            "text": "Don't say that. Let's just enjoy watching the Xiao Lanterns while we still may..."
          }
        }
      }
    },
    {
      "subId": "4133421",
      "subQuestName": "Escort the two to a high point to release the Xiao Lantern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413342101"
        ],
        "dialogs": {
          "413342101": {
            "id": "413342101",
            "speakerId": 2405,
            "speakerName": "Jianqiu",
            "text": "This would actually be a very suitable place to release the Xiao Lantern. Thank you, Traveler.",
            "nextDialogs": [
              "413342102"
            ]
          },
          "413342102": {
            "id": "413342102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're welcome.",
            "nextDialogs": [
              "413342103"
            ]
          },
          "413342103": {
            "id": "413342103",
            "speakerId": 2405,
            "speakerName": "Jianqiu",
            "text": "I just hope... that her wish will come true.",
            "nextDialogs": [
              "413342104"
            ]
          },
          "413342104": {
            "id": "413342104",
            "speakerId": 2420,
            "speakerName": "Huachu",
            "text": "...",
            "nextDialogs": [
              "413342105"
            ]
          },
          "413342105": {
            "id": "413342105",
            "speakerId": 2405,
            "speakerName": "Jianqiu",
            "text": "Thank you, Traveler. We should be on our way now."
          }
        }
      }
    },
    {
      "subId": "4133422",
      "subQuestName": "Talk to Mr. Zhu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413342801"
        ],
        "dialogs": {
          "413342801": {
            "id": "413342801",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Ah, you're back. *sigh* It's been difficult to attract guests during the festival...",
            "nextDialogs": [
              "413342802"
            ]
          },
          "413342802": {
            "id": "413342802",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Huh, what about the two guests that were here earlier? Have they left already?",
            "nextDialogs": [
              "413342803"
            ]
          },
          "413342803": {
            "id": "413342803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, they've continued on their journey.",
            "nextDialogs": [
              "413342804"
            ]
          },
          "413342804": {
            "id": "413342804",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Oh, I see... Leaving on a journey during the Lantern Rite mustn't be easy for them.",
            "nextDialogs": [
              "413342805"
            ]
          },
          "413342805": {
            "id": "413342805",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Huh, now that you mention it... Regardless of whether they were heading towards or away from Liyue, don't you find it a little strange that they continued their journey without stopping for the night?",
            "nextDialogs": [
              "413342806"
            ]
          },
          "413342806": {
            "id": "413342806",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "When I met them earlier, it was clear from their expressions that they didn't know which way to go.",
            "nextDialogs": [
              "413342807"
            ]
          },
          "413342807": {
            "id": "413342807",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "They even jumped when I called after them, and there was something a bit off about their attire as well...",
            "nextDialogs": [
              "413342808"
            ]
          },
          "413342808": {
            "id": "413342808",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Oh, forget about it... Here's the compensation I'd promised you earlier.",
            "nextDialogs": [
              "413342809"
            ]
          },
          "413342809": {
            "id": "413342809",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Thanks for all your help. I'll get back to matters at the inn now."
          }
        }
      }
    },

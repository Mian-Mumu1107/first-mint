    {
      "subId": "4133407",
      "subQuestName": "Give Delicious Jewelry Soup to Mr. Zhu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413342201"
        ],
        "dialogs": {
          "413342201": {
            "id": "413342201",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "So, is the food ready?",
            "nextDialogs": [
              "413342202"
            ]
          },
          "413342202": {
            "id": "413342202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It certainly is.",
            "nextDialogs": [
              "413342203"
            ]
          },
          "413342203": {
            "id": "413342203",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Okay, great. These are all the dishes we needed. Thank you.",
            "nextDialogs": [
              "413342204"
            ]
          },
          "413342204": {
            "id": "413342204",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Sorry to keep you waiting, hehe. Here's your food, please enjoy.",
            "nextDialogs": [
              "413342205"
            ]
          },
          "413342205": {
            "id": "413342205",
            "speakerId": 2405,
            "speakerName": "Jianqiu",
            "text": "#Thank you, Mr. Zhu. Also, this Traveler has gone to great lengths to help with everything. We'd be delighted if {M#he}{F#she} could join us.",
            "nextDialogs": [
              "413342206"
            ]
          },
          "413342206": {
            "id": "413342206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thanks.",
            "nextDialogs": [
              "413342207"
            ]
          },
          "413342207": {
            "id": "413342207",
            "speakerId": 2405,
            "speakerName": "Jianqiu",
            "text": "Hehe, judging from your appearance, you must also be a traveler on some distant journey. The festival makes for a fitting time for people to come together, share a meal, and enjoy a lively time with one another.",
            "nextDialogs": [
              "413342208"
            ]
          },
          "413342208": {
            "id": "413342208",
            "speakerId": 2420,
            "speakerName": "Huachu",
            "text": "Yes. In fact, would you also care to join us, Mr. Zhu?",
            "nextDialogs": [
              "413342209"
            ]
          },
          "413342209": {
            "id": "413342209",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Oh, uh... Yes, I—I'd be delighted."
          }
        }
      }
    },

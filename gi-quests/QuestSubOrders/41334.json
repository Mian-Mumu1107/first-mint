    {
      "subId": "4133416",
      "subQuestName": "Cook a Delicious Jewelry Soup",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413341601"
        ],
        "dialogs": {
          "413341601": {
            "id": "413341601",

          "413340401"
        ],
        "dialogs": {
          "413340401": {
            "id": "413340401",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "I need to go attract some guests. I'll give you your rewards a little later.",
            "nextDialogs": [
              "413340402"
            ]
          },
          "413340402": {
            "id": "413340402",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Hmm... Minghua Bank... Minghua Bank."
          }
        }
      }
    },
    {
      "subId": "4133405",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413340501"
        ],
        "dialogs": {
          "413340501": {
            "id": "413340501",
            "speakerId": 2451,
            "speakerName": "Dummy",
            "text": "Thanks — I was just beginning to worry that we'd run out of materials.",
            "nextDialogs": [
              "413340502"
            ]
          },
          "413340502": {
            "id": "413340502",
            "speakerId": 2451,
            "speakerName": "Dummy",
            "text": "Just give me a moment to make a few more Xiao Lanterns and we can hang them all up together.",
            "nextDialogs": [
              "413340503"
            ]
          },
          "413340503": {
            "id": "413340503",
            "speakerId": 2451,
            "speakerName": "Dummy",
            "text": "...And that should just about do it. Here, take these Xiao Lanterns and hang them beside the doors to the inn.",
            "nextDialogs": [
              "413340504"
            ]
          },
          "413340504": {
            "id": "413340504",
            "speakerId": 2451,
            "speakerName": "Dummy",
            "text": "I still need to make a few more lanterns in case we need them later."
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "4133426",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413342601"
        ],
        "dialogs": {
          "413342601": {
            "id": "413342601",
            "speakerId": 2405,
            "speakerName": "Jianqiu",
            "text": "Thank you for your service. Here's some Mora, please check the amount.",
            "nextDialogs": [
              "413342602"
            ]
          },
          "413342602": {
            "id": "413342602",
            "speakerId": 1629,
            "speakerName": "Mr. Zhu",
            "text": "Sure thing. This Mora will be plenty. Now, will you two travelers be continuing further on your journey, or will you return to the city?",
            "nextDialogs": [
              "413342603"
            ]
          },
          "413342603": {
            "id": "413342603",
            "speakerId": 1629,
            "speakerName": "Mr. Zhu",
            "text": "I've heard that the Mingxiao Lantern will be particularly impressive this year.",
            "nextDialogs": [
              "413342604"
            ]
          },
          "413342604": {
            "id": "413342604",
            "speakerId": 2420,
            "speakerName": "Huachu",
            "text": "We...",
            "nextDialogs": [
              "413342605"
            ]
          },
          "413342605": {
            "id": "413342605",
            "speakerId": 2405,
            "speakerName": "Jianqiu",
            "text": "We'll be sure to go see it if we get the chance. Thanks for letting us know, Mr. Zhu.",
            "nextDialogs": [
              "413342606"
            ]
          },
          "413342606": {
            "id": "413342606",
            "speakerId": 2420,
            "speakerName": "Huachu",
            "text": "Excuse me, Mr. Zhu. Would you be willing to sell us one of your Xiao Lanterns?",
            "nextDialogs": [
              "413342607"
            ]
          },
          "413342607": {
            "id": "413342607",
            "speakerId": 2420,
            "speakerName": "Huachu",
            "text": "Even if we don't get the opportunity to see the Mingxiao Lantern in the city, it would still be nice to release a Xiao Lantern, right?",
            "nextDialogs": [
              "413342608"
            ]
          },
          "413342608": {
            "id": "413342608",
            "speakerId": 2405,
            "speakerName": "Jianqiu",
            "text": "Yes, it is the Lantern Rite after all.",
            "nextDialogs": [
              "413342609"
            ]
          },
          "413342609": {
            "id": "413342609",
            "speakerId": 1629,
            "speakerName": "Mr. Zhu",
            "text": "Sure, no problem at all! I just happen to have a few new Xiao Lanterns that were just made today.",
            "nextDialogs": [
              "413342610"
            ]
          },
          "413342610": {
            "id": "413342610",
            "speakerId": 1629,
            "speakerName": "Mr. Zhu",
            "text": "Here, you may have this lantern free of charge. It is the Lantern Rite after all, you may keep your Mora.",
            "nextDialogs": [
              "413342611"
            ]
          },
          "413342611": {
            "id": "413342611",
            "speakerId": 2405,
            "speakerName": "Jianqiu",
            "text": "Thank you, Mr. Zhu. Do you know of a suitable place to release the lantern nearby?",
            "nextDialogs": [
              "413342612"
            ]
          },
          "413342612": {
            "id": "413342612",
            "speakerId": 1629,
            "speakerName": "Mr. Zhu",
            "text": "A place to release a Xiao Lantern, huh? Let me think, it should somewhere higher up... Ah yes, I remember that there should be some suitable places if you follow this road further up the mountain.",
            "nextDialogs": [
              "413342613"
            ]
          },
          "413342613": {
            "id": "413342613",
            "speakerId": 1629,
            "speakerName": "Mr. Zhu",
            "text": "However, there's been word of monsters appearing on the mountain, so you two should be careful."
          }
        }
      }
    },
    {
      "subId": "4133401",
      "subQuestName": "Talk to Mr. Zhu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413340101"
        ],
        "dialogs": {
          "413340101": {
            "id": "413340101",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "There must be a way...",
            "nextDialogs": [
              "413340102"
            ]
          },
          "413340102": {
            "id": "413340102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A way to do what?",
            "nextDialogs": [
              "413340103"
            ]
          },
          "413340103": {
            "id": "413340103",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Oh, it's you, Traveler. You know how it's the time of the Lantern Rite, right? Well, I was trying to think of a way to help give my business a bit of a boost during all the festivities.",
            "nextDialogs": [
              "413340104"
            ]
          },
          "413340104": {
            "id": "413340104",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Good location, nice scenery, and food... we've got plenty of that, too.",
            "nextDialogs": [
              "413340105"
            ]
          },
          "413340105": {
            "id": "413340105",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "I can see it now...They'll release the Mingxiao Lantern in the city, and here we've got tasty food, plenty to drink, and an incredible view — it's going to be spectacular!",
            "nextDialogs": [
              "413340106"
            ]
          },
          "413340106": {
            "id": "413340106",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "This'll be my main selling point to attract more customers. What do you think?",
            "nextDialogs": [
              "413340109"
            ]
          },
          "413340109": {
            "id": "413340109",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Uh, of course you can see it from here... The lantern's so big that you'll certainly be able to see part of it, at least.",
            "nextDialogs": [
              "413340110"
            ]
          },
          "413340110": {
            "id": "413340110",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Anyway, we'll get to that when the time comes. First, I need to get the inn squared away for more guests.",
            "nextDialogs": [
              "413340111"
            ]
          },
          "413340111": {
            "id": "413340111",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Traveler, could I trouble you to collect some Xiao Lantern-making materials? I would like to hang some around the inn."
          }
        }
      }
    },
    {
      "subId": "4133411",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413341101"
        ],
        "dialogs": {
          "413341101": {
            "id": "413341101",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Please hurry with the Delicious Jewelry Soup. It's hard enough to get guests as it is, we mustn't disappoint them."
          }
        }
      }
    },

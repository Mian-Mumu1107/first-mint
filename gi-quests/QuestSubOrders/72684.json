    {
      "subId": "7268403",
      "subQuestName": "Talk to the Tenryou Commission Doushin Kimura",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726840301"
        ],
        "dialogs": {
          "726840301": {
            "id": "726840301",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "Oh, do you need a hand with anything?",
            "nextDialogs": [
              "726840302"
            ]
          },
          "726840302": {
            "id": "726840302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Isn't there supposed to be a festival soon?",
            "nextDialogs": [
              "726840303"
            ]
          },
          "726840303": {
            "id": "726840303",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "What? A festival? I haven't heard anything about a festival coming up.",
            "nextDialogs": [
              "726840304"
            ]
          },
          "726840304": {
            "id": "726840304",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "Uh, could you be more specific? What festival are you talking about, exactly?",
            "nextDialogs": [
              "726840305"
            ]
          },
          "726840305": {
            "id": "726840305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's the Almighty Arataki—",
            "nextDialogs": [
              "726840306"
            ]
          },
          "726840306": {
            "id": "726840306",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "Almighty Arataki...?",
            "nextDialogs": [
              "726840309"
            ]
          },
          "726840309": {
            "id": "726840309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's the Almighty Arataki Great and Glorious Drumalong Festival, organized by the Arataki Gang!",
            "nextDialogs": [
              "726840310"
            ]
          },
          "726840310": {
            "id": "726840310",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "Ah yes! The same Arataki Gang who made a scene at the Irodori Festival?",
            "nextDialogs": [
              "726840311"
            ]
          },
          "726840311": {
            "id": "726840311",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "So, you're here for the unauthorized, unprofessional, and unofficial event, huh...",
            "nextDialogs": [
              "726840312"
            ]
          },
          "726840312": {
            "id": "726840312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What? No, no, no, it's not un-anything! It's the Almighty Arataki Great and Glorious Drumalong Festival!",
            "nextDialogs": [
              "726840313"
            ]
          },
          "726840313": {
            "id": "726840313",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "Yeah, I gotcha, no need to keep re-hashing the name. I think I know what this is about, let me bring you up to speed.",
            "nextDialogs": [
              "726840314"
            ]
          },
          "726840314": {
            "id": "726840314",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "So we saw the members of the Arataki Gang here a few days ago. And they were busy at work leaving piles of hideous things all over the place.",
            "nextDialogs": [
              "726840315"
            ]
          },
          "726840315": {
            "id": "726840315",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "Their leader claimed to be hosting a grand event, big enough to rival the Irodori Festival. I think that must be the one you're talking about.",
            "nextDialogs": [
              "726840316"
            ]
          },
          "726840316": {
            "id": "726840316",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "I asked them a couple of questions and it quickly became clear that they had no permit to host the event, no proof of venue hire, and — surprise, surprise — no record of having registered the event with the Police Station.",
            "nextDialogs": [
              "726840317"
            ]
          },
          "726840317": {
            "id": "726840317",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "Pff. If that isn't the definition of an unauthorized, unprofessional, and unofficial festival, I don't know what is. According to the rules, we had to force them to shut down the event.",
            "nextDialogs": [
              "726840318"
            ]
          },
          "726840318": {
            "id": "726840318",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What? You shut it down!? ...Let Paimon guess, then you arrested them, hmm?",
            "nextDialogs": [
              "726840319"
            ]
          },
          "726840319": {
            "id": "726840319",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "No, actually. Seeing that they had no prior experience organizing events, and they'd at least gone to the trouble of preparing a safety plan, we just gave them a warning.",
            "nextDialogs": [
              "726840320"
            ]
          },
          "726840320": {
            "id": "726840320",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Safety plan? Huh, that's pretty responsible...",
            "nextDialogs": [
              "726840321"
            ]
          },
          "726840321": {
            "id": "726840321",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "Anyway, if you are looking for the Arataki Gang, you could try going to Amakane Island.",
            "nextDialogs": [
              "726840322"
            ]
          },
          "726840322": {
            "id": "726840322",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "Which is a venue designated by the Yashiro Commission for use in all kinds of festivals, big and small. It was established to try and encourage community cultural events. The application process is much simpler there, and less expensive, too.",
            "nextDialogs": [
              "726840323"
            ]
          },
          "726840323": {
            "id": "726840323",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "We told the Arataki Gang about that.",
            "nextDialogs": [
              "726840324"
            ]
          },
          "726840324": {
            "id": "726840324",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "If they still want to host their event, that's gonna be their best option.",
            "nextDialogs": [
              "726840325"
            ]
          },
          "726840325": {
            "id": "726840325",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hmm... this whole thing is starting to sound like a non-starter, {NICKNAME}...",
            "nextDialogs": [
              "726840326"
            ]
          },
          "726840326": {
            "id": "726840326",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But, since we've come this far... we might as well go and take a look at Amakane Island, right?"
          }
        }
      }
    },
    {
      "subId": "7268404",
      "subQuestName": "Go to Amakane Island and look for the Arataki Gang",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726840401"
        ],
        "dialogs": {
          "726840401": {
            "id": "726840401",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "Do you have any other questions?",
            "nextDialogs": [
              "726840402"
            ]
          },
          "726840402": {
            "id": "726840402",
            "speakerId": 20567,
            "speakerName": "Kimura",
            "text": "If you want to find the Arataki Gang, try Amakane Island."
          }
        }
      }
    },
    {
      "subId": "7268405",
      "subQuestName": "Talk to Hirohiko, the Yashiro Commission Representative",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726840501"
        ],
        "dialogs": {
          "726840501": {
            "id": "726840501",
            "speakerId": 3150,
            "speakerName": "Hirohiko",
            "text": "How can I help?",
            "nextDialogs": [
              "726840502"
            ]
          },
          "726840502": {
            "id": "726840502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're looking for the Arataki Gang.",
            "nextDialogs": [
              "726840503"
            ]
          },
          "726840503": {
            "id": "726840503",
            "speakerId": 3150,
            "speakerName": "Hirohiko",
            "text": "Ah yes, you must be here for the Almighty Arataki Whatchamacallit Festival, too?",
            "nextDialogs": [
              "726840504"
            ]
          },
          "726840504": {
            "id": "726840504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Too\"?",
            "nextDialogs": [
              "726840505"
            ]
          },
          "726840505": {
            "id": "726840505",
            "speakerId": 3150,
            "speakerName": "Hirohiko",
            "text": "Yep, Madam Kujou Sara of the Tenryou Commission and Yoimiya of Naganohara Fireworks have both been here so far.",
            "nextDialogs": [
              "726840506"
            ]
          },
          "726840506": {
            "id": "726840506",
            "speakerId": 3150,
            "speakerName": "Hirohiko",
            "text": "Yoimiya noticed them getting the venue ready when she was here to deliver some fireworks. I guess she got curious and went to go check it out.",
            "nextDialogs": [
              "726840507"
            ]
          },
          "726840507": {
            "id": "726840507",
            "speakerId": 3150,
            "speakerName": "Hirohiko",
            "text": "As to what Madam Kujou Sara was here for, I'm not quite sure.",
            "nextDialogs": [
              "726840508"
            ]
          },
          "726840508": {
            "id": "726840508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Whoa, so other people got here before us? That's a good sign, {NICKNAME}, hehe.",
            "nextDialogs": [
              "726840509"
            ]
          },
          "726840509": {
            "id": "726840509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So where's the Arataki Gang now?",
            "nextDialogs": [
              "726840510"
            ]
          },
          "726840510": {
            "id": "726840510",
            "speakerId": 3150,
            "speakerName": "Hirohiko",
            "text": "Unfortunately, since there's no space available at any official venues at the moment...",
            "nextDialogs": [
              "726840511"
            ]
          },
          "726840511": {
            "id": "726840511",
            "speakerId": 3150,
            "speakerName": "Hirohiko",
            "text": "...we had to allocate them to a tiny beach at the northwest part of the island.",
            "nextDialogs": [
              "726840512"
            ]
          },
          "726840512": {
            "id": "726840512",
            "speakerId": 3150,
            "speakerName": "Hirohiko",
            "text": "If only they'd applied earlier, we could've given them a better location.",
            "nextDialogs": [
              "726840513"
            ]
          },
          "726840513": {
            "id": "726840513",
            "speakerId": 3150,
            "speakerName": "Hirohiko",
            "text": "Head northwest, you'll see them."
          }
        }
      }
    },
    {
      "subId": "7268406",
      "subQuestName": "Go to the tidal flats on northwest Amakane Island",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726840632"
        ],
        "dialogs": {
          "726840632": {
            "id": "726840632",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's this festival got in store for us?",
            "nextDialogs": [
              "726840633"
            ]
          },
          "726840633": {
            "id": "726840633",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Hahahaha! A ton of totally awesome stuff!",
            "nextDialogs": [
              "726840634"
            ]
          },
          "726840634": {
            "id": "726840634",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "See that hill over there? That's Singalong Hill. Stand at the top, look out over the sea, and sing your heart out.",
            "nextDialogs": [
              "726840635"
            ]
          },
          "726840635": {
            "id": "726840635",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "And this bonfire, it's perfect for roasting Lavender Melons, the regular kind or the ones of the annoying little floating variety.",
            "nextDialogs": [
              "726840636"
            ]
          },
          "726840636": {
            "id": "726840636",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "And these boxes. Plenty of space whether you wanna play Genius Invokation TCG or a-battle some beetles.",
            "nextDialogs": [
              "726840637"
            ]
          },
          "726840637": {
            "id": "726840637",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, you really pulled out all the stops.",
            "nextDialogs": [
              "726840638"
            ]
          },
          "726840638": {
            "id": "726840638",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "But of course, the highlight of this festival is the Drumalong. Here, feast your eyes on this.",
            "nextDialogs": [
              "726840639"
            ]
          },
          "726840639": {
            "id": "726840639",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Just between you and me, this little treasure was sourced through a top-secret channel. They said it's a prized hand drum that once belonged to a renowned onmyouji, and it's worth 8 million Mora!",
            "nextDialogs": [
              "726840640"
            ]
          },
          "726840640": {
            "id": "726840640",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Thanks to my strapping good looks and the fact that the vendor and I kinda had a connection — her words, not mine — she gave me a generous discount, and only asked for 800 thousand Mora.",
            "nextDialogs": [
              "726840641"
            ]
          },
          "726840641": {
            "id": "726840641",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "She went from 8 million to 800 thousand just like that? Uh... sounds suspiciously like a scam to Paimon.",
            "nextDialogs": [
              "726840642"
            ]
          },
          "726840642": {
            "id": "726840642",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Duh, haha! Oldest trick in the book, right? Which is why it didn't work on me.",
            "nextDialogs": [
              "726840643"
            ]
          },
          "726840643": {
            "id": "726840643",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "I spotted the damage on the edge right away. Practically screamed \"defective product alert\"! \"Ooh, we have a connection\"... Gimme a break!",
            "nextDialogs": [
              "726840644"
            ]
          },
          "726840644": {
            "id": "726840644",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "So I haggled hard and took her down to 80 G's, hahahaha! Practically a steal!",
            "nextDialogs": [
              "726840645"
            ]
          },
          "726840645": {
            "id": "726840645",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah... more specifically, daylight robbery...",
            "nextDialogs": [
              "726840646"
            ]
          },
          "726840646": {
            "id": "726840646",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Still, it's pretty impressive that you could actually afford something worth 80 thousand Mora. Good for you, Bull-Chucker.",
            "nextDialogs": [
              "726840647"
            ]
          },
          "726840647": {
            "id": "726840647",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Pfft, it's only 80 thousand Mora. What do you take me for!",
            "nextDialogs": [
              "726840648"
            ]
          },
          "726840648": {
            "id": "726840648",
            "speakerId": 12277,
            "speakerName": "Genta",
            "text": "I put in 20 grand...",
            "nextDialogs": [
              "726840649"
            ]
          },
          "726840649": {
            "id": "726840649",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "Me too...",
            "nextDialogs": [
              "726840650"
            ]
          },
          "726840650": {
            "id": "726840650",
            "speakerId": 12276,
            "speakerName": "Akira",
            "text": "Huh? Boss, how come I had to pay 30 grand?",
            "nextDialogs": [
              "726840651"
            ]
          },
          "726840651": {
            "id": "726840651",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "20 grand plus 20 grand plus 30 grand...",
            "nextDialogs": [
              "726840652"
            ]
          },
          "726840652": {
            "id": "726840652",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, you really are a bull-chucker! You extorted 80 grand from your gang members and didn't pay a single Mora yourself!",
            "nextDialogs": [
              "726840653"
            ]
          },
          "726840653": {
            "id": "726840653",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Ahem, you might wanna check your mathematics there! I paid my share... y'know, I paid the last 10 grand!",
            "nextDialogs": [
              "726840665"
            ]
          },
          "726840665": {
            "id": "726840665",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Alright, good chat, but we should wrap things up. It's getting late, I should go rendezvous with Shinobu.",
            "nextDialogs": [
              "726840666"
            ]
          },
          "726840666": {
            "id": "726840666",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "This festival's just getting started. We need to keep plugging it to get a bigger crowd!",
            "nextDialogs": [
              "726840667"
            ]
          },
          "726840667": {
            "id": "726840667",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Take care of the hand drum, alright? Oh, and if you wanna try out the Drumalong at any point, Genta's your guy.",
            "nextDialogs": [
              "726840668"
            ]
          },
          "726840668": {
            "id": "726840668",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Laters, compadre!"
          }
        }
      }
    },
    {
      "subId": "7268407",
      "subQuestName": "Drum along with Genta",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726840701"
        ],
        "dialogs": {
          "726840701": {
            "id": "726840701",
            "speakerId": 12277,
            "speakerName": "Genta",
            "text": "I'm Genta, the Arataki Drumalong Festival Welcome Ambassador. Are you ready for your Drumalong performance?",
            "nextDialogs": [
              "726840702"
            ]
          },
          "726840702": {
            "id": "726840702",
            "speakerId": 12277,
            "speakerName": "Genta",
            "text": "Oh, I almost forgot, there's something that Boss forgot to mention to you about this hand drum.",
            "nextDialogs": [
              "726840703"
            ]
          },
          "726840703": {
            "id": "726840703",
            "speakerId": 12277,
            "speakerName": "Genta",
            "text": "Since none of us really know if it's in tune or not, please test it out first.",
            "nextDialogs": [
              "726840704"
            ]
          },
          "726840704": {
            "id": "726840704",
            "speakerId": 12277,
            "speakerName": "Genta",
            "text": "That way, it'll sound better when you deliver your final performance.",
            "nextDialogs": [
              "726840705"
            ]
          },
          "726840705": {
            "id": "726840705",
            "speakerId": 12277,
            "speakerName": "Genta",
            "text": "Go on, give it a try."
          }
        }
      }
    },
    {
      "subId": "7268406",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726840601"
        ],
        "dialogs": {
          "726840601": {
            "id": "726840601",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Hahahahaha! Hey there, compadres! You finally made it!",
            "nextDialogs": [
              "726840602"
            ]
          },
          "726840602": {
            "id": "726840602",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "I was just wondering when you'd be showing up, next thing I know, boom. There you are. Hahaha, boy, am I happy to see you.",
            "nextDialogs": [
              "726840603"
            ]
          },
          "726840603": {
            "id": "726840603",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Look at this venue. What do you think? Is this a prime location or what?",
            "nextDialogs": [
              "726840604"
            ]
          },
          "726840604": {
            "id": "726840604",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "It's surrounded by sea, the air is as fresh as it gets, there's no noise pollution from the city, and the views are simply spectacular.",
            "nextDialogs": [
              "726840605"
            ]
          },
          "726840605": {
            "id": "726840605",
            "speakerId": 12276,
            "speakerName": "Akira",
            "text": "The venue is situated against the backdrop of Amakane Island, where you can enjoy exclusive access to the Festival and Culture Center's first-rate equipment.",
            "nextDialogs": [
              "726840606"
            ]
          },
          "726840606": {
            "id": "726840606",
            "speakerId": 12277,
            "speakerName": "Genta",
            "text": "With excellent transport links by sea and lands, getting where you need to be is highly convenient — whether you're traveling by foot or by boat.",
            "nextDialogs": [
              "726840609"
            ]
          },
          "726840609": {
            "id": "726840609",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "The moment I set eyes on this venue, I knew this was the one!",
            "nextDialogs": [
              "726840610"
            ]
          },
          "726840610": {
            "id": "726840610",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "It was the moment that changed the world.",
            "nextDialogs": [
              "726840611"
            ]
          },
          "726840611": {
            "id": "726840611",
            "speakerId": 1007,
            "speakerName": "Arataki Gang Members",
            "text": "Give it up for the boss!",
            "nextDialogs": [
              "726840612"
            ]
          },
          "726840612": {
            "id": "726840612",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Clearly, you're only here because the Tenryou Commission sent you away.",
            "nextDialogs": [
              "726840613"
            ]
          },
          "726840613": {
            "id": "726840613",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Ahem... alright, let's get down to business.",
            "nextDialogs": [
              "726840614"
            ]
          },
          "726840614": {
            "id": "726840614",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "I invited you all here to attend the Almighty Arataki Great and Glorious Drumalong Festival! A highly important festival, I might add.",
            "nextDialogs": [
              "726840615"
            ]
          },
          "726840615": {
            "id": "726840615",
            "speakerId": 12277,
            "speakerName": "Genta",
            "text": "Yeah, Boss said the first goal of the festival is to promote the Arataki Gang and recruit new members.",
            "nextDialogs": [
              "726840616"
            ]
          },
          "726840616": {
            "id": "726840616",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "Secondly, it's to celebrate Shinobu's graduation!",
            "nextDialogs": [
              "726840617"
            ]
          },
          "726840617": {
            "id": "726840617",
            "speakerId": 12276,
            "speakerName": "Akira",
            "text": "And last but not least, it makes up for all the previous team building events that were canceled due to insufficient funding.",
            "nextDialogs": [
              "726840618"
            ]
          },
          "726840618": {
            "id": "726840618",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Three festivals in one, wow.",
            "nextDialogs": [
              "726840619"
            ]
          },
          "726840619": {
            "id": "726840619",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Akira... we can leave that last point out from now on.",
            "nextDialogs": [
              "726840620"
            ]
          },
          "726840620": {
            "id": "726840620",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Where is Shinobu?",
            "nextDialogs": [
              "726840621"
            ]
          },
          "726840621": {
            "id": "726840621",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "The thing with festivals is, you gotta get out there and promote them far and wide if you want to get a good crowd. So Shinobu's handing out flyers.",
            "nextDialogs": [
              "726840622"
            ]
          },
          "726840622": {
            "id": "726840622",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Shinobu's supposed to be the star of the show, isn't she?",
            "nextDialogs": [
              "726840623"
            ]
          },
          "726840623": {
            "id": "726840623",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How come she's out there working her butt off while you're hanging around here doing nothing?",
            "nextDialogs": [
              "726840624"
            ]
          },
          "726840624": {
            "id": "726840624",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Hey, I'm hard at work too! I'm, uh... entertaining guests!",
            "nextDialogs": [
              "726840625"
            ]
          },
          "726840625": {
            "id": "726840625",
            "speakerId": 12277,
            "speakerName": "Genta",
            "text": "Boss actually just got back.",
            "nextDialogs": [
              "726840626"
            ]
          },
          "726840626": {
            "id": "726840626",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "He said he was expecting you to arrive any second, so he came back specially to welcome you.",
            "nextDialogs": [
              "726840627"
            ]
          },
          "726840627": {
            "id": "726840627",
            "speakerId": 12276,
            "speakerName": "Akira",
            "text": "Until then, he was out there with Shinobu working hard to bring more people to the festival.",
            "nextDialogs": [
              "726840628"
            ]
          },
          "726840628": {
            "id": "726840628",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Just—Just doin' my duty. Nothin' more, nothin' less.",
            "nextDialogs": [
              "726840629"
            ]
          },
          "726840629": {
            "id": "726840629",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, this bull-chucker actually did some serious work for once. Paimon's pleasantly surprised.",
            "nextDialogs": [
              "726840630"
            ]
          },
          "726840630": {
            "id": "726840630",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Hmph, trust a puny little flying Lavender Melon to stoop to the level of childish name-calling!",
            "nextDialogs": [
              "726840631"
            ]
          },
          "726840631": {
            "id": "726840631",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Anyway, so, compadre — you got any questions about this festival?"
          },
          "726840654": {
            "id": "726840654",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I heard Kujou Sara came?",
            "nextDialogs": [
              "726840655"
            ]
          },
          "726840655": {
            "id": "726840655",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Oh, you mean that stupid tengu?",
            "nextDialogs": [
              "726840656"
            ]
          },
          "726840656": {
            "id": "726840656",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Yeah, I hesitated, but... I sent her an invitation.",
            "nextDialogs": [
              "726840657"
            ]
          },
          "726840657": {
            "id": "726840657",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "I cannot believe how ungrateful she is. Get this — she came all the way out here just to put up a bulletin board and write a load of baloney on it, claiming that visitors need to be cautioned.",
            "nextDialogs": [
              "726840658"
            ]
          },
          "726840658": {
            "id": "726840658",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "She even warned us not to change it. It's blatant bullying of the gang, that's what it is...",
            "nextDialogs": [
              "726840659"
            ]
          },
          "726840659": {
            "id": "726840659",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "One day, I'm gonna defeat that tengu fair and square, in broad daylight, in the middle of the street! She'll get what's coming to her!",
            "nextDialogs": [
              "726840660"
            ]
          },
          "726840660": {
            "id": "726840660",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I heard Yoimiya showed up, too?",
            "nextDialogs": [
              "726840661"
            ]
          },
          "726840661": {
            "id": "726840661",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "The owner of Naganohara Fireworks?",
            "nextDialogs": [
              "726840662"
            ]
          },
          "726840662": {
            "id": "726840662",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Chatting with her is a real blast. She only found out about our festival because she happened to be delivering some fireworks to Amakane Island.",
            "nextDialogs": [
              "726840663"
            ]
          },
          "726840663": {
            "id": "726840663",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "She really liked what we're trying to do here, and came to pass on her best wishes. She even said she'll provide some fireworks for us next time.",
            "nextDialogs": [
              "726840664"
            ]
          },
          "726840664": {
            "id": "726840664",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Looks like the Arataki Gang should make sure to keep good ties with Naganohara Fireworks in the future."
          }
        }
      }
    },
    {
      "subId": "7268471",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726847101"
        ],
        "dialogs": {
          "726847101": {
            "id": "726847101",
            "speakerId": 12276,
            "speakerName": "Akira",
            "text": "I'm Akira, the Arataki Drumalong Festival Feedback Ambassador. So, can you give us some feedback?",
            "nextDialogs": [
              "726847105"
            ]
          },
          "726847105": {
            "id": "726847105",
            "speakerId": 12276,
            "speakerName": "Akira",
            "text": "Got it. Thank you for your feedback.",
            "nextDialogs": [
              "726847106"
            ]
          },
          "726847106": {
            "id": "726847106",
            "speakerId": 12276,
            "speakerName": "Akira",
            "text": "Hmm? You have other questions? But I don't really have anything else to say.",
            "nextDialogs": [
              "726847107"
            ]
          },
          "726847107": {
            "id": "726847107",
            "speakerId": 12276,
            "speakerName": "Akira",
            "text": "Uh... The boss said my only job was to say two things: \"Can you give us some feedback?\" and \"Thank you for your feedback.\"",
            "nextDialogs": [
              "726847108"
            ]
          },
          "726847108": {
            "id": "726847108",
            "speakerId": 12276,
            "speakerName": "Akira",
            "text": "And if the guests ask when they will receive a response to their feedback, I'm supposed to say: \"We'll get back to you as soon as possible.\"",
            "nextDialogs": [
              "726847109"
            ]
          },
          "726847109": {
            "id": "726847109",
            "speakerId": 12276,
            "speakerName": "Akira",
            "text": "He said that's what people do in other events he's been to. I'm sure he's basing this on a wealth of experience.",
            "nextDialogs": [
              "726847110"
            ]
          },
          "726847110": {
            "id": "726847110",
            "speakerId": 12276,
            "speakerName": "Akira",
            "text": "But then Shinobu told me that's too insincere, so she gave me this notebook.",
            "nextDialogs": [
              "726847111"
            ]
          },
          "726847111": {
            "id": "726847111",
            "speakerId": 12276,
            "speakerName": "Akira",
            "text": "Look here, I've made a note of your feedback, and I'll show it to Shinobu when she gets back."
          }
        }
      }
    },
    {
      "subId": "7268472",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726847201"
        ],
        "dialogs": {
          "726847201": {
            "id": "726847201",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "I'm Mamoru, the Arataki Drumalong Festival Atmosphere Ambassador. How may I help?",
            "nextDialogs": [
              "726847202"
            ]
          },
          "726847202": {
            "id": "726847202",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "You're asking what my job is?",
            "nextDialogs": [
              "726847203"
            ]
          },
          "726847203": {
            "id": "726847203",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "Well, as the atmosphere ambassador, my job is mainly to create a lively atmosphere and give all attendants the feeling of \"I'm so hyped I'm going out of my mind.\"",
            "nextDialogs": [
              "726847204"
            ]
          },
          "726847204": {
            "id": "726847204",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "Do you feel that way?",
            "nextDialogs": [
              "726847207"
            ]
          },
          "726847207": {
            "id": "726847207",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "...Hey, don't say that!",
            "nextDialogs": [
              "726847208"
            ]
          },
          "726847208": {
            "id": "726847208",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "That was really disheartening, it's like being punched in the gut! If that's how you feel... my job's meaningless, isn't it?",
            "nextDialogs": [
              "726847209"
            ]
          },
          "726847209": {
            "id": "726847209",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "You are the boss's friend. Please, show me some support for his sake. I'm begging you, say the line!",
            "nextDialogs": [
              "726847210"
            ]
          },
          "726847210": {
            "id": "726847210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What line?",
            "nextDialogs": [
              "726847211"
            ]
          },
          "726847211": {
            "id": "726847211",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "You know, \"I'm so hyped I'm going out of my mind.\""
          }
        }
      }
    },
    {
      "subId": "7268499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726849906"
        ],
        "dialogs": {
          "726849906": {
            "id": "726849906",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Same situation as earlier. The Arataki Gang is nowhere in sight.",
            "nextDialogs": [
              "726849907"
            ]
          },
          "726849907": {
            "id": "726849907",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There should be a Yashiro Commission representative here. Let's go and ask him."
          }
        }
      }
    }
  ]
}
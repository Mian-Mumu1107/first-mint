            ]
          },
          "700780220": {
            "id": "700780220",
            "speakerId": 1002,
            "speakerName": "Lennart",
            "text": "You want to help Winslow?",
            "nextDialogs": [
              "700780221"
            ]
          },
          "700780221": {
            "id": "700780221",
            "speakerId": 1002,
            "speakerName": "Lennart",
            "text": "Just so we're clear, the area below used to be an ancient battlefield. I'm not risking my life down there. Besides, even the Knights of Favonius have checked it out, and the problem still hasn't been solved...",
            "nextDialogs": [
              "700780222"
            ]
          },
          "700780222": {
            "id": "700780222",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "That means we'll need someone even more reliable than the Knights. Say, a great hero who saved Mondstadt in the past, for example...",
            "nextDialogs": [
              "700780223"
            ]
          },
          "700780223": {
            "id": "700780223",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Hmph hmph~ And where exactly could anyone find a hero like that?",
            "nextDialogs": [
              "700780227",
              "700780226"
            ]
          },
          "700780227": {
            "id": "700780227",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "Haha, brave heroes, forgive my bluntness, but might you possibly entertain my humble request for help?",
            "nextDialogs": [
              "700780228"
            ]
          },
          "700780228": {
            "id": "700780228",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Emm... But there are those annoying ghosts...",
            "nextDialogs": [
              "700780229"
            ]
          },
          "700780229": {
            "id": "700780229",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "Ah, but some stories say ghosts linger only to guard treasures hidden deep in the mountains...",
            "nextDialogs": [
              "700780230"
            ]
          },
          "700780230": {
            "id": "700780230",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Oh! Treasure!"
          },
          "700780226": {
            "id": "700780226",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "Well, you do happen to be here... And you know what they say, there is no greater beauty to be found in this world than that of verse and chance. To be honest, even if you're not here, I was planning to investigate on my own anyway."
          }
        }
      }

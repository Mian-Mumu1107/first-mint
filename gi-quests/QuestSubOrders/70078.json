    {
      "subId": "7007819",
      "subQuestName": "Return to the base of the old lighthouse",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7007820",
      "subQuestName": "Talk to Odolf",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700782001"
        ],
        "dialogs": {
          "700782001": {
            "id": "700782001",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Odolf, we're back. How's it going? Any more problems with the alarm?",
            "nextDialogs": [
              "700782002"
            ]
          },
          "700782002": {
            "id": "700782002",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "No. It's stopped flashing.",
            "nextDialogs": [
              "700782003"
            ]
          },
          "700782003": {
            "id": "700782003",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "Goodness, that was fast. You two really solved the problem in no time.",
            "nextDialogs": [
              "700782004"
            ]
          },
          "700782004": {
            "id": "700782004",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Yeah. So, about that wind earlier...",
            "nextDialogs": [
              "700782005"
            ]
          },
          "700782005": {
            "id": "700782005",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "The wind... It must be the cries of fallen knights who refuse to leave this place. The flashing of the alarm was only meant to alert us.",
            "nextDialogs": [
              "700782006"
            ]
          },
          "700782006": {
            "id": "700782006",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Ehh? Wait, the ghosts are actually...",
            "nextDialogs": [
              "700782007"
            ]
          },
          "700782007": {
            "id": "700782007",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "The ghosts never meant to harm you, Winslow. They were only upset by the idea of being driven away.",
            "nextDialogs": [
              "700782008"
            ]
          },
          "700782008": {
            "id": "700782008",
            "speakerId": 1005,
            "speakerName": "Winslow",
            "text": "R—Really...?",
            "nextDialogs": [
              "700782009"
            ]
          },
          "700782009": {
            "id": "700782009",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "They were heroes who gave up their lives fighting the Abyss here. How could they ever wish you harm?",
            "nextDialogs": [
              "700782010"
            ]
          },
          "700782010": {
            "id": "700782010",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "#Ahem... It's all thanks to {NICKNAME} and Paimon. They are Honorary Knights of the Knights of Favonius and also top-tier... top-tier ghost negotiation experts.",
            "nextDialogs": [
              "700782011"
            ]
          },
          "700782011": {
            "id": "700782011",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Emm... Well, that title does sound kind of cool.",
            "nextDialogs": [
              "700782012"
            ]
          },
          "700782012": {
            "id": "700782012",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "That loud crash just now. It sounded like the floor split apart. You two weren't hurt, were you...?",
            "nextDialogs": [
              "700782013"
            ]
          },
          "700782013": {
            "id": "700782013",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not a scratch.",
            "nextDialogs": [
              "700782014"
            ]
          },
          "700782014": {
            "id": "700782014",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "#That's a relief. I was a little worried just now. Ahem. As for that noise, it was actually... Well, it was {NICKNAME} and Paimon negotiating with the ghosts of the Knights of Favonius through...",
            "nextDialogs": [
              "700782015"
            ]
          },
          "700782015": {
            "id": "700782015",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "Through... a form of super spiritual arm wrestling! Locals all know about it. Ah, it's a perilous method to appease the angry ghosts indeed.",
            "nextDialogs": [
              "700782016"
            ]
          },
          "700782016": {
            "id": "700782016",
            "speakerId": 1005,
            "speakerName": "Winslow",
            "text": "Super spiritual arm wrestling? R—Really?",
            "nextDialogs": [
              "700782018",
              "700782020"
            ]
          },
          "700782018": {
            "id": "700782018",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "#Such sheer power! Bringing down ancient ruins during an arm-wrestling match with a ghost? Just another day in the life of the master negotiator {NICKNAME}.",
            "nextDialogs": [
              "700782021"
            ]
          },
          "700782021": {
            "id": "700782021",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "In any case, after the negotiation, the ghosts' anger should have settled...",
            "nextDialogs": [
              "700782022"
            ]
          },
          "700782022": {
            "id": "700782022",
            "speakerId": 1005,
            "speakerName": "Winslow",
            "text": "Th—Then they won't come out to cause trouble anymore... No, I mean... they won't come out and mess with the alarm again, right...?",
            "nextDialogs": [
              "700782023"
            ]
          },
          "700782023": {
            "id": "700782023",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "It's hard to say, Winslow. It depends on how you behave.",
            "nextDialogs": [
              "700782024"
            ]
          },
          "700782024": {
            "id": "700782024",
            "speakerId": 1005,
            "speakerName": "Winslow",
            "text": "I... I've been on my best behavior these past few days. I cleared the weeds around the heroes' graves and carefully cleaned their tombstones...",
            "nextDialogs": [
              "700782025"
            ]
          },
          "700782025": {
            "id": "700782025",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "...",
            "nextDialogs": [
              "700782026"
            ]
          },
          "700782026": {
            "id": "700782026",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "#Goodness! Well done, Winslow. {NICKNAME}'s negotiation went smoothly, and your efforts helped too.",
            "nextDialogs": [
              "700782027"
            ]
          },
          "700782027": {
            "id": "700782027",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "If you could stay this way forever, the spirits of the fallen would surely rest easy in their graves.",
            "nextDialogs": [
              "700782028"
            ]
          },
          "700782028": {
            "id": "700782028",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "After all, if they can rest in peace, why would they bother coming back to stir up trouble?",
            "nextDialogs": [
              "700782029"
            ]
          },
          "700782029": {
            "id": "700782029",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "#Relax, Winslow. You see, things always work out in the end. And if the alarm malfunctions again, we can always ask {NICKNAME} to come negotiate on your behalf.",
            "nextDialogs": [
              "700782030"
            ]
          },
          "700782030": {
            "id": "700782030",
            "speakerId": 1005,
            "speakerName": "Winslow",
            "text": "*sigh* You're right... Odolf...",
            "nextDialogs": [
              "700782031"
            ]
          },
          "700782031": {
            "id": "700782031",
            "speakerId": 1005,
            "speakerName": "Winslow",
            "text": "My thanks to you as well...",
            "nextDialogs": [
              "700782032"
            ]
          },
          "700782032": {
            "id": "700782032",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "#All right then. As for {NICKNAME} and Paimon, thank you for what you've done for us. Please take this...",
            "nextDialogs": [
              "700782033"
            ]
          },
          "700782033": {
            "id": "700782033",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "This is the thing I mentioned preparing earlier. I knew you would be able to resolve this.",
            "nextDialogs": [
              "700782034"
            ]
          },
          "700782034": {
            "id": "700782034",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Oh, it's really a reward. Paimon thought you were preparing some kind of adventuring gear.",
            "nextDialogs": [
              "700782035"
            ]
          },
          "700782035": {
            "id": "700782035",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "I know my limits. I can handle business well enough, but adventuring is not my strength.",
            "nextDialogs": [
              "700782036"
            ]
          },
          "700782036": {
            "id": "700782036",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "All right, my friends. Come by the tavern again sometime. Next time, we can chat about something a little more interesting."
          },
          "700782020": {
            "id": "700782020",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "#This is something only {NICKNAME} could pull off..."
          }
        }
      }
    }
  ]
}
    {
      "subId": "7007803",
      "subQuestName": "Talk to Odolf",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700780301"
        ],
        "dialogs": {
          "700780301": {
            "id": "700780301",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Odolf!",
            "nextDialogs": [
              "700780302"
            ]
          },
          "700780302": {
            "id": "700780302",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "Oh, it's you. You arrived even sooner than I expected...",
            "nextDialogs": [
              "700780304",
              "700780307"
            ]
          },
          "700780304": {
            "id": "700780304",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "No. Everything that needed doing is already done... Ah, what I said just now wasn't a complaint. It was a compliment.",
            "nextDialogs": [
              "700780305"
            ]
          },
          "700780305": {
            "id": "700780305",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "Punctuality is rare. Most only keep others waiting... Sometimes, arriving early is a virtue in itself.",
            "nextDialogs": [
              "700780309"
            ]
          },
          "700780309": {
            "id": "700780309",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "Hmm... take a look. This is the kind of mechanism that's been sounding the alarm. It activates because...",
            "nextDialogs": [
              "700780310"
            ]
          },
          "700780310": {
            "id": "700780310",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "There's a ghost! Right here, right now!",
            "nextDialogs": [
              "700780311"
            ]
          },
          "700780311": {
            "id": "700780311",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "Oh my. Looks like there's a ghost among the three of us, then. I can assure you I'm a living person. I was drinking beer just now.",
            "nextDialogs": [
              "700780312"
            ]
          },
          "700780312": {
            "id": "700780312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm a living person too.",
            "nextDialogs": [
              "700780313"
            ]
          },
          "700780313": {
            "id": "700780313",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "So, the ghost is Paimon... That's not right!",
            "nextDialogs": [
              "700780314"
            ]
          },
          "700780314": {
            "id": "700780314",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "Haha. It would appear that there are no ghosts among us. In that case, the alarm probably wasn't triggered by a ghost.",
            "nextDialogs": [
              "700780315"
            ]
          },
          "700780315": {
            "id": "700780315",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "I think it could be the abnormal airflow. Old-fashioned mechanisms like this tend to grow overly sensitive. Even the slightest movement can set them off.",
            "nextDialogs": [
              "700780316"
            ]
          },
          "700780316": {
            "id": "700780316",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Odolf knows so much about this mechanism.",
            "nextDialogs": [
              "700780317"
            ]
          },
          "700780317": {
            "id": "700780317",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "Ah... well, I am a local. It's only natural that locals know a few secrets outsiders don't."
          },
          "700780307": {
            "id": "700780307",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "Haha, no, that's not what I meant. Sorry, I should have chosen my words more wisely.",
            "nextDialogs": [
              "700780308"
            ]
          },
          "700780308": {
            "id": "700780308",
            "speakerId": 1001,
            "speakerName": "Odolf",
            "text": "It's a good thing you arrived early. For example... it means we can start the investigation sooner."
          }
        }
      }
    },
    {
      "subId": "7007804",
      "subQuestName": "Go to the other entrance to the ruins at the base of the lighthouse",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700780401"

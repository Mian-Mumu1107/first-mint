    {
      "subId": "7007815",
      "subQuestName": "Continue investigating the lighthouse ruins",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7007816",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700781601"
        ],
        "dialogs": {
          "700781601": {
            "id": "700781601",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "That alarm was flashing so fast earlier. Paimon really thought there's something dangerous...",
            "nextDialogs": [
              "700781602"
            ]
          },
          "700781602": {
            "id": "700781602",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "But now it looks like there's nothing at all. No Abyss monsters, no ghosts either.",
            "nextDialogs": [
              "700781603"
            ]
          },
          "700781603": {
            "id": "700781603",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "It almost feels a little lonely.",
            "nextDialogs": [
              "700781604"
            ]
          },
          "700781604": {
            "id": "700781604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Loneliness is the most frightening thing of all.",
            "nextDialogs": [
              "700781605"
            ]
          },
          "700781605": {
            "id": "700781605",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Oh, is it? Paimon doesn't understand at all!",
            "nextDialogs": [
              "700781606"
            ]
          },
          "700781606": {
            "id": "700781606",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "But where did that strong wind just now come from... Wait. It's coming from above.",
            "nextDialogs": [
              "700781607"
            ]
          },
          "700781607": {
            "id": "700781607",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Something just fell from above! Eek!!!"
          }
        }
      }
    },

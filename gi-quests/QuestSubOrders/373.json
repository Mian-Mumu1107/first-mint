    {
      "subId": "37302",
      "subQuestName": "Talk to Venti",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3730201"
        ],
        "dialogs": {
          "3730201": {
            "id": "3730201",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Oh? What are you doing here?",
            "nextDialogs": [
              "3730202"
            ]
          },
          "3730202": {
            "id": "3730202",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Though I was just wondering if you would happen to follow me...",
            "nextDialogs": [
              "3730203"
            ]
          },
          "3730203": {
            "id": "3730203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I want to know more about the Anemo God.",
            "nextDialogs": [
              "3730204"
            ]
          },
          "3730204": {
            "id": "3730204",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "You speak of the God of Anemo, Barbatos? He already disappeared from Mondstadt a long time ago.",
            "nextDialogs": [
              "3730205"
            ]
          },
          "3730205": {
            "id": "3730205",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Liyue and Inazuma's respective gods of Geo and Electro are still present, but Mondstadt has seen many a moon since they last saw their own god.",
            "nextDialogs": [
              "3730206"
            ]
          },
          "3730206": {
            "id": "3730206",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Why do you wish to know about the God of Anemo? Does it have something to do with Dvalin?",
            "nextDialogs": [
              "3730207"
            ]
          },
          "3730207": {
            "id": "3730207",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh... ahhh... it's because gods...",
            "nextDialogs": [
              "3730208"
            ]
          },
          "3730208": {
            "id": "3730208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, someone told me about Dvalin's past.",
            "nextDialogs": [
              "3730209"
            ]
          },
          "3730209": {
            "id": "3730209",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Just how is it that everyone sees Stormterror? I'm quite curious.",
            "nextDialogs": [
              "3730210"
            ]
          },
          "3730210": {
            "id": "3730210",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "That said, there's no need to rush...",
            "nextDialogs": [
              "3730211"
            ]
          },
          "3730211": {
            "id": "3730211",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "I have not been back in a while, it seems there are a few who are unhappy with my arrival."
          }
        }
      }
    },
    {

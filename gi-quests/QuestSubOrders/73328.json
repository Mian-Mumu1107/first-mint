        ],
        "dialogs": {
          "733280201": {
            "id": "733280201",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Well, here's your a thousand hugs! Until next time!",
            "nextDialogs": [
              "733280203",
              "733280207"
            ]
          },
          "733280203": {
            "id": "733280203",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Who knows? Maybe in Celestia?",
            "nextDialogs": [
              "733280204"
            ]
          },
          "733280204": {
            "id": "733280204",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Hahahaha! I was joking! But if you want to see me there, I will definitely be there.",
            "nextDialogs": [
              "733280205"
            ]
          },
          "733280205": {
            "id": "733280205",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Don't ask me why. I just know it.",
            "nextDialogs": [
              "733280208"
            ]
          },
          "733280208": {
            "id": "733280208",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Anyway, until next time!"
          },
          "733280207": {
            "id": "733280207",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Haha, thanks!"
          }
        }
      }
    }

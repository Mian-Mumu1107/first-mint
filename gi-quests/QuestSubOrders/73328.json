      "dialogue": {
        "startDialogs": [
          "733280101"
        ],
        "dialogs": {
          "733280101": {
            "id": "733280101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey there, Jeht!",
            "nextDialogs": [
              "733280102"
            ]
          },
          "733280102": {
            "id": "733280102",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "#{NICKNAME}? And Paimon, too!",
            "nextDialogs": [
              "733280103"
            ]
          },
          "733280103": {
            "id": "733280103",
            "speakerId": 16771,
            "speakerName": "Benben",
            "text": "Beep beep!",
            "nextDialogs": [
              "733280104"
            ]
          },
          "733280104": {
            "id": "733280104",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Haha, see what I told you? We'd meet again!",
            "nextDialogs": [
              "733280105"
            ]
          },
          "733280105": {
            "id": "733280105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing here?",
            "nextDialogs": [
              "733280106"
            ]
          },
          "733280106": {
            "id": "733280106",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Well, that's a proper lady's little secret.",
            "nextDialogs": [
              "733280107"
            ]
          },
          "733280107": {
            "id": "733280107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "?",
            "nextDialogs": [
              "733280108"
            ]
          },
          "733280108": {
            "id": "733280108",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "#{M#It means no probing! Even I wanna keep some things to myself, you know...}{F#Find me an izakaya and amuse me, and I might divulge a secret or two... Didn't you know that already?}",
            "nextDialogs": [
              "733280109"
            ]
          },
          "733280109": {
            "id": "733280109",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "#{M#Pfft, sorry 'bout that, but according to the rules we've gotta follow as guards-for-hire, I can't tell you anything.}{F#Haha, I'm just joking! There are some rules we must follow as guards... We mustn't say a word about the goods we're escorting. My apologies.}",
            "nextDialogs": [
              "733280110"
            ]
          },
          "733280110": {
            "id": "733280110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph, you sound all secretive!",
            "nextDialogs": [
              "733280111"
            ]
          },
          "733280111": {
            "id": "733280111",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "So... How have you been?",
            "nextDialogs": [
              "733280114"
            ]
          },
          "733280114": {
            "id": "733280114",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Yeah... The same with me.",
            "nextDialogs": [
              "733280115"
            ]
          },
          "733280115": {
            "id": "733280115",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Alright, I won't keep you any longer. *sigh* I've got my own business to deal with.",
            "nextDialogs": [
              "733280116"
            ]
          },
          "733280116": {
            "id": "733280116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, you're so busy, Jeht. You weren't like this before.",
            "nextDialogs": [
              "733280117"
            ]
          },
          "733280117": {
            "id": "733280117",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Pfft... Well, that's a \"stable\" job for ya, though what I'm doing is pretty much the same as before.",
            "nextDialogs": [
              "733280118"
            ]
          },
          "733280118": {
            "id": "733280118",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "It really hasn't taken too long for me to start missing my old, carefree days...",
            "nextDialogs": [
              "733280119"
            ]
          },
          "733280119": {
            "id": "733280119",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "I don't know what you've been doing lately, but I always look forward to listening to your stories... and I've got plenty to share with you, too.",
            "nextDialogs": [
              "733280120"
            ]
          },
          "733280120": {
            "id": "733280120",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "But we're in no hurry. Good stories are like wine. Gotta let them age properly, you know? Travelers in the desert used to live on these stories once upon a time, hehe!",
            "nextDialogs": [
              "733280121"
            ]
          },
          "733280121": {
            "id": "733280121",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Mm... Anyway, stay safe.",
            "nextDialogs": [
              "733280122"
            ]
          },
          "733280122": {
            "id": "733280122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You too, Jeht.",
            "nextDialogs": [
              "733280123"
            ]
          },
          "733280123": {
            "id": "733280123",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Yeah, lemme give you a thousand hugs. I'll be praying for your safety.",
            "nextDialogs": [
              "733280124"
            ]
          },
          "733280124": {
            "id": "733280124",
            "speakerId": 16771,
            "speakerName": "Benben",
            "text": "Beep!",
            "nextDialogs": [
              "733280125"
            ]
          },
          "733280125": {
            "id": "733280125",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Haha, Benben will be doing so too!"
          }
        }
      }
    },
    {
      "subId": "7332802",

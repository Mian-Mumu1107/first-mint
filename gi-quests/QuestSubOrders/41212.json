  "subQuests": [
    {
      "subId": "4121201",
      "subQuestName": "Meet with Albedo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412120101"
        ],
        "dialogs": {
          "412120101": {
            "id": "412120101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Albedo! We're back~!",
            "nextDialogs": [
              "412120102"
            ]
          },
          "412120102": {
            "id": "412120102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, hey, does he have a guest over?",
            "nextDialogs": [
              "412120105"
            ]
          },
          "412120105": {
            "id": "412120105",
            "speakerId": 1001,
            "speakerName": "Cyrus",
            "text": "Yes, perhaps it is too soon to ask our greenhorns to come adventuring here...",
            "nextDialogs": [
              "412120106"
            ]
          },
          "412120106": {
            "id": "412120106",
            "speakerId": 1001,
            "speakerName": "Cyrus",
            "text": "But adventure is nothing if it is not about pushing our limits! What is a journey without struggle, without excitement?",
            "nextDialogs": [
              "412120107"
            ]
          },
          "412120107": {
            "id": "412120107",
            "speakerId": 1001,
            "speakerName": "Cyrus",
            "text": "This place may be infested with wicked hilichurl bandits and knee-deep snow, but an adventurer must never stop pressing forward!",
            "nextDialogs": [
              "412120108"
            ]
          },
          "412120108": {
            "id": "412120108",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "Cyrus, to the point, please.",
            "nextDialogs": [
              "412120109"
            ]
          },
          "412120109": {
            "id": "412120109",
            "speakerId": 1001,
            "speakerName": "Cyrus",
            "text": "Hahaha! Come, come! The beauty of a chat lies in the journey, not the destination — just like an adventure!",
            "nextDialogs": [
              "412120110"
            ]
          },
          "412120110": {
            "id": "412120110",
            "speakerId": 1001,
            "speakerName": "Cyrus",
            "text": "Even if you are robbed blind and must give up on your encampment, you can start a fire and cook a meal in the frigid snow!",
            "nextDialogs": [
              "412120111"
            ]
          },
          "412120111": {
            "id": "412120111",
            "speakerId": 1001,
            "speakerName": "Cyrus",
            "text": "This journey up the mountain will be an unforgettable one for all our newcomers!",
            "nextDialogs": [
              "412120112"
            ]
          },
          "412120112": {
            "id": "412120112",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "Mm, yes.",
            "nextDialogs": [
              "412120113"
            ]
          },
          "412120113": {
            "id": "412120113",
            "speakerId": 1001,
            "speakerName": "Cyrus",
            "text": "They may resent me, or even hate me. But in the future, they will think back upon this moment with hearts full of gratitude — for this was the day that the spirit of adventure was passed on to them!",
            "nextDialogs": [
              "412120114"
            ]
          },
          "412120114": {
            "id": "412120114",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "Oh yes, go on.",
            "nextDialogs": [
              "412120115"
            ]
          },
          "412120115": {
            "id": "412120115",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh brother... Albedo's at it again. He's always so cold when the topic doesn't catch his fancy...",
            "nextDialogs": [
              "412120116"
            ]
          },
          "412120116": {
            "id": "412120116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He isn't interested in adventurers in the slightest, is he?",
            "nextDialogs": [
              "412120117"
            ]
          },
          "412120117": {
            "id": "412120117",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "He sure is interested in you, though.",
            "nextDialogs": [
              "412120118"
            ]
          },
          "412120118": {
            "id": "412120118",
            "speakerId": 1001,
            "speakerName": "Cyrus",
            "text": "Still... should we say that our newcomers are too green, or that the mountain is too mighty? We have taken great losses this time...",
            "nextDialogs": [
              "412120119"
            ]
          },
          "412120119": {
            "id": "412120119",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What? What do you mean, \"great losses\"?",
            "nextDialogs": [
              "412120120"
            ]
          },
          "412120120": {
            "id": "412120120",
            "speakerId": 1001,
            "speakerName": "Cyrus",
            "text": "Oh, you must be...",
            "nextDialogs": [
              "412120121"
            ]
          },
          "412120121": {
            "id": "412120121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's up, Cyrus?",
            "nextDialogs": [
              "412120122"
            ]
          },
          "412120122": {
            "id": "412120122",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Long time no see—!",
            "nextDialogs": [
              "412120123"
            ]
          },
          "412120123": {
            "id": "412120123",
            "speakerId": 1001,
            "speakerName": "Cyrus",
            "text": "#Ah, yes! The young adventurer and {M#his}{F#her} companion! It is my pleasure to see you here.",
            "nextDialogs": [
              "412120124"
            ]
          },
          "412120124": {
            "id": "412120124",
            "speakerId": 1001,
            "speakerName": "Cyrus",
            "text": "I trust these frigid ascents have not given you too much trouble?",
            "nextDialogs": [
              "412120125"
            ]
          },
          "412120125": {
            "id": "412120125",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ha, we can take anything it has to throw at us!",
            "nextDialogs": [
              "412120126"
            ]
          },
          "412120126": {
            "id": "412120126",
            "speakerId": 1001,
            "speakerName": "Cyrus",
            "text": "Hahaha! Good, good! I love your confidence!",
            "nextDialogs": [
              "412120127"
            ]
          },
          "412120127": {
            "id": "412120127",
            "speakerId": 1001,
            "speakerName": "Cyrus",
            "text": "But you must be here on some important duty, braving the wind and snow like this.",
            "nextDialogs": [
              "412120128"
            ]
          },
          "412120128": {
            "id": "412120128",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "#I came here to gather the latest data on hilichurls, and asked {M#him}{F#her} to serve as my assistant."
          }
        }
      }
    },
    {
      "subId": "4121203",
      "subQuestName": "Speak to Albedo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4121204",
      "subQuestName": "Head partway up the mountain",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412120401"
        ],
        "dialogs": {
          "412120401": {
            "id": "412120401",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "We must get the book back, it has my notes and sketches in it."
          }
        }
      }
    },
    {
      "subId": "4121221",
      "subQuestName": "Speak to Albedo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412120301"
        ],
        "dialogs": {
          "412120301": {
            "id": "412120301",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "Hmm. It seems that no one is here.",
            "nextDialogs": [
              "412120302"
            ]
          },
          "412120302": {
            "id": "412120302",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Do monsters go out to run errands too?",
            "nextDialogs": [
              "412120303"
            ]
          },
          "412120303": {
            "id": "412120303",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "Well then, would you like to take a look around before they return, or shall we rest a while here?",
            "nextDialogs": [
              "412120305",
              "412120307"
            ]
          },
          "412120305": {
            "id": "412120305",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "Just what I was thinking.",
            "nextDialogs": [
              "412120309"
            ]
          },
          "412120309": {
            "id": "412120309",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So, we're having a chat now? Paimon wants in!",
            "nextDialogs": [
              "412120310"
            ]
          },
          "412120310": {
            "id": "412120310",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "I know you must have questions, whether it be about me, or about this entire situation. As I said before, I will answer them.",
            "nextDialogs": [
              "412120311"
            ]
          },
          "412120311": {
            "id": "412120311",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "But I will not deceive you. There are some things I cannot go into detail on. On these matters, you'll have to permit me to summarize a bit.",
            "nextDialogs": [
              "412120312"
            ]
          },
          "412120312": {
            "id": "412120312",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh. Guess Albedo can be pretty straightforward when he wants to be..."
          },
          "412120307": {
            "id": "412120307",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "...",
            "nextDialogs": [
              "412120308"
            ]
          },
          "412120308": {
            "id": "412120308",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "Alright. What would you like to ask?"
          }
        }
      }
    },
    {
      "subId": "4121207",
      "subQuestName": "Defeat the attacking hilichurls",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412120701"
        ],
        "dialogs": {
          "412120701": {
            "id": "412120701",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Albedo, how's the sketchbook situation?",
            "nextDialogs": [
              "412120702"
            ]
          },
          "412120702": {
            "id": "412120702",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "It's alright. A few pages were destroyed, but most of it is intact.",
            "nextDialogs": [
              "412120703"
            ]
          },
          "412120703": {
            "id": "412120703",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "The temperature in the Snowy Mountain is subzero. It can reach extremely low temperatures, especially near that cavern.",
            "nextDialogs": [
              "412120704"
            ]
          },
          "412120704": {
            "id": "412120704",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "What makes matters worse is that the hilichurls have drooled all over the pages. To leave wet paper in such low temperatures, it's too dreadful to imagine...",
            "nextDialogs": [
              "412120705"
            ]
          },
          "412120705": {
            "id": "412120705",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Frozen paper is so brittle. It doesn't take much for it to fall apart, huh?",
            "nextDialogs": [
              "412120706"
            ]
          },
          "412120706": {
            "id": "412120706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Fortunately, you knew how to piece it back together.",
            "nextDialogs": [
              "412120707"
            ]
          },
          "412120707": {
            "id": "412120707",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "No wonder you're an alchemist! Such an ingenious mind!",
            "nextDialogs": [
              "412120708"
            ]
          },
          "412120708": {
            "id": "412120708",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "If the sketchbook had been severely damaged, you'd be furious, wouldn't you?",
            "nextDialogs": [
              "412120709"
            ]
          },
          "412120709": {
            "id": "412120709",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "What leads you to believe that?",
            "nextDialogs": [
              "412120710"
            ]
          },
          "412120710": {
            "id": "412120710",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You told us there's a lot of drawings and notes inside.",
            "nextDialogs": [
              "412120711"
            ]
          },
          "412120711": {
            "id": "412120711",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "I must admit, I bring this sketchbook everywhere I go.",
            "nextDialogs": [
              "412120712"
            ]
          },
          "412120712": {
            "id": "412120712",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "However, I wouldn't fly into a rage over such a thing.",
            "nextDialogs": [
              "412120713"
            ]
          },
          "412120713": {
            "id": "412120713",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "Had I not been able to salvage it, I would just draw everything again.",
            "nextDialogs": [
              "412120714"
            ]
          },
          "412120714": {
            "id": "412120714",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eh... How pragmatic of you...",
            "nextDialogs": [
              "412120717"
            ]
          },
          "412120717": {
            "id": "412120717",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "Is that so?",
            "nextDialogs": [
              "412120718"
            ]
          },
          "412120718": {
            "id": "412120718",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "After all, you've put a lot of effort into your drawings.",
            "nextDialogs": [
              "412120719"
            ]
          },
          "412120719": {
            "id": "412120719",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That's right!",
            "nextDialogs": [
              "412120720"
            ]
          },
          "412120720": {
            "id": "412120720",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Think of all the memories you've committed to paper.",
            "nextDialogs": [
              "412120721"
            ]
          },
          "412120721": {
            "id": "412120721",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yep yep!",
            "nextDialogs": [
              "412120722"
            ]
          },
          "412120722": {
            "id": "412120722",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Such mementos shouldn't be easily abandoned.",
            "nextDialogs": [
              "412120723"
            ]
          },
          "412120723": {
            "id": "412120723",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Absolutely! All well said. You took the words out of Paimon's mouth, {NICKNAME}.",
            "nextDialogs": [
              "412120724"
            ]
          },
          "412120724": {
            "id": "412120724",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "Hmm... You're right. Redrawing everything would be a tedious endeavor.",
            "nextDialogs": [
              "412120725"
            ]
          },
          "412120725": {
            "id": "412120725",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Especially since you're so talented, right?",
            "nextDialogs": [
              "412120726"
            ]
          },
          "412120726": {
            "id": "412120726",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You've mastered so many skills and gathered so much knowledge that other people can only dream of!",
            "nextDialogs": [
              "412120727"
            ]
          },
          "412120727": {
            "id": "412120727",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But such talented people sometimes forget about that. It's one of the downsides of being smart, isn't it?",
            "nextDialogs": [
              "412120728"
            ]
          },
          "412120728": {
            "id": "412120728",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Albedo's also praised your smarts, Paimon.",
            "nextDialogs": [
              "412120729"
            ]
          },
          "412120729": {
            "id": "412120729",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "Without a doubt, Paimon is an interesting creature."
          }
        }
      }
    },
    {
      "subId": "4121205",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412120501"
        ],
        "dialogs": {
          "412120501": {
            "id": "412120501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Did you see that? That hilichurl ran off while holding on to something that looks like a book!",
            "nextDialogs": [
              "412120502"
            ]
          },
          "412120502": {
            "id": "412120502",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "That's... not good. That was my sketchbook.",
            "nextDialogs": [
              "412120505"
            ]
          },
          "412120505": {
            "id": "412120505",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon thinks it's just your run-of-the-mill thief, really.",
            "nextDialogs": [
              "412120506"
            ]
          },
          "412120506": {
            "id": "412120506",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "To think that it dared to steal my sketchbook. Quite bold, this one.",
            "nextDialogs": [
              "412120507"
            ]
          },
          "412120507": {
            "id": "412120507",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, looks like Albedo's got a frosty temper...",
            "nextDialogs": [
              "412120508"
            ]
          },
          "412120508": {
            "id": "412120508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll lend you a hand."
          }
        }
      }
    },

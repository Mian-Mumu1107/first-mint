    {
      "subId": "4121209",
      "subQuestName": "Follow the footprints to tail the hilichurl",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412120901"
        ],
        "dialogs": {
          "412120901": {
            "id": "412120901",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "This is the monsters' camp. It seems that the birds have brought their plunder back to their nest.",
            "nextDialogs": [
              "412120902"
            ]
          },
          "412120902": {
            "id": "412120902",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Let's get in there!",
            "nextDialogs": [
              "412120903"
            ]
          },
          "412120903": {
            "id": "412120903",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "No, our best option is to find a way to lure them out."
          }
        }
      }
    },
    {
      "subId": "4121210",
      "subQuestName": "Speak to Albedo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412120601"
        ],
        "dialogs": {
          "412120601": {
            "id": "412120601",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Looks like it's a dead end. You know, except for this huge cavern entrance.",
            "nextDialogs": [
              "412120602"
            ]
          },
          "412120602": {
            "id": "412120602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did it run in there?",
            "nextDialogs": [
              "412120603"
            ]
          },
          "412120603": {
            "id": "412120603",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "Judging from the tracks, that seems to be the case.",
            "nextDialogs": [
              "412120604"
            ]
          },
          "412120604": {
            "id": "412120604",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Then what are we waiting for!? We can't let it escape!",
            "nextDialogs": [
              "412120605"
            ]
          },
          "412120605": {
            "id": "412120605",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "Wait.",
            "nextDialogs": [
              "412120606"
            ]
          },
          "412120606": {
            "id": "412120606",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "This mountain is incredibly large. Even if there was a path within its bowels, such a road would not be easy to walk.",
            "nextDialogs": [
              "412120607"
            ]
          },
          "412120607": {
            "id": "412120607",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "...",
            "nextDialogs": [
              "412120608"
            ]
          },
          "412120608": {
            "id": "412120608",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "Can you feel it? The wind carries the scent of ice and stone with it... and the sound of echoes. The space within must be massive.",
            "nextDialogs": [
              "412120609"
            ]
          },
          "412120609": {
            "id": "412120609",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "R—Really?",
            "nextDialogs": [
              "412120610"
            ]
          },
          "412120610": {
            "id": "412120610",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "As such, rash moves are of no benefit to us.",
            "nextDialogs": [
              "412120611"
            ]
          },
          "412120611": {
            "id": "412120611",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But... But we've come all this way — we can't just let it leave!",
            "nextDialogs": [
              "412120612"
            ]
          },
          "412120612": {
            "id": "412120612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Isn't that sketchbook very important to you?",
            "nextDialogs": [
              "412120613"
            ]
          },
          "412120613": {
            "id": "412120613",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "It is. But that doesn't mean that we should act recklessly.",
            "nextDialogs": [
              "412120614"
            ]
          },
          "412120614": {
            "id": "412120614",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "There is another way. It just requires some extra work.",
            "nextDialogs": [
              "412120615"
            ]
          },
          "412120615": {
            "id": "412120615",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "If my guess is correct, this cavern's exit is on the other side of the mountain.",
            "nextDialogs": [
              "412120616"
            ]
          },
          "412120616": {
            "id": "412120616",
            "speakerId": 1002,
            "speakerName": "Albedo",
            "text": "You are quite the expert glider, and I'm a fair hand myself. So prepare yourself, and we'll glide across in one go."
          }
        }
      }
    },

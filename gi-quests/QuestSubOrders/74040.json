    {
      "subId": "7404012",
      "subQuestName": "Use the conches to send the signal again",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740401201"
        ],
        "dialogs": {
          "740401201": {
            "id": "740401201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, are you alright?",
            "nextDialogs": [
              "740401202"
            ]
          },
          "740401202": {
            "id": "740401202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You told Paimon to hide, and then you went wild on those slimes... Then you picked up a handful of sand and started talking to yourself!",
            "nextDialogs": [
              "740401203"
            ]
          },
          "740401203": {
            "id": "740401203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What happened to you just now? You scared Paimon half to death!",
            "nextDialogs": [
              "740401205",
              "740401208"
            ]
          },
          "740401205": {
            "id": "740401205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Wait... So you thought you were fighting a group of monsters from the Abyss? No wonder you had that scarily serious look on your face!",
            "nextDialogs": [
              "740401206"
            ]
          },
          "740401206": {
            "id": "740401206",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmph. If you ask Paimon, this is all Verenata's potions' fault!",
            "nextDialogs": [
              "740401210"
            ]
          },
          "740401210": {
            "id": "740401210",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "What's with all that noise! What are you doing!? Were you trying to haul the wreck off while I wasn't around?",
            "nextDialogs": [
              "740401211"
            ]
          },
          "740401211": {
            "id": "740401211",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... Is the wood from shipwrecks like these worth a lot?",
            "nextDialogs": [
              "740401212"
            ]
          },
          "740401212": {
            "id": "740401212",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "I don't know... Hey, is that really what you're planning!? You... naughty jellyfish!",
            "nextDialogs": [
              "740401213"
            ]
          },
          "740401213": {
            "id": "740401213",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Hmm... Even though it's in pieces... Well, bits of it can still be collected as souvenirs...",
            "nextDialogs": [
              "740401214"
            ]
          },
          "740401214": {
            "id": "740401214",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "I'm afraid it's probably impossible to restore its original white ironclad appearance... But I can still explore her past experiences... Maybe..."
          },
          "740401208": {
            "id": "740401208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A pendant? But there's nothing in your hands but sand! Huh? Wait, there's also a really small conch...",
            "nextDialogs": [
              "740401209"
            ]
          },
          "740401209": {
            "id": "740401209",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, so you were talking to this \"imaginary pendant\"? ... That's just the contents of the logbook earlier confusing you, right?"
          }
        }
      }
    },
    {
      "subId": "7404013",
      "subQuestName": "Follow the phantom once again",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740401301"
        ],
        "dialogs": {
          "740401301": {
            "id": "740401301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? This is a... navigation log? It looks like it's relatively intact! Should we give it a read?"
          }
        }
      }
    },
    {
      "subId": "7404014",
      "subQuestName": "Get to the location where the phantom stopped",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }

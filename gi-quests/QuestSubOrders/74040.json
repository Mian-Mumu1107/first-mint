  "subQuests": [
    {
      "subId": "7404001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400101"
        ],
        "dialogs": {
          "740400101": {
            "id": "740400101",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Hello, I'm Ahes. It's a pleasure to meet a new friend!",
            "nextDialogs": [
              "740400102"
            ]
          },
          "740400102": {
            "id": "740400102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hi, Ahes! Paimon's Paimon!",
            "nextDialogs": [
              "740400103"
            ]
          },
          "740400103": {
            "id": "740400103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#Hello there, I'm {NICKNAME}.",
            "nextDialogs": [
              "740400104"
            ]
          },
          "740400104": {
            "id": "740400104",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Verenata told me that you found \"that ship\" too! Is it true? Is it?",
            "nextDialogs": [
              "740400105"
            ]
          },
          "740400105": {
            "id": "740400105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Well, there are a lot of ships in the ocean, but...",
            "nextDialogs": [
              "740400107",
              "740400110"
            ]
          },
          "740400107": {
            "id": "740400107",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Th—That very unique ship!",
            "nextDialogs": [
              "740400108"
            ]
          },
          "740400108": {
            "id": "740400108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oooh... that ship, huh...",
            "nextDialogs": [
              "740400115"
            ]
          },
          "740400115": {
            "id": "740400115",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Haha! Sorry, forgive me! I must have confused you!",
            "nextDialogs": [
              "740400116"
            ]
          },
          "740400116": {
            "id": "740400116",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Ahem, the ship I mentioned is the Sponsian, a white ironclad ship that sails through dreams, and the explorer of whirlpools and the abyss... It's the flagship of Admiral Basil Elton!",
            "nextDialogs": [
              "740400117"
            ]
          },
          "740400117": {
            "id": "740400117",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Captain Basil left a faded shipwreck and a tattered logbook in these waters... I come here every day to pick up and read everything with writing on them!",
            "nextDialogs": [
              "740400118"
            ]
          },
          "740400118": {
            "id": "740400118",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Hehe, so you can consider me a Sponsian archaeologist! I know everything about her! Well, not everything-everything, but I know at least half of her!",
            "nextDialogs": [
              "740400119"
            ]
          },
          "740400119": {
            "id": "740400119",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa! You must really love this ship, huh? You just can't stop talking about her once you start.",
            "nextDialogs": [
              "740400120"
            ]
          },
          "740400120": {
            "id": "740400120",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But since even you only know half... She must've been a huge ship, then!",
            "nextDialogs": [
              "740400121"
            ]
          },
          "740400121": {
            "id": "740400121",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Well... She isn't that huge... because Captain Basil only left half of its hull behind...",
            "nextDialogs": [
              "740400122"
            ]
          },
          "740400122": {
            "id": "740400122",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um, so..."
          },
          "740400110": {
            "id": "740400110",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Yes, yes, that one!",
            "nextDialogs": [
              "740400111"
            ]
          },
          "740400111": {
            "id": "740400111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah, that one! Paimon thought you were talking about a different one! Haha...",
            "nextDialogs": [
              "740400112"
            ]
          },
          "740400112": {
            "id": "740400112",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Then... which ship were you thinking about?"
          }
        }
      }
    },
    {
      "subId": "7404002",
      "subQuestName": "Go to the place Ahes mentioned",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400201"
        ],
        "dialogs": {
          "740400201": {
            "id": "740400201",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "This is the place! We've arrived!",
            "nextDialogs": [
              "740400202"
            ]
          },
          "740400202": {
            "id": "740400202",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Um, please wait just a moment... Allow me to tune the conch a bit.",
            "nextDialogs": [
              "740400203"
            ]
          },
          "740400203": {
            "id": "740400203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? \"Tune\"... a conch? Is that a part of the grilling process...?",
            "nextDialogs": [
              "740400204"
            ]
          },
          "740400204": {
            "id": "740400204",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Oh, come on. All you know is eat, eat, eat! This is a military conch for communication!",
            "nextDialogs": [
              "740400205"
            ]
          },
          "740400205": {
            "id": "740400205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A... military conch?",
            "nextDialogs": [
              "740400206"
            ]
          },
          "740400206": {
            "id": "740400206",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Yes, this is an old military conch. Ancient sailors used conches as a tool to communicate with each other... It must be a relic left behind from when the navy still existed. I found it in a sunken wreck.",
            "nextDialogs": [
              "740400207"
            ]
          },
          "740400207": {
            "id": "740400207",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "When I tuned the conch here last time, I heard her response. Since you've seen her, I think you should be able to hear her response too!",
            "nextDialogs": [
              "740400208"
            ]
          },
          "740400208": {
            "id": "740400208",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "But you'll have to wait a moment, you know! I have to tune the conch before I can send out the proper signal.",
            "nextDialogs": [
              "740400210",
              "740400212"
            ]
          },
          "740400210": {
            "id": "740400210",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Yes, that's correct. However, both the time of day and the conditions of the sea will affect the conch's signal generation, so you have to constantly tune it to make sure it'll work. Hehe... that's the problem with antiques.",
            "nextDialogs": [
              "740400213"
            ]
          },
          "740400213": {
            "id": "740400213",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Hmm, anyway, please wait while I tune this conch to align with the vibration of the waves. Don't go running too far away now!",
            "nextDialogs": [
              "740400214"
            ]
          },
          "740400214": {
            "id": "740400214",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Ahes deftly works with the conch in her hand, and not long after, the tuning is complete...",
            "nextDialogs": [
              "740400215"
            ]
          },
          "740400215": {
            "id": "740400215",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Okay, that's it! Hehe, I've learned a lot from those ancient seafarer manuals!",
            "nextDialogs": [
              "740400216"
            ]
          },
          "740400216": {
            "id": "740400216",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Now, allow me to give you a little primer. There are three kinds of short signals that I usually use...",
            "nextDialogs": [
              "740400217"
            ]
          },
          "740400217": {
            "id": "740400217",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "\"Long low note, short low note, long low note.\" Yes... This one should mean... Well, my guess is that it probably means \"Ready and waiting.\"",
            "nextDialogs": [
              "740400218"
            ]
          },
          "740400218": {
            "id": "740400218",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "\"Long low note, long low note, long low note, long low note, long low note.\" This one means... Um, I'm not actually sure, but the response I received last time was something like that, so it's definitely useful for something!",
            "nextDialogs": [
              "740400219"
            ]
          },
          "740400219": {
            "id": "740400219",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "\"Short low note, long low note, short low note, long low note, short low note, long low note, short low note, long low note, short low note, long low note\"... Phew! This is a long one, for sure! This is the signal that has the highest likelihood of receiving a response, and as for its meaning...",
            "nextDialogs": [
              "740400220"
            ]
          },
          "740400220": {
            "id": "740400220",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "According to the manual at least... it means \"I have a message to send.\"",
            "nextDialogs": [
              "740400221"
            ]
          },
          "740400221": {
            "id": "740400221",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... So, what should we do to figure out the signal that will receive a response?"
          },
          "740400212": {
            "id": "740400212",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Hehe, pretty cool, isn't it? She's just like a whale! You sing, and she responds. I've heard the sound with my own ears, it's true."
          }
        }
      }
    },

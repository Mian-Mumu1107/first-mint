    {
      "subId": "7404015",
      "subQuestName": "Talk to Ahes",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400901"
        ],
        "dialogs": {
          "740400901": {
            "id": "740400901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa, look! This wreckage must've once been the ship we were chasing earlier — or, well, half of it anyway...",
            "nextDialogs": [
              "740400902"
            ]
          },
          "740400902": {
            "id": "740400902",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "...!",
            "nextDialogs": [
              "740400903"
            ]
          },
          "740400903": {
            "id": "740400903",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Sh—She's all torn up...",
            "nextDialogs": [
              "740400904"
            ]
          },
          "740400904": {
            "id": "740400904",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey... Don't be so sad, Ahes... We couldn't have expected things to turn out like this, right?",
            "nextDialogs": [
              "740400905"
            ]
          },
          "740400905": {
            "id": "740400905",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "I know, but... Oh, forget it... I'll go look around and see if there's anything worth investigating...",
            "nextDialogs": [
              "740400906"
            ]
          },
          "740400906": {
            "id": "740400906",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Yeah, there might be some good stuff left... C'mon, {NICKNAME}, let's have a look around as well!"
          }
        }
      }
    },
    {
      "subId": "7404016",
      "subQuestName": "Look for clues near the wreck",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7404028",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740401001"
        ],
        "dialogs": {
          "740401001": {
            "id": "740401001",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "In other words, this ship must've sunk during the struggle against the sea monster...",
            "nextDialogs": [
              "740401002"
            ]
          },
          "740401002": {
            "id": "740401002",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Then this half was torn up by the waves and floated on the ocean currents before finally settling here.",
            "nextDialogs": [
              "740401005"
            ]
          },
          "740401005": {
            "id": "740401005",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, but wouldn't that mean that she really was bitten in half? ... Huh? What's that noise?",
            "nextDialogs": [
              "740401006"
            ]
          },
          "740401006": {
            "id": "740401006",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ugh, more monsters! Here they come again!",
            "nextDialogs": [
              "740401007"
            ]
          },
          "740401007": {
            "id": "740401007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon, hide!",
            "nextDialogs": [
              "740401008"
            ]
          },
          "740401008": {
            "id": "740401008",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But... but... Okay!"
          }
        }
      }
    },
    {
      "subId": "7404017",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7404018",
      "subQuestName": "Investigate the strange item",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740401101"
        ],
        "dialogs": {
          "740401101": {
            "id": "740401101",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "\"...Oh leave her, sailors, leave her...\"\\n\"...Tomorrow you'll get your pay, and it's time for us to leave her...\"\\n\"...Oh leave her, sailors, leave her...\"\\n\"For the voyage is done and the winds don't blow, so it's time for us to leave her...\"",
            "nextDialogs": [
              "740401102"
            ]
          },
          "740401102": {
            "id": "740401102",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "\"...No grog allowed and rotten grub, and it's time for us to leave her...\"\\n\"...Oh leave her, sailors, leave her...\"\\n\"...The sails all furled, our work is done, and it's time for us to leave her...\"",
            "nextDialogs": [
              "740401103"
            ]
          },
          "740401103": {
            "id": "740401103",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "As the dream-like shanty dissolves into the ocean waves, a sorrowful voice comes from the strange pendant...",
            "nextDialogs": [
              "740401104"
            ]
          },
          "740401104": {
            "id": "740401104",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "\"Blue, like a little sailor... I saw her... Haha...\"\\n\"She had the scent of sea monsters on her...\"\\n\"But she is a good child. Perhaps she will not get my flagship dirty...\"",
            "nextDialogs": [
              "740401105"
            ]
          },
          "740401105": {
            "id": "740401105",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "\"Heh, it's a shame I couldn't protect her well enough. She was a good boat...\""
          }
        }
      }
    },
    {
      "subId": "7404019",
      "subQuestName": "Talk to Paimon and the others",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7404004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400401"
        ],
        "dialogs": {
          "740400401": {
            "id": "740400401",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "What's wrong, did you forget? The signals you want to send are: \"Low, high, low\"...",
            "nextDialogs": [
              "740400402"
            ]
          },
          "740400402": {
            "id": "740400402",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "\"Low, low, low, low, low\" and... um...",
            "nextDialogs": [
              "740400403"
            ]
          },
          "740400403": {
            "id": "740400403",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "\"High, low, high, low, high, low, high, low, high, low\"... Phew, that's long! But these three signals should all get you a response!"
          }
        }
      }
    },
    {
      "subId": "7404019",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740401901"
        ],
        "dialogs": {
          "740401901": {
            "id": "740401901",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Oh, did you forget the signal? It's \"long low note, short low note, long low note.\"",
            "nextDialogs": [
              "740401903",
              "740401905"
            ]
          },
          "740401903": {
            "id": "740401903",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Hehe, you've got this!"
          },
          "740401905": {
            "id": "740401905",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Well, in that case... Hehe, maybe I should do it myself, then!"
          }
        }
      }
    },
    {
      "subId": "7404020",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740402001"
        ],
        "dialogs": {
          "740402001": {
            "id": "740402001",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Do you still remember the signal? It goes \"Short low note, long low note, short low note, long low note, short low note, long low note, short low note, long low note, short low note, long low note\"!",
            "nextDialogs": [
              "740402002"
            ]
          },
          "740402002": {
            "id": "740402002",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Hehe, it's pretty long, huh?",
            "nextDialogs": [
              "740402004",
              "740402006"
            ]
          },
          "740402004": {
            "id": "740402004",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Hehe, you've got this!"
          },
          "740402006": {
            "id": "740402006",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Well, in that case... Hehe, maybe I should do it myself, then!"
          }
        }
      }
    },
    {
      "subId": "7404021",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740402101"
        ],
        "dialogs": {
          "740402101": {
            "id": "740402101",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "\"Long low note, long low note, long low note, long low note, long low note\" — that's how this signal's supposed to go.",
            "nextDialogs": [
              "740402103",
              "740402105"
            ]
          },
          "740402103": {
            "id": "740402103",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Hehe, you've got this!"
          },
          "740402105": {
            "id": "740402105",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Well, in that case... Hehe, maybe I should do it myself, then!"
          }
        }
      }
    },
    {
      "subId": "7404099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740409902"
        ],
        "dialogs": {
          "740409902": {
            "id": "740409902",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Hmm. Here, aaand... here. They should be marked out on your sea chart now... Anyway, these are my best bets based on the echoes.",
            "nextDialogs": [
              "740409903"
            ]
          },
          "740409903": {
            "id": "740409903",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Let's investigate these areas next!"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7404026",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740401701"
        ],
        "dialogs": {
          "740401701": {
            "id": "740401701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm not sure. What would you prefer, Ahes?",
            "nextDialogs": [
              "740401702"
            ]
          },
          "740401702": {
            "id": "740401702",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Ah, me? Um... if you're asking me, then I would pick this one.",
            "nextDialogs": [
              "740401703"
            ]
          },
          "740401703": {
            "id": "740401703",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Ahes sends the signal with the conch..."
          }
        }
      }
    },
    {
      "subId": "7404007",
      "subQuestName": "Use the conches to send the signal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400701"
        ],
        "dialogs": {
          "740400701": {
            "id": "740400701",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "What happened here... It's a complete mess. There isn't even a complete wreck, it's mostly just... fragments.",
            "nextDialogs": [
              "740400702"
            ]
          },
          "740400702": {
            "id": "740400702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Signs point to her being still further up ahead.",
            "nextDialogs": [
              "740400703"
            ]
          },
          "740400703": {
            "id": "740400703",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "But she must have suffered irreparable damage, so why would she still forge onward in such poor condition? Unless... Hmm. I think we'll find out why soon.",
            "nextDialogs": [
              "740400704"
            ]
          },
          "740400704": {
            "id": "740400704",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So many tiny little pieces everywhere! It's like she was *chomp* bitten in half by a giant sea monster!",
            "nextDialogs": [
              "740400705"
            ]
          },
          "740400705": {
            "id": "740400705",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "..."
          }
        }
      }
    },
    {
      "subId": "7404027",
      "subQuestName": "Talk to Ahes",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740401801"
        ],
        "dialogs": {
          "740401801": {
            "id": "740401801",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Eh... Did you hear it?",
            "nextDialogs": [
              "740401802"
            ]
          },
          "740401802": {
            "id": "740401802",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? What...",
            "nextDialogs": [
              "740401803"
            ]
          },
          "740401803": {
            "id": "740401803",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Shh, the signal... Wait... Her! It's her, she's over there! In the distance!",
            "nextDialogs": [
              "740401804"
            ]
          },
          "740401804": {
            "id": "740401804",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What? Paimon... Paimon can't see anything!",
            "nextDialogs": [
              "740401805"
            ]
          },
          "740401805": {
            "id": "740401805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I saw it.",
            "nextDialogs": [
              "740401806"
            ]
          },
          "740401806": {
            "id": "740401806",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Yes! I knew you'd able to see it too! Quick, after her, let's catch up!",
            "nextDialogs": [
              "740401807"
            ]
          },
          "740401807": {
            "id": "740401807",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Catch... catch what? The ship? Have you two grown sails and sprouted oars or something!?"
          }
        }
      }
    },
    {
      "subId": "7404029",
      "subQuestName": "Follow the phantom that has appeared",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7404008",
      "subQuestName": "Follow the phantom that has appeared",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400801"
        ],
        "dialogs": {
          "740400801": {
            "id": "740400801",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Which is to say, the Sponsian suffered heavy damage, and the damage was related to the abyss expedition, and... she continued to sail on. In that case...",
            "nextDialogs": [
              "740400802"
            ]
          },
          "740400802": {
            "id": "740400802",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Let's use the conch to send out another signal! Maybe we'll hear her response from up ahead!",
            "nextDialogs": [
              "740400803"
            ]
          },
          "740400803": {
            "id": "740400803",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Oh right, right! The signals you want to send are \"long low note, short low note, long low note\"...",
            "nextDialogs": [
              "740400804"
            ]
          },
          "740400804": {
            "id": "740400804",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "\"Long low note, long low note, long low note, long low note, long low note,\" and... Uh...",
            "nextDialogs": [
              "740400805"
            ]
          },
          "740400805": {
            "id": "740400805",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "\"Short low note, long low note, short low note, long low note, short low note, long low note, short low note, long low note, short low note, long low note\"... Gah, this one is super lengthy! But these three signals should all get you a response!"
          }
        }
      }
    },
    {
      "subId": "7404004",
      "subQuestName": "Talk to Ahes",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400301"
        ],
        "dialogs": {
          "740400301": {
            "id": "740400301",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Strange... Why won't she show herself?",
            "nextDialogs": [
              "740400302"
            ]
          },
          "740400302": {
            "id": "740400302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Gah... Even though Paimon can't see that ship, so far, she's still been following you two around on this wild goose chase...",
            "nextDialogs": [
              "740400303"
            ]
          },
          "740400303": {
            "id": "740400303",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But since it disappeared here, perhaps it's a hint to tell us to find something? For all you know, there might be lost treasure here!",
            "nextDialogs": [
              "740400304"
            ]
          },
          "740400304": {
            "id": "740400304",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Hehe, little jellyfish Paimon sure is greedy.",
            "nextDialogs": [
              "740400305"
            ]
          },
          "740400305": {
            "id": "740400305",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "But what we're looking for isn't treasure at all... Yes, if we have to give it a name, isn't it closer to \"proof\"?",
            "nextDialogs": [
              "740400307",
              "740400310"
            ]
          },
          "740400307": {
            "id": "740400307",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Proof that the Sponsian passed through this place. Such as a navigation log, any wreckage from the boat itself, or nautical tools... Anyway, we should be able to find something related to her!",
            "nextDialogs": [
              "740400308"
            ]
          },
          "740400308": {
            "id": "740400308",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh... so no treasure then...",
            "nextDialogs": [
              "740400313"
            ]
          },
          "740400313": {
            "id": "740400313",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "We can use the conch to send out sounds, and analyze the returning sound waves to determine the ship's approximate location."
          },
          "740400310": {
            "id": "740400310",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah! That's just what Paimon thinks!",
            "nextDialogs": [
              "740400311"
            ]
          },
          "740400311": {
            "id": "740400311",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Perhaps... But we're not here to find sunken treasure this time. What we want is proof that the \"Sponsian\" passed this way.",
            "nextDialogs": [
              "740400312"
            ]
          },
          "740400312": {
            "id": "740400312",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Navigation logs, wreckage from the boat itself, or nautical tools... Anyway, we should be able to find something related to her!"
          }
        }
      }
    },
    {
      "subId": "7404005",
      "subQuestName": "Investigate the area of interest",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400501"
        ],
        "dialogs": {
          "740400501": {
            "id": "740400501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh... It's a box and a... bucket? Maybe we should open them up and take a look? They just might be...",
            "nextDialogs": [
              "740400502"
            ]
          },
          "740400502": {
            "id": "740400502",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Rocks. They are rocks.",
            "nextDialogs": [
              "740400503"
            ]
          },
          "740400503": {
            "id": "740400503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah! Really valuable rocks!",
            "nextDialogs": [
              "740400504"
            ]
          },
          "740400504": {
            "id": "740400504",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Hahaha, silly Paimon! They're ballast! Ballast used to stabilize the weight of the battleship!",
            "nextDialogs": [
              "740400505"
            ]
          },
          "740400505": {
            "id": "740400505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh? Oh... then... Paimon guesses that there's no such thing as valuable ballast then...",
            "nextDialogs": [
              "740400506"
            ]
          },
          "740400506": {
            "id": "740400506",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "But since we found so much ballast dumped in a single location, perhaps the ship had to execute an emergency maneuver to increase buoyancy...",
            "nextDialogs": [
              "740400507"
            ]
          },
          "740400507": {
            "id": "740400507",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "In other words, she must have been forced to take extreme measures to evade danger, despite being the flagship of the ironclad armada..."
          }
        }
      }
    },
    {
      "subId": "7404009",
      "subQuestName": "Investigate the area of interest",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400601"
        ],
        "dialogs": {
          "740400601": {
            "id": "740400601",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... Busted wooden planks, oars, and... the wreck of a small boat. There's nothing worth looking at here...",
            "nextDialogs": [
              "740400602"
            ]
          },
          "740400602": {
            "id": "740400602",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "It's a lifeboat... So even the lifeboats were destroyed? ...Oh? Look over there. What's that between the boards?",
            "nextDialogs": [
              "740400603"
            ]
          },
          "740400603": {
            "id": "740400603",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmmm... It looks like a scrap of paper... Is it the log? Should we take it out and have a look?",
            "nextDialogs": [
              "740400604"
            ]
          },
          "740400604": {
            "id": "740400604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They came here to fight against monsters from the Abyss...",
            "nextDialogs": [
              "740400605"
            ]
          },
          "740400605": {
            "id": "740400605",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Yes... I have heard of legends regarding them before. But... does that mean that the Sponsian has already...",
            "nextDialogs": [
              "740400606"
            ]
          },
          "740400606": {
            "id": "740400606",
            "speakerId": 1000,
            "speakerName": "Ahes",
            "text": "Hmph! This isn't enough proof. Let's go to the next location."
          }
        }
      }
    },

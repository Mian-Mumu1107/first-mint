  "subQuests": [
    {
      "subId": "7321701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170101"
        ],
        "dialogs": {
          "732170101": {
            "id": "732170101",
            "speakerId": 1000,
            "speakerName": "Port Ormos Bulletin Board",
            "text": "This Bulletin Board is set up by the Port Master of Port Ormos to publicize important matters in and around Port Ormos. Questions or doubts regarding the notices on the Bulletin Board can be posted here as well."
          }
        }
      }
    },
    {
      "subId": "7321702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170201"
        ],
        "dialogs": {
          "732170201": {
            "id": "732170201",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Struggling with paper format? Still trying to find ideas for your paper? It's time to try something new!\"",
            "nextDialogs": [
              "732170202"
            ]
          },
          "732170202": {
            "id": "732170202",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"I majored in Hara{RUBY#[S]Semiotics}vatat and am proficient in both Span{RUBY#[S]Elementalism}tamad and Kshah{RUBY#[S]Technology}rewar. Providing Q&A services on paper writing.\"",
            "nextDialogs": [
              "732170203"
            ]
          },
          "732170203": {
            "id": "732170203",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Time to wriggle out of your pains. Contact Mr. Amandeep at the hotel. Service fee negotiable.\"",
            "nextDialogs": [
              "732170204"
            ]
          },
          "732170204": {
            "id": "732170204",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"Do you ghostwrite?\"",
            "nextDialogs": [
              "732170205"
            ]
          },
          "732170205": {
            "id": "732170205",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"No, the Inspector will not allow such behavior.\"",
            "nextDialogs": [
              "732170206"
            ]
          },
          "732170206": {
            "id": "732170206",
            "speakerId": 1003,
            "speakerName": "Message by the Inspector",
            "text": "\"Indeed. Focus on your study and do not try your luck.\""
          }
        }
      }
    },
    {
      "subId": "7321703",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170301"
        ],
        "dialogs": {
          "732170301": {
            "id": "732170301",
            "speakerId": 1004,
            "speakerName": "Fontaine Flyers Advertisement",
            "text": "Have you heard of levitation? Have you seen someone flying? Would you like to discover the secrets of the flying Sumpter Beast? Then don't miss out on the Fontaine Flyers' first performance in Sumeru!",
            "nextDialogs": [
              "732170302"
            ]
          },
          "732170302": {
            "id": "732170302",
            "speakerId": 1004,
            "speakerName": "Fontaine Flyers Advertisement",
            "text": "Welcome, show's on! Don't miss this unique performance of art! Only five Mora for a ticket.",
            "nextDialogs": [
              "732170303"
            ]
          },
          "732170303": {
            "id": "732170303",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"It was wonderful. I've never seen anything like it, even in Fontaine!\""
          }
        }
      }
    },
    {
      "subId": "7321704",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170401"
        ],
        "dialogs": {
          "732170401": {
            "id": "732170401",
            "speakerId": 1005,
            "speakerName": "The Eremites Announcement",
            "text": "Special reminder: The Eremites are the only authorized mercenary organization in Sumeru.",
            "nextDialogs": [
              "732170402"
            ]
          },
          "732170402": {
            "id": "732170402",
            "speakerId": 1005,
            "speakerName": "The Eremites Announcement",
            "text": "Please do not trust strangers easily in case of getting cheated by scammers.",
            "nextDialogs": [
              "732170403"
            ]
          },
          "732170403": {
            "id": "732170403",
            "speakerId": 1005,
            "speakerName": "The Eremites Announcement",
            "text": "If you wish to hire bodyguards, security staff, or have any other requests, please contact Captain Feroz of the Corps of Thirty at Port Ormos."
          }
        }
      }
    },
    {
      "subId": "7321705",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170501"
        ],
        "dialogs": {
          "732170501": {
            "id": "732170501",
            "speakerId": 1006,
            "speakerName": "Port Master Notice",
            "text": "Personal info and reasons for all docking ships need to be reported to the Port Master.",
            "nextDialogs": [
              "732170502"
            ]
          },
          "732170502": {
            "id": "732170502",
            "speakerId": 1006,
            "speakerName": "Port Master Notice",
            "text": "Merchant ships need to provide details on the cargo.",
            "nextDialogs": [
              "732170503"
            ]
          },
          "732170503": {
            "id": "732170503",
            "speakerId": 1006,
            "speakerName": "Port Master Notice",
            "text": "Merchant ships shall not unload cargo or trade without registration here. Any violation will face severe punishment."
          }
        }
      }
    },
    {
      "subId": "7321706",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170601"
        ],
        "dialogs": {
          "732170601": {
            "id": "732170601",
            "speakerId": 1006,
            "speakerName": "Port Master Notice",
            "text": "Investigations are being conducted to track smuggling. All goods passing through the port need to be registered and inspected.",
            "nextDialogs": [
              "732170602"
            ]
          },
          "732170602": {
            "id": "732170602",
            "speakerId": 1006,
            "speakerName": "Port Master Notice",
            "text": "All unregistered or contraband goods will be confiscated.",
            "nextDialogs": [
              "732170603"
            ]
          },
          "732170603": {
            "id": "732170603",
            "speakerId": 1006,
            "speakerName": "Port Master Notice",
            "text": "All consequences shall be borne by the cargo owner."
          }
        }
      }
    },
    {
      "subId": "7321707",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170701"
        ],
        "dialogs": {
          "732170701": {
            "id": "732170701",
            "speakerId": 1007,
            "speakerName": "Lighthouse Guardian Notice",
            "text": "Watch out for sea beasts!",
            "nextDialogs": [
              "732170702"
            ]
          },
          "732170702": {
            "id": "732170702",
            "speakerId": 1007,
            "speakerName": "Lighthouse Guardian Notice",
            "text": "We have witnessed an increased sea beasts activity recently. Ships leaving the port should pay attention to warnings issued by Pharos Lighthouse, or obtain maritime information in advance through Akasha.",
            "nextDialogs": [
              "732170703"
            ]
          },
          "732170703": {
            "id": "732170703",
            "speakerId": 1007,
            "speakerName": "Lighthouse Guardian Notice",
            "text": "For any questions, please contact the Lighthouse Guardian."
          }
        }
      }
    },
    {
      "subId": "7321708",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170801"
        ],
        "dialogs": {
          "732170801": {
            "id": "732170801",
            "speakerId": 1008,
            "speakerName": "Shapur Hotel Advertisement",
            "text": "As the largest hotel in Port Ormos, we provide the most thoughtful services for merchants and tourists.",
            "nextDialogs": [
              "732170802"
            ]
          },
          "732170802": {
            "id": "732170802",
            "speakerId": 1008,
            "speakerName": "Shapur Hotel Advertisement",
            "text": "We have a special discount for students and graduates of the Akademiya.",
            "nextDialogs": [
              "732170803"
            ]
          },
          "732170803": {
            "id": "732170803",
            "speakerId": 1008,
            "speakerName": "Shapur Hotel Advertisement",
            "text": "If you need to store goods, please contact Wikala Funduq."
          }
        }
      }
    },
    {
      "subId": "7321709",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170901"
        ],
        "dialogs": {
          "732170901": {
            "id": "732170901",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"The service at Shapur Hotel is good, but their sound insulation is awful.\"",
            "nextDialogs": [
              "732170902"
            ]
          },
          "732170902": {
            "id": "732170902",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"I stayed here because prices in Port Ormos were low. Now I'll have to move to Sumeru City.\"",
            "nextDialogs": [
              "732170903"
            ]
          },
          "732170903": {
            "id": "732170903",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"If I failed the exam again this year, I'm gonna have to return home and be a farmer. Don't know if I can take some 'Anahitian Blessing' with me then...\""
          }
        }
      }
    },
    {
      "subId": "7321710",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171001"
        ],
        "dialogs": {
          "732171001": {
            "id": "732171001",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"These Mahamata they sent are each more useless than the last. They can't answer a single question that I ask.\"",
            "nextDialogs": [
              "732171002"
            ]
          },
          "732171002": {
            "id": "732171002",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"And now that we have access to the Akasha, these amateur Mahamata are not even at my level.\"",
            "nextDialogs": [
              "732171003"
            ]
          },
          "732171003": {
            "id": "732171003",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"That Scribe we don't see very often who helped us sort out the shipping schedule last time is the only exception. Seems the Akademiya are not all dim-wits.\""
          }
        }
      }
    },
    {
      "subId": "7321711",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171101"
        ],
        "dialogs": {
          "732171101": {
            "id": "732171101",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"The burden on me gets heavier since Cyno became a General Mahamatra, but it's actually more relieving since I don't have to deal with the tedious factionalism anymore.\"",
            "nextDialogs": [
              "732171102"
            ]
          },
          "732171102": {
            "id": "732171102",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Or I couldn't be loitering around here while on a research trip.\"",
            "nextDialogs": [
              "732171103"
            ]
          },
          "732171103": {
            "id": "732171103",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Don't know where Cyno has been. Guess I wouldn't get caught by him if I write it here.\"",
            "nextDialogs": [
              "732171104"
            ]
          },
          "732171104": {
            "id": "732171104",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"I've seen it all. Report to me before tomorrow noon and receive punishment.\"",
            "nextDialogs": [
              "732171105"
            ]
          },
          "732171105": {
            "id": "732171105",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"Don't waste my time.\""
          }
        }
      }
    },
    {
      "subId": "7321712",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171201"
        ],
        "dialogs": {
          "732171201": {
            "id": "732171201",
            "speakerId": 1009,
            "speakerName": "Feiyun Commerce Guild Advertisement",
            "text": "Our commerce engages in the trade of gem products and precious ores produced in Liyue with sufficient stable supply channels and long-term cooperation with many fleets.",
            "nextDialogs": [
              "732171202"
            ]
          },
          "732171202": {
            "id": "732171202",
            "speakerId": 1009,
            "speakerName": "Feiyun Commerce Guild Advertisement",
            "text": "A handful of stylish silks are for sale. Limited offer!",
            "nextDialogs": [
              "732171203"
            ]
          },
          "732171203": {
            "id": "732171203",
            "speakerId": 1009,
            "speakerName": "Feiyun Commerce Guild Advertisement",
            "text": "Contact us if you have a good supply channel for Sumeru local blankets, herbs, gemstones, and brocade products. Let's trade and make friends!"
          }
        }
      }
    },
    {
      "subId": "7321713",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171301"
        ],
        "dialogs": {
          "732171301": {
            "id": "732171301",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Last month, I sailed to a country whose king had never seen a horse. Can you believe it?\"",
            "nextDialogs": [
              "732171302"
            ]
          },
          "732171302": {
            "id": "732171302",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"So I decided to sell some Sumpter Beasts there and tell them that those were horses, haha. If I closed a deal with them, perhaps I could be a king or something there!\"",
            "nextDialogs": [
              "732171303"
            ]
          },
          "732171303": {
            "id": "732171303",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"What is a king?\"",
            "nextDialogs": [
              "732171304"
            ]
          },
          "732171304": {
            "id": "732171304",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Like the Navbed or a Vizier, but with greater power than any of them. Pretty much the same as the legendary Twenty-Nine Deys. Gosh, it's so hard to describe.\"",
            "nextDialogs": [
              "732171305"
            ]
          },
          "732171305": {
            "id": "732171305",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"You're just making this up.\""
          }
        }
      }
    },
    {
      "subId": "7321714",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171401"
        ],
        "dialogs": {
          "732171401": {
            "id": "732171401",
            "speakerId": 1010,
            "speakerName": "Unsigned Poem",
            "text": "\"So dully is the sage's preach. Bring the wine made from flowers, for there are the seven seas to reach.\""
          }
        }
      }
    },
    {
      "subId": "7321715",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171501"
        ],
        "dialogs": {
          "732171501": {
            "id": "732171501",
            "speakerId": 1011,
            "speakerName": "Sheriff Announcement",
            "text": "To sailors, travelers, merchants, and port residents: The port regulations are announced here.",
            "nextDialogs": [
              "732171502"
            ]
          },
          "732171502": {
            "id": "732171502",
            "speakerId": 1011,
            "speakerName": "Sheriff Announcement",
            "text": "In case of dispute, contact Sheriff Shyam for assistance."
          }
        }
      }
    },
    {
      "subId": "7321716",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171601"
        ],
        "dialogs": {
          "732171601": {
            "id": "732171601",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Instead of visiting the Grand Bazaar in Sumeru City, you should visit the old markets in Port Ormos.\"",
            "nextDialogs": [
              "732171602"
            ]
          },
          "732171602": {
            "id": "732171602",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"The Grand Bazaar is messed up by the Mahamata. We are maintaining a lot more Sumeru traditions and characters here instead.\"",
            "nextDialogs": [
              "732171603"
            ]
          },
          "732171603": {
            "id": "732171603",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"But, of course, if you want to watch a dancing performance, you still have to go to Zubayr Theater, though.\"",
            "nextDialogs": [
              "732171604"
            ]
          },
          "732171604": {
            "id": "732171604",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"Peasants. The Sumeru City was built with a delicate plan by researchers. The zoning and planning of each and every area here are backed up by scientific research.\"",
            "nextDialogs": [
              "732171605"
            ]
          },
          "732171605": {
            "id": "732171605",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"I see someone here is full of nonsense. The unruly streets in Port Ormos somehow have become treasures in their eyes!\"",
            "nextDialogs": [
              "732171606"
            ]
          },
          "732171606": {
            "id": "732171606",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"What's that? Can't hear you!\""
          }
        }
      }
    },
    {
      "subId": "7321717",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171701"
        ],
        "dialogs": {
          "732171701": {
            "id": "732171701",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"This is embarrassing to say. We were workers that maintain merchant ships here, living off the maintenance skills passed down from generation to generation.\"",
            "nextDialogs": [
              "732171702"
            ]
          },
          "732171702": {
            "id": "732171702",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"But some time ago, new technologies have been added to the Akasha, and our years of experience have become worthless. Young people can still learn through the Akasha, but old stuff like us have no choice but to change jobs.\"",
            "nextDialogs": [
              "732171703"
            ]
          },
          "732171703": {
            "id": "732171703",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"The Scribe said we can go to sea and try our luck, but we have no money for something like that right now. If you have any gigs, please come to us.\"",
            "nextDialogs": [
              "732171704"
            ]
          },
          "732171704": {
            "id": "732171704",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"Don't listen to the Scribe. I happen to know a big client who needs craftsmen. I'll introduce you to her. Take the money too. Forget about going to sea.\"",
            "nextDialogs": [
              "732171705"
            ]
          },
          "732171705": {
            "id": "732171705",
            "speakerId": 1012,
            "speakerName": "Reply",
            "text": "\"I wish you could do less meaningless things. Some people will succeed and some will fall, that's how the world works. Why interfere with it just to act like a goody-two-shoes?\"",
            "nextDialogs": [
              "732171706"
            ]
          },
          "732171706": {
            "id": "732171706",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"Here the Scribe goes again with the mysticism. Why did I do this, you say? Because it makes me happy!\"",
            "nextDialogs": [
              "732171707"
            ]
          },
          "732171707": {
            "id": "732171707",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"And don't you forget that mutual assistance, fairness, and righteous anger are also what drive the world, not the nonsense like 'the fittest survives'!\"",
            "nextDialogs": [
              "732171708"
            ]
          },
          "732171708": {
            "id": "732171708",
            "speakerId": 1012,
            "speakerName": "Reply",
            "text": "\"Make no mistake. I have never denied what you meant, but you don't understand what I am saying to you at all. End of conversation.\"",
            "nextDialogs": [
              "732171709"
            ]
          },
          "732171709": {
            "id": "732171709",
            "speakerId": 1012,
            "speakerName": "Reply",
            "text": "\"It's a headache to argue with the impulsive. Anyway, where's your own budget? Don't tell me you're spending all your Akademiya subsidies on such nonsense.\"",
            "nextDialogs": [
              "732171710"
            ]
          },
          "732171710": {
            "id": "732171710",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"'The poor suffer from the rich's wealth. Thus the rich should give away their wealth for a good purpose.' says the sage Zolfikar.\"",
            "nextDialogs": [
              "732171711"
            ]
          },
          "732171711": {
            "id": "732171711",
            "speakerId": 1012,
            "speakerName": "Reply",
            "text": "\"He never said that.\"",
            "nextDialogs": [
              "732171712"
            ]
          },
          "732171712": {
            "id": "732171712",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"He did.\"",
            "nextDialogs": [
              "732171713"
            ]
          },
          "732171713": {
            "id": "732171713",
            "speakerId": 1012,
            "speakerName": "Reply",
            "text": "\"No, he never said that. And you'll pay for your drinks this month.\"",
            "nextDialogs": [
              "732171714"
            ]
          },
          "732171714": {
            "id": "732171714",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"I won't argue with you about this. But give me a month. I'll prove that he said it.\""
          }
        }
      }
    },
    {
      "subId": "7321718",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171801"
        ],
        "dialogs": {
          "732171801": {
            "id": "732171801",
            "speakerId": 1013,
            "speakerName": "Trading Company Advertisement",
            "text": "\"Our company has opened the route to Dornman Port. We sincerely invite you to join our fruit business.\"",
            "nextDialogs": [
              "732171802"
            ]
          },
          "732171802": {
            "id": "732171802",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Wait a minute. Is it even possible to import fruit from Mondstadt, given the long voyage? I might be interested if you were talking about liquor.\"",
            "nextDialogs": [
              "732171803"
            ]
          },
          "732171803": {
            "id": "732171803",
            "speakerId": 1012,
            "speakerName": "Reply",
            "text": "\"Everyone knows importing wine from Mondstadt is a business, but importing fruit? Only I do such business here. That's why this is such a great business opportunity!\"",
            "nextDialogs": [
              "732171804"
            ]
          },
          "732171804": {
            "id": "732171804",
            "speakerId": 1012,
            "speakerName": "Reply",
            "text": "\"And you don't actually need to import from Mondstadt...\""
          }
        }
      }
    },
    {
      "subId": "7321719",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171901"
        ],
        "dialogs": {
          "732171901": {
            "id": "732171901",
            "speakerId": 1014,
            "speakerName": "International Trade Association Advertisement",
            "text": "\"The route to Ritou has been reopened. We sincerely invite you to join our business.\"",
            "nextDialogs": [
              "732171902"
            ]
          },
          "732171902": {
            "id": "732171902",
            "speakerId": 1014,
            "speakerName": "International Trade Association Advertisement",
            "text": "\"Our Association's trade of wild mushrooms between Sumeru and Inazuma has been approved by the Port Master. We are now open to mushroom merchants for cooperation.\"",
            "nextDialogs": [
              "732171903"
            ]
          },
          "732171903": {
            "id": "732171903",
            "speakerId": 1014,
            "speakerName": "International Trade Association Advertisement",
            "text": "\"You can also contact us if you encounter any problems or difficulties during your travel to Inazuma.\""
          }
        }
      }
    },
    {
      "subId": "7321720",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732172001"
        ],
        "dialogs": {
          "732172001": {
            "id": "732172001",
            "speakerId": 1007,
            "speakerName": "Lighthouse Guardian Notice",
            "text": "Watch out for sea beasts!",
            "nextDialogs": [
              "732172002"
            ]
          },
          "732172002": {
            "id": "732172002",
            "speakerId": 1007,
            "speakerName": "Lighthouse Guardian Notice",
            "text": "We have recently witnessed an increase in sea beast activity. Ships leaving the port should pay attention to warnings issued by Pharos Lighthouse, or obtain maritime information in advance through the Mahamata.",
            "nextDialogs": [
              "732172003"
            ]
          },
          "732172003": {
            "id": "732172003",
            "speakerId": 1007,
            "speakerName": "Lighthouse Guardian Notice",
            "text": "For any questions, please contact the Lighthouse Guardian."
          }
        }
      }
    }
  ]
}
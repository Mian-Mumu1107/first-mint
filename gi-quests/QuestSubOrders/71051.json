  "subQuests": [
    {
      "subId": "7105101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710500501"
        ],
        "dialogs": {
          "710500501": {
            "id": "710500501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the strange object...",
            "nextDialogs": [
              "710500502"
            ]
          },
          "710500502": {
            "id": "710500502",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "Did you fish this up from the water? Hmm. Actually, at first glance, this thing does look like a fishing bait.",
            "nextDialogs": [
              "710500503"
            ]
          },
          "710500503": {
            "id": "710500503",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "Is it normal for people to come across this kind of stuff while fishing? Anisa never misses a single day fishing on Watatsumi Island, but she's never discovered anything special.",
            "nextDialogs": [
              "710500504"
            ]
          },
          "710500504": {
            "id": "710500504",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "Perhaps it's the fisher that makes the difference, then?",
            "nextDialogs": [
              "710500505"
            ]
          },
          "710500505": {
            "id": "710500505",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "Let me check. Mm, I can sense an incredibly high concentration of Hydro energy within it.",
            "nextDialogs": [
              "710500506"
            ]
          },
          "710500506": {
            "id": "710500506",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "The groundwater in The Chasm does contain unusually rich elemental power. Does that have anything to do with things like this growing within it?",
            "nextDialogs": [
              "710500507"
            ]
          },
          "710500507": {
            "id": "710500507",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "But ever since you fished it up, its elemental energy has been ebbing away. Maybe we need to place it by the water to see what its power is capable of.",
            "nextDialogs": [
              "710500508"
            ]
          },
          "710500508": {
            "id": "710500508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Place it by the water?",
            "nextDialogs": [
              "710500509"
            ]
          },
          "710500509": {
            "id": "710500509",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "Yes, and also activate it with Hydro energy. I suspect that it'll reveal its secrets to us then.",
            "nextDialogs": [
              "710500510"
            ]
          },
          "710500510": {
            "id": "710500510",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "How about you go activate it? — I mean, since you're the one who fished it up and all. Let me know if you get any results.",
            "nextDialogs": [
              "710500511"
            ]
          },
          "710500511": {
            "id": "710500511",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "I'll pay you if your findings are of academic value."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "49201",
      "subQuestName": "Return to the cathedral and see how Jean is doing",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4901001"
        ],
        "dialogs": {
          "4901001": {
            "id": "4901001",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "Oh, it is you.",
            "nextDialogs": [
              "4901004"
            ]
          },
          "4901004": {
            "id": "4901004",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "Yes, I am just... getting some air.",
            "nextDialogs": [
              "4901005"
            ]
          },
          "4901005": {
            "id": "4901005",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh-oh, it seems like something's bothering Jean.",
            "nextDialogs": [
              "4901006"
            ]
          },
          "4901006": {
            "id": "4901006",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "#{NICKNAME}, I want to thank you again—",
            "nextDialogs": [
              "4901007"
            ]
          },
          "4901007": {
            "id": "4901007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Actually, I knew nothing about this whole thing either.",
            "nextDialogs": [
              "4901008"
            ]
          },
          "4901008": {
            "id": "4901008",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "Either way, it is good to be here together with everyone. It has lifted my spirits.",
            "nextDialogs": [
              "4901011"
            ]
          },
          "4901011": {
            "id": "4901011",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "And it has taught me something.",
            "nextDialogs": [
              "4901012"
            ]
          },
          "4901012": {
            "id": "4901012",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What's that?",
            "nextDialogs": [
              "4901013"
            ]
          },
          "4901013": {
            "id": "4901013",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "I am definitely more of a Dandelion Knight than a Lionfang Knight.",
            "nextDialogs": [
              "4901014"
            ]
          },
          "4901014": {
            "id": "4901014",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "The Lionfang Knight represents Vennessa's past — a past in which she fought hard for Mondstadt.",
            "nextDialogs": [
              "4901015"
            ]
          },
          "4901015": {
            "id": "4901015",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "But it was the Dandelion Knight that represented her hopes for the future — a future belonging to the newly formed Knights of Favonius...",
            "nextDialogs": [
              "4901016"
            ]
          },
          "4901016": {
            "id": "4901016",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Jean, Vennessa would be so proud of who you are right now.",
            "nextDialogs": [
              "4901017"
            ]
          },
          "4901017": {
            "id": "4901017",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "I do believe that Vennessa watches over us, whether from high up above, or from the wind all around us.",
            "nextDialogs": [
              "4901018"
            ]
          },
          "4901018": {
            "id": "4901018",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let the Wind lead.",
            "nextDialogs": [
              "4901019"
            ]
          },
          "4901019": {
            "id": "4901019",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "#Let the Wind lead. The winds of freedom will guide us along the path that lies ahead. I hope you will continue to join us on that path, {NICKNAME}."
          }
        }
      }
    }
  ]
}
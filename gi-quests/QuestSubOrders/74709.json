        ],
        "dialogs": {
          "747090101": {
            "id": "747090101",
            "speakerId": 1079,
            "speakerName": "Sigewinne",
            "text": "#Thank you for all your hard work, {NICKNAME} and Paimon.",
            "nextDialogs": [
              "747090102"
            ]
          },
          "747090102": {
            "id": "747090102",
            "speakerId": 1079,
            "speakerName": "Sigewinne",
            "text": "I have a pretty good understanding of our patients' condition now, so I've mixed them up some special Melusine medicine...",
            "nextDialogs": [
              "747090103"
            ]
          },
          "747090103": {
            "id": "747090103",
            "speakerId": 1079,
            "speakerName": "Sigewinne",
            "text": "Adding these herbs to the water tank should help calm them down.",
            "nextDialogs": [
              "747090104"
            ]
          },
          "747090104": {
            "id": "747090104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So you're basically turning the whole tank into a giant health spa?",
            "nextDialogs": [
              "747090105"
            ]
          },
          "747090105": {
            "id": "747090105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That really is a plan that only you could pull off, Sigewinne!",
            "nextDialogs": [
              "747090108"
            ]
          },
          "747090108": {
            "id": "747090108",
            "speakerId": 1079,
            "speakerName": "Sigewinne",
            "text": "You're spot on. I'll need to invite a whole variety of different fish here for physical examinations before I can determine exactly what's wrong.",
            "nextDialogs": [
              "747090109"
            ]
          },
          "747090109": {
            "id": "747090109",
            "speakerId": 1079,
            "speakerName": "Sigewinne",
            "text": "I'll put together a list of patients to check based on the characteristics I need.",
            "nextDialogs": [
              "747090110"
            ]
          },
          "747090110": {
            "id": "747090110",
            "speakerId": 1079,
            "speakerName": "Sigewinne",
            "text": "I'd appreciate it if you could keep a close eye out for any fish that meet the criteria."
          }
        }
      }
    }
  ]

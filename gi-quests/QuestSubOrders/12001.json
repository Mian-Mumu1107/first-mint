  "subQuests": [
    {
      "subId": "1200101",
      "subQuestName": "Go to Gentry Maocai's residence and make inquiries",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120010101"
        ],
        "dialogs": {
          "120010101": {
            "id": "120010101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "This must be Gentry Maocai's house. He must be loaded, this place is swanky!",
            "nextDialogs": [
              "120010102"
            ]
          },
          "120010102": {
            "id": "120010102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "How're we gonna find out if Gentry Maocai is in cahoots with the Fatui? Hmm, maybe start by talking to the guards."
          }
        }
      }
    },
    {
      "subId": "1200103",
      "subQuestName": "Talk to the guards and make inquiries",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120010301"
        ],
        "dialogs": {
          "120010301": {
            "id": "120010301",
            "speakerId": 1001,
            "speakerName": "Sturdy Wu",
            "text": "Who goes there?",
            "nextDialogs": [
              "120010303",
              "120010305"
            ]
          },
          "120010303": {
            "id": "120010303",
            "speakerId": 1001,
            "speakerName": "Sturdy Wu",
            "text": "Really? He didn't mention anything about a meeting...",
            "nextDialogs": [
              "120010306"
            ]
          },
          "120010306": {
            "id": "120010306",
            "speakerId": 1001,
            "speakerName": "Sturdy Wu",
            "text": "The Master is dealing with some urgent business today. All prior appointments have been canceled.",
            "nextDialogs": [
              "120010307"
            ]
          },
          "120010307": {
            "id": "120010307",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Urgent business? ...What is it?",
            "nextDialogs": [
              "120010308"
            ]
          },
          "120010308": {
            "id": "120010308",
            "speakerId": 1001,
            "speakerName": "Sturdy Wu",
            "text": "The Master has been working on a major business deal recently. He left early this morning to meet with a VIP client.",
            "nextDialogs": [
              "120010309"
            ]
          },
          "120010309": {
            "id": "120010309",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So where is he now?",
            "nextDialogs": [
              "120010310"
            ]
          },
          "120010310": {
            "id": "120010310",
            "speakerId": 1001,
            "speakerName": "Sturdy Wu",
            "text": "I'm sorry, the Master has stressed that we must not disclose that information to just anyone...",
            "nextDialogs": [
              "120010311"
            ]
          },
          "120010311": {
            "id": "120010311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Just anyone\"? Are you saying we are not his VIP clients?",
            "nextDialogs": [
              "120010312"
            ]
          },
          "120010312": {
            "id": "120010312",
            "speakerId": 1001,
            "speakerName": "Sturdy Wu",
            "text": "N—No! I mean yes, yes you are! Ah... I—I meant no offense, please believe me..."
          },
          "120010305": {
            "id": "120010305",
            "speakerId": 1001,
            "speakerName": "Sturdy Wu",
            "text": "How strange, you're not on the guestlist..."
          }
        }
      }
    },
    {
      "subId": "1200106",
      "subQuestName": "Go to Xinyue Kiosk and eavesdrop on Gentry Maocai",
      "sceneId": null,
      "locations": [],

    {
      "subId": "7410408",
      "subQuestName": "Work with Paimon to open the cell",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741040801"
        ],
        "dialogs": {
          "741040801": {
            "id": "741040801",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's see... There are two terminals and two energy storage devices here. If Paimon can activate the energy storage device beside the door, then the cage should be able to open!",
            "nextDialogs": [
              "741040802"
            ]
          },
          "741040802": {
            "id": "741040802",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Where should Paimon go? To the terminal by the door, or the one by the cage?",
            "nextDialogs": [
              "741040804",
              "741040806"
            ]
          },
          "741040804": {
            "id": "741040804",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm, this doesn't seem quite right..."
          },
          "741040806": {
            "id": "741040806",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let Paimon see...",
            "nextDialogs": [
              "741040807"
            ]
          },
          "741040807": {
            "id": "741040807",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon can see the door Kuisel exited from here. What should Paimon do now?"
          }
        }
      }
    },

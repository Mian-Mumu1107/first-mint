    {
      "subId": "7410404",
      "subQuestName": "Talk to the trapped person",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741040401"
        ],
        "dialogs": {
          "741040401": {
            "id": "741040401",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "A—Are you two here for the research assistant position? S—Sorry, but I'm a little busy at the moment...",
            "nextDialogs": [
              "741040405",
              "741040404"
            ]
          },
          "741040405": {
            "id": "741040405",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Never mind that for now. Why are you locked up in a cage?",
            "nextDialogs": [
              "741040406"
            ]
          },
          "741040406": {
            "id": "741040406",
            "speakerId": 1002,
            "speakerName": "Kuisel",
            "text": "I had some disagreements with a research partner... Coutrot... he left me here to calm down a little. Th—That's right... I haven't introduced myself yet. You can call me Kuisel.",
            "nextDialogs": [
              "741040407"
            ]
          },
          "741040407": {
            "id": "741040407",
            "speakerId": 1002,
            "speakerName": "Kuisel",
            "text": "Ugh, you know... Kuisel's Clockwork Workshop — that Kuisel.",
            "nextDialogs": [
              "741040408"
            ]
          },
          "741040408": {
            "id": "741040408",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Paimon is Paimon, and {M#he's}{F#she's} {NICKNAME}... Paimon did hear the sound of arguing just now. So that guy who sounded really mad is actually your research partner, huh?"
          },
          "741040404": {
            "id": "741040404",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "H—Here for a tour? O—Of course, you're most welcome to."
          }
        }
      }
    },
    {
      "subId": "7410405",
      "subQuestName": "Operate the Energy Transfer Terminal to open the cell",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741040501"
        ],
        "dialogs": {
          "741040501": {
            "id": "741040501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The door's already open. Aren't you going to come out?",
            "nextDialogs": [
              "741040502"
            ]
          },
          "741040502": {
            "id": "741040502",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "A—Actually, there is one more thing I was too scared to mention... If I were to leave this cage now, I'm a—afraid this place could blow up.",
            "nextDialogs": [
              "741040503"
            ]
          },
          "741040503": {
            "id": "741040503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Blow up?",
            "nextDialogs": [
              "741040504"
            ]
          },
          "741040504": {
            "id": "741040504",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "Th—That's right... Like I said earlier, my research partner's got... a violent temper, which is why he installed a trigger mechanism under the cage.",
            "nextDialogs": [
              "741040505"
            ]
          },
          "741040505": {
            "id": "741040505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh!? Then what should we do now?",
            "nextDialogs": [
              "741040507",
              "741040509"
            ]
          },
          "741040507": {
            "id": "741040507",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "O—Ordinary heavy objects won't work, I'm afraid... The way it works is rather complicated. Ugh...",
            "nextDialogs": [
              "741040510"
            ]
          },
          "741040510": {
            "id": "741040510",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "#If you could take my spot temporarily, kind {M#Mr.}{F#Miss} {NICKNAME}... and wait in the cage a bit. Then I... I can go disable this special trigger mechanism.",
            "nextDialogs": [
              "741040511"
            ]
          },
          "741040511": {
            "id": "741040511",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "A—After all, I've worked with him for years, and I know exactly what he was thinking when he put it in place."
          },
          "741040509": {
            "id": "741040509",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "Th—There's no need to go through all that trouble..."
          }
        }
      }
    },

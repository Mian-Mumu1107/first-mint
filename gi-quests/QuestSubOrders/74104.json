    {
      "subId": "7410428",
      "subQuestName": "Talk to Bricole",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741042802"
        ],
        "dialogs": {
          "741042802": {
            "id": "741042802",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "You guys again... You're more skilled than I thought. You are truly the best research material I've ever seen! Far beyond what I can control, though... I admit I've lost.",
            "nextDialogs": [
              "741042803"
            ]
          },
          "741042803": {
            "id": "741042803",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Just what is up with this guy!?",
            "nextDialogs": [
              "741042804"
            ]
          },
          "741042804": {
            "id": "741042804",
            "speakerId": 1007,
            "speakerName": "Bricole",
            "text": "Yep, that's a pretty common reaction to him. You see, his... more peculiar research was exactly what got him kicked out from the Fontaine Research Institute in the first place.",
            "nextDialogs": [
              "741042805"
            ]
          },
          "741042805": {
            "id": "741042805",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "My research was not peculiar...",
            "nextDialogs": [
              "741042806"
            ]
          },
          "741042806": {
            "id": "741042806",
            "speakerId": 1007,
            "speakerName": "Bricole",
            "text": "Yeah yeah, and that's what you told the Ethics Committee back in the day as well. Don't think a single person bought what you said.",
            "nextDialogs": [
              "741042807"
            ]
          },
          "741042807": {
            "id": "741042807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So... what was his research?",
            "nextDialogs": [
              "741042808"
            ]
          },
          "741042808": {
            "id": "741042808",
            "speakerId": 1007,
            "speakerName": "Bricole",
            "text": "Ahem... If you wish to learn more about his research, you may go to the new Fontaine Research Institute to apply for access.",
            "nextDialogs": [
              "741042809"
            ]
          },
          "741042809": {
            "id": "741042809",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That gives Paimon a headache just thinking about it...",
            "nextDialogs": [
              "741042810"
            ]
          },
          "741042810": {
            "id": "741042810",
            "speakerId": 1007,
            "speakerName": "Bricole",
            "text": "It's giving me a headache too. Even though he's been fired, the asset theft case I've been investigating still has to do with him...",
            "nextDialogs": [
              "741042811"
            ]
          },
          "741042811": {
            "id": "741042811",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "Haha, do you want to ship me off to the Fortress of Meropide?",
            "nextDialogs": [
              "741042812"
            ]
          },
          "741042812": {
            "id": "741042812",
            "speakerId": 1007,
            "speakerName": "Bricole",
            "text": "Well, that's not up to me to decide. The law will hand you your proper judgment. It's a shame that, unlike last time, we can't simply resolve matters by kicking you out.",
            "nextDialogs": [
              "741042813"
            ]
          },
          "741042813": {
            "id": "741042813",
            "speakerId": 1007,
            "speakerName": "Bricole",
            "text": "Either way, thank you both for your help. I probably wouldn't have been able to bring him down myself... You can leave the rest to me. I promise that this time, he will receive his proper punishment.",
            "nextDialogs": [
              "741042814"
            ]
          },
          "741042814": {
            "id": "741042814",
            "speakerId": 1007,
            "speakerName": "Bricole",
            "text": "*sigh* I'm afraid I'll still have to return to this place to continue my work. There are so many assets... Just how many reports would I have to compile..."
          }
        }
      }
    },
    {
      "subId": "7410440",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741044001"
        ],
        "dialogs": {
          "741044001": {
            "id": "741044001",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "Please believe me. All you need to do is stay in my place for a moment, and I'll be back from disabling the mechanism before you know it.",
            "nextDialogs": [
              "741044002"
            ]
          },
          "741044002": {
            "id": "741044002",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well... alright then. But be quick!",
            "nextDialogs": [
              "741044003"
            ]
          },
          "741044003": {
            "id": "741044003",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Very carefully, you swap places with Kuisel...",
            "nextDialogs": [
              "741044004"
            ]
          },
          "741044004": {
            "id": "741044004",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You wait for some time, but he doesn't come back as he promised. You also hear some strange voices...",
            "nextDialogs": [
              "741044005"
            ]
          },
          "741044005": {
            "id": "741044005",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You decide to try and find a way out of the cage...",
            "nextDialogs": [
              "741044006"
            ]
          },
          "741044006": {
            "id": "741044006",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But luckily, Paimon didn't end up getting locked in the cage with you... Uh... Paimon should be able to open the door the way we did before, right? Let's give it a try!"
          }
        }
      }
    },

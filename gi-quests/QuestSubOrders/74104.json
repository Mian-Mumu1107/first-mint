      "dialogue": {
        "startDialogs": [
          "741043901"
        ],
        "dialogs": {
          "741043901": {
            "id": "741043901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "On that note, is it really okay for us to be messing with stuff like the terminals here?",
            "nextDialogs": [
              "741043902"
            ]
          },
          "741043902": {
            "id": "741043902",
            "speakerId": 1002,
            "speakerName": "Kuisel",
            "text": "I—It's okay. Everything here is... well-designed."
          }
        }
      }
    },
    {

    {
      "subId": "7410425",
      "subQuestName": "Talk to Kuisel",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741042501"
        ],
        "dialogs": {
          "741042501": {
            "id": "741042501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Kuisel! There you are!",
            "nextDialogs": [
              "741042502"
            ]
          },
          "741042502": {
            "id": "741042502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And the one next to him... must be that villainous research partner Coutrot that Kuisel was talking about!",
            "nextDialogs": [
              "741042503"
            ]
          },
          "741042503": {
            "id": "741042503",
            "speakerId": 1007,
            "speakerName": "Bricole",
            "text": "...? He's Coutrot, not me. I'm Bricole.",
            "nextDialogs": [
              "741042504"
            ]
          },
          "741042504": {
            "id": "741042504",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh? Isn't he Kuisel?",
            "nextDialogs": [
              "741042505"
            ]
          },
          "741042505": {
            "id": "741042505",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "Kuisel... is just a convenient character. You've already passed many trials, so there's no reason to hide anything from you anymore. My name is Coutrot, and I'm the real owner of this workshop.",
            "nextDialogs": [
              "741042506"
            ]
          },
          "741042506": {
            "id": "741042506",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "Haha, you two are truly... great research material. If you are willing to help me with my research...",
            "nextDialogs": [
              "741042507"
            ]
          },
          "741042507": {
            "id": "741042507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What research? Tell us a bit more about it.",
            "nextDialogs": [
              "741042508"
            ]
          },
          "741042508": {
            "id": "741042508",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, c'mon! Are you really going to help someone this fishy?",
            "nextDialogs": [
              "741042510"
            ]
          },
          "741042510": {
            "id": "741042510",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Nothing about this place looks like a proper workshop! You also lied to us and made the clockwork meka attack us... Paimon has no reason to believe you're a good guy!",
            "nextDialogs": [
              "741042511"
            ]
          },
          "741042511": {
            "id": "741042511",
            "speakerId": 1007,
            "speakerName": "Bricole",
            "text": "That's exactly right! Don't fall for his trap! He... He's an extremely vicious crook!",
            "nextDialogs": [
              "741042512"
            ]
          },
          "741042512": {
            "id": "741042512",
            "speakerId": 1007,
            "speakerName": "Bricole",
            "text": "I followed the clues here while investigating. I didn't expect you to continue your dangerous research even after you were kicked out, and you even stole the Research Institute's assets for this purpose...",
            "nextDialogs": [
              "741042513"
            ]
          },
          "741042513": {
            "id": "741042513",
            "speakerId": 1007,
            "speakerName": "Bricole",
            "text": "You've committed a crime!",
            "nextDialogs": [
              "741042514"
            ]
          },
          "741042514": {
            "id": "741042514",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "You really can't keep your mouth shut, eh, Bricole... You're just a good-for-nothing idiot. I'll take care of you once I've properly appraised our two VIPs over here.",
            "nextDialogs": [
              "741042515"
            ]
          },
          "741042515": {
            "id": "741042515",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Your two VIPs... You don't mean us, right?",
            "nextDialogs": [
              "741042516"
            ]
          },
          "741042516": {
            "id": "741042516",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "Of course, you only need to pass one last trial to prove your true worth...",
            "nextDialogs": [
              "741042517"
            ]
          },
          "741042517": {
            "id": "741042517",
            "speakerId": 1003,
            "speakerName": "Coutrot",
            "text": "Time to show me what you've got!"
          }
        }
      }
    },

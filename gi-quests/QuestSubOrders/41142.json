    {
      "subId": "4114201",
      "subQuestName": "Speak to Chef Mao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411420101"
        ],
        "dialogs": {
          "411420101": {
            "id": "411420101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll deliver it right now.",
            "nextDialogs": [
              "411420102"
            ]
          },
          "411420102": {
            "id": "411420102",
            "speakerId": 1000,
            "speakerName": "Chef Mao",
            "text": "Thanks a lot, you're a big help.",
            "nextDialogs": [
              "411420103"
            ]
          },
          "411420103": {
            "id": "411420103",
            "speakerId": 1000,
            "speakerName": "Chef Mao",
            "text": "Make sure you keep a good grip on this Jewelry Soup, and be careful while you're delivering it. <color=#00E1FFFF>Make sure not to knock it over, and make sure you don't glide</color>, or it'll all spill out.",
            "nextDialogs": [
              "411420104"
            ]
          },
          "411420104": {
            "id": "411420104",
            "speakerId": 1000,
            "speakerName": "Chef Mao",
            "text": "Oh yes — and <color=#00E1FFFF>don't touch anything weird</color>, or the flavors will get all mixed up...",
            "nextDialogs": [
              "411420105"
            ]
          },
          "411420105": {
            "id": "411420105",
            "speakerId": 1000,
            "speakerName": "Chef Mao",
            "text": "Now, hurry and deliver that Jewelry Soup. It won't be any good once it gets cold."
          }
        }
      }
    },
    {

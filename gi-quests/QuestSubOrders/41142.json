    {
      "subId": "4114203",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411420301"
        ],
        "dialogs": {
          "411420301": {
            "id": "411420301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I heard that someone placed a custom order...",
            "nextDialogs": [
              "411420302"
            ]
          },
          "411420302": {
            "id": "411420302",
            "speakerId": 1000,
            "speakerName": "Chef Mao",
            "text": "Yes, that's correct. A while ago, a customer named Tingfang ordered a bowl of Jewelry Soup from me. He paid in advance, saying that he wanted it delivered to the Dunyu Ruins.",
            "nextDialogs": [
              "411420303"
            ]
          },
          "411420303": {
            "id": "411420303",
            "speakerId": 1000,
            "speakerName": "Chef Mao",
            "text": "I still need to man the restaurant, so I don't have time to make the delivery. It would be great if you're willing to go in my place."
          }
        }
      }
    },
    {
      "subId": "4114205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

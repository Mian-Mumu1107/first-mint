    {
      "subId": "7280905",
      "subQuestName": "Observe Harrison",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728090108"
        ],
        "dialogs": {
          "728090108": {
            "id": "728090108",
            "speakerId": 1000,
            "speakerName": "Harrison",
            "text": "Well, so this stuff's finally arrived...",
            "nextDialogs": [
              "728090109"
            ]
          },
          "728090109": {
            "id": "728090109",
            "speakerId": 1000,
            "speakerName": "Harrison",
            "text": "Took them long enough...",
            "nextDialogs": [
              "728090110"
            ]
          },
          "728090110": {
            "id": "728090110",
            "speakerId": 1000,
            "speakerName": "Harrison",
            "text": "Agh, and this box is broken on one side, too!",
            "nextDialogs": [
              "728090111"
            ]
          },
          "728090111": {
            "id": "728090111",
            "speakerId": 1000,
            "speakerName": "Harrison",
            "text": "Come on! I told him to be careful. Let's just hope nothing inside is broken...",
            "nextDialogs": [
              "728090112"
            ]
          },
          "728090112": {
            "id": "728090112",
            "speakerId": 1000,
            "speakerName": "Harrison",
            "text": "Phew, looks like none of the bottles broke...",
            "nextDialogs": [
              "728090113"
            ]
          },
          "728090113": {
            "id": "728090113",
            "speakerId": 1000,
            "speakerName": "Harrison",
            "text": "Eh? Why's this bottle's cap loose? You have to unscrew it first before installing it, come on...",
            "nextDialogs": [
              "728090114"
            ]
          },
          "728090114": {
            "id": "728090114",
            "speakerId": 1000,
            "speakerName": "Harrison",
            "text": "*cough* And these alcohol-making ingredients have too strong a flavor, let's move them out first...",
            "nextDialogs": [
              "728090115"
            ]
          },
          "728090115": {
            "id": "728090115",
            "speakerId": 1000,
            "speakerName": "Harrison",
            "text": "Eh!? What are all these slimes doing here?"
          }
        }
      }
    },
    {
      "subId": "7280906",
      "subQuestName": "Defeat all the slimes",
      "sceneId": null,
      "locations": [],

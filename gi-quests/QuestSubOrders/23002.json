        "dialogs": {
          "230020501": {
            "id": "230020501",
            "speakerId": 4024,
            "speakerName": "Hanbei",
            "text": "This merchant's mushroom supply doesn't look very reliable either...",
            "nextDialogs": [
              "230020502"
            ]
          },
          "230020502": {
            "id": "230020502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why does he look so troubled? Has he gotten himself into some kind of trouble again?",
            "nextDialogs": [
              "230020503"
            ]
          },
          "230020503": {
            "id": "230020503",
            "speakerId": 4024,
            "speakerName": "Hanbei",
            "text": "Traveler, you're here. The quality of the mushrooms you gathered was really good.",
            "nextDialogs": [
              "230020504"
            ]
          },
          "230020504": {
            "id": "230020504",
            "speakerId": 4024,
            "speakerName": "Hanbei",
            "text": "Can I ask you to gather more for me? I plan to compare them with the mushrooms from other suppliers.",
            "nextDialogs": [
              "230020506",
              "230020508"
            ]
          },
          "230020506": {
            "id": "230020506",
            "speakerId": 4024,
            "speakerName": "Hanbei",
            "text": "Thank you."
          },
          "230020508": {
            "id": "230020508",
            "speakerId": 4024,
            "speakerName": "Hanbei",
            "text": "Um, five or six, but their supply doesn't seem very reliable, which makes me feel rather uneasy.",
            "nextDialogs": [
              "230020509"
            ]
          },
          "230020509": {
            "id": "230020509",
            "speakerId": 4024,
            "speakerName": "Hanbei",
            "text": "I'll look for other suppliers, and I'll leave the mushroom gathering to you."
          }
        }

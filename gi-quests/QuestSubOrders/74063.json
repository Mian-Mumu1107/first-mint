  "subQuests": [
    {
      "subId": "7406307",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740630701"
        ],
        "dialogs": {
          "740630701": {
            "id": "740630701",
            "speakerId": 5236,
            "speakerName": "Grainville",
            "text": "All relevant labor regulations and procedures must be followed in the production zone — that means safety first. If you've got no questions, then don't disturb my work."
          }
        }
      }
    },
    {
      "subId": "7406302",
      "subQuestName": "Talk to Nelly",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740630201"
        ],
        "dialogs": {
          "740630201": {
            "id": "740630201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? What's a Kamera doing here?",
            "nextDialogs": [
              "740630202"
            ]
          },
          "740630202": {
            "id": "740630202",
            "speakerId": 5219,
            "speakerName": "Nelly",
            "text": "\"Where there's news, there's Kameras.\" Have you never heard that before?",
            "nextDialogs": [
              "740630204",
              "740630207"
            ]
          },
          "740630204": {
            "id": "740630204",
            "speakerId": 5219,
            "speakerName": "Nelly",
            "text": "But I just made that up, so where did you hear it?",
            "nextDialogs": [
              "740630205"
            ]
          },
          "740630205": {
            "id": "740630205",
            "speakerId": 5219,
            "speakerName": "Nelly",
            "text": "Well, there really isn't anything new under the sun, anyway. No matter what I say or write, it is always but a parody of others.",
            "nextDialogs": [
              "740630208"
            ]
          },
          "740630208": {
            "id": "740630208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Kamera is here, so where's the news?",
            "nextDialogs": [
              "740630209"
            ]
          },
          "740630209": {
            "id": "740630209",
            "speakerId": 5219,
            "speakerName": "Nelly",
            "text": "Well... News is like fishing. It requires patience and making the right judgment at the right time. That's how you hook really big fish...",
            "nextDialogs": [
              "740630210"
            ]
          },
          "740630210": {
            "id": "740630210",
            "speakerId": 5219,
            "speakerName": "Nelly",
            "text": "Oh! I mean... That's how you hook a scoop. Hmm? Wait, that doesn't sound right! Ugh! Forget it!"
          },
          "740630207": {
            "id": "740630207",
            "speakerId": 5219,
            "speakerName": "Nelly",
            "text": "Oh! Well, you've heard it now! Don't forget that if you do happen to use it anywhere else, you must cite the source — namely, me!"
          }
        }
      }
    },
    {
      "subId": "7406303",
      "subQuestName": "Turn off the loudspeaker",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740630301"
        ],
        "dialogs": {
          "740630301": {
            "id": "740630301",
            "speakerId": 5219,
            "speakerName": "Nelly",
            "text": "I must take a photo so good that all the other photographers will gain new levels of respect for me!",
            "nextDialogs": [
              "740630302"
            ]
          },
          "740630302": {
            "id": "740630302",
            "speakerId": 5219,
            "speakerName": "Nelly",
            "text": "I still want the Platinum Collection though... Agh..."
          }
        }
      }
    },
    {
      "subId": "7406304",
      "subQuestName": "Talk to the guard",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740630401"
        ],
        "dialogs": {
          "740630401": {
            "id": "740630401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hi, we found a loudspeaker that seems to be malfunctioning... It's over there.",
            "nextDialogs": [
              "740630402"
            ]
          },
          "740630402": {
            "id": "740630402",
            "speakerId": 5236,
            "speakerName": "Grainville",
            "text": "Again? That's strange... I just got Clynes to repair it. Looks like he's not even as good at fixing things as I am. I mean, all you gotta do is give machines a couple of good smacks, right?",
            "nextDialogs": [
              "740630403"
            ]
          },
          "740630403": {
            "id": "740630403",
            "speakerId": 5236,
            "speakerName": "Grainville",
            "text": "Anyway, thanks, I'll go have a look.",
            "nextDialogs": [
              "740630404"
            ]
          },
          "740630404": {
            "id": "740630404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Thanks for your help!"
          }
        }
      }
    },
    {
      "subId": "7406306",
      "subQuestName": "Wait for the guard to reach the designated spot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740630601"
        ],
        "dialogs": {
          "740630601": {
            "id": "740630601",
            "speakerId": 5236,
            "speakerName": "Grainville",
            "text": "What's wrong with it? Hmm..."
          }
        }
      }
    },
    {
      "subId": "7406305",
      "subQuestName": "Talk to Nelly",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740630501"
        ],
        "dialogs": {
          "740630501": {
            "id": "740630501",
            "speakerId": 5219,
            "speakerName": "Nelly",
            "text": "I've finally completed my project! I'm a journalist in my own right now! Thank you!",
            "nextDialogs": [
              "740630502"
            ]
          },
          "740630502": {
            "id": "740630502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You must have snapped a really excellent picture.",
            "nextDialogs": [
              "740630503"
            ]
          },
          "740630503": {
            "id": "740630503",
            "speakerId": 5219,
            "speakerName": "Nelly",
            "text": "Yeah, take a look at this.",
            "nextDialogs": [
              "740630505",
              "740630507"
            ]
          },
          "740630505": {
            "id": "740630505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon doesn't understand art at all...",
            "nextDialogs": [
              "740630508"
            ]
          },
          "740630508": {
            "id": "740630508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Will it really be okay to just use this one?",
            "nextDialogs": [
              "740630509"
            ]
          },
          "740630509": {
            "id": "740630509",
            "speakerId": 5219,
            "speakerName": "Nelly",
            "text": "What's wrong with it? I think it's a great shot! I'm sure no one would have expected me to snap a shot like this one! They will all be so surprised...",
            "nextDialogs": [
              "740630510"
            ]
          },
          "740630510": {
            "id": "740630510",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon really doesn't get your standards for artistic critique...",
            "nextDialogs": [
              "740630511"
            ]
          },
          "740630511": {
            "id": "740630511",
            "speakerId": 5219,
            "speakerName": "Nelly",
            "text": "Oh, it's called \"symbolic meaning over substance.\" I'm sure all experienced photographers will understand once I submit it!",
            "nextDialogs": [
              "740630512"
            ]
          },
          "740630512": {
            "id": "740630512",
            "speakerId": 5219,
            "speakerName": "Nelly",
            "text": "Anyway, thank you. This is for you. Hehe, it would be great if we could chat at a fishing spot next time!"
          },
          "740630507": {
            "id": "740630507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, Paimon might get dizzy if she looks at it any longer..."
          }
        }
      }
    },
    {
      "subId": "7406300",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740630004"
        ],
        "dialogs": {
          "740630004": {
            "id": "740630004",
            "speakerId": 5219,
            "speakerName": "Nelly",
            "text": "Hehe! It worked!",
            "nextDialogs": [
              "740630005"
            ]
          },
          "740630005": {
            "id": "740630005",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Now go ahead and turn off the loudspeaker.",
            "nextDialogs": [
              "740630006"
            ]
          },
          "740630006": {
            "id": "740630006",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Next, we report to Grainville and tell him that there's something wrong with the loudspeaker, right?",
            "nextDialogs": [
              "740630007"
            ]
          },
          "740630007": {
            "id": "740630007",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "After that, it's all up to Nelly. Let's wait and see."
          }
        }
      }
    }
  ]
}
      "subQuestName": "Interrogate the guard",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "201010301"
        ],
        "dialogs": {
          "201010301": {
            "id": "201010301",
            "speakerId": 10329,
            "speakerName": "Fatui Guard",
            "text": "No, NO! Don't eat me! Ah? You're... You're human?",
            "nextDialogs": [
              "201010302"
            ]
          },
          "201010302": {
            "id": "201010302",
            "speakerId": 10329,
            "speakerName": "Fatui Guard",
            "text": "The entire floor's defenses... have been broken. I thought it was the Abyss Order attacking...",
            "nextDialogs": [
              "201010304",
              "201010306"
            ]
          },
          "201010304": {
            "id": "201010304",
            "speakerId": 10329,
            "speakerName": "Fatui Guard",
            "text": "H—How did you guys know the lyre's here?",
            "nextDialogs": [
              "201010309"
            ]
          },
          "201010309": {
            "id": "201010309",
            "speakerId": 10329,
            "speakerName": "Fatui Guard",
            "text": "The place it's being kept is locked up tight. If you're after the key, keep going further into the ruins, but d—don't come after me!",
            "nextDialogs": [
              "201010310"
            ]
          },
          "201010310": {
            "id": "201010310",
            "speakerId": 10329,
            "speakerName": "Fatui Guard",
            "text": "I don't know which one of the guards has it, but I'm sure you can find the guards and find out for yourselves.",
            "nextDialogs": [
              "201010311"
            ]
          },
          "201010311": {
            "id": "201010311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This guy looks like he's about to wet himself...",
            "nextDialogs": [
              "201010312"
            ]
          },
          "201010312": {
            "id": "201010312",
            "speakerId": 10329,
            "speakerName": "Fatui Guard",
            "text": "Y—You just worry about yourselves!",
            "nextDialogs": [
              "201010313"
            ]
          },
          "201010313": {
            "id": "201010313",
            "speakerId": 10329,
            "speakerName": "Fatui Guard",
            "text": "One of the Harbingers is already in Mondstadt.",
            "nextDialogs": [
              "201010314"
            ]
          },
          "201010314": {
            "id": "201010314",
            "speakerId": 10329,
            "speakerName": "Fatui Guard",
            "text": "Signora. When she gets her hands on you she's going to string you up and torture you. When that time comes, don't you dare say a word about me."
          },
          "201010306": {
            "id": "201010306",
            "speakerId": 10329,
            "speakerName": "Fatui Guard",
            "text": "Ahh, Ah, Ah!",
            "nextDialogs": [
              "201010307"
            ]
          },
          "201010307": {
            "id": "201010307",
            "speakerId": 10329,
            "speakerName": "Fatui Guard",
            "text": "No, don't! I have valuable information! I'll tell you!",
            "nextDialogs": [
              "201010308"
            ]
          },
          "201010308": {
            "id": "201010308",
            "speakerId": 10329,
            "speakerName": "Fatui Guard",
            "text": "We hid the Holy Lyre in the depths of these ruins."
          }
        }
      }
    },

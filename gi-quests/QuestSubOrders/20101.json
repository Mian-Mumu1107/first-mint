    {
      "subId": "2010127",
      "subQuestName": "Bribe NPC 3",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "201012701"
        ],
        "dialogs": {
          "201012701": {
            "id": "201012701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Deceptive dialog content) We are members of the Society for The Advancement of Snezhno-Mondstadtian Relations.",
            "nextDialogs": [
              "201012799"
            ]
          },
          "201012799": {
            "id": "201012799",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We are here to issue rewards on behalf of the Association. But we need to have a little... discussion with your captain first.",
            "nextDialogs": [
              "201012702"
            ]
          },
          "201012702": {
            "id": "201012702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How did you know Paimon would be willing to help you?",
            "nextDialogs": [
              "201012704",
              "201012706",
              "201012708"
            ]
          },
          "201012704": {
            "id": "201012704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What!?",
            "nextDialogs": [
              "201012709"
            ]
          },
          "201012709": {
            "id": "201012709",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon can help you, but once the captain agrees Paimon will need 2,000 Mora as compensation."
          },
          "201012706": {
            "id": "201012706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Wise words!"
          },
          "201012708": {
            "id": "201012708",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Huh."
          }
        }
      }
    },

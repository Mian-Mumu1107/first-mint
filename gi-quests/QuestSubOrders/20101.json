        ],
        "dialogs": {
          "201015101": {
            "id": "201015101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Where did that guy go, though? He was here a second ago...",
            "nextDialogs": [
              "201015102"
            ]
          },
          "201015102": {
            "id": "201015102",
            "speakerId": 10048,
            "speakerName": "Agent",
            "text": "Signora is going to end you. The songs bards sing of your demise will be so terrifying — the people of Mondstadt will never sleep again for the nightmares they give them.",
            "nextDialogs": [
              "201015103"
            ]
          },
          "201015103": {
            "id": "201015103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Big talk for a guy who still ran off in the end... Chicken."
          }
        }

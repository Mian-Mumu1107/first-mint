    {
      "subId": "7527101",
      "subQuestName": "Talk to Ziki $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752710401"
        ],
        "dialogs": {
          "752710401": {
            "id": "752710401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll help you paint them red.",
            "nextDialogs": [
              "752710402"
            ]
          },
          "752710402": {
            "id": "752710402",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "You will! Thank you, thank you! You're such a kindhearted friend!"
          }
        }
      }
    },
    {
      "subId": "7527102",
      "subQuestName": "Paint the balloon red $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752710201"
        ],
        "dialogs": {
          "752710201": {
            "id": "752710201",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "...Ah! I'm so lucky to have met you, friend. Please help me paint these balloons a romantic red."
          }
        }
      }
    },
    {
      "subId": "7527103",
      "subQuestName": "Talk to Ziki $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752710301"
        ],
        "dialogs": {
          "752710301": {
            "id": "752710301",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "Romantic red balloons... I'm sure such beauty will stir the heart of my beloved!",
            "nextDialogs": [
              "752710302"
            ]
          },
          "752710302": {
            "id": "752710302",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "Isn't that right, friend?",
            "nextDialogs": [
              "752710305"
            ]
          },
          "752710305": {
            "id": "752710305",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "Whatever happens, thank you so much, friend. Stay awhile, I'd like to introduce you to Yopoyi.",
            "nextDialogs": [
              "752710306"
            ]
          },
          "752710306": {
            "id": "752710306",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "Given what time it is... Hmm, she should be here any moment now. We made an appointment and everything."
          }
        }
      }
    },
    {
      "subId": "7527105",
      "subQuestName": "Witness Ziki's confession $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752710601"
        ],
        "dialogs": {
          "752710601": {
            "id": "752710601",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "Yopoyi! You came!",
            "nextDialogs": [
              "752710602"
            ]
          },
          "752710602": {
            "id": "752710602",
            "speakerId": 21976,
            "speakerName": "Yopoyi",
            "text": "Ziki? It's you... What's with the outfit?",
            "nextDialogs": [
              "752710603"
            ]
          },
          "752710603": {
            "id": "752710603",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "I'm a Nanasian — your favorite! I rented the costume specially. How do I look? Oh, and these balloons — I prepared them just for you!",
            "nextDialogs": [
              "752710604"
            ]
          },
          "752710604": {
            "id": "752710604",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "Actually, there's something I've been wanting to say for a long time... Please go out with me!",
            "nextDialogs": [
              "752710605"
            ]
          },
          "752710605": {
            "id": "752710605",
            "speakerId": 21976,
            "speakerName": "Yopoyi",
            "text": "...Are you for real?",
            "nextDialogs": [
              "752710606"
            ]
          },
          "752710606": {
            "id": "752710606",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "I am! My lovely lady, Yopoyi, please, say you'll go out on a date with me!",
            "nextDialogs": [
              "752710607"
            ]
          },
          "752710607": {
            "id": "752710607",
            "speakerId": 21976,
            "speakerName": "Yopoyi",
            "text": "Did you hit your head getting into that costume or something? This is our third anniversary! We're MARRIED!",
            "nextDialogs": [
              "752710608"
            ]
          },
          "752710608": {
            "id": "752710608",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "I know that! It's just... you're always telling me how unromantic I am... and I never properly confessed my love before our marriage... I know it's late, but this is my confession to you!",
            "nextDialogs": [
              "752710609"
            ]
          },
          "752710609": {
            "id": "752710609",
            "speakerId": 21976,
            "speakerName": "Yopoyi",
            "text": "Haha... So that's it, huh? Alright then, of course I'll go out with you.",
            "nextDialogs": [
              "752710610"
            ]
          },
          "752710610": {
            "id": "752710610",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "For real?",
            "nextDialogs": [
              "752710611"
            ]
          },
          "752710611": {
            "id": "752710611",
            "speakerId": 21976,
            "speakerName": "Yopoyi",
            "text": "Yes, for real, you silly romantic fool, you.",
            "nextDialogs": [
              "752710612"
            ]
          },
          "752710612": {
            "id": "752710612",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "A gust of wind blows by, and the lovers embrace."
          }
        }
      }
    },
    {
      "subId": "7527101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752710101"
        ],
        "dialogs": {
          "752710101": {
            "id": "752710101",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "Please don't pop these balloons! If you want some to play with, I have some others I can give you.",
            "nextDialogs": [
              "752710102"
            ]
          },
          "752710102": {
            "id": "752710102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "These balloons look special.",
            "nextDialogs": [
              "752710103"
            ]
          },
          "752710103": {
            "id": "752710103",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "It's a little embarrassing to say, but they're very important items to me.",
            "nextDialogs": [
              "752710104"
            ]
          },
          "752710104": {
            "id": "752710104",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "I'm sure you can guess their purpose just by looking at them, right?",
            "nextDialogs": [
              "752710106",
              "752710108"
            ]
          },
          "752710106": {
            "id": "752710106",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "Actually, they're for a romantic confession.",
            "nextDialogs": [
              "752710109"
            ]
          },
          "752710109": {
            "id": "752710109",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "I plan to use these romantic balloons to confess my love to my beloved Yopoyi! Well? What do you think?",
            "nextDialogs": [
              "752710110"
            ]
          },
          "752710110": {
            "id": "752710110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You should use red ones.",
            "nextDialogs": [
              "752710111"
            ]
          },
          "752710111": {
            "id": "752710111",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "Hmm... You've got a point. Gosh, is my spirit of romance still not up to scratch?",
            "nextDialogs": [
              "752710112"
            ]
          },
          "752710112": {
            "id": "752710112",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "Yopoyi's going to be here any minute! Where am I even going to find some red balloons?"
          },
          "752710108": {
            "id": "752710108",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "Th—That's right!"
          }
        }
      }
    },
    {
      "subId": "7527105",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752710501"
        ],
        "dialogs": {
          "752710501": {
            "id": "752710501",
            "speakerId": 22032,
            "speakerName": "Ziki",
            "text": "Thank you, kind friend.",
            "nextDialogs": [
              "752710502"
            ]
          },
          "752710502": {
            "id": "752710502",
            "speakerId": 21976,
            "speakerName": "Yopoyi",
            "text": "Has Ziki been causing you trouble? His thought process can be a little unconventional, but that's what I like about him."
          }
        }
      }
    }
  ]
}
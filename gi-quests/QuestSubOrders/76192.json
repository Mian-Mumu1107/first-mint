  "subQuests": [
    {
      "subId": "7619201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761920101"
        ],
        "dialogs": {
          "761920101": {
            "id": "761920101",
            "speakerId": 1000,
            "speakerName": "Helka",
            "text": "Looks like today's not our lucky day... We've been waiting so long and haven't even spotted a single ordinary Frostfin Whale...",
            "nextDialogs": [
              "761920102"
            ]
          },
          "761920102": {
            "id": "761920102",
            "speakerId": 1001,
            "speakerName": "Maisie",
            "text": "Hmm...",
            "nextDialogs": [
              "761920103"
            ]
          },
          "761920103": {
            "id": "761920103",
            "speakerId": 1000,
            "speakerName": "Helka",
            "text": "Hmm... Maybe we should call it a day and head back. There'll be other chances.",
            "nextDialogs": [
              "761920104"
            ]
          },
          "761920104": {
            "id": "761920104",
            "speakerId": 1001,
            "speakerName": "Maisie",
            "text": "But... you're only back for a short while before you leave for other places again, right?",
            "nextDialogs": [
              "761920105"
            ]
          },
          "761920105": {
            "id": "761920105",
            "speakerId": 1001,
            "speakerName": "Maisie",
            "text": "Let's wait a bit longer, then.",
            "nextDialogs": [
              "761920106"
            ]
          },
          "761920106": {
            "id": "761920106",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "Wait... Helka, is that you?",
            "nextDialogs": [
              "761920107"
            ]
          },
          "761920107": {
            "id": "761920107",
            "speakerId": 1000,
            "speakerName": "Helka",
            "text": "Linnea! Yes, I'm back. But my archive isn't quite complete yet, so our showdown will have to wait.",
            "nextDialogs": [
              "761920108"
            ]
          },
          "761920108": {
            "id": "761920108",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "Oh? So the trip was fruitful, then. I haven't been idle either, and I added quite a bit to my own records.",
            "nextDialogs": [
              "761920109"
            ]
          },
          "761920109": {
            "id": "761920109",
            "speakerId": 1001,
            "speakerName": "Maisie",
            "text": "Did you come to see the Frostfin Whale too?",
            "nextDialogs": [
              "761920110"
            ]
          },
          "761920110": {
            "id": "761920110",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "Yes. I heard it was only discovered recently. Considering its size, I suspect environmental changes caused the shift in its skin color.",
            "nextDialogs": [
              "761920111"
            ]
          },
          "761920111": {
            "id": "761920111",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "Like the concentration of kuuvahki in the area, for example...",
            "nextDialogs": [
              "761920112"
            ]
          },
          "761920112": {
            "id": "761920112",
            "speakerId": 1000,
            "speakerName": "Helka",
            "text": "It's a shame, but we probably won't see it today. We've waited so long, and we've got nothing to show for it.",
            "nextDialogs": [
              "761920113"
            ]
          },
          "761920113": {
            "id": "761920113",
            "speakerId": 1000,
            "speakerName": "Helka",
            "text": "Linnea... back me up here! Let's just call it a day and head back, Maisie...",
            "nextDialogs": [
              "761920114"
            ]
          },
          "761920114": {
            "id": "761920114",
            "speakerId": 1001,
            "speakerName": "Maisie",
            "text": "I'm fine. I feel better than usual since I woke up this morning. Let's wait a little longer.",
            "nextDialogs": [
              "761920115"
            ]
          },
          "761920115": {
            "id": "761920115",
            "speakerId": 1001,
            "speakerName": "Maisie",
            "text": "I heard that anyone who sees the Frostfin Whale can have their wish come true. So... it's supposed to bring good luck, right?",
            "nextDialogs": [
              "761920116"
            ]
          },
          "761920116": {
            "id": "761920116",
            "speakerId": 1001,
            "speakerName": "Maisie",
            "text": "I hope you can take the luck it brings with you on your next journey, Helka.",
            "nextDialogs": [
              "761920117"
            ]
          },
          "761920117": {
            "id": "761920117",
            "speakerId": 1000,
            "speakerName": "Helka",
            "text": "But...",
            "nextDialogs": [
              "761920118"
            ]
          },
          "761920118": {
            "id": "761920118",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "Let's wait together, then.",
            "nextDialogs": [
              "761920119"
            ]
          },
          "761920119": {
            "id": "761920119",
            "speakerId": 1000,
            "speakerName": "Helka",
            "text": "...Linnea!",
            "nextDialogs": [
              "761920120"
            ]
          },
          "761920120": {
            "id": "761920120",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "Don't worry. I have a feeling we're going to see that Frostfin Whale today.",
            "nextDialogs": [
              "761920121"
            ]
          },
          "761920121": {
            "id": "761920121",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "You know how it is, Helka. My instincts are always right.",
            "nextDialogs": [
              "761920122"
            ]
          },
          "761920122": {
            "id": "761920122",
            "speakerId": 1000,
            "speakerName": "Helka",
            "text": "Alright... then we'll wait a little longer. But just a little, okay?",
            "nextDialogs": [
              "761920123"
            ]
          },
          "761920123": {
            "id": "761920123",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "A while later...",
            "nextDialogs": [
              "761920124"
            ]
          },
          "761920124": {
            "id": "761920124",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "Look, look! Wow, it jumped so high!",
            "nextDialogs": [
              "761920125"
            ]
          },
          "761920125": {
            "id": "761920125",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "I wish I could swim that fast too... Swimming with them must be so much fun!",
            "nextDialogs": [
              "761920126"
            ]
          },
          "761920126": {
            "id": "761920126",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "Let's just jump in now—",
            "nextDialogs": [
              "761920127"
            ]
          },
          "761920127": {
            "id": "761920127",
            "speakerId": 1000,
            "speakerName": "Helka",
            "text": "Hey! That's too dangerous! Geez, nothing's changed while I was away. You're still as reckless as ever...",
            "nextDialogs": [
              "761920128"
            ]
          },
          "761920128": {
            "id": "761920128",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "W—What? Don't you want to play with them too? They're having so much fun!",
            "nextDialogs": [
              "761920129"
            ]
          },
          "761920129": {
            "id": "761920129",
            "speakerId": 1001,
            "speakerName": "Maisie",
            "text": "But if your clothes get wet, you might catch a cold. Why not stay on shore and use the Kamera to capture them having fun?",
            "nextDialogs": [
              "761920130"
            ]
          },
          "761920130": {
            "id": "761920130",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "Hmm... makes sense. Then I'll borrow Helka's Kamera for a bit."
          }
        }
      }
    },

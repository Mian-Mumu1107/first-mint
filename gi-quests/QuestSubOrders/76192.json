          "761920501": {
            "id": "761920501",
            "speakerId": 1001,
            "speakerName": "Maisie",
            "text": "There's nothing there...",
            "nextDialogs": [
              "761920502"
            ]
          },
          "761920502": {
            "id": "761920502",
            "speakerId": 1000,
            "speakerName": "Helka",
            "text": "Seems like today is not our lucky day."
          }
        }
      }
    },

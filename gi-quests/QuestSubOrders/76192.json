    {
      "subId": "7619204",
      "subQuestName": "Take a photo of the Frostfin Whale",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761920401"
        ],
        "dialogs": {
          "761920401": {
            "id": "761920401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(There seems to be something nearby worth examining. <color=#FFCC33FF>Linnea</color>, with her deep knowledge of the local ecology, might find something useful...)"
          }
        }
      }
    },
    {
      "subId": "7619205",
      "subQuestName": "Talk to Maisie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761920201"
        ],
        "dialogs": {
          "761920201": {
            "id": "761920201",
            "speakerId": 1001,
            "speakerName": "Maisie",
            "text": "That was a great shot!",
            "nextDialogs": [
              "761920202"
            ]
          },
          "761920202": {
            "id": "761920202",
            "speakerId": 1000,
            "speakerName": "Helka",
            "text": "Feeling satisfied now?",
            "nextDialogs": [
              "761920203"
            ]
          },
          "761920203": {
            "id": "761920203",
            "speakerId": 1001,
            "speakerName": "Maisie",
            "text": "Mhm! Whether the legend's true or not, I hope that, wherever you go, Helka, luck will see you through any danger and bring you back to Speranza, safe and sound.",
            "nextDialogs": [
              "761920204"
            ]
          },
          "761920204": {
            "id": "761920204",
            "speakerId": 1000,
            "speakerName": "Helka",
            "text": "...Thanks.",
            "nextDialogs": [
              "761920205"
            ]
          },
          "761920205": {
            "id": "761920205",
            "speakerId": 1001,
            "speakerName": "Maisie",
            "text": "Hehe, shall we head back then? Thanks so much, Linnea! See you at Speranza!",
            "nextDialogs": [
              "761920206"
            ]
          },
          "761920206": {
            "id": "761920206",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "Mm-hmm! See you there!"
          }
        }
      }
    },
    {
      "subId": "7619205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

{
  "lineCounts": {
    "Hasegawa": 6,
    "Junkichi": 15,
    "Player": 8,
    "Rie": 8,
    "Shigeru": 20,
    "Yuzu": 6
  },
  "subQuests": [
    {
      "subId": "2201301",
      "subQuestName": "Visit Shigeru and Junkichi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220130101"
        ],
        "dialogs": {
          "220130101": {
            "id": "220130101",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "Have you read the reader feedback? Our reviews have been plummeting lately!",
            "nextDialogs": [
              "220130102"
            ]
          },
          "220130102": {
            "id": "220130102",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "Don't worry. This is just the calm before the grand climax!",
            "nextDialogs": [
              "220130103"
            ]
          },
          "220130103": {
            "id": "220130103",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "When the key plot point gets revealed, we'll see a real turnaround in those reviews!",
            "nextDialogs": [
              "220130104"
            ]
          },
          "220130104": {
            "id": "220130104",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "And what good is that if your novel gets axed long before you get there?",
            "nextDialogs": [
              "220130105"
            ]
          },
          "220130105": {
            "id": "220130105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's going on?",
            "nextDialogs": [
              "220130106"
            ]
          },
          "220130106": {
            "id": "220130106",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "Traveler, thank goodness you're here.",
            "nextDialogs": [
              "220130107"
            ]
          },
          "220130107": {
            "id": "220130107",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "Junkichi has been adding a lot more wild abilities to the main character, in \"Onibudou.\" It's just been one thing after another ever since that \"inspiration trip\" of his.",
            "nextDialogs": [
              "220130108"
            ]
          },
          "220130108": {
            "id": "220130108",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "Yae Publishing House has received a lot of negative feedback from readers who say they don't understand why these abilities are appearing. They think that the author isn't taking the story seriously.",
            "nextDialogs": [
              "220130109"
            ]
          },
          "220130109": {
            "id": "220130109",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "They don't know what they're talking about. I'll just keep writing, they'll get it at some point...",
            "nextDialogs": [
              "220130110"
            ]
          },
          "220130110": {
            "id": "220130110",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "Like I was saying, your novel will get axed before you can get to that point!",
            "nextDialogs": [
              "220130111"
            ]
          },
          "220130111": {
            "id": "220130111",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "Oh, whatever... From what I recall, there are a few readers of \"Onibudou\" around this area...",
            "nextDialogs": [
              "220130112"
            ]
          },
          "220130112": {
            "id": "220130112",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "Why don't you go and ask them if your idea has legs or not?",
            "nextDialogs": [
              "220130113"
            ]
          },
          "220130113": {
            "id": "220130113",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "Fine! I'm sure they'll get it, anyway. Traveler, come with me. I'll need a witness!",
            "nextDialogs": [
              "220130114"
            ]
          },
          "220130114": {
            "id": "220130114",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "Yes, that sounds good. Bring the Traveler with you. That way, you can't deny what they say later.",
            "nextDialogs": [
              "220130115"
            ]
          },
          "220130115": {
            "id": "220130115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's do this.",
            "nextDialogs": [
              "220130116"
            ]
          },
          "220130116": {
            "id": "220130116",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "Okay, let's get going. I'm sure my readers will understand me!",
            "nextDialogs": [
              "220130117"
            ]
          },
          "220130117": {
            "id": "220130117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How much feature creep is there, anyway?",
            "nextDialogs": [
              "220130118"
            ]
          },
          "220130118": {
            "id": "220130118",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "Just... just a bit.",
            "nextDialogs": [
              "220130119"
            ]
          },
          "220130119": {
            "id": "220130119",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "\"A bit\"? The main character will soon have more abilities than every other character in the story combined!",
            "nextDialogs": [
              "220130120"
            ]
          },
          "220130120": {
            "id": "220130120",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "Ahem! Let's get going. I'm sure my readers get it!"
          }
        }
      }
    },
    {
      "subId": "2201302",
      "subQuestName": "Ask for Yuzu's opinion",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220130301"
        ],
        "dialogs": {
          "220130301": {
            "id": "220130301",
            "speakerId": 3023,
            "speakerName": "Yuzu",
            "text": "Hello, what is it?",
            "nextDialogs": [
              "220130302"
            ]
          },
          "220130302": {
            "id": "220130302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hello there. Have you read \"Onibudou,\" by any chance?",
            "nextDialogs": [
              "220130303"
            ]
          },
          "220130303": {
            "id": "220130303",
            "speakerId": 3023,
            "speakerName": "Yuzu",
            "text": "Huh? I have and I liked it, but... How should I put it? The plot seems a little strange lately.",
            "nextDialogs": [
              "220130304"
            ]
          },
          "220130304": {
            "id": "220130304",
            "speakerId": 3023,
            "speakerName": "Yuzu",
            "text": "The main character is constantly getting new abilities and can immediately defeat the enemy with them.",
            "nextDialogs": [
              "220130305"
            ]
          },
          "220130305": {
            "id": "220130305",
            "speakerId": 3023,
            "speakerName": "Yuzu",
            "text": "I liked \"Onibudou\" because of the clever methods the main character used to defeat his enemies, but now... it feels like the author is just being lazy.",
            "nextDialogs": [
              "220130306"
            ]
          },
          "220130306": {
            "id": "220130306",
            "speakerId": 3023,
            "speakerName": "Yuzu",
            "text": "Also, most of the abilities the main character gets are only used once. It makes the story seem so... flippant.",
            "nextDialogs": [
              "220130307"
            ]
          },
          "220130307": {
            "id": "220130307",
            "speakerId": 3023,
            "speakerName": "Yuzu",
            "text": "I really don't know what the author is thinking...",
            "nextDialogs": [
              "220130308"
            ]
          },
          "220130308": {
            "id": "220130308",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "Ahem... well... let's ask a few more people, shall we? This has got to be an odd case..."
          }
        }
      }
    },
    {
      "subId": "2201303",
      "subQuestName": "Ask for Hasegawa's opinion",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220130401"
        ],
        "dialogs": {
          "220130401": {
            "id": "220130401",
            "speakerId": 3021,
            "speakerName": "Hasegawa",
            "text": "Hello, is there anything I can help you with?",
            "nextDialogs": [
              "220130402"
            ]
          },
          "220130402": {
            "id": "220130402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, there is. Have you ever read \"Onibudou\"?",
            "nextDialogs": [
              "220130403"
            ]
          },
          "220130403": {
            "id": "220130403",
            "speakerId": 3021,
            "speakerName": "Hasegawa",
            "text": "Yes, I have! It's a very interesting novel. The characters and the plot are wonderful.",
            "nextDialogs": [
              "220130404"
            ]
          },
          "220130404": {
            "id": "220130404",
            "speakerId": 3021,
            "speakerName": "Hasegawa",
            "text": "But... I feel like the author has been slacking off a bit lately.",
            "nextDialogs": [
              "220130405"
            ]
          },
          "220130405": {
            "id": "220130405",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "Uh... Um...",
            "nextDialogs": [
              "220130406"
            ]
          },
          "220130406": {
            "id": "220130406",
            "speakerId": 3021,
            "speakerName": "Hasegawa",
            "text": "There are all these new powers that suddenly appear without having ever been referenced before.",
            "nextDialogs": [
              "220130407"
            ]
          },
          "220130407": {
            "id": "220130407",
            "speakerId": 3021,
            "speakerName": "Hasegawa",
            "text": "Although it's called an \"awakening,\" it just seems cheap.",
            "nextDialogs": [
              "220130408"
            ]
          },
          "220130408": {
            "id": "220130408",
            "speakerId": 3021,
            "speakerName": "Hasegawa",
            "text": "I just think this kind of cheap plot makes the character look cheap too. I really hope the author reconsiders this course...",
            "nextDialogs": [
              "220130409"
            ]
          },
          "220130409": {
            "id": "220130409",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "Traveler, let's... let's go ask someone else..."
          }
        }
      }
    },
    {
      "subId": "2201304",
      "subQuestName": "Ask for Rie's opinion",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220130501"
        ],
        "dialogs": {
          "220130501": {
            "id": "220130501",
            "speakerId": 3024,
            "speakerName": "Rie",
            "text": "Hi there, are you up for a chat?",
            "nextDialogs": [
              "220130502"
            ]
          },
          "220130502": {
            "id": "220130502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Indeed. Have you read \"Onibudou,\" by any chance?",
            "nextDialogs": [
              "220130503"
            ]
          },
          "220130503": {
            "id": "220130503",
            "speakerId": 3024,
            "speakerName": "Rie",
            "text": "I have. I like the main character a lot, too.",
            "nextDialogs": [
              "220130504"
            ]
          },
          "220130504": {
            "id": "220130504",
            "speakerId": 3024,
            "speakerName": "Rie",
            "text": "But I've been having a hard time reading it lately...",
            "nextDialogs": [
              "220130505"
            ]
          },
          "220130505": {
            "id": "220130505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A hard time?",
            "nextDialogs": [
              "220130506"
            ]
          },
          "220130506": {
            "id": "220130506",
            "speakerId": 3024,
            "speakerName": "Rie",
            "text": "In the last few chapters, the main character was suddenly bestowed with all these new abilities.",
            "nextDialogs": [
              "220130507"
            ]
          },
          "220130507": {
            "id": "220130507",
            "speakerId": 3024,
            "speakerName": "Rie",
            "text": "The story spends a lot of time talking about how those abilities were awakened and how they can be used.",
            "nextDialogs": [
              "220130508"
            ]
          },
          "220130508": {
            "id": "220130508",
            "speakerId": 3024,
            "speakerName": "Rie",
            "text": "And the names of those abilities are getting harder and harder to follow. I can't remember any of them.",
            "nextDialogs": [
              "220130509"
            ]
          },
          "220130509": {
            "id": "220130509",
            "speakerId": 3024,
            "speakerName": "Rie",
            "text": "If I keep reading, I don't think I will be able to follow the story without understanding these abilities.",
            "nextDialogs": [
              "220130510"
            ]
          },
          "220130510": {
            "id": "220130510",
            "speakerId": 3024,
            "speakerName": "Rie",
            "text": "*sigh* I was thinking of giving the book a rest and switching to something a little easier to follow.",
            "nextDialogs": [
              "220130511"
            ]
          },
          "220130511": {
            "id": "220130511",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "Uh... Let's...",
            "nextDialogs": [
              "220130512"
            ]
          },
          "220130512": {
            "id": "220130512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's head back...",
            "nextDialogs": [
              "220130513"
            ]
          },
          "220130513": {
            "id": "220130513",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "Okay... I don't get why this is happening..."
          }
        }
      }
    },
    {
      "subId": "2201305",
      "subQuestName": "Report the results to Shigeru",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220130601"
        ],
        "dialogs": {
          "220130601": {
            "id": "220130601",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "Alright then, how did it turn out? Did you get the readers'...",
            "nextDialogs": [
              "220130602"
            ]
          },
          "220130602": {
            "id": "220130602",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "...Wait, why does he look so depressed... what kind of feedback did you get?",
            "nextDialogs": [
              "220130603"
            ]
          },
          "220130603": {
            "id": "220130603",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "*sigh*... So, Junkichi, will you accept the feedback now?",
            "nextDialogs": [
              "220130604"
            ]
          },
          "220130604": {
            "id": "220130604",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "I can't believe it... How did this happen...",
            "nextDialogs": [
              "220130605"
            ]
          },
          "220130605": {
            "id": "220130605",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "Are my ideas... and my writing... not interesting enough?",
            "nextDialogs": [
              "220130606"
            ]
          },
          "220130606": {
            "id": "220130606",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "As I said, advancing the plot purely by giving the character new powers can be dangerous...",
            "nextDialogs": [
              "220130607"
            ]
          },
          "220130607": {
            "id": "220130607",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "The new traits might be momentarily popular, but as soon as the novelty wears off, the readers will get bored.",
            "nextDialogs": [
              "220130608"
            ]
          },
          "220130608": {
            "id": "220130608",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "This is years of experience talking, you know.",
            "nextDialogs": [
              "220130609"
            ]
          },
          "220130609": {
            "id": "220130609",
            "speakerId": 3032,
            "speakerName": "Junkichi",
            "text": "I—I know...",
            "nextDialogs": [
              "220130610"
            ]
          },
          "220130610": {
            "id": "220130610",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "It's not too late to change it, though... We can't reverse the reviews of the previous chapters, but we can get the following chapters back on solid footing...",
            "nextDialogs": [
              "220130611"
            ]
          },
          "220130611": {
            "id": "220130611",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "Thank you, Traveler. It's actually better to let him take a hit now. If he kept on writing like that, he would definitely be worse off overall.",
            "nextDialogs": [
              "220130612"
            ]
          },
          "220130612": {
            "id": "220130612",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "So, thank you. This is your payment. Please take it."
          }
        }
      }
    },
    {
      "subId": "2201302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220130201"
        ],
        "dialogs": {
          "220130201": {
            "id": "220130201",
            "speakerId": 3033,
            "speakerName": "Shigeru",
            "text": "Traveler, I'm counting on you. Please record their opinions honestly!"
          }
        }
      }
    }
  ]
}
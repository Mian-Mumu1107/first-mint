  "subQuests": [
    {
      "subId": "2302101",
      "subQuestName": "Talk to Rafiq",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230210101"
        ],
        "dialogs": {
          "230210101": {
            "id": "230210101",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "Traveler! You're just in time. I just launched the ship. It's steady as she goes, as they say.",
            "nextDialogs": [
              "230210102"
            ]
          },
          "230210102": {
            "id": "230210102",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "My calculation worked out perfectly, just as I thought!",
            "nextDialogs": [
              "230210103"
            ]
          },
          "230210103": {
            "id": "230210103",
            "speakerId": 1001,
            "speakerName": "Qishan",
            "text": "So, when do we start this load test?",
            "nextDialogs": [
              "230210104"
            ]
          },
          "230210104": {
            "id": "230210104",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "Let's not rush. The Traveler is here, so we may start soon.",
            "nextDialogs": [
              "230210105"
            ]
          },
          "230210105": {
            "id": "230210105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's a load test?",
            "nextDialogs": [
              "230210106"
            ]
          },
          "230210106": {
            "id": "230210106",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "In a nutshell, we test the load capacity of the ship using heavy objects.",
            "nextDialogs": [
              "230210107"
            ]
          },
          "230210107": {
            "id": "230210107",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "This means that someone is going to have to move the stuff onto the ship with me.",
            "nextDialogs": [
              "230210108"
            ]
          },
          "230210108": {
            "id": "230210108",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "And you, Traveler, as I observed previously, are most able-bodied. Surely such a gig is a piece of cake to you...",
            "nextDialogs": [
              "230210111"
            ]
          },
          "230210111": {
            "id": "230210111",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "Well... Ugh, I can't do this on my own, so I could only ask you to help out.",
            "nextDialogs": [
              "230210112"
            ]
          },
          "230210112": {
            "id": "230210112",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "There will be generous rewards, I promise! I just helped a guy fix his large ship days ago. It was a pretty well-paying job, too!",
            "nextDialogs": [
              "230210113"
            ]
          },
          "230210113": {
            "id": "230210113",
            "speakerId": 1001,
            "speakerName": "Qishan",
            "text": "Well paid, you say...",
            "nextDialogs": [
              "230210114"
            ]
          },
          "230210114": {
            "id": "230210114",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "Eh? Uh, well, I did spend nearly all that Mora on the ship...",
            "nextDialogs": [
              "230210115"
            ]
          },
          "230210115": {
            "id": "230210115",
            "speakerId": 1001,
            "speakerName": "Qishan",
            "text": "Nearly all?",
            "nextDialogs": [
              "230210116"
            ]
          },
          "230210116": {
            "id": "230210116",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "I still have some left! Don't worry, I can still buy you some coffee...",
            "nextDialogs": [
              "230210117"
            ]
          },
          "230210117": {
            "id": "230210117",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "Well then, Traveler, let's get this started! To the ship!"
          }
        }
      }
    },

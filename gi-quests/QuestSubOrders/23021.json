        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2302109",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230210901"
        ],
        "dialogs": {
          "230210901": {
            "id": "230210901",
            "speakerId": 1001,
            "speakerName": "Qishan",
            "text": "Huh? Is this ship really capable of carrying such heavy things..."
          }
        }
      }
    },
    {
      "subId": "2302106",
      "subQuestName": "Go back and talk to Rafiq",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230210614"
        ],
        "dialogs": {
          "230210614": {
            "id": "230210614",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "Alright! That should be it. Let's see what will happen...",
            "nextDialogs": [
              "230210601"
            ]
          },
          "230210601": {
            "id": "230210601",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Whoa! The ship's sprung a leak over there!",
            "nextDialogs": [
              "230210615"
            ]
          },
          "230210615": {
            "id": "230210615",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "What!?",
            "nextDialogs": [
              "230210602"
            ]
          },
          "230210602": {
            "id": "230210602",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "The ship is tilting! What's going on?",
            "nextDialogs": [
              "230210603"
            ]
          },
          "230210603": {
            "id": "230210603",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "Move the stuff off now! Something's gone wrong!",
            "nextDialogs": [
              "230210604"
            ]
          },
          "230210604": {
            "id": "230210604",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You rid the ship of heavy items together with Rafiq in a hurry...",
            "nextDialogs": [
              "230210605"
            ]
          },
          "230210605": {
            "id": "230210605",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "Whew... We're lucky that there weren't too many things to move.",
            "nextDialogs": [
              "230210606"
            ]
          },
          "230210606": {
            "id": "230210606",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "What the... Where did I go wrong?",
            "nextDialogs": [
              "230210607"
            ]
          },
          "230210607": {
            "id": "230210607",
            "speakerId": 1001,
            "speakerName": "Qishan",
            "text": "What did I say? The theoretical data you used is too extreme to be reliable.",
            "nextDialogs": [
              "230210608"
            ]
          },
          "230210608": {
            "id": "230210608",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "*sigh* I... I... Fine.",
            "nextDialogs": [
              "230210609"
            ]
          },
          "230210609": {
            "id": "230210609",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "This shouldn't have happened... I did my calculations with so much precision!",
            "nextDialogs": [
              "230210610"
            ]
          },
          "230210610": {
            "id": "230210610",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "Thanks for your help, Traveler. Please take this as compensation for your trouble.",
            "nextDialogs": [
              "230210611"
            ]
          },
          "230210611": {
            "id": "230210611",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "I'll go back and redo my calculations. Qishan, could you help me with them?",
            "nextDialogs": [
              "230210612"
            ]
          },
          "230210612": {
            "id": "230210612",
            "speakerId": 1001,
            "speakerName": "Qishan",
            "text": "You say it like I wasn't already helping before...",
            "nextDialogs": [
              "230210613"
            ]
          },
          "230210613": {
            "id": "230210613",
            "speakerId": 1001,
            "speakerName": "Qishan",
            "text": "Just leave it to me, and remember to buy me coffee after this."
          }
        }
      }
    },
    {
      "subId": "2302108",
      "subQuestName": "Go back and talk to Rafiq",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230210801"
        ],
        "dialogs": {
          "230210801": {
            "id": "230210801",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "Yes! It worked out!",
            "nextDialogs": [
              "230210802"
            ]
          },
          "230210802": {
            "id": "230210802",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "There are no structural problems with the hull... The waterline is stable, too. No tipping.",
            "nextDialogs": [
              "230210803"
            ]
          },
          "230210803": {
            "id": "230210803",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "Look, Qishan, my design and calculations are immaculate!",
            "nextDialogs": [
              "230210804"
            ]
          },
          "230210804": {
            "id": "230210804",
            "speakerId": 1001,
            "speakerName": "Qishan",
            "text": "Don't get carried away. We're just at phase one of the load test.",
            "nextDialogs": [
              "230210805"
            ]
          },
          "230210805": {
            "id": "230210805",
            "speakerId": 1001,
            "speakerName": "Qishan",
            "text": "And you haven't even taken into account the center of gravity shift that will occur on the ship due to weather and cargo as it navigates.",
            "nextDialogs": [
              "230210806"
            ]
          },
          "230210806": {
            "id": "230210806",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "Ugh... I'll consider those factors. But please, just let me enjoy this moment.",
            "nextDialogs": [
              "230210807"
            ]
          },
          "230210807": {
            "id": "230210807",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "Oh, Traveler, this is your payment. Please take it.",
            "nextDialogs": [
              "230210808"
            ]
          },
          "230210808": {
            "id": "230210808",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "Qishan, can't you just be happy for me once?",
            "nextDialogs": [
              "230210809"
            ]
          },
          "230210809": {
            "id": "230210809",
            "speakerId": 1001,
            "speakerName": "Qishan",
            "text": "But being happy for you isn't going to help you build the ship.",
            "nextDialogs": [
              "230210810"
            ]
          },
          "230210810": {
            "id": "230210810",
            "speakerId": 1001,
            "speakerName": "Qishan",
            "text": "Best you try to make your wallet happy instead."
          }
        }
      }
    },
    {
      "subId": "2302110",
      "subQuestName": "Go back and talk to Rafiq",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230211001"
        ],
        "dialogs": {
          "230211001": {
            "id": "230211001",
            "speakerId": 1000,
            "speakerName": "Rafiq",
            "text": "The load capacity of this ship is out of the question! Don't worry!"
          }
        }
      }
    }
  ]
}
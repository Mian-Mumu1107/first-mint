    {
      "subId": "1050203",
      "subQuestName": "Catch up with Klee and retrieve the box",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105020301"
        ],
        "dialogs": {
          "105020301": {
            "id": "105020301",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Found it! It's this box.",
            "nextDialogs": [
              "105020302"
            ]
          },
          "105020302": {
            "id": "105020302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Glad it wasn't damaged in the explosions.",
            "nextDialogs": [
              "105020303"
            ]
          },
          "105020303": {
            "id": "105020303",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Retrieval complete! Let's bring it back!"
          }
        }
      }
    },
    {
      "subId": "1050204",
      "subQuestName": "Talk to Klee and retrieve the box",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105020201"
        ],
        "dialogs": {
          "105020201": {
            "id": "105020201",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "We're heeere! This is it. Let's dig it up!",
            "nextDialogs": [
              "105020204"
            ]
          },
          "105020204": {
            "id": "105020204",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "It can't be. I put up a sign here. There's no mistake—",
            "nextDialogs": [
              "105020205"
            ]
          },
          "105020205": {
            "id": "105020205",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Argh! Dendro Slimes!",
            "nextDialogs": [
              "105020206"
            ]
          },
          "105020206": {
            "id": "105020206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yup. Dendro Slimes.",
            "nextDialogs": [
              "105020207"
            ]
          },
          "105020207": {
            "id": "105020207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*sigh* We can talk later, let's take them out first!"
          }
        }
      }
    },
    {
      "subId": "1050205",
      "subQuestName": "Defeat the attacking Dendro Slimes",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105020501"
        ],
        "dialogs": {
          "105020501": {
            "id": "105020501",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "About Mona's background and her quandary...",
            "nextDialogs": [
              "105020502"
            ]
          },
          "105020502": {
            "id": "105020502",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "I see. I understand the situation.",
            "nextDialogs": [
              "105020503"
            ]
          },
          "105020503": {
            "id": "105020503",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "There is a <color=#00E1FFFF>magic laboratory</color> in Mondstadt that has been sealed by some unknown person.",
            "nextDialogs": [
              "105020504"
            ]
          },
          "105020504": {
            "id": "105020504",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Although we have a few specialists who could break the seal, they all have their own labs, and aren't that interested in the matter.",
            "nextDialogs": [
              "105020505"
            ]
          },
          "105020505": {
            "id": "105020505",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "I believe that if the astrologist you mentioned can break the seal, the owner of that house wouldn't mind if she stayed there.",
            "nextDialogs": [
              "105020508"
            ]
          },
          "105020508": {
            "id": "105020508",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Alright. Then, allow me to tell you where the house is."
          }
        }
      }
    },
    {
      "subId": "1050206",

  "subQuests": [
    {
      "subId": "1050201",
      "subQuestName": "Reach Mondstadt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105020101"
        ],
        "dialogs": {
          "105020101": {
            "id": "105020101",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Are you ready? Don't shame your master now — we're about to meet that successor.",
            "nextDialogs": [
              "105020104"
            ]
          },
          "105020104": {
            "id": "105020104",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "I guess... Wait, no! It won't do if you have no idea at all, even if you are a fake disciple.",
            "nextDialogs": [
              "105020105"
            ]
          },
          "105020105": {
            "id": "105020105",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "We have a rule that forbids us from teaching outsiders, but I suppose... I suppose I could teach you.",
            "nextDialogs": [
              "105020106"
            ]
          },
          "105020106": {
            "id": "105020106",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "My astrology is based on hydromancy, and as the name suggests, I use the reflections in water bodies to observe the true starry sky.",
            "nextDialogs": [
              "105020107"
            ]
          },
          "105020107": {
            "id": "105020107",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Allow me to demonstrate. Watch closely now.",
            "nextDialogs": [
              "105020108"
            ]
          },
          "105020108": {
            "id": "105020108",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "From the present station and movement of the stars... I see, so that successor is a young... female... Knight of Favonius.",
            "nextDialogs": [
              "105020109"
            ]
          },
          "105020109": {
            "id": "105020109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Doesn't that sound like... Lisa?",
            "nextDialogs": [
              "105020110"
            ]
          },
          "105020110": {
            "id": "105020110",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "We will meet her here presently.",
            "nextDialogs": [
              "105020111"
            ]
          },
          "105020111": {
            "id": "105020111",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Well, that's all the information we need."
          }
        }
      }
    },

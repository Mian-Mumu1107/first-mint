    {
      "subId": "1050209",
      "subQuestName": "Head to the magical laboratory and check the seal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1050211",
      "subQuestName": "Talk to Mona",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105020601"
        ],
        "dialogs": {
          "105020601": {
            "id": "105020601",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "The person who placed this seal... is by no means simple. Breaking this seal by force is nigh on impossible.",
            "nextDialogs": [
              "105020602"
            ]
          },
          "105020602": {
            "id": "105020602",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Interesting. I suppose it's worth using my astrology on.",
            "nextDialogs": [
              "105020603"
            ]
          },
          "105020603": {
            "id": "105020603",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Let me see... Hmm, I see, so if you first... ...and then you...",
            "nextDialogs": [
              "105020604"
            ]
          },
          "105020604": {
            "id": "105020604",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Alright, it's open.",
            "nextDialogs": [
              "105020605"
            ]
          },
          "105020605": {
            "id": "105020605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Holy moly, that's amazing!",
            "nextDialogs": [
              "105020606"
            ]
          },
          "105020606": {
            "id": "105020606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Now we just need to go back to Katheryne, and you'll be able to stay here!",
            "nextDialogs": [
              "105020607"
            ]
          },
          "105020607": {
            "id": "105020607",
            "speakerId": 1606,
            "speakerName": "Goth",
            "text": "No need, no need, you have my utmost thanks.",
            "nextDialogs": [
              "105020608"
            ]
          },
          "105020608": {
            "id": "105020608",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "You are...?",
            "nextDialogs": [
              "105020609"
            ]
          },
          "105020609": {
            "id": "105020609",
            "speakerId": 1606,
            "speakerName": "Goth",
            "text": "Oh, I'm Goth, the owner of this house. I passed by the Adventurers' Guild a while back, and Katheryne told me about the matter.",
            "nextDialogs": [
              "105020610"
            ]
          },
          "105020610": {
            "id": "105020610",
            "speakerId": 1606,
            "speakerName": "Goth",
            "text": "I never thought this troublesome seal would be dispelled so quickly!",
            "nextDialogs": [
              "105020611"
            ]
          },
          "105020611": {
            "id": "105020611",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Does that mean I can stay here?",
            "nextDialogs": [
              "105020612"
            ]
          },
          "105020612": {
            "id": "105020612",
            "speakerId": 1606,
            "speakerName": "Goth",
            "text": "Of course, of course. The facilities inside were just being left there, anyway. I would be glad to have someone make use of them.",
            "nextDialogs": [
              "105020613"
            ]
          },
          "105020613": {
            "id": "105020613",
            "speakerId": 1606,
            "speakerName": "Goth",
            "text": "To express my thanks, I shall rent this building to you at the lowest possible price!",
            "nextDialogs": [
              "105020614"
            ]
          },
          "105020614": {
            "id": "105020614",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "R—Rent?",
            "nextDialogs": [
              "105020615"
            ]
          },
          "105020615": {
            "id": "105020615",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "I didn't hear anything about rent, and I helped out, too...",
            "nextDialogs": [
              "105020616"
            ]
          },
          "105020616": {
            "id": "105020616",
            "speakerId": 1606,
            "speakerName": "Goth",
            "text": "Yes, of course, I understand. I am most thankful to you for that, so rest assured that I will give you the best rates!",
            "nextDialogs": [
              "105020617"
            ]
          },
          "105020617": {
            "id": "105020617",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "I... I mean...",
            "nextDialogs": [
              "105020618"
            ]
          },
          "105020618": {
            "id": "105020618",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon thinks Mona's misunderstood something, but...",
            "nextDialogs": [
              "105020621"
            ]
          },
          "105020621": {
            "id": "105020621",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "*sigh* I guess I don't have any other choice. I'll rent this place.",
            "nextDialogs": [
              "105020622"
            ]
          },
          "105020622": {
            "id": "105020622",
            "speakerId": 1606,
            "speakerName": "Goth",
            "text": "Great! Then we are agreed. I will go prepare the documentation, please wait here.",
            "nextDialogs": [
              "105020623"
            ]
          },
          "105020623": {
            "id": "105020623",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Thanks for your help. Also, well, I'm very sorry, but I won't be able to do what I agreed to help you with just yet.",
            "nextDialogs": [
              "105020624"
            ]
          },
          "105020624": {
            "id": "105020624",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Without the necessary tools, and without new knowledge, it will take me some time to see your destiny clearly.",
            "nextDialogs": [
              "105020625"
            ]
          },
          "105020625": {
            "id": "105020625",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "But I promise that I'll do a reading for you first thing once I'm ready!"
          }
        }
      }
    },
    {
      "subId": "1050207",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105020701"
        ],
        "dialogs": {
          "105020701": {
            "id": "105020701",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "That box is really important to me...",
            "nextDialogs": [
              "105020702"
            ]
          },
          "105020702": {
            "id": "105020702",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "If anything were to happen to it, I wouldn't be able to report back to that old crone..."
          }
        }
      }
    }
  ]
}
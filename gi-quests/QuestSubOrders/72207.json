      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722070101"
        ],
        "dialogs": {
          "722070101": {
            "id": "722070101",
            "speakerId": 20429,
            "speakerName": "Shitoki",
            "text": "It's not enough... Not enough at all...",
            "nextDialogs": [
              "722070102"
            ]
          },
          "722070102": {
            "id": "722070102",
            "speakerId": 20429,
            "speakerName": "Shitoki",
            "text": "The treasure that Brother left me is in those conches...",
            "nextDialogs": [
              "722070103"
            ]
          },
          "722070103": {
            "id": "722070103",
            "speakerId": 20429,
            "speakerName": "Shitoki",
            "text": "But they've been scattered, aye, they've been scattered all over...",
            "nextDialogs": [
              "722070104"
            ]
          },
          "722070104": {
            "id": "722070104",
            "speakerId": 20429,
            "speakerName": "Shitoki",
            "text": "It's Brother's treasure. I can't leave yet, no, no...",
            "nextDialogs": [
              "722070107"
            ]
          },
          "722070107": {
            "id": "722070107",
            "speakerId": 20429,
            "speakerName": "Shitoki",
            "text": "He went out into the Sea of Fog, and that made the priest really angry. The priest said that my older brother's spirit would never be able to return...",
            "nextDialogs": [
              "722070108"
            ]
          },
          "722070108": {
            "id": "722070108",
            "speakerId": 20429,
            "speakerName": "Shitoki",
            "text": "But Brother said that \"there are lovely flowers there and seas with pearls. Father rows a boat there, and he and our little sister wave to us...\"",
            "nextDialogs": [
              "722070109"
            ]
          },
          "722070109": {
            "id": "722070109",
            "speakerId": 20429,
            "speakerName": "Shitoki",
            "text": "He left his treasure behind when he went out to sea, and he never returned."
          }
        }
      }
    },
    {
      "subId": "7220703",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722070301"
        ],
        "dialogs": {
          "722070301": {
            "id": "722070301",
            "speakerId": 20429,
            "speakerName": "Shitoki",
            "text": "Ah, I see, I see. So that's where the treasure was! Thank you so much.",
            "nextDialogs": [
              "722070302"
            ]
          },
          "722070302": {
            "id": "722070302",
            "speakerId": 20429,
            "speakerName": "Shitoki",
            "text": "Though we won't be able to go to the land of dreams together, I'm sure I'll be able to turn into motes of light and return to look for you...",
            "nextDialogs": [
              "722070303"
            ]
          },
          "722070303": {
            "id": "722070303",
            "speakerId": 20429,
            "speakerName": "Shitoki",
            "text": "Do strange spirits wandering in a strange land also dream, I wonder?"
          }
        }
      }
    },
    {
      "subId": "7220702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722070201"
        ],
        "dialogs": {
          "722070201": {
            "id": "722070201",
            "speakerId": 20429,
            "speakerName": "Shitoki",
            "text": "No, no, I cannot leave. Not before I find his treasure..."
          }
        }
      }
    }
  ]

    {
      "subId": "2503007",
      "subQuestName": "Dig out the buried target mechanisms",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250300701"
        ],
        "dialogs": {
          "250300701": {
            "id": "250300701",
            "speakerId": 1002,
            "speakerName": "Alem",
            "text": "Tahmures, how's my training coming? Can I be an archaeologist now?",
            "nextDialogs": [
              "250300702"
            ]
          },
          "250300702": {
            "id": "250300702",
            "speakerId": 1001,
            "speakerName": "Tahmures",
            "text": "Yes, you're doing great, Alem! Once you've got things down, I can start teaching you the formal courses!",
            "nextDialogs": [
              "250300703"
            ]
          },
          "250300703": {
            "id": "250300703",
            "speakerId": 1000,
            "speakerName": "Akeor",
            "text": "Tahmures has specially prepared a bunch of resources for you. Once the training is over, be sure to study hard, okay?",
            "nextDialogs": [
              "250300704"
            ]
          },
          "250300704": {
            "id": "250300704",
            "speakerId": 1001,
            "speakerName": "Tahmures",
            "text": "#{NICKNAME}, you're here, and just in time! Alem, get ready to go train with your mentor, would you?"
          }
        }
      }
    },
    {
      "subId": "2503008",
      "subQuestName": "Report back to Akeor",
      "sceneId": null,
      "locations": [],

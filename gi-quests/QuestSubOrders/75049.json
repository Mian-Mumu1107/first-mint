        "startDialogs": [
          "750490401"
        ],
        "dialogs": {
          "750490401": {
            "id": "750490401",
            "speakerId": 21715,
            "speakerName": "Nightsoul Spirit",
            "text": "What, ho... To think you could find this entrance. Long has it been since any have come hither...",
            "nextDialogs": [
              "750490402"
            ]
          },
          "750490402": {
            "id": "750490402",
            "speakerId": 21715,
            "speakerName": "Nightsoul Spirit",
            "text": "This... Mm, yes, this is where the Nightsouls roam, though afeared am I that none now live on the sun-kissed earth who recall their names or deeds.",
            "nextDialogs": [
              "750490403"
            ]
          },
          "750490403": {
            "id": "750490403",
            "speakerId": 21715,
            "speakerName": "Nightsoul Spirit",
            "text": "Ah, Nightsouls... While our mistress slumbers, we are her dreams. When our goddess awakens ever and anon, we are but single strains of her mind.",
            "nextDialogs": [
              "750490404"
            ]
          },
          "750490404": {
            "id": "750490404",
            "speakerId": 21715,
            "speakerName": "Nightsoul Spirit",
            "text": "That a living person should set foot here... Haha, those overcome by their battle-craving can hold back no longer... Outlander warrior, you who are much beloved...",
            "nextDialogs": [
              "750490405"
            ]
          },
          "750490405": {
            "id": "750490405",
            "speakerId": 21715,
            "speakerName": "Nightsoul Spirit",
            "text": "Still these unquiet souls to slumber soundly with the blaze of battle and triumph, and be rewarded... What say you?"
          }
        }
      }
    },
    {
      "subId": "7504905",
      "subQuestName": "Additional",

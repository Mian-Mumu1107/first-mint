    {
      "subId": "4007412",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400741201"
        ],
        "dialogs": {
          "400741201": {
            "id": "400741201",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "Lady Megistus... this is heartbreaking.",
            "nextDialogs": [
              "400741202"
            ]
          },
          "400741202": {
            "id": "400741202",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Ugh, please don't try to comfort me. It'll only make me feel embarrassed...",
            "nextDialogs": [
              "400741203"
            ]
          },
          "400741203": {
            "id": "400741203",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "C'mon, you don't need to pretend in front of us! Need a hug?",
            "nextDialogs": [
              "400741204"
            ]
          },
          "400741204": {
            "id": "400741204",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "N—No!",
            "nextDialogs": [
              "400741205"
            ]
          },
          "400741205": {
            "id": "400741205",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "That was really how I felt back when I first started out in astrology but...",
            "nextDialogs": [
              "400741206"
            ]
          },
          "400741206": {
            "id": "400741206",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "I've matured now. I'm no longer so easily swayed by random people's opinions.",
            "nextDialogs": [
              "400741207"
            ]
          },
          "400741207": {
            "id": "400741207",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Who would've thought! Even Megistus the Court Archmage was not spared of vexatious times in her career.",
            "nextDialogs": [
              "400741208"
            ]
          },
          "400741208": {
            "id": "400741208",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "It must have been difficult to be misunderstood by others... I'm glad that you were able to move past that.",
            "nextDialogs": [
              "400741209"
            ]
          },
          "400741209": {
            "id": "400741209",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Actually, there are many who have given up astrology due to similar circumstances.",
            "nextDialogs": [
              "400741210"
            ]
          },
          "400741210": {
            "id": "400741210",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "But, I am a genius, so it's only fair that I'm able to accomplish what others cannot.",
            "nextDialogs": [
              "400741211"
            ]
          },
          "400741211": {
            "id": "400741211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's pretty inspiring to hear you say all that in an amazing place like this!",
            "nextDialogs": [
              "400741214"
            ]
          },
          "400741214": {
            "id": "400741214",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Yes, good, keep going.",
            "nextDialogs": [
              "400741215"
            ]
          },
          "400741215": {
            "id": "400741215",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "Ahem... sorry to interrupt, but the door is that way.",
            "nextDialogs": [
              "400741216"
            ]
          },
          "400741216": {
            "id": "400741216",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Alright, I'll let you shower me with praise after all the mysteries are solved."
          }
        }
      }
    },
    {
      "subId": "4007414",

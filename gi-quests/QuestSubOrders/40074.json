    {
      "subId": "4007409",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400740901"
        ],
        "dialogs": {
          "400740901": {
            "id": "400740901",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "The surroundings appear to have changed. This isn't the beach we originally left.",
            "nextDialogs": [
              "400740902"
            ]
          },
          "400740902": {
            "id": "400740902",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "The area appears to be the mountains of Mondstadt. Wait, have we been sent back to Mondstadt?",
            "nextDialogs": [
              "400740903"
            ]
          },
          "400740903": {
            "id": "400740903",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Yet the boundless ocean still surrounds us.",
            "nextDialogs": [
              "400740904"
            ]
          },
          "400740904": {
            "id": "400740904",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "There should be another pool around here for us to enter.",
            "nextDialogs": [
              "400740905"
            ]
          },
          "400740905": {
            "id": "400740905",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Over here, y'all!",
            "nextDialogs": [
              "400740906"
            ]
          },
          "400740906": {
            "id": "400740906",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Hmm? Why isn't it letting us enter?",
            "nextDialogs": [
              "400740907"
            ]
          },
          "400740907": {
            "id": "400740907",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, something seems to be floating on the water there...",
            "nextDialogs": [
              "400740908"
            ]
          },
          "400740908": {
            "id": "400740908",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Uh... is it a painting? Or what is it...?",
            "nextDialogs": [
              "400740909"
            ]
          },
          "400740909": {
            "id": "400740909",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "It seems to be hinting at a specific place.",
            "nextDialogs": [
              "400740910"
            ]
          },
          "400740910": {
            "id": "400740910",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "It is anticipating that the Prinzessin would guide her loyal followers to the location that has been chosen by fate.",
            "nextDialogs": [
              "400740911"
            ]
          },
          "400740911": {
            "id": "400740911",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Why is it always you that has to take the lead... Ugh whatever, it doesn't matter. Let's just find this place first."
          }
        }
      }
    },
    {
      "subId": "4007499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400749902"
        ],
        "dialogs": {
          "400749902": {
            "id": "400749902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm? There's a star over there...",
            "nextDialogs": [
              "400749903"
            ]
          },
          "400749903": {
            "id": "400749903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And now it's gone! Let's follow it!",
            "nextDialogs": [
              "400749904"
            ]
          },
          "400749904": {
            "id": "400749904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It made its way inside!"
          }
        }
      }
    }
  ]
}
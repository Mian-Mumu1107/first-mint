    {
      "subId": "4007411",
      "subQuestName": "Rendezvous with everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400741101"
        ],
        "dialogs": {
          "400741101": {
            "id": "400741101",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Everyone, over here!",
            "nextDialogs": [
              "400741102"
            ]
          },
          "400741102": {
            "id": "400741102",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "Is everyone awake now? Mona says that she has something important to tell everyone.",
            "nextDialogs": [
              "400741103"
            ]
          },
          "400741103": {
            "id": "400741103",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "The first glimmering daybreak after the return of the Immernachtreich most certainly revitalizes one's innermost spirits.",
            "nextDialogs": [
              "400741104"
            ]
          },
          "400741104": {
            "id": "400741104",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "What mein Fräulein means is that she is ready to take on the next challenge.",
            "nextDialogs": [
              "400741105"
            ]
          },
          "400741105": {
            "id": "400741105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, we're rested and ready too!",
            "nextDialogs": [
              "400741106"
            ]
          },
          "400741106": {
            "id": "400741106",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Alright. Then I'll get to the crux of the matter.",
            "nextDialogs": [
              "400741107"
            ]
          },
          "400741107": {
            "id": "400741107",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "I just peeked into my scryglass, and there's a new mirage forming on the island over there.",
            "nextDialogs": [
              "400741108"
            ]
          },
          "400741108": {
            "id": "400741108",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "And... I have a feeling that this one is my mirage.",
            "nextDialogs": [
              "400741109"
            ]
          },
          "400741109": {
            "id": "400741109",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Oh, so now it's Mona's turn. You were with us for all of ours, seems like it's time for us to go with you into yours!",
            "nextDialogs": [
              "400741110"
            ]
          },
          "400741110": {
            "id": "400741110",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Ugh... well, I'm sure there's nothing to see, really.",
            "nextDialogs": [
              "400741111"
            ]
          },
          "400741111": {
            "id": "400741111",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "Lady Megistus, are you embarrassed?",
            "nextDialogs": [
              "400741112"
            ]
          },
          "400741112": {
            "id": "400741112",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "No, absolutely not! Haha... It's not like I'm worried about everyone judging me after seeing my embarrassingly pathetic mirage or anything...",
            "nextDialogs": [
              "400741113"
            ]
          },
          "400741113": {
            "id": "400741113",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "This emphatic \"no\" sounds rather like a thinly disguised \"yes\"...",
            "nextDialogs": [
              "400741114"
            ]
          },
          "400741114": {
            "id": "400741114",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Well... *ahem* Astrologists are often regarded as something out of this world, right? But what if my mirage is nothing like that...?",
            "nextDialogs": [
              "400741115"
            ]
          },
          "400741115": {
            "id": "400741115",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Fret not. Your Prinzessin is not so foolish as to entertain preconceived notions on how thy mirage should or should not present itself.",
            "nextDialogs": [
              "400741116"
            ]
          },
          "400741116": {
            "id": "400741116",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Yeah, me neither! Not that I have low expectations of you, Mona, but personally, I think you're a kind soul, and you shouldn't feel like you have to live up to anything more than that.",
            "nextDialogs": [
              "400741117"
            ]
          },
          "400741117": {
            "id": "400741117",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "I'm sure Mona's mirage will stay true to her kind heart.",
            "nextDialogs": [
              "400741118"
            ]
          },
          "400741118": {
            "id": "400741118",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, and it's not like we're going in there just to do some sightseeing. There's other reasons, too, right?",
            "nextDialogs": [
              "400741121"
            ]
          },
          "400741121": {
            "id": "400741121",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "...Really? Well, okay then.",
            "nextDialogs": [
              "400741122"
            ]
          },
          "400741122": {
            "id": "400741122",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "I suppose I'm not worried as long as everyone doesn't get too excited. Alright then, let's get going."
          }
        }
      }
    },
    {
      "subId": "4007402",
      "subQuestName": "Head to Minacious Isle",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400740201"
        ],
        "dialogs": {
          "400740201": {
            "id": "400740201",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "According to my scryglass, we've arrived at the mirage. Okay, let's find the entrance first...",
            "nextDialogs": [
              "400740202"
            ]
          },
          "400740202": {
            "id": "400740202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is that it, over there?",
            "nextDialogs": [
              "400740203"
            ]
          },
          "400740203": {
            "id": "400740203",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Huh, this looks like some kind of pool.",
            "nextDialogs": [
              "400740204"
            ]
          },
          "400740204": {
            "id": "400740204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, we're not gonna have to swim to get in, are we?",
            "nextDialogs": [
              "400740205"
            ]
          },
          "400740205": {
            "id": "400740205",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "...",
            "nextDialogs": [
              "400740206"
            ]
          },
          "400740206": {
            "id": "400740206",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Wait, do we have a non-swimmer among us?",
            "nextDialogs": [
              "400740207"
            ]
          },
          "400740207": {
            "id": "400740207",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "No, I don't think that's the real problem here...",
            "nextDialogs": [
              "400740208"
            ]
          },
          "400740208": {
            "id": "400740208",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Ahaha, someone's scared, huh? Well, then, I'll go first.",
            "nextDialogs": [
              "400740209"
            ]
          },
          "400740209": {
            "id": "400740209",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "And there she goes! She's gonna show off her oh-so-perfect swimming skills now!",
            "nextDialogs": [
              "400740210"
            ]
          },
          "400740210": {
            "id": "400740210",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "Ahem! Please be mindful of your wording, mein Fräulein.",
            "nextDialogs": [
              "400740211"
            ]
          },
          "400740211": {
            "id": "400740211",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Ohh! Right!",
            "nextDialogs": [
              "400740212"
            ]
          },
          "400740212": {
            "id": "400740212",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "See you later!",
            "nextDialogs": [
              "400740213"
            ]
          },
          "400740213": {
            "id": "400740213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, Mona dived right into the pool and disappeared! Let's catch up with her!"
          }
        }
      }
    },
    {
      "subId": "4007403",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400740301"
        ],
        "dialogs": {
          "400740301": {
            "id": "400740301",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "What a spectacular structure...",
            "nextDialogs": [
              "400740302"
            ]
          },
          "400740302": {
            "id": "400740302",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Wow, I've never seen anything like this...",
            "nextDialogs": [
              "400740303"
            ]
          },
          "400740303": {
            "id": "400740303",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Hey, uh Mona, your mirage is amazing!",
            "nextDialogs": [
              "400740304"
            ]
          },
          "400740304": {
            "id": "400740304",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Though it falls short of the glorious Immernachtreich, one must admit that it is an impressive realm nonetheless, Lady Megistus.",
            "nextDialogs": [
              "400740305"
            ]
          },
          "400740305": {
            "id": "400740305",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "(Whew, at least it's not showing me getting lectured by the old hag. Thank goodness...)",
            "nextDialogs": [
              "400740306"
            ]
          },
          "400740306": {
            "id": "400740306",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Well, what else would you expect of a genius astrologist's mirage?",
            "nextDialogs": [
              "400740307"
            ]
          },
          "400740307": {
            "id": "400740307",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Okay, let's get started."
          }
        }
      }
    },

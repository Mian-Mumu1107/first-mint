    {
      "subId": "1204602",
      "subQuestName": "Go to the Aisa Bathhouse",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120460201"
        ],
        "dialogs": {
          "120460201": {
            "id": "120460201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Mizuki, we're here to book our next therapy appointment...",
            "nextDialogs": [
              "120460202"
            ]
          },
          "120460202": {
            "id": "120460202",
            "speakerId": 3210,
            "speakerName": "Hyakujitsuhaku Shion",
            "text": "Ugh...",
            "nextDialogs": [
              "120460203"
            ]
          },
          "120460203": {
            "id": "120460203",
            "speakerId": 3211,
            "speakerName": "Shiba Murasaki",
            "text": "Agh... It hurts...",
            "nextDialogs": [
              "120460204"
            ]
          },
          "120460204": {
            "id": "120460204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no... What's wrong with them?",
            "nextDialogs": [
              "120460205"
            ]
          },
          "120460205": {
            "id": "120460205",
            "speakerId": 3038,
            "speakerName": "Aikawa Susumu",
            "text": "They've been like this ever since they woke up...",
            "nextDialogs": [
              "120460206"
            ]
          },
          "120460206": {
            "id": "120460206",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "...It's an extreme case of indigestion.",
            "nextDialogs": [
              "120460207"
            ]
          },
          "120460207": {
            "id": "120460207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? How come? Did they eat too many nightmares last night?",
            "nextDialogs": [
              "120460208"
            ]
          },
          "120460208": {
            "id": "120460208",
            "speakerId": 3038,
            "speakerName": "Aikawa Susumu",
            "text": "I doubt it... We only had four customers yesterday, including you two.",
            "nextDialogs": [
              "120460209"
            ]
          },
          "120460209": {
            "id": "120460209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon blames the other two...",
            "nextDialogs": [
              "120460210"
            ]
          },
          "120460210": {
            "id": "120460210",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "You're right. Something's definitely wrong with their nightmares... Our ability to digest dreams isn't just a matter of quantity. It depends on the emotional intensity, too.",
            "nextDialogs": [
              "120460211"
            ]
          },
          "120460211": {
            "id": "120460211",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Point being, no normal person should ever have a nightmare of this magnitude...",
            "nextDialogs": [
              "120460212"
            ]
          },
          "120460212": {
            "id": "120460212",
            "speakerId": 3210,
            "speakerName": "Hyakujitsuhaku Shion",
            "text": "*retching*",
            "nextDialogs": [
              "120460213"
            ]
          },
          "120460213": {
            "id": "120460213",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "The situation is dire. If I can't find a way to help them digest the dreams soon...",
            "nextDialogs": [
              "120460214"
            ]
          },
          "120460214": {
            "id": "120460214",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What can we do? Let us help!",
            "nextDialogs": [
              "120460215"
            ]
          },
          "120460215": {
            "id": "120460215",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "We need to find those two customers from yesterday, and figure out the cause of their bad dreams. Without knowing that, I have no way of treating them.",
            "nextDialogs": [
              "120460216"
            ]
          },
          "120460216": {
            "id": "120460216",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "#{NICKNAME}, Paimon, I know you spoke to them both. Think you can track them down?",
            "nextDialogs": [
              "120460217"
            ]
          },
          "120460217": {
            "id": "120460217",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's see... Hmm, they did say they were gonna get counselling from Emura Ichigensai again. Chances are, that's where we'll find them!",
            "nextDialogs": [
              "120460218"
            ]
          },
          "120460218": {
            "id": "120460218",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Lead the way. I'm coming with you."
          }
        }
      }
    },
    {
      "subId": "1204603",
      "subQuestName": "Go to Emura Ichigensai's place of business",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120460301"
        ],
        "dialogs": {
          "120460301": {
            "id": "120460301",
            "speakerId": 15038,
            "speakerName": "Umihiko",
            "text": "Y'know, I went out to sea earlier today, but was so distracted that I lost my net... Ah well, it's not a big deal though.",
            "nextDialogs": [
              "120460302"
            ]
          },
          "120460302": {
            "id": "120460302",
            "speakerId": 15037,
            "speakerName": "Susukida",
            "text": "Yeah, I messed up today too... but hey, what's the big deal? A few bandits got away, it's not the end of the world, hahaha...",
            "nextDialogs": [
              "120460303"
            ]
          },
          "120460303": {
            "id": "120460303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, you two! Murasaki and Shion are sick, and it's all because of your bad dreams!",
            "nextDialogs": [
              "120460304"
            ]
          },
          "120460304": {
            "id": "120460304",
            "speakerId": 15037,
            "speakerName": "Susukida",
            "text": "Whoa, someone's in a bad mood, huh? So funny, haha...",
            "nextDialogs": [
              "120460305"
            ]
          },
          "120460305": {
            "id": "120460305",
            "speakerId": 15038,
            "speakerName": "Umihiko",
            "text": "I know, right? Hehehe...",
            "nextDialogs": [
              "120460306"
            ]
          },
          "120460306": {
            "id": "120460306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um...",
            "nextDialogs": [
              "120460307"
            ]
          },
          "120460307": {
            "id": "120460307",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "What's wrong?",
            "nextDialogs": [
              "120460308"
            ]
          },
          "120460308": {
            "id": "120460308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They're acting so weird! Paimon was pretty aggressive just now, but they don't seem offended at all...",
            "nextDialogs": [
              "120460309"
            ]
          },
          "120460309": {
            "id": "120460309",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "...Allow me. Gentlemen, do you still remember visiting Aisa Bathhouse last night for dream regulation therapy?",
            "nextDialogs": [
              "120460310"
            ]
          },
          "120460310": {
            "id": "120460310",
            "speakerId": 15038,
            "speakerName": "Umihiko",
            "text": "Did we?",
            "nextDialogs": [
              "120460311"
            ]
          },
          "120460311": {
            "id": "120460311",
            "speakerId": 15037,
            "speakerName": "Susukida",
            "text": "I don't think so...?",
            "nextDialogs": [
              "120460312"
            ]
          },
          "120460312": {
            "id": "120460312",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Huh... Do you recall having any bad dreams recently?",
            "nextDialogs": [
              "120460313"
            ]
          },
          "120460313": {
            "id": "120460313",
            "speakerId": 15037,
            "speakerName": "Susukida",
            "text": "No, why would I? What in this world could be so bad that it'd give me nightmares?",
            "nextDialogs": [
              "120460314"
            ]
          },
          "120460314": {
            "id": "120460314",
            "speakerId": 15038,
            "speakerName": "Umihiko",
            "text": "Hmm... Nope, nothing comes to mind. Bad dreams must be highly irregular, surely? You don't have to look far to see that life is beautiful.",
            "nextDialogs": [
              "120460315"
            ]
          },
          "120460315": {
            "id": "120460315",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What is going on? It's like they've completely forgotten what they did last night.",
            "nextDialogs": [
              "120460316"
            ]
          },
          "120460316": {
            "id": "120460316",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Although, Paimon can believe what they're saying. They don't exactly seem troubled by nightmares... Does that mean Emura Ichigensai's counselling actually works?",
            "nextDialogs": [
              "120460317"
            ]
          },
          "120460317": {
            "id": "120460317",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "#No, they're clearly not in their right minds... {NICKNAME}, Paimon, focus hard for a second. I'm gonna try something a little unorthodox...",
            "nextDialogs": [
              "120460318"
            ]
          },
          "120460318": {
            "id": "120460318",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, what did you do...?",
            "nextDialogs": [
              "120460319"
            ]
          },
          "120460319": {
            "id": "120460319",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Entered their subconscious minds. I noticed they've both become disassociated from their subconscious, meaning I can access it — similarly to how I enter people's dreams.",
            "nextDialogs": [
              "120460320"
            ]
          },
          "120460320": {
            "id": "120460320",
            "speakerId": 15037,
            "speakerName": "Susukida",
            "text": "No, nooo! Those thugs, I won't let them get away with this! I won't!!!",
            "nextDialogs": [
              "120460321"
            ]
          },
          "120460321": {
            "id": "120460321",
            "speakerId": 15038,
            "speakerName": "Umihiko",
            "text": "The sea's too rough today... I should stay on dry land till things calm down.",
            "nextDialogs": [
              "120460322"
            ]
          },
          "120460322": {
            "id": "120460322",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh!?",
            "nextDialogs": [
              "120460323"
            ]
          },
          "120460323": {
            "id": "120460323",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "As you can see, their troubles haven't gone anywhere.",
            "nextDialogs": [
              "120460324"
            ]
          },
          "120460324": {
            "id": "120460324",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Susukida seems to have a short fuse, which causes him to act out of line. I'm sure this has caused him a lot of grief in his line of work.",
            "nextDialogs": [
              "120460325"
            ]
          },
          "120460325": {
            "id": "120460325",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "As for Umihiko... I believe he developed a fear of stormy waves after a near-death experience. Now, he's reluctant to sail out to sea at all, which is having a devastating impact on his livelihood.",
            "nextDialogs": [
              "120460326"
            ]
          },
          "120460326": {
            "id": "120460326",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Their negative emotions have been isolated from their conscious minds and left to float around in their subconscious. That's why on the outside, the only emotion they appear to feel is happiness.",
            "nextDialogs": [
              "120460327"
            ]
          },
          "120460327": {
            "id": "120460327",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "But those suppressed emotions will only continue to fester in their subconscious, eventually turning into the nightmares that have been giving Murasaki and Shion indigestion.",
            "nextDialogs": [
              "120460328"
            ]
          },
          "120460328": {
            "id": "120460328",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How did this happen?",
            "nextDialogs": [
              "120460329"
            ]
          },
          "120460329": {
            "id": "120460329",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "...If it's Emura Ichigensai's doing, I guess he's not the straightforward conman we thought he was. Maybe he really does have ways of influencing human emotions. That would explain why no one has blown the whistle on him yet...",
            "nextDialogs": [
              "120460330"
            ]
          },
          "120460330": {
            "id": "120460330",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Did you notice anything strange when you came here yesterday?",
            "nextDialogs": [
              "120460331"
            ]
          },
          "120460331": {
            "id": "120460331",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Not really. They were a lot more serious than today...",
            "nextDialogs": [
              "120460332"
            ]
          },
          "120460332": {
            "id": "120460332",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Actually, since you ask...",
            "nextDialogs": [
              "120460333"
            ]
          },
          "120460333": {
            "id": "120460333",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "You remember the strange dream from yesterday, and recount it to Mizuki.",
            "nextDialogs": [
              "120460334"
            ]
          },
          "120460334": {
            "id": "120460334",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You sure kept that one quiet!",
            "nextDialogs": [
              "120460335"
            ]
          },
          "120460335": {
            "id": "120460335",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I didn't think much of it at the time.",
            "nextDialogs": [
              "120460336"
            ]
          },
          "120460336": {
            "id": "120460336",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Oh, no no no... Look, we have to find this Emura Ichigensai right away!",
            "nextDialogs": [
              "120460337"
            ]
          },
          "120460337": {
            "id": "120460337",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Mizuki... What is it?",
            "nextDialogs": [
              "120460338"
            ]
          },
          "120460338": {
            "id": "120460338",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "#Something inhuman is at work in Emura Ichigensai. {NICKNAME}'s dream confirms that... He has victimized everyone who has received his so-called counselling.",
            "nextDialogs": [
              "120460339"
            ]
          },
          "120460339": {
            "id": "120460339",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "If we don't find and stop him as soon as possible, his victims may well suffer irreversible damage to their psyches.",
            "nextDialogs": [
              "120460340"
            ]
          },
          "120460340": {
            "id": "120460340",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yikes... Well, guess we'd better press these guys a little harder. Do you know when Emura Ichigensai will be here next?",
            "nextDialogs": [
              "120460341"
            ]
          },
          "120460341": {
            "id": "120460341",
            "speakerId": 15037,
            "speakerName": "Susukida",
            "text": "What's with the urgency? Why does it matter when he shows up?",
            "nextDialogs": [
              "120460342"
            ]
          },
          "120460342": {
            "id": "120460342",
            "speakerId": 15038,
            "speakerName": "Umihiko",
            "text": "Yeah, he'll turn up when he's ready. No point trying to rush him, heh...",
            "nextDialogs": [
              "120460343"
            ]
          },
          "120460343": {
            "id": "120460343",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, this is infuriating!",
            "nextDialogs": [
              "120460344"
            ]
          },
          "120460344": {
            "id": "120460344",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "...You do remember what happened last night. Both of you.",
            "nextDialogs": [
              "120460345"
            ]
          },
          "120460345": {
            "id": "120460345",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Only, you don't want to talk about it, because you can't reconcile the presence of a nightmare with the happiness you presently feel.",
            "nextDialogs": [
              "120460346"
            ]
          },
          "120460346": {
            "id": "120460346",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Just thinking about it brings up an overwhelming sense of being torn apart. You can't quite put it into words, but you fear you're a hair's breadth away from a total breakdown... Is that about right?",
            "nextDialogs": [
              "120460347"
            ]
          },
          "120460347": {
            "id": "120460347",
            "speakerId": 15038,
            "speakerName": "Umihiko",
            "text": "...Please, stop. Everything will be fine as long as we don't think about it...",
            "nextDialogs": [
              "120460348"
            ]
          },
          "120460348": {
            "id": "120460348",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Emura Ichigensai's treatment has clearly left you wounded and vulnerable. But don't worry — I'm not here to snap you out of your denial.",
            "nextDialogs": [
              "120460349"
            ]
          },
          "120460349": {
            "id": "120460349",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "...At least, as long as you answer our question.",
            "nextDialogs": [
              "120460350"
            ]
          },
          "120460350": {
            "id": "120460350",
            "speakerId": 15037,
            "speakerName": "Susukida",
            "text": "Alright... But seriously, we really have no idea. We've asked already, and all we know is that he's not coming today.",
            "nextDialogs": [
              "120460351"
            ]
          },
          "120460351": {
            "id": "120460351",
            "speakerId": 15038,
            "speakerName": "Umihiko",
            "text": "Yeah, uh... apparently yesterday's session kind of... tired him out.",
            "nextDialogs": [
              "120460352"
            ]
          },
          "120460352": {
            "id": "120460352",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Is he trying to hide from me again?",
            "nextDialogs": [
              "120460353"
            ]
          },
          "120460353": {
            "id": "120460353",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They really don't know anything? Darn. Looks like we've hit a dead end...",
            "nextDialogs": [
              "120460354"
            ]
          },
          "120460354": {
            "id": "120460354",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "I don't suppose you know where he lives, do you?",
            "nextDialogs": [
              "120460355"
            ]
          },
          "120460355": {
            "id": "120460355",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No. We did ask yesterday, but even his guard didn't know.",
            "nextDialogs": [
              "120460356"
            ]
          },
          "120460356": {
            "id": "120460356",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "In that case...",
            "nextDialogs": [
              "120460359"
            ]
          },
          "120460359": {
            "id": "120460359",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Yes, I suppose... Now that I know what's causing their bad dreams, I can administer the correct treatment..."
          }
        }
      }
    },
    {
      "subId": "1204604",
      "subQuestName": "Go to the Grand Narukami Shrine and look for Miko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120460401"
        ],
        "dialogs": {
          "120460401": {
            "id": "120460401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "She's usually somewhere around here...",
            "nextDialogs": [
              "120460402"
            ]
          },
          "120460402": {
            "id": "120460402",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Here for a fortune slip, little ones? Or visiting a friend?",
            "nextDialogs": [
              "120460403"
            ]
          },
          "120460403": {
            "id": "120460403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa! Where did you come from...",
            "nextDialogs": [
              "120460404"
            ]
          },
          "120460404": {
            "id": "120460404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's been a while, Lady Guuji.",
            "nextDialogs": [
              "120460405"
            ]
          },
          "120460405": {
            "id": "120460405",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "That was a little lukewarm. You're starting to sound a lot like her... But pleasantries aside, what's the matter? You look rather out of sorts.",
            "nextDialogs": [
              "120460408"
            ]
          },
          "120460408": {
            "id": "120460408",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "You may remember I dropped a not-so-subtle hint as to his whereabouts yesterday. You mean to tell me you still haven't found him?",
            "nextDialogs": [
              "120460409"
            ]
          },
          "120460409": {
            "id": "120460409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aha, so you did bring him up on purpose!",
            "nextDialogs": [
              "120460410"
            ]
          },
          "120460410": {
            "id": "120460410",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "...Let's not lose focus here. You're here to ask for my help. So, would you mind explaining the situation to me?",
            "nextDialogs": [
              "120460411"
            ]
          },
          "120460411": {
            "id": "120460411",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, fair enough... We went to the place you mentioned, but he slipped through our fingers.",
            "nextDialogs": [
              "120460412"
            ]
          },
          "120460412": {
            "id": "120460412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Next thing we heard was, he's not seeing patients there anymore — apparently, he loves his peace and solitude... So obviously, we've got no idea where to find him now...",
            "nextDialogs": [
              "120460413"
            ]
          },
          "120460413": {
            "id": "120460413",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "*sigh* And after the lengths I went to to get you that location...",
            "nextDialogs": [
              "120460414"
            ]
          },
          "120460414": {
            "id": "120460414",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Dunno if this helps, but we did learn some other stuff about him yesterday. For example, a guy matching Emura Ichigensai's description came to Mizuki for therapy once — only his name was \"Emura Chuuya.\"",
            "nextDialogs": [
              "120460415"
            ]
          },
          "120460415": {
            "id": "120460415",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Wait, what? Emura Chuuya?",
            "nextDialogs": [
              "120460416"
            ]
          },
          "120460416": {
            "id": "120460416",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You know him?",
            "nextDialogs": [
              "120460417"
            ]
          },
          "120460417": {
            "id": "120460417",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "I once asked the Yae Publishing House to host an event for contributors to the readers' letters column. I had hoped it might be a fun chance to meet some like-minded people and chat... until he showed up.",
            "nextDialogs": [
              "120460418"
            ]
          },
          "120460418": {
            "id": "120460418",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Are you telling me that Emura the hell-raiser and Emura the healer are the same person?",
            "nextDialogs": [
              "120460419"
            ]
          },
          "120460419": {
            "id": "120460419",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Based on everything we've learned so far, it certainly looks that way.",
            "nextDialogs": [
              "120460420"
            ]
          },
          "120460420": {
            "id": "120460420",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Alright. Well, in that case... give this address a try.",
            "nextDialogs": [
              "120460421"
            ]
          },
          "120460421": {
            "id": "120460421",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh... Really? Who chooses to live in a place like that?",
            "nextDialogs": [
              "120460422"
            ]
          },
          "120460422": {
            "id": "120460422",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "This was the delivery address he gave to the Yae Publishing House once, when he placed an order for several dozen books in one go. He also requested to pay on receipt.",
            "nextDialogs": [
              "120460423"
            ]
          },
          "120460423": {
            "id": "120460423",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "The warehouse took one look and assumed it must be some kind of prank, so they rejected the order... Earning them an honorable mention in his complaint letter.",
            "nextDialogs": [
              "120460424"
            ]
          },
          "120460424": {
            "id": "120460424",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Of course, with the benefit of hindsight, it's rather obvious why he lives there. Someone as antisocial as him wouldn't be welcome anywhere else.",
            "nextDialogs": [
              "120460425"
            ]
          },
          "120460425": {
            "id": "120460425",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You've got a point... Well, we clearly made the right decision coming to talk to you!",
            "nextDialogs": [
              "120460426"
            ]
          },
          "120460426": {
            "id": "120460426",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "I'm just glad I could help my old friend.",
            "nextDialogs": [
              "120460427"
            ]
          },
          "120460427": {
            "id": "120460427",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You mean Mizuki? So, you really do want to help her?",
            "nextDialogs": [
              "120460428"
            ]
          },
          "120460428": {
            "id": "120460428",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "I can tell that she's invested an awful lot into the Aisa Bathhouse. It's only natural for me to show some concern when I see a friend's business in trouble.",
            "nextDialogs": [
              "120460429"
            ]
          },
          "120460429": {
            "id": "120460429",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really? 'Cause yesterday, it looked more like you were looking for a fight...",
            "nextDialogs": [
              "120460430"
            ]
          },
          "120460430": {
            "id": "120460430",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "I assume Mizuki has told you that we're competitors?",
            "nextDialogs": [
              "120460431"
            ]
          },
          "120460431": {
            "id": "120460431",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "She has always believed that, ever since we were classmates. And now that I'm the Guuji of the Grand Narukami Shrine, I'm sure she must feel the need to prove herself through her endeavors at the Aisa Bathhouse.",
            "nextDialogs": [
              "120460432"
            ]
          },
          "120460432": {
            "id": "120460432",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "The last thing she'd want is for me of all people to swoop in and save the day the moment the going gets tough... So if I want to help, I have to be mindful of her feelings and tread delicately.",
            "nextDialogs": [
              "120460433"
            ]
          },
          "120460433": {
            "id": "120460433",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's rare to see you being so considerate...",
            "nextDialogs": [
              "120460434"
            ]
          },
          "120460434": {
            "id": "120460434",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "I'll take that as a compliment. Mizuki's always so considerate towards others — it would be nice for someone to reciprocate once in a while."
          }
        }
      }
    },

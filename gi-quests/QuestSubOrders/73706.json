  "subQuests": [
    {
      "subId": "7370601",
      "subQuestName": "Talk to Collei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "737060101"
        ],
        "dialogs": {
          "737060101": {
            "id": "737060101",
            "speakerId": 1000,
            "speakerName": "Collei",
            "text": "Good news, everyone!",
            "nextDialogs": [
              "737060102"
            ]
          },
          "737060102": {
            "id": "737060102",
            "speakerId": 1000,
            "speakerName": "Collei",
            "text": "The Fieldwise center is getting a lot of praise from important scholars all throughout the Akademiya...",
            "nextDialogs": [
              "737060103"
            ]
          },
          "737060103": {
            "id": "737060103",
            "speakerId": 1000,
            "speakerName": "Collei",
            "text": "Soon, they'll send a team of specialists to take over the management of this place based on our recommendations!",
            "nextDialogs": [
              "737060104"
            ]
          },
          "737060104": {
            "id": "737060104",
            "speakerId": 1000,
            "speakerName": "Collei",
            "text": "So, thank you for all the support!",
            "nextDialogs": [
              "737060105"
            ]
          },
          "737060105": {
            "id": "737060105",
            "speakerId": 1001,
            "speakerName": "Amber",
            "text": "Wow, sounds like your hard work paid off, Collei!",
            "nextDialogs": [
              "737060106"
            ]
          },
          "737060106": {
            "id": "737060106",
            "speakerId": 1002,
            "speakerName": "Faruzan",
            "text": "And you're overseeing the transition yourself... Well done.",
            "nextDialogs": [
              "737060107"
            ]
          },
          "737060107": {
            "id": "737060107",
            "speakerId": 1002,
            "speakerName": "Faruzan",
            "text": "The young students today could learn a thing or two from you, Collei. Your confidence, your proactiveness, your leadership... It's admirable.",
            "nextDialogs": [
              "737060108"
            ]
          },
          "737060108": {
            "id": "737060108",
            "speakerId": 1002,
            "speakerName": "Faruzan",
            "text": "Not like some of the ones I teach, so focused on theses and research, with no practical skills to speak of.",
            "nextDialogs": [
              "737060109"
            ]
          },
          "737060109": {
            "id": "737060109",
            "speakerId": 1000,
            "speakerName": "Collei",
            "text": "T—To be honest, I don't feel all that confident. Being the go-between for all the different Darshans, coordinating everything... I still can't quite believe I managed it.",
            "nextDialogs": [
              "737060110"
            ]
          },
          "737060110": {
            "id": "737060110",
            "speakerId": 1000,
            "speakerName": "Collei",
            "text": "#Oh, but {NICKNAME} and Paimon played a huge role in that too. I can't thank you both enough...",
            "nextDialogs": [
              "737060113"
            ]
          },
          "737060113": {
            "id": "737060113",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Yeah, we're used to this kinda work. So, for us, this was more like... a super special camping trip with friends!",
            "nextDialogs": [
              "737060114"
            ]
          },
          "737060114": {
            "id": "737060114",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Y'know, a few puzzles here, a little exercise there... It was super fun! Pretty much a piece of cake!",
            "nextDialogs": [
              "737060115"
            ]
          },
          "737060115": {
            "id": "737060115",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Aw, man... Now Paimon's hungry...",
            "nextDialogs": [
              "737060116"
            ]
          },
          "737060116": {
            "id": "737060116",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Hey, now that we're all done, why don't we go get some food to celebrate?",
            "nextDialogs": [
              "737060117"
            ]
          },
          "737060117": {
            "id": "737060117",
            "speakerId": 1004,
            "speakerName": "Dehya",
            "text": "Hah, Candace and I are two steps ahead of you!",
            "nextDialogs": [
              "737060118"
            ]
          },
          "737060118": {
            "id": "737060118",
            "speakerId": 1005,
            "speakerName": "Candace",
            "text": "This way, everyone.",
            "nextDialogs": [
              "737060119"
            ]
          },
          "737060119": {
            "id": "737060119",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Woohoo! A feast!",
            "nextDialogs": [
              "737060120"
            ]
          },
          "737060120": {
            "id": "737060120",
            "speakerId": 1001,
            "speakerName": "Amber",
            "text": "Mm! Perfect timing!",
            "nextDialogs": [
              "737060121"
            ]
          },
          "737060121": {
            "id": "737060121",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Aww, it's been a while since we've had such a delicious spread of dishes from Sumeru... Paimon feels like she could eat twice as much... No, three times as much as normal!"
          }
        }
      }
    }
  ]

    {
      "subId": "7334806",
      "subQuestName": "Search for the Purbiruni scholar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733480901"
        ],
        "dialogs": {
          "733480901": {
            "id": "733480901",
            "speakerId": 4002,
            "speakerName": "Iris",
            "text": "*sigh* This paltry funding is by no means enough for my research...",
            "nextDialogs": [
              "733480904"
            ]
          },
          "733480904": {
            "id": "733480904",
            "speakerId": 4002,
            "speakerName": "Iris",
            "text": "A Purbiruni researcher? Right, you must be looking for Sadife. A guest for him... Quite unusual.",
            "nextDialogs": [
              "733480905"
            ]
          },
          "733480905": {
            "id": "733480905",
            "speakerId": 4002,
            "speakerName": "Iris",
            "text": "He's been back taking care of things at the Akademiya lately, and should be nearby... What's the matter?",
            "nextDialogs": [
              "733480906"
            ]
          },
          "733480906": {
            "id": "733480906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Khedive's recommendation letter...",
            "nextDialogs": [
              "733480907"
            ]
          },
          "733480907": {
            "id": "733480907",
            "speakerId": 4002,
            "speakerName": "Iris",
            "text": "Khedive? So his research has wrapped up? Being rich must be nice, having a whole observation team supporting him...",
            "nextDialogs": [
              "733480908"
            ]
          },
          "733480908": {
            "id": "733480908",
            "speakerId": 4002,
            "speakerName": "Iris",
            "text": "...whereas I can't even get a subsidy for a field trip...",
            "nextDialogs": [
              "733480909"
            ]
          },
          "733480909": {
            "id": "733480909",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You know about Khedive?",
            "nextDialogs": [
              "733480910"
            ]
          },
          "733480910": {
            "id": "733480910",
            "speakerId": 4002,
            "speakerName": "Iris",
            "text": "Of course! We poor researchers, who scrounge for funding and never make any Mora, all know about his fabulous wealth.",
            "nextDialogs": [
              "733480911"
            ]
          },
          "733480911": {
            "id": "733480911",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, you mean... this Khedive... and the researchers in his family, they're all loaded!?",
            "nextDialogs": [
              "733480912"
            ]
          },
          "733480912": {
            "id": "733480912",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Does this mean we can get a big fat reward?",
            "nextDialogs": [
              "733480913"
            ]
          },
          "733480913": {
            "id": "733480913",
            "speakerId": 4002,
            "speakerName": "Iris",
            "text": "No way. Khedive is the exception. Don't go getting any unrealistic thoughts about the Purbiruni and Pursina researchers.",
            "nextDialogs": [
              "733480914"
            ]
          },
          "733480914": {
            "id": "733480914",
            "speakerId": 4002,
            "speakerName": "Iris",
            "text": "Especially those majoring in Astrology and minoring in History and Biology... In their fields, the unlucky ones can't even manage to apply for research funding.",
            "nextDialogs": [
              "733480915"
            ]
          },
          "733480915": {
            "id": "733480915",
            "speakerId": 4002,
            "speakerName": "Iris",
            "text": "Also, they always repeat something like \"Wisdom shall not be sold for gold\"...",
            "nextDialogs": [
              "733480916"
            ]
          },
          "733480916": {
            "id": "733480916",
            "speakerId": 4002,
            "speakerName": "Iris",
            "text": "*ahem* I shouldn't have said that... There's your man. Go ask him about anything else you want to know."
          }
        }
      }
    },
    {
      "subId": "7334801",
      "subQuestName": "Search for Sadife",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733480101"
        ],
        "dialogs": {
          "733480101": {
            "id": "733480101",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "But... Without those samples...",
            "nextDialogs": [
              "733480104"
            ]
          },
          "733480104": {
            "id": "733480104",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "Yes, and the current Herbad. How may I help you?",
            "nextDialogs": [
              "733480105"
            ]
          },
          "733480105": {
            "id": "733480105",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "Scholarly inquiries, perhaps? You don't look like an Akademiya researcher, though...",
            "nextDialogs": [
              "733480106"
            ]
          },
          "733480106": {
            "id": "733480106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Khedive's recommendation letter...",
            "nextDialogs": [
              "733480107"
            ]
          },
          "733480107": {
            "id": "733480107",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "Was this letter really personally written by Khedive? Wait a moment while I read it...",
            "nextDialogs": [
              "733480108"
            ]
          },
          "733480108": {
            "id": "733480108",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "Hmm, so his research at The Chasm is going well.",
            "nextDialogs": [
              "733480109"
            ]
          },
          "733480109": {
            "id": "733480109",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "...Research on Fungi... aquatic environment... fossils... unique geological features... samples...",
            "nextDialogs": [
              "733480110"
            ]
          },
          "733480110": {
            "id": "733480110",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "Nice, perfect, astounding! He is still an astute scholar and outstanding researcher, of course he didn't disappoint!",
            "nextDialogs": [
              "733480111"
            ]
          },
          "733480111": {
            "id": "733480111",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "Hmph... I hate admitting this in front of an outsider, but the researchers of Pursina are certainly gifted...",
            "nextDialogs": [
              "733480112"
            ]
          },
          "733480112": {
            "id": "733480112",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "Moreover, Khedive did emphasize your repeated and exceptional contributions in his letter.",
            "nextDialogs": [
              "733480113"
            ]
          },
          "733480113": {
            "id": "733480113",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "With your assistance, his research really was \"as smooth as a cat soaring in the air,\" wasn't it?"
          }
        }
      }
    },
    {
      "subId": "7334802",
      "subQuestName": "Find Sadife's case",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733480201"
        ],
        "dialogs": {
          "733480201": {
            "id": "733480201",
            "speakerId": 21044,
            "speakerName": "Dara",
            "text": "Whoa! Stop! Stop that! Just stop!",
            "nextDialogs": [
              "733480202"
            ]
          },
          "733480202": {
            "id": "733480202",
            "speakerId": 21044,
            "speakerName": "Dara",
            "text": "*panting* Come on, this is absolutely unnecessary. It's just a case of books, take it if you like!",
            "nextDialogs": [
              "733480205"
            ]
          },
          "733480205": {
            "id": "733480205",
            "speakerId": 21044,
            "speakerName": "Dara",
            "text": "I swear it! This is all we dug out here!",
            "nextDialogs": [
              "733480206"
            ]
          },
          "733480206": {
            "id": "733480206",
            "speakerId": 21044,
            "speakerName": "Dara",
            "text": "Other than books, we did find some bottled mud and rocks... Well, there were some nice gems, actually...",
            "nextDialogs": [
              "733480207"
            ]
          },
          "733480207": {
            "id": "733480207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did you take them?",
            "nextDialogs": [
              "733480208"
            ]
          },
          "733480208": {
            "id": "733480208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! You better give those gems back! Those are precious geological samples!",
            "nextDialogs": [
              "733480209"
            ]
          },
          "733480209": {
            "id": "733480209",
            "speakerId": 21044,
            "speakerName": "Dara",
            "text": "Geological... samples..."
          }
        }
      }
    },

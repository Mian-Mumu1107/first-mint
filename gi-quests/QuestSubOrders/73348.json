    {
      "subId": "7334805",
      "subQuestName": "Report back to Sadife",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733480301"
        ],
        "dialogs": {
          "733480301": {
            "id": "733480301",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "Traveler, you've returned! About my case...",
            "nextDialogs": [
              "733480304"
            ]
          },
          "733480304": {
            "id": "733480304",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "Excellent! Thank you so much... To think you had a recommendation letter, and yet I still made you do so much work... Please accept this payment."
          }
        }
      }
    },
    {
      "subId": "7334804",
      "subQuestName": "Report back to Khedive",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733480401"
        ],
        "dialogs": {
          "733480401": {
            "id": "733480401",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "Look who's here, eh? Did you find a Purbiruni? Not that hard, right?",
            "nextDialogs": [
              "733480404"
            ]
          },
          "733480404": {
            "id": "733480404",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "Hmm? You seem pretty hesitant. Did someone give you any trouble?",
            "nextDialogs": [
              "733480405"
            ]
          },
          "733480405": {
            "id": "733480405",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "You tell Khedive about everything that happened with Sadife...",
            "nextDialogs": [
              "733480406"
            ]
          },
          "733480406": {
            "id": "733480406",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "Ah, Sadife... He's known for his stubbornness, even his teachers can't always deal with him...",
            "nextDialogs": [
              "733480407"
            ]
          },
          "733480407": {
            "id": "733480407",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "He even turns down every single source of funding, and insists on working alone, to \"keep his research pure\"...",
            "nextDialogs": [
              "733480408"
            ]
          },
          "733480408": {
            "id": "733480408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So that's \"Wisdom shall not be sold for gold\" at work?",
            "nextDialogs": [
              "733480409"
            ]
          },
          "733480409": {
            "id": "733480409",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "Well, that's the Purbiruni rule... Haha, Pursina is much more flexible.",
            "nextDialogs": [
              "733480410"
            ]
          },
          "733480410": {
            "id": "733480410",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "Well... To be fair, it's just because I am rather well off."
          }
        }
      }
    },
    {
      "subId": "7334805",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733480501"
        ],
        "dialogs": {
          "733480501": {
            "id": "733480501",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "I'm counting on you. Your payment will be ready soon."
          }
        }
      }
    },
    {
      "subId": "7334810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733481001"
        ],
        "dialogs": {
          "733481001": {
            "id": "733481001",
            "speakerId": 1665,
            "speakerName": "Iris",
            "text": "How on earth can I get funding... Ugh..."
          }
        }
      }
    },
    {
      "subId": "7334811",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733481101"
        ],
        "dialogs": {
          "733481101": {
            "id": "733481101",
            "speakerId": 4086,
            "speakerName": "Hawa",
            "text": "I'd better get some rest. All this reading is making me dizzy..."
          }
        }
      }
    },
    {
      "subId": "7334899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733489901"
        ],
        "dialogs": {
          "733489901": {
            "id": "733489901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay, since we're already at the Akademiya... why not try looking for some of the Purbiruni mentioned by Khedive? But where should we start...",
            "nextDialogs": [
              "733489902"
            ]
          },
          "733489902": {
            "id": "733489902",
            "speakerId": 1665,
            "speakerName": "Iris",
            "text": "(No, no! I can't go back to the exchange, one more loss in futures trading and I won't even be able to afford food...)",
            "nextDialogs": [
              "733489903"
            ]
          },
          "733489903": {
            "id": "733489903",
            "speakerId": 4086,
            "speakerName": "Hawa",
            "text": "(The ancient characters... They're overlapping...)",
            "nextDialogs": [
              "733489904"
            ]
          },
          "733489904": {
            "id": "733489904",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "(Khedive... Doesn't that sound like a Pursina? How come this traveler has a hand-written letter of his?)",
            "nextDialogs": [
              "733489905"
            ]
          },
          "733489905": {
            "id": "733489905",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, this should be the place. Let's... start... digging...",
            "nextDialogs": [
              "733489906"
            ]
          },
          "733489906": {
            "id": "733489906",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "(Great! Seems relatively undamaged...)",
            "nextDialogs": [
              "733489907"
            ]
          },
          "733489907": {
            "id": "733489907",
            "speakerId": 21043,
            "speakerName": "Sadife",
            "text": "(If the samples are gone...)"
          }
        }
      }
    }
  ]
}
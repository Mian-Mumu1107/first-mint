  "subQuests": [
    {
      "subId": "7414101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741410101"
        ],
        "dialogs": {
          "741410101": {
            "id": "741410101",
            "speakerId": 1000,
            "speakerName": "Book of Revealing",
            "text": "(The content on the pages still consists of incomprehensible symbols, letters, ancient languages, and geometric figures. But a period of focus seems to gradually render their meaning comprehensible.)",
            "nextDialogs": [
              "741410102"
            ]
          },
          "741410102": {
            "id": "741410102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Canotila doesn't seem to be here. Maybe she's in that mysterious place again! Should we start meditating?",
            "nextDialogs": [
              "741410103"
            ]
          },
          "741410103": {
            "id": "741410103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Having heard what she said the last time...",
            "nextDialogs": [
              "741410104"
            ]
          },
          "741410104": {
            "id": "741410104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm a little bit concerned. I'm going to check it out.",
            "nextDialogs": [
              "741410105"
            ]
          },
          "741410105": {
            "id": "741410105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well... This is kinda unsettling, but let's go together!",
            "nextDialogs": [
              "741410106"
            ]
          },
          "741410106": {
            "id": "741410106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon, why don't you wait out here for me?",
            "nextDialogs": [
              "741410107"
            ]
          },
          "741410107": {
            "id": "741410107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What?",
            "nextDialogs": [
              "741410108"
            ]
          },
          "741410108": {
            "id": "741410108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The world in the Book of Revealing...",
            "nextDialogs": [
              "741410111"
            ]
          },
          "741410111": {
            "id": "741410111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So I don't want you to take the risk.",
            "nextDialogs": [
              "741410112"
            ]
          },
          "741410112": {
            "id": "741410112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But... we've been journeying together this whole time, haven't we? There's no hardship we can't overcome, and no enemies we can't defeat together.",
            "nextDialogs": [
              "741410113"
            ]
          },
          "741410113": {
            "id": "741410113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The dangers inside may not be something force alone can resolve.",
            "nextDialogs": [
              "741410114"
            ]
          },
          "741410114": {
            "id": "741410114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "741410115"
            ]
          },
          "741410115": {
            "id": "741410115",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, if you insist! You're smarter than Paimon, so Paimon has faith in you. Just don't abandon Paimon! Paimon will wait right here until you return!"
          }
        }
      }
    },

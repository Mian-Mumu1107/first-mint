    {
      "subId": "7414108",
      "subQuestName": "Talk to the figure",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741410801"
        ],
        "dialogs": {
          "741410801": {
            "id": "741410801",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "...",
            "nextDialogs": [
              "741410802"
            ]
          },
          "741410802": {
            "id": "741410802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Caterpillar.",
            "nextDialogs": [
              "741410803"
            ]
          },
          "741410803": {
            "id": "741410803",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "Who's there?",
            "nextDialogs": [
              "741410804"
            ]
          },
          "741410804": {
            "id": "741410804",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "...It's you. I remember you.",
            "nextDialogs": [
              "741410805"
            ]
          },
          "741410805": {
            "id": "741410805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What brings you here?",
            "nextDialogs": [
              "741410806"
            ]
          },
          "741410806": {
            "id": "741410806",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "I was just going to ask you the same thing.",
            "nextDialogs": [
              "741410807"
            ]
          },
          "741410807": {
            "id": "741410807",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "Nothing, it's just that...",
            "nextDialogs": [
              "741410808"
            ]
          },
          "741410808": {
            "id": "741410808",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "#You're {NICKNAME}, right? And... where is the little white thing that's always with you? What was her name again? Why isn't she here?",
            "nextDialogs": [
              "741410810"
            ]
          },
          "741410810": {
            "id": "741410810",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "Was that her name? Anyway, it doesn't matter. You're a good person, and so is Paimon.",
            "nextDialogs": [
              "741410812"
            ]
          },
          "741410812": {
            "id": "741410812",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "I came here to look for something important. Do you know what it is I'm looking for?",
            "nextDialogs": [
              "741410813"
            ]
          },
          "741410813": {
            "id": "741410813",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "Hmm, never mind. Forget that I asked. Why are you here, anyway? This place is very dangerous... You should turn around now. There were people who once came here for the trial, but they lost their way, and their minds turned to mush.",
            "nextDialogs": [
              "741410814"
            ]
          },
          "741410814": {
            "id": "741410814",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "Huh. I remember now. You and I... We accomplished something incredible together. The only thing in my life that I'm proud of...",
            "nextDialogs": [
              "741410815"
            ]
          },
          "741410815": {
            "id": "741410815",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You mean..."
          }
        }
      }
    },
    {
      "subId": "7414109",

    {
      "subId": "7414110",
      "subQuestName": "Talk to the figure",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741411001"
        ],
        "dialogs": {
          "741411001": {
            "id": "741411001",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "...Is that so? That makes things easier, then. What's your name?",
            "nextDialogs": [
              "741411002"
            ]
          },
          "741411002": {
            "id": "741411002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Caterpillar.",
            "nextDialogs": [
              "741411003"
            ]
          },
          "741411003": {
            "id": "741411003",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "#I didn't think I'd see you here, {NICKNAME}. Where's Paimon, though? I don't see her.",
            "nextDialogs": [
              "741411004"
            ]
          },
          "741411004": {
            "id": "741411004",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "Wait, you're not some monster who's transformed into someone I know in order to trick me, are you?",
            "nextDialogs": [
              "741411005"
            ]
          },
          "741411005": {
            "id": "741411005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We just saw each other not long ago.",
            "nextDialogs": [
              "741411006"
            ]
          },
          "741411006": {
            "id": "741411006",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "...Is that so? It feels like a long time has passed since we said farewell. Might just be my age, though, and my memory getting worse as I get older.",
            "nextDialogs": [
              "741411007"
            ]
          },
          "741411007": {
            "id": "741411007",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "...Are you sure you are not a monster?",
            "nextDialogs": [
              "741411008"
            ]
          },
          "741411008": {
            "id": "741411008",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you still remember?",
            "nextDialogs": [
              "741411011"
            ]
          },
          "741411011": {
            "id": "741411011",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "I remember, yes. Ah. It's really you.",
            "nextDialogs": [
              "741411012"
            ]
          },
          "741411012": {
            "id": "741411012",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "Sorry, I've encountered too many incredible things here, and many battles that could not be won.",
            "nextDialogs": [
              "741411013"
            ]
          },
          "741411013": {
            "id": "741411013",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "But things have finally changed here. Golden rays of light have arisen, and the sunflowers have bloomed. Even the universe the ancient ones speculated about is not immune to changes.",
            "nextDialogs": [
              "741411014"
            ]
          },
          "741411014": {
            "id": "741411014",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "Maybe things will get better. Maybe I will finally understand, and be able to let go.",
            "nextDialogs": [
              "741411015"
            ]
          },
          "741411015": {
            "id": "741411015",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Caterpillar...",
            "nextDialogs": [
              "741411016"
            ]
          },
          "741411016": {
            "id": "741411016",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Come with me.",
            "nextDialogs": [
              "741411017"
            ]
          },
          "741411017": {
            "id": "741411017",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "Haha, I suppose it really is you. I remember now... I knew you, and you haven't changed. You're always sticking your nose in someone else's business, but that's because you're kind and honest.",
            "nextDialogs": [
              "741411018"
            ]
          },
          "741411018": {
            "id": "741411018",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "But you don't have to worry about me. I don't need help — you've seen what I'm capable of.",
            "nextDialogs": [
              "741411019"
            ]
          },
          "741411019": {
            "id": "741411019",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "And... Perhaps I know more about this place than even you do.",
            "nextDialogs": [
              "741411020"
            ]
          },
          "741411020": {
            "id": "741411020",
            "speakerId": 1003,
            "speakerName": "Puppy",
            "text": "#Hilichurl, tell the {M#boy}{F#girl} to leave at once.",
            "nextDialogs": [
              "741411021"
            ]
          },
          "741411021": {
            "id": "741411021",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you have something to tell me?",
            "nextDialogs": [
              "741411022"
            ]
          },
          "741411022": {
            "id": "741411022",
            "speakerId": 1003,
            "speakerName": "Puppy",
            "text": "...Can you understand what I'm saying? I see. Let me ask you... What am I in your eyes?",
            "nextDialogs": [
              "741411023"
            ]
          },
          "741411023": {
            "id": "741411023",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A dog.",
            "nextDialogs": [
              "741411024"
            ]
          },
          "741411024": {
            "id": "741411024",
            "speakerId": 1003,
            "speakerName": "Puppy",
            "text": "Hmm. Maybe there is still hope.",
            "nextDialogs": [
              "741411025"
            ]
          },
          "741411025": {
            "id": "741411025",
            "speakerId": 1003,
            "speakerName": "Puppy",
            "text": "Leave this place, young one. It's for your own good.",
            "nextDialogs": [
              "741411026"
            ]
          },
          "741411026": {
            "id": "741411026",
            "speakerId": 1002,
            "speakerName": "Caterpillar",
            "text": "#I agree, {NICKNAME}. You belong to a brighter world.",
            "nextDialogs": [
              "741411027"
            ]
          },
          "741411027": {
            "id": "741411027",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I have a question...",
            "nextDialogs": [
              "741411028"
            ]
          },
          "741411028": {
            "id": "741411028",
            "speakerId": 1003,
            "speakerName": "Puppy",
            "text": "You shouldn't. Goodbye, and don't come back."
          }
        }
      }
    },
    {
      "subId": "7414111",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741411101"
        ],
        "dialogs": {
          "741411101": {
            "id": "741411101",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! You're back!",
            "nextDialogs": [
              "741411102"
            ]
          },
          "741411102": {
            "id": "741411102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How long was I gone for?",
            "nextDialogs": [
              "741411103"
            ]
          },
          "741411103": {
            "id": "741411103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm, just the blink of an eye.",
            "nextDialogs": [
              "741411104"
            ]
          },
          "741411104": {
            "id": "741411104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "If it was just a blink of an eye to you...",
            "nextDialogs": [
              "741411105"
            ]
          },
          "741411105": {
            "id": "741411105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What's wrong?",
            "nextDialogs": [
              "741411106"
            ]
          },
          "741411106": {
            "id": "741411106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Nothing. I suppose it really is dangerous inside.",
            "nextDialogs": [
              "741411107"
            ]
          },
          "741411107": {
            "id": "741411107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Is that so...",
            "nextDialogs": [
              "741411108"
            ]
          },
          "741411108": {
            "id": "741411108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Anyway, where's Canotila? She didn't go become a guard in the Court of Fontaine, did she?",
            "nextDialogs": [
              "741411109"
            ]
          },
          "741411109": {
            "id": "741411109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...I'm feeling a little dizzy, let's come back next time.",
            "nextDialogs": [
              "741411110"
            ]
          },
          "741411110": {
            "id": "741411110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, okay. Should we find something to eat? Paimon was so worried about you that she's now starving!",
            "nextDialogs": [
              "741411111"
            ]
          },
          "741411111": {
            "id": "741411111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wasn't it just a blink of an eye for you?",
            "nextDialogs": [
              "741411112"
            ]
          },
          "741411112": {
            "id": "741411112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, it took a lot of effort to worry about you!"
          }
        }
      }
    },

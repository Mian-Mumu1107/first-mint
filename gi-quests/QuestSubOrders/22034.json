        ],
        "dialogs": {
          "220349901": {
            "id": "220349901",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "There are indeed a lot of Treasure Hoarders here.",
            "nextDialogs": [
              "220349902"
            ]
          },
          "220349902": {
            "id": "220349902",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "Let's go, Traveler. Time to have a little chat with them."
          }
        }

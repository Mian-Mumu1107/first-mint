      "dialogue": {
        "startDialogs": [
          "220340203"
        ],
        "dialogs": {
          "220340203": {
            "id": "220340203",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "These people are quite quick to flee.",
            "nextDialogs": [
              "220340204"
            ]
          },
          "220340204": {
            "id": "220340204",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "They probably went back to report about us. In this case, our objective has been accomplished.",
            "nextDialogs": [
              "220340205"
            ]
          },
          "220340205": {
            "id": "220340205",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "Thank you for your hard work, Traveler. Please take these.",
            "nextDialogs": [
              "220340206"
            ]
          },
          "220340206": {
            "id": "220340206",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "I will also return and report to Sango about this.",
            "nextDialogs": [
              "220340207"
            ]
          },
          "220340207": {
            "id": "220340207",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "I wonder if she's figured something out yet..."
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "7216101",
      "subQuestName": "Rescue the besieged samurai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721610101"
        ],
        "dialogs": {
          "721610101": {
            "id": "721610101",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Hmph, how humiliating...",
            "nextDialogs": [
              "721610102"
            ]
          },
          "721610102": {
            "id": "721610102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! We saved your life! What do you mean we're \"humiliating\"?",
            "nextDialogs": [
              "721610105"
            ]
          },
          "721610105": {
            "id": "721610105",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "To think that I had to be rescued by outlanders, and was even reduced to being judged by them...",
            "nextDialogs": [
              "721610106"
            ]
          },
          "721610106": {
            "id": "721610106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh... So, Mr. Samurai, are you alright?",
            "nextDialogs": [
              "721610107"
            ]
          },
          "721610107": {
            "id": "721610107",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "..."
          }
        }
      }
    },
    {
      "subId": "7216102",
      "subQuestName": "Talk to the samurai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7216103",
      "subQuestName": "Clear out the pirate camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721610301"
        ],
        "dialogs": {
          "721610301": {
            "id": "721610301",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "You've returned.",
            "nextDialogs": [
              "721610304"
            ]
          },
          "721610304": {
            "id": "721610304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, the atmosphere got weird all of a sudden...",
            "nextDialogs": [
              "721610305"
            ]
          },
          "721610305": {
            "id": "721610305",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "I must apologize for asking you, an outsider, to do my dirty work."
          }
        }
      }
    },
    {
      "subId": "7216114",

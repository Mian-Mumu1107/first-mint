    {
      "subId": "7216102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721610201"
        ],
        "dialogs": {
          "721610201": {
            "id": "721610201",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "I'm tired. Please forgive my lack of hospitality."
          }
        }
      }
    },
    {
      "subId": "7216107",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721610701"
        ],
        "dialogs": {
          "721610701": {
            "id": "721610701",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "...And it seems that the rats nearby have begun scurrying about again.",
            "nextDialogs": [
              "721610702"
            ]
          },
          "721610702": {
            "id": "721610702",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Watch out for pirates if you wander around these parts, outlander.",
            "nextDialogs": [
              "721610703"
            ]
          },
          "721610703": {
            "id": "721610703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thank you.",
            "nextDialogs": [
              "721610704"
            ]
          },
          "721610704": {
            "id": "721610704",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "You're welcome.",
            "nextDialogs": [
              "721610705"
            ]
          },
          "721610705": {
            "id": "721610705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They shall be no match for me.",
            "nextDialogs": [
              "721610706"
            ]
          },
          "721610706": {
            "id": "721610706",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Haha, again with the big talk...",
            "nextDialogs": [
              "721610707"
            ]
          },
          "721610707": {
            "id": "721610707",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Only say that once you've finally gotten rid of them all!",
            "nextDialogs": [
              "721610708"
            ]
          },
          "721610708": {
            "id": "721610708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You have a deal.",
            "nextDialogs": [
              "721610709"
            ]
          },
          "721610709": {
            "id": "721610709",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Yes, that we do."
          }
        }
      }
    },
    {
      "subId": "7216113",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721611301"
        ],
        "dialogs": {
          "721611301": {
            "id": "721611301",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "An outlander? Interesting...",
            "nextDialogs": [
              "721611302"
            ]
          },
          "721611302": {
            "id": "721611302",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "If you're a tourist, you've come to the wrong place.",
            "nextDialogs": [
              "721611303"
            ]
          },
          "721611303": {
            "id": "721611303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing here?",
            "nextDialogs": [
              "721611304"
            ]
          },
          "721611304": {
            "id": "721611304",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "What, are you from the Shogunate?",
            "nextDialogs": [
              "721611305"
            ]
          },
          "721611305": {
            "id": "721611305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No.",
            "nextDialogs": [
              "721611306"
            ]
          },
          "721611306": {
            "id": "721611306",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Then mind your own business.",
            "nextDialogs": [
              "721611307"
            ]
          },
          "721611307": {
            "id": "721611307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This guy's so rude!",
            "nextDialogs": [
              "721611308"
            ]
          },
          "721611308": {
            "id": "721611308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Shogunate sent me, alright.",
            "nextDialogs": [
              "721611309"
            ]
          },
          "721611309": {
            "id": "721611309",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Why you outlanders...",
            "nextDialogs": [
              "721611310"
            ]
          },
          "721611310": {
            "id": "721611310",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "In front of the Commissioner, you beg like dogs, but in front of us Inazuman samurai, you act all high and mighty...",
            "nextDialogs": [
              "721611311"
            ]
          },
          "721611311": {
            "id": "721611311",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Running here, spying there, stirring things up everywhere... And now you come all the way to this broken boat, for archons only know what.",
            "nextDialogs": [
              "721611312"
            ]
          },
          "721611312": {
            "id": "721611312",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Well, too bad. I'm just a wounded soldier. There's nothing I can do for you.",
            "nextDialogs": [
              "721611313"
            ]
          },
          "721611313": {
            "id": "721611313",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "So if it pleases you, kindly get out of here.",
            "nextDialogs": [
              "721611314"
            ]
          },
          "721611314": {
            "id": "721611314",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Doesn't this guy have any manners at all?",
            "nextDialogs": [
              "721611315"
            ]
          },
          "721611315": {
            "id": "721611315",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Whatever. You're too noisy.",
            "nextDialogs": [
              "721611316"
            ]
          },
          "721611316": {
            "id": "721611316",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Before you leave, let me give you a piece of advice: don't stay on Yashiori Island for too long. This island has been cursed.",
            "nextDialogs": [
              "721611317"
            ]
          },
          "721611317": {
            "id": "721611317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Cursed?",
            "nextDialogs": [
              "721611318"
            ]
          },
          "721611318": {
            "id": "721611318",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "What are you, deaf? I said that this island is cursed.",
            "nextDialogs": [
              "721611319"
            ]
          },
          "721611319": {
            "id": "721611319",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "This never-ending stalemate, the ambitions of our lords, the despair of the common folk, the hatred welling up from the innocent victims, the charnel-sick of vulneraries filling the rooms of dying old people...",
            "nextDialogs": [
              "721611320"
            ]
          },
          "721611320": {
            "id": "721611320",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "It's all a curse.",
            "nextDialogs": [
              "721611321"
            ]
          },
          "721611321": {
            "id": "721611321",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Leave before you get crushed under its weight.",
            "nextDialogs": [
              "721611322"
            ]
          },
          "721611322": {
            "id": "721611322",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon didn't get him at all. What a weirdo."
          }
        }
      }
    },
    {
      "subId": "7216114",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721611401"
        ],
        "dialogs": {
          "721611401": {
            "id": "721611401",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "It's you again!?",
            "nextDialogs": [
              "721611402"
            ]
          },
          "721611402": {
            "id": "721611402",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Didn't I tell you to... Oh, forget it. Do as you like.",
            "nextDialogs": [
              "721611403"
            ]
          },
          "721611403": {
            "id": "721611403",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Just don't mess around with my things. There are just enough supplies on the ship for you. Leave as soon as you are satisfied.",
            "nextDialogs": [
              "721611404"
            ]
          },
          "721611404": {
            "id": "721611404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Would you like some help?",
            "nextDialogs": [
              "721611405"
            ]
          },
          "721611405": {
            "id": "721611405",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "No. Can't you see that I'm doing just fine?",
            "nextDialogs": [
              "721611406"
            ]
          },
          "721611406": {
            "id": "721611406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But your wound...",
            "nextDialogs": [
              "721611407"
            ]
          },
          "721611407": {
            "id": "721611407",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "It's my wound, not yours.",
            "nextDialogs": [
              "721611408"
            ]
          },
          "721611408": {
            "id": "721611408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, we asked out of kindness!",
            "nextDialogs": [
              "721611409"
            ]
          },
          "721611409": {
            "id": "721611409",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Then I also answer you out of kindness: don't bother me.",
            "nextDialogs": [
              "721611410"
            ]
          },
          "721611410": {
            "id": "721611410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I can help you.",
            "nextDialogs": [
              "721611411"
            ]
          },
          "721611411": {
            "id": "721611411",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "How can you help me, hand me over to the shogunate?",
            "nextDialogs": [
              "721611412"
            ]
          },
          "721611412": {
            "id": "721611412",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Haha, I'd advise you against such misguided mercy... I will be treated as a deserter, and Lord Kujou has never shown mercy to deserters.",
            "nextDialogs": [
              "721611413"
            ]
          },
          "721611413": {
            "id": "721611413",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "If you really want to help me, then give me some peace and quiet.",
            "nextDialogs": [
              "721611414"
            ]
          },
          "721611414": {
            "id": "721611414",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, this guy is so grumpy!"
          }
        }
      }
    },
    {
      "subId": "7216115",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721611501"
        ],
        "dialogs": {
          "721611501": {
            "id": "721611501",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Stop bothering me. Find some other way to occupy yourself."
          }
        }
      }
    }
  ]
}
    {
      "subId": "7216104",
      "subQuestName": "Gather 12 Naku Weeds",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721610401"
        ],
        "dialogs": {
          "721610401": {
            "id": "721610401",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "You're back. Stay safe while you're on this island.",
            "nextDialogs": [
              "721610402"
            ]
          },
          "721610402": {
            "id": "721610402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Will these be enough?"
          }
        }
      }
    },
    {
      "subId": "7216105",
      "subQuestName": "Talk to Inaba Kyuuzou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721610505"
        ],
        "dialogs": {
          "721610505": {
            "id": "721610505",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "It will take a long time to mash the herbs into a paste. You can go now.",
            "nextDialogs": [
              "721610506"
            ]
          },
          "721610506": {
            "id": "721610506",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "No, don't get me wrong. I'm not driving you away...",
            "nextDialogs": [
              "721610507"
            ]
          },
          "721610507": {
            "id": "721610507",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Come back after a while. It's good to have someone to chat with.",
            "nextDialogs": [
              "721610510"
            ]
          },
          "721610510": {
            "id": "721610510",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Take care, outlander."
          }
        }
      }
    },
    {
      "subId": "7216106",
      "subQuestName": "Wait till 10:00 – 12:00 the next day and talk to Inaba Kyuuzou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721610601"
        ],
        "dialogs": {
          "721610601": {
            "id": "721610601",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Outlander, how have you been?",
            "nextDialogs": [
              "721610602"
            ]
          },
          "721610602": {
            "id": "721610602",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "I apologize. This is no place for guests.",
            "nextDialogs": [
              "721610603"
            ]
          },
          "721610603": {
            "id": "721610603",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Still... I'm glad you could come.",
            "nextDialogs": [
              "721610604"
            ]
          },
          "721610604": {
            "id": "721610604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You look much better now.",
            "nextDialogs": [
              "721610605"
            ]
          },
          "721610605": {
            "id": "721610605",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "All thanks to you. Once again, I am in your debt.",
            "nextDialogs": [
              "721610606"
            ]
          },
          "721610606": {
            "id": "721610606",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Haha, isn't it a pity that I've survived yet again?",
            "nextDialogs": [
              "721610607"
            ]
          },
          "721610607": {
            "id": "721610607",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Isn't that a good thing? Why's that a pity?",
            "nextDialogs": [
              "721610610"
            ]
          },
          "721610610": {
            "id": "721610610",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "I haven't made my mind up about what to do next, but I don't think I'll go back.",
            "nextDialogs": [
              "721610611"
            ]
          },
          "721610611": {
            "id": "721610611",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Kujou Masahito is not a bad person, but his old man is calling for deserters to be caught and punished...",
            "nextDialogs": [
              "721610612"
            ]
          },
          "721610612": {
            "id": "721610612",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "I cannot afford to get on the wrong side of him.",
            "nextDialogs": [
              "721610613"
            ]
          },
          "721610613": {
            "id": "721610613",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "Maybe I'll take off my armor. It's been nice, living alone here...",
            "nextDialogs": [
              "721610614"
            ]
          },
          "721610614": {
            "id": "721610614",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "But until we have peace, there's no point deceiving myself. My memories assert that I am still that same wounded, bloodstained soldier...",
            "nextDialogs": [
              "721610615"
            ]
          },
          "721610615": {
            "id": "721610615",
            "speakerId": 20291,
            "speakerName": "Inaba Kyuuzou",
            "text": "*sigh* And who knows what might happen in the future?"
          }
        }
      }
    },
    {

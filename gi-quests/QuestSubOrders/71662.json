  "subQuests": [
    {
      "subId": "7166201",
      "subQuestName": "Talk to Katheryne",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716620101"
        ],
        "dialogs": {
          "716620101": {
            "id": "716620101",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "Hello there, Traveler. Great timing: we have a commission that I believe would best be taken up by you.",
            "nextDialogs": [
              "716620104"
            ]
          },
          "716620104": {
            "id": "716620104",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "Well, it involves a hitherto unknown Domain.",
            "nextDialogs": [
              "716620105"
            ]
          },
          "716620105": {
            "id": "716620105",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "Though the Guild has undertaken extensive investigations into that Domain, we have yet to achieve results of any particular value.",
            "nextDialogs": [
              "716620106"
            ]
          },
          "716620106": {
            "id": "716620106",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "Honglang, who is in charge of this investigation, says that he needs the assistance of a highly adaptable adventurer.",
            "nextDialogs": [
              "716620107"
            ]
          },
          "716620107": {
            "id": "716620107",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "You were the first person I thought of, Traveler.",
            "nextDialogs": [
              "716620108"
            ]
          },
          "716620108": {
            "id": "716620108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What sort of Domain is this...",
            "nextDialogs": [
              "716620109"
            ]
          },
          "716620109": {
            "id": "716620109",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "Honglang is at the entrance to this Domain. If you're willing to help, you can go ask him what he needs.",
            "nextDialogs": [
              "716620110"
            ]
          },
          "716620110": {
            "id": "716620110",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "We're counting on you, Traveler."
          }
        }
      }
    },
    {
      "subId": "7166202",
      "subQuestName": "Talk to Honglang",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716620201"
        ],
        "dialogs": {
          "716620201": {
            "id": "716620201",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "What's with this Domain...",
            "nextDialogs": [
              "716620202"
            ]
          },
          "716620202": {
            "id": "716620202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hey there, about the commission...",
            "nextDialogs": [
              "716620203"
            ]
          },
          "716620203": {
            "id": "716620203",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "Eh? You... Oh, so you're the one Ms. Katheryne called in?",
            "nextDialogs": [
              "716620204"
            ]
          },
          "716620204": {
            "id": "716620204",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "I've heard that you're flexible, highly experienced, and one of our top adventurers to boot...",
            "nextDialogs": [
              "716620207"
            ]
          },
          "716620207": {
            "id": "716620207",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "Wonderful! That's very reassuring indeed.",
            "nextDialogs": [
              "716620208"
            ]
          },
          "716620208": {
            "id": "716620208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Still, could you tell me about this Domain...?",
            "nextDialogs": [
              "716620209"
            ]
          },
          "716620209": {
            "id": "716620209",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "Ah, yes, right. Sorry. Let me fill you in...",
            "nextDialogs": [
              "716620210"
            ]
          },
          "716620210": {
            "id": "716620210",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "Well, here's what happened: some time back, a team of adventurers found this strange, large door out in the wild... You're looking at it right now, naturally.",
            "nextDialogs": [
              "716620211"
            ]
          },
          "716620211": {
            "id": "716620211",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "Once they had passed through this gate, the team entered an unknown Domain.",
            "nextDialogs": [
              "716620212"
            ]
          },
          "716620212": {
            "id": "716620212",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "According to the first batch of adventurers, the Domain was just an \"empty room\" when they first entered it."
          }
        }
      }
    },
    {
      "subId": "7166203",
      "subQuestName": "Enter the Domain",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716620301"
        ],
        "dialogs": {
          "716620301": {
            "id": "716620301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This...",
            "nextDialogs": [
              "716620302"
            ]
          },
          "716620302": {
            "id": "716620302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You sure this is the same place as that \"empty room\" you talked about?",
            "nextDialogs": [
              "716620305"
            ]
          },
          "716620305": {
            "id": "716620305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Exactly! Isn't this just an ordinary ruin? Y'know, the ones we visit all the time?",
            "nextDialogs": [
              "716620306"
            ]
          },
          "716620306": {
            "id": "716620306",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "This is indeed the Domain we mean to explore.",
            "nextDialogs": [
              "716620307"
            ]
          },
          "716620307": {
            "id": "716620307",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "And as for the reason why it looks like this...",
            "nextDialogs": [
              "716620308"
            ]
          },
          "716620308": {
            "id": "716620308",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "That's because this Domain changed its form not long ago.",
            "nextDialogs": [
              "716620309"
            ]
          },
          "716620309": {
            "id": "716620309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh?",
            "nextDialogs": [
              "716620310"
            ]
          },
          "716620310": {
            "id": "716620310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It \"changed its form\"? Into this?",
            "nextDialogs": [
              "716620311"
            ]
          },
          "716620311": {
            "id": "716620311",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "That's right. This Domain transforms based on people's wishes.",
            "nextDialogs": [
              "716620312"
            ]
          },
          "716620312": {
            "id": "716620312",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "According to the leader of the adventure team at that time, they'd started to lose patience with this place after exploring it for some time to no avail.",
            "nextDialogs": [
              "716620313"
            ]
          },
          "716620313": {
            "id": "716620313",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "One of their members began to grumble under their breath.",
            "nextDialogs": [
              "716620314"
            ]
          },
          "716620314": {
            "id": "716620314",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "\"If this was an ordinary Domain, we would've finished exploring it long ago.\"",
            "nextDialogs": [
              "716620315"
            ]
          },
          "716620315": {
            "id": "716620315",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "Hungry and tired as they were, the rest of the team expressed approval of that member's view.",
            "nextDialogs": [
              "716620316"
            ]
          },
          "716620316": {
            "id": "716620316",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "And as more people began to concur, the team suddenly found themselves in \"an ordinary Domain.\"",
            "nextDialogs": [
              "716620317"
            ]
          },
          "716620317": {
            "id": "716620317",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "This \"ordinary Domain\" contained mechanisms, paths, treasure... even torches that were still burning.",
            "nextDialogs": [
              "716620318"
            ]
          },
          "716620318": {
            "id": "716620318",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "The adventure team judged themselves unable to deal with such a situation, and thus reported back to the Guild immediately.",
            "nextDialogs": [
              "716620319"
            ]
          },
          "716620319": {
            "id": "716620319",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "In response, we quickly sent people to conduct further investigations.",
            "nextDialogs": [
              "716620320"
            ]
          },
          "716620320": {
            "id": "716620320",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "However, all we know even now is that this Domain can change according to a person's will.",
            "nextDialogs": [
              "716620321"
            ]
          },
          "716620321": {
            "id": "716620321",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "If many people enter the Domain at once, then it will react to the person with the strongest thoughts.",
            "nextDialogs": [
              "716620322"
            ]
          },
          "716620322": {
            "id": "716620322",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow! Does this mean that it could create, say, the entire Liyue Harbor in here?",
            "nextDialogs": [
              "716620323"
            ]
          },
          "716620323": {
            "id": "716620323",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "We've tried this, but to no avail. Perhaps our desire to create Liyue Harbor just wasn't strong enough.",
            "nextDialogs": [
              "716620324"
            ]
          },
          "716620324": {
            "id": "716620324",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "Whatever the case, we are currently gathering adventurers to enter this Domain and cause all manner of changes according to their desires.",
            "nextDialogs": [
              "716620325"
            ]
          },
          "716620325": {
            "id": "716620325",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "We hope that we might be able to figure out some of the rules and principles behind the changes this Domain undergoes, and thus get answers from there."
          }
        }
      }
    },

    },
    {
      "subId": "7166207",
      "subQuestName": "Give the Adventure Coin to Honglang",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716620401"
        ],
        "dialogs": {
          "716620401": {
            "id": "716620401",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "Wow! That was pretty impressive. You got the hang of this place really quickly!",
            "nextDialogs": [
              "716620402"
            ]
          },
          "716620402": {
            "id": "716620402",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "In that case, we're counting on you. Use all your wits and imagination to transform this Domain.",
            "nextDialogs": [
              "716620403"
            ]
          },
          "716620403": {
            "id": "716620403",
            "speakerId": 30153,
            "speakerName": "Honglang",
            "text": "I do hope that we'll be able to understand the rules behind the changes of this Domain soon."
          }
        }
      }
    },

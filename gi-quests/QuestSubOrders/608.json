          "6080101": {
            "id": "6080101",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Phew, it's been a while since I unleashed my lightning during Windblume.",
            "nextDialogs": [
              "6080102"
            ]
          },
          "6080102": {
            "id": "6080102",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "It happen a lot before?",
            "nextDialogs": [
              "6080103"
            ]
          },
          "6080103": {
            "id": "6080103",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Unleashing lightning on people? Haha, no, no. Once in a while, maybe. It sure feels good to let loose, though...",
            "nextDialogs": [
              "6080104"
            ]
          },
          "6080104": {
            "id": "6080104",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Hah, my old Professor even wrote to me about that a few days ago. Of course, I made sure to emphasize that I always \"treat others with kindness.\"",
            "nextDialogs": [
              "6080105"
            ]
          },
          "6080105": {
            "id": "6080105",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "It's only natural for a student to inherit their teacher's ways, after all, and mine was a gentle old man from the Spantamad school.",
            "nextDialogs": [
              "6080106"
            ]
          },
          "6080106": {
            "id": "6080106",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "So, you see? This time, I only used gentle methods of electrocution. So gentle, even Jean would have no reason to intervene.",
            "nextDialogs": [
              "6080107"
            ]
          },
          "6080107": {
            "id": "6080107",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Huh, gentle electrocution...",
            "nextDialogs": [
              "6080108"
            ]
          },
          "6080108": {
            "id": "6080108",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "You seem to be in good spirits, Miss Lisa.",
            "nextDialogs": [
              "6080109"
            ]
          },
          "6080109": {
            "id": "6080109",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Ah, well, it's good to move about every once in a while."
          }
        }

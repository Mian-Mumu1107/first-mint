            "text": "Allow me to give it a try."
          }
        }
      }
    },
    {
      "subId": "7516508",
      "subQuestName": "Complete Illimani's challenge",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751650801"
        ],
        "dialogs": {
          "751650801": {
            "id": "751650801",
            "speakerId": 1001,
            "speakerName": "Illimani",
            "text": "You did pretty well, but honestly... Not to brag, my best record is still better than yours.",
            "nextDialogs": [
              "751650802"
            ]
          },
          "751650802": {
            "id": "751650802",
            "speakerId": 1001,
            "speakerName": "Illimani",
            "text": "I mean, everyone's got one or two things they're really good at.",
            "nextDialogs": [
              "751650803"
            ]
          },
          "751650803": {
            "id": "751650803",
            "speakerId": 1001,
            "speakerName": "Illimani",
            "text": "See? Even someone with my build can be agile. So, make sure to eat properly and don't go on any crazy diets!"
          }
        }
      }
    },
    {
      "subId": "7516505",

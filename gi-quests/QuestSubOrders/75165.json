    {
      "subId": "7516507",
      "subQuestName": "Complete Suriqui's challenge",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751650701"
        ],
        "dialogs": {
          "751650701": {
            "id": "751650701",
            "speakerId": 1000,
            "speakerName": "Suriqui",
            "text": "Hehe. Not bad, but you're still a bit behind me.",
            "nextDialogs": [
              "751650702"
            ]
          },
          "751650702": {
            "id": "751650702",
            "speakerId": 1000,
            "speakerName": "Suriqui",
            "text": "I've been rocking the slightly chubby look for a while now, but trust me, I've never skimped on my training. My agility and impact are way beyond those clueless gym junkies.",
            "nextDialogs": [
              "751650703"
            ]
          },
          "751650703": {
            "id": "751650703",
            "speakerId": 1000,
            "speakerName": "Suriqui",
            "text": "Forget chasing muscles — come join me in celebrating the greatness of fat!"
          }
        }
      }
    },
    {
      "subId": "7516503",
      "subQuestName": "Complete Suriqui's challenge",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751650301"
        ],
        "dialogs": {
          "751650301": {
            "id": "751650301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll need a moment to prepare.",
            "nextDialogs": [
              "751650302"
            ]
          },
          "751650302": {
            "id": "751650302",
            "speakerId": 1000,
            "speakerName": "Suriqui",
            "text": "No problem, come back whenever you're prepared."
          }
        }
      }
    },
    {
      "subId": "7516511",
      "subQuestName": "Come back later and check",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751651101"
        ],
        "dialogs": {
          "751651101": {
            "id": "751651101",
            "speakerId": 1001,
            "speakerName": "Illimani",
            "text": "Come on, give it a try! Run through this training ground as fast as you can, but be sure <color=#00E1FFFF>not to break any of the jars</color>!",
            "nextDialogs": [
              "751651102"
            ]
          },
          "751651102": {
            "id": "751651102",
            "speakerId": 1001,
            "speakerName": "Illimani",
            "text": "Let's see how well you do — and whether you can beat my record."
          }
        }
      }
    },
    {
      "subId": "7516504",

    {
      "subId": "7321213",
      "subQuestName": "Investigate the hilichurl camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732121601"
        ],
        "dialogs": {
          "732121601": {
            "id": "732121601",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmph... They left absolutely nothing intact. Oh, Paimon's getting mad! These hilichurls really know how to break stuff!",
            "nextDialogs": [
              "732121603",
              "732121605"
            ]
          },
          "732121603": {
            "id": "732121603",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? But... the hilichurls have their camp here, don't they?"
          },
          "732121605": {
            "id": "732121605",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But the hilichurls placed their camp right in the middle of the road... Look there. If they block that spot off, won't it be easy to rob someone?"
          }
        }
      }
    },
    {
      "subId": "7321205",
      "subQuestName": "Look for clues in the area",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732120801"
        ],
        "dialogs": {
          "732120801": {
            "id": "732120801",
            "speakerId": 1004,
            "speakerName": "Ruined Rug",
            "text": "(A rolled carpet that's still in good condition. The symbol of the Tanit tribe is stitched into it, while ominous blotches dot its surface...)",
            "nextDialogs": [
              "732120802"
            ]
          },
          "732120802": {
            "id": "732120802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The rug... how strange...",
            "nextDialogs": [
              "732120803"
            ]
          },
          "732120803": {
            "id": "732120803",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh... Wow, that rug looks expensive. But why did it just get left here?",
            "nextDialogs": [
              "732120804"
            ]
          },
          "732120804": {
            "id": "732120804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe there was a struggle or fight over it...",
            "nextDialogs": [
              "732120805"
            ]
          },
          "732120805": {
            "id": "732120805",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hm... Yeah... Paimon thinks she can see that happening.",
            "nextDialogs": [
              "732120806"
            ]
          },
          "732120806": {
            "id": "732120806",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The caravan and the robbers had a fight here. Some goods got damaged during the battle, while other perfectly fine ones were left aside in the ensuing chaos...",
            "nextDialogs": [
              "732120807"
            ]
          },
          "732120807": {
            "id": "732120807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Very astute, Paimon.",
            "nextDialogs": [
              "732120808"
            ]
          },
          "732120808": {
            "id": "732120808",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe. Paimon's the best!",
            "nextDialogs": [
              "732120809"
            ]
          },
          "732120809": {
            "id": "732120809",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And then, the caravan and the robbers fought while running all along the way... fighting and running and fighting... That's why all these boxes and jars are scattered everywhere.",
            "nextDialogs": [
              "732120810"
            ]
          },
          "732120810": {
            "id": "732120810",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hm. Paimon thinks that's a good deduction!",
            "nextDialogs": [
              "732120811"
            ]
          },
          "732120811": {
            "id": "732120811",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That doesn't make any sense!",
            "nextDialogs": [
              "732120812"
            ]
          },
          "732120812": {
            "id": "732120812",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmph!",
            "nextDialogs": [
              "732120815"
            ]
          },
          "732120815": {
            "id": "732120815",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Really...",
            "nextDialogs": [
              "732120816"
            ]
          },
          "732120816": {
            "id": "732120816",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Because we didn't see any signs of a struggle along the way.",
            "nextDialogs": [
              "732120817"
            ]
          },
          "732120817": {
            "id": "732120817",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So, that's how it was... Still, Paimon's theory was close... Like ninety-percent accurate close!",
            "nextDialogs": [
              "732120818"
            ]
          },
          "732120818": {
            "id": "732120818",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh... Paimon can't help feeling something's wrong..."
          }
        }
      }
    },

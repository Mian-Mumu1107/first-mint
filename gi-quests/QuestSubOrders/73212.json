  "subQuests": [
    {
      "subId": "7321201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732120101"
        ],
        "dialogs": {
          "732120101": {
            "id": "732120101",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "Ah, Master of the Jinni! Y—you're here.",
            "nextDialogs": [
              "732120102"
            ]
          },
          "732120102": {
            "id": "732120102",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "I jus—just so happen to have a t—task for you... An urgent one!",
            "nextDialogs": [
              "732120104",
              "732120106"
            ]
          },
          "732120104": {
            "id": "732120104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah, slow down! We'll help once you tell us what's happening!",
            "nextDialogs": [
              "732120107"
            ]
          },
          "732120107": {
            "id": "732120107",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "A shipment—a shipment—a—a shipment of goods has g—gone missing!",
            "nextDialogs": [
              "732120108"
            ]
          },
          "732120108": {
            "id": "732120108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You lost three shipment of goods!?",
            "nextDialogs": [
              "732120109"
            ]
          },
          "732120109": {
            "id": "732120109",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "N—no! Just on—one shipment.",
            "nextDialogs": [
              "732120110"
            ]
          },
          "732120110": {
            "id": "732120110",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "I contracted an outside party to sh—ship us some Anahitian Blessing, b—but a l—long time has p—passed and it's s—still not here...",
            "nextDialogs": [
              "732120111"
            ]
          },
          "732120111": {
            "id": "732120111",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "It might be the d—doing of those nor—northerners... Might be retaliation because Babel is always s—searching them for t—traitors...",
            "nextDialogs": [
              "732120112"
            ]
          },
          "732120112": {
            "id": "732120112",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "E-ever since Aderfi and Azariq left... The northerners h—have been much more a—active.",
            "nextDialogs": [
              "732120113"
            ]
          },
          "732120113": {
            "id": "732120113",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "A—alright. I am d—done with dallying. The caravan delivering the Anahitian Blessing's last known location i—is in this region, according to our scouts.",
            "nextDialogs": [
              "732120114"
            ]
          },
          "732120114": {
            "id": "732120114",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "I hope you can help me f—find the goods. Or a—at—at least find any clues as to what happened to the caravan.",
            "nextDialogs": [
              "732120115"
            ]
          },
          "732120115": {
            "id": "732120115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure. I'll give you a hand.",
            "nextDialogs": [
              "732120116"
            ]
          },
          "732120116": {
            "id": "732120116",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A caravan can't just disappear on its own, right? Sounds like they got robbed by some bandits...",
            "nextDialogs": [
              "732120117"
            ]
          },
          "732120117": {
            "id": "732120117",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "Th—thank you. A tho—thousand thanks! Please, accept this meat as gra—gratitude for your service.",
            "nextDialogs": [
              "732120118"
            ]
          },
          "732120118": {
            "id": "732120118",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow! Thanks! You're too kind!"
          },
          "732120106": {
            "id": "732120106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Take it slowly now! You don't need to hurry!"
          }
        }
      }
    },
    {
      "subId": "7321202",
      "subQuestName": "Head to the last known location of the merchant caravan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7321203",
      "subQuestName": "Investigate the area",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732120501"
        ],
        "dialogs": {
          "732120501": {
            "id": "732120501",
            "speakerId": 1002,
            "speakerName": "Damaged Jar",
            "text": "(A cracked, empty jar lay there, not yet swallowed by the sands. Looks like it was thrown aside not long ago.)",
            "nextDialogs": [
              "732120502"
            ]
          },
          "732120502": {
            "id": "732120502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Look! That jar's still poking out from the sand!",
            "nextDialogs": [
              "732120504",
              "732120506"
            ]
          },
          "732120504": {
            "id": "732120504",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, this doesn't look good... Paimon thinks that they might have dropped some other goods along the way? Maybe we should keep searching ahead."
          },
          "732120506": {
            "id": "732120506",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah... They might have left some other stuff behind them. Let's keep going!"
          }
        }
      }
    },
    {
      "subId": "7321204",
      "subQuestName": "Follow the trail of clues",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732120601"
        ],
        "dialogs": {
          "732120601": {
            "id": "732120601",
            "speakerId": 1003,
            "speakerName": "Empty Broken Box",
            "text": "(An empty, broken box lay abandoned, toppled over by the roadside.)",
            "nextDialogs": [
              "732120602"
            ]
          },
          "732120602": {
            "id": "732120602",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh. This box must be from the caravan. Look! It even has the tribe's symbol on it!",
            "nextDialogs": [
              "732120603"
            ]
          },
          "732120603": {
            "id": "732120603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Won't be hard to ambush someone here.",
            "nextDialogs": [
              "732120604"
            ]
          },
          "732120604": {
            "id": "732120604",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah... This place looks dangerous!",
            "nextDialogs": [
              "732120605"
            ]
          },
          "732120605": {
            "id": "732120605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It looks like they stole even the largest of the goods...",
            "nextDialogs": [
              "732120606"
            ]
          },
          "732120606": {
            "id": "732120606",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "They moved all the valuables, but left the containers. Huh. Paimon guesses they might have a lot of people, but don't seem to have the tools to move the crates.",
            "nextDialogs": [
              "732120607"
            ]
          },
          "732120607": {
            "id": "732120607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Or, perhaps, this is a trap...",
            "nextDialogs": [
              "732120608"
            ]
          },
          "732120608": {
            "id": "732120608",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A... trap?",
            "nextDialogs": [
              "732120609"
            ]
          },
          "732120609": {
            "id": "732120609",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Do you mean they left these empty boxes on purpose? To... lure people to them?",
            "nextDialogs": [
              "732120610"
            ]
          },
          "732120610": {
            "id": "732120610",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "To lure us.",
            "nextDialogs": [
              "732120611"
            ]
          },
          "732120611": {
            "id": "732120611",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ah! Paimon's getting goosebumps! Then... do we really need to keep going...",
            "nextDialogs": [
              "732120613",
              "732120615"
            ]
          },
          "732120613": {
            "id": "732120613",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What? Pfft. Paimon's not scared. Hmph. Besides, you can't just leave Paimon!"
          },
          "732120615": {
            "id": "732120615",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, the way you say that isn't making Paimon feel good at all... But since you're not scared, maybe we should keep going..."
          }
        }
      }
    },
    {
      "subId": "7321214",
      "subQuestName": "Follow the trail of clues",
      "sceneId": null,
      "locations": [],

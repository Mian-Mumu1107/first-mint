    {
      "subId": "7321215",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732121501"
        ],
        "dialogs": {
          "732121501": {
            "id": "732121501",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "This matter is e—extremely urgent! P—please go inform the Matriarch."
          }
        }
      }

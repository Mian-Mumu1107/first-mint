    {
      "subId": "7321216",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7321209",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732120901"
        ],
        "dialogs": {
          "732120901": {
            "id": "732120901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow... that was close. Luckily, we're good at fighting. Took them down in no time flat!",
            "nextDialogs": [
              "732120902"
            ]
          },
          "732120902": {
            "id": "732120902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thanks for your \"hospitality.\"",
            "nextDialogs": [
              "732120903"
            ]
          },
          "732120903": {
            "id": "732120903",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why is it that every bad guy wants to mess with us? Is it because we look soft?",
            "nextDialogs": [
              "732120904"
            ]
          },
          "732120904": {
            "id": "732120904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They claimed to be sent by Jeht...",
            "nextDialogs": [
              "732120905"
            ]
          },
          "732120905": {
            "id": "732120905",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "732120906"
            ]
          },
          "732120906": {
            "id": "732120906",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Do you believe them?",
            "nextDialogs": [
              "732120907"
            ]
          },
          "732120907": {
            "id": "732120907",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't think Jeht has a reason to do this.",
            "nextDialogs": [
              "732120908"
            ]
          },
          "732120908": {
            "id": "732120908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But she might be wrapped up in something big...",
            "nextDialogs": [
              "732120909"
            ]
          },
          "732120909": {
            "id": "732120909",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah... Paimon doesn't think Jeht would do this either... But, what should we do now?",
            "nextDialogs": [
              "732120910"
            ]
          },
          "732120910": {
            "id": "732120910",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The people who just ambushed us knew Jeht, which means that they must know people amongst the Tanit as well...",
            "nextDialogs": [
              "732120911"
            ]
          },
          "732120911": {
            "id": "732120911",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You mean that if we return to the tribe, we'll catch their attention? Paimon doesn't think they'll just let this go.",
            "nextDialogs": [
              "732120912"
            ]
          },
          "732120912": {
            "id": "732120912",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And Jeht... Paimon's not suspecting her, but the people who tried to kill us might be hiding within the tribe. Maybe we should leave for a while...",
            "nextDialogs": [
              "732120913"
            ]
          },
          "732120913": {
            "id": "732120913",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "If we leave, Jeht might be in danger.",
            "nextDialogs": [
              "732120914"
            ]
          },
          "732120914": {
            "id": "732120914",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah... We can't just leave her.",
            "nextDialogs": [
              "732120915"
            ]
          },
          "732120915": {
            "id": "732120915",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's go back first. But don't mention Jeht.",
            "nextDialogs": [
              "732120916"
            ]
          },
          "732120916": {
            "id": "732120916",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? But...",
            "nextDialogs": [
              "732120917"
            ]
          },
          "732120917": {
            "id": "732120917",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmph! Paimon's not scared! If you've decided, then that's how we'll do it!"
          }
        }
      }
    },
    {
      "subId": "7321210",
      "subQuestName": "Report your findings back to Yuften",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732121001"
        ],
        "dialogs": {
          "732121001": {
            "id": "732121001",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "Y—y—you're back?",
            "nextDialogs": [
              "732121002"
            ]
          },
          "732121002": {
            "id": "732121002",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What? Something strange about us coming back?",
            "nextDialogs": [
              "732121003"
            ]
          },
          "732121003": {
            "id": "732121003",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "N—N—No. I'm v—very pleased th—that you h—have returned, e—esteemed Master of the Jinni.",
            "nextDialogs": [
              "732121004"
            ]
          },
          "732121004": {
            "id": "732121004",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "R—right. Ab—abo—about the c—caravan. How did y—your investigation... go?",
            "nextDialogs": [
              "732121005"
            ]
          },
          "732121005": {
            "id": "732121005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The caravan got ambushed. The goods have been taken.",
            "nextDialogs": [
              "732121006"
            ]
          },
          "732121006": {
            "id": "732121006",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "Cu—curses! It's those traitors again! I—I—I just kn—know it!",
            "nextDialogs": [
              "732121007"
            ]
          },
          "732121007": {
            "id": "732121007",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Traitors...",
            "nextDialogs": [
              "732121008"
            ]
          },
          "732121008": {
            "id": "732121008",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "Th—Th—Those traitors! Those northerner colluding dogs!",
            "nextDialogs": [
              "732121009"
            ]
          },
          "732121009": {
            "id": "732121009",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "A—aside from this, wh—what else ha—have you uncovered?",
            "nextDialogs": [
              "732121010"
            ]
          },
          "732121010": {
            "id": "732121010",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We were ambushed by the Eremites.",
            "nextDialogs": [
              "732121011"
            ]
          },
          "732121011": {
            "id": "732121011",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah. Just as we finished investigating what happened to the caravan, the Eremites showed up to ambush us! They also said...",
            "nextDialogs": [
              "732121012"
            ]
          },
          "732121012": {
            "id": "732121012",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They also said that they knew us.",
            "nextDialogs": [
              "732121013"
            ]
          },
          "732121013": {
            "id": "732121013",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Right... That too!",
            "nextDialogs": [
              "732121014"
            ]
          },
          "732121014": {
            "id": "732121014",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "...",
            "nextDialogs": [
              "732121015"
            ]
          },
          "732121015": {
            "id": "732121015",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "I—if—if that's the c—case... Th—then they might be onto you as well.",
            "nextDialogs": [
              "732121016"
            ]
          },
          "732121016": {
            "id": "732121016",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "H—Here is your pa—payment. P—Please go see Matriarch B—Babel about th—this matter as s—soon as possible!",
            "nextDialogs": [
              "732121017"
            ]
          },
          "732121017": {
            "id": "732121017",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Right.",
            "nextDialogs": [
              "732121018"
            ]
          },
          "732121018": {
            "id": "732121018",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "Fa—farewell, esteemed Master of the Jinni."
          }
        }
      }
    },
    {
      "subId": "7321211",
      "subQuestName": "Report your findings to Babel",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732121101"
        ],
        "dialogs": {
          "732121101": {
            "id": "732121101",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Greetings, esteemed Master of the Jinni. Is there something you need?",
            "nextDialogs": [
              "732121102"
            ]
          },
          "732121102": {
            "id": "732121102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yuften's caravan got raided by some of your traitors.",
            "nextDialogs": [
              "732121103"
            ]
          },
          "732121103": {
            "id": "732121103",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Truly... Well, it's not unexpected. The northerners from the snowlands have long tried to push into our lands. The treacherous amongst our number fell prey to their words and turned against us.",
            "nextDialogs": [
              "732121104"
            ]
          },
          "732121104": {
            "id": "732121104",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "These traitors have been causing havoc for quite some time. Sporadic but persistent raids and robberies have been happening since a few months ago...",
            "nextDialogs": [
              "732121105"
            ]
          },
          "732121105": {
            "id": "732121105",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Oh... Apologies, I didn't mean to interrupt. Please continue.",
            "nextDialogs": [
              "732121106"
            ]
          },
          "732121106": {
            "id": "732121106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The traitors have also taken an interest in us.",
            "nextDialogs": [
              "732121107"
            ]
          },
          "732121107": {
            "id": "732121107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah. Just as we finished investigating the caravan, thugs from the Eremites ambushed us.",
            "nextDialogs": [
              "732121108"
            ]
          },
          "732121108": {
            "id": "732121108",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Is that the case... How vile.",
            "nextDialogs": [
              "732121109"
            ]
          },
          "732121109": {
            "id": "732121109",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "It appears that... with Aderfi and Azariq both gone, these wild dogs see this as high time to bare their teeth.",
            "nextDialogs": [
              "732121110"
            ]
          },
          "732121110": {
            "id": "732121110",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "How about this? Please wait here and rest. I will handle all matters regarding your safety.",
            "nextDialogs": [
              "732121111"
            ]
          },
          "732121111": {
            "id": "732121111",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Jeht is still outside fulfilling her duties to the tribe. I will have her work alongside you to get to the bottom of this matter.",
            "nextDialogs": [
              "732121112"
            ]
          },
          "732121112": {
            "id": "732121112",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "And before that, I will do my utmost to find the assassins who sought you dead... I ask for only patience in return.",
            "nextDialogs": [
              "732121113"
            ]
          },
          "732121113": {
            "id": "732121113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uhh... Oh, one more thing! The bad guys that jumped us seemed to know us! They might be from the tribe!",
            "nextDialogs": [
              "732121114"
            ]
          },
          "732121114": {
            "id": "732121114",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "It's not impossible... But it matters little. With your privileges as esteemed guests, you will be protected... So long as you stay here, no one can hurt you.",
            "nextDialogs": [
              "732121115"
            ]
          },
          "732121115": {
            "id": "732121115",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "If anyone of the Tanit seeks to trouble you, whoever they are, they will face judgment at my hands, under my authority as Matriarch.",
            "nextDialogs": [
              "732121116"
            ]
          },
          "732121116": {
            "id": "732121116",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Please, rest. I will pursue the matter of the traitors to the fullest of my ability.",
            "nextDialogs": [
              "732121117"
            ]
          },
          "732121117": {
            "id": "732121117",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Additionally, I will keep watch for Jeht on your behalf. I will notify you the moment she returns.",
            "nextDialogs": [
              "732121118"
            ]
          },
          "732121118": {
            "id": "732121118",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Alright! Thanks a lot, Matriarch Babel.",
            "nextDialogs": [
              "732121119"
            ]
          },
          "732121119": {
            "id": "732121119",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "The courtesy is unneeded."
          }
        }
      }
    },
    {
      "subId": "7321203",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732120301"
        ],
        "dialogs": {
          "732120301": {
            "id": "732120301",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "H—h—how's your search going?",
            "nextDialogs": [
              "732120302"
            ]
          },
          "732120302": {
            "id": "732120302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're still looking for the caravan.",
            "nextDialogs": [
              "732120303"
            ]
          },
          "732120303": {
            "id": "732120303",
            "speakerId": 1000,
            "speakerName": "Yuften",
            "text": "Pl—p—please find them. I beg you."
          }
        }
      }
    },
    {
      "subId": "7321204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732120401"
        ],
        "dialogs": {
          "732120401": {
            "id": "732120401",
            "speakerId": 1006,
            "speakerName": "Jeht",
            "text": "#{NICKNAME}! How have you been!",
            "nextDialogs": [
              "732120402"
            ]
          },
          "732120402": {
            "id": "732120402",
            "speakerId": 1006,
            "speakerName": "Jeht",
            "text": "Thanks for adventuring with me. I... about my parents... Thanks.",
            "nextDialogs": [
              "732120403"
            ]
          },
          "732120403": {
            "id": "732120403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's no need.",
            "nextDialogs": [
              "732120404"
            ]
          },
          "732120404": {
            "id": "732120404",
            "speakerId": 1006,
            "speakerName": "Jeht",
            "text": "Yeah. If Babel didn't have me doing commissions for other assignments, I would be exploring the desert right alongside you.",
            "nextDialogs": [
              "732120405"
            ]
          },
          "732120405": {
            "id": "732120405",
            "speakerId": 1006,
            "speakerName": "Jeht",
            "text": "I still know plenty of cool places! When I find the time, I'll show them to you!",
            "nextDialogs": [
              "732120406"
            ]
          },
          "732120406": {
            "id": "732120406",
            "speakerId": 1006,
            "speakerName": "Jeht",
            "text": "It's just... now's not the time. The cursed traitors are colluding with the northerners, eyeing our territory. I've got to keep on their movements."
          }
        }
      }
    },
    {
      "subId": "7321217",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732121701"
        ],
        "dialogs": {
          "732121701": {
            "id": "732121701",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Greetings, esteemed Master of the Jinni.",
            "nextDialogs": [
              "732121702"
            ]
          },
          "732121702": {
            "id": "732121702",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Regarding the attempt on your life, rest assured, I am still investigating.",
            "nextDialogs": [
              "732121703"
            ]
          },
          "732121703": {
            "id": "732121703",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "I can promise your safety when you are amongst the Tanit, but should you walk the desert sands... Be very careful.",
            "nextDialogs": [
              "732121705",
              "732121712",
              "732121715",
              "732121722"
            ]
          },
          "732121705": {
            "id": "732121705",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Allow me to offer my deepest thanks on behalf of the Tanit and Jeht herself for your deeds...",
            "nextDialogs": [
              "732121706"
            ]
          },
          "732121706": {
            "id": "732121706",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "The Eternal Oasis not only bears great importance to Jeht, but it also stands as a central pillar of our faith.",
            "nextDialogs": [
              "732121707"
            ]
          },
          "732121707": {
            "id": "732121707",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Claiming the Eternal Oasis means claiming the sovereignty that once belonged to the Queen of All Oases, Nabu Malikata... For her descendants, this inheritance means everything.",
            "nextDialogs": [
              "732121708"
            ]
          },
          "732121708": {
            "id": "732121708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't quite understand... Just what is it actually worth?",
            "nextDialogs": [
              "732121709"
            ]
          },
          "732121709": {
            "id": "732121709",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Hahaha. Perhaps it can't even be traded for a single coin...",
            "nextDialogs": [
              "732121710"
            ]
          },
          "732121710": {
            "id": "732121710",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "But it is beyond value nonetheless."
          },
          "732121712": {
            "id": "732121712",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Yes. As we now hold the Eternal Oasis, we must prevent all with dubious intent from ever breaching its thresholds. The Tanit stands now as defenders of the Eternal Oasis.",
            "nextDialogs": [
              "732121713"
            ]
          },
          "732121713": {
            "id": "732121713",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "And the one most suited to complete this task is, to my mind, undoubtedly Jeht. She is guarding her parents, is she not?"
          },
          "732121715": {
            "id": "732121715",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "I suppose it is due to the fact that we have opened a path to the Eternal Oasis that has caused these traitors to grow restless.",
            "nextDialogs": [
              "732121716"
            ]
          },
          "732121716": {
            "id": "732121716",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Our goddess, to them, is a symbol of status above all others, and might bring them unfathomable wealth... I cannot tolerate such blasphemy."
          },
          "732121722": {
            "id": "732121722",
            "speakerId": 1005,
            "speakerName": "Babel",
            "text": "Farewell, esteemed Master of the Jinni."
          }
        }
      }
    },
    {
      "subId": "7321299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732129901"
        ],
        "dialogs": {
          "732129901": {
            "id": "732129901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "According to the marks on the map from Yuften, this must be the right place!",
            "nextDialogs": [
              "732129902"
            ]
          },
          "732129902": {
            "id": "732129902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's have a look around, maybe the caravan has left some clues!",
            "nextDialogs": [
              "732129904"
            ]
          },
          "732129904": {
            "id": "732129904",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Look, what's that over there?",
            "nextDialogs": [
              "732129905"
            ]
          },
          "732129905": {
            "id": "732129905",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! Look, over there! It's a rug...",
            "nextDialogs": [
              "732129906"
            ]
          },
          "732129906": {
            "id": "732129906",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Over there! It's a cart! We've found the caravan!",
            "nextDialogs": [
              "732129907"
            ]
          },
          "732129907": {
            "id": "732129907",
            "speakerId": 1007,
            "speakerName": "Eremite Assassin",
            "text": "We've also been commissioned to complete a task. You should empathize. Why must you make things so difficult?"
          }
        }
      }
    }
  ]
}
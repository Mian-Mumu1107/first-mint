    {
      "subId": "1501799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150179901"
        ],
        "dialogs": {
          "150179901": {
            "id": "150179901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The tracks end at this cliff... Could the Tepetlisaur have climbed up the mountain?",
            "nextDialogs": [
              "150179902"
            ]
          },
          "150179902": {
            "id": "150179902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's head up there and see."
          }
        }
      }

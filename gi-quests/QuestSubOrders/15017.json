  "subQuests": [
    {
      "subId": "1501701",
      "subQuestName": "Talk to Cheven",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150170101"
        ],
        "dialogs": {
          "150170101": {
            "id": "150170101",
            "speakerId": 1000,
            "speakerName": "Cheven",
            "text": "Oh, you're early! Looking forward to your gift?",
            "nextDialogs": [
              "150170103",
              "150170106"
            ]
          },
          "150170103": {
            "id": "150170103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's right! Nechca's been so sick, and Tlazolli had to give up what she loves...",
            "nextDialogs": [
              "150170104"
            ]
          },
          "150170104": {
            "id": "150170104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Things might be getting better, but they could probably still use some cheering up.",
            "nextDialogs": [
              "150170109"
            ]
          },
          "150170109": {
            "id": "150170109",
            "speakerId": 1000,
            "speakerName": "Cheven",
            "text": "Haha, I've already asked someone to swing by and let Tlazolli know we're coming. She's probably made all the necessary preparations.",
            "nextDialogs": [
              "150170110"
            ]
          },
          "150170110": {
            "id": "150170110",
            "speakerId": 1000,
            "speakerName": "Cheven",
            "text": "Let's go, then. Do you mind watching the store, Imix? I'll be right back."
          },
          "150170106": {
            "id": "150170106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon too... But we're also here to see how Nechca's doing.",
            "nextDialogs": [
              "150170107"
            ]
          },
          "150170107": {
            "id": "150170107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It can't be easy to recover from such a serious illness. And then there's Tlazolli...",
            "nextDialogs": [
              "150170108"
            ]
          },
          "150170108": {
            "id": "150170108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "She had to give up what she loves... We just want to cheer them up!"
          }
        }
      }
    },
    {
      "subId": "1501702",
      "subQuestName": "Go visit Tlazolli with Cheven",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150170201"
        ],
        "dialogs": {
          "150170201": {
            "id": "150170201",
            "speakerId": 1000,
            "speakerName": "Cheven",
            "text": "Here we are. Nice house, right? Gimme a sec, I'll go knock.",
            "nextDialogs": [
              "150170202"
            ]
          },
          "150170202": {
            "id": "150170202",
            "speakerId": 1000,
            "speakerName": "Cheven",
            "text": "Tlazolli, open up! They're here!",
            "nextDialogs": [
              "150170203"
            ]
          },
          "150170203": {
            "id": "150170203",
            "speakerId": 1000,
            "speakerName": "Cheven",
            "text": "...Tlazolli? Are you home? Open the door!",
            "nextDialogs": [
              "150170204"
            ]
          },
          "150170204": {
            "id": "150170204",
            "speakerId": 1000,
            "speakerName": "Cheven",
            "text": "That's strange... Huh, the door's locked, but she shouldn't be out at this time of day.",
            "nextDialogs": [
              "150170205"
            ]
          },
          "150170205": {
            "id": "150170205",
            "speakerId": 1000,
            "speakerName": "Cheven",
            "text": "Hey, Nechca? Nechca? It's me, Cheven. Open up, please.",
            "nextDialogs": [
              "150170210",
              "150170208"
            ]
          },
          "150170210": {
            "id": "150170210",
            "speakerId": 1000,
            "speakerName": "Cheven",
            "text": "Still, I told Tlazolli we were coming... Maybe she had to take Nechca out to get some medicine?",
            "nextDialogs": [
              "150170211"
            ]
          },
          "150170211": {
            "id": "150170211",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, what's that over there? Looks like a Tepetlisaur nest.",
            "nextDialogs": [
              "150170212"
            ]
          },
          "150170212": {
            "id": "150170212",
            "speakerId": 1000,
            "speakerName": "Cheven",
            "text": "That's right. Tlazolli has a Tepetlisaur companion. If I remember right, its name is... Iengu?",
            "nextDialogs": [
              "150170213"
            ]
          },
          "150170213": {
            "id": "150170213",
            "speakerId": 1000,
            "speakerName": "Cheven",
            "text": "When she was still in the forging business, she'd often have Iengu help with some digging work.",
            "nextDialogs": [
              "150170214"
            ]
          },
          "150170214": {
            "id": "150170214",
            "speakerId": 1000,
            "speakerName": "Cheven",
            "text": "But since Nechca fell ill, she hasn't let it dig much recently...",
            "nextDialogs": [
              "150170215"
            ]
          },
          "150170215": {
            "id": "150170215",
            "speakerId": 1000,
            "speakerName": "Cheven",
            "text": "Wait a minute. What the...? This place is a mess! Iengu's nowhere to be seen, either.",
            "nextDialogs": [
              "150170216"
            ]
          },
          "150170216": {
            "id": "150170216",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa, look at all these broken boxes! Something terrible must have happened..."
          },
          "150170208": {
            "id": "150170208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What if something happened to the two of them? What if Nechca got worse again...",
            "nextDialogs": [
              "150170209"
            ]
          },
          "150170209": {
            "id": "150170209",
            "speakerId": 1000,
            "speakerName": "Cheven",
            "text": "Let's not overthink things. They were doing just fine the last time I was here. Nechca was sleeping soundly in her room."
          }
        }
      }
    },
    {
      "subId": "1501703",
      "subQuestName": "Look for clues related to Tlazolli or Iengu",

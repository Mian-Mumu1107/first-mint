          "191823701": {
            "id": "191823701",
            "speakerId": 1002,
            "speakerName": "Investigation Notes",
            "text": "(There are newspaper clippings in amongst the notes. They're about shows of different styles. Those on the first few pages have turned yellow, which means they must be quite old.)",
            "nextDialogs": [
              "191823702"
            ]
          },
          "191823702": {
            "id": "191823702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "[Investigation] (Look for mentions of Merieux.)"
          }

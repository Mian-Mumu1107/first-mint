      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191824501"
        ],
        "dialogs": {
          "191824501": {
            "id": "191824501",
            "speakerId": 1004,
            "speakerName": "Investigate Official Script",
            "text": "(In Act IV, the protagonist loses the ability to dance due to wear-and-tear in her circuitry. There's a note saying: \"Some cursory movements to get the point across will suffice. The audience's focus will be on the fancy set and the extras.\")"
          }
        }
      }
    },

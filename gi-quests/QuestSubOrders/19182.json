    {
      "subId": "1918204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191820425"
        ],
        "dialogs": {
          "191820425": {
            "id": "191820425",
            "speakerId": 1006,
            "speakerName": "Furina",
            "text": "I'm an outsider to this show, so it's not my place to compare the final production to earlier drafts of the script. I'll be careful to put any initial impression I had after reading it to one side when I'm reviewing the show on the record.",
            "nextDialogs": [
              "191820426"
            ]
          },
          "191820426": {
            "id": "191820426",
            "speakerId": 1006,
            "speakerName": "Furina",
            "text": "Hmm... Yes, the only people qualified to compare the stage show and the script are the cast and crew. Or maybe Merieux alone."
          }
        }
      }
    },

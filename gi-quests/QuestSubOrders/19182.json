    },
    {
      "subId": "1918239",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191823901"
        ],
        "dialogs": {
          "191823901": {
            "id": "191823901",
            "speakerId": 1002,
            "speakerName": "Investigation Notes",
            "text": "(Merieux's name does appear in some earlier clippings, but mostly in articles bemoaning \"A Series of Lukewarm Receptions for an Experimental Art Form\" and \"Empty Seats at Avant-Garde Play Despite Critical Acclaim\"...)",
            "nextDialogs": [
              "191823902"
            ]
          },
          "191823902": {
            "id": "191823902",
            "speakerId": 1002,
            "speakerName": "Investigation Notes",
            "text": "(In more recent years, there are many reports praising Merieux as a forward-thinking director, one of the greats of his era...)",
            "nextDialogs": [
              "191823903"
            ]
          },
          "191823903": {
            "id": "191823903",
            "speakerId": 1002,
            "speakerName": "Investigation Notes",
            "text": "(The articles are written by a variety of authors from an eclectic range of fields. Corentin and Amaury are the most prolific authors.)"
          }
        }
      }
    },
    {
      "subId": "1918240",
      "subQuestName": "Additional",

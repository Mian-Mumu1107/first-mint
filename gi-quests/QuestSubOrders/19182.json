          "191820298": {
            "id": "191820298",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Think back to what was happening on the first floor while we were taking some time out...)",
            "nextDialogs": [
              "191820299"
            ]
          },
          "191820299": {
            "id": "191820299",

        "dialogs": {
          "191824801": {
            "id": "191824801",
            "speakerId": 1000,
            "speakerName": "Investigate Original Script",
            "text": "(Act IV seems to be a solo performance by the protagonist, and the set is just some decrepit ruins. There's a note saying: \"This will focus the audience's attention on the solo performer.\")"

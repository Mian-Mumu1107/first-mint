  "subQuests": [
    {
      "subId": "2202501",
      "subQuestName": "Talk to Tang Wen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220250101"
        ],
        "dialogs": {
          "220250101": {
            "id": "220250101",
            "speakerId": 1000,
            "speakerName": "Tang Wen",
            "text": "Ah... I'm so hungry... I don't feel good...",
            "nextDialogs": [
              "220250102"
            ]
          },
          "220250102": {
            "id": "220250102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "220250103"
            ]
          },
          "220250103": {
            "id": "220250103",
            "speakerId": 1000,
            "speakerName": "Tang Wen",
            "text": "I-I'm not sure... I just feel quite sluggish.",
            "nextDialogs": [
              "220250104"
            ]
          },
          "220250104": {
            "id": "220250104",
            "speakerId": 1000,
            "speakerName": "Tang Wen",
            "text": "It was probably last night, when I brought home and ate that gourmet meal you made.",
            "nextDialogs": [
              "220250105"
            ]
          },
          "220250105": {
            "id": "220250105",
            "speakerId": 1000,
            "speakerName": "Tang Wen",
            "text": "Although that dish was... quite special, but it at least filled my stomach.",
            "nextDialogs": [
              "220250106"
            ]
          },
          "220250106": {
            "id": "220250106",
            "speakerId": 1000,
            "speakerName": "Tang Wen",
            "text": "I then wanted to have a good night's sleep and work well today, but...",
            "nextDialogs": [
              "220250107"
            ]
          },
          "220250107": {
            "id": "220250107",
            "speakerId": 1000,
            "speakerName": "Tang Wen",
            "text": "Every time I'm about to fall asleep, the interesting smell of that dish suddenly came back up from the pit of my stomach! It instantly woke me up.",
            "nextDialogs": [
              "220250108"
            ]
          },
          "220250108": {
            "id": "220250108",
            "speakerId": 1000,
            "speakerName": "Tang Wen",
            "text": "This cycle then continued, and I lay half-asleep until the sun came up...",
            "nextDialogs": [
              "220250109"
            ]
          },
          "220250109": {
            "id": "220250109",
            "speakerId": 1000,
            "speakerName": "Tang Wen",
            "text": "It's not a big deal if it's just having less sleep. I occasionally have to work overtime in the past...",
            "nextDialogs": [
              "220250110"
            ]
          },
          "220250110": {
            "id": "220250110",
            "speakerId": 1000,
            "speakerName": "Tang Wen",
            "text": "The main point is what happened today! I thought I would be fine after I got up and ate something, but I didn't expect that even when I ate something, the taste of yesterday's dish still lingers in my mouth...",
            "nextDialogs": [
              "220250111"
            ]
          },
          "220250111": {
            "id": "220250111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is that dish so powerful...",
            "nextDialogs": [
              "220250112"
            ]
          },
          "220250112": {
            "id": "220250112",
            "speakerId": 1000,
            "speakerName": "Tang Wen",
            "text": "*sigh* I think...only a dish with a unique flavor can wash away that interesting taste...",
            "nextDialogs": [
              "220250113"
            ]
          },
          "220250113": {
            "id": "220250113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Dish with a unique flavor? Why don't we go around and ask others if they know of such a dish?",
            "nextDialogs": [
              "220250114"
            ]
          },
          "220250114": {
            "id": "220250114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Then we can make one for Miss Tang Wen... Maybe that will solve her problem!",
            "nextDialogs": [
              "220250115"
            ]
          },
          "220250115": {
            "id": "220250115",
            "speakerId": 1000,
            "speakerName": "Tang Wen",
            "text": "Really? That's great, thank you so much! If-if it's convenient, please head to Ritou and ask...",
            "nextDialogs": [
              "220250116"
            ]
          },
          "220250116": {
            "id": "220250116",
            "speakerId": 1000,
            "speakerName": "Tang Wen",
            "text": "I remember... Li Xiao, a merchant of Ritou, is very knowledgeable about food, and Qiuyue of the Chuyu Trading Company, she can also be considered as an amateur gourmet!"
          }
        }
      }
    },
    {
      "subId": "2202502",
      "subQuestName": "Ask for Li Xiao's opinion",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220250201"
        ],
        "dialogs": {
          "220250201": {
            "id": "220250201",
            "speakerId": 1002,
            "speakerName": "Li Xiao",
            "text": "What's the matter? Ah... Miss Tang Wen.",
            "nextDialogs": [
              "220250207"
            ]
          },
          "220250207": {
            "id": "220250207",
            "speakerId": 1002,
            "speakerName": "Li Xiao",
            "text": "Loss of appetite... A strange taste in your mouth... Needs a special delicacy to salvage this situation?",
            "nextDialogs": [
              "220250202"
            ]
          },
          "220250202": {
            "id": "220250202",
            "speakerId": 1002,
            "speakerName": "Li Xiao",
            "text": "She actually met with such a difficulty... That's really quite tricky.",
            "nextDialogs": [
              "220250203"
            ]
          },
          "220250203": {
            "id": "220250203",
            "speakerId": 1002,
            "speakerName": "Li Xiao",
            "text": "But in my opinion, it doesn't have to be a particularly expensive dish. As long as the taste and flavor is unique, and it packs a punch, that should be enough...",
            "nextDialogs": [
              "220250204"
            ]
          },
          "220250204": {
            "id": "220250204",
            "speakerId": 1002,
            "speakerName": "Li Xiao",
            "text": "I suggest Jueyun Guoba! It has both a unique crunchy texture and a strong spicy flavor...",
            "nextDialogs": [
              "220250205"
            ]
          },
          "220250205": {
            "id": "220250205",
            "speakerId": 1002,
            "speakerName": "Li Xiao",
            "text": "It's been more than ten years since I first tasted Jueyun Guoba at Qingce Village, and I still think about it from time to time...",
            "nextDialogs": [
              "220250206"
            ]
          },
          "220250206": {
            "id": "220250206",
            "speakerId": 1002,
            "speakerName": "Li Xiao",
            "text": "I think if it's Jueyun Guoba, no matter what the problem is, it will be solved."
          }
        }
      }
    },
    {
      "subId": "2202503",
      "subQuestName": "Ask for Qiuyue's opinion",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220250301"
        ],
        "dialogs": {
          "220250301": {
            "id": "220250301",
            "speakerId": 1003,
            "speakerName": "Qiuyue",
            "text": "What is it? Hmm... Miss Tang Wen?",
            "nextDialogs": [
              "220250307"
            ]
          },
          "220250307": {
            "id": "220250307",
            "speakerId": 1003,
            "speakerName": "Qiuyue",
            "text": "A strange taste in your mouth, loss of appetite, don't really want to eat anything?",
            "nextDialogs": [
              "220250302"
            ]
          },
          "220250302": {
            "id": "220250302",
            "speakerId": 1003,
            "speakerName": "Qiuyue",
            "text": "Is it really because she ate something strange? You're not mistaken, right?",
            "nextDialogs": [
              "220250303"
            ]
          },
          "220250303": {
            "id": "220250303",
            "speakerId": 1003,
            "speakerName": "Qiuyue",
            "text": "Why does it sound more like she's just bloated? Hmm, let me think...",
            "nextDialogs": [
              "220250304"
            ]
          },
          "220250304": {
            "id": "220250304",
            "speakerId": 1003,
            "speakerName": "Qiuyue",
            "text": "Forget it, since there is no way to judge, there is only one dish that I can recommend, and that is — Bamboo Shoot Soup!",
            "nextDialogs": [
              "220250305"
            ]
          },
          "220250305": {
            "id": "220250305",
            "speakerId": 1003,
            "speakerName": "Qiuyue",
            "text": "The taste is savory, the meat is tender, and the flavor refreshing and appetizing. Most importantly, the soup can help in food digestion. Mmm! I wish I could have some right now.",
            "nextDialogs": [
              "220250306"
            ]
          },
          "220250306": {
            "id": "220250306",
            "speakerId": 1003,
            "speakerName": "Qiuyue",
            "text": "Believe me, all Tang Wen needs right now is Bamboo Shoot Soup!"
          }
        }
      }
    },
    {
      "subId": "2202504",
      "subQuestName": "Ask for Paimon's opinion",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220250401"
        ],
        "dialogs": {
          "220250401": {
            "id": "220250401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh no, we got different answers. Both Jueyun Guoba and Bamboo Shoot Soup are special dishes.",
            "nextDialogs": [
              "220250402"
            ]
          },
          "220250402": {
            "id": "220250402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What should we do? Paimon's so torn!",
            "nextDialogs": [
              "220250403"
            ]
          },
          "220250403": {
            "id": "220250403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do you think, Paimon?",
            "nextDialogs": [
              "220250404"
            ]
          },
          "220250404": {
            "id": "220250404",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? You're asking Paimon?",
            "nextDialogs": [
              "220250405"
            ]
          },
          "220250405": {
            "id": "220250405",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "If that's the case... If Paimon were to choose...",
            "nextDialogs": [
              "220250406"
            ]
          },
          "220250406": {
            "id": "220250406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon will choose Grilled Tiger Fish!",
            "nextDialogs": [
              "220250407"
            ]
          },
          "220250407": {
            "id": "220250407",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Grilled Tiger Fish sounds very courageous. If Miss Tang Wen eats this courage, her troubles will be solved, right?",
            "nextDialogs": [
              "220250410"
            ]
          },
          "220250410": {
            "id": "220250410",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oops, that's why Paimon should let you decide."
          }
        }
      }
    },

    {
      "subId": "2401504",
      "subQuestName": "Talk to Depierris",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240150401"
        ],
        "dialogs": {
          "240150401": {
            "id": "240150401",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "No, no... If I remove the lights and shadows here, what will that do to the layering on the painting?",
            "nextDialogs": [
              "240150402"
            ]
          },
          "240150402": {
            "id": "240150402",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "The power of expression in those colors is insufficient... and the contrast is not great either...",
            "nextDialogs": [
              "240150403"
            ]
          },
          "240150403": {
            "id": "240150403",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Ugh! Just a few elements removed, and the whole thing's a mess now!",
            "nextDialogs": [
              "240150406"
            ]
          },
          "240150406": {
            "id": "240150406",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Ah, it's you. It's good to see you again...",
            "nextDialogs": [
              "240150407"
            ]
          },
          "240150407": {
            "id": "240150407",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "I apologize for the misunderstanding — I was merely thinking about the issues with this picture, and I couldn't help but pace about...",
            "nextDialogs": [
              "240150408"
            ]
          },
          "240150408": {
            "id": "240150408",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "You might not be able to understand, but I simply cannot sit still when reflecting on problems.",
            "nextDialogs": [
              "240150409"
            ]
          },
          "240150409": {
            "id": "240150409",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "The longer I sit in place considering problems, the more frustrated I get. That's why I'm used to thinking as I pace.",
            "nextDialogs": [
              "240150410"
            ]
          },
          "240150410": {
            "id": "240150410",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "I allow my legs to carry me anywhere they will as I think, so long as they don't keep me in place.",
            "nextDialogs": [
              "240150411"
            ]
          },
          "240150411": {
            "id": "240150411",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "So... this happens often. Sorry for making you worry."
          }
        }
      }
    },
    {
      "subId": "2401505",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2401506",
      "subQuestName": "Talk to Depierris",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240150601"
        ],
        "dialogs": {
          "240150601": {
            "id": "240150601",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "*panting* Thank you... Really, thank you...",
            "nextDialogs": [
              "240150602"
            ]
          },
          "240150602": {
            "id": "240150602",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Seriously, I was just painting over here — but before I knew it, they had me surrounded!",
            "nextDialogs": [
              "240150603"
            ]
          },
          "240150603": {
            "id": "240150603",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "They attacked my painting so vigorously, you'd think they wanted to eat it or something!",
            "nextDialogs": [
              "240150604"
            ]
          },
          "240150604": {
            "id": "240150604",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "But I couldn't let them have it, of course, so I grabbed it and ran...",
            "nextDialogs": [
              "240150605"
            ]
          },
          "240150605": {
            "id": "240150605",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Didn't get far before they caught up, though — thank the Archons you were there to rescue me.",
            "nextDialogs": [
              "240150608"
            ]
          },
          "240150608": {
            "id": "240150608",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "A—Archons if I know! I've always used Whopperflower Nectar to make my paints — you know, the stuff you got for me previously?",
            "nextDialogs": [
              "240150609"
            ]
          },
          "240150609": {
            "id": "240150609",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "Wait... What if the paint was attracting them? No, that can't be — that nectar doesn't smell at all after I mix it into the paint!",
            "nextDialogs": [
              "240150610"
            ]
          },
          "240150610": {
            "id": "240150610",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "I daren't change the paint formula on the fly, either. Guess we'll have to find some other way...",
            "nextDialogs": [
              "240150611"
            ]
          },
          "240150611": {
            "id": "240150611",
            "speakerId": 5140,
            "speakerName": "Depierris",
            "text": "*cough* And here I thought that even the Whopperflowers could sense the beauty in my painting and wanted to come have a look at it."
          }
        }
      }
    },
    {
      "subId": "2401599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240159906"
        ],
        "dialogs": {
          "240159906": {
            "id": "240159906",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look up ahead! Depierris is just over there. C'mon!"
          }
        }
      }
    }
  ]
}
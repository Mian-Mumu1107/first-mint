    {
      "subId": "7904405",
      "subQuestName": "Discover the truth behind the curtain",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790440601"
        ],
        "dialogs": {
          "790440601": {
            "id": "790440601",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa! Why are there so many Water Droplets here... what are they doing gathered around that giant machine?",
            "nextDialogs": [
              "790440602"
            ]
          },
          "790440602": {
            "id": "790440602",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon's confused, what's this machine for? And where's Daiya?",
            "nextDialogs": [
              "790440603"
            ]
          },
          "790440603": {
            "id": "790440603",
            "speakerId": 1000,
            "speakerName": "Park Announcement Speaker",
            "text": "Welcome to the Three-Day Reverie! Surely, you must be confused by the scene unfolding before your eyes?",
            "nextDialogs": [
              "790440604"
            ]
          },
          "790440604": {
            "id": "790440604",
            "speakerId": 1000,
            "speakerName": "Park Announcement Speaker",
            "text": "Then allow us to demonstrate!",
            "nextDialogs": [
              "790440605"
            ]
          },
          "790440605": {
            "id": "790440605",
            "speakerId": 1000,
            "speakerName": "Park Announcement Speaker",
            "text": "C'mon, Loafer, stop napping! Now, Place 1, Action 2!",
            "nextDialogs": [
              "790440606"
            ]
          },
          "790440606": {
            "id": "790440606",
            "speakerId": 1000,
            "speakerName": "Park Announcement Speaker",
            "text": "\"Let us give thanks to fate, dear travelers, for your wanderings have finally brought you here!\"",
            "nextDialogs": [
              "790440607"
            ]
          },
          "790440607": {
            "id": "790440607",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Is that Water Droplet using the announcement speaker to... play a recording?",
            "nextDialogs": [
              "790440608"
            ]
          },
          "790440608": {
            "id": "790440608",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It sounds so familiar... where has Paimon heard it before?",
            "nextDialogs": [
              "790440611"
            ]
          },
          "790440611": {
            "id": "790440611",
            "speakerId": 1000,
            "speakerName": "Park Announcement Speaker",
            "text": "Hustler, you're up! Place 3, Action 7!",
            "nextDialogs": [
              "790440612"
            ]
          },
          "790440612": {
            "id": "790440612",
            "speakerId": 1003,
            "speakerName": "Narrator On Speaker",
            "text": "\"The Chief Mate that appears in front of the new recruits is dressed raggedly, covered in bandages from head to toe. It is readily apparent that they barely survived an intense battle not long ago...\"",
            "nextDialogs": [
              "790440613"
            ]
          },
          "790440613": {
            "id": "790440613",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon remembers! This is from \"The Black Nacre and the All-Devouring Kraken\"! This is the part right after we meet the Chief Mate!",
            "nextDialogs": [
              "790440614"
            ]
          },
          "790440614": {
            "id": "790440614",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The narration we heard then was also played like this... what amazing timing!",
            "nextDialogs": [
              "790440615"
            ]
          },
          "790440615": {
            "id": "790440615",
            "speakerId": 1000,
            "speakerName": "Park Announcement Speaker",
            "text": "The Harum-Scarum and Black Nacre are about to reach the pass where the treasure is hidden, hurry up and prep the scenery and props, don't you dare screw this up!",
            "nextDialogs": [
              "790440616"
            ]
          },
          "790440616": {
            "id": "790440616",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That Water Droplet is... operating that device? Paimon can't see how..."
          }
        }
      }
    }
  ]
}
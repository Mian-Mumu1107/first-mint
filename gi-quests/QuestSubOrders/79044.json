  "subQuests": [
    {
      "subId": "7904401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790440101"
        ],
        "dialogs": {
          "790440101": {
            "id": "790440101",
            "speakerId": 1000,
            "speakerName": "Park Announcement Speaker",
            "text": "Let us give thanks to fate, dear travelers, for your wanderings have finally brought you here!",
            "nextDialogs": [
              "790440102"
            ]
          },
          "790440102": {
            "id": "790440102",
            "speakerId": 1000,
            "speakerName": "Park Announcement Speaker",
            "text": "Surely you must be searching for a serendipitous encounter beyond your wildest dreams, an astonishing journey that is beyond your mundane imagination?",
            "nextDialogs": [
              "790440103"
            ]
          },
          "790440103": {
            "id": "790440103",
            "speakerId": 1000,
            "speakerName": "Park Announcement Speaker",
            "text": "Now, the opportunity for us to fulfill all of our desires has been laid before you, right here, right now!",
            "nextDialogs": [
              "790440104"
            ]
          },
          "790440104": {
            "id": "790440104",
            "speakerId": 1000,
            "speakerName": "Park Announcement Speaker",
            "text": "Dive into the brand new \"Daiya's Three-Day Reverie\"! Step onto the grand stage, and you can experience something beyond your wildest dreams!",
            "nextDialogs": [
              "790440105"
            ]
          },
          "790440105": {
            "id": "790440105",
            "speakerId": 1000,
            "speakerName": "Park Announcement Speaker",
            "text": "Swim freely in a pool of Mora... exorcise the phantoms haunting ancient castles... break free from the shackles of gravity...",
            "nextDialogs": [
              "790440106"
            ]
          },
          "790440106": {
            "id": "790440106",
            "speakerId": 1000,
            "speakerName": "Park Announcement Speaker",
            "text": "Whisper the passphrase: \"Take us to the world of reverie\" to declare your curiosity and passion, and begin your journey!",
            "nextDialogs": [
              "790440107"
            ]
          },
          "790440107": {
            "id": "790440107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, that speaker really knows how to work a crowd! Though Paimon didn't understand the details...",
            "nextDialogs": [
              "790440108"
            ]
          },
          "790440108": {
            "id": "790440108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Journey? Show? Stage? And something about... A pool of Mora!",
            "nextDialogs": [
              "790440111"
            ]
          },
          "790440111": {
            "id": "790440111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh! When you put it like that... Paimon's definitely heard of that kind of activity before.",
            "nextDialogs": [
              "790440112"
            ]
          },
          "790440112": {
            "id": "790440112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So, is the person making the announcement Daiya? She must be the director of the play.",
            "nextDialogs": [
              "790440113"
            ]
          },
          "790440113": {
            "id": "790440113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So if we register, we can become the characters of some of the plays?"
          }
        }
      }
    },
    {
      "subId": "7904402",
      "subQuestName": "Complete three shows:",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7904407",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790440701"
        ],
        "dialogs": {
          "790440701": {
            "id": "790440701",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... Wait, how come we didn't notice this secret door before?",
            "nextDialogs": [
              "790440702"
            ]
          },
          "790440702": {
            "id": "790440702",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oooh! Paimon knows! Let's say the passphrase again, then a new path will open!",
            "nextDialogs": [
              "790440703"
            ]
          },
          "790440703": {
            "id": "790440703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Together now!",
            "nextDialogs": [
              "790440704"
            ]
          },
          "790440704": {
            "id": "790440704",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Okay! We did it to register, and times like this are perfect to have a little ceremony!",
            "nextDialogs": [
              "790440705"
            ]
          },
          "790440705": {
            "id": "790440705",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You recite the passphrase together with Paimon: Take us to the world of reverie!",
            "nextDialogs": [
              "790440706"
            ]
          },
          "790440706": {
            "id": "790440706",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "With the clinking of machines, a door opens, revealing a tunnel."
          }
        }
      }
    },
    {
      "subId": "7904408",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790440801"
        ],
        "dialogs": {
          "790440801": {
            "id": "790440801",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon knew it! A hidden chamber, filled with secrets!",
            "nextDialogs": [
              "790440802"
            ]
          },
          "790440802": {
            "id": "790440802",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe! Ready or not, here we come!"
          }
        }
      }
    },

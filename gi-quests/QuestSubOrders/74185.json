        ],
        "dialogs": {
          "741850201": {
            "id": "741850201",
            "speakerId": 5326,
            "speakerName": "Este",
            "text": "The cattery is on the other side of the building. Just walk over and you'll see it."
          }
        }
      }
    },
    {
      "subId": "7418503",
      "subQuestName": "Bring Osse to the cattery",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741850301"
        ],
        "dialogs": {
          "741850301": {
            "id": "741850301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, this'll be your home from now on, Osse!",
            "nextDialogs": [
              "741850302"
            ]
          },
          "741850302": {
            "id": "741850302",
            "speakerId": 21431,
            "speakerName": "Osse",
            "text": "Meeeow?",
            "nextDialogs": [
              "741850303"
            ]
          },
          "741850303": {
            "id": "741850303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Still, it feels a bit weird. Cassiodor should've already left here, right? So who is Osse now?",
            "nextDialogs": [
              "741850304"
            ]
          },
          "741850304": {
            "id": "741850304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is it the original cat that hadn't been indwelt by Cassiodor, or is it the Monsieur Os that shared all those adventures with us...? Ugh, Paimon's brain is cramping up.",
            "nextDialogs": [
              "741850306",
              "741850308"
            ]
          },
          "741850306": {
            "id": "741850306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon doesn't get it at all...",
            "nextDialogs": [
              "741850309"
            ]
          },
          "741850309": {
            "id": "741850309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, we've found a new home for Osse now, too! If we've got time, maybe we can come play with him!",
            "nextDialogs": [
              "741850310"
            ]
          },
          "741850310": {
            "id": "741850310",
            "speakerId": 21431,
            "speakerName": "Osse",
            "text": "Meow meow!"
          },
          "741850308": {
            "id": "741850308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Though Paimon still doesn't get it, it does make a certain kind of sense..."
          }
        }
      }
    }
  ]

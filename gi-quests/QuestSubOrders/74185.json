  "subQuests": [
    {
      "subId": "7418501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741850101"
        ],
        "dialogs": {
          "741850101": {
            "id": "741850101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Este, we're back!",
            "nextDialogs": [
              "741850102"
            ]
          },
          "741850102": {
            "id": "741850102",
            "speakerId": 5326,
            "speakerName": "Este",
            "text": "Oh, if it isn't... Wait, no. Who are you?",
            "nextDialogs": [
              "741850103"
            ]
          },
          "741850103": {
            "id": "741850103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Huh? You can't have forgotten us already! We're {NICKNAME} and Paimon!",
            "nextDialogs": [
              "741850104"
            ]
          },
          "741850104": {
            "id": "741850104",
            "speakerId": 5326,
            "speakerName": "Este",
            "text": "#{NICKNAME} and Paimon... I have indeed heard tell of these names, but I could've sworn I heard them in a dream!",
            "nextDialogs": [
              "741850105"
            ]
          },
          "741850105": {
            "id": "741850105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh... But you were definitely awake then, Este! Also, while we were below, didn't we even see...",
            "nextDialogs": [
              "741850106"
            ]
          },
          "741850106": {
            "id": "741850106",
            "speakerId": 5326,
            "speakerName": "Este",
            "text": "*sigh* I dreamed that everyone in town was petrified, turned into statues of stone, leaving me utterly helpless and alone.",
            "nextDialogs": [
              "741850107"
            ]
          },
          "741850107": {
            "id": "741850107",
            "speakerId": 5326,
            "speakerName": "Este",
            "text": "Until finally, two brave heroes came and shouldered the burden of rescuing everyone... Could it be, that it was no dream at all?",
            "nextDialogs": [
              "741850110"
            ]
          },
          "741850110": {
            "id": "741850110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah. After all, everyone's back to normal now, aren't they?",
            "nextDialogs": [
              "741850111"
            ]
          },
          "741850111": {
            "id": "741850111",
            "speakerId": 5326,
            "speakerName": "Este",
            "text": "But it seems as though everyone had some very strange dreams indeed. Just what happened? Could we all have been hypnotized en masse?",
            "nextDialogs": [
              "741850112"
            ]
          },
          "741850112": {
            "id": "741850112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It would take us ages to explain it all properly... Just forget about the hypnosis thing for now!",
            "nextDialogs": [
              "741850113"
            ]
          },
          "741850113": {
            "id": "741850113",
            "speakerId": 5326,
            "speakerName": "Este",
            "text": "Oh? Speaking of hypnosis, you two even brought over a cat! It looks quite intelligent."
          }
        }
      }
    },
    {
      "subId": "7418502",
      "subQuestName": "Bring Osse to the cattery",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

    {
      "subId": "7302201",
      "subQuestName": "Look for Araphala",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730220101"
        ],
        "dialogs": {
          "730220101": {
            "id": "730220101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hi there!",
            "nextDialogs": [
              "730220102"
            ]
          },
          "730220102": {
            "id": "730220102",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "*snore* *snore*",
            "nextDialogs": [
              "730220103"
            ]
          },
          "730220103": {
            "id": "730220103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Hello—!",
            "nextDialogs": [
              "730220104"
            ]
          },
          "730220104": {
            "id": "730220104",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Mmm... Tasty fruits... *snore*",
            "nextDialogs": [
              "730220105"
            ]
          },
          "730220105": {
            "id": "730220105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, he's in deep slumber. Oh, right. Arapacati mentioned that <color=#00E1FFFF>the power of Dendro</color> should do the trick.",
            "nextDialogs": [
              "730220106"
            ]
          },
          "730220106": {
            "id": "730220106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Paimon will leave it to you, {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "7302202",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730220201"
        ],
        "dialogs": {
          "730220201": {
            "id": "730220201",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Oh? It's you. Long time no see.",
            "nextDialogs": [
              "730220202"
            ]
          },
          "730220202": {
            "id": "730220202",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Whoa, where am I? Is this a cave? Ugh... I'm feeling dizzy.",
            "nextDialogs": [
              "730220203"
            ]
          },
          "730220203": {
            "id": "730220203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Who are you? Why are you sleeping here?",
            "nextDialogs": [
              "730220204"
            ]
          },
          "730220204": {
            "id": "730220204",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Who am I... Ugh, so dizzy. Let me think... My name is...",
            "nextDialogs": [
              "730220205"
            ]
          },
          "730220205": {
            "id": "730220205",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "My name is Araphala! Hehe, I remember now...",
            "nextDialogs": [
              "730220206"
            ]
          },
          "730220206": {
            "id": "730220206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So you're Araphala! We were wondering where you'd gone... and here you were, sleeping in this cave the whole time!",
            "nextDialogs": [
              "730220207"
            ]
          },
          "730220207": {
            "id": "730220207",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "Araphala... You know my name...",
            "nextDialogs": [
              "730220208"
            ]
          },
          "730220208": {
            "id": "730220208",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "Eh? Nara!?",
            "nextDialogs": [
              "730220209"
            ]
          },
          "730220209": {
            "id": "730220209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He's wide awake now.",
            "nextDialogs": [
              "730220210"
            ]
          },
          "730220210": {
            "id": "730220210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Indeed he is.",
            "nextDialogs": [
              "730220211"
            ]
          },
          "730220211": {
            "id": "730220211",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "*sob* I'm not ready yet. Don't make porridge out of me...",
            "nextDialogs": [
              "730220212"
            ]
          },
          "730220212": {
            "id": "730220212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Why would anyone want to make porridge out of you!?",
            "nextDialogs": [
              "730220213"
            ]
          },
          "730220213": {
            "id": "730220213",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "M—My sister said that if I'm always half asleep like this, a bad Nara will take me and make porridge out of me...",
            "nextDialogs": [
              "730220215"
            ]
          },
          "730220215": {
            "id": "730220215",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "Waaah!!",
            "nextDialogs": [
              "730220216"
            ]
          },
          "730220216": {
            "id": "730220216",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hey! {NICKNAME}, don't make jokes like that! Araphala, no one will cook you!",
            "nextDialogs": [
              "730220218"
            ]
          },
          "730220218": {
            "id": "730220218",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "...Really?",
            "nextDialogs": [
              "730220219"
            ]
          },
          "730220219": {
            "id": "730220219",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really!",
            "nextDialogs": [
              "730220220"
            ]
          },
          "730220220": {
            "id": "730220220",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "Not kidding?",
            "nextDialogs": [
              "730220221"
            ]
          },
          "730220221": {
            "id": "730220221",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#No kidding! Anyway, Paimon's name is Paimon, and this tall Nara is {NICKNAME}. Arapacati sent us...",
            "nextDialogs": [
              "730220222"
            ]
          },
          "730220222": {
            "id": "730220222",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "Arapacati? Is she doing well? How long have I been here...",
            "nextDialogs": [
              "730220223"
            ]
          },
          "730220223": {
            "id": "730220223",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"How long,\" you say? Well, if Paimon recalls correctly...",
            "nextDialogs": [
              "730220224"
            ]
          },
          "730220224": {
            "id": "730220224",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh... Many, many moons ago, the seedlings sprouted from the earth, and became trees... How many Arapacatis tall were they again?"
          }
        }
      }
    },
    {
      "subId": "7302205",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730220501"
        ],
        "dialogs": {
          "730220501": {
            "id": "730220501",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "*snore* *snore*",
            "nextDialogs": [
              "730220502"
            ]
          },
          "730220502": {
            "id": "730220502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Araphala!",
            "nextDialogs": [
              "730220503"
            ]
          },
          "730220503": {
            "id": "730220503",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "Huh? Oh, it's Paimon.",
            "nextDialogs": [
              "730220504"
            ]
          },
          "730220504": {
            "id": "730220504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Yeah, we are here to tell you that {NICKNAME} has taken down the huge monster outside!",
            "nextDialogs": [
              "730220505"
            ]
          },
          "730220505": {
            "id": "730220505",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "#Whoa! I didn't expect Nara {NICKNAME} who looks smaller than the monster to be so strong!",
            "nextDialogs": [
              "730220508"
            ]
          },
          "730220508": {
            "id": "730220508",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "Alright, then let's go. Good Nara, let's eat fruits together."
          }
        }
      }
    },
    {
      "subId": "7302206",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730220601"
        ],
        "dialogs": {
          "730220601": {
            "id": "730220601",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "Okay, let's start cooking with the Unrivaled Fresh Fruits.",
            "nextDialogs": [
              "730220602"
            ]
          },
          "730220602": {
            "id": "730220602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's the difference between this \"Unrivaled Fresh Fruit\" and ordinary fruits?",
            "nextDialogs": [
              "730220603"
            ]
          },
          "730220603": {
            "id": "730220603",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "I understand. To Nara, all fruits may be the same, but they are different.",
            "nextDialogs": [
              "730220604"
            ]
          },
          "730220604": {
            "id": "730220604",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "Only strong trees can bear Unrivaled Fresh Fruits. Strong trees sing first when the wind blows.",
            "nextDialogs": [
              "730220605"
            ]
          },
          "730220605": {
            "id": "730220605",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "The bearings of the strong trees, these Unrivaled Fresh Fruits, are a blessing to us. That Nara friend said these fruits are so tasty they sing in your stomach.",
            "nextDialogs": [
              "730220606"
            ]
          },
          "730220606": {
            "id": "730220606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon can't wait to see what kind of delicacy will be made from them!",
            "nextDialogs": [
              "730220607"
            ]
          },
          "730220607": {
            "id": "730220607",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Araphala starts cooking right away...\\nHe divides the fruits equally...\\nThen, he gives a few portions to you and Paimon.",
            "nextDialogs": [
              "730220608"
            ]
          },
          "730220608": {
            "id": "730220608",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You try the fresh fruits together.\\nIt sort of lives up to your expectations. They do taste like fresh fruits.",
            "nextDialogs": [
              "730220609"
            ]
          },
          "730220609": {
            "id": "730220609",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "So good. Thank you, strong trees.",
            "nextDialogs": [
              "730220610"
            ]
          },
          "730220610": {
            "id": "730220610",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait! You call that cooking?",
            "nextDialogs": [
              "730220611"
            ]
          },
          "730220611": {
            "id": "730220611",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "The Unrivaled Fresh Fruit itself is the best Supreme Delicacy. It doesn't need any extra processing to present its best taste...",
            "nextDialogs": [
              "730220612"
            ]
          },
          "730220612": {
            "id": "730220612",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "Just taste it and you will understand.",
            "nextDialogs": [
              "730220613"
            ]
          },
          "730220613": {
            "id": "730220613",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It is tasty, but it's just... it's just like eating fruits...",
            "nextDialogs": [
              "730220614"
            ]
          },
          "730220614": {
            "id": "730220614",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It is a fruit after all.",
            "nextDialogs": [
              "730220615"
            ]
          },
          "730220615": {
            "id": "730220615",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, Paimon guesses so...",
            "nextDialogs": [
              "730220616"
            ]
          },
          "730220616": {
            "id": "730220616",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "Don't you Nara have a dish where you cut fruits and serve them on a wooden board too?",
            "nextDialogs": [
              "730220617"
            ]
          },
          "730220617": {
            "id": "730220617",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Do we? Wait! Are you talking about a fruit platter?",
            "nextDialogs": [
              "730220618"
            ]
          },
          "730220618": {
            "id": "730220618",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is a fruit platter considered a dish?",
            "nextDialogs": [
              "730220620",
              "730220622"
            ]
          },
          "730220620": {
            "id": "730220620",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It still seems a bit strange to Paimon...",
            "nextDialogs": [
              "730220623"
            ]
          },
          "730220623": {
            "id": "730220623",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "Oh, don't be a stickler for things like that. Finding better ingredients is a form of cooking too.",
            "nextDialogs": [
              "730220624"
            ]
          },
          "730220624": {
            "id": "730220624",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "While searching for ingredients, I can travel the forest and get closer to it. That's the true meaning of my cooking training.",
            "nextDialogs": [
              "730220625"
            ]
          },
          "730220625": {
            "id": "730220625",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is it?",
            "nextDialogs": [
              "730220626"
            ]
          },
          "730220626": {
            "id": "730220626",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "It sure is.",
            "nextDialogs": [
              "730220627"
            ]
          },
          "730220627": {
            "id": "730220627",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "I've picked Unrivaled Fresh Fruits and made my Supreme Delicacy. My cooking training is complete.",
            "nextDialogs": [
              "730220628"
            ]
          },
          "730220628": {
            "id": "730220628",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "I can return proudly to Vanarana.",
            "nextDialogs": [
              "730220629"
            ]
          },
          "730220629": {
            "id": "730220629",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "#Oh, I would've missed Festival Utsava if Nara {NICKNAME} and Paimon didn't take care of that huge monster that blocked me here in this cave.",
            "nextDialogs": [
              "730220630"
            ]
          },
          "730220630": {
            "id": "730220630",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright, hurry back to Vanarana!",
            "nextDialogs": [
              "730220631"
            ]
          },
          "730220631": {
            "id": "730220631",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "Indeed, indeed... Sister will scold me if I miss Festival Utsava... Just the thought of it is scary enough."
          },
          "730220622": {
            "id": "730220622",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right? It's kinda strange to call something that hasn't been, y'know, processed... a dish."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2502501",
      "subQuestName": "Talk to Pele Nui",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250250201"
        ],
        "dialogs": {
          "250250201": {
            "id": "250250201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe I can coax him out.",
            "nextDialogs": [
              "250250202"
            ]
          },
          "250250202": {
            "id": "250250202",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Well... Yeah, sure, why not? Maybe a change of pace is just what the doctor ordered, eh? Good luck, then.",
            "nextDialogs": [
              "250250203"
            ]
          },
          "250250203": {
            "id": "250250203",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Honestly, what's gotten into it? Before, I could just pat his <color=#00E1FFFF>head</color> or <color=#00E1FFFF>tummy</color>, and he'd just do what he was told..."
          }
        }
      }
    },
    {
      "subId": "2502504",
      "subQuestName": "Try communicating with the lazy little Koholasaurus",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250250401"
        ],
        "dialogs": {
          "250250401": {
            "id": "250250401",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "Hroo...? Rrroo, rroo...",
            "nextDialogs": [
              "250250403",
              "250250406",
              "250250409"
            ]
          },
          "250250403": {
            "id": "250250403",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "Rroo? Oroo! Hroooo—",
            "nextDialogs": [
              "250250404"
            ]
          },
          "250250404": {
            "id": "250250404",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "(The little Koholasaurus seems rather happy. He is sitting by the shore — you should be able to grab him and bring him up now...)",
            "nextDialogs": [
              "250250412"
            ]
          },
          "250250412": {
            "id": "250250412",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The little Koholasaurus finally quiets down. You carefully carry him up onto the shore..."
          },
          "250250406": {
            "id": "250250406",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "Hrooh? Rroooo—",
            "nextDialogs": [
              "250250407"
            ]
          },
          "250250407": {
            "id": "250250407",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "(The little Koholasaurus seems rather happy. He is sitting by the shore — you should be able to grab him and bring him up now...)"
          },
          "250250409": {
            "id": "250250409",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "Raar! Oroo, rrooh!",
            "nextDialogs": [
              "250250410"
            ]
          },
          "250250410": {
            "id": "250250410",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "(The little Koholasaurus seems quite unhappy, and he splashes water all over your face.)",
            "nextDialogs": [
              "250250411"
            ]
          },
          "250250411": {
            "id": "250250411",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "(The little Koholasaurus watches you expectantly. Time to find a different way to cajole him...)"
          }
        }
      }
    },
    {
      "subId": "2502511",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250251101"
        ],
        "dialogs": {
          "250251101": {
            "id": "250251101",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Well, you sure enjoyed yourself, huh? As for me, I need to go get changed...",
            "nextDialogs": [
              "250251102"
            ]
          },
          "250251102": {
            "id": "250251102",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "Hroo! Rooh—",
            "nextDialogs": [
              "250251103"
            ]
          },
          "250251103": {
            "id": "250251103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're all wet...",
            "nextDialogs": [
              "250251104"
            ]
          },
          "250251104": {
            "id": "250251104",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "*cough* He finally decided to listen — just needed to play with him for a bit, you know?",
            "nextDialogs": [
              "250251105"
            ]
          },
          "250251105": {
            "id": "250251105",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "You're done cleaning the spring over there? Thanks a lot, then. Here, take this as your reward.",
            "nextDialogs": [
              "250251106"
            ]
          },
          "250251106": {
            "id": "250251106",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Once I'm done cleaning the others, I'll need a change of clothes... Wait, where'd that kid run off to?",
            "nextDialogs": [
              "250251107"
            ]
          },
          "250251107": {
            "id": "250251107",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "Wrooh! Hroo—",
            "nextDialogs": [
              "250251108"
            ]
          },
          "250251108": {
            "id": "250251108",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Hey, get back here! The springs over there haven't been cleaned yet!",
            "nextDialogs": [
              "250251109"
            ]
          },
          "250251109": {
            "id": "250251109",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The little Koholasaurus jumps joyously toward the other hot spring, with the shouting Pele Nui in hot pursuit..."
          }
        }
      }
    },
    {
      "subId": "2502512",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250251201"
        ],
        "dialogs": {
          "250251201": {
            "id": "250251201",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Hmm? Why did he climb ashore by himself? Did he tire of playing?",
            "nextDialogs": [
              "250251202"
            ]
          },
          "250251202": {
            "id": "250251202",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "...Well, whatever the case, thanks so much for your help. Here, take your payment. I'll go get him something nice to eat now...",
            "nextDialogs": [
              "250251203"
            ]
          },
          "250251203": {
            "id": "250251203",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Huh? Where's he gone? H—He hasn't dived back into the hot springs again, has he?",
            "nextDialogs": [
              "250251204"
            ]
          },
          "250251204": {
            "id": "250251204",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "Hroo! Rroooh—",
            "nextDialogs": [
              "250251205"
            ]
          },
          "250251205": {
            "id": "250251205",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Hey, get back here! The springs over there haven't been cleaned yet!",
            "nextDialogs": [
              "250251206"
            ]
          },
          "250251206": {
            "id": "250251206",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The little Koholasaurus jumps joyously toward the other hot spring, with the shouting Pele Nui in hot pursuit..."
          }
        }
      }
    },
    {
      "subId": "2502505",
      "subQuestName": "Report back to Pele Nui",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250250701"
        ],
        "dialogs": {
          "250250701": {
            "id": "250250701",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Hahaha. Looks like the kid's fond of you. You convinced him to come along right away.",
            "nextDialogs": [
              "250250702"
            ]
          },
          "250250702": {
            "id": "250250702",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Thanks so much. Here's your payment. I'll go get him something nice to eat now...",
            "nextDialogs": [
              "250250703"
            ]
          },
          "250250703": {
            "id": "250250703",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Huh? Where's he gone? H—He hasn't dived back into the hot springs again, has he?",
            "nextDialogs": [
              "250250704"
            ]
          },
          "250250704": {
            "id": "250250704",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "Rooo! Wroo—",
            "nextDialogs": [
              "250250705"
            ]
          },
          "250250705": {
            "id": "250250705",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Hey, get back here! The springs over there haven't been cleaned yet!",
            "nextDialogs": [
              "250250706"
            ]
          },
          "250250706": {
            "id": "250250706",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The little Koholasaurus jumps joyously toward the other hot spring, with the shouting Pele Nui in hot pursuit..."
          }
        }
      }
    },
    {
      "subId": "2502503",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250250301"
        ],
        "dialogs": {
          "250250301": {
            "id": "250250301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I can help you clean the other springs.",
            "nextDialogs": [
              "250250302"
            ]
          },
          "250250302": {
            "id": "250250302",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Would you really? That'd be great, because I'm pretty overwhelmed here.",
            "nextDialogs": [
              "250250303"
            ]
          },
          "250250303": {
            "id": "250250303",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "In that case, uh, just start from that one over there.",
            "nextDialogs": [
              "250250304"
            ]
          },
          "250250304": {
            "id": "250250304",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "I already scrubbed the bottom a few days back, so all you need to do is clear the junk floating on the surface.",
            "nextDialogs": [
              "250250305"
            ]
          },
          "250250305": {
            "id": "250250305",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "I'm counting on you, then. I'll continue persuading this little fella.",
            "nextDialogs": [
              "250250306"
            ]
          },
          "250250306": {
            "id": "250250306",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "*sigh* Honestly, what's gotten into him? Before, I could just pat his head or tummy, and he'd just do what he was told..."
          }
        }
      }
    },
    {
      "subId": "2502506",

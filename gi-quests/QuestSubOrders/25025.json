    {
      "subId": "2502501",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250250101"
        ],
        "dialogs": {
          "250250101": {
            "id": "250250101",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Could you please come ashore, just for a bit? I need to clean up the springs over here.",
            "nextDialogs": [
              "250250102"
            ]
          },
          "250250102": {
            "id": "250250102",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "Roar...",
            "nextDialogs": [
              "250250103"
            ]
          },
          "250250103": {
            "id": "250250103",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Come on now, be a good boy! If not, I'm going to have to pick you up myself!",
            "nextDialogs": [
              "250250104"
            ]
          },
          "250250104": {
            "id": "250250104",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "Roar!",
            "nextDialogs": [
              "250250105"
            ]
          },
          "250250105": {
            "id": "250250105",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "And he's gone in a flash, just like that. Ugh, how am I going to get a hold of him now...",
            "nextDialogs": [
              "250250106"
            ]
          },
          "250250106": {
            "id": "250250106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you up to?",
            "nextDialogs": [
              "250250107"
            ]
          },
          "250250107": {
            "id": "250250107",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Hmm? You here for a hot spring bath? Sorry, but I'm in the middle of cleaning this pool here, so you might have to wait a moment.",
            "nextDialogs": [
              "250250108"
            ]
          },
          "250250108": {
            "id": "250250108",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Also, this lunk won't come up and out no matter what I say. *sigh* And I've got so many more pools to clean, too.",
            "nextDialogs": [
              "250250109"
            ]
          },
          "250250109": {
            "id": "250250109",
            "speakerId": 1000,
            "speakerName": "Pele Nui",
            "text": "Could he be throwing a tantrum because I carried him out a few days earlier? Seriously, what a pain..."
          }
        }
      }
    },
    {
      "subId": "2502505",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250250501"
        ],
        "dialogs": {
          "250250501": {
            "id": "250250501",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "Phew... New friend... Hoo...",
            "nextDialogs": [
              "250250503",
              "250250506",
              "250250509"
            ]
          },
          "250250503": {
            "id": "250250503",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "New friend! Hoo—",
            "nextDialogs": [
              "250250504"
            ]
          },
          "250250504": {
            "id": "250250504",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "(The little Koholasaurus seems rather happy. He is sitting by the shore...)",
            "nextDialogs": [
              "250250512"
            ]
          },
          "250250512": {
            "id": "250250512",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "Hoo, enough play. Rest...",
            "nextDialogs": [
              "250250513"
            ]
          },
          "250250513": {
            "id": "250250513",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The little Koholasaurus yawns and climbs ashore slowly..."
          },
          "250250506": {
            "id": "250250506",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "New friend! Hoo—",
            "nextDialogs": [
              "250250507"
            ]
          },
          "250250507": {
            "id": "250250507",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "(The little Koholasaurus seems rather happy. He is sitting by the shore...)"
          },
          "250250509": {
            "id": "250250509",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "No! Wanna play! No go!",
            "nextDialogs": [
              "250250510"
            ]
          },
          "250250510": {
            "id": "250250510",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "(The little Koholasaurus seems quite unhappy, and he splashes water all over your face.)",
            "nextDialogs": [
              "250250511"
            ]
          },
          "250250511": {
            "id": "250250511",
            "speakerId": 1001,
            "speakerName": "Lazy Koholasaurus",
            "text": "(The little Koholasaurus watches you expectantly. Time to find a different way to cajole him...)"
          }
        }
      }
    },

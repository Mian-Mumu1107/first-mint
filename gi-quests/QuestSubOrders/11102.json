    {
      "subId": "1110222",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111022201"
        ],
        "dialogs": {
          "111022201": {
            "id": "111022201",
            "speakerId": 10218,
            "speakerName": "Mercantile Believer",
            "text": "I can't believe that the Master of Stars wasn't powerful enough to defeat those hilichurls..."
          }
        }
      }
    },
    {
      "subId": "1110223",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111022301"
        ],
        "dialogs": {
          "111022301": {
            "id": "111022301",
            "speakerId": 10202,
            "speakerName": "Starsnatcher",
            "text": "One is merely feeling unwell. One hopes that you shall not spread these tidings wantonly..."
          }
        }
      }
    },
    {
      "subId": "1110224",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111022401"
        ],
        "dialogs": {
          "111022401": {
            "id": "111022401",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Finish your preparations, and we shall enter — we should not leave those monsters be for too long."
          }
        }
      }
    }
  ]

  "subQuests": [
    {
      "subId": "7109601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710960101"
        ],
        "dialogs": {
          "710960101": {
            "id": "710960101",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "Have you found the Archaic Stones?",
            "nextDialogs": [
              "710960102"
            ]
          },
          "710960102": {
            "id": "710960102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here they are."
          }
        }
      }
    },
    {
      "subId": "7109602",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710960201"
        ],
        "dialogs": {
          "710960201": {
            "id": "710960201",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "Three more.",
            "nextDialogs": [
              "710960202"
            ]
          },
          "710960202": {
            "id": "710960202",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "I shall gratefully take the Archaic Stones submitted by our two \"civic-minded citizens.\"",
            "nextDialogs": [
              "710960203"
            ]
          },
          "710960203": {
            "id": "710960203",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "I didn't expect you to find three of them so quickly. And they are much better in quality than the ones I've previously seen.",
            "nextDialogs": [
              "710960204"
            ]
          },
          "710960204": {
            "id": "710960204",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "*sigh*... They remind me of the one that I used to have.",
            "nextDialogs": [
              "710960205"
            ]
          },
          "710960205": {
            "id": "710960205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You have an Archaic Stone?",
            "nextDialogs": [
              "710960208"
            ]
          },
          "710960208": {
            "id": "710960208",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "I mean I USED to have one.",
            "nextDialogs": [
              "710960209"
            ]
          },
          "710960209": {
            "id": "710960209",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "My old man once handled a batch of ores at Shenglu Hall. That stone was just a leftover remnant and its quality was poor, so he gave it to me as a toy.",
            "nextDialogs": [
              "710960210"
            ]
          },
          "710960210": {
            "id": "710960210",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "We had been arguing all the time back then. I never had a job, and to make it worse, I spent most of my time at Yanshang Teahouse. As such, I ended up in heavy debt — and in distress too...",
            "nextDialogs": [
              "710960211"
            ]
          },
          "710960211": {
            "id": "710960211",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ah...",
            "nextDialogs": [
              "710960212"
            ]
          },
          "710960212": {
            "id": "710960212",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That feels a bit wrong...",
            "nextDialogs": [
              "710960213"
            ]
          },
          "710960213": {
            "id": "710960213",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "Well, who hasn't done a stupid thing or two when they were young? Anyway, when I was helpless...",
            "nextDialogs": [
              "710960214"
            ]
          },
          "710960214": {
            "id": "710960214",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "Someone recognized my Archaic Stone and offered a good price. To me, it was no big deal — a stone in exchange for some Mora to get me out of my immediate predicament. A fair trade I'd say.",
            "nextDialogs": [
              "710960215"
            ]
          },
          "710960215": {
            "id": "710960215",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "Yet my father brought this up the other day and asked, \"Muning, where did you put the stone that I gave you?\"",
            "nextDialogs": [
              "710960216"
            ]
          },
          "710960216": {
            "id": "710960216",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "All I could tell him was, \"It's just a stone. I've long lost it.\"",
            "nextDialogs": [
              "710960217"
            ]
          },
          "710960217": {
            "id": "710960217",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "Though I said so, I couldn't help wondering what if I hadn't sold the stone — then I could show it to Father when he mentioned it...",
            "nextDialogs": [
              "710960218"
            ]
          },
          "710960218": {
            "id": "710960218",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "...Forget it. It's no use wondering about the what-if now.",
            "nextDialogs": [
              "710960219"
            ]
          },
          "710960219": {
            "id": "710960219",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "At least the prodigal son has returned.",
            "nextDialogs": [
              "710960220"
            ]
          },
          "710960220": {
            "id": "710960220",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "You are right... It's just that I still have a long way to go before I can clear my debt.",
            "nextDialogs": [
              "710960221"
            ]
          },
          "710960221": {
            "id": "710960221",
            "speakerId": 1000,
            "speakerName": "Muning",
            "text": "I've digressed. If you find more, please bring them to me."
          }
        }
      }
    }
  ]
}
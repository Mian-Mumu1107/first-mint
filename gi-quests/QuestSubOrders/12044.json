    {
      "subId": "1204402",
      "subQuestName": "Go to Inazuma",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120440201"
        ],
        "dialogs": {
          "120440201": {
            "id": "120440201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ahh, remember when we chased that tanuki down this way? Good times!",
            "nextDialogs": [
              "120440202"
            ]
          },
          "120440202": {
            "id": "120440202",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? What's that?",
            "nextDialogs": [
              "120440205"
            ]
          },
          "120440205": {
            "id": "120440205",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon doesn't think they look anything like that... Oh, maybe there's a new kind of youkai in town?",
            "nextDialogs": [
              "120440206"
            ]
          },
          "120440206": {
            "id": "120440206",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Umm.... Is it trying to get us to follow it?"
          }
        }
      }
    },
    {
      "subId": "1204403",
      "subQuestName": "Follow the little youkai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120440301"
        ],
        "dialogs": {
          "120440301": {
            "id": "120440301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What's that girl doing over there?",
            "nextDialogs": [
              "120440302"
            ]
          },
          "120440302": {
            "id": "120440302",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "She doesn't look well... Let's go check on her.",
            "nextDialogs": [
              "120440801"
            ]
          },
          "120440801": {
            "id": "120440801",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What just happened? All we did was lock eyes with her for a split-second, and then...",
            "nextDialogs": [
              "120440802"
            ]
          },
          "120440802": {
            "id": "120440802",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, where did all these people come from? And what are they here for?",
            "nextDialogs": [
              "120440803"
            ]
          },
          "120440803": {
            "id": "120440803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Looks like they're waiting in line for some reason.",
            "nextDialogs": [
              "120440804"
            ]
          },
          "120440804": {
            "id": "120440804",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "True... Oh, and there's that girl! She's still here. Hmm, maybe she knows what happened?",
            "nextDialogs": [
              "120440805"
            ]
          },
          "120440805": {
            "id": "120440805",
            "speakerId": 1001,
            "speakerName": "Tejima",
            "text": "If I leave now, will I have enough time?",
            "nextDialogs": [
              "120440806"
            ]
          },
          "120440806": {
            "id": "120440806",
            "speakerId": 1002,
            "speakerName": "Shigeru",
            "text": "How many times do I have to explain?",
            "nextDialogs": [
              "120440807"
            ]
          },
          "120440807": {
            "id": "120440807",
            "speakerId": 1003,
            "speakerName": "Sanada",
            "text": "There's no going back if I report him. But still...",
            "nextDialogs": [
              "120440808"
            ]
          },
          "120440808": {
            "id": "120440808",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Hmm... anxiety over a lack of creative inspiration... Well, inspiration tends to give anxious minds a wide berth, so I hope our treatment will help you relax.",
            "nextDialogs": [
              "120440809"
            ]
          },
          "120440809": {
            "id": "120440809",
            "speakerId": 1005,
            "speakerName": "Wakamurasaki",
            "text": "...Thank you.",
            "nextDialogs": [
              "120440810"
            ]
          },
          "120440810": {
            "id": "120440810",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "...Remorse for the misdeeds of the past, and despair over the sorry state of the present... I can help you face your troubles with a more positive mindset, but you'll need to work through things in your own time, too.",
            "nextDialogs": [
              "120440811"
            ]
          },
          "120440811": {
            "id": "120440811",
            "speakerId": 1006,
            "speakerName": "Nishiguchi",
            "text": "...Many thanks.",
            "nextDialogs": [
              "120440812"
            ]
          },
          "120440812": {
            "id": "120440812",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Next please! *cough*...",
            "nextDialogs": [
              "120440813"
            ]
          },
          "120440813": {
            "id": "120440813",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What's wrong with her?",
            "nextDialogs": [
              "120440814"
            ]
          },
          "120440814": {
            "id": "120440814",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you alright?",
            "nextDialogs": [
              "120440815"
            ]
          },
          "120440815": {
            "id": "120440815",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "I'm fine. Next, please...",
            "nextDialogs": [
              "120440816"
            ]
          },
          "120440816": {
            "id": "120440816",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Um...",
            "nextDialogs": [
              "120440817"
            ]
          },
          "120440817": {
            "id": "120440817",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Mmm! Delicious!",
            "nextDialogs": [
              "120440818"
            ]
          },
          "120440818": {
            "id": "120440818",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa, that was unexpected...",
            "nextDialogs": [
              "120440819"
            ]
          },
          "120440819": {
            "id": "120440819",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Huh? What do we have here... *burp*! Oh no, I'm so sorry...",
            "nextDialogs": [
              "120440820"
            ]
          },
          "120440820": {
            "id": "120440820",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Sorry for what? We have no idea what's going on here, let alone what you're sorry for. Would you mind bringing us up to speed?",
            "nextDialogs": [
              "120440821"
            ]
          },
          "120440821": {
            "id": "120440821",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "It looks like you entered my dream by mistake. Let me wake you up, then I'll explain everything.",
            "nextDialogs": [
              "120440822"
            ]
          },
          "120440822": {
            "id": "120440822",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Dream? When did that—",
            "nextDialogs": [
              "120440901"
            ]
          },
          "120440901": {
            "id": "120440901",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa...",
            "nextDialogs": [
              "120440902"
            ]
          },
          "120440902": {
            "id": "120440902",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "#Hi! Feeling more awake now? Heh, I never expected {NICKNAME} to literally come to me in a dream.",
            "nextDialogs": [
              "120440903"
            ]
          },
          "120440903": {
            "id": "120440903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How do you know who I am?",
            "nextDialogs": [
              "120440904"
            ]
          },
          "120440904": {
            "id": "120440904",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Oh, someone I know talks about you all the time. Plus... I'm pretty good at profiling people based on their reputation.",
            "nextDialogs": [
              "120440905"
            ]
          },
          "120440905": {
            "id": "120440905",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So who are you?",
            "nextDialogs": [
              "120440906"
            ]
          },
          "120440906": {
            "id": "120440906",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Right, of course. It's our first time meeting each other, so I should introduce myself properly.",
            "nextDialogs": [
              "120440907"
            ]
          },
          "120440907": {
            "id": "120440907",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "My name is Yumemizuki Mizuki — or just \"Mizuki\" for short. I'm a yumekui-baku, which is a kind of youkai here in Inazuma.",
            "nextDialogs": [
              "120440908"
            ]
          },
          "120440908": {
            "id": "120440908",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yumekui-baku?",
            "nextDialogs": [
              "120440909"
            ]
          },
          "120440909": {
            "id": "120440909",
            "speakerId": 1008,
            "speakerName": "Little Baku",
            "text": "*hum*",
            "nextDialogs": [
              "120440910"
            ]
          },
          "120440910": {
            "id": "120440910",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, it's that little critter from before...",
            "nextDialogs": [
              "120440911"
            ]
          },
          "120440911": {
            "id": "120440911",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "That's what we look like in our original form. I'm guessing that's the one that led you into my dream earlier?",
            "nextDialogs": [
              "120440912"
            ]
          },
          "120440912": {
            "id": "120440912",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Baku feast on the bad dreams of human beings — but we need to be in a dream of our own to digest them. The place where you met me earlier was where I go to digest bad dreams.",
            "nextDialogs": [
              "120440913"
            ]
          },
          "120440913": {
            "id": "120440913",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "I must have swallowed one too many bad dreams, because they were causing me some digestive trouble... It's actually a good thing you showed up when you did.",
            "nextDialogs": [
              "120440914"
            ]
          },
          "120440914": {
            "id": "120440914",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Call it a happy accident, I guess. Thanks to your help, I'm now able to digest all these dreams properly.",
            "nextDialogs": [
              "120440915"
            ]
          },
          "120440915": {
            "id": "120440915",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yeah, we thought you looked a little uncomfortable. That's why we came over. We didn't know what it was, we just thought maybe you could use some help.",
            "nextDialogs": [
              "120440916"
            ]
          },
          "120440916": {
            "id": "120440916",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And Paimon really hates bad dreams, so Paimon's even more happy to help knowing that you can eat them!",
            "nextDialogs": [
              "120440917"
            ]
          },
          "120440917": {
            "id": "120440917",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Thank you... but I still owe you an apology...",
            "nextDialogs": [
              "120440918"
            ]
          },
          "120440918": {
            "id": "120440918",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "For what?",
            "nextDialogs": [
              "120440919"
            ]
          },
          "120440919": {
            "id": "120440919",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "While you were inside my dream... I ate one of your dreams, but it wasn't a bad one. It was a nice one.",
            "nextDialogs": [
              "120440920"
            ]
          },
          "120440920": {
            "id": "120440920",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "I've eaten so many bad dreams today that I just scarfed it down without noticing...",
            "nextDialogs": [
              "120440921"
            ]
          },
          "120440921": {
            "id": "120440921",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So yumekui-baku can eat good dreams too, huh... Still, is that really such a big deal?",
            "nextDialogs": [
              "120440922"
            ]
          },
          "120440922": {
            "id": "120440922",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Of course it is. Dreams are some of the most precious things a person can have, and I just went and gobbled it down...",
            "nextDialogs": [
              "120440923"
            ]
          },
          "120440923": {
            "id": "120440923",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "It's the unwritten rule of my kind: Never eat someone else's good dreams without permission. I can't believe I was so careless.",
            "nextDialogs": [
              "120440926"
            ]
          },
          "120440926": {
            "id": "120440926",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "But... Don't you feel horribly depressed? Isn't your mind suddenly flooded with distressing memories?",
            "nextDialogs": [
              "120440927"
            ]
          },
          "120440927": {
            "id": "120440927",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Nope.",
            "nextDialogs": [
              "120440928"
            ]
          },
          "120440928": {
            "id": "120440928",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Remarkable... I've never heard of someone remaining so mentally stable after having a good dream of theirs devoured...",
            "nextDialogs": [
              "120440929"
            ]
          },
          "120440929": {
            "id": "120440929",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Umm... It's probably because {NICKNAME} has too many good dreams to count!",
            "nextDialogs": [
              "120440930"
            ]
          },
          "120440930": {
            "id": "120440930",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Maybe, but I still owe you something for your trouble... Ah! Here, take this.",
            "nextDialogs": [
              "120440931"
            ]
          },
          "120440931": {
            "id": "120440931",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's a VIP pass for the Aisa Bathhouse...",
            "nextDialogs": [
              "120440932"
            ]
          },
          "120440932": {
            "id": "120440932",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "\"Staffed by clinical psychologists and offering spa and fine dining services, we invite you to bring us your troubles and leave refreshed and renewed\"...",
            "nextDialogs": [
              "120440933"
            ]
          },
          "120440933": {
            "id": "120440933",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "That's where I work. You'll find the address on there, too.",
            "nextDialogs": [
              "120440934"
            ]
          },
          "120440934": {
            "id": "120440934",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "This invitation letter entitles you to enjoy our highest-tier service, free of charge... Oh, and speaking of work — I'd better get back before I'm missed.",
            "nextDialogs": [
              "120440935"
            ]
          },
          "120440935": {
            "id": "120440935",
            "speakerId": 1007,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Hope to see you as customers soon!",
            "nextDialogs": [
              "120440936"
            ]
          },
          "120440936": {
            "id": "120440936",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So she's a yumekui-baku that eats bad dreams and a clinical psychologist, too?"
          }
        }
      }
    },

{
  "lineCounts": {
    "#{REALNAME[ID(2)|SHOWHOST(true)]}": 6,
    "Bona": 48,
    "Cocouik": 1,
    "Paimon": 49,
    "Player": 20
  },
  "subQuests": [
    {
      "subId": "7513601",
      "subQuestName": "Explore the Tonatiuh",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751360101"
        ],
        "dialogs": {
          "751360101": {
            "id": "751360101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We're... We're alive! Sure feels great to step on solid ground again...",
            "nextDialogs": [
              "751360102"
            ]
          },
          "751360102": {
            "id": "751360102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But you float.",
            "nextDialogs": [
              "751360103"
            ]
          },
          "751360103": {
            "id": "751360103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, there's a huge difference between hovering near the ground and being blown all over the place in the skies!",
            "nextDialogs": [
              "751360104"
            ]
          },
          "751360104": {
            "id": "751360104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The \"ground\" here doesn't look too solid, either.",
            "nextDialogs": [
              "751360105"
            ]
          },
          "751360105": {
            "id": "751360105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Don't scare Paimon like that! If we do fall, she can't pull both you and {REALNAME[ID(2)|SHOWHOST(true)]} back up!",
            "nextDialogs": [
              "751360106"
            ]
          },
          "751360106": {
            "id": "751360106",
            "speakerId": 1001,
            "speakerName": "Cocouik",
            "text": "Cheep, ku...",
            "nextDialogs": [
              "751360107"
            ]
          },
          "751360107": {
            "id": "751360107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Is that the Tonatiuh? Woohoo, we've done it!",
            "nextDialogs": [
              "751360108"
            ]
          },
          "751360108": {
            "id": "751360108",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751360109"
            ]
          },
          "751360109": {
            "id": "751360109",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It looks more like a huge ball of yarn than a ship, though! Or snakes, what with all those tangled lines...",
            "nextDialogs": [
              "751360110"
            ]
          },
          "751360110": {
            "id": "751360110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But it looks safer, at least, so let's fly over there... Um, wait. Where did Bona go?",
            "nextDialogs": [
              "751360111"
            ]
          },
          "751360111": {
            "id": "751360111",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "She did say she has a lot of flying experience, but Paimon's still kinda worried.",
            "nextDialogs": [
              "751360112"
            ]
          },
          "751360112": {
            "id": "751360112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "As long as the wind direction was correct...",
            "nextDialogs": [
              "751360113"
            ]
          },
          "751360113": {
            "id": "751360113",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You're right, she probably landed somewhere around here, if that's the case.",
            "nextDialogs": [
              "751360114"
            ]
          },
          "751360114": {
            "id": "751360114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We won't know if we just stay here either way.",
            "nextDialogs": [
              "751360115"
            ]
          },
          "751360115": {
            "id": "751360115",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You're right, we have to get going. Maybe she's already waiting for us onboard the ship.",
            "nextDialogs": [
              "751360116"
            ]
          },
          "751360116": {
            "id": "751360116",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Then let's go!"
          }
        }
      }
    },
    {
      "subId": "7513602",
      "subQuestName": "Explore the Tonatiuh",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751360201"
        ],
        "dialogs": {
          "751360201": {
            "id": "751360201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What's this? It looks like Pyrophosphorite, but it's all shiny and flam-ey and stuff. Sure looks more powerful than the one Bona has.",
            "nextDialogs": [
              "751360202"
            ]
          },
          "751360202": {
            "id": "751360202",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Could this be Pyrophosphorite's original form?",
            "nextDialogs": [
              "751360203"
            ]
          },
          "751360203": {
            "id": "751360203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ouch! It's burning hot!",
            "nextDialogs": [
              "751360204"
            ]
          },
          "751360204": {
            "id": "751360204",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Don't just touch whatever you find, {NICKNAME}!",
            "nextDialogs": [
              "751360205"
            ]
          },
          "751360205": {
            "id": "751360205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I didn't realize...",
            "nextDialogs": [
              "751360206"
            ]
          },
          "751360206": {
            "id": "751360206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oh, hey, the pot's calling the kettle black.",
            "nextDialogs": [
              "751360207"
            ]
          },
          "751360207": {
            "id": "751360207",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr! Rawr!",
            "nextDialogs": [
              "751360208"
            ]
          },
          "751360208": {
            "id": "751360208",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#What is it, {REALNAME[ID(2)|SHOWHOST(true)]}? Do you know something about this?",
            "nextDialogs": [
              "751360209"
            ]
          },
          "751360209": {
            "id": "751360209",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Wow, {REALNAME[ID(2)|SHOWHOST(true)]}! It's finally your time to shine, huh?",
            "nextDialogs": [
              "751360210"
            ]
          },
          "751360210": {
            "id": "751360210",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Guess we'll let you handle any hot and sizzling treasures from now on!",
            "nextDialogs": [
              "751360211"
            ]
          },
          "751360211": {
            "id": "751360211",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Yee! Rawr!",
            "nextDialogs": [
              "751360212"
            ]
          },
          "751360212": {
            "id": "751360212",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Hey! Hey! Over here!",
            "nextDialogs": [
              "751360213"
            ]
          },
          "751360213": {
            "id": "751360213",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Look, it's Bona!",
            "nextDialogs": [
              "751360214"
            ]
          },
          "751360214": {
            "id": "751360214",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "How did she get there? Did she land... Anyway, let's go over there first!"
          }
        }
      }
    },
    {
      "subId": "7513603",
      "subQuestName": "Explore the Tonatiuh",
      "sceneId": null,
      "locations": [],

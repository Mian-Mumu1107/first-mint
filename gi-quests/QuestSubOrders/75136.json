    {
      "subId": "7513617",
      "subQuestName": "Go with your little Tepetlisaurus to where Bona is",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7513604",
      "subQuestName": "Head to where Bona is",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751360301"
        ],
        "dialogs": {
          "751360301": {
            "id": "751360301",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "#There you are, {NICKNAME}, Paimon, {REALNAME[ID(2)|SHOWHOST(true)]}.",
            "nextDialogs": [
              "751360302"
            ]
          },
          "751360302": {
            "id": "751360302",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey there Bona! Paimon's glad to see you're okay!",
            "nextDialogs": [
              "751360303"
            ]
          },
          "751360303": {
            "id": "751360303",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751360304"
            ]
          },
          "751360304": {
            "id": "751360304",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Oh? Worried about me, Paimon? Don't worry! I'm the ace adventurer of the Flower-Feather Clan. It'll take a lot more to bring down someone like me.",
            "nextDialogs": [
              "751360305"
            ]
          },
          "751360305": {
            "id": "751360305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's good to see that you're well, either way.",
            "nextDialogs": [
              "751360306"
            ]
          },
          "751360306": {
            "id": "751360306",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Hehe, maybe it's also thanks to you. My luck's been looking up ever since we met!",
            "nextDialogs": [
              "751360307"
            ]
          },
          "751360307": {
            "id": "751360307",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "After I got separated from you guys in the clouds, I was blown onto a floating rock and passed out. I'm not sure how much time went by, but when I woke up, I found myself here.",
            "nextDialogs": [
              "751360308"
            ]
          },
          "751360308": {
            "id": "751360308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How did you end up here?",
            "nextDialogs": [
              "751360309"
            ]
          },
          "751360309": {
            "id": "751360309",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Well, after I got separated from you guys in the clouds, I was blown onto a floating rock and passed out. I'm not sure how much time went by, but when I woke up, I found myself here.",
            "nextDialogs": [
              "751360310"
            ]
          },
          "751360310": {
            "id": "751360310",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "When I woke up, I searched everywhere, but had no luck finding you, so I thought you... Anyway, looks like you guys are tougher than you seem too!",
            "nextDialogs": [
              "751360311"
            ]
          },
          "751360311": {
            "id": "751360311",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa, Paimon was just about to ask how you got up here, actually. These are all isolated floating islands, so did you fly up here or something?",
            "nextDialogs": [
              "751360312"
            ]
          },
          "751360312": {
            "id": "751360312",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Hehe, let's talk about that later. Anyway, this is the Tonatiuh we've been looking for. Our adventure's been a great success!",
            "nextDialogs": [
              "751360313"
            ]
          },
          "751360313": {
            "id": "751360313",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, but from the looks of this place, it doesn't seem to have treasures scattered everywhere like the legends say. Has someone else come and taken them all away?",
            "nextDialogs": [
              "751360314"
            ]
          },
          "751360314": {
            "id": "751360314",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "For my part, I'd bet on our so-called Tonatiuh treasures being made up by tribal storytellers!",
            "nextDialogs": [
              "751360315"
            ]
          },
          "751360315": {
            "id": "751360315",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? No way! So you're telling Paimon that we came here for nothing!?",
            "nextDialogs": [
              "751360316"
            ]
          },
          "751360316": {
            "id": "751360316",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "While the treasures might be fabricated, that doesn't mean the Jade of Return we're looking for isn't here. We can't give up hope yet.",
            "nextDialogs": [
              "751360317"
            ]
          },
          "751360317": {
            "id": "751360317",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Also, look up at that thing over there!",
            "nextDialogs": [
              "751360318"
            ]
          },
          "751360318": {
            "id": "751360318",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "See how there's something inside? You found a Pyrophosphorite inside the Core of Chu'ulel just now, didn't you?",
            "nextDialogs": [
              "751360319"
            ]
          },
          "751360319": {
            "id": "751360319",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Well, based on my experience as an adventurer, it stands to reason that the Jade of Return we seek is in there.",
            "nextDialogs": [
              "751360320"
            ]
          },
          "751360320": {
            "id": "751360320",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "In that case, let's figure out a way to get up there and smash it open!",
            "nextDialogs": [
              "751360321"
            ]
          },
          "751360321": {
            "id": "751360321",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Leave it to me.",
            "nextDialogs": [
              "751360322"
            ]
          },
          "751360322": {
            "id": "751360322",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Hold on now, it's not as simple as you think! I've already tried. It's not something that can be smashed open with brute force.",
            "nextDialogs": [
              "751360323"
            ]
          },
          "751360323": {
            "id": "751360323",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Something tells me things won't be that simple.",
            "nextDialogs": [
              "751360324"
            ]
          },
          "751360324": {
            "id": "751360324",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Yeah, this doesn't look like something we can break open using only brute force.",
            "nextDialogs": [
              "751360325"
            ]
          },
          "751360325": {
            "id": "751360325",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "My adventuring experience suggests that there should be some sort of mechanism around here, just like when we got the Pyrophosphorite earlier.",
            "nextDialogs": [
              "751360326"
            ]
          },
          "751360326": {
            "id": "751360326",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Speaking of mechanisms, this must be it right here! It looks exactly like the Altar of Primal Flame we saw earlier!",
            "nextDialogs": [
              "751360327"
            ]
          },
          "751360327": {
            "id": "751360327",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "What a coincidence... Wait, this can't be a coincidence. This must be some sort of clue.",
            "nextDialogs": [
              "751360328"
            ]
          },
          "751360328": {
            "id": "751360328",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "If it's a clue, maybe we should try using the Pyrophosphorite to... Uh, hang on. We don't have any left, do we?",
            "nextDialogs": [
              "751360329"
            ]
          },
          "751360329": {
            "id": "751360329",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}'s carrying one right now...",
            "nextDialogs": [
              "751360330"
            ]
          },
          "751360330": {
            "id": "751360330",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh yeah, we stumbled upon this on our way here...",
            "nextDialogs": [
              "751360331"
            ]
          },
          "751360331": {
            "id": "751360331",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "This must be it! Are you familiar with the principle of the \"Adventurer's Key\"? It states that the crucial item needed at the final stage of an adventure is always acquired at its beginning.",
            "nextDialogs": [
              "751360332"
            ]
          },
          "751360332": {
            "id": "751360332",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That sounds like nonsense! Plus, this interval is kinda tight, don't you think? That said, this thing sure does look like Pyrophosphorite...",
            "nextDialogs": [
              "751360333"
            ]
          },
          "751360333": {
            "id": "751360333",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, apart from the constant crackling and spitting flames, Paimon thinks they're exactly the same!",
            "nextDialogs": [
              "751360334"
            ]
          },
          "751360334": {
            "id": "751360334",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Wow, you're right. I totally wouldn't have realized if it weren't for you, Paimon.",
            "nextDialogs": [
              "751360335"
            ]
          },
          "751360335": {
            "id": "751360335",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That, uh, sounds like a you problem, but anyway, based on what you said, we just need to collect stones like that, right?",
            "nextDialogs": [
              "751360336"
            ]
          },
          "751360336": {
            "id": "751360336",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Well, if we're looking for these Firestones, there are four in total on this ship. For example, there should be one on the floating island across from us.",
            "nextDialogs": [
              "751360337"
            ]
          },
          "751360337": {
            "id": "751360337",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ooh... Wait, Bona, how do you know all this? It's almost like you've been here before. Really, it feels like there's more to this than \"adventuring experience.\"",
            "nextDialogs": [
              "751360338"
            ]
          },
          "751360338": {
            "id": "751360338",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Uh, how should I put it... I guess it's like an adventurer's premonition? I'm not sure why, but as soon as I saw this Altar, I knew how to use it.",
            "nextDialogs": [
              "751360339"
            ]
          },
          "751360339": {
            "id": "751360339",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "I was also investigating this place before meeting you guys. Conducting a thorough preliminary investigation is a must for an ace adventurer, don't you think?",
            "nextDialogs": [
              "751360340"
            ]
          },
          "751360340": {
            "id": "751360340",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I see. Guess you learn something every day.",
            "nextDialogs": [
              "751360341"
            ]
          },
          "751360341": {
            "id": "751360341",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "#Wait, so you've just been brute-forcing your way through this whole time, {NICKNAME}...? Must be nice being able to fight.",
            "nextDialogs": [
              "751360342"
            ]
          },
          "751360342": {
            "id": "751360342",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Luckily, I always rely on brute force.",
            "nextDialogs": [
              "751360343"
            ]
          },
          "751360343": {
            "id": "751360343",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Well, you're just one of a kind, you know?",
            "nextDialogs": [
              "751360344"
            ]
          },
          "751360344": {
            "id": "751360344",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Speaking of which, how are we even gonna get over there? Might be a little tricky, even for you.",
            "nextDialogs": [
              "751360345"
            ]
          },
          "751360345": {
            "id": "751360345",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Hehe... Also, aren't you curious about how I got up here earlier? Now's the time to show you my discovery.",
            "nextDialogs": [
              "751360346"
            ]
          },
          "751360346": {
            "id": "751360346",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Well, how about it? We can use this mechanism to freely travel between the floating islands.",
            "nextDialogs": [
              "751360347"
            ]
          },
          "751360347": {
            "id": "751360347",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "I'm counting on you to find them. Just holler over to me if you cross over to another floating island and can't get back here.",
            "nextDialogs": [
              "751360348"
            ]
          },
          "751360348": {
            "id": "751360348",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Alright, and we'll leave the job of holding the Firestones up to you, {REALNAME[ID(2)|SHOWHOST(true)]}. Let's go!",
            "nextDialogs": [
              "751360349"
            ]
          },
          "751360349": {
            "id": "751360349",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!"
          }
        }
      }
    },
    {
      "subId": "7513605",
      "subQuestName": "Collect the burning Firestones $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751360501"
        ],
        "dialogs": {
          "751360501": {
            "id": "751360501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Woohoo, we did it! Hmm, still, this is a rather familiar Iridescent Inscription. Is this the famous Jade of Return, then?",
            "nextDialogs": [
              "751360502"
            ]
          },
          "751360502": {
            "id": "751360502",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait a second, isn't this the Golden Entreaty? It's the same as the one we got at the stone tablet back then!",
            "nextDialogs": [
              "751360503"
            ]
          },
          "751360503": {
            "id": "751360503",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rooo... Rawr...",
            "nextDialogs": [
              "751360504"
            ]
          },
          "751360504": {
            "id": "751360504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wow, that really is the case!",
            "nextDialogs": [
              "751360505"
            ]
          },
          "751360505": {
            "id": "751360505",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And y'know, a treasure that can suppress the filth of the Abyss and a token that can remove curses and disasters do sound somewhat similar...",
            "nextDialogs": [
              "751360506"
            ]
          },
          "751360506": {
            "id": "751360506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're only realizing this now?",
            "nextDialogs": [
              "751360507"
            ]
          },
          "751360507": {
            "id": "751360507",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Really!? Why didn't you just tell Paimon if you already knew!? Wait a second, how did you even know? Wait, is this an \"adventurer's experience\" thing again?",
            "nextDialogs": [
              "751360508"
            ]
          },
          "751360508": {
            "id": "751360508",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm. Come to think of it, a treasure that can suppress the filth of the Abyss and a token that can remove curses and disasters do sound somewhat similar...",
            "nextDialogs": [
              "751360509"
            ]
          },
          "751360509": {
            "id": "751360509",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But can this thing really suppress the Abyss in Ochkanatlan? Paimon's never heard anyone from the Saurian Relics Association mention it before...",
            "nextDialogs": [
              "751360510"
            ]
          },
          "751360510": {
            "id": "751360510",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, and since the Jade of Return is just a Golden Entreaty, could that be why the evil dragon has been targeting us?",
            "nextDialogs": [
              "751360511"
            ]
          },
          "751360511": {
            "id": "751360511",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whew, so it wasn't because it was eyeing the Blazed Meat Stew Paimon had this morning...",
            "nextDialogs": [
              "751360512"
            ]
          },
          "751360512": {
            "id": "751360512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Looks like the clues are falling into place.",
            "nextDialogs": [
              "751360513"
            ]
          },
          "751360513": {
            "id": "751360513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Looks like it really was foreshadowing.",
            "nextDialogs": [
              "751360514"
            ]
          },
          "751360514": {
            "id": "751360514",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, but Bona probably doesn't know about the Golden Entreaty yet... Hey, Bona?",
            "nextDialogs": [
              "751360515"
            ]
          },
          "751360515": {
            "id": "751360515",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Something's not right... I'm sure I've been here before, the Tonatiuh, and the Jade of Return...",
            "nextDialogs": [
              "751360516"
            ]
          },
          "751360516": {
            "id": "751360516",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Yes, we must destroy it... It cannot fall into the hands of that person...",
            "nextDialogs": [
              "751360517"
            ]
          },
          "751360517": {
            "id": "751360517",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, are you okay, Bona?",
            "nextDialogs": [
              "751360518"
            ]
          },
          "751360518": {
            "id": "751360518",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Bona? No... Bona should be long gone. Why am I still here...",
            "nextDialogs": [
              "751360519"
            ]
          },
          "751360519": {
            "id": "751360519",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "#I see, so that's what's— Careful, {NICKNAME}! Don't come any closer. This is a trap...",
            "nextDialogs": [
              "751360520"
            ]
          },
          "751360520": {
            "id": "751360520",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh?"
          }
        }
      }
    },

            ]
          },
          "751360607": {
            "id": "751360607",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh, this might just be Paimon feeling hungry after all this running about, but now that Bona's found the Tonatiuh and gotten her hands on the Jade of Return, her wish has been fulfilled, right?",
            "nextDialogs": [

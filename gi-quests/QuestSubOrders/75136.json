          },
          "751360609": {
            "id": "751360609",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Yes, we must destroy it... It cannot fall into the hands of that person...",
            "nextDialogs": [
              "751360610"
            ]
          },
          "751360610": {
            "id": "751360610",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, are you okay, Bona?",
            "nextDialogs": [
              "751360611"
            ]
          },
          "751360611": {
            "id": "751360611",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "Bona? No... Bona should be long gone. Why am I still here...",
            "nextDialogs": [
              "751360612"
            ]
          },
          "751360612": {
            "id": "751360612",
            "speakerId": 1003,
            "speakerName": "Bona",
            "text": "#I see, so that's what's— Careful, {NICKNAME}! Don't come any closer. This is a trap...",
            "nextDialogs": [
              "751360613"
            ]
          },
          "751360613": {
            "id": "751360613",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh?"
          }
        }

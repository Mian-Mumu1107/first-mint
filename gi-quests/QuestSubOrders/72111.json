  "subQuests": [
    {
      "subId": "7211104",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721110101"
        ],
        "dialogs": {
          "721110101": {
            "id": "721110101",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "Well then. What can I do for you, youngster?",
            "nextDialogs": [
              "721110102"
            ]
          },
          "721110102": {
            "id": "721110102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We found the evidence.",
            "nextDialogs": [
              "721110103"
            ]
          },
          "721110103": {
            "id": "721110103",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "Evidence? What evidence? I don't understand what you mean.",
            "nextDialogs": [
              "721110104"
            ]
          },
          "721110104": {
            "id": "721110104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Evidence about the strange incidents in the village. Please stop pretending.",
            "nextDialogs": [
              "721110105"
            ]
          },
          "721110105": {
            "id": "721110105",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "Nonsense! What kind of strange incidents could possibly happen in our village? Well, alright then, show me!",
            "nextDialogs": [
              "721110106"
            ]
          },
          "721110106": {
            "id": "721110106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#(Hey {NICKNAME}, start with what was found near the well. Paimon's leaving it to you!)",
            "nextDialogs": [
              "721110107"
            ]
          },
          "721110107": {
            "id": "721110107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This was found at the dry well in your backyard."
          }
        }
      }
    },
    {
      "subId": "7211105",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721110201"
        ],
        "dialogs": {
          "721110201": {
            "id": "721110201",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "A bag for carrying Mora?",
            "nextDialogs": [
              "721110202"
            ]
          },
          "721110202": {
            "id": "721110202",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "This...",
            "nextDialogs": [
              "721110203"
            ]
          },
          "721110203": {
            "id": "721110203",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "...This belongs to our family. There is nothing suspicious about it. That's right, it's very normal!",
            "nextDialogs": [
              "721110204"
            ]
          },
          "721110204": {
            "id": "721110204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "He's so suspicious! Something's definitely off!",
            "nextDialogs": [
              "721110210",
              "721110207"
            ]
          },
          "721110210": {
            "id": "721110210",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "...",
            "nextDialogs": [
              "721110211"
            ]
          },
          "721110211": {
            "id": "721110211",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "Fine. This is indeed not my coin pouch.",
            "nextDialogs": [
              "721110212"
            ]
          },
          "721110212": {
            "id": "721110212",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "So many people have passed by my backyard, it's pretty normal for someone to have dropped it, right?",
            "nextDialogs": [
              "721110213"
            ]
          },
          "721110213": {
            "id": "721110213",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "It's...",
            "nextDialogs": [
              "721110214"
            ]
          },
          "721110214": {
            "id": "721110214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's going on?",
            "nextDialogs": [
              "721110215"
            ]
          },
          "721110215": {
            "id": "721110215",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "*sigh* Aye, you've seen through me, alright. Now, I was really tempted to take the coin pouch for myself, you know?",
            "nextDialogs": [
              "721110216"
            ]
          },
          "721110216": {
            "id": "721110216",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "Oh Densuke, how could an old man like you have such mischievous thoughts!"
          },
          "721110207": {
            "id": "721110207",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "Hahaha, what kind of question is that?",
            "nextDialogs": [
              "721110208"
            ]
          },
          "721110208": {
            "id": "721110208",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "There's no way you would know how much Mora was in there without opening it up either, right?",
            "nextDialogs": [
              "721110209"
            ]
          },
          "721110209": {
            "id": "721110209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Now then, please draw the marking that was on it."
          }
        }
      }
    },
    {
      "subId": "7211106",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721110301"
        ],
        "dialogs": {
          "721110301": {
            "id": "721110301",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "This is... ahem, where did you get this?",
            "nextDialogs": [
              "721110303",
              "721110305"
            ]
          },
          "721110303": {
            "id": "721110303",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "...",
            "nextDialogs": [
              "721110306"
            ]
          },
          "721110306": {
            "id": "721110306",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "How can you prove that these two items are related?",
            "nextDialogs": [
              "721110307"
            ]
          },
          "721110307": {
            "id": "721110307",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, they're related alright.",
            "nextDialogs": [
              "721110308"
            ]
          },
          "721110308": {
            "id": "721110308",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "Ridiculous! How can that be?",
            "nextDialogs": [
              "721110309"
            ]
          },
          "721110309": {
            "id": "721110309",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "Unless... there's some kind of secret code on the Mora?",
            "nextDialogs": [
              "721110310"
            ]
          },
          "721110310": {
            "id": "721110310",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "There's nothing on the Mora, but we did find something elsewhere.",
            "nextDialogs": [
              "721110311"
            ]
          },
          "721110311": {
            "id": "721110311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We found this near the remains of a cart..."
          },
          "721110305": {
            "id": "721110305",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "How could that be... You'll get nowhere, testing me like that."
          }
        }
      }
    },
    {
      "subId": "7211108",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721110801"
        ],
        "dialogs": {
          "721110801": {
            "id": "721110801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This was found at the dry well in your backyard."
          }
        }
      }
    },
    {
      "subId": "7211107",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721110701"
        ],
        "dialogs": {
          "721110701": {
            "id": "721110701",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "This is... This is...",
            "nextDialogs": [
              "721110702"
            ]
          },
          "721110702": {
            "id": "721110702",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "I can't believe that I was so careless when I was damaging the cart...",
            "nextDialogs": [
              "721110703"
            ]
          },
          "721110703": {
            "id": "721110703",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey now, you finally admitted it!",
            "nextDialogs": [
              "721110704"
            ]
          },
          "721110704": {
            "id": "721110704",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "Since you have already gotten this far in your investigation, there's nothing for it. I can't hide it anymore.",
            "nextDialogs": [
              "721110705"
            ]
          },
          "721110705": {
            "id": "721110705",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "In that case, you should have a pretty good idea of what happened.",
            "nextDialogs": [
              "721110706"
            ]
          },
          "721110706": {
            "id": "721110706",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A very good idea indeed! Grandpa Densuke, you...",
            "nextDialogs": [
              "721110707"
            ]
          },
          "721110707": {
            "id": "721110707",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Tried to rob a Shogunate cart, didn't you? And in the midst of the struggle, you destroyed the cart with a single punch, causing the goods to go flying into the gully.",
            "nextDialogs": [
              "721110708"
            ]
          },
          "721110708": {
            "id": "721110708",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hoping to save themselves, the Shogunate's people threw their coin pouches into the well to distract you! And then, you locked the well up to prevent others from stealing the Mora!",
            "nextDialogs": [
              "721110709"
            ]
          },
          "721110709": {
            "id": "721110709",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Is that right?",
            "nextDialogs": [
              "721110710"
            ]
          },
          "721110710": {
            "id": "721110710",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "Ah? No, that's not what happened at all!",
            "nextDialogs": [
              "721110711"
            ]
          },
          "721110711": {
            "id": "721110711",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Really? Paimon was gonna ask for your key and to have that Mora at the bottom of the well...",
            "nextDialogs": [
              "721110712"
            ]
          },
          "721110712": {
            "id": "721110712",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...Surrendered to the Shogunate! That's right! They were definitely going to be surrendered to the Shogunate!",
            "nextDialogs": [
              "721110713"
            ]
          },
          "721110713": {
            "id": "721110713",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "*sigh* Well, this is what actually happened...",
            "nextDialogs": [
              "721110714"
            ]
          },
          "721110714": {
            "id": "721110714",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "There was originally a group of young people in the village who got too bold after getting drunk, and actually robbed one of the Shogunate's cargo carts. These goods and the bag both belong to the Shogunate.",
            "nextDialogs": [
              "721110715"
            ]
          },
          "721110715": {
            "id": "721110715",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "I couldn't let others know that this shameful incident occurred in our village. That's why I tried to cover it up.",
            "nextDialogs": [
              "721110716"
            ]
          },
          "721110716": {
            "id": "721110716",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What about your confession regarding the coin pouch...",
            "nextDialogs": [
              "721110717"
            ]
          },
          "721110717": {
            "id": "721110717",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He did that to cover up the truth.",
            "nextDialogs": [
              "721110718"
            ]
          },
          "721110718": {
            "id": "721110718",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "That's right. I thought that you would stop the investigation once I confessed.",
            "nextDialogs": [
              "721110719"
            ]
          },
          "721110719": {
            "id": "721110719",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "If it was just me... As long as no one else was affected...",
            "nextDialogs": [
              "721110720"
            ]
          },
          "721110720": {
            "id": "721110720",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "Please don't report this to the Shogunate. This isn't about me saving face. I just don't want the entire village to be dragged down in the process.",
            "nextDialogs": [
              "721110722",
              "721110725"
            ]
          },
          "721110722": {
            "id": "721110722",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah, that's not why we came here!",
            "nextDialogs": [
              "721110723"
            ]
          },
          "721110723": {
            "id": "721110723",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "Oh, thank goodness! Thank goodness...",
            "nextDialogs": [
              "721110727"
            ]
          },
          "721110727": {
            "id": "721110727",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "My conscience kept bothering me because of this cover-up, so I recorded everything in a diary.",
            "nextDialogs": [
              "721110728"
            ]
          },
          "721110728": {
            "id": "721110728",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "I threw the diary onto the roof. If you really want to read it, help yourself, but please don't ruin my recently renovated roof.",
            "nextDialogs": [
              "721110729"
            ]
          },
          "721110729": {
            "id": "721110729",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the lock on the well...",
            "nextDialogs": [
              "721110730"
            ]
          },
          "721110730": {
            "id": "721110730",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "Yes, it was me who locked the well up. I also wrote down where I hid the key. Go read for yourself.",
            "nextDialogs": [
              "721110731"
            ]
          },
          "721110731": {
            "id": "721110731",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Grandpa Densuke, do you know anything about the Konda Village barrier?",
            "nextDialogs": [
              "721110732"
            ]
          },
          "721110732": {
            "id": "721110732",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "Barrier? Oh, so people still know about that old legend...",
            "nextDialogs": [
              "721110733"
            ]
          },
          "721110733": {
            "id": "721110733",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "They say that in ancient times, underneath the ground we are standing on right now, lay the roots of the Thunder Sakura. Indeed, this was one of the five roots that protect the peace on Narukami Island.",
            "nextDialogs": [
              "721110734"
            ]
          },
          "721110734": {
            "id": "721110734",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "And guarding it and its barrier was said to be a responsibility assigned to us, the Konda Clan, by the Kitsune Saiguu herself.",
            "nextDialogs": [
              "721110735"
            ]
          },
          "721110735": {
            "id": "721110735",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "But this was a long, long time ago. I hardly recall anything about the details."
          },
          "721110725": {
            "id": "721110725",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah, we didn't come here to report you!",
            "nextDialogs": [
              "721110726"
            ]
          },
          "721110726": {
            "id": "721110726",
            "speakerId": 1000,
            "speakerName": "Konda Densuke",
            "text": "The truth? Hehe... You young people these days are so interesting."
          }
        }
      }
    },

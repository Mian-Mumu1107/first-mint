              "130280106"
            ]
          },
          "130280106": {
            "id": "130280106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, so they can look out for each other!",
            "nextDialogs": [
              "130280107"
            ]
          },
          "130280107": {
            "id": "130280107",
            "speakerId": 1056,
            "speakerName": "Nahida",

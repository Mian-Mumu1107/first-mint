    {
      "subId": "7050008",
      "subQuestName": "Report back to Cloud Retainer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705000701"
        ],
        "dialogs": {
          "705000701": {
            "id": "705000701",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "Mmm... A most wonderful flavor. One would have expected no less...",
            "nextDialogs": [
              "705000704"
            ]
          },
          "705000704": {
            "id": "705000704",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "'Tis so. The completion of these three dishes has proven the reliability of one's Supreme Cuisine Machine.",
            "nextDialogs": [
              "705000705"
            ]
          },
          "705000705": {
            "id": "705000705",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "We have but to solve the two issues of heat control and the automatic retrieval of ingredients, and this machine shall truly have achieved \"all-in-one cooking.\"",
            "nextDialogs": [
              "705000706"
            ]
          },
          "705000706": {
            "id": "705000706",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "Ah, yes, lest one forgets... Your Braised Meat recipe. With but one difference — this recipe involves the use of normal Raw Meat instead.",
            "nextDialogs": [
              "705000707"
            ]
          },
          "705000707": {
            "id": "705000707",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "One deems that it might be inconvenient for you to scale this frigid mountain each time you wish to eat this meal...",
            "nextDialogs": [
              "705000708"
            ]
          },
          "705000708": {
            "id": "705000708",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "Ordinary meat shall serve in ordinary occasions.",
            "nextDialogs": [
              "705000709"
            ]
          },
          "705000709": {
            "id": "705000709",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "Regardless, you have one's thanks for your aid in foraging for ingredients.",
            "nextDialogs": [
              "705000710"
            ]
          },
          "705000710": {
            "id": "705000710",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "To one's abode one must now return, and make further improvements to this device. Let us part here, then.",
            "nextDialogs": [
              "705000711"
            ]
          },
          "705000711": {
            "id": "705000711",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "Should one require any further succor... perhaps one shall call upon you again.",
            "nextDialogs": [
              "705000712"
            ]
          },
          "705000712": {
            "id": "705000712",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "A measure of faith one has that you shall not decline should that time come. Most highly does one regard your abilities and trustworthiness, after all."
          }
        }
      }
    },
    {
      "subId": "7050006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

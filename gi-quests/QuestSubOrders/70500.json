        ],
        "dialogs": {
          "705000601": {
            "id": "705000601",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "Now then, Traveler, pursue the scent one has put you on and retrieve the ingredients one requires."
          }
        }
      }
    },
    {
      "subId": "7050008",
      "subQuestName": "Additional",
      "sceneId": null,

  },
  "subQuests": [
    {
      "subId": "7302001",
      "subQuestName": "Look for a rising pillar of smoke",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730200101"
        ],
        "dialogs": {
          "730200101": {
            "id": "730200101",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "*whimper*",
            "nextDialogs": [
              "730200102"
            ]
          },
          "730200102": {
            "id": "730200102",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Aah! It's Nara.",
            "nextDialogs": [
              "730200103"
            ]
          },
          "730200103": {
            "id": "730200103",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "*cough* I'm sorry that Nara had to see me in such a messy state.",
            "nextDialogs": [
              "730200104"
            ]
          },
          "730200104": {
            "id": "730200104",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Kind Nara, I'm Arachatora. You are?",
            "nextDialogs": [
              "730200105"
            ]
          },
          "730200105": {
            "id": "730200105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#I'm {NICKNAME}.",
            "nextDialogs": [
              "730200106"
            ]
          },
          "730200106": {
            "id": "730200106",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "And Paimon's name is Paimon!",
            "nextDialogs": [
              "730200107"
            ]
          },
          "730200107": {
            "id": "730200107",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "#Nara {NICKNAME} and Paimon, I see. Thank you so much. If fate hadn't brought us together, it would have taken me much longer to recover.",
            "nextDialogs": [
              "730200108"
            ]
          },
          "730200108": {
            "id": "730200108",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "How long is a little longer?",
            "nextDialogs": [
              "730200109"
            ]
          },
          "730200109": {
            "id": "730200109",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "I'm ashamed to admit that something like this happened once before because of bad mushrooms. The Nilotpala Lotuses in the water bloomed and closed, twice, before I recovered.",
            "nextDialogs": [
              "730200110"
            ]
          },
          "730200110": {
            "id": "730200110",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Bloomed and closed... Doesn't that take two days!?",
            "nextDialogs": [
              "730200111"
            ]
          },
          "730200111": {
            "id": "730200111",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Ah, two days. I see, so that's what a day means. You Nara are really interesting. Are two days long or short?",
            "nextDialogs": [
              "730200112"
            ]
          },
          "730200112": {
            "id": "730200112",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Hmm... What do you think, {NICKNAME}? Is it long or short?",
            "nextDialogs": [
              "730200114",
              "730200117",
              "730200121",
              "730200124"
            ]
          },
          "730200114": {
            "id": "730200114",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Uh-huh, Paimon can't imagine how Arachatora whimpered for two days straight.",
            "nextDialogs": [
              "730200115"
            ]
          },
          "730200115": {
            "id": "730200115",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Really? So it's a very long time...",
            "nextDialogs": [
              "730200126"
            ]
          },
          "730200126": {
            "id": "730200126",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But if you're Arachatora... Aren't you related to Arapacati?",
            "nextDialogs": [
              "730200127"
            ]
          },
          "730200127": {
            "id": "730200127",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Nope.",
            "nextDialogs": [
              "730200128"
            ]
          },
          "730200128": {
            "id": "730200128",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Huh? But... You're Arapacati's older brother, right?",
            "nextDialogs": [
              "730200129"
            ]
          },
          "730200129": {
            "id": "730200129",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Oh, how did you know? Arapacati is my \"younger sister.\"",
            "nextDialogs": [
              "730200130"
            ]
          },
          "730200130": {
            "id": "730200130",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon is confused...",
            "nextDialogs": [
              "730200131"
            ]
          },
          "730200131": {
            "id": "730200131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Perhaps it's different for Aranara...",
            "nextDialogs": [
              "730200132"
            ]
          },
          "730200132": {
            "id": "730200132",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Anyway, let us bring you up to speed...",
            "nextDialogs": [
              "730200133"
            ]
          },
          "730200133": {
            "id": "730200133",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You bring Arachatora up to speed on the events so far...",
            "nextDialogs": [
              "730200134"
            ]
          },
          "730200134": {
            "id": "730200134",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Festival Utsava is coming again... What should I do...",
            "nextDialogs": [
              "730200135"
            ]
          },
          "730200135": {
            "id": "730200135",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "I haven't had the most important cooking ingredient yet. Festival Utsava should be the best time to prove the greatness of mushroom dishes to Arasaka, Arapas, and Araphala.",
            "nextDialogs": [
              "730200136"
            ]
          },
          "730200136": {
            "id": "730200136",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So, Aras... spa... ara...",
            "nextDialogs": [
              "730200137"
            ]
          },
          "730200137": {
            "id": "730200137",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Arasaka, Arapas, and Araphala.",
            "nextDialogs": [
              "730200138"
            ]
          },
          "730200138": {
            "id": "730200138",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ahhh! Aranara names are so difficult! Arachatora, where're your brothers?",
            "nextDialogs": [
              "730200139"
            ]
          },
          "730200139": {
            "id": "730200139",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "We drifted apart on our paths of training, just like a river branches into streams.",
            "nextDialogs": [
              "730200140"
            ]
          },
          "730200140": {
            "id": "730200140",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So you split apart, right?",
            "nextDialogs": [
              "730200141"
            ]
          },
          "730200141": {
            "id": "730200141",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "We train to cook the supreme delicacy, but they refuse to acknowledge mushroom dishes — how could they not see that the Head Mushroom is unmatched!",
            "nextDialogs": [
              "730200142"
            ]
          },
          "730200142": {
            "id": "730200142",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Anyway, we decided to complete our own dishes and compete with each other later.",
            "nextDialogs": [
              "730200143"
            ]
          },
          "730200143": {
            "id": "730200143",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh, Paimon totally understands the pursuit of delicious food!",
            "nextDialogs": [
              "730200144"
            ]
          },
          "730200144": {
            "id": "730200144",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So, where's your Head Mushroom?",
            "nextDialogs": [
              "730200145"
            ]
          },
          "730200145": {
            "id": "730200145",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Marana has been spreading rapidly. Even the Head Mushroom's habitat has been taken over.",
            "nextDialogs": [
              "730200146"
            ]
          },
          "730200146": {
            "id": "730200146",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ah, the Withering Zone... Paimon hopes Rana is doing okay.",
            "nextDialogs": [
              "730200147"
            ]
          },
          "730200147": {
            "id": "730200147",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Its withering claws have probably taken the precious mushroom there. I'm sure you're aware how very, very dangerous Marana's territory is.",
            "nextDialogs": [
              "730200148"
            ]
          },
          "730200148": {
            "id": "730200148",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Without the Head Mushroom, I could only try the strange mushroom that no Aranara has ever tasted before.",
            "nextDialogs": [
              "730200149"
            ]
          },
          "730200149": {
            "id": "730200149",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "And?"
          },
          "730200117": {
            "id": "730200117",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmm... True. Come to think of it, we've known each other for a long time, but it feels like we met just yesterday.",
            "nextDialogs": [
              "730200118"
            ]
          },
          "730200118": {
            "id": "730200118",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Really? That's relieving. So losing control for two days in the forest isn't very long.",
            "nextDialogs": [
              "730200119"
            ]
          },
          "730200119": {
            "id": "730200119",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "That's not what we meant!"
          },
          "730200121": {
            "id": "730200121",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Well... that's true. Two whole days of whimpering is very long, but two whole days in a forest boar's life is very short.",
            "nextDialogs": [
              "730200122"
            ]
          },
          "730200122": {
            "id": "730200122",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Really? So it's a very long time..."
          },
          "730200124": {
            "id": "730200124",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "#Yes, Nara {NICKNAME}, you understand the principles of the forest well. To the forest, life is born, life grows, and life returns to the earth... All these don't need such concept as a \"day.\"",
            "nextDialogs": [
              "730200125"
            ]
          },
          "730200125": {
            "id": "730200125",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "You're not making much sense to Paimon..."
          }
        }
      }
    },
    {
      "subId": "7302002",
      "subQuestName": "Use Dendro to heal the Aranara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730200201"
        ],
        "dialogs": {
          "730200201": {
            "id": "730200201",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Ahh! The Head Mushroom I've always been dreaming about.",
            "nextDialogs": [
              "730200202"
            ]
          },
          "730200202": {
            "id": "730200202",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Head Mushroom, would you still be the same without your sweet scent?",
            "nextDialogs": [
              "730200203"
            ]
          },
          "730200203": {
            "id": "730200203",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hehe... This mushroom does smell really good.",
            "nextDialogs": [
              "730200204"
            ]
          },
          "730200204": {
            "id": "730200204",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Anyway, let's get out!"
          }
        }
      }
    },
    {
      "subId": "7302006",
      "subQuestName": "Use Dendro to heal the Aranara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7302003",
      "subQuestName": "Look for the \"Head Mushroom\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730200301"
        ],
        "dialogs": {
          "730200301": {
            "id": "730200301",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "I'm so lucky to have met both of you.",
            "nextDialogs": [
              "730200302"
            ]
          },
          "730200302": {
            "id": "730200302",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "It's the smell of a fully matured Head Mushroom. It's richer than ever.",
            "nextDialogs": [
              "730200303"
            ]
          },
          "730200303": {
            "id": "730200303",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "So, you grew well even when Marana took over your habitat. You're amazing.",
            "nextDialogs": [
              "730200304"
            ]
          },
          "730200304": {
            "id": "730200304",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Uh, so... Can we taste it?",
            "nextDialogs": [
              "730200305"
            ]
          },
          "730200305": {
            "id": "730200305",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Of course. Putting aside how you've helped me, serving the most delicious mushroom dish to Nara again has always been the goal of my cooking training.",
            "nextDialogs": [
              "730200306"
            ]
          },
          "730200306": {
            "id": "730200306",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh yeah! Head Mushroom!",
            "nextDialogs": [
              "730200307"
            ]
          },
          "730200307": {
            "id": "730200307",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Arachatora immediately starts cooking...\\nThe fresh aroma of the mushroom bursts out from the pot.",
            "nextDialogs": [
              "730200308"
            ]
          },
          "730200308": {
            "id": "730200308",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Once it's ready, Arachatora serves it to you and Paimon.\\nShould it be considered disappointing? Or conforming to expectations? Because it's tasteless.\\nBesides that, it's filled with vitality and too tough to the point of being difficult to chew.",
            "nextDialogs": [
              "730200309"
            ]
          },
          "730200309": {
            "id": "730200309",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "...It's done. My cooking training has finally been completed successfully. What do you think? I'm sure it's the best delicacy to a Nara.",
            "nextDialogs": [
              "730200310"
            ]
          },
          "730200310": {
            "id": "730200310",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "*nom nom* *gulp* Uh... how should Paimon put this...",
            "nextDialogs": [
              "730200311"
            ]
          },
          "730200311": {
            "id": "730200311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "*chew forcefully*",
            "nextDialogs": [
              "730200312"
            ]
          },
          "730200312": {
            "id": "730200312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "*swallow forcefully*",
            "nextDialogs": [
              "730200316"
            ]
          },
          "730200316": {
            "id": "730200316",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmm... It's a very fragrant mushroom indeed, but its texture and taste don't really suit us.",
            "nextDialogs": [
              "730200317"
            ]
          },
          "730200317": {
            "id": "730200317",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Huh?",
            "nextDialogs": [
              "730200318"
            ]
          },
          "730200318": {
            "id": "730200318",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "#How could this be? When I served it to the other Nara from before, {F#he}{M#she} said it was good.",
            "nextDialogs": [
              "730200319"
            ]
          },
          "730200319": {
            "id": "730200319",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "From before?",
            "nextDialogs": [
              "730200320"
            ]
          },
          "730200320": {
            "id": "730200320",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "#I served my mushroom dish to a Nara some time ago, and because it was so good, {F#he}{M#she} swallowed it with so much vigor.",
            "nextDialogs": [
              "730200321"
            ]
          },
          "730200321": {
            "id": "730200321",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "It should be fine.",
            "nextDialogs": [
              "730200322"
            ]
          },
          "730200322": {
            "id": "730200322",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "730200323"
            ]
          },
          "730200323": {
            "id": "730200323",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "730200324"
            ]
          },
          "730200324": {
            "id": "730200324",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Oh, just like every Aranara grows different leaves, the taste of the mushroom may not suit all Nara.",
            "nextDialogs": [
              "730200325"
            ]
          },
          "730200325": {
            "id": "730200325",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Right... Speaking of leaves... Are Aranara not afraid of fire? You look like you're covered in leaves...",
            "nextDialogs": [
              "730200326"
            ]
          },
          "730200326": {
            "id": "730200326",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Of course it's scary. Forest fires sometimes raze entire forests until only barren ground remains.",
            "nextDialogs": [
              "730200327"
            ]
          },
          "730200327": {
            "id": "730200327",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "But it's for my cooking training, so keeping my fear at bay and controlling the temperature of the flames is also a part of my training.",
            "nextDialogs": [
              "730200328"
            ]
          },
          "730200328": {
            "id": "730200328",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So that's how it is... Anyway, guess it's time to go back. Arapacati is waiting for you guys!",
            "nextDialogs": [
              "730200329"
            ]
          },
          "730200329": {
            "id": "730200329",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Yes, I'll head back to Vanarana immediately. I can't keep my precious sister worrying about me.",
            "nextDialogs": [
              "730200330"
            ]
          },
          "730200330": {
            "id": "730200330",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "As for the others... Arasaka, Arapas, and Araphala are around <color=#00E1FFFF>Gandharva Ville</color>, <color=#00E1FFFF>Apam Woods</color>, and <color=#00E1FFFF>Devantaka Mountain</color>.",
            "nextDialogs": [
              "730200331"
            ]
          },
          "730200331": {
            "id": "730200331",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "#Thank you. Golden Nara {NICKNAME} is dazzling like the sun, and Paimon is quite amazing, too. I'll leave my sister's request to you.",
            "nextDialogs": [
              "730200332"
            ]
          },
          "730200332": {
            "id": "730200332",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Why is Paimon only quite amazing!?",
            "nextDialogs": [
              "730200333"
            ]
          },
          "730200333": {
            "id": "730200333",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Oh, don't worry about that... Anyway, I don't know how to repay you for all the help you've given me...",
            "nextDialogs": [
              "730200334"
            ]
          },
          "730200334": {
            "id": "730200334",
            "speakerId": 1001,
            "speakerName": "Arachatora",
            "text": "Hmm... I've decided to give you my Supreme Delicacy's recipe. Perhaps you'll grow fond of its taste as you age.",
            "nextDialogs": [
              "730200335"
            ]
          },
          "730200335": {
            "id": "730200335",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#({NICKNAME}, if Paimon modifies this recipe a little, it should be able to become a pretty good original dish!)"
          }
        }
      }
    },

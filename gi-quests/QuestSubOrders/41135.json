  },
  "subQuests": [
    {
      "subId": "4113501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411350101"
        ],
        "dialogs": {
          "411350101": {
            "id": "411350101",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "I wonder how Glory is getting on...",
            "nextDialogs": [
              "411350102"
            ]
          },
          "411350102": {
            "id": "411350102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "411350103"
            ]
          },
          "411350103": {
            "id": "411350103",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "Ah, it's you, Traveler. It's dangerous out here right now.",
            "nextDialogs": [
              "411350104"
            ]
          },
          "411350104": {
            "id": "411350104",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "If you'd like to seek shelter somewhere safe, you should return to Mondstadt as soon as you can.",
            "nextDialogs": [
              "411350105"
            ]
          },
          "411350105": {
            "id": "411350105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're not heading back?",
            "nextDialogs": [
              "411350106"
            ]
          },
          "411350106": {
            "id": "411350106",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "Well, I... I'm staying out here for now. I am a Knight of Favonius, after all — I cannot abandon my post at a moment like this.",
            "nextDialogs": [
              "411350107"
            ]
          },
          "411350107": {
            "id": "411350107",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "I can't return to Mondstadt for various reasons, but I can still stay here and help out.",
            "nextDialogs": [
              "411350108"
            ]
          },
          "411350108": {
            "id": "411350108",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "After the meteorites fell down, many monsters came under their influence, becoming exceedingly aggressive.",
            "nextDialogs": [
              "411350109"
            ]
          },
          "411350109": {
            "id": "411350109",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "If left unchecked, they will definitely make huge trouble for us later. I was just getting ready to wipe them out, in fact.",
            "nextDialogs": [
              "411350110"
            ]
          },
          "411350110": {
            "id": "411350110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Can you do it by yourself?",
            "nextDialogs": [
              "411350111"
            ]
          },
          "411350111": {
            "id": "411350111",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "Uh, so they do have great numbers... But as long as I'm careful, I should be fine.",
            "nextDialogs": [
              "411350112"
            ]
          },
          "411350112": {
            "id": "411350112",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "But if I were to go alone, who knows how long it would take to defeat them.",
            "nextDialogs": [
              "411350113"
            ]
          },
          "411350113": {
            "id": "411350113",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "If you don't mind, Traveler, could you help me clear their camp out?",
            "nextDialogs": [
              "411350115",
              "411350117"
            ]
          },
          "411350115": {
            "id": "411350115",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "Thank you, that would be a great help to me."
          },
          "411350117": {
            "id": "411350117",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "Ask the Knights for— Well... Suffice it to say that I have my own private troubles.",
            "nextDialogs": [
              "411350118"
            ]
          },
          "411350118": {
            "id": "411350118",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "Please lend me a hand in destroying that monster camp. You may consider it as a favor done for the Knights as well."
          }
        }
      }
    },
    {
      "subId": "4113502",
      "subQuestName": "Talk to Godwin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4113503",
      "subQuestName": "Clear out the hilichurl camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411350301"
        ],
        "dialogs": {
          "411350301": {
            "id": "411350301",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "Have you managed to wipe all the monsters out?",
            "nextDialogs": [
              "411350302"
            ]
          },
          "411350302": {
            "id": "411350302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "All clear.",
            "nextDialogs": [
              "411350303"
            ]
          },
          "411350303": {
            "id": "411350303",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "You have my thanks, Traveler. They should cease to be a threat for now.",
            "nextDialogs": [
              "411350304"
            ]
          },
          "411350304": {
            "id": "411350304",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "You should head back to the city. I'm very sorry for asking you to risk yourself out in the wild while all this is happening.",
            "nextDialogs": [
              "411350305"
            ]
          },
          "411350305": {
            "id": "411350305",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "When you're back in the city... could you help me take note of something?",
            "nextDialogs": [
              "411350306"
            ]
          },
          "411350306": {
            "id": "411350306",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "I—It's a very simple matter! You just need to help me look out for it.",
            "nextDialogs": [
              "411350307"
            ]
          },
          "411350307": {
            "id": "411350307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What might that be?",
            "nextDialogs": [
              "411350308"
            ]
          },
          "411350308": {
            "id": "411350308",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "Well... When you're back in the city, can you help me see how Glory is doing?",
            "nextDialogs": [
              "411350309"
            ]
          },
          "411350309": {
            "id": "411350309",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "She should still be safe in the city, but I can't help but worry.",
            "nextDialogs": [
              "411350310"
            ]
          },
          "411350310": {
            "id": "411350310",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "So could you check in on her for me, please?",
            "nextDialogs": [
              "411350311"
            ]
          },
          "411350311": {
            "id": "411350311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure.",
            "nextDialogs": [
              "411350312"
            ]
          },
          "411350312": {
            "id": "411350312",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "Thank you, Traveler. Oh, yes — could you also refrain from telling her that I'm here? Just... just tell her that I'm still on a mission in a faraway land.",
            "nextDialogs": [
              "411350313"
            ]
          },
          "411350313": {
            "id": "411350313",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "I'm sorry, but I'm counting on you — you must tell her this. Again, my apologies, but I cannot share our private troubles with you."
          }
        }
      }
    },
    {
      "subId": "4113504",
      "subQuestName": "Clear out the hilichurl camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411350401"
        ],
        "dialogs": {
          "411350401": {
            "id": "411350401",
            "speakerId": 1001,
            "speakerName": "Glory",
            "text": "I do hope Godwin is alright...",
            "nextDialogs": [
              "411350402"
            ]
          },
          "411350402": {
            "id": "411350402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hey there. Godwin's asked me to check in on you.",
            "nextDialogs": [
              "411350403"
            ]
          },
          "411350403": {
            "id": "411350403",
            "speakerId": 1001,
            "speakerName": "Glory",
            "text": "Godwin? D—Do you know where he is? I haven't heard from him in a good long while, and I've been worried.",
            "nextDialogs": [
              "411350404"
            ]
          },
          "411350404": {
            "id": "411350404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He's still on a mission in a faraway land.",
            "nextDialogs": [
              "411350405"
            ]
          },
          "411350405": {
            "id": "411350405",
            "speakerId": 1001,
            "speakerName": "Glory",
            "text": "Oh... I see. Alright then.",
            "nextDialogs": [
              "411350406"
            ]
          },
          "411350406": {
            "id": "411350406",
            "speakerId": 1001,
            "speakerName": "Glory",
            "text": "If not for these meteorites, I would have asked after his whereabouts with the Knights...",
            "nextDialogs": [
              "411350407"
            ]
          },
          "411350407": {
            "id": "411350407",
            "speakerId": 1001,
            "speakerName": "Glory",
            "text": "I've been staying inside the city, so I've been safe so far. But he's probably still out there accomplishing his mission. If this phenomenon is occurring all over the world...",
            "nextDialogs": [
              "411350408"
            ]
          },
          "411350408": {
            "id": "411350408",
            "speakerId": 1001,
            "speakerName": "Glory",
            "text": "*sigh* I hope that he's alright.",
            "nextDialogs": [
              "411350409"
            ]
          },
          "411350409": {
            "id": "411350409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He will be.",
            "nextDialogs": [
              "411350410"
            ]
          },
          "411350410": {
            "id": "411350410",
            "speakerId": 1001,
            "speakerName": "Glory",
            "text": "Thank you. That would be wonderful. Oh, yes. Could you help me with something?",
            "nextDialogs": [
              "411350411"
            ]
          },
          "411350411": {
            "id": "411350411",
            "speakerId": 1001,
            "speakerName": "Glory",
            "text": "I purchased a set of Dandelion Seeds from Flora, and I was looking for someone to help me scatter them from a high vantage point... to let the wind carry them to Godwin.",
            "nextDialogs": [
              "411350412"
            ]
          },
          "411350412": {
            "id": "411350412",
            "speakerId": 1001,
            "speakerName": "Glory",
            "text": "But things being as they are, I don't think I'll be able to find someone who can help me at the moment.",
            "nextDialogs": [
              "411350413"
            ]
          },
          "411350413": {
            "id": "411350413",
            "speakerId": 1001,
            "speakerName": "Glory",
            "text": "Since you're here, could you help me bring these Dandelion Seeds to Godwin?",
            "nextDialogs": [
              "411350414"
            ]
          },
          "411350414": {
            "id": "411350414",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No problem.",
            "nextDialogs": [
              "411350415"
            ]
          },
          "411350415": {
            "id": "411350415",
            "speakerId": 1001,
            "speakerName": "Glory",
            "text": "Thank you. He must be in a very faraway place right now. He did set out on that expedition with the Grand Master, after all.",
            "nextDialogs": [
              "411350416"
            ]
          },
          "411350416": {
            "id": "411350416",
            "speakerId": 1001,
            "speakerName": "Glory",
            "text": "Please take these Dandelion Seeds to him and tell him that I'm doing well. And then... remind him to take good care of himself."
          }
        }
      }
    },

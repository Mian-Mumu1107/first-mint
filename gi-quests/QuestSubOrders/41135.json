    {
      "subId": "4113507",
      "subQuestName": "Give the Dandelion Seeds to Godwin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411350501"
        ],
        "dialogs": {
          "411350501": {
            "id": "411350501",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "Traveler, did you meet Glory?",
            "nextDialogs": [
              "411350502"
            ]
          },
          "411350502": {
            "id": "411350502",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "How is she? Is she well? Was she injured? Is she— Well, yes, I know that she's been in the city this entire time, but still—!",
            "nextDialogs": [
              "411350503"
            ]
          },
          "411350503": {
            "id": "411350503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She sent you some Dandelion Seeds.",
            "nextDialogs": [
              "411350504"
            ]
          },
          "411350504": {
            "id": "411350504",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "Dandelion Seeds... That's just like her. *sigh* I hope she's not angry with me.",
            "nextDialogs": [
              "411350505"
            ]
          },
          "411350505": {
            "id": "411350505",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "Thank you for helping me this time as well. Please, take these.",
            "nextDialogs": [
              "411350506"
            ]
          },
          "411350506": {
            "id": "411350506",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "*sigh* If only the Grand Master could return right now — this problem would be solved in no time at all."
          }
        }
      }
    },
    {
      "subId": "4113502",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411350201"
        ],
        "dialogs": {
          "411350201": {
            "id": "411350201",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "Where in the world is the Grand Master... I wonder if he's received any word that something like this has happened?",
            "nextDialogs": [
              "411350202"
            ]
          },
          "411350202": {
            "id": "411350202",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "*sigh* But even if he received the news, he wouldn't be able to return so soon, either..."
          }
        }
      }
    },

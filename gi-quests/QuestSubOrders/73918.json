        "dialogs": {
          "739180101": {
            "id": "739180101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Forest Watchers might have a problem with that.",
            "nextDialogs": [
              "739180102"
            ]
          },
          "739180102": {
            "id": "739180102",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "Th—They can't know it, for sure!",
            "nextDialogs": [
              "739180103"
            ]
          },
          "739180103": {
            "id": "739180103",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "I bumped into a long-tailed Forest Watcher once and got my noggin beaten. It really hurt!",
            "nextDialogs": [
              "739180104"
            ]
          },
          "739180104": {
            "id": "739180104",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "But if you think about it, it's actually quite some memory, to be dragged by rescue dogs all the way to Gandharva Ville. You should try it sometime.",
            "nextDialogs": [
              "739180105"
            ]
          },
          "739180105": {
            "id": "739180105",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "Just kidding! It's important to listen to the Forest Watchers for your own safety.",
            "nextDialogs": [
              "739180106"
            ]
          },
          "739180106": {
            "id": "739180106",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "After all, the rainforest is full of both safe ingredients that can make a delicious meal and inedible stuff one should avoid."
          }
        }
      }
    }
  ]

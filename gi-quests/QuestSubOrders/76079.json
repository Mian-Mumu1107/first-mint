          "760790101"
        ],
        "dialogs": {
          "760790101": {
            "id": "760790101",
            "speakerId": 1000,
            "speakerName": "Flins",
            "text": "The monsters have disappeared, but still, a fissure remains. And through it...",
            "nextDialogs": [
              "760790102"
            ]
          },
          "760790102": {
            "id": "760790102",
            "speakerId": 1000,
            "speakerName": "Flins",
            "text": "I sense the thick stench of the Abyss. Something lurks behind this rift.",
            "nextDialogs": [
              "760790103"
            ]
          },
          "760790103": {
            "id": "760790103",
            "speakerId": 1000,
            "speakerName": "Flins",
            "text": "Well, come out then. Or would you prefer a sealed letter of invitation?",
            "nextDialogs": [
              "760790104"
            ]
          },
          "760790104": {
            "id": "760790104",
            "speakerId": 1000,
            "speakerName": "Flins",
            "text": "Did you truly think sneaking out of the fissure unseen would allow you to escape our eyes?"
          }
        }
      }
    },
    {
      "subId": "7607903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760790301"
        ],
        "dialogs": {
          "760790301": {
            "id": "760790301",
            "speakerId": 1001,
            "speakerName": "Strange Rift",
            "text": "(Though the monsters have dispersed, the darkness has not faded. You may need to enlist the help of a professional who knows more about the Wild Hunt.)"
          }
        }
      }
    },
    {
      "subId": "7607904",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760790201"
        ],
        "dialogs": {
          "760790201": {
            "id": "760790201",
            "speakerId": 1000,
            "speakerName": "Flins",
            "text": "The monsters that follow the Wild Hunt do not utterly lack intelligence, and they have some sense of strategy.",
            "nextDialogs": [
              "760790202"
            ]
          },
          "760790202": {
            "id": "760790202",
            "speakerId": 1000,
            "speakerName": "Flins",
            "text": "As such, the consequences for underestimating the enemy in any battle are dire indeed."
          }
        }
      }
    },
    {
      "subId": "7607904",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760790401"
        ],
        "dialogs": {
          "760790401": {
            "id": "760790401",
            "speakerId": 1002,
            "speakerName": "Illuga",
            "text": "The monsters here have been driven back, and yet a Wild Hunt rift remains. Could it be...?",
            "nextDialogs": [
              "760790402"
            ]
          },
          "760790402": {
            "id": "760790402",
            "speakerId": 1002,
            "speakerName": "Illuga",
            "text": "Enough hiding, you wretch. I know you're lurking behind that rift.",
            "nextDialogs": [
              "760790403"
            ]
          },
          "760790403": {
            "id": "760790403",
            "speakerId": 1002,
            "speakerName": "Illuga",
            "text": "Cheap tricks like this won't fool me. Come out and face your end!"
          }
        }
      }
    },
    {
      "subId": "7607905",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760790501"
        ],
        "dialogs": {
          "760790501": {
            "id": "760790501",
            "speakerId": 1002,
            "speakerName": "Illuga",
            "text": "That should be the last of them... The old man was right. The Wild Hunt has been getting craftier lately.",
            "nextDialogs": [
              "760790502"
            ]
          },
          "760790502": {
            "id": "760790502",
            "speakerId": 1002,
            "speakerName": "Illuga",
            "text": "Looks like we'll need to be a lot more careful from now on."
          }
        }
      }
    }
  ]

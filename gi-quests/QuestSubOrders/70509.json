    {
      "subId": "7050902",
      "subQuestName": "Mix Shenhe the specified drink",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705090201"
        ],
        "dialogs": {
          "705090201": {
            "id": "705090201",
            "speakerId": 1000,
            "speakerName": "Shenhe",
            "text": "Hmm, it's sweet and smooth. Not bitter at all. What is it?",
            "nextDialogs": [
              "705090202"
            ]
          },
          "705090202": {
            "id": "705090202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's called a Snow-Covered Kiss! Whisk milk until it froths, and then gently pour it over some juice. It looks like it's covered by a layer of snow.",
            "nextDialogs": [
              "705090203"
            ]
          },
          "705090203": {
            "id": "705090203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Don't ask why it's called a kiss, though... Paimon doesn't get it either. It's probably just a gimmick to get it to sell better!",
            "nextDialogs": [
              "705090204"
            ]
          },
          "705090204": {
            "id": "705090204",
            "speakerId": 1000,
            "speakerName": "Shenhe",
            "text": "A gimmick?",
            "nextDialogs": [
              "705090205"
            ]
          },
          "705090205": {
            "id": "705090205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh, Paimon's just guessing... Maybe it's more of a romantic description!",
            "nextDialogs": [
              "705090206"
            ]
          },
          "705090206": {
            "id": "705090206",
            "speakerId": 1000,
            "speakerName": "Shenhe",
            "text": "Romantic?",
            "nextDialogs": [
              "705090207"
            ]
          },
          "705090207": {
            "id": "705090207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uhh... It's hard to explain! Stop making Paimon come up with things.",
            "nextDialogs": [
              "705090210"
            ]
          },
          "705090210": {
            "id": "705090210",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Mm-hmm, that's right."
          }
        }
      }
    },

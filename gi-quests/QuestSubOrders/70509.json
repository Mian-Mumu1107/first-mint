  "subQuests": [
    {
      "subId": "7050901",
      "subQuestName": "Talk to Luka and enter the tavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705090101"
        ],
        "dialogs": {
          "705090101": {
            "id": "705090101",
            "speakerId": 1000,
            "speakerName": "Shenhe",
            "text": "#Hello, {NICKNAME}.",
            "nextDialogs": [
              "705090102"
            ]
          },
          "705090102": {
            "id": "705090102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hi there! Paimon would be more surprised to see you if we hadn't already seen a bunch of our friends...",
            "nextDialogs": [
              "705090103"
            ]
          },
          "705090103": {
            "id": "705090103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh!? Wait, you're Shenhe! This is a surprise!",
            "nextDialogs": [
              "705090104"
            ]
          },
          "705090104": {
            "id": "705090104",
            "speakerId": 1000,
            "speakerName": "Shenhe",
            "text": "This place isn't easy to find. Angel's Share... The name doesn't exactly roll off the tongue.",
            "nextDialogs": [
              "705090105"
            ]
          },
          "705090105": {
            "id": "705090105",
            "speakerId": 1000,
            "speakerName": "Shenhe",
            "text": "Mr. Zhongli was kind enough to help me with directions. I'm thankful.",
            "nextDialogs": [
              "705090106"
            ]
          },
          "705090106": {
            "id": "705090106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You needed help with directions?... Wait, you came all this way just for a drink?",
            "nextDialogs": [
              "705090107"
            ]
          },
          "705090107": {
            "id": "705090107",
            "speakerId": 1000,
            "speakerName": "Shenhe",
            "text": "That's right.",
            "nextDialogs": [
              "705090108"
            ]
          },
          "705090108": {
            "id": "705090108",
            "speakerId": 1000,
            "speakerName": "Shenhe",
            "text": "Because... we're friends.",
            "nextDialogs": [
              "705090109"
            ]
          },
          "705090109": {
            "id": "705090109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What would you like?",
            "nextDialogs": [
              "705090110"
            ]
          },
          "705090110": {
            "id": "705090110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Here's the menu!",
            "nextDialogs": [
              "705090111"
            ]
          },
          "705090111": {
            "id": "705090111",
            "speakerId": 1000,
            "speakerName": "Shenhe",
            "text": "Boreal Watch... Hmm, Boreal? As in a cold climate?",
            "nextDialogs": [
              "705090112"
            ]
          },
          "705090112": {
            "id": "705090112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, Boreal Watch here probably is referring to the Wolf of the North. So yeah, you could say it's cold.",
            "nextDialogs": [
              "705090113"
            ]
          },
          "705090113": {
            "id": "705090113",
            "speakerId": 1000,
            "speakerName": "Shenhe",
            "text": "Caramel Pinecone... How could that be a drink?",
            "nextDialogs": [
              "705090114"
            ]
          },
          "705090114": {
            "id": "705090114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, Paimon's tried that one. It's actually caramel flavored coffee. \"Pinecone\" just refers to the color!",
            "nextDialogs": [
              "705090115"
            ]
          },
          "705090115": {
            "id": "705090115",
            "speakerId": 1000,
            "speakerName": "Shenhe",
            "text": "Huh...",
            "nextDialogs": [
              "705090116"
            ]
          },
          "705090116": {
            "id": "705090116",
            "speakerId": 1000,
            "speakerName": "Shenhe",
            "text": "These names are confusing. I can't make sense of any of these.",
            "nextDialogs": [
              "705090117"
            ]
          },
          "705090117": {
            "id": "705090117",
            "speakerId": 1000,
            "speakerName": "Shenhe",
            "text": "I'll leave it up to you. As long as it's something that tastes like Qingxin or Violetgrass.",
            "nextDialogs": [
              "705090118"
            ]
          },
          "705090118": {
            "id": "705090118",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Those medicinal herbs don't grow around here. If you want something bitter, then it'd have to be coffee...",
            "nextDialogs": [
              "705090119"
            ]
          },
          "705090119": {
            "id": "705090119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How about something sweet instead?",
            "nextDialogs": [
              "705090120"
            ]
          },
          "705090120": {
            "id": "705090120",
            "speakerId": 1000,
            "speakerName": "Shenhe",
            "text": "Fine.",
            "nextDialogs": [
              "705090121"
            ]
          },
          "705090121": {
            "id": "705090121",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's a good idea. You've practiced the adepti arts long enough. It's time for something new!",
            "nextDialogs": [
              "705090122"
            ]
          },
          "705090122": {
            "id": "705090122",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's make Shenhe a Snow-Covered Kiss! It sounds like a perfect fit for her."
          }
        }
      }
    },

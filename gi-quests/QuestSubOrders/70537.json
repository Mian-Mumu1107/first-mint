        ],
        "dialogs": {
          "705371401": {
            "id": "705371401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Whoa! It's so scary! Let's run!",
            "nextDialogs": [
              "705371402"
            ]
          },
          "705371402": {
            "id": "705371402",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Even you think it's dangerous!? Does that mean that this box is oozing murderous intent... Let's get out of here!"

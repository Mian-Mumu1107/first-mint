          "705371201"
        ],
        "dialogs": {
          "705371201": {
            "id": "705371201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Haha! Explosives! My kind of fun!",
            "nextDialogs": [
              "705371202"
            ]
          },
          "705371202": {
            "id": "705371202",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Why are you suddenly so excited? We don't even know how powerful these explosives are! What if we hurt innocent bystanders?",
            "nextDialogs": [
              "705371205"
            ]
          },
          "705371205": {
            "id": "705371205",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eek!",
            "nextDialogs": [
              "705371206"
            ]
          },
          "705371206": {
            "id": "705371206",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But when you put it like that... Paimon really does want to try...",
            "nextDialogs": [
              "705371207"
            ]
          },
          "705371207": {
            "id": "705371207",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Normally we're always hearing about how Klee wants to blast fish, is blasting fish, or is getting punished for doing it...",
            "nextDialogs": [
              "705371208"
            ]
          },
          "705371208": {
            "id": "705371208",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But now that Paimon is here, by the lakeside, with a box of explosives beside her... Paimon really wants to try it, too!",
            "nextDialogs": [
              "705371209"
            ]
          },
          "705371209": {
            "id": "705371209",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Throwing just one should be... no big deal, right?"
          }
        }
      }
    },
    {
      "subId": "7053701",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705370101"
        ],
        "dialogs": {
          "705370101": {
            "id": "705370101",
            "speakerId": 1001,
            "speakerName": "Suspicious Wooden Chest",
            "text": "A suspicious wooden box, never seen before. A piece of paper is lodged in the cracks between the boards on the lid. Written on it is \"Property of the Investigation Team. Materials of the highest grade of danger are within. Handle with care.\""
          }
        }
      }
    },
    {
      "subId": "7053711",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705371101"
        ],
        "dialogs": {
          "705371101": {
            "id": "705371101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Seems like it's worth \"investigating\"...",
            "nextDialogs": [
              "705371102"
            ]
          },
          "705371102": {
            "id": "705371102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That note on the box sounds... terrifying!",
            "nextDialogs": [
              "705371103"
            ]
          },
          "705371103": {
            "id": "705371103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Why would something so obviously dangerous be left right by Cider Lake? Could it belong to those two knights over there?",
            "nextDialogs": [
              "705371104"
            ]
          },
          "705371104": {
            "id": "705371104",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It looks like there's a wide gap between the planks! We should be able to see inside!",
            "nextDialogs": [
              "705371105"
            ]
          },
          "705371105": {
            "id": "705371105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Let Paimon have a look... It appears to be filled with... lots of round, red objects, much larger than Sunsettias...",
            "nextDialogs": [
              "705371106"
            ]
          },
          "705371106": {
            "id": "705371106",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Waitasec, could they be... bombs!?",
            "nextDialogs": [
              "705371107"
            ]
          },
          "705371107": {
            "id": "705371107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Why would the Knights of Favonius leave a box of explosives by the lake? Are they planning to blow up... those invasive fish that Lisa mentioned?"
          }
        }
      }
    },
    {
      "subId": "7053713",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705371301"
        ],
        "dialogs": {
          "705371301": {
            "id": "705371301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Whoa! So scary! Let's get out of here!",
            "nextDialogs": [
              "705371302"
            ]
          },
          "705371302": {
            "id": "705371302",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yeah, that's right! A whole box of bombs! We should get as far away from something that dangerous as we can!"
          }
        }
      }
    },
    {
      "subId": "7053714",
      "subQuestName": "Additional",

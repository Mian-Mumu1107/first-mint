  "subQuests": [
    {
      "subId": "7266201",
      "subQuestName": "Talk to Kujirai Momiji",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726620101"
        ],
        "dialogs": {
          "726620101": {
            "id": "726620101",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "Look, guys! I flipped through my father's sailing log again.",
            "nextDialogs": [
              "726620102"
            ]
          },
          "726620102": {
            "id": "726620102",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "There's an appendix in there that mentions a special fish bait formula they had developed.",
            "nextDialogs": [
              "726620103"
            ]
          },
          "726620103": {
            "id": "726620103",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "When they encountered the \"Lunar Leviathan,\" they used a special bait that mixed Seagrass and Magical Crystal Ore.",
            "nextDialogs": [
              "726620104"
            ]
          },
          "726620104": {
            "id": "726620104",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "If we can also make this, we may be able to attract the \"Lunar Leviathan.\"",
            "nextDialogs": [
              "726620105"
            ]
          },
          "726620105": {
            "id": "726620105",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "I have a lot of Seagrass, but the Magical Crystal Ore...",
            "nextDialogs": [
              "726620106"
            ]
          },
          "726620106": {
            "id": "726620106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry, I have them.",
            "nextDialogs": [
              "726620107"
            ]
          },
          "726620107": {
            "id": "726620107",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "Eh? Really? Were they mined at Araumi?",
            "nextDialogs": [
              "726620108"
            ]
          },
          "726620108": {
            "id": "726620108",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "My father's log mentioned that the Magical Crystal Ore must be mined from the ruins at Araumi.",
            "nextDialogs": [
              "726620109"
            ]
          },
          "726620109": {
            "id": "726620109",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "Although I'm not sure what the difference is, compared to ordinary Magical Crystal Ore, but since we have decided to do so, we should be more rigorous and follow the sailing log closely.",
            "nextDialogs": [
              "726620110"
            ]
          },
          "726620110": {
            "id": "726620110",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "Speaking of which, there are a lot of dangerous monsters over at Araumi. Let's go to the Adventurers' Guild and put up a commission.",
            "nextDialogs": [
              "726620111"
            ]
          },
          "726620111": {
            "id": "726620111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's okay, I'll handle them.",
            "nextDialogs": [
              "726620112"
            ]
          },
          "726620112": {
            "id": "726620112",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "Ah... Right, I forgot you are a powerful adventurer!",
            "nextDialogs": [
              "726620113"
            ]
          },
          "726620113": {
            "id": "726620113",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "I'm so lucky to have your help, I'm counting on you!",
            "nextDialogs": [
              "726620114"
            ]
          },
          "726620114": {
            "id": "726620114",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "I'll go back and get some bait-making tools, let's meet up later at the beach on the west of Araumi."
          }
        }
      }
    },
    {
      "subId": "7266202",
      "subQuestName": "Go to Araumi and look for the Special Magical Crystal Ore",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726620201"
        ],
        "dialogs": {
          "726620201": {
            "id": "726620201",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "You found them so quickly? You're a powerful adventurer indeed!",
            "nextDialogs": [
              "726620202"
            ]
          },
          "726620202": {
            "id": "726620202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Will these be enough?",
            "nextDialogs": [
              "726620203"
            ]
          },
          "726620203": {
            "id": "726620203",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "Well, watch me next, I just have to do this...this...and this...",
            "nextDialogs": [
              "726620204"
            ]
          },
          "726620204": {
            "id": "726620204",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "This should be it, that's all.",
            "nextDialogs": [
              "726620205"
            ]
          },
          "726620205": {
            "id": "726620205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The next step is to scatter the bait and wait for the \"Lunar Leviathan\" to appear, right?",
            "nextDialogs": [
              "726620206"
            ]
          },
          "726620206": {
            "id": "726620206",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "Yes, I purposely chose this place, from where we reached the shore back then.",
            "nextDialogs": [
              "726620207"
            ]
          },
          "726620207": {
            "id": "726620207",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "The \"Lunar Leviathan\" that guided us back to the ship also disappeared here.",
            "nextDialogs": [
              "726620208"
            ]
          },
          "726620208": {
            "id": "726620208",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "So, is everyone ready? Don't forget to make a wish when you see the \"Lunar Leviathan.\"",
            "nextDialogs": [
              "726620209"
            ]
          },
          "726620209": {
            "id": "726620209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What if it doesn't work?",
            "nextDialogs": [
              "726620210"
            ]
          },
          "726620210": {
            "id": "726620210",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "...",
            "nextDialogs": [
              "726620211"
            ]
          },
          "726620211": {
            "id": "726620211",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "Don't say such discouraging things, it will work. The \"Lunar Leviathan\" will definitely come.",
            "nextDialogs": [
              "726620212"
            ]
          },
          "726620212": {
            "id": "726620212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah! It will work! Big fish, big fish, you must be good and bite the bait! I'm counting on you!",
            "nextDialogs": [
              "726620213"
            ]
          },
          "726620213": {
            "id": "726620213",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "Look! Look at this! It's glowing under the water! Something's coming!",
            "nextDialogs": [
              "726620214"
            ]
          },
          "726620214": {
            "id": "726620214",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really? Is the \"Lunar Leviathan\" really here?",
            "nextDialogs": [
              "726620215"
            ]
          },
          "726620215": {
            "id": "726620215",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Help, it's a Ruin Guard!",
            "nextDialogs": [
              "726620216"
            ]
          },
          "726620216": {
            "id": "726620216",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why is it this guy!"
          }
        }
      }
    },
    {
      "subId": "7266203",
      "subQuestName": "Collect 3 Special Magical Crystal Ore",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726620301"
        ],
        "dialogs": {
          "726620301": {
            "id": "726620301",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "How...how did this happen, even my father's bait formula didn't work?",
            "nextDialogs": [
              "726620302"
            ]
          },
          "726620302": {
            "id": "726620302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Don't be sad, it's that Ruin Guard's fault! It must have scared the \"Lunar Leviathan\" away! Let's try again!",
            "nextDialogs": [
              "726620303"
            ]
          },
          "726620303": {
            "id": "726620303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yeah, let's try again.",
            "nextDialogs": [
              "726620304"
            ]
          },
          "726620304": {
            "id": "726620304",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "...",
            "nextDialogs": [
              "726620305"
            ]
          },
          "726620305": {
            "id": "726620305",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "...",
            "nextDialogs": [
              "726620306"
            ]
          },
          "726620306": {
            "id": "726620306",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "Let's forget it for now, I'm a little tired. Maybe Nantuck is right?",
            "nextDialogs": [
              "726620307"
            ]
          },
          "726620307": {
            "id": "726620307",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "*sigh* I want to go and take a stroll outside. I have to think about what happens after this.",
            "nextDialogs": [
              "726620308"
            ]
          },
          "726620308": {
            "id": "726620308",
            "speakerId": 3200,
            "speakerName": "Kujirai Momiji",
            "text": "Here's your payment. Whatever the case, thank you very much for your help.",
            "nextDialogs": [
              "726620309"
            ]
          },
          "726620309": {
            "id": "726620309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like Ms. Kujirai wants to be left alone now, let's come back to see her later."
          }
        }
      }
    },

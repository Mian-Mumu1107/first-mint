{
  "lineCounts": {
    "Jiangxue": 9,
    "Player": 9,
    "Smiley Yanxiao": 28
  },
  "subQuests": [
    {
      "subId": "2200301",
      "subQuestName": "Talk to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220030101"
        ],
        "dialogs": {
          "220030101": {
            "id": "220030101",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Hmph, he's got some nerve scrounging off me all this time...",
            "nextDialogs": [
              "220030102"
            ]
          },
          "220030102": {
            "id": "220030102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "220030103"
            ]
          },
          "220030103": {
            "id": "220030103",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "I'm cooking for someone who doesn't deserve it, that's what!",
            "nextDialogs": [
              "220030104"
            ]
          },
          "220030104": {
            "id": "220030104",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Unbelievable! He whiles away his time doing whatever he pleases and doesn't even offer to help at the inn.",
            "nextDialogs": [
              "220030105"
            ]
          },
          "220030105": {
            "id": "220030105",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "He spends most of his day fishing, but I've never seen him catch more than a couple of tiddlers.",
            "nextDialogs": [
              "220030106"
            ]
          },
          "220030106": {
            "id": "220030106",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "If it wasn't for me, he'd starve to death!",
            "nextDialogs": [
              "220030107"
            ]
          },
          "220030107": {
            "id": "220030107",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Ugh, what's the use in complaining. He can't hear me — and even if he could, he'd act like he hadn't.",
            "nextDialogs": [
              "220030108"
            ]
          },
          "220030108": {
            "id": "220030108",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "If you've got nothing better to do, you can go grab me a couple of extra ingredients. I'm running low here.",
            "nextDialogs": [
              "220030109"
            ]
          },
          "220030109": {
            "id": "220030109",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Don't need much. Just one <color=#00E1FFFF>Jueyun Chili</color> and one <color=#00E1FFFF>Lotus Head</color> will do it.",
            "nextDialogs": [
              "220030111",
              "220030113"
            ]
          },
          "220030111": {
            "id": "220030111",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Bring them back here as soon as you find them. I want to get this done and dusted."
          },
          "220030113": {
            "id": "220030113",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "My boss paid good money for those. Do you think this freeloader's gonna pay my boss back? I think not.",
            "nextDialogs": [
              "220030114"
            ]
          },
          "220030114": {
            "id": "220030114",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Everything I cook for him comes out of my own pocket... Hmph, he owes me big time!",
            "nextDialogs": [
              "220030115"
            ]
          },
          "220030115": {
            "id": "220030115",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Just go fetch the vegetables, will you? It's not a huge ask, and it won't take you long."
          }
        }
      }
    },
    {
      "subId": "2200302",
      "subQuestName": "Help Smiley Yanxiao find Jueyun Chili and Lotus Head",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220030201"
        ],
        "dialogs": {
          "220030201": {
            "id": "220030201",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Where are my vegetables?",
            "nextDialogs": [
              "220030204"
            ]
          },
          "220030204": {
            "id": "220030204",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "...Why on earth not!? Go get them! Otherwise, that waste of space is going to turn into a hungry waste of space."
          }
        }
      }
    },
    {
      "subId": "2200303",
      "subQuestName": "Talk to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220030301"
        ],
        "dialogs": {
          "220030301": {
            "id": "220030301",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Wait here. When the food's ready, I'll get you to take it over to him.",
            "nextDialogs": [
              "220030302"
            ]
          },
          "220030302": {
            "id": "220030302",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Don't look so hard done by! I'm not making you do this for free. You'll get what you deserve, don't you worry.",
            "nextDialogs": [
              "220030303"
            ]
          },
          "220030303": {
            "id": "220030303",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Alright. It's ready. Take this over to Mr. Doesn't-Know-How-Lucky-He-Is...",
            "nextDialogs": [
              "220030304"
            ]
          },
          "220030304": {
            "id": "220030304",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "His name is <color=#00E1FFFF>Jiangxue</color>. He'll be fishing down by the water, you can't miss him."
          }
        }
      }
    },
    {
      "subId": "2200304",
      "subQuestName": "Bring the dish Smiley Yanxiao made to Jiangxue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220030501"
        ],
        "dialogs": {
          "220030501": {
            "id": "220030501",
            "speakerId": 1001,
            "speakerName": "Jiangxue",
            "text": "Hello? Is it me you're looking for?",
            "nextDialogs": [
              "220030502"
            ]
          },
          "220030502": {
            "id": "220030502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This is from Smiley Yanxiao.",
            "nextDialogs": [
              "220030503"
            ]
          },
          "220030503": {
            "id": "220030503",
            "speakerId": 1001,
            "speakerName": "Jiangxue",
            "text": "Aha! I was wondering where that delicious smell was coming from. He's a really talented chef, you know.",
            "nextDialogs": [
              "220030504"
            ]
          },
          "220030504": {
            "id": "220030504",
            "speakerId": 1001,
            "speakerName": "Jiangxue",
            "text": "Thanks for bringing this. And make sure you thank him profusely for me when you get back."
          }
        }
      }
    },
    {
      "subId": "2200305",
      "subQuestName": "Report back to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220030601"
        ],
        "dialogs": {
          "220030601": {
            "id": "220030601",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Did you deliver the food?",
            "nextDialogs": [
              "220030602"
            ]
          },
          "220030602": {
            "id": "220030602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, and he said to make sure I—",
            "nextDialogs": [
              "220030603"
            ]
          },
          "220030603": {
            "id": "220030603",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Thank me profusely? Please. Spare me that charade.",
            "nextDialogs": [
              "220030604"
            ]
          },
          "220030604": {
            "id": "220030604",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "The number of times I've heard those words these last few years... drives me mad.",
            "nextDialogs": [
              "220030605"
            ]
          },
          "220030605": {
            "id": "220030605",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Thanking me profusely seems to be his only other pastime aside from fishing. Tell you what, how about pack all that in, stop wasting time, and come earn your keep at the inn?",
            "nextDialogs": [
              "220030606"
            ]
          },
          "220030606": {
            "id": "220030606",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Ah, there's no use me venting at you. Here's your reward — you've earned it, unlike some people. Now you can get back to living your life."
          }
        }
      }
    },
    {
      "subId": "2200304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220030401"
        ],
        "dialogs": {
          "220030401": {
            "id": "220030401",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "And don't delay! A happy cheapskate is preferable to a hungry cheapskate, trust me.",
            "nextDialogs": [
              "220030402"
            ]
          },
          "220030402": {
            "id": "220030402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why do you cook for him?",
            "nextDialogs": [
              "220030403"
            ]
          },
          "220030403": {
            "id": "220030403",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "If you must know, it's because he's got no one else. I'm the only person he knows in the whole of Liyue. And this is the only place he dares to try and scrounge from.",
            "nextDialogs": [
              "220030404"
            ]
          },
          "220030404": {
            "id": "220030404",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "...What's the reason? Why does it matter? Fine... It's because I'm willing to cook for him. Happy now?",
            "nextDialogs": [
              "220030405"
            ]
          },
          "220030405": {
            "id": "220030405",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "If I wasn't willing to cook for him, he'd probably go and do something stupid down at Dihua Marsh again. And we can't be having that.",
            "nextDialogs": [
              "220030406"
            ]
          },
          "220030406": {
            "id": "220030406",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "What are you still hanging round here for? Quit dawdling and get going!"
          }
        }
      }
    },
    {
      "subId": "2200307",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220030701"
        ],
        "dialogs": {
          "220030701": {
            "id": "220030701",
            "speakerId": 1001,
            "speakerName": "Jiangxue",
            "text": "You're still here? ...It's probably best that you get back; when you keep him waiting he tends to throw one of his temper tantrums.",
            "nextDialogs": [
              "220030702"
            ]
          },
          "220030702": {
            "id": "220030702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why does he cook for you?",
            "nextDialogs": [
              "220030703"
            ]
          },
          "220030703": {
            "id": "220030703",
            "speakerId": 1001,
            "speakerName": "Jiangxue",
            "text": "We're... friends. We've known each other a very long time.",
            "nextDialogs": [
              "220030704"
            ]
          },
          "220030704": {
            "id": "220030704",
            "speakerId": 1001,
            "speakerName": "Jiangxue",
            "text": "I, uh... I went to Dihua Marsh once to do... a bad thing. But something I had to do.",
            "nextDialogs": [
              "220030705"
            ]
          },
          "220030705": {
            "id": "220030705",
            "speakerId": 1001,
            "speakerName": "Jiangxue",
            "text": "This is the only place in the whole of Liyue where they let me stay, and the chef here makes sure I'm fed.",
            "nextDialogs": [
              "220030706"
            ]
          },
          "220030706": {
            "id": "220030706",
            "speakerId": 1001,
            "speakerName": "Jiangxue",
            "text": "I won't elaborate any further — it's a long story, and you probably have better things to do with your time.",
            "nextDialogs": [
              "220030707"
            ]
          },
          "220030707": {
            "id": "220030707",
            "speakerId": 1001,
            "speakerName": "Jiangxue",
            "text": "I'd better let you go — that chef is not the patient type."
          }
        }
      }
    }
  ]
}
      "dialogue": {
        "startDialogs": [
          "756530201"
        ],
        "dialogs": {
          "756530201": {
            "id": "756530201",
            "speakerId": 10033,
            "speakerName": "Xiangling",
            "text": "#{NICKNAME}, it's you! Long time no see! Funny, I just mentioned you to Guoba yesterday, and here we are.",
            "nextDialogs": [
              "756530202"
            ]
          },
          "756530202": {
            "id": "756530202",
            "speakerId": 10033,
            "speakerName": "Xiangling",
            "text": "I guess that's what they call \"fate,\" huh?",
            "nextDialogs": [
              "756530203"
            ]
          },
          "756530203": {
            "id": "756530203",
            "speakerId": 10033,
            "speakerName": "Xiangling",
            "text": "Ah, right. Where are you headed?",
            "nextDialogs": [
              "756530206"
            ]
          },
          "756530206": {
            "id": "756530206",
            "speakerId": 10033,
            "speakerName": "Xiangling",
            "text": "Photo-taking? Ooh, that's a coincidence. I've taken an interest in that lately myself.",
            "nextDialogs": [
              "756530207"
            ]
          },
          "756530207": {
            "id": "756530207",
            "speakerId": 10033,
            "speakerName": "Xiangling",
            "text": "We've been using the same poster at the restaurant for so long. It's high time we got a new one.",
            "nextDialogs": [
              "756530208"
            ]
          },
          "756530208": {
            "id": "756530208",
            "speakerId": 10033,
            "speakerName": "Xiangling",
            "text": "I've been thinking that we could draw passersby in more easily with some beautiful shots of our dishes.",
            "nextDialogs": [
              "756530209"
            ]
          },
          "756530209": {
            "id": "756530209",
            "speakerId": 10033,
            "speakerName": "Xiangling",
            "text": "As the old saying goes: \"A fine meal is three parts color, three parts aroma, three parts taste, and one part advertising.\"",
            "nextDialogs": [
              "756530210"
            ]
          },
          "756530210": {
            "id": "756530210",
            "speakerId": 10033,
            "speakerName": "Xiangling",
            "text": "...Of course, I added that last bit myself.",
            "nextDialogs": [
              "756530211"
            ]
          },
          "756530211": {
            "id": "756530211",
            "speakerId": 10033,
            "speakerName": "Xiangling",
            "text": "Dad always talks about the first three — it's as common culinary wisdom as can be."
          }
        }
      }
    }
  ]
}
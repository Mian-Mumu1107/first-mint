            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "It must be nearby.",
            "nextDialogs": [
              "101012002"
            ]
          },
          "101012002": {
            "id": "101012002",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Using <color=#00E1FFFF>Elemental Sight</color>, you can even detect <color=#00E1FFFF>magic</color>.",
            "nextDialogs": [
              "101012003"
            ]
          },
          "101012003": {
            "id": "101012003",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Follow the flow of <color=#00E1FFFF>magic</color> to find the book."
          }
        }
      }

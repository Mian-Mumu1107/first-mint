    {
      "subId": "1010114",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101010701"
        ],
        "dialogs": {
          "101010701": {
            "id": "101010701",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The thief lives inside <color=#00E1FFFF>ruins</color>? Mondstadt people do have some strange quirks.",
            "nextDialogs": [
              "101010702"
            ]
          },
          "101010702": {
            "id": "101010702",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Please do not jump to such a preposterous conclusion about the living habits of Mondstadt's residents.",
            "nextDialogs": [
              "101010703"
            ]
          },
          "101010703": {
            "id": "101010703",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "This seems far more likely to be the work of some none-too-friendly troublemakers.",
            "nextDialogs": [
              "101010705",
              "101010708",
              "101010710"
            ]
          },
          "101010705": {
            "id": "101010705",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Stealing books is hardly the hilichurls' style.",
            "nextDialogs": [
              "101010706"
            ]
          },
          "101010706": {
            "id": "101010706",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "All they would use books for is to keep their campfire going anyway.",
            "nextDialogs": [
              "101010712"
            ]
          },
          "101010712": {
            "id": "101010712",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "This is more likely to be the <color=#00E1FFFF>Abyss Order's</color> doing. They do seem to have a way of slipping in and out of places like ghosts, after all.",
            "nextDialogs": [
              "101010713"
            ]
          },
          "101010713": {
            "id": "101010713",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Also... There is an elemental seal at the entrance. It looks like the result of an Abyss Mage's magic.",
            "nextDialogs": [
              "101010714"
            ]
          },
          "101010714": {
            "id": "101010714",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A seal? How are we gonna break it? Is this gonna turn into another huge ordeal?",
            "nextDialogs": [
              "101010715"
            ]
          },
          "101010715": {
            "id": "101010715",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Not to worry. If you think a little magic can keep me out, think again!",
            "nextDialogs": [
              "101010716"
            ]
          },
          "101010716": {
            "id": "101010716",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why is that?",
            "nextDialogs": [
              "101010717"
            ]
          },
          "101010717": {
            "id": "101010717",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "Come on.",
            "nextDialogs": [
              "101010718"
            ]
          },
          "101010718": {
            "id": "101010718",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa...",
            "nextDialogs": [
              "101010719"
            ]
          },
          "101010719": {
            "id": "101010719",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So this is what Lisa's like when she's hard at work..."
          },
          "101010708": {
            "id": "101010708",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "It's like you can read my mind."
          },
          "101010710": {
            "id": "101010710",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "It's not unlike them, in the sense that they are known for darting around amongst underground ruins.",
            "nextDialogs": [
              "101010711"
            ]
          },
          "101010711": {
            "id": "101010711",
            "speakerId": 1000,
            "speakerName": "Lisa",
            "text": "But Adventurers do not typically take others' belongings... Well, not from the living, anyway."
          }
        }
      }
    },
    {
      "subId": "1010107",
      "subQuestName": "Enter the book thief's hiding place",

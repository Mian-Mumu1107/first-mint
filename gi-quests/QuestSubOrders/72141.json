        "dialogs": {
          "721411201": {
            "id": "721411201",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "\"He\" is coming! Don't stop worshiping! We must not stop worshiping!",
            "nextDialogs": [
              "721411204"
            ]
          },
          "721411204": {
            "id": "721411204",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "\"He\" is sullen. \"His\" anger shall soon burst forth!"
          }

    {
      "subId": "7214105",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721411101"
        ],
        "dialogs": {
          "721411101": {
            "id": "721411101",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "Worship, listen...",
            "nextDialogs": [
              "721411102"
            ]
          },
          "721411102": {
            "id": "721411102",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "\"He\" is strong because \"he\" listens. \"He\" sees and hears everything because \"he\" is strong. Thus \"he\" sees all there is. Hears all there is.",
            "nextDialogs": [
              "721411103"
            ]
          },
          "721411103": {
            "id": "721411103",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "Neither the fools in Sangonomiya nor the madmen of Narukami Island understand it, feel it. So all they know is to fight each other and let the blood blind their eyes...",
            "nextDialogs": [
              "721411104"
            ]
          },
          "721411104": {
            "id": "721411104",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "But you must understand that.",
            "nextDialogs": [
              "721411107"
            ]
          },
          "721411107": {
            "id": "721411107",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "The answer lies in worship.",
            "nextDialogs": [
              "721411108"
            ]
          },
          "721411108": {
            "id": "721411108",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "Remember. Worship three times a day and you shall be rewarded."
          }
        }
      }
    },

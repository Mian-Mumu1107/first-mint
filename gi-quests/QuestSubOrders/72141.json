    {
      "subId": "7214108",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721411701"
        ],
        "dialogs": {
          "721411701": {
            "id": "721411701",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "\"He\" must be calmed. \"His\" anger must be soothed...",
            "nextDialogs": [
              "721411702"
            ]
          },
          "721411702": {
            "id": "721411702",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "You've done well! You've done very well!",
            "nextDialogs": [
              "721411703"
            ]
          },
          "721411703": {
            "id": "721411703",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "Remember, some will try to cheat you with masks, but \"he\" will help you. \"He\" will always help you.",
            "nextDialogs": [
              "721411706"
            ]
          },
          "721411706": {
            "id": "721411706",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "That woman is like the kitsune demons of legend. I let her go. \"He\" is very angry.",
            "nextDialogs": [
              "721411707"
            ]
          },
          "721411707": {
            "id": "721411707",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "\"He\" is angry again... This is my sin.",
            "nextDialogs": [
              "721411708"
            ]
          },
          "721411708": {
            "id": "721411708",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "Please forgive me... I will sacrifice again. I will find a sacrifice for the \"returning\"...",
            "nextDialogs": [
              "721411709"
            ]
          },
          "721411709": {
            "id": "721411709",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "Please forgive me, please forgive me...",
            "nextDialogs": [
              "721411710"
            ]
          },
          "721411710": {
            "id": "721411710",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "Please forgive me, please forgive me..."
          }
        }
      }
    },
    {
      "subId": "7214118",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721411901"
        ],
        "dialogs": {
          "721411901": {
            "id": "721411901",
            "speakerId": 1000,
            "speakerName": "Outsider Shrine",
            "text": "(This looks like a common shrine with no special features. Seeing Washizu in this state, do you still want to keep paying respects at this shrine?)",
            "nextDialogs": [
              "721411902"
            ]
          },
          "721411902": {
            "id": "721411902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pay respects at the shrine",
            "nextDialogs": [
              "721411904"
            ]
          },
          "721411904": {
            "id": "721411904",
            "speakerId": 1000,
            "speakerName": "Outsider Shrine",
            "text": "(Washizu is still muttering to himself by the side, and he doesn't look well at all. The shrine is still and unresponsive. Perhaps this is all a scam? You try to listen, but nothing happens.)"
          }
        }
      }
    },
    {
      "subId": "7214119",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721412001"
        ],
        "dialogs": {
          "721412001": {
            "id": "721412001",
            "speakerId": 1000,
            "speakerName": "Outsider Shrine",
            "text": "(This looks like a common shrine with no special features. Seeing Washizu in this state, do you still want to keep paying respects at this shrine?)",
            "nextDialogs": [
              "721412002"
            ]
          },
          "721412002": {
            "id": "721412002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Continue to pay respects",
            "nextDialogs": [
              "721412003"
            ]
          },
          "721412003": {
            "id": "721412003",
            "speakerId": 1000,
            "speakerName": "Outsider Shrine",
            "text": "(You hear the wind whistling through the great serpent's bones, but the ancient corpse remains still. It seems to have been weathered by the sea into an instrument — the most mournful instrument in the ocean. You try to listen, but nothing happens.)"
          }
        }
      }
    },

              "721412103"
            ]
          },
          "721412103": {
            "id": "721412103",
            "speakerId": 1000,
            "speakerName": "Outsider Shrine",
            "text": "(Washizu is still muttering to himself by the side, and he doesn't look well. The shrine is still and unresponsive. Perhaps this is all a scam? You try to listen, but nothing happens.)",
            "nextDialogs": [
              "721412104"
            ]
          },
          "721412104": {
            "id": "721412104",
            "speakerId": 1000,
            "speakerName": "Outsider Shrine",
            "text": "\"Watch out behind you...\"",
            "nextDialogs": [
              "721412105"
            ]
          },
          "721412105": {
            "id": "721412105",
            "speakerId": 1000,
            "speakerName": "Outsider Shrine",
            "text": "(Footsteps come from behind, clearly trying to remain unheard.)",
            "nextDialogs": [
              "721412106"
            ]
          },
          "721412106": {
            "id": "721412106",
            "speakerId": 1000,
            "speakerName": "Outsider Shrine",
            "text": "\"Watch out!\""
          }
        }

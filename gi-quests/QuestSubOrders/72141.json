    {
      "subId": "7214102",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721410601"
        ],
        "dialogs": {
          "721410601": {
            "id": "721410601",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "How is it? Were you fortunate enough to hear \"his\" teachings?",
            "nextDialogs": [
              "721410604"
            ]
          },
          "721410604": {
            "id": "721410604",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "Ah, it is alright. It is alright. \"He\" sees. \"He\" hears.",
            "nextDialogs": [
              "721410605"
            ]
          },
          "721410605": {
            "id": "721410605",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "\"He\" is comforted, and those who delight in \"him\" shall be rewarded.",
            "nextDialogs": [
              "721410606"
            ]
          },
          "721410606": {
            "id": "721410606",
            "speakerId": 1001,
            "speakerName": "Washizu",
            "text": "\"His\" reward is not on yonder shore. It is tomorrow."
          }
        }
      }
    },
    {

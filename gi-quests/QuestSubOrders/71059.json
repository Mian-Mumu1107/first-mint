  "subQuests": [
    {
      "subId": "7105906",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710590601"
        ],
        "dialogs": {
          "710590601": {
            "id": "710590601",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Uh... There's no sign of anyone. What are we supposed to tell Katya?",
            "nextDialogs": [
              "710590602"
            ]
          },
          "710590602": {
            "id": "710590602",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, Paimon guesses there's not much we can do. Let's head back."
          }
        }
      }
    },
    {
      "subId": "7105901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710590101"
        ],
        "dialogs": {
          "710590101": {
            "id": "710590101",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Ah, you came! Sit and make yourself at home.",
            "nextDialogs": [
              "710590102"
            ]
          },
          "710590102": {
            "id": "710590102",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "I'm sorry that I sent you away in a hurry last time. I didn't even tell you what I wanted you to help me with.",
            "nextDialogs": [
              "710590107",
              "710590105"
            ]
          },
          "710590107": {
            "id": "710590107",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Relax, I won't make you do anything evil."
          },
          "710590105": {
            "id": "710590105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yep, you're a Fatuus! We won't even lift a finger to help if you're up to something evil!",
            "nextDialogs": [
              "710590106"
            ]
          },
          "710590106": {
            "id": "710590106",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Pfft... you do have a point."
          }
        }
      }
    },
    {
      "subId": "7105902",
      "subQuestName": "Look for clues Nikolay left behind",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710590201"
        ],
        "dialogs": {
          "710590201": {
            "id": "710590201",
            "speakerId": 1002,
            "speakerName": "Shred of Kapral Nikolay's Diary",
            "text": "\"... Oh no! Katya's balalaika is broken. I somehow damaged it during the fracas. Gotta get it repaired before she chews me out...\"",
            "nextDialogs": [
              "710590202"
            ]
          },
          "710590202": {
            "id": "710590202",
            "speakerId": 1002,
            "speakerName": "Shred of Kapral Nikolay's Diary",
            "text": "\"...Did our ancestors fight the calamity like this five hundred years ago? The Kapitan-Poruchik once said we knew not a hundredth of the grueling battles that our ancestors went through...\"",
            "nextDialogs": [
              "710590203"
            ]
          },
          "710590203": {
            "id": "710590203",
            "speakerId": 1002,
            "speakerName": "Shred of Kapral Nikolay's Diary",
            "text": "(Many pages in the middle are tainted by some black substance. When you clean it off, the writing in ink is also rendered entirely illegible.)",
            "nextDialogs": [
              "710590204"
            ]
          },
          "710590204": {
            "id": "710590204",
            "speakerId": 1002,
            "speakerName": "Shred of Kapral Nikolay's Diary",
            "text": "\"...I can't stay here any longer. They could easily track me down through the black mud...\"",
            "nextDialogs": [
              "710590205"
            ]
          },
          "710590205": {
            "id": "710590205",
            "speakerId": 1002,
            "speakerName": "Shred of Kapral Nikolay's Diary",
            "text": "\"...Next, I'm gonna go the opposite direction and lure them further away from the rest of the squad...\"",
            "nextDialogs": [
              "710590206"
            ]
          },
          "710590206": {
            "id": "710590206",
            "speakerId": 1002,
            "speakerName": "Shred of Kapral Nikolay's Diary",
            "text": "\"...There's a hole near the ruined bastion on the southeast side. Maybe I can take that route...\"",
            "nextDialogs": [
              "710590207"
            ]
          },
          "710590207": {
            "id": "710590207",
            "speakerId": 1002,
            "speakerName": "Shred of Kapral Nikolay's Diary",
            "text": "\"...Wish me luck. If not us, then who?\""
          }
        }
      }
    },
    {
      "subId": "7105903",
      "subQuestName": "Find the place mentioned in Nikolay's diary",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710590301"
        ],
        "dialogs": {
          "710590301": {
            "id": "710590301",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "You're back. I have some Fire-Water to spare.",
            "nextDialogs": [
              "710590302"
            ]
          },
          "710590302": {
            "id": "710590302",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Haha, I'm not inviting you to drink. It can also be used to clean your wounds if you're injured.",
            "nextDialogs": [
              "710590303"
            ]
          },
          "710590303": {
            "id": "710590303",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "How is it? Did you find anything?",
            "nextDialogs": [
              "710590304"
            ]
          },
          "710590304": {
            "id": "710590304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We found this."
          }
        }
      }
    },
    {
      "subId": "7105904",
      "subQuestName": "Look for the place the diary mentioned",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710590401"
        ],
        "dialogs": {
          "710590401": {
            "id": "710590401",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "You're back. Did you find anything?",
            "nextDialogs": [
              "710590402"
            ]
          },
          "710590402": {
            "id": "710590402",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "It's alright if you found nothing. Go get some rest.",
            "nextDialogs": [
              "710590403"
            ]
          },
          "710590403": {
            "id": "710590403",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Don't you worry about me... I'm not anxious. After all, I kinda wanna stay here for my retirement. Maybe I'll ask you to deal with my pension application!",
            "nextDialogs": [
              "710590404"
            ]
          },
          "710590404": {
            "id": "710590404",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wow, you sure are getting some good rest!",
            "nextDialogs": [
              "710590405"
            ]
          },
          "710590405": {
            "id": "710590405",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Hmph, if you keep coming back here without bringing me any news... Who knows, you might just find me resting till I rest in peace."
          }
        }
      }
    },
    {
      "subId": "7105908",
      "subQuestName": "Read the information Nikolay left behind",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710591401"
        ],
        "dialogs": {
          "710591401": {
            "id": "710591401",
            "speakerId": 1003,
            "speakerName": "Kapral Nikolay's Diary",
            "text": "\"...I made it into this secret chamber. The mechanical monster is still lurking outside like a ferocious predator, just waiting for me to go out...\"",
            "nextDialogs": [
              "710591402"
            ]
          },
          "710591402": {
            "id": "710591402",
            "speakerId": 1003,
            "speakerName": "Kapral Nikolay's Diary",
            "text": "\"...My left leg is badly wounded and it hurts like hell. I bandaged it up haphazardly, but it's swollen — could be a sign of infection...\"",
            "nextDialogs": [
              "710591403"
            ]
          },
          "710591403": {
            "id": "710591403",
            "speakerId": 1003,
            "speakerName": "Kapral Nikolay's Diary",
            "text": "\"...The grotto has another exit, but I don't know where it leads. The structure of the exit looks tenuous. Without something to support it, it might collapse if exposed to violent force...\"",
            "nextDialogs": [
              "710591404"
            ]
          },
          "710591404": {
            "id": "710591404",
            "speakerId": 1003,
            "speakerName": "Kapral Nikolay's Diary",
            "text": "\"...I've been spotted! Someone's coming. It's a... swordsman... clad in black?\"",
            "nextDialogs": [
              "710591405"
            ]
          },
          "710591405": {
            "id": "710591405",
            "speakerId": 1003,
            "speakerName": "Kapral Nikolay's Diary",
            "text": "\"...He, no, it... Seems as though even metal bars are no obstacle for it. And just from looking upon it, I know this in my heart...\"",
            "nextDialogs": [
              "710591406"
            ]
          },
          "710591406": {
            "id": "710591406",
            "speakerId": 1003,
            "speakerName": "Kapral Nikolay's Diary",
            "text": "\"...I'm sorry, Katya.\""
          }
        }
      }
    },
    {
      "subId": "7105907",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710590603"
        ],
        "dialogs": {
          "710590603": {
            "id": "710590603",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eh... Is this the insignia left behind by the Fatui guy?"
          }
        }
      }
    },
    {
      "subId": "7105905",
      "subQuestName": "Tell Katarina about the clues you found",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7105909",
      "subQuestName": "Talk to Katarina",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710591305"
        ],
        "dialogs": {
          "710591305": {
            "id": "710591305",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "These are... insignias, action logs, and... note?",
            "nextDialogs": [
              "710591306"
            ]
          },
          "710591306": {
            "id": "710591306",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Please tell me where Kolya is. Is he still alive?",
            "nextDialogs": [
              "710591309"
            ]
          },
          "710591309": {
            "id": "710591309",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Kolya would never desert and abandon me. I'm sure of it, I just know it. He wouldn't run away in the face of a battle.",
            "nextDialogs": [
              "710591310"
            ]
          },
          "710591310": {
            "id": "710591310",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Where did you find these?",
            "nextDialogs": [
              "710591311"
            ]
          },
          "710591311": {
            "id": "710591311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A cave in the southeast. Let me mark it out for you.",
            "nextDialogs": [
              "710591312"
            ]
          },
          "710591312": {
            "id": "710591312",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's a creepy place with many monsters inside it.",
            "nextDialogs": [
              "710591313"
            ]
          },
          "710591313": {
            "id": "710591313",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Th—Thank you... I'm sorry...",
            "nextDialogs": [
              "710591314"
            ]
          },
          "710591314": {
            "id": "710591314",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "I... I hope Kolya sold his life dearly. I'd rather that's what happened.",
            "nextDialogs": [
              "710591315"
            ]
          },
          "710591315": {
            "id": "710591315",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Kolya, please don't bring shame to the Tsaritsa. Don't bring shame on me.",
            "nextDialogs": [
              "710591316"
            ]
          },
          "710591316": {
            "id": "710591316",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "710591317"
            ]
          },
          "710591317": {
            "id": "710591317",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Ahem, I—I'm fine... Just got a bit sentimental there. It just occurred to me that I haven't properly thanked you two!",
            "nextDialogs": [
              "710591318"
            ]
          },
          "710591318": {
            "id": "710591318",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Oh right, here's some Fire-Water... *sigh* But you don't drink, do you?",
            "nextDialogs": [
              "710591319"
            ]
          },
          "710591319": {
            "id": "710591319",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "I have some Mora...and some other materials that I collected. They are of no use to me now, so please take them."
          }
        }
      }
    },
    {
      "subId": "7105806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710580601"
        ],
        "dialogs": {
          "710580601": {
            "id": "710580601",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "I need to get some rest now. My old injuries still hurt. My apologies.",
            "nextDialogs": [
              "710580602"
            ]
          },
          "710580602": {
            "id": "710580602",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Please come back another day if you have more questions. I'll also have a favor to ask."
          }
        }
      }
    }
  ]
}
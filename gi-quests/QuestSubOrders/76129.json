  "subQuests": [
    {
      "subId": "7612901",
      "subQuestName": "Talk to Katheryne",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761290101"
        ],
        "dialogs": {
          "761290101": {
            "id": "761290101",
            "speakerId": 7000,
            "speakerName": "Katheryne",
            "text": "Thank you again for all the help you've given the Guild, Boss Nefer, Miss Jahoda.",
            "nextDialogs": [
              "761290102"
            ]
          },
          "761290102": {
            "id": "761290102",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "There's no need for that. Not when this is really a collaboration between us.",
            "nextDialogs": [
              "761290103"
            ]
          },
          "761290103": {
            "id": "761290103",
            "speakerId": 7016,
            "speakerName": "Sarin",
            "text": "That's true, but I still want to thank you, Boss Nefer, for being so willing to help the Guild with the... complicated investigative work.",
            "nextDialogs": [
              "761290104"
            ]
          },
          "761290104": {
            "id": "761290104",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "The Adventurers' Guild has also sent several folks to help us with our work. We're all working together towards the same goal.",
            "nextDialogs": [
              "761290105"
            ]
          },
          "761290105": {
            "id": "761290105",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "I hope our future collaborations will be just as pleasant, Mr. Sarin.",
            "nextDialogs": [
              "761290106"
            ]
          },
          "761290106": {
            "id": "761290106",
            "speakerId": 7016,
            "speakerName": "Sarin",
            "text": "You can rest assured, Boss Nefer, that the Adventurers' Guild...",
            "nextDialogs": [
              "761290107"
            ]
          },
          "761290107": {
            "id": "761290107",
            "speakerId": 7016,
            "speakerName": "Sarin",
            "text": "Oh, I should be clear about this. You can absolutely trust that we at the Nod-Krai Adventurers' Guild are your ever-reliable partners.",
            "nextDialogs": [
              "761290108"
            ]
          },
          "761290108": {
            "id": "761290108",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Heh, that much is clear to me, yes.",
            "nextDialogs": [
              "761290109"
            ]
          },
          "761290109": {
            "id": "761290109",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(Good, good, just keep talking like that, Boss Nef, my dearest Boss Nef, please don't look at me, please don't look at me, please don't look at me...)",
            "nextDialogs": [
              "761290110"
            ]
          },
          "761290110": {
            "id": "761290110",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Jahoda, why are you keeping so quiet?",
            "nextDialogs": [
              "761290111"
            ]
          },
          "761290111": {
            "id": "761290111",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(NO, she looked at me!!! Fine, just don't look at the commission board, please don't look at the commission board, please don't look at the commission boar—)",
            "nextDialogs": [
              "761290112"
            ]
          },
          "761290112": {
            "id": "761290112",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Huh? M-me? Um, I don't have anything to say! Um... Thanks... for the commission...?",
            "nextDialogs": [
              "761290113"
            ]
          },
          "761290113": {
            "id": "761290113",
            "speakerId": 7016,
            "speakerName": "Sarin",
            "text": "Oh, we should also thank you for your assistance, Miss Jahoda. Without you, the paperwork at the Guild would've piled up into a mountain by now.",
            "nextDialogs": [
              "761290114"
            ]
          },
          "761290114": {
            "id": "761290114",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "No need for thank me... I'm getting paid, so I have to do the job right, of course...",
            "nextDialogs": [
              "761290115"
            ]
          },
          "761290115": {
            "id": "761290115",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "(*Sigh* Looks like she has forgotten everything I taught her to say...)",
            "nextDialogs": [
              "761290116"
            ]
          },
          "761290116": {
            "id": "761290116",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "By the way, since we're all here...",
            "nextDialogs": [
              "761290117"
            ]
          },
          "761290117": {
            "id": "761290117",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(No! We had such a good vibe going, Boss! Please just give me a break, Boss!)",
            "nextDialogs": [
              "761290118"
            ]
          },
          "761290118": {
            "id": "761290118",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Mr. Sarin, would you please bring over the latest batch of commissions?",
            "nextDialogs": [
              "761290119"
            ]
          },
          "761290119": {
            "id": "761290119",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Jahoda, pick the commission you believe matters the most.",
            "nextDialogs": [
              "761290120"
            ]
          },
          "761290120": {
            "id": "761290120",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "I want you to think this over carefully, so take your time, okay?",
            "nextDialogs": [
              "761290121"
            ]
          },
          "761290121": {
            "id": "761290121",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Okay... Yes, Boss...",
            "nextDialogs": [
              "761290122"
            ]
          },
          "761290122": {
            "id": "761290122",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(Ugh!!! I'm DOOMED!)"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2003301",
      "subQuestName": "Talk to Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200330101"
        ],
        "dialogs": {
          "200330101": {
            "id": "200330101",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Traveler, come have a look! What do you think? Does this look good on me?",
            "nextDialogs": [
              "200330102"
            ]
          },
          "200330102": {
            "id": "200330102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oh, this uniform...!",
            "nextDialogs": [
              "200330103"
            ]
          },
          "200330103": {
            "id": "200330103",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "That's right! I passed the Adventurers' Guild exam. That makes me an officially-recognized adventurer!",
            "nextDialogs": [
              "200330106"
            ]
          },
          "200330106": {
            "id": "200330106",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Hehe, thanks. I tried to persuade my brother to give the exam a go too, but he refused no matter what I said...",
            "nextDialogs": [
              "200330107"
            ]
          },
          "200330107": {
            "id": "200330107",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "I've got no interest in adventures... And anyway, who'll take care of our parents if we both become adventurers?",
            "nextDialogs": [
              "200330108"
            ]
          },
          "200330108": {
            "id": "200330108",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Well, then we can bring them along! We can travel the whole world together!",
            "nextDialogs": [
              "200330109"
            ]
          },
          "200330109": {
            "id": "200330109",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "You... Alright, alright. You're an adventurer now, so do your best. Leave matters at home to me.",
            "nextDialogs": [
              "200330110"
            ]
          },
          "200330110": {
            "id": "200330110",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "But remember, don't get yourself injured, and don't overtax yourself...",
            "nextDialogs": [
              "200330111"
            ]
          },
          "200330111": {
            "id": "200330111",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Oh, fine, fine, I get it! Heading out now, I've got a commission to finish!",
            "nextDialogs": [
              "200330112"
            ]
          },
          "200330112": {
            "id": "200330112",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Traveler, do you mind coming with me? I've got so many things I want to ask you about being an adventurer!"
          }
        }
      }
    },
    {
      "subId": "2003302",
      "subQuestName": "Go with Anna to complete her Adventurers' Guild commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200330201"
        ],
        "dialogs": {
          "200330201": {
            "id": "200330201",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "And we're done! Thanks, Traveler. This went pretty well, I think.",
            "nextDialogs": [
              "200330202"
            ]
          },
          "200330202": {
            "id": "200330202",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "But is this the usual fare for adventurers?",
            "nextDialogs": [
              "200330204",
              "200330206"
            ]
          },
          "200330204": {
            "id": "200330204",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "What's with that hapless tone...",
            "nextDialogs": [
              "200330207"
            ]
          },
          "200330207": {
            "id": "200330207",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Is that so... Nice! I'll keep working at it, then!",
            "nextDialogs": [
              "200330208"
            ]
          },
          "200330208": {
            "id": "200330208",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Once I've saved up enough Mora, I'll bring my brother and our parents out on a trip!",
            "nextDialogs": [
              "200330209"
            ]
          },
          "200330209": {
            "id": "200330209",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "My brother always wanted to travel... But I fell ill, and he had to stay back to take care of me.",
            "nextDialogs": [
              "200330210"
            ]
          },
          "200330210": {
            "id": "200330210",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "But I'm well now, and I've even become an adventurer.",
            "nextDialogs": [
              "200330211"
            ]
          },
          "200330211": {
            "id": "200330211",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Hehe. When the time comes, I'll help my brother fulfill some of his dreams too!"
          },
          "200330206": {
            "id": "200330206",
            "speakerId": 1000,
            "speakerName": "Anna",
            "text": "Hey, not that tired look..."
          }
        }
      }
    },
    {
      "subId": "2003303",
      "subQuestName": "Go with Anna to complete her Adventurers' Guild commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200330301"
        ],
        "dialogs": {
          "200330301": {
            "id": "200330301",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "Please take care of Anna, Traveler. Her excitement might have gotten to her head lately...",
            "nextDialogs": [
              "200330302"
            ]
          },
          "200330302": {
            "id": "200330302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you not want her to become an adventurer?",
            "nextDialogs": [
              "200330303"
            ]
          },
          "200330303": {
            "id": "200330303",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "...",
            "nextDialogs": [
              "200330304"
            ]
          },
          "200330304": {
            "id": "200330304",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "I respect my sister's wishes.",
            "nextDialogs": [
              "200330305"
            ]
          },
          "200330305": {
            "id": "200330305",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "Now that she's well again after such a long struggle with her illness, she deserves a chance to pursue her dreams.",
            "nextDialogs": [
              "200330306"
            ]
          },
          "200330306": {
            "id": "200330306",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "As her brother, I'll support her... all the way.",
            "nextDialogs": [
              "200330307"
            ]
          },
          "200330307": {
            "id": "200330307",
            "speakerId": 1001,
            "speakerName": "Anthony",
            "text": "That's all I have to say."
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "2006501",
      "subQuestName": "Talk to Ellin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200650101"
        ],
        "dialogs": {
          "200650101": {
            "id": "200650101",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Ugh, what a headache... What am I supposed to do about this?",
            "nextDialogs": [
              "200650102"
            ]
          },
          "200650102": {
            "id": "200650102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you up to?",
            "nextDialogs": [
              "200650103"
            ]
          },
          "200650103": {
            "id": "200650103",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Practicing for the Knights of Favonius' tryouts!",
            "nextDialogs": [
              "200650104"
            ]
          },
          "200650104": {
            "id": "200650104",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "*sigh* But I'm nowhere near as powerful as Jean.",
            "nextDialogs": [
              "200650105"
            ]
          },
          "200650105": {
            "id": "200650105",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "I think it's better for me to focus on technique rather than power.",
            "nextDialogs": [
              "200650106"
            ]
          },
          "200650106": {
            "id": "200650106",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "For example, I was thinking about how to break all these wooden dummies in one fell swoop.",
            "nextDialogs": [
              "200650107"
            ]
          },
          "200650107": {
            "id": "200650107",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "They're a lot more robust than they look, this is no trivial task... I don't know where my father managed to get them from, but he must have gone to a lot of effort."
          }
        }
      }
    },
    {
      "subId": "2006502",
      "subQuestName": "Destroy all the training dummies in under 2 seconds",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200650201"
        ],
        "dialogs": {
          "200650201": {
            "id": "200650201",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "How are you getting along? Had a eureka moment yet?",
            "nextDialogs": [
              "200650202"
            ]
          },
          "200650202": {
            "id": "200650202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Still thinking it over...",
            "nextDialogs": [
              "200650203"
            ]
          },
          "200650203": {
            "id": "200650203",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Huh. I've met a few other Adventurers before. They were the same way.",
            "nextDialogs": [
              "200650204"
            ]
          },
          "200650204": {
            "id": "200650204",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "They fight monsters like pros, but they're hopelessly lost when it comes to trying to break a few wooden sticks.",
            "nextDialogs": [
              "200650205"
            ]
          },
          "200650205": {
            "id": "200650205",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "And they reinforce the wood like it's for building a storm shelter or something... Way overestimating their own strength.",
            "nextDialogs": [
              "200650206"
            ]
          },
          "200650206": {
            "id": "200650206",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "If they want a challenge so desperately, why don't they just go off into the wilderness and pick a fight with the biggest monster they can find?"
          }
        }
      }
    },
    {
      "subId": "2006503",
      "subQuestName": "Talk to Ellin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200650301"
        ],
        "dialogs": {
          "200650301": {
            "id": "200650301",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Nailed it!",
            "nextDialogs": [
              "200650302"
            ]
          },
          "200650302": {
            "id": "200650302",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Huh, I never even thought of trying that...",
            "nextDialogs": [
              "200650303"
            ]
          },
          "200650303": {
            "id": "200650303",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Thanks! I'm gonna try it myself now."
          }
        }
      }
    }
  ]
}
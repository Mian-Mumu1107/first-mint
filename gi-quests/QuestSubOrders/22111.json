  "subQuests": [
    {
      "subId": "2211101",
      "subQuestName": "Talk to Katheryne in Mondstadt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221110101"
        ],
        "dialogs": {
          "221110101": {
            "id": "221110101",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Any new Commissions?",
            "nextDialogs": [
              "221110102"
            ]
          },
          "221110102": {
            "id": "221110102",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Greetings, Adventurer. The tales of your deeds are now known to all in Mondstadt.",
            "nextDialogs": [
              "221110103"
            ]
          },
          "221110103": {
            "id": "221110103",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Continue in this fashion and you are destined to become one of the great Adventurers of our age.",
            "nextDialogs": [
              "221110105",
              "221110108"
            ]
          },
          "221110105": {
            "id": "221110105",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "If you wish to become a great Adventurer, there comes a time when you must move beyond the places you know.",
            "nextDialogs": [
              "221110106"
            ]
          },
          "221110106": {
            "id": "221110106",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Now you have amassed such a wealth of adventuring experience, perhaps it is time for you to explore somewhere new.",
            "nextDialogs": [
              "221110110"
            ]
          },
          "221110110": {
            "id": "221110110",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Take this letter and deliver it to Liyue Katheryne."
          },
          "221110108": {
            "id": "221110108",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "That is because your adventures this far have all been limited to the Mondstadt area.",
            "nextDialogs": [
              "221110109"
            ]
          },
          "221110109": {
            "id": "221110109",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "But all that is about to change. Soon, you will be able to venture into the world beyond."
          }
        }
      }
    },
    {
      "subId": "2211102",
      "subQuestName": "Talk to Katheryne in Liyue Harbor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221110201"
        ],
        "dialogs": {
          "221110201": {
            "id": "221110201",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "I have a letter for you.",
            "nextDialogs": [
              "221110202"
            ]
          },
          "221110202": {
            "id": "221110202",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Ad astra abyssosque! Welcome to the Adventurers' Guild.",
            "nextDialogs": [
              "221110203"
            ]
          },
          "221110203": {
            "id": "221110203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I suspect this is for you...",
            "nextDialogs": [
              "221110204"
            ]
          },
          "221110204": {
            "id": "221110204",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "A letter? For me? Oh... So, you're an Adventurer from Mondstadt?",
            "nextDialogs": [
              "221110205"
            ]
          },
          "221110205": {
            "id": "221110205",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "What's this — a Dandelion? Why is there a Dandelion in the envelope?",
            "nextDialogs": [
              "221110206"
            ]
          },
          "221110206": {
            "id": "221110206",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Adventurer, did you place a Dandelion in this envelope to try and prove you are from Mondstadt?",
            "nextDialogs": [
              "221110207"
            ]
          },
          "221110207": {
            "id": "221110207",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "There's really no need. There is more than enough information contained in this letter to establish your identity and background.",
            "nextDialogs": [
              "221110209",
              "221110211"
            ]
          },
          "221110209": {
            "id": "221110209",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Not that it really matters, of course.",
            "nextDialogs": [
              "221110214"
            ]
          },
          "221110214": {
            "id": "221110214",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "This letter from the Mondstadt Adventurers' Guild says that you are a highly experienced Adventurer.",
            "nextDialogs": [
              "221110215"
            ]
          },
          "221110215": {
            "id": "221110215",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "If that's true, I'm sure you are ready to take on Commissions from the Liyue Adventurers' Guild.",
            "nextDialogs": [
              "221110216"
            ]
          },
          "221110216": {
            "id": "221110216",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "A whole new world of wild adventure awaits you. Ad astra abyssosque!"
          },
          "221110211": {
            "id": "221110211",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Katheryne? ...Oh, you must mean Mondstadt Katheryne.",
            "nextDialogs": [
              "221110212"
            ]
          },
          "221110212": {
            "id": "221110212",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Why did she put a Dandelion in with the letter? Very odd... A Dandelion isn't much use to an Adventurer, now, is it?",
            "nextDialogs": [
              "221110213"
            ]
          },
          "221110213": {
            "id": "221110213",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Not that it really matters, of course."
          }
        }
      }
    }
  ]
}
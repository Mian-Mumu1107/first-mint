      }
    },
    {
      "subId": "4008408",
      "subQuestName": "Spar with Layla",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400840801"
        ],
        "dialogs": {
          "400840801": {
            "id": "400840801",
            "speakerId": 1002,
            "speakerName": "Layla",
            "text": "I'm feeling nervous, but excited at the same time!",
            "nextDialogs": [
              "400840802"
            ]
          },
          "400840802": {
            "id": "400840802",
            "speakerId": 1002,
            "speakerName": "Layla",
            "text": "You don't have to go easy on me. Twirly-Whirly and team have weathered plenty of tough challenges already, and they know how to put up a good fight! So you and your shroom buddies can give it your all!",
            "nextDialogs": [
              "400840803"
            ]
          },
          "400840803": {
            "id": "400840803",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well then, prepare for battle, Layla and Twirly!"
          }
        }
      }
    },
    {
      "subId": "4008409",
      "subQuestName": "Spar with Layla",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008413",
      "subQuestName": "Talk to Layla",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400841301"
        ],
        "dialogs": {
          "400841301": {
            "id": "400841301",
            "speakerId": 1002,
            "speakerName": "Layla",
            "text": "Oh shoot, we lost...",
            "nextDialogs": [
              "400841302"
            ]
          },
          "400841302": {
            "id": "400841302",
            "speakerId": 1002,
            "speakerName": "Layla",
            "text": "But you and the gang put on the best show I've seen so far, Twirly-Whirly! That was a real blast, I loved it!",
            "nextDialogs": [
              "400841303"
            ]
          },
          "400841303": {
            "id": "400841303",
            "speakerId": 1002,
            "speakerName": "Layla",
            "text": "Thank you all! Twirly-Whirly and I went out with a bang. Any other opponent, and we might be feeling a little disappointed right now... but we were definitely beaten by the best.",
            "nextDialogs": [
              "400841304"
            ]
          },
          "400841304": {
            "id": "400841304",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You did really well too, y'know! Felt like we were one wrong move away from a very mushy Bongo!",
            "nextDialogs": [
              "400841305"
            ]
          },
          "400841305": {
            "id": "400841305",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Just letting the Fungi do their thing and enjoying the match with no pressure to win... It was a good feeling.",
            "nextDialogs": [
              "400841306"
            ]
          },
          "400841306": {
            "id": "400841306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Perhaps this is how all competitions should be...",
            "nextDialogs": [
              "400841307"
            ]
          },
          "400841307": {
            "id": "400841307",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "If only every match could be as carefree as that... Meanwhile, Miko's busy duking it out with Haniyyah. Paimon's so nervous for her! Let's go see how she's doing!"
          }
        }
      }
    },
    {
      "subId": "4008412",
      "subQuestName": "Leave the arena",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400841201"
        ],
        "dialogs": {
          "400841201": {
            "id": "400841201",
            "speakerId": 1005,
            "speakerName": "Haniyyah",
            "text": "Huh? How did you find me here...",
            "nextDialogs": [
              "400841202"
            ]
          },
          "400841202": {
            "id": "400841202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We followed Pyro-1's tracks. We're a little worried about you...",
            "nextDialogs": [
              "400841203"
            ]
          },
          "400841203": {
            "id": "400841203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait a second... Are you comforting Pyro-1!?",
            "nextDialogs": [
              "400841204"
            ]
          },
          "400841204": {
            "id": "400841204",
            "speakerId": 1005,
            "speakerName": "Haniyyah",
            "text": "\"The irony,\" I know... and I'd probably be enjoying it, if Pyro-1 were any other animal than a Fungi.",
            "nextDialogs": [
              "400841205"
            ]
          },
          "400841205": {
            "id": "400841205",
            "speakerId": 1005,
            "speakerName": "Haniyyah",
            "text": "The next time we meet will be in the finals. Whatever you have to say, save it for if you beat me...",
            "nextDialogs": [
              "400841208"
            ]
          },
          "400841208": {
            "id": "400841208",
            "speakerId": 1005,
            "speakerName": "Haniyyah",
            "text": "The fox lady said you might say that... You're pure of heart, kind, and believe the best in things.",
            "nextDialogs": [
              "400841209"
            ]
          },
          "400841209": {
            "id": "400841209",
            "speakerId": 1005,
            "speakerName": "Haniyyah",
            "text": "You wouldn't understand if I tried to explain, so here — read this.",
            "nextDialogs": [
              "400841210"
            ]
          },
          "400841210": {
            "id": "400841210",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh, what is it?",
            "nextDialogs": [
              "400841212"
            ]
          },
          "400841212": {
            "id": "400841212",
            "speakerId": 1005,
            "speakerName": "Haniyyah",
            "text": "These are my ancestors' records. They were attacked by a horde of Fungi in the rainforest, and many people were seriously injured.",
            "nextDialogs": [
              "400841213"
            ]
          },
          "400841213": {
            "id": "400841213",
            "speakerId": 1005,
            "speakerName": "Haniyyah",
            "text": "There was nothing exceptional about this incident at the time, and it certainly never made it into any official records. But my family have been reading it to me since I was a child, constantly warning me of the grave threat that Fungi pose to us.",
            "nextDialogs": [
              "400841214"
            ]
          },
          "400841214": {
            "id": "400841214",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So that's what happened... No wonder you're so hostile towards Fungi."
          }
        }
      }
    },
    {
      "subId": "4008410",
      "subQuestName": "Talk to Yae Miko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400841001"
        ],
        "dialogs": {
          "400841001": {
            "id": "400841001",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh...? It's over already? And why's the atmosphere so heavy... Does this mean Miko won!?",
            "nextDialogs": [
              "400841002"
            ]
          },
          "400841002": {
            "id": "400841002",
            "speakerId": 1004,
            "speakerName": "Yae Miko",
            "text": "Your match is over too? You took your time. I'm assuming it was a close call...",
            "nextDialogs": [
              "400841003"
            ]
          },
          "400841003": {
            "id": "400841003",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You sound way too relaxed for someone who's just fought in the semifinals. Bet it was a walk in the park, huh?",
            "nextDialogs": [
              "400841004"
            ]
          },
          "400841004": {
            "id": "400841004",
            "speakerId": 1004,
            "speakerName": "Yae Miko",
            "text": "Ahaha, yes, ours was as far from a close call as you could get. All it took was a few short, sharp strikes for Blitzara and I...",
            "nextDialogs": [
              "400841005"
            ]
          },
          "400841005": {
            "id": "400841005",
            "speakerId": 1004,
            "speakerName": "Yae Miko",
            "text": "...to be beaten by Haniyyah.",
            "nextDialogs": [
              "400841006"
            ]
          },
          "400841006": {
            "id": "400841006",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh?",
            "nextDialogs": [
              "400841007"
            ]
          },
          "400841007": {
            "id": "400841007",
            "speakerId": 1005,
            "speakerName": "Haniyyah",
            "text": "...What, you think this is funny? Am I a joke to you?",
            "nextDialogs": [
              "400841008"
            ]
          },
          "400841008": {
            "id": "400841008",
            "speakerId": 1004,
            "speakerName": "Yae Miko",
            "text": "Hehe, far from it, Haniyyah. I know full well how serious you are about all this from your iron-clad determination to annihilate an entire species... How would I ever dare mock you?",
            "nextDialogs": [
              "400841009"
            ]
          },
          "400841009": {
            "id": "400841009",
            "speakerId": 1004,
            "speakerName": "Yae Miko",
            "text": "That said, if you continue down this path and find that it leads somewhere quite different from what you had hoped... what will become of that iron-clad determination then? I look forward to finding out.",
            "nextDialogs": [
              "400841010"
            ]
          },
          "400841010": {
            "id": "400841010",
            "speakerId": 1005,
            "speakerName": "Haniyyah",
            "text": "That's... not your concern.",
            "nextDialogs": [
              "400841011"
            ]
          },
          "400841011": {
            "id": "400841011",
            "speakerId": 1004,
            "speakerName": "Yae Miko",
            "text": "Running away so soon?",
            "nextDialogs": [
              "400841012"
            ]
          },
          "400841012": {
            "id": "400841012",
            "speakerId": 1002,
            "speakerName": "Layla",
            "text": "Miss Yae lost the match, but why is Haniyyah the one who seemed upset...",
            "nextDialogs": [
              "400841013"
            ]
          },
          "400841013": {
            "id": "400841013",
            "speakerId": 1004,
            "speakerName": "Yae Miko",
            "text": "The situation gets more interesting with each development... Blitzara injured Pyro-1 soon after the match started, and Haniyyah was clearly quite distressed.",
            "nextDialogs": [
              "400841014"
            ]
          },
          "400841014": {
            "id": "400841014",
            "speakerId": 1004,
            "speakerName": "Yae Miko",
            "text": "I simply pointed out that she's still deceiving herself, and her defenses began breaking down. She's more fragile than I'd imagined.",
            "nextDialogs": [
              "400841017"
            ]
          },
          "400841017": {
            "id": "400841017",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You mean, Haniyyah isn't as heartless as she tries to make herself out to be? So she does care about Pyro-1... but she didn't mean to show it in front of you...",
            "nextDialogs": [
              "400841018"
            ]
          },
          "400841018": {
            "id": "400841018",
            "speakerId": 1004,
            "speakerName": "Yae Miko",
            "text": "Right answer. Now's our chance to get through to her. You, my little friends, are the only ones who can get her back onto the right path.",

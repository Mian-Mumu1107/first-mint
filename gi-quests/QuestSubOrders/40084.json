    {
      "subId": "4008404",
      "subQuestName": "Defeat your opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400840401"
        ],
        "dialogs": {
          "400840401": {
            "id": "400840401",
            "speakerId": 1000,
            "speakerName": "Hardy Two-Blades",
            "text": "It's you. The uncultured swine of the Nilotpala Cup.",
            "nextDialogs": [
              "400840402"
            ]
          },
          "400840402": {
            "id": "400840402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, you potty mouth! What's your problem?",
            "nextDialogs": [
              "400840403"
            ]
          },
          "400840403": {
            "id": "400840403",
            "speakerId": 1000,
            "speakerName": "Hardy Two-Blades",
            "text": "The way you dote on your Fungi. It's pathetic. What a joke! You make a mockery of the philosophy of the greatest beast-tamer of all, the mighty Haniyyah.",
            "nextDialogs": [
              "400840404"
            ]
          },
          "400840404": {
            "id": "400840404",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"Greatest beast-tamer of all\"? That's debatable.",
            "nextDialogs": [
              "400840405"
            ]
          },
          "400840405": {
            "id": "400840405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll set her \"philosophy\" straight.",
            "nextDialogs": [
              "400840406"
            ]
          },
          "400840406": {
            "id": "400840406",
            "speakerId": 1000,
            "speakerName": "Hardy Two-Blades",
            "text": "You keep telling yourself that! You were never gonna come close to facing Haniyyah. Time for you to go home!"
          }
        }
      }
    },
    {
      "subId": "4008405",
      "subQuestName": "Defeat your opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008414",
      "subQuestName": "Talk to your opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400841401"
        ],
        "dialogs": {
          "400841401": {
            "id": "400841401",
            "speakerId": 1000,
            "speakerName": "Hardy Two-Blades",
            "text": "Nooo! This can't be happening... I trained my Fungi non-stop... Maybe I should have been harder on them?",
            "nextDialogs": [
              "400841402"
            ]
          },
          "400841402": {
            "id": "400841402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whew. Well, we beat him... but somehow Paimon isn't really in the mood to celebrate."
          }
        }
      }
    },
    {
      "subId": "4008402",
      "subQuestName": "Leave the arena",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008406",
      "subQuestName": "Talk to Layla",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400840601"
        ],
        "dialogs": {
          "400840601": {
            "id": "400840601",
            "speakerId": 1002,
            "speakerName": "Layla",
            "text": "#{NICKNAME}, Paimon. I made it through!",
            "nextDialogs": [
              "400840602"
            ]
          },
          "400840602": {
            "id": "400840602",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's amazing, Layla! You've reached your goal!",
            "nextDialogs": [
              "400840603"
            ]
          },
          "400840603": {
            "id": "400840603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Congratulations!",
            "nextDialogs": [
              "400840604"
            ]
          },
          "400840604": {
            "id": "400840604",
            "speakerId": 1002,
            "speakerName": "Layla",
            "text": "I heard you won against the unstoppable Hardy Two-Blades... But you don't seem too happy about it. How come?",
            "nextDialogs": [
              "400840605"
            ]
          },
          "400840605": {
            "id": "400840605",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's just that... He was really mean. He said some weird things...",
            "nextDialogs": [
              "400840606"
            ]
          },
          "400840606": {
            "id": "400840606",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You tell Layla the details of the match...",
            "nextDialogs": [
              "400840607"
            ]
          },
          "400840607": {
            "id": "400840607",
            "speakerId": 1002,
            "speakerName": "Layla",
            "text": "I see what you mean... Yeah, somehow beast-tamers like him make me feel a little... sad.",
            "nextDialogs": [
              "400840608"
            ]
          },
          "400840608": {
            "id": "400840608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sad?",
            "nextDialogs": [
              "400840609"
            ]
          },
          "400840609": {
            "id": "400840609",
            "speakerId": 1002,
            "speakerName": "Layla",
            "text": "Yeah. He clearly doesn't know anything about Haniyyah. He's just making assumptions about what she's like based on a vague impression, and even trying to copy her. I'm sure Haniyyah would feel uneasy about it too, if she knew.",
            "nextDialogs": [
              "400840610"
            ]
          },
          "400840610": {
            "id": "400840610",
            "speakerId": 1002,
            "speakerName": "Layla",
            "text": "Also, he's so cruel to his shroom buddies, when they could have been friends... It's not just his loss, either. It brings all the other contestants down.",
            "nextDialogs": [
              "400840611"
            ]
          },
          "400840611": {
            "id": "400840611",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Right! You have the right mindset, Layla! If only everyone was like you, this whole tournament would feel a lot less gloomy!",
            "nextDialogs": [
              "400840612"
            ]
          },
          "400840612": {
            "id": "400840612",
            "speakerId": 1002,
            "speakerName": "Layla",
            "text": "But it's only because I'm not aiming as high... I just wanna be able to take Twirly-Whirly back to live with me, that's all.",
            "nextDialogs": [
              "400840613"
            ]
          },
          "400840613": {
            "id": "400840613",
            "speakerId": 1002,
            "speakerName": "Layla",
            "text": "Looks like the next fight is you against me. Let's just try to enjoy ourselves. It doesn't matter who wins, this is just a little contest between friends.",
            "nextDialogs": [
              "400840614"
            ]
          },
          "400840614": {
            "id": "400840614",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You have a deal!",
            "nextDialogs": [
              "400840615"
            ]
          },
          "400840615": {
            "id": "400840615",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Alright! Time to see who's the strongest Fungi, Twirly-Whirly or Bongo-Head! Loser buys dinner for the winner!",
            "nextDialogs": [
              "400840616"
            ]
          },
          "400840616": {
            "id": "400840616",
            "speakerId": 1004,
            "speakerName": "Yae Miko",
            "text": "Whatever deal this is, you seem very happy about it. Did I miss anything big while I was gone?",
            "nextDialogs": [
              "400840617"
            ]
          },
          "400840617": {
            "id": "400840617",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Miko, you're back — finally! You snuck off without saying anything last time, so we didn't get to tell you about the evidence we— Ahem! Uh, evidently we have some things to discuss with you...!",
            "nextDialogs": [
              "400840618"
            ]
          },
          "400840618": {
            "id": "400840618",
            "speakerId": 1004,
            "speakerName": "Yae Miko",
            "text": "Yes, well, it's been quite the ordeal for me, too. I only entered this tournament for a bit of fun, but now I've ended up in the semifinals. I've barely had any time at all to spend with Souka and the others gathering source material for the novel.",
            "nextDialogs": [
              "400840619"
            ]
          },
          "400840619": {
            "id": "400840619",
            "speakerId": 1004,
            "speakerName": "Yae Miko",
            "text": "I'm sure you two will have a wonderful time in your fun-and-friendly match. I, on the other hand, have to take mine a little more seriously. I'm up against that stubborn young lady, after all.",
            "nextDialogs": [
              "400840620"
            ]
          },
          "400840620": {
            "id": "400840620",
            "speakerId": 1002,
            "speakerName": "Layla",
            "text": "Yeah, who knew it'd get to this point... Miss Yae has to face off against Haniyyah...",
            "nextDialogs": [
              "400840621"
            ]
          },
          "400840621": {
            "id": "400840621",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Look on the bright side! Maybe Miko will help us defeat Haniyyah!",
            "nextDialogs": [
              "400840622"
            ]
          },
          "400840622": {
            "id": "400840622",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But that means we won't get to show Haniyyah the error of her ways ourselves... Whatever, Paimon just doesn't want to see Miko lose!"
          }
        }
      }
    },
    {
      "subId": "4008407",
      "subQuestName": "Participate in the semifinals",
      "sceneId": null,
      "locations": [],

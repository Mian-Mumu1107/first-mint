  "subQuests": [
    {
      "subId": "2201901",
      "subQuestName": "Talk to Sango",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220190101"
        ],
        "dialogs": {
          "220190101": {
            "id": "220190101",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "...Alright then, I'll be counting on you two.",
            "nextDialogs": [
              "220190102"
            ]
          },
          "220190102": {
            "id": "220190102",
            "speakerId": 1001,
            "speakerName": "Andou",
            "text": "You can rest assured, Ms. Sango.",
            "nextDialogs": [
              "220190103"
            ]
          },
          "220190103": {
            "id": "220190103",
            "speakerId": 1002,
            "speakerName": "Amano",
            "text": "I can't believe that he's been hiding under our noses for so long. He's got a lot of nerve.",
            "nextDialogs": [
              "220190104"
            ]
          },
          "220190104": {
            "id": "220190104",
            "speakerId": 1002,
            "speakerName": "Amano",
            "text": "What with... who he was pretending to be...",
            "nextDialogs": [
              "220190105"
            ]
          },
          "220190105": {
            "id": "220190105",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "In any case, today shall be the end of his \"career.\" Ryuuji, do you remember what I said?",
            "nextDialogs": [
              "220190106"
            ]
          },
          "220190106": {
            "id": "220190106",
            "speakerId": 1003,
            "speakerName": "Ryuuji",
            "text": "Mm-hmm.",
            "nextDialogs": [
              "220190107"
            ]
          },
          "220190107": {
            "id": "220190107",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "Good... You're here too, Traveler. That's great.",
            "nextDialogs": [
              "220190111",
              "220190110"
            ]
          },
          "220190111": {
            "id": "220190111",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "I've collected enough evidence and I've figured out the culprit's habits.",
            "nextDialogs": [
              "220190112"
            ]
          },
          "220190112": {
            "id": "220190112",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "Traveler, will you go with Ryuuji, Andou, and Amano to bring the culprit to justice?",
            "nextDialogs": [
              "220190113"
            ]
          },
          "220190113": {
            "id": "220190113",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "He must have several accomplices. With you there, the success of the operation will be more certain."
          },
          "220190110": {
            "id": "220190110",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "Yes. If everything goes well, it will be closed today."
          }
        }
      }
    },
    {
      "subId": "2201902",
      "subQuestName": "Go to the criminal's location",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220190201"
        ],
        "dialogs": {
          "220190201": {
            "id": "220190201",
            "speakerId": 1003,
            "speakerName": "Ryuuji",
            "text": "Found him. He's burying the loot...",
            "nextDialogs": [
              "220190203",
              "220190205"
            ]
          },
          "220190203": {
            "id": "220190203",
            "speakerId": 1003,
            "speakerName": "Ryuuji",
            "text": "Wait, Traveler. Now is not the time.",
            "nextDialogs": [
              "220190206"
            ]
          },
          "220190206": {
            "id": "220190206",
            "speakerId": 1003,
            "speakerName": "Ryuuji",
            "text": "Just a little longer... Hmmm... It'll be time soon...",
            "nextDialogs": [
              "220190207"
            ]
          },
          "220190207": {
            "id": "220190207",
            "speakerId": 1001,
            "speakerName": "Andou",
            "text": "Hey, you! What are you doing?",
            "nextDialogs": [
              "220190208"
            ]
          },
          "220190208": {
            "id": "220190208",
            "speakerId": 1002,
            "speakerName": "Amano",
            "text": "Drop what's in your hands and freeze!",
            "nextDialogs": [
              "220190209"
            ]
          },
          "220190209": {
            "id": "220190209",
            "speakerId": 1004,
            "speakerName": "Ishikawa Hachirou",
            "text": "H—How did you...",
            "nextDialogs": [
              "220190210"
            ]
          },
          "220190210": {
            "id": "220190210",
            "speakerId": 1004,
            "speakerName": "Ishikawa Hachirou",
            "text": "Agh... C'mon, don't just stand there! Take them out! Get rid of these two, and we'll be home free!",
            "nextDialogs": [
              "220190211"
            ]
          },
          "220190211": {
            "id": "220190211",
            "speakerId": 1002,
            "speakerName": "Amano",
            "text": "Hah! A measly few Treasure Hoarders, and you're getting cocky already?",
            "nextDialogs": [
              "220190212"
            ]
          },
          "220190212": {
            "id": "220190212",
            "speakerId": 1003,
            "speakerName": "Ryuuji",
            "text": "Andou, Amano, let us take care of them!",
            "nextDialogs": [
              "220190213"
            ]
          },
          "220190213": {
            "id": "220190213",
            "speakerId": 1001,
            "speakerName": "Andou",
            "text": "Okay! They're all yours!",
            "nextDialogs": [
              "220190214"
            ]
          },
          "220190214": {
            "id": "220190214",
            "speakerId": 1003,
            "speakerName": "Ryuuji",
            "text": "Traveler, now's the time.",
            "nextDialogs": [
              "220190215"
            ]
          },
          "220190215": {
            "id": "220190215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Bah. So complicated...",
            "nextDialogs": [
              "220190216"
            ]
          },
          "220190216": {
            "id": "220190216",
            "speakerId": 1003,
            "speakerName": "Ryuuji",
            "text": "It's Sango's plan.",
            "nextDialogs": [
              "220190217"
            ]
          },
          "220190217": {
            "id": "220190217",
            "speakerId": 1003,
            "speakerName": "Ryuuji",
            "text": "Well then. Let's do this."
          },
          "220190205": {
            "id": "220190205",
            "speakerId": 1003,
            "speakerName": "Ryuuji",
            "text": "In a moment. It's not the time yet."
          }
        }
      }
    },
    {
      "subId": "2201903",
      "subQuestName": "Talk to Ryuuji",
      "sceneId": null,
      "locations": [],

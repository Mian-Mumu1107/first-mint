  "subQuests": [
    {
      "subId": "1502408",
      "subQuestName": "Go to the Masters of the Night-Wind's tribal settlement",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150240801"
        ],
        "dialogs": {
          "150240801": {
            "id": "150240801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, we really did get teleported...",
            "nextDialogs": [
              "150240802"
            ]
          },
          "150240802": {
            "id": "150240802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But where's the way out?",
            "nextDialogs": [
              "150240803"
            ]
          },
          "150240803": {
            "id": "150240803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... It seems like this place is completely sealed off. Doesn't look like there's an exit anywhere.",
            "nextDialogs": [
              "150240804"
            ]
          },
          "150240804": {
            "id": "150240804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's take a look around and see what we can find."
          }
        }
      }
    },
    {
      "subId": "1502401",
      "subQuestName": "Go to the settlement of the Masters of the Night-Wind",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150240101"
        ],
        "dialogs": {
          "150240101": {
            "id": "150240101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*gasp* Something's hiding behind that statue!",
            "nextDialogs": [
              "150240102"
            ]
          },
          "150240102": {
            "id": "150240102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aw, it's a baby Iktomisaurus. So cute... although, why is it staring at us?",
            "nextDialogs": [
              "150240103"
            ]
          },
          "150240103": {
            "id": "150240103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}!",
            "nextDialogs": [
              "150240104"
            ]
          },
          "150240104": {
            "id": "150240104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(What is this place...?)",
            "nextDialogs": [
              "150240105"
            ]
          },
          "150240105": {
            "id": "150240105",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "...",
            "nextDialogs": [
              "150240106"
            ]
          },
          "150240106": {
            "id": "150240106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Who are you...)",
            "nextDialogs": [
              "150240107"
            ]
          },
          "150240107": {
            "id": "150240107",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "!",
            "nextDialogs": [
              "150240108"
            ]
          },
          "150240108": {
            "id": "150240108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh... How long was Paimon out?",
            "nextDialogs": [
              "150240109"
            ]
          },
          "150240109": {
            "id": "150240109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon locked eyes with that baby Iktomisaurus for like, a second, and then she was suddenly pulled into this strange place with a huuuge Iktomisaur!",
            "nextDialogs": [
              "150240110"
            ]
          },
          "150240110": {
            "id": "150240110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yeah, same here...",
            "nextDialogs": [
              "150240111"
            ]
          },
          "150240111": {
            "id": "150240111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Any idea what happened?",
            "nextDialogs": [
              "150240112"
            ]
          },
          "150240112": {
            "id": "150240112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#...{NICKNAME}? Hey, what's wrong?",
            "nextDialogs": [
              "150240115"
            ]
          },
          "150240115": {
            "id": "150240115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look! It's that baby Iktomisaur — seems like it wants us to follow it. Paimon's adventurous side says we have to see where this leads!",
            "nextDialogs": [
              "150240116"
            ]
          },
          "150240116": {
            "id": "150240116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm in! Let's go!"
          }
        }
      }
    },
    {
      "subId": "1502402",
      "subQuestName": "Go to the settlement of the Masters of the Night-Wind",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150240201"
        ],
        "dialogs": {
          "150240201": {
            "id": "150240201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wonder if we're allowed in here... Oh. The door opened all by itself. Taking that as a yes!",
            "nextDialogs": [
              "150240202"
            ]
          },
          "150240202": {
            "id": "150240202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aw! The Iktomisaur from earlier, it's really here!",
            "nextDialogs": [
              "150240203"
            ]
          },
          "150240203": {
            "id": "150240203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's the one who summoned us...",
            "nextDialogs": [
              "150240204"
            ]
          },
          "150240204": {
            "id": "150240204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Then let's go introduce ourselves."
          }
        }
      }
    },
    {
      "subId": "1502403",
      "subQuestName": "Enter the hall",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150240301"
        ],
        "dialogs": {
          "150240301": {
            "id": "150240301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hello there, um...",
            "nextDialogs": [
              "150240302"
            ]
          },
          "150240302": {
            "id": "150240302",
            "speakerId": 1002,
            "speakerName": "Strange Iktomisaurus",
            "text": "...",
            "nextDialogs": [
              "150240303"
            ]
          },
          "150240303": {
            "id": "150240303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay, probably doesn't understand what we're saying... Doesn't look like any cogs are turning in there...",
            "nextDialogs": [
              "150240304"
            ]
          },
          "150240304": {
            "id": "150240304",
            "speakerId": 1002,
            "speakerName": "Strange Iktomisaurus",
            "text": "!",
            "nextDialogs": [
              "150240305"
            ]
          },
          "150240305": {
            "id": "150240305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoops, sorry! No offense intended!",
            "nextDialogs": [
              "150240306"
            ]
          },
          "150240306": {
            "id": "150240306",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "You there — you dare disrespect our elder!?",
            "nextDialogs": [
              "150240307"
            ]
          },
          "150240307": {
            "id": "150240307",
            "speakerId": 1003,
            "speakerName": "Iktomisaurus Elder",
            "text": "...",
            "nextDialogs": [
              "150240308"
            ]
          },
          "150240308": {
            "id": "150240308",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Oh, you mean... I see, I see. Sorry, my mistake. Apparently, you are here by invitation, in which case it's my job to make you feel welcome.",
            "nextDialogs": [
              "150240309"
            ]
          },
          "150240309": {
            "id": "150240309",
            "speakerId": 15018,
            "speakerName": "Caholom",
            "text": "Some introductions are in order. I am Caholom, one of the priests of our tribe.",
            "nextDialogs": [
              "150240310"
            ]
          },
          "150240310": {
            "id": "150240310",
            "speakerId": 15018,
            "speakerName": "Caholom",
            "text": "And this is our Iktomisaur Elder, the Great Tlapopoctiztetl. A living totem among the Masters of the Night-Wind.",
            "nextDialogs": [
              "150240311"
            ]
          },
          "150240311": {
            "id": "150240311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, that's quite a tongue-twister...",
            "nextDialogs": [
              "150240312"
            ]
          },
          "150240312": {
            "id": "150240312",
            "speakerId": 15018,
            "speakerName": "Caholom",
            "text": "In truth, we usually go with \"Elder Tlapo\" for short. You're welcome to do the same.",
            "nextDialogs": [
              "150240313"
            ]
          },
          "150240313": {
            "id": "150240313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We were invited here in a very... unusual way.",
            "nextDialogs": [
              "150240314"
            ]
          },
          "150240314": {
            "id": "150240314",
            "speakerId": 15018,
            "speakerName": "Caholom",
            "text": "Ah, I assume you're referring to our elder's special ability.",
            "nextDialogs": [
              "150240315"
            ]
          },
          "150240315": {
            "id": "150240315",
            "speakerId": 15018,
            "speakerName": "Caholom",
            "text": "Elder Tlapo has been alive for many centuries, and harbors secrets that even we priests are at a loss to explain, so your reaction is entirely natural.",
            "nextDialogs": [
              "150240316"
            ]
          },
          "150240316": {
            "id": "150240316",
            "speakerId": 15018,
            "speakerName": "Caholom",
            "text": "But one thing I can say for sure is that Elder Tlapo has appointed the two of you to an extremely important task. For this reason, I would like to ask you to undergo a test.",
            "nextDialogs": [
              "150240317"
            ]
          },
          "150240317": {
            "id": "150240317",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What sort of task? And what kind of test?",
            "nextDialogs": [
              "150240318"
            ]
          },
          "150240318": {
            "id": "150240318",
            "speakerId": 15018,
            "speakerName": "Caholom",
            "text": "If it's alright with you, I'll take you to see our chief. He's in a much better position to answer your questions.",
            "nextDialogs": [
              "150240319"
            ]
          },
          "150240319": {
            "id": "150240319",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um... okay, sure.",
            "nextDialogs": [
              "150240320"
            ]
          },
          "150240320": {
            "id": "150240320",
            "speakerId": 15018,
            "speakerName": "Caholom",
            "text": "Very well. Then please follow me.",
            "nextDialogs": [
              "150240401"
            ]
          },
          "150240401": {
            "id": "150240401",
            "speakerId": 15018,
            "speakerName": "Caholom",
            "text": "You can use this scroll to go directly to the Obsidian Altar, where the chief is.",
            "nextDialogs": [
              "150240402"
            ]
          },
          "150240402": {
            "id": "150240402",
            "speakerId": 15018,
            "speakerName": "Caholom",
            "text": "Don't worry, it's just one of the many mystical abilities of our tribe."
          }
        }
      }
    },
    {
      "subId": "1502404",
      "subQuestName": "Go to the Obsidian Altar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1502405",
      "subQuestName": "Meet with the Chief of the Masters of the Night-Wind",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150240501"
        ],
        "dialogs": {
          "150240501": {
            "id": "150240501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, what was that just now?",
            "nextDialogs": [
              "150240502"
            ]
          },
          "150240502": {
            "id": "150240502",
            "speakerId": 6251,
            "speakerName": "Caholom",
            "text": "One of the routine duties of a priest. We attempt to contact the spirits of our ancestors to seek epiphanies and revelations.",
            "nextDialogs": [
              "150240503"
            ]
          },
          "150240503": {
            "id": "150240503",
            "speakerId": 6251,
            "speakerName": "Caholom",
            "text": "The chief is just over there. Please wait here while I have a word with him — I'll just be a moment.",
            "nextDialogs": [
              "150240504"
            ]
          },
          "150240504": {
            "id": "150240504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, the Masters of the Night-Wind are definitely living up to their reputation as the mysterious ones.",
            "nextDialogs": [
              "150240505"
            ]
          },
          "150240505": {
            "id": "150240505",
            "speakerId": 6251,
            "speakerName": "Caholom",
            "text": "Alright, I've told the chief why we're here, and now you may speak with him. Right this way.",
            "nextDialogs": [
              "150240506"
            ]
          },
          "150240506": {
            "id": "150240506",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "So, you two are the appointed ones? I am Chief Biram. Welcome, and thank you for your patience.",
            "nextDialogs": [
              "150240507"
            ]
          },
          "150240507": {
            "id": "150240507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...So tall...",
            "nextDialogs": [
              "150240508"
            ]
          },
          "150240508": {
            "id": "150240508",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Unusually so. Yes, I am aware. But I assure you, it's no cause for alarm.",
            "nextDialogs": [
              "150240509"
            ]
          },
          "150240509": {
            "id": "150240509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh — no, of course not! Sorry, Paimon just reacted without thinking...",
            "nextDialogs": [
              "150240510"
            ]
          },
          "150240510": {
            "id": "150240510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's this about us being \"appointed\"?",
            "nextDialogs": [
              "150240511"
            ]
          },
          "150240511": {
            "id": "150240511",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Ah yes, Caholom told me about that. As outsiders to our tribe, this is probably the first you've heard of such appointments. I'm sure the whole thing seems very confusing.",
            "nextDialogs": [
              "150240512"
            ]
          },
          "150240512": {
            "id": "150240512",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Throughout our history, only members of the Masters of the Night-Wind have been appointed to undertake these tasks. This is the first time an outsider has ever been chosen.",
            "nextDialogs": [
              "150240513"
            ]
          },
          "150240513": {
            "id": "150240513",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really?",
            "nextDialogs": [
              "150240514"
            ]
          },
          "150240514": {
            "id": "150240514",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Allow me to explain. Our tribe has an old tradition of recording history in the form of woven scrolls.",
            "nextDialogs": [
              "150240515"
            ]
          },
          "150240515": {
            "id": "150240515",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "And not just our own history. We record the legends and heroic feats of all other tribes as well.",
            "nextDialogs": [
              "150240516"
            ]
          },
          "150240516": {
            "id": "150240516",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "It is a tradition we have observed for many centuries. We treat it as a solemn duty.",
            "nextDialogs": [
              "150240517"
            ]
          },
          "150240517": {
            "id": "150240517",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "However, when a major event occurs that affects all of Natlan, we record it on a different kind of scroll used for this exact purpose.",
            "nextDialogs": [
              "150240518"
            ]
          },
          "150240518": {
            "id": "150240518",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "And these scrolls can only be woven by someone of the Iktomisaur Elder's choosing.",
            "nextDialogs": [
              "150240519"
            ]
          },
          "150240519": {
            "id": "150240519",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "When the Iktomisaur Elder senses a major change in the Ley Lines, it will issue a formal declaration to appoint a creator for this scroll.",
            "nextDialogs": [
              "150240520"
            ]
          },
          "150240520": {
            "id": "150240520",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, so you mean...",
            "nextDialogs": [
              "150240521"
            ]
          },
          "150240521": {
            "id": "150240521",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Elder Tlapo sensed a Ley Line change quite some time ago, but had not yet designated the scroll-weavers... until you arrived.",
            "nextDialogs": [
              "150240522"
            ]
          },
          "150240522": {
            "id": "150240522",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay, but... Just so you're aware, we don't know the first thing about weaving scrolls.",
            "nextDialogs": [
              "150240523"
            ]
          },
          "150240523": {
            "id": "150240523",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "As a matter of fact, that does not surprise me at all.",
            "nextDialogs": [
              "150240524"
            ]
          },
          "150240524": {
            "id": "150240524",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How come?",
            "nextDialogs": [
              "150240525"
            ]
          },
          "150240525": {
            "id": "150240525",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "In the two hundred years that Elder Tlapo has held this position, none of the appointed ones have ever been experienced scroll-weavers.",
            "nextDialogs": [
              "150240526"
            ]
          },
          "150240526": {
            "id": "150240526",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Does that mean two hundred years of major historical events have gone unrecorded?",
            "nextDialogs": [
              "150240527"
            ]
          },
          "150240527": {
            "id": "150240527",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "No, they all submitted scrolls in time. Yet each of them claimed it was not their own work, but a \"gift from the spirits.\"",
            "nextDialogs": [
              "150240528"
            ]
          },
          "150240528": {
            "id": "150240528",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Man... this tribe gets more mysterious by the second.",
            "nextDialogs": [
              "150240529"
            ]
          },
          "150240529": {
            "id": "150240529",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Yes, well... that is the part that troubles me.",
            "nextDialogs": [
              "150240530"
            ]
          },
          "150240530": {
            "id": "150240530",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "The notion that we have to rely on esoteric things like \"gifts from the spirits\" to record historical events of such great importance... it is unsettling.",
            "nextDialogs": [
              "150240531"
            ]
          },
          "150240531": {
            "id": "150240531",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh... That's pretty surprising to hear, coming from the chief of this tribe.",
            "nextDialogs": [
              "150240532"
            ]
          },
          "150240532": {
            "id": "150240532",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "I can imagine. You probably see the Masters of the Night-Wind as a people shrouded in mystery, who pride ourselves on our arcane practices.",
            "nextDialogs": [
              "150240533"
            ]
          },
          "150240533": {
            "id": "150240533",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "But I am something of an exception. I may be the chief, but when it comes to our traditions, I am in fact a proponent of change and reform.",
            "nextDialogs": [
              "150240534"
            ]
          },
          "150240534": {
            "id": "150240534",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "I have dedicated my energies to deciphering the many mysteries of our tribe. In doing so, I hope to establish clearer rules that will help sustain our traditions in the future.",
            "nextDialogs": [
              "150240535"
            ]
          },
          "150240535": {
            "id": "150240535",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, that sounds great! So have you figured out the mystery of the \"gift from the spirits\"?",
            "nextDialogs": [
              "150240536"
            ]
          },
          "150240536": {
            "id": "150240536",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Sadly not... It is something I have been investigating for a long time, but I have yet to uncover what this \"gift\" truly refers to.",
            "nextDialogs": [
              "150240537"
            ]
          },
          "150240537": {
            "id": "150240537",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Only a small handful of events over the years have been recorded on these special scrolls, with decades between each one.",
            "nextDialogs": [
              "150240538"
            ]
          },
          "150240538": {
            "id": "150240538",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "And by the time the next scroll-weaver is appointed, my time as chief will be long gone. I will not be in a position to investigate as thoroughly.",
            "nextDialogs": [
              "150240539"
            ]
          },
          "150240539": {
            "id": "150240539",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So...",
            "nextDialogs": [
              "150240540"
            ]
          },
          "150240540": {
            "id": "150240540",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "While I haven't yet gotten to the bottom of the matter, I have made some progress. But the only way I can develop my theories further is with the cooperation of the appointed ones.",
            "nextDialogs": [
              "150240541"
            ]
          },
          "150240541": {
            "id": "150240541",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And that's why you want to put us through this test.",
            "nextDialogs": [
              "150240542"
            ]
          },
          "150240542": {
            "id": "150240542",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Precisely. It's nothing to be worried about — simply a means of validating my current hypothesis. It shouldn't take you long, nor will it put you in any danger.",
            "nextDialogs": [
              "150240543"
            ]
          },
          "150240543": {
            "id": "150240543",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright. So what does it involve, exactly?",
            "nextDialogs": [
              "150240544"
            ]
          },
          "150240544": {
            "id": "150240544",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "I can explain everything in detail when we get to the site of the test. But first, please wait a moment while I change out of the Soul-Shielding Cloak.",
            "nextDialogs": [
              "150240545"
            ]
          },
          "150240545": {
            "id": "150240545",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "This garb is one of our important cultural relics, handed down by generations of chiefs. It is only to be worn when conducting certain ceremonies.",
            "nextDialogs": [
              "150240546"
            ]
          },
          "150240546": {
            "id": "150240546",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh...",
            "nextDialogs": [
              "150240547"
            ]
          },
          "150240547": {
            "id": "150240547",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "Biram removes his cloak and carefully hands it to a priest for safekeeping.",
            "nextDialogs": [
              "150240548"
            ]
          },
          "150240548": {
            "id": "150240548",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Please follow me.",
            "nextDialogs": [
              "150240549"
            ]
          },
          "150240549": {
            "id": "150240549",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Do you see this scroll? If you touch it, you will enter a hidden space.",
            "nextDialogs": [
              "150240550"
            ]
          },
          "150240550": {
            "id": "150240550",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Today's test is, quite simply, to find a way to escape that space.",
            "nextDialogs": [
              "150240551"
            ]
          },
          "150240551": {
            "id": "150240551",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's it?",
            "nextDialogs": [
              "150240552"
            ]
          },
          "150240552": {
            "id": "150240552",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "I assure you, it's not as easy as it sounds. If you cannot find your own way out, I will of course intervene to bring you back here.",
            "nextDialogs": [
              "150240553"
            ]
          },
          "150240553": {
            "id": "150240553",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "But then, we will be no closer to solving this mystery...",
            "nextDialogs": [
              "150240554"
            ]
          },
          "150240554": {
            "id": "150240554",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll give it a try.",
            "nextDialogs": [
              "150240555"
            ]
          },
          "150240555": {
            "id": "150240555",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Good. Simply touch the scroll to begin the test."
          }
        }
      }
    },
    {
      "subId": "1502409",
      "subQuestName": "Accept the test",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150240901"
        ],
        "dialogs": {
          "150240901": {
            "id": "150240901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There are so many woven scrolls here. Paimon remembers seeing some of them before in other tribes. They seem to record historical events.",
            "nextDialogs": [
              "150240902"
            ]
          },
          "150240902": {
            "id": "150240902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This one really stands out from the rest. For starters, it's the biggest of them all. Wonder what story it tells?",
            "nextDialogs": [
              "150240903"
            ]
          },
          "150240903": {
            "id": "150240903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The colors are very distinctive, too...",
            "nextDialogs": [
              "150240904"
            ]
          },
          "150240904": {
            "id": "150240904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, you're right...",
            "nextDialogs": [
              "150240905"
            ]
          },
          "150240905": {
            "id": "150240905",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Over there, something just flashed! {NICKNAME}, did you catch that?",
            "nextDialogs": [
              "150240906"
            ]
          },
          "150240906": {
            "id": "150240906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe that's how we get out...",
            "nextDialogs": [
              "150240907"
            ]
          },
          "150240907": {
            "id": "150240907",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...By seeing things we couldn't see before.",
            "nextDialogs": [
              "150240908"
            ]
          },
          "150240908": {
            "id": "150240908",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ohhh, right! Paimon's with you!"
          }
        }
      }
    },
    {

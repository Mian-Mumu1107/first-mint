    {
      "subId": "7418403",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741840397"
        ],
        "dialogs": {
          "741840397": {
            "id": "741840397",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "The thieves, who were beaten so badly they couldn't spare even a thought for the \"treasures,\" fled on their boat.",
            "nextDialogs": [
              "741840398"
            ]
          },
          "741840398": {
            "id": "741840398",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "And as it so happens, there were no traps in the container, of the evil dark lord-y variety or otherwise.",
            "nextDialogs": [
              "741840399"
            ]
          },
          "741840399": {
            "id": "741840399",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "But there was no valuable treasure within either. Within was naught but heavy shards of shattered stone."
          }
        }
      }
    },
    {
      "subId": "7418434",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741843401"
        ],
        "dialogs": {
          "741843401": {
            "id": "741843401",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Well, this should be Petrichor!",
            "nextDialogs": [
              "741843402"
            ]
          },
          "741843402": {
            "id": "741843402",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "It's even more beautiful than we'd heard.",
            "nextDialogs": [
              "741843403"
            ]
          },
          "741843403": {
            "id": "741843403",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wow, and the sea breeze is super comfy, too!",
            "nextDialogs": [
              "741843404"
            ]
          },
          "741843404": {
            "id": "741843404",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Still, is it just Paimon, or is this place kinda deserted...?",
            "nextDialogs": [
              "741843405"
            ]
          },
          "741843405": {
            "id": "741843405",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Eek!",
            "nextDialogs": [
              "741843406"
            ]
          },
          "741843406": {
            "id": "741843406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did something happen?",
            "nextDialogs": [
              "741843407"
            ]
          },
          "741843407": {
            "id": "741843407",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Uh, um, nothing! Let's just, uh, go somewhere else first, shall we?"
          }
        }
      }
    },
    {
      "subId": "7418499",

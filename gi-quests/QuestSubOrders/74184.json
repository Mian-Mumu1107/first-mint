    {
      "subId": "7418413",
      "subQuestName": "Talk to the talking cat",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741841301"
        ],
        "dialogs": {
          "741841301": {
            "id": "741841301",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Not bad, not bad. Your valor would not know shame, even should it stand in the company of the Marechaussee Hunters of old.",
            "nextDialogs": [
              "741841304"
            ]
          },
          "741841304": {
            "id": "741841304",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "...We've seen a whole lot of really strange things on our journey. Even so, a glowing, talking cat... Paimon supposes it still makes the \"rare\" list...",
            "nextDialogs": [
              "741841305"
            ]
          },
          "741841305": {
            "id": "741841305",
            "speakerId": 1008,
            "speakerName": "Glowing Cat",
            "text": "#...One such as I shall not dwell on being called a \"strange thing.\" O chosen champions, {NICKNAME} and Paimon, the time has come for true heroes such as ye to step forth!",
            "nextDialogs": [
              "741841306"
            ]
          },
          "741841306": {
            "id": "741841306",
            "speakerId": 1008,
            "speakerName": "Glowing Cat",
            "text": "Come with me unto the ancient kingdom of the deep seas. We must still the chaotic \"Symphony\" if we are to save the lost souls."
          }
        }
      }
    },
    {
      "subId": "7418414",
      "subQuestName": "Follow Osse into the deep spring",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

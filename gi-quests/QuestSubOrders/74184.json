  "subQuests": [
    {
      "subId": "7418401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741840101"
        ],
        "dialogs": {
          "741840101": {
            "id": "741840101",
            "speakerId": 1000,
            "speakerName": "Leader",
            "text": "Hey, you! Yes, you! You blithering idiot! What are you doing dragging your feet for? Waiting for us all to get old!? Why in the blazes aren't all these boxes already on the ship!?",
            "nextDialogs": [
              "741840102"
            ]
          },
          "741840102": {
            "id": "741840102",
            "speakerId": 1001,
            "speakerName": "The Dude They Call \"Idiot\"",
            "text": "No, Boss! It's just... These boxes are way too heavy! If we lug 'em all up, I think the ship might...",
            "nextDialogs": [
              "741840103"
            ]
          },
          "741840103": {
            "id": "741840103",
            "speakerId": 1000,
            "speakerName": "Leader",
            "text": "Might what? This is treasure here, treasure! You gonna just leave profit on the ground like that?",
            "nextDialogs": [
              "741840104"
            ]
          },
          "741840104": {
            "id": "741840104",
            "speakerId": 1001,
            "speakerName": "The Dude They Call \"Idiot\"",
            "text": "But... If we load everything on board, plus ourselves... I don't think the boat can hold all that weight!",
            "nextDialogs": [
              "741840105"
            ]
          },
          "741840105": {
            "id": "741840105",
            "speakerId": 1000,
            "speakerName": "Leader",
            "text": "Ha, that's an easy one! If we just leave a couple of you here on this island, we can bring all the treasure back, now can't we?",
            "nextDialogs": [
              "741840106"
            ]
          },
          "741840106": {
            "id": "741840106",
            "speakerId": 1001,
            "speakerName": "The Dude They Call \"Idiot\"",
            "text": "Ooh, a cunning plan, Boss! ... Wait, uh, I'm one of the ones you're taking with you, right? I don't wanna get captured by those golems, you've seen what happens to anyone they catch!",
            "nextDialogs": [
              "741840107"
            ]
          },
          "741840107": {
            "id": "741840107",
            "speakerId": 1000,
            "speakerName": "Leader",
            "text": "Then stop yapping and start moving! If the Dark Lord's lackeys catch up, we're all done for!",
            "nextDialogs": [
              "741840108"
            ]
          },
          "741840108": {
            "id": "741840108",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "...Dark Lord's lackeys? Are they putting on some kind of show?",
            "nextDialogs": [
              "741840109"
            ]
          },
          "741840109": {
            "id": "741840109",
            "speakerId": 1001,
            "speakerName": "The Dude They Call \"Idiot\"",
            "text": "Wait, Boss! There's people over there!",
            "nextDialogs": [
              "741840110"
            ]
          },
          "741840110": {
            "id": "741840110",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, why don't we go ask them...",
            "nextDialogs": [
              "741840111"
            ]
          },
          "741840111": {
            "id": "741840111",
            "speakerId": 1000,
            "speakerName": "Leader",
            "text": "Oi, you! Yeah, you, the big 'un and the tiny thing! What're you skulking over there for?",
            "nextDialogs": [
              "741840113",
              "741840115"
            ]
          },
          "741840113": {
            "id": "741840113",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hey! We're not doing anything wrong over here, so what are you acting all nervous for?",
            "nextDialogs": [
              "741840116"
            ]
          },
          "741840116": {
            "id": "741840116",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Anyway, we should talk to them first.",
            "nextDialogs": [
              "741840117"
            ]
          },
          "741840117": {
            "id": "741840117",
            "speakerId": 1000,
            "speakerName": "Leader",
            "text": "Hmm, from the look of you, you must be foreigners. And here I thought you were minions of the Dark Lord Remus!",
            "nextDialogs": [
              "741840118"
            ]
          },
          "741840118": {
            "id": "741840118",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#This is {NICKNAME}, and Paimon's Paimon! And you're right, we're travelers! Oh, but who's this \"Dark Lord Remus\" you mentioned? Has he finished playing his part already?",
            "nextDialogs": [
              "741840119"
            ]
          },
          "741840119": {
            "id": "741840119",
            "speakerId": 1000,
            "speakerName": "Leader",
            "text": "Haha, you don't even know who the Dark Lord is!? ... Alright, I get it. I suppose it is up to me to educate you, O ignorant outlanders!",
            "nextDialogs": [
              "741840120"
            ]
          },
          "741840120": {
            "id": "741840120",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ooooh!",
            "nextDialogs": [
              "741840121"
            ]
          },
          "741840121": {
            "id": "741840121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Nice worldbuilding. Very detailed.",
            "nextDialogs": [
              "741840122"
            ]
          },
          "741840122": {
            "id": "741840122",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "And then? And then? What happened next? How did you defeat the Dark Lord?",
            "nextDialogs": [
              "741840123"
            ]
          },
          "741840123": {
            "id": "741840123",
            "speakerId": 1000,
            "speakerName": "Leader",
            "text": "The Dark Lord's golems are each mighty beyond measure. How could we be their match? Still, we had the aid of \"Este the Quick-Witted\" this time!",
            "nextDialogs": [
              "741840124"
            ]
          },
          "741840124": {
            "id": "741840124",
            "speakerId": 1000,
            "speakerName": "Leader",
            "text": "With his aid, we infiltrated the Dark Lord's fell keep, and reclaimed the treasures he and his minions plundered from us Fontainians!",
            "nextDialogs": [
              "741840125"
            ]
          },
          "741840125": {
            "id": "741840125",
            "speakerId": 1001,
            "speakerName": "The Dude They Call \"Idiot\"",
            "text": "Like the Boss said, uh... what is it we're doing again...? Oh yeah! \"Disrupting the special military maneuvers being conducted by the Dark Lord's legions!\" Totally a brilliant plan!"
          },
          "741840115": {
            "id": "741840115",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Huh? {NICKNAME}, what're you saying...?"
          }
        }
      }
    },
    {
      "subId": "7418402",
      "subQuestName": "Defeat the \"bandits\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7418403",
      "subQuestName": "Examine the chest carrying the \"treasure\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741840301"
        ],
        "dialogs": {
          "741840301": {
            "id": "741840301",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "...There they go, huh? Guess they weren't acting after all.",
            "nextDialogs": [
              "741840302"
            ]
          },
          "741840302": {
            "id": "741840302",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But what was this \"treasure\" they were talking about? Dark Lord this, Dark Lord's keep that, no way any of that's real...",
            "nextDialogs": [
              "741840303"
            ]
          },
          "741840303": {
            "id": "741840303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why don't we have a look at the \"treasure\"?",
            "nextDialogs": [
              "741840304"
            ]
          },
          "741840304": {
            "id": "741840304",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Eh!? But we don't know where this stuff came from...",
            "nextDialogs": [
              "741840306",
              "741840308"
            ]
          },
          "741840306": {
            "id": "741840306",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon's just worried that... What if, well, just in case there's some kind of evil dark lord-y trap in it...",
            "nextDialogs": [
              "741840309"
            ]
          },
          "741840309": {
            "id": "741840309",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ugh, guess there's no dissuading you! But please be careful, okay?",
            "nextDialogs": [
              "741840310"
            ]
          },
          "741840310": {
            "id": "741840310",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmph! Paimon knew they were just a bunch of frauds! There's no treasure at all!",
            "nextDialogs": [
              "741840311"
            ]
          },
          "741840311": {
            "id": "741840311",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Or is this shabby excuse for a statue some kind of priceless artifact?",
            "nextDialogs": [
              "741840312"
            ]
          },
          "741840312": {
            "id": "741840312",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmm... Let's go to Petrichor and ask around. Maybe it's some kind of landmark or lucky mascot or something!",
            "nextDialogs": [
              "741840313"
            ]
          },
          "741840313": {
            "id": "741840313",
            "speakerId": 1003,
            "speakerName": "Paimon's Voice",
            "text": "As for these \"treasures\"... We...",
            "nextDialogs": [
              "741840314"
            ]
          },
          "741840314": {
            "id": "741840314",
            "speakerId": 1003,
            "speakerName": "Paimon's Voice",
            "text": "#...Hey! {NICKNAME}, you..."
          },
          "741840308": {
            "id": "741840308",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "You're not wrong, but... What if there's some kind of evil dark lord-y trap inside..."
          }
        }
      }
    },
    {
      "subId": "7418433",

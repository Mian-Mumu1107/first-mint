  "subQuests": [
    {
      "subId": "2200501",
      "subQuestName": "Talk to Bao'er",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220050101"
        ],
        "dialogs": {
          "220050101": {
            "id": "220050101",
            "speakerId": 1000,
            "speakerName": "Bao'er",
            "text": "Come on, where is it...",
            "nextDialogs": [
              "220050102"
            ]
          },
          "220050102": {
            "id": "220050102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "220050103"
            ]
          },
          "220050103": {
            "id": "220050103",
            "speakerId": 1000,
            "speakerName": "Bao'er",
            "text": "Wah! Where'd you come from!? How'd you sneak up so quietly...",
            "nextDialogs": [
              "220050104"
            ]
          },
          "220050104": {
            "id": "220050104",
            "speakerId": 1000,
            "speakerName": "Bao'er",
            "text": "Me? I'm... a researcher. I'm looking into the historical architecture and relics of the Guili Plains. Y—You can call me Bao'er.",
            "nextDialogs": [
              "220050105"
            ]
          },
          "220050105": {
            "id": "220050105",
            "speakerId": 1000,
            "speakerName": "Bao'er",
            "text": "I was so engrossed in my research that I've misplaced a package I carry round with me.",
            "nextDialogs": [
              "220050106"
            ]
          },
          "220050106": {
            "id": "220050106",
            "speakerId": 1000,
            "speakerName": "Bao'er",
            "text": "It's got an extremely rare trea... Uh, an extremely rare historical relic inside. Could you help me look for it?",
            "nextDialogs": [
              "220050110",
              "220050111",
              "220050114"
            ]
          },
          "220050110": {
            "id": "220050110",
            "speakerId": 1000,
            "speakerName": "Bao'er",
            "text": "Great! I think it was near here that I dropped it... or maybe a little further out. Anyway, please have a careful look."
          },
          "220050111": {
            "id": "220050111",
            "speakerId": 1000,
            "speakerName": "Bao'er",
            "text": "Y'know, just... an everyday box. Four sides, a top, and a bottom...",
            "nextDialogs": [
              "220050112"
            ]
          },
          "220050112": {
            "id": "220050112",
            "speakerId": 1000,
            "speakerName": "Bao'er",
            "text": "Why put a relic in there? Because... Having it in a box is more convenient.",
            "nextDialogs": [
              "220050113"
            ]
          },
          "220050113": {
            "id": "220050113",
            "speakerId": 1000,
            "speakerName": "Bao'er",
            "text": "I padded the box with some clothes to protect it from damage. Please, help me find it as quickly as you can."
          },
          "220050114": {
            "id": "220050114",
            "speakerId": 1000,
            "speakerName": "Bao'er",
            "text": "It's, uh... It's just a very precious relic. Ugh, you wouldn't understand even if I tried to explain it.",
            "nextDialogs": [
              "220050115"
            ]
          },
          "220050115": {
            "id": "220050115",
            "speakerId": 1000,
            "speakerName": "Bao'er",
            "text": "Only an expert like me can tell its true value. Please, help me find it as quickly as you can."
          }
        }
      }
    },

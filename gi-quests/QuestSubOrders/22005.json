          },
          "220050303": {
            "id": "220050303",
            "speakerId": 1000,
            "speakerName": "Bao'er",
            "text": "Let me see... No, I—I don't think so... Feels too light, it's definitely not that relic inside...",
            "nextDialogs": [
              "220050304"
            ]
          },
          "220050304": {
            "id": "220050304",
            "speakerId": 1000,
            "speakerName": "Bao'er",
            "text": "But thanks anyway. I'll keep looking by myself.",

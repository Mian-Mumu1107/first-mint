  "subQuests": [
    {
      "subId": "2005001",
      "subQuestName": "Go and talk to Ellin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200500101"
        ],
        "dialogs": {
          "200500101": {
            "id": "200500101",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Ugh, what a headache... What am I supposed to do about this?",
            "nextDialogs": [
              "200500102"
            ]
          },
          "200500102": {
            "id": "200500102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you up to?",
            "nextDialogs": [
              "200500103"
            ]
          },
          "200500103": {
            "id": "200500103",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Practicing for the Knights of Favonius' tryouts!",
            "nextDialogs": [
              "200500104"
            ]
          },
          "200500104": {
            "id": "200500104",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "*sigh* But I'm nowhere near as powerful as Jean.",
            "nextDialogs": [
              "200500105"
            ]
          },
          "200500105": {
            "id": "200500105",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "I think it's better for me to focus on technique rather than power.",
            "nextDialogs": [
              "200500106"
            ]
          },
          "200500106": {
            "id": "200500106",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "For example, I was thinking about how to break all these wooden dummies in one fell swoop.",
            "nextDialogs": [
              "200500107"
            ]
          },
          "200500107": {
            "id": "200500107",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "If you're at a loose end, fancy helping me think about how to tackle it?",
            "nextDialogs": [
              "200500110",
              "200500112"
            ]
          },
          "200500110": {
            "id": "200500110",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Sure, take your time. It's not like these dummies are going anywhere.",
            "nextDialogs": [
              "200500111"
            ]
          },
          "200500111": {
            "id": "200500111",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Nor is my life going anywhere while I'm stuck trying to sort this out, ugh...",
            "nextDialogs": [
              "200500114"
            ]
          },
          "200500114": {
            "id": "200500114",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "I've heard that the elements interact in special ways. I wonder if there's a way we can use the fire on this brazier to cause a little explosion...",
            "nextDialogs": [
              "200500115"
            ]
          },
          "200500115": {
            "id": "200500115",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "But first there needs to actually be a fire in the brazier..."
          },
          "200500112": {
            "id": "200500112",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "You like team combat, then? Alright for some... always someone to help you out.",
            "nextDialogs": [
              "200500113"
            ]
          },
          "200500113": {
            "id": "200500113",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "For people like me, the best I can do is try and hold my own as a lone fighter."
          }
        }
      }
    },
    {
      "subId": "2005002",
      "subQuestName": "Destroy all the training dummies in under 2 seconds",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200500201"
        ],
        "dialogs": {
          "200500201": {
            "id": "200500201",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "How are you getting along? Had a eureka moment yet?",
            "nextDialogs": [
              "200500202"
            ]
          },
          "200500202": {
            "id": "200500202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Still thinking it over...",
            "nextDialogs": [
              "200500203"
            ]
          },
          "200500203": {
            "id": "200500203",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Huh. I've met a few other adventurers before. They were the same way.",
            "nextDialogs": [
              "200500204"
            ]
          },
          "200500204": {
            "id": "200500204",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "They fight monsters like pros, but they're hopelessly lost when it comes to trying to break a few wooden sticks.",
            "nextDialogs": [
              "200500205"
            ]
          },
          "200500205": {
            "id": "200500205",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "And they reinforce the wood like it's for building a storm shelter or something... Way overestimating their own strength.",
            "nextDialogs": [
              "200500206"
            ]
          },
          "200500206": {
            "id": "200500206",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "If they want a challenge so desperately, why don't they just go off into the wilderness and pick a fight with the biggest monster they can find?"
          }
        }
      }
    },
    {
      "subId": "2005003",
      "subQuestName": "Go back and talk to Ellin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200500301"
        ],
        "dialogs": {
          "200500301": {
            "id": "200500301",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Nailed it!",
            "nextDialogs": [
              "200500302"
            ]
          },
          "200500302": {
            "id": "200500302",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Huh, I never even thought of trying that...",
            "nextDialogs": [
              "200500303"
            ]
          },
          "200500303": {
            "id": "200500303",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Thanks! I'm gonna try it myself now."
          }
        }
      }
    }
  ]
}
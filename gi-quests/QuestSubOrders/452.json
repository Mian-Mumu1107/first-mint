    {
      "subId": "45204",
      "subQuestName": "Defeat the hilichurls",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4520401"
        ],
        "dialogs": {
          "4520401": {
            "id": "4520401",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Quick, let's go help!"
          }
        }
      }

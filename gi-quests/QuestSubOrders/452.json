  "subQuests": [
    {
      "subId": "45201",
      "subQuestName": "Find Amber and ask about the boy from Wolvendom",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4520101"
        ],
        "dialogs": {
          "4520101": {
            "id": "4520101",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "#Hi Paimon, hi {NICKNAME}! What can I do for you?",
            "nextDialogs": [
              "4520102"
            ]
          },
          "4520102": {
            "id": "4520102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hi Amber~",
            "nextDialogs": [
              "4520104",
              "4520125"
            ]
          },
          "4520104": {
            "id": "4520104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Amber, do you know a wolf boy from Wolvendom?",
            "nextDialogs": [
              "4520105"
            ]
          },
          "4520105": {
            "id": "4520105",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Who?",
            "nextDialogs": [
              "4520106"
            ]
          },
          "4520106": {
            "id": "4520106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He said you guys hit it off like a mountain on fire...",
            "nextDialogs": [
              "4520107"
            ]
          },
          "4520107": {
            "id": "4520107",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "What on earth are you talking about?",
            "nextDialogs": [
              "4520108"
            ]
          },
          "4520108": {
            "id": "4520108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Strange... He said he would wait for you at your regular spot. Did you lose your memory or something?",
            "nextDialogs": [
              "4520109"
            ]
          },
          "4520109": {
            "id": "4520109",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "My memory is fine. But you've been eating magic matsutake again, haven't you Paimon?",
            "nextDialogs": [
              "4520110"
            ]
          },
          "4520110": {
            "id": "4520110",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "I have no idea what you're talking about.",
            "nextDialogs": [
              "4520111"
            ]
          },
          "4520111": {
            "id": "4520111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Magic matsutake... Remind me what color they are?",
            "nextDialogs": [
              "4520112"
            ]
          },
          "4520112": {
            "id": "4520112",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Purple.",
            "nextDialogs": [
              "4520113"
            ]
          },
          "4520113": {
            "id": "4520113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Paimon may have had a couple the other day.",
            "nextDialogs": [
              "4520114"
            ]
          },
          "4520114": {
            "id": "4520114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But that's not the point! Paimon's not loopy!",
            "nextDialogs": [
              "4520115"
            ]
          },
          "4520115": {
            "id": "4520115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Do you really not know that boy that lives with the wolves?",
            "nextDialogs": [
              "4520116"
            ]
          },
          "4520116": {
            "id": "4520116",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "I. don't. know. what. you're. talking. about.",
            "nextDialogs": [
              "4520117"
            ]
          },
          "4520117": {
            "id": "4520117",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "But on the subject of wolves, I've been investigating something recently.",
            "nextDialogs": [
              "4520118"
            ]
          },
          "4520118": {
            "id": "4520118",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "In the past, the wolves never dared venture outside of Wolvendom. But now they're getting braver.",
            "nextDialogs": [
              "4520119"
            ]
          },
          "4520119": {
            "id": "4520119",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "I heard they attacked a cart fleet near Drunkard Gorge.",
            "nextDialogs": [
              "4520120"
            ]
          },
          "4520120": {
            "id": "4520120",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "If you have time, could you come and check out the situation with me?"
          },
          "4520125": {
            "id": "4520125",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Hi... Looks like you've got a bit of time on your hands.",
            "nextDialogs": [
              "4520126"
            ]
          },
          "4520126": {
            "id": "4520126",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh-oh, here it comes...",
            "nextDialogs": [
              "4520127"
            ]
          },
          "4520127": {
            "id": "4520127",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "I've been rushed off my feet recently. An Outrider's duties never end, so... Wanna help?",
            "nextDialogs": [
              "4520129"
            ]
          },
          "4520129": {
            "id": "4520129",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Told you so!"
          }
        }
      }
    },
    {
      "subId": "45202",
      "subQuestName": "Go to Drunkard Gorge",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4520201"
        ],
        "dialogs": {
          "4520201": {
            "id": "4520201",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Look, up ahead! Something's happening.",
            "nextDialogs": [
              "4520202"
            ]
          },
          "4520202": {
            "id": "4520202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That ain't no wolf pack... looks like it's the hilichurls attacking the carts after all.",
            "nextDialogs": [
              "4520203"
            ]
          },
          "4520203": {
            "id": "4520203",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Huh. Not such a mystery after all.",
            "nextDialogs": [
              "4520204"
            ]
          },
          "4520204": {
            "id": "4520204",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Enough talk. Let's go help out!"
          }
        }
      }
    },

    {
      "subId": "45205",
      "subQuestName": "Talk to Siegfria",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4520301"
        ],
        "dialogs": {
          "4520301": {
            "id": "4520301",
            "speakerId": 1631,
            "speakerName": "Siegfria",
            "text": "Bless you!",
            "nextDialogs": [
              "4520302"
            ]
          },
          "4520302": {
            "id": "4520302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Piece of cake!",
            "nextDialogs": [
              "4520303"
            ]
          },
          "4520303": {
            "id": "4520303",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "So, the hilichurls have been starting to flex their muscles on the back of the wolf scare.",
            "nextDialogs": [
              "4520304"
            ]
          },
          "4520304": {
            "id": "4520304",
            "speakerId": 1631,
            "speakerName": "Siegfria",
            "text": "That's right. But I must say, if you think the Hilichurls are a nasty lot, the wolves are even worse.",
            "nextDialogs": [
              "4520305"
            ]
          },
          "4520305": {
            "id": "4520305",
            "speakerId": 1631,
            "speakerName": "Siegfria",
            "text": "They... they attacked Springvale this morning.",
            "nextDialogs": [
              "4520306"
            ]
          },
          "4520306": {
            "id": "4520306",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Springvale!? That's crazy!",
            "nextDialogs": [
              "4520307"
            ]
          },
          "4520307": {
            "id": "4520307",
            "speakerId": 1631,
            "speakerName": "Siegfria",
            "text": "It's unheard of.",
            "nextDialogs": [
              "4520308"
            ]
          },
          "4520308": {
            "id": "4520308",
            "speakerId": 1631,
            "speakerName": "Siegfria",
            "text": "I thought I would take my chances on the road after the wolves had their fun... I never thought the hilichurls would show up too.",
            "nextDialogs": [
              "4520309"
            ]
          },
          "4520309": {
            "id": "4520309",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "We should head there soon and see how bad the situation is.",
            "nextDialogs": [
              "4520310"
            ]
          },
          "4520310": {
            "id": "4520310",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "But first things first, you should assess the damage to your cart. Does it still work?",
            "nextDialogs": [
              "4520311"
            ]
          },
          "4520311": {
            "id": "4520311",
            "speakerId": 1631,
            "speakerName": "Siegfria",
            "text": "I'll take a look."
          }
        }
      }
    }

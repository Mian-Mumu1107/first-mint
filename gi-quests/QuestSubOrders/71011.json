        "dialogs": {
          "3476801": {
            "id": "3476801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh... The words on this tablet are really hard to read.",
            "nextDialogs": [
              "3476802"
            ]
          },
          "3476802": {
            "id": "3476802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So this is a ruin, but it's also an adepti's trail. Which is it?",
            "nextDialogs": [
              "3476803"
            ]
          },
          "3476803": {
            "id": "3476803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Still, it says here that \"At Tianqiu Valley the adepti's ancient trail grows cold.\" That means we can be sure that the event the stone tablet mentions must have happened at Tianqiu Valley.",
            "nextDialogs": [
              "3476804"
            ]
          },
          "3476804": {
            "id": "3476804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Guess we've got no choice but to have a look around. Maybe we'll find something."
          }
        }
      }
    },

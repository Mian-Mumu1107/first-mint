  "subQuests": [
    {
      "subId": "7329401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732940101"
        ],
        "dialogs": {
          "732940101": {
            "id": "732940101",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "Ugh...",
            "nextDialogs": [
              "732940102"
            ]
          },
          "732940102": {
            "id": "732940102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Looks like this guy's not doing so good... He must be famished! Let's give him some of our food, shall we, {NICKNAME}?",
            "nextDialogs": [
              "732940104",
              "732940106"
            ]
          },
          "732940104": {
            "id": "732940104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Not to be biased or anything, but Paimon thinks you make great food!",
            "nextDialogs": [
              "732940107"
            ]
          },
          "732940107": {
            "id": "732940107",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You give the collapsed man some Teyvat Fried Egg.",
            "nextDialogs": [
              "732940108"
            ]
          },
          "732940108": {
            "id": "732940108",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "I... I live! I live again!",
            "nextDialogs": [
              "732940109"
            ]
          },
          "732940109": {
            "id": "732940109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa, he must really have been starving. That was just one fried egg...",
            "nextDialogs": [
              "732940110"
            ]
          },
          "732940110": {
            "id": "732940110",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "Ah, that unspeakable deliciousness was enough to revive the dead, surely! If I had known that fried eggs could taste this glorious, I would've bought that mysterious egg off that fellow.",
            "nextDialogs": [
              "732940111"
            ]
          },
          "732940111": {
            "id": "732940111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What mysterious egg?",
            "nextDialogs": [
              "732940112"
            ]
          },
          "732940112": {
            "id": "732940112",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "It is said that eating the egg can help you deflect a day's worth of misfortune. Oh, how I wish I'd bought one... or perhaps even twelve...",
            "nextDialogs": [
              "732940113"
            ]
          },
          "732940113": {
            "id": "732940113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh, that sounds really suspicious — and Paimon reckons she knows a scam when she sees one. Still, how did you end up here?",
            "nextDialogs": [
              "732940114"
            ]
          },
          "732940114": {
            "id": "732940114",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "I... Well, I'm a renowned artist from Fontaine, and I'm here in Sumeru to gather inspiration for my work. Call me Julien."
          },
          "732940106": {
            "id": "732940106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "C'mon! Everyone's definitely fainted from hunger at least once in their lives, right?"
          }
        }
      }
    },
    {
      "subId": "7329404",
      "subQuestName": "Return with Julien to his camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732940401"
        ],
        "dialogs": {
          "732940401": {
            "id": "732940401",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "I'm counting on you regarding my luggage..."
          }
        }
      }
    },
    {
      "subId": "7329405",
      "subQuestName": "Talk to Julien",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732940501"
        ],
        "dialogs": {
          "732940501": {
            "id": "732940501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What a simple camp... Paimon wonders if you could even call it a camp.",
            "nextDialogs": [
              "732940502"
            ]
          },
          "732940502": {
            "id": "732940502",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "Well, the scenery here is quite good, and there's a sense of openness whenever I stand by the water. It's honestly a lot more relaxing than when I was in Fontaine.",
            "nextDialogs": [
              "732940503"
            ]
          },
          "732940503": {
            "id": "732940503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What sort of life did you lead while you were there, seriously? That's... not quite what Paimon was expecting from a renowned artist.",
            "nextDialogs": [
              "732940504"
            ]
          },
          "732940504": {
            "id": "732940504",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "I lived in a very small place back in Fontaine... And um, that's only because I'm a humble person.",
            "nextDialogs": [
              "732940505"
            ]
          },
          "732940505": {
            "id": "732940505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But even outdoor adventurer camps look way better than this. Huh? You have an animal buddy?",
            "nextDialogs": [
              "732940506"
            ]
          },
          "732940506": {
            "id": "732940506",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "Um, I don't have one. This must've been left behind by an adventurer or something like that. Speaking of which...",
            "nextDialogs": [
              "732940507"
            ]
          },
          "732940507": {
            "id": "732940507",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "I would love to receive you in better fashion, but most of my luggage fell into the water when my raft fell apart, and I cannot swim...",
            "nextDialogs": [
              "732940508"
            ]
          },
          "732940508": {
            "id": "732940508",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "But if you could find my lost luggage for me...",
            "nextDialogs": [
              "732940509"
            ]
          },
          "732940509": {
            "id": "732940509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Would it even be usable after getting soaked like that...",
            "nextDialogs": [
              "732940510"
            ]
          },
          "732940510": {
            "id": "732940510",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "I did carefully pack everything up, but there are some things that... *sigh* Well, if I've lost them, I've lost them. I can always redraw them... yes, redraw them...",
            "nextDialogs": [
              "732940511"
            ]
          },
          "732940511": {
            "id": "732940511",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um, perhaps we should help out. This guy seems like he's in a real bad spot.",
            "nextDialogs": [
              "732940512"
            ]
          },
          "732940512": {
            "id": "732940512",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "I have no one else to rely on here, so I can only ask the two of you for aid. I'll be waiting here with some good tea in hand."
          }
        }
      }
    },

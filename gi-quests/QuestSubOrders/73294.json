    {
      "subId": "7329412",
      "subQuestName": "Go to the camp and talk to Julien",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732941201"
        ],
        "dialogs": {
          "732941201": {
            "id": "732941201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We're back! Huh, so it is your animal companion, Julien!",
            "nextDialogs": [
              "732941202"
            ]
          },
          "732941202": {
            "id": "732941202",
            "speakerId": 1003,
            "speakerName": "Dog",
            "text": "(Lets out a threatening growl.)",
            "nextDialogs": [
              "732941203"
            ]
          },
          "732941203": {
            "id": "732941203",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "Wonderful, Pepper... Taken to growling at me, have you? Don't you know who's keeping us both fed here?",
            "nextDialogs": [
              "732941204"
            ]
          },
          "732941204": {
            "id": "732941204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "(Oh, so it has a name! But on the other hand... is this guy seriously arguing with a dog?)",
            "nextDialogs": [
              "732941206",
              "732941208"
            ]
          },
          "732941206": {
            "id": "732941206",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "(Is that what \"close\" looks like to you!?)",
            "nextDialogs": [
              "732941244"
            ]
          },
          "732941244": {
            "id": "732941244",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, Julien! We found the stuff you lost! Pepper's your animal buddy, isn't it? Why did you lie to us earlier?",
            "nextDialogs": [
              "732941209"
            ]
          },
          "732941209": {
            "id": "732941209",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "If this ungrateful fellow counts as my buddy... I'd rather adopt a Rifthound.",
            "nextDialogs": [
              "732941210"
            ]
          },
          "732941210": {
            "id": "732941210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I doubt that you'll be companions for very long...",
            "nextDialogs": [
              "732941211"
            ]
          },
          "732941211": {
            "id": "732941211",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Exactly. If someone like you, who faints from hunger, ran into a Rifthound, the resulting problem wouldn't be one we could solve with just a Teyvat Fried Egg...",
            "nextDialogs": [
              "732941212"
            ]
          },
          "732941212": {
            "id": "732941212",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Speaking of which, it seems to have been guarding a drawing board on the beach."
          },
          "732941208": {
            "id": "732941208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "(Is he just usually like that? Seems like a rather troublesome guy...)"
          }
        }
      }
    },
    {
      "subId": "7329499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732949901"
        ],
        "dialogs": {
          "732949901": {
            "id": "732949901",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "Speaking of which, what brings the two of you here? You're not here for the same reasons as me... right?",
            "nextDialogs": [
              "732949902"
            ]
          },
          "732949902": {
            "id": "732949902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You mean, did we travel here just to make some art? Nah, of course not!",
            "nextDialogs": [
              "732949903"
            ]
          },
          "732949903": {
            "id": "732949903",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}'s a registered adventurer. It should be no surprise finding {M#him}{F#her} in every corner of Teyvat!",
            "nextDialogs": [
              "732949906"
            ]
          },
          "732949906": {
            "id": "732949906",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's a drawing board! That's gotta be Julien's. Let's haul it back together with the rest. The tea's probably ready by now, so we've gotta hurry!"
          }
        }
      }
    }
  ]
}
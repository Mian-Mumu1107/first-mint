    {
      "subId": "7329410",
      "subQuestName": "Check on the dog on the beach",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732941001"
        ],
        "dialogs": {
          "732941001": {
            "id": "732941001",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Strange. Why would there be a dog here? And it seems to be guarding something, too.",
            "nextDialogs": [
              "732941002"
            ]
          },
          "732941002": {
            "id": "732941002",
            "speakerId": 1003,
            "speakerName": "Dog",
            "text": "(Watches you warily.)",
            "nextDialogs": [
              "732941004",
              "732941006"
            ]
          },
          "732941004": {
            "id": "732941004",
            "speakerId": 1003,
            "speakerName": "Dog",
            "text": "(Gives a short bark.)",
            "nextDialogs": [
              "732941007"
            ]
          },
          "732941007": {
            "id": "732941007",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Right, didn't we see a food bowl back at Julien's camp? Maybe it belongs to this fella! Strange, though. Didn't Julien say that he didn't have any animal companions?",
            "nextDialogs": [
              "732941008"
            ]
          },
          "732941008": {
            "id": "732941008",
            "speakerId": 1003,
            "speakerName": "Dog",
            "text": "*whimpers*",
            "nextDialogs": [
              "732941009"
            ]
          },
          "732941009": {
            "id": "732941009",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The dog runs toward the camp...",
            "nextDialogs": [
              "732941010"
            ]
          },
          "732941010": {
            "id": "732941010",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's gone... Let's ask Julien about this later. For now, though... Paimon wonders what's under this sand pile. Should we take a look?"
          },
          "732941006": {
            "id": "732941006",
            "speakerId": 1003,
            "speakerName": "Dog",
            "text": "(Gives a low growl.)"
          }
        }
      }
    },
    {
      "subId": "7329411",

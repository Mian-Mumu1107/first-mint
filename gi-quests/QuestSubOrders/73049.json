    {
      "subId": "7304910",
      "subQuestName": "Talk to Oleg",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730491001"
        ],
        "dialogs": {
          "730491001": {
            "id": "730491001",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "Argh, lost again...",
            "nextDialogs": [
              "730491002"
            ]
          },
          "730491002": {
            "id": "730491002",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "I bet you are one of those who'd do anything for Mora, right?",
            "nextDialogs": [
              "730491003"
            ]
          },
          "730491003": {
            "id": "730491003",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "How about this? I give you Mora, and you get out of the way, you in?",
            "nextDialogs": [
              "730491004"
            ]
          },
          "730491004": {
            "id": "730491004",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Whoa, {NICKNAME}, this Fatui guy does know us well!",
            "nextDialogs": [
              "730491005"
            ]
          },
          "730491005": {
            "id": "730491005",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But listen, we'll take the Mora...",
            "nextDialogs": [
              "730491006"
            ]
          },
          "730491006": {
            "id": "730491006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But we won't stay away!",
            "nextDialogs": [
              "730491007"
            ]
          },
          "730491007": {
            "id": "730491007",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "Ugh, why are you so annoying? That's some beef between us, just you wait!",
            "nextDialogs": [
              "730491008"
            ]
          },
          "730491008": {
            "id": "730491008",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "Oleg runs away amidst the chaos...",
            "nextDialogs": [
              "730491009"
            ]
          },
          "730491009": {
            "id": "730491009",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, Paimon couldn't even see his moves... it's like one blink, and he's gone!",
            "nextDialogs": [
              "730491010"
            ]
          },
          "730491010": {
            "id": "730491010",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This Fatuus is actually skilled in running away!",
            "nextDialogs": [
              "730491011"
            ]
          },
          "730491011": {
            "id": "730491011",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "One... Two... Next up is camp number three on the patrol route. We aren't gonna run into him there, right..."
          }
        }
      }
    },
    {
      "subId": "7304911",

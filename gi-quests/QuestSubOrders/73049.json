    {
      "subId": "7304916",
      "subQuestName": "Talk to Kasim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730491601"
        ],
        "dialogs": {
          "730491601": {
            "id": "730491601",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Ouch... Geez, don't hit me... Stooop that!",
            "nextDialogs": [
              "730491602"
            ]
          },
          "730491602": {
            "id": "730491602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are you really some legendary bandit...?",
            "nextDialogs": [
              "730491603"
            ]
          },
          "730491603": {
            "id": "730491603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're much weaker than I imagined...",
            "nextDialogs": [
              "730491604"
            ]
          },
          "730491604": {
            "id": "730491604",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Not every bandit is known for their physical strength...",
            "nextDialogs": [
              "730491605"
            ]
          },
          "730491605": {
            "id": "730491605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hm, that's a slick tongue. We should really ask him some right questions!"
          }
        }
      }
    },
    {
      "subId": "7304917",
      "subQuestName": "Interrogate Kasim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730491701"
        ],
        "dialogs": {
          "730491701": {
            "id": "730491701",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Go ahead. I promise I'll tell everything in my knowledge, hehe...",
            "nextDialogs": [
              "730491702"
            ]
          },
          "730491702": {
            "id": "730491702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you really a bandit from the Eremites?",
            "nextDialogs": [
              "730491703"
            ]
          },
          "730491703": {
            "id": "730491703",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Yes, sure...",
            "nextDialogs": [
              "730491705",
              "730491707"
            ]
          },
          "730491705": {
            "id": "730491705",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "We are the Eremites, after all. We're from different places and all walks of life, haha!",
            "nextDialogs": [
              "730491709"
            ]
          },
          "730491709": {
            "id": "730491709",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Speaking of this, how on earth did the Fatui find you?",
            "nextDialogs": [
              "730491710"
            ]
          },
          "730491710": {
            "id": "730491710",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "They came for my hard-earned reputation in the Eremites, of course..."
          },
          "730491707": {
            "id": "730491707",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Oh, stop mentioning the Corps of Thirty, will you? We could always talk... Ugh, okay, \"Kasim the Bandit\" is just a stage name. You just need a title for swindling...",
            "nextDialogs": [
              "730491708"
            ]
          },
          "730491708": {
            "id": "730491708",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "That's how the Fatui bought my words this time..."
          }
        }
      }
    },
    {
      "subId": "7304927",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730492701"
        ],
        "dialogs": {
          "730492701": {
            "id": "730492701",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Ah, as things stand now, I might as well tell you everything... I've been providing fake experiment results, and they seem to be suspecting me...",
            "nextDialogs": [
              "730492702"
            ]
          },
          "730492702": {
            "id": "730492702",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "I'll reveal the location of the stronghold. Please catch them. This way, the Fatui would never know that I've been fabricating the results...",
            "nextDialogs": [
              "730492703"
            ]
          },
          "730492703": {
            "id": "730492703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, he's really rotten to the core. The Fatui got into some serious trouble cooperating with him!",
            "nextDialogs": [
              "730492704"
            ]
          },
          "730492704": {
            "id": "730492704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's just hear him out for now...",
            "nextDialogs": [
              "730492705"
            ]
          },
          "730492705": {
            "id": "730492705",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Near the tents in the Apam Woods, there are four torches. Light them at night...",
            "nextDialogs": [
              "730492706"
            ]
          },
          "730492706": {
            "id": "730492706",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "And the Fatui will respond with signal lights. So if you see bright spots on nearby cliffs...",
            "nextDialogs": [
              "730492707"
            ]
          },
          "730492707": {
            "id": "730492707",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That means the Fatui operation stronghold lies right there! What an interesting communication method...",
            "nextDialogs": [
              "730492708"
            ]
          },
          "730492708": {
            "id": "730492708",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Yes. The Fatui behind the gate will ask you for the watchword, and only those who get it right can enter...",
            "nextDialogs": [
              "730492709"
            ]
          },
          "730492709": {
            "id": "730492709",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They even set up a watchword!",
            "nextDialogs": [
              "730492710"
            ]
          },
          "730492710": {
            "id": "730492710",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "That's right. Let me see, the first half is \"Never bring your own rule book...\"",
            "nextDialogs": [
              "730492711"
            ]
          },
          "730492711": {
            "id": "730492711",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "And the second half is \"to someone else's place.\"",
            "nextDialogs": [
              "730492712"
            ]
          },
          "730492712": {
            "id": "730492712",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, hope the Fatui could actually honor their watchword...",
            "nextDialogs": [
              "730492713"
            ]
          },
          "730492713": {
            "id": "730492713",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Come on, let's try it out. \"Never bring your own rule book...\"",
            "nextDialogs": [
              "730492714"
            ]
          },
          "730492714": {
            "id": "730492714",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"To someone else's place.\"",
            "nextDialogs": [
              "730492715"
            ]
          },
          "730492715": {
            "id": "730492715",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Great, go ahead! For the sake of not revealing my true identity to the Fatui, please catch them!",
            "nextDialogs": [
              "730492716"
            ]
          },
          "730492716": {
            "id": "730492716",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Hehe, see... I've given you such important information. Perhaps you could, you know... let me off the hook...",
            "nextDialogs": [
              "730492717"
            ]
          },
          "730492717": {
            "id": "730492717",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph, behave yourself after this! If you're found doing any tricks again... we'll see you with the Corps of Thirty!",
            "nextDialogs": [
              "730492718"
            ]
          },
          "730492718": {
            "id": "730492718",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Sure, with you two here in Sumeru, I won't do anything mischievous ever, ever again! So, just forgive me this time!",
            "nextDialogs": [
              "730492719"
            ]
          },
          "730492719": {
            "id": "730492719",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Hehe, I'll get outta here then. Wish you success!",
            "nextDialogs": [
              "730492720"
            ]
          },
          "730492720": {
            "id": "730492720",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "Kasim flees in a hurry...",
            "nextDialogs": [
              "730492721"
            ]
          },
          "730492721": {
            "id": "730492721",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um... Maybe we should send this guy to the Sheriff...",
            "nextDialogs": [
              "730492722"
            ]
          },
          "730492722": {
            "id": "730492722",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But we might as well deal with the Fatui first."
          }
        }
      }
    },
    {
      "subId": "7304928",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730492801"
        ],
        "dialogs": {
          "730492801": {
            "id": "730492801",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Their stronghold... Ah, of course I know where it is... It's located in...",
            "nextDialogs": [
              "730492802"
            ]
          },
          "730492802": {
            "id": "730492802",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "...Ah, can you see the mountains over there?",
            "nextDialogs": [
              "730492803"
            ]
          },
          "730492803": {
            "id": "730492803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The mountains over there? You mean that's where the Fatui stronghold lies?",
            "nextDialogs": [
              "730492804"
            ]
          },
          "730492804": {
            "id": "730492804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But Paimon doesn't see anything unusual there. Kasim... Huh? Where did he go?",
            "nextDialogs": [
              "730492805"
            ]
          },
          "730492805": {
            "id": "730492805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He must've sneaked away!",
            "nextDialogs": [
              "730492806"
            ]
          },
          "730492806": {
            "id": "730492806",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wah, that's so despicable!",
            "nextDialogs": [
              "730492808"
            ]
          },
          "730492808": {
            "id": "730492808",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We were so close to the key information!",
            "nextDialogs": [
              "730492809"
            ]
          },
          "730492809": {
            "id": "730492809",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But Kasim was initially meeting with the Fatui here... Maybe we can find some clues around.",
            "nextDialogs": [
              "730492810"
            ]
          },
          "730492810": {
            "id": "730492810",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's check the camp first!"
          }
        }
      }
    },
    {
      "subId": "7304920",
      "subQuestName": "Search the camp for clues about the Fatui stronghold",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "687220101"
        ],
        "dialogs": {
          "687220101": {
            "id": "687220101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look here! It's a book named \"A Guide to Clandestine Contact With the Fatui\"... Paimon wonders if we can find clues regarding the Fatui operation stronghold here...",
            "nextDialogs": [
              "687220102"
            ]
          },
          "687220102": {
            "id": "687220102",
            "speakerId": 1006,
            "speakerName": "\"A Guide to Clandestine Contact With the Fatui\"",
            "text": "\"At night, go near the tents in Apam Woods. Light four torches there...\"",
            "nextDialogs": [
              "687220103"
            ]
          },
          "687220103": {
            "id": "687220103",
            "speakerId": 1006,
            "speakerName": "\"A Guide to Clandestine Contact With the Fatui\"",
            "text": "\"Then, go towards the signal lights. The stronghold lies where the lights come from...\" Wow, so this is how they've been communicating...",
            "nextDialogs": [
              "687220104"
            ]
          },
          "687220104": {
            "id": "687220104",
            "speakerId": 1006,
            "speakerName": "\"A Guide to Clandestine Contact With the Fatui\"",
            "text": "\"Remember, the code is: Never bring your own rule book to someone else's place...\"",
            "nextDialogs": [
              "687220105"
            ]
          },
          "687220105": {
            "id": "687220105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#They even have a code! {NICKNAME}, let's give it a try. \"Never bring your own rule book...\"",
            "nextDialogs": [
              "687220106"
            ]
          },
          "687220106": {
            "id": "687220106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"To someone else's place.\"",
            "nextDialogs": [
              "687220107"
            ]
          },
          "687220107": {
            "id": "687220107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They say \"never bring your own rule book to someone else's place,\" but hmph! The Fatui brought this contact rule with them to Sumeru...",
            "nextDialogs": [
              "687220108"
            ]
          },
          "687220108": {
            "id": "687220108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright, let's go to Apam Woods and get those Fatui!"
          }
        }
      }
    },

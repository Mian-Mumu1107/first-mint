    {
      "subId": "7304913",
      "subQuestName": "Talk to Oleg",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730491301"
        ],
        "dialogs": {
          "730491301": {
            "id": "730491301",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "Geez, what are you after?",
            "nextDialogs": [
              "730491302"
            ]
          },
          "730491302": {
            "id": "730491302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "To stop you from doing bad things, of course!",
            "nextDialogs": [
              "730491303"
            ]
          },
          "730491303": {
            "id": "730491303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell us what the machines are used for!",
            "nextDialogs": [
              "730491304"
            ]
          },
          "730491304": {
            "id": "730491304",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "...Hmph, no way. You must be daydreaming!",
            "nextDialogs": [
              "730491305"
            ]
          },
          "730491305": {
            "id": "730491305",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "Ugh, I've fought too much today... Gotta get some rest at the stronghold...",
            "nextDialogs": [
              "730491306"
            ]
          },
          "730491306": {
            "id": "730491306",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "Oleg runs away amidst the chaos...",
            "nextDialogs": [
              "730491307"
            ]
          },
          "730491307": {
            "id": "730491307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, how does he manage to escape every time? Just why...",
            "nextDialogs": [
              "730491308"
            ]
          },
          "730491308": {
            "id": "730491308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon guesses he had no idea that we had his plan, though. Just look at his surprised face...",
            "nextDialogs": [
              "730491309"
            ]
          },
          "730491309": {
            "id": "730491309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He said he was going back to base to rest. In other words, he won't be patrolling the last camp on the map...",
            "nextDialogs": [
              "730491312"
            ]
          },
          "730491312": {
            "id": "730491312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yes, you're right. We can't leave the weird suction fans activated like that..."
          }
        }
      }
    },

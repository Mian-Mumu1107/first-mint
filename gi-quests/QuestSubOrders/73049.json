  "subQuests": [
    {
      "subId": "7304929",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730492901"
        ],
        "dialogs": {
          "730492901": {
            "id": "730492901",
            "speakerId": 16791,
            "speakerName": "Rukh Shah",
            "text": "I must thank you both.",
            "nextDialogs": [
              "730492902"
            ]
          },
          "730492902": {
            "id": "730492902",
            "speakerId": 16791,
            "speakerName": "Rukh Shah",
            "text": "And let me know if you have any clues about Kasim's whereabouts."
          }
        }
      }
    },
    {
      "subId": "7304903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730490317"
        ],
        "dialogs": {
          "730490317": {
            "id": "730490317",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Shhh, {NICKNAME}, look over there! An Eremite member and... a Fatuus!",
            "nextDialogs": [
              "730490301"
            ]
          },
          "730490301": {
            "id": "730490301",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Kasim... how are these Saghira Machines working?",
            "nextDialogs": [
              "730490302"
            ]
          },
          "730490302": {
            "id": "730490302",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Working good, Oleg...",
            "nextDialogs": [
              "730490303"
            ]
          },
          "730490303": {
            "id": "730490303",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "This is the result report. And if nothing goes wrong, it won't take long for you to get what you want...",
            "nextDialogs": [
              "730490304"
            ]
          },
          "730490304": {
            "id": "730490304",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "Hahaha, great! With your help, we will be able to complete the order of our Lord Harbingers in no time.",
            "nextDialogs": [
              "730490305"
            ]
          },
          "730490305": {
            "id": "730490305",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "But if you dare lie to me... you will pay the price!",
            "nextDialogs": [
              "730490306"
            ]
          },
          "730490306": {
            "id": "730490306",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "What's in it for me to lie to you?",
            "nextDialogs": [
              "730490307"
            ]
          },
          "730490307": {
            "id": "730490307",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "Anyway, you know what I mean.",
            "nextDialogs": [
              "730490308"
            ]
          },
          "730490308": {
            "id": "730490308",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "Hmph, Trofin Snezhevich... That guy didn't achieve anything here in the past few years, whereas I have already gotten results. Well, won't we see what he has to say for himself then?",
            "nextDialogs": [
              "730490309"
            ]
          },
          "730490309": {
            "id": "730490309",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Trofin Snezhevich... I've never heard that name in Sumeru...",
            "nextDialogs": [
              "730490310"
            ]
          },
          "730490310": {
            "id": "730490310",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "Haha, of course you haven't. Surely he wouldn't use this name to reveal himself... The Lord Harbinger sent him here, but he's made no progress all these years.",
            "nextDialogs": [
              "730490311"
            ]
          },
          "730490311": {
            "id": "730490311",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "...Wait, wh—who is there? How did you get in here?",
            "nextDialogs": [
              "730490312"
            ]
          },
          "730490312": {
            "id": "730490312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Oops, {NICKNAME}, they found us!",
            "nextDialogs": [
              "730490313"
            ]
          },
          "730490313": {
            "id": "730490313",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "...I should leave now.",
            "nextDialogs": [
              "730490314"
            ]
          },
          "730490314": {
            "id": "730490314",
            "speakerId": 20713,
            "speakerName": "Kasim",
            "text": "Hm, Fatuus, you won't lose to some random adventurer who broke in, will you?",
            "nextDialogs": [
              "730490315"
            ]
          },
          "730490315": {
            "id": "730490315",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "None of your business, Eremite guy. I'll beat down this rude intruder and head to the research camp we talked about.",
            "nextDialogs": [
              "730490316"
            ]
          },
          "730490316": {
            "id": "730490316",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "Kasim leaves..."
          }
        }
      }
    },
    {
      "subId": "7304904",
      "subQuestName": "Fight Oleg",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7304905",
      "subQuestName": "Talk to Oleg",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730490501"
        ],
        "dialogs": {
          "730490501": {
            "id": "730490501",
            "speakerId": 20712,
            "speakerName": "Oleg",
            "text": "If I weren't exhausted by retaking the camp... Ugh, I'll get you next time!",
            "nextDialogs": [
              "730490502"
            ]
          },
          "730490502": {
            "id": "730490502",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "Oleg runs away amidst the chaos...",
            "nextDialogs": [
              "730490503"
            ]
          },
          "730490503": {
            "id": "730490503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, that's a quick getaway...",
            "nextDialogs": [
              "730490504"
            ]
          },
          "730490504": {
            "id": "730490504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, the thing he left behind is... an \"Emergency Adjustment Plan\"?",
            "nextDialogs": [
              "730490505"
            ]
          },
          "730490505": {
            "id": "730490505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's see what it says...",
            "nextDialogs": [
              "730490506"
            ]
          },
          "730490506": {
            "id": "730490506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Since the Saghira Machine operation is an important link in Snezhnaya's research projects in Sumeru, there is no room for failure... Recently our research camps have suffered from repeated breaches of security, resulting in the breakdown of the machines...\"",
            "nextDialogs": [
              "730490507"
            ]
          },
          "730490507": {
            "id": "730490507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, someone broke through their camps multiple times. That's impressive. Paimon wonders who those kind and brave people are!",
            "nextDialogs": [
              "730490510"
            ]
          },
          "730490510": {
            "id": "730490510",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, yeah. Then, \"we need to retake the camp. Patrols will be stepped up today... Make your rounds <color=#00E1FFFF>in the order of the camps marked on this map...</color>\"",
            "nextDialogs": [
              "730490511"
            ]
          },
          "730490511": {
            "id": "730490511",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "As you can see in this picture, the camp we are in is the starting point for the patrol.",
            "nextDialogs": [
              "730490512"
            ]
          },
          "730490512": {
            "id": "730490512",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So they need to recapture these four camps! Interesting that the Fatui would seek help from the Eremites...",
            "nextDialogs": [
              "730490513"
            ]
          },
          "730490513": {
            "id": "730490513",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh... And it goes \"...set out from the action stronghold and execute the above plan.\" So they even have an operation stronghold...",
            "nextDialogs": [
              "730490514"
            ]
          },
          "730490514": {
            "id": "730490514",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph, if only we knew where this operation stronghold is...",
            "nextDialogs": [
              "730490515"
            ]
          },
          "730490515": {
            "id": "730490515",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's wipe them all out!",
            "nextDialogs": [
              "730490516"
            ]
          },
          "730490516": {
            "id": "730490516",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh-huh! Now let's head to the camps in order. We'll definitely catch the Fatui!"
          }
        }
      }
    },

    {
      "subId": "2051104",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205110401"
        ],
        "dialogs": {
          "205110401": {
            "id": "205110401",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Have you found it yet?",
            "nextDialogs": [
              "205110402"
            ]
          },
          "205110402": {
            "id": "205110402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yup.",
            "nextDialogs": [
              "205110403"
            ]
          },
          "205110403": {
            "id": "205110403",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Is that it? It really doesn't look any different...",
            "nextDialogs": [
              "205110404"
            ]
          },
          "205110404": {
            "id": "205110404",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "However you look at it, this is just an ordinary berry...",
            "nextDialogs": [
              "205110405"
            ]
          },
          "205110405": {
            "id": "205110405",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Forget it. Since that's the doctor's orders, let's follow the prescription to the letter.",
            "nextDialogs": [
              "205110406"
            ]
          },
          "205110406": {
            "id": "205110406",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Thank you. This is for your trouble.",
            "nextDialogs": [
              "205110407"
            ]
          },
          "205110407": {
            "id": "205110407",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "I might need to bother you again in the future. When that happens, please don't decline."
          }
        }
      }
    }

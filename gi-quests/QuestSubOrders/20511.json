            "speakerName": "Player",
            "text": "Not yet.",
            "nextDialogs": [
              "205110203"
            ]
          },
          "205110203": {
            "id": "205110203",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Please hurry. With Anna's condition, we can't afford to delay..."
          }
        }
      }

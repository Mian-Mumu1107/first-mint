  "subQuests": [
    {
      "subId": "2051101",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205110101"
        ],
        "dialogs": {
          "205110101": {
            "id": "205110101",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Will this prescription really work...?",
            "nextDialogs": [
              "205110102"
            ]
          },
          "205110102": {
            "id": "205110102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "205110103"
            ]
          },
          "205110103": {
            "id": "205110103",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Traveler! You've got great timing. I was just in a spot of bother.",
            "nextDialogs": [
              "205110104"
            ]
          },
          "205110104": {
            "id": "205110104",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Here's the thing. You remember my younger sister, Anna, right? She's always been sickly, and nothing's managed to cure her.",
            "nextDialogs": [
              "205110105"
            ]
          },
          "205110105": {
            "id": "205110105",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "But I heard that there's an incredible doctor in Liyue Harbor who is especially skilled at curing the incurable. So, I asked someone to help me get a prescription from him.",
            "nextDialogs": [
              "205110106"
            ]
          },
          "205110106": {
            "id": "205110106",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "The ingredients are all very unusual... but I suppose I can only give it a shot.",
            "nextDialogs": [
              "205110107"
            ]
          },
          "205110107": {
            "id": "205110107",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Um, let me see... Could you help me find a Dendro-Processed Berry?",
            "nextDialogs": [
              "205110109",
              "205110113",
              "205110117"
            ]
          },
          "205110109": {
            "id": "205110109",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "I have no clue either! Do Dendro Slimes really eat berries...",
            "nextDialogs": [
              "205110110"
            ]
          },
          "205110110": {
            "id": "205110110",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Either way, I'm counting on you! I do know of a place where both Slimes and berries may be found.",
            "nextDialogs": [
              "205110111"
            ]
          },
          "205110111": {
            "id": "205110111",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Please help me take a look. I hope you'll find it..."
          },
          "205110113": {
            "id": "205110113",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "So you think so too, huh? But I don't have any other options.",
            "nextDialogs": [
              "205110114"
            ]
          },
          "205110114": {
            "id": "205110114",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "I know of a place where you can find both Slimes and berries. Could you please go have a look for me?",
            "nextDialogs": [
              "205110115"
            ]
          },
          "205110115": {
            "id": "205110115",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "I'll try the medication that we make first. No matter what, I can't let Anna's condition get any worse."
          },
          "205110117": {
            "id": "205110117",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Huh... What? Are you telling me to stuff the berry into the Dendro Slime's mouth myself?",
            "nextDialogs": [
              "205110118"
            ]
          },
          "205110118": {
            "id": "205110118",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Spare me, please! The last time I went picking herbs for Anna's medication, a group of Dendro Slimes chased me all the way to Springvale!",
            "nextDialogs": [
              "205110119"
            ]
          },
          "205110119": {
            "id": "205110119",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "I know of a place where you can find both Slimes and berries. Please go have a look for me, will you? I hope you find something...",
            "nextDialogs": [
              "205110120"
            ]
          },
          "205110120": {
            "id": "205110120",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "But... i—if you really can't find anything, then for Anna's sake... J—Just catch a Dendro Slime and bring it back here. I can do it. I... I will do it!"
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "2303701",
      "subQuestName": "Talk to Maruf",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230370101"
        ],
        "dialogs": {
          "230370101": {
            "id": "230370101",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "*sigh* This condition is tricky. I'd better get Dr. Zakariya's help.",
            "nextDialogs": [
              "230370102"
            ]
          },
          "230370102": {
            "id": "230370102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is someone gravely ill?",
            "nextDialogs": [
              "230370103"
            ]
          },
          "230370103": {
            "id": "230370103",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "Eh? Ah, Traveler! Nobody's gravely ill. It's just that a patient's got a severe case of headache.",
            "nextDialogs": [
              "230370104"
            ]
          },
          "230370104": {
            "id": "230370104",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "I gave him some medicine, but it didn't really work that well.",
            "nextDialogs": [
              "230370105"
            ]
          },
          "230370105": {
            "id": "230370105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you tried prescribing other medicine?",
            "nextDialogs": [
              "230370106"
            ]
          },
          "230370106": {
            "id": "230370106",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "Ahem... That would've been far beyond me. You see, with my limited experience, I can only come up with this many prescriptions...",
            "nextDialogs": [
              "230370107"
            ]
          },
          "230370107": {
            "id": "230370107",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "They can treat mild conditions alright, but when it comes to serious ones, they're next to useless.",
            "nextDialogs": [
              "230370108"
            ]
          },
          "230370108": {
            "id": "230370108",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "Luckily, Dr. Zakariya at Bimarstan has offered to prescribe medicine and get the ingredients ready for me...",
            "nextDialogs": [
              "230370109"
            ]
          },
          "230370109": {
            "id": "230370109",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "Traveler, can I ask you a favor?",
            "nextDialogs": [
              "230370110"
            ]
          },
          "230370110": {
            "id": "230370110",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "I've got some patients to attend to, so could you visit Dr. Zakariya in my stead and ask him to prescribe something?",
            "nextDialogs": [
              "230370112",
              "230370114"
            ]
          },
          "230370112": {
            "id": "230370112",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "I'm counting on you, Traveler."
          },
          "230370114": {
            "id": "230370114",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "He occasionally has people send herbs and stuff over, but he's too busy to show up in person, really.",
            "nextDialogs": [
              "230370115"
            ]
          },
          "230370115": {
            "id": "230370115",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "Anyway, about that prescription — I'm counting on you, Traveler."
          }
        }
      }
    },
    {
      "subId": "2303702",
      "subQuestName": "Talk to Zakariya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230370501"
        ],
        "dialogs": {
          "230370501": {
            "id": "230370501",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "Why am I having more and more patients lately...",
            "nextDialogs": [
              "230370502"
            ]
          },
          "230370502": {
            "id": "230370502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Maruf...",
            "nextDialogs": [
              "230370503"
            ]
          },
          "230370503": {
            "id": "230370503",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "Maruf? Did he run into some little-understood illness again?",
            "nextDialogs": [
              "230370504"
            ]
          },
          "230370504": {
            "id": "230370504",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You describe the condition Maruf is treating...",
            "nextDialogs": [
              "230370505"
            ]
          },
          "230370505": {
            "id": "230370505",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "*sigh* How many times have I told him? He's fully capable of handling something this simple on his own — without needing my help!",
            "nextDialogs": [
              "230370506"
            ]
          },
          "230370506": {
            "id": "230370506",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "I bet the patients are exaggerating their discomfort again, thinking that a mere village doctor is unable to treat their \"serious illness.\"",
            "nextDialogs": [
              "230370507"
            ]
          },
          "230370507": {
            "id": "230370507",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "That's why Maruf wants my prescription to reassure them.",
            "nextDialogs": [
              "230370508"
            ]
          },
          "230370508": {
            "id": "230370508",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "Looking after the villagers for so many years has definitely not been an easy task for Maruf... I'll write up a prescription right away. Please take note, Traveler.",
            "nextDialogs": [
              "230370509"
            ]
          },
          "230370509": {
            "id": "230370509",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "Um, I remember Maruf is treating a patient with...",
            "nextDialogs": [
              "230370510"
            ]
          },
          "230370510": {
            "id": "230370510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A headache.",
            "nextDialogs": [
              "230370511"
            ]
          },
          "230370511": {
            "id": "230370511",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "Ah, I see. To treat headaches, the prescription that I gave him last time will do.",
            "nextDialogs": [
              "230370512"
            ]
          },
          "230370512": {
            "id": "230370512",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "Brew up a herbal soup out of the ingredients listed in the prescription and add three portions of <color=#00E1FFFF>Mint</color>.",
            "nextDialogs": [
              "230370513"
            ]
          },
          "230370513": {
            "id": "230370513",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "After that, keep boiling the soup on a <color=#00E1FFFF>high flame</color> for around... Forget it... Boil it until <color=#00E1FFFF>the ingredients float</color>.",
            "nextDialogs": [
              "230370514"
            ]
          },
          "230370514": {
            "id": "230370514",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "Um... Just in case you forget, I'll write it down.",
            "nextDialogs": [
              "230370520"
            ]
          },
          "230370520": {
            "id": "230370520",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Zakariya writes down the prescription...",
            "nextDialogs": [
              "230370515"
            ]
          },
          "230370515": {
            "id": "230370515",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "Please deliver the prescription to Maruf.",
            "nextDialogs": [
              "230370516"
            ]
          },
          "230370516": {
            "id": "230370516",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "To be honest, I wouldn't say what I prescribed is \"medicine.\" Instead, it's more of a... How should I put it...",
            "nextDialogs": [
              "230370517"
            ]
          },
          "230370517": {
            "id": "230370517",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "Well, it's more of a mild, nutritious supplement.",
            "nextDialogs": [
              "230370518"
            ]
          },
          "230370518": {
            "id": "230370518",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "One can be as creative as they want with the prescription. The worst thing they might end up with is a useless soup, that's all.",
            "nextDialogs": [
              "230370519"
            ]
          },
          "230370519": {
            "id": "230370519",
            "speakerId": 1001,
            "speakerName": "Zakariya",
            "text": "*sigh* Actually, all Maruf had to do was to adjust his original prescription very slightly. Why couldn't he put more trust in himself?"
          }
        }
      }
    },

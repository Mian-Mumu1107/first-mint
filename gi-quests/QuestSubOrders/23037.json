    {
      "subId": "2303706",
      "subQuestName": "Talk to Maruf",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230370801"
        ],
        "dialogs": {
          "230370801": {
            "id": "230370801",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "Ah, Traveler, you're back! What did Zakariya say?",
            "nextDialogs": [
              "230370802"
            ]
          },
          "230370802": {
            "id": "230370802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Zakariya's prescription...",
            "nextDialogs": [
              "230370803"
            ]
          },
          "230370803": {
            "id": "230370803",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "It says to use the soup he prescribed last time as the base? I see... Let me check the instructions more carefully.",
            "nextDialogs": [
              "230370804"
            ]
          },
          "230370804": {
            "id": "230370804",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "Eh? His writing is, um, unsurprisingly still so hard to understand.",
            "nextDialogs": [
              "230370805"
            ]
          },
          "230370805": {
            "id": "230370805",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "Traveler, he told you how to brew it and what ingredients are needed, right?",
            "nextDialogs": [
              "230370806"
            ]
          },
          "230370806": {
            "id": "230370806",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "Could you watch my steps? Let me know if I make any mistakes.",
            "nextDialogs": [
              "230370807"
            ]
          },
          "230370807": {
            "id": "230370807",

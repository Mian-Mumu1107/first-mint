    {
      "subId": "2303702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230370201"
        ],
        "dialogs": {
          "230370201": {
            "id": "230370201",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "*sigh* This condition is tricky. I'd better get Dr. Zakariya's help.",
            "nextDialogs": [
              "230370202"
            ]
          },
          "230370202": {
            "id": "230370202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is someone gravely ill?",
            "nextDialogs": [
              "230370203"
            ]
          },
          "230370203": {
            "id": "230370203",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "Eh? Ah, Traveler! Nobody's gravely ill. It's just that a patient's got a severe case of stomachache.",
            "nextDialogs": [
              "230370204"
            ]
          },
          "230370204": {
            "id": "230370204",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "I gave him some medicine, but it didn't really work that well.",
            "nextDialogs": [
              "230370205"
            ]
          },
          "230370205": {
            "id": "230370205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you tried prescribing other medicine?",
            "nextDialogs": [
              "230370206"
            ]
          },
          "230370206": {
            "id": "230370206",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "Ahem... That would've been far beyond me. You see, with my limited experience, I can only come up with this many prescriptions...",
            "nextDialogs": [
              "230370207"
            ]
          },
          "230370207": {
            "id": "230370207",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "They can treat mild conditions alright, but when it comes to serious ones, they're next to useless.",
            "nextDialogs": [
              "230370208"
            ]
          },
          "230370208": {
            "id": "230370208",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "Luckily, Dr. Zakariya at Bimarstan has offered to prescribe medicine and get the ingredients ready for me...",
            "nextDialogs": [
              "230370209"
            ]
          },
          "230370209": {
            "id": "230370209",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "Traveler, can I ask you a favor?",
            "nextDialogs": [
              "230370210"
            ]
          },
          "230370210": {
            "id": "230370210",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "I've got some patients to attend to, so could you visit Dr. Zakariya in my stead and ask him to prescribe something?",
            "nextDialogs": [
              "230370212",
              "230370214"
            ]
          },
          "230370212": {
            "id": "230370212",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "I'm counting on you, Traveler."
          },
          "230370214": {
            "id": "230370214",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "He occasionally has people send herbs and stuff over, but he's too busy to show up in person, really.",
            "nextDialogs": [
              "230370215"
            ]
          },
          "230370215": {
            "id": "230370215",
            "speakerId": 1000,
            "speakerName": "Maruf",
            "text": "Anyway, about that prescription — I'm counting on you, Traveler."
          }
        }
      }
    },

            "id": "735010305",
            "speakerId": 1001,
            "speakerName": "Tanger",
            "text": "That depends on the Aranara son. It would be interesting to hear them speak at different paces.",
            "nextDialogs": [
              "735010306"
            ]
          },
          "735010306": {
            "id": "735010306",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hey, Tanger and Razi, what's up!",
            "nextDialogs": [
              "735010307"
            ]
          },
          "735010307": {
            "id": "735010307",
            "speakerId": 1000,
            "speakerName": "Razi",

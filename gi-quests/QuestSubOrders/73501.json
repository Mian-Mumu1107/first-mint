        ],
        "dialogs": {
          "735010301": {
            "id": "735010301",
            "speakerId": 1000,
            "speakerName": "Razi",
            "text": "The Aranara father owned up to his mistake and was forgiven by his Aranara son...",
            "nextDialogs": [
              "735010302"
            ]
          },
          "735010302": {
            "id": "735010302",
            "speakerId": 1000,
            "speakerName": "Razi",
            "text": "Hmm... I think everyone will like how the story goes, but the conflict was resolved a little too quickly.",
            "nextDialogs": [
              "735010303"
            ]
          },
          "735010303": {
            "id": "735010303",
            "speakerId": 1001,
            "speakerName": "Tanger",
            "text": "Perhaps we could let them go through some kind of hardship together. I'm sure they'll become more understanding of each other. We can make the Aranara father feel remorseful after seeing his son's efforts.",
            "nextDialogs": [
              "735010304"
            ]
          },
          "735010304": {
            "id": "735010304",
            "speakerId": 1000,
            "speakerName": "Razi",
            "text": "When the Aranara father starts feeling remorseful, should he speak more slowly, or quickly?",
            "nextDialogs": [
              "735010305"

  "subQuests": [
    {
      "subId": "7350101",
      "subQuestName": "Talk to the artisans and Razi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735010201"
        ],
        "dialogs": {
          "735010201": {
            "id": "735010201",
            "speakerId": 1000,
            "speakerName": "Razi",
            "text": "The Aranara father owned up to his mistake and was forgiven by his Aranara son...",
            "nextDialogs": [
              "735010202"
            ]
          },
          "735010202": {
            "id": "735010202",
            "speakerId": 1000,
            "speakerName": "Razi",
            "text": "Hmm... I think everyone will like how the story goes, but the reason the father owned up to his mistake was too simple.",
            "nextDialogs": [
              "735010203"
            ]
          },
          "735010203": {
            "id": "735010203",
            "speakerId": 1001,
            "speakerName": "Tanger",
            "text": "Perhaps we could make them go through some kind of hardship together. I'm sure they'll become more understanding of each other that way. The Aranara father will feel guilty after seeing his son work hard.",
            "nextDialogs": [
              "735010204"
            ]
          },
          "735010204": {
            "id": "735010204",
            "speakerId": 1000,
            "speakerName": "Razi",
            "text": "Hmm, when the Aranara father starts feeling guilty, should he speak more slowly, or more quickly?",
            "nextDialogs": [
              "735010205"
            ]
          },
          "735010205": {
            "id": "735010205",
            "speakerId": 1001,
            "speakerName": "Tanger",
            "text": "That depends on the Aranara son. It would be interesting to hear them speak at different paces.",
            "nextDialogs": [
              "735010206"
            ]
          },
          "735010206": {
            "id": "735010206",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hey, Tanger and Razi, whatcha up to?",
            "nextDialogs": [
              "735010207"
            ]
          },
          "735010207": {
            "id": "735010207",
            "speakerId": 1000,
            "speakerName": "Razi",
            "text": "Dad and I are just discussing our latest story. I'll be the one telling the story this time.",
            "nextDialogs": [
              "735010208"
            ]
          },
          "735010208": {
            "id": "735010208",
            "speakerId": 1000,
            "speakerName": "Razi",
            "text": "But I'm a little nervous about telling a story in front of so many people. That's why I'm asking Dad for advice.",
            "nextDialogs": [
              "735010209"
            ]
          },
          "735010209": {
            "id": "735010209",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ooh! Sumeru's gonna have a new young storyteller.",
            "nextDialogs": [
              "735010210"
            ]
          },
          "735010210": {
            "id": "735010210",
            "speakerId": 1001,
            "speakerName": "Tanger",
            "text": "If it weren't for you, Razi would surely have left me for good.",
            "nextDialogs": [
              "735010211"
            ]
          },
          "735010211": {
            "id": "735010211",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon's so glad everything worked out!",
            "nextDialogs": [
              "735010212"
            ]
          },
          "735010212": {
            "id": "735010212",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But... there's still something that doesn't quite add up!",
            "nextDialogs": [
              "735010213"
            ]
          },
          "735010213": {
            "id": "735010213",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "Oh? What is it? Do you need help investigating something?",
            "nextDialogs": [
              "735010214"
            ]
          },
          "735010214": {
            "id": "735010214",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Why would a Mondstadter leave a note in a tree hollow deep in the Avidya Forest?",
            "nextDialogs": [
              "735010215"
            ]
          },
          "735010215": {
            "id": "735010215",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "I—I thought we moved on from this topic! Um... it was just a coincidence!",
            "nextDialogs": [
              "735010216"
            ]
          },
          "735010216": {
            "id": "735010216",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "A lot of people write down their secrets and hide them in tree hollows! It's not a big deal at all...",
            "nextDialogs": [
              "735010219"
            ]
          },
          "735010219": {
            "id": "735010219",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "Ugh... Uhhh... Okay...",
            "nextDialogs": [
              "735010220"
            ]
          },
          "735010220": {
            "id": "735010220",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "I have my secrets and troubles too. And... I tell them to tree hollows.",
            "nextDialogs": [
              "735010221"
            ]
          },
          "735010221": {
            "id": "735010221",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "But seeing Razi and Tanger has given me an idea:",
            "nextDialogs": [
              "735010222"
            ]
          },
          "735010222": {
            "id": "735010222",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "#{NICKNAME}, could you be my tree hollow?"
          }
        }
      }
    },
    {
      "subId": "7350101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735010101"
        ],
        "dialogs": {
          "735010101": {
            "id": "735010101",
            "speakerId": 1004,
            "speakerName": "Qasit",
            "text": "Aww... I got the same one again. When will I get the chubby, squishy one...",
            "nextDialogs": [
              "735010102"
            ]
          },
          "735010102": {
            "id": "735010102",
            "speakerId": 1004,
            "speakerName": "Qasit",
            "text": "I guess I'll just have to save up my allowance and get them all.",
            "nextDialogs": [
              "735010103"
            ]
          },
          "735010103": {
            "id": "735010103",
            "speakerId": 1005,
            "speakerName": "Alia",
            "text": "Huh...? I thought you came here every day! Have you still not collected them all yet?",
            "nextDialogs": [
              "735010104"
            ]
          },
          "735010104": {
            "id": "735010104",
            "speakerId": 1005,
            "speakerName": "Alia",
            "text": "You should've gotten them as a set. That way, you get seven different designs at once.",
            "nextDialogs": [
              "735010105"
            ]
          },
          "735010105": {
            "id": "735010105",
            "speakerId": 1004,
            "speakerName": "Qasit",
            "text": "But then there's no surprise...",
            "nextDialogs": [
              "735010106"
            ]
          },
          "735010106": {
            "id": "735010106",
            "speakerId": 1005,
            "speakerName": "Alia",
            "text": "Surprises are boring! I want to have every design there is! That's what you do when you really love something.",
            "nextDialogs": [
              "735010107"
            ]
          },
          "735010107": {
            "id": "735010107",
            "speakerId": 1005,
            "speakerName": "Alia",
            "text": "I've finally saved up enough to buy the set today.",
            "nextDialogs": [
              "735010108"
            ]
          },
          "735010108": {
            "id": "735010108",
            "speakerId": 1006,
            "speakerName": "Mamdouh",
            "text": "I'm very sorry, but the one Qasit bought was our very last carving. We're out of stock today.",
            "nextDialogs": [
              "735010128"
            ]
          },
          "735010128": {
            "id": "735010128",
            "speakerId": 1006,
            "speakerName": "Mamdouh",
            "text": "But, we're working on expanding our team, so please check back tomorrow!",
            "nextDialogs": [
              "735010109"
            ]
          },
          "735010109": {
            "id": "735010109",
            "speakerId": 1005,
            "speakerName": "Alia",
            "text": "Fine, I'll come back tomorrow. Hmph, just so you know, Aranara carvings are more than just \"stock\"!",
            "nextDialogs": [
              "735010110"
            ]
          },
          "735010110": {
            "id": "735010110",
            "speakerId": 1004,
            "speakerName": "Qasit",
            "text": "Yeah!",
            "nextDialogs": [
              "735010111"
            ]
          },
          "735010111": {
            "id": "735010111",
            "speakerId": 1006,
            "speakerName": "Mamdouh",
            "text": "Alright, alright, I'm sorry...",
            "nextDialogs": [
              "735010112"
            ]
          },
          "735010112": {
            "id": "735010112",
            "speakerId": 1007,
            "speakerName": "Fayez",
            "text": "Sorry buddy, our Aranara carvings have sold out for today.",
            "nextDialogs": [
              "735010113"
            ]
          },
          "735010113": {
            "id": "735010113",
            "speakerId": 1008,
            "speakerName": "Ruhi",
            "text": "Sold out? Oh no... I was gonna buy one for my cousin who's visiting tomorrow.",
            "nextDialogs": [
              "735010114"
            ]
          },
          "735010114": {
            "id": "735010114",
            "speakerId": 1007,
            "speakerName": "Fayez",
            "text": "Hey, how about this? You live near Razi's house, right? We'll deliver the new carvings to you first thing tomorrow.",
            "nextDialogs": [
              "735010115"
            ]
          },
          "735010115": {
            "id": "735010115",
            "speakerId": 1008,
            "speakerName": "Ruhi",
            "text": "Wow, thanks, Mr. Fayez! Don't forget, okay!",
            "nextDialogs": [
              "735010116"
            ]
          },
          "735010116": {
            "id": "735010116",
            "speakerId": 1007,
            "speakerName": "Fayez",
            "text": "I promise. Acara Crafts would never let down a child!",
            "nextDialogs": [
              "735010117"
            ]
          },
          "735010117": {
            "id": "735010117",
            "speakerId": 1007,
            "speakerName": "Fayez",
            "text": "Ah, more customers. Sorry, our Aranara carvings have...",
            "nextDialogs": [
              "735010118"
            ]
          },
          "735010118": {
            "id": "735010118",
            "speakerId": 1007,
            "speakerName": "Fayez",
            "text": "Oh hey, it's you guys. Thank you so much for your help. We've been planning on visiting you to express our gratitude, but as you can see... our store's been really busy.",
            "nextDialogs": [
              "735010119"
            ]
          },
          "735010119": {
            "id": "735010119",
            "speakerId": 1007,
            "speakerName": "Fayez",
            "text": "If it weren't for you, the store's anniversary might have been a different story.",
            "nextDialogs": [
              "735010122"
            ]
          },
          "735010122": {
            "id": "735010122",
            "speakerId": 1007,
            "speakerName": "Fayez",
            "text": "It's all thanks to Razi. He has so much creativity at such a young age.",
            "nextDialogs": [
              "735010123"
            ]
          },
          "735010123": {
            "id": "735010123",
            "speakerId": 1007,
            "speakerName": "Fayez",
            "text": "Oh, and we would like you to have the Prototype Aranara as a small token of appreciation.",
            "nextDialogs": [
              "735010124"
            ]
          },
          "735010124": {
            "id": "735010124",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "Woah, wait... This looks kinda...",
            "nextDialogs": [
              "735010125"
            ]
          },
          "735010125": {
            "id": "735010125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Mind-blowing.",
            "nextDialogs": [
              "735010126"
            ]
          },
          "735010126": {
            "id": "735010126",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "Right, mind-blowing. It has a very... mysterious feel.",
            "nextDialogs": [
              "735010127"
            ]
          },
          "735010127": {
            "id": "735010127",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Umm... We appreciate your thought, but please give us some time to decide if we wanna keep it."
          },
          "735010129": {
            "id": "735010129",
            "speakerId": 1009,
            "speakerName": "Black Screen",
            "text": "Now that the toymakers' problems are resolved, let's visit Tanger and Razi!"
          }
        }
      }
    },
    {

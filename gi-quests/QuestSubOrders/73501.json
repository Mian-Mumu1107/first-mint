            "nextDialogs": [
              "735010308"
            ]
          },
          "735010308": {
            "id": "735010308",
            "speakerId": 1000,
            "speakerName": "Razi",
            "text": "But I'm a little nervous about telling a story in front of so many people. That's why I'm asking Dad for advice.",
            "nextDialogs": [

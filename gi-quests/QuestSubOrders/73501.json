            "id": "735010310",
            "speakerId": 1001,
            "speakerName": "Tanger",
            "text": "If it weren't for you, Razi would surely have left me for good.",
            "nextDialogs": [
              "735010311"
            ]
          },
          "735010311": {
            "id": "735010311",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon's so glad everything worked out!",
            "nextDialogs": [
              "735010312"
            ]
          },
          "735010312": {
            "id": "735010312",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But... there's still something that doesn't quite add up!",
            "nextDialogs": [
              "735010313"
            ]
          },
          "735010313": {
            "id": "735010313",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "Oh? What is it? Do you need help investigating something?",
            "nextDialogs": [
              "735010314"
            ]
          },
          "735010314": {
            "id": "735010314",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Why would a Mondstadter leave a note in a tree hollow back in Avidya Forest?",
            "nextDialogs": [
              "735010315"
            ]
          },
          "735010315": {
            "id": "735010315",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "I-I thought we moved on from this topic! Um... it was just a coincidence!",
            "nextDialogs": [
              "735010316"
            ]
          },
          "735010316": {
            "id": "735010316",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "A lot of people write down their secrets and hide them in tree hollows! It's not a big deal at all...",
            "nextDialogs": [
              "735010319"
            ]
          },
          "735010319": {
            "id": "735010319",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "Ugh... Uhhh... Okay...",
            "nextDialogs": [
              "735010320"
            ]
          },
          "735010320": {
            "id": "735010320",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "I might have an idea about who that Mondstadter is.",
            "nextDialogs": [
              "735010321"
            ]
          },
          "735010321": {
            "id": "735010321",
            "speakerId": 1003,
            "speakerName": "Collei",
            "text": "I'll tell you more about it when we get the chance."
          }
        }
      }
    },
    {
      "subId": "7350199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735019901"
        ],
        "dialogs": {
          "735019901": {
            "id": "735019901",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "The 20th aniversary of Acara Crafts is coming up. Paimon wonders what the children thought of the Aranara carvings we helped create! Let's go check it out.",
            "nextDialogs": [
              "735019902"
            ]
          },
          "735019902": {
            "id": "735019902",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Now that the toymakers' problems are resolved, let's go see how Tanger and Razi are doing!"
          }
        }
      }

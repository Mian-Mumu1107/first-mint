  "subQuests": [
    {
      "subId": "7218501",
      "subQuestName": "Talk to Kiminami Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721850101"
        ],
        "dialogs": {
          "721850101": {
            "id": "721850101",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "*sigh* What am I to do...",
            "nextDialogs": [
              "721850102"
            ]
          },
          "721850102": {
            "id": "721850102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "721850103"
            ]
          },
          "721850103": {
            "id": "721850103",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Traveler? Great, you have perfect timing!",
            "nextDialogs": [
              "721850104"
            ]
          },
          "721850104": {
            "id": "721850104",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Do you remember the recipe you wrote for me the last time, when you and Ms. Kamisato came to my store?",
            "nextDialogs": [
              "721850105"
            ]
          },
          "721850105": {
            "id": "721850105",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Oh, that pizza was so popular that many customers came to the store to order it specially.",
            "nextDialogs": [
              "721850106"
            ]
          },
          "721850106": {
            "id": "721850106",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "But... some customers also said that they were bored of eating this pizza all the time and asked if I have other pizza flavors.",
            "nextDialogs": [
              "721850107"
            ]
          },
          "721850107": {
            "id": "721850107",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Although I have tried several methods to make new types of pizza based on feedback from customers...",
            "nextDialogs": [
              "721850108"
            ]
          },
          "721850108": {
            "id": "721850108",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "But I always feel... that something is lacking, and the response from customers is not very good.",
            "nextDialogs": [
              "721850109"
            ]
          },
          "721850109": {
            "id": "721850109",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "*sigh* Maybe I'm really not good at making pizza...",
            "nextDialogs": [
              "721850110"
            ]
          },
          "721850110": {
            "id": "721850110",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Traveler, you know a lot about this dish, right? Can you give me some advice?",
            "nextDialogs": [
              "721850112",
              "721850114"
            ]
          },
          "721850112": {
            "id": "721850112",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Great! By the way, I've also collected feedback from customers. Give me a moment, I'll look for it.",
            "nextDialogs": [
              "721850116"
            ]
          },
          "721850116": {
            "id": "721850116",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Miss Matsumoto said that although the pizza in my shop incorporates a lot of ingredients from Inazuma, she heard that Mondstadt pizza is not made like this.",
            "nextDialogs": [
              "721850117"
            ]
          },
          "721850117": {
            "id": "721850117",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "She said that for such outland delicacies, it's better to retain it's authentic flavor...",
            "nextDialogs": [
              "721850118"
            ]
          },
          "721850118": {
            "id": "721850118",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "*sigh* But how am I going to know how to make Mondstadt's pizza? Traveler, please help me ask her."
          },
          "721850114": {
            "id": "721850114",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Do you want to take a look at the customer feedback?",
            "nextDialogs": [
              "721850115"
            ]
          },
          "721850115": {
            "id": "721850115",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Give me a moment, I'll look for it."
          }
        }
      }
    },
    {
      "subId": "7218502",
      "subQuestName": "Talk to Matsumoto",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721850201"
        ],
        "dialogs": {
          "721850201": {
            "id": "721850201",
            "speakerId": 1001,
            "speakerName": "Matsumoto",
            "text": "*sigh* Is there anything in the world that will satisfy my taste buds?",
            "nextDialogs": [
              "721850202"
            ]
          },
          "721850202": {
            "id": "721850202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Kiminami Restaurant's pizza...",
            "nextDialogs": [
              "721850203"
            ]
          },
          "721850203": {
            "id": "721850203",
            "speakerId": 1001,
            "speakerName": "Matsumoto",
            "text": "Oh, the pizza you mentioned tastes really good, and it also has a lot of local ingredients.",
            "nextDialogs": [
              "721850204"
            ]
          },
          "721850204": {
            "id": "721850204",
            "speakerId": 1001,
            "speakerName": "Matsumoto",
            "text": "However, I have tried the authentic Mushroom Pizza before.",
            "nextDialogs": [
              "721850205"
            ]
          },
          "721850205": {
            "id": "721850205",
            "speakerId": 1001,
            "speakerName": "Matsumoto",
            "text": "I remember that the pizza was made of Cheese, Cabbage, and Mushrooms...",
            "nextDialogs": [
              "721850206"
            ]
          },
          "721850206": {
            "id": "721850206",
            "speakerId": 1001,
            "speakerName": "Matsumoto",
            "text": "Hahaha, I just feel that for such outland delicacies, it's better to retain it's authentic flavor."
          }
        }
      }
    },
    {
      "subId": "7218503",
      "subQuestName": "Talk to Kiminami Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721850301"
        ],
        "dialogs": {
          "721850301": {
            "id": "721850301",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Traveler, you've returned.",
            "nextDialogs": [
              "721850302"
            ]
          },
          "721850302": {
            "id": "721850302",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "How did it go, any feedback?",
            "nextDialogs": [
              "721850303"
            ]
          },
          "721850303": {
            "id": "721850303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the customers' feedback...",
            "nextDialogs": [
              "721850304"
            ]
          },
          "721850304": {
            "id": "721850304",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "The original Mushroom Pizza... Hmm, it's worth a try.",
            "nextDialogs": [
              "721850305"
            ]
          },
          "721850305": {
            "id": "721850305",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "The ingredients to prepare are Cheese, Cabbage, and Mushrooms...",
            "nextDialogs": [
              "721850306"
            ]
          },
          "721850306": {
            "id": "721850306",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "We have the other ingredients, but we usually don't stock up on Cheese...",
            "nextDialogs": [
              "721850307"
            ]
          },
          "721850307": {
            "id": "721850307",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Traveler, could I trouble you to get a block of Cheese?",
            "nextDialogs": [
              "721850309",
              "721850311"
            ]
          },
          "721850309": {
            "id": "721850309",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "I'm counting on you, then. Just a block of Cheese will do."
          },
          "721850311": {
            "id": "721850311",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "It's not that we don't use it at all, we just use it very rarely.",
            "nextDialogs": [
              "721850312"
            ]
          },
          "721850312": {
            "id": "721850312",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "After all, there are not many dishes in the store that require Cheese, so we don't really stock much of it...",
            "nextDialogs": [
              "721850313"
            ]
          },
          "721850313": {
            "id": "721850313",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Anyway, I'm counting on you, Traveler. Please help to bring me a block of Cheese."
          }
        }
      }
    },
    {
      "subId": "7218504",
      "subQuestName": "Bring the Cheese back to Kiminami Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721850401"
        ],
        "dialogs": {
          "721850401": {
            "id": "721850401",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Have you brought the ingredients back with you?"
          }
        }
      }
    },
    {
      "subId": "7218505",
      "subQuestName": "Talk to Kiminami Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721850501"
        ],
        "dialogs": {
          "721850501": {
            "id": "721850501",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Thank you, these ingredients will do.",
            "nextDialogs": [
              "721850502"
            ]
          },
          "721850502": {
            "id": "721850502",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "The original Mushroom Pizza from Mondstadt, I don't know if I can make it successfully...",
            "nextDialogs": [
              "721850503"
            ]
          },
          "721850503": {
            "id": "721850503",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "It's done!",
            "nextDialogs": [
              "721850504"
            ]
          },
          "721850504": {
            "id": "721850504",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "This pizza looks... pretty good...",
            "nextDialogs": [
              "721850505"
            ]
          },
          "721850505": {
            "id": "721850505",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "Thanks for your help, Traveler. Here, these are for you.",
            "nextDialogs": [
              "721850506"
            ]
          },
          "721850506": {
            "id": "721850506",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "I'll make sure to savor this pizza's taste...",
            "nextDialogs": [
              "721850507"
            ]
          },
          "721850507": {
            "id": "721850507",
            "speakerId": 1000,
            "speakerName": "Kiminami Anna",
            "text": "If it's not bad...it should be officially launched as a new dish soon."
          }
        }
      }
    },
    {
      "subId": "7218506",

    {
      "subId": "2302805",
      "subQuestName": "Spray the potions with Yasmin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230280501"
        ],
        "dialogs": {
          "230280501": {
            "id": "230280501",
            "speakerId": 1001,
            "speakerName": "Panicked Students",
            "text": "Yasmin! Wah!",
            "nextDialogs": [
              "230280502"
            ]
          },
          "230280502": {
            "id": "230280502",
            "speakerId": 1001,
            "speakerName": "Panicked Students",
            "text": "I—I can't breathe! I've gotta get out of here!",
            "nextDialogs": [
              "230280503"
            ]
          },
          "230280503": {
            "id": "230280503",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "What is this... *cough* *cough*! This smell...",
            "nextDialogs": [
              "230280504"
            ]
          },
          "230280504": {
            "id": "230280504",
            "speakerId": 1000,
            "speakerName": "Yasmin",
            "text": "Well, it seems that Ladep has done well.",
            "nextDialogs": [
              "230280505"
            ]
          },
          "230280505": {
            "id": "230280505",
            "speakerId": 1000,
            "speakerName": "Yasmin",
            "text": "We're done with the sprinkling here. Let's move to the next spot. It's not far away."
          }
        }
      }
    },

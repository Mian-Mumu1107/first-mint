  "subQuests": [
    {
      "subId": "2302801",
      "subQuestName": "Talk to Yasmin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230280101"
        ],
        "dialogs": {
          "230280101": {
            "id": "230280101",
            "speakerId": 1000,
            "speakerName": "Yasmin",
            "text": "Traveler! Thank goodness you're here. I was just in need of someone's help!",
            "nextDialogs": [
              "230280102"
            ]
          },
          "230280102": {
            "id": "230280102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is there anything wrong with the Divine Tree's roots?",
            "nextDialogs": [
              "230280103"
            ]
          },
          "230280103": {
            "id": "230280103",
            "speakerId": 1000,
            "speakerName": "Yasmin",
            "text": "Oh, the Divine Tree is perfectly fine.",
            "nextDialogs": [
              "230280104"
            ]
          },
          "230280104": {
            "id": "230280104",
            "speakerId": 1000,
            "speakerName": "Yasmin",
            "text": "And my job here is to keep it that way.",
            "nextDialogs": [
              "230280105"
            ]
          },
          "230280105": {
            "id": "230280105",
            "speakerId": 1000,
            "speakerName": "Yasmin",
            "text": "To be specific, I am sprinkling these potions around the tree's roots.",
            "nextDialogs": [
              "230280106"
            ]
          },
          "230280106": {
            "id": "230280106",
            "speakerId": 1000,
            "speakerName": "Yasmin",
            "text": "Unfortunately, I can't move all these potions on my own, while Ladep and Pharez are busily engaged in their own work.",
            "nextDialogs": [
              "230280107"
            ]
          },
          "230280107": {
            "id": "230280107",
            "speakerId": 1000,
            "speakerName": "Yasmin",
            "text": "As such, I could really use your help in moving these potions.",
            "nextDialogs": [
              "230280109"
            ]
          },
          "230280109": {
            "id": "230280109",
            "speakerId": 1000,
            "speakerName": "Yasmin",
            "text": "Oh, they are students, just like me. But Ladep is from Spantamad, and Pharez is from Kshahrewar.",
            "nextDialogs": [
              "230280110"
            ]
          },
          "230280110": {
            "id": "230280110",
            "speakerId": 1000,
            "speakerName": "Yasmin",
            "text": "We are researching on a shared topic, thus the cooperation despite our different ideologies.",
            "nextDialogs": [
              "230280111"
            ]
          },
          "230280111": {
            "id": "230280111",
            "speakerId": 1000,
            "speakerName": "Yasmin",
            "text": "These potions, for example, are the fruits of our teamwork.",
            "nextDialogs": [
              "230280113"
            ]
          },
          "230280113": {
            "id": "230280113",
            "speakerId": 1000,
            "speakerName": "Yasmin",
            "text": "Okay, I will carry this one, and I'll be counting on you for the rest. Thank you!",
            "nextDialogs": [
              "230280114"
            ]
          },
          "230280114": {
            "id": "230280114",
            "speakerId": 1000,
            "speakerName": "Yasmin",
            "text": "Careful now. Ladep said the potions were intentionally made with a foul odor so that no one would drink them by accident.",
            "nextDialogs": [
              "230280115"
            ]
          },
          "230280115": {
            "id": "230280115",
            "speakerId": 1000,
            "speakerName": "Yasmin",
            "text": "Try not to get any on your clothes... The smell won't wash off easily at all."
          }
        }
      }
    },

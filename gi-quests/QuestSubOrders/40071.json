    {
      "subId": "4007114",
      "subQuestName": "Listen to the voices inside the room",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400711401"
        ],
        "dialogs": {
          "400711401": {
            "id": "400711401",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Huh? We've been transported again, but we're not back on the beach.",
            "nextDialogs": [
              "400711402"
            ]
          },
          "400711402": {
            "id": "400711402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We are somewhere in... Mondstadt.",
            "nextDialogs": [
              "400711403"
            ]
          },
          "400711403": {
            "id": "400711403",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Greetings, Honorable Kaiserin der Verurteilung.",
            "nextDialogs": [
              "400711404"
            ]
          },
          "400711404": {
            "id": "400711404",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Amy, dear, I've made Steak and Fisherman's Toast. Come on, eat up before they go cold.",
            "nextDialogs": [
              "400711405"
            ]
          },
          "400711405": {
            "id": "400711405",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Ahem! Mother...",
            "nextDialogs": [
              "400711406"
            ]
          },
          "400711406": {
            "id": "400711406",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Oh, look at me, being so forgetful. Ahem! Dost thou knowest, Prinzessin der Verurteilung, that the hour of luncheon encroaches?",
            "nextDialogs": [
              "400711407"
            ]
          },
          "400711407": {
            "id": "400711407",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Of course, Mother.",
            "nextDialogs": [
              "400711408"
            ]
          },
          "400711408": {
            "id": "400711408",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Ah, behold the view from the window, a delight to the senses! Prinzessin, Kaiserin, would you care to join the Kaiser der Verurteilung for a grand royal picnic? We shall enjoy the scenic view and partake of the delicacies granted to us by the heavens.",
            "nextDialogs": [
              "400711409"
            ]
          },
          "400711409": {
            "id": "400711409",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Yes, I shall gladly join you!",
            "nextDialogs": [
              "400711410"
            ]
          },
          "400711410": {
            "id": "400711410",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "...",
            "nextDialogs": [
              "400711411"
            ]
          },
          "400711411": {
            "id": "400711411",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "...Oh.",
            "nextDialogs": [
              "400711412"
            ]
          },
          "400711412": {
            "id": "400711412",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Uh... does anyone wanna say anything about that?",
            "nextDialogs": [
              "400711413"
            ]
          },
          "400711413": {
            "id": "400711413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "400711414"
            ]
          },
          "400711414": {
            "id": "400711414",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Okay, I'll bite. So \"Amy\"... that's Fischl's real name?",
            "nextDialogs": [
              "400711415"
            ]
          },
          "400711415": {
            "id": "400711415",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems like it. The other two voices were probably her mom and dad.",
            "nextDialogs": [
              "400711416"
            ]
          },
          "400711416": {
            "id": "400711416",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "...Why are all of you giving me that look!?",
            "nextDialogs": [
              "400711417"
            ]
          },
          "400711417": {
            "id": "400711417",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "Forgive me if this comes across as rude, but... is your surname truly Megistus?",
            "nextDialogs": [
              "400711418"
            ]
          },
          "400711418": {
            "id": "400711418",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Hmph, you think I was bluffing? My full title is and always has been \"Mona Megistus, the Astrologist.\"",
            "nextDialogs": [
              "400711419"
            ]
          },
          "400711419": {
            "id": "400711419",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "...My apologies.",
            "nextDialogs": [
              "400711420"
            ]
          },
          "400711420": {
            "id": "400711420",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Don't you think that's a bit long?",
            "nextDialogs": [
              "400711421"
            ]
          },
          "400711421": {
            "id": "400711421",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Well, it's a special case. Only geniuses get titles like this.",
            "nextDialogs": [
              "400711422"
            ]
          },
          "400711422": {
            "id": "400711422",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, that makes no sense...",
            "nextDialogs": [
              "400711423"
            ]
          },
          "400711423": {
            "id": "400711423",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "What are your thoughts on the scenes we just witnessed?",
            "nextDialogs": [
              "400711424"
            ]
          },
          "400711424": {
            "id": "400711424",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "Well, it seems that \"closing the book\" is one way of affecting change in this mirage.",
            "nextDialogs": [
              "400711425"
            ]
          },
          "400711425": {
            "id": "400711425",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Well, I think it's sweet that Fischl's parents are willing to play along with her.",
            "nextDialogs": [
              "400711426"
            ]
          },
          "400711426": {
            "id": "400711426",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "They probably didn't indulge her forever. Based on the voice, this was surely a memory from her childhood? It's a different story now she's grown up.",
            "nextDialogs": [
              "400711427"
            ]
          },
          "400711427": {
            "id": "400711427",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You know a lot about Fischl, Mona!",
            "nextDialogs": [
              "400711428"
            ]
          },
          "400711428": {
            "id": "400711428",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "After all, we've been friends for quite a while.",
            "nextDialogs": [
              "400711429"
            ]
          },
          "400711429": {
            "id": "400711429",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Speaking of...I wonder where Fischl is now?",
            "nextDialogs": [
              "400711430"
            ]
          },
          "400711430": {
            "id": "400711430",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "That voice mentioned that she was heading out. We may as well go outside, and see if we can find anything."
          }
        }
      }
    },
    {
      "subId": "4007107",
      "subQuestName": "Leave the room",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4007115",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400711501"
        ],
        "dialogs": {
          "400711501": {
            "id": "400711501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, we're back.",
            "nextDialogs": [
              "400711502"
            ]
          },
          "400711502": {
            "id": "400711502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, why are we back? We haven't finished the story yet!",
            "nextDialogs": [
              "400711503"
            ]
          },
          "400711503": {
            "id": "400711503",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "This feels as awful as purchasing a counterfeit astrology tutorial, or realizing you've forgotten your wallet in the middle of dinner...",
            "nextDialogs": [
              "400711504"
            ]
          },
          "400711504": {
            "id": "400711504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "ARGH!",
            "nextDialogs": [
              "400711505"
            ]
          },
          "400711505": {
            "id": "400711505",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Argh! This is torture!",
            "nextDialogs": [
              "400711506"
            ]
          },
          "400711506": {
            "id": "400711506",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "I think they're a little bit upset.",
            "nextDialogs": [
              "400711507"
            ]
          },
          "400711507": {
            "id": "400711507",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "To be honest, I also don't like to read books that end on an unexpected cliffhanger.",
            "nextDialogs": [
              "400711508"
            ]
          },
          "400711508": {
            "id": "400711508",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Haha, no one likes that. Alright, let's enter the mirage again.",
            "nextDialogs": [
              "400711509"
            ]
          },
          "400711509": {
            "id": "400711509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Good idea! Let's go!",
            "nextDialogs": [
              "400711510"
            ]
          },
          "400711510": {
            "id": "400711510",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "...Eh?",
            "nextDialogs": [
              "400711511"
            ]
          },
          "400711511": {
            "id": "400711511",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "We're still here, it's not working",
            "nextDialogs": [
              "400711512"
            ]
          },
          "400711512": {
            "id": "400711512",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "That's odd. We were able to enter earlier, but now, we can't.",
            "nextDialogs": [
              "400711513"
            ]
          },
          "400711513": {
            "id": "400711513",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Why!? Why are we being denied the opportunity to finish the book!? This is pure sadism!",
            "nextDialogs": [
              "400711514"
            ]
          },
          "400711514": {
            "id": "400711514",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "Hmm... Maybe it's because we've already reached the end of this book.",
            "nextDialogs": [
              "400711515"
            ]
          },
          "400711515": {
            "id": "400711515",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "Before leaving the mirage, we saw that the book had been flipped to the final page. I believe \"Hymn of the Holy Land\" is divided into multiple volumes.",
            "nextDialogs": [
              "400711516"
            ]
          },
          "400711516": {
            "id": "400711516",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's like one of those sneaky light novel marketing schemes... \"If you want to know what happens next, please buy the next volume.\" Yuck.",
            "nextDialogs": [
              "400711517"
            ]
          },
          "400711517": {
            "id": "400711517",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Hmph! I have to see the ending.",
            "nextDialogs": [
              "400711518"
            ]
          },
          "400711518": {
            "id": "400711518",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Oh, oh, yes, the ending. Everyone wants to see how the books ends.",
            "nextDialogs": [
              "400711519"
            ]
          },
          "400711519": {
            "id": "400711519",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Huh? Who's there?",
            "nextDialogs": [
              "400711520"
            ]
          },
          "400711520": {
            "id": "400711520",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Oh, oh, heavens above, she saw me. Stand up straight, stand up straight.",
            "nextDialogs": [
              "400711521"
            ]
          },
          "400711521": {
            "id": "400711521",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "You're...",
            "nextDialogs": [
              "400711522"
            ]
          },
          "400711522": {
            "id": "400711522",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I'm \"Ask-Me-For-Directions Arnold\".",
            "nextDialogs": [
              "400711523"
            ]
          },
          "400711523": {
            "id": "400711523",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That name's a little on the nose!",
            "nextDialogs": [
              "400711524"
            ]
          },
          "400711524": {
            "id": "400711524",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "So, Arnold, let me ask you something...",
            "nextDialogs": [
              "400711525"
            ]
          },
          "400711525": {
            "id": "400711525",
            "speakerId": 12629,
            "speakerName": "Arnold",
            "text": "It's \"Ask-Me-For-Directions Arnold\"!",
            "nextDialogs": [
              "400711526"
            ]
          },
          "400711526": {
            "id": "400711526",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "...So, Ask-Me-For-Directions Arnold, let me ask you something!",
            "nextDialogs": [
              "400711527"
            ]
          },
          "400711527": {
            "id": "400711527",
            "speakerId": 12629,
            "speakerName": "Arnold",
            "text": "Yes, Ma'am!",
            "nextDialogs": [
              "400711528"
            ]
          },
          "400711528": {
            "id": "400711528",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Are there other volumes of \"Hymn of the Holy Land\"? Where can I find them?",
            "nextDialogs": [
              "400711529"
            ]
          },
          "400711529": {
            "id": "400711529",
            "speakerId": 12629,
            "speakerName": "Arnold",
            "text": "Oh, oh, you're asking the right person. \"Hymn of the Holy Land\" is the sacred scripture of the Immernachtreich. There are three volumes in total, with the other two stored in two high locations in the castle.",
            "nextDialogs": [
              "400711530"
            ]
          },
          "400711530": {
            "id": "400711530",
            "speakerId": 12629,
            "speakerName": "Arnold",
            "text": "If you wish to find the second volume, you must climb to the very top floor of the tower.",
            "nextDialogs": [
              "400711531"
            ]
          },
          "400711531": {
            "id": "400711531",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Tower? You mean, that tower over there?",
            "nextDialogs": [
              "400711532"
            ]
          },
          "400711532": {
            "id": "400711532",
            "speakerId": 12629,
            "speakerName": "Arnold",
            "text": "That is, indeed, the tower where the sacred scripture is stored. If you look closely to the cave right over there, you'll find a secret passage that will swiftly take you to the tower.",
            "nextDialogs": [
              "400711533"
            ]
          },
          "400711533": {
            "id": "400711533",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Okay, thank you, Arnold.",
            "nextDialogs": [
              "400711534"
            ]
          },
          "400711534": {
            "id": "400711534",
            "speakerId": 12629,
            "speakerName": "Arnold",
            "text": "It's \"Ask-Me-For-Directions Arnold\"!",
            "nextDialogs": [
              "400711535"
            ]
          },
          "400711535": {
            "id": "400711535",
            "speakerId": 12629,
            "speakerName": "Arnold",
            "text": "Do you have any other questions for me, fair maiden? Concerning, perhaps, my relationship status, or monthly income...?",
            "nextDialogs": [
              "400711536"
            ]
          },
          "400711536": {
            "id": "400711536",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "No! Goodbye!",
            "nextDialogs": [
              "400711537"
            ]
          },
          "400711537": {
            "id": "400711537",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Let's ignore that raven and proceed! There's a secret passage in the cave ahead that leads directly to the top of the tower.",
            "nextDialogs": [
              "400711538"
            ]
          },
          "400711538": {
            "id": "400711538",
            "speakerId": 12629,
            "speakerName": "Arnold",
            "text": "Oh, oh, but Ma'am! Are you sure you're not interested in me? I only shared with you the secrets of the Immernachtreich because of your great beauty! Ma'am! Wait...!"
          }
        }
      }
    },
    {
      "subId": "4007199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400719902"
        ],
        "dialogs": {
          "400719902": {
            "id": "400719902",
            "speakerId": 12674,
            "speakerName": "Narrator",
            "text": "\"The people celebrated and worshiped the Prinzessin's authority, and followed her call to migrate to the sacred land that would eventually be known as the Immernachtreich.\"",
            "nextDialogs": [
              "400719903"
            ]
          },
          "400719903": {
            "id": "400719903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It really is the Immernachtreich!",
            "nextDialogs": [
              "400719904"
            ]
          },
          "400719904": {
            "id": "400719904",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Mm, it really looks the part... I'm quite impressed.",
            "nextDialogs": [
              "400719905"
            ]
          },
          "400719905": {
            "id": "400719905",
            "speakerId": 12674,
            "speakerName": "Narrator",
            "text": "\"We established a nation on the Holy Land, revered the Prinzessin as The Absolute One, and introduced poetry, theater, and adventure to the Kingdom, laying the groundwork for the Immernachtreich.\""
          }
        }
      }
    }
  ]
}
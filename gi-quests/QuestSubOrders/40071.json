    {
      "subId": "4007110",
      "subQuestName": "Find the source of the voice",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400711001"
        ],
        "dialogs": {
          "400711001": {
            "id": "400711001",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Someone, please, help me!",
            "nextDialogs": [
              "400711002"
            ]
          },
          "400711002": {
            "id": "400711002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, isn't this a statue?",
            "nextDialogs": [
              "400711003"
            ]
          },
          "400711003": {
            "id": "400711003",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Please don't refer to me like that! My name is Leon, and I am a knight of the Immernachtreich.",
            "nextDialogs": [
              "400711004"
            ]
          },
          "400711004": {
            "id": "400711004",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A knight? But you don't look like one...",
            "nextDialogs": [
              "400711005"
            ]
          },
          "400711005": {
            "id": "400711005",
            "speakerId": 12626,
            "speakerName": "Leon",
            "text": "You can't tell? Anyway, please don't speak ill of Sire Ozvaldo. He personally designed and distributed the armor for Die Nachtraben Ritter.",
            "nextDialogs": [
              "400711006"
            ]
          },
          "400711006": {
            "id": "400711006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Sire Ozvaldo\"?",
            "nextDialogs": [
              "400711007"
            ]
          },
          "400711007": {
            "id": "400711007",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "#{NICKNAME}, you must have heard that one before, surely? Oz's full name, \"Ozvaldo Hrafnavins.\"",
            "nextDialogs": [
              "400711010"
            ]
          },
          "400711010": {
            "id": "400711010",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Oh... So \"Megistus\" was the easy pronunciation...",
            "nextDialogs": [
              "400711011"
            ]
          },
          "400711011": {
            "id": "400711011",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "I agree.",
            "nextDialogs": [
              "400711012"
            ]
          },
          "400711012": {
            "id": "400711012",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Haha, or so it seems...",
            "nextDialogs": [
              "400711013"
            ]
          },
          "400711013": {
            "id": "400711013",
            "speakerId": 12626,
            "speakerName": "Leon",
            "text": "Dear friends, I apologize for interrupting your lovely conversation, but I believe you haven't been informed that the gate ahead has been locked.",
            "nextDialogs": [
              "400711014"
            ]
          },
          "400711014": {
            "id": "400711014",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yup, that's news to us.",
            "nextDialogs": [
              "400711015"
            ]
          },
          "400711015": {
            "id": "400711015",
            "speakerId": 12626,
            "speakerName": "Leon",
            "text": "I'm hoping you'll be kind enough to save me, and in exchange, I'll gladly teach you how to unlock the gate.",
            "nextDialogs": [
              "400711016"
            ]
          },
          "400711016": {
            "id": "400711016",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Well, I guess we'll have to save you then."
          }
        }
      }
    },
    {
      "subId": "4007111",
      "subQuestName": "Help Leon leave the cellar",
      "sceneId": null,
      "locations": [],
      "dialogue": {

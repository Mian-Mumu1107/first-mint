    {
      "subId": "4007112",
      "subQuestName": "Talk to Leon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400711201"
        ],
        "dialogs": {
          "400711201": {
            "id": "400711201",
            "speakerId": 12626,
            "speakerName": "Leon",
            "text": "Valiant heroes... No words can express how grateful I feel right now. Thank you very much.",
            "nextDialogs": [
              "400711202"
            ]
          },
          "400711202": {
            "id": "400711202",
            "speakerId": 12626,
            "speakerName": "Leon",
            "text": "Remember, this is the password that unlocks the gate. \"May my people be freed from the shackles of ancient decrees.\""
          }
        }
      }
    },
    {
      "subId": "4007116",
      "subQuestName": "Repair the path to the tower",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4007113",
      "subQuestName": "Head to the top of the tower",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400711301"
        ],
        "dialogs": {
          "400711301": {
            "id": "400711301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like it's a dead end ahead. There's only a book.",
            "nextDialogs": [
              "400711302"
            ]
          },
          "400711302": {
            "id": "400711302",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "Do you think what we just heard is the story from the book?",
            "nextDialogs": [
              "400711303"
            ]
          },
          "400711303": {
            "id": "400711303",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "So the \"Holy Land\" in the book's title refers to the Immernachtreich. This book sings the praises of the Prinzessin from the perspective of the people in her kingdom.",
            "nextDialogs": [
              "400711304"
            ]
          },
          "400711304": {
            "id": "400711304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I guess this is kind of an autobiography...",
            "nextDialogs": [
              "400711305"
            ]
          },
          "400711305": {
            "id": "400711305",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "We're on the last page of the book, but the story doesn't seem to have ended.",
            "nextDialogs": [
              "400711306"
            ]
          },
          "400711306": {
            "id": "400711306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What happens next? Paimon wants to know what happens next!",
            "nextDialogs": [
              "400711307"
            ]
          },
          "400711307": {
            "id": "400711307",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "I guess we'll have to keep exploring. As for this book... wait, I have an idea... Now that we've finished it, let's close it."
          }
        }
      }
    },
    {
      "subId": "4007118",

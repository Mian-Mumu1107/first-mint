    {
      "subId": "4007102",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400710201"
        ],
        "dialogs": {
          "400710201": {
            "id": "400710201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are you awake?",
            "nextDialogs": [
              "400710202"
            ]
          },
          "400710202": {
            "id": "400710202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ugh... It's morning again...",
            "nextDialogs": [
              "400710203"
            ]
          },
          "400710203": {
            "id": "400710203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's up? Has something happened?",
            "nextDialogs": [
              "400710204"
            ]
          },
          "400710204": {
            "id": "400710204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It might sound hard to believe, but no. Nothing's happened.",
            "nextDialogs": [
              "400710205"
            ]
          },
          "400710205": {
            "id": "400710205",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "You're awake? Then let's bring you up to speed: We've searched everywhere, and found nothing unusual at all.",
            "nextDialogs": [
              "400710206"
            ]
          },
          "400710206": {
            "id": "400710206",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "Based on the previous two mirages, we should have been able to find something that acts as an entrance.",
            "nextDialogs": [
              "400710207"
            ]
          },
          "400710207": {
            "id": "400710207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's weird.",
            "nextDialogs": [
              "400710208"
            ]
          },
          "400710208": {
            "id": "400710208",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Is it possible that the time has not come yet?",
            "nextDialogs": [
              "400710209"
            ]
          },
          "400710209": {
            "id": "400710209",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "You mean, we should wait a little longer?",
            "nextDialogs": [
              "400710210"
            ]
          },
          "400710210": {
            "id": "400710210",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Yes. Plus, Fischl is still nowhere to be found, and I highly suspect that she's even more eager to find the entrance than we are.",
            "nextDialogs": [
              "400710211"
            ]
          },
          "400710211": {
            "id": "400710211",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "So let's wait. Let's give the mirage... no, give Fischl some more time.",
            "nextDialogs": [
              "400710212"
            ]
          },
          "400710212": {
            "id": "400710212",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Everyone agrees with Mona and takes a break. Then, they continue the search in two groups.",
            "nextDialogs": [
              "400710213"
            ]
          },
          "400710213": {
            "id": "400710213",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "After numerous round trips with little success, something finally appears on the beach.",
            "nextDialogs": [
              "400710214"
            ]
          },
          "400710214": {
            "id": "400710214",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's something on the beach!",
            "nextDialogs": [
              "400710215"
            ]
          },
          "400710215": {
            "id": "400710215",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "A book? And next to it is... hmm... a raven statue?",
            "nextDialogs": [
              "400710216"
            ]
          },
          "400710216": {
            "id": "400710216",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This statue looks a lot like Oz...",
            "nextDialogs": [
              "400710217"
            ]
          },
          "400710217": {
            "id": "400710217",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Why did these two items appear together? Did the raven bring the book here?",
            "nextDialogs": [
              "400710218"
            ]
          },
          "400710218": {
            "id": "400710218",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "What's the book about? Is it a diary?",
            "nextDialogs": [
              "400710219"
            ]
          },
          "400710219": {
            "id": "400710219",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Let's see... \"Hymn of the Holy Land\"? I've never heard of a book by that title.",
            "nextDialogs": [
              "400710220"
            ]
          },
          "400710220": {
            "id": "400710220",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "From the cover, it looks like... it was written by Fischl herself?",
            "nextDialogs": [
              "400710221"
            ]
          },
          "400710221": {
            "id": "400710221",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "That would certainly fit her personality. \"Hymn of the Holy Land\"... interesting, I like it.",
            "nextDialogs": [
              "400710222"
            ]
          },
          "400710222": {
            "id": "400710222",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "As a title, it has a sacred ring to it.",
            "nextDialogs": [
              "400710223"
            ]
          },
          "400710223": {
            "id": "400710223",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So what should we do? Should we touch it?",
            "nextDialogs": [
              "400710224"
            ]
          },
          "400710224": {
            "id": "400710224",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "...Fischl's still not back.",
            "nextDialogs": [
              "400710225"
            ]
          },
          "400710225": {
            "id": "400710225",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Never mind, let's head inside first. Once Fischl finds the book, I'm sure she'll be able to catch up with us.",
            "nextDialogs": [
              "400710226"
            ]
          },
          "400710226": {
            "id": "400710226",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon agrees! It's like we're peeping into her diary, so Paimon's sure she'll wanna come in and stop us."
          }
        }
      }
    },
    {
      "subId": "4007103",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400710301"
        ],
        "dialogs": {
          "400710301": {
            "id": "400710301",
            "speakerId": 12674,
            "speakerName": "Narrator",
            "text": "\"Though this truth has long faded from popular memory, scholars have long known that Prinzessin Fischl von Luftschloss Narfidort first descended upon the world during the Time of Chaos, roughly six hundred years before the Era of the Saints.\"",
            "nextDialogs": [
              "400710302"
            ]
          },
          "400710302": {
            "id": "400710302",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "What? A narrator?",
            "nextDialogs": [
              "400710303"
            ]
          },
          "400710303": {
            "id": "400710303",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "We really are inside a book, huh. There's even a narrator telling us the story.",
            "nextDialogs": [
              "400710304"
            ]
          },
          "400710304": {
            "id": "400710304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no, the path has been cut off. We can't go across.",
            "nextDialogs": [
              "400710305"
            ]
          },
          "400710305": {
            "id": "400710305",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "There's a device over there that appears to be waiting for us to approach it.",
            "nextDialogs": [
              "400710306"
            ]
          },
          "400710306": {
            "id": "400710306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is it just Paimon, or does everything in this place seem just a little bit over-deliberate?",
            "nextDialogs": [
              "400710307"
            ]
          },
          "400710307": {
            "id": "400710307",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Well, it is the Holy Land, what did you expect...",
            "nextDialogs": [
              "400710308"
            ]
          },
          "400710308": {
            "id": "400710308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, everything's so blatant... it's clearly begging to be noticed.",
            "nextDialogs": [
              "400710309"
            ]
          },
          "400710309": {
            "id": "400710309",
            "speakerId": 1042,
            "speakerName": "Xinyan",
            "text": "That's our Fischl for ya!"
          }
        }
      }
    },

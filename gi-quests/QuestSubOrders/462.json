    {
      "subId": "46203",
      "subQuestName": "Talk to the informant",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4620301"
        ],
        "dialogs": {
          "4620301": {
            "id": "4620301",
            "speakerId": 1213,
            "speakerName": "Vile",
            "text": "Why is this happening to me? I shouldn't have helped <color=#00E1FFFF>him</color>...",
            "nextDialogs": [
              "4620302"
            ]
          },
          "4620302": {
            "id": "4620302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Him, who?",
            "nextDialogs": [
              "4620303"
            ]
          },
          "4620303": {
            "id": "4620303",
            "speakerId": 1213,
            "speakerName": "Vile",
            "text": "Thanks so much for saving me! You're far more reliable than those Favonius guys.",
            "nextDialogs": [
              "4620304"
            ]
          },
          "4620304": {
            "id": "4620304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#It's nothing. {M#He}{F#She}'s a traveler, {M#he}{F#she} has to deal with stuff like this all the time.",
            "nextDialogs": [
              "4620305"
            ]
          },
          "4620305": {
            "id": "4620305",
            "speakerId": 1213,
            "speakerName": "Vile",
            "text": "Traveler? I've heard stories about you. I didn't think I'd be saved by <color=#00E1FFFF>the one I'm here to meet</color>.",
            "nextDialogs": [
              "4620306"
            ]
          },
          "4620306": {
            "id": "4620306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, so you're the...",
            "nextDialogs": [
              "4620307"
            ]
          },
          "4620307": {
            "id": "4620307",
            "speakerId": 1213,
            "speakerName": "Vile",
            "text": "Hahaha... I didn't know how I could pay you back initially, but now, I think I'll just give you the intel for free.",
            "nextDialogs": [
              "4620308"
            ]
          },
          "4620308": {
            "id": "4620308",
            "speakerId": 1213,
            "speakerName": "Vile",
            "text": "People in our circle know how important the network is.",
            "nextDialogs": [
              "4620310"
            ]
          },
          "4620310": {
            "id": "4620310",
            "speakerId": 1213,
            "speakerName": "Vile",
            "text": "Well, you did save my life.",
            "nextDialogs": [
              "4620312"
            ]
          },
          "4620312": {
            "id": "4620312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "LUCKY!",
            "nextDialogs": [
              "4620313"
            ]
          },
          "4620313": {
            "id": "4620313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But... it's lucky for Kaeya, isn't it? He's supposed to pay for the intel...",
            "nextDialogs": [
              "4620314"
            ]
          },
          "4620314": {
            "id": "4620314",
            "speakerId": 1213,
            "speakerName": "Vile",
            "text": "Listen well then, the intel on the Arcadian Ruins...",
            "nextDialogs": [
              "4620315"
            ]
          },
          "4620315": {
            "id": "4620315",
            "speakerId": 1213,
            "speakerName": "Vile",
            "text": "\"Three six-armed giants reside in the city in the lake. Two guard the statue, one, the treasure.\"",
            "nextDialogs": [
              "4620316"
            ]
          },
          "4620316": {
            "id": "4620316",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right... Wait, is that it?",
            "nextDialogs": [
              "4620325"
            ]
          },
          "4620325": {
            "id": "4620325",
            "speakerId": 1213,
            "speakerName": "Vile",
            "text": "There's also this map that came with it.",
            "nextDialogs": [
              "4620317"
            ]
          },
          "4620317": {
            "id": "4620317",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Could... this be the X-marks-the-spot?",
            "nextDialogs": [
              "4620318"
            ]
          },
          "4620318": {
            "id": "4620318",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So the clue is more like a riddle...",
            "nextDialogs": [
              "4620319"
            ]
          },
          "4620319": {
            "id": "4620319",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Well, should be a piece of cake for ya, right {NICKNAME}? Paimon'll leave it to you then!"
          }
        }
      }
    },
    {
      "subId": "46204",
      "subQuestName": "Find the location of the buried treasure",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4620401"
        ],
        "dialogs": {
          "4620401": {
            "id": "4620401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, lemme see what's inside!",
            "nextDialogs": [
              "4620402"
            ]
          },
          "4620402": {
            "id": "4620402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"She doesn't love him at all. The passion rushing through the clear spring is just a front. When she's cold and alone, her true heart is revealed.\"",
            "nextDialogs": [
              "4620407"
            ]
          },
          "4620407": {
            "id": "4620407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's another map.",
            "nextDialogs": [
              "4620403"
            ]
          },
          "4620403": {
            "id": "4620403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "More riddles?",
            "nextDialogs": [
              "4620404"
            ]
          },
          "4620404": {
            "id": "4620404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's dizzy already. Oh, no! Paimon used up all her brain juice!",
            "nextDialogs": [
              "4620405"
            ]
          },
          "4620405": {
            "id": "4620405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You never had any to begin with...",
            "nextDialogs": [
              "4620406"
            ]
          },
          "4620406": {
            "id": "4620406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon'll let you have all the fun. Or, you could get Kaeya to help."
          }
        }
      }
    },
    {
      "subId": "46210",

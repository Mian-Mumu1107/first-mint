  "subQuests": [
    {
      "subId": "46201",
      "subQuestName": "Meet with the informant at the designated location",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4620101"
        ],
        "dialogs": {
          "4620101": {
            "id": "4620101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Look, {NICKNAME}! She's in trouble!",
            "nextDialogs": [
              "4620102"
            ]
          },
          "4620102": {
            "id": "4620102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Forget about the informant. Let's save her!"
          }
        }
      }
    },
    {
      "subId": "46202",
      "subQuestName": "Defeat the opponents attacking the informant",
      "sceneId": null,

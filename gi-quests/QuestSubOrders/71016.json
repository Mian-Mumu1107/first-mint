    {
      "subId": "7101603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710160301"
        ],
        "dialogs": {
          "710160301": {
            "id": "710160301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Regarding the Nameless Treasure...",
            "nextDialogs": [
              "710160302"
            ]
          },
          "710160302": {
            "id": "710160302",
            "speakerId": 2023,
            "speakerName": "Linlang",
            "text": "If my guess isn't off, the object you brought previously is one of three.",
            "nextDialogs": [
              "710160303"
            ]
          },
          "710160303": {
            "id": "710160303",
            "speakerId": 2023,
            "speakerName": "Linlang",
            "text": "It will only be complete once all three objects are gathered together.",
            "nextDialogs": [
              "710160304"
            ]
          },
          "710160304": {
            "id": "710160304",
            "speakerId": 2023,
            "speakerName": "Linlang",
            "text": "If you could find them all, I would be more than willing to make you a generous offer.",
            "nextDialogs": [
              "710160305"
            ]
          },
          "710160305": {
            "id": "710160305",
            "speakerId": 2023,
            "speakerName": "Linlang",
            "text": "I fear that they may be from too ancient a time, however, and that gathering them... could be difficult."
          }
        }
      }
    }

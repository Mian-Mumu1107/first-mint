  "subQuests": [
    {
      "subId": "7370201",
      "subQuestName": "Talk to Zurvan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "737020101"
        ],
        "dialogs": {
          "737020101": {
            "id": "737020101",
            "speakerId": 4284,
            "speakerName": "Zurvan",
            "text": "You look much happier than when last we spoke. Seems things have gone well?",
            "nextDialogs": [
              "737020102"
            ]
          },
          "737020102": {
            "id": "737020102",
            "speakerId": 13210,
            "speakerName": "Sorush",
            "text": "Hmm. From what I've learned doing these tasks, I have grown. For now...",
            "nextDialogs": [
              "737020103"
            ]
          },
          "737020103": {
            "id": "737020103",
            "speakerId": 4284,
            "speakerName": "Zurvan",
            "text": "You are worthy of being called Bloomguard?",
            "nextDialogs": [
              "737020104"
            ]
          },
          "737020104": {
            "id": "737020104",
            "speakerId": 13210,
            "speakerName": "Sorush",
            "text": "No... not yet. There is still a final portion of the task that I need to complete.",
            "nextDialogs": [
              "737020105"
            ]
          },
          "737020105": {
            "id": "737020105",
            "speakerId": 13210,
            "speakerName": "Sorush",
            "text": "Until all the tasks are done, until your respect is earned, I am not finished. Only then can the \"Twin-Horned Chaplet\" truly belong to me.",
            "nextDialogs": [
              "737020106"
            ]
          },
          "737020106": {
            "id": "737020106",
            "speakerId": 4284,
            "speakerName": "Zurvan",
            "text": "Oh? Looks like you're actually beyond your rebellious phase after all, just as was claimed.",
            "nextDialogs": [
              "737020107"
            ]
          },
          "737020107": {
            "id": "737020107",
            "speakerId": 13210,
            "speakerName": "Sorush",
            "text": "E—Elder, you... still remember that? Forget, I beg of you!",
            "nextDialogs": [
              "737020108"
            ]
          },
          "737020108": {
            "id": "737020108",
            "speakerId": 4284,
            "speakerName": "Zurvan",
            "text": "Haha. Regardless, it's good to see that your spirits have returned.",
            "nextDialogs": [
              "737020109"
            ]
          },
          "737020109": {
            "id": "737020109",
            "speakerId": 4284,
            "speakerName": "Zurvan",
            "text": "#{NICKNAME}. Paimon. Please be witnesses to the truth of whether Sorush is worthy of the Twin-Horned Chaplet.",
            "nextDialogs": [
              "737020110"
            ]
          },
          "737020110": {
            "id": "737020110",
            "speakerId": 4284,
            "speakerName": "Zurvan",
            "text": "Then I will await you at the end. See you soon."
          }
        }
      }
    },

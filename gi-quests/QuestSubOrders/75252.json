        "startDialogs": [
          "752520601"
        ],
        "dialogs": {
          "752520601": {
            "id": "752520601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You were a guest in the bar. We've met.",
            "nextDialogs": [
              "752520602"
            ]
          },
          "752520602": {
            "id": "752520602",
            "speakerId": 6512,
            "speakerName": "Tecuhtli",
            "text": "Have we? Guess that's why you look familiar. I've met a lot of people today, so I don't really remember the faces... but that isn't important right now."
          }
        }
      }
    },
    {
      "subId": "7525205",
      "subQuestName": "Return and look for Icahua",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752520701"
        ],
        "dialogs": {
          "752520701": {
            "id": "752520701",
            "speakerId": 6512,
            "speakerName": "Tecuhtli",
            "text": "What's important is whether you've seen a bald-headed guy around here? I have something to talk to him about.",
            "nextDialogs": [
              "752520704",
              "752520705"
            ]
          },
          "752520704": {
            "id": "752520704",
            "speakerId": 6512,
            "speakerName": "Tecuhtli",
            "text": "Oh, was he here just now? I guess he must have seen me coming...",
            "nextDialogs": [
              "752520709"
            ]
          },
          "752520709": {
            "id": "752520709",
            "speakerId": 6512,
            "speakerName": "Tecuhtli",
            "text": "Hmph. I'll get you for this, Icahua...",
            "nextDialogs": [
              "752520706"
            ]
          },
          "752520706": {
            "id": "752520706",
            "speakerId": 6512,
            "speakerName": "Tecuhtli",
            "text": "Since we've met before and you seem alright, I'll warn you to steer clear of that follicly deficient rascal and me — otherwise, that pretty face of yours might end up covered in red and white paint.",
            "nextDialogs": [
              "752520707"
            ]
          },
          "752520707": {
            "id": "752520707",
            "speakerId": 6512,
            "speakerName": "Tecuhtli",
            "text": "These are the things I found in his camp. I'm guessing he didn't have time to take them with him.",
            "nextDialogs": [
              "752520708"
            ]
          },
          "752520708": {
            "id": "752520708",
            "speakerId": 6512,
            "speakerName": "Tecuhtli",
            "text": "They're yours now. Don't worry, he's already forfeited any right to object.",
            "nextDialogs": [
              "752520710"
            ]
          },
          "752520710": {
            "id": "752520710",
            "speakerId": 6512,
            "speakerName": "Tecuhtli",
            "text": "Sooner or later, his life will be mine."
          },
          "752520705": {
            "id": "752520705",
            "speakerId": 6512,
            "speakerName": "Tecuhtli",
            "text": "Are you telling me the truth? I'm inclined to trust that honest face of yours — for now."
          }
        }
      }
    },

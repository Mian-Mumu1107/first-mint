          },
          "752520104": {
            "id": "752520104",
            "speakerId": 21972,
            "speakerName": "Icahua",
            "text": "Thanks. But I'm busy, so please don't stand around here.",
            "nextDialogs": [
              "752520110"
            ]
          },
          "752520110": {
            "id": "752520110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you working on?",
            "nextDialogs": [
              "752520105"
            ]
          },
          "752520105": {
            "id": "752520105",
            "speakerId": 21972,
            "speakerName": "Icahua",
            "text": "You don't need to know.",
            "nextDialogs": [
              "752520106"
            ]
          },
          "752520106": {
            "id": "752520106",
            "speakerId": 21972,

    {
      "subId": "2401212",
      "subQuestName": "Talk to Arouet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240121201"
        ],
        "dialogs": {
          "240121201": {
            "id": "240121201",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "Hmm... There's something not quite right about this Latte...",
            "nextDialogs": [
              "240121202"
            ]
          },
          "240121202": {
            "id": "240121202",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "First, you'll need to mix <color=#00E1FFFF>one portion of coffee extract</color> and <color=#00E1FFFF>one portion of milk</color> together completely.",
            "nextDialogs": [
              "240121203"
            ]
          },
          "240121203": {
            "id": "240121203",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "After that, you need to cap it off with <color=#00E1FFFF>a serving of milk foam</color>... which I've already prepared for you. It's over there.",
            "nextDialogs": [
              "240121204"
            ]
          },
          "240121204": {
            "id": "240121204",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "Please try it again."
          }
        }
      }
    },
    {
      "subId": "2401214",
      "subQuestName": "Talk to Arouet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240121401"
        ],
        "dialogs": {
          "240121401": {
            "id": "240121401",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "Your technique's all over the place today... Did something happen?",
            "nextDialogs": [
              "240121402"
            ]
          },
          "240121402": {
            "id": "240121402",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "It's alright. Leave the brewing to me this time.",
            "nextDialogs": [
              "240121403"
            ]
          },
          "240121403": {
            "id": "240121403",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Arouet starts brewing the coffee...",
            "nextDialogs": [
              "240121404"
            ]
          },
          "240121404": {
            "id": "240121404",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "Alright, please bring this to our customers..."
          }
        }
      }
    },
    {
      "subId": "2401209",
      "subQuestName": "Talk to Arouet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240120901"
        ],
        "dialogs": {
          "240120901": {
            "id": "240120901",
            "speakerId": 5053,
            "speakerName": "Arouet",
            "text": "This flavor is excellent — one might even call it perfect. Bring it to our customer as soon as possible. I'm sure she'll enjoy it!"
          }
        }
      }
    },

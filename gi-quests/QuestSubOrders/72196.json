{
  "lineCounts": {
    "Inaba Kyuuzou": 35,
    "Paimon": 6,
    "Player": 11
  },
  "subQuests": [
    {
      "subId": "7219614",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721961401"
        ],
        "dialogs": {
          "721961401": {
            "id": "721961401",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "It's you again!?",
            "nextDialogs": [
              "721961402"
            ]
          },
          "721961402": {
            "id": "721961402",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Didn't I tell you to... Oh, forget it. Do as you like.",
            "nextDialogs": [
              "721961403"
            ]
          },
          "721961403": {
            "id": "721961403",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Just don't mess around with my things. There are just enough supplies on the ship for you. Leave as soon as you are satisfied.",
            "nextDialogs": [
              "721961404"
            ]
          },
          "721961404": {
            "id": "721961404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Would you like some help?",
            "nextDialogs": [
              "721961405"
            ]
          },
          "721961405": {
            "id": "721961405",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "No. Can't you see that I'm doing just fine?",
            "nextDialogs": [
              "721961406"
            ]
          },
          "721961406": {
            "id": "721961406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But your wound...",
            "nextDialogs": [
              "721961407"
            ]
          },
          "721961407": {
            "id": "721961407",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "It's my wound, not yours.",
            "nextDialogs": [
              "721961408"
            ]
          },
          "721961408": {
            "id": "721961408",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, we asked out of kindness!",
            "nextDialogs": [
              "721961409"
            ]
          },
          "721961409": {
            "id": "721961409",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Then I also answer you out of kindness: don't bother me.",
            "nextDialogs": [
              "721961410"
            ]
          },
          "721961410": {
            "id": "721961410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I can help you.",
            "nextDialogs": [
              "721961411"
            ]
          },
          "721961411": {
            "id": "721961411",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "How can you help me, hand me over to the shogunate?",
            "nextDialogs": [
              "721961412"
            ]
          },
          "721961412": {
            "id": "721961412",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Haha, I'd advise you against such misguided mercy... I will be treated as a deserter, and Lord Kujou has never shown mercy to deserters.",
            "nextDialogs": [
              "721961413"
            ]
          },
          "721961413": {
            "id": "721961413",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "If you really want to help me, then give me some peace and quiet.",
            "nextDialogs": [
              "721961414"
            ]
          },
          "721961414": {
            "id": "721961414",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, this guy is so grumpy!"
          }
        }
      }
    },
    {
      "subId": "7219606",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721960601"
        ],
        "dialogs": {
          "721960601": {
            "id": "721960601",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Outlander, how have you been?",
            "nextDialogs": [
              "721960602"
            ]
          },
          "721960602": {
            "id": "721960602",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "I apologize. This is no place for guests.",
            "nextDialogs": [
              "721960603"
            ]
          },
          "721960603": {
            "id": "721960603",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Still... I'm glad you could come.",
            "nextDialogs": [
              "721960604"
            ]
          },
          "721960604": {
            "id": "721960604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You look much better now.",
            "nextDialogs": [
              "721960605"
            ]
          },
          "721960605": {
            "id": "721960605",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "All thanks to you. Once again, I am in your debt.",
            "nextDialogs": [
              "721960606"
            ]
          },
          "721960606": {
            "id": "721960606",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Haha, isn't it a pity that I've survived yet again?",
            "nextDialogs": [
              "721960607"
            ]
          },
          "721960607": {
            "id": "721960607",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Isn't that a good thing? Why's that a pity?"
          }
        }
      }
    },
    {
      "subId": "7219607",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721960701"
        ],
        "dialogs": {
          "721960701": {
            "id": "721960701",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "...And it seems that the rats nearby have begun scurrying about again.",
            "nextDialogs": [
              "721960702"
            ]
          },
          "721960702": {
            "id": "721960702",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Watch out for pirates if you wander around these parts, outlander.",
            "nextDialogs": [
              "721960703"
            ]
          },
          "721960703": {
            "id": "721960703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thank you.",
            "nextDialogs": [
              "721960704"
            ]
          },
          "721960704": {
            "id": "721960704",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "You're welcome.",
            "nextDialogs": [
              "721960705"
            ]
          },
          "721960705": {
            "id": "721960705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They shall be no match for me.",
            "nextDialogs": [
              "721960706"
            ]
          },
          "721960706": {
            "id": "721960706",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Haha, again with the big talk...",
            "nextDialogs": [
              "721960707"
            ]
          },
          "721960707": {
            "id": "721960707",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Only say that once you've finally gotten rid of them all!",
            "nextDialogs": [
              "721960708"
            ]
          },
          "721960708": {
            "id": "721960708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You have a deal.",
            "nextDialogs": [
              "721960709"
            ]
          },
          "721960709": {
            "id": "721960709",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Yes, that we do."
          }
        }
      }
    },
    {
      "subId": "7219613",
      "subQuestName": "Report the situation to Inaba Kyuuzou.",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721961301"
        ],
        "dialogs": {
          "721961301": {
            "id": "721961301",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "An outlander? Interesting...",
            "nextDialogs": [
              "721961302"
            ]
          },
          "721961302": {
            "id": "721961302",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "If you're a tourist, you've come to the wrong place.",
            "nextDialogs": [
              "721961303"
            ]
          },
          "721961303": {
            "id": "721961303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing here?",
            "nextDialogs": [
              "721961304"
            ]
          },
          "721961304": {
            "id": "721961304",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "What, are you from the Shogunate?",
            "nextDialogs": [
              "721961305"
            ]
          },
          "721961305": {
            "id": "721961305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No.",
            "nextDialogs": [
              "721961306"
            ]
          },
          "721961306": {
            "id": "721961306",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Then mind your own business.",
            "nextDialogs": [
              "721961307"
            ]
          },
          "721961307": {
            "id": "721961307",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This guy's so rude!",
            "nextDialogs": [
              "721961308"
            ]
          },
          "721961308": {
            "id": "721961308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Shogunate sent me, alright.",
            "nextDialogs": [
              "721961309"
            ]
          },
          "721961309": {
            "id": "721961309",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Why you outlanders...",
            "nextDialogs": [
              "721961310"
            ]
          },
          "721961310": {
            "id": "721961310",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "In front of the Commissioner, you beg like dogs, but in front of us Inazuman samurai, you act all high and mighty...",
            "nextDialogs": [
              "721961311"
            ]
          },
          "721961311": {
            "id": "721961311",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Running here, spying there, stirring things up everywhere... And now you come all the way to this broken boat, for archons only know what.",
            "nextDialogs": [
              "721961312"
            ]
          },
          "721961312": {
            "id": "721961312",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Well, too bad. I'm just a wounded soldier. There's nothing I can do for you.",
            "nextDialogs": [
              "721961313"
            ]
          },
          "721961313": {
            "id": "721961313",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "So if it pleases you, kindly get out of here.",
            "nextDialogs": [
              "721961314"
            ]
          },
          "721961314": {
            "id": "721961314",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Doesn't this guy have any manners at all?",
            "nextDialogs": [
              "721961315"
            ]
          },
          "721961315": {
            "id": "721961315",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Whatever. You're too noisy.",
            "nextDialogs": [
              "721961316"
            ]
          },
          "721961316": {
            "id": "721961316",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Before you leave, let me give you a piece of advice: don't stay on Yashiori Island for too long. This island has been cursed.",
            "nextDialogs": [
              "721961317"
            ]
          },
          "721961317": {
            "id": "721961317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Cursed?",
            "nextDialogs": [
              "721961318"
            ]
          },
          "721961318": {
            "id": "721961318",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "What are you, deaf? I said that this island is cursed.",
            "nextDialogs": [
              "721961319"
            ]
          },
          "721961319": {
            "id": "721961319",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "This never-ending stalemate, the ambitions of our lords, the despair of the common folk, the hatred welling up from the innocent victims, the charnel-sick of vulneraries filling the rooms of dying old people...",
            "nextDialogs": [
              "721961320"
            ]
          },
          "721961320": {
            "id": "721961320",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "It's all a curse.",
            "nextDialogs": [
              "721961321"
            ]
          },
          "721961321": {
            "id": "721961321",
            "speakerId": 1000,
            "speakerName": "Inaba Kyuuzou",
            "text": "Leave before you get crushed under its weight.",
            "nextDialogs": [
              "721961322"
            ]
          },
          "721961322": {
            "id": "721961322",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon didn't get him at all. What a weirdo."
          }
        }
      }
    },
    {
      "subId": "7219611",
      "subQuestName": "Witness Inaba Kyuuzou's fate.",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    }
  ]
}
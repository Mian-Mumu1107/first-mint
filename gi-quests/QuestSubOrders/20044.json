  "subQuests": [
    {
      "subId": "2004401",
      "subQuestName": "Talk to Ellin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200440101"
        ],
        "dialogs": {
          "200440101": {
            "id": "200440101",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Ugh, what a headache... What am I supposed to do about this?",
            "nextDialogs": [
              "200440102"
            ]
          },
          "200440102": {
            "id": "200440102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you up to?",
            "nextDialogs": [
              "200440103"
            ]
          },
          "200440103": {
            "id": "200440103",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Practicing for the Knights of Favonius' tryouts!",
            "nextDialogs": [
              "200440104"
            ]
          },
          "200440104": {
            "id": "200440104",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "*sigh* But I'm nowhere near as powerful as Jean.",
            "nextDialogs": [
              "200440105"
            ]
          },
          "200440105": {
            "id": "200440105",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "I think it's better for me to focus on technique rather than power.",
            "nextDialogs": [
              "200440106"
            ]
          },
          "200440106": {
            "id": "200440106",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "For example, I was thinking about how to break all these wooden dummies in one fell swoop.",
            "nextDialogs": [
              "200440107"
            ]
          },
          "200440107": {
            "id": "200440107",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "If you're at a loose end, fancy helping me think about how to tackle it?",
            "nextDialogs": [
              "200440110",
              "200440112"
            ]
          },
          "200440110": {
            "id": "200440110",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Sure, take your time. It's not like these dummies are going anywhere.",
            "nextDialogs": [
              "200440111"
            ]
          },
          "200440111": {
            "id": "200440111",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Nor is my life going anywhere while I'm stuck trying to sort this out, ugh...",
            "nextDialogs": [
              "200440114"
            ]
          },
          "200440114": {
            "id": "200440114",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "If only I had a bigger weapon, or some powerful elemental ability like Jean, breaking all these wooden dummies would probably be a piece of cake."
          },
          "200440112": {
            "id": "200440112",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "You like team combat, then? Alright for some... always someone to help you out.",
            "nextDialogs": [
              "200440113"
            ]
          },
          "200440113": {
            "id": "200440113",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "For people like me, the best I can do is try and hold my own as a lone fighter."
          }
        }
      }
    },
    {
      "subId": "2004402",
      "subQuestName": "Destroy all the training dummies in under 2 seconds",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200440201"
        ],
        "dialogs": {
          "200440201": {
            "id": "200440201",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "How are you getting along? Had a eureka moment yet?",
            "nextDialogs": [
              "200440202"
            ]
          },
          "200440202": {
            "id": "200440202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Still thinking it over...",
            "nextDialogs": [
              "200440203"
            ]
          },
          "200440203": {
            "id": "200440203",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Huh. I've met a few other adventurers before. They were the same way.",
            "nextDialogs": [
              "200440204"
            ]
          },
          "200440204": {
            "id": "200440204",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "They fight monsters like pros, but they're hopelessly lost when it comes to trying to break a few wooden sticks.",
            "nextDialogs": [
              "200440205"
            ]
          },
          "200440205": {
            "id": "200440205",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "And they reinforce the wood like it's for building a storm shelter or something... Way overestimating their own strength.",
            "nextDialogs": [
              "200440206"
            ]
          },
          "200440206": {
            "id": "200440206",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "If they want a challenge so desperately, why don't they just go off into the wilderness and pick a fight with the biggest monster they can find?"
          }
        }
      }
    },
    {
      "subId": "2004403",
      "subQuestName": "Talk to Ellin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200440301"
        ],
        "dialogs": {
          "200440301": {
            "id": "200440301",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Nailed it!",
            "nextDialogs": [
              "200440302"
            ]
          },
          "200440302": {
            "id": "200440302",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Huh, I never even thought of trying that...",
            "nextDialogs": [
              "200440303"
            ]
          },
          "200440303": {
            "id": "200440303",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Thanks! I'm gonna try it myself now."
          }
        }
      }
    }
  ]
}
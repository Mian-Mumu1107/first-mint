    {
      "subId": "1918532",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191853201"
        ],
        "dialogs": {
          "191853201": {
            "id": "191853201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Hmm... But maybe I'm overthinking things a bit...)",
            "nextDialogs": [
              "191853202"
            ]
          },
          "191853202": {
            "id": "191853202",
            "speakerId": 1072,
            "speakerName": "Lynette",
            "text": "...Is the answer not coming to you, or do you think it's too unbelievable to be true?"
          }
        }
      }
    },
    {
      "subId": "1918541",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191854101"
        ],
        "dialogs": {
          "191854101": {
            "id": "191854101",
            "speakerId": 1072,
            "speakerName": "Lynette",
            "text": "...",
            "nextDialogs": [
              "191854102"
            ]
          },
          "191854102": {
            "id": "191854102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Something on your mind still?",
            "nextDialogs": [
              "191854103"
            ]
          },
          "191854103": {
            "id": "191854103",
            "speakerId": 1072,
            "speakerName": "Lynette",
            "text": "Ah, it was that obvious, huh... Well, even though it didn't feel like Bernard was lying, after talking to him, I'm getting an even stronger sense that something's not quite right.",
            "nextDialogs": [
              "191854104"
            ]
          },
          "191854104": {
            "id": "191854104",
            "speakerId": 1072,
            "speakerName": "Lynette",
            "text": "We investigated so quickly that perhaps we've missed a thing or two along the way. Let me activate deduction mode and consider things again from the top to see if we can find anything new.",
            "nextDialogs": [
              "191854105"
            ]
          },
          "191854105": {
            "id": "191854105",
            "speakerId": 1072,
            "speakerName": "Lynette",
            "text": "...Is there still anything unresolved or strange that we should try to consider?"
          }
        }
      }
    },
    {

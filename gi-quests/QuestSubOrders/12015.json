    {
      "subId": "1201504",
      "subQuestName": "Look for Yae Miko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120150401"
        ],
        "dialogs": {
          "120150401": {
            "id": "120150401",
            "speakerId": 1004,
            "speakerName": "Inagi Hotomi",
            "text": "Are you here to see Lady Yae?",
            "nextDialogs": [
              "120150402"
            ]
          },
          "120150402": {
            "id": "120150402",
            "speakerId": 1004,
            "speakerName": "Inagi Hotomi",
            "text": "She was inside a moment ago, but her movements are always a source of mystery — you never know when she might disappear...",
            "nextDialogs": [
              "120150403"
            ]
          },
          "120150403": {
            "id": "120150403",
            "speakerId": 1004,
            "speakerName": "Inagi Hotomi",
            "text": "Anyway, you may head in and see if she's there."
          }
        }
      }
    },
    {
      "subId": "1201505",
      "subQuestName": "Talk to Yae Miko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120150501"
        ],
        "dialogs": {
          "120150501": {
            "id": "120150501",
            "speakerId": 1005,
            "speakerName": "Yae Miko",
            "text": "I wasn't expecting to receive VIP shrine visitors during down time. Hehe, so I suppose you're here just to visit me?",
            "nextDialogs": [
              "120150503",
              "120150506"
            ]
          },
          "120150503": {
            "id": "120150503",
            "speakerId": 1005,
            "speakerName": "Yae Miko",
            "text": "What a smooth talker... though, your eyes do not lie as convincingly as your tongue. You came because you need my help, didn't you?",
            "nextDialogs": [
              "120150504"
            ]
          },
          "120150504": {
            "id": "120150504",
            "speakerId": 1005,
            "speakerName": "Yae Miko",
            "text": "Still, your answer has put me in a good mood.",
            "nextDialogs": [
              "120150508"
            ]
          },
          "120150508": {
            "id": "120150508",
            "speakerId": 1005,
            "speakerName": "Yae Miko",
            "text": "So, tell me. What is the matter?",
            "nextDialogs": [
              "120150509"
            ]
          },
          "120150509": {
            "id": "120150509",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "We heard that the Shogun decided to take a break, and since then the thunderstorm around Inazuma has gotten wilder.",
            "nextDialogs": [
              "120150510"
            ]
          },
          "120150510": {
            "id": "120150510",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Rumor has it that the thunderstorm is affected by the Shogun's will. So people are worrying that something might be wrong with her.",
            "nextDialogs": [
              "120150511"
            ]
          },
          "120150511": {
            "id": "120150511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Tenryou Commission also needs her attention.",
            "nextDialogs": [
              "120150512"
            ]
          },
          "120150512": {
            "id": "120150512",
            "speakerId": 1005,
            "speakerName": "Yae Miko",
            "text": "*sigh*...",
            "nextDialogs": [
              "120150513"
            ]
          },
          "120150513": {
            "id": "120150513",
            "speakerId": 1005,
            "speakerName": "Yae Miko",
            "text": "Alright. There's little purpose in keeping anything hidden from you, anyway.",
            "nextDialogs": [
              "120150514"
            ]
          },
          "120150514": {
            "id": "120150514",
            "speakerId": 1005,
            "speakerName": "Yae Miko",
            "text": "Since the battle, the Shogun has been greatly troubled and her temperament has changed drastically.",
            "nextDialogs": [
              "120150515"
            ]
          },
          "120150515": {
            "id": "120150515",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "What!?"
          },
          "120150506": {
            "id": "120150506",
            "speakerId": 1005,
            "speakerName": "Yae Miko",
            "text": "Oh, how cold. I saved your skin, didn't I? Surely you could at least humor me by engaging in some small talk first?",
            "nextDialogs": [
              "120150507"
            ]
          },
          "120150507": {
            "id": "120150507",
            "speakerId": 1005,
            "speakerName": "Yae Miko",
            "text": "Then again, I suppose your frankness is part of your charm."
          }
        }
      }
    },
    {
      "subId": "1201506",
      "subQuestName": "Go to see the Shogun",

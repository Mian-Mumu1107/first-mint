    {
      "subId": "1201507",
      "subQuestName": "Talk to Takeshi at the entrance",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120150701"
        ],
        "dialogs": {
          "120150701": {
            "id": "120150701",
            "speakerId": 1006,
            "speakerName": "Takeshi",
            "text": "The Almighty Shogun has requested solitude. No visitors allowed.",
            "nextDialogs": [
              "120150702"
            ]
          },
          "120150702": {
            "id": "120150702",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "We've got a Pass Permit from Miko.",
            "nextDialogs": [
              "120150703"
            ]
          },
          "120150703": {
            "id": "120150703",
            "speakerId": 1006,
            "speakerName": "Takeshi",
            "text": "Don't be ridiculous. Lady Guuji never gives her Pass Permit to another person, not even esteemed travelers like yourselves.",
            "nextDialogs": [
              "120150704"
            ]
          },
          "120150704": {
            "id": "120150704",
            "speakerId": 1006,
            "speakerName": "Takeshi",
            "text": "Guuji Yae is only authorized to hold that Pass Permit because of the trust that the Almighty Shogun places in her and her alone...",
            "nextDialogs": [
              "120150705"
            ]
          },
          "120150705": {
            "id": "120150705",
            "speakerId": 1006,
            "speakerName": "Takeshi",
            "text": "Wait... This is... authentic!?",
            "nextDialogs": [
              "120150708"
            ]
          },
          "120150708": {
            "id": "120150708",
            "speakerId": 1006,
            "speakerName": "Takeshi",
            "text": "Understood. Then, as the Shogun has ordered, I must not stand in your way.",
            "nextDialogs": [
              "120150709"
            ]
          },
          "120150709": {
            "id": "120150709",
            "speakerId": 1006,
            "speakerName": "Takeshi",
            "text": "Apologies, please proceed. Since the Shogun is resting at this time, please be especially respectful and make sure your behavior is impeccable."
          }
        }
      }
    },
    {
      "subId": "1201508",
      "subQuestName": "Go to Tenshukaku to see the Shogun",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120150802"
        ],
        "dialogs": {
          "120150802": {
            "id": "120150802",
            "speakerId": 1007,
            "speakerName": "Raiden Shogun",
            "text": "How did you get in?",
            "nextDialogs": [
              "120150803"
            ]
          },
          "120150803": {
            "id": "120150803",
            "speakerId": 1007,
            "speakerName": "Raiden Shogun",
            "text": "Trespassers are to be eliminated at once.",
            "nextDialogs": [
              "120150804"
            ]
          },
          "120150804": {
            "id": "120150804",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Wait, no, it's us! Why are you treating us like we're your enemies!?",
            "nextDialogs": [
              "120150805"
            ]
          },
          "120150805": {
            "id": "120150805",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "We made amends, didn't we? Also, we got in by totally legitimate means!",
            "nextDialogs": [
              "120150806"
            ]
          },
          "120150806": {
            "id": "120150806",
            "speakerId": 1007,
            "speakerName": "Raiden Shogun",
            "text": "Denied. Use of force has been forbidden.",
            "nextDialogs": [
              "120150807"
            ]
          },
          "120150807": {
            "id": "120150807",
            "speakerId": 1007,
            "speakerName": "Raiden Shogun",
            "text": "Anyway. Be gone. Do not disturb my solitude.",
            "nextDialogs": [
              "120150810"
            ]
          },
          "120150810": {
            "id": "120150810",
            "speakerId": 1007,
            "speakerName": "Raiden Shogun",
            "text": "That is of no concern. This is my recuperation state.",
            "nextDialogs": [
              "120150811"
            ]
          },
          "120150811": {
            "id": "120150811",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "#Huh, {NICKNAME}, what do you make of this? She's acting strange, huh?"
          }
        }
      }
    },
    {
      "subId": "1201509",
      "subQuestName": "Enter the Plane of Euthymia",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120150901"
        ],
        "dialogs": {
          "120150901": {
            "id": "120150901",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "That was terrifying! Would it be so hard to give us a little warning first...",
            "nextDialogs": [
              "120150902"
            ]
          },
          "120150902": {
            "id": "120150902",
            "speakerId": 1008,
            "speakerName": "Ei",
            "text": "It's not your first time. I don't see what there is to be so alarmed about.",
            "nextDialogs": [
              "120150903"
            ]
          },
          "120150903": {
            "id": "120150903",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "So, is the Shogun broken? Are you gonna get it fixed, or...?",
            "nextDialogs": [
              "120150904"
            ]
          },
          "120150904": {
            "id": "120150904",
            "speakerId": 1008,
            "speakerName": "Ei",
            "text": "Don't worry. The Shogun's not broken, I've just temporarily disabled many of her functions.",
            "nextDialogs": [
              "120150905"
            ]
          },
          "120150905": {
            "id": "120150905",
            "speakerId": 1008,
            "speakerName": "Ei",
            "text": "Currently, the Shogun is unable to handle any business and cannot appear as me. So the easiest solution was to announce that I am resting.",
            "nextDialogs": [
              "120150908"
            ]
          },
          "120150908": {
            "id": "120150908",
            "speakerId": 1008,
            "speakerName": "Ei",
            "text": "As I said, I need to think about Inazuma's Eternity. And thinking takes time.",
            "nextDialogs": [
              "120150909"
            ]
          },
          "120150909": {
            "id": "120150909",
            "speakerId": 1008,
            "speakerName": "Ei",
            "text": "But the Shogun is still running based on her old rules. I can't allow her to make any more mistakes while I am working things out.",
            "nextDialogs": [
              "120150910"
            ]
          },
          "120150910": {
            "id": "120150910",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Have you tried turning it off and on again?",
            "nextDialogs": [
              "120150911"
            ]
          },
          "120150911": {
            "id": "120150911",
            "speakerId": 1008,
            "speakerName": "Ei",
            "text": "No. She was not created to ever be turned off.",
            "nextDialogs": [
              "120150912"
            ]
          },
          "120150912": {
            "id": "120150912",
            "speakerId": 1008,
            "speakerName": "Ei",
            "text": "Furthermore, I had even predicted at the time that I may wish to modify the Shogun's operational rules at some point in the future. However, such changes would not be conducive to Eternity.",
            "nextDialogs": [
              "120150913"
            ]
          },
          "120150913": {
            "id": "120150913",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You are so strict with yourself...",
            "nextDialogs": [
              "120150914"
            ]
          },
          "120150914": {
            "id": "120150914",
            "speakerId": 1008,
            "speakerName": "Ei",
            "text": "That's why the Shogun has a robust system to safeguard against modification. It's also to protect against unforeseen circumstances.",
            "nextDialogs": [
              "120150915"
            ]
          },
          "120150915": {
            "id": "120150915",
            "speakerId": 1008,
            "speakerName": "Ei",
            "text": "For now, while I figure out the form that Eternity should take, it's more effective for me to temporarily disable some of the puppet's functions rather than attempt to modify her rules.",
            "nextDialogs": [
              "120150916"
            ]
          },
          "120150916": {
            "id": "120150916",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Paimon gets it now. The thunderstorm's getting out of control because some of the Shogun's functions have been disabled.",
            "nextDialogs": [
              "120150917"
            ]
          },
          "120150917": {
            "id": "120150917",
            "speakerId": 1008,
            "speakerName": "Ei",
            "text": "The thunderstorm is getting out of control? This is the first I've heard of it.",
            "nextDialogs": [
              "120150918"
            ]
          },
          "120150918": {
            "id": "120150918",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Huh? Okay, well, let us bring you up to speed...",
            "nextDialogs": [
              "120150919"
            ]
          },
          "120150919": {
            "id": "120150919",
            "speakerId": 1008,
            "speakerName": "Ei",
            "text": "Hmm, I see. So the thunderstorm is drawing closer...",
            "nextDialogs": [
              "120150920"
            ]
          },
          "120150920": {
            "id": "120150920",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "You can fix it... right?",
            "nextDialogs": [
              "120150921"
            ]
          },
          "120150921": {
            "id": "120150921",
            "speakerId": 1008,
            "speakerName": "Ei",
            "text": "It's just a minor error. This kind of thing was bound to happen. A small modification to the Shogun should fix it."
          }
        }
      }
    },
    {
      "subId": "1201510",
      "subQuestName": "Speak to Ei in the distance",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

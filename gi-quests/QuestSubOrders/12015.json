    {
      "subId": "1201551",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120155101"
        ],
        "dialogs": {
          "120155101": {
            "id": "120155101",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "Your master shouldn't blame himself so much. Anyone else in his position would find it just as difficult to deal with.",
            "nextDialogs": [
              "120155102"
            ]
          },
          "120155102": {
            "id": "120155102",
            "speakerId": 1002,
            "speakerName": "Ippei",
            "text": "Exactly. He puts far too much pressure on himself...",
            "nextDialogs": [
              "120155103"
            ]
          },
          "120155103": {
            "id": "120155103",
            "speakerId": 1002,
            "speakerName": "Ippei",
            "text": "*sigh*... The Kujou Clan's future isn't looking bright."
          }
        }
      }
    },
    {
      "subId": "1201552",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120155201"
        ],
        "dialogs": {
          "120155201": {
            "id": "120155201",
            "speakerId": 1005,
            "speakerName": "Yae Miko",
            "text": "She spends all her time alone. Having a visitor once in a while can't do any harm.",
            "nextDialogs": [
              "120155202"
            ]
          },
          "120155202": {
            "id": "120155202",
            "speakerId": 1005,
            "speakerName": "Yae Miko",
            "text": "As the one who shook Eternity, you are her potential for change."
          }
        }
      }
    },
    {
      "subId": "1201553",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120155301"
        ],
        "dialogs": {
          "120155301": {
            "id": "120155301",
            "speakerId": 1006,
            "speakerName": "Takeshi",
            "text": "It's rumored that the Almighty Shogun has taken ill... Could it be true?",
            "nextDialogs": [
              "120155302"
            ]
          },
          "120155302": {
            "id": "120155302",
            "speakerId": 1006,
            "speakerName": "Takeshi",
            "text": "Ah, ignore me. Please, head in."
          }
        }
      }
    }
  ]
}
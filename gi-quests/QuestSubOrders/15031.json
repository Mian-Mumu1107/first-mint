  "subQuests": [
    {
      "subId": "1503101",
      "subQuestName": "Return and inform people in the tribe",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150310101"
        ],
        "dialogs": {
          "150310101": {
            "id": "150310101",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "Chief Acatl gathers people from the tribe to hear Varesa's report on the mushrooms.",
            "nextDialogs": [
              "150310102"
            ]
          },
          "150310102": {
            "id": "150310102",
            "speakerId": 6305,
            "speakerName": "Acatl",
            "text": "...",
            "nextDialogs": [
              "150310103"
            ]
          },
          "150310103": {
            "id": "150310103",
            "speakerId": 6393,
            "speakerName": "Atolli",
            "text": "...",
            "nextDialogs": [
              "150310104"
            ]
          },
          "150310104": {
            "id": "150310104",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "...",
            "nextDialogs": [
              "150310105"
            ]
          },
          "150310105": {
            "id": "150310105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay, so it felt pretty normal in the moment, but hearing it back does sound kind of... ridiculous.",
            "nextDialogs": [
              "150310106"
            ]
          },
          "150310106": {
            "id": "150310106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This silence speaks volumes...",
            "nextDialogs": [
              "150310107"
            ]
          },
          "150310107": {
            "id": "150310107",
            "speakerId": 6305,
            "speakerName": "Acatl",
            "text": "So, the mushrooms in the orchard are sentient? What a remarkable discovery!",
            "nextDialogs": [
              "150310108"
            ]
          },
          "150310108": {
            "id": "150310108",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "Yeah, without your investigation, who knows what could have happened?",
            "nextDialogs": [
              "150310109"
            ]
          },
          "150310109": {
            "id": "150310109",
            "speakerId": 6394,
            "speakerName": "Xoctli",
            "text": "Thanks for looking into it, and for collecting all this information!",
            "nextDialogs": [
              "150310110"
            ]
          },
          "150310110": {
            "id": "150310110",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "Phew, what a relief... I was worried it sounded like I lost my marbles...",
            "nextDialogs": [
              "150310111"
            ]
          },
          "150310111": {
            "id": "150310111",
            "speakerId": 6305,
            "speakerName": "Acatl",
            "text": "Hahaha, it does sound far-fetched. After all, none of us have ever spoken to a mushroom.",
            "nextDialogs": [
              "150310112"
            ]
          },
          "150310112": {
            "id": "150310112",
            "speakerId": 6305,
            "speakerName": "Acatl",
            "text": "But, we know you're not one to lie, Varesa. Besides, the origin of the green mushrooms has always been a mystery to us.",
            "nextDialogs": [
              "150310113"
            ]
          },
          "150310113": {
            "id": "150310113",
            "speakerId": 6305,
            "speakerName": "Acatl",
            "text": "Thanks to you, we now know something sinister could be going on. So, we should do our part to help!",
            "nextDialogs": [
              "150310114"
            ]
          },
          "150310114": {
            "id": "150310114",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "Yeah, just let me know if there's anything I can do!",
            "nextDialogs": [
              "150310115"
            ]
          },
          "150310115": {
            "id": "150310115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, that didn't take much convincing...",
            "nextDialogs": [
              "150310116"
            ]
          },
          "150310116": {
            "id": "150310116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thank you, everyone.",
            "nextDialogs": [
              "150310117"
            ]
          },
          "150310117": {
            "id": "150310117",
            "speakerId": 6393,
            "speakerName": "Atolli",
            "text": "Oh, wait, you said the mushrooms need to be cooked on high heat, right? I can do that for you right now — I'll be quick.",
            "nextDialogs": [
              "150310118"
            ]
          },
          "150310118": {
            "id": "150310118",
            "speakerId": 6393,
            "speakerName": "Atolli",
            "text": "Alright, I'm back! I used cast iron, so it should be hot enough!",
            "nextDialogs": [
              "150310119"
            ]
          },
          "150310119": {
            "id": "150310119",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, it smells delicious! Suddenly, Paimon's hungry again!",
            "nextDialogs": [
              "150310120"
            ]
          },
          "150310120": {
            "id": "150310120",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "W—Well, here goes nothing...",
            "nextDialogs": [
              "150310121"
            ]
          },
          "150310121": {
            "id": "150310121",
            "speakerId": 1007,
            "speakerName": "Sage-Lord of Fungi",
            "text": "Hmm...",
            "nextDialogs": [
              "150310122"
            ]
          },
          "150310122": {
            "id": "150310122",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, that's his voice!",
            "nextDialogs": [
              "150310123"
            ]
          },
          "150310123": {
            "id": "150310123",
            "speakerId": 1007,
            "speakerName": "Sage-Lord of Fungi",
            "text": "Hahaha, looks like you stumbled upon the right path, but this temperature does not demonstrate even a fraction of the sincerity I require.",
            "nextDialogs": [
              "150310124"
            ]
          },
          "150310124": {
            "id": "150310124",
            "speakerId": 1007,
            "speakerName": "Sage-Lord of Fungi",
            "text": "Did you really think some common stove could generate enough heat to earn the acknowledgement of the Sage-Lord?",
            "nextDialogs": [
              "150310125"
            ]
          },
          "150310125": {
            "id": "150310125",
            "speakerId": 1007,
            "speakerName": "Sage-Lord of Fungi",
            "text": "Humans are such a disappointment. You can solve my riddles when the answers are handed to you on a silver platter...",
            "nextDialogs": [
              "150310126"
            ]
          },
          "150310126": {
            "id": "150310126",
            "speakerId": 1007,
            "speakerName": "Sage-Lord of Fungi",
            "text": "But, as soon as there are no more hints... not a shred of intelligence in sight.",
            "nextDialogs": [
              "150310127"
            ]
          },
          "150310127": {
            "id": "150310127",
            "speakerId": 1007,
            "speakerName": "Sage-Lord of Fungi",
            "text": "Do try and use your brain this time, hehehe...",
            "nextDialogs": [
              "150310128"
            ]
          },
          "150310128": {
            "id": "150310128",
            "speakerId": 6393,
            "speakerName": "Atolli",
            "text": "H—How did it go? Did you hear the voice?",
            "nextDialogs": [
              "150310129"
            ]
          },
          "150310129": {
            "id": "150310129",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh! Annoying menace of a mushroom!",
            "nextDialogs": [
              "150310130"
            ]
          },
          "150310130": {
            "id": "150310130",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The Sage-Lord of Fungi said the heat's still not high enough. Hmph, Sage-Lord of nitpicking, more like!",
            "nextDialogs": [
              "150310133"
            ]
          },
          "150310133": {
            "id": "150310133",
            "speakerId": 6305,
            "speakerName": "Acatl",
            "text": "Not high enough, huh... I guess that means we need a more powerful source of heat.",
            "nextDialogs": [
              "150310134"
            ]
          },
          "150310134": {
            "id": "150310134",
            "speakerId": 6305,
            "speakerName": "Acatl",
            "text": "Attention, everyone! We need items that can generate intense heat. Anything you can find!",
            "nextDialogs": [
              "150310135"
            ]
          },
          "150310135": {
            "id": "150310135",
            "speakerId": 6393,
            "speakerName": "Atolli",
            "text": "I'll see what I can do.",
            "nextDialogs": [
              "150310136"
            ]
          },
          "150310136": {
            "id": "150310136",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "Leave it to me!",
            "nextDialogs": [
              "150310137"
            ]
          },
          "150310137": {
            "id": "150310137",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "We should take a look, too.",
            "nextDialogs": [
              "150310138"
            ]
          },
          "150310138": {
            "id": "150310138",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Definitely! We're not super familiar with this area, though. Do you have any ideas?",
            "nextDialogs": [
              "150310139"
            ]
          },
          "150310139": {
            "id": "150310139",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "Hmm... Nothing concrete, but we could check around the volcano.",
            "nextDialogs": [
              "150310140"
            ]
          },
          "150310140": {
            "id": "150310140",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "It spews out all kinds of stuff. Maybe there's something we can use.",
            "nextDialogs": [
              "150310141"
            ]
          },
          "150310141": {
            "id": "150310141",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Awesome, let's go! Paimon's gonna find something scorching hot and then throw it at that stupid mushroom's face!"
          }
        }
      }
    },
    {
      "subId": "1503102",
      "subQuestName": "Look for the high-temperature materials needed",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150310201"
        ],
        "dialogs": {
          "150310201": {
            "id": "150310201",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "Hey, there should be some Avatars of Lava somewhere along this path...",
            "nextDialogs": [
              "150310202"
            ]
          },
          "150310202": {
            "id": "150310202",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "Their cores are really hot. It might be just what we need.",
            "nextDialogs": [
              "150310203"
            ]
          },
          "150310203": {
            "id": "150310203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Y'know, when you think about how everyone jumped to help us like that, it seems like your tribe has been suspicious of the green mushrooms for a while.",
            "nextDialogs": [
              "150310204"
            ]
          },
          "150310204": {
            "id": "150310204",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "Yeah, but without you, we would have never gotten this far. I mean, tons of people have tried that mushroom without a weird voice talking in their head.",
            "nextDialogs": [
              "150310205"
            ]
          },
          "150310205": {
            "id": "150310205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right... So, even if you wanted to investigate, you had nowhere to start...",
            "nextDialogs": [
              "150310206"
            ]
          },
          "150310206": {
            "id": "150310206",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "Yeah, this opportunity was a long time coming! Plus, the Sage-Lord's arrogant attitude definitely triggered my tribe's competitive spirit.",
            "nextDialogs": [
              "150310207"
            ]
          },
          "150310207": {
            "id": "150310207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yeah, competitions seem to be a thing here.",
            "nextDialogs": [
              "150310208"
            ]
          },
          "150310208": {
            "id": "150310208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Umm... Varesa doesn't seem competitive most of the time, though. Outside of training and fighting monsters, at least...",
            "nextDialogs": [
              "150310209"
            ]
          },
          "150310209": {
            "id": "150310209",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "Yeah, well... I don't really like fighting or competing, to be honest. Simple day-to-day happiness is what matters to me.",
            "nextDialogs": [
              "150310210"
            ]
          },
          "150310210": {
            "id": "150310210",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "Still, I've learned a lot from Coach Iansan. She taught me that strength is a means rather than an end.",
            "nextDialogs": [
              "150310211"
            ]
          },
          "150310211": {
            "id": "150310211",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "We get stronger so we can use our strength when it counts — like during the Abyss invasion. Having the training to master my Vision meant that I could do something to stop it.",
            "nextDialogs": [
              "150310212"
            ]
          },
          "150310212": {
            "id": "150310212",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "So, no matter how scared I feel, I know I have to be brave, because people are counting on me.",
            "nextDialogs": [
              "150310215"
            ]
          },
          "150310215": {
            "id": "150310215",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "Thanks. It's a work in progress. I can only hope that, one day, I can be as brave as Lady Fietena.",
            "nextDialogs": [
              "150310216"
            ]
          },
          "150310216": {
            "id": "150310216",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "Alright, we should keep looking."
          }
        }
      }
    },
    {
      "subId": "1503103",
      "subQuestName": "Overcome obstacles and climb up",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150310301"
        ],
        "dialogs": {
          "150310301": {
            "id": "150310301",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "Done and dusted! This core should be perfect. Look! The phlogiston inside it is still active!",
            "nextDialogs": [
              "150310302"
            ]
          },
          "150310302": {
            "id": "150310302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, let's see... Whoa, hot!",
            "nextDialogs": [
              "150310303"
            ]
          },
          "150310303": {
            "id": "150310303",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "A few more chunks like this, and we should be good. C'mon, let's keep heading up."
          }
        }
      }
    },

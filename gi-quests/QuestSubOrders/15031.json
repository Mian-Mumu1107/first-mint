    {
      "subId": "1503107",
      "subQuestName": "Talk to Varesa and obtain the material",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150310401"
        ],
        "dialogs": {
          "150310401": {
            "id": "150310401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What a great haul! A bunch of Seeing Eyes and this thing the weasel used to spew out fire!",
            "nextDialogs": [
              "150310402"
            ]
          },
          "150310402": {
            "id": "150310402",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "I think that's its back armor! It shoots out phlogiston, so it can pretty much attack from all directions.",
            "nextDialogs": [
              "150310403"
            ]
          },
          "150310403": {
            "id": "150310403",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "My dad told me about them once — creatures that live in the volcano. I can't believe we actually ran into one!",
            "nextDialogs": [
              "150310404"
            ]
          },
          "150310404": {
            "id": "150310404",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "This piece of armor might produce even higher temperatures than the Seeing Eyes. Hehe, we'll get those mushrooms super hot this time!",
            "nextDialogs": [
              "150310405"
            ]
          },
          "150310405": {
            "id": "150310405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Nice fighting back there, by the way.",
            "nextDialogs": [
              "150310406"
            ]
          },
          "150310406": {
            "id": "150310406",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "Oh, well... Even though I don't like fighting, sometimes, you don't have a choice. So, I've tried to figure out a bunch of different ways to get myself in the zone.",
            "nextDialogs": [
              "150310407"
            ]
          },
          "150310407": {
            "id": "150310407",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "For example, I've read a lot of stories about heroes, and my favorite hero has always been Fietena — the one I mentioned before.",
            "nextDialogs": [
              "150310408"
            ]
          },
          "150310408": {
            "id": "150310408",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "Fietena's most iconic feature was her mask, so I decided to make one just like hers.",
            "nextDialogs": [
              "150310409"
            ]
          },
          "150310409": {
            "id": "150310409",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "So, now, whenever I wear the mask, it's like there's a little piece of her with me. If I want to honor her legacy, I have no choice but to be brave.",
            "nextDialogs": [
              "150310410"
            ]
          },
          "150310410": {
            "id": "150310410",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "At the same time, though... I guess it's kind of like a crutch. Kind of like, I'm hiding behind her strength.",
            "nextDialogs": [
              "150310411"
            ]
          },
          "150310411": {
            "id": "150310411",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, you really think so?",
            "nextDialogs": [
              "150310414"
            ]
          },
          "150310414": {
            "id": "150310414",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "Really? It's just...",
            "nextDialogs": [
              "150310415"
            ]
          },
          "150310415": {
            "id": "150310415",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "I feel like... I need to take it off one day and face things alone.",
            "nextDialogs": [
              "150310416"
            ]
          },
          "150310416": {
            "id": "150310416",
            "speakerId": 1098,
            "speakerName": "Varesa",
            "text": "But, the longer I put off taking that step, the more impossible it feels. I... don't know if I have it in me."
          }
        }
      }
    }
  ]
}
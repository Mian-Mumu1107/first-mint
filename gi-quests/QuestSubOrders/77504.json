        "dialogs": {
          "775040101": {
            "id": "775040101",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Hm? More fresh recruits?",
            "nextDialogs": [
              "775040102"
            ]
          },
          "775040102": {
            "id": "775040102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Fresh recruits? Is she talking about us?",
            "nextDialogs": [
              "775040103"
            ]
          },
          "775040103": {
            "id": "775040103",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "You don't dress like locals, and you've been poking around nearby... Friends of Little Pinecone and Wood Figure, are you?",
            "nextDialogs": [
              "775040104"
            ]
          },
          "775040104": {
            "id": "775040104",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Actually, never mind! Welcome to Morepesok's \"Mutual Aid Advancement Network\"!",
            "nextDialogs": [
              "775040105"
            ]
          },
          "775040105": {
            "id": "775040105",
            "speakerId": 1002,
            "speakerName": "Chichikova",
            "text": "You're in capable hands now — the hands of Chichikova, blessed by Lady Katheryne, recognized by Talalikhin, and favored by the \"New Edge\"!",
            "nextDialogs": [
              "775040106"
            ]
          },
          "775040106": {
            "id": "775040106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Mutual Aid... Advancement Network? Paimon's never heard of that one before...",
            "nextDialogs": [
              "775040107"
            ]
          },
          "775040107": {
            "id": "775040107",
            "speakerId": 1002,
            "speakerName": "Chichikova",
            "text": "It's exactly what it sounds like! We're a group that helps people train, improve, and get stronger together.",
            "nextDialogs": [
              "775040108"
            ]
          },
          "775040108": {
            "id": "775040108",
            "speakerId": 1002,
            "speakerName": "Chichikova",
            "text": "If you've got the ambition to make your mark on the world, then come along with us!",
            "nextDialogs": [
              "775040111"
            ]
          },
          "775040111": {
            "id": "775040111",
            "speakerId": 1002,
            "speakerName": "Chichikova",
            "text": "Then come with me. I'll introduce you to the others.",
            "nextDialogs": [
              "775040112"
            ]
          },
          "775040112": {
            "id": "775040112",
            "speakerId": 1002,
            "speakerName": "Chichikova",
            "text": "We're just about to start this round of activities, so you arrived at the perfect time!",
            "nextDialogs": [
              "775040113"
            ]
          },
          "775040113": {
            "id": "775040113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, wait a second! Why'd you run with that so quickly?",
            "nextDialogs": [
              "775040114"
            ]
          },
          "775040114": {
            "id": "775040114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon knows you're not one to brag, but are we seriously doing the whole \"new recruits\" act?"
          }
        }
      }

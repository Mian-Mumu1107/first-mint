        ],
        "dialogs": {
          "191211501": {
            "id": "191211501",
            "speakerId": 12237,
            "speakerName": "Masanobu",
            "text": "Greetings, welcome to the Yashiro Commission.",
            "nextDialogs": [
              "191211502"
            ]
          },
          "191211502": {
            "id": "191211502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Thoma...",
            "nextDialogs": [
              "191211503"
            ]
          },
          "191211503": {
            "id": "191211503",
            "speakerId": 12237,
            "speakerName": "Masanobu",
            "text": "People have been talking about him behind his back? Surely not.",
            "nextDialogs": [
              "191211504"
            ]
          },
          "191211504": {
            "id": "191211504",
            "speakerId": 12237,
            "speakerName": "Masanobu",
            "text": "He does a wonderful job and always remains modest about it. Why would anyone single him out?",
            "nextDialogs": [
              "191211505"
            ]
          },
          "191211505": {
            "id": "191211505",
            "speakerId": 12237,
            "speakerName": "Masanobu",
            "text": "Huh, I can't figure it out. Try asking someone else."
          }
        }
      }
    },

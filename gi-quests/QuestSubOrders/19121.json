    {
      "subId": "1912114",
      "subQuestName": "Go with Thoma to see Sakai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191211401"
        ],
        "dialogs": {
          "191211401": {
            "id": "191211401",
            "speakerId": 12236,
            "speakerName": "Takashi",
            "text": "...You're asking me what I think Thoma could do better?",
            "nextDialogs": [
              "191211402"
            ]
          },
          "191211402": {
            "id": "191211402",
            "speakerId": 12236,
            "speakerName": "Takashi",
            "text": "He's busy enough as it is, don't you think? I barely see him around here at the Commission.",
            "nextDialogs": [
              "191211403"
            ]
          },
          "191211403": {
            "id": "191211403",
            "speakerId": 12236,
            "speakerName": "Takashi",
            "text": "And when I do, more often than not, he's busy with the housework.",
            "nextDialogs": [
              "191211404"
            ]
          },
          "191211404": {
            "id": "191211404",
            "speakerId": 12236,
            "speakerName": "Takashi",
            "text": "I think he should carry on doing what he's doing. Everyone's got their own way of living, and Thoma's no different."
          }
        }
      }
    },

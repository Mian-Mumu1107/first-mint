              "790490103"
            ]
          },
          "790490103": {
            "id": "790490103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, it seems not only had he found landscapes he loved in the Veluriyam Mirage, but also made friends with Water Droplets and found some new inspirations for his paintings!",
            "nextDialogs": [
              "790490106"
            ]
          },
          "790490106": {
            "id": "790490106",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eek! Now that you mention it, Paimon's heard of some people that go nuts after a failure! They just keep trying harder and harder until they lose themselves...",
            "nextDialogs": [
              "790490107"
            ]
          },
          "790490107": {
            "id": "790490107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Thanks to the painting tools Idyia provided and the company of the Water Droplets, he stayed on the right track!"
          }

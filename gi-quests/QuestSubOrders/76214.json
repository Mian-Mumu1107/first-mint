    {
      "subId": "7621402",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762140201"
        ],
        "dialogs": {
          "762140201": {
            "id": "762140201",
            "speakerId": 1001,
            "speakerName": "Miss Tabby",
            "text": "...Meow. Your swordsmanship... leaves quite the impression.",
            "nextDialogs": [
              "762140209"
            ]
          },
          "762140209": {
            "id": "762140209",
            "speakerId": 1001,
            "speakerName": "Miss Tabby",
            "text": "My thanks to you, esteemed knight from lands afar. Those arrogant brutes won't be troubling my people's homes ever again.",
            "nextDialogs": [
              "762140210"
            ]
          },
          "762140210": {
            "id": "762140210",
            "speakerId": 1001,
            "speakerName": "Miss Tabby",
            "text": "Now then... what brings you to my court?",
            "nextDialogs": [
              "762140203",
              "762140205"
            ]
          },
          "762140203": {
            "id": "762140203",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Um... Since this is a fairy tale, this must also be part of that fairy tale world, then?",
            "nextDialogs": [
              "762140206"
            ]
          },
          "762140206": {
            "id": "762140206",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "On behalf of Mr. Gray Cat, you extend an invitation to his tea party to the lady tabby...",
            "nextDialogs": [
              "762140207"
            ]
          },
          "762140207": {
            "id": "762140207",
            "speakerId": 1001,
            "speakerName": "Miss Tabby",
            "text": "...",
            "nextDialogs": [
              "762140208"
            ]
          },
          "762140208": {
            "id": "762140208",
            "speakerId": 1001,
            "speakerName": "Miss Tabby",
            "text": "...I understand, and you have my thanks, esteemed knight from lands afar. I shall heed your wise counsel and set forth at once."
          },
          "762140205": {
            "id": "762140205",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ahem, someone sure came around fast! Guess you just mind the local ways when \"abroad\"..."
          }
        }
      }
    },
    {
      "subId": "7621403",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762140301"
        ],
        "dialogs": {
          "762140301": {
            "id": "762140301",
            "speakerId": 1004,
            "speakerName": "Miss Lady Poodle",
            "text": "#Woof? What is it, {M#Mr.}{F#Miss} Golden Traveler? Is there something I can help you with?",
            "nextDialogs": [
              "762140302"
            ]
          },
          "762140302": {
            "id": "762140302",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "On behalf of Mr. Gray Cat, you extend an invitation to his tea party to Miss Lady Poodle...",
            "nextDialogs": [
              "762140303"
            ]
          },
          "762140303": {
            "id": "762140303",
            "speakerId": 1004,
            "speakerName": "Miss Lady Poodle",
            "text": "Oh? Is it time already?",
            "nextDialogs": [
              "762140304"
            ]
          },
          "762140304": {
            "id": "762140304",
            "speakerId": 1004,
            "speakerName": "Miss Lady Poodle",
            "text": "Thank you, woof! If I weren't so busy, I'd have gone to invite Miss Tabby myself... If I'd done that, perhaps Mr. Gray Cat might have...",
            "nextDialogs": [
              "762140305"
            ]
          },
          "762140305": {
            "id": "762140305",
            "speakerId": 1004,
            "speakerName": "Miss Lady Poodle",
            "text": "Cat or dog, we are all capable of getting along in peace... Yes, we can. Anyway, I should head to the tea party now. Thank you for the reminder!"
          }
        }
      }
    },
    {
      "subId": "7621404",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762140401"
        ],
        "dialogs": {
          "762140401": {
            "id": "762140401",
            "speakerId": 1000,
            "speakerName": "Mr. Gray Cat",
            "text": "#Meow! Everyone is finally here, meow! Thanks to you, {M#Mr.}{F#Miss} Golden Traveler, our happy tea party can finally begin, meow!",
            "nextDialogs": [
              "762140402"
            ]
          },
          "762140402": {
            "id": "762140402",
            "speakerId": 1001,
            "speakerName": "Miss Tabby",
            "text": "...",
            "nextDialogs": [
              "762140403"
            ]
          },
          "762140403": {
            "id": "762140403",
            "speakerId": 1004,
            "speakerName": "Miss Lady Poodle",
            "text": "Why the long face, Miss Tabby? Have something sweet, and you'll find your spirits lifting in no time!"
          }
        }
      }
    }
  ]

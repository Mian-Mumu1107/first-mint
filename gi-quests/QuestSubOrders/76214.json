  "subQuests": [
    {
      "subId": "7621401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762140101"
        ],
        "dialogs": {
          "762140101": {
            "id": "762140101",
            "speakerId": 1000,
            "speakerName": "Mr. Gray Cat",
            "text": "Meow... It's already time for the tea party, meow. I wonder if they're lost, meow...",
            "nextDialogs": [
              "762140102"
            ]
          },
          "762140102": {
            "id": "762140102",
            "speakerId": 1000,
            "speakerName": "Mr. Gray Cat",
            "text": "#Oh, it's you, {M#Mr.}{F#Miss} Golden Traveler. You must be the chosen hero, meow! Would you help me look for my friends?",
            "nextDialogs": [
              "762140106",
              "762140105"
            ]
          },
          "762140106": {
            "id": "762140106",
            "speakerId": 1000,
            "speakerName": "Mr. Gray Cat",
            "text": "Oh, and of the two ladies who aren't here yet, one is a kitty that can talk just like me. But unlike me, she's an orange tabby, meow.",
            "nextDialogs": [
              "762140107"
            ]
          },
          "762140107": {
            "id": "762140107",
            "speakerId": 1000,
            "speakerName": "Mr. Gray Cat",
            "text": "My other friend is a very polite lady poodle. A canine, true, but a most genteel one nevertheless, meow.",
            "nextDialogs": [
              "762140108"
            ]
          },
          "762140108": {
            "id": "762140108",
            "speakerId": 1000,
            "speakerName": "Mr. Gray Cat",
            "text": "Even though one of them's a cat and the other, a dog, whenever we sit down for tea together, we always have a wonderful time, meow!",
            "nextDialogs": [
              "762140109"
            ]
          },
          "762140109": {
            "id": "762140109",
            "speakerId": 1000,
            "speakerName": "Mr. Gray Cat",
            "text": "Please, for the peace of Meouranopolis, lend me a paw, meow!"
          },
          "762140105": {
            "id": "762140105",
            "speakerId": 1000,
            "speakerName": "Mr. Gray Cat",
            "text": "Oh, let's not quibble too much over the details, meow. If you already have the holy sword of legend, a hero is a hero, whether you find the Pure Grail they speak of or not, meow."
          }
        }
      }
    },
    {
      "subId": "7621406",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762140601"
        ],
        "dialogs": {
          "762140601": {
            "id": "762140601",
            "speakerId": 1000,
            "speakerName": "Mr. Gray Cat",
            "text": "This is where we agreed to meet... but my friends still haven't arrived, meow.",
            "nextDialogs": [
              "762140602"
            ]
          },
          "762140602": {
            "id": "762140602",
            "speakerId": 1000,
            "speakerName": "Mr. Gray Cat",
            "text": "Our chosen hero, would you mind helping me look around for them?"
          }
        }
      }
    },

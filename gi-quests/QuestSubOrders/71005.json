    {
      "subId": "7100503",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710050301"
        ],
        "dialogs": {
          "710050301": {
            "id": "710050301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Could you help us look at this antique?",
            "nextDialogs": [
              "710050302"
            ]
          },
          "710050302": {
            "id": "710050302",
            "speakerId": 1002,
            "speakerName": "Bolai",
            "text": "Antiques and curios? I'm not too familiar with them, but I'll have a look.",
            "nextDialogs": [
              "710050303"
            ]
          },
          "710050303": {
            "id": "710050303",
            "speakerId": 1002,
            "speakerName": "Bolai",
            "text": "This ring... Huh, it's set with a jade gem, and one of good quality, too. Just the gem alone would be worth a sum.",
            "nextDialogs": [
              "710050304"
            ]
          },
          "710050304": {
            "id": "710050304",
            "speakerId": 1002,
            "speakerName": "Bolai",
            "text": "There's an inscription on it, too... \"Disaster runs rampant throughout the world , and all who live do so in agony...\" Where did you find this ring?",
            "nextDialogs": [
              "710050305"
            ]
          },
          "710050305": {
            "id": "710050305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "In a ruin near Cuijue Slope.",
            "nextDialogs": [
              "710050306"
            ]
          },
          "710050306": {
            "id": "710050306",
            "speakerId": 1002,
            "speakerName": "Bolai",
            "text": "Cuijue Slope, huh... Tsk tsk, what a shame. Jueyun Karst is so nearby, too...",
            "nextDialogs": [
              "710050307"
            ]
          },
          "710050307": {
            "id": "710050307",
            "speakerId": 1002,
            "speakerName": "Bolai",
            "text": "If this ring came from a ruin in Jueyun Karst, it would surely fetch a great price.",
            "nextDialogs": [
              "710050308"
            ]
          },
          "710050308": {
            "id": "710050308",
            "speakerId": 1002,
            "speakerName": "Bolai",
            "text": "Unfortunately, without any storied origin, this one's price falls a great deal. But it's of good quality. I'm sure someone would want it nonetheless.",
            "nextDialogs": [
              "710050309"
            ]
          },
          "710050309": {
            "id": "710050309",
            "speakerId": 1002,
            "speakerName": "Bolai",
            "text": "How about this? I'll offer you <color=#00E1FFFF>180,000 Mora</color> for this ring, with a few add-ons to boot. Would you sell it to me?"
          }
        }
      }
    },
    {

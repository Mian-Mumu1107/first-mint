  "subQuests": [
    {
      "subId": "7100501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710050101"
        ],
        "dialogs": {
          "710050101": {
            "id": "710050101",
            "speakerId": 1000,
            "speakerName": "Inscription",
            "text": "\"All the turmoils in the world have their root in human vice...\"",
            "nextDialogs": [
              "710050102"
            ]
          },
          "710050102": {
            "id": "710050102",
            "speakerId": 1000,
            "speakerName": "Inscription",
            "text": "\"Nine pillars we raise here to suppress conflict, that we may never again raise armies against each other...\""
          }
        }
      }
    },
    {
      "subId": "7100510",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710051001"
        ],
        "dialogs": {
          "710051001": {
            "id": "710051001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We have a deal.",
            "nextDialogs": [
              "710051002"
            ]
          },
          "710051002": {
            "id": "710051002",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "Well, here's the money, then. I'll take the ring in exchange.",
            "nextDialogs": [
              "710051003"
            ]
          },
          "710051003": {
            "id": "710051003",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "If you ever pick up any other antiques that you'd like to sell, feel free to come to me."
          }
        }
      }
    },
    {
      "subId": "7100509",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710050901"
        ],
        "dialogs": {
          "710050901": {
            "id": "710050901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Could you help us look at this antique?",
            "nextDialogs": [
              "710050902"
            ]
          },
          "710050902": {
            "id": "710050902",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "An antique? Well, you've come to the right person. I'd say that I'm the fairest at valuating such things in all of Liyue. Let's see it.",
            "nextDialogs": [
              "710050903"
            ]
          },
          "710050903": {
            "id": "710050903",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "Hmm, both the gemstone and the band are of fine quality, and it is very ancient... Yet it is very well-preserved — highly unusual.",
            "nextDialogs": [
              "710050904"
            ]
          },
          "710050904": {
            "id": "710050904",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "Still, I can't say I've ever heard the phrase \"Disaster runs rampant throughout the world , and all who live do so in agony.\"",
            "nextDialogs": [
              "710050905"
            ]
          },
          "710050905": {
            "id": "710050905",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "Never mind that. Where did you find this ring?",
            "nextDialogs": [
              "710050906"
            ]
          },
          "710050906": {
            "id": "710050906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "In a ruin near Cuijue Slope.",
            "nextDialogs": [
              "710050907"
            ]
          },
          "710050907": {
            "id": "710050907",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "You... You're a fair hand at this, aren't you? Not many dare to go there to hunt for treasure.",
            "nextDialogs": [
              "710050908"
            ]
          },
          "710050908": {
            "id": "710050908",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "Were those ruins surrounded by nine pillars, with a stone tablet in the center, by any chance?",
            "nextDialogs": [
              "710050909"
            ]
          },
          "710050909": {
            "id": "710050909",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "Don't look so surprised. I've heard many people who come to do business with me mention that place. They always say that such a large formation must have some sort of treasure within.",
            "nextDialogs": [
              "710050910"
            ]
          },
          "710050910": {
            "id": "710050910",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "They even say that those pillars and that ruin were built by Liyue's forebears in order to quell conflict...",
            "nextDialogs": [
              "710050911"
            ]
          },
          "710050911": {
            "id": "710050911",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "But I suppose that's just a legend. After all, if nine stone pillars could quell strife, this world would have been at peace long ago.",
            "nextDialogs": [
              "710050912"
            ]
          },
          "710050912": {
            "id": "710050912",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "But regardless of whether this legend is true or not, this ring was found in that ruin, and has to be related to that legend.",
            "nextDialogs": [
              "710050913"
            ]
          },
          "710050913": {
            "id": "710050913",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "It's got a name, a history to go with it, and it's of good quality, too. It'll fetch a fine price.",
            "nextDialogs": [
              "710050914"
            ]
          },
          "710050914": {
            "id": "710050914",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "...Relax, I'm not going to ask how you got in there. I just do business. Other matters are none of my concern.",
            "nextDialogs": [
              "710050915"
            ]
          },
          "710050915": {
            "id": "710050915",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "All in all, I'd say this ring's worth <color=#00E1FFFF>200,000 Mora</color>. What do you say?"
          }
        }
      }
    },
    {
      "subId": "7100508",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710050801"
        ],
        "dialogs": {
          "710050801": {
            "id": "710050801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Regarding that ring...",
            "nextDialogs": [
              "710050802"
            ]
          },
          "710050802": {
            "id": "710050802",
            "speakerId": 1001,
            "speakerName": "Linlang",
            "text": "Oh, you've considered the matter? Will you sell or not, then?"
          }
        }
      }
    },
    {
      "subId": "7100507",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710050701"
        ],
        "dialogs": {
          "710050701": {
            "id": "710050701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Regarding that ring...",
            "nextDialogs": [
              "710050702"
            ]
          },
          "710050702": {
            "id": "710050702",
            "speakerId": 1002,
            "speakerName": "Bolai",
            "text": "Have you considered it? Well then, are you willing to sell it to me?"
          }
        }
      }
    },
    {
      "subId": "7100505",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710050501"
        ],
        "dialogs": {
          "710050501": {
            "id": "710050501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let me give it a little thought...",
            "nextDialogs": [
              "710050502"
            ]
          },
          "710050502": {
            "id": "710050502",
            "speakerId": 1002,
            "speakerName": "Bolai",
            "text": "You... Well, alright. Give it some thought. Perhaps my offer isn't the best you've heard.",
            "nextDialogs": [
              "710050503"
            ]
          },
          "710050503": {
            "id": "710050503",
            "speakerId": 1002,
            "speakerName": "Bolai",
            "text": "But when it comes to business, I'll do right by you should you sell it to me.",
            "nextDialogs": [
              "710050504"
            ]
          },
          "710050504": {
            "id": "710050504",
            "speakerId": 1002,
            "speakerName": "Bolai",
            "text": "Think about it. This ring won't stop changing hands with me. If you sell it to me now, don't you think I'll let you in on any further transactions that take place down the line?",
            "nextDialogs": [
              "710050505"
            ]
          },
          "710050505": {
            "id": "710050505",
            "speakerId": 1002,
            "speakerName": "Bolai",
            "text": "Moreover, I'm willing to add some things on, to boot...",
            "nextDialogs": [
              "710050506"
            ]
          },
          "710050506": {
            "id": "710050506",
            "speakerId": 1002,
            "speakerName": "Bolai",
            "text": "Think on it carefully, and come back to me anytime should you decide to sell!"
          }
        }
      }
    },
    {
      "subId": "7100504",
      "subQuestName": "",
      "sceneId": null,

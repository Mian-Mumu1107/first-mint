    {
      "subId": "7100512",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710051201"
        ],
        "dialogs": {
          "710051201": {
            "id": "710051201",
            "speakerId": 1000,
            "speakerName": "Inscription",
            "text": "\"Greed, nostalgia, vision, jealousy, anger, lust, self-aggrandizement, competition, turmoil...\"",
            "nextDialogs": [
              "710051202"
            ]
          },
          "710051202": {
            "id": "710051202",
            "speakerId": 1000,
            "speakerName": "Inscription",
            "text": "\"These nine mortal desires may heal the world, or do it great hurt. Their fire will never diminish, and it will never fade...Thus, we lay down nine pillars to bring peace, to end here the conflicts that plague this world.\"",
            "nextDialogs": [
              "710051203"
            ]
          },
          "710051203": {
            "id": "710051203",
            "speakerId": 1000,
            "speakerName": "Inscription",
            "text": "\"If one who comes after will break those pillars and enter, war shall once again consume the world.\"",
            "nextDialogs": [
              "710051204"
            ]
          },
          "710051204": {
            "id": "710051204",
            "speakerId": 1000,
            "speakerName": "Inscription",
            "text": "\"O you who read this tablet, claim the treasure that lies within, and bring peace to Liyue.\""
          }
        }
      }
    },

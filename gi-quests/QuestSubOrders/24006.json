{
  "lineCounts": {
    "Aurele": 14,
    "Black Screen": 1,
    "Lovi": 15,
    "Player": 9,
    "Verut": 18
  },
  "subQuests": [
    {
      "subId": "2400601",
      "subQuestName": "Talk to Verut",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240060101"
        ],
        "dialogs": {
          "240060101": {
            "id": "240060101",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "It's my turn to catch people, huh? I'll get you for sure, Lovi!",
            "nextDialogs": [
              "240060102"
            ]
          },
          "240060102": {
            "id": "240060102",
            "speakerId": 1001,
            "speakerName": "Lovi",
            "text": "I wouldn't be so sure! There's some places even you can't climb up to.",
            "nextDialogs": [
              "240060103"
            ]
          },
          "240060103": {
            "id": "240060103",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Well, um, that's because my shoes aren't suited to climbing. If I change shoes, I can definitely get you!",
            "nextDialogs": [
              "240060104"
            ]
          },
          "240060104": {
            "id": "240060104",
            "speakerId": 1001,
            "speakerName": "Lovi",
            "text": "Then let's both take our shoes off. That'll make things fair!",
            "nextDialogs": [
              "240060105"
            ]
          },
          "240060105": {
            "id": "240060105",
            "speakerId": 1002,
            "speakerName": "Aurele",
            "text": "Stop! You're both not allowed to run around barefoot. There's all sorts of abandoned bits and bobs everywhere. What if you get cut?",
            "nextDialogs": [
              "240060106"
            ]
          },
          "240060106": {
            "id": "240060106",
            "speakerId": 1001,
            "speakerName": "Lovi",
            "text": "Okay...",
            "nextDialogs": [
              "240060107"
            ]
          },
          "240060107": {
            "id": "240060107",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Fine...",
            "nextDialogs": [
              "240060108"
            ]
          },
          "240060108": {
            "id": "240060108",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Um, brother, when you were trying to catch me earlier, you were kinda distracted, weren't you? I ran past you earlier, and you didn't respond at all.",
            "nextDialogs": [
              "240060109"
            ]
          },
          "240060109": {
            "id": "240060109",
            "speakerId": 1002,
            "speakerName": "Aurele",
            "text": "Huh? Did that happen? I didn't notice...",
            "nextDialogs": [
              "240060110"
            ]
          },
          "240060110": {
            "id": "240060110",
            "speakerId": 1001,
            "speakerName": "Lovi",
            "text": "Exactly! I ran an entire round earlier, and you didn't seem to see me at all!",
            "nextDialogs": [
              "240060111"
            ]
          },
          "240060111": {
            "id": "240060111",
            "speakerId": 1002,
            "speakerName": "Aurele",
            "text": "But... Huh? It's you! Why are you here?",
            "nextDialogs": [
              "240060113",
              "240060116"
            ]
          },
          "240060113": {
            "id": "240060113",
            "speakerId": 1001,
            "speakerName": "Lovi",
            "text": "Dad said that he needed to go out to work. Mom has to work as well.",
            "nextDialogs": [
              "240060114"
            ]
          },
          "240060114": {
            "id": "240060114",
            "speakerId": 1001,
            "speakerName": "Lovi",
            "text": "Aurele happened to come to return a book, so Dad asked him to take care of me, so I came over to play with them.",
            "nextDialogs": [
              "240060118"
            ]
          },
          "240060118": {
            "id": "240060118",
            "speakerId": 1002,
            "speakerName": "Aurele",
            "text": "Never mind that, let's continue playing. Who's going to do the catching this time?"
          },
          "240060116": {
            "id": "240060116",
            "speakerId": 1002,
            "speakerName": "Aurele",
            "text": "Yes. Mr. Delerue happens to need to go on a business trip, and Aunt Dumay also needs to work, so they asked that I take care of Lovi.",
            "nextDialogs": [
              "240060117"
            ]
          },
          "240060117": {
            "id": "240060117",
            "speakerId": 1002,
            "speakerName": "Aurele",
            "text": "So I brought her here to play with us... I hope her dress won't get too dirty..."
          }
        }
      }
    },
    {
      "subId": "2400602",
      "subQuestName": "Find all the kids",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240060201"
        ],
        "dialogs": {
          "240060201": {
            "id": "240060201",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "So you found me anyway, huh? Guess you really are better at this.",
            "nextDialogs": [
              "240060202"
            ]
          },
          "240060202": {
            "id": "240060202",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "I'll head back to the meeting point. I hope my brother does better...",
            "nextDialogs": [
              "240060203"
            ]
          },
          "240060203": {
            "id": "240060203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why do you hope so?",
            "nextDialogs": [
              "240060204"
            ]
          },
          "240060204": {
            "id": "240060204",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Well, he did say it himself, didn't he? His brain works better after we play hide-and-seek.",
            "nextDialogs": [
              "240060205"
            ]
          },
          "240060205": {
            "id": "240060205",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "But he has too many thoughts, and he needs to squat on the ground, trying to recall and memorize them for a long time.",
            "nextDialogs": [
              "240060206"
            ]
          },
          "240060206": {
            "id": "240060206",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Lovi told me that those ideas of his are very precious things, and so we shouldn't disturb him.",
            "nextDialogs": [
              "240060207"
            ]
          },
          "240060207": {
            "id": "240060207",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "That's why when we're playing hide-and-seek with him, if we're about to catch him, we purposely take our time until he finishes collecting his thoughts.",
            "nextDialogs": [
              "240060208"
            ]
          },
          "240060208": {
            "id": "240060208",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "It's just that if it's my brother's turn to catch people, we'll have to wait for him for a long while..."
          }
        }
      }
    },
    {
      "subId": "2400603",
      "subQuestName": "Find all the kids",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240060301"
        ],
        "dialogs": {
          "240060301": {
            "id": "240060301",
            "speakerId": 1002,
            "speakerName": "Aurele",
            "text": "No... This logical sequence doesn't line up. I need to come at this from a different angle...",
            "nextDialogs": [
              "240060302"
            ]
          },
          "240060302": {
            "id": "240060302",
            "speakerId": 1002,
            "speakerName": "Aurele",
            "text": "How about... No, no...",
            "nextDialogs": [
              "240060303"
            ]
          },
          "240060303": {
            "id": "240060303",
            "speakerId": 1002,
            "speakerName": "Aurele",
            "text": "Huh? Oh. You found me. I'll head back to the meeting point, then.",
            "nextDialogs": [
              "240060304"
            ]
          },
          "240060304": {
            "id": "240060304",
            "speakerId": 1002,
            "speakerName": "Aurele",
            "text": "Is this point of view correct? No, it... Actually, is it right or wrong..."
          }
        }
      }
    },
    {
      "subId": "2400604",
      "subQuestName": "Find all the kids",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240060401"
        ],
        "dialogs": {
          "240060401": {
            "id": "240060401",
            "speakerId": 1001,
            "speakerName": "Lovi",
            "text": "I wonder if Aurele will be able to put his thoughts together...",
            "nextDialogs": [
              "240060402"
            ]
          },
          "240060402": {
            "id": "240060402",
            "speakerId": 1001,
            "speakerName": "Lovi",
            "text": "Uh, what? You actually found this place? Seriously, how many times have you played hide-and-seek?",
            "nextDialogs": [
              "240060403"
            ]
          },
          "240060403": {
            "id": "240060403",
            "speakerId": 1001,
            "speakerName": "Lovi",
            "text": "Well, I'll head back to the meeting point. I'll hide myself better next time!"
          }
        }
      }
    },
    {
      "subId": "2400606",
      "subQuestName": "Talk to Aurele",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240060601"
        ],
        "dialogs": {
          "240060601": {
            "id": "240060601",
            "speakerId": 1002,
            "speakerName": "Aurele",
            "text": "No, no... The argument is insufficiently rigorous here...",
            "nextDialogs": [
              "240060602"
            ]
          },
          "240060602": {
            "id": "240060602",
            "speakerId": 1001,
            "speakerName": "Lovi",
            "text": "Oh well, looks like Aurele's in his own world again. Anyway, thanks for playing with us again!",
            "nextDialogs": [
              "240060605"
            ]
          },
          "240060605": {
            "id": "240060605",
            "speakerId": 1001,
            "speakerName": "Lovi",
            "text": "As long as he doesn't start drinking coffee like water, as my dad did, he should be fine.",
            "nextDialogs": [
              "240060606"
            ]
          },
          "240060606": {
            "id": "240060606",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "Leave that one to me! I won't let my brother drink too much coffee... If it really comes down to it, I'll hide all of his coffee from him.",
            "nextDialogs": [
              "240060607"
            ]
          },
          "240060607": {
            "id": "240060607",
            "speakerId": 1001,
            "speakerName": "Lovi",
            "text": "*sigh* I was planning to hide my dad's coffee here... But I guess that's a bust.",
            "nextDialogs": [
              "240060608"
            ]
          },
          "240060608": {
            "id": "240060608",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "It sure is tough being a reviewer..."
          }
        }
      }
    },
    {
      "subId": "2400699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240069901"
        ],
        "dialogs": {
          "240069901": {
            "id": "240069901",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "You can't find me... You can't find me...",
            "nextDialogs": [
              "240069902"
            ]
          },
          "240069902": {
            "id": "240069902",
            "speakerId": 1001,
            "speakerName": "Lovi",
            "text": "That Aurele, honestly...",
            "nextDialogs": [
              "240069903"
            ]
          },
          "240069903": {
            "id": "240069903",
            "speakerId": 1002,
            "speakerName": "Aurele",
            "text": "This passage isn't too bad...",
            "nextDialogs": [
              "240069904"
            ]
          },
          "240069904": {
            "id": "240069904",
            "speakerId": 1000,
            "speakerName": "Verut",
            "text": "You can't catch me... You can't catch me...",
            "nextDialogs": [
              "240069905"
            ]
          },
          "240069905": {
            "id": "240069905",
            "speakerId": 1001,
            "speakerName": "Lovi",
            "text": "That Aurele..."
          }
        }
      }
    }
  ]
}
    {
      "subId": "2102706",
      "subQuestName": "Give the Slime Condensate to Little Meng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210270601"
        ],
        "dialogs": {
          "210270601": {
            "id": "210270601",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Wow, this recipe is so detailed... So many words...",
            "nextDialogs": [
              "210270602"
            ]
          },
          "210270602": {
            "id": "210270602",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm. You know what? Paimon gets the feeling that it won't quite be a pleasant surprise if it's this simple.",
            "nextDialogs": [
              "210270603"
            ]
          },
          "210270603": {
            "id": "210270603",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Eh? Then what should we do?",
            "nextDialogs": [
              "210270604"
            ]
          },
          "210270604": {
            "id": "210270604",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why don't we... add some unique ingredients into the mix?",
            "nextDialogs": [
              "210270605"
            ]
          },
          "210270605": {
            "id": "210270605",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What should we add, though?"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2102701",
      "subQuestName": "Talk to Little Meng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210270101"
        ],
        "dialogs": {
          "210270101": {
            "id": "210270101",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "You're just in time, Traveler! I was just looking for you!",
            "nextDialogs": [
              "210270102"
            ]
          },
          "210270102": {
            "id": "210270102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh? What's up, Little Meng?",
            "nextDialogs": [
              "210270103"
            ]
          },
          "210270103": {
            "id": "210270103",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Do you remember when I asked you to help me send a drifting bottle downriver with my worries in it?",
            "nextDialogs": [
              "210270104"
            ]
          },
          "210270104": {
            "id": "210270104",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "I honestly wasn't holding out much hope...",
            "nextDialogs": [
              "210270105"
            ]
          },
          "210270105": {
            "id": "210270105",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "But then, one of my father's business partners came looking for him a few days ago.",
            "nextDialogs": [
              "210270106"
            ]
          },
          "210270106": {
            "id": "210270106",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "He said that they're currently looking to get into the mushroom business, and are planning to go to Sumeru to survey the market.",
            "nextDialogs": [
              "210270107"
            ]
          },
          "210270107": {
            "id": "210270107",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "So they wanted to ask my dad if he wanted to go with them.",
            "nextDialogs": [
              "210270108"
            ]
          },
          "210270108": {
            "id": "210270108",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "They even said that they could take me along!",
            "nextDialogs": [
              "210270109"
            ]
          },
          "210270109": {
            "id": "210270109",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Dad didn't agree at first, but one of his friends pulled out a letter and asked to speak privately with him.",
            "nextDialogs": [
              "210270110"
            ]
          },
          "210270110": {
            "id": "210270110",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "They talked for a while, and after that, Dad said that I could go with him to Sumeru...",
            "nextDialogs": [
              "210270111"
            ]
          },
          "210270111": {
            "id": "210270111",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Well, I don't know why he changed his mind so suddenly, but...",
            "nextDialogs": [
              "210270112"
            ]
          },
          "210270112": {
            "id": "210270112",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "I can go to Sumeru now! We're going to Sumeru! Woohoo!",
            "nextDialogs": [
              "210270114",
              "210270116"
            ]
          },
          "210270114": {
            "id": "210270114",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "It must be that drifting bottle we sent, I just know it! Thank you so much, Traveler!",
            "nextDialogs": [
              "210270117"
            ]
          },
          "210270117": {
            "id": "210270117",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Dad said that after going to Sumeru, they'll also go to a place called Qiaoying Village.",
            "nextDialogs": [
              "210270118"
            ]
          },
          "210270118": {
            "id": "210270118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Qiaoying Village?",
            "nextDialogs": [
              "210270119"
            ]
          },
          "210270119": {
            "id": "210270119",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Yup. Dad says it's a tea village where they plant lots of tea trees that produce super high-quality tea leaves. The name's a bit of a toughie, though...",
            "nextDialogs": [
              "210270120"
            ]
          },
          "210270120": {
            "id": "210270120",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Well, but let's put that aside for now. We'll need to get to Sumeru first.",
            "nextDialogs": [
              "210270121"
            ]
          },
          "210270121": {
            "id": "210270121",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "It's really far from here, so it's going to take a while for us to get there.",
            "nextDialogs": [
              "210270122"
            ]
          },
          "210270122": {
            "id": "210270122",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "But I've heard people say that traveling requires a lot of preparations, since you could encounter all kinds of situations on the way.",
            "nextDialogs": [
              "210270123"
            ]
          },
          "210270123": {
            "id": "210270123",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "You're a frequent traveler, so... could you teach me a few tricks for life on the road?",
            "nextDialogs": [
              "210270124"
            ]
          },
          "210270124": {
            "id": "210270124",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Like, uh...",
            "nextDialogs": [
              "210270125"
            ]
          },
          "210270125": {
            "id": "210270125",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Like, what do you usually eat when you're out traveling?",
            "nextDialogs": [
              "210270126"
            ]
          },
          "210270126": {
            "id": "210270126",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Dad says that they would always eat stuff they made themselves. But I only know a few simple dishes, and I don't know if I can do them well or not...",
            "nextDialogs": [
              "210270127"
            ]
          },
          "210270127": {
            "id": "210270127",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Ohohoho! Cooking! Now that's something we're experts at, huh, {NICKNAME}?"
          },
          "210270116": {
            "id": "210270116",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Really? Then let's meet there!"
          }
        }
      }
    },
    {
      "subId": "2102702",
      "subQuestName": "Teach Little Meng how to cook",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210270201"
        ],
        "dialogs": {
          "210270201": {
            "id": "210270201",
            "speakerId": 1002,
            "speakerName": "Chef Mao",
            "text": "Oh, if it isn't the Traveler and Little Meng! Do you need anything?",
            "nextDialogs": [
              "210270202"
            ]
          },
          "210270202": {
            "id": "210270202",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Eh? I, uh, um... Traveler...",
            "nextDialogs": [
              "210270203"
            ]
          },
          "210270203": {
            "id": "210270203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'd like to borrow your kitchen, please.",
            "nextDialogs": [
              "210270204"
            ]
          },
          "210270204": {
            "id": "210270204",
            "speakerId": 1002,
            "speakerName": "Chef Mao",
            "text": "Sure, but that's a little sudden of you...",
            "nextDialogs": [
              "210270205"
            ]
          },
          "210270205": {
            "id": "210270205",
            "speakerId": 1002,
            "speakerName": "Chef Mao",
            "text": "Oh. Is that how it is... Alright, use it as you please.",
            "nextDialogs": [
              "210270206"
            ]
          },
          "210270206": {
            "id": "210270206",
            "speakerId": 1002,
            "speakerName": "Chef Mao",
            "text": "Little Meng, remember not to be picky with your food while you're out traveling.",
            "nextDialogs": [
              "210270207"
            ]
          },
          "210270207": {
            "id": "210270207",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "I—I got it...",
            "nextDialogs": [
              "210270208"
            ]
          },
          "210270208": {
            "id": "210270208",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Traveler, please teach me how to make something really tasty.",
            "nextDialogs": [
              "210270209"
            ]
          },
          "210270209": {
            "id": "210270209",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "I'd like to give Dad a surprise while we're on the road.",
            "nextDialogs": [
              "210270210"
            ]
          },
          "210270210": {
            "id": "210270210",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You got it!",
            "nextDialogs": [
              "210270211"
            ]
          },
          "210270211": {
            "id": "210270211",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Now then, {NICKNAME}, what shall we make?"
          }
        }
      }
    },

{
  "lineCounts": {
    "A Third Person's Message": 1,
    "Another Person's Message": 1,
    "Message": 22,
    "Owner's Reply": 18
  },
  "subQuests": [
    {
      "subId": "50501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050101"
        ],
        "dialogs": {
          "5050101": {
            "id": "5050101",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"Mr. Okazaki, when will the next shipment of Dandelion Wine arrive? Although the Sakoku Decree is very strict, given your status at the Commission, you must have a way, right?\"",
            "nextDialogs": [
              "5050102"
            ]
          },
          "5050102": {
            "id": "5050102",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Sorry, there is no such way.",
            "nextDialogs": [
              "5050103"
            ]
          },
          "5050103": {
            "id": "5050103",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "P.S: Can this type of question really be asked on a public message board like this...?"
          }
        }
      }
    },
    {
      "subId": "50502",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050201"
        ],
        "dialogs": {
          "5050201": {
            "id": "5050201",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"Go back and be a good public servant then, you idiot! I'll see you around!\"",
            "nextDialogs": [
              "5050202"
            ]
          },
          "5050202": {
            "id": "5050202",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Sorry, but my career in public service ended long ago. I can't really go back anymore.",
            "nextDialogs": [
              "5050203"
            ]
          },
          "5050203": {
            "id": "5050203",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"Sorry, I was not talking about you.\"",
            "nextDialogs": [
              "5050204"
            ]
          },
          "5050204": {
            "id": "5050204",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "..."
          }
        }
      }
    },
    {
      "subId": "50503",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050301"
        ],
        "dialogs": {
          "5050301": {
            "id": "5050301",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"Mr. Okazaki, thank you for the guidance and your explanations. It was quite enlightening. I shall certainly continue to support your business going forward.\"",
            "nextDialogs": [
              "5050302"
            ]
          },
          "5050302": {
            "id": "5050302",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Oh no no. It's quite an honor to receive such flattering words from the Tenryou Commissioner's strong right hand.",
            "nextDialogs": [
              "5050303"
            ]
          },
          "5050303": {
            "id": "5050303",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "If anything troubles you in the future, please do not hesitate to talk to me. I will do my best to help."
          }
        }
      }
    },
    {
      "subId": "50504",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050401"
        ],
        "dialogs": {
          "5050401": {
            "id": "5050401",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"Regarding the damage to the furniture caused by my drunk son a few days ago, I will pay for them in full. May the Kamisato Clan please accept my sincere apology.\"",
            "nextDialogs": [
              "5050402"
            ]
          },
          "5050402": {
            "id": "5050402",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "You are too kind, Sir Madarame. It was nothing."
          }
        }
      }
    },
    {
      "subId": "50505",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050501"
        ],
        "dialogs": {
          "5050501": {
            "id": "5050501",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"The Sakura wine and Sakura Mochi were excellent. Thank you for serving us.\"",
            "nextDialogs": [
              "5050502"
            ]
          },
          "5050502": {
            "id": "5050502",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "I should thank you for coming.",
            "nextDialogs": [
              "5050503"
            ]
          },
          "5050503": {
            "id": "5050503",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"I must say that the wine tasted a bit different tonight. Was that on purpose?\"",
            "nextDialogs": [
              "5050504"
            ]
          },
          "5050504": {
            "id": "5050504",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Thank you for trying the wine! It was indeed specially prepared by myself."
          }
        }
      }
    },
    {
      "subId": "50506",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050601"
        ],
        "dialogs": {
          "5050601": {
            "id": "5050601",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"The secret surveillance was pretty successful. You completely bluffed them, General Gorou! That said, I didn't drink because I looked too young... (contents deleted)\"",
            "nextDialogs": [
              "5050602"
            ]
          },
          "5050602": {
            "id": "5050602",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"You idiot! Now everyone in Inazuma knows (contents hurriedly scrubbed) is me, General Gorou!\"",
            "nextDialogs": [
              "5050603"
            ]
          },
          "5050603": {
            "id": "5050603",
            "speakerId": 1003,
            "speakerName": "A Third Person's Message",
            "text": "\"Please stop writing! This has to be part of the owner's scheme! He intentionally using the message board to lure you to reveal critical intel, exposing the whereabouts of the surveillance team. That's got to be it!\"",
            "nextDialogs": [
              "5050604"
            ]
          },
          "5050604": {
            "id": "5050604",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"It's okay as long as we have deleted the critical information, such as... (contents hurriedly scrubbed)\"",
            "nextDialogs": [
              "5050605"
            ]
          },
          "5050605": {
            "id": "5050605",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "In the end, nothing was removed..."
          }
        }
      }
    },
    {
      "subId": "50507",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050701"
        ],
        "dialogs": {
          "5050701": {
            "id": "5050701",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"I will be stationed at Tatarasuna starting tomorrow. It will be a difficult parting for me.\"",
            "nextDialogs": [
              "5050702"
            ]
          },
          "5050702": {
            "id": "5050702",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"I hope that my sister will manage the family business well, but the economy hasn't been doing well lately. It won't be easy for her.\"",
            "nextDialogs": [
              "5050703"
            ]
          },
          "5050703": {
            "id": "5050703",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"I wish that the war would be over soon so that I can come home to share the family responsibilities.\"",
            "nextDialogs": [
              "5050704"
            ]
          },
          "5050704": {
            "id": "5050704",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Lad, don't worry! I am sure that you will complete your responsibilities successfully, and that you will return home soon!"
          }
        }
      }
    },
    {
      "subId": "50508",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050801"
        ],
        "dialogs": {
          "5050801": {
            "id": "5050801",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"Tengu of the Kujou Clan, hear me! You'll pay for taking away my Vision! Don't you forget about our duel!\"",
            "nextDialogs": [
              "5050802"
            ]
          },
          "5050802": {
            "id": "5050802",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"I'll be waiting for you! Think long and hard about whom you've offended each time you come through this door!\"",
            "nextDialogs": [
              "5050803"
            ]
          },
          "5050803": {
            "id": "5050803",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Dear guest, although I don't know what Madam Kujou Sara has done to you, you are always welcome here to relax.",
            "nextDialogs": [
              "5050804"
            ]
          },
          "5050804": {
            "id": "5050804",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"Haha, of course! This is Mr. Okazaki's place after all!\""
          }
        }
      }
    },
    {
      "subId": "50509",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050901"
        ],
        "dialogs": {
          "5050901": {
            "id": "5050901",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"This will be our last visit. Thank you for having us, Mr. Okazaki. I hope we did not give you too much trouble.\"",
            "nextDialogs": [
              "5050902"
            ]
          },
          "5050902": {
            "id": "5050902",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "No need to thank me. I am always happy to look after young people.",
            "nextDialogs": [
              "5050903"
            ]
          },
          "5050903": {
            "id": "5050903",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"We will be taking some big risks. We may not return again.\"",
            "nextDialogs": [
              "5050904"
            ]
          },
          "5050904": {
            "id": "5050904",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Although you're doing this for your friends, allow me to remind you... that you still have much to live for.",
            "nextDialogs": [
              "5050905"
            ]
          },
          "5050905": {
            "id": "5050905",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"A lifetime of honor is nothing before a cup of fine wine.\"",
            "nextDialogs": [
              "5050906"
            ]
          },
          "5050906": {
            "id": "5050906",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Stop pretending! You still have another two years before you can drink legally."
          }
        }
      }
    },
    {
      "subId": "50510",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5051001"
        ],
        "dialogs": {
          "5051001": {
            "id": "5051001",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"When shall the spring flowers bloom? The worries in my mind are boundless.\"",
            "nextDialogs": [
              "5051002"
            ]
          },
          "5051002": {
            "id": "5051002",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "The remnants of snow on the tree branches do seem like flowers."
          }
        }
      }
    },
    {
      "subId": "50511",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5051101"
        ],
        "dialogs": {
          "5051101": {
            "id": "5051101",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"Finally, the Uyuu Restaurant once again, at last! Mr. Okazaki's as friendly as he ever was, and the wine's still excellent!\"",
            "nextDialogs": [
              "5051102"
            ]
          },
          "5051102": {
            "id": "5051102",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Haha, you are exaggerating, dear customer. By the way, it has been a while since I heard the stories of Haishan.",
            "nextDialogs": [
              "5051103"
            ]
          },
          "5051103": {
            "id": "5051103",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"'Good men don't brag about past valor,' Mr. Okazaki. Stop listening to my brothers when they talk about silly things!\"",
            "nextDialogs": [
              "5051104"
            ]
          },
          "5051104": {
            "id": "5051104",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Well, what is an old man to do, when you have never told any of those stories yourself?",
            "nextDialogs": [
              "5051105"
            ]
          },
          "5051105": {
            "id": "5051105",
            "speakerId": 1000,
            "speakerName": "Message",
            "text": "\"Haha, stop teasing me!\""
          }
        }
      }
    }
  ]
}
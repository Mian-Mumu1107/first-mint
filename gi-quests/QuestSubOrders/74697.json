  "subQuests": [
    {
      "subId": "7469701",
      "subQuestName": "Talk to Yumemizuki Mizuki",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746970101"
        ],
        "dialogs": {
          "746970101": {
            "id": "746970101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Isn't that Mizuki and her two mini baku? Are they talking to Barbeloth already?",
            "nextDialogs": [
              "746970102"
            ]
          },
          "746970102": {
            "id": "746970102",
            "speakerId": 1001,
            "speakerName": "Yumemizuki Mizuki",
            "text": "#{NICKNAME} and Paimon...? Lady Barbeloth was just talking about you. I was wondering if we might cross paths.",
            "nextDialogs": [
              "746970103"
            ]
          },
          "746970103": {
            "id": "746970103",
            "speakerId": 1001,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Hehe... It seems like fate has already arranged our meeting place.",
            "nextDialogs": [
              "746970104"
            ]
          },
          "746970104": {
            "id": "746970104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you here on holiday, Mizuki?",
            "nextDialogs": [
              "746970105"
            ]
          },
          "746970105": {
            "id": "746970105",
            "speakerId": 1001,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Hmm... I suppose you could say that. If the prep work for this educational film about psychology I'm doing goes smoothly, I should indeed have time for some leisure. Though until then, I still need to focus on my work.",
            "nextDialogs": [
              "746970108"
            ]
          },
          "746970108": {
            "id": "746970108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa, films can do that? That's amazing!",
            "nextDialogs": [
              "746970109"
            ]
          },
          "746970109": {
            "id": "746970109",
            "speakerId": 1001,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Mmhmm, it's a new idea I came up with. Back when I was promoting Aisa Bathhouse, I took inspiration from Fontainian cinema and recorded a few variety show episodes.",
            "nextDialogs": [
              "746970110"
            ]
          },
          "746970110": {
            "id": "746970110",
            "speakerId": 1001,
            "speakerName": "Yumemizuki Mizuki",
            "text": "People seemed to love it. Not only did they watch every episode, they even remembered all the psychological concepts we showcased.",
            "nextDialogs": [
              "746970111"
            ]
          },
          "746970111": {
            "id": "746970111",
            "speakerId": 1001,
            "speakerName": "Yumemizuki Mizuki",
            "text": "So I thought, why not make a few films about mental disorders as a fun and educational way to explain basic psychological concepts.",
            "nextDialogs": [
              "746970112"
            ]
          },
          "746970112": {
            "id": "746970112",
            "speakerId": 1001,
            "speakerName": "Yumemizuki Mizuki",
            "text": "...If I can raise everyone's basic awareness, perhaps people can develop a more objective understanding of what mental disorders are.",
            "nextDialogs": [
              "746970157"
            ]
          },
          "746970157": {
            "id": "746970157",
            "speakerId": 1001,
            "speakerName": "Yumemizuki Mizuki",
            "text": "...Perhaps I can stop people from blindly dismissing these conditions as made-up nonsense, or treating them like some terrifying bogeyman.",
            "nextDialogs": [
              "746970113"
            ]
          },
          "746970113": {
            "id": "746970113",
            "speakerId": 1001,
            "speakerName": "Yumemizuki Mizuki",
            "text": "And maybe my future therapy sessions will go a little more smoothly..."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7005801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700580101"
        ],
        "dialogs": {
          "700580101": {
            "id": "700580101",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "It's you. Long time no see.",
            "nextDialogs": [
              "700580102"
            ]
          },
          "700580102": {
            "id": "700580102",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "I was just preparing to release some Xiao Lanterns. Care to join me?",
            "nextDialogs": [
              "700580103"
            ]
          },
          "700580103": {
            "id": "700580103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure.",
            "nextDialogs": [
              "700580107",
              "700580106"
            ]
          },
          "700580107": {
            "id": "700580107",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "You walk with a carefree stride, and you're holding a Kamera. It's obvious that you came here to take pictures.",
            "nextDialogs": [
              "700580108"
            ]
          },
          "700580108": {
            "id": "700580108",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "This temple sits between mountains and rivers. It's a tranquil place.",
            "nextDialogs": [
              "700580109"
            ]
          },
          "700580109": {
            "id": "700580109",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Sometimes, visitors come here to paint, and sometimes I see the younger ones bring their Kameras with them.",
            "nextDialogs": [
              "700580110"
            ]
          },
          "700580110": {
            "id": "700580110",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "It just so happens that nobody else is here today, so don't worry about others disturbing your photography session.",
            "nextDialogs": [
              "700580111"
            ]
          },
          "700580111": {
            "id": "700580111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'd like to take a picture of you, Xiao.",
            "nextDialogs": [
              "700580112"
            ]
          },
          "700580112": {
            "id": "700580112",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "...Of me?",
            "nextDialogs": [
              "700580113"
            ]
          },
          "700580113": {
            "id": "700580113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We can keep it as a memento of you releasing your Xiao Lanterns.",
            "nextDialogs": [
              "700580114"
            ]
          },
          "700580114": {
            "id": "700580114",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "I just came to release them. I never considered keeping mementos.",
            "nextDialogs": [
              "700580115"
            ]
          },
          "700580115": {
            "id": "700580115",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Be that as it may, I think it's a good idea. We'll do as you suggest.",
            "nextDialogs": [
              "700580116"
            ]
          },
          "700580116": {
            "id": "700580116",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "In your opinion, how should I hold myself in this photo?"
          },
          "700580106": {
            "id": "700580106",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "I didn't know, but I can sense your scent."
          }
        }
      }
    }
  ]
}
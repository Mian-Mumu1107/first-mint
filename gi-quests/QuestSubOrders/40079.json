    {
      "subId": "4007951",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400795101"
        ],
        "dialogs": {
          "400795101": {
            "id": "400795101",
            "speakerId": 1001,
            "speakerName": "Razor",
            "text": "My heart, feels like, rotten berries. So sour.",
            "nextDialogs": [
              "400795102"
            ]
          },
          "400795102": {
            "id": "400795102",
            "speakerId": 1001,
            "speakerName": "Razor",
            "text": "I don't understand what I should do...",
            "nextDialogs": [
              "400795103"
            ]
          },
          "400795103": {
            "id": "400795103",
            "speakerId": 1003,
            "speakerName": "Lisa",
            "text": "Aw, alright. I'll teach you a very special magic trick that can make all your troubles disappear in the blink of an eye.",
            "nextDialogs": [
              "400795104"
            ]
          },
          "400795104": {
            "id": "400795104",
            "speakerId": 1003,
            "speakerName": "Lisa",
            "text": "But before we do that, let's warm up with something a little bit easier, hmm? Let's practice some talking.",
            "nextDialogs": [
              "400795105"
            ]
          },
          "400795105": {
            "id": "400795105",
            "speakerId": 1003,
            "speakerName": "Lisa",
            "text": "That way, the next time somebody helps you, or you have a different opinion from the rest of the group, you'll be able to express what you think clearly and precisely.",
            "nextDialogs": [
              "400795106"
            ]
          },
          "400795106": {
            "id": "400795106",
            "speakerId": 1001,
            "speakerName": "Razor",
            "text": "Okay!",
            "nextDialogs": [
              "400795107"
            ]
          },
          "400795107": {
            "id": "400795107",
            "speakerId": 1001,
            "speakerName": "Razor",
            "text": "I will do my best."
          }
        }
      }
    },

    {
      "subId": "7470501",
      "subQuestName": "Head near the aquarium tank",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747050101"
        ],
        "dialogs": {
          "747050101": {
            "id": "747050101",
            "speakerId": 1081,
            "speakerName": "Chevreuse",
            "text": "Hmm, I think... This one.",
            "nextDialogs": [
              "747050102"
            ]
          },
          "747050102": {
            "id": "747050102",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Yes, I see what you mean.",
            "nextDialogs": [
              "747050103"
            ]
          },
          "747050103": {
            "id": "747050103",
            "speakerId": 1082,
            "speakerName": "Chiori",
            "text": "Why that one?",
            "nextDialogs": [
              "747050104"
            ]
          },
          "747050104": {
            "id": "747050104",
            "speakerId": 1081,
            "speakerName": "Chevreuse",
            "text": "Look at the color of its tail. It's the most fashionable thing in the whole aquarium.",
            "nextDialogs": [
              "747050105"
            ]
          },
          "747050105": {
            "id": "747050105",
            "speakerId": 1082,
            "speakerName": "Chiori",
            "text": "The colors are a bit loud for my taste, but alright, I'll take it as a compliment.",
            "nextDialogs": [
              "747050106"
            ]
          },
          "747050106": {
            "id": "747050106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa! Look at all these people! Is everyone here to see the fish?",
            "nextDialogs": [
              "747050107"
            ]
          },
          "747050107": {
            "id": "747050107",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Mmhmm! I just wrapped up a scene, so I'm taking time out to admire your aquarium.",
            "nextDialogs": [
              "747050108"
            ]
          },
          "747050108": {
            "id": "747050108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What were you talking about just now?",
            "nextDialogs": [
              "747050109"
            ]
          },
          "747050109": {
            "id": "747050109",
            "speakerId": 1081,
            "speakerName": "Chevreuse",
            "text": "We were trying to decide which fish looks most like Chiori.",
            "nextDialogs": [
              "747050110"
            ]
          },
          "747050110": {
            "id": "747050110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You guys do that too!?",
            "nextDialogs": [
              "747050111"
            ]
          },
          "747050111": {
            "id": "747050111",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Oh, uh, hehe... Oh well, it was actually Columbina who mentioned it originally. It sounded like fun, and then, before we knew it, we were doing it too.",
            "nextDialogs": [
              "747050112"
            ]
          },
          "747050112": {
            "id": "747050112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So it's contagious...",
            "nextDialogs": [
              "747050113"
            ]
          },
          "747050113": {
            "id": "747050113",
            "speakerId": 1082,
            "speakerName": "Chiori",
            "text": "Oh, look! That one's just like you, Chevreuse.",
            "nextDialogs": [
              "747050114"
            ]
          },
          "747050114": {
            "id": "747050114",
            "speakerId": 1081,
            "speakerName": "Chevreuse",
            "text": "What do you mean?",
            "nextDialogs": [
              "747050115"
            ]
          },
          "747050115": {
            "id": "747050115",
            "speakerId": 1082,
            "speakerName": "Chiori",
            "text": "Never still, swimming laps around the tank. Just like you, training every second of the day!",
            "nextDialogs": [
              "747050116"
            ]
          },
          "747050116": {
            "id": "747050116",
            "speakerId": 1081,
            "speakerName": "Chevreuse",
            "text": "...Is that how you see me?"
          }
        }
      }
    }
  ]
}
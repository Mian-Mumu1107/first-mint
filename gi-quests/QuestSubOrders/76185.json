        "dialogs": {
          "761850201": {
            "id": "761850201",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "Tea tastes so much better when paired with useful intel...",
            "nextDialogs": [
              "761850202"
            ]
          },
          "761850202": {
            "id": "761850202",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "(Let's sit like this for a little while longer.)",
            "nextDialogs": [
              "761850204"
            ]
          },
          "761850204": {
            "id": "761850204",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "Oh, take care. And remember to drop by whenever you're free."
          }
        }

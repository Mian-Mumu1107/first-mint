  "subQuests": [
    {
      "subId": "7618501",
      "subQuestName": "Go to the Curatorium of Secrets to start the tea party",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761850101"
        ],
        "dialogs": {
          "761850101": {
            "id": "761850101",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "Mm, delicious tea and delectable snacks. Thank you for your hospitality, Miss Sandrone.",
            "nextDialogs": [
              "761850102"
            ]
          },
          "761850102": {
            "id": "761850102",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "I'm glad you like it. I also brought some snacks for Ashru. Isn't that right, Ashru? Come here. There's a good kitty.",
            "nextDialogs": [
              "761850103"
            ]
          },
          "761850103": {
            "id": "761850103",
            "speakerId": 1002,
            "speakerName": "Ashru",
            "text": "Meow~",
            "nextDialogs": [
              "761850104"
            ]
          },
          "761850104": {
            "id": "761850104",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "I hope your warm feelings for Nod-Krai and the Curatorium of Secrets will prove beneficial to our future cooperation.",
            "nextDialogs": [
              "761850105"
            ]
          },
          "761850105": {
            "id": "761850105",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "I hope so too. Here, Ashru, try one of these.",
            "nextDialogs": [
              "761850106"
            ]
          },
          "761850106": {
            "id": "761850106",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "Also, regarding that matter I enquired about before...",
            "nextDialogs": [
              "761850107"
            ]
          },
          "761850107": {
            "id": "761850107",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "Hehe, your little paws are so soft...",
            "nextDialogs": [
              "761850108"
            ]
          },
          "761850108": {
            "id": "761850108",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "...",
            "nextDialogs": [
              "761850109"
            ]
          },
          "761850109": {
            "id": "761850109",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "Miss Sandrone... Don't tell me you used this tea party as a pretext to come here and dote on my cat?",
            "nextDialogs": [
              "761850110"
            ]
          },
          "761850110": {
            "id": "761850110",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "Huh...? M—Me? I would never! I take my dealings with the Curatorium of Secrets very seriously!",
            "nextDialogs": [
              "761850111"
            ]
          },
          "761850111": {
            "id": "761850111",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "Ashru, come here.",
            "nextDialogs": [
              "761850112"
            ]
          },
          "761850112": {
            "id": "761850112",
            "speakerId": 1002,
            "speakerName": "Ashru",
            "text": "Meow~",
            "nextDialogs": [
              "761850113"
            ]
          },
          "761850113": {
            "id": "761850113",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "Aww...",
            "nextDialogs": [
              "761850114"
            ]
          },
          "761850114": {
            "id": "761850114",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "Then let's talk about the details of our \"dealings,\" shall we?",
            "nextDialogs": [
              "761850115"
            ]
          },
          "761850115": {
            "id": "761850115",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "...Hmph. S—So what if I wanted to pet Ashru... Who wouldn't!?",
            "nextDialogs": [
              "761850116"
            ]
          },
          "761850116": {
            "id": "761850116",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "Small animals are usually wary of machines. It took a lot of work to get Ashru to trust me when I was here working on the numerological array. What's so wrong with me wanting to give him a belly rub or two...",
            "nextDialogs": [
              "761850117"
            ]
          },
          "761850117": {
            "id": "761850117",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "Hah... No need to get so defensive.",
            "nextDialogs": [
              "761850118"
            ]
          },
          "761850118": {
            "id": "761850118",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "Go on, Ashru. It's not like it's my place to tell you who you can or can't rub up against.",
            "nextDialogs": [
              "761850119"
            ]
          },
          "761850119": {
            "id": "761850119",
            "speakerId": 1002,
            "speakerName": "Ashru",
            "text": "Meow~",
            "nextDialogs": [
              "761850120"
            ]
          },
          "761850120": {
            "id": "761850120",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "But once you're done petting him, don't forget we have business to discuss...",
            "nextDialogs": [
              "761850121"
            ]
          },
          "761850121": {
            "id": "761850121",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "Like I told you, I take our dealings very seriously!"
          }
        }
      }
    },
    {
      "subId": "7618502",
      "subQuestName": "Go to the Curatorium of Secrets to start the tea party",
      "sceneId": null,
      "locations": [],

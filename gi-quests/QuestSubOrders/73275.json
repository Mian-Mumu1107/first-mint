  "subQuests": [
    {
      "subId": "7327501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732750102"
        ],
        "dialogs": {
          "732750102": {
            "id": "732750102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Golden Roses have sprouted into seedlings, yes.",
            "nextDialogs": [
              "732750103"
            ]
          },
          "732750103": {
            "id": "732750103",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "These seeds... Where did you even find these seeds, I wonder?",
            "nextDialogs": [
              "732750104"
            ]
          },
          "732750104": {
            "id": "732750104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "From a far-off place.",
            "nextDialogs": [
              "732750105"
            ]
          },
          "732750105": {
            "id": "732750105",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Did you indeed? Well, I suppose that the seeds Uncle Shafaqat sowed really did find their way back here in the end after being spread to every corner of the desert — even if the path they took meandered quite a bit.",
            "nextDialogs": [
              "732750107"
            ]
          },
          "732750107": {
            "id": "732750107",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "We'll have to take good care of these seedlings — I intend to leave them to young Sabbah. Once I, too, am gone, these flowers shall pass on to her.",
            "nextDialogs": [
              "732750108"
            ]
          },
          "732750108": {
            "id": "732750108",
            "speakerId": 1000,
            "speakerName": "Affan",
            "text": "Thank you, child. There is little I can give you... but please accept these fruits and flowers."
          }
        }
      }
    },

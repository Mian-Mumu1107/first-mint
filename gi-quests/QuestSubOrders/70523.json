  "subQuests": [
    {
      "subId": "7052301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705230101"
        ],
        "dialogs": {
          "705230101": {
            "id": "705230101",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "Are you guys from out of town? Welcome to Qingce Village!",
            "nextDialogs": [
              "705230104"
            ]
          },
          "705230104": {
            "id": "705230104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon first! Paimon first! Let's introduce ourselves first!",
            "nextDialogs": [
              "705230105"
            ]
          },
          "705230105": {
            "id": "705230105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#This is the almighty Traveler, {NICKNAME}, and Paimon is this Traveler's best companion, Paimon.",
            "nextDialogs": [
              "705230106"
            ]
          },
          "705230106": {
            "id": "705230106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We are ordering specialty drinks from the Weinlesefest for out-of-town clients. We saw your commission, so we decided to come talk to you.",
            "nextDialogs": [
              "705230107"
            ]
          },
          "705230107": {
            "id": "705230107",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "Ah, I like how direct you are! Then I'll cut to the chase, too.",
            "nextDialogs": [
              "705230109"
            ]
          },
          "705230109": {
            "id": "705230109",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "I'm Chef Guanchui, and I need <color=#00E1FFFF>100 cases of \"Fruits of the Festival,\"</color> to make tea to help keep the spirits up for the guys doing manual labor.",
            "nextDialogs": [
              "705230110"
            ]
          },
          "705230110": {
            "id": "705230110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Okay! Before we get to work, please give us the funds.",
            "nextDialogs": [
              "705230111"
            ]
          },
          "705230111": {
            "id": "705230111",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "One step ahead of you. Please take these Fairbrew Jellies! After ordering, there will probably be some left over. Doesn't matter how much is left, please keep the change as reward for your hard work!",
            "nextDialogs": [
              "705230112"
            ]
          },
          "705230112": {
            "id": "705230112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We'll take it and be on our way!",
            "nextDialogs": [
              "705230113"
            ]
          },
          "705230113": {
            "id": "705230113",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "Right on! I await the good news from both of you!"
          }
        }
      }
    },
    {

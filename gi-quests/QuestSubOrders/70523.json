    {
      "subId": "7052302",
      "subQuestName": "Return to Springvale and place an order with Georg",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705230201"
        ],
        "dialogs": {
          "705230201": {
            "id": "705230201",
            "speakerId": 1002,
            "speakerName": "Georg",
            "text": "Oh! You're back?",
            "nextDialogs": [
              "705230202"
            ]
          },
          "705230202": {
            "id": "705230202",
            "speakerId": 1002,
            "speakerName": "Georg",
            "text": "Are you still helping to place orders for foreign clients?",
            "nextDialogs": [
              "705230203"
            ]
          },
          "705230203": {
            "id": "705230203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yup. This time we need 100 cases of \"Fruits of the Festival,\" for Guanchui, the chef of Qingce Village.",
            "nextDialogs": [
              "705230204"
            ]
          },
          "705230204": {
            "id": "705230204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We're ready to make an offer, Georg!",
            "nextDialogs": [
              "705230207"
            ]
          },
          "705230207": {
            "id": "705230207",
            "speakerId": 1002,
            "speakerName": "Georg",
            "text": "Oh! The ball's rolling! Let me see what you've got this time!"
          }
        }
      }
    },
    {
      "subId": "7052306",
      "subQuestName": "Negotiate with Georg",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705232601"
        ],
        "dialogs": {
          "705232601": {
            "id": "705232601",
            "speakerId": 1002,
            "speakerName": "Georg",
            "text": "Okay, just like last time, the documents will be given to you, and I will arrange the transportation.",
            "nextDialogs": [
              "705232602"
            ]
          },
          "705232602": {
            "id": "705232602",
            "speakerId": 1002,
            "speakerName": "Georg",
            "text": "Since he is a new customer, you'd better give him the receipt, so as to make him feel at ease.",
            "nextDialogs": [
              "705232603"
            ]
          },
          "705232603": {
            "id": "705232603",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You have a point. We thought so too!",
            "nextDialogs": [
              "705232604"
            ]
          },
          "705232604": {
            "id": "705232604",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Let's go, {NICKNAME}. Let's head back to Qingce Village and report back."
          }
        }
      }
    },
    {
      "subId": "7052303",
      "subQuestName": "Go to Qingce Village and respond to Guanchui's request",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705230301"
        ],
        "dialogs": {
          "705230301": {
            "id": "705230301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Guanchui, we're back!",
            "nextDialogs": [
              "705230302"
            ]
          },
          "705230302": {
            "id": "705230302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We've placed an order for your 100 cases of \"Fruits of the Festival.\" Here's your receipt.",
            "nextDialogs": [
              "705230303"
            ]
          },
          "705230303": {
            "id": "705230303",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "Amazing! You two have been a big help!",
            "nextDialogs": [
              "705230304"
            ]
          },
          "705230304": {
            "id": "705230304",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "I will study the \"Fruits of the Festival\" carefully and mix the fresh drink with the tea with a specific proportion. I'll bring out the flavor, so that the workers will be able to work harder!",
            "nextDialogs": [
              "705230305"
            ]
          },
          "705230305": {
            "id": "705230305",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh, sounds a bit like bartending, but with tea... Is that even possible?",
            "nextDialogs": [
              "705230306"
            ]
          },
          "705230306": {
            "id": "705230306",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "Don't worry, I used to be a chef when I was abroad for a while. This approach achieves the best balance between cost and taste, and I've made it many times!",
            "nextDialogs": [
              "705230307"
            ]
          },
          "705230307": {
            "id": "705230307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Makes me want to try it...",
            "nextDialogs": [
              "705230308"
            ]
          },
          "705230308": {
            "id": "705230308",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "The next time you guys come to Qingce Village, I'll treat you guys to the finished product.",
            "nextDialogs": [
              "705230309"
            ]
          },
          "705230309": {
            "id": "705230309",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Okay! Next time {NICKNAME} can try it!",
            "nextDialogs": [
              "705230310"
            ]
          },
          "705230310": {
            "id": "705230310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Best of luck, bartending chef!",
            "nextDialogs": [
              "705230311"
            ]
          },
          "705230311": {
            "id": "705230311",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "Thank you! Come back when you've got time!"
          }
        }
      }
    },
    {
      "subId": "7052304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705230401"
        ],
        "dialogs": {
          "705230401": {
            "id": "705230401",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "I can't think of a better specialty drink for this Weinlesefest than the tea brewed with the spring water from Qingce Village.",
            "nextDialogs": [
              "705230402"
            ]
          },
          "705230402": {
            "id": "705230402",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "Thank you, both of you!",
            "nextDialogs": [
              "705230404",
              "705230408",
              "705230416"
            ]
          },
          "705230404": {
            "id": "705230404",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "It hasn't been that long since I moved back to the farm with my brothers. Usually I am in charge of cooking for the boys who work in the field.",
            "nextDialogs": [
              "705230405"
            ]
          },
          "705230405": {
            "id": "705230405",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "But most of what I do is just simple and filling dishes, which are not quite suitable for out-of-town guests.",
            "nextDialogs": [
              "705230406"
            ]
          },
          "705230406": {
            "id": "705230406",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "Qingce Village is pretty quiet, but there is no shortage of good food. You can tell by just simply walking around!"
          },
          "705230408": {
            "id": "705230408",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "The boys working the field are often real thirsty, so thirsty that they end up going through a whole jug of tea in half a day.",
            "nextDialogs": [
              "705230409"
            ]
          },
          "705230409": {
            "id": "705230409",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "The distance between the tea shop and the fields is quite far. Going to and from is too much trouble.",
            "nextDialogs": [
              "705230410"
            ]
          },
          "705230410": {
            "id": "705230410",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "Pops Kai is getting a little long in the tooth to bring tea to the boys, so it's now down to me to bring it over.",
            "nextDialogs": [
              "705230411"
            ]
          },
          "705230411": {
            "id": "705230411",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "A couple of my companions and I went out of town for a while, and the big jug of tea was a little light for us. Sometimes, they wanted something a little stronger.",
            "nextDialogs": [
              "705230412"
            ]
          },
          "705230412": {
            "id": "705230412",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "So I added something to my tea to bring out a refreshing flavor and let the boys have a little bit of fun.",
            "nextDialogs": [
              "705230413"
            ]
          },
          "705230413": {
            "id": "705230413",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "Of course, I've only made enough for a couple brothers. Pops Kai still has a business to maintain!",
            "nextDialogs": [
              "705230414"
            ]
          },
          "705230414": {
            "id": "705230414",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "After taking a break, we would also go to Pops Kai's tea shop and help him with chores."
          },
          "705230416": {
            "id": "705230416",
            "speakerId": 1000,
            "speakerName": "Guanchui",
            "text": "Okay! I await the good news!"
          }
        }
      }
    },
    {
      "subId": "7052321",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705232101"
        ],
        "dialogs": {
          "705232101": {
            "id": "705232101",
            "speakerId": 1002,
            "speakerName": "Georg",
            "text": "No, no, that's too little! Even if the total number of the order is higher, the unit price per case shouldn't be this low."
          }
        }
      }
    },
    {
      "subId": "7052322",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705232201"
        ],
        "dialogs": {
          "705232201": {
            "id": "705232201",
            "speakerId": 1002,
            "speakerName": "Georg",
            "text": "Well, that's not a bad offer, but considering the difficulty of transportation to Qingce Village, it's still a tough one."
          }
        }
      }
    },
    {
      "subId": "7052323",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705232301"
        ],
        "dialogs": {
          "705232301": {
            "id": "705232301",
            "speakerId": 1002,
            "speakerName": "Georg",
            "text": "Deal! You two are fast learners. The second time we did business, we ended up in a win-win situation for everyone!"
          }
        }
      }
    },
    {
      "subId": "7052324",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705232401"
        ],
        "dialogs": {
          "705232401": {
            "id": "705232401",
            "speakerId": 1002,
            "speakerName": "Georg",
            "text": "Yup, you guys drive a hard bargain!"
          }
        }
      }
    },
    {
      "subId": "7052325",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705232501"
        ],
        "dialogs": {
          "705232501": {
            "id": "705232501",
            "speakerId": 1002,
            "speakerName": "Georg",
            "text": "Ah, I guess I've been underestimated! Let's agree on the price I asked for this time. Think of it as your fee for negotiation skills."
          }
        }
      }
    }
  ]
}
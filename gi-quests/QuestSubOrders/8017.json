  "subQuests": [
    {
      "subId": "801701",
      "subQuestName": "Return to the area near the cave to investigate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170101"
        ],
        "dialogs": {
          "80170101": {
            "id": "80170101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And we're back where we started. That hilichurl probably found the key nearby, right?",
            "nextDialogs": [
              "80170102"
            ]
          },
          "80170102": {
            "id": "80170102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's look around for clues. There's no time to waste — Iansan and Citlali are waiting for us!",
            "nextDialogs": [
              "80170103"
            ]
          },
          "80170103": {
            "id": "80170103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh... We've scoured the entire area, but still nothing. How the heck did the key end up in that hilichurl's hands?",
            "nextDialogs": [
              "80170104"
            ]
          },
          "80170104": {
            "id": "80170104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Are we supposed to believe that it just fell out of your {M#sister}{F#brother}'s pocket as {M#she}{F#he} passed by?",
            "nextDialogs": [
              "80170105"
            ]
          },
          "80170105": {
            "id": "80170105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hah. Seems kinda ludicrous to lose something so important in such a dumb way... But then again, who knows? Sometimes in life, things just go missing and that's that.",
            "nextDialogs": [
              "80170106"
            ]
          },
          "80170106": {
            "id": "80170106",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Ah! Thank goodness, someone's here... Please, help me!",
            "nextDialogs": [
              "80170107"
            ]
          },
          "80170107": {
            "id": "80170107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa! Who are you? What happened?",
            "nextDialogs": [
              "80170108"
            ]
          },
          "80170108": {
            "id": "80170108",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Uh...",
            "nextDialogs": [
              "80170109"
            ]
          },
          "80170109": {
            "id": "80170109",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Ah, ugh, no, now isn't the time...",
            "nextDialogs": [
              "80170110"
            ]
          },
          "80170110": {
            "id": "80170110",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Please, you gotta help me... I'm being chased by monsters, and I can't keep running. Can you do something?",
            "nextDialogs": [
              "80170113"
            ]
          },
          "80170113": {
            "id": "80170113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, where are they? Paimon doesn't see any monsters behind you...",
            "nextDialogs": [
              "80170114"
            ]
          },
          "80170114": {
            "id": "80170114",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Huh...? I'm sorry, I don't quite understand...",
            "nextDialogs": [
              "80170115"
            ]
          },
          "80170115": {
            "id": "80170115",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "They're almost here... This really isn't the time to be joking around...",
            "nextDialogs": [
              "80170116"
            ]
          },
          "80170116": {
            "id": "80170116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh... We're not... We're completely serious. We don't see any monsters.",
            "nextDialogs": [
              "80170117"
            ]
          },
          "80170117": {
            "id": "80170117",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "But how... Ugh, there's no time! They're coming. We gotta run!"
          }
        }
      }
    },
    {
      "subId": "801702",
      "subQuestName": "Defeat the monsters that appeared",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170201"
        ],
        "dialogs": {
          "80170201": {
            "id": "80170201",
            "speakerId": 15267,
            "speakerName": "Sutura",
            "text": "Wow! \"Tuma{RUBY#[S]Hope}ini,\" our hero! We've actually fought together before. You probably don't remember it though, hahaha...",
            "nextDialogs": [
              "80170203",
              "80170205"
            ]
          },
          "80170203": {
            "id": "80170203",
            "speakerId": 15267,
            "speakerName": "Sutura",
            "text": "You do? Then it's truly an honor to serve alongside you once more.",
            "nextDialogs": [
              "80170206"
            ]
          },
          "80170206": {
            "id": "80170206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Thank you for standing guard this whole time.",
            "nextDialogs": [
              "80170207"
            ]
          },
          "80170207": {
            "id": "80170207",
            "speakerId": 15267,
            "speakerName": "Sutura",
            "text": "It's all good! Honestly, it's not been that much work. Haven't heard a peep from the enemy.",
            "nextDialogs": [
              "80170208"
            ]
          },
          "80170208": {
            "id": "80170208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you seen anything out of the ordinary?",
            "nextDialogs": [
              "80170209"
            ]
          },
          "80170209": {
            "id": "80170209",
            "speakerId": 15267,
            "speakerName": "Sutura",
            "text": "Nothing that would indicate an impending attack. I've spotted a bunch of Abyss Order operatives, but they weren't acting hostile, just hanging around.",
            "nextDialogs": [
              "80170210"
            ]
          },
          "80170210": {
            "id": "80170210",
            "speakerId": 15267,
            "speakerName": "Sutura",
            "text": "There were even moments when they seemed to be meditating. At least, that's what it looked like to me. Maybe it's part of their religion, or something.",
            "nextDialogs": [
              "80170211"
            ]
          },
          "80170211": {
            "id": "80170211",
            "speakerId": 15267,
            "speakerName": "Sutura",
            "text": "Out of an abundance of caution, I asked some shamans from the tribe to take a look, and see if there was anything nefarious at work...",
            "nextDialogs": [
              "80170212"
            ]
          },
          "80170212": {
            "id": "80170212",
            "speakerId": 15267,
            "speakerName": "Sutura",
            "text": "But, they didn't sense anything untoward. So we just put it down to religious ceremony and left them to it.",
            "nextDialogs": [
              "80170213"
            ]
          },
          "80170213": {
            "id": "80170213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Interesting... Well, the more time they spend meditating, the less time they spend trying to beat us to a pulp."
          },
          "80170205": {
            "id": "80170205",
            "speakerId": 15267,
            "speakerName": "Sutura",
            "text": "Haha, that's to be expected! You took point, and I was much further back in the ranks. I saw you, though... You were a great inspiration to us all."
          }
        }
      }
    },
    {
      "subId": "801703",
      "subQuestName": "Talk to the girl attacked by the monster",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170301"
        ],
        "dialogs": {
          "80170301": {
            "id": "80170301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Umm? You done? Paimon still can't see anything, so she can't tell.",
            "nextDialogs": [
              "80170302"
            ]
          },
          "80170302": {
            "id": "80170302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It just looked like you were slicing at thin air. Kinda funny, actually...",
            "nextDialogs": [
              "80170305"
            ]
          },
          "80170305": {
            "id": "80170305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, really?"
          }
        }
      }
    },
    {
      "subId": "801704",
      "subQuestName": "Go to the Masters of the Night-Wind",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170401"
        ],
        "dialogs": {
          "80170401": {
            "id": "80170401",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "Oh, you're back! How did it go? Find anything?",
            "nextDialogs": [
              "80170402"
            ]
          },
          "80170402": {
            "id": "80170402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Nothing substantial, unfortunately. But we had the weirdest experience...",
            "nextDialogs": [
              "80170403"
            ]
          },
          "80170403": {
            "id": "80170403",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "So, I take it that the war's still on?",
            "nextDialogs": [
              "80170406"
            ]
          },
          "80170406": {
            "id": "80170406",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "That's okay — I just wasn't sure, because things seemed to be at a standstill while you were gone.",
            "nextDialogs": [
              "80170407"
            ]
          },
          "80170407": {
            "id": "80170407",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "The Abyss Order hasn't attacked us, and since we don't know what they're planning, we haven't made a move either.",
            "nextDialogs": [
              "80170408"
            ]
          },
          "80170408": {
            "id": "80170408",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "In a word, it's a stalemate. The guards have been keeping watch around the clock, but for everyone else, you wouldn't even know we're at war.",
            "nextDialogs": [
              "80170409"
            ]
          },
          "80170409": {
            "id": "80170409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh... Really makes you wonder what the Abyss Order's thinking.",
            "nextDialogs": [
              "80170410"
            ]
          },
          "80170410": {
            "id": "80170410",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "#I was wondering, {NICKNAME}... If you have the time, could you go and pay a visit to the guards?",
            "nextDialogs": [
              "80170411"
            ]
          },
          "80170411": {
            "id": "80170411",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "They've been working a pretty demanding schedule. I was gonna go see them myself, but I'm sure they'd appreciate a visit from the greatest hero of our time.",
            "nextDialogs": [
              "80170412"
            ]
          },
          "80170412": {
            "id": "80170412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aw, but you're a great hero too, Iansan!"
          }
        }
      }
    },
    {
      "subId": "801709",
      "subQuestName": "Talk to the forward sentries",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "801710",
      "subQuestName": "Talk to the forward sentries",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170701"
        ],
        "dialogs": {
          "80170701": {
            "id": "80170701",
            "speakerId": 15268,
            "speakerName": "Kantalo",
            "text": "Huh? ...Is... Is that \"Tum{RUBY#[S]Hope}aini\"? What brings you here? Is this, like, uh... a meet-and-greet?",
            "nextDialogs": [
              "80170702"
            ]
          },
          "80170702": {
            "id": "80170702",
            "speakerId": 15268,
            "speakerName": "Kantalo",
            "text": "Um... Hahaha... I, uh... I wasn't... Ahh, I'm so nervous...",
            "nextDialogs": [
              "80170703"
            ]
          },
          "80170703": {
            "id": "80170703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hey, come on. You'd march to war without so much as blinking. What's so scary about a chat with {NICKNAME}, hmm?",
            "nextDialogs": [
              "80170704"
            ]
          },
          "80170704": {
            "id": "80170704",
            "speakerId": 15268,
            "speakerName": "Kantalo",
            "text": "It's not the same thing at all! There are plenty of chances to go to war... but a one-on-one chat with our great hero? That could be a once-in-a-lifetime opportunity!",
            "nextDialogs": [
              "80170705"
            ]
          },
          "80170705": {
            "id": "80170705",
            "speakerId": 15268,
            "speakerName": "Kantalo",
            "text": "How can I not be nervous? What if I say something wrong? Or... Or if my posture's bad, or if I accidentally make a weird expression with my face? One bad impression can stick for life!",
            "nextDialogs": [
              "80170706"
            ]
          },
          "80170706": {
            "id": "80170706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No one's here to judge you on your posture or your facial expressions! Relax!",
            "nextDialogs": [
              "80170707"
            ]
          },
          "80170707": {
            "id": "80170707",
            "speakerId": 15268,
            "speakerName": "Kantalo",
            "text": "*sigh* Alright, then...",
            "nextDialogs": [
              "80170708"
            ]
          },
          "80170708": {
            "id": "80170708",
            "speakerId": 15268,
            "speakerName": "Kantalo",
            "text": "Um... I'm sorry, great hero, but I have a small favor to ask...",
            "nextDialogs": [
              "80170709"
            ]
          },
          "80170709": {
            "id": "80170709",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let Paimon guess, an autograph, right? That's easy...",
            "nextDialogs": [
              "80170710"
            ]
          },
          "80170710": {
            "id": "80170710",
            "speakerId": 15268,
            "speakerName": "Kantalo",
            "text": "...May I challenge you to a fight?",
            "nextDialogs": [
              "80170711"
            ]
          },
          "80170711": {
            "id": "80170711",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What!? How can you be so... audacious and so sheepish at the same time? Hmm, Paimon's starting to think your nervousness is all just an act!",
            "nextDialogs": [
              "80170712"
            ]
          },
          "80170712": {
            "id": "80170712",
            "speakerId": 15268,
            "speakerName": "Kantalo",
            "text": "No no no, of course not... I just figured that if I don't ask now, I'll regret it for the rest of my life...",
            "nextDialogs": [
              "80170713"
            ]
          },
          "80170713": {
            "id": "80170713",
            "speakerId": 15268,
            "speakerName": "Kantalo",
            "text": "But I am still on patrol, so please, Great Paimon, if you wouldn't mind taking over for me for just a few minutes...",
            "nextDialogs": [
              "80170714"
            ]
          },
          "80170714": {
            "id": "80170714",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Again with the sheepish audacity! Just pick one or the other, will you!",
            "nextDialogs": [
              "80170717"
            ]
          },
          "80170717": {
            "id": "80170717",
            "speakerId": 15268,
            "speakerName": "Kantalo",
            "text": "Woohoooooo! Haha!",
            "nextDialogs": [
              "80170718"
            ]
          },
          "80170718": {
            "id": "80170718",
            "speakerId": 15268,
            "speakerName": "Kantalo",
            "text": "Obviously, I never expected to win, but until now, I didn't appreciate just how great the gulf was between us...",
            "nextDialogs": [
              "80170719"
            ]
          },
          "80170719": {
            "id": "80170719",
            "speakerId": 15268,
            "speakerName": "Kantalo",
            "text": "Hahaha, I'll be bragging about the day I got to spar with \"Tum{RUBY#[S]Hope}aini\" for the rest of my life. Today's really my lucky day!",
            "nextDialogs": [
              "80170720"
            ]
          },
          "80170720": {
            "id": "80170720",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Paimon can't keep up with you. Your tone has changed all over again now you've had a spar with {NICKNAME}... What gives?",
            "nextDialogs": [
              "80170721"
            ]
          },
          "80170721": {
            "id": "80170721",
            "speakerId": 15268,
            "speakerName": "Kantalo",
            "text": "Mm, well, some people connect through conversation, but we warriors bond by sparring. And now that I've had a bout with the hero, we're no longer strangers. Nothing to be nervous about anymore!",
            "nextDialogs": [
              "80170722"
            ]
          },
          "80170722": {
            "id": "80170722",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay... Well, each to their own, but Paimon's still gonna stick to conversation.",
            "nextDialogs": [
              "80170723"
            ]
          },
          "80170723": {
            "id": "80170723",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you noticed anything out of the ordinary?",
            "nextDialogs": [
              "80170724"
            ]
          },
          "80170724": {
            "id": "80170724",
            "speakerId": 15268,
            "speakerName": "Kantalo",
            "text": "Not at all. We haven't spotted any new enemy movements.",
            "nextDialogs": [
              "80170725"
            ]
          },
          "80170725": {
            "id": "80170725",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "As Paimon expected... Nothing here, either. Let's do another lap and get back to Iansan."
          }
        }
      }
    },
    {
      "subId": "801705",
      "subQuestName": "Talk to Iansan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170501"
        ],
        "dialogs": {
          "80170501": {
            "id": "80170501",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "You're back. So, did the guards find anything?",
            "nextDialogs": [
              "80170502"
            ]
          },
          "80170502": {
            "id": "80170502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Nothing much, no. Someone mentioned that the Abyss Order has been doing some kind of meditation or prayer, but apparently it seemed harmless.",
            "nextDialogs": [
              "80170503"
            ]
          },
          "80170503": {
            "id": "80170503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon wants to lodge a complaint about one of the guards, though. His name's Kantalo...",
            "nextDialogs": [
              "80170504"
            ]
          },
          "80170504": {
            "id": "80170504",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "Hmm?",
            "nextDialogs": [
              "80170507"
            ]
          },
          "80170507": {
            "id": "80170507",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "#{NICKNAME}, you're back already? Ah, and no one thought to wake me up, huh!?",
            "nextDialogs": [
              "80170508"
            ]
          },
          "80170508": {
            "id": "80170508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "In fairness, you look pretty hungover. Can't imagine anyone wanting to wake you up in that state...",
            "nextDialogs": [
              "80170509"
            ]
          },
          "80170509": {
            "id": "80170509",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "I'll have you know I'm perfectly sober when I'm hungover! Uh... Okay, I'll admit that sounds strange at face value, but regardless...",
            "nextDialogs": [
              "80170510"
            ]
          },
          "80170510": {
            "id": "80170510",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "What I meant to say is — I heard something about the Abyss Order engaging in meditation?",
            "nextDialogs": [
              "80170511"
            ]
          },
          "80170511": {
            "id": "80170511",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, that's right! Does that mean anything to you, Citlali?",
            "nextDialogs": [
              "80170512"
            ]
          },
          "80170512": {
            "id": "80170512",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "I sensed something strange in my dream. It was vague, but... It seemed as if some \"noise\" had found its way into Natlan's Ley Lines...",
            "nextDialogs": [
              "80170513"
            ]
          },
          "80170513": {
            "id": "80170513",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What does that mean?",
            "nextDialogs": [
              "80170514"
            ]
          },
          "80170514": {
            "id": "80170514",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Hard to say... I don't think it had any tangible effect on the Night Kingdom or on our Ley Lines, but still...",
            "nextDialogs": [
              "80170515"
            ]
          },
          "80170515": {
            "id": "80170515",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "It's like... a signal that exists on a different dimension of reality. It might not interfere with ours, or pose any detectable risk, but I just get the sense that something strange is going on.",
            "nextDialogs": [
              "80170516"
            ]
          },
          "80170516": {
            "id": "80170516",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So even someone as familiar with the Ley Lines as you can't tell what's going on...",
            "nextDialogs": [
              "80170517"
            ]
          },
          "80170517": {
            "id": "80170517",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No wonder the shamans that Sutura called to the front lines couldn't sense anything.",
            "nextDialogs": [
              "80170518"
            ]
          },
          "80170518": {
            "id": "80170518",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Iansan, I think we should go talk to the Chiefs. There's no point dragging this out. We need to take the initiative and drive the Abyss Order out of Natlan for good.",
            "nextDialogs": [
              "80170519"
            ]
          },
          "80170519": {
            "id": "80170519",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "If that's the counsel of Granny Itztli, I'm sure the Chiefs will agree. But it will still take us some time to gather the required force.",
            "nextDialogs": [
              "80170520"
            ]
          },
          "80170520": {
            "id": "80170520",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "In war, adequate planning and preparation is the key to victory.",
            "nextDialogs": [
              "80170521"
            ]
          },
          "80170521": {
            "id": "80170521",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Sure, but the finer details aren't my concern. Anyway, I'll leave you to it. Just remember to come find me when you're ready to talk to the Chiefs."
          }
        }
      }
    },
    {
      "subId": "801706",
      "subQuestName": "Return to the cave to investigate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170601"
        ],
        "dialogs": {
          "80170601": {
            "id": "80170601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Here we are. Direidyth will still be here, right?",
            "nextDialogs": [
              "80170602"
            ]
          },
          "80170602": {
            "id": "80170602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's so quiet, though... Uh-oh, what if Iansan was right? Maybe she never intended to stay here at all...",
            "nextDialogs": [
              "80170605"
            ]
          },
          "80170605": {
            "id": "80170605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}! Watch out!",
            "nextDialogs": [
              "80170606"
            ]
          },
          "80170606": {
            "id": "80170606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...!!!",
            "nextDialogs": [
              "80170607"
            ]
          },
          "80170607": {
            "id": "80170607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Shoot, maybe Direidyth really is a—)",
            "nextDialogs": [
              "80170608"
            ]
          },
          "80170608": {
            "id": "80170608",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "Hey-yah!",
            "nextDialogs": [
              "80170609"
            ]
          },
          "80170609": {
            "id": "80170609",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "Ah... sorry, sorry! I didn't know it was you! I heard a noise, and I thought it was the monsters coming to get me...",
            "nextDialogs": [
              "80170610"
            ]
          },
          "80170610": {
            "id": "80170610",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "Did I hurt you? I'm so sorry, I... I wasn't thinking straight..."
          }
        }
      }
    },
    {
      "subId": "801707",
      "subQuestName": "Protect Direidyth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "801708",
      "subQuestName": "Talk to Direidyth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170801"
        ],
        "dialogs": {
          "80170801": {
            "id": "80170801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Wow, that was fast... Did you get all of them?",
            "nextDialogs": [
              "80170802"
            ]
          },
          "80170802": {
            "id": "80170802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's slowly but surely getting used to the sight of you fighting thin air...",
            "nextDialogs": [
              "80170803"
            ]
          },
          "80170803": {
            "id": "80170803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You doing alright, Direidyth?",
            "nextDialogs": [
              "80170804"
            ]
          },
          "80170804": {
            "id": "80170804",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "...",
            "nextDialogs": [
              "80170805"
            ]
          },
          "80170805": {
            "id": "80170805",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Direidyth? Hey, it's okay, there's nothing to be scared of anymore...",
            "nextDialogs": [
              "80170806"
            ]
          },
          "80170806": {
            "id": "80170806",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "...Oh... I—I'm fine... I just spaced out there for a moment.",
            "nextDialogs": [
              "80170807"
            ]
          },
          "80170807": {
            "id": "80170807",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You... spaced out? That's a pretty bold move under the circumstances...",
            "nextDialogs": [
              "80170808"
            ]
          },
          "80170808": {
            "id": "80170808",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "#I was just, uh... The image of {NICKNAME} fighting to protect me — I was trying to commit it to memory. Seems like the least I can do.",
            "nextDialogs": [
              "80170809"
            ]
          },
          "80170809": {
            "id": "80170809",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright... Whatever floats your boat.",
            "nextDialogs": [
              "80170810"
            ]
          },
          "80170810": {
            "id": "80170810",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "Anyway, there are no more monsters in the area, and it's getting late. Why don't you stay here tonight?",
            "nextDialogs": [
              "80170811"
            ]
          },
          "80170811": {
            "id": "80170811",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Sounds reasonable to Paimon! What do you think, {NICKNAME}?",
            "nextDialogs": [
              "80170812"
            ]
          },
          "80170812": {
            "id": "80170812",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(I'm personally satisfied that Direidyth isn't a threat, but... it can't hurt to monitor her for another night.)",
            "nextDialogs": [
              "80170813"
            ]
          },
          "80170813": {
            "id": "80170813",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright! Direidyth, we'll be... Huh? Direidyth? Why are you going in alone?",
            "nextDialogs": [
              "80170814"
            ]
          },
          "80170814": {
            "id": "80170814",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "As you stare at the Hibernation Chamber key in your hands, you start to relax and drift into a deep sleep...",
            "nextDialogs": [
              "80170815"
            ]
          },
          "80170815": {
            "id": "80170815",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "Soon, a vivid dream fills your mind..."
          }
        }
      }
    },
    {
      "subId": "801713",
      "subQuestName": "Sleep and enter the dream...",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80171001"
        ],
        "dialogs": {
          "80171001": {
            "id": "80171001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(This is... the Night Kingdom?)",
            "nextDialogs": [
              "80171002"
            ]
          },
          "80171002": {
            "id": "80171002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#({M#Lumine}{F#Aether}! And... the Lord of the Night?)",
            "nextDialogs": [
              "80171003"
            ]
          },
          "80171003": {
            "id": "80171003",
            "speakerId": 1008,
            "speakerName": "Sibling",
            "text": "...",
            "nextDialogs": [
              "80171004"
            ]
          },
          "80171004": {
            "id": "80171004",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(!!!)",
            "nextDialogs": [
              "80171005"
            ]
          },
          "80171005": {
            "id": "80171005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(My head... It hurts!)",
            "nextDialogs": [
              "80171006"
            ]
          },
          "80171006": {
            "id": "80171006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(...)",
            "nextDialogs": [
              "80171007"
            ]
          },
          "80171007": {
            "id": "80171007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(My headache... it's gone...)",
            "nextDialogs": [
              "80171008"
            ]
          },
          "80171008": {
            "id": "80171008",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(I think... I hear a voice in the darkness.)",
            "nextDialogs": [
              "80171009"
            ]
          },
          "80171009": {
            "id": "80171009",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "...Doomsday... a fitting name indeed.",
            "nextDialogs": [
              "80171010"
            ]
          },
          "80171010": {
            "id": "80171010",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "A blood-red sky...",
            "nextDialogs": [
              "80171011"
            ]
          },
          "80171011": {
            "id": "80171011",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Wild beasts that slaughter all in sight...",
            "nextDialogs": [
              "80171012"
            ]
          },
          "80171012": {
            "id": "80171012",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Endless pain, a terrible curse that cannot be reversed...",
            "nextDialogs": [
              "80171013"
            ]
          },
          "80171013": {
            "id": "80171013",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "And... the birth of a Savior."
          }
        }
      }
    },
    {
      "subId": "801711",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80171101"
        ],
        "dialogs": {
          "80171101": {

    {
      "subId": "801717",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80171701"
        ],
        "dialogs": {
          "80171701": {
            "id": "80171701",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Why holding hands? Why that, specifically? Why not... literally anything else?"
          }
        }
      }
    },
    {
      "subId": "801718",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80171801"
        ],
        "dialogs": {
          "80171801": {
            "id": "80171801",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "I'm not normally so suspicious of strangers, but at times like this, the safety of the tribes has to come first."
          }
        }
      }
    }

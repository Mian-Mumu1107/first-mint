    {
      "subId": "801712",
      "subQuestName": "Talk to Direidyth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80170901"
        ],
        "dialogs": {
          "80170901": {
            "id": "80170901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(!!!)",
            "nextDialogs": [
              "80170902"
            ]
          },
          "80170902": {
            "id": "80170902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(That dream I just had...)",
            "nextDialogs": [
              "80170903"
            ]
          },
          "80170903": {
            "id": "80170903",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "Ah, you're awake... I—I'm sorry, I didn't mean to, uh...",
            "nextDialogs": [
              "80170904"
            ]
          },
          "80170904": {
            "id": "80170904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Was she holding my hand?)",
            "nextDialogs": [
              "80170905"
            ]
          },
          "80170905": {
            "id": "80170905",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "You just... looked quite distressed, like you were having a nightmare...",
            "nextDialogs": [
              "80170906"
            ]
          },
          "80170906": {
            "id": "80170906",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "I thought if I took your hand into mine, you might find it soothing... At least, that's what my family always did when I had nightmares.",
            "nextDialogs": [
              "80170907"
            ]
          },
          "80170907": {
            "id": "80170907",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "But it didn't seem to work on you... In fact, I think I made it even worse... I'm so sorry...",
            "nextDialogs": [
              "80170908"
            ]
          },
          "80170908": {
            "id": "80170908",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh? Is that right...",
            "nextDialogs": [
              "80170909"
            ]
          },
          "80170909": {
            "id": "80170909",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hmm... You'd better not be trying to pull a fast one on the {NICKNAME}...",
            "nextDialogs": [
              "80170910"
            ]
          },
          "80170910": {
            "id": "80170910",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "What!? Don't be so... I have more self-control than that!",
            "nextDialogs": [
              "80170911"
            ]
          },
          "80170911": {
            "id": "80170911",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Self-control? What does that have to do with it...?",
            "nextDialogs": [
              "80170912"
            ]
          },
          "80170912": {
            "id": "80170912",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Ugh, I still can't remember anything... What did I see in my dream just now?)",
            "nextDialogs": [
              "80170913"
            ]
          },
          "80170913": {
            "id": "80170913",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#(I think I saw {M#Lumine}{F#Aether} in the Night Kingdom at the very start of the dream... But I can't remember what happened next...)",
            "nextDialogs": [
              "80170914"
            ]
          },
          "80170914": {
            "id": "80170914",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Never mind. If the memory is gone, I can't force myself to remember it...)",
            "nextDialogs": [
              "80170917"
            ]
          },
          "80170917": {
            "id": "80170917",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh... No way is Paimon getting back to sleep after this!",
            "nextDialogs": [
              "80170918"
            ]
          },
          "80170918": {
            "id": "80170918",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You go ahead, but for the rest of the night, Paimon is staying up to keep an eye on this young lady!",
            "nextDialogs": [
              "80170919"
            ]
          },
          "80170919": {
            "id": "80170919",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "Aww... Do I really seem that shady to you...?",
            "nextDialogs": [
              "80170920"
            ]
          },
          "80170920": {
            "id": "80170920",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, Direidyth, this should be enough food for three days. Make sure you eat the perishable stuff first, so nothing goes to waste. ...You can tell which stuff is perishable, right?",
            "nextDialogs": [
              "80170921"
            ]
          },
          "80170921": {
            "id": "80170921",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "Yeah, I can tell from the ingredients. Thank you so much for making all this for me.",
            "nextDialogs": [
              "80170922"
            ]
          },
          "80170922": {
            "id": "80170922",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "Three days will definitely be enough time for my ankle to heal. Then, I'll continue on my journey to find the Savior.",
            "nextDialogs": [
              "80170923"
            ]
          },
          "80170923": {
            "id": "80170923",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright, then we'll be off. Bye for now, Direidyth!",
            "nextDialogs": [
              "80170924"
            ]
          },
          "80170924": {
            "id": "80170924",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "See ya... Wait, but if this is goodbye... How am I supposed to find you again?",
            "nextDialogs": [
              "80170925"
            ]
          },
          "80170925": {
            "id": "80170925",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "Oh... I mean, what if I find your sibling? How am I supposed to let you know?",
            "nextDialogs": [
              "80170926"
            ]
          },
          "80170926": {
            "id": "80170926",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, that's a good point... We share the same goal, but we're constantly on the road, so we've got no fixed address...",
            "nextDialogs": [
              "80170927"
            ]
          },
          "80170927": {
            "id": "80170927",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How about this? When the time comes, you can just write a letter to Mavuika. She'll be able to find us for sure!",
            "nextDialogs": [
              "80170928"
            ]
          },
          "80170928": {
            "id": "80170928",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "Mavuika? Who's Mavuika?"
          }
        }
      }
    },
    {
      "subId": "801712",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80171201"
        ],
        "dialogs": {
          "80171201": {
            "id": "80171201",
            "speakerId": 15204,
            "speakerName": "Direidyth",
            "text": "Aah! ...Don't worry, I—I'm fine. I just need some time to myself..."
          }
        }
      }
    },
    {
      "subId": "801713",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],

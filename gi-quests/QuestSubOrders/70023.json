  "subQuests": [
    {
      "subId": "7002301",
      "subQuestName": "Talk to the other hilichurl willing to make conversation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700230101"
        ],
        "dialogs": {
          "700230101": {
            "id": "700230101",
            "speakerId": 1000,
            "speakerName": "Diligent Hilichurl",
            "text": "Ya!",
            "nextDialogs": [
              "700230102"
            ]
          },
          "700230102": {
            "id": "700230102",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "Mimi ika yaya nye! Mimi tomo, mimi mani ye.",
            "nextDialogs": [
              "700230103"
            ]
          },
          "700230103": {
            "id": "700230103",
            "speakerId": 1000,
            "speakerName": "Diligent Hilichurl",
            "text": "Mani. Mi muhe mani. Unu du mani! Hahahahaha.",
            "nextDialogs": [
              "700230104"
            ]
          },
          "700230104": {
            "id": "700230104",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "This one just told a joke in Hilichurlian, then laughed at its own joke. They must have such a spiritually impoverished existence... Poor things.",
            "nextDialogs": [
              "700230105"
            ]
          },
          "700230105": {
            "id": "700230105",
            "speakerId": 1000,
            "speakerName": "Diligent Hilichurl",
            "text": "Mi muhe <color=#00E1FFFF>kucha gusha</color>. Kucha gusha dada. Unu gusha dada!",
            "nextDialogs": [
              "700230106"
            ]
          },
          "700230106": {
            "id": "700230106",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "He wants to... Actually, never mind, you can find everything you need to know inside the handbook."
          }
        }
      }
    },
    {
      "subId": "7002302",
      "subQuestName": "Give an item to the hilichurl",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700230301"
        ],
        "dialogs": {
          "700230301": {
            "id": "700230301",
            "speakerId": 1000,
            "speakerName": "Diligent Hilichurl",
            "text": "Yeye dada! Mosi mita!",
            "nextDialogs": [
              "700230302"
            ]
          },
          "700230302": {
            "id": "700230302",
            "speakerId": 1000,
            "speakerName": "Diligent Hilichurl",
            "text": "Hahahaha, kucha gusha unu gusha. Unu kucha si!",
            "nextDialogs": [
              "700230303"
            ]
          },
          "700230303": {
            "id": "700230303",
            "speakerId": 1000,
            "speakerName": "Diligent Hilichurl",
            "text": "Wei? Odomu tomo zido mi! <color=#00E1FFFF>Mosi aba nunu</color>!",
            "nextDialogs": [
              "700230304"
            ]
          },
          "700230304": {
            "id": "700230304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "<color=#00E1FFFF>Mosi aba nunu</color>... Does the handbook say what that phrase means?",
            "nextDialogs": [
              "700230307"
            ]
          },
          "700230307": {
            "id": "700230307",
            "speakerId": 1000,
            "speakerName": "Diligent Hilichurl",
            "text": "Valo, mi tomo!"
          }
        }
      }
    },
    {
      "subId": "7002304",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700230401"
        ],
        "dialogs": {
          "700230401": {
            "id": "700230401",
            "speakerId": 1000,
            "speakerName": "Diligent Hilichurl",
            "text": "Nye nye nye. Kucha, gusha. Hahahaha. Kucha gusha, kucha, gusha. Hahaha.",
            "nextDialogs": [
              "700230402"
            ]
          },
          "700230402": {
            "id": "700230402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That didn't seem right.",
            "nextDialogs": [
              "700230403"
            ]
          },
          "700230403": {
            "id": "700230403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(But it certainly made it smile...)"
          }
        }
      }
    },
    {
      "subId": "7002302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700230201"
        ],
        "dialogs": {
          "700230201": {
            "id": "700230201",
            "speakerId": 1000,
            "speakerName": "Diligent Hilichurl",
            "text": "Mi muhe unu boya gusha.",
            "nextDialogs": [
              "700230202"
            ]
          },
          "700230202": {
            "id": "700230202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Is it this one?)"
          }
        }
      }
    },
    {
      "subId": "7002399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700239901"
        ],
        "dialogs": {
          "700239901": {
            "id": "700239901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hold on a second... Why are we fighting the hilichurls' battles for them, again?"
          }
        }
      }
    }
  ]

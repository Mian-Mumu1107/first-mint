      "dialogue": {
        "startDialogs": [
          "402270201"
        ],
        "dialogs": {
          "402270201": {
            "id": "402270201",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You lead Aino and Ineffa to the venue.",
            "nextDialogs": [
              "402270202"
            ]
          },
          "402270202": {
            "id": "402270202",
            "speakerId": 1000,
            "speakerName": "Aino",
            "text": "Hm... This looks like a good spot for the demo platform.",
            "nextDialogs": [
              "402270203"
            ]
          },
          "402270203": {
            "id": "402270203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This new bot looks pretty interesting, Aino.",
            "nextDialogs": [
              "402270204"
            ]
          },
          "402270204": {
            "id": "402270204",
            "speakerId": 1000,
            "speakerName": "Aino",
            "text": "Hehehe! Swing by and try it out whenever you want! It'll blow your mind, I just know it!",
            "nextDialogs": [
              "402270205"
            ]
          },
          "402270205": {
            "id": "402270205",
            "speakerId": 1002,
            "speakerName": "Ineffa",
            "text": "Thanks for the help.",
            "nextDialogs": [
              "402270206"
            ]
          },
          "402270206": {
            "id": "402270206",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "No problem! Oh, and for registration, is it just gonna be you two?",
            "nextDialogs": [
              "402270207"
            ]
          },
          "402270207": {
            "id": "402270207",
            "speakerId": 1002,
            "speakerName": "Ineffa",
            "text": "Hmm... I will be participating, but there is no need to register Aino. She doesn't like to be around a lot of people. Once the expo starts, she'll head straight back to the Craftshop.",
            "nextDialogs": [
              "402270208"
            ]
          },
          "402270208": {
            "id": "402270208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Good point..."
          }
        }
      }
    }
  ]

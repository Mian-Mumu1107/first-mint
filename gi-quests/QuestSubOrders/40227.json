  "subQuests": [
    {
      "subId": "4022701",
      "subQuestName": "Go to the Clink-Clank Krumkake Craftshop",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402270101"
        ],
        "dialogs": {
          "402270101": {
            "id": "402270101",
            "speakerId": 1000,
            "speakerName": "Aino",
            "text": "Hm...",
            "nextDialogs": [
              "402270102"
            ]
          },
          "402270102": {
            "id": "402270102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, you two!",
            "nextDialogs": [
              "402270103"
            ]
          },
          "402270103": {
            "id": "402270103",
            "speakerId": 1002,
            "speakerName": "Ineffa",
            "text": "#{NICKNAME}, Paimon, hello.",
            "nextDialogs": [
              "402270104"
            ]
          },
          "402270104": {
            "id": "402270104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We're helping out Nefer with some expo stuff, and we heard the Krumkake Craftshop is taking part.",
            "nextDialogs": [
              "402270105"
            ]
          },
          "402270105": {
            "id": "402270105",
            "speakerId": 1002,
            "speakerName": "Ineffa",
            "text": "Correct. Aino is just doing a final round of debugging on her \"Thwack 'n Smack Defense Bots.\"",
            "nextDialogs": [
              "402270106"
            ]
          },
          "402270106": {
            "id": "402270106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, is that her submission for the expo?",
            "nextDialogs": [
              "402270107"
            ]
          },
          "402270107": {
            "id": "402270107",
            "speakerId": 1002,
            "speakerName": "Ineffa",
            "text": "Yes. Moles and other small creatures often steal from the Craftshop, so Aino designed a defense bot based off of them to protect this place.",
            "nextDialogs": [
              "402270108"
            ]
          },
          "402270108": {
            "id": "402270108",
            "speakerId": 1002,
            "speakerName": "Ineffa",
            "text": "Upon further testing, these bots turned out to be highly effective, so she decided to perform some upgrades and bring them to the expo.",
            "nextDialogs": [
              "402270109"
            ]
          },
          "402270109": {
            "id": "402270109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, so Aino is actually gonna trade one of her bots?",
            "nextDialogs": [
              "402270110"
            ]
          },
          "402270110": {
            "id": "402270110",
            "speakerId": 1002,
            "speakerName": "Ineffa",
            "text": "Not exactly. With the exception of a few special orders, Aino rarely sells her finished products. What she's trading at the expo is the blueprint, not the finished product.",
            "nextDialogs": [
              "402270111"
            ]
          },
          "402270111": {
            "id": "402270111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ohhh... So, are you guys ready to head over, then?",
            "nextDialogs": [
              "402270112"
            ]
          },
          "402270112": {
            "id": "402270112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Jahoda asked us to speed things along a bit. She's saving a super good spot for you, and she's worried people are gonna start asking questions.",
            "nextDialogs": [
              "402270113"
            ]
          },
          "402270113": {
            "id": "402270113",
            "speakerId": 1000,
            "speakerName": "Aino",
            "text": "I told her I need to finish debugging first! There's no point in rushing or I'll have nothing to trade!",
            "nextDialogs": [
              "402270114"
            ]
          },
          "402270114": {
            "id": "402270114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa, Paimon's never seen Aino this serious before.",
            "nextDialogs": [
              "402270115"
            ]
          },
          "402270115": {
            "id": "402270115",
            "speakerId": 1002,
            "speakerName": "Ineffa",
            "text": "The Craftshop is experiencing a severe shortage of funds. Aino is hoping the expo will improve our financial situation, so she's being extra thorough.",
            "nextDialogs": [
              "402270116"
            ]
          },
          "402270116": {
            "id": "402270116",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Where'd all the money go? Some kind of expensive research?",
            "nextDialogs": [
              "402270117"
            ]
          },
          "402270117": {
            "id": "402270117",
            "speakerId": 1002,
            "speakerName": "Ineffa",
            "text": "Negative. It's our dessert funds that are lacking. We have had at least 47 cases where excess dessert purchases have led to a shortage of research funds.",
            "nextDialogs": [
              "402270118"
            ]
          },
          "402270118": {
            "id": "402270118",
            "speakerId": 1002,
            "speakerName": "Ineffa",
            "text": "As such, I decided to split up our research and dessert budgets. Aino is forbidden from dipping into one to transfer to the other.",
            "nextDialogs": [
              "402270119"
            ]
          },
          "402270119": {
            "id": "402270119",
            "speakerId": 1002,
            "speakerName": "Ineffa",
            "text": "And not too long ago, she cleaned out the entire dessert budget for this month.",
            "nextDialogs": [
              "402270122"
            ]
          },
          "402270122": {
            "id": "402270122",
            "speakerId": 1000,
            "speakerName": "Aino",
            "text": "Alright, done! Thwack 'n Whack Defense Bots, do me proud!",
            "nextDialogs": [
              "402270123"
            ]
          },
          "402270123": {
            "id": "402270123",
            "speakerId": 1002,
            "speakerName": "Ineffa",
            "text": "Looks like we can head over now."
          }
        }
      }
    },
    {
      "subId": "4022702",
      "subQuestName": "Take Aino and Ineffa to the event venue",
      "sceneId": null,

    {
      "subId": "7619108",
      "subQuestName": "Investigate Capybara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761910301"
        ],
        "dialogs": {
          "761910301": {
            "id": "761910301",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "It really is a silver Capybara... No dye, no trick of the light. This is so incredibly rare... absolutely astonishing!",
            "nextDialogs": [
              "761910302"
            ]
          },
          "761910302": {
            "id": "761910302",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "I searched all over Natlan and never managed to find one. Turns out, it got snatched by smugglers.",
            "nextDialogs": [
              "761910303"
            ]
          },
          "761910303": {
            "id": "761910303",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "But it doesn't seem hurt... Hehe, a silver Capybara! Never imagined I'd get to see one with my own eyes! Let me just— oh, let me feel it for a moment, see if this silver one feels any different from the ordinary ones...",
            "nextDialogs": [
              "761910304"
            ]
          },
          "761910304": {
            "id": "761910304",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "Ouch! It's burning hot!",
            "nextDialogs": [
              "761910305"
            ]
          },
          "761910305": {
            "id": "761910305",
            "speakerId": 1004,
            "speakerName": "Capybara",
            "text": "?",
            "nextDialogs": [
              "761910306"
            ]
          },
          "761910306": {
            "id": "761910306",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "Ah, I almost forgot! You're still in the pot!",
            "nextDialogs": [
              "761910307"
            ]
          },
          "761910307": {
            "id": "761910307",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "Could it be that you've grown used to Natlan's liquid Phlogiston, so this temperature barely fazes you?",
            "nextDialogs": [
              "761910308"
            ]
          },
          "761910308": {
            "id": "761910308",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "Anyway, you're coming back with me for now!",
            "nextDialogs": [
              "761910309"
            ]
          },
          "761910309": {
            "id": "761910309",
            "speakerId": 1004,
            "speakerName": "Capybara",
            "text": "♪~"
          }
        }
      }
    },

    {
      "subId": "7619105",
      "subQuestName": "Investigate the cage",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761910501"
        ],
        "dialogs": {
          "761910501": {
            "id": "761910501",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "They fled in a panic... Tsk, pathetic.",
            "nextDialogs": [
              "761910502"
            ]
          },
          "761910502": {
            "id": "761910502",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "(The smuggled Capybara isn't here... Could this have something to do with the Hilichurls?)",
            "nextDialogs": [
              "761910503"
            ]
          },
          "761910503": {
            "id": "761910503",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "(Let's see if we can find any clues nearby.)"
          }
        }
      }
    },

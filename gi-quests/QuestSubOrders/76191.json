    {
      "subId": "7619103",
      "subQuestName": "Stop the Treasure Hoarders",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761910201"
        ],
        "dialogs": {
          "761910201": {
            "id": "761910201",
            "speakerId": 1001,
            "speakerName": "Alhoma",
            "text": "I warned you more than once — keep your eyes open. This is premium stock, personally requested by repeat clients in Snezhnograd.",
            "nextDialogs": [
              "761910202"
            ]
          },
          "761910202": {
            "id": "761910202",
            "speakerId": 1001,
            "speakerName": "Alhoma",
            "text": "And you just let it go? Have you gone soft on me? Did you suddenly grow a conscience or what?",
            "nextDialogs": [
              "761910203"
            ]
          },
          "761910203": {
            "id": "761910203",
            "speakerId": 1002,
            "speakerName": "Yelo",
            "text": "Boss, listen, it's really not my fault. Those Hilichurls—",
            "nextDialogs": [
              "761910204"
            ]
          },
          "761910204": {
            "id": "761910204",
            "speakerId": 1001,
            "speakerName": "Alhoma",
            "text": "Hilichurls? You're using that as an excuse? Keep this up and you'll make a joke of our Treasure Hoarder brand!",
            "nextDialogs": [
              "761910205"
            ]
          },
          "761910205": {
            "id": "761910205",
            "speakerId": 1002,
            "speakerName": "Yelo",
            "text": "I couldn't handle them, boss. I really couldn't! The blue one and its green friend hit harder than those Agents...",
            "nextDialogs": [
              "761910206"
            ]
          },
          "761910206": {
            "id": "761910206",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "(These two... they're definitely smugglers.)",
            "nextDialogs": [
              "761910207"
            ]
          },
          "761910207": {
            "id": "761910207",
            "speakerId": 1001,
            "speakerName": "Alhoma",
            "text": "...Who's there?",
            "nextDialogs": [
              "761910208"
            ]
          },
          "761910208": {
            "id": "761910208",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "Easy, Lumi! Not yet.",
            "nextDialogs": [
              "761910209"
            ]
          },
          "761910209": {
            "id": "761910209",
            "speakerId": 1001,
            "speakerName": "Alhoma",
            "text": "What's this? Hmm... A rare find.",
            "nextDialogs": [
              "761910210"
            ]
          },
          "761910210": {
            "id": "761910210",
            "speakerId": 1001,
            "speakerName": "Alhoma",
            "text": "Hey, you can handle a little girl, yeah? This looks solid enough. Let's swap it in and call it a day.",
            "nextDialogs": [
              "761910211"
            ]
          },
          "761910211": {
            "id": "761910211",
            "speakerId": 1002,
            "speakerName": "Yelo",
            "text": "Yes, boss.",
            "nextDialogs": [
              "761910212"
            ]
          },
          "761910212": {
            "id": "761910212",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "You have the nerve to go after Lumi now? You're the reason the Treasure Hoarders' reputation is in the gutter...",
            "nextDialogs": [
              "761910213"
            ]
          },
          "761910213": {
            "id": "761910213",
            "speakerId": 1002,
            "speakerName": "Yelo",
            "text": "\"Reputation\"? The Treasure Hoarders have a... what now?",
            "nextDialogs": [
              "761910214"
            ]
          },
          "761910214": {
            "id": "761910214",
            "speakerId": 1001,
            "speakerName": "Alhoma",
            "text": "Stop wasting your breath on her!"
          }
        }
      }
    },
    {
      "subId": "7619104",
      "subQuestName": "Defeat the opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {

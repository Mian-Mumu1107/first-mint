      "dialogue": {
        "startDialogs": [
          "761919901"
        ],
        "dialogs": {
          "761919901": {
            "id": "761919901",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "You should count yourselves lucky it was me you ran into, and not Grandma Hiljetta!",
            "nextDialogs": [
              "761919902"
            ]
          },
          "761919902": {
            "id": "761919902",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "Wow, so the silver Capybara really exists... Wait, why's it in a pot!?",
            "nextDialogs": [
              "761919903"
            ]
          },
          "761919903": {
            "id": "761919903",
            "speakerId": 1003,
            "speakerName": "Linnea",
            "text": "Heh, I'd better let Mikko and the others see this little wonder before sending it back!"
          }
        }
      }

    {
      "subId": "7111105",
      "subQuestName": "Check on Chili Pepper",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711110501"
        ],
        "dialogs": {
          "711110501": {
            "id": "711110501",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Chili, why aren't you moving either? Do you want some Jueyun Chilis?",
            "nextDialogs": [
              "711110502"
            ]
          },
          "711110502": {
            "id": "711110502",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Come, come, I've got lots of them here. You can eat all you want today!",
            "nextDialogs": [
              "711110503"
            ]
          },
          "711110503": {
            "id": "711110503",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "That way, you'll have the energy to compete!",
            "nextDialogs": [
              "711110504"
            ]
          },
          "711110504": {
            "id": "711110504",
            "speakerId": 2494,
            "speakerName": "Chili Pepper",
            "text": "(Chili Pepper seems to know what Wenhua's bringing and doesn't even look at it.)",
            "nextDialogs": [
              "711110505"
            ]
          },
          "711110505": {
            "id": "711110505",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "This... What's going on? Why aren't you eating anymore?"
          }
        }
      }
    },
    {
      "subId": "7111107",
      "subQuestName": "Check on Yunyun",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711110701"
        ],
        "dialogs": {
          "711110701": {
            "id": "711110701",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "Hey now, come on, didn't you just eat? Are you hungry already?",
            "nextDialogs": [
              "711110702"
            ]
          },
          "711110702": {
            "id": "711110702",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "*sigh* What am I supposed to do with you? ... Well, we're fresh out of Berries, but we've still got some Sunsettias. Here, I suppose you'll enjoy these too?",
            "nextDialogs": [
              "711110703"
            ]
          },
          "711110703": {
            "id": "711110703",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "Tusheng retrieves a pile of Sunsettias and places them on the ground.",
            "nextDialogs": [
              "711110704"
            ]
          },
          "711110704": {
            "id": "711110704",
            "speakerId": 2232,
            "speakerName": "Yunyun",
            "text": "(Yunyun starts to eat...)",
            "nextDialogs": [
              "711110705"
            ]
          },
          "711110705": {
            "id": "711110705",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look! Chili Pepper's joining in, too! Guess it wants in on those Sunsettias, huh?",
            "nextDialogs": [
              "711110706"
            ]
          },
          "711110706": {
            "id": "711110706",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Chili! Not you too...",
            "nextDialogs": [
              "711110707"
            ]
          },
          "711110707": {
            "id": "711110707",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "See, I told you so. You're the only one who's enamored with the idea of them liking Jueyun Chilis.",
            "nextDialogs": [
              "711110708"
            ]
          },
          "711110708": {
            "id": "711110708",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "How could this be...",
            "nextDialogs": [
              "711110709"
            ]
          },
          "711110709": {
            "id": "711110709",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "Whatever. There's nothing to be said to people like you. We can compete once they're done eating their fill.",
            "nextDialogs": [
              "711110710"
            ]
          },
          "711110710": {
            "id": "711110710",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "...Ah, forget it... *sigh*",
            "nextDialogs": [
              "711110711"
            ]
          },
          "711110711": {
            "id": "711110711",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "I get it. There's no need for competition now... I know I've lost.",
            "nextDialogs": [
              "711110712"
            ]
          },
          "711110712": {
            "id": "711110712",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "Huh?",
            "nextDialogs": [
              "711110713"
            ]
          },
          "711110713": {
            "id": "711110713",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Perhaps I was too overconfident... But I'm not some bull-headed old fogey!",
            "nextDialogs": [
              "711110714"
            ]
          },
          "711110714": {
            "id": "711110714",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "You win, youngster. Looks like Yun and Chili have grown up. If they don't wish to eat Jueyun Chilis any longer, then I'll let them be...",
            "nextDialogs": [
              "711110715"
            ]
          },
          "711110715": {
            "id": "711110715",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon thinks they never did in the first place...",
            "nextDialogs": [
              "711110716"
            ]
          },
          "711110716": {
            "id": "711110716",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "Hmm. You know what, old man, you've surprised me... Guess you're pretty alright, learning from your errors and all.",
            "nextDialogs": [
              "711110717"
            ]
          },
          "711110717": {
            "id": "711110717",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "...Youngster, could I ask you a question? How are you so familiar with Sumpter Beast habits?",
            "nextDialogs": [
              "711110718"
            ]
          },
          "711110718": {
            "id": "711110718",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "Well, I just like little critters, and Sumpter Beasts are pretty cute when they're young. My family wasn't well-to-do, though, so I couldn't afford to have one.",
            "nextDialogs": [
              "711110719"
            ]
          },
          "711110719": {
            "id": "711110719",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And that's how you came to steal Yun together with the Treasure Hoarders?",
            "nextDialogs": [
              "711110720"
            ]
          },
          "711110720": {
            "id": "711110720",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "Hey, I told you, this one came to us. I stole nothing!",
            "nextDialogs": [
              "711110721"
            ]
          },
          "711110721": {
            "id": "711110721",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "Our superiors said that it was just as well that we had a Sumpter Beast, since we got a big deal going recently and would have to transport some large goods — and that's how we came to keep it at our camp.",
            "nextDialogs": [
              "711110722"
            ]
          },
          "711110722": {
            "id": "711110722",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Hmph. Even so, taking it for yourself... That's just not right!",
            "nextDialogs": [
              "711110723"
            ]
          },
          "711110723": {
            "id": "711110723",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "Well, how were we supposed to know that someone would be raising Sumpter Beasts out here in the boonies!? If we knew we'd end up facing off with this tough a customer, we'd have returned it to you right away!",
            "nextDialogs": [
              "711110724"
            ]
          },
          "711110724": {
            "id": "711110724",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So you wouldn't have returned it so easily had it not been for us, I take it?",
            "nextDialogs": [
              "711110725"
            ]
          },
          "711110725": {
            "id": "711110725",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "I see, I see... Well. It's not too late to make up for past mistakes! Well, youngster, ever considered switching careers to work in a caravan?",
            "nextDialogs": [
              "711110726"
            ]
          },
          "711110726": {
            "id": "711110726",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "What? I'm not sure I'll have squarer meals with you...",
            "nextDialogs": [
              "711110727"
            ]
          },
          "711110727": {
            "id": "711110727",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Square meals? You? Hahaha... You want to eat your fill, do you? Hahaha!",
            "nextDialogs": [
              "711110728"
            ]
          },
          "711110728": {
            "id": "711110728",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "...",
            "nextDialogs": [
              "711110729"
            ]
          },
          "711110729": {
            "id": "711110729",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Look. Everyone here can attest to you being a Treasure Hoarder, a member of a criminal organization! A single document submitted by me to the Millelith captains, and you'll be eating your fill in a prison cell.",
            "nextDialogs": [
              "711110730"
            ]
          },
          "711110730": {
            "id": "711110730",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "But see, I'm a kind soul. Not only am I erasing any record of your guilt, but I'm going to offer you a job, food, and board. What do you say?",
            "nextDialogs": [
              "711110731"
            ]
          },
          "711110731": {
            "id": "711110731",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "And how much will I make?",
            "nextDialogs": [
              "711110732"
            ]
          },
          "711110732": {
            "id": "711110732",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Ah? Wages... Wages... Well, you can ask the Millelith about that!",
            "nextDialogs": [
              "711110733"
            ]
          },
          "711110733": {
            "id": "711110733",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "W—Wait! Please, don't! ... Ugh. You can just decide my paycheck for yourself, alright?",
            "nextDialogs": [
              "711110734"
            ]
          },
          "711110734": {
            "id": "711110734",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Hmm. Well, in any case, you've impressed me with your abilities. In future, my Sumpter Beasts shall be in your care.",
            "nextDialogs": [
              "711110735"
            ]
          },
          "711110735": {
            "id": "711110735",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "I guarantee that not only will you be able to fill your stomach, but that your talents will see ample use indeed!",
            "nextDialogs": [
              "711110736"
            ]
          },
          "711110736": {
            "id": "711110736",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, uh, this is the first time Paimon's ever seen someone taking advantage of a Treasure Hoarder this much!",
            "nextDialogs": [
              "711110739"
            ]
          },
          "711110739": {
            "id": "711110739",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "You think so too? Well... To be honest, I quite like the idea of spending time with the Sumpter Beasts...",
            "nextDialogs": [
              "711110740"
            ]
          },
          "711110740": {
            "id": "711110740",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "Let me give it some thought. I'll let you know once I've thought it through.",
            "nextDialogs": [
              "711110741"
            ]
          },
          "711110741": {
            "id": "711110741",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "I believe you'll make the right decision, young man.",
            "nextDialogs": [
              "711110742"
            ]
          },
          "711110742": {
            "id": "711110742",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "(I need to find someone to keep an eye on him!)",
            "nextDialogs": [
              "711110743"
            ]
          },
          "711110743": {
            "id": "711110743",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Good, good! Anyway, my good fellows, thank you for helping me reclaim my precious Yun, and bringing it to my attention that they do not like Jueyun Chilis... *sigh* Sorry for the trouble, truly!",
            "nextDialogs": [
              "711110744"
            ]
          },
          "711110744": {
            "id": "711110744",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "So please, take this as a token of my appreciation. 'Twould be a shame if fine young folks such as yourselves could not eat as they pleased every day!"
          }
        }
      }
    },
    {
      "subId": "7111151",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711115101"
        ],
        "dialogs": {
          "711115101": {
            "id": "711115101",
            "speakerId": 2254,
            "speakerName": "Mingli",
            "text": "Hello there. I'm Mingli, the boss's assistant.",
            "nextDialogs": [
              "711115102"
            ]
          },
          "711115102": {
            "id": "711115102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why the long face?",
            "nextDialogs": [
              "711115103"
            ]
          },
          "711115103": {
            "id": "711115103",
            "speakerId": 2254,
            "speakerName": "Mingli",
            "text": "I'm worried about my boss... He lost yet another Sumpter Beast... We had three in total, but now we're just down to one!",
            "nextDialogs": [
              "711115104"
            ]
          },
          "711115104": {
            "id": "711115104",
            "speakerId": 2254,
            "speakerName": "Mingli",
            "text": "Sumpter Beasts are quite expensive, and neither my boss nor I know much about keeping them. We're going to take big losses if we keep going like this.",
            "nextDialogs": [
              "711115105"
            ]
          },
          "711115105": {
            "id": "711115105",
            "speakerId": 2254,
            "speakerName": "Mingli",
            "text": "Do you guys think he's getting old and starting to forget things?"
          }
        }
      }
    },
    {
      "subId": "7111152",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711115201"
        ],
        "dialogs": {
          "711115201": {
            "id": "711115201",
            "speakerId": 2254,
            "speakerName": "Mingli",
            "text": "It's not over yet? Did something unexpected happen?",
            "nextDialogs": [
              "711115202"
            ]
          },
          "711115202": {
            "id": "711115202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's over.",
            "nextDialogs": [
              "711115203"
            ]
          },
          "711115203": {
            "id": "711115203",
            "speakerId": 2254,
            "speakerName": "Mingli",
            "text": "Huh!? Did Boss forget that I'm waiting at the end!? Is his age finally catching up with him...",
            "nextDialogs": [
              "711115204"
            ]
          },
          "711115204": {
            "id": "711115204",
            "speakerId": 2254,
            "speakerName": "Mingli",
            "text": "Perhaps it's time for me to start looking at other options..."
          }
        }
      }
    },
    {
      "subId": "7111199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711119901"
        ],
        "dialogs": {
          "711119901": {
            "id": "711119901",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "This is the place. Please, do it!",
            "nextDialogs": [
              "711119902"
            ]
          },
          "711119902": {
            "id": "711119902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, who's the real bandit here?",
            "nextDialogs": [
              "711119903"
            ]
          },
          "711119903": {
            "id": "711119903",
            "speakerId": 1008,
            "speakerName": "Startled Treasure Hoarder",
            "text": "Hmm!? Who are you? We're with the Iron and Salt Gang, so you'd better watch yourself around us!",
            "nextDialogs": [
              "711119904"
            ]
          },
          "711119904": {
            "id": "711119904",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Ah! My Yun! These wicked Treasure Hoarders didn't bully you, did they?",
            "nextDialogs": [
              "711119905"
            ]
          },
          "711119905": {
            "id": "711119905",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, do you really have to get all that fuzzy-wuzzy with a Sumpter Beast?",
            "nextDialogs": [
              "711119906"
            ]
          },
          "711119906": {
            "id": "711119906",
            "speakerId": 1008,
            "speakerName": "Startled Treasure Hoarder",
            "text": "Hmm!? Who are you? We're with the Iron and Salt Gang, so you'd better watch yourself around us!",
            "nextDialogs": [
              "711119907"
            ]
          },
          "711119907": {
            "id": "711119907",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why are there Treasure Hoarders here too!?",
            "nextDialogs": [
              "711119908"
            ]
          },
          "711119908": {
            "id": "711119908",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, and they're raising that Sumpter Beast? They sure do have time on their hands...",
            "nextDialogs": [
              "711119912"
            ]
          },
          "711119912": {
            "id": "711119912",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Yunyun's stopped!",
            "nextDialogs": [
              "711119913"
            ]
          },
          "711119913": {
            "id": "711119913",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "See? What did I say?",
            "nextDialogs": [
              "711119914"
            ]
          },
          "711119914": {
            "id": "711119914",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You say that, but... Chili Pepper's stopped, too.",
            "nextDialogs": [
              "711119915"
            ]
          },
          "711119915": {
            "id": "711119915",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "They must both be hungry.",
            "nextDialogs": [
              "711119916"
            ]
          },
          "711119916": {
            "id": "711119916",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa! That Sumpter Beast's charging, now that's what Paimon calls energy!"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7111101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711110101"
        ],
        "dialogs": {
          "711110101": {
            "id": "711110101",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Dear passersby, could you please help a poor old man?",
            "nextDialogs": [
              "711110102"
            ]
          },
          "711110102": {
            "id": "711110102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "711110103"
            ]
          },
          "711110103": {
            "id": "711110103",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "My precious Yun has gone missing. I've searched all over for it, but it's nowhere to be found... Well, there's a Treasure Hoarder camp too, but I dare not go there...",
            "nextDialogs": [
              "711110104"
            ]
          },
          "711110104": {
            "id": "711110104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yun?",
            "nextDialogs": [
              "711110105"
            ]
          },
          "711110105": {
            "id": "711110105",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "My precious, yes! My Yunyun, a Sumpter Beast by that name!",
            "nextDialogs": [
              "711110106"
            ]
          },
          "711110106": {
            "id": "711110106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A Sumpter Beast... Huh. So people from Liyue keep those too, do they?",
            "nextDialogs": [
              "711110107"
            ]
          },
          "711110107": {
            "id": "711110107",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Well, moving large quantities of cargo through the mountains is always a challenge for merchants who run long routes like we do. Cows are too slow, while mules and ponies carry too little, and arranging for food and drink for porters is too expensive...",
            "nextDialogs": [
              "711110108"
            ]
          },
          "711110108": {
            "id": "711110108",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "So I had this idea — what if I simply bought a few Sumpter Beasts of good stock from Sumeru? That way, I'd be able to transport goods in bulk without worry!",
            "nextDialogs": [
              "711110109"
            ]
          },
          "711110109": {
            "id": "711110109",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "I didn't think that someone would just... steal my Sumpter Beast just as I entered Chenyu Vale! Ah... My Yun! My Mora!",
            "nextDialogs": [
              "711110110"
            ]
          },
          "711110110": {
            "id": "711110110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Err, d—don't cry! You're a grown man, y'know?",
            "nextDialogs": [
              "711110112",
              "711110116"
            ]
          },
          "711110112": {
            "id": "711110112",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "You can't calculate it so simply. Look, the Sumpter Beasts I bought come in a group, and they're of good stock, too. As long as I'm successful in breeding them, I've no doubt that they'll have adapted to Liyue's environment in two to three generations.",
            "nextDialogs": [
              "711110113"
            ]
          },
          "711110113": {
            "id": "711110113",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Hehe, and once those two to three generations have passed, I'll rent my grown Sumpter Beasts out or sell them off — that's how I'll recoup all my costs!",
            "nextDialogs": [
              "711110114"
            ]
          },
          "711110114": {
            "id": "711110114",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "*sigh* But right now, as you can see... Ah, what a loss! My Yun...",
            "nextDialogs": [
              "711110119"
            ]
          },
          "711110119": {
            "id": "711110119",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "I bought these three precious Sumpter Beasts, and it was such an effort, too... Never mind how I feel about them...",
            "nextDialogs": [
              "711110120"
            ]
          },
          "711110120": {
            "id": "711110120",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Chili has always been the most obedient, and it's been here all this time. Jue was very mischievous, and ran off long ago.",
            "nextDialogs": [
              "711110121"
            ]
          },
          "711110121": {
            "id": "711110121",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "If even Yun should leave me... It would be a loss I could never, ever recover from!",
            "nextDialogs": [
              "711110122"
            ]
          },
          "711110122": {
            "id": "711110122",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah... Well, the remaining Sumpter Beast definitely seems to be having a hard time. All alone, without any companions...",
            "nextDialogs": [
              "711110123"
            ]
          },
          "711110123": {
            "id": "711110123",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Surely, you two kind souls will help me, right? I've been wallowing here in my trouble for half the day, and only you two have paid me any mind..."
          },
          "711110116": {
            "id": "711110116",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Well, this... I don't... Actually, wait! I did say earlier that there was a Treasure Hoarder camp nearby, right? Yun's disappearance must have something to do with them!",
            "nextDialogs": [
              "711110117"
            ]
          },
          "711110117": {
            "id": "711110117",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Those crooks have been active in this area all this time. If I hadn't spent all the funds allocated for guards on the Sumpter Beasts, then maybe... *sigh*",
            "nextDialogs": [
              "711110118"
            ]
          },
          "711110118": {
            "id": "711110118",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "As their name would suggest, they steal treasures, don't they? Well, then, I think they were the ones who stole Yun!"
          }
        }
      }
    },
    {
      "subId": "7111106",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711110601"
        ],
        "dialogs": {
          "711110601": {
            "id": "711110601",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Yun! My Yun! I've come to take you home!",
            "nextDialogs": [
              "711110602"
            ]
          },
          "711110602": {
            "id": "711110602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yun?",
            "nextDialogs": [
              "711110603"
            ]
          },
          "711110603": {
            "id": "711110603",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "It's my precious, my baby Yunyun, stolen by these Treasure Hoarders!",
            "nextDialogs": [
              "711110604"
            ]
          },
          "711110604": {
            "id": "711110604",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "I've been a merchant for many years, and all my savings went into my three precious Sumpter Beasts. Chili is the most obedient and has always stayed with me. Jue, the most mischievous, ran off a long time ago...",
            "nextDialogs": [
              "711110605"
            ]
          },
          "711110605": {
            "id": "711110605",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "If even Yun should leave me... Ah, that would be tragedy unbearable! Thank you, good folk, truly!",
            "nextDialogs": [
              "711110606"
            ]
          },
          "711110606": {
            "id": "711110606",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "You must've suffered, haven't you? I've brought you your favorite Jueyun Chilis! Come, come, have some!",
            "nextDialogs": [
              "711110607"
            ]
          },
          "711110607": {
            "id": "711110607",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Hmm? You're not eating them anymore, Yun? ...Have you learned the wrong lessons while you've been out and about? Come on, eat!",
            "nextDialogs": [
              "711110608"
            ]
          },
          "711110608": {
            "id": "711110608",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, do Sumpter Beasts even eat Jueyun Chilis?",
            "nextDialogs": [
              "711110609"
            ]
          },
          "711110609": {
            "id": "711110609",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "That's what I've been feeding Yun this whole time! Surely I know what it likes!",
            "nextDialogs": [
              "711110610"
            ]
          },
          "711110610": {
            "id": "711110610",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "You're a disgrace, old man... Don't you know that Sumpter Beasts like eating fruit?",
            "nextDialogs": [
              "711110611"
            ]
          },
          "711110611": {
            "id": "711110611",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Unless they're practically starving, they won't eat Jueyun Chilis — that stuff's bad for their health.",
            "nextDialogs": [
              "711110612"
            ]
          },
          "711110612": {
            "id": "711110612",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? And who in the world are you?",
            "nextDialogs": [
              "711110614",
              "711110618"
            ]
          },
          "711110614": {
            "id": "711110614",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, and here Paimon thought that it might be someone actually important...",
            "nextDialogs": [
              "711110615"
            ]
          },
          "711110615": {
            "id": "711110615",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Well, either way, Yun's back with us, so let's head back...",
            "nextDialogs": [
              "711110616"
            ]
          },
          "711110616": {
            "id": "711110616",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Hey! Don't you ignore me!",
            "nextDialogs": [
              "711110622"
            ]
          },
          "711110622": {
            "id": "711110622",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Hmph, alright... you thief.",
            "nextDialogs": [
              "711110623"
            ]
          },
          "711110623": {
            "id": "711110623",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Your comrades have all been brought to justice, but still, you dare to say this and that about my precious...",
            "nextDialogs": [
              "711110624"
            ]
          },
          "711110624": {
            "id": "711110624",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "\"Say\"? I'll give you \"say.\" Gainsay, soothsay, hearsay, assay, naysay..."
          },
          "711110618": {
            "id": "711110618",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, so spooky!",
            "nextDialogs": [
              "711110619"
            ]
          },
          "711110619": {
            "id": "711110619",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "So sneaky!",
            "nextDialogs": [
              "711110620"
            ]
          },
          "711110620": {
            "id": "711110620",
            "speakerId": 2232,
            "speakerName": "Yunyun",
            "text": "Moo!",
            "nextDialogs": [
              "711110621"
            ]
          },
          "711110621": {
            "id": "711110621",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Oi! Quit making mountains out of molehills, you!"
          }
        }
      }
    },

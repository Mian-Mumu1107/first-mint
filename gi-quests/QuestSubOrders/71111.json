    {
      "subId": "7111110",
      "subQuestName": "Talk to Wenhua",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711111001"
        ],
        "dialogs": {
          "711111001": {
            "id": "711111001",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "See? Chili's doing great! And on the other hand... Yun's doing so poorly it breaks my heart.",
            "nextDialogs": [
              "711111002"
            ]
          },
          "711111002": {
            "id": "711111002",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "Are you sure your eyes are working right, old man? Isn't it the other way around?",
            "nextDialogs": [
              "711111003"
            ]
          },
          "711111003": {
            "id": "711111003",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh... Y'know, Paimon can't really tell either way. They just look pretty similar. Maybe we'll need them to walk around a bit to tell.",
            "nextDialogs": [
              "711111004"
            ]
          },
          "711111004": {
            "id": "711111004",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Please, could the two of you be our referees? I'm sure you'll be impartial.",
            "nextDialogs": [
              "711111005"
            ]
          },
          "711111005": {
            "id": "711111005",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And what are the rules, exactly?",
            "nextDialogs": [
              "711111006"
            ]
          },
          "711111006": {
            "id": "711111006",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "We'll just see who gets to the finish line first — Yun, or Chili! I'll have my assistant wait at the finish line.",
            "nextDialogs": [
              "711111007"
            ]
          },
          "711111007": {
            "id": "711111007",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "You can go over there now, Mingli.",
            "nextDialogs": [
              "711111008"
            ]
          },
          "711111008": {
            "id": "711111008",
            "speakerId": 2254,
            "speakerName": "Mingli",
            "text": "Yes, Boss.",
            "nextDialogs": [
              "711111009"
            ]
          },
          "711111009": {
            "id": "711111009",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "Old man, don't you think you're too tough on the Sumpter Beasts? Especially that Chili of yours, it looks super hungry.",
            "nextDialogs": [
              "711111010"
            ]
          },
          "711111010": {
            "id": "711111010",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Hahaha! Scared, young one? Making excuses, are we?",
            "nextDialogs": [
              "711111011"
            ]
          },
          "711111011": {
            "id": "711111011",
            "speakerId": 2231,
            "speakerName": "Tusheng",
            "text": "What slander. I'm only being considerate! Fine, let's compete! I ain't afraid of you none!",
            "nextDialogs": [
              "711111012"
            ]
          },
          "711111012": {
            "id": "711111012",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Heh, let's begin then. I'm about to teach you a good lesson.",
            "nextDialogs": [
              "711111013"
            ]
          },
          "711111013": {
            "id": "711111013",
            "speakerId": 2254,
            "speakerName": "Mingli",
            "text": "Boss, we can start now!",
            "nextDialogs": [
              "711111014"
            ]
          },
          "711111014": {
            "id": "711111014",
            "speakerId": 2488,
            "speakerName": "Wenhua",
            "text": "Okay, begin!"
          }
        }
      }
    },

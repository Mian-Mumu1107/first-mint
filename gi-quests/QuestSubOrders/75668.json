  "subQuests": [
    {
      "subId": "7566801",
      "subQuestName": "Talk to Avisura",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "756680101"
        ],
        "dialogs": {
          "756680101": {
            "id": "756680101",
            "speakerId": 1000,
            "speakerName": "Avisura",
            "text": "In with the mushrooms... and now some wild root veggies...",
            "nextDialogs": [
              "756680102"
            ]
          },
          "756680102": {
            "id": "756680102",
            "speakerId": 1000,
            "speakerName": "Avisura",
            "text": "#The drink's all ready! Want to try some, {NICKNAME}?",
            "nextDialogs": [
              "756680103"
            ]
          },
          "756680103": {
            "id": "756680103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm sorry, did you say... \"mushrooms\"?",
            "nextDialogs": [
              "756680104"
            ]
          },
          "756680104": {
            "id": "756680104",
            "speakerId": 1000,
            "speakerName": "Avisura",
            "text": "Sure did! All just ordinary ingredients and seasonings to help improve the flavor.",
            "nextDialogs": [
              "756680105"
            ]
          },
          "756680105": {
            "id": "756680105",
            "speakerId": 1000,
            "speakerName": "Avisura",
            "text": "The stage is set, and ordinary drinks simply won't do justice to the music that's about to be served.",
            "nextDialogs": [
              "756680106"
            ]
          },
          "756680106": {
            "id": "756680106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "If you say so...",
            "nextDialogs": [
              "756680107"
            ]
          },
          "756680107": {
            "id": "756680107",
            "speakerId": 1000,
            "speakerName": "Avisura",
            "text": "Oh, don't worry! You're hardly the first person to try this drink today. And the others are all perfectly fine!",
            "nextDialogs": [
              "756680108"
            ]
          },
          "756680108": {
            "id": "756680108",
            "speakerId": 1000,
            "speakerName": "Avisura",
            "text": "See? They're already dancing by the stage, drinks in hand and all.",
            "nextDialogs": [
              "756680109"
            ]
          },
          "756680109": {
            "id": "756680109",
            "speakerId": 1000,
            "speakerName": "Avisura",
            "text": "#Come on, {NICKNAME}! Grab a cup and let's get moving to the music!",
            "nextDialogs": [
              "756680110"
            ]
          },
          "756680110": {
            "id": "756680110",
            "speakerId": 1000,
            "speakerName": "Avisura",
            "text": "Put your troubles aside and enjoy the music!",
            "nextDialogs": [
              "756680111"
            ]
          },
          "756680111": {
            "id": "756680111",
            "speakerId": 1000,
            "speakerName": "Avisura",
            "text": "Oh, but don't get too carried away, especially when you're dancing. We don't want anybody getting injured out there!",
            "nextDialogs": [
              "756680112"
            ]
          },
          "756680112": {
            "id": "756680112",
            "speakerId": 1000,
            "speakerName": "Avisura",
            "text": "Some folks danced themselves into a stupor earlier. Even when they were being carried away, they were mumbling something barely coherent...",
            "nextDialogs": [
              "756680113"
            ]
          },
          "756680113": {
            "id": "756680113",
            "speakerId": 1000,
            "speakerName": "Avisura",
            "text": "\"I can— I can see the hilichurls... They're dancing beside me...\"",
            "nextDialogs": [
              "756680114"
            ]
          },
          "756680114": {
            "id": "756680114",
            "speakerId": 1000,
            "speakerName": "Avisura",
            "text": "...Anyway, I'm sure you get the picture. Get onstage and have some fun!"
          }
        }
      }
    }
  ]
}
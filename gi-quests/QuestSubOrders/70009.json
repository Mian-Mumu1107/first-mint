    {
      "subId": "7000904",
      "subQuestName": "Talk to Lily",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090201"
        ],
        "dialogs": {
          "700090201": {
            "id": "700090201",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Why can't that Mister Fatooey go to the Weedplume Festival?",
            "nextDialogs": [
              "700090203",
              "700090205"
            ]
          },
          "700090203": {
            "id": "700090203",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Impotent work? Even more impotent than the Weedplume Festival?",
            "nextDialogs": [
              "700090207"
            ]
          },
          "700090207": {
            "id": "700090207",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "But even if that Fatooey's done a lot of bad, bad things, he can become a good person again if he changes, right?",
            "nextDialogs": [
              "700090208"
            ]
          },
          "700090208": {
            "id": "700090208",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "I'm going to tell him that if he becomes a good person, he can take part in the Weedplume Festival!",
            "nextDialogs": [
              "700090209"
            ]
          },
          "700090209": {
            "id": "700090209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That man's really busy right now. Let's go out and play first, alright?",
            "nextDialogs": [
              "700090210"
            ]
          },
          "700090210": {
            "id": "700090210",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Oh... okay. Can you take me out to play then?",
            "nextDialogs": [
              "700090211"
            ]
          },
          "700090211": {
            "id": "700090211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure can, just... not too far out, alright?",
            "nextDialogs": [
              "700090212"
            ]
          },
          "700090212": {
            "id": "700090212",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Yay! Let's go, let's go!"
          },
          "700090205": {
            "id": "700090205",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Why not? Is it because the Fatooey are bad, bad people? Dadda says that they don't brush their teeth before they sleep and eat with their hands...",
            "nextDialogs": [
              "700090206"
            ]
          },
          "700090206": {
            "id": "700090206",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Mm... I guess they are bad people, then. I'm sure that Fatooey's Dadda would be mad, too..."
          }
        }
      }
    },
    {
      "subId": "7000905",
      "subQuestName": "Head to Mondstadt's market district",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090501"
        ],
        "dialogs": {
          "700090501": {
            "id": "700090501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About feeding the puppies...",
            "nextDialogs": [
              "700090502"
            ]
          },
          "700090502": {
            "id": "700090502",
            "speakerId": 1423,
            "speakerName": "Blanche",
            "text": "Ah, Lily, Traveler, you're back. Did you find the puppies?",
            "nextDialogs": [
              "700090503"
            ]
          },
          "700090503": {
            "id": "700090503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yup.",
            "nextDialogs": [
              "700090504"
            ]
          },
          "700090504": {
            "id": "700090504",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "We sure did! Thanks, big sis! We had so much fun!",
            "nextDialogs": [
              "700090505"
            ]
          },
          "700090505": {
            "id": "700090505",
            "speakerId": 1423,
            "speakerName": "Blanche",
            "text": "That's good. Oh, yes, if the two of you have some time, you could go over to Flora's.",
            "nextDialogs": [
              "700090506"
            ]
          },
          "700090506": {
            "id": "700090506",
            "speakerId": 1423,
            "speakerName": "Blanche",
            "text": "It's the Windblume Festival, after all. It would be good to bring a bouquet of flowers back with you, wouldn't it?",
            "nextDialogs": [
              "700090507"
            ]
          },
          "700090507": {
            "id": "700090507",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Wow... That's true! I wanna go...",
            "nextDialogs": [
              "700090508"
            ]
          },
          "700090508": {
            "id": "700090508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Say no more, let's be off!",
            "nextDialogs": [
              "700090509"
            ]
          },
          "700090509": {
            "id": "700090509",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Yaaaay! Thanks!"
          }
        }
      }
    },
    {
      "subId": "7000906",
      "subQuestName": "Talk to Blanche",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090302"
        ],
        "dialogs": {
          "700090302": {
            "id": "700090302",
            "speakerId": 1423,
            "speakerName": "Blanche",
            "text": "Traveler? Is there something you need?",
            "nextDialogs": [
              "700090303"
            ]
          },
          "700090303": {
            "id": "700090303",
            "speakerId": 1423,
            "speakerName": "Blanche",
            "text": "And... is that you, Lily? Why are you here? Where are your parents?",
            "nextDialogs": [
              "700090304"
            ]
          },
          "700090304": {
            "id": "700090304",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "#Dadda and Mommy have something really impotent to do! That's why {F#she's}{M#he's} bringing me around to play!",
            "nextDialogs": [
              "700090305"
            ]
          },
          "700090305": {
            "id": "700090305",
            "speakerId": 1423,
            "speakerName": "Blanche",
            "text": "Something very important? Ah, Rudolf and Jilliana, they...",
            "nextDialogs": [
              "700090306"
            ]
          },
          "700090306": {
            "id": "700090306",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Big sis, what happened to those puppies from earlier?",
            "nextDialogs": [
              "700090307"
            ]
          },
          "700090307": {
            "id": "700090307",
            "speakerId": 1423,
            "speakerName": "Blanche",
            "text": "Oh, the puppies? Um, I'm not very sure myself, actually. They usually hide in their kennel and only show up when I put food in their bowl.",
            "nextDialogs": [
              "700090308"
            ]
          },
          "700090308": {
            "id": "700090308",
            "speakerId": 1423,
            "speakerName": "Blanche",
            "text": "Maybe it's all this noise around us that's driven them out?",
            "nextDialogs": [
              "700090309"
            ]
          },
          "700090309": {
            "id": "700090309",
            "speakerId": 1423,
            "speakerName": "Blanche",
            "text": "Do you want to play with them, Lily?",
            "nextDialogs": [
              "700090310"
            ]
          },
          "700090310": {
            "id": "700090310",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Yup! I do! I wanna play with them!",
            "nextDialogs": [
              "700090311"
            ]
          },
          "700090311": {
            "id": "700090311",
            "speakerId": 1423,
            "speakerName": "Blanche",
            "text": "Huh... Let me think. I don't think looking for them is going to do us any good... Perhaps you could put some food into that bowl. Let's see if that attracts them.",
            "nextDialogs": [
              "700090312"
            ]
          },
          "700090312": {
            "id": "700090312",
            "speakerId": 1423,
            "speakerName": "Blanche",
            "text": "I think that some Fowl would do the trick best.",
            "nextDialogs": [
              "700090313"
            ]
          },
          "700090313": {
            "id": "700090313",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Eh? But where are we gonna find some...",
            "nextDialogs": [
              "700090314"
            ]
          },
          "700090314": {
            "id": "700090314",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I can take care of that.",
            "nextDialogs": [
              "700090315"
            ]
          },
          "700090315": {
            "id": "700090315",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Really? Thank you! Then let's go feed the puppies!"
          }
        }
      }
    },
    {
      "subId": "7000907",
      "subQuestName": "Place Fowl into the bowl",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090701"
        ],
        "dialogs": {
          "700090701": {
            "id": "700090701",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Yup, that's the wok, alright! Wait for me!",
            "nextDialogs": [
              "700090702"
            ]
          },
          "700090702": {
            "id": "700090702",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Gotta stand on a chair... Could you help me get a chair?",
            "nextDialogs": [
              "700090703"
            ]
          },
          "700090703": {
            "id": "700090703",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Alright, it's done! I've got three pancakes right here. One for you, one for me, and one for Mister Fatooey!",
            "nextDialogs": [
              "700090704"
            ]
          },
          "700090704": {
            "id": "700090704",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Alright then, let's go back!"
          }
        }
      }
    },
    {
      "subId": "7000908",
      "subQuestName": "Talk to Lily",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090401"
        ],
        "dialogs": {
          "700090401": {
            "id": "700090401",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Come on, puppies, we've got good food...",
            "nextDialogs": [
              "700090402"
            ]
          },
          "700090402": {
            "id": "700090402",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Wow! They're here, they're here! I wanna pet them...",
            "nextDialogs": [
              "700090403"
            ]
          },
          "700090403": {
            "id": "700090403",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Aw, they're so soft and fluffy. Mister Fatooey said that he has lots of puppies back home, too!",
            "nextDialogs": [
              "700090404"
            ]
          },
          "700090404": {
            "id": "700090404",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "But he said that his puppies are really, really big and really, really furry. I bet they'd be so nice to pet..."
          }
        }
      }
    },
    {
      "subId": "7000909",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090901"
        ],
        "dialogs": {
          "700090901": {
            "id": "700090901",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "The Windblume Festival... Hmph. It's got nothing to do with me either way."
          }
        }
      }
    },
    {
      "subId": "7000910",
      "subQuestName": "Report back to Blanche",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }

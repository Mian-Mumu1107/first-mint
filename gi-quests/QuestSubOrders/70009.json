    {
      "subId": "7000902",
      "subQuestName": "Talk to Viktor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090801"
        ],
        "dialogs": {
          "700090801": {
            "id": "700090801",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Finally back, are you? Great timing, I was just getting tired of that sister looking at me like I colluded with you to do something to Lily...",
            "nextDialogs": [
              "700090802"
            ]
          },
          "700090802": {
            "id": "700090802",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "But at least that kid's not—",
            "nextDialogs": [
              "700090803"
            ]
          },
          "700090803": {
            "id": "700090803",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Mister! Here, this is for you!",
            "nextDialogs": [
              "700090804"
            ]
          },
          "700090804": {
            "id": "700090804",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "A Dandelion and a pancake? This...",
            "nextDialogs": [
              "700090805"
            ]
          },
          "700090805": {
            "id": "700090805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's a gift.",
            "nextDialogs": [
              "700090806"
            ]
          },
          "700090806": {
            "id": "700090806",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "A... a gift? This Dandelion's barely got anything more than its stalk left, and the pancake...",
            "nextDialogs": [
              "700090807"
            ]
          },
          "700090807": {
            "id": "700090807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Lily made it herself.",
            "nextDialogs": [
              "700090808"
            ]
          },
          "700090808": {
            "id": "700090808",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "...It looks... Why, it looks pretty good! Never would have thought that you had it in you, kid...",
            "nextDialogs": [
              "700090809"
            ]
          },
          "700090809": {
            "id": "700090809",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Hehe, I learned from Mommy! Once you've eaten it, I wanna hear more of your stories, Mister!",
            "nextDialogs": [
              "700090810"
            ]
          },
          "700090810": {
            "id": "700090810",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "You still want to hear my...",
            "nextDialogs": [
              "700090811"
            ]
          },
          "700090811": {
            "id": "700090811",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Alright. Since you've given me a gift, I'll tell you a few more.",
            "nextDialogs": [
              "700090812"
            ]
          },
          "700090812": {
            "id": "700090812",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Hooray! Then I want to hear... about the Fatooey!",
            "nextDialogs": [
              "700090813"
            ]
          },
          "700090813": {
            "id": "700090813",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "*cough* I... No, it's... Those stories aren't very interesting, you know? I'll think of something better, just you wait!"
          }
        }
      }
    },
    {
      "subId": "7000910",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700091001"
        ],
        "dialogs": {
          "700091001": {
            "id": "700091001",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "You seem to have had lots of fun chatting with that kid. I heard everything too, by the way.",
            "nextDialogs": [
              "700091002"
            ]
          },
          "700091002": {
            "id": "700091002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Mora for your thoughts?",
            "nextDialogs": [
              "700091003"
            ]
          },
          "700091003": {
            "id": "700091003",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "They're the dreams of a little child. I've got nothing to say about them either way.",
            "nextDialogs": [
              "700091004"
            ]
          },
          "700091004": {
            "id": "700091004",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "If the world was so easily divided into good and evil, then many things would...",
            "nextDialogs": [
              "700091005"
            ]
          },
          "700091005": {
            "id": "700091005",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "...Whatever. I'll say no more. Go take her out to play."
          }
        }
      }
    }
  ]
}
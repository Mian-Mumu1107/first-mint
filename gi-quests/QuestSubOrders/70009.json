  "subQuests": [
    {
      "subId": "7000901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090101"
        ],
        "dialogs": {
          "700090101": {
            "id": "700090101",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Mister, are you Fatooey not celebrating the Weedplume Festival?",
            "nextDialogs": [
              "700090102"
            ]
          },
          "700090102": {
            "id": "700090102",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "I, uh, probably won't...?",
            "nextDialogs": [
              "700090103"
            ]
          },
          "700090103": {
            "id": "700090103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And what are you up to?",
            "nextDialogs": [
              "700090104"
            ]
          },
          "700090104": {
            "id": "700090104",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Who, me? Oh, it's you. Come on, why are you giving me that look of suspicion again?",
            "nextDialogs": [
              "700090105"
            ]
          },
          "700090105": {
            "id": "700090105",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "I was just talking to that kid. I wasn't going to do anything bad!",
            "nextDialogs": [
              "700090106"
            ]
          },
          "700090106": {
            "id": "700090106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Seems like you Fatui really don't celebrate the Windblume Festival.",
            "nextDialogs": [
              "700090107"
            ]
          },
          "700090107": {
            "id": "700090107",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Wait, what about you? Are you not gonna enjoy the Weedplume Festival either?",
            "nextDialogs": [
              "700090108"
            ]
          },
          "700090108": {
            "id": "700090108",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Well, I'm sure that Mondstadt's Honorary Knight has a great many duties to attend to during the Windblume Festival. Isn't that right?",
            "nextDialogs": [
              "700090109"
            ]
          },
          "700090109": {
            "id": "700090109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're looking very smug, what are you up to?",
            "nextDialogs": [
              "700090110"
            ]
          },
          "700090110": {
            "id": "700090110",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Ahem... nothing, nothing. And speaking of nothing, if you haven't got anything else to do, why don't you do me a quick favor?",
            "nextDialogs": [
              "700090111"
            ]
          },
          "700090111": {
            "id": "700090111",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "This kid's parents have gone out shopping amid the festival, so she's been left here in the care of the sisters.",
            "nextDialogs": [
              "700090112"
            ]
          },
          "700090112": {
            "id": "700090112",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "But as you know, everyone's got their own fair share of business to attend to because of the festivities, even the sisters. They've got no time to play with the girl.",
            "nextDialogs": [
              "700090113"
            ]
          },
          "700090113": {
            "id": "700090113",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "And that's how she latched on to me. But as you must also surely know, I can't simply leave the Cathedral, so the only thing I can do is talk to her.",
            "nextDialogs": [
              "700090114"
            ]
          },
          "700090114": {
            "id": "700090114",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "What a shame, that even in this I must withstand the stares of that sister over there...",
            "nextDialogs": [
              "700090115"
            ]
          },
          "700090115": {
            "id": "700090115",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "I'll wager that she's thinking \"oh, I wonder what that evil Fatui schemer has in mind this time\" or something right about now.",
            "nextDialogs": [
              "700090116"
            ]
          },
          "700090116": {
            "id": "700090116",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Hmph. So, to get that sister off my back, and for the psychological well-being of this child...",
            "nextDialogs": [
              "700090117"
            ]
          },
          "700090117": {
            "id": "700090117",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Might our glorious, righteous Honorary Knight deign to take this child out to play?",
            "nextDialogs": [
              "700090119",
              "700090123"
            ]
          },
          "700090119": {
            "id": "700090119",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Oh ho, how very straightforward. But then again, you're the Honorary Knight! How silly of me, to think that you might quibble with me for some remuneration...",
            "nextDialogs": [
              "700090120"
            ]
          },
          "700090120": {
            "id": "700090120",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Come on, just take the kid and go. I'll just be over here, getting a hole drilled into the back of my skull by these sisters...",
            "nextDialogs": [
              "700090121"
            ]
          },
          "700090121": {
            "id": "700090121",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "*sigh* When will these days finally come to an end?"
          },
          "700090123": {
            "id": "700090123",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "You... Agh, whatever. I'm with the Fatui. We're villains, got it? No bleeding hearts around here.",
            "nextDialogs": [
              "700090124"
            ]
          },
          "700090124": {
            "id": "700090124",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Just... Go on, shoo. Take that kid and go off to play. She's killing me over here.",
            "nextDialogs": [
              "700090125"
            ]
          },
          "700090125": {
            "id": "700090125",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "As for me... I'll just be over here, getting a hole drilled into the back of my skull by these sisters...",
            "nextDialogs": [
              "700090126"
            ]
          },
          "700090126": {
            "id": "700090126",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "*sigh* When will these days finally come to an end?"
          }
        }
      }
    },
    {
      "subId": "7000903",

    {
      "subId": "7000911",
      "subQuestName": "Talk to Flora",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700090602"
        ],
        "dialogs": {
          "700090602": {
            "id": "700090602",
            "speakerId": 1425,
            "speakerName": "Flora",
            "text": "Hehe. How are you? Here to buy flowers?",
            "nextDialogs": [
              "700090603"
            ]
          },
          "700090603": {
            "id": "700090603",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Wow, there are so many of them...",
            "nextDialogs": [
              "700090604"
            ]
          },
          "700090604": {
            "id": "700090604",
            "speakerId": 1425,
            "speakerName": "Flora",
            "text": "Hmm, Lily? Why are you out with the Traveler?",
            "nextDialogs": [
              "700090605"
            ]
          },
          "700090605": {
            "id": "700090605",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "#Dadda and Mommy have something really impotent to do! That's why {F#she's}{M#he's} bringing me around to play!",
            "nextDialogs": [
              "700090606"
            ]
          },
          "700090606": {
            "id": "700090606",
            "speakerId": 1425,
            "speakerName": "Flora",
            "text": "Important things, huh? Well, I've certainly got a few ideas about what that might be...",
            "nextDialogs": [
              "700090607"
            ]
          },
          "700090607": {
            "id": "700090607",
            "speakerId": 1425,
            "speakerName": "Flora",
            "text": "But never mind that. Do you two need anything?",
            "nextDialogs": [
              "700090608"
            ]
          },
          "700090608": {
            "id": "700090608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just here to look at the flowers.",
            "nextDialogs": [
              "700090609"
            ]
          },
          "700090609": {
            "id": "700090609",
            "speakerId": 1425,
            "speakerName": "Flora",
            "text": "Just here to look, huh? Hmm, how about this. I happen to have a Dandelion with me right now. Here, Lily, this is for you.",
            "nextDialogs": [
              "700090610"
            ]
          },
          "700090610": {
            "id": "700090610",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "Really? Thanks!",
            "nextDialogs": [
              "700090611"
            ]
          },
          "700090611": {
            "id": "700090611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That was sudden...",
            "nextDialogs": [
              "700090612"
            ]
          },
          "700090612": {
            "id": "700090612",
            "speakerId": 1425,
            "speakerName": "Flora",
            "text": "Well, Rudolf has actually ordered a huge bouquet to give to Jilliana...",
            "nextDialogs": [
              "700090613"
            ]
          },
          "700090613": {
            "id": "700090613",
            "speakerId": 1425,
            "speakerName": "Flora",
            "text": "Giving out one complimentary Dandelion isn't much in comparison.",
            "nextDialogs": [
              "700090614"
            ]
          },
          "700090614": {
            "id": "700090614",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "This Dandelion's so pwetty... But I gotta go back soon, or Dadda and Mommy are going to worry when they don't see me...",
            "nextDialogs": [
              "700090615"
            ]
          },
          "700090615": {
            "id": "700090615",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "#Wait. Before we go back... Do you know where we can find a great big wok, {F#big sis}{M#big bro}?",
            "nextDialogs": [
              "700090616"
            ]
          },
          "700090616": {
            "id": "700090616",
            "speakerId": 1599,
            "speakerName": "Lily",
            "text": "I've seen Mommy make pancakes before, and I'd like to make you some too, as thanks for taking me out to play!"
          }
        }
      }
    },

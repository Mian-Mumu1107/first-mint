    {
      "subId": "1501507",
      "subQuestName": "Pursue Tlazolli",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150150701"
        ],
        "dialogs": {
          "150150701": {
            "id": "150150701",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "You got here quick. Impressive.",
            "nextDialogs": [
              "150150702"
            ]
          },
          "150150702": {
            "id": "150150702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Nechca's up there! What are you planning to do to her!?",
            "nextDialogs": [
              "150150703"
            ]
          },
          "150150703": {
            "id": "150150703",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "I never lied to you. All this time, I've only been trying to save my daughter.",
            "nextDialogs": [
              "150150704"
            ]
          },
          "150150704": {
            "id": "150150704",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "Even though she's not my daughter yet... But once everything is over, she will really become my Nechca.",
            "nextDialogs": [
              "150150705"
            ]
          },
          "150150705": {
            "id": "150150705",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What is she saying? Is she not Nechca?",
            "nextDialogs": [
              "150150708"
            ]
          },
          "150150708": {
            "id": "150150708",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "So you've figured it out? I want to use memories to awaken my Nechca.",
            "nextDialogs": [
              "150150709"
            ]
          },
          "150150709": {
            "id": "150150709",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "She has stayed in the Night Kingdom for far too long... She's afraid of the dark and cold.",
            "nextDialogs": [
              "150150710"
            ]
          },
          "150150710": {
            "id": "150150710",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "I'm the one who made her stay there alone, so I must bring her back.",
            "nextDialogs": [
              "150150711"
            ]
          },
          "150150711": {
            "id": "150150711",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "Don't worry, Nechca. Mom hasn't forgotten anything, she has always remembered your name..."
          }
        }
      }
    },
    {
      "subId": "1501508",
      "subQuestName": "Stop Tlazolli's ritual",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1501501",
      "subQuestName": "Rescue Nepecha",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150150101"
        ],
        "dialogs": {
          "150150101": {
            "id": "150150101",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "I saw Nechca, and was speaking with her, but now, where... Where did she go!?",
            "nextDialogs": [
              "150150102"
            ]
          },
          "150150102": {
            "id": "150150102",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "Nechca? Nechca! Where are you? Answer Mommy! Please... Please!",
            "nextDialogs": [
              "150150103"
            ]
          },
          "150150103": {
            "id": "150150103",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "Xilonen! You saw her too, didn't you? You saw my little Nechca!",
            "nextDialogs": [
              "150150104"
            ]
          },
          "150150104": {
            "id": "150150104",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "I felt her hands and hugged her. I was right... I was right...",
            "nextDialogs": [
              "150150105"
            ]
          },
          "150150105": {
            "id": "150150105",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "Those gray shadows were just a minor mistake... I just need to restart the ritual again... Right, I'll start it again, and Nechca will...",
            "nextDialogs": [
              "150150106"
            ]
          },
          "150150106": {
            "id": "150150106",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "Have you still not come to your senses, Auntie?",
            "nextDialogs": [
              "150150107"
            ]
          },
          "150150107": {
            "id": "150150107",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "Hmm? What senses? I was not wrong. Nothing about what happened was wrong!",
            "nextDialogs": [
              "150150108"
            ]
          },
          "150150108": {
            "id": "150150108",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "She's just a little upset and was trying to ignore me... That child sure knows how to throw a tantrum... B—But I understand, I can accept that!",
            "nextDialogs": [
              "150150109"
            ]
          },
          "150150109": {
            "id": "150150109",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "Enough, Tlazolli!",
            "nextDialogs": [
              "150150110"
            ]
          },
          "150150110": {
            "id": "150150110",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "The person you summoned with the Blazegem Inscription wasn't the real Nechca at all.",
            "nextDialogs": [
              "150150111"
            ]
          },
          "150150111": {
            "id": "150150111",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "You collected memories of Nechca from countless people, but you forgot one thing...",
            "nextDialogs": [
              "150150112"
            ]
          },
          "150150112": {
            "id": "150150112",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "Among what you gathered were not only real memories but also countless emotions.",
            "nextDialogs": [
              "150150113"
            ]
          },
          "150150113": {
            "id": "150150113",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "Didn't you realize what kind of emotions people would feel upon seeing Nechca's condition?",
            "nextDialogs": [
              "150150114"
            ]
          },
          "150150114": {
            "id": "150150114",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "When people held a dying child's hand... when they felt her faint breath and saw the helplessness in her eyes... When they sensed her body growing colder and colder...",
            "nextDialogs": [
              "150150115"
            ]
          },
          "150150115": {
            "id": "150150115",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "What could they feel, but abject pain and sorrow?",
            "nextDialogs": [
              "150150116"
            ]
          },
          "150150116": {
            "id": "150150116",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "I... I took those emotions...",
            "nextDialogs": [
              "150150117"
            ]
          },
          "150150117": {
            "id": "150150117",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "You absorbed those emotions into the Blazegem Inscriptions, and solidified them as a piece of her past.",
            "nextDialogs": [
              "150150118"
            ]
          },
          "150150118": {
            "id": "150150118",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "Those gray figures were projections of that past. They could only reproduce the appearance of Nechca in her sickly state.",
            "nextDialogs": [
              "150150119"
            ]
          },
          "150150119": {
            "id": "150150119",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "What the real Nechca wished to say was drowned out by those twisted and painful thoughts.",
            "nextDialogs": [
              "150150120"
            ]
          },
          "150150120": {
            "id": "150150120",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "I... I didn't want things to turn out like this... All I wanted was to remember Nechca... to see her again...",
            "nextDialogs": [
              "150150121"
            ]
          },
          "150150121": {
            "id": "150150121",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "Nechca has always been with you, Auntie.",
            "nextDialogs": [
              "150150122"
            ]
          },
          "150150122": {
            "id": "150150122",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "Everything has long been recorded on your Ancient Name... The one you said was \"useless.\"",
            "nextDialogs": [
              "150150123"
            ]
          },
          "150150123": {
            "id": "150150123",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "You exhausted every option and sacrificed everything in the hopes of saving your daughter... That's undeniable.",
            "nextDialogs": [
              "150150124"
            ]
          },
          "150150124": {
            "id": "150150124",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "But have you forgotten the true meaning of your own Ancient Name?",
            "nextDialogs": [
              "150150125"
            ]
          },
          "150150125": {
            "id": "150150125",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "My Ancient Name is... \"Und{RUBY#[D]Kinship}ugu\"...",
            "nextDialogs": [
              "150150126"
            ]
          },
          "150150126": {
            "id": "150150126",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "The immovable love between you and Nechca has already been recorded in your Ancient Name, but you chose to ignore that.",
            "nextDialogs": [
              "150150127"
            ]
          },
          "150150127": {
            "id": "150150127",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "\"Names are blessings from the past to the future...\" You told me that, Auntie.",
            "nextDialogs": [
              "150150128"
            ]
          },
          "150150128": {
            "id": "150150128",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "You gave Nechca her name, her first blessing.",
            "nextDialogs": [
              "150150129"
            ]
          },
          "150150129": {
            "id": "150150129",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "But now, you've turned her name into a prison by taking an innocent child captive... And you've imprisoned yourself.",
            "nextDialogs": [
              "150150130"
            ]
          },
          "150150130": {
            "id": "150150130",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "Nechca is everything to me. Without her, I can't see any future for me.",
            "nextDialogs": [
              "150150131"
            ]
          },
          "150150131": {
            "id": "150150131",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "And as for blessings... Haha. What blessings have I had since the day she passed? I see her in my dreams every day, grasping my hand... telling me she's in pain, asking me to hold her.",
            "nextDialogs": [
              "150150132"
            ]
          },
          "150150132": {
            "id": "150150132",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "But I can't say anything... I can't grasp her hand... All I can do is shout her name over and over again until I wake up.",
            "nextDialogs": [
              "150150133"
            ]
          },
          "150150133": {
            "id": "150150133",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "Every day... every single day, I've hated myself... and Ancient Names, too. Who knows... Maybe hate would have been the only thing left to her, too...",
            "nextDialogs": [
              "150150134"
            ]
          },
          "150150134": {
            "id": "150150134",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "You think... Nechca would have come to hate you?",
            "nextDialogs": [
              "150150135"
            ]
          },
          "150150135": {
            "id": "150150135",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "...",
            "nextDialogs": [
              "150150136"
            ]
          },
          "150150136": {
            "id": "150150136",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "Auntie, do you still remember the last words Nechca ever said to you? Do you remember what her final words really were?",
            "nextDialogs": [
              "150150137"
            ]
          },
          "150150137": {
            "id": "150150137",
            "speakerId": 14310,
            "speakerName": "Tlazolli",
            "text": "I... I...",
            "nextDialogs": [
              "150150138"
            ]
          },
          "150150138": {
            "id": "150150138",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "The reason you haven't felt blessed is because you've forgotten the true past... Auntie, you've been wallowing in memories of your imagination and refused to let go of them.",
            "nextDialogs": [
              "150150139"
            ]
          },
          "150150139": {
            "id": "150150139",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "A name without a past is nothing but a withered tree with no roots, rotting without a future.",
            "nextDialogs": [
              "150150140"
            ]
          },
          "150150140": {
            "id": "150150140",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "It's over, Auntie. It's all over now.",
            "nextDialogs": [
              "150150141"
            ]
          },
          "150150141": {
            "id": "150150141",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, slowly now. Why don't you stay lying down? Uh, on second thought, this might not be the best place to rest...",
            "nextDialogs": [
              "150150142"
            ]
          },
          "150150142": {
            "id": "150150142",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Xilonen! Nechca... uh, Nepecha can already stand now, so we made our way over.",
            "nextDialogs": [
              "150150145"
            ]
          },
          "150150145": {
            "id": "150150145",
            "speakerId": 14739,
            "speakerName": "Nepecha",
            "text": "#Thank you, Paimon, and {M#Mr.}{F#Miss} {NICKNAME}...",
            "nextDialogs": [
              "150150146"
            ]
          },
          "150150146": {
            "id": "150150146",
            "speakerId": 14739,
            "speakerName": "Nepecha",
            "text": "I'm fine, really. The real Nechca helped me just now, so it doesn't hurt much anymore.",
            "nextDialogs": [
              "150150147"
            ]
          },
          "150150147": {
            "id": "150150147",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "That's good. If you became Nechca, then this story would really become like Tequil the Brave.",
            "nextDialogs": [
              "150150148"
            ]
          },
          "150150148": {
            "id": "150150148",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "This isn't the place to chat. Come on, let's get out of here.",
            "nextDialogs": [
              "150150149"
            ]
          },
          "150150149": {
            "id": "150150149",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, but what about Tlazolli?",
            "nextDialogs": [
              "150150150"
            ]
          },
          "150150150": {
            "id": "150150150",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "Don't worry, she won't be able to cause any more trouble now.",
            "nextDialogs": [
              "150150151"
            ]
          },
          "150150151": {
            "id": "150150151",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "It's all over. You leave the workshop. Once outside, Xilonen asks that you go accompany Nepecha. She still needs to have some words with Tlazolli alone..."
          }
        }
      }
    },
    {
      "subId": "1501509",
      "subQuestName": "Rest for a moment with Xilonen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150150901"
        ],
        "dialogs": {
          "150150901": {
            "id": "150150901",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "Alright, I've locked Auntie in the house with a few ropes. I'll take her to the tribe shortly to be punished for what she did.",
            "nextDialogs": [
              "150150902"
            ]
          },
          "150150902": {
            "id": "150150902",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "As for now, we can get away from the house and get some sun.",
            "nextDialogs": [
              "150150903"
            ]
          },
          "150150903": {
            "id": "150150903",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "After dealing with all of that, I'm completely out of energy...",
            "nextDialogs": [
              "150150904"
            ]
          },
          "150150904": {
            "id": "150150904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "She's already planned out everything... Xilonen sure doesn't waste time.",
            "nextDialogs": [
              "150150905"
            ]
          },
          "150150905": {
            "id": "150150905",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*sigh* It's still so scary to imagine... Tlazolli wanted to turn her adopted child into Nechca, and she even nearly succeeded...",
            "nextDialogs": [
              "150150908"
            ]
          },
          "150150908": {
            "id": "150150908",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, you were so cool in the final moments, Xilonen! You went right into action and took control of the situation instantly.",
            "nextDialogs": [
              "150150909"
            ]
          },
          "150150909": {
            "id": "150150909",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "It's all thanks to Nepecha's resilience — she never gave up. If it weren't for her bravely trying to get help, then I wouldn't have noticed Auntie's plans so easily."
          }
        }
      }
    },

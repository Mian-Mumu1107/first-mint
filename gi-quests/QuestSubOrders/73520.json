  "subQuests": [
    {
      "subId": "7352001",
      "subQuestName": "Ask Dori for information",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735200101"
        ],
        "dialogs": {
          "735200101": {
            "id": "735200101",
            "speakerId": 1000,
            "speakerName": "Dori",
            "text": "Have you decided to buy information from me?",
            "nextDialogs": [
              "735200102"
            ]
          },
          "735200102": {
            "id": "735200102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmmm... Paimon's a little curious about your exclusive information, but we need to hear the price first! If it's too expensive, then forget it.",
            "nextDialogs": [
              "735200103"
            ]
          },
          "735200103": {
            "id": "735200103",
            "speakerId": 1000,
            "speakerName": "Dori",
            "text": "I'll sell it to you for the fixed price of one million Mora!",
            "nextDialogs": [
              "735200104"
            ]
          },
          "735200104": {
            "id": "735200104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's a lot! Never mind, one million Mora can buy lots and lots of tasty food!",
            "nextDialogs": [
              "735200105"
            ]
          },
          "735200105": {
            "id": "735200105",
            "speakerId": 1000,
            "speakerName": "Dori",
            "text": "Wait a sec... Let me see... Eh? Paimon is customer number 1,001 for today. The original cost of the information was one million Mora, but for you the price is now free!",
            "nextDialogs": [
              "735200106"
            ]
          },
          "735200106": {
            "id": "735200106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh!? Paimon didn't know such luck exists!",
            "nextDialogs": [
              "735200107"
            ]
          },
          "735200107": {
            "id": "735200107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, you're not baiting us into spending, are you? Maybe the first sentence is free, but not the next sentence...",
            "nextDialogs": [
              "735200108"
            ]
          },
          "735200108": {
            "id": "735200108",
            "speakerId": 1000,
            "speakerName": "Dori",
            "text": "If you don't want it, fine! Next!",
            "nextDialogs": [
              "735200109"
            ]
          },
          "735200109": {
            "id": "735200109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, wait, wait, forget what Paimon said. We'll listen!",
            "nextDialogs": [
              "735200110"
            ]
          },
          "735200110": {
            "id": "735200110",
            "speakerId": 1000,
            "speakerName": "Dori",
            "text": "Dori's exclusive scoop number one! Do you remember the Diadem of Knowledge?",
            "nextDialogs": [
              "735200111"
            ]
          },
          "735200111": {
            "id": "735200111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon remembers that only the champion was entitled to wear the diadem. It seemed very valuable!",
            "nextDialogs": [
              "735200112"
            ]
          },
          "735200112": {
            "id": "735200112",
            "speakerId": 1000,
            "speakerName": "Dori",
            "text": "Exactly. The diadem that Sachin gave the Akademiya was a rather expensive antique.",
            "nextDialogs": [
              "735200113"
            ]
          },
          "735200113": {
            "id": "735200113",
            "speakerId": 1000,
            "speakerName": "Dori",
            "text": "Yet this very diadem, after it was donated to the Akademiya, was lost by them once before!",
            "nextDialogs": [
              "735200114"
            ]
          },
          "735200114": {
            "id": "735200114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh? Why didn't we hear about this?",
            "nextDialogs": [
              "735200115"
            ]
          },
          "735200115": {
            "id": "735200115",
            "speakerId": 1000,
            "speakerName": "Dori",
            "text": "Hehe... if everyone knew about this, would my information still be considered \"exclusive\"?",
            "nextDialogs": [
              "735200116"
            ]
          },
          "735200116": {
            "id": "735200116",
            "speakerId": 1000,
            "speakerName": "Dori",
            "text": "Of course, this information doesn't come from nowhere. I've got witnesses, too.",
            "nextDialogs": [
              "735200117"
            ]
          },
          "735200117": {
            "id": "735200117",
            "speakerId": 1000,
            "speakerName": "Dori",
            "text": "There's a young fellow named Kashmer from the suburbs. If you're interested in delving further, you could ask him.",
            "nextDialogs": [
              "735200118"
            ]
          },
          "735200118": {
            "id": "735200118",
            "speakerId": 1000,
            "speakerName": "Dori",
            "text": "The password is \"that incident from twenty years ago\"!"
          }
        }
      }
    },
    {
      "subId": "7352002",
      "subQuestName": "Talk to Kashmer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735200203"
        ],
        "dialogs": {
          "735200203": {
            "id": "735200203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"That Incident From Twenty Years Ago\"",
            "nextDialogs": [
              "735200204"
            ]
          },
          "735200204": {
            "id": "735200204",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "... I guess I shouldn't have told anyone. Last time I had too much to drink and blabbered a little too much, and now people are seeking me out.",
            "nextDialogs": [
              "735200205"
            ]
          },
          "735200205": {
            "id": "735200205",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "Since you're curious, I guess I'll tell you.",
            "nextDialogs": [
              "735200206"
            ]
          },
          "735200206": {
            "id": "735200206",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "I was just six years old twenty years ago, so I can't remember clearly what happened at the time. But recently, I read the diary I kept when I was a child, and vaguely recalled the situation back then.",
            "nextDialogs": [
              "735200207"
            ]
          },
          "735200207": {
            "id": "735200207",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "The Interdarshan Championship was also held that year. There were three rounds, the last of which was outside the city. I begged my mom to take me out of town to see it, and when she refused, I snuck out.",
            "nextDialogs": [
              "735200208"
            ]
          },
          "735200208": {
            "id": "735200208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And then?",
            "nextDialogs": [
              "735200209"
            ]
          },
          "735200209": {
            "id": "735200209",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "I ended up getting lost outside the city. In the middle of nowhere, there was no one around. I grew more and more frightened and began to cry.",
            "nextDialogs": [
              "735200210"
            ]
          },
          "735200210": {
            "id": "735200210",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "That's when I saw some strange creatures... I can't remember what they looked like. I only remember how, as a child, I stopped crying at the sight of them.",
            "nextDialogs": [
              "735200211"
            ]
          },
          "735200211": {
            "id": "735200211",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Strange creatures... they must be...",
            "nextDialogs": [
              "735200212"
            ]
          },
          "735200212": {
            "id": "735200212",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(The Aranara.)",
            "nextDialogs": [
              "735200213"
            ]
          },
          "735200213": {
            "id": "735200213",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "They took me to the competition. Unfortunately, by the time we got there, it was too late. It was already over.",
            "nextDialogs": [
              "735200214"
            ]
          },
          "735200214": {
            "id": "735200214",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "Just when I was disheartened, I suddenly saw one of those strange creatures slowly dragging a crown along.",
            "nextDialogs": [
              "735200215"
            ]
          },
          "735200215": {
            "id": "735200215",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "It was a beautiful crown, shining in the moonlight, and I could not help but follow it. I saw the little fellow hide the crown in a hollow tree before disappearing.",
            "nextDialogs": [
              "735200216"
            ]
          },
          "735200216": {
            "id": "735200216",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "I wanted to touch that crown. But at the moment, I could hear the distant cries of my mother. It turns out, she figured out I was lost, and got her neighbors to go looking for me.",
            "nextDialogs": [
              "735200217"
            ]
          },
          "735200217": {
            "id": "735200217",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "I never got to touch it. It wasn't until I was older, when I saw the \"Diadem of Knowledge\" at the Interdarshan Championship that I realized it was the same thing.",
            "nextDialogs": [
              "735200218"
            ]
          },
          "735200218": {
            "id": "735200218",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Alright... do you remember where that diadem ended up?",
            "nextDialogs": [
              "735200219"
            ]
          },
          "735200219": {
            "id": "735200219",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "It's probably in the Avidya Forest, but I've been back a few times, and I haven't found anything.",
            "nextDialogs": [
              "735200220"
            ]
          },
          "735200220": {
            "id": "735200220",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "No one would believe me, even if I told them. Alas, even I can't remember it clearly. Perhaps, it was a dream I had when I was a child.",
            "nextDialogs": [
              "735200221"
            ]
          },
          "735200221": {
            "id": "735200221",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Well... should we go look for it, {NICKNAME}?"
          }
        }
      }
    },
    {
      "subId": "7352003",
      "subQuestName": "Continue looking for clues",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735200301"
        ],
        "dialogs": {
          "735200301": {
            "id": "735200301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "There's a hole in the tree. It seems completely empty, and there's nothing in it...",
            "nextDialogs": [
              "735200302"
            ]
          },
          "735200302": {
            "id": "735200302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh? Wait! There's a note there!",
            "nextDialogs": [
              "735200303"
            ]
          },
          "735200303": {
            "id": "735200303",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"The good Nara taught Arakasyapa how to read. Arakasyapa must protect the good Nara...\"",
            "nextDialogs": [
              "735200304"
            ]
          },
          "735200304": {
            "id": "735200304",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What's this supposed to mean?"
          }
        }
      }
    },
    {
      "subId": "7352002",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735200201"
        ],
        "dialogs": {
          "735200201": {
            "id": "735200201",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "Who are you guys? Is there something you need?",
            "nextDialogs": [
              "735200202"
            ]
          },
          "735200202": {
            "id": "735200202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No..."
          }
        }
      }
    },
    {
      "subId": "7352033",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735203301"
        ],
        "dialogs": {
          "735203301": {
            "id": "735203301",
            "speakerId": 1000,
            "speakerName": "Dori",
            "text": "Is there anything else you want to know? If you want more information, you gotta pay extra!"
          }
        }
      }
    },
    {
      "subId": "7352034",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735203401"
        ],
        "dialogs": {
          "735203401": {
            "id": "735203401",
            "speakerId": 1002,
            "speakerName": "Kashmer",
            "text": "What exactly happened back then?"
          }
        }
      }
    }
  ]
}
    {
      "subId": "99015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "9901508"
        ],
        "dialogs": {
          "9901508": {
            "id": "9901508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How do you like it here?",
            "nextDialogs": [
              "9901509"
            ]
          },
          "9901509": {
            "id": "9901509",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Oh, I love it here!",
            "nextDialogs": [
              "9901510"
            ]
          },
          "9901510": {
            "id": "9901510",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "The scenery here is so different from Mondstadt's. I find it really refreshing.",
            "nextDialogs": [
              "9901511"
            ]
          },
          "9901511": {
            "id": "9901511",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "And here, I can sing at the top of my voice without having to worry if I'm disturbing anyone! It's the best way to practice.",
            "nextDialogs": [
              "9901512"
            ]
          },
          "9901512": {
            "id": "9901512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Surely no one would ever consider your sweet voice a disturbance?",
            "nextDialogs": [
              "9901513"
            ]
          },
          "9901513": {
            "id": "9901513",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Ah...",
            "nextDialogs": [
              "9901514"
            ]
          },
          "9901514": {
            "id": "9901514",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "It sure is nice of you to say that! But, uh... still, I always need to make sure I'm being considerate of other people.",
            "nextDialogs": [
              "9901515"
            ]
          },
          "9901515": {
            "id": "9901515",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Anyway, I'm really happy you invited me here!",
            "nextDialogs": [
              "9901516"
            ]
          },
          "9901516": {
            "id": "9901516",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's great!",
            "nextDialogs": [
              "9901517"
            ]
          },
          "9901517": {
            "id": "9901517",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Yeah... I'm just so happy that you invited me to come here.",
            "nextDialogs": [
              "9901518"
            ]
          },
          "9901518": {
            "id": "9901518",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "I think I'd like to stay here a little longer.",
            "nextDialogs": [
              "9901519"
            ]
          },
          "9901519": {
            "id": "9901519",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Would you like to have a chat with me?",
            "nextDialogs": [
              "9901520"
            ]
          },
          "9901520": {
            "id": "9901520",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Oh, sure!",
            "nextDialogs": [
              "9901521"
            ]
          },
          "9901521": {
            "id": "9901521",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Hehe...",
            "nextDialogs": [
              "9901522"
            ]
          },
          "9901522": {
            "id": "9901522",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's with that smile...",
            "nextDialogs": [
              "9901523"
            ]
          },
          "9901523": {
            "id": "9901523",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you suddenly remembered something amusing?",
            "nextDialogs": [
              "9901524"
            ]
          },
          "9901524": {
            "id": "9901524",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Oh, I just realized that I haven't chatted with a friend like this in a long time.",
            "nextDialogs": [
              "9901525"
            ]
          },
          "9901525": {
            "id": "9901525",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "I just feel so blessed all of a sudden.",
            "nextDialogs": [
              "9901526"
            ]
          },
          "9901526": {
            "id": "9901526",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Seems like you're easy to please.",
            "nextDialogs": [
              "9901527"
            ]
          },
          "9901527": {
            "id": "9901527",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Uhh... Is that so...",
            "nextDialogs": [
              "9901528"
            ]
          },
          "9901528": {
            "id": "9901528",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Well, maybe... but it's not such a bad thing.",
            "nextDialogs": [
              "9901529"
            ]
          },
          "9901529": {
            "id": "9901529",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "The easier you find it to receive joy, the more energy you have to share that joy with other people.",
            "nextDialogs": [
              "9901530"
            ]
          },
          "9901530": {
            "id": "9901530",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's because you're always putting other people first.",
            "nextDialogs": [
              "9901531"
            ]
          },
          "9901531": {
            "id": "9901531",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Of course I do, that's what I'm supposed to do!",
            "nextDialogs": [
              "9901532"
            ]
          },
          "9901532": {
            "id": "9901532",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "I've always had so many people looking out for me. I just want to do all that is within my power to repay their kindness.",
            "nextDialogs": [
              "9901533"
            ]
          },
          "9901533": {
            "id": "9901533",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You are every bit as wonderful as people say.",
            "nextDialogs": [
              "9901534"
            ]
          },
          "9901534": {
            "id": "9901534",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Ahh... please, no need to shower me with compliments...",
            "nextDialogs": [
              "9901535"
            ]
          },
          "9901535": {
            "id": "9901535",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Only with constructive criticism can we grow, right...?",
            "nextDialogs": [
              "9901536"
            ]
          },
          "9901536": {
            "id": "9901536",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is there anything you'd like to do?",
            "nextDialogs": [
              "9901537"
            ]
          },
          "9901537": {
            "id": "9901537",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Oh, I've been practicing a new song recently.",
            "nextDialogs": [
              "9901538"
            ]
          },
          "9901538": {
            "id": "9901538",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "But I'm still trying to iron out a few details...",
            "nextDialogs": [
              "9901539"
            ]
          },
          "9901539": {
            "id": "9901539",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "When I repeat the chorus, should I go up a half step? I can't decide... And I think there's room for improvement with the dance routine, but I'm not sure...",
            "nextDialogs": [
              "9901540"
            ]
          },
          "9901540": {
            "id": "9901540",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "If it's no trouble, I'd really appreciate it if you could watch my performance and give me your suggestions.",
            "nextDialogs": [
              "9901541"
            ]
          },
          "9901541": {
            "id": "9901541",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You have my unconditional support.",
            "nextDialogs": [
              "9901542"
            ]
          },
          "9901542": {
            "id": "9901542",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It would be my honor.",
            "nextDialogs": [
              "9901543"
            ]
          },
          "9901543": {
            "id": "9901543",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Thank you...!",
            "nextDialogs": [
              "9901544"
            ]
          },
          "9901544": {
            "id": "9901544",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Um... Please don't laugh at me if there are parts that still need practicing.",
            "nextDialogs": [
              "9901545"
            ]
          },
          "9901545": {
            "id": "9901545",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "I've thought about this a lot of times in the past, but it's taken me this long to finally pluck up the courage to perform for you at such close distance.",
            "nextDialogs": [
              "9901546"
            ]
          },
          "9901546": {
            "id": "9901546",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "If you laughed at me, there'd be nowhere I could run from my embarrassment...",
            "nextDialogs": [
              "9901547"
            ]
          },
          "9901547": {
            "id": "9901547",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry. I won't laugh.",
            "nextDialogs": [
              "9901548"
            ]
          },
          "9901548": {
            "id": "9901548",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I believe in you, and you should believe in yourself as well.",
            "nextDialogs": [
              "9901549"
            ]
          },
          "9901549": {
            "id": "9901549",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Whew... Okay.",
            "nextDialogs": [
              "9901550"
            ]
          },
          "9901550": {
            "id": "9901550",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Then...",
            "nextDialogs": [
              "9901551"
            ]
          },
          "9901551": {
            "id": "9901551",
            "speakerId": 1008,
            "speakerName": "Barbara",
            "text": "Let the show begin!"
          }
        }
      }
    },

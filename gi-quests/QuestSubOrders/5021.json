  "subQuests": [
    {
      "subId": "502101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210101"
        ],
        "dialogs": {
          "50210101": {
            "id": "50210101",
            "speakerId": 1000,
            "speakerName": "Uturunku",
            "text": "Do you get... scared?"
          }
        }
      }
    },
    {
      "subId": "502102",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210201"
        ],
        "dialogs": {
          "50210201": {
            "id": "50210201",
            "speakerId": 1001,
            "speakerName": "Tepoz",
            "text": "Traveler, can I ask you a favor?",
            "nextDialogs": [
              "50210202"
            ]
          },
          "50210202": {
            "id": "50210202",
            "speakerId": 1001,
            "speakerName": "Tepoz",
            "text": "My mother's a doctor. When she heard about the attacks in the wilderness, she rushed out to help, and I haven't heard from her since.",
            "nextDialogs": [
              "50210203"
            ]
          },
          "50210203": {
            "id": "50210203",
            "speakerId": 1001,
            "speakerName": "Tepoz",
            "text": "I'm worried. She's not a fighter, and I can't leave to check on her. I want her to stay out of this, so if you see her, can you please tell her to take shelter?",
            "nextDialogs": [
              "50210204"
            ]
          },
          "50210204": {
            "id": "50210204",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Of course! We've got this!",
            "nextDialogs": [
              "50210205"
            ]
          },
          "50210205": {
            "id": "50210205",
            "speakerId": 1001,
            "speakerName": "Tepoz",
            "text": "Thank you. That makes it easier to focus on the current battle."
          }
        }
      }
    },
    {
      "subId": "502103",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210301"
        ],
        "dialogs": {
          "50210301": {
            "id": "50210301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's normal to be afraid.",
            "nextDialogs": [
              "50210302"
            ]
          },
          "50210302": {
            "id": "50210302",
            "speakerId": 1000,
            "speakerName": "Uturunku",
            "text": "Normal? You mean... I'm not being a coward?",
            "nextDialogs": [
              "50210303"
            ]
          },
          "50210303": {
            "id": "50210303",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Not at all! You're here, aren't you? Ready to fight even despite your fear! That's impressive!",
            "nextDialogs": [
              "50210304"
            ]
          },
          "50210304": {
            "id": "50210304",
            "speakerId": 1000,
            "speakerName": "Uturunku",
            "text": "Oh... Y—Yeah! You're right! Thanks, you two."
          }
        }
      }
    },
    {
      "subId": "502104",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210401"
        ],
        "dialogs": {
          "50210401": {
            "id": "50210401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not really.",
            "nextDialogs": [
              "50210402"
            ]
          },
          "50210402": {
            "id": "50210402",
            "speakerId": 1000,
            "speakerName": "Uturunku",
            "text": "I... I knew it. You're too strong for that...",
            "nextDialogs": [
              "50210403"
            ]
          },
          "50210403": {
            "id": "50210403",
            "speakerId": 1000,
            "speakerName": "Uturunku",
            "text": "*sigh*..."
          }
        }
      }
    },
    {
      "subId": "502105",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210601"
        ],
        "dialogs": {
          "50210601": {
            "id": "50210601",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Doctor... Wait, do you know Tepoz?",
            "nextDialogs": [
              "50210602"
            ]
          },
          "50210602": {
            "id": "50210602",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "He's my son... Why? Did something happen to him?",
            "nextDialogs": [
              "50210603"
            ]
          },
          "50210603": {
            "id": "50210603",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "No, no! He's fine! He's just worried about you. He asked us to tell you to seek shelter.",
            "nextDialogs": [
              "50210604"
            ]
          },
          "50210604": {
            "id": "50210604",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "Ah, I see. I know it's dangerous to be out and about like this, but I just can't sit back and do nothing...",
            "nextDialogs": [
              "50210605"
            ]
          },
          "50210605": {
            "id": "50210605",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "How about this... I'll write to him and promise to team up with the next group of warriors I come across. I'll be safer that way.",
            "nextDialogs": [
              "50210606"
            ]
          },
          "50210606": {
            "id": "50210606",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Sounds good! Paimon's sure he'll be relieved you're okay.",
            "nextDialogs": [
              "50210607"
            ]
          },
          "50210607": {
            "id": "50210607",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "Thank you for passing along his message."
          }
        }
      }
    },
    {
      "subId": "502122",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50212201"
        ],
        "dialogs": {
          "50212201": {
            "id": "50212201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Absolutely.",
            "nextDialogs": [
              "50212202"
            ]
          },
          "50212202": {
            "id": "50212202",
            "speakerId": 1000,
            "speakerName": "Uturunku",
            "text": "That's what I'm hoping for, too, it's just... Never mind."
          }
        }
      }
    },
    {
      "subId": "502106",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210801"
        ],
        "dialogs": {
          "50210801": {
            "id": "50210801",
            "speakerId": 1004,
            "speakerName": "Raman",
            "text": "Uh... Ugh...",
            "nextDialogs": [
              "50210802"
            ]
          },
          "50210802": {
            "id": "50210802",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Someone's injured... That must be the messenger! Hey, are you alright? Can you still walk?",
            "nextDialogs": [
              "50210803"
            ]
          },
          "50210803": {
            "id": "50210803",
            "speakerId": 1004,
            "speakerName": "Raman",
            "text": "The battle report, I have to find the battle report...",
            "nextDialogs": [
              "50210804"
            ]
          },
          "50210804": {
            "id": "50210804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We already found it.",
            "nextDialogs": [
              "50210805"
            ]
          },
          "50210805": {
            "id": "50210805",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yeah, we got you covered! Here you go.",
            "nextDialogs": [
              "50210806"
            ]
          },
          "50210806": {
            "id": "50210806",
            "speakerId": 1004,
            "speakerName": "Raman",
            "text": "Oh, thank you... *sigh* I just hope I'm not too late...",
            "nextDialogs": [
              "50210807"
            ]
          },
          "50210807": {
            "id": "50210807",
            "speakerId": 1004,
            "speakerName": "Raman",
            "text": "In times like these, every second counts. Even a short delay can put lives at risk...",
            "nextDialogs": [
              "50210808"
            ]
          },
          "50210808": {
            "id": "50210808",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Don't worry about that! We can take things from here. You just need to head back to the Stadium and focus on getting better.",
            "nextDialogs": [
              "50210809"
            ]
          },
          "50210809": {
            "id": "50210809",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have faith in your people.",
            "nextDialogs": [
              "50210810"
            ]
          },
          "50210810": {
            "id": "50210810",
            "speakerId": 1004,
            "speakerName": "Raman",
            "text": "...You're right. I can't do much else in my current state anyway.",
            "nextDialogs": [
              "50210811"
            ]
          },
          "50210811": {
            "id": "50210811",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "How can we make sure he'll safely get back, though? We can't let him make the journey alone, it's too dangerous out there...",
            "nextDialogs": [
              "50210812"
            ]
          },
          "50210812": {
            "id": "50210812",
            "speakerId": 1005,
            "speakerName": "Brave Yumkasaur",
            "text": "Roar... roar, roar...",
            "nextDialogs": [
              "50210813"
            ]
          },
          "50210813": {
            "id": "50210813",
            "speakerId": 1004,
            "speakerName": "Raman",
            "text": "Huh? What the...",
            "nextDialogs": [
              "50210814"
            ]
          },
          "50210814": {
            "id": "50210814",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Looks like this yumkasaur wants to give you a lift.",
            "nextDialogs": [
              "50210815"
            ]
          },
          "50210815": {
            "id": "50210815",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Whoa... you guys sure about this? It's really dangerous out there...",
            "nextDialogs": [
              "50210816"
            ]
          },
          "50210816": {
            "id": "50210816",
            "speakerId": 1005,
            "speakerName": "Brave Yumkasaur",
            "text": "Roar, roar...",
            "nextDialogs": [
              "50210817"
            ]
          },
          "50210817": {
            "id": "50210817",
            "speakerId": 1004,
            "speakerName": "Raman",
            "text": "Alright, well... Thanks, this is a huge help.",
            "nextDialogs": [
              "50210818"
            ]
          },
          "50210818": {
            "id": "50210818",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Be careful on the road.",
            "nextDialogs": [
              "50210819"
            ]
          },
          "50210819": {
            "id": "50210819",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Thank goodness for those saurians. They really came to the rescue.",
            "nextDialogs": [
              "50210821",
              "50210823"
            ]
          },
          "50210821": {
            "id": "50210821",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "It's no wonder people from Natlan are so fond of their saurian companions."
          },
          "50210823": {
            "id": "50210823",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Really, that's your takeaway from this? Unbelievable..."
          }
        }
      }
    },
    {
      "subId": "502109",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210901"
        ],
        "dialogs": {
          "50210901": {
            "id": "50210901",
            "speakerId": 1006,
            "speakerName": "Stadukhin",
            "text": "The Captain must have known the situation would get a lot more dire than expected. That would explain why he was so anxious."
          }
        }
      }
    },
    {
      "subId": "502110",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211101"
        ],
        "dialogs": {
          "50211101": {
            "id": "50211101",
            "speakerId": 1007,
            "speakerName": "Chimalli",
            "text": "Thanks to you, we managed to clear out the threats in the surrounding area. Let's head back."
          }
        }
      }
    },
    {
      "subId": "502112",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211201"
        ],
        "dialogs": {
          "50211201": {
            "id": "50211201",
            "speakerId": 1008,
            "speakerName": "Awhina",
            "text": "I want to seek shelter as well, but the People of the Springs need these potions. I have to get them there."
          }
        }
      }
    },
    {
      "subId": "502107",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210701"
        ],
        "dialogs": {
          "50210701": {
            "id": "50210701",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "It really is getting dangerous out here. Looks like sticking with a group of warriors is the only way to stay safe...",
            "nextDialogs": [
              "50210702"
            ]
          },
          "50210702": {
            "id": "50210702",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "Anyway, I should head out. Other places need my attention.",
            "nextDialogs": [
              "50210703"
            ]
          },
          "50210703": {
            "id": "50210703",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "She seems quite anxious... Guess that means things aren't looking good..."
          }
        }
      }
    },
    {
      "subId": "502118",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211801"
        ],
        "dialogs": {
          "50211801": {
            "id": "50211801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Fatui could escort you?",
            "nextDialogs": [
              "50211802"
            ]
          },
          "50211802": {
            "id": "50211802",
            "speakerId": 1008,
            "speakerName": "Awhina",
            "text": "Uh... I'm not sure about that.",
            "nextDialogs": [
              "50211803"
            ]
          },
          "50211803": {
            "id": "50211803",
            "speakerId": 1006,
            "speakerName": "Stadukhin",
            "text": "We can get you close. It's on our way.",
            "nextDialogs": [
              "50211804"
            ]
          },
          "50211804": {
            "id": "50211804",
            "speakerId": 1008,
            "speakerName": "Awhina",
            "text": "Oh, well... Great! I appreciate it!"
          }
        }
      }
    },
    {
      "subId": "502119",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211901"
        ],
        "dialogs": {
          "50211901": {
            "id": "50211901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I wouldn't risk it.",
            "nextDialogs": [
              "50211902"
            ]
          },
          "50211902": {
            "id": "50211902",
            "speakerId": 1008,
            "speakerName": "Awhina",
            "text": "You're right. It's dangerous out here. I don't even know if I'd make it...",
            "nextDialogs": [
              "50211903"
            ]
          },
          "50211903": {
            "id": "50211903",
            "speakerId": 1008,
            "speakerName": "Awhina",
            "text": "Other caravans are already there, so it should be fine."
          }
        }
      }
    },
    {
      "subId": "502113",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211301"
        ],
        "dialogs": {
          "50211301": {
            "id": "50211301",
            "speakerId": 1009,
            "speakerName": "Kamaka",
            "text": "How long are these attacks going to last...",
            "nextDialogs": [
              "50211302"
            ]
          },
          "50211302": {
            "id": "50211302",
            "speakerId": 1009,
            "speakerName": "Kamaka",
            "text": "I was heading to the People of the Springs for business, but looks like I can kiss that Mora goodbye. At least I'm still in one piece.",
            "nextDialogs": [
              "50211303"
            ]
          },
          "50211303": {
            "id": "50211303",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Did something happen on the road?",
            "nextDialogs": [
              "50211304"
            ]
          },
          "50211304": {
            "id": "50211304",
            "speakerId": 1009,
            "speakerName": "Kamaka",
            "text": "I was attacked by monsters. I really thought it was over, but would you believe it... the Fatui saved my life.",
            "nextDialogs": [
              "50211305"
            ]
          },
          "50211305": {
            "id": "50211305",
            "speakerId": 1009,
            "speakerName": "Kamaka",
            "text": "The Captain's soldiers running around Natlan rescuing people... I almost couldn't believe it. I guess the Abyss really is our common enemy.",
            "nextDialogs": [
              "50211306"
            ]
          },
          "50211306": {
            "id": "50211306",
            "speakerId": 1009,
            "speakerName": "Kamaka",
            "text": "They set out again after rescuing us. I hope they'll be okay out there."
          }
        }
      }
    },
    {
      "subId": "502114",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211401"
        ],
        "dialogs": {
          "50211401": {
            "id": "50211401",
            "speakerId": 1009,
            "speakerName": "Kamaka",
            "text": "Hey, you two! We made it back in one piece!",
            "nextDialogs": [
              "50211402"
            ]
          },
          "50211402": {
            "id": "50211402",
            "speakerId": 1009,
            "speakerName": "Kamaka",
            "text": "Honestly, it's all thanks to you.",
            "nextDialogs": [
              "50211403"
            ]
          },
          "50211403": {
            "id": "50211403",
            "speakerId": 1009,
            "speakerName": "Kamaka",
            "text": "The Fatui that helped us are still fighting out there. I hope they're okay."
          }
        }
      }
    },
    {
      "subId": "502115",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50212401"
        ],
        "dialogs": {
          "50212401": {
            "id": "50212401",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "Oh, I didn't expect to see you here.",
            "nextDialogs": [
              "50212402"
            ]
          },
          "50212402": {
            "id": "50212402",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "I heard medical personnel were needed at the Stadium, so I followed a group of warriors back here.",
            "nextDialogs": [
              "50212403"
            ]
          },
          "50212403": {
            "id": "50212403",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "My age means I can't charge to the frontlines, but I can handle things here. Everything will get better."
          }
        }
      }
    },
    {
      "subId": "502116",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211601"
        ],
        "dialogs": {
          "50211601": {
            "id": "50211601",
            "speakerId": 1008,
            "speakerName": "Awhina",
            "text": "I've decided to bring these supplies to the Stadium, but this amount won't nearly be enough. There's a shortage pretty much everywhere.",
            "nextDialogs": [
              "50211602"
            ]
          },
          "50211602": {
            "id": "50211602",
            "speakerId": 1008,
            "speakerName": "Awhina",
            "text": "We have emergency stockpiles of things like water, food, and medicine, but what if we'll need them even more in the future...?",
            "nextDialogs": [
              "50211603"
            ]
          },
          "50211603": {
            "id": "50211603",
            "speakerId": 1008,
            "speakerName": "Awhina",
            "text": "Guess I'll just have to talk to my guild, and see if they've got any more to spare."
          }
        }
      }
    },
    {
      "subId": "502132",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50117001"
        ],
        "dialogs": {
          "50117001": {
            "id": "50117001",
            "speakerId": 1010,
            "speakerName": "Ardra",
            "text": "It's you two! I'm so glad you're alright!",
            "nextDialogs": [
              "50117002"
            ]
          },
          "50117002": {
            "id": "50117002",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hey! You made it back!",
            "nextDialogs": [
              "50117003"
            ]
          },
          "50117003": {
            "id": "50117003",
            "speakerId": 1011,
            "speakerName": "Kokpon",
            "text": "Sure did. Dargo made sure we got back safely before rushing out again.",
            "nextDialogs": [
              "50117004"
            ]
          },
          "50117004": {
            "id": "50117004",
            "speakerId": 1010,
            "speakerName": "Ardra",
            "text": "Plus, we managed to deliver the medical supplies to the Stadium. I really can't thank you enough for your help!"
          }
        }
      }
    },
    {
      "subId": "502133",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50117101"
        ],
        "dialogs": {
          "50117101": {
            "id": "50117101",
            "speakerId": 1012,
            "speakerName": "Diligent Yumkasaur",
            "text": "No going outside. It's too dangerous. That goes for you too!"
          }
        }
      }
    },
    {
      "subId": "502117",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211701"
        ],
        "dialogs": {
          "50211701": {
            "id": "50211701",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "Oh, it's you two! Perfect timing! I heard you saved this lady, too.",
            "nextDialogs": [
              "50211702"
            ]
          },
          "50211702": {
            "id": "50211702",
            "speakerId": 1008,
            "speakerName": "Awhina",
            "text": "That's right! They rescued my potion shipment.",
            "nextDialogs": [
              "50211703"
            ]
          },
          "50211703": {
            "id": "50211703",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "Wonderful, these potions are just what I needed to treat my patients. I'll make sure you're well rewarded for the trouble.",
            "nextDialogs": [
              "50211704"
            ]
          },
          "50211704": {
            "id": "50211704",
            "speakerId": 1008,
            "speakerName": "Awhina",
            "text": "Don't worry about it. The regular price is more than enough. Time is the most precious thing right now.",
            "nextDialogs": [
              "50211705"
            ]
          },
          "50211705": {
            "id": "50211705",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "Thank you so much! Let's head out soon.",
            "nextDialogs": [
              "50211706"
            ]
          },
          "50211706": {
            "id": "50211706",
            "speakerId": 1008,
            "speakerName": "Awhina",
            "text": "Sounds good."
          }
        }
      }
    },
    {
      "subId": "502120",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50212001"
        ],
        "dialogs": {
          "50212001": {
            "id": "50212001",
            "speakerId": 1000,
            "speakerName": "Uturunku",
            "text": "I've managed to accept my fear, but I still want to ask you one last thing... If I die, do you think anyone will remember me?"
          }
        }
      }
    },
    {
      "subId": "502121",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50212101"
        ],
        "dialogs": {
          "50212101": {
            "id": "50212101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't think about that. Do your best to stay alive.",
            "nextDialogs": [
              "50212102"
            ]
          },
          "50212102": {
            "id": "50212102",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yeah! Please do whatever you can to stay alive! Your life is super important!",
            "nextDialogs": [
              "50212103"
            ]
          },
          "50212103": {
            "id": "50212103",
            "speakerId": 1000,
            "speakerName": "Uturunku",
            "text": "My life... is super important...",
            "nextDialogs": [
              "50212104"
            ]
          },
          "50212104": {
            "id": "50212104",
            "speakerId": 1000,
            "speakerName": "Uturunku",
            "text": "...Got it. Thank you again for leading me to the answer."
          }
        }
      }
    },
    {
      "subId": "502105",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50210501"
        ],
        "dialogs": {
          "50210501": {
            "id": "50210501",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "Thank you. *sigh* They really came out of nowhere...",
            "nextDialogs": [
              "50210502"
            ]
          },
          "50210502": {
            "id": "50210502",
            "speakerId": 1013,
            "speakerName": "Guaman",
            "text": "Yeah, that was close. Thank you for coming all this way to help us, Doctor.",
            "nextDialogs": [
              "50210503"
            ]
          },
          "50210503": {
            "id": "50210503",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "Just doing my part."
          }
        }
      }
    },
    {
      "subId": "502110",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211001"
        ],
        "dialogs": {
          "50211001": {
            "id": "50211001",
            "speakerId": 1007,
            "speakerName": "Chimalli",
            "text": "Ah, by the way... I think I know where some monsters might be. It's an area nearby.",
            "nextDialogs": [
              "50211002"
            ]
          },
          "50211002": {
            "id": "50211002",
            "speakerId": 1007,
            "speakerName": "Chimalli",
            "text": "If you've got some time, I'd appreciate the back-up.",
            "nextDialogs": [
              "50211004",
              "50211006"
            ]
          },
          "50211004": {
            "id": "50211004",
            "speakerId": 1007,
            "speakerName": "Chimalli",
            "text": "Alright, let's move out."
          },
          "50211006": {
            "id": "50211006",
            "speakerId": 1007,
            "speakerName": "Chimalli",
            "text": "Don't worry about it. I'll round up a few warriors to go with me."
          }
        }
      }
    },
    {
      "subId": "502115",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50211501"
        ],
        "dialogs": {
          "50211501": {
            "id": "50211501",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "Oh, I didn't expect to see you here.",
            "nextDialogs": [
              "50211502"
            ]
          },
          "50211502": {
            "id": "50211502",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "My son wrote back to me and said things are under control on his end. That's one less thing to worry about for now.",
            "nextDialogs": [
              "50211503"
            ]
          },
          "50211503": {
            "id": "50211503",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "I heard medical personnel were needed at the Stadium, so I followed a group of warriors back here.",
            "nextDialogs": [
              "50211504"
            ]
          },
          "50211504": {
            "id": "50211504",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "My age means I can't charge to the frontlines, but I can handle things here. Everything will get better."
          }
        }
      }
    },
    {
      "subId": "502144",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50214401"
        ],
        "dialogs": {
          "50214401": {
            "id": "50214401",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "Still no sign of any warriors. I need to head out soon. We're running out of time..."
          }
        }
      }
    },
    {
      "subId": "502150",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50215001"
        ],
        "dialogs": {
          "50215001": {
            "id": "50215001",
            "speakerId": 1001,
            "speakerName": "Tepoz",
            "text": "I'll be heading out with the others soon. *sigh* I just hope she's okay..."
          }
        }
      }
    },
    {
      "subId": "502151",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50215101"
        ],
        "dialogs": {
          "50215101": {
            "id": "50215101",
            "speakerId": 1000,
            "speakerName": "Uturunku",
            "text": "*sigh*... I have to do this."
          }
        }
      }
    },
    {
      "subId": "502152",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50215201"
        ],
        "dialogs": {
          "50215201": {
            "id": "50215201",
            "speakerId": 1000,
            "speakerName": "Uturunku",
            "text": "Thanks for your encouragement. You helped me accept my fear, and now... It doesn't seem so scary anymore."
          }
        }
      }
    },
    {
      "subId": "502153",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50215301"
        ],
        "dialogs": {
          "50215301": {
            "id": "50215301",
            "speakerId": 1013,
            "speakerName": "Guaman",
            "text": "That doctor is amazing! I owe her my life. I'll never forget that!"
          }
        }
      }
    },
    {
      "subId": "502154",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50215401"
        ],
        "dialogs": {
          "50215401": {
            "id": "50215401",
            "speakerId": 1007,
            "speakerName": "Chimalli",
            "text": "We'll continue to stand guard. Thanks for all the help."
          }
        }
      }
    },
    {
      "subId": "502155",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50215501"
        ],
        "dialogs": {
          "50215501": {
            "id": "50215501",
            "speakerId": 1008,
            "speakerName": "Awhina",
            "text": "I... I suppose our safety is in your hands, then.",
            "nextDialogs": [
              "50215502"
            ]
          },
          "50215502": {
            "id": "50215502",
            "speakerId": 1006,
            "speakerName": "Stadukhin",
            "text": "It's dangerous to rely solely on others. You also need to look after your own safety."
          }
        }
      }
    },
    {
      "subId": "502156",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50215601"
        ],
        "dialogs": {
          "50215601": {
            "id": "50215601",
            "speakerId": 1008,
            "speakerName": "Awhina",
            "text": "At least we weren't the only caravan headed to the People of the Springs. I'll focus on doing what I can while staying safe."
          }
        }
      }
    },
    {
      "subId": "502157",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50215701"
        ],
        "dialogs": {
          "50215701": {
            "id": "50215701",
            "speakerId": 1003,
            "speakerName": "Mayahuel",
            "text": "Oh, that reminds me, is it possible to set up some future deliveries?",
            "nextDialogs": [
              "50215702"
            ]
          },
          "50215702": {
            "id": "50215702",
            "speakerId": 1008,
            "speakerName": "Awhina",
            "text": "I'm not sure... Communication is tricky right now, and our stock is getting low, but I can try."
          }
        }
      }
    },
    {
      "subId": "502158",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50215801"
        ],
        "dialogs": {
          "50215801": {
            "id": "50215801",
            "speakerId": 1000,
            "speakerName": "Uturunku",
            "text": "I don't have to die to become a hero. Just being remembered is enough."
          }
        }
      }
    },
    {
      "subId": "502159",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50215901"
        ],
        "dialogs": {
          "50215901": {
            "id": "50215901",
            "speakerId": 1000,
            "speakerName": "Uturunku",
            "text": "You're right. We're not fighting to die. We're fighting to survive."
          }
        }
      }
    }
  ]
}
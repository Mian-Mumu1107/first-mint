  "subQuests": [
    {
      "subId": "2204901",
      "subQuestName": "Talk to Naganohara Ryuunosuke",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220490101"
        ],
        "dialogs": {
          "220490101": {
            "id": "220490101",
            "speakerId": 1000,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "Oh, if it isn't my little girl's new pal? You here to hang out with her again?",
            "nextDialogs": [
              "220490103",
              "220490106"
            ]
          },
          "220490103": {
            "id": "220490103",
            "speakerId": 1000,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "Good, very good! Hahaha, my little girl's a real good tinkerer, she is, eh?",
            "nextDialogs": [
              "220490104"
            ]
          },
          "220490104": {
            "id": "220490104",
            "speakerId": 1000,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "Did you come looking for her today?",
            "nextDialogs": [
              "220490107"
            ]
          },
          "220490107": {
            "id": "220490107",
            "speakerId": 1000,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "Well, that's unfortunate! She said she was going to gather materials to make new fireworks, so she's out at the moment!",
            "nextDialogs": [
              "220490108"
            ]
          },
          "220490108": {
            "id": "220490108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Huh. Then where is she?",
            "nextDialogs": [
              "220490109"
            ]
          },
          "220490109": {
            "id": "220490109",
            "speakerId": 1000,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "What? Err, what did you say?",
            "nextDialogs": [
              "220490110"
            ]
          },
          "220490110": {
            "id": "220490110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yoimiya! Where's she gone?",
            "nextDialogs": [
              "220490111"
            ]
          },
          "220490111": {
            "id": "220490111",
            "speakerId": 1000,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "Oh, uh... I'm actually not that sure. She might have mentioned it, but you know, I don't think I heard it that clearly with these ears of mine...",
            "nextDialogs": [
              "220490112"
            ]
          },
          "220490112": {
            "id": "220490112",
            "speakerId": 1000,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "Do you have something you need from her? Would you like to buy some fireworks?"
          },
          "220490106": {
            "id": "220490106",
            "speakerId": 1000,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "Ah, you're here looking for her, eh?"
          }
        }
      }
    },
    {
      "subId": "2204902",
      "subQuestName": "Test the fireworks outside the city",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220490201"
        ],
        "dialogs": {
          "220490201": {
            "id": "220490201",
            "speakerId": 1000,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "Off you go, then. Make sure you set these off outside the city, though. If you light them up inside, you're going to attract a whole bunch of people..."
          }
        }
      }
    },
    {
      "subId": "2204903",
      "subQuestName": "Report back to Naganohara Ryuunosuke",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220490301"
        ],
        "dialogs": {
          "220490301": {
            "id": "220490301",
            "speakerId": 1000,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "Ah, you're back! How were the fireworks?",
            "nextDialogs": [
              "220490303",
              "220490305"
            ]
          },
          "220490303": {
            "id": "220490303",
            "speakerId": 1000,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "Glad that you enjoyed them!",
            "nextDialogs": [
              "220490306"
            ]
          },
          "220490306": {
            "id": "220490306",
            "speakerId": 1000,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "Well, I need to get back to manning the store now. Business has really picked up recently.",
            "nextDialogs": [
              "220490307"
            ]
          },
          "220490307": {
            "id": "220490307",
            "speakerId": 1000,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "Heh, why isn't that girl back yet. Where has she gone to do her tinkering, I wonder..."
          },
          "220490305": {
            "id": "220490305",
            "speakerId": 1000,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "Oh, you really liked it, didn't you? Don't worry. I'll pass you some more next time."
          }
        }
      }
    }
  ]
}
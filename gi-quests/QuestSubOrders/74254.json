    {
      "subId": "7425403",
      "subQuestName": "Enjoy teatime",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742540501"
        ],
        "dialogs": {
          "742540501": {
            "id": "742540501",
            "speakerId": 1000,
            "speakerName": "Ann",
            "text": "Seymour! It's been so long! And Mamere too!",
            "nextDialogs": [
              "742540502"
            ]
          },
          "742540502": {
            "id": "742540502",
            "speakerId": 1001,
            "speakerName": "Mamere",
            "text": "Hehe, Seymour wouldn't stop telling me how much he missed you.",
            "nextDialogs": [
              "742540503"
            ]
          },
          "742540503": {
            "id": "742540503",
            "speakerId": 1002,
            "speakerName": "Seymour",
            "text": "Affirmative. I never stopped thinking of Miss Mary-Ann.",
            "nextDialogs": [
              "742540504"
            ]
          },
          "742540504": {
            "id": "742540504",
            "speakerId": 1003,
            "speakerName": "Mary-Ann",
            "text": "And thank you, Miss Sandrone, for hosting this tea party. It's so nice to get together and chat about our travels.",
            "nextDialogs": [
              "742540505"
            ]
          },
          "742540505": {
            "id": "742540505",
            "speakerId": 1004,
            "speakerName": "Marionette",
            "text": "Don't mention it. I feel like we're all family on some level, with a long, shared history. Uhm, at least that's how I see it. So there's no harm in getting together when everyone's free.",
            "nextDialogs": [
              "742540506"
            ]
          },
          "742540506": {
            "id": "742540506",
            "speakerId": 1000,
            "speakerName": "Ann",
            "text": "Family? I don't know why, but hearing you say that fills me with joy.",
            "nextDialogs": [
              "742540507"
            ]
          },
          "742540507": {
            "id": "742540507",
            "speakerId": 1003,
            "speakerName": "Mary-Ann",
            "text": "So does that make Miss Sandrone our... little sister?",
            "nextDialogs": [
              "742540508"
            ]
          },
          "742540508": {
            "id": "742540508",
            "speakerId": 1004,
            "speakerName": "Marionette",
            "text": "Uhm... Maybe we can skip the whole big, little thing for now...?",
            "nextDialogs": [
              "742540509"
            ]
          },
          "742540509": {
            "id": "742540509",
            "speakerId": 1002,
            "speakerName": "Seymour",
            "text": "Affirmative. As the prototype created by Mr. Alain, Miss Sandrone should properly address me as \"Big Brother.\"",
            "nextDialogs": [
              "742540510"
            ]
          },
          "742540510": {
            "id": "742540510",
            "speakerId": 1004,
            "speakerName": "Marionette",
            "text": "Hmph...",
            "nextDialogs": [
              "742540511"
            ]
          },
          "742540511": {
            "id": "742540511",
            "speakerId": 1001,
            "speakerName": "Mamere",
            "text": "Aw, that's so lovely. Can I be a member of this family, too?",
            "nextDialogs": [
              "742540512"
            ]
          },
          "742540512": {
            "id": "742540512",
            "speakerId": 1004,
            "speakerName": "Marionette",
            "text": "Of course! We're hardly a conventional \"family\" to begin with. What harm could adding a Melusine to the mix do?",
            "nextDialogs": [
              "742540513"
            ]
          },
          "742540513": {
            "id": "742540513",
            "speakerId": 1002,
            "speakerName": "Seymour",
            "text": "Affirmative. Besides, Miss Mamere is already my family.",
            "nextDialogs": [
              "742540514"
            ]
          },
          "742540514": {
            "id": "742540514",
            "speakerId": 1001,
            "speakerName": "Mamere",
            "text": "Hehe. This makes me so happy! How about I paint us all a family portrait?",
            "nextDialogs": [
              "742540515"
            ]
          },
          "742540515": {
            "id": "742540515",
            "speakerId": 1003,
            "speakerName": "Mary-Ann",
            "text": "A family portrait? It's been a long time since I posed for one of those...",
            "nextDialogs": [
              "742540516"
            ]
          },
          "742540516": {
            "id": "742540516",
            "speakerId": 1000,
            "speakerName": "Ann",
            "text": "Make sure to make me look impressive! Like the big sister of the family!",
            "nextDialogs": [
              "742540517"
            ]
          },
          "742540517": {
            "id": "742540517",
            "speakerId": 1001,
            "speakerName": "Mamere",
            "text": "Sure thing!",
            "nextDialogs": [
              "742540518"
            ]
          },
          "742540518": {
            "id": "742540518",
            "speakerId": 1004,
            "speakerName": "Marionette",
            "text": "Heh... Why not?"
          }
        }
      }
    },
    {
      "subId": "7425404",
      "subQuestName": "Enjoy teatime",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742540601"
        ],
        "dialogs": {
          "742540601": {
            "id": "742540601",
            "speakerId": 1003,
            "speakerName": "Mary-Ann",
            "text": "Such a peaceful, pleasant day.",
            "nextDialogs": [
              "742540602"
            ]
          },
          "742540602": {
            "id": "742540602",
            "speakerId": 1004,
            "speakerName": "Marionette",
            "text": "(Let's sit like this for a little while longer.)",
            "nextDialogs": [
              "742540604"
            ]
          },
          "742540604": {
            "id": "742540604",
            "speakerId": 1003,
            "speakerName": "Mary-Ann",
            "text": "Mmhmm, thank you for the invitation, Sandrone... Or should I call you \"little sister\"?"
          }
        }
      }
    }
  ]
}
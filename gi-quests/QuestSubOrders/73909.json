        "dialogs": {
          "739090101": {
            "id": "739090101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Gorgeous... and gentle...",
            "nextDialogs": [
              "739090102"
            ]
          },
          "739090102": {
            "id": "739090102",
            "speakerId": 4125,
            "speakerName": "Nesmil",
            "text": "Shh, quiet, don't let her hear you!",
            "nextDialogs": [
              "739090103"
            ]
          },
          "739090103": {
            "id": "739090103",
            "speakerId": 4125,
            "speakerName": "Nesmil",
            "text": "Every time I say something like that, she thinks I'm nagging and gives me the cold shoulder. I don't want that.",
            "nextDialogs": [
              "739090104"
            ]
          },
          "739090104": {
            "id": "739090104",
            "speakerId": 4125,
            "speakerName": "Nesmil",
            "text": "To be honest, I left the Eremites for here because of Roshana.",
            "nextDialogs": [
              "739090105"
            ]
          },
          "739090105": {
            "id": "739090105",
            "speakerId": 4125,
            "speakerName": "Nesmil",
            "text": "She is such a visionary! I enjoy much more freedom here than freelancing for the Akademiya.",
            "nextDialogs": [
              "739090106"
            ]
          },
          "739090106": {
            "id": "739090106",
            "speakerId": 4125,
            "speakerName": "Nesmil",
            "text": "But don't tell her I said that. I'll bribe you with some nice cooking!"
          }
        }
      }
    }
  ]

        ],
        "dialogs": {
          "60280501": {
            "id": "60280501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Columbina...)",
            "nextDialogs": [
              "60280502"
            ]
          },
          "60280502": {
            "id": "60280502",
            "speakerId": 1010,
            "speakerName": "Columbina",
            "text": "..."
          }
        }
      }
    },
    {
      "subId": "602411",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60241102"
        ],
        "dialogs": {
          "60241102": {
            "id": "60241102",
            "speakerId": 1010,
            "speakerName": "Columbina",
            "text": "I never thought that \"Columbina\" would become my real name.",
            "nextDialogs": [
              "60241104"
            ]
          },
          "60241104": {
            "id": "60241104",
            "speakerId": 1010,
            "speakerName": "Columbina",
            "text": "It went being from a Fatui codename... to \"something my friends call me.\""
          }
        }
      }
    },
    {
      "subId": "602899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60289902"
        ],
        "dialogs": {
          "60289902": {
            "id": "60289902",
            "speakerId": 1010,
            "speakerName": "Columbina",
            "text": "(I still don't know what to expect on the moon...)",
            "nextDialogs": [
              "60289903"
            ]
          },
          "60289903": {
            "id": "60289903",
            "speakerId": 1010,
            "speakerName": "Columbina",
            "text": "(Will I really be able to send messages to my friends...?)",
            "nextDialogs": [
              "60289905"
            ]
          },
          "60289905": {
            "id": "60289905",
            "speakerId": 1010,
            "speakerName": "Columbina",
            "text": "(I wonder where I'll be when the next Moon-Prayer Night comes?)"
          }
        }
      }
    }
  ]
}
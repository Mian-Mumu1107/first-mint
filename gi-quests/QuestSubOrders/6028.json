    {
      "subId": "602802",
      "subQuestName": "Set out on the path back to the moon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60280201"
        ],
        "dialogs": {
          "60280201": {
            "id": "60280201",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "This is... this is where the people of Hyperborea used to communicate with the moons...",
            "nextDialogs": [
              "60280202"
            ]
          },
          "60280202": {
            "id": "60280202",
            "speakerId": 1001,
            "speakerName": "Lauma",
            "text": "Eternal Moon, Frost Moon, Iridescent Moon... When the power of all three converge...",
            "nextDialogs": [
              "60280203"
            ]
          },
          "60280203": {
            "id": "60280203",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "The gate to the moons shall open.",
            "nextDialogs": [
              "60280204"
            ]
          },
          "60280204": {
            "id": "60280204",
            "speakerId": 1001,
            "speakerName": "Lauma",
            "text": "Mmhmm...",
            "nextDialogs": [
              "60280205"
            ]
          },
          "60280205": {
            "id": "60280205",
            "speakerId": 1002,
            "speakerName": "The Knave",
            "text": "The Moon Marrows are in position. Only the final step remains.",
            "nextDialogs": [
              "60280206"
            ]
          },
          "60280206": {
            "id": "60280206",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...I'm sure Nasha Town is livelier than ever at this moment.",
            "nextDialogs": [
              "60280207"
            ]
          },
          "60280207": {
            "id": "60280207",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Yeah... It's a shame you couldn't be there for it. But it's now or never, right?",
            "nextDialogs": [
              "60280208"
            ]
          },
          "60280208": {
            "id": "60280208",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "It's fine. I'm more than happy with this... my last piece of luggage — my only piece of luggage.",
            "nextDialogs": [
              "60280209"
            ]
          },
          "60280209": {
            "id": "60280209",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "60280210"
            ]
          },
          "60280210": {
            "id": "60280210",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "I can already feel the moon calling to me.",
            "nextDialogs": [
              "60280211"
            ]
          },
          "60280211": {
            "id": "60280211",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "60280212"
            ]
          },
          "60280212": {
            "id": "60280212",
            "speakerId": 1002,
            "speakerName": "The Knave",
            "text": "This ray of light will lead you home, Columbina.",
            "nextDialogs": [
              "60280213"
            ]
          },
          "60280213": {
            "id": "60280213",
            "speakerId": 1001,
            "speakerName": "Lauma",
            "text": "From now on, we will at last have a reason to pray to the true moon.",
            "nextDialogs": [
              "60280214"
            ]
          },
          "60280214": {
            "id": "60280214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Columbina.",
            "nextDialogs": [
              "60280215"
            ]
          },
          "60280215": {
            "id": "60280215",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Yes. I'm listening.",
            "nextDialogs": [
              "60280216"
            ]
          },
          "60280216": {
            "id": "60280216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Be sure to come back and see us when you get the chance!",
            "nextDialogs": [
              "60280217"
            ]
          },
          "60280217": {
            "id": "60280217",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Hah... Of course.",
            "nextDialogs": [
              "60280218"
            ]
          },
          "60280218": {
            "id": "60280218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But if that chance doesn't come... Then remember that you have friends on this planet — people who will miss \"Columbina.\"",
            "nextDialogs": [
              "60280219"
            ]
          },
          "60280219": {
            "id": "60280219",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Yes, I will. Thank you for everything you've done for me.",
            "nextDialogs": [
              "60280220"
            ]
          },
          "60280220": {
            "id": "60280220",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "And remember... Come night or day, the moonlight shall always connect us.",
            "nextDialogs": [
              "60280221"
            ]
          },
          "60280221": {
            "id": "60280221",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "... Well then... Farewell, my friends."
          }
        }
      }
    },

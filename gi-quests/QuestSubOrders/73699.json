    {
      "subId": "7369906",
      "subQuestName": "Talk to Sorush",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736990601"
        ],
        "dialogs": {
          "736990601": {
            "id": "736990601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, isn't this the place we passed by looking for Mihir? Though, Mihir shouldn't be here right now, right?",
            "nextDialogs": [
              "736990602"
            ]
          },
          "736990602": {
            "id": "736990602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "All those thorns... They should be Mihir's companions. They look pretty good. Speaking of which, they helped us a lot.",
            "nextDialogs": [
              "736990603"
            ]
          },
          "736990603": {
            "id": "736990603",
            "speakerId": 13210,
            "speakerName": "Sorush",
            "text": "Pale Floater... Did you forget all that I have accomplished?",
            "nextDialogs": [
              "736990604"
            ]
          },
          "736990604": {
            "id": "736990604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No way. You might complain a lot, but you do care about your people, right?",
            "nextDialogs": [
              "736990606",
              "736990608"
            ]
          },
          "736990606": {
            "id": "736990606",
            "speakerId": 13210,
            "speakerName": "Sorush",
            "text": "How can you be so forgetful, Yasnapati? I punish you with the task of several more odes!",
            "nextDialogs": [
              "736990609"
            ]
          },
          "736990609": {
            "id": "736990609",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Haha. Paimon knew it! You've got a big bark to go with your soft heart.",
            "nextDialogs": [
              "736990610"
            ]
          },
          "736990610": {
            "id": "736990610",
            "speakerId": 13210,
            "speakerName": "Sorush",
            "text": "Malicious slander! I was only here because I wished to earn the Chaplet. If the elder hadn't made me come... Hmph.",
            "nextDialogs": [
              "736990611"
            ]
          },
          "736990611": {
            "id": "736990611",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, whatever you say, Mihir's part of the reason you even managed to claim the Twin-Horned Chaplet. Shouldn't you thank her for that, at least?",
            "nextDialogs": [
              "736990612"
            ]
          },
          "736990612": {
            "id": "736990612",
            "speakerId": 13210,
            "speakerName": "Sorush",
            "text": "Her? Bah. For such a figure, one stained and still struggling thusly, I'd say she would only be worth any merit after another ten cleansing pilgrimages.",
            "nextDialogs": [
              "736990613"
            ]
          },
          "736990613": {
            "id": "736990613",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ten is way too many! Uh... Wait a minute, on second thought, Paimon thinks it wouldn't be too hard..."
          },
          "736990608": {
            "id": "736990608",
            "speakerId": 13210,
            "speakerName": "Sorush",
            "text": "Indeed, hehe."
          }
        }
      }
    }
  ]
}
    {
      "subId": "7507014",
      "subQuestName": "Talk to Magnifico",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750701401"
        ],
        "dialogs": {
          "750701401": {
            "id": "750701401",
            "speakerId": 21586,
            "speakerName": "Magnifico",
            "text": "Gah, we must start over! ...Uh, if you don't mind, I mean.",
            "nextDialogs": [
              "750701402"
            ]
          },
          "750701402": {
            "id": "750701402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*sigh* There's no \"mind\" or \"don't mind.\" We're already here, aren't we?",
            "nextDialogs": [
              "750701404",
              "750701406"
            ]
          },
          "750701404": {
            "id": "750701404",
            "speakerId": 21586,
            "speakerName": "Magnifico",
            "text": "You have my thanks."
          },
          "750701406": {
            "id": "750701406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's right. Jumping off cliffs is hard work, y'know?",
            "nextDialogs": [
              "750701407"
            ]
          },
          "750701407": {
            "id": "750701407",
            "speakerId": 21586,
            "speakerName": "Magnifico",
            "text": "Ah... Yes. I did not consider that. Alright, just start whenever you're ready. I will wait for you here."
          }
        }
      }
    },
    {
      "subId": "7507009",
      "subQuestName": "Talk to Magnifico",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750700901"
        ],
        "dialogs": {
          "750700901": {
            "id": "750700901",
            "speakerId": 21586,
            "speakerName": "Magnifico",
            "text": "Haha! Perfect! Here, have a copy!",
            "nextDialogs": [
              "750700902"
            ]
          },
          "750700902": {
            "id": "750700902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, that *is* amazing!",
            "nextDialogs": [
              "750700903"
            ]
          },
          "750700903": {
            "id": "750700903",
            "speakerId": 21586,
            "speakerName": "Magnifico",
            "text": "Here's your compensation. This is the second... No, the third time you've aided me. If not for you... Why, I doubt I'd have a chance of finishing my photo-taking trip at all!",
            "nextDialogs": [
              "750700904"
            ]
          },
          "750700904": {
            "id": "750700904",
            "speakerId": 21586,
            "speakerName": "Magnifico",
            "text": "My destination is... Here. I've marked it out on your map. Again, if you're interested, I look forward to working with you again.",
            "nextDialogs": [
              "750700905"
            ]
          },
          "750700905": {
            "id": "750700905",
            "speakerId": 21586,
            "speakerName": "Magnifico",
            "text": "Ah! It's almost time. I've got to go now. See you, and good luck!",
            "nextDialogs": [
              "750700906"
            ]
          },
          "750700906": {
            "id": "750700906",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Magnifico finishes packing and hops happily up into his hot-air balloon.\\nAs the balloon slowly disappears, his boisterous laughter is reduced to a distant echo..."
          }
        }
      }
    },

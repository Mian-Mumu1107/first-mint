      }
    },
    {
      "subId": "7507015",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750701501"
        ],
        "dialogs": {
          "750701501": {
            "id": "750701501",
            "speakerId": 21586,
            "speakerName": "Magnifico",
            "text": "What's up? Are those little ones refusing to listen to you as well?"
          }
        }
      }
    },
    {
      "subId": "7507016",
      "subQuestName": "Talk to Magnifico",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750701601"
        ],
        "dialogs": {
          "750701601": {
            "id": "750701601",
            "speakerId": 21586,
            "speakerName": "Magnifico",
            "text": "*sigh* As you can see, the results are... not ideal. As the deeds, so the man — unsuccessful both!",
            "nextDialogs": [
              "750701602"
            ]
          },
          "750701602": {
            "id": "750701602",
            "speakerId": 21586,
            "speakerName": "Magnifico",
            "text": "Ah... My family always told me that even small trees can cast huge shadows... But it's nonsense! Nonsense! They only meant to humiliate me, surely!",
            "nextDialogs": [
              "750701603"
            ]
          },
          "750701603": {
            "id": "750701603",
            "speakerId": 21586,
            "speakerName": "Magnifico",
            "text": "Ugh...",
            "nextDialogs": [
              "750701604"
            ]
          },
          "750701604": {
            "id": "750701604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, hey, don't get mad! You're not going to get any bigger even if you do!",
            "nextDialogs": [
              "750701606",
              "750701610"
            ]
          },
          "750701606": {
            "id": "750701606",
            "speakerId": 21586,
            "speakerName": "Magnifico",
            "text": "Give up? Who says I'm giving up? Nay! Anger and shame only drive me on, give me strength — that is their purpose! We continue!",
            "nextDialogs": [
              "750701607"
            ]
          },
          "750701607": {
            "id": "750701607",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, he's sure fired up... Still a pretty weird guy, though.",
            "nextDialogs": [
              "750701608"
            ]
          },
          "750701608": {
            "id": "750701608",
            "speakerId": 21586,
            "speakerName": "Magnifico",
            "text": "Yes, yes."
          },
          "750701610": {
            "id": "750701610",
            "speakerId": 21586,
            "speakerName": "Magnifico",
            "text": "Yes, let's!",
            "nextDialogs": [
              "750701611"
            ]
          },
          "750701611": {
            "id": "750701611",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, you sure recover fast!"
          }
        }
      }
    },
    {

    {
      "subId": "800403",
      "subQuestName": "Go to the designated location to investigate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80040301"
        ],
        "dialogs": {
          "80040301": {
            "id": "80040301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What the... It's a city?",
            "nextDialogs": [
              "80040302"
            ]
          },
          "80040302": {
            "id": "80040302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A whole city that's... floating in the air... upside down!?",
            "nextDialogs": [
              "80040402"
            ]
          },
          "80040402": {
            "id": "80040402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Just look at this place, {NICKNAME}... Doesn't it remind you of something?",
            "nextDialogs": [
              "80040403"
            ]
          },
          "80040403": {
            "id": "80040403",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, what was it again...",
            "nextDialogs": [
              "80040404"
            ]
          },
          "80040404": {
            "id": "80040404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"The Defiled Statue.\"",
            "nextDialogs": [
              "80040405"
            ]
          },
          "80040405": {
            "id": "80040405",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yes, that's it! It's just like that. Just as strange, just as upside-down, and just as spooky.",
            "nextDialogs": [
              "80040406"
            ]
          },
          "80040406": {
            "id": "80040406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "In which case... Maybe whatever's going on in The Chasm really is connected to the Abyss Order.",
            "nextDialogs": [
              "80040407"
            ]
          },
          "80040407": {
            "id": "80040407",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, we gotta get to the bottom of this...",
            "nextDialogs": [
              "80040408"
            ]
          },
          "80040408": {
            "id": "80040408",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...Oh...",
            "nextDialogs": [
              "80040409"
            ]
          },
          "80040409": {
            "id": "80040409",
            "speakerId": 1003,
            "speakerName": "Dainsleif",
            "text": "..."
          }
        }
      }
    },
    {
      "subId": "800405",
      "subQuestName": "Go to the designated location to investigate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80040501"
        ],
        "dialogs": {
          "80040501": {
            "id": "80040501",
            "speakerId": 1002,
            "speakerName": "Yuehui",
            "text": "It took a huge amount of work to get this Mining Permit... I hope it was worth it. The rest is up to you."
          }
        }
      }
    },
    {
      "subId": "800404",

    {
      "subId": "800499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80049901"
        ],
        "dialogs": {
          "80049901": {
            "id": "80049901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Looks like we can't explore any further... Hmm, is there any way to open up this tunnel?"
          }
        }

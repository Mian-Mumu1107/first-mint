        "dialogs": {
          "732671001": {
            "id": "732671001",
            "speakerId": 1003,
            "speakerName": "Ayten",
            "text": "Those scorpions are huge! Uh, should we really get any closer to them?",
            "nextDialogs": [
              "732671002"
            ]
          },
          "732671002": {
            "id": "732671002",
            "speakerId": 1004,
            "speakerName": "Karima",
            "text": "I shot them with my bow, but they didn't even flinch...",
            "nextDialogs": [
              "732671003"
            ]
          },
          "732671003": {
            "id": "732671003",
            "speakerId": 1004,
            "speakerName": "Karima",
            "text": "But you... you defeated them so easily...",
            "nextDialogs": [
              "732671006"
            ]
          },
          "732671006": {
            "id": "732671006",
            "speakerId": 1004,
            "speakerName": "Karima",
            "text": "But... Miss Candace said I'd improved...",
            "nextDialogs": [
              "732671007"
            ]
          },
          "732671007": {
            "id": "732671007",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Chin up, Karima! You'll become strong eventually — but you've got to take it all one day at a time.",
            "nextDialogs": [
              "732671008"
            ]
          },
          "732671008": {
            "id": "732671008",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "You too, Ayten. If you keep training hard like this, it's only a matter of time before we'll let you in.",
            "nextDialogs": [
              "732671009"
            ]
          },
          "732671009": {
            "id": "732671009",
            "speakerId": 1003,
            "speakerName": "Ayten",
            "text": "Ohh, if only I could get Miss Dehya to teach me...",
            "nextDialogs": [
              "732671010"
            ]
          },
          "732671010": {
            "id": "732671010",
            "speakerId": 1004,
            "speakerName": "Karima",
            "text": "The next time I see Miss Candace, I'll get her to teach me more!",
            "nextDialogs": [
              "732671011"
            ]
          },
          "732671011": {
            "id": "732671011",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Hahaha! That's the spirit!"
          }
        }
      }

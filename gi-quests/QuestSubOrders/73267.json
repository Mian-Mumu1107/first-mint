        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7326703",
      "subQuestName": "Talk to Sania",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732670301"
        ],
        "dialogs": {
          "732670301": {
            "id": "732670301",
            "speakerId": 1001,
            "speakerName": "Sania",
            "text": "How worrying...",
            "nextDialogs": [
              "732670302"
            ]
          },
          "732670302": {
            "id": "732670302",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Good afternoon, Sania! What are you buying?",
            "nextDialogs": [
              "732670303"
            ]
          },
          "732670303": {
            "id": "732670303",
            "speakerId": 1001,
            "speakerName": "Sania",
            "text": "I've told you many times before, Atiyah, Jabari isn't interested in joining you, nor do I want him to go become a mercenary. I'm not going to help you convince him.",
            "nextDialogs": [
              "732670304"
            ]
          },
          "732670304": {
            "id": "732670304",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Well, that's a shame. With his culinary skills, Jabari'd do really well with us, and your family's financial standing would be improved greatly, too.",
            "nextDialogs": [
              "732670305"
            ]
          },
          "732670305": {
            "id": "732670305",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "And hasn't he said before that he'd like to go out and find work? If that's what he really wants, who better to recommend work than an old friend, eh?",
            "nextDialogs": [
              "732670306"
            ]
          },
          "732670306": {
            "id": "732670306",
            "speakerId": 1001,
            "speakerName": "Sania",
            "text": "Don't take anything he says seriously. He'll tell you that one day, and change his mind the next.",
            "nextDialogs": [
              "732670307"
            ]
          },
          "732670307": {
            "id": "732670307",
            "speakerId": 1001,
            "speakerName": "Sania",
            "text": "In the end, he just can't bear to leave me here alone in the village... and I couldn't bear to see him slogging away by himself, either.",
            "nextDialogs": [
              "732670308"
            ]
          },
          "732670308": {
            "id": "732670308",
            "speakerId": 1001,
            "speakerName": "Sania",
            "text": "What's more, you're asking that he risk his neck out there as a mercenary! Even if he wanted to go, I'd stop him for sure.",
            "nextDialogs": [
              "732670309"
            ]
          },
          "732670309": {
            "id": "732670309",
            "speakerId": 1001,
            "speakerName": "Sania",
            "text": "Let's just leave this topic be. I've got things to buy — go bother someone else.",
            "nextDialogs": [
              "732670310"
            ]
          },
          "732670310": {
            "id": "732670310",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Phew... Well, alright then. You see, traveler? This is what work looks like for me every day.",
            "nextDialogs": [
              "732670311"
            ]
          },
          "732670311": {
            "id": "732670311",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Next up on my list of people to meet is Fodil. He was one of us once... but he quit.",
            "nextDialogs": [
              "732670312"
            ]
          },
          "732670312": {
            "id": "732670312",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Sure would be nice if I could convince him to make a bit of a comeback..."
          }
        }
      }
    },
    {
      "subId": "7326705",
      "subQuestName": "Talk to Fodil",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732670501"
        ],
        "dialogs": {
          "732670501": {
            "id": "732670501",
            "speakerId": 1002,
            "speakerName": "Fodil",
            "text": "Atiyah... Not you again.",
            "nextDialogs": [
              "732670502"
            ]
          },
          "732670502": {
            "id": "732670502",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Hehe, persistence is one of our virtues, you know.",
            "nextDialogs": [
              "732670503"
            ]
          },
          "732670503": {
            "id": "732670503",
            "speakerId": 1002,
            "speakerName": "Fodil",
            "text": "Well, then you should know that sticking to principles is mine.",
            "nextDialogs": [
              "732670504"
            ]
          },
          "732670504": {
            "id": "732670504",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Come on now, brother...",
            "nextDialogs": [
              "732670505"
            ]
          },
          "732670505": {
            "id": "732670505",
            "speakerId": 1002,
            "speakerName": "Fodil",
            "text": "I've left the organization already. Don't call me that.",
            "nextDialogs": [
              "732670506"
            ]
          },
          "732670506": {
            "id": "732670506",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Right, alright, Fodil. You sure you're not considering coming back at all?",
            "nextDialogs": [
              "732670507"
            ]
          },
          "732670507": {
            "id": "732670507",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "I know that some of us can be a bit... reckless, but most of us are perfectly law-abiding citizens!",
            "nextDialogs": [
              "732670508"
            ]
          },
          "732670508": {
            "id": "732670508",
            "speakerId": 1002,
            "speakerName": "Fodil",
            "text": "I've said this before, Atiyah. I'm not going back.",
            "nextDialogs": [
              "732670509"
            ]
          },
          "732670509": {
            "id": "732670509",
            "speakerId": 1002,
            "speakerName": "Fodil",
            "text": "The things you speak of, I've already confirmed them with my own two eyes.",
            "nextDialogs": [
              "732670510"
            ]
          },
          "732670510": {
            "id": "732670510",
            "speakerId": 1002,
            "speakerName": "Fodil",
            "text": "Perhaps not all the Eremites are a lawless lot, and not every Eremite enjoys kicking those who have already gone down...",
            "nextDialogs": [
              "732670511"
            ]
          },
          "732670511": {
            "id": "732670511",
            "speakerId": 1002,
            "speakerName": "Fodil",
            "text": "But ill deeds spread, Atiyah. All it takes is one person to act like the law is merely a suggestion, and everyone else will be affected by them.",
            "nextDialogs": [
              "732670522"
            ]
          },
          "732670522": {
            "id": "732670522",
            "speakerId": 1002,
            "speakerName": "Fodil",
            "text": "One person influences another, and if that group keeps acting a certain way, they will influence yet more people...",
            "nextDialogs": [
              "732670523"
            ]
          },
          "732670523": {
            "id": "732670523",
            "speakerId": 1002,
            "speakerName": "Fodil",
            "text": "I'm sure you know what that means better than I do, Atiyah.",
            "nextDialogs": [
              "732670512"
            ]
          },
          "732670512": {
            "id": "732670512",
            "speakerId": 1002,
            "speakerName": "Fodil",
            "text": "It is all too easy to do evil in such an environment.",
            "nextDialogs": [
              "732670513"
            ]
          },
          "732670513": {
            "id": "732670513",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "...",
            "nextDialogs": [
              "732670514"
            ]
          },
          "732670514": {
            "id": "732670514",
            "speakerId": 1002,
            "speakerName": "Fodil",
            "text": "You wish for me to return... just as I wish for you to leave.",
            "nextDialogs": [
              "732670515"
            ]
          },
          "732670515": {
            "id": "732670515",
            "speakerId": 1002,
            "speakerName": "Fodil",
            "text": "Perhaps from your perspective, the Eremites are not an evil organization even if they're not exactly honorable... But you can't always live in shades of gray.",
            "nextDialogs": [
              "732670516"
            ]
          },
          "732670516": {
            "id": "732670516",
            "speakerId": 1002,
            "speakerName": "Fodil",
            "text": "This is just a word of advice. You may do with it as you will.",
            "nextDialogs": [
              "732670517"
            ]
          },
          "732670517": {
            "id": "732670517",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "I know, chief.",
            "nextDialogs": [
              "732670518"
            ]
          },
          "732670518": {
            "id": "732670518",
            "speakerId": 1002,
            "speakerName": "Fodil",
            "text": "Alright. If you do leave and need a new line of work, I will help you.",
            "nextDialogs": [
              "732670519"
            ]
          },
          "732670519": {
            "id": "732670519",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you alright?",
            "nextDialogs": [
              "732670520"
            ]
          },
          "732670520": {
            "id": "732670520",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Heh, well, there's no way I can win an argument with Fodil, I guess.",
            "nextDialogs": [
              "732670521"
            ]
          },
          "732670521": {
            "id": "732670521",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "What's next? Right, right, let's rest a bit. I gotta say, my throat's getting tired after all that."
          }
        }
      }
    },
    {
      "subId": "7326706",
      "subQuestName": "Go back and take a break",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732670601"
        ],
        "dialogs": {
          "732670601": {
            "id": "732670601",
            "speakerId": 1003,
            "speakerName": "Ayten",
            "text": "Hey, Uncle Atiyah! You still asking people to join the Eremites?",
            "nextDialogs": [
              "732670602"
            ]
          },
          "732670602": {
            "id": "732670602",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Why, if it isn't Ayten. Did you tell your mother you were coming here?",
            "nextDialogs": [
              "732670603"
            ]
          },
          "732670603": {
            "id": "732670603",
            "speakerId": 1003,
            "speakerName": "Ayten",
            "text": "I did! She's working, so I went to go play with Karima.",
            "nextDialogs": [
              "732670604"
            ]
          },
          "732670604": {
            "id": "732670604",
            "speakerId": 1004,
            "speakerName": "Karima",
            "text": "Hello, Uncle Atiyah!",
            "nextDialogs": [
              "732670605"
            ]
          },
          "732670605": {
            "id": "732670605",
            "speakerId": 1003,
            "speakerName": "Ayten",
            "text": "Uncle Atiyah, what do you think? About the stuff we talked about last time.",
            "nextDialogs": [
              "732670606"
            ]
          },
          "732670606": {
            "id": "732670606",
            "speakerId": 1003,
            "speakerName": "Ayten",
            "text": "I've been working out this whole time, and I've even been training with Karima.. She's never gonna catch me again in a race!",
            "nextDialogs": [
              "732670607"
            ]
          },
          "732670607": {
            "id": "732670607",
            "speakerId": 1004,
            "speakerName": "Karima",
            "text": "That one time doesn't count! It was because I didn't eat enough for lunch that day!",
            "nextDialogs": [
              "732670608"
            ]
          },
          "732670608": {
            "id": "732670608",
            "speakerId": 1003,
            "speakerName": "Ayten",
            "text": "...Anyway, I've been following the training plan you gave me...",
            "nextDialogs": [
              "732670609"
            ]
          },
          "732670609": {
            "id": "732670609",
            "speakerId": 1003,
            "speakerName": "Ayten",
            "text": "So let me take the test again! Let's see if I'm good enough to join the Eremites!",
            "nextDialogs": [
              "732670612"
            ]
          },
          "732670612": {
            "id": "732670612",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Ahem! Alright then, Ayten. As a member of the Eremites, I will conduct the test once again!",
            "nextDialogs": [
              "732670613"
            ]
          },
          "732670613": {
            "id": "732670613",
            "speakerId": 1003,
            "speakerName": "Ayten",
            "text": "Alright! C'mon, Karima, you join in too. Let's do this together!",
            "nextDialogs": [
              "732670614"
            ]
          },
          "732670614": {
            "id": "732670614",
            "speakerId": 1004,
            "speakerName": "Karima",
            "text": "But I don't wanna join the Eremites... I just want to stay here in the village and protect everyone...",
            "nextDialogs": [
              "732670615"
            ]
          },
          "732670615": {
            "id": "732670615",
            "speakerId": 1004,
            "speakerName": "Karima",
            "text": "But it would be nice to get Uncle Atiyah to test my skills. I mean, I did ask Miss Candace for advice on how to train before!",
            "nextDialogs": [
              "732670616"
            ]
          },
          "732670616": {
            "id": "732670616",
            "speakerId": 1003,
            "speakerName": "Ayten",
            "text": "Wait, what? When did you...",
            "nextDialogs": [
              "732670617"
            ]
          },
          "732670617": {
            "id": "732670617",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Hahaha! Good, good, that's the spirit!",
            "nextDialogs": [
              "732670618"
            ]
          },
          "732670618": {
            "id": "732670618",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Alright, Ayten, stop pouting. If we get the chance, I'll bring you to go get some pointers from Dehya! How does that sound?",
            "nextDialogs": [
              "732670619"
            ]
          },
          "732670619": {
            "id": "732670619",
            "speakerId": 1003,
            "speakerName": "Ayten",
            "text": "Really!? You'd do that?",
            "nextDialogs": [
              "732670620"
            ]
          },
          "732670620": {
            "id": "732670620",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "We Eremites don't lie, kiddo.",
            "nextDialogs": [
              "732670621"
            ]
          },
          "732670621": {
            "id": "732670621",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "But before we begin the test, let's have this traveler show us the expected standards."
          }
        }
      }
    },
    {
      "subId": "7326707",
      "subQuestName": "Demonstrate for Ayten and Karima",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7326708",
      "subQuestName": "Talk to Ayten and Karima",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732670801"
        ],
        "dialogs": {
          "732670801": {
            "id": "732670801",
            "speakerId": 1003,
            "speakerName": "Ayten",
            "text": "Wow!",
            "nextDialogs": [
              "732670802"
            ]
          },
          "732670802": {
            "id": "732670802",
            "speakerId": 1004,
            "speakerName": "Karima",
            "text": "You're... so fast...",
            "nextDialogs": [
              "732670803"
            ]
          },
          "732670803": {
            "id": "732670803",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Very good! You were quick... and more importantly, very steady.",
            "nextDialogs": [
              "732670804"
            ]
          },
          "732670804": {
            "id": "732670804",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Watch and learn, kids.",
            "nextDialogs": [
              "732670805"
            ]
          },
          "732670805": {
            "id": "732670805",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Don't insist on pushing through every dangerous situation you get in. If you must retreat, retreat decisively!",
            "nextDialogs": [
              "732670806"
            ]
          },
          "732670806": {
            "id": "732670806",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "That means you especially, Ayten.",
            "nextDialogs": [
              "732670807"
            ]
          },
          "732670807": {
            "id": "732670807",
            "speakerId": 1003,
            "speakerName": "Ayten",
            "text": "I know, I know...",
            "nextDialogs": [
              "732670808"
            ]
          },
          "732670808": {
            "id": "732670808",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Good. Let's move on to the next step... It's time for some live combat demonstration.",
            "nextDialogs": [
              "732670809"
            ]
          },
          "732670809": {
            "id": "732670809",
            "speakerId": 1003,
            "speakerName": "Ayten",
            "text": "Ooh, awesome! My dad carved me a wooden sword that I carry with me. What about you, Karima?",
            "nextDialogs": [
              "732670810"
            ]
          },
          "732670810": {
            "id": "732670810",
            "speakerId": 1004,
            "speakerName": "Karima",
            "text": "I do have a small bow, though my mother only gave me arrows without tips...",
            "nextDialogs": [
              "732670811"
            ]
          },
          "732670811": {
            "id": "732670811",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Hahaha! That's alright! You have a sword and a bow, and your boundless courage. That's all anyone really needs to begin their adventures.",
            "nextDialogs": [
              "732670812"
            ]
          },
          "732670812": {
            "id": "732670812",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "But remember not to run around aimlessly when you're outside the village. Stick with me and the Traveler at all times.",
            "nextDialogs": [
              "732670815"
            ]
          },
          "732670815": {
            "id": "732670815",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Oh, don't you worry. I've scouted that area beforehand. There's just a bunch of sickly scorpions out there. They barely retain any offensive capabilities, so we should be alright.",
            "nextDialogs": [
              "732670816"
            ]
          },
          "732670816": {
            "id": "732670816",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "And whatever happens, the two of us will be there!"
          }
        }
      }
    },
    {
      "subId": "7326709",
      "subQuestName": "Defeat all monsters",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

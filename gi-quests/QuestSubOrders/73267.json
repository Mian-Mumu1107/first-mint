  "subQuests": [
    {
      "subId": "7326701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732670101"
        ],
        "dialogs": {
          "732670101": {
            "id": "732670101",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Join the Eremites and embrace a wonderful new life! Come, friend, would you like to hear about the Eremites?",
            "nextDialogs": [
              "732670102"
            ]
          },
          "732670102": {
            "id": "732670102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh...",
            "nextDialogs": [
              "732670103"
            ]
          },
          "732670103": {
            "id": "732670103",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Oh, come on, just listen up a bit. The Eremites is a good community to be a part of! We're free! We're united! Friendly, too!",
            "nextDialogs": [
              "732670104"
            ]
          },
          "732670104": {
            "id": "732670104",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "And if you join up with us, you'll get the chance to fleece those tree-dwellers of their fat wallets. The Akademiya's researchers are a rich lot, and they're not ones to default on their payments either!",
            "nextDialogs": [
              "732670107"
            ]
          },
          "732670107": {
            "id": "732670107",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Eh? You're with the Adventurers' Guild? I mean... That's no obstacle, is it? C'mon, everyone's got a side hustle nowadays — and it's not like adventurers and mercenaries are really that different, you get what I mean?",
            "nextDialogs": [
              "732670108"
            ]
          },
          "732670108": {
            "id": "732670108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I think they're pretty different.",
            "nextDialogs": [
              "732670109"
            ]
          },
          "732670109": {
            "id": "732670109",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "Well, we've got good food here too! Meat and fish are regulars on the menu!",
            "nextDialogs": [
              "732670110"
            ]
          },
          "732670110": {
            "id": "732670110",
            "speakerId": 1000,
            "speakerName": "Atiyah",
            "text": "And if you're lucky, you might even get to meet Dehya, the Flame-Mane! Now I... *cough*"
          }
        }
      }
    },
    {
      "subId": "7326702",
      "subQuestName": "Wait till daytime (6:00 – 19:00)",
      "sceneId": null,
      "locations": [],

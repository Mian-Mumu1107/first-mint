    },
    {
      "subId": "7404311",
      "subQuestName": "Talk to Henri",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740430301"
        ],
        "dialogs": {
          "740430301": {
            "id": "740430301",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "Hmm, there we go — seven cores, all told.",
            "nextDialogs": [
              "740430302"
            ]
          },
          "740430302": {
            "id": "740430302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do you need with them, anyway?",
            "nextDialogs": [
              "740430303"
            ]
          },
          "740430303": {
            "id": "740430303",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "How should I know? My boss just said that seven mysterious cores from these mysterious machines would be needed — and if I can get them, I'll make big Mora.",
            "nextDialogs": [
              "740430304"
            ]
          },
          "740430304": {
            "id": "740430304",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "And well, this'll do! I've arranged to meet him here and report on the situation, so you can just ask him yourself. In any case, I'll need him to settle his bills with me before I can give you your share...",
            "nextDialogs": [
              "740430305"
            ]
          },
          "740430305": {
            "id": "740430305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, fine, if you say so... We'll wait.",
            "nextDialogs": [
              "740430306"
            ]
          },
          "740430306": {
            "id": "740430306",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You wait for a while...",
            "nextDialogs": [
              "740430307"
            ]
          },
          "740430307": {
            "id": "740430307",
            "speakerId": 21028,
            "speakerName": "\"Boss\"",
            "text": "Dear Henri, how are things going?",
            "nextDialogs": [
              "740430308"
            ]
          },
          "740430308": {
            "id": "740430308",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "Very well, Boss! I've gathered the seven mysterious cores you asked for. Anyway, let me introduce you to my partner... Um, what's your name again?",
            "nextDialogs": [
              "740430309"
            ]
          },
          "740430309": {
            "id": "740430309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "740430310"
            ]
          },
          "740430310": {
            "id": "740430310",
            "speakerId": 21028,
            "speakerName": "\"Boss\"",
            "text": "Um...",
            "nextDialogs": [
              "740430311"
            ]
          },
          "740430311": {
            "id": "740430311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh...",
            "nextDialogs": [
              "740430312"
            ]
          },
          "740430312": {
            "id": "740430312",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "Wait? You know each other? Great! So, this is how things went...",
            "nextDialogs": [
              "740430315"
            ]
          },
          "740430315": {
            "id": "740430315",
            "speakerId": 21028,
            "speakerName": "\"Boss\"",
            "text": "Agh! Mercy, have mercy!",
            "nextDialogs": [
              "740430316"
            ]
          },
          "740430316": {
            "id": "740430316",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, these two are pretty skilled...",
            "nextDialogs": [
              "740430317"
            ]
          },
          "740430317": {
            "id": "740430317",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "Don't worry, Boss! There's no mortal danger here, I'm sure of it!",
            "nextDialogs": [
              "740430318"
            ]
          },
          "740430318": {
            "id": "740430318",
            "speakerId": 21091,
            "speakerName": "Hunter",
            "text": "Indeed, indeed. No one's in any danger at all.",
            "nextDialogs": [
              "740430319"
            ]
          },
          "740430319": {
            "id": "740430319",
            "speakerId": 21092,
            "speakerName": "Turner",
            "text": "For now, anyway.",
            "nextDialogs": [
              "740430320"
            ]
          },
          "740430320": {
            "id": "740430320",
            "speakerId": 21028,
            "speakerName": "\"Boss\"",
            "text": "F—For now...!?",
            "nextDialogs": [
              "740430321"
            ]
          },
          "740430321": {
            "id": "740430321",
            "speakerId": 21091,
            "speakerName": "Hunter",
            "text": "As for what comes next...",
            "nextDialogs": [
              "740430322"
            ]
          },
          "740430322": {
            "id": "740430322",
            "speakerId": 21092,
            "speakerName": "Turner",
            "text": "Whether you wind up as roast chicken or something else altogether... Well, that's all up to you... Boss.",
            "nextDialogs": [
              "740430323"
            ]
          },
          "740430323": {
            "id": "740430323",
            "speakerId": 21028,
            "speakerName": "\"Boss\"",
            "text": "Eek!",
            "nextDialogs": [
              "740430324"
            ]
          },
          "740430324": {
            "id": "740430324",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How did the two of you end up here?",
            "nextDialogs": [
              "740430325"
            ]
          },
          "740430325": {
            "id": "740430325",
            "speakerId": 21091,
            "speakerName": "Hunter",
            "text": "After we had the... honor of meeting you previously, we decided to tail Henri.",
            "nextDialogs": [
              "740430326"
            ]
          },
          "740430326": {
            "id": "740430326",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "Huh? Wait. Why me?",
            "nextDialogs": [
              "740430327"
            ]
          },
          "740430327": {
            "id": "740430327",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "Actually, why was I the target in the first place? I was just doing my job!",
            "nextDialogs": [
              "740430328"
            ]
          },
          "740430328": {
            "id": "740430328",
            "speakerId": 21092,
            "speakerName": "Turner",
            "text": "The machines you dismantled were devices used by the Fontaine Research Institute to monitor and optimize water quality.",
            "nextDialogs": [
              "740430329"
            ]
          },
          "740430329": {
            "id": "740430329",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "Huh? Weren't they meant to produce pollution?",
            "nextDialogs": [
              "740430330"
            ]
          },
          "740430330": {
            "id": "740430330",
            "speakerId": 21091,
            "speakerName": "Hunter",
            "text": "The cores you dismantled contained the most advanced central components and hydrological data in Fontaine. As such, we hoped to... acquaint ourselves with your trading partner.",
            "nextDialogs": [
              "740430331"
            ]
          },
          "740430331": {
            "id": "740430331",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "Eh? What? Why?",
            "nextDialogs": [
              "740430333"
            ]
          },
          "740430333": {
            "id": "740430333",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "No, no, you're my great benefactor! Why would I ever lie to you?",
            "nextDialogs": [
              "740430335"
            ]
          },
          "740430335": {
            "id": "740430335",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "You lied to me, Boss! Did you know you were making me destroy such important things!?",
            "nextDialogs": [
              "740430336"
            ]
          },
          "740430336": {
            "id": "740430336",
            "speakerId": 21028,
            "speakerName": "\"Boss\"",
            "text": "I—I didn't mean to! I'm only the lowest rung on the...",
            "nextDialogs": [
              "740430337"
            ]
          },
          "740430337": {
            "id": "740430337",
            "speakerId": 21092,
            "speakerName": "Turner",
            "text": "Hmm? What did I hear about you \"not meaning to\" do something? Could you say that again? I don't think I heard you clearly.",
            "nextDialogs": [
              "740430338"
            ]
          },
          "740430338": {
            "id": "740430338",
            "speakerId": 21028,
            "speakerName": "\"Boss\"",
            "text": "Eeeee!",
            "nextDialogs": [
              "740430339"
            ]
          },
          "740430339": {
            "id": "740430339",
            "speakerId": 21091,
            "speakerName": "Hunter",
            "text": "Oh dear, this Boss must be tired — he's even fallen asleep with his eyes open.",
            "nextDialogs": [
              "740430340"
            ]
          },
          "740430340": {
            "id": "740430340",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh, th—this wasn't our intention either...",
            "nextDialogs": [
              "740430341"
            ]
          },
          "740430341": {
            "id": "740430341",
            "speakerId": 21092,
            "speakerName": "Turner",
            "text": "Well, about that — we've decided not to pursue the matter.",
            "nextDialogs": [
              "740430342"
            ]
          },
          "740430342": {
            "id": "740430342",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really? Will things be okay like that?",
            "nextDialogs": [
              "740430343"
            ]
          },
          "740430343": {
            "id": "740430343",
            "speakerId": 21091,
            "speakerName": "Hunter",
            "text": "We just need the cores and the data within them to be whole — the machines themselves are ancillary.",
            "nextDialogs": [
              "740430344"
            ]
          },
          "740430344": {
            "id": "740430344",
            "speakerId": 21092,
            "speakerName": "Turner",
            "text": "The higher-ups say that it's fine — and that we shouldn't tangle with you regardless.",
            "nextDialogs": [
              "740430345"
            ]
          },
          "740430345": {
            "id": "740430345",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hmm? What's that about tangling with me?",
            "nextDialogs": [
              "740430346"
            ]
          },
          "740430346": {
            "id": "740430346",
            "speakerId": 21091,
            "speakerName": "Hunter",
            "text": "Oh, nothing, nothing.",
            "nextDialogs": [
              "740430347"
            ]
          },
          "740430347": {
            "id": "740430347",
            "speakerId": 21092,
            "speakerName": "Turner",
            "text": "I mean, would you look at that — it's us, out on a stroll!",
            "nextDialogs": [
              "740430348"
            ]
          },
          "740430348": {
            "id": "740430348",
            "speakerId": 21091,
            "speakerName": "Hunter",
            "text": "And fancy us meeting you here, huh? What lovely weather, and a lovely coincidence too!",
            "nextDialogs": [
              "740430349"
            ]
          },
          "740430349": {
            "id": "740430349",
            "speakerId": 21092,
            "speakerName": "Turner",
            "text": "Alas, all encounters must come to an end, and so too will ours. It's time to say goodbye, I fear.",
            "nextDialogs": [
              "740430350"
            ]
          },
          "740430350": {
            "id": "740430350",
            "speakerId": 21091,
            "speakerName": "Hunter",
            "text": "Just allow the beauty of such a meeting to linger in your heart, or perhaps...",
            "nextDialogs": [
              "740430351"
            ]
          },
          "740430351": {
            "id": "740430351",
            "speakerId": 21092,
            "speakerName": "Turner",
            "text": "Forget about it. Who knows? It might be better that way.",
            "nextDialogs": [
              "740430352"
            ]
          },
          "740430352": {
            "id": "740430352",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "Huh? ...So we're alright?",
            "nextDialogs": [
              "740430353"
            ]
          },
          "740430353": {
            "id": "740430353",
            "speakerId": 21091,
            "speakerName": "Hunter",
            "text": "Would you prefer things to be otherwise?",
            "nextDialogs": [
              "740430354"
            ]
          },
          "740430354": {
            "id": "740430354",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "Oh, Archons, no! We're alright. Of course we are!",
            "nextDialogs": [
              "740430355"
            ]
          },
          "740430355": {
            "id": "740430355",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "*sigh* I thought I'd met a good person with whom I could turn my life around through labor — alas, people of ill intent remain the dominant majority!",
            "nextDialogs": [
              "740430356"
            ]
          },
          "740430356": {
            "id": "740430356",
            "speakerId": 21092,
            "speakerName": "Turner",
            "text": "...Hey, Henri. Lend a hand, would you?",
            "nextDialogs": [
              "740430357"
            ]
          },
          "740430357": {
            "id": "740430357",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "Huh?",
            "nextDialogs": [
              "740430358"
            ]
          },
          "740430358": {
            "id": "740430358",
            "speakerId": 21091,
            "speakerName": "Hunter",
            "text": "I mean, it's a mighty shame, but this good-hearted Boss of yours seems to have lost his wits.",
            "nextDialogs": [
              "740430359"
            ]
          },
          "740430359": {
            "id": "740430359",
            "speakerId": 21092,
            "speakerName": "Turner",
            "text": "We're going to need someone...",
            "nextDialogs": [
              "740430360"
            ]
          },
          "740430360": {
            "id": "740430360",
            "speakerId": 21091,
            "speakerName": "Hunter",
            "text": "Hardworking...",
            "nextDialogs": [
              "740430361"
            ]
          },
          "740430361": {
            "id": "740430361",
            "speakerId": 21092,
            "speakerName": "Turner",
            "text": "Reliable...",
            "nextDialogs": [
              "740430362"
            ]
          },
          "740430362": {
            "id": "740430362",
            "speakerId": 21091,
            "speakerName": "Hunter",
            "text": "You know, a good friend who hopes to change his life through honest labor.",
            "nextDialogs": [
              "740430363"
            ]
          },
          "740430363": {
            "id": "740430363",
            "speakerId": 21092,
            "speakerName": "Turner",
            "text": "That's right — we need a good friend to help us take this nice man to our safehouse.",
            "nextDialogs": [
              "740430364"
            ]
          },
          "740430364": {
            "id": "740430364",
            "speakerId": 21091,
            "speakerName": "Hunter",
            "text": "There, we can... speak with him at our leisure.",
            "nextDialogs": [
              "740430365"
            ]
          },
          "740430365": {
            "id": "740430365",
            "speakerId": 21092,
            "speakerName": "Turner",
            "text": "Of course, we will... express our gratitude — in Mora.",
            "nextDialogs": [
              "740430366"
            ]
          },
          "740430366": {
            "id": "740430366",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "Oh... Sure! Count me in, then!",
            "nextDialogs": [
              "740430367"
            ]
          },
          "740430367": {
            "id": "740430367",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "Thank you, thank you both. And thank you too, um...",
            "nextDialogs": [
              "740430368"
            ]
          },
          "740430368": {
            "id": "740430368",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#{NICKNAME}. She's Paimon.",
            "nextDialogs": [
              "740430369"
            ]
          },
          "740430369": {
            "id": "740430369",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "#Thank you both, {NICKNAME}, Paimon. My life really did change after meeting the two of you, it seems!",
            "nextDialogs": [
              "740430370"
            ]
          },
          "740430370": {
            "id": "740430370",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No need to thank us! Just work hard, Henri — and don't get fooled again, alright?",
            "nextDialogs": [
              "740430371"
            ]
          },
          "740430371": {
            "id": "740430371",
            "speakerId": 5254,
            "speakerName": "Henri",
            "text": "Yes, I won't! I'm going to work hard and become a rich man — and then I'll have others working for me!",
            "nextDialogs": [
              "740430372"
            ]
          },
          "740430372": {
            "id": "740430372",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Hunter, Turner, and Henri dig the unconscious Fatuus out and take him away.",
            "nextDialogs": [
              "740430373"
            ]
          },
          "740430373": {
            "id": "740430373",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, Paimon sure hopes that Henri's life will turn around...",
            "nextDialogs": [
              "740430374"
            ]
          },
          "740430374": {
            "id": "740430374",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hang on a minute. What about the pay Henri was supposed to give us!?"
          }
        }
      }
    },
    {

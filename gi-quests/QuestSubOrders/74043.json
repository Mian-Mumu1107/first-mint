    },
    {
      "subId": "7404309",
      "subQuestName": "Talk to Henri",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7404302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740430201"
        ],
        "dialogs": {
          "740430201": {
            "id": "740430201",
            "speakerId": 21029,
            "speakerName": "Henri",
            "text": "What do I want? Labor rights! When do I want them? Now!",
            "nextDialogs": [
              "740430203",
              "740430205",
              "740430207"
            ]
          },
          "740430203": {
            "id": "740430203",
            "speakerId": 21029,
            "speakerName": "Henri",
            "text": "Hmm? Let me see!"
          },
          "740430205": {
            "id": "740430205",
            "speakerId": 21029,
            "speakerName": "Henri",
            "text": "We must rise where we fell, of course!"
          },
          "740430207": {
            "id": "740430207",
            "speakerId": 21029,
            "speakerName": "Henri",
            "text": "Ugh, what will I do with you, seriously? Now, someone has placed some strange machines of this sort above ground and underwater. They're very easy to identify as well — there'll be a strange light in their area.",
            "nextDialogs": [
              "740430208"
            ]
          },
          "740430208": {
            "id": "740430208",
            "speakerId": 21029,
            "speakerName": "Henri",
            "text": "Get rid of them and bring these specialized cores to me. I need <color=#00E1FFFF>7</color> in total. Thanks!"
          }
        }
      }
    }
  ]
}
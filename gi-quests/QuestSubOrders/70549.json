  "subQuests": [
    {
      "subId": "7054901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705490101"
        ],
        "dialogs": {
          "705490101": {
            "id": "705490101",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "Suspicion confirmed...",
            "nextDialogs": [
              "705490102"
            ]
          },
          "705490102": {
            "id": "705490102",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "While patrolling the area, I was sure I'd sensed a familiar presence, so I came over to take a look, and sure enough, here you are.",
            "nextDialogs": [
              "705490105"
            ]
          },
          "705490105": {
            "id": "705490105",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "If Miss Charlotte were to see you like this, I'm guessing she'd take a hundred pictures and write up a report...",
            "nextDialogs": [
              "705490106"
            ]
          },
          "705490106": {
            "id": "705490106",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "#\"Sword-Wielding {NICKNAME}'s Secret Side Hustle: Exclusive Cocktails From Teyvat's Explorer Extraordinaire\"...",
            "nextDialogs": [
              "705490107"
            ]
          },
          "705490107": {
            "id": "705490107",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "You'd make the front pages of every major newspaper, and there'd be crowds of Fontainian tourists flocking to your drinks stand, causing gridlock on the streets of Mondstadt."
          }
        }
      }
    },
    {
      "subId": "7054903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705490301"
        ],
        "dialogs": {
          "705490301": {
            "id": "705490301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright, this new creation is called... \"Leisuretime Lightning.\"",
            "nextDialogs": [
              "705490302"
            ]
          },
          "705490302": {
            "id": "705490302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A cocktail made exclusively for Champion Duelists — enjoy!",
            "nextDialogs": [
              "705490303"
            ]
          },
          "705490303": {
            "id": "705490303",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "Huh...",
            "nextDialogs": [
              "705490304"
            ]
          },
          "705490304": {
            "id": "705490304",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "Hmm? Mm... Have you added fruit wine? It tastes wonderful... This is ideal for me!",
            "nextDialogs": [
              "705490305"
            ]
          },
          "705490305": {
            "id": "705490305",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "There's a subtle saltiness that combines well with the tartness of the fruit and the sweetness of the caramel — each sip balances delicately on the edge of perfection.",
            "nextDialogs": [
              "705490306"
            ]
          },
          "705490306": {
            "id": "705490306",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "The color of the wine also fits well with the name, and the lightning imagery contrasts with the fiery nature of the Caramel Blaze...",
            "nextDialogs": [
              "705490307"
            ]
          },
          "705490307": {
            "id": "705490307",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "But where does the \"leisuretime\" part come in?",
            "nextDialogs": [
              "705490310"
            ]
          },
          "705490310": {
            "id": "705490310",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "I see... That certainly matches the impression this cocktail gives me.",
            "nextDialogs": [
              "705490311"
            ]
          },
          "705490311": {
            "id": "705490311",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "Its unique aroma and taste will hold a special place in my memories of Mondstadt."
          }
        }
      }
    },
    {
      "subId": "7054906",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705490201"
        ],
        "dialogs": {
          "705490201": {
            "id": "705490201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Your Caramel Blaze is ready. Try not to drink it all in one go...",
            "nextDialogs": [
              "705490202"
            ]
          },
          "705490202": {
            "id": "705490202",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "It sure lives up to its name. The color reminds me of a raging fire, while that aroma... really hits you head-on.",
            "nextDialogs": [
              "705490203"
            ]
          },
          "705490203": {
            "id": "705490203",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "Ahem... It's quite strong.",
            "nextDialogs": [
              "705490206"
            ]
          },
          "705490206": {
            "id": "705490206",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "I'm alright, I just need a little time to get used to it.",
            "nextDialogs": [
              "705490207"
            ]
          },
          "705490207": {
            "id": "705490207",
            "speakerId": 1000,
            "speakerName": "Clorinde",
            "text": "As I recall, the last time I drank alcohol was at a wine tasting event that Navia invited me to last year. I only had a small sip of Sassica Wine, and it was nowhere near as strong as this concoction of yours."
          }
        }
      }
    }
  ]
}
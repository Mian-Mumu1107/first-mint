{
  "lineCounts": {
    "???": 4,
    "Mona": 65,
    "Mr. Zhu": 11,
    "Paimon": 38,
    "Player": 39
  },
  "subQuests": [
    {
      "subId": "1050007",
      "subQuestName": "Leave Liyue Harbor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000701"
        ],
        "dialogs": {
          "105000701": {
            "id": "105000701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Found it! This must be the ring!",
            "nextDialogs": [
              "105000702"
            ]
          },
          "105000702": {
            "id": "105000702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's so pretty. Paimon's sure it's worth a ton of...",
            "nextDialogs": [
              "105000703"
            ]
          },
          "105000703": {
            "id": "105000703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Ah, Paimon wasn't having any bad thoughts! Let's bring the ring back to <color=#00E1FFFF>Mr. Zhu</color>!"
          }
        }
      }
    },
    {
      "subId": "1050001",
      "subQuestName": "Find out what the girl who stopped you wants",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000101"
        ],
        "dialogs": {
          "105000101": {
            "id": "105000101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "H—How do you know about that?",
            "nextDialogs": [
              "105000102"
            ]
          },
          "105000102": {
            "id": "105000102",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "How? Because I'm a master of true astrology.",
            "nextDialogs": [
              "105000103"
            ]
          },
          "105000103": {
            "id": "105000103",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "If you've no other questions, let's be off.",
            "nextDialogs": [
              "105000106"
            ]
          },
          "105000106": {
            "id": "105000106",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "*sigh* Fine, I'll exercise a little patience, and explain.",
            "nextDialogs": [
              "105000107"
            ]
          },
          "105000107": {
            "id": "105000107",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "I am Astrologist Mona Megistus. But considering that it is most rude to misremember names, I allow others to call me Mona.",
            "nextDialogs": [
              "105000108"
            ]
          },
          "105000108": {
            "id": "105000108",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "I am on a mission from my master to retrieve a certain box from Mondstadt.",
            "nextDialogs": [
              "105000109"
            ]
          },
          "105000109": {
            "id": "105000109",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "It was part of an agreement she made with a friend 50 years ago. But she isn't as spry as she used to be, so now it's up to me.",
            "nextDialogs": [
              "105000110"
            ]
          },
          "105000110": {
            "id": "105000110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Not sure what getting some box back has to do with us. Why do you need us to come along?",
            "nextDialogs": [
              "105000111"
            ]
          },
          "105000111": {
            "id": "105000111",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Well... that's because I would also like to take on the guardian of the box.",
            "nextDialogs": [
              "105000112"
            ]
          },
          "105000112": {
            "id": "105000112",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "My master and her friend contended in the mystic arts all their lives without a clear victor. If I triumph here, then I will show myself to be superior to my master!"
          }
        }
      }
    },
    {
      "subId": "1050002",
      "subQuestName": "Find out what the girl who stopped you wants",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1050003",
      "subQuestName": "Accompany Mona to say farewell to Mr. Zhu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000201"
        ],
        "dialogs": {
          "105000201": {
            "id": "105000201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(Well, it's no wonder that an inn set up here has no business...)",
            "nextDialogs": [
              "105000202"
            ]
          },
          "105000202": {
            "id": "105000202",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Mona, you've come at just the right time. Did you see a jade ring while you made your way here?",
            "nextDialogs": [
              "105000203"
            ]
          },
          "105000203": {
            "id": "105000203",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "A jade ring? Can't say I have.",
            "nextDialogs": [
              "105000204"
            ]
          },
          "105000204": {
            "id": "105000204",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Oh, that's not good... that ring was given to me by my mother. But while my back was turned, it was swallowed up by a slime!",
            "nextDialogs": [
              "105000205"
            ]
          },
          "105000205": {
            "id": "105000205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm? That should be no trouble with Mona here. She's really good at astrology...",
            "nextDialogs": [
              "105000206"
            ]
          },
          "105000206": {
            "id": "105000206",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Absolutely not. Astrology is meant to be used to gain insight into reality and observe destiny itself. It's certainly not for such mundane affairs.",
            "nextDialogs": [
              "105000207"
            ]
          },
          "105000207": {
            "id": "105000207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But didn't you say that the owner here's been good to you?",
            "nextDialogs": [
              "105000208"
            ]
          },
          "105000208": {
            "id": "105000208",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "This is a matter of pride and one's state of mind. If an astrologist thinks that their arts can solve all problems, they will be forsaken by the starry ether.",
            "nextDialogs": [
              "105000209"
            ]
          },
          "105000209": {
            "id": "105000209",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Their divinations will lose the power to guide, and will not be able to pierce the fog of the unknown before them. Principles are principles.",
            "nextDialogs": [
              "105000210"
            ]
          },
          "105000210": {
            "id": "105000210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Such a powerful ability, and you don't use it to earn a living? What a shame...",
            "nextDialogs": [
              "105000211"
            ]
          },
          "105000211": {
            "id": "105000211",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "*sigh* Well, I was going to put up twenty thousand Mora as compensation, if you were willing.",
            "nextDialogs": [
              "105000212"
            ]
          },
          "105000212": {
            "id": "105000212",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Twenty thousand...!",
            "nextDialogs": [
              "105000215"
            ]
          },
          "105000215": {
            "id": "105000215",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Oh, ahh, it's nothing! I... I was just thinking that the person who finds that ring must be lucky indeed, to be able to earn twenty thousand Mora just like that."
          }
        }
      }
    },
    {
      "subId": "1050004",
      "subQuestName": "Attract slimes and reclaim Mr. Zhu's lost ring",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000401"
        ],
        "dialogs": {
          "105000401": {
            "id": "105000401",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "There is a small inn near <color=#00E1FFFF>Mt. Tianheng</color> that never sees a lot of business, even though its food is always great value for the money."
          }
        }
      }
    },
    {
      "subId": "1050005",
      "subQuestName": "Defeat the slimes and search for the ring",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000501"
        ],
        "dialogs": {
          "105000501": {
            "id": "105000501",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Thank you all very much, that ring really is very important to me."
          }
        }
      }
    },
    {
      "subId": "1050008",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1050006",
      "subQuestName": "Give the ring back to Mr. Zhu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000301"
        ],
        "dialogs": {
          "105000301": {
            "id": "105000301",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "That's it, that's the one! I thought it was lost forever!",
            "nextDialogs": [
              "105000302"
            ]
          },
          "105000302": {
            "id": "105000302",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "You actually found it. Not bad.",
            "nextDialogs": [
              "105000303"
            ]
          },
          "105000303": {
            "id": "105000303",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Mr. Zhu, you must take care of such precious things a bit better. You might not be so fortunate next time.",
            "nextDialogs": [
              "105000304"
            ]
          },
          "105000304": {
            "id": "105000304",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "You're absolutely right. How would I have faced my family if I had lost the 253rd ring my mother gave me?",
            "nextDialogs": [
              "105000308"
            ]
          },
          "105000308": {
            "id": "105000308",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Ah, let me explain. My family owns three jade mines, and in order to ensure that I would be able to find myself a good wife, my mother had many jade accessories made as heirlooms.",
            "nextDialogs": [
              "105000309"
            ]
          },
          "105000309": {
            "id": "105000309",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "I think there might be over five hundred of them.",
            "nextDialogs": [
              "105000310"
            ]
          },
          "105000310": {
            "id": "105000310",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Then, why would you feel the need to set up an inn here?",
            "nextDialogs": [
              "105000311"
            ]
          },
          "105000311": {
            "id": "105000311",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Well, inheriting the family business too early unavoidably made things boring.",
            "nextDialogs": [
              "105000312"
            ]
          },
          "105000312": {
            "id": "105000312",
            "speakerId": 2430,
            "speakerName": "Mr. Zhu",
            "text": "Thank you, all the same. Here's the Mora, as agreed. Please take it.",
            "nextDialogs": [
              "105000313"
            ]
          },
          "105000313": {
            "id": "105000313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Then—",
            "nextDialogs": [
              "105000314"
            ]
          },
          "105000314": {
            "id": "105000314",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "—Then I'll take it gladly!"
          }
        }
      }
    },
    {
      "subId": "1050004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000402"
        ],
        "dialogs": {
          "105000402": {
            "id": "105000402",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "The owner has always been good to me, so I'd like to say a farewell before I set off.",
            "nextDialogs": [
              "105000403"
            ]
          },
          "105000403": {
            "id": "105000403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The Elemental Bait's really strong — it will attract all the slimes in the area.",
            "nextDialogs": [
              "105000404"
            ]
          },
          "105000404": {
            "id": "105000404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Even if they're just slimes, they can be dangerous together, so we'd best prepare ourselves."
          }
        }
      }
    },
    {
      "subId": "1050006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000601"
        ],
        "dialogs": {
          "105000601": {
            "id": "105000601",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "This is your first mission, so don't mess it up.",
            "nextDialogs": [
              "105000602"
            ]
          },
          "105000602": {
            "id": "105000602",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "But if the going gets too tough for you... Well, I shall lend a hand then."
          }
        }
      }
    },
    {
      "subId": "1050008",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000825"
        ],
        "dialogs": {
          "105000825": {
            "id": "105000825",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did you know? It's something that the Dawn Winery accidentally refined while making wine...",
            "nextDialogs": [
              "105000826"
            ]
          },
          "105000826": {
            "id": "105000826",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The formula is a secret, but it's really good at attracting slimes.",
            "nextDialogs": [
              "105000827"
            ]
          },
          "105000827": {
            "id": "105000827",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And... Hehe, Paimon actually kept a small amount!",
            "nextDialogs": [
              "105000829",
              "105000831"
            ]
          },
          "105000829": {
            "id": "105000829",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's the very best partner, right?",
            "nextDialogs": [
              "105000832"
            ]
          },
          "105000832": {
            "id": "105000832",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Seems like you already have a plan.",
            "nextDialogs": [
              "105000833"
            ]
          },
          "105000833": {
            "id": "105000833",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yup. We'll be back in a jiffy!"
          },
          "105000831": {
            "id": "105000831",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aw, don't sweat the small stuff."
          }
        }
      }
    },
    {
      "subId": "1050009",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000901"
        ],
        "dialogs": {
          "105000901": {
            "id": "105000901",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Does my ability to see through your secrets so easily not evoke any memories?",
            "nextDialogs": [
              "105000904"
            ]
          },
          "105000904": {
            "id": "105000904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, Paimon remembers! You're that astrologist!",
            "nextDialogs": [
              "105000905"
            ]
          },
          "105000905": {
            "id": "105000905",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "That's right. It is I, Astrologist Mona Megistus.",
            "nextDialogs": [
              "105000906"
            ]
          },
          "105000906": {
            "id": "105000906",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "This time, I would like you to come with me to Mondstadt to reclaim a box that belongs to my master.",
            "nextDialogs": [
              "105000907"
            ]
          },
          "105000907": {
            "id": "105000907",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "It was part of an agreement she made with a friend 50 years ago. But she isn't as spry as she used to be, so now it's up to me.",
            "nextDialogs": [
              "105000908"
            ]
          },
          "105000908": {
            "id": "105000908",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Not sure what getting some box back has to do with us. Why do you need us to come along?",
            "nextDialogs": [
              "105000909"
            ]
          },
          "105000909": {
            "id": "105000909",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Well... that's because I would also like to take on the guardian of the box.",
            "nextDialogs": [
              "105000910"
            ]
          },
          "105000910": {
            "id": "105000910",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "My master and her friend contended in the mystic arts all their lives without a clear victor. If I triumph here, then I will show myself to be superior to my master!"
          }
        }
      }
    }
  ]
}
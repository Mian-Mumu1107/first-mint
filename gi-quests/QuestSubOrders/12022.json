    {
      "subId": "1202210",
      "subQuestName": "Investigate Kokomi's secret base",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120221001"
        ],
        "dialogs": {
          "120221001": {
            "id": "120221001",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "Ahh... I don't even want to move right now.",
            "nextDialogs": [
              "120221002"
            ]
          },
          "120221002": {
            "id": "120221002",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "It'd be so nice if all my work could just do itself without me having to lift a finger..."
          }
        }
      }
    },
    {
      "subId": "1202217",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120220301"
        ],
        "dialogs": {
          "120220301": {
            "id": "120220301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hey, look, {NICKNAME}. Could this be the book she wanted?",
            "nextDialogs": [
              "120220302"
            ]
          },
          "120220302": {
            "id": "120220302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Swordfish captain came back today. Energy +4...\"",
            "nextDialogs": [
              "120220303"
            ]
          },
          "120220303": {
            "id": "120220303",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "Ah, that's... that's just, um...",
            "nextDialogs": [
              "120220306"
            ]
          },
          "120220306": {
            "id": "120220306",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "Give. It. Here.",
            "nextDialogs": [
              "120220307"
            ]
          },
          "120220307": {
            "id": "120220307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh-heh, guess that was the wrong one... Let's keep looking."
          }
        }
      }
    },
    {
      "subId": "1202211",
      "subQuestName": "Investigate Kokomi's secret base",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120221101"
        ],
        "dialogs": {
          "120221101": {
            "id": "120221101",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "I'm actually pretty social when I have the energy.",
            "nextDialogs": [
              "120221102"
            ]
          },
          "120221102": {
            "id": "120221102",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "Still, talking to people I don't know is really draining..."
          }
        }
      }
    },
    {
      "subId": "1202213",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120220601"
        ],
        "dialogs": {
          "120220601": {
            "id": "120220601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#It's gotta be this one, right, {NICKNAME}?",
            "nextDialogs": [
              "120220602"
            ]
          },
          "120220602": {
            "id": "120220602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look, there's even a bookmark. None of the other books have one, so she must have finished reading those already.",
            "nextDialogs": [
              "120220603"
            ]
          },
          "120220603": {
            "id": "120220603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whew, it's pretty dense. Paimon doesn't understand a thing...",
            "nextDialogs": [
              "120220604"
            ]
          },
          "120220604": {
            "id": "120220604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, let's take it over and read it to her!"
          }
        }
      }
    },
    {
      "subId": "1202207",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120220701"
        ],
        "dialogs": {
          "120220701": {
            "id": "120220701",
            "speakerId": 3142,
            "speakerName": "Shibata",
            "text": "Are you looking for Her Excellency?",
            "nextDialogs": [
              "120220702"
            ]
          },
          "120220702": {
            "id": "120220702",
            "speakerId": 3142,
            "speakerName": "Shibata",
            "text": "I'm afraid she isn't here at the moment. I don't know where she's gone.",
            "nextDialogs": [
              "120220703"
            ]
          },
          "120220703": {
            "id": "120220703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So strange... Guess we should just call it a rain check then?",
            "nextDialogs": [
              "120220704"
            ]
          },
          "120220704": {
            "id": "120220704",
            "speakerId": 3142,
            "speakerName": "Shibata",
            "text": "Not necessarily. If I recall correctly, Her Excellency has made special provisions for just such a scenario in her General Operational Directives.",
            "nextDialogs": [
              "120220705"
            ]
          },
          "120220705": {
            "id": "120220705",
            "speakerId": 3142,
            "speakerName": "Shibata",
            "text": "Let me see... Ah yes, No. 98. <color=#00E1FFFF> \"Should a visitor from afar come to see me, and should my whereabouts be unknown, direct them to proceed southward until they arrive at a tree with purple foliage.\"</color>",
            "nextDialogs": [
              "120220706"
            ]
          },
          "120220706": {
            "id": "120220706",
            "speakerId": 3142,
            "speakerName": "Shibata",
            "text": "The footnote stipulates that this only applies when Her Excellency has made no communication regarding her whereabouts before disappearing, and even then only when the visitor in question is of VIP status.",
            "nextDialogs": [
              "120220707"
            ]
          },
          "120220707": {
            "id": "120220707",
            "speakerId": 3142,
            "speakerName": "Shibata",
            "text": "As far as I'm concerned, you two tick all of the boxes. I keep this directive on me at all times — I'm sure this is the right course of action.",
            "nextDialogs": [
              "120220708"
            ]
          },
          "120220708": {
            "id": "120220708",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kokomi really does think of everything! Alright, let's find the place she wrote about and have a look."
          }
        }
      }
    },
    {
      "subId": "1202212",
      "subQuestName": "Read a book about military strategy to Kokomi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120220401"
        ],
        "dialogs": {
          "120220401": {
            "id": "120220401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kokomi, is this the book you wanted?",
            "nextDialogs": [
              "120220402"
            ]
          },
          "120220402": {
            "id": "120220402",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "Hmm, I'm not sure, actually... Could you read a bit out loud?",
            "nextDialogs": [
              "120220405"
            ]
          },
          "120220405": {
            "id": "120220405",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "*yawns* Yes, that's the one! Thank you.",
            "nextDialogs": [
              "120220406"
            ]
          },
          "120220406": {
            "id": "120220406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kokomi? Kokomi...",
            "nextDialogs": [
              "120220407"
            ]
          },
          "120220407": {
            "id": "120220407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Oh no, she's fallen asleep. What're we gonna do, {NICKNAME}?",
            "nextDialogs": [
              "120220408"
            ]
          },
          "120220408": {
            "id": "120220408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Tonight's the Victory Feast! Not to mention that the peace talks are just around the corner. She's got so much to do..."
          }
        }
      }
    },

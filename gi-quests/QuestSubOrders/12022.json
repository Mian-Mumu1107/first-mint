    {
      "subId": "1202217",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120221701"
        ],
        "dialogs": {
          "120221701": {
            "id": "120221701",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "...You saw it, didn't you?"
          }
        }
      }
    },
    {
      "subId": "1202299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120229901"
        ],
        "dialogs": {
          "120229901": {
            "id": "120229901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are you sure this is the right place? It feels like we keep heading deeper into the middle of nowhere...",
            "nextDialogs": [
              "120229902"
            ]
          },
          "120229902": {
            "id": "120229902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hey, doesn't that tree look like the one she described in the directive, {NICKNAME}?",
            "nextDialogs": [
              "120229903"
            ]
          },
          "120229903": {
            "id": "120229903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It looks like there's a way in over there... Let's take a look!"
          }
        }
      }
    }

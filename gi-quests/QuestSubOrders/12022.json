  "subQuests": [
    {
      "subId": "1202201",
      "subQuestName": "Wait till 10:00 – 12:00 the next day",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120220101"
        ],
        "dialogs": {
          "120220101": {
            "id": "120220101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Kokomi isn't here yet...",
            "nextDialogs": [
              "120220102"
            ]
          },
          "120220102": {
            "id": "120220102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's weird. She doesn't seem like the type to show up late to things... Eh, let's wait a while longer.",
            "nextDialogs": [
              "120220103"
            ]
          },
          "120220103": {
            "id": "120220103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How is she still not here? Do you think she could be in trouble?",
            "nextDialogs": [
              "120220104"
            ]
          },
          "120220104": {
            "id": "120220104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's go ask that soldier over there."
          }
        }
      }
    },

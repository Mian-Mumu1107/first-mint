    {
      "subId": "7082403",
      "subQuestName": "Clean all the stains",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708240301"
        ],
        "dialogs": {
          "708240301": {
            "id": "708240301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm an excellent sweeper.",
            "nextDialogs": [
              "708240302"
            ]
          },
          "708240302": {
            "id": "708240302",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Really? That's wonderful. Well, since you're willing, I'll gladly take you up on the offer.",
            "nextDialogs": [
              "708240303"
            ]
          },
          "708240303": {
            "id": "708240303",
            "speakerId": 1000,
            "speakerName": "Adelinde",

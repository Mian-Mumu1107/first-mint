          }
        }
      }
    },
    {
      "subId": "7082404",
      "subQuestName": "Talk to Adelinde",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708240401"
        ],
        "dialogs": {
          "708240401": {
            "id": "708240401",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Finished?",
            "nextDialogs": [
              "708240402"
            ]
          },
          "708240402": {
            "id": "708240402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "All done.",
            "nextDialogs": [
              "708240403"
            ]
          },
          "708240403": {
            "id": "708240403",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Wonderful, this was a huge help. I can't imagine how long this would have taken me by myself.",
            "nextDialogs": [
              "708240404"
            ]
          },
          "708240404": {
            "id": "708240404",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "And if I'd gotten the girls to do it... Who knows how many items they'd end up destroying in the process...",
            "nextDialogs": [
              "708240405"
            ]
          },
          "708240405": {
            "id": "708240405",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Thank you, please take these. I do apologize for troubling you, a visitor, with the work of a Winery maid.",
            "nextDialogs": [
              "708240406"
            ]
          },
          "708240406": {
            "id": "708240406",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Next time you visit, the Winery will be spotless."
          }
        }
      }
    },
    {
      "subId": "7082401",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708240101"
        ],
        "dialogs": {
          "708240101": {
            "id": "708240101",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Clean the place again, and I want it spotless this time! This is about making a good first impression!",
            "nextDialogs": [
              "708240102"
            ]
          },
          "708240102": {
            "id": "708240102",
            "speakerId": 1001,
            "speakerName": "Moco",
            "text": "Sorry, Ms. Adelinde!",
            "nextDialogs": [
              "708240103"
            ]
          },
          "708240103": {
            "id": "708240103",
            "speakerId": 1002,
            "speakerName": "Hillie",
            "text": "We'll be more careful this time, Ms. Adelinde!",
            "nextDialogs": [
              "708240104"
            ]
          },
          "708240104": {
            "id": "708240104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's up?",
            "nextDialogs": [
              "708240105"
            ]
          },
          "708240105": {
            "id": "708240105",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Ah, hello, Traveler. Welcome to the Dawn Winery. The storm may have passed, but here at the Winery we're still cleaning up the mess it made.",
            "nextDialogs": [
              "708240106"
            ]
          },
          "708240106": {
            "id": "708240106",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "I'm trying to organize the cleanup operation, but these girls, they—",
            "nextDialogs": [
              "708240107"
            ]
          },
          "708240107": {
            "id": "708240107",
            "speakerId": 1001,
            "speakerName": "Moco",
            "text": "Sorry, Ms. Adelinde!",
            "nextDialogs": [
              "708240108"
            ]
          },
          "708240108": {
            "id": "708240108",
            "speakerId": 1002,
            "speakerName": "Hillie",
            "text": "We'll be more careful this time, Ms. Adelinde!",
            "nextDialogs": [
              "708240109"
            ]
          },
          "708240109": {
            "id": "708240109",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Yes, you've said that already, thank you very much! Now, why don't you put your efforts into cleaning instead of standing here apologizing to me? Shoo!",
            "nextDialogs": [
              "708240110"
            ]
          },
          "708240110": {
            "id": "708240110",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "These kids... Ugh, they're so sloppy. I don't know how we'll ever get through it all at their rate of progress. And even after that, there's still the indoors that needs cleaning."
          }
        }
      }
    },
    {
      "subId": "7082406",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

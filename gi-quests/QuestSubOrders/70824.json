        ],
        "dialogs": {
          "708240601": {
            "id": "708240601",
            "speakerId": 1002,
            "speakerName": "Hillie",
            "text": "Ugh, the Winery is just too big. How are we supposed to clean the whole place?",
            "nextDialogs": [
              "708240602"
            ]
          },
          "708240602": {
            "id": "708240602",
            "speakerId": 1001,
            "speakerName": "Moco",
            "text": "After cleaning the outside, there's still the inside to do. Are we ever gonna get this place clean..."
          }
        }
      }
    },
    {
      "subId": "7082407",

{
  "lineCounts": {
    "???": 4,
    "Etsuko": 12,
    "Neko": 20,
    "Ooshima Junpei": 22,
    "Paimon": 8,
    "Player": 19,
    "Taisuke": 5
  },
  "subQuests": [
    {
      "subId": "7221201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722120101"
        ],
        "dialogs": {
          "722120101": {
            "id": "722120101",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Your timing is impeccable. I need your aid once more.",
            "nextDialogs": [
              "722120102"
            ]
          },
          "722120102": {
            "id": "722120102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Go on, shoot.",
            "nextDialogs": [
              "722120103"
            ]
          },
          "722120103": {
            "id": "722120103",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "I desire...",
            "nextDialogs": [
              "722120104"
            ]
          },
          "722120104": {
            "id": "722120104",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "That you place a tall, large stone shaped in my own image beside this shrine.",
            "nextDialogs": [
              "722120105"
            ]
          },
          "722120105": {
            "id": "722120105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Where are we supposed to find something like that...",
            "nextDialogs": [
              "722120106"
            ]
          },
          "722120106": {
            "id": "722120106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She means a statue, Paimon.",
            "nextDialogs": [
              "722120107"
            ]
          },
          "722120107": {
            "id": "722120107",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Whatever the case, I desire something similar to those fox stones on that island far, far away.",
            "nextDialogs": [
              "722120108"
            ]
          },
          "722120108": {
            "id": "722120108",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Hibiki used to say that there were lots of them on that island, and even asked if I would like one made in my image.",
            "nextDialogs": [
              "722120109"
            ]
          },
          "722120109": {
            "id": "722120109",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "I feel that if Hibiki wanted it, it must be good. As such, I ask you to have one such stone made.",
            "nextDialogs": [
              "722120111",
              "722120114"
            ]
          },
          "722120111": {
            "id": "722120111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmmm, what are we gonna do...",
            "nextDialogs": [
              "722120112"
            ]
          },
          "722120112": {
            "id": "722120112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Right, why don't we ask Taisuke? He likes cats a lot. He might even be willing to take up carving just to help Neko!"
          },
          "722120114": {
            "id": "722120114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's true! He's so fond of cats. Maybe he can help us!"
          }
        }
      }
    },
    {
      "subId": "7221202",
      "subQuestName": "Ask Etsuko and Taisuke some questions",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722120201"
        ],
        "dialogs": {
          "722120201": {
            "id": "722120201",
            "speakerId": 1002,
            "speakerName": "Taisuke",
            "text": "Ah, hello there. What are you busy with today?",
            "nextDialogs": [
              "722120202"
            ]
          },
          "722120202": {
            "id": "722120202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Helping Neko make a statue.",
            "nextDialogs": [
              "722120203"
            ]
          },
          "722120203": {
            "id": "722120203",
            "speakerId": 1002,
            "speakerName": "Taisuke",
            "text": "Uh... What? A statue, here? Really?",
            "nextDialogs": [
              "722120204"
            ]
          },
          "722120204": {
            "id": "722120204",
            "speakerId": 1002,
            "speakerName": "Taisuke",
            "text": "I—I'll pick up carving immediately!",
            "nextDialogs": [
              "722120205"
            ]
          },
          "722120205": {
            "id": "722120205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I doubt you'll make it in time...",
            "nextDialogs": [
              "722120206"
            ]
          },
          "722120206": {
            "id": "722120206",
            "speakerId": 1003,
            "speakerName": "Etsuko",
            "text": "Hmm, is this another one of Neko's requests?",
            "nextDialogs": [
              "722120207"
            ]
          },
          "722120207": {
            "id": "722120207",
            "speakerId": 1003,
            "speakerName": "Etsuko",
            "text": "You know what, I don't think it'll be that hard to find craftsmen looking for work, what with the issues we've been having in Tatarasuna.",
            "nextDialogs": [
              "722120208"
            ]
          },
          "722120208": {
            "id": "722120208",
            "speakerId": 1003,
            "speakerName": "Etsuko",
            "text": "The Guild's received quite a few commissions related to this, and I've heard that some people are still in Tatarasuna looking for work.",
            "nextDialogs": [
              "722120209"
            ]
          },
          "722120209": {
            "id": "722120209",
            "speakerId": 1003,
            "speakerName": "Etsuko",
            "text": "I encountered just such an encampment while on a commission.",
            "nextDialogs": [
              "722120210"
            ]
          },
          "722120210": {
            "id": "722120210",
            "speakerId": 1003,
            "speakerName": "Etsuko",
            "text": "So if you want, you can try your luck there.",
            "nextDialogs": [
              "722120214",
              "722120213"
            ]
          },
          "722120214": {
            "id": "722120214",
            "speakerId": 1003,
            "speakerName": "Etsuko",
            "text": "Heh, don't pay it any mind. It wasn't that hard.",
            "nextDialogs": [
              "722120215"
            ]
          },
          "722120215": {
            "id": "722120215",
            "speakerId": 1003,
            "speakerName": "Etsuko",
            "text": "And you know what? I'd like to see what might happen if that shrine really does thrive again...",
            "nextDialogs": [
              "722120216"
            ]
          },
          "722120216": {
            "id": "722120216",
            "speakerId": 1003,
            "speakerName": "Etsuko",
            "text": "Especially that \"Hibiki\" Neko keeps talking about. What sort of person could be so beloved by that cat?",
            "nextDialogs": [
              "722120217"
            ]
          },
          "722120217": {
            "id": "722120217",
            "speakerId": 1003,
            "speakerName": "Etsuko",
            "text": "Alright, don't worry, I'm just talking to myself. Go look for that artisan.",
            "nextDialogs": [
              "722120218"
            ]
          },
          "722120218": {
            "id": "722120218",
            "speakerId": 1003,
            "speakerName": "Etsuko",
            "text": "As for whether they know how to carve rock or not... Well, I guess that's up to luck, eh?",
            "nextDialogs": [
              "722120219"
            ]
          },
          "722120219": {
            "id": "722120219",
            "speakerId": 1002,
            "speakerName": "Taisuke",
            "text": "Come on, Miss Etsuko, you just want to help Lady Neko as well, don't you? Haha, you're such a—",
            "nextDialogs": [
              "722120220"
            ]
          },
          "722120220": {
            "id": "722120220",
            "speakerId": 1003,
            "speakerName": "Etsuko",
            "text": "Taisuke, is our survey plan ready yet?",
            "nextDialogs": [
              "722120221"
            ]
          },
          "722120221": {
            "id": "722120221",
            "speakerId": 1002,
            "speakerName": "Taisuke",
            "text": "Uh, I—I'm almost done. Sorry..."
          },
          "722120213": {
            "id": "722120213",
            "speakerId": 1003,
            "speakerName": "Etsuko",
            "text": "What, not used to me giving you information first?"
          }
        }
      }
    },
    {
      "subId": "7221203",
      "subQuestName": "Go to Tatarasuna to look for an artisan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722120301"
        ],
        "dialogs": {
          "722120301": {
            "id": "722120301",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "*sigh* When will I be able to find some work...",
            "nextDialogs": [
              "722120302"
            ]
          },
          "722120302": {
            "id": "722120302",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Are you looking for me? What is this about?",
            "nextDialogs": [
              "722120305"
            ]
          },
          "722120305": {
            "id": "722120305",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Eh? Well... Well then, that's great!",
            "nextDialogs": [
              "722120306"
            ]
          },
          "722120306": {
            "id": "722120306",
            "speakerId": 1004,
            "speakerName": "???",
            "text": "Wait, sorry, I forgot to introduce myself. I'm Ooshima Junpei, and I used to work at Tatarasuna.",
            "nextDialogs": [
              "722120307"
            ]
          },
          "722120307": {
            "id": "722120307",
            "speakerId": 1005,
            "speakerName": "Ooshima Junpei",
            "text": "After that accident, we were all evacuated.",
            "nextDialogs": [
              "722120308"
            ]
          },
          "722120308": {
            "id": "722120308",
            "speakerId": 1005,
            "speakerName": "Ooshima Junpei",
            "text": "But till now, I haven't received any notice that we might be returning to work, so I've been idle here this whole time.",
            "nextDialogs": [
              "722120309"
            ]
          },
          "722120309": {
            "id": "722120309",
            "speakerId": 1005,
            "speakerName": "Ooshima Junpei",
            "text": "So you're looking for someone who can do some stone carving, right? Well, that's not my specialty per se, but I do have some skill in it...",
            "nextDialogs": [
              "722120310"
            ]
          },
          "722120310": {
            "id": "722120310",
            "speakerId": 1005,
            "speakerName": "Ooshima Junpei",
            "text": "What sort of stone carving do you need made? Could you tell me?",
            "nextDialogs": [
              "722120311"
            ]
          },
          "722120311": {
            "id": "722120311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, here's the situation...",
            "nextDialogs": [
              "722120312"
            ]
          },
          "722120312": {
            "id": "722120312",
            "speakerId": 1005,
            "speakerName": "Ooshima Junpei",
            "text": "Uh... So, let me get this straight. A talking cat wants you to find a craftsman to make a carved statue of it?",
            "nextDialogs": [
              "722120313"
            ]
          },
          "722120313": {
            "id": "722120313",
            "speakerId": 1005,
            "speakerName": "Ooshima Junpei",
            "text": "It's not like I don't believe you or anything. It's just a bit... You know, outrageous...",
            "nextDialogs": [
              "722120314"
            ]
          },
          "722120314": {
            "id": "722120314",
            "speakerId": 1005,
            "speakerName": "Ooshima Junpei",
            "text": "And even if I agreed, how is that... that provisional head priestess supposed to pay me? I'm not going to work for free, no matter what anyone says.",
            "nextDialogs": [
              "722120315"
            ]
          },
          "722120315": {
            "id": "722120315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Relax, it'll be fine.",
            "nextDialogs": [
              "722120316"
            ]
          },
          "722120316": {
            "id": "722120316",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "(...Will it really, though...)",
            "nextDialogs": [
              "722120317"
            ]
          },
          "722120317": {
            "id": "722120317",
            "speakerId": 1005,
            "speakerName": "Ooshima Junpei",
            "text": "Will it? I... Hmm, it just feels like you're swindling me...",
            "nextDialogs": [
              "722120318"
            ]
          },
          "722120318": {
            "id": "722120318",
            "speakerId": 1005,
            "speakerName": "Ooshima Junpei",
            "text": "Still... You know what? Never mind. I'm a pair of idle hands anyway. Might as well go with you to have a look.",
            "nextDialogs": [
              "722120319"
            ]
          },
          "722120319": {
            "id": "722120319",
            "speakerId": 1005,
            "speakerName": "Ooshima Junpei",
            "text": "I really hope that I can get paid..."
          }
        }
      }
    },
    {
      "subId": "7221204",
      "subQuestName": "Talk to the artisan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7221205",
      "subQuestName": "Report back to Neko together with Ooshima Junpei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722120601"
        ],
        "dialogs": {
          "722120601": {
            "id": "722120601",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Still, I am curious. How will a thing as hard as stone take on my countenance?",
            "nextDialogs": [
              "722120602"
            ]
          },
          "722120602": {
            "id": "722120602",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Is that stone human very powerful? Can he use some magic?",
            "nextDialogs": [
              "722120604",
              "722120606"
            ]
          },
          "722120604": {
            "id": "722120604",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Ah, I understand. Lovely!"
          },
          "722120606": {
            "id": "722120606",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Ah, I understand. The meals you and Hibiki made were all good things. The stone that the stone human will make must then also be a good thing.",
            "nextDialogs": [
              "722120607"
            ]
          },
          "722120607": {
            "id": "722120607",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Humans can be quite skilled sometimes, it seems. You have my thanks."
          }
        }
      }
    },
    {
      "subId": "7221204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722120401"
        ],
        "dialogs": {
          "722120401": {
            "id": "722120401",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Ah, you have returned. This human must be the stone human, yes?",
            "nextDialogs": [
              "722120404"
            ]
          },
          "722120404": {
            "id": "722120404",
            "speakerId": 1005,
            "speakerName": "Ooshima Junpei",
            "text": "...What!? The cat... it really can talk!",
            "nextDialogs": [
              "722120405"
            ]
          },
          "722120405": {
            "id": "722120405",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Meow meow meow, such ado about nothing... Is it so strange that I speak?"
          }
        }
      }
    },
    {
      "subId": "7221205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722120501"
        ],
        "dialogs": {
          "722120501": {
            "id": "722120501",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "I will leave the matter of stone to you."
          }
        }
      }
    },
    {
      "subId": "7221299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722129901"
        ],
        "dialogs": {
          "722129901": {
            "id": "722129901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, look! That's the camp that Miss Etsuko told us about. There's someone in there, too!",
            "nextDialogs": [
              "722129902"
            ]
          },
          "722129902": {
            "id": "722129902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's go ask around. Maybe he knows a thing or two about carving stone..."
          }
        }
      }
    }
  ]
}
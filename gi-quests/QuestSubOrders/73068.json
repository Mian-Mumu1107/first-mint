  "subQuests": [
    {
      "subId": "7306801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730680101"
        ],
        "dialogs": {
          "730680101": {
            "id": "730680101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hello! The land here doesn't look like the other places. Is there some special purpose for it?",
            "nextDialogs": [
              "730680102"
            ]
          },
          "730680102": {
            "id": "730680102",
            "speakerId": 1001,
            "speakerName": "Arakara",
            "text": "...",
            "nextDialogs": [
              "730680103"
            ]
          },
          "730680103": {
            "id": "730680103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eh? Why isn't he responding? Did he not hear Paimon?",
            "nextDialogs": [
              "730680105",
              "730680107"
            ]
          },
          "730680105": {
            "id": "730680105",
            "speakerId": 1001,
            "speakerName": "Arakara",
            "text": "Guh... N—Nara?",
            "nextDialogs": [
              "730680108"
            ]
          },
          "730680108": {
            "id": "730680108",
            "speakerId": 1001,
            "speakerName": "Arakara",
            "text": "H—How? Why is there a Nara in Vanarana? Are they here to catch me and roast me? Arakara is not as tasty as mushrooms...",
            "nextDialogs": [
              "730680109"
            ]
          },
          "730680109": {
            "id": "730680109",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, who do you think we are to do such a horrible thing? We're known as \"Aranara's happy partners\"!"
          },
          "730680107": {
            "id": "730680107",
            "speakerId": 1001,
            "speakerName": "Arakara",
            "text": "Mushrooms are yummy! ...Nara? Yummy? No, Nara can't eat."
          }
        }
      }
    },
    {
      "subId": "7306802",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730680201"
        ],
        "dialogs": {
          "730680201": {
            "id": "730680201",
            "speakerId": 1001,
            "speakerName": "Arakara",
            "text": "#Nara {NICKNAME} and Paimon? Aranakula followed Arapandu to Ashavan Realm and still hasn't returned, so why don't we eat some mushrooms now."
          }
        }
      }
    },
    {
      "subId": "7306803",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730680301"
        ],
        "dialogs": {
          "730680301": {
            "id": "730680301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's Aranakula! He's returned to Vanarana.",
            "nextDialogs": [
              "730680302"
            ]
          },
          "730680302": {
            "id": "730680302",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "#Nara {NICKNAME}, and Paimon! The Varuna Contraption has been healed. Aranakula can now focus on the nursery.",
            "nextDialogs": [
              "730680303"
            ]
          },
          "730680303": {
            "id": "730680303",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "This is the nursery that Aranakula always talks about.",
            "nextDialogs": [
              "730680304"
            ]
          },
          "730680304": {
            "id": "730680304",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "Yes, it's the nursery that Aranakula and Arakara take care of together. The soil here was suitable for growing happy Viparyas.",
            "nextDialogs": [
              "730680305"
            ]
          },
          "730680305": {
            "id": "730680305",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Are there unhappy Viparyas?",
            "nextDialogs": [
              "730680306"
            ]
          },
          "730680306": {
            "id": "730680306",
            "speakerId": 1001,
            "speakerName": "Arakara",
            "text": "They are not unhappy, just not as happy.",
            "nextDialogs": [
              "730680307"
            ]
          },
          "730680307": {
            "id": "730680307",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...Huh?",
            "nextDialogs": [
              "730680308"
            ]
          },
          "730680308": {
            "id": "730680308",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "It's like having soil that's suitable for growth, and there is no lack of rain and sunlight, and no obstacles to growth... There seems nothing to be unhappy about, but also not anything to be very happy about.",
            "nextDialogs": [
              "730680309"
            ]
          },
          "730680309": {
            "id": "730680309",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hm... Feels plain and ordinary. Eh? So is this place different from the other places?",
            "nextDialogs": [
              "730680310"
            ]
          },
          "730680310": {
            "id": "730680310",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "The soil in Vanarana, all very good, but here is particularly good. And more importantly...",
            "nextDialogs": [
              "730680311"
            ]
          },
          "730680311": {
            "id": "730680311",
            "speakerId": 1001,
            "speakerName": "Arakara",
            "text": "Arakara and Aranakula will look after them.",
            "nextDialogs": [
              "730680312"
            ]
          },
          "730680312": {
            "id": "730680312",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Look after... in what way, specifically?",
            "nextDialogs": [
              "730680313"
            ]
          },
          "730680313": {
            "id": "730680313",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "Will play music to them.",
            "nextDialogs": [
              "730680314"
            ]
          },
          "730680314": {
            "id": "730680314",
            "speakerId": 1001,
            "speakerName": "Arakara",
            "text": "And compliment their beauty.",
            "nextDialogs": [
              "730680315"
            ]
          },
          "730680315": {
            "id": "730680315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is this the difference between wild and domesticated Viparyas...?",
            "nextDialogs": [
              "730680316"
            ]
          },
          "730680316": {
            "id": "730680316",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon can relate... It's hard not to be happy when there is pleasant music to listen to every day and to be praised daily for your beauty!",
            "nextDialogs": [
              "730680317"
            ]
          },
          "730680317": {
            "id": "730680317",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Right, just like Paimon. Before Paimon was fished out by {NICKNAME}, Paimon wasn't unhappy, but not that happy either...",
            "nextDialogs": [
              "730680318"
            ]
          },
          "730680318": {
            "id": "730680318",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#After Paimon started traveling with {NICKNAME}, we've met with many difficulties, but when Paimon is happy, Paimon sometimes feels extra happy!",
            "nextDialogs": [
              "730680319"
            ]
          },
          "730680319": {
            "id": "730680319",
            "speakerId": 1001,
            "speakerName": "Arakara",
            "text": "Paimon is quite right. Arakara is going to make beautiful lights with the happy Viparyas for Festival Utsava.",
            "nextDialogs": [
              "730680320"
            ]
          },
          "730680320": {
            "id": "730680320",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe, since Aranakula is also back, we should hurry and get started! The seeds of Viparyas... Do Viparyas have seeds too?",
            "nextDialogs": [
              "730680321"
            ]
          },
          "730680321": {
            "id": "730680321",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "Viparyas, is the earth's balderdash, is what the earth remembers in dreams.",
            "nextDialogs": [
              "730680322"
            ]
          },
          "730680322": {
            "id": "730680322",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That seed...",
            "nextDialogs": [
              "730680323"
            ]
          },
          "730680323": {
            "id": "730680323",
            "speakerId": 1001,
            "speakerName": "Arakara",
            "text": "Viparyas has no seeds.",
            "nextDialogs": [
              "730680324"
            ]
          },
          "730680324": {
            "id": "730680324",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? But how do you have a nursery without seeds... Ah! Could Aranakula have some Ararakalari that can grow Viparyas out of thin air?",
            "nextDialogs": [
              "730680325"
            ]
          },
          "730680325": {
            "id": "730680325",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "No, Paimon is wrong... To make the nursery grow Viparyas, Vasmrti is needed.",
            "nextDialogs": [
              "730680326"
            ]
          },
          "730680326": {
            "id": "730680326",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Vas... what now?",
            "nextDialogs": [
              "730680327"
            ]
          },
          "730680327": {
            "id": "730680327",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Vasmrti.",
            "nextDialogs": [
              "730680328"
            ]
          },
          "730680328": {
            "id": "730680328",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "Vanarana will remember everything, so, with Vasmrti, the earth will remember again in a dream.",
            "nextDialogs": [
              "730680329"
            ]
          },
          "730680329": {
            "id": "730680329",
            "speakerId": 1001,
            "speakerName": "Arakara",
            "text": "The nursery will also birth happy Viparyas.",
            "nextDialogs": [
              "730680330"
            ]
          },
          "730680330": {
            "id": "730680330",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Oh... Th—Then this Vasmrti can only be obtained by Aranara? So does that mean {NICKNAME} and Paimon have no chance to grow Viparyas in the nursery...",
            "nextDialogs": [
              "730680331"
            ]
          },
          "730680331": {
            "id": "730680331",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "#The Golden Nara helped Aranakula and other Aranara. The Golden Nara is Aranara friend, so Aranakula and Nara {NICKNAME} will cultivate Viparyas together.",
            "nextDialogs": [
              "730680332"
            ]
          },
          "730680332": {
            "id": "730680332",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "#Let Vasmrti sink into the soil, and Viparyas will be birthed. Nara {NICKNAME}, try it.",
            "nextDialogs": [
              "730680333"
            ]
          },
          "730680333": {
            "id": "730680333",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You follow what Aranakula said and let the Vasmrti sink into the soil.",
            "nextDialogs": [
              "730680334"
            ]
          },
          "730680334": {
            "id": "730680334",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That's it? It doesn't seem to be any different from growing other plants! Put the seed in the soil, then wait for the seed to grow...",
            "nextDialogs": [
              "730680335"
            ]
          },
          "730680335": {
            "id": "730680335",
            "speakerId": 1001,
            "speakerName": "Arakara",
            "text": "Vasmrti is not a seed. Just like Paimon is not a flying cat.",
            "nextDialogs": [
              "730680336"
            ]
          },
          "730680336": {
            "id": "730680336",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hm... O—Okay.",
            "nextDialogs": [
              "730680337"
            ]
          },
          "730680337": {
            "id": "730680337",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Speaking of which, the nursery still has a lot of space left. One, two, three... Whoa, there are twelve spots for growing Viparyas! Do you have more Vasmrti, Aranakula?",
            "nextDialogs": [
              "730680338"
            ]
          },
          "730680338": {
            "id": "730680338",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "Used to, but not anymore, need to collect again.",
            "nextDialogs": [
              "730680339"
            ]
          },
          "730680339": {
            "id": "730680339",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "Outside the dream world, there are 12 nurseries that condense Vasmrti. With them, the Vanarana nursery will be full of Viparyas.",
            "nextDialogs": [
              "730680340"
            ]
          },
          "730680340": {
            "id": "730680340",
            "speakerId": 1001,
            "speakerName": "Arakara",
            "text": "#Festival Utsava needs lots of Viparyas, and Vanarana has a lot of them. But if there are more happy Viparyas. Aranara will be happy. Nara {NICKNAME} and Paimon will be happy too.",
            "nextDialogs": [
              "730680341"
            ]
          },
          "730680341": {
            "id": "730680341",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "In that case, let's help collect Vasmrti! But how do we collect this thing? Arakara just said earlier that it's in the nursery outside of the dream world...",
            "nextDialogs": [
              "730680342"
            ]
          },
          "730680342": {
            "id": "730680342",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "Golden Nara, still need to traverse the land of the nursery. Once is okay. Too many times, no.",
            "nextDialogs": [
              "730680343"
            ]
          },
          "730680343": {
            "id": "730680343",
            "speakerId": 1002,
            "speakerName": "Aranakula",
            "text": "Only one trip is needed... And then, the nursery soil will bear Vasmrtis, like dew that gathers on the leaves in the sunrise after a night of rain.",
            "nextDialogs": [
              "730680344"
            ]
          },
          "730680344": {
            "id": "730680344",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh... Paimon doesn't get it at all!",
            "nextDialogs": [
              "730680345"
            ]
          },
          "730680345": {
            "id": "730680345",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But based on the experience of dealing with Aranara before... When we find the nursery outside the dream world, we should be able to know what Aranakula is saying.",
            "nextDialogs": [
              "730680346"
            ]
          },
          "730680346": {
            "id": "730680346",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, then we should look around when we find a nursery!"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "4007202",
      "subQuestName": "Look for the second volume of \"Hymn of the Holy Land\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400720201"
        ],
        "dialogs": {
          "400720201": {
            "id": "400720201",
            "speakerId": 1000,
            "speakerName": "Solemn Raven",
            "text": "Hey, stop! Who are you?",
            "nextDialogs": [
              "400720202"
            ]
          },
          "400720202": {
            "id": "400720202",
            "speakerId": 1001,
            "speakerName": "Severe Raven",
            "text": "You don't look like citizens of the Immernachtreich. Explain yourselves! What's your purpose here?",
            "nextDialogs": [
              "400720203"
            ]
          },
          "400720203": {
            "id": "400720203",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "This place even comes with guards!",
            "nextDialogs": [
              "400720204"
            ]
          },
          "400720204": {
            "id": "400720204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't panic.",
            "nextDialogs": [
              "400720205"
            ]
          },
          "400720205": {
            "id": "400720205",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Uh... What are you doing?",
            "nextDialogs": [
              "400720206"
            ]
          },
          "400720206": {
            "id": "400720206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We are personal retainers of the Prinzessin.",
            "nextDialogs": [
              "400720207"
            ]
          },
          "400720207": {
            "id": "400720207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We've traveled through the sea of stars to get here.",
            "nextDialogs": [
              "400720208"
            ]
          },
          "400720208": {
            "id": "400720208",
            "speakerId": 1000,
            "speakerName": "Solemn Raven",
            "text": "How can you prove that you are Her Highness's retainers?",
            "nextDialogs": [
              "400720209"
            ]
          },
          "400720209": {
            "id": "400720209",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Hmph, such an absurd question betrays your ignorance.",
            "nextDialogs": [
              "400720210"
            ]
          },
          "400720210": {
            "id": "400720210",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "\"May my people be freed from the shackles of ancient decrees.\"",
            "nextDialogs": [
              "400720211"
            ]
          },
          "400720211": {
            "id": "400720211",
            "speakerId": 1001,
            "speakerName": "Severe Raven",
            "text": "Th—That's the password of the Immernachtreich! They really are Her Highness's retainers!",
            "nextDialogs": [
              "400720212"
            ]
          },
          "400720212": {
            "id": "400720212",
            "speakerId": 1000,
            "speakerName": "Solemn Raven",
            "text": "Oh my goodness. We didn't know! Please forgive us...",
            "nextDialogs": [
              "400720213"
            ]
          },
          "400720213": {
            "id": "400720213",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Now step down!",
            "nextDialogs": [
              "400720214"
            ]
          },
          "400720214": {
            "id": "400720214",
            "speakerId": 1000,
            "speakerName": "Solemn Raven",
            "text": "Y—Yes, we're leaving now...",
            "nextDialogs": [
              "400720215"
            ]
          },
          "400720215": {
            "id": "400720215",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "They are gone.",
            "nextDialogs": [
              "400720216"
            ]
          },
          "400720216": {
            "id": "400720216",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "This is the second volume of \"Hymn of the Holy Land.\" Everyone ready?",
            "nextDialogs": [
              "400720217"
            ]
          },
          "400720217": {
            "id": "400720217",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Bring it on!"
          }
        }
      }
    },
    {
      "subId": "4007203",
      "subQuestName": "Open the second volume of \"Hymn of the Holy Land\"",
      "sceneId": null,
      "locations": [],

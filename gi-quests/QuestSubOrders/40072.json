    {
      "subId": "4007213",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400721301"
        ],
        "dialogs": {
          "400721301": {
            "id": "400721301",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "We're back again.",
            "nextDialogs": [
              "400721302"
            ]
          },
          "400721302": {
            "id": "400721302",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "I believe we have just witnessed the true nature of the wicked dragon.",
            "nextDialogs": [
              "400721303"
            ]
          },
          "400721303": {
            "id": "400721303",
            "speakerId": 1006,
            "speakerName": "Xinyan",
            "text": "*sigh* This is something I am all too familiar with. There are always people who believe that our passions are a waste of time.",
            "nextDialogs": [
              "400721304"
            ]
          },
          "400721304": {
            "id": "400721304",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Huh? You're—",
            "nextDialogs": [
              "400721305"
            ]
          },
          "400721305": {
            "id": "400721305",
            "speakerId": 1008,
            "speakerName": "Arnold",
            "text": "Ask-Me-For-Directions Arnold.",
            "nextDialogs": [
              "400721306"
            ]
          },
          "400721306": {
            "id": "400721306",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "I mean, you're back, why?",
            "nextDialogs": [
              "400721307"
            ]
          },
          "400721307": {
            "id": "400721307",
            "speakerId": 1008,
            "speakerName": "Arnold",
            "text": "Oh, I came because I bet you'd be looking for the third volume of \"Hymn of the Holy Land.\"",
            "nextDialogs": [
              "400721308"
            ]
          },
          "400721308": {
            "id": "400721308",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "Well, you bet right on that front...",
            "nextDialogs": [
              "400721309"
            ]
          },
          "400721309": {
            "id": "400721309",
            "speakerId": 1008,
            "speakerName": "Arnold",
            "text": "You need not do anything for me, my dear lady. The opportunity to behold your beauty is the finest reward I could ask for. I shall give you the answer you seek.",
            "nextDialogs": [
              "400721310"
            ]
          },
          "400721310": {
            "id": "400721310",
            "speakerId": 1008,
            "speakerName": "Arnold",
            "text": "The third volume of \"Hymn of the Holy Land\" can be found on the top floor of the royal castle.",
            "nextDialogs": [
              "400721311"
            ]
          },
          "400721311": {
            "id": "400721311",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "Is it guarded by anyone?",
            "nextDialogs": [
              "400721312"
            ]
          },
          "400721312": {
            "id": "400721312",
            "speakerId": 1008,
            "speakerName": "Arnold",
            "text": "Oh, oh, but of course, sir. What sort of a question is that? No nation would treat its most treasured books as if they were just cast out into the wilderness.",
            "nextDialogs": [
              "400721313"
            ]
          },
          "400721313": {
            "id": "400721313",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "That means we will still find Nachtraben guards stationed there.",
            "nextDialogs": [
              "400721314"
            ]
          },
          "400721314": {
            "id": "400721314",
            "speakerId": 1008,
            "speakerName": "Arnold",
            "text": "It is a citizen's utmost honor to guard the sacred scriptures. But it matters not. I'm quite sure the fine lady merely seeks to peruse them, and has no malicious intentions.",
            "nextDialogs": [
              "400721315"
            ]
          },
          "400721315": {
            "id": "400721315",
            "speakerId": 1008,
            "speakerName": "Arnold",
            "text": "Your face is captivating and full of wisdom, and the company you keep appears to be heroes of some renown. I have the utmost faith that you will be able to comprehend the meaning behind the stories in our sacred scriptures.",
            "nextDialogs": [
              "400721316"
            ]
          },
          "400721316": {
            "id": "400721316",
            "speakerId": 1008,
            "speakerName": "Arnold",
            "text": "Her Highness's accomplishments were documented by Oz, the Great Sekretär, and became great treasures of the Immernachtreich. I wish Her Highness joy and happiness every time I read those books."
          }
        }
      }
    },
    {
      "subId": "4007299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400729902"
        ],
        "dialogs": {
          "400729902": {
            "id": "400729902",
            "speakerId": 1005,
            "speakerName": "Narrator",
            "text": "\"The Prinzessin descended to confront the dragon, but the great battle was certain to damage the castle.\"",
            "nextDialogs": [
              "400729904"
            ]
          },
          "400729904": {
            "id": "400729904",
            "speakerId": 1007,
            "speakerName": "Leon",
            "text": "Help me! Somebody, please!",
            "nextDialogs": [
              "400729905"
            ]
          },
          "400729905": {
            "id": "400729905",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Aaaah, we've just got to the interesting part! What did the Prinzessin say!?",
            "nextDialogs": [
              "400729906"
            ]
          },
          "400729906": {
            "id": "400729906",
            "speakerId": 1006,
            "speakerName": "Xinyan",
            "text": "That voice sounds familiar. Is it that Nachtraben Ritter fella again?"
          }
        }
      }
    }
  ]
}
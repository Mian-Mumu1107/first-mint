    {
      "subId": "4007204",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400720401"
        ],
        "dialogs": {
          "400720401": {
            "id": "400720401",
            "speakerId": 1005,
            "speakerName": "Narrator",
            "text": "\"However, the Immernachtreich soon became plagued by a perpetual nightmare. Tasraque, the wicked dragon, infiltrated the subterranean, crossed the bottom of the sea, and eventually came to roam above the capital.\"",
            "nextDialogs": [
              "400720402"
            ]
          },
          "400720402": {
            "id": "400720402",
            "speakerId": 1006,
            "speakerName": "Xinyan",
            "text": "Huh? A dragon? The only thing I noticed is the gloomy weather.",
            "nextDialogs": [
              "400720403"
            ]
          },
          "400720403": {
            "id": "400720403",
            "speakerId": 1004,
            "speakerName": "Kaedehara Kazuha",
            "text": "Could the dragon be... some kind of metaphor?",
            "nextDialogs": [
              "400720404"
            ]
          },
          "400720404": {
            "id": "400720404",
            "speakerId": 1003,
            "speakerName": "Mona",
            "text": "If that's so... Her arch-nemesis, Tasraque, the wicked dragon, is made up of everything that opposes her and rejects her fantasies."
          }
        }
      }
    },

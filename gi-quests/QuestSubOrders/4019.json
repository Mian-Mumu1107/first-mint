  },
  "subQuests": [
    {
      "subId": "401901",
      "subQuestName": "Return to the prison to learn more about everyone's situation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40190101"
        ],
        "dialogs": {
          "40190101": {
            "id": "40190101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Sigewinne!",
            "nextDialogs": [
              "40190102"
            ]
          },
          "40190102": {
            "id": "40190102",
            "speakerId": 1001,
            "speakerName": "Sigewinne",
            "text": "#{NICKNAME}, Paimon, you're back!",
            "nextDialogs": [
              "40190103"
            ]
          },
          "40190103": {
            "id": "40190103",
            "speakerId": 1001,
            "speakerName": "Sigewinne",
            "text": "Are you still doing alright? Did either of you get hurt?",
            "nextDialogs": [
              "40190104"
            ]
          },
          "40190104": {
            "id": "40190104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry, we're both doing great.",
            "nextDialogs": [
              "40190105"
            ]
          },
          "40190105": {
            "id": "40190105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We're fine! But what about you guys? It was such a huge mess! How bad was it?",
            "nextDialogs": [
              "40190106"
            ]
          },
          "40190106": {
            "id": "40190106",
            "speakerId": 1001,
            "speakerName": "Sigewinne",
            "text": "A few people sustained superficial injuries, but that's about the extent of the damage. Monsieur Neuvillette paid us a visit. It was all thanks to him that we managed to suppress the crisis for the time being.",
            "nextDialogs": [
              "40190107"
            ]
          },
          "40190107": {
            "id": "40190107",
            "speakerId": 1001,
            "speakerName": "Sigewinne",
            "text": "Of course, we must also thank you for the help you provided.",
            "nextDialogs": [
              "40190108"
            ]
          },
          "40190108": {
            "id": "40190108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "How did Neuvillette know that he was needed here?",
            "nextDialogs": [
              "40190109"
            ]
          },
          "40190109": {
            "id": "40190109",
            "speakerId": 1001,
            "speakerName": "Sigewinne",
            "text": "Monsieur Neuvillette has strong resonance with the Hydro element. When the water level rises, he can feel the waves produced.",
            "nextDialogs": [
              "40190110"
            ]
          },
          "40190110": {
            "id": "40190110",
            "speakerId": 1001,
            "speakerName": "Sigewinne",
            "text": "I ran into the Bombshell Bros while bandaging the injuries of the wounded. They were mumbling the whole time about how you just ran down without a word... I'm so relieved to see that you're both alright.",
            "nextDialogs": [
              "40190111"
            ]
          },
          "40190111": {
            "id": "40190111",
            "speakerId": 1001,
            "speakerName": "Sigewinne",
            "text": "If you're not too pressed for time, please stay with us a few more days.",
            "nextDialogs": [
              "40190112"
            ]
          },
          "40190112": {
            "id": "40190112",
            "speakerId": 1001,
            "speakerName": "Sigewinne",
            "text": "Just let me know if you get a craving for any particular dish, so I can have Mr. Wolsey get your meals prepared. Oh, and please feel free to visit the infirmary for a break at any time.",
            "nextDialogs": [
              "40190113"
            ]
          },
          "40190113": {
            "id": "40190113",
            "speakerId": 1001,
            "speakerName": "Sigewinne",
            "text": "I'd like to take the opportunity to spend some more time observing your facial muscles as well. Your happy smiles are quite contagious, you know. They're so memorable, and I've missed them immensely while you were gone."
          }
        }
      }
    },
    {
      "subId": "401902",
      "subQuestName": "Return to the prison to learn more about everyone's situation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40190201"
        ],
        "dialogs": {
          "40190201": {
            "id": "40190201",
            "speakerId": 1002,
            "speakerName": "Lyney",
            "text": "Now guess! What suit will this next card be?",
            "nextDialogs": [
              "40190202"
            ]
          },
          "40190202": {
            "id": "40190202",
            "speakerId": 1003,
            "speakerName": "Freminet",
            "text": "Uhhh... A bared-teeth cat?",
            "nextDialogs": [
              "40190203"
            ]
          },
          "40190203": {
            "id": "40190203",
            "speakerId": 1004,
            "speakerName": "Lynette",
            "text": "Well, well, look who it is.",
            "nextDialogs": [
              "40190204"
            ]
          },
          "40190204": {
            "id": "40190204",
            "speakerId": 1002,
            "speakerName": "Lyney",
            "text": "#{NICKNAME}, Paimon!",
            "nextDialogs": [
              "40190205"
            ]
          },
          "40190205": {
            "id": "40190205",
            "speakerId": 1003,
            "speakerName": "Freminet",
            "text": "Hello everyone.",
            "nextDialogs": [
              "40190206"
            ]
          },
          "40190206": {
            "id": "40190206",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Looks like you're recovering nicely, Freminet!",
            "nextDialogs": [
              "40190207"
            ]
          },
          "40190207": {
            "id": "40190207",
            "speakerId": 1003,
            "speakerName": "Freminet",
            "text": "Mhm, thanks to everyone's support.",
            "nextDialogs": [
              "40190208"
            ]
          },
          "40190208": {
            "id": "40190208",
            "speakerId": 1003,
            "speakerName": "Freminet",
            "text": "Oh, right! I... I managed to work up the courage to thank Miss Clorinde in person!",
            "nextDialogs": [
              "40190209"
            ]
          },
          "40190209": {
            "id": "40190209",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa, how did she react?",
            "nextDialogs": [
              "40190210"
            ]
          },
          "40190210": {
            "id": "40190210",
            "speakerId": 1003,
            "speakerName": "Freminet",
            "text": "She told me that it was nothing... It was as if saving a life wasn't a big deal to her at all. She also told me to not worry about it.",
            "nextDialogs": [
              "40190211"
            ]
          },
          "40190211": {
            "id": "40190211",
            "speakerId": 1004,
            "speakerName": "Lynette",
            "text": "She didn't want to stress you out, that's all. She's right, and it's best not to dwell on it.",
            "nextDialogs": [
              "40190212"
            ]
          },
          "40190212": {
            "id": "40190212",
            "speakerId": 1003,
            "speakerName": "Freminet",
            "text": "Yeah...",
            "nextDialogs": [
              "40190213"
            ]
          },
          "40190213": {
            "id": "40190213",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Okay, but check this out! We went back to the opera house, and we met The Knave!",
            "nextDialogs": [
              "40190214"
            ]
          },
          "40190214": {
            "id": "40190214",
            "speakerId": 1002,
            "speakerName": "Lyney",
            "text": "You met \"Father\"? Did she say anything to you?",
            "nextDialogs": [
              "40190215"
            ]
          },
          "40190215": {
            "id": "40190215",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "She said a few things that were... uh, a bit hard to understand, and also that she's looking forward to working with us in the future.",
            "nextDialogs": [
              "40190216"
            ]
          },
          "40190216": {
            "id": "40190216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It was a little surprising.",
            "nextDialogs": [
              "40190217"
            ]
          },
          "40190217": {
            "id": "40190217",
            "speakerId": 1002,
            "speakerName": "Lyney",
            "text": "Her attitude towards you is even better than what we'd imagined... That's fantastic.",
            "nextDialogs": [
              "40190218"
            ]
          },
          "40190218": {
            "id": "40190218",
            "speakerId": 1002,
            "speakerName": "Lyney",
            "text": "You should believe her. She has her own way of doing things, and she'll do everything in her power to help those she considers close, which now might also include you.",
            "nextDialogs": [
              "40190219"
            ]
          },
          "40190219": {
            "id": "40190219",
            "speakerId": 1004,
            "speakerName": "Lynette",
            "text": "Mhm. \"Father\" is very capable, and also trustworthy.",
            "nextDialogs": [
              "40190220"
            ]
          },
          "40190220": {
            "id": "40190220",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, Paimon just remembered that she thought Lyney was a bit too proud as well! She said that you should learn how to rely on others sometimes.",
            "nextDialogs": [
              "40190221"
            ]
          },
          "40190221": {
            "id": "40190221",
            "speakerId": 1002,
            "speakerName": "Lyney",
            "text": "Uh... Got it.",
            "nextDialogs": [
              "40190222"
            ]
          },
          "40190222": {
            "id": "40190222",
            "speakerId": 1003,
            "speakerName": "Freminet",
            "text": "That does sound like something that \"Father\" would say...",
            "nextDialogs": [
              "40190223"
            ]
          },
          "40190223": {
            "id": "40190223",
            "speakerId": 1002,
            "speakerName": "Lyney",
            "text": "Hey!",
            "nextDialogs": [
              "40190224"
            ]
          },
          "40190224": {
            "id": "40190224",
            "speakerId": 1004,
            "speakerName": "Lynette",
            "text": "Are you going to stay here for the next few days?",
            "nextDialogs": [
              "40190225"
            ]
          },
          "40190225": {
            "id": "40190225",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Looks like it, yeah.",
            "nextDialogs": [
              "40190226"
            ]
          },
          "40190226": {
            "id": "40190226",
            "speakerId": 1004,
            "speakerName": "Lynette",
            "text": "Excellent. I will host a tea party.",
            "nextDialogs": [
              "40190227"
            ]
          },
          "40190227": {
            "id": "40190227",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "For real? Then Paimon wants another serving of cake!",
            "nextDialogs": [
              "40190228"
            ]
          },
          "40190228": {
            "id": "40190228",
            "speakerId": 1004,
            "speakerName": "Lynette",
            "text": "Another implies that you were already served some delicious cake while you were up there. Hmm, how lovely.",
            "nextDialogs": [
              "40190229"
            ]
          },
          "40190229": {
            "id": "40190229",
            "speakerId": 1004,
            "speakerName": "Lynette",
            "text": "Well next time, you're going to have tea and snacks with us."
          }
        }
      }
    },
    {
      "subId": "401904",
      "subQuestName": "Return to the prison to learn more about everyone's situation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40190401"
        ],
        "dialogs": {
          "40190401": {
            "id": "40190401",
            "speakerId": 1005,
            "speakerName": "Cuistot",
            "text": "Eh? You... You guys are back?",
            "nextDialogs": [
              "40190402"
            ]
          },
          "40190402": {
            "id": "40190402",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Cuistot! Laverune!",
            "nextDialogs": [
              "40190403"
            ]
          },
          "40190403": {
            "id": "40190403",
            "speakerId": 1006,
            "speakerName": "Laverune",
            "text": "You guys... didn't get caught and thrown back down here, right?",
            "nextDialogs": [
              "40190404"
            ]
          },
          "40190404": {
            "id": "40190404",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? No, not at all!",
            "nextDialogs": [
              "40190405"
            ]
          },
          "40190405": {
            "id": "40190405",
            "speakerId": 1005,
            "speakerName": "Cuistot",
            "text": "Ugh! And here I thought you'd managed to escape from jail during all the commotion. I had held you up as legendary jailbreakers, but now you're telling me... you just never left?",
            "nextDialogs": [
              "40190406"
            ]
          },
          "40190406": {
            "id": "40190406",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ahahaha... Uh, we're sorry, but we just... Had some business to take care of...",
            "nextDialogs": [
              "40190407"
            ]
          },
          "40190407": {
            "id": "40190407",
            "speakerId": 1006,
            "speakerName": "Laverune",
            "text": "Alright, alright, there's no need to get caught up in the details. We're just relieved to see you. He was super worried about you, you know.",
            "nextDialogs": [
              "40190408"
            ]
          },
          "40190408": {
            "id": "40190408",
            "speakerId": 1005,
            "speakerName": "Cuistot",
            "text": "Hey, it wasn't just me! Weren't you super worried as well?",
            "nextDialogs": [
              "40190409"
            ]
          },
          "40190409": {
            "id": "40190409",
            "speakerId": 1006,
            "speakerName": "Laverune",
            "text": "Something like that, yeah.",
            "nextDialogs": [
              "40190410"
            ]
          },
          "40190410": {
            "id": "40190410",
            "speakerId": 1006,
            "speakerName": "Laverune",
            "text": "I was also transferred to work in the kitchen a few days ago. I can still hear Cuistot mumbling to the carrots: \"Are those two alright? Do you think they made it out alive?\"",
            "nextDialogs": [
              "40190411"
            ]
          },
          "40190411": {
            "id": "40190411",
            "speakerId": 1006,
            "speakerName": "Laverune",
            "text": "Whenever he said that, I'd tell him, \"I'm sure they're fine! Wherever they are, they're kicking back with drinks in hand, enjoying the lovely scenery.\"",
            "nextDialogs": [
              "40190412"
            ]
          },
          "40190412": {
            "id": "40190412",
            "speakerId": 1005,
            "speakerName": "Cuistot",
            "text": "Hey! There's nothing wrong with worrying about your prison pals, is there? I mean, considering how they always loved listening to all of my gossip...",
            "nextDialogs": [
              "40190413"
            ]
          },
          "40190413": {
            "id": "40190413",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "These two... They sure are a lot warmer and friendlier than when Paimon first met them...",
            "nextDialogs": [
              "40190416"
            ]
          },
          "40190416": {
            "id": "40190416",
            "speakerId": 1005,
            "speakerName": "Cuistot",
            "text": "...Well, if you say so. I'll be watching you to make sure you finish every last bite!"
          }
        }
      }
    },
    {
      "subId": "401905",
      "subQuestName": "Return to the prison to learn more about everyone's situation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40190501"
        ],
        "dialogs": {
          "40190501": {
            "id": "40190501",
            "speakerId": 1007,
            "speakerName": "Lourvine",
            "text": "Jurieu! Miss Sigewinne told me you still haven't eaten.",
            "nextDialogs": [
              "40190502"
            ]
          },
          "40190502": {
            "id": "40190502",
            "speakerId": 1008,
            "speakerName": "Jurieu",
            "text": "Er, I was working on something, so I forgot.",
            "nextDialogs": [
              "40190503"
            ]
          },
          "40190503": {
            "id": "40190503",
            "speakerId": 1007,
            "speakerName": "Lourvine",
            "text": "That's no excuse for... Huh? It's you two!",
            "nextDialogs": [
              "40190504"
            ]
          },
          "40190504": {
            "id": "40190504",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Jurieu, Lourvine, we're back!",
            "nextDialogs": [
              "40190505"
            ]
          },
          "40190505": {
            "id": "40190505",
            "speakerId": 1008,
            "speakerName": "Jurieu",
            "text": "Hello there. It's been quite the mess here recently. How have you been?",
            "nextDialogs": [
              "40190506"
            ]
          },
          "40190506": {
            "id": "40190506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're fine, thanks.",
            "nextDialogs": [
              "40190507"
            ]
          },
          "40190507": {
            "id": "40190507",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And you? Are you still taking the secret passageway from the infirmary to work on the ship?",
            "nextDialogs": [
              "40190508"
            ]
          },
          "40190508": {
            "id": "40190508",
            "speakerId": 1007,
            "speakerName": "Lourvine",
            "text": "Yep. That is still top secret, though. So don't say a word to anyone!",
            "nextDialogs": [
              "40190509"
            ]
          },
          "40190509": {
            "id": "40190509",
            "speakerId": 1008,
            "speakerName": "Jurieu",
            "text": "It can be a bit annoying when there are lots of people in the infirmary, but I still prefer taking that route over the one from the Duke's office.",
            "nextDialogs": [
              "40190510"
            ]
          },
          "40190510": {
            "id": "40190510",
            "speakerId": 1007,
            "speakerName": "Lourvine",
            "text": "I mean, the infirmary does make it easier for you to slack off.",
            "nextDialogs": [
              "40190511"
            ]
          },
          "40190511": {
            "id": "40190511",
            "speakerId": 1008,
            "speakerName": "Jurieu",
            "text": "Oh yeah? Then why are you also here so much?",
            "nextDialogs": [
              "40190512"
            ]
          },
          "40190512": {
            "id": "40190512",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You two really are just using your jobs as a cover for your relationship, aren't you?",
            "nextDialogs": [
              "40190513"
            ]
          },
          "40190513": {
            "id": "40190513",
            "speakerId": 1009,
            "speakerName": "Together",
            "text": "Not at all!"
          }
        }
      }
    },
    {
      "subId": "401903",
      "subQuestName": "Talk to Wriothesley",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40190301"
        ],
        "dialogs": {
          "40190301": {
            "id": "40190301",
            "speakerId": 1010,
            "speakerName": "Wriothesley",
            "text": "Do my eyes deceive me or did I just see two inmates come back after making it to the surface? Some strange winds blowing of late.",
            "nextDialogs": [
              "40190302"
            ]
          },
          "40190302": {
            "id": "40190302",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We wanted to see how the Fortress is doing! Is everything still alright?",
            "nextDialogs": [
              "40190303"
            ]
          },
          "40190303": {
            "id": "40190303",
            "speakerId": 1010,
            "speakerName": "Wriothesley",
            "text": "We're fine for the most part. Neuvillette came down and took care of the worst of it.",
            "nextDialogs": [
              "40190304"
            ]
          },
          "40190304": {
            "id": "40190304",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "If that's the case, why don't you just ask him to stay here?",
            "nextDialogs": [
              "40190305"
            ]
          },
          "40190305": {
            "id": "40190305",
            "speakerId": 1010,
            "speakerName": "Wriothesley",
            "text": "Oh yeah, what a brilliant plan. Let's go convince the Iudex himself to exchange the courts of Fontaine for a puddle of water in the middle of nowhere.",
            "nextDialogs": [
              "40190306"
            ]
          },
          "40190306": {
            "id": "40190306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't think that's going to work...",
            "nextDialogs": [
              "40190307"
            ]
          },
          "40190307": {
            "id": "40190307",
            "speakerId": 1010,
            "speakerName": "Wriothesley",
            "text": "He came here in a hurry, and left without even stopping for a cup of tea. He did remember to take Miss Sigewinne's gift with him, though.",
            "nextDialogs": [
              "40190308"
            ]
          },
          "40190308": {
            "id": "40190308",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "He sure sounds super busy.",
            "nextDialogs": [
              "40190309"
            ]
          },
          "40190309": {
            "id": "40190309",
            "speakerId": 1010,
            "speakerName": "Wriothesley",
            "text": "Miss Clorinde has left as well. She also took her gift from Miss Sigewinne.",
            "nextDialogs": [
              "40190310"
            ]
          },
          "40190310": {
            "id": "40190310",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Were the gifts milkshakes?",
            "nextDialogs": [
              "40190311"
            ]
          },
          "40190311": {
            "id": "40190311",
            "speakerId": 1010,
            "speakerName": "Wriothesley",
            "text": "Neuvillette got the milkshake. Clorinde received lipstick instead.",
            "nextDialogs": [
              "40190312"
            ]
          },
          "40190312": {
            "id": "40190312",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Those aren't even remotely alike!",
            "nextDialogs": [
              "40190313"
            ]
          },
          "40190313": {
            "id": "40190313",
            "speakerId": 1010,
            "speakerName": "Wriothesley",
            "text": "Well, it's Neuvillette's own fault for making Sigewinne worried about his health by working so much. But besides that, our head nurse is still pretty fond of picking out beauty products for the ladies.",
            "nextDialogs": [
              "40190314"
            ]
          },
          "40190314": {
            "id": "40190314",
            "speakerId": 1010,
            "speakerName": "Wriothesley",
            "text": "Oh, and I have some gifts here for you as well.",
            "nextDialogs": [
              "40190315"
            ]
          },
          "40190315": {
            "id": "40190315",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Are these from Sigewinne, too?",
            "nextDialogs": [
              "40190316"
            ]
          },
          "40190316": {
            "id": "40190316",
            "speakerId": 1010,
            "speakerName": "Wriothesley",
            "text": "Nope, they are from yours truly.",
            "nextDialogs": [
              "40190317"
            ]
          },
          "40190317": {
            "id": "40190317",
            "speakerId": 1010,
            "speakerName": "Wriothesley",
            "text": "You've already wrapped up your work at the Fortress, so you can return to the surface at any time. You haven't yet served your full prison term, however, so you may continue to use your cell until your term is up.",
            "nextDialogs": [
              "40190318"
            ]
          },
          "40190318": {
            "id": "40190318",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "For real? Then we can stay here for a really long time!",
            "nextDialogs": [
              "40190319"
            ]
          },
          "40190319": {
            "id": "40190319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is food still covered?",
            "nextDialogs": [
              "40190320"
            ]
          },
          "40190320": {
            "id": "40190320",
            "speakerId": 1010,
            "speakerName": "Wriothesley",
            "text": "You may access the cafeteria for free.",
            "nextDialogs": [
              "40190321"
            ]
          },
          "40190321": {
            "id": "40190321",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hooray!",
            "nextDialogs": [
              "40190322"
            ]
          },
          "40190322": {
            "id": "40190322",
            "speakerId": 1010,
            "speakerName": "Wriothesley",
            "text": "Just remember to come complete your paperwork once it's time for your release."
          }
        }
      }
    },
    {
      "subId": "401906",
      "subQuestName": "Return to the dormitories to rest",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40190601"
        ],
        "dialogs": {
          "40190601": {
            "id": "40190601",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We're back in our cell again! We're no longer prisoners, though, so it really doesn't feel the same...",
            "nextDialogs": [
              "40190602"
            ]
          },
          "40190602": {
            "id": "40190602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It feels like a huge weight is off our shoulders.",
            "nextDialogs": [
              "40190603"
            ]
          },
          "40190603": {
            "id": "40190603",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Sure feels that way... But the truth is, we never did anything bad to begin with, so I'm not sure why we put so much pressure on ourselves.",
            "nextDialogs": [
              "40190604"
            ]
          },
          "40190604": {
            "id": "40190604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It feels like we've regained our freedom.",
            "nextDialogs": [
              "40190605"
            ]
          },
          "40190605": {
            "id": "40190605",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Mhm! Being free sure feels pretty special now.",
            "nextDialogs": [
              "40190606"
            ]
          },
          "40190606": {
            "id": "40190606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon, is there something you'd like to say?",
            "nextDialogs": [
              "40190607"
            ]
          },
          "40190607": {
            "id": "40190607",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? How did you know?",
            "nextDialogs": [
              "40190608"
            ]
          },
          "40190608": {
            "id": "40190608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Because you usually just immediately fall asleep.",
            "nextDialogs": [
              "40190609"
            ]
          },
          "40190609": {
            "id": "40190609",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, that's not true! Alright... Okay, Paimon just wanted to say that we really are an amazing duo after all!",
            "nextDialogs": [
              "40190610"
            ]
          },
          "40190610": {
            "id": "40190610",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's like... We've now gone to so many places together, and become friends with so many people. We've never stopped traveling, or stopped meeting new friends.",
            "nextDialogs": [
              "40190611"
            ]
          },
          "40190611": {
            "id": "40190611",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "There are so many bad things in the world, and we're just two people, but we've still been solving problems no matter where we go... Isn't that pretty cool?",
            "nextDialogs": [
              "40190612"
            ]
          },
          "40190612": {
            "id": "40190612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're the best adventurers ever.",
            "nextDialogs": [
              "40190613"
            ]
          },
          "40190613": {
            "id": "40190613",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You're counting Paimon today? Aren't you the only adventurer here?",
            "nextDialogs": [
              "40190614"
            ]
          },
          "40190614": {
            "id": "40190614",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Being a guide counts, too.",
            "nextDialogs": [
              "40190615"
            ]
          },
          "40190615": {
            "id": "40190615",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Then let's ask Katheryne to give Paimon an Adventurer Handbook as well! Paimon'll also be an adventurer from today forward!",
            "nextDialogs": [
              "40190616"
            ]
          },
          "40190616": {
            "id": "40190616",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ahh, just the thought's making Paimon giddy... Paimon's gonna crash, so you sleep soon, too!",
            "nextDialogs": [
              "40190617"
            ]
          },
          "40190617": {
            "id": "40190617",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "The last time we fell asleep here, we woke up to a whole mess outside our cell. The Primordial Seawater nearly rose up. That was so scary...",
            "nextDialogs": [
              "40190618"
            ]
          },
          "40190618": {
            "id": "40190618",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We should be safe now, right?",
            "nextDialogs": [
              "40190619"
            ]
          },
          "40190619": {
            "id": "40190619",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll be fine, so don't worry, Paimon.",
            "nextDialogs": [
              "40190620"
            ]
          },
          "40190620": {
            "id": "40190620",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Alright, then good night to you, {NICKNAME}!",
            "nextDialogs": [
              "40190621"
            ]
          },
          "40190621": {
            "id": "40190621",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Good night to you, Paimon."
          }
        }
      }
    },
    {
      "subId": "401921",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

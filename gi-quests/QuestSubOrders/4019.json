    {
      "subId": "401922",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40192201"
        ],
        "dialogs": {
          "40192201": {
            "id": "40192201",
            "speakerId": 1004,
            "speakerName": "Lynette",
            "text": "We should start preparing that tea party!",
            "nextDialogs": [
              "40192202"
            ]
          },
          "40192202": {
            "id": "40192202",
            "speakerId": 1002,
            "speakerName": "Lyney",
            "text": "Oh! That's a great idea. I'm all for it.",
            "nextDialogs": [
              "40192203"
            ]
          },
          "40192203": {
            "id": "40192203",
            "speakerId": 1003,
            "speakerName": "Freminet",
            "text": "I'll help you set it up."
          }
        }
      }
    },
    {
      "subId": "401923",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40192301"
        ],
        "dialogs": {
          "40192301": {
            "id": "40192301",
            "speakerId": 1010,
            "speakerName": "Wriothesley",
            "text": "Your file can't be closed until we've completed your paperwork, so don't forget to come find me again when you're done serving your sentence."
          }
        }
      }
    },
    {
      "subId": "401924",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40192401"
        ],
        "dialogs": {
          "40192401": {
            "id": "40192401",
            "speakerId": 1005,
            "speakerName": "Cuistot",
            "text": "Why don't we have a meal with those two one of these days?",
            "nextDialogs": [
              "40192402"
            ]
          },
          "40192402": {
            "id": "40192402",
            "speakerId": 1006,
            "speakerName": "Laverune",
            "text": "You wanna cook for 'em yourself?",
            "nextDialogs": [
              "40192403"
            ]
          },
          "40192403": {
            "id": "40192403",
            "speakerId": 1005,
            "speakerName": "Cuistot",
            "text": "Why not? Good chance to show them what I can do."
          }
        }
      }
    },
    {
      "subId": "401925",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40192501"
        ],
        "dialogs": {
          "40192501": {
            "id": "40192501",
            "speakerId": 1007,
            "speakerName": "Lourvine",
            "text": "Jurieu, the rumors about us are literally everywhere now. Please do something about it.",
            "nextDialogs": [
              "40192502"
            ]
          },
          "40192502": {
            "id": "40192502",
            "speakerId": 1008,
            "speakerName": "Jurieu",
            "text": "But it's not like I caused them by myself... Alright, alright, I'll try to do something about it when I can find the time."
          }
        }
      }
    }
  ]
}
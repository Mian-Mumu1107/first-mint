      }
    },
    {
      "subId": "2001904",
      "subQuestName": "Give the key to Wyatt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200190401"
        ],
        "dialogs": {
          "200190401": {
            "id": "200190401",
            "speakerId": 1000,
            "speakerName": "Wyatt",
            "text": "Found the key yet?",
            "nextDialogs": [
              "200190402"
            ]
          },
          "200190402": {
            "id": "200190402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I found this key — is it yours?",
            "nextDialogs": [
              "200190403"
            ]
          },
          "200190403": {
            "id": "200190403",
            "speakerId": 1000,
            "speakerName": "Wyatt",
            "text": "Yes! That's the one. I can't afford to let that happen again... I really must rein in my drinking.",
            "nextDialogs": [
              "200190404"
            ]
          },
          "200190404": {
            "id": "200190404",
            "speakerId": 1000,
            "speakerName": "Wyatt",
            "text": "Oh — and take these. Thanks for your help."
          }
        }
      }
    },
    {
      "subId": "2001902",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200190201"
        ],
        "dialogs": {
          "200190201": {
            "id": "200190201",
            "speakerId": 1000,
            "speakerName": "Wyatt",
            "text": "Have you found my key?",
            "nextDialogs": [
              "200190202"
            ]
          },
          "200190202": {
            "id": "200190202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm afraid not.",
            "nextDialogs": [
              "200190203"
            ]
          },
          "200190203": {
            "id": "200190203",
            "speakerId": 1000,
            "speakerName": "Wyatt",
            "text": "Well, it is quite a big search area... Good luck!"
          }
        }
      }
    }
  ]

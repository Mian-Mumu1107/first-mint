    {
      "subId": "7280099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728009901"
        ],
        "dialogs": {
          "728009901": {
            "id": "728009901",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Oh! I think this is it. I heard that there are many fresh ingredients here. Look carefully.",
            "nextDialogs": [
              "728009902"
            ]
          },
          "728009902": {
            "id": "728009902",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Why are we looking for ingredients in the forest here in Inazuma? I thought the specialty here is seafood...",
            "nextDialogs": [
              "728009903"
            ]
          },
          "728009903": {
            "id": "728009903",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I heard people in Inazuma cook with Sakura Blooms. That sounds delicious.",
            "nextDialogs": [
              "728009904"
            ]
          },
          "728009904": {
            "id": "728009904",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Shouldn't we go directly to the cherry trees...",
            "nextDialogs": [
              "728009905"
            ]
          },
          "728009905": {
            "id": "728009905",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Come on. Let's keep looking up ahead.",
            "nextDialogs": [
              "728009906"
            ]
          },
          "728009906": {
            "id": "728009906",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "Those monsters... Have all been knocked down.",
            "nextDialogs": [
              "728009907"
            ]
          },
          "728009907": {
            "id": "728009907",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Those monsters are all lying on the ground. It's quite an impressive sight... Let's go and have a look.",
            "nextDialogs": [
              "728009908"
            ]
          },
          "728009908": {
            "id": "728009908",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "There is nothing we can use here... The vegetables are all rotten.",
            "nextDialogs": [
              "728009909"
            ]
          },
          "728009909": {
            "id": "728009909",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Well, these fruits have not been stored properly. They're completely useless now.",
            "nextDialogs": [
              "728009910"
            ]
          },
          "728009910": {
            "id": "728009910",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "Well, there's some dried meat here. Can we cook with it?"
          }
        }
      }
    }
  ]
}
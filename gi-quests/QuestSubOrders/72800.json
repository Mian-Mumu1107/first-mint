  "subQuests": [
    {
      "subId": "7280001",
      "subQuestName": "Talk to Xudong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728000101"
        ],
        "dialogs": {
          "728000101": {
            "id": "728000101",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hey traveler! This way! I've been looking for you.",
            "nextDialogs": [
              "728000104"
            ]
          },
          "728000104": {
            "id": "728000104",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "We're the Gourmet Supremos. All-Star Gourmet!",
            "nextDialogs": [
              "728000105"
            ]
          },
          "728000105": {
            "id": "728000105",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "As I said, who would remember such a silly name...",
            "nextDialogs": [
              "728000106"
            ]
          },
          "728000106": {
            "id": "728000106",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "Really? I think it's quite memorable...",
            "nextDialogs": [
              "728000107"
            ]
          },
          "728000107": {
            "id": "728000107",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "That's just because Xudong talks about it every day.",
            "nextDialogs": [
              "728000108"
            ]
          },
          "728000108": {
            "id": "728000108",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hahaha, a good name is not easy to come by. Of course I have to keep repeating it.",
            "nextDialogs": [
              "728000109"
            ]
          },
          "728000109": {
            "id": "728000109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What other names did you have before?",
            "nextDialogs": [
              "728000110"
            ]
          },
          "728000110": {
            "id": "728000110",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "I came up with a lot of names, like \"pika pika rice team\" and \"Gulu Gulu dessert team\"!",
            "nextDialogs": [
              "728000111"
            ]
          },
          "728000111": {
            "id": "728000111",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "I really don't understand why you Mondstadters like to make these ridiculous names, sweetee floweree, Calla Lilyyy, Wolfhook fruitee...",
            "nextDialogs": [
              "728000112"
            ]
          },
          "728000112": {
            "id": "728000112",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "You can also call me Julie-Julie...",
            "nextDialogs": [
              "728000113"
            ]
          },
          "728000113": {
            "id": "728000113",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "...Julie, can you please act normal?",
            "nextDialogs": [
              "728000114"
            ]
          },
          "728000114": {
            "id": "728000114",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Because these kinds of names are memorable. See, you remember it right away.",
            "nextDialogs": [
              "728000115"
            ]
          },
          "728000115": {
            "id": "728000115",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Haha... So Liyue's Jueyun Chilili must've been named by a Mondstadter, right?",
            "nextDialogs": [
              "728000116"
            ]
          },
          "728000116": {
            "id": "728000116",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "No, that's totally different. This is simply to highlight the spiciness of the Jueyun Chilili. That's why we use the double \"li\". It makes perfect sense.",
            "nextDialogs": [
              "728000117"
            ]
          },
          "728000117": {
            "id": "728000117",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "That makes no sense! How does that highlight the spiciness of the Jueyun Chili?!",
            "nextDialogs": [
              "728000118"
            ]
          },
          "728000118": {
            "id": "728000118",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "Well... I think it sounds cute...",
            "nextDialogs": [
              "728000119"
            ]
          },
          "728000119": {
            "id": "728000119",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hahaha, anyway, if it's memorable, it is a good name.",
            "nextDialogs": [
              "728000120"
            ]
          },
          "728000120": {
            "id": "728000120",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "All right, let's not talk about that. Traveler, we'd like to ask you a favor.",
            "nextDialogs": [
              "728000121"
            ]
          },
          "728000121": {
            "id": "728000121",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "We want to cook something special with the local ingredients of Inazuma.",
            "nextDialogs": [
              "728000122"
            ]
          },
          "728000122": {
            "id": "728000122",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "In order to ensure the freshness of the food, we are going to collect the ingredients in the forest north of the city.",
            "nextDialogs": [
              "728000123"
            ]
          },
          "728000123": {
            "id": "728000123",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "But... I heard there are many monsters over there, so I'd like to invite you to come with us. Other than the reward, we'll take care of your meals. What do you say? Would you like to help?"
          }
        }
      }
    },
    {
      "subId": "7280002",
      "subQuestName": "Go to the designated location to find cooking ingredients",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728000201"
        ],
        "dialogs": {
          "728000201": {
            "id": "728000201",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "What can I do for you?",
            "nextDialogs": [
              "728000202"
            ]
          },
          "728000202": {
            "id": "728000202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Excuse me, you are...",
            "nextDialogs": [
              "728000203"
            ]
          },
          "728000203": {
            "id": "728000203",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I'm Kamei Munehisa, I am just passing by.",
            "nextDialogs": [
              "728000204"
            ]
          },
          "728000204": {
            "id": "728000204",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "Wow... This guy dresses like a samurai...",
            "nextDialogs": [
              "728000205"
            ]
          },
          "728000205": {
            "id": "728000205",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "S...samurai? Is he the samurai from the Shogunate... I heard that the Shogunate's attitude towards outlanders is quite... subtle...",
            "nextDialogs": [
              "728000206"
            ]
          },
          "728000206": {
            "id": "728000206",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "...",
            "nextDialogs": [
              "728000207"
            ]
          },
          "728000207": {
            "id": "728000207",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Don't worry. I've left the Shogunate. I'm no longer a samurai.",
            "nextDialogs": [
              "728000208"
            ]
          },
          "728000208": {
            "id": "728000208",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I often come here to look for food. But today, I noticed monsters wandering around.",
            "nextDialogs": [
              "728000209"
            ]
          },
          "728000209": {
            "id": "728000209",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "They've taken all the food around here. So I had to destroy them.",
            "nextDialogs": [
              "728000211",
              "728000213",
              "728000215"
            ]
          },
          "728000211": {
            "id": "728000211",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "There are not many monsters around here usually. I often come here to pick fruits or hunt.",
            "nextDialogs": [
              "728000217"
            ]
          },
          "728000217": {
            "id": "728000217",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Well, that's all I have to say. After killing these monsters, the other ones around here won't dare to come here for a while.",
            "nextDialogs": [
              "728000218"
            ]
          },
          "728000218": {
            "id": "728000218",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "If you are also looking for food, you can look around. I only took what I need. There should be something left.",
            "nextDialogs": [
              "728000219"
            ]
          },
          "728000219": {
            "id": "728000219",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Well, goodbye.",
            "nextDialogs": [
              "728000220"
            ]
          },
          "728000220": {
            "id": "728000220",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "Did he just leave just like that? His behavior is exactly like the samurai I heard about before...",
            "nextDialogs": [
              "728000221"
            ]
          },
          "728000221": {
            "id": "728000221",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "But what does he mean he's left the Shogunate? Samurai who have left the Shogunate are..."
          },
          "728000213": {
            "id": "728000213",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Yes, they are just ordinary monsters. They're easy to deal with."
          },
          "728000215": {
            "id": "728000215",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "...",
            "nextDialogs": [
              "728000216"
            ]
          },
          "728000216": {
            "id": "728000216",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I have my own reasons."
          }
        }
      }
    },
    {
      "subId": "7280003",
      "subQuestName": "Explore further and find cooking ingredients",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728000301"
        ],
        "dialogs": {
          "728000301": {
            "id": "728000301",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I was going to look for some fresh ingredients... Anyway, these will do.",
            "nextDialogs": [
              "728000302"
            ]
          },
          "728000302": {
            "id": "728000302",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I'm sorry. I wanted to cook something nice for you, but now I guess we'll have to make do with these.",
            "nextDialogs": [
              "728000304",
              "728000307"
            ]
          },
          "728000304": {
            "id": "728000304",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "You worked hard escorting us. \"It's fine\" is not an acceptable answer.",
            "nextDialogs": [
              "728000305"
            ]
          },
          "728000305": {
            "id": "728000305",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I'll remember this and treat you to a nice meal next time.",
            "nextDialogs": [
              "728000308"
            ]
          },
          "728000308": {
            "id": "728000308",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Julie, is the soup ready? Remember not to let Parvaneh...",
            "nextDialogs": [
              "728000309"
            ]
          },
          "728000309": {
            "id": "728000309",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "No, no, just let the soup simmer quietly!",
            "nextDialogs": [
              "728000310"
            ]
          },
          "728000310": {
            "id": "728000310",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "It's fine. I'm seasoning this soup according to my improved recipe. I'm just adding a little bit of seasoning...",
            "nextDialogs": [
              "728000311"
            ]
          },
          "728000311": {
            "id": "728000311",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "I don't understand your improved recipe. Stop it! Xudong, Xudong, come over here!",
            "nextDialogs": [
              "728000312"
            ]
          },
          "728000312": {
            "id": "728000312",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Parvaneh! Hey! What kind of strange seasoning are you putting in!?",
            "nextDialogs": [
              "728000313"
            ]
          },
          "728000313": {
            "id": "728000313",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Strange seasoning? This is my special sauce! This is the result of my thesis research!",
            "nextDialogs": [
              "728000314"
            ]
          },
          "728000314": {
            "id": "728000314",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I don't need that! Let's just eat something ordinary today! Julie, stop her!",
            "nextDialogs": [
              "728000315"
            ]
          },
          "728000315": {
            "id": "728000315",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Humph, what do you know... Fine, let me fine-tune this. I am going to make the ultimate seasoning that will make any dish delicious.",
            "nextDialogs": [
              "728000316"
            ]
          },
          "728000316": {
            "id": "728000316",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Ultimate seasoning... Is something like that really possible?",
            "nextDialogs": [
              "728000317"
            ]
          },
          "728000317": {
            "id": "728000317",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "No one has ever done it, that's why I am going to! I'll show those stuck-up unbelievers at the Akademiya!",
            "nextDialogs": [
              "728000318"
            ]
          },
          "728000318": {
            "id": "728000318",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Haha... Well, I look forward to it.",
            "nextDialogs": [
              "728000319"
            ]
          },
          "728000319": {
            "id": "728000319",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "By the way, traveler, thank you for spending all this time running around with us. Thank you.",
            "nextDialogs": [
              "728000320"
            ]
          },
          "728000320": {
            "id": "728000320",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I'll prepare a takeaway for you. You've got to have enough food when you are adventuring out there.",
            "nextDialogs": [
              "728000321"
            ]
          },
          "728000321": {
            "id": "728000321",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Next time we meet, I will treat you to a nice meal."
          },
          "728000307": {
            "id": "728000307",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hahaha, okay. I'll make a note of this. I'll make sure to treat you to something nice next time..."
          }
        }
      }
    },

    {
      "subId": "7100607",
      "subQuestName": "Look for another strange rock",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710060701"
        ],
        "dialogs": {
          "710060701": {
            "id": "710060701",
            "speakerId": 2409,
            "speakerName": "Vermeer",
            "text": "How will I find that one perfect view...",
            "nextDialogs": [
              "710060702"
            ]
          },
          "710060702": {
            "id": "710060702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Regarding that rock...",
            "nextDialogs": [
              "710060703"
            ]
          },
          "710060703": {
            "id": "710060703",
            "speakerId": 2409,
            "speakerName": "Vermeer",
            "text": "About the rock? Why are you suddenly interested in that?",
            "nextDialogs": [
              "710060704"
            ]
          },
          "710060704": {
            "id": "710060704",
            "speakerId": 2409,
            "speakerName": "Vermeer",
            "text": "I picked it up while looking for a good view at <color=#00E1FFFF>Luhua Pool</color>.",
            "nextDialogs": [
              "710060705"
            ]
          },
          "710060705": {
            "id": "710060705",
            "speakerId": 2409,
            "speakerName": "Vermeer",
            "text": "Do you want to go to <color=#00E1FFFF>Luhua Pool</color> to have a look?",
            "nextDialogs": [
              "710060706"
            ]
          },
          "710060706": {
            "id": "710060706",
            "speakerId": 2409,
            "speakerName": "Vermeer",
            "text": "You'll have to keep a close eye out. There're all sorts of things in that pool, and I have no idea who threw it in there..."
          }
        }
      }
    },
    {
      "subId": "7100609",
      "subQuestName": "Unravel the secret behind Luhua Pool",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710060901"
        ],
        "dialogs": {
          "710060901": {
            "id": "710060901",
            "speakerId": 2409,
            "speakerName": "Vermeer",
            "text": "I should bring more materials to paint with next time...",
            "nextDialogs": [
              "710060902"
            ]
          },
          "710060902": {
            "id": "710060902",
            "speakerId": 2409,
            "speakerName": "Vermeer",
            "text": "Or maybe I should keep a memo of the things I lose instead..."
          }
        }
      }
    },
    {
      "subId": "7100610",
      "subQuestName": "Unravel the secret behind Luhua Pool",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710061001"
        ],
        "dialogs": {
          "710061001": {
            "id": "710061001",
            "speakerId": 2409,
            "speakerName": "Vermeer",
            "text": "Oh... So that's how it is! These two rocks really are the eyes of the two statues. Their eyes will only shine once you've slotted those stones in...",
            "nextDialogs": [
              "710061002"
            ]
          },
          "710061002": {
            "id": "710061002",
            "speakerId": 2409,
            "speakerName": "Vermeer",
            "text": "Looks like I'll be able to paint something great after all! I'm off to find a good angle! Thank you so much!",
            "nextDialogs": [
              "710061003"
            ]
          },
          "710061003": {
            "id": "710061003",
            "speakerId": 2409,
            "speakerName": "Vermeer",
            "text": "Wonderful, absolutely wonderful..."
          }
        }
      }
    },

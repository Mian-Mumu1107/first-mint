  "subQuests": [
    {
      "subId": "7100608",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710060801"
        ],
        "dialogs": {
          "710060801": {
            "id": "710060801",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "This isn't right... This can't be right. Those statues' eyes don't light up...",
            "nextDialogs": [
              "710060802"
            ]
          },
          "710060802": {
            "id": "710060802",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "Is my viewfinding technique wrong somehow? No, that can't be it...",
            "nextDialogs": [
              "710060803"
            ]
          },
          "710060803": {
            "id": "710060803",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "Eyes... What eyes? This statue doesn't have any at all."
          }
        }
      }
    },
    {
      "subId": "7100601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710060101"
        ],
        "dialogs": {
          "710060101": {
            "id": "710060101",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "Oh, this is terrible. How will I paint like this...?",
            "nextDialogs": [
              "710060102"
            ]
          },
          "710060102": {
            "id": "710060102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "710060103"
            ]
          },
          "710060103": {
            "id": "710060103",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "You... Oh, it's you, Traveler. Well, here's the problem: I've been looking for inspiration around the Luhua Pool, and I wanted to paint a few pictures to bring back with me.",
            "nextDialogs": [
              "710060104"
            ]
          },
          "710060104": {
            "id": "710060104",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "But I haven't been able to find a good angle, and so none of my paintings have been to my satisfaction.",
            "nextDialogs": [
              "710060105"
            ]
          },
          "710060105": {
            "id": "710060105",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "I was so focused on taking the scenery in that I only realized that most of my paintbrushes and paints had gone missing when I arrived here.",
            "nextDialogs": [
              "710060106"
            ]
          },
          "710060106": {
            "id": "710060106",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "I must have left them in the previous posts where I'd painted pictures. Could you help me look for them?",
            "nextDialogs": [
              "710060108",
              "710060111"
            ]
          },
          "710060108": {
            "id": "710060108",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "Uh, actually... I don't quite remember myself. I was too engrossed in my painting each time to pay my surroundings much mind, so I can't give you very specific locations...",
            "nextDialogs": [
              "710060109"
            ]
          },
          "710060109": {
            "id": "710060109",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "But I've only drawn two pictures in this area, so it can only be in those two places.",
            "nextDialogs": [
              "710060113"
            ]
          },
          "710060113": {
            "id": "710060113",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "I'll give you these two paintings. I'm sure that I must have left my painting tools in the areas I was <color=#00E1FFFF>using as a reference</color> for those paintings.",
            "nextDialogs": [
              "710060114"
            ]
          },
          "710060114": {
            "id": "710060114",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "Once you've found them, please bring them back to me. I'll keep looking around here... I'm sure there's a better angle to take."
          },
          "710060111": {
            "id": "710060111",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "I was too engrossed in my surroundings each time to pay attention to my surroundings, so I can't remember any specifics...",
            "nextDialogs": [
              "710060112"
            ]
          },
          "710060112": {
            "id": "710060112",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "But I've only painted two pictures in this area, so it can only be in those two places."
          }
        }
      }
    },
    {
      "subId": "7100602",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710060201"
        ],
        "dialogs": {
          "710060201": {
            "id": "710060201",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "Have you found my painting tools?",
            "nextDialogs": [
              "710060202"
            ]
          },
          "710060202": {
            "id": "710060202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Found them.",
            "nextDialogs": [
              "710060203"
            ]
          },
          "710060203": {
            "id": "710060203",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "Just as I thought, I left them in the place I was taking references from. I tend to put the things I've used on the ground while I paint out of habit.",
            "nextDialogs": [
              "710060204"
            ]
          },
          "710060204": {
            "id": "710060204",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "When I'm in too much of a rush, I tend to leave a lot of things behind. Thank you so much. If not for you, I'd have to go back into the city to buy more.",
            "nextDialogs": [
              "710060205"
            ]
          },
          "710060205": {
            "id": "710060205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're going to continue painting here?",
            "nextDialogs": [
              "710060206"
            ]
          },
          "710060206": {
            "id": "710060206",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "Don't even mention it. I'd heard people say that these two statues have eyes that could light up, and that you could see that from afar.",
            "nextDialogs": [
              "710060207"
            ]
          },
          "710060207": {
            "id": "710060207",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "Giant statues with blazing eyes, standing guard next to a mountain... It would surely have made an excellent painting.",
            "nextDialogs": [
              "710060208"
            ]
          },
          "710060208": {
            "id": "710060208",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "But when I came here, the statues were here, but there were no shining eyes to be found.",
            "nextDialogs": [
              "710060209"
            ]
          },
          "710060209": {
            "id": "710060209",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "I thought that I might have missed some special timing, or that my angle was off, which is why I've been walking around.",
            "nextDialogs": [
              "710060210"
            ]
          },
          "710060210": {
            "id": "710060210",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "But it seems that no matter where I stand, the scenery doesn't change...",
            "nextDialogs": [
              "710060211"
            ]
          },
          "710060211": {
            "id": "710060211",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "The only thing I've gotten out of the whole venture is this — I found it in the pond down there.",
            "nextDialogs": [
              "710060212"
            ]
          },
          "710060212": {
            "id": "710060212",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "I have no clue what it is, but the more I look at it, the more it resembles an eye.",
            "nextDialogs": [
              "710060213"
            ]
          },
          "710060213": {
            "id": "710060213",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "But if this is an eye, then there might be another similar rock nearby. People do have two eyes, after all...",
            "nextDialogs": [
              "710060214"
            ]
          },
          "710060214": {
            "id": "710060214",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "*sigh* That's my conjecture, anyway. Don't think too hard about it. This rock's of little use to me, anyway, so why don't you have it? Consider it thanks for helping me find my tools.",
            "nextDialogs": [
              "710060215"
            ]
          },
          "710060215": {
            "id": "710060215",
            "speakerId": 17174,
            "speakerName": "Vermeer",
            "text": "Statues with shining eyes... I wonder what secrets one can uncover in Luhua Pool?"
          }
        }
      }
    },

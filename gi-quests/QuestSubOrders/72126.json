  "subQuests": [
    {
      "subId": "7212601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721260101"
        ],
        "dialogs": {
          "721260101": {
            "id": "721260101",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Oh no...what now...",
            "nextDialogs": [
              "721260102"
            ]
          },
          "721260102": {
            "id": "721260102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "721260103"
            ]
          },
          "721260103": {
            "id": "721260103",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Hey...I'm so glad you're here... It's like this, after you gave me the flower seeds, I started planting flowers.",
            "nextDialogs": [
              "721260104"
            ]
          },
          "721260104": {
            "id": "721260104",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "But before I could plant much, a group of monsters suddenly appeared and kept loitering around the place where I was going to plant the flowers. I no longer dare to go over to plant them.",
            "nextDialogs": [
              "721260105"
            ]
          },
          "721260105": {
            "id": "721260105",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "If they continue to remain here, they may destroy the place where the flowers were planted...",
            "nextDialogs": [
              "721260106"
            ]
          },
          "721260106": {
            "id": "721260106",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "If you don't mind, could you go and get rid of those monsters for me? I... I just want to plant flowers...",
            "nextDialogs": [
              "721260108",
              "721260110"
            ]
          },
          "721260108": {
            "id": "721260108",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "You said yes? Thank you so much! I'm counting on you!"
          },
          "721260110": {
            "id": "721260110",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "I was thinking, the reason why people don't want to come back to Tatarasuna is because they are worried that this place is no longer suitable for living after the Mikage Furnace incident happened...",
            "nextDialogs": [
              "721260111"
            ]
          },
          "721260111": {
            "id": "721260111",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "I can't persuade everyone one by one, but if I can plant a lot of beautiful flowers here again...",
            "nextDialogs": [
              "721260112"
            ]
          },
          "721260112": {
            "id": "721260112",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Maybe it will be enough to convince everyone that Tatarasuna is already safe.",
            "nextDialogs": [
              "721260113"
            ]
          },
          "721260113": {
            "id": "721260113",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "And...heh, besides planting flowers, I have no other means to convince people...",
            "nextDialogs": [
              "721260114"
            ]
          },
          "721260114": {
            "id": "721260114",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "So please, please help me to chase away those monsters!"
          }
        }
      }
    },
    {
      "subId": "7212602",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],

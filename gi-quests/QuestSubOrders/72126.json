        "dialogs": {
          "721260301": {
            "id": "721260301",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Have you managed to chase away those monsters?",
            "nextDialogs": [
              "721260302"
            ]
          },
          "721260302": {
            "id": "721260302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I chased them all away.",
            "nextDialogs": [
              "721260303"
            ]
          },
          "721260303": {
            "id": "721260303",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Thank you, now I can continue to grow flowers...",
            "nextDialogs": [
              "721260304"
            ]
          },
          "721260304": {
            "id": "721260304",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Oh yes, please take these, I'm sorry I don't have anything nice for you... Anyway, thanks for helping me out!"
          }
        }
      }
    },
    {
      "subId": "7212604",
      "subQuestName": "",

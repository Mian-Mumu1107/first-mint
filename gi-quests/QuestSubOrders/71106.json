    {
      "subId": "7110609",
      "subQuestName": "Talk to Uncle Luo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711061201"
        ],
        "dialogs": {
          "711061201": {
            "id": "711061201",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "Whoa, how did you come out from there? I was just about to call someone — I was worried sick! Never imagined an adepti treasure could suck people in like that...",
            "nextDialogs": [
              "711061202"
            ]
          },
          "711061202": {
            "id": "711061202",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "But check this out!",
            "nextDialogs": [
              "711061203"
            ]
          },
          "711061203": {
            "id": "711061203",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa! There's tea flowing out after cleaning out the elemental sedimentation... Hang on, this looks like it's just regular water!",
            "nextDialogs": [
              "711061204"
            ]
          },
          "711061204": {
            "id": "711061204",
            "speakerId": 1003,
            "speakerName": "Hautemontagne",
            "text": "Wow... Liyue's adepti mechanisms are truly incredible. They can even generate whole new spaces! Even Master Guillotin himself couldn't do such a thing...",
            "nextDialogs": [
              "711061205"
            ]
          },
          "711061205": {
            "id": "711061205",
            "speakerId": 1003,
            "speakerName": "Hautemontagne",
            "text": "Seems like Little Mao was right, after all! \"There'll always be someone better than you, and teapots you haven't been to\"...",
            "nextDialogs": [
              "711061206"
            ]
          },
          "711061206": {
            "id": "711061206",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That's not how it goes!",
            "nextDialogs": [
              "711061207"
            ]
          },
          "711061207": {
            "id": "711061207",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "Needless to say, without you the tea cauldron wouldn't have been repaired so quickly. Thanks for your help, Haut... mon... uh...?",
            "nextDialogs": [
              "711061208"
            ]
          },
          "711061208": {
            "id": "711061208",
            "speakerId": 1003,
            "speakerName": "Hautemontagne",
            "text": "Hautemontagne! But you don't have to use my full name. Just call me Mountain — it basically means the same thing anyway!",
            "nextDialogs": [
              "711061209"
            ]
          },
          "711061209": {
            "id": "711061209",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "Haha! Alright, well thank you, Mountain.",
            "nextDialogs": [
              "711061210"
            ]
          },
          "711061210": {
            "id": "711061210",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "This'll sort out the soil issue too... Hmph, guess you lost the bet, Grandpa Lu!",
            "nextDialogs": [
              "711061211"
            ]
          },
          "711061211": {
            "id": "711061211",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "Can't let you young'uns toil away and go hungry for nothing... Once the current tea crisis has been resolved, we'll all finally be able to breathe a little easier, and no longer have to worry about losses...",
            "nextDialogs": [
              "711061212"
            ]
          },
          "711061212": {
            "id": "711061212",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "Grandpa Lu, Laoding, and Xiaoding hadn't slept a wink for several nights, worrying about the substandard tea. But now the tea cauldron's been repaired... Just you wait and see! I hope I'm right, anyway!",
            "nextDialogs": [
              "711061213"
            ]
          },
          "711061213": {
            "id": "711061213",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "Thank you all, dear guests, for your help as well. Qiaoying Village's future is looking bright once again!",
            "nextDialogs": [
              "711061214"
            ]
          },
          "711061214": {
            "id": "711061214",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe, you're too kind! As long as there's plenty of tea and snacks waiting for us the next time we come!",
            "nextDialogs": [
              "711061215"
            ]
          },
          "711061215": {
            "id": "711061215",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "But of course, that goes without saying! You're Qiaoying Village VIPs now. Once the first batch is done, I'll reserve some of the very highest quality tea for you to sample!"
          }
        }
      }
    },
    {
      "subId": "7110609",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711060901"
        ],
        "dialogs": {
          "711060901": {
            "id": "711060901",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Uncle Luo! With Mountain's help, all three mechanisms have now been taken care of!",
            "nextDialogs": [
              "711060902"
            ]
          },
          "711060902": {
            "id": "711060902",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "Haha, I knew you three could do it! Such extraordinary skill!",
            "nextDialogs": [
              "711060903"
            ]
          },
          "711060903": {
            "id": "711060903",
            "speakerId": 1003,
            "speakerName": "Hautemontagne",
            "text": "#It was all thanks to {NICKNAME} and Paimon! I just need to do some final checks now, though there shouldn't be any problems... You two wouldn't be able to help out again, would you?",
            "nextDialogs": [
              "711060904"
            ]
          },
          "711060904": {
            "id": "711060904",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Alright, let's head up together!",
            "nextDialogs": [
              "711060905"
            ]
          },
          "711060905": {
            "id": "711060905",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You follow Hautemontagne to the tea cauldron...",
            "nextDialogs": [
              "711060906"
            ]
          },
          "711060906": {
            "id": "711060906",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "After tapping the tea cauldron lightly, a slight look of surprise appears on Hautemontagne's face...",
            "nextDialogs": [
              "711060907"
            ]
          },
          "711060907": {
            "id": "711060907",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eh, what's up?",
            "nextDialogs": [
              "711060908"
            ]
          },
          "711060908": {
            "id": "711060908",
            "speakerId": 1003,
            "speakerName": "Hautemontagne",
            "text": "Hmm, there's just something strange about the echo. According to my calculations, it should be more of a \"thump—thump—thump\" sound...",
            "nextDialogs": [
              "711060909"
            ]
          },
          "711060909": {
            "id": "711060909",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Could you have miscalculated, maybe?",
            "nextDialogs": [
              "711060910"
            ]
          },
          "711060910": {
            "id": "711060910",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Surely that's way too abstract, anyway! What do you mean by \"thump—thump—thump\"!?",
            "nextDialogs": [
              "711060911"
            ]
          },
          "711060911": {
            "id": "711060911",
            "speakerId": 1003,
            "speakerName": "Hautemontagne",
            "text": "Well... The tea cauldron's empty, so going by the formula left by Master Guillotin, the echo should be much clearer! What in Teyvat could be the reason...?",
            "nextDialogs": [
              "711060912"
            ]
          },
          "711060912": {
            "id": "711060912",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? What exactly is the problem? Can't see anything from the outside...",
            "nextDialogs": [
              "711060914",
              "711060920"
            ]
          },
          "711060914": {
            "id": "711060914",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm?",
            "nextDialogs": [
              "711060915"
            ]
          },
          "711060915": {
            "id": "711060915",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "*taps the tea cauldron* Like this...",
            "nextDialogs": [
              "711060916"
            ]
          },
          "711060916": {
            "id": "711060916",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Um... No response?",
            "nextDialogs": [
              "711060917"
            ]
          },
          "711060917": {
            "id": "711060917",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "*taps the tea cauldron* Or like this...",
            "nextDialogs": [
              "711060918"
            ]
          },
          "711060918": {
            "id": "711060918",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Still no respo... Wahhhh!"
          },
          "711060920": {
            "id": "711060920",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon can't fit in there! No way, surely!?",
            "nextDialogs": [
              "711060921"
            ]
          },
          "711060921": {
            "id": "711060921",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And why do you need Paimon to go in, anyway? Can't you just climb up, lift the lid, and take a look inside yourself!?",
            "nextDialogs": [
              "711060922"
            ]
          },
          "711060922": {
            "id": "711060922",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Forget it! I'll check it out myself...",
            "nextDialogs": [
              "711060923"
            ]
          },
          "711060923": {
            "id": "711060923",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm?",
            "nextDialogs": [
              "711060924"
            ]
          },
          "711060924": {
            "id": "711060924",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "*taps the tea cauldron* Like this...",
            "nextDialogs": [
              "711060925"
            ]
          },
          "711060925": {
            "id": "711060925",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Um... No response?",
            "nextDialogs": [
              "711060926"
            ]
          },
          "711060926": {
            "id": "711060926",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "*taps the tea cauldron* Or like this...",
            "nextDialogs": [
              "711060927"
            ]
          },
          "711060927": {
            "id": "711060927",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Still no respo... Wahhhh!"
          }
        }
      }

            ]
          },
          "711061309": {
            "id": "711061309",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "Haha! Alright, well thank you, Mountain.",
            "nextDialogs": [
              "711061310"
            ]
          },
          "711061310": {
            "id": "711061310",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "Roasting tea will never be as efficient as processing it in a workshop, but seeing as this tea cauldron was a divine treasure, it'll surely be a real tourist magnet and help revitalize Qiaoying Village!",
            "nextDialogs": [
              "711061311"
            ]
          },
          "711061311": {
            "id": "711061311",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "Haha, we'll invite the tourists to experience our centuries-old tea making traditions themselves... And pocket a few Mora for entry tickets in exchange...",
            "nextDialogs": [
              "711061312"
            ]
          },
          "711061312": {
            "id": "711061312",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmph, seems like someone's forgotten to respect the adepti...",
            "nextDialogs": [
              "711061313"
            ]
          },
          "711061313": {
            "id": "711061313",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "Aha! The village will prosper, business will boom, and the adepti will smile upon us when they see it! Isn't that a kind of respect!?",
            "nextDialogs": [
              "711061314"
            ]
          },
          "711061314": {
            "id": "711061314",
            "speakerId": 1001,
            "speakerName": "Uncle Luo",
            "text": "Thank you all, dear guests, for your help as well. Qiaoying Village's future is looking bright once again!",
            "nextDialogs": [
              "711061315"
            ]
          },
          "711061315": {
            "id": "711061315",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe, you're too kind! As long as there's plenty of tea and snacks waiting for us the next time we come!",
            "nextDialogs": [
              "711061316"
            ]
          },

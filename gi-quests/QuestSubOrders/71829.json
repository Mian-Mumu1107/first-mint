  "subQuests": [
    {
      "subId": "7182901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718290101"
        ],
        "dialogs": {
          "718290101": {
            "id": "718290101",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "*sigh* What should I do...?",
            "nextDialogs": [
              "718290102"
            ]
          },
          "718290102": {
            "id": "718290102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "718290103"
            ]
          },
          "718290103": {
            "id": "718290103",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Ah, it's you. Nothing's wrong... except I might need to start looking for a new job soon.",
            "nextDialogs": [
              "718290104"
            ]
          },
          "718290104": {
            "id": "718290104",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "The other day, the innkeeper asked me to prepare a new dish that would attract more guests.",
            "nextDialogs": [
              "718290105"
            ]
          },
          "718290105": {
            "id": "718290105",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "It should be presentable and tasty, but also stylish and artisan. Oh, and have personality...",
            "nextDialogs": [
              "718290106"
            ]
          },
          "718290106": {
            "id": "718290106",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "I've been trying to come up with something satisfactory over the last week, but the innkeeper didn't like any dish I came up with.",
            "nextDialogs": [
              "718290107"
            ]
          },
          "718290107": {
            "id": "718290107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What did you make?",
            "nextDialogs": [
              "718290108"
            ]
          },
          "718290108": {
            "id": "718290108",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "I gave it all I had, really. I utilized everything I learned while honing my culinary skills in the mountains.",
            "nextDialogs": [
              "718290109"
            ]
          },
          "718290109": {
            "id": "718290109",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Candied Silk Flower, Qingxin and Lotus Seed Duck Stew, Crab Roe Stewed Meatballs...",
            "nextDialogs": [
              "718290110"
            ]
          },
          "718290110": {
            "id": "718290110",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "...But he would shake his head at everything and ask me to give it another thought.",
            "nextDialogs": [
              "718290111"
            ]
          },
          "718290111": {
            "id": "718290111",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "But I've already reached my limit, eh...",
            "nextDialogs": [
              "718290112"
            ]
          },
          "718290112": {
            "id": "718290112",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Ah, right! I still gotta cook something for that freeloader. It's about time he came around...",
            "nextDialogs": [
              "718290113"
            ]
          },
          "718290113": {
            "id": "718290113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you mean Jiangxue?",
            "nextDialogs": [
              "718290114"
            ]
          },
          "718290114": {
            "id": "718290114",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Unless you know of any other parasites who'd shamelessly come here every day asking for food...",
            "nextDialogs": [
              "718290117"
            ]
          },
          "718290117": {
            "id": "718290117",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Since you're already here, why don't you grab a bite too? You can sit over there. I'll serve the food when it's ready."
          }
        }
      }
    },
    {
      "subId": "7182902",
      "subQuestName": "Sit by the table",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718290201"
        ],
        "dialogs": {
          "718290201": {
            "id": "718290201",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "You can sit by the table. I'll serve the food when it's ready."
          }
        }
      }
    },
    {
      "subId": "7182903",
      "subQuestName": "Talk to Jiangxue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718290401"
        ],
        "dialogs": {
          "718290401": {
            "id": "718290401",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "These meatballs are not half bad, this meat just melts in one's mouth, the broth packs a lot of flavor as well...",
            "nextDialogs": [
              "718290402"
            ]
          },
          "718290402": {
            "id": "718290402",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Huh? There's crab roe in the meat, no wonder it tastes so unusually fresh.",
            "nextDialogs": [
              "718290403"
            ]
          },
          "718290403": {
            "id": "718290403",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Come, Traveler, try one more. I'll teach you what to do. First, use chopsticks to open the meatball up, then soak it in the broth, and eat it with some rice...",
            "nextDialogs": [
              "718290409",
              "718290406",
              "718290408"
            ]
          },
          "718290409": {
            "id": "718290409",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "You'd better enjoy the food because that might've been the last meal I got to cook here...",
            "nextDialogs": [
              "718290410"
            ]
          },
          "718290410": {
            "id": "718290410",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Last meal you got to cook here... Who told you so?",
            "nextDialogs": [
              "718290411"
            ]
          },
          "718290411": {
            "id": "718290411",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Oh no, is it because of me? Is the innkeeper fed up with you because you've been feeding me all this time?",
            "nextDialogs": [
              "718290412"
            ]
          },
          "718290412": {
            "id": "718290412",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Seems a bit unfair, given that I supplied the inn with some of my best catches free of charge. That should've covered at least a part of my bill. Besides, the innkeeper isn't known for being a miser...",
            "nextDialogs": [
              "718290413"
            ]
          },
          "718290413": {
            "id": "718290413",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Give me a break, it was just a few fish, and most of them ended up in your stomach anyway.",
            "nextDialogs": [
              "718290414"
            ]
          },
          "718290414": {
            "id": "718290414",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "So actually...",
            "nextDialogs": [
              "718290415"
            ]
          },
          "718290415": {
            "id": "718290415",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "*sigh* ...Fine. I'll tell you...",
            "nextDialogs": [
              "718290416"
            ]
          },
          "718290416": {
            "id": "718290416",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Presentable, tasty, stylish, artisan, and with personality...",
            "nextDialogs": [
              "718290417"
            ]
          },
          "718290417": {
            "id": "718290417",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Hahaha, I'm not sure if there's any dish in this world that'd meet the innkeeper's requirements.",
            "nextDialogs": [
              "718290418"
            ]
          },
          "718290418": {
            "id": "718290418",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "You think it's funny? We'll see how you'll laugh when you come over next time and I won't be here to feed you for free!",
            "nextDialogs": [
              "718290419"
            ]
          },
          "718290419": {
            "id": "718290419",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Alright, alright, it's not so funny after all. So that's why you've been looking so worried today.",
            "nextDialogs": [
              "718290420"
            ]
          },
          "718290420": {
            "id": "718290420",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "It's hard to be in high spirits when your boss expects you to perform miracles all of a sudden...",
            "nextDialogs": [
              "718290421"
            ]
          },
          "718290421": {
            "id": "718290421",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Hm, there might be a way out. Even though I can't cook myself, I happen to know a recipe for a unique dish.",
            "nextDialogs": [
              "718290422"
            ]
          },
          "718290422": {
            "id": "718290422",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "I came across that dish during a trip abroad, when I happened to be a guest at a local big shot's house. They called it Chicken Tofu Pudding.",
            "nextDialogs": [
              "718290423"
            ]
          },
          "718290423": {
            "id": "718290423",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "By the looks of it, you wouldn't say that it's a meat dish. It really is as delicate as tofu pudding, but with a strong flavor of meat and herbs. A rare meat dish that imitates vegetarian cuisine.",
            "nextDialogs": [
              "718290424"
            ]
          },
          "718290424": {
            "id": "718290424",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "That meal left me so curious about the dish that I asked my host for the recipe, however... I'm a bad cook, so the recipe has been collecting dust in my chest ever since..."
          },
          "718290406": {
            "id": "718290406",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Hahaha, even a fool would learn a thing or two about food if they got to eat such delicacies every day. Let me teach you the correct way to taste this stewed fish..."
          },
          "718290408": {
            "id": "718290408",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Me? I'm afraid I'm already full... since the innkeeper filled me with anxiety."
          }
        }
      }
    },
    {
      "subId": "7182904",
      "subQuestName": "Give Smiley Yanxiao the ingredients",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7182905",
      "subQuestName": "Talk to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718290701"
        ],
        "dialogs": {
          "718290701": {
            "id": "718290701",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Alright, we've got all the ingredients needed. Let's get to work.",
            "nextDialogs": [
              "718290704"
            ]
          },
          "718290704": {
            "id": "718290704",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Well... maybe our freeloading friend can provide us with some instructions?",
            "nextDialogs": [
              "718290705"
            ]
          },
          "718290705": {
            "id": "718290705",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Right. First, portion the meat on the table with your sword and slice it into smaller pieces. Then, mince it, slowly turning it into fine paste..."
          }
        }
      }
    },
    {
      "subId": "7182906",
      "subQuestName": "Cut the meat",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718290601"
        ],
        "dialogs": {
          "718290601": {
            "id": "718290601",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "I've never expected that this recipe might actually come in handy, and yet..."
          }
        }
      }
    },
    {
      "subId": "7182907",
      "subQuestName": "Pour pure water into the cooking pot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7182908",
      "subQuestName": "Bring the stove up to temperature",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718290801"
        ],
        "dialogs": {
          "718290801": {
            "id": "718290801",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "First, portion the meat on the table with your sword and slice it into smaller pieces. Then, mince it, slowly turning it into fine paste..."
          }
        }
      }
    },
    {
      "subId": "7182909",
      "subQuestName": "Talk to Jiangxue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718291401"
        ],
        "dialogs": {
          "718291401": {
            "id": "718291401",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Let me try...",
            "nextDialogs": [
              "718291402"
            ]
          },
          "718291402": {
            "id": "718291402",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Mmmm, this flavor... so rich and fresh, but the mouthfeel resembles that of a tofu pudding...",
            "nextDialogs": [
              "718291403"
            ]
          },
          "718291403": {
            "id": "718291403",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Looks quite presentable, too, and requires truly exquisite workmanship. The premise is also catchy — a meat dish that imitates vegetarian cuisine — I'm sure many would like to try it for themselves...",
            "nextDialogs": [
              "718291404"
            ]
          },
          "718291404": {
            "id": "718291404",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Not bad! Not bad at all! I'm sure it'll be to the innkeeper's taste.",
            "nextDialogs": [
              "718291405"
            ]
          },
          "718291405": {
            "id": "718291405",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "What a surprise! Turns out you're more capable than I gave you credit for. Who knew a sponger like you would remember this recipe so well.",
            "nextDialogs": [
              "718291406"
            ]
          },
          "718291406": {
            "id": "718291406",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Haha. I might as well tell you: back in the day, I thought that this recipe contained some sort of secret sword art, so I studied it day and night without ceasing...",
            "nextDialogs": [
              "718291407"
            ]
          },
          "718291407": {
            "id": "718291407",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Now that I think about it, I must have been an absolute madman. It was just a recipe, why would there be anything about swordsmanship in it?",
            "nextDialogs": [
              "718291408"
            ]
          },
          "718291408": {
            "id": "718291408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And all that practice, for...",
            "nextDialogs": [
              "718291409"
            ]
          },
          "718291409": {
            "id": "718291409",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "To look for someone and to ask for justice, that's all.",
            "nextDialogs": [
              "718291410"
            ]
          },
          "718291410": {
            "id": "718291410",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Hah! That was a magnificent deed! And here you are, speaking so softly about it.",
            "nextDialogs": [
              "718291411"
            ]
          },
          "718291411": {
            "id": "718291411",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Haha. Well, once I'd exacted that justice, I came here. Thankfully, the innkeeper was willing to take me in and let me loaf about the place.",
            "nextDialogs": [
              "718291412"
            ]
          },
          "718291412": {
            "id": "718291412",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "I am now free of desire. I no longer wish to wield my sword, nor do I have any other skills... Hahaha, I suppose staying here for the rest of my life isn't so bad.",
            "nextDialogs": [
              "718291413"
            ]
          },
          "718291413": {
            "id": "718291413",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Well now, I suppose I should give you a copy of this recipe. You can make it for yourself if you have the time. It's a little troublesome, but it tastes pretty good.",
            "nextDialogs": [
              "718291417",
              "718291416"
            ]
          },
          "718291417": {
            "id": "718291417",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Hmm... Well, let's put this dish aside. We can show it to the innkeeper once he gets here.",
            "nextDialogs": [
              "718291418"
            ]
          },
          "718291418": {
            "id": "718291418",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "And after that... hey, hey, Mr. Loafer, don't you go anywhere just yet. Come over here.",
            "nextDialogs": [
              "718291419"
            ]
          },
          "718291419": {
            "id": "718291419",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Oh, what do you want? I don't have another recipe for you, just so you know.",
            "nextDialogs": [
              "718291420"
            ]
          },
          "718291420": {
            "id": "718291420",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Come on. Didn't you say that you didn't have any skills apart from wielding your sword? Well then, draw that sword, I'm teaching you to chop meat.",
            "nextDialogs": [
              "718291421"
            ]
          },
          "718291421": {
            "id": "718291421",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Chop meat? I... Well, I'm afraid...",
            "nextDialogs": [
              "718291422"
            ]
          },
          "718291422": {
            "id": "718291422",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "You'll get it pretty quickly. Chop meat today, make a dish tomorrow. Learn yourself a few of those, and there, you've got a skill.",
            "nextDialogs": [
              "718291423"
            ]
          },
          "718291423": {
            "id": "718291423",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "What are you...",
            "nextDialogs": [
              "718291424"
            ]
          },
          "718291424": {
            "id": "718291424",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Hmph. A few dishes under your belt, yes — that'll spare me the need to watch you scrap for food around here, that's for sure.",
            "nextDialogs": [
              "718291425"
            ]
          },
          "718291425": {
            "id": "718291425",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Well, come on then, don't drag your feet. You dilly-dally some more, and you can forget having any meatballs to eat tomorrow!",
            "nextDialogs": [
              "718291426"
            ]
          },
          "718291426": {
            "id": "718291426",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Wait, what? Come on, you can't threaten me like that... Alright, alright, I'll chop them. I'll chop them!"
          },
          "718291416": {
            "id": "718291416",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Of course. I never get tired of our good chef's great food."
          }
        }
      }
    },
    {
      "subId": "7182903",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718290301"
        ],
        "dialogs": {
          "718290301": {
            "id": "718290301",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "Huh? I see that we have a special guest today. Usually, it's just that chef and I, eating in silence. Perhaps your presence will liven up today's meal.",
            "nextDialogs": [
              "718290302"
            ]
          },
          "718290302": {
            "id": "718290302",
            "speakerId": 2201,
            "speakerName": "Jiangxue",
            "text": "But it appears that the chef is terribly worried about something today. Why the long face..."
          }
        }
      }
    },
    {
      "subId": "7182905",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718290501"
        ],
        "dialogs": {
          "718290501": {
            "id": "718290501",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Have you found a Bird Egg and a Snapdragon?"
          }
        }
      }
    },
    {
      "subId": "7182909",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718290901"
        ],
        "dialogs": {
          "718290901": {
            "id": "718290901",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",

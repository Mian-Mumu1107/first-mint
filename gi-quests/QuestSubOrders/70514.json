  },
  "subQuests": [
    {
      "subId": "7051401",
      "subQuestName": "Talk to Félix Yogue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705140101"
        ],
        "dialogs": {
          "705140101": {
            "id": "705140101",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "The passion of Mondstadt is well-founded, I say. More so than I imagined, in fact... even their hilichurls are so very lively.",
            "nextDialogs": [
              "705140102"
            ]
          },
          "705140102": {
            "id": "705140102",
            "speakerId": 1437,
            "speakerName": "Swan",
            "text": "Regardless, Mr. Yogue, we ask that you not go out by yourself again.",
            "nextDialogs": [
              "705140103"
            ]
          },
          "705140103": {
            "id": "705140103",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "What? Then what about my machine? I'm still missing... um...",
            "nextDialogs": [
              "705140104"
            ]
          },
          "705140104": {
            "id": "705140104",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "1, 2, 3... 18... 19 components!",
            "nextDialogs": [
              "705140105"
            ]
          },
          "705140105": {
            "id": "705140105",
            "speakerId": 1437,
            "speakerName": "Swan",
            "text": "We've got adventurers working on finding them. Just wait here in the city where it's safe, please...",
            "nextDialogs": [
              "705140106"
            ]
          },
          "705140106": {
            "id": "705140106",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "But without that device, my... It's a matter of inspiration, you understand? What shall I do when inspiration strikes?",
            "nextDialogs": [
              "705140107"
            ]
          },
          "705140107": {
            "id": "705140107",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Ah, it comes and it goes... Like a belch after a good drink, or a candle in the wind!",
            "nextDialogs": [
              "705140108"
            ]
          },
          "705140108": {
            "id": "705140108",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Hmm, actually, that's not a bad analogy. I should write it down. I'm sure Xavier would love it...",
            "nextDialogs": [
              "705140109"
            ]
          },
          "705140109": {
            "id": "705140109",
            "speakerId": 1437,
            "speakerName": "Swan",
            "text": "You...",
            "nextDialogs": [
              "705140110"
            ]
          },
          "705140110": {
            "id": "705140110",
            "speakerId": 1437,
            "speakerName": "Swan",
            "text": "Huh? Honorary Knight? Ah, wonderful! Just the person I wanted to see! Please, over here!",
            "nextDialogs": [
              "705140113"
            ]
          },
          "705140113": {
            "id": "705140113",
            "speakerId": 1437,
            "speakerName": "Swan",
            "text": "Well, allow me to introduce you. This man here is from the Court of Fontaine...",
            "nextDialogs": [
              "705140114"
            ]
          },
          "705140114": {
            "id": "705140114",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "No man am I, but a daydreamer! That is how we name ourselves!",
            "nextDialogs": [
              "705140115"
            ]
          },
          "705140115": {
            "id": "705140115",
            "speakerId": 1437,
            "speakerName": "Swan",
            "text": "...So, Mr. Yogue, this is our Honorary Knight...",
            "nextDialogs": [
              "705140116"
            ]
          },
          "705140116": {
            "id": "705140116",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Yogue! Félix Yogue. Salutations to you, Honorary Knight! Long have I heard of your many exploits.",
            "nextDialogs": [
              "705140117"
            ]
          },
          "705140117": {
            "id": "705140117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You know of me?",
            "nextDialogs": [
              "705140118"
            ]
          },
          "705140118": {
            "id": "705140118",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Of course, of course! Who wouldn't?",
            "nextDialogs": [
              "705140119"
            ]
          },
          "705140119": {
            "id": "705140119",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Your battle against Dvalin in Mondstadt made headlines in The Steambird for three whole weeks!",
            "nextDialogs": [
              "705140120"
            ]
          },
          "705140120": {
            "id": "705140120",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Hahaha, if those reporters knew that I was speaking to you right now, why, they would be beside themselves with envy!",
            "nextDialogs": [
              "705140121"
            ]
          },
          "705140121": {
            "id": "705140121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's The Steambird?",
            "nextDialogs": [
              "705140122"
            ]
          },
          "705140122": {
            "id": "705140122",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Ah, you don't know? It's a... Ah, let's say it's a rather popular newspaper in the Court of Fontaine.",
            "nextDialogs": [
              "705140123"
            ]
          },
          "705140123": {
            "id": "705140123",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "You once got their sales up to record numbers, I'll have you know.",
            "nextDialogs": [
              "705140125"
            ]
          },
          "705140125": {
            "id": "705140125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Headlines, you say?",
            "nextDialogs": [
              "705140126"
            ]
          },
          "705140126": {
            "id": "705140126",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Indeed! And you got their sales up to record numbers, to boot!",
            "nextDialogs": [
              "705140127"
            ]
          },
          "705140127": {
            "id": "705140127",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Front-page, full-length, expert interviews up the wazoo, and the best hand-drawn illustrations Mora could buy! You made a lot of people mad Mora there.",
            "nextDialogs": [
              "705140128"
            ]
          },
          "705140128": {
            "id": "705140128",
            "speakerId": 1437,
            "speakerName": "Swan",
            "text": "Well then... Traveler, Mr. Yogue, I shall leave you guys alone... I've got some other things to handle at the moment, if you'll excuse me.",
            "nextDialogs": [
              "705140129"
            ]
          },
          "705140129": {
            "id": "705140129",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Swan leaves in a hurry...",
            "nextDialogs": [
              "705140130"
            ]
          },
          "705140130": {
            "id": "705140130",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Ah, it is as I was told. The Knights of Favonius have a never-ending backlog of work.",
            "nextDialogs": [
              "705140131"
            ]
          },
          "705140131": {
            "id": "705140131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, why are you here in Mondstadt?",
            "nextDialogs": [
              "705140132"
            ]
          },
          "705140132": {
            "id": "705140132",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Me? Well, I'm actually planning to tour Teyvat.",
            "nextDialogs": [
              "705140133"
            ]
          },
          "705140133": {
            "id": "705140133",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "As for the purpose of my trip, why, it is to promote these Kinesis Cores that I have made.",
            "nextDialogs": [
              "705140134"
            ]
          },
          "705140134": {
            "id": "705140134",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Simply put, a Kinesis Core is a form of clockwork device. As long as its mainspring is wound from time to time, these cores can provide motive force for a long period of time.",
            "nextDialogs": [
              "705140135"
            ]
          },
          "705140135": {
            "id": "705140135",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "I even created a sort of perpetual-motion toy powered by the Kinesis Core to show off its capabilities. I call it the Evermotion Mechanical Painting.",
            "nextDialogs": [
              "705140136"
            ]
          },
          "705140136": {
            "id": "705140136",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Unfortunately, while I'd love to show the device to you...",
            "nextDialogs": [
              "705140137"
            ]
          },
          "705140137": {
            "id": "705140137",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Its allure was all too much for even monsters to resist.",
            "nextDialogs": [
              "705140138"
            ]
          },
          "705140138": {
            "id": "705140138",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "At the moment, they must have divvied my device up into many pieces in a manner most unfriendly, playing around with each component...",
            "nextDialogs": [
              "705140139"
            ]
          },
          "705140139": {
            "id": "705140139",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "I have, of course, asked for the help of the Adventurers' Guild, but I have received no news from any adventurer so far...",
            "nextDialogs": [
              "705140140"
            ]
          },
          "705140140": {
            "id": "705140140",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Honorary Knight, could you help me out as well, if you have a mind to?",
            "nextDialogs": [
              "705140141"
            ]
          },
          "705140141": {
            "id": "705140141",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Believe me, neither my device nor the payment due will disappoint you!",
            "nextDialogs": [
              "705140142"
            ]
          },
          "705140142": {
            "id": "705140142",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Leave it to me.",
            "nextDialogs": [
              "705140143"
            ]
          },
          "705140143": {
            "id": "705140143",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Wonderful. You are indeed a mighty adventurer, and a mighty sympathetic one, too. Just as the papers said!",
            "nextDialogs": [
              "705140144"
            ]
          },
          "705140144": {
            "id": "705140144",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Ah, it's a shame that we're in Mondstadt. Were we in the Court of Fontaine, I would bring a few reporters from The Steambird for an exclusive interview with you.",
            "nextDialogs": [
              "705140145"
            ]
          },
          "705140145": {
            "id": "705140145",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "I'm sure that your charisma would bowl them over to the point where you'd be guaranteed another three weeks' worth of headlines — not to mention the requisite royalties."
          }
        }
      }
    },
    {
      "subId": "7051402",
      "subQuestName": "Collect Components",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7051403",
      "subQuestName": "Talk to Félix Yogue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705140301"
        ],
        "dialogs": {
          "705140301": {
            "id": "705140301",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "You've returned, Honorary Knight. What news of the components?",
            "nextDialogs": [
              "705140302"
            ]
          },
          "705140302": {
            "id": "705140302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You mean these?"
          }
        }
      }
    },
    {
      "subId": "7051404",
      "subQuestName": "Talk to Félix Yogue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705140401"
        ],
        "dialogs": {
          "705140401": {
            "id": "705140401",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Yes, indeed! Ah, this is wonderful! Heavens, yes!",
            "nextDialogs": [
              "705140402"
            ]
          },
          "705140402": {
            "id": "705140402",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Well now, since all the components have been returned to us, all that's left is to combine them...",
            "nextDialogs": [
              "705140403"
            ]
          },
          "705140403": {
            "id": "705140403",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "Well then... Honorary Knight, if you want, you can attempt to put all the pieces together.",
            "nextDialogs": [
              "705140404"
            ]
          },
          "705140404": {
            "id": "705140404",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "It will be an interesting experience, trust me!"
          }
        }
      }
    },
    {
      "subId": "7051405",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705140501"
        ],
        "dialogs": {
          "705140501": {
            "id": "705140501",
            "speakerId": 30217,
            "speakerName": "Félix Yogue",
            "text": "#Well, {F#Ms.}{M#Mr.} Honorary Knight, I leave the matter of these components to you."
          }
        }
      }
    }
  ]
}
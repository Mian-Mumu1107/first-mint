    {
      "subId": "7007403",
      "subQuestName": "Destroy all the training dummies within the time limit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740301"
        ],
        "dialogs": {
          "700740301": {
            "id": "700740301",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "The training ground's all yours. Oh, to witness a pair of top masters in action... What luck!"
          }
        }
      }
    },
    {
      "subId": "7007410",
      "subQuestName": "Defeat the special training dummies",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700741001"
        ],
        "dialogs": {
          "700741001": {
            "id": "700741001",
            "speakerId": 1061,
            "speakerName": "Diona",
            "text": "The old boozebrain will be okay, though, won't he?"
          }
        }
      }
    },
    {
      "subId": "7007404",
      "subQuestName": "Talk to Varka",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740401"
        ],
        "dialogs": {
          "700740401": {
            "id": "700740401",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Amazing! So THAT's how you do it...",
            "nextDialogs": [
              "700740402"
            ]
          },
          "700740402": {
            "id": "700740402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh... Why does Paimon feel like she's heard that reaction like a hundred times before...",
            "nextDialogs": [
              "700740403"
            ]
          },
          "700740403": {
            "id": "700740403",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Hmm... Yep, this'll do! The shape, the texture, the quality... brilliant.",
            "nextDialogs": [
              "700740404"
            ]
          },
          "700740404": {
            "id": "700740404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How you can tell one wood chip apart from another is beyond Paimon... Whatever, as long as you're happy. Next up, those \"pigeon feathers shed in joy\"..."
          }
        }
      }
    },
    {
      "subId": "7007405",
      "subQuestName": "Go to the city gate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740501"
        ],
        "dialogs": {
          "700740501": {
            "id": "700740501",
            "speakerId": 1567,
            "speakerName": "Timmie",
            "text": "Hey! You've scared off all the pigeons...",
            "nextDialogs": [
              "700740502"
            ]
          },
          "700740502": {
            "id": "700740502",
            "speakerId": 1567,
            "speakerName": "Timmie",
            "text": "...G—Grand Master?",
            "nextDialogs": [
              "700740503"
            ]
          },
          "700740503": {
            "id": "700740503",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Hey, if it isn't little Timmie! Grown up quite a bit, haven't you? Been eating well?",
            "nextDialogs": [
              "700740504"
            ]
          },
          "700740504": {
            "id": "700740504",
            "speakerId": 1567,
            "speakerName": "Timmie",
            "text": "Y—Yes Sir! I always remember what you told me — that I've gotta eat well and exercise hard if I wanna grow up big and strong!",
            "nextDialogs": [
              "700740507"
            ]
          },
          "700740507": {
            "id": "700740507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, guess that's the Varka effect... Honestly, Paimon would be shocked if there was a single kid in this city who didn't look up to our \"living legend\" over here!",
            "nextDialogs": [
              "700740508"
            ]
          },
          "700740508": {
            "id": "700740508",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Sorry for scaring your pigeons away.",
            "nextDialogs": [
              "700740509"
            ]
          },
          "700740509": {
            "id": "700740509",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "I was actually gonna ask... Is there a way to approach pigeons without spooking them... while keeping them happy at the same time?",
            "nextDialogs": [
              "700740510"
            ]
          },
          "700740510": {
            "id": "700740510",
            "speakerId": 1567,
            "speakerName": "Timmie",
            "text": "Hmm... To be honest, I usually just walk up to them quietly and scatter some feed...",
            "nextDialogs": [
              "700740511"
            ]
          },
          "700740511": {
            "id": "700740511",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Boom, that's it! Say, you got any extra feed on you right now?",
            "nextDialogs": [
              "700740512"
            ]
          },
          "700740512": {
            "id": "700740512",
            "speakerId": 1567,
            "speakerName": "Timmie",
            "text": "I do have quite a bit, but... Grand Master... Um... What are you planning to do...?",
            "nextDialogs": [
              "700740513"
            ]
          },
          "700740513": {
            "id": "700740513",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Don't worry, little man, we just need to borrow a feather or two... You have my word!",
            "nextDialogs": [
              "700740514"
            ]
          },
          "700740514": {
            "id": "700740514",
            "speakerId": 1567,
            "speakerName": "Timmie",
            "text": "Ah... Alright then, no problem! And thank you, Grand Master!"
          }
        }
      }
    },
    {
      "subId": "7007406",
      "subQuestName": "Go to where the pigeons gather",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740601"
        ],
        "dialogs": {
          "700740601": {
            "id": "700740601",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Looks like we've got ourselves some pigeon tracks. Let's wait here.",
            "nextDialogs": [
              "700740602"
            ]
          },
          "700740602": {
            "id": "700740602",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "When they appear, walk up to them quietly and scatter the feed... but make sure not to hurt them. Ready?"
          }
        }
      }
    },
    {
      "subId": "7007413",

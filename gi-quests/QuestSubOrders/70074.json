  "subQuests": [
    {
      "subId": "7007401",
      "subQuestName": "Go to Mondstadt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740101"
        ],
        "dialogs": {
          "700740101": {
            "id": "700740101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Y'know, since it was Varka who came up with the whole idea of holding a \"conference\" with the Hexenzirkel, how come we never found out what task they gave him?",
            "nextDialogs": [
              "700740102"
            ]
          },
          "700740102": {
            "id": "700740102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's see... Varka, Varka... Wait, why's it blank?",
            "nextDialogs": [
              "700740103"
            ]
          },
          "700740103": {
            "id": "700740103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why don't we just go ask him ourselves?",
            "nextDialogs": [
              "700740104"
            ]
          },
          "700740104": {
            "id": "700740104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Good point... Well, knowing what he's like, we'd better start by checking all the local taverns and restaurants...",
            "nextDialogs": [
              "700740105"
            ]
          },
          "700740105": {
            "id": "700740105",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "...Still not here, huh? Looks like I'll have to figure this out on my own.",
            "nextDialogs": [
              "700740106"
            ]
          },
          "700740106": {
            "id": "700740106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Speak of the devil, huh?",
            "nextDialogs": [
              "700740107"
            ]
          },
          "700740107": {
            "id": "700740107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, Varka! We wanted to ask you about your \"task\"...",
            "nextDialogs": [
              "700740108"
            ]
          },
          "700740108": {
            "id": "700740108",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Oh, hey there, Honorary Knight and Paimon! My \"task\"...? What's all this about?",
            "nextDialogs": [
              "700740111"
            ]
          },
          "700740111": {
            "id": "700740111",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Now that you mention it, I'm pretty sure Alice did tell me something about that... I think?",
            "nextDialogs": [
              "700740112"
            ]
          },
          "700740112": {
            "id": "700740112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You \"think\"? That \"conference\" of yours is why those \"tasks\" even exist in the first place! ...Ugh, anyway, why *is* yours blank?",
            "nextDialogs": [
              "700740113"
            ]
          },
          "700740113": {
            "id": "700740113",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "...If I had to take a wild guess, probably 'cause it'd be too much for that little book of theirs to handle."
          }
        }
      }
    },
    {
      "subId": "7007402",
      "subQuestName": "Go to the Knights of Favonius training ground",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700740201"
        ],
        "dialogs": {
          "700740201": {
            "id": "700740201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So this is where we'll be getting those \"wood chips struck by knights,\" huh...",
            "nextDialogs": [
              "700740202"
            ]
          },
          "700740202": {
            "id": "700740202",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Ah! Grand Master! Honorary Knight! Are you here to train as well?",
            "nextDialogs": [
              "700740203"
            ]
          },
          "700740203": {
            "id": "700740203",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Well, maybe not in a traditional sense... But we're here to pursue a goal, so I guess that counts too!",
            "nextDialogs": [
              "700740204"
            ]
          },
          "700740204": {
            "id": "700740204",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "You're already so skilled, yet you still strive for perfection... Please, train however you like! I'll be taking notes from the side!"
          }
        }
      }
    },

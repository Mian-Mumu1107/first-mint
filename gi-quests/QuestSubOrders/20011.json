    {
      "subId": "2001102",
      "subQuestName": "Defeat the nearby enemies",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200110201"
        ],
        "dialogs": {
          "200110201": {
            "id": "200110201",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Whew. Thanks, Traveler...",
            "nextDialogs": [
              "200110202"
            ]
          },
          "200110202": {
            "id": "200110202",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "But there's this roadblock here. I can't get through.",
            "nextDialogs": [
              "200110203"
            ]
          },
          "200110203": {
            "id": "200110203",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Haha... I would be able to sort this myself if the hilichurls hadn't just beaten the living daylights out of me. I'm aching all over!",
            "nextDialogs": [
              "200110204"
            ]
          },
          "200110204": {
            "id": "200110204",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "But at least these medicinal herbs I gathered for Anna are still in good condition.",
            "nextDialogs": [
              "200110205"
            ]
          },
          "200110205": {
            "id": "200110205",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "I'm sorry... I know this is asking a lot after what you've done for me already, but could you get rid of the roadblock for me?",
            "nextDialogs": [
              "200110208",
              "200110209"
            ]
          },
          "200110208": {
            "id": "200110208",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Thank you! I'm going to take a much-needed rest in the meantime..."
          },
          "200110209": {
            "id": "200110209",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "But Anna is waiting for me at home... Please, I really need your help."
          }
        }
      }
    },
    {
      "subId": "2001103",
      "subQuestName": "Defeat all opponents and destroy the roadblocks",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200110301"
        ],
        "dialogs": {
          "200110301": {
            "id": "200110301",
            "speakerId": 140801,
            "speakerName": "Anthony",
            "text": "Now the way ahead is clear. Thanks, Traveler.",
            "nextDialogs": [
              "200110302"
            ]
          },
          "200110302": {
            "id": "200110302",
            "speakerId": 140801,
            "speakerName": "Anthony",
            "text": "Anna's illness never fully goes away. But since we don't have much money, I often come here and gather what medicinal herbs I can.",
            "nextDialogs": [
              "200110303"
            ]
          },
          "200110303": {
            "id": "200110303",
            "speakerId": 140801,
            "speakerName": "Anthony",
            "text": "I managed to get the herbs I was looking for, but then that bunch started attacking me out of nowhere. You got here just in time to save me.",
            "nextDialogs": [
              "200110304"
            ]
          },
          "200110304": {
            "id": "200110304",
            "speakerId": 140801,
            "speakerName": "Anthony",
            "text": "This is for you. I make tea for Anna with it all the time, it helps with her coughing.",
            "nextDialogs": [
              "200110305"
            ]
          },
          "200110305": {
            "id": "200110305",
            "speakerId": 140801,
            "speakerName": "Anthony",
            "text": "You seem like the outdoors type too. Make sure you look after yourself."
          }
        }
      }
    },

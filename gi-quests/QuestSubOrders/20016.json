          "200160702": {
            "id": "200160702",
            "speakerId": 1003,
            "speakerName": "Reckless Pallad",
            "text": "Yes, a long time ago! Took you long enough! There'll be no treasure left if I wait much longer.",
            "nextDialogs": [
              "200160703"
            ]
          },
          "200160703": {
            "id": "200160703",
            "speakerId": 1003,
            "speakerName": "Reckless Pallad",
            "text": "Mmm, this does smell delicious though...",
            "nextDialogs": [
              "200160704"
            ]
          },
          "200160704": {
            "id": "200160704",
            "speakerId": 1003,
            "speakerName": "Reckless Pallad",
            "text": "Well, I guess good food is also a treasure worth waiting for. I'm sure I've got time to eat before treasure hunting.",
            "nextDialogs": [
              "200160705"
            ]
          },
          "200160705": {
            "id": "200160705",
            "speakerId": 1003,
            "speakerName": "Reckless Pallad",
            "text": "Thank you. Here's the cash."
          }
        }
      }

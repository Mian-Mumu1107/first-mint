    {
      "subId": "2001601",
      "subQuestName": "Talk to Sara at Good Hunter",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200160101"
        ],
        "dialogs": {
          "200160101": {
            "id": "200160101",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "Order for delivery",
            "nextDialogs": [
              "200160102"
            ]
          },
          "200160102": {
            "id": "200160102",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "Traveler! Perfect timing...",
            "nextDialogs": [
              "200160103"
            ]
          },
          "200160103": {
            "id": "200160103",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "Sorry, I know you must be hungry, but could you do something for me?",
            "nextDialogs": [
              "200160104"
            ]
          },
          "200160104": {
            "id": "200160104",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "There's been a steady increase in volume of delivery orders recently. I tend to divide them up by region and then label each dish with the name of the person who ordered it.",
            "nextDialogs": [
              "200160105"
            ]
          },
          "200160105": {
            "id": "200160105",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "But I've lost the label for this <color=#00E1FFFF>Calla Lily Seafood Soup</color>. All I know is that it's for someone in Springvale.",
            "nextDialogs": [
              "200160106"
            ]
          },
          "200160106": {
            "id": "200160106",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "Could you take this <color=#00E1FFFF>Calla Lily Seafood Soup</color> over to Springvale for me and find out who ordered it?",
            "nextDialogs": [
              "200160108",
              "200160111"
            ]
          },
          "200160108": {
            "id": "200160108",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "Rest assured there'll be a hearty meal waiting for you on your return!",
            "nextDialogs": [
              "200160109"
            ]
          },
          "200160109": {
            "id": "200160109",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "I'm counting on you!"
          },
          "200160111": {
            "id": "200160111",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "Once you've done what I ask, I'll treat you to something from the Good Hunter special menu! Much obliged."
          }
        }
      }
    },

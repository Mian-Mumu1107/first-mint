    {
      "subId": "2001604",
      "subQuestName": "Buyer determiner 1",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200160301"
        ],
        "dialogs": {
          "200160301": {
            "id": "200160301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Excuse me, did you order takeout?",
            "nextDialogs": [
              "200160302"
            ]
          },
          "200160302": {
            "id": "200160302",
            "speakerId": 1001,
            "speakerName": "Terrified Schuster",
            "text": "Wow, that was fast. I thought it would take longer.",
            "nextDialogs": [
              "200160303"
            ]
          },
          "200160303": {
            "id": "200160303",
            "speakerId": 1001,
            "speakerName": "Terrified Schuster",
            "text": "Here's what I owe you. Mmm, smells gooood!",
            "nextDialogs": [
              "200160304"
            ]
          },
          "200160304": {
            "id": "200160304",
            "speakerId": 1001,
            "speakerName": "Terrified Schuster",
            "text": "I mustn't go adventuring on an empty stomach. Now, I'm going to savor every last bite of this..."
          }
        }
      }
    },
    {
      "subId": "2001605",
      "subQuestName": "Buyer determiner 2",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200160501"
        ],
        "dialogs": {
          "200160501": {
            "id": "200160501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hello there. Is this your food?",
            "nextDialogs": [
              "200160502"
            ]
          },
          "200160502": {
            "id": "200160502",
            "speakerId": 1002,
            "speakerName": "Timid Morrow",
            "text": "Um... is it Calla Lily Seafood Soup?",
            "nextDialogs": [
              "200160503"
            ]
          },
          "200160503": {
            "id": "200160503",
            "speakerId": 1002,
            "speakerName": "Timid Morrow",
            "text": "Yay, it is mine then. But I'm not sure what took you so long...",
            "nextDialogs": [
              "200160504"
            ]
          },
          "200160504": {
            "id": "200160504",
            "speakerId": 1002,
            "speakerName": "Timid Morrow",
            "text": "Any later and Draff would have dragged me out on a hunt by now.",
            "nextDialogs": [
              "200160505"
            ]
          },
          "200160505": {
            "id": "200160505",
            "speakerId": 1002,
            "speakerName": "Timid Morrow",
            "text": "Ugh, whatever. Here's your money. Now get outta here, let me eat my food in peace."
          }
        }
      }
    },
    {
      "subId": "2001606",
      "subQuestName": "Buyer determiner 3",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200160701"
        ],
        "dialogs": {
          "200160701": {
            "id": "200160701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Excuse me, did you order some takeout?",

{
  "lineCounts": {
    "Black Screen": 4,
    "Paimon": 8,
    "Player": 15,
    "Sabbah": 66
  },
  "subQuests": [
    {
      "subId": "7320307",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731930501"
        ],
        "dialogs": {
          "731930501": {
            "id": "731930501",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "If it weren't for you, I don't think I'd have ever seen these roses sprout.",
            "nextDialogs": [
              "731930502"
            ]
          },
          "731930502": {
            "id": "731930502",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "If only I knew this would happen... instead of seeds, I should have brought a few more books.",
            "nextDialogs": [
              "731930504",
              "731930520"
            ]
          },
          "731930504": {
            "id": "731930504",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Are you surprised? Well, I guess that means that I've adapted pretty well.",
            "nextDialogs": [
              "731930505"
            ]
          },
          "731930505": {
            "id": "731930505",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "When I first got here, I was unable to get used to anything, whether it be the food, the housing, or anything else.",
            "nextDialogs": [
              "731930506"
            ]
          },
          "731930506": {
            "id": "731930506",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "But I got used to everything over time.",
            "nextDialogs": [
              "731930507"
            ]
          },
          "731930507": {
            "id": "731930507",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "That doesn't mean that I've fully accepted my predicament, though.",
            "nextDialogs": [
              "731930508"
            ]
          },
          "731930508": {
            "id": "731930508",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I suppose it is impossible to make roses from Sumeru City bloom here after all.",
            "nextDialogs": [
              "731930509"
            ]
          },
          "731930509": {
            "id": "731930509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you a researcher?",
            "nextDialogs": [
              "731930510"
            ]
          },
          "731930510": {
            "id": "731930510",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I could have been called that once, but not anymore.",
            "nextDialogs": [
              "731930511"
            ]
          },
          "731930511": {
            "id": "731930511",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I said something beyond my station, and learned something I shouldn't have.",
            "nextDialogs": [
              "731930512"
            ]
          },
          "731930512": {
            "id": "731930512",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I broke the Akademiya's taboos, so I was removed from amongst their ranks.",
            "nextDialogs": [
              "731930513"
            ]
          },
          "731930513": {
            "id": "731930513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What did you say?",
            "nextDialogs": [
              "731930514"
            ]
          },
          "731930514": {
            "id": "731930514",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Curiosity is the impetus for seeking wisdom, but it's also the cause of sin.",
            "nextDialogs": [
              "731930515"
            ]
          },
          "731930515": {
            "id": "731930515",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I only understood that after I was exiled to this place.",
            "nextDialogs": [
              "731930516"
            ]
          },
          "731930516": {
            "id": "731930516",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "For safety reasons, I don't think I should go into details.",
            "nextDialogs": [
              "731930517"
            ]
          },
          "731930517": {
            "id": "731930517",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "All right then.",
            "nextDialogs": [
              "731930518"
            ]
          },
          "731930518": {
            "id": "731930518",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Ahem, but...",
            "nextDialogs": [
              "731930535"
            ]
          },
          "731930535": {
            "id": "731930535",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I thought adventurers would just come and go, never coming back to chit-chat after finishing their jobs.",
            "nextDialogs": [
              "731930536"
            ]
          },
          "731930536": {
            "id": "731930536",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I didn't expect to have another long conversation with you.",
            "nextDialogs": [
              "731930537"
            ]
          },
          "731930537": {
            "id": "731930537",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "To be honest, I don't have a lot of friends to talk to here.",
            "nextDialogs": [
              "731930538"
            ]
          },
          "731930538": {
            "id": "731930538",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Do you think... at some point... you would be able to come by and fertilize my plants again?",
            "nextDialogs": [
              "731930539"
            ]
          },
          "731930539": {
            "id": "731930539",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure.",
            "nextDialogs": [
              "731930540"
            ]
          },
          "731930540": {
            "id": "731930540",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "...Okay then, I'll wait for you."
          },
          "731930520": {
            "id": "731930520",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "You probably don't know much about them... but they are very versatile, and have many uses.",
            "nextDialogs": [
              "731930521"
            ]
          },
          "731930521": {
            "id": "731930521",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "They can be eaten, turned into medicine, given as gifts, or fetch a good price on the market.",
            "nextDialogs": [
              "731930522"
            ]
          },
          "731930522": {
            "id": "731930522",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "And that's just some of the more common applications.",
            "nextDialogs": [
              "731930523"
            ]
          },
          "731930523": {
            "id": "731930523",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "The flower, leaves, and stalk of a Sumeru Rose also did not always look like this. They all had different appearances once upon a time.",
            "nextDialogs": [
              "731930524"
            ]
          },
          "731930524": {
            "id": "731930524",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I believe geographical changes led to changes in the roses' traits.",
            "nextDialogs": [
              "731930525"
            ]
          },
          "731930525": {
            "id": "731930525",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "A study of its traits could help us derive past geographical and historical information.",
            "nextDialogs": [
              "731930526"
            ]
          },
          "731930526": {
            "id": "731930526",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I won't be able to explain the mechanism over just a casual conversation, and sharing such information with adventurers is probably against the rules as well.",
            "nextDialogs": [
              "731930527"
            ]
          },
          "731930527": {
            "id": "731930527",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "If you're interested in botanical evolution, you should visit the Akademiya. They'll have more on the subject.",
            "nextDialogs": [
              "731930528"
            ]
          },
          "731930528": {
            "id": "731930528",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, you're doing this for your research?",
            "nextDialogs": [
              "731930529"
            ]
          },
          "731930529": {
            "id": "731930529",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I'm not a researcher anymore. I no longer have the right or means to pursue any research.",
            "nextDialogs": [
              "731930530"
            ]
          },
          "731930530": {
            "id": "731930530",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "If you must know why... *sigh*, you are a very curious soul, you know that?",
            "nextDialogs": [
              "731930531"
            ]
          },
          "731930531": {
            "id": "731930531",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I grew a lot of Sumeru Roses back in my former residence. The flowers were spectacular, and I got to see them every day.",
            "nextDialogs": [
              "731930532"
            ]
          },
          "731930532": {
            "id": "731930532",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "If it was possible, I wish I could see them again, just like before.",
            "nextDialogs": [
              "731930533"
            ]
          },
          "731930533": {
            "id": "731930533",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "...That's all there is to it.",
            "nextDialogs": [
              "731930534"
            ]
          },
          "731930534": {
            "id": "731930534",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I can understand that."
          }
        }
      }
    },
    {
      "subId": "7320301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732030101"
        ],
        "dialogs": {
          "732030101": {
            "id": "732030101",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "There you are. You're very punctual.",
            "nextDialogs": [
              "732030102"
            ]
          },
          "732030102": {
            "id": "732030102",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I made some Butter Chicken. You're welcome to dine with me if you're hungry.",
            "nextDialogs": [
              "732030103"
            ]
          },
          "732030103": {
            "id": "732030103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Butter Chicken! How could we refuse? A big plate for Paimon, please!",
            "nextDialogs": [
              "732030106"
            ]
          },
          "732030106": {
            "id": "732030106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay, sorry...",
            "nextDialogs": [
              "732030107"
            ]
          },
          "732030107": {
            "id": "732030107",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "It's okay, there's no need to be so formal. It's only human nature to love food.",
            "nextDialogs": [
              "732030108"
            ]
          },
          "732030108": {
            "id": "732030108",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I'll heat some up and pack it for you. It's the least I could do to show my gratitude for your help.",
            "nextDialogs": [
              "732030109"
            ]
          },
          "732030109": {
            "id": "732030109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're so nice, Miss Sabbah! Your roses will surely grow and flower, just like you wanted!",
            "nextDialogs": [
              "732030110"
            ]
          },
          "732030110": {
            "id": "732030110",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Well, I've been keeping the soil moist, so the sprouts have been coming along.",
            "nextDialogs": [
              "732030111"
            ]
          },
          "732030111": {
            "id": "732030111",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "My only worry is that they are growing slowly.",
            "nextDialogs": [
              "732030112"
            ]
          },
          "732030112": {
            "id": "732030112",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Generally speaking, if a germ is in good shape, it should grow quickly enough, but these few have been dormant so far...",
            "nextDialogs": [
              "732030113"
            ]
          },
          "732030113": {
            "id": "732030113",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I'm not sure if it's because the soil isn't fertile enough. I may have to add more fertilizer if this keeps up."
          }
        }
      }
    },
    {
      "subId": "7320302",
      "subQuestName": "Use the power of Dendro to \"fertilize\" the sprouts",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7320303",
      "subQuestName": "Talk to Sabbah",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732030301"
        ],
        "dialogs": {
          "732030301": {
            "id": "732030301",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Thank you again. Honestly, it gladdens my heart to see Sumeru Roses grow in this environment.",
            "nextDialogs": [
              "732030302"
            ]
          },
          "732030302": {
            "id": "732030302",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "As you talk to Sabbah, new leaves begin to sprout...",
            "nextDialogs": [
              "732030303"
            ]
          },
          "732030303": {
            "id": "732030303",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The leaves unfold, revealing flower buds.",
            "nextDialogs": [
              "732030304"
            ]
          },
          "732030304": {
            "id": "732030304",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The flower buds slowly open and blossom into Sumeru Roses.",
            "nextDialogs": [
              "732030305"
            ]
          },
          "732030305": {
            "id": "732030305",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Sabbah picks one and hands it to you and Paimon.",
            "nextDialogs": [
              "732030306"
            ]
          },
          "732030306": {
            "id": "732030306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You shouldn't have... You didn't have many to begin with...",
            "nextDialogs": [
              "732030307"
            ]
          },
          "732030307": {
            "id": "732030307",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "It's all right. After all, this wouldn't have been possible without your help.",
            "nextDialogs": [
              "732030310"
            ]
          },
          "732030310": {
            "id": "732030310",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "A rose garden is magnificent, but a single rose also has beauty of its own. I've been intrigued by roses ever since my scholarly days.",
            "nextDialogs": [
              "732030311"
            ]
          },
          "732030311": {
            "id": "732030311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What? You were a researcher?",
            "nextDialogs": [
              "732030312"
            ]
          },
          "732030312": {
            "id": "732030312",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Right, I haven't told you yet... I'm not a native of Aaru Village. I \"moved\" here from the Akademiya.",
            "nextDialogs": [
              "732030313"
            ]
          },
          "732030313": {
            "id": "732030313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "See, didn't Paimon tell you that Miss Sabbah speaks in a refined way, just like the researchers we've met?",
            "nextDialogs": [
              "732030314"
            ]
          },
          "732030314": {
            "id": "732030314",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You planted these because you wanted to continue studying roses, right?",
            "nextDialogs": [
              "732030315"
            ]
          },
          "732030315": {
            "id": "732030315",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I wouldn't say that. To be honest, I don't think that researchers' interest in their subjects should be cultivated just for research's sake alone.",
            "nextDialogs": [
              "732030316"
            ]
          },
          "732030316": {
            "id": "732030316",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I did this because I love this world and want to understand the life cycle of plants.",
            "nextDialogs": [
              "732030317"
            ]
          },
          "732030317": {
            "id": "732030317",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "As for me, I once studied the impact of geographical changes on the evolution of roses.",
            "nextDialogs": [
              "732030318"
            ]
          },
          "732030318": {
            "id": "732030318",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Just consider this. If the environments in Sumeru had changed in a totally different way, how would these roses have adapted?",
            "nextDialogs": [
              "732030319"
            ]
          },
          "732030319": {
            "id": "732030319",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Would they have crawled up the walls like ivy? If so, the walls of the Akademiya would now be covered in roses.",
            "nextDialogs": [
              "732030320"
            ]
          },
          "732030320": {
            "id": "732030320",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Would they have formed clusters? A natural bouquet! Wouldn't that have been lovely?",
            "nextDialogs": [
              "732030321"
            ]
          },
          "732030321": {
            "id": "732030321",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Maybe they might have even developed a spectrum of colors... White, red, and gold... Brand new species in their own right.",
            "nextDialogs": [
              "732030322"
            ]
          },
          "732030322": {
            "id": "732030322",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Of course, very few people discover new species nowadays, much less develop new species like the top researchers used to do.",
            "nextDialogs": [
              "732030323"
            ]
          },
          "732030323": {
            "id": "732030323",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "What I want to say is that there's a vast amount of potential in every rose.",
            "nextDialogs": [
              "732030324"
            ]
          },
          "732030324": {
            "id": "732030324",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Exploring the possibilities is a lot of fun for me. Back then, I would happily collect samples every day.",
            "nextDialogs": [
              "732030325"
            ]
          },
          "732030325": {
            "id": "732030325",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Looking back now, that was a simple and joyful time.",
            "nextDialogs": [
              "732030326"
            ]
          },
          "732030326": {
            "id": "732030326",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Anyway, just take it. To me, this is no loss. I am freely sharing my happiness.",
            "nextDialogs": [
              "732030327"
            ]
          },
          "732030327": {
            "id": "732030327",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "If you still feel awkward, just visit me often, and bring some Sumeru Roses with you.",
            "nextDialogs": [
              "732030328"
            ]
          },
          "732030328": {
            "id": "732030328",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I feel at ease when I talk to you.",
            "nextDialogs": [
              "732030329"
            ]
          },
          "732030329": {
            "id": "732030329",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "And no matter what I said, you never thought it was nonsense or interrupted me.",
            "nextDialogs": [
              "732030330"
            ]
          },
          "732030330": {
            "id": "732030330",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I'll have small gifts for you too. Though I have no use for them now, you might like them.",
            "nextDialogs": [
              "732030331"
            ]
          },
          "732030331": {
            "id": "732030331",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll be back.",
            "nextDialogs": [
              "732030332"
            ]
          },
          "732030332": {
            "id": "732030332",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Please do return."
          }
        }
      }
    },
    {
      "subId": "7320306",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732030601"
        ],
        "dialogs": {
          "732030601": {
            "id": "732030601",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Here for a chat? I've been wanting to talk to somebody."
          }
        }
      }
    },
    {
      "subId": "7320304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732030401"
        ],
        "dialogs": {
          "732030401": {

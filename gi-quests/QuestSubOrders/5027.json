  "subQuests": [
    {
      "subId": "502701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50270101"
        ],
        "dialogs": {
          "50270101": {
            "id": "50270101",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Whoa, our Archon really is amazing! And super brave, too. She even went toe to toe with Lord Xbalanque!",
            "nextDialogs": [
              "50270102"
            ]
          },
          "50270102": {
            "id": "50270102",
            "speakerId": 1088,
            "speakerName": "Kinich",
            "text": "Don't be so modest. You'd have done the same.",
            "nextDialogs": [
              "50270103"
            ]
          },
          "50270103": {
            "id": "50270103",
            "speakerId": 14221,
            "speakerName": "Ajaw",
            "text": "Hah, like any of us wouldn't! I'd have jumped at the chance! What about you?",
            "nextDialogs": [
              "50270104"
            ]
          },
          "50270104": {
            "id": "50270104",
            "speakerId": 1086,
            "speakerName": "Kachina",
            "text": "I... I wouldn't dare!",
            "nextDialogs": [
              "50270105"
            ]
          },
          "50270105": {
            "id": "50270105",
            "speakerId": 1088,
            "speakerName": "Kinich",
            "text": "Fighting is in a warrior's nature. If the opportunity was presented to you, I'm sure your instincts would make that choice for you.",
            "nextDialogs": [
              "50270106"
            ]
          },
          "50270106": {
            "id": "50270106",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "*sigh* I swear, you're all just brimming with energy over here... This is Lord Xbalanque we're talking about. Our greatest ancestor! Are you really that into sparring with your elders?",
            "nextDialogs": [
              "50270107"
            ]
          },
          "50270107": {
            "id": "50270107",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "Granny Citlali! Let's spar sometime, too!",
            "nextDialogs": [
              "50270108"
            ]
          },
          "50270108": {
            "id": "50270108",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "No, no, we're absolutely not doing that."
          }
        }
      }
    },
    {
      "subId": "502702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50270201"
        ],
        "dialogs": {
          "50270201": {
            "id": "50270201",
            "speakerId": 14985,
            "speakerName": "Mausau",
            "text": "Say, what kind of vegetable do you think I'll become? A red one, or... a green one?",
            "nextDialogs": [
              "50270202"
            ]
          },
          "50270202": {
            "id": "50270202",
            "speakerId": 1094,
            "speakerName": "Ororon",
            "text": "You? I have a feeling... that you might turn into an onion.",
            "nextDialogs": [
              "50270203"
            ]
          },
          "50270203": {
            "id": "50270203",
            "speakerId": 14985,
            "speakerName": "Mausau",
            "text": "An onion?",
            "nextDialogs": [
              "50270204"
            ]
          },
          "50270204": {
            "id": "50270204",
            "speakerId": 1094,
            "speakerName": "Ororon",
            "text": "Someone who looks ordinary, but who can make anyone who attacks you break down and weep.",
            "nextDialogs": [
              "50270205"
            ]
          },
          "50270205": {
            "id": "50270205",
            "speakerId": 14985,
            "speakerName": "Mausau",
            "text": "Really? That sounds super strong...",
            "nextDialogs": [
              "50270206"
            ]
          },
          "50270206": {
            "id": "50270206",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "What are those two even talking about...",
            "nextDialogs": [
              "50270207"
            ]
          },
          "50270207": {
            "id": "50270207",
            "speakerId": 1094,
            "speakerName": "Ororon",
            "text": "Onions are super powerful. One of my friends happened to be cutting onions when I came over to his house. He began to cry, and the Saurians also began to cry, and eventually, nearly every living creature in the room was crying.",
            "nextDialogs": [
              "50270208"
            ]
          },
          "50270208": {
            "id": "50270208",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "What about you? Did you cry too?",
            "nextDialogs": [
              "50270209"
            ]
          },
          "50270209": {
            "id": "50270209",
            "speakerId": 1094,
            "speakerName": "Ororon",
            "text": "I was also in the room, but I shielded my eyes with my cloak just in time. Cacucu and Ifa couldn't see my face, so they thought I cried too.",
            "nextDialogs": [
              "50270210"
            ]
          },
          "50270210": {
            "id": "50270210",
            "speakerId": 14985,
            "speakerName": "Mausau",
            "text": "I'd like to become an onion-man, and make people cry too!",
            "nextDialogs": [
              "50270211"
            ]
          },
          "50270211": {
            "id": "50270211",
            "speakerId": 1094,
            "speakerName": "Ororon",
            "text": "Sure, no problem.",
            "nextDialogs": [
              "50270212"
            ]
          },
          "50270212": {
            "id": "50270212",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "I really want to interrupt you, but I have no clue what to say to derail this line of conversation...",
            "nextDialogs": [
              "50270213"
            ]
          },
          "50270213": {
            "id": "50270213",
            "speakerId": 1094,
            "speakerName": "Ororon",
            "text": "Well, Iansan, you're a tiny... mushroom. Yes.",
            "nextDialogs": [
              "50270214"
            ]
          },
          "50270214": {
            "id": "50270214",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "No one asked you!",
            "nextDialogs": [
              "50270215"
            ]
          },
          "50270215": {
            "id": "50270215",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "Although... mushrooms are pretty resilient, I guess... Okay, I approve.",
            "nextDialogs": [
              "50270216"
            ]
          },
          "50270216": {
            "id": "50270216",
            "speakerId": 14985,
            "speakerName": "Mausau",
            "text": "Then you must be full of life too, right, Miss?",
            "nextDialogs": [
              "50270217"
            ]
          },
          "50270217": {
            "id": "50270217",
            "speakerId": 1094,
            "speakerName": "Ororon",
            "text": "Yes she is.",
            "nextDialogs": [
              "50270218"
            ]
          },
          "50270218": {
            "id": "50270218",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "Yeah... Sure, why not?"
          }
        }
      }
    }
  ]
}
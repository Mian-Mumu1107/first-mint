  "subQuests": [
    {
      "subId": "7303201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730320101"
        ],
        "dialogs": {
          "730320101": {
            "id": "730320101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're back, Araja!",
            "nextDialogs": [
              "730320102"
            ]
          },
          "730320102": {
            "id": "730320102",
            "speakerId": 4184,
            "speakerName": "Araja",
            "text": "Finally! Everyone's been waiting!",
            "nextDialogs": [
              "730320103"
            ]
          },
          "730320103": {
            "id": "730320103",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Festival Utsava has started, but it's not in full swing yet since Nara friends didn't get back till now.",
            "nextDialogs": [
              "730320107",
              "730320106"
            ]
          },
          "730320107": {
            "id": "730320107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#It's been a real grind adventuring like this huh. Let's just enjoy the festivities right now, {NICKNAME}!",
            "nextDialogs": [
              "730320108"
            ]
          },
          "730320108": {
            "id": "730320108",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#Yes, you must enjoy yourselves, Nara {NICKNAME} and Paimon.",
            "nextDialogs": [
              "730320109"
            ]
          },
          "730320109": {
            "id": "730320109",
            "speakerId": 4184,
            "speakerName": "Araja",
            "text": "Yes. I'll see you later."
          },
          "730320106": {
            "id": "730320106",
            "speakerId": 4184,
            "speakerName": "Araja",
            "text": "As far as I know, yes."
          }
        }
      }
    },
    {
      "subId": "7303203",
      "subQuestName": "Enjoy Festival Utsava with Aranara in the Vanarana in the dream",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730320301"
        ],
        "dialogs": {
          "730320301": {
            "id": "730320301",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "The Aranara disperse following the duet.",
            "nextDialogs": [
              "730320302"
            ]
          },
          "730320302": {
            "id": "730320302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, that was great! Your playing and the Aranara song were both awesome!",
            "nextDialogs": [
              "730320303"
            ]
          },
          "730320303": {
            "id": "730320303",
            "speakerId": 20666,
            "speakerName": "Arasudraka",
            "text": "#Yeah, Nara {NICKNAME} is awesome! I'd love to travel with you and remember your songs!",
            "nextDialogs": [
              "730320307"
            ]
          },
          "730320307": {
            "id": "730320307",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "#Such a radiant melody. How exciting! Nara {NICKNAME} and Paimon, and your song... What an epic tale!",
            "nextDialogs": [
              "730320308"
            ]
          },
          "730320308": {
            "id": "730320308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not calling me \"Golden Nara\" anymore?",
            "nextDialogs": [
              "730320309"
            ]
          },
          "730320309": {
            "id": "730320309",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "I'm short on experience, but if the stories were true, the glow from Nara Varuna's song might have been dimmer than yours!",
            "nextDialogs": [
              "730320310"
            ]
          },
          "730320310": {
            "id": "730320310",
            "speakerId": 20667,
            "speakerName": "Aradasa",
            "text": "♪~",
            "nextDialogs": [
              "730320311"
            ]
          },
          "730320311": {
            "id": "730320311",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "#Aradasa is right. Please take these as tokens of our appreciation, Nara {NICKNAME} and Paimon.",
            "nextDialogs": [
              "730320312"
            ]
          },
          "730320312": {
            "id": "730320312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, this is a lot of flowers...",
            "nextDialogs": [
              "730320313"
            ]
          },
          "730320313": {
            "id": "730320313",
            "speakerId": 20665,
            "speakerName": "Arayasa",
            "text": "\"Even though the horizon is so gray, it's such a blessing to meet you...\"",
            "nextDialogs": [
              "730320314"
            ]
          },
          "730320314": {
            "id": "730320314",
            "speakerId": 20667,
            "speakerName": "Aradasa",
            "text": "\"...Singing your song forever is the pact between you and me.\""
          }
        }
      }
    },
    {
      "subId": "7303212",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730321201"
        ],
        "dialogs": {
          "730321201": {
            "id": "730321201",
            "speakerId": 20715,
            "speakerName": "Aranishat",
            "text": "Aralila, Nara have a incantation to find Nara in hiding. It goes like this: \"Curry, curry in the air~ Hungry children it's time to come home~♪\"",
            "nextDialogs": [
              "730321202"
            ]
          },
          "730321202": {
            "id": "730321202",
            "speakerId": 20714,
            "speakerName": "Aralila",
            "text": "But what's curry?",
            "nextDialogs": [
              "730321203"
            ]
          },
          "730321203": {
            "id": "730321203",
            "speakerId": 20715,
            "speakerName": "Aranishat",
            "text": "Oh, I don't know. But I heard little Nara will come when they hear this incantation! So, you can try it if you're looking for little Nara!"
          }
        }
      }
    },
    {
      "subId": "7303213",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730321301"
        ],
        "dialogs": {
          "730321301": {
            "id": "730321301",
            "speakerId": 20777,
            "speakerName": "Araesha",
            "text": "Festival Utsava will have Araesha's tasty riddles, which are also sweet and fragrant! I heard that Nara like sweet and fragrant things...",
            "nextDialogs": [
              "730321302"
            ]
          },
          "730321302": {
            "id": "730321302",
            "speakerId": 20777,
            "speakerName": "Araesha",
            "text": "So you'll love this sweet and fragrant Festival Utsava, right, Nara?"
          }
        }
      }
    },
    {
      "subId": "7303214",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730321401"
        ],
        "dialogs": {
          "730321401": {
            "id": "730321401",
            "speakerId": 20716,
            "speakerName": "Arakanta",
            "text": "Thank you, Nara! Arakanta is so happy!"
          }
        }
      }
    },
    {
      "subId": "7303215",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730321501"
        ],
        "dialogs": {
          "730321501": {
            "id": "730321501",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "#Oh? It's Nara {NICKNAME}! We learned many lost tunes thanks to you, Paimon, and Arama.",
            "nextDialogs": [
              "730321502"
            ]
          },
          "730321502": {
            "id": "730321502",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "You're well acquainted with the art of singing, right?",
            "nextDialogs": [
              "730321507",
              "730321506"
            ]
          },
          "730321507": {
            "id": "730321507",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "Then please... What was the Nara phrase again? \"Let me borrow your ears\"... or something like that."
          },
          "730321506": {
            "id": "730321506",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "#Hahaha, Nara {NICKNAME}'s really funny."
          }
        }
      }
    },
    {
      "subId": "7303216",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730321601"
        ],
        "dialogs": {
          "730321601": {
            "id": "730321601",
            "speakerId": 20665,
            "speakerName": "Arayasa",
            "text": "#\"Even if you cover {M#her}{F#his} eyes in gloom, you can't take away the light from {M#her}{F#his} heart...\""
          }
        }
      }
    },
    {
      "subId": "7303217",

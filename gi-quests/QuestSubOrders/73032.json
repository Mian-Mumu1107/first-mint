    {
      "subId": "7303208",
      "subQuestName": "Head to Araja's house to rest",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730320801"
        ],
        "dialogs": {
          "730320801": {
            "id": "730320801",
            "speakerId": 20607,
            "speakerName": "Aranakula",
            "text": "#This feels just like the time Nara Varuna celebrated Festival Utsava with Aranara all over again... Aranakula hasn't been so happy in a very long time, Nara {NICKNAME}. *sob*",
            "nextDialogs": [
              "730320802"
            ]
          },
          "730320802": {
            "id": "730320802",
            "speakerId": 20816,
            "speakerName": "Arakara",
            "text": "Viparyas hate tears. Festival Utsava is a happy festival. Aranakula will play a happy song for Viparyas!"
          }
        }
      }
    },

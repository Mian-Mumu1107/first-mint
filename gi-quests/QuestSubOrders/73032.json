        ],
        "dialogs": {
          "730322801": {
            "id": "730322801",
            "speakerId": 20667,
            "speakerName": "Aradasa",
            "text": "♪~"
          }
        }
      }
    },
    {
      "subId": "7303229",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730322901"
        ],
        "dialogs": {
          "730322901": {
            "id": "730322901",
            "speakerId": 20648,
            "speakerName": "Araja",
            "text": "You go get some rest. I want to stay and reminisce a little."
          }
        }
      }
    },
    {
      "subId": "7303230",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730323001"
        ],
        "dialogs": {
          "730323001": {
            "id": "730323001",
            "speakerId": 16767,
            "speakerName": "Ararycan",
            "text": "#Thank you, Nara {NICKNAME} and Paimon. Later, Ararycan will return to the bad dirty stuff, and see if anything bad happens.",
            "nextDialogs": [
              "730323002"
            ]
          },
          "730323002": {
            "id": "730323002",
            "speakerId": 16767,
            "speakerName": "Ararycan",
            "text": "#Ararycan is a good friend to Nara {NICKNAME} and Paimon, forever!"
          }
        }
      }
    },
    {
      "subId": "7303231",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730323101"
        ],
        "dialogs": {
          "730323101": {
            "id": "730323101",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "Aranakin, Aranaga, my heart feels empty. Have I forgotten something?",
            "nextDialogs": [
              "730323102"
            ]
          },
          "730323102": {
            "id": "730323102",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Aragaru is \"hungry\" just like Nara?",
            "nextDialogs": [
              "730323103"
            ]
          },
          "730323103": {
            "id": "730323103",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "What is it... Can't remember..."
          }
        }
      }
    },

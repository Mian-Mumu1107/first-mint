    },
    {
      "subId": "7303222",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730322201"
        ],
        "dialogs": {
          "730322201": {
            "id": "730322201",
            "speakerId": 20665,
            "speakerName": "Arayasa",
            "text": "\"This is our song...\""
          }
        }
      }
    },
    {
      "subId": "7303207",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730320701"
        ],
        "dialogs": {
          "730320701": {
            "id": "730320701",
            "speakerId": 20605,
            "speakerName": "Arapandu",
            "text": "The last time we had such a lively Festival Utsava was when Nara Varuna came to Vanarana...",
            "nextDialogs": [
              "730320702"
            ]
          },
          "730320702": {
            "id": "730320702",
            "speakerId": 16769,
            "speakerName": "Arabalika",
            "text": "The festival may be fun, but nothing lasts forever.",
            "nextDialogs": [
              "730320703"
            ]
          },
          "730320703": {
            "id": "730320703",
            "speakerId": 20608,
            "speakerName": "Arakunti",
            "text": "Just like how Nilotpala Lotuses in the water never stay in bloom. They must always close sometime."
          }
        }
      }
    },
    {
      "subId": "7303210",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730321001"
        ],
        "dialogs": {
          "730321001": {
            "id": "730321001",
            "speakerId": 4185,
            "speakerName": "Ararycan",
            "text": "#Thank you, Nara {NICKNAME} and Paimon, for coming to Vanarana and celebrating Festival Utsava with us Aranara.",
            "nextDialogs": [
              "730321002"
            ]
          },
          "730321002": {
            "id": "730321002",
            "speakerId": 4185,
            "speakerName": "Ararycan",
            "text": "Ararycan wants to spend more time together with you, good friends..."
          }
        }
      }
    },
    {
      "subId": "7303224",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730322401"
        ],
        "dialogs": {
          "730322401": {
            "id": "730322401",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#Yes! You will be fine, Nara {NICKNAME}! Hearing your song gives us courage to even face Marana!"
          }
        }
      }
    },
    {
      "subId": "7303225",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730322501"
        ],
        "dialogs": {
          "730322501": {
            "id": "730322501",
            "speakerId": 20656,
            "speakerName": "Arakavi",
            "text": "*sigh* This is great..."
          }
        }
      }
    },
    {
      "subId": "7303226",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730322601"
        ],
        "dialogs": {
          "730322601": {
            "id": "730322601",
            "speakerId": 20666,
            "speakerName": "Arasudraka",
            "text": "As long as your heart emits golden and warm lights like the sun, there will always be hope!"
          }
        }
      }
    },
    {
      "subId": "7303227",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730322701"
        ],
        "dialogs": {
          "730322701": {
            "id": "730322701",
            "speakerId": 20665,
            "speakerName": "Arayasa",
            "text": "\"...Singing your song forever is the pact between you and me.\""
          }
        }
      }
    },
    {
      "subId": "7303228",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

  "subQuests": [
    {
      "subId": "7210335",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721033501"
        ],
        "dialogs": {
          "721033501": {
            "id": "721033501",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "You want a fortune slip?",
            "nextDialogs": [
              "721033502"
            ]
          },
          "721033502": {
            "id": "721033502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Geez, she's so cold.",
            "nextDialogs": [
              "721033503"
            ]
          },
          "721033503": {
            "id": "721033503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, I'd like one...",
            "nextDialogs": [
              "721033504"
            ]
          },
          "721033504": {
            "id": "721033504",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Got it. Here's how it goes. First, shake this... thing over here.",
            "nextDialogs": [
              "721033505"
            ]
          },
          "721033505": {
            "id": "721033505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Isn't it called a Fortune Slip Box?",
            "nextDialogs": [
              "721033506"
            ]
          },
          "721033506": {
            "id": "721033506",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Yes. A Bamboo Slip will drop out from it. Give it to me, and I'll give you a matching strip of paper.",
            "nextDialogs": [
              "721033507"
            ]
          },
          "721033507": {
            "id": "721033507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm pretty sure they say it's a Fortune Slip...",
            "nextDialogs": [
              "721033508"
            ]
          },
          "721033508": {
            "id": "721033508",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Whatever.",
            "nextDialogs": [
              "721033509"
            ]
          },
          "721033509": {
            "id": "721033509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's got a question! If... What do we do if we get one that means bad luck?",
            "nextDialogs": [
              "721033510"
            ]
          },
          "721033510": {
            "id": "721033510",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "It's fate. You got a problem with that? Huh?",
            "nextDialogs": [
              "721033511"
            ]
          },
          "721033511": {
            "id": "721033511",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh!?",
            "nextDialogs": [
              "721033512"
            ]
          },
          "721033512": {
            "id": "721033512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Isn't there that shelf-like thing outside we can use to...",
            "nextDialogs": [
              "721033513"
            ]
          },
          "721033513": {
            "id": "721033513",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Tsk.",
            "nextDialogs": [
              "721033514"
            ]
          },
          "721033514": {
            "id": "721033514",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did she seriously just say \"tsk\"?",
            "nextDialogs": [
              "721033515"
            ]
          },
          "721033515": {
            "id": "721033515",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Let me see... Oh right, so it's like this. \"Tie the inauspicious slip onto the Fortune Slip Hanger to change ill fortune to good\"...",
            "nextDialogs": [
              "721033516"
            ]
          },
          "721033516": {
            "id": "721033516",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Ah, right! If you get a slip with ill fortune, just tie it to that shelf, that'll do.",
            "nextDialogs": [
              "721033517"
            ]
          },
          "721033517": {
            "id": "721033517",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Huh, what a bunch of... No, sorry. We at the Grand Narukami Shrine are most gentle indeed. Even if you should draw a slip with bad luck, you shall have a chance to turn it around.",
            "nextDialogs": [
              "721033518"
            ]
          },
          "721033518": {
            "id": "721033518",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Something about this doesn't seem right...",
            "nextDialogs": [
              "721033519"
            ]
          },
          "721033519": {
            "id": "721033519",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Let's go draw a fortune slip, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "7210336",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721033601"
        ],
        "dialogs": {
          "721033601": {
            "id": "721033601",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Give me that bamboo slip.",
            "nextDialogs": [
              "721033602"
            ]
          },
          "721033602": {
            "id": "721033602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "R—Right.",
            "nextDialogs": [
              "721033603"
            ]
          },
          "721033603": {
            "id": "721033603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This shrine really seems to lack the whole divine affection thing, huh...",
            "nextDialogs": [
              "721033604"
            ]
          },
          "721033604": {
            "id": "721033604",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Here.",
            "nextDialogs": [
              "721033605"
            ]
          },
          "721033605": {
            "id": "721033605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's see how our luck's going...",
            "nextDialogs": [
              "721033606"
            ]
          },
          "721033606": {
            "id": "721033606",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Ah, yes. You can only draw one fortune slip each day. Please remember that.",
            "nextDialogs": [
              "721033607"
            ]
          },
          "721033607": {
            "id": "721033607",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "It's too tiring otherwise... Wait, no. If not, you won't be able to use the Fortune Slip Hanger to... No, that's not right either. What was I supposed to say?",
            "nextDialogs": [
              "721033608"
            ]
          },
          "721033608": {
            "id": "721033608",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "\"Fortune slips are the manifestation of our archon's will. It is our place as mortals to respect it and do all we can.\"",
            "nextDialogs": [
              "721033609"
            ]
          },
          "721033609": {
            "id": "721033609",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "See? Elegantly put. So please remember, you can only draw one fortune slip each day."
          }
        }
      }
    },
    {
      "subId": "7210315",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721031901"
        ],
        "dialogs": {
          "721031901": {
            "id": "721031901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#(Hey, {NICKNAME}!)",
            "nextDialogs": [
              "721031902"
            ]
          },
          "721031902": {
            "id": "721031902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(According to that Ms. Gendou, this Ms. Gendou is...)",
            "nextDialogs": [
              "721031903"
            ]
          },
          "721031903": {
            "id": "721031903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Yeah, a Fatui knockoff.)",
            "nextDialogs": [
              "721031904"
            ]
          },
          "721031904": {
            "id": "721031904",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Ah, we meet again. Want to check your fortune as well? Or...",
            "nextDialogs": [
              "721031905"
            ]
          },
          "721031905": {
            "id": "721031905",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "If you need a listening ear or if you have something to discuss, I can help too.",
            "nextDialogs": [
              "721031908"
            ]
          },
          "721031908": {
            "id": "721031908",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ms. Gendou is so friendly!",
            "nextDialogs": [
              "721031909"
            ]
          },
          "721031909": {
            "id": "721031909",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Is that so? Hehe, that's what many people have told me lately. It feels good.",
            "nextDialogs": [
              "721031910"
            ]
          },
          "721031910": {
            "id": "721031910",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "It's always been my dream to work at a beautiful shrine like this.",
            "nextDialogs": [
              "721031911"
            ]
          },
          "721031911": {
            "id": "721031911",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Yeah, she's a Fatui knockoff.)",
            "nextDialogs": [
              "721031912"
            ]
          },
          "721031912": {
            "id": "721031912",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(Still, she seems like she actually enjoys this job.)"
          }
        }
      }
    },

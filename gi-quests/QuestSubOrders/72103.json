    {
      "subId": "7210337",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721033701"
        ],
        "dialogs": {
          "721033701": {
            "id": "721033701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "In the middle of a hazy night.",
            "nextDialogs": [
              "721033702"
            ]
          },
          "721033702": {
            "id": "721033702",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Ah, I'm sorry. \"No such thing\" exists at the moment.",
            "nextDialogs": [
              "721033703"
            ]
          },
          "721033703": {
            "id": "721033703",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "You are so reliable... If only the F...",
            "nextDialogs": [
              "721033704"
            ]
          },
          "721033704": {
            "id": "721033704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Fatui?",
            "nextDialogs": [
              "721033705"
            ]
          },
          "721033705": {
            "id": "721033705",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Uh... I mean, \"If only I, the foolish Gendou Ringo, could witness your prowess in combat!\"",
            "nextDialogs": [
              "721033706"
            ]
          },
          "721033706": {
            "id": "721033706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...You will someday, don't worry."
          }
        }
      }
    },
    {
      "subId": "7210338",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721033801"
        ],
        "dialogs": {
          "721033801": {
            "id": "721033801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the strip of paper...",
            "nextDialogs": [
              "721033802"
            ]
          },
          "721033802": {
            "id": "721033802",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Oh, you mean the Fortune Slip? It works like this.",
            "nextDialogs": [
              "721033803"
            ]
          },
          "721033803": {
            "id": "721033803",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "First, you have to shake the Fortune Slip box till a Bamboo Slip falls out. Then, give me the Bamboo Slip and I will give the corresponding Fortune Slip to you.",
            "nextDialogs": [
              "721033804"
            ]
          },
          "721033804": {
            "id": "721033804",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "If it is an inauspicious fortune, you can knot it on the Fortune Slip Hanger to turn bad luck into good luck... That's about all there is to it.",
            "nextDialogs": [
              "721033805"
            ]
          },
          "721033805": {
            "id": "721033805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You know so much.",
            "nextDialogs": [
              "721033806"
            ]
          },
          "721033806": {
            "id": "721033806",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Well, after all, these are... the basic skills of a shrine maiden!"
          }
        }
      }
    },
    {
      "subId": "7210339",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721033901"
        ],
        "dialogs": {
          "721033901": {
            "id": "721033901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Give the Special Bamboo Slip",
            "nextDialogs": [
              "721033902"
            ]
          },
          "721033902": {
            "id": "721033902",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Alright, please pass that Bamboo Slip to me... Huh, actually, you know what? I have the faintest impression that you didn't shake the slip cylinder at all.",
            "nextDialogs": [
              "721033903"
            ]
          },
          "721033903": {
            "id": "721033903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Really? Must've been a trick of the light.",
            "nextDialogs": [
              "721033904"
            ]
          },
          "721033904": {
            "id": "721033904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's right. You just weren't paying attention, Ms. Gendou.",
            "nextDialogs": [
              "721033905"
            ]
          },
          "721033905": {
            "id": "721033905",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "M—Me? Not paying attention? C—Come now, that... that never happened. I just didn't sleep so well last night, that's all. Sorry for worrying you!",
            "nextDialogs": [
              "721033906"
            ]
          },
          "721033906": {
            "id": "721033906",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Here's your Fortune Slip.",
            "nextDialogs": [
              "721033907"
            ]
          },
          "721033907": {
            "id": "721033907",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(How did it go? We should've gotten the powder onto her, right?)",
            "nextDialogs": [
              "721033908"
            ]
          },
          "721033908": {
            "id": "721033908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Without a hitch, Paimon.)",
            "nextDialogs": [
              "721033909"
            ]
          },
          "721033909": {
            "id": "721033909",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Um, why are you two standing there while looking so somber? Did you get a slip with Misfortune on it?",
            "nextDialogs": [
              "721033910"
            ]
          },
          "721033910": {
            "id": "721033910",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No, just a Modest Fortune.",
            "nextDialogs": [
              "721033911"
            ]
          },
          "721033911": {
            "id": "721033911",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Oh, I wouldn't be too sad about that. A Modest Fortune is not bad, either. Perhaps you might encounter some challenges, but I'm sure that there's a happy ending waiting for you on the other side.",
            "nextDialogs": [
              "721033912"
            ]
          },
          "721033912": {
            "id": "721033912",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Someone with a heart as good as yours will definitely see such fortunes through. Well, that's what I believe, at least."
          }
        }
      }
    },
    {
      "subId": "7210340",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721034001"
        ],
        "dialogs": {
          "721034001": {
            "id": "721034001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How've things been going lately?",
            "nextDialogs": [
              "721034002"
            ]
          },
          "721034002": {
            "id": "721034002",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Thanks for your concern. I'm feeling great, really! That I was able to become a real shrine maiden is thanks to your help, and that of many others.",
            "nextDialogs": [
              "721034003"
            ]
          },
          "721034003": {
            "id": "721034003",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "I will stay here, and I will pray for you all in earnest. If you ever have something on your mind, I'll be happy to hear you out.",
            "nextDialogs": [
              "721034004"
            ]
          },
          "721034004": {
            "id": "721034004",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you heard anything from Momoyo?",
            "nextDialogs": [
              "721034005"
            ]
          },
          "721034005": {
            "id": "721034005",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "I fear that Ms. Momoyo had already left by the time I returned to this place, so I missed the opportunity to thank her in person.",
            "nextDialogs": [
              "721034006"
            ]
          },
          "721034006": {
            "id": "721034006",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Still, I believe that we will meet again in future."
          }
        }
      }
    },
    {
      "subId": "7210341",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721034101"
        ],
        "dialogs": {
          "721034101": {
            "id": "721034101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "See you around.",
            "nextDialogs": [
              "721034102"
            ]
          },
          "721034102": {
            "id": "721034102",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "See you! May your day be blessed."
          }
        }
      }
    },
    {
      "subId": "7210342",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721034201"
        ],
        "dialogs": {
          "721034201": {
            "id": "721034201",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "..."
          }
        }
      }
    },
    {
      "subId": "7210343",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721034301"
        ],
        "dialogs": {
          "721034301": {
            "id": "721034301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hey, Ms. Gendou?",
            "nextDialogs": [
              "721034302"
            ]
          },
          "721034302": {
            "id": "721034302",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "#...O—Oh, why, hello, {NICKNAME}! Are you here to decipher your fortune slip today?",
            "nextDialogs": [
              "721034303"
            ]
          },
          "721034303": {
            "id": "721034303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "In the middle of a hazy night.",
            "nextDialogs": [
              "721034304"
            ]
          },
          "721034304": {
            "id": "721034304",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Ah, I'm sorry. \"No such thing\" exists at the moment.",
            "nextDialogs": [
              "721034305"
            ]
          },
          "721034305": {
            "id": "721034305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's been a while since there's been anything, eh?",
            "nextDialogs": [
              "721034306"
            ]
          },
          "721034306": {
            "id": "721034306",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Um, th—that has been case, hasn't it? And perhaps there won't be any in the future ever again, really...",
            "nextDialogs": [
              "721034307"
            ]
          },
          "721034307": {
            "id": "721034307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What did you just say?",
            "nextDialogs": [
              "721034308"
            ]
          },
          "721034308": {
            "id": "721034308",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Um, nothing, nothing! Don't worry about it!"
          }
        }
      }
    }
  ]
}
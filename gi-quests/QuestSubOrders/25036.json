        "startDialogs": [
          "250360301"
        ],
        "dialogs": {
          "250360301": {
            "id": "250360301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I am.",
            "nextDialogs": [
              "250360302"
            ]
          },
          "250360302": {
            "id": "250360302",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "Hmm, resolute and decisive. Quite commendable."
          }
        }
      }
    },
    {
      "subId": "2503604",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250360401"
        ],
        "dialogs": {
          "250360401": {
            "id": "250360401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe in a moment...",
            "nextDialogs": [
              "250360402"
            ]
          },
          "250360402": {
            "id": "250360402",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "Yes, it is not urgent. I can wait."
          }
        }
      }
    },
    {
      "subId": "2503602",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250360201"
        ],
        "dialogs": {
          "250360201": {
            "id": "250360201",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "Are you ready to answer those questions?"
          }
        }
      }
    },
    {
      "subId": "2503611",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250361101"
        ],
        "dialogs": {
          "250361101": {
            "id": "250361101",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "The sounds of the Children of Echoes' hammers ring out ceaselessly among the peaks. They are superlative smiths and tenacious warriors. Even the strongest stone cannot slow their march.",
            "nextDialogs": [
              "250361102"
            ]
          },
          "250361102": {
            "id": "250361102",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "My question is: Who are the companions of the Children of Echoes? What is their true name?",
            "nextDialogs": [
              "250361001",
              "250361002"
            ]
          },
          "250361001": {
            "id": "250361001",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "Indeed, completely flawless. Not a single error."
          },
          "250361002": {
            "id": "250361002",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "Hmm... A minor mistake. Worthy of further consideration."
          }
        }
      }
    },
    {
      "subId": "2503612",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250361201"
        ],
        "dialogs": {
          "250361201": {
            "id": "250361201",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "You have seen those whose entire body is a vibrant green, those who dart atop cliffs and leap amongst the trees, the ones known as Yumkasaurs, yes?",
            "nextDialogs": [
              "250361202"
            ]
          },
          "250361202": {
            "id": "250361202",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "My question is: What is the name of the tribe where the Yumkasaurs live?"
          }
        }
      }
    },
    {
      "subId": "2503613",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250361301"
        ],
        "dialogs": {
          "250361301": {
            "id": "250361301",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "Natlan has a certain thing. It can be used for forging, for the making of records... and it even has different states. Sometimes it is liquid, others solid. Moreover, this thing exists only in Natlan.",
            "nextDialogs": [
              "250361302"
            ]
          },
          "250361302": {
            "id": "250361302",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "My question is: What's the name of that thing?"
          }
        }
      }
    },
    {
      "subId": "2503614",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250361401"
        ],
        "dialogs": {
          "250361401": {
            "id": "250361401",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "Above the flowing springs, on the edge of the crashing waves, there lives a tribe known as the People of the Springs. They are cheerful, kind people, lovers of music, gatherings, and hot springs. Staying with them is sure to bring gladness.",
            "nextDialogs": [
              "250361402"
            ]
          },
          "250361402": {
            "id": "250361402",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "My question is: Who are the companions of the People of the Springs? What is their true name?"
          }
        }
      }
    },
    {
      "subId": "2503615",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250361501"
        ],
        "dialogs": {
          "250361501": {
            "id": "250361501",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "In Natlan, phlogiston may be found in many things — yes, even within certain plants.",
            "nextDialogs": [
              "250361502"
            ]
          },
          "250361502": {
            "id": "250361502",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "My question is: In Natlan, there is a type of mushroom that contains phlogiston. What is its name?"
          }
        }
      }
    },
    {
      "subId": "2503616",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250361601"
        ],
        "dialogs": {
          "250361601": {
            "id": "250361601",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "In Natlan, phlogiston may be found in many things — yes, even in some plants.",
            "nextDialogs": [
              "250361602"
            ]
          },
          "250361602": {
            "id": "250361602",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "My question is: In Natlan, there is a type of flower that contains phlogiston. What is its name?"
          }
        }
      }
    },
    {
      "subId": "2503621",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250362101"
        ],
        "dialogs": {
          "250362101": {
            "id": "250362101",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "Well then, please continue to answer the next question."
          }
        }
      }
    },
    {
      "subId": "2503622",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250362201"
        ],
        "dialogs": {
          "250362201": {
            "id": "250362201",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "Hmm, the final question."
          }
        }
      }
    },
    {
      "subId": "2503623",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250362301"
        ],
        "dialogs": {
          "250362301": {
            "id": "250362301",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "Your answers yet betray errors and flawed understanding, and are far from perfect...",
            "nextDialogs": [
              "250362302"
            ]
          },
          "250362302": {
            "id": "250362302",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "Hmm... You still have much to experience here in Natlan, it seems.",
            "nextDialogs": [
              "250362303"
            ]
          },
          "250362303": {
            "id": "250362303",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "Fret not. The future and past shall become the answers to the present."
          }
        }
      }
    },
    {
      "subId": "2503624",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250362401"
        ],
        "dialogs": {
          "250362401": {
            "id": "250362401",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "Your answers are flawless, perfect, with not a single error.",
            "nextDialogs": [
              "250362402"
            ]
          },
          "250362402": {
            "id": "250362402",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "May wisdom accompany you throughout your journey.",
            "nextDialogs": [
              "250362403"
            ]
          },
          "250362403": {
            "id": "250362403",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "...Perhaps my questions are simply too easy?"
          }
        }
      }
    },
    {
      "subId": "2503625",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250362501"
        ],
        "dialogs": {
          "250362501": {
            "id": "250362501",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "...You have the courage to take on the questions. That alone is praiseworthy.",
            "nextDialogs": [
              "250362502"
            ]
          },
          "250362502": {
            "id": "250362502",
            "speakerId": 1000,
            "speakerName": "Keita",
            "text": "Please continue to journey through Natlan. I am sure you will find more answers as you go."
          }
        }
      }
    }
  ]
}
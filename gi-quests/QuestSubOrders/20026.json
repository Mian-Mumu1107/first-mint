  "subQuests": [
    {
      "subId": "2002601",
      "subQuestName": "Talk to Sara at Good Hunter",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200260101"
        ],
        "dialogs": {
          "200260101": {
            "id": "200260101",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Order for delivery",
            "nextDialogs": [
              "200260102"
            ]
          },
          "200260102": {
            "id": "200260102",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Hey, Traveler! What's happening—",
            "nextDialogs": [
              "200260103"
            ]
          },
          "200260103": {
            "id": "200260103",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "...Oh, you're just here to eat, you say?",
            "nextDialogs": [
              "200260104"
            ]
          },
          "200260104": {
            "id": "200260104",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "I understand, really I do... But I promise you I will make you the best meal you ever tasted if you just lend me a hand first.",
            "nextDialogs": [
              "200260105"
            ]
          },
          "200260105": {
            "id": "200260105",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Ernest from the Dawn Winery often orders food from here to pair with his wine, and his orders always come with special requests.",
            "nextDialogs": [
              "200260106"
            ]
          },
          "200260106": {
            "id": "200260106",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "This time he wants <color=#00E1FFFF>Fried Radish Balls</color> but with egg added in. Unfortunately, I'm fresh out of eggs!",
            "nextDialogs": [
              "200260107"
            ]
          },
          "200260107": {
            "id": "200260107",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "So if you could just go ahead and grab me a couple of Bird Eggs, that would be great.",
            "nextDialogs": [
              "200260109",
              "200260112"
            ]
          },
          "200260109": {
            "id": "200260109",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "There must be plenty of Bird Eggs around Windrise.",
            "nextDialogs": [
              "200260110"
            ]
          },
          "200260110": {
            "id": "200260110",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "I appreciate it!"
          },
          "200260112": {
            "id": "200260112",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "There must be plenty of Bird Eggs around Windrise.",
            "nextDialogs": [
              "200260113"
            ]
          },
          "200260113": {
            "id": "200260113",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Once you've done what I ask, I'll treat you to something from the Good Hunter special menu! Much obliged."
          }
        }
      }
    },

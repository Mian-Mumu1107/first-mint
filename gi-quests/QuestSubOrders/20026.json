    {
      "subId": "2002603",
      "subQuestName": "Find two Bird Eggs",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200260301"
        ],
        "dialogs": {
          "200260301": {
            "id": "200260301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Your meal, sir.",
            "nextDialogs": [
              "200260302"
            ]
          },
          "200260302": {
            "id": "200260302",
            "speakerId": 1535,
            "speakerName": "Ernest",
            "text": "Aha! My <color=#00E1FFFF>Fried Radish Balls</color>... and prepared just as I requested!",
            "nextDialogs": [
              "200260303"
            ]
          },
          "200260303": {
            "id": "200260303",
            "speakerId": 1535,
            "speakerName": "Ernest",
            "text": "Mmm... Yes, the addition of eggs does indeed do wonders for the texture and aroma.",
            "nextDialogs": [
              "200260304"
            ]
          },
          "200260304": {
            "id": "200260304",
            "speakerId": 1535,
            "speakerName": "Ernest",
            "text": "Oh yeah! I know what I'm doing when it comes to food. *mwah!*",
            "nextDialogs": [
              "200260305"
            ]
          },
          "200260305": {
            "id": "200260305",
            "speakerId": 1535,
            "speakerName": "Ernest",
            "text": "Oh, and this is for you. Many thanks!"
          }
        }
      }
    },
    {
      "subId": "2002604",
      "subQuestName": "Collect the completed meals",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200260201"
        ],
        "dialogs": {
          "200260201": {
            "id": "200260201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I come bearing ingredients.",
            "nextDialogs": [
              "200260202"
            ]
          },
          "200260202": {
            "id": "200260202",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "That'll do it. One moment...",
            "nextDialogs": [
              "200260203"
            ]
          },
          "200260203": {
            "id": "200260203",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "It's ready! Now, get these <color=#00E1FFFF>Fried Radish Balls</color> to Ernest, pronto!",
            "nextDialogs": [
              "200260204"
            ]
          },
          "200260204": {
            "id": "200260204",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "...Don't give me that look, I know you're famished.",
            "nextDialogs": [
              "200260205"
            ]
          },
          "200260205": {
            "id": "200260205",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "There'll be a special Good Hunter surprise waiting for you when you get back!"
          }
        }
      }
    },

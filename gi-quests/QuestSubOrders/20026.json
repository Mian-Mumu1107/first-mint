    {
      "subId": "2002608",
      "subQuestName": "Give the fee to Sara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200260401"
        ],
        "dialogs": {
          "200260401": {
            "id": "200260401",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Deliver meal fee",
            "nextDialogs": [
              "200260402"
            ]
          },
          "200260402": {
            "id": "200260402",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "You're back! Did you make the delivery?",
            "nextDialogs": [
              "200260403"
            ]
          },
          "200260403": {
            "id": "200260403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's the fee.",
            "nextDialogs": [
              "200260404"
            ]
          },
          "200260404": {
            "id": "200260404",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Let's see... Excellent! Thank you.",
            "nextDialogs": [
              "200260405"
            ]
          },
          "200260405": {
            "id": "200260405",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Here, this <color=#00E1FFFF>Crab, Ham & Veggie Bake</color> is for you. It's fresh out of the oven, eat it while it's hot."
          }
        }
      }
    },
    {
      "subId": "2002607",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200260701"
        ],
        "dialogs": {
          "200260701": {
            "id": "200260701",
            "speakerId": 1535,
            "speakerName": "Ernest",
            "text": "Mmm... Yes, that rich eggy aroma just hits you straight away, but it's not overpowering thanks to the freshness of the carrot. I've missed my calling, should have been a chef!"
          }
        }
      }

    {
      "subId": "45405",
      "subQuestName": "Challenge the Wolf of the North",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4540501"
        ],
        "dialogs": {
          "4540501": {
            "id": "4540501",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Please! Calm!"
          }
        }
      }
    },
    {
      "subId": "45406",
      "subQuestName": "Talk to Razor and the Wolf of the North",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4540601"
        ],
        "dialogs": {
          "4540601": {
            "id": "4540601",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Please. Calm down.",
            "nextDialogs": [
              "4540602"
            ]
          },
          "4540602": {
            "id": "4540602",
            "speakerId": 1176,
            "speakerName": "Boreas",
            "text": "Hmph...",
            "nextDialogs": [
              "4540603"
            ]
          },
          "4540603": {
            "id": "4540603",
            "speakerId": 1176,
            "speakerName": "Boreas",
            "text": "It's just like he said. An outside wolf pack coming in and breaking the rules. They will reap what they have sown.",
            "nextDialogs": [
              "4540604"
            ]
          },
          "4540604": {
            "id": "4540604",
            "speakerId": 1176,
            "speakerName": "Boreas",
            "text": "But Razor — you must not get involved. This is for the wolves to settle between themselves.",
            "nextDialogs": [
              "4540605"
            ]
          },
          "4540605": {
            "id": "4540605",
            "speakerId": 1176,
            "speakerName": "Boreas",
            "text": "You fight not with claws, but with the sword. You strike not with teeth, but with lightning...",
            "nextDialogs": [
              "4540606"
            ]
          },
          "4540606": {
            "id": "4540606",
            "speakerId": 1176,
            "speakerName": "Boreas",
            "text": "You are human, Razor.",
            "nextDialogs": [
              "4540607"
            ]
          },
          "4540607": {
            "id": "4540607",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "I am not like them! I don't belong.",
            "nextDialogs": [
              "4540608"
            ]
          },
          "4540608": {
            "id": "4540608",
            "speakerId": 1176,
            "speakerName": "Boreas",
            "text": "You are no wolf. This is a matter for the wolves, and the wolves alone.",
            "nextDialogs": [
              "4540609"
            ]
          },
          "4540609": {
            "id": "4540609",
            "speakerId": 1176,
            "speakerName": "Boreas",
            "text": "And you, you are Razor's Lupical amongst humans. Your nobility stands out against others of your kind.",
            "nextDialogs": [
              "4540610"
            ]
          },
          "4540610": {
            "id": "4540610",
            "speakerId": 1176,
            "speakerName": "Boreas",
            "text": "If you ever wish, you may train with me.",
            "nextDialogs": [
              "4540611"
            ]
          },
          "4540611": {
            "id": "4540611",
            "speakerId": 1176,
            "speakerName": "Boreas",
            "text": "I have nothing further to say. May we meet again, Razor, and company...",
            "nextDialogs": [
              "4540612"
            ]
          },
          "4540612": {
            "id": "4540612",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Hey... Razor, what's that look for? Why don't you come to the city for a few days?",
            "nextDialogs": [
              "4540613"
            ]
          },
          "4540613": {
            "id": "4540613",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah! You have a friend in Mondstadt anyway right?",
            "nextDialogs": [
              "4540614"
            ]
          },
          "4540614": {
            "id": "4540614",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Y'know... that red, burny friend of yours?",
            "nextDialogs": [
              "4540615"
            ]
          },
          "4540615": {
            "id": "4540615",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "You're not safe in the wild anymore. But I know that you don't want to hurt them.",
            "nextDialogs": [
              "4540616"
            ]
          },
          "4540616": {
            "id": "4540616",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "I'm fine. Don't worry. But I'm not city human...",
            "nextDialogs": [
              "4540617"
            ]
          },
          "4540617": {
            "id": "4540617",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "But also not wolf...",
            "nextDialogs": [
              "4540621"
            ]
          },
          "4540621": {
            "id": "4540621",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "#Thank you. {NICKNAME}, Paimon and... other red girl.",
            "nextDialogs": [
              "4540622"
            ]
          },
          "4540622": {
            "id": "4540622",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Hey!? We've been with you all this time, and you still don't even know my name!?",
            "nextDialogs": [
              "4540623"
            ]
          },
          "4540623": {
            "id": "4540623",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Goodbye."
          }
        }
      }

    {
      "subId": "45415",
      "subQuestName": "Talk to Razor about how to help the injured wolf",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4541501"
        ],
        "dialogs": {
          "4541501": {
            "id": "4541501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Where are we?",
            "nextDialogs": [
              "4541502"
            ]
          },
          "4541502": {
            "id": "4541502",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "#{NICKNAME}, help me. Collect these.",
            "nextDialogs": [
              "4541503"
            ]
          },
          "4541503": {
            "id": "4541503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aren't those wolfhook seeds?",
            "nextDialogs": [
              "4541504"
            ]
          },
          "4541504": {
            "id": "4541504",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Crush them. Put on wound. Bleeding stop.",
            "nextDialogs": [
              "4541505"
            ]
          },
          "4541505": {
            "id": "4541505",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "It's true. Wolfhook seeds have a liquid coating that not only functions as a mild painkiller, but also has a hemostatic effect...",
            "nextDialogs": [
              "4541506"
            ]
          },
          "4541506": {
            "id": "4541506",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "...I read that in a book.",
            "nextDialogs": [
              "4541507"
            ]
          },
          "4541507": {
            "id": "4541507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why?",
            "nextDialogs": [
              "4541508"
            ]
          },
          "4541508": {
            "id": "4541508",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "...I have no idea.",
            "nextDialogs": [
              "4541509"
            ]
          },
          "4541509": {
            "id": "4541509",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Hooks help seeds move. Liquid stops pain and bleeding.",
            "nextDialogs": [
              "4541510"
            ]
          },
          "4541510": {
            "id": "4541510",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Animal doesn't feel hooks, they take seeds far away.",
            "nextDialogs": [
              "4541511"
            ]
          },
          "4541511": {
            "id": "4541511",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "...Purple teacher told me so.",
            "nextDialogs": [
              "4541512"
            ]
          },
          "4541512": {
            "id": "4541512",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "I stay here, take care of this one. I answer red girl's questions.",
            "nextDialogs": [
              "4541513"
            ]
          },
          "4541513": {
            "id": "4541513",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Right. And if that lot does come back, I doubt they will try their luck against a member of the Knights of Favonius.",
            "nextDialogs": [
              "4541514"
            ]
          },
          "4541514": {
            "id": "4541514",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "#Your wolf friend is not clear of my suspicion just yet. But {NICKNAME}, we'll still need to fetch those seeds."
          }
        }
      }
    },
    {
      "subId": "45402",
      "subQuestName": "Collect Wolfhook",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4540201"
        ],
        "dialogs": {
          "4540201": {
            "id": "4540201",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Traveler, go and find some Wolfhooks. I need to talk with Razor."
          }
        }
      }
    },
    {
      "subId": "45403",
      "subQuestName": "Give a Wolfhook to Razor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4540301"
        ],
        "dialogs": {
          "4540301": {
            "id": "4540301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're back! Have we got enough?",
            "nextDialogs": [
              "4540302"
            ]
          },
          "4540302": {
            "id": "4540302",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Yes. Enough.",
            "nextDialogs": [
              "4540303"
            ]
          },
          "4540303": {
            "id": "4540303",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Razor was just telling me about the wolven code of conduct. Mind-blowing stuff.",
            "nextDialogs": [
              "4540304"
            ]
          },
          "4540304": {
            "id": "4540304",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Thank you.",
            "nextDialogs": [
              "4540305"
            ]
          },
          "4540305": {
            "id": "4540305",
            "speakerId": 154301,
            "speakerName": "Hopkins the Marvelous",
            "text": "We've looked everywhere and haven't seen any other wolves.",
            "nextDialogs": [
              "4540307"
            ]
          },
          "4540307": {
            "id": "4540307",
            "speakerId": 163201,
            "speakerName": "Jotun",
            "text": "Yep, that's wolves for you. The one we managed to capture must have been sick or something.",
            "nextDialogs": [
              "4540308"
            ]
          },
          "4540308": {
            "id": "4540308",
            "speakerId": 154301,
            "speakerName": "Hopkins the Marvelous",
            "text": "Wh—What are you doing here?",
            "nextDialogs": [
              "4540309"
            ]
          },
          "4540309": {
            "id": "4540309",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Revenge.",
            "nextDialogs": [
              "4540310"
            ]
          },
          "4540310": {
            "id": "4540310",
            "speakerId": 163201,
            "speakerName": "Jotun",
            "text": "It's him! The one who was raised by wolves!",
            "nextDialogs": [
              "4540311"
            ]
          },
          "4540311": {
            "id": "4540311",
            "speakerId": 154301,
            "speakerName": "Hopkins the Marvelous",
            "text": "Huh!?",
            "nextDialogs": [
              "4540312"
            ]
          },
          "4540312": {
            "id": "4540312",
            "speakerId": 154301,
            "speakerName": "Hopkins the Marvelous",
            "text": "So, it was you. I should have known, wolves aren't smart enough to be behind this.",
            "nextDialogs": [
              "4540313"
            ]
          },
          "4540313": {
            "id": "4540313",
            "speakerId": 154301,
            "speakerName": "Hopkins the Marvelous",
            "text": "I can't believe you would help wolves plot against humans!",
            "nextDialogs": [
              "4540314"
            ]
          },
          "4540314": {
            "id": "4540314",
            "speakerId": 154301,
            "speakerName": "Hopkins the Marvelous",
            "text": "They throw you some scraps and you treat them like kin? Have you forgotten what you are?",
            "nextDialogs": [
              "4540315"
            ]
          },
          "4540315": {
            "id": "4540315",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Enough!",
            "nextDialogs": [
              "4540316"
            ]
          },
          "4540316": {
            "id": "4540316",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah! You can't talk about Razor like that!",
            "nextDialogs": [
              "4540317"
            ]
          },
          "4540317": {
            "id": "4540317",
            "speakerId": 163201,
            "speakerName": "Jotun",
            "text": "The Knights of Favonius are gonna let this guy off!?",
            "nextDialogs": [
              "4540318"
            ]
          },
          "4540318": {
            "id": "4540318",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "We. Did. Not. Raid. Village."
          }
        }
      }
    },

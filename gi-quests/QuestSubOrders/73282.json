      }
    },
    {
      "subId": "7328206",
      "subQuestName": "Confront Masseira",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732820601"
        ],
        "dialogs": {
          "732820601": {
            "id": "732820601",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Darn it, Masseira is gone!",
            "nextDialogs": [
              "732820602"
            ]
          },
          "732820602": {
            "id": "732820602",
            "speakerId": 1003,
            "speakerName": "Liloupar",
            "text": "He left a note. Hmph, that sly old fox.",
            "nextDialogs": [
              "732820603"
            ]
          },
          "732820603": {
            "id": "732820603",
            "speakerId": 1004,
            "speakerName": "Neat Note",
            "text": "By the time you see this note, I should already have ensconced myself in a safehouse within the valley.\\nIf your head is still on your shoulders, do not weep for Tadhla's choice.\\n\\nThis hunt is not yet over. This is just the beginning of the storm.\\nThus does Masseira the Hunter, elder of Tanit, warn you.",
            "nextDialogs": [
              "732820604"
            ]
          },
          "732820604": {
            "id": "732820604",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? What does he mean by all this? Paimon doesn't get it.",
            "nextDialogs": [
              "732820605"
            ]
          },
          "732820605": {
            "id": "732820605",
            "speakerId": 1003,
            "speakerName": "Liloupar",
            "text": "Seems like he fled the tribe under certain pressure and left this note for you. Hmph, the Tanit sure are not as peaceful as they seem."
          }
        }
      }
    },
    {
      "subId": "7328228",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732822801"
        ],
        "dialogs": {
          "732822801": {
            "id": "732822801",
            "speakerId": 1002,
            "speakerName": "Tadhla",
            "text": "(Tadhla avoids eye contact and lowers her head nervously.)",
            "nextDialogs": [
              "732822803",
              "732822806"
            ]
          },
          "732822803": {
            "id": "732822803",
            "speakerId": 1002,
            "speakerName": "Tadhla",
            "text": "Sorry, the hunt is over. I am Father's \"Falcon.\"",
            "nextDialogs": [
              "732822804"
            ]
          },
          "732822804": {
            "id": "732822804",
            "speakerId": 1002,
            "speakerName": "Tadhla",
            "text": "But I'm feeling great. Don't worry about me."
          },
          "732822806": {
            "id": "732822806",
            "speakerId": 1002,
            "speakerName": "Tadhla",
            "text": "As I said, he is my father, and I am his Falcon. I follow his orders. I hunt for him, risk my life for him, as he is the will of the Tanit.",
            "nextDialogs": [
              "732822807"
            ]
          },
          "732822807": {
            "id": "732822807",
            "speakerId": 1002,
            "speakerName": "Tadhla",
            "text": "When the day comes that I cannot fully execute Father's orders, then my life as a Falcon will end."
          }
        }
      }
    },
    {
      "subId": "7328229",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732822901"
        ],
        "dialogs": {
          "732822901": {
            "id": "732822901",
            "speakerId": 1000,
            "speakerName": "Masseira",
            "text": "Ah, if it isn't the esteemed Master of the Jinni. What can I do for you?",
            "nextDialogs": [
              "732822903",
              "732822907"
            ]
          },
          "732822903": {
            "id": "732822903",
            "speakerId": 1000,
            "speakerName": "Masseira",
            "text": "She likes you, I can see that.",
            "nextDialogs": [
              "732822904"
            ]
          },
          "732822904": {
            "id": "732822904",
            "speakerId": 1000,
            "speakerName": "Masseira",
            "text": "Don't worry, I'll leave her be. To be young... Right?",
            "nextDialogs": [
              "732822905"
            ]
          },
          "732822905": {
            "id": "732822905",
            "speakerId": 1000,
            "speakerName": "Masseira",
            "text": "I'll encourage her to express her feelings. As her elder and father, this is a duty to which I am bound. There's no need for you to worry about her. Truly."
          },
          "732822907": {
            "id": "732822907",
            "speakerId": 1000,
            "speakerName": "Masseira",
            "text": "Thank you for helping her complete her coming-of-age ceremony. I was right to trust you.",
            "nextDialogs": [
              "732822908"
            ]
          },
          "732822908": {
            "id": "732822908",
            "speakerId": 1000,
            "speakerName": "Masseira",
            "text": "Next, she will accept her first hunting mission as a qualified Falcon.",
            "nextDialogs": [
              "732822909"
            ]
          },
          "732822909": {
            "id": "732822909",
            "speakerId": 1000,
            "speakerName": "Masseira",
            "text": "By then, hehe, please witness her growth in person."
          }
        }
      }
    },
    {
      "subId": "7328299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732829901"
        ],
        "dialogs": {
          "732829901": {
            "id": "732829901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Tadhla? Tadhla! Uh, she—",
            "nextDialogs": [
              "732829902"
            ]
          },
          "732829902": {
            "id": "732829902",
            "speakerId": 1003,
            "speakerName": "Liloupar",
            "text": "This is the choice of her own will: To no longer live as a Falcon, but as a friend."
          }
        }
      }
    }
  ]
}
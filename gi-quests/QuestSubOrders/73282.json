  "subQuests": [
    {
      "subId": "7328201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732820101"
        ],
        "dialogs": {
          "732820101": {
            "id": "732820101",
            "speakerId": 1000,
            "speakerName": "Masseira",
            "text": "Ah, you've come. A moment, if you please. This should be the last time that I ask a favor of you.",
            "nextDialogs": [
              "732820103",
              "732820105"
            ]
          },
          "732820103": {
            "id": "732820103",
            "speakerId": 1000,
            "speakerName": "Masseira",
            "text": "It is Tadhla. She wants to talk to you.",
            "nextDialogs": [
              "732820106"
            ]
          },
          "732820106": {
            "id": "732820106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh? Why so formal?",
            "nextDialogs": [
              "732820107"
            ]
          },
          "732820107": {
            "id": "732820107",
            "speakerId": 1000,
            "speakerName": "Masseira",
            "text": "The ruins in the north, around where you first met each other."
          },
          "732820105": {
            "id": "732820105",
            "speakerId": 1000,
            "speakerName": "Masseira",
            "text": "Please, hear me out. Tadhla wants to talk to you."
          }
        }
      }
    },
    {
      "subId": "7328202",
      "subQuestName": "Go to the place where Tadhla is waiting for you",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732820201"
        ],
        "dialogs": {
          "732820201": {
            "id": "732820201",
            "speakerId": 1000,
            "speakerName": "Masseira",
            "text": "The ruins in the north, around where you first met each other.",
            "nextDialogs": [
              "732820202"
            ]
          },
          "732820202": {
            "id": "732820202",
            "speakerId": 1000,
            "speakerName": "Masseira",
            "text": "This is her choice. I hope you will respect that."
          }
        }
      }
    },
    {
      "subId": "7328204",
      "subQuestName": "Talk to Tadhla",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732820401"
        ],
        "dialogs": {
          "732820401": {
            "id": "732820401",
            "speakerId": 1002,
            "speakerName": "Tadhla",
            "text": "Here you are. I am happy that you came.",
            "nextDialogs": [
              "732820404"
            ]
          },
          "732820404": {
            "id": "732820404",
            "speakerId": 1002,
            "speakerName": "Tadhla",
            "text": "I've always liked the desert at this time of the day. It's beautiful. It's my favorite sight.",
            "nextDialogs": [
              "732820405"
            ]
          },
          "732820405": {
            "id": "732820405",
            "speakerId": 1002,
            "speakerName": "Tadhla",
            "text": "Only it is a shame that I never had the chance to watch the sunset with my friends.",
            "nextDialogs": [
              "732820406"
            ]
          },
          "732820406": {
            "id": "732820406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah... The desert is all dyed with the color of the sunset. So peaceful and quiet...",
            "nextDialogs": [
              "732820407"
            ]
          },
          "732820407": {
            "id": "732820407",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But, Tadhla, did you ask us to come here just for that?",
            "nextDialogs": [
              "732820408"
            ]
          },
          "732820408": {
            "id": "732820408",
            "speakerId": 1002,
            "speakerName": "Tadhla",
            "text": "...",
            "nextDialogs": [
              "732820409"
            ]
          },
          "732820409": {
            "id": "732820409",
            "speakerId": 1002,
            "speakerName": "Tadhla",
            "text": "To the Tanit, you are guests. To Falcons, you are potential prey. But I hope you are the ones who will survive.",
            "nextDialogs": [
              "732820410"
            ]
          },
          "732820410": {
            "id": "732820410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "732820411"
            ]
          },
          "732820411": {
            "id": "732820411",
            "speakerId": 1002,
            "speakerName": "Tadhla",
            "text": "So, I am sorry."
          }
        }
      }
    },
    {
      "subId": "7328205",
      "subQuestName": "Defeat Tadhla",
      "sceneId": null,
      "locations": [],
      "dialogue": {

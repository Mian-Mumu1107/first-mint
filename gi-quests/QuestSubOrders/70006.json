              "700060103"
            ]
          },
          "700060103": {
            "id": "700060103",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "Oh, it's hungry... Let's see what it wants, shall we?",
            "nextDialogs": [
              "700060104"
            ]
          },
          "700060104": {
            "id": "700060104",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "It appears to want... some sort of meat? But I'm not sure what, exactly, so could you please check the handbook?"
          }
        }
      }
    },
    {
      "subId": "7000602",
      "subQuestName": "Give an item to the hilichurl",

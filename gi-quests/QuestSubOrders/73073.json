    {
      "subId": "7307311",
      "subQuestName": "Search for the mechanical components",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7307314",
      "subQuestName": "Return to the secret base",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730731401"
        ],
        "dialogs": {
          "730731401": {
            "id": "730731401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey Royinjan, we're back!",
            "nextDialogs": [
              "730731402"
            ]
          },
          "730731402": {
            "id": "730731402",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "There you are. Looks like you met the old man and found the fragments you were looking for, hmm?",
            "nextDialogs": [
              "730731403"
            ]
          },
          "730731403": {
            "id": "730731403",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "That aside, is he as tedious now as he was then? Not that I care though.",
            "nextDialogs": [
              "730731406"
            ]
          },
          "730731406": {
            "id": "730731406",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "What did Amadhiah tell you? Don't believe anything he said! If he hadn't slipped back into the village the night before our adventure at sea...",
            "nextDialogs": [
              "730731407"
            ]
          },
          "730731407": {
            "id": "730731407",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "We could have been the greatest adventurers in history."
          }
        }
      }
    },
    {
      "subId": "7307312",
      "subQuestName": "Talk to Royinjan in the secret base",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7307313",
      "subQuestName": "Talk to Jazari",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730731501"
        ],
        "dialogs": {
          "730731501": {
            "id": "730731501",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "Thank goodness you're back.",
            "nextDialogs": [
              "730731502"
            ]
          },
          "730731502": {
            "id": "730731502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here are the two remaining fragments...",
            "nextDialogs": [
              "730731503"
            ]
          },
          "730731503": {
            "id": "730731503",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "Ah, yes, that's them, alright! Thank you so much for your help. I'll take care of the rest.",
            "nextDialogs": [
              "730731504"
            ]
          },
          "730731504": {
            "id": "730731504",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "Jazari fixes the Amiti Device.",
            "nextDialogs": [
              "730731505"
            ]
          },
          "730731505": {
            "id": "730731505",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "Well, this should do the trick. Haha, pretty good, eh? Why, I bet that even a Herbad of the Akademiya couldn't fix this thing without consulting any information.",
            "nextDialogs": [
              "730731506"
            ]
          },
          "730731506": {
            "id": "730731506",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "You're lucky to have me with you, you know? Now we can get inside the Ruin Golem!",
            "nextDialogs": [
              "730731507"
            ]
          },
          "730731507": {
            "id": "730731507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh... I think that's our line.",
            "nextDialogs": [
              "730731508"
            ]
          },
          "730731508": {
            "id": "730731508",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "Ah, no one's been in this machine for centuries. I can already smell the parchment of the pages in the academic annals that shall bear my name! ...Oh, um, sorry. I got too excited.",
            "nextDialogs": [
              "730731509"
            ]
          },
          "730731509": {
            "id": "730731509",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "No problem. Paimon's getting excited too! Mora or treasure, here we come!"
          }
        }
      }
    },
    {
      "subId": "7307303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730301"
        ],
        "dialogs": {
          "730730301": {
            "id": "730730301",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "Ugh, why am I looking for some secret base here again...? Oh, whatever. It's all in the name of academic research. Yes, yes...",
            "nextDialogs": [
              "730730302"
            ]
          },
          "730730302": {
            "id": "730730302",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "We're going to fall behind on research progress if we don't find the Amiti Device quickly."
          }
        }
      }
    },
    {
      "subId": "7307308",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730801"
        ],
        "dialogs": {
          "730730801": {
            "id": "730730801",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "This is such a nostalgic place. It's like the very dirt and air here are trying to tell me something... But I just can't recall anything.",
            "nextDialogs": [
              "730730802"
            ]
          },
          "730730802": {
            "id": "730730802",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Did you guys find the device fragments you're after? Remember to bring the stories you've collected to me afterward, alright?"
          }
        }
      }
    },
    {
      "subId": "7307309",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730901"
        ],
        "dialogs": {
          "730730901": {
            "id": "730730901",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "I didn't expect that there would be a Ruin Golem component that I've never seen before. How much more of this Ruin Golem have I not discovered?",
            "nextDialogs": [
              "730730902"
            ]
          },
          "730730902": {
            "id": "730730902",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "Have you found the fragments of the Amiti Device? My academic career is in your hands here!"
          }
        }
      }
    },
    {
      "subId": "7307399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730739905"
        ],
        "dialogs": {
          "730739905": {
            "id": "730739905",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Y'know, Paimon's used to this already... But why has this become a problem that only the two of us can solve again?",
            "nextDialogs": [
              "730739906"
            ]
          },
          "730739906": {
            "id": "730739906",
            "speakerId": 1002,
            "speakerName": "Ararycan",
            "text": "Two? You didn't count Ararycan in. Bad Paimon.",
            "nextDialogs": [
              "730739907"
            ]
          },
          "730739907": {
            "id": "730739907",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh... Ararycan is Aranara, so you don't really count!",
            "nextDialogs": [
              "730739908"
            ]
          },
          "730739908": {
            "id": "730739908",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon's not sure what's going on here. How about we go see Amadhiah about it?"
          }
        }
      }
    }
  ]
}
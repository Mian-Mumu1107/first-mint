{
  "lineCounts": {
    "Amadhiah": 31,
    "Ararycan": 19,
    "Black Screen": 6,
    "Jazari": 22,
    "Paimon": 42,
    "Player": 32,
    "Royinjan": 62
  },
  "subQuests": [
    {
      "subId": "7307301",
      "subQuestName": "Find the secret base",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730101"
        ],
        "dialogs": {
          "730730101": {
            "id": "730730101",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "It should be in a cave somewhere near here. Is my memory going or something?",
            "nextDialogs": [
              "730730102"
            ]
          },
          "730730102": {
            "id": "730730102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why don't we ask the villagers of Vimara Village? They should know if there's a cave around here.",
            "nextDialogs": [
              "730730103"
            ]
          },
          "730730103": {
            "id": "730730103",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "The villagers? Eh, there's no point asking them. This is a secret base! How would they even know where it is? If I remember correctly, the cave entrance should be behind these vines, so let's split up and search for it.",
            "nextDialogs": [
              "730730104"
            ]
          },
          "730730104": {
            "id": "730730104",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "This great researcher and I will go look over there. You two search this place, alright?",
            "nextDialogs": [
              "730730105"
            ]
          },
          "730730105": {
            "id": "730730105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Alrighty, then let's start our search from the vines here. Gah, there really are so many of them, though...",
            "nextDialogs": [
              "730730106"
            ]
          },
          "730730106": {
            "id": "730730106",
            "speakerId": 1002,
            "speakerName": "Ararycan",
            "text": "These are not vines, they're Vamadha.",
            "nextDialogs": [
              "730730107"
            ]
          },
          "730730107": {
            "id": "730730107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh? You know something about this, Ararycan?",
            "nextDialogs": [
              "730730108"
            ]
          },
          "730730108": {
            "id": "730730108",
            "speakerId": 1002,
            "speakerName": "Ararycan",
            "text": "Yeah, these are Vamadha. Aranara made them.",
            "nextDialogs": [
              "730730109"
            ]
          },
          "730730109": {
            "id": "730730109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why would the Aranara make this?",
            "nextDialogs": [
              "730730110"
            ]
          },
          "730730110": {
            "id": "730730110",
            "speakerId": 1002,
            "speakerName": "Ararycan",
            "text": "Aranara make Vamadha when they don't want Nara to enter a place. Where Vamadha are present, only Aranara can enter.",
            "nextDialogs": [
              "730730111"
            ]
          },
          "730730111": {
            "id": "730730111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh... Aranara are pretty small, but the place's been blocked completely. Paimon thinks even you can't get through.",
            "nextDialogs": [
              "730730112"
            ]
          },
          "730730112": {
            "id": "730730112",
            "speakerId": 1002,
            "speakerName": "Ararycan",
            "text": "Nara can't get in, but Aranara can sing. Vamadha spin when they hear us singing, and when they do, we can enter.",
            "nextDialogs": [
              "730730115"
            ]
          },
          "730730115": {
            "id": "730730115",
            "speakerId": 1002,
            "speakerName": "Ararycan",
            "text": "#Yep! Nara {NICKNAME} is a friend of the forest. If you sing, Nara {NICKNAME}, the Vamadha will hear it. Come on, Ararycan will teach you!"
          }
        }
      }
    },
    {
      "subId": "7307302",
      "subQuestName": "Turn the Vamadha",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730201"
        ],
        "dialogs": {
          "730730201": {
            "id": "730730201",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "I recall it should be around here...",
            "nextDialogs": [
              "730730202"
            ]
          },
          "730730202": {
            "id": "730730202",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Why can't I find it..."
          }
        }
      }
    },
    {
      "subId": "7307309",
      "subQuestName": "Turn the Vamadha",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730401"
        ],
        "dialogs": {
          "730730401": {
            "id": "730730401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, no kidding! It really started spinning like a ball.",
            "nextDialogs": [
              "730730402"
            ]
          },
          "730730402": {
            "id": "730730402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Aaand there's our mysterious cave entrance.",
            "nextDialogs": [
              "730730403"
            ]
          },
          "730730403": {
            "id": "730730403",
            "speakerId": 1002,
            "speakerName": "Ararycan",
            "text": "Ararycan remembers this cave.",
            "nextDialogs": [
              "730730404"
            ]
          },
          "730730404": {
            "id": "730730404",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh? Did you make this Vamadha, Ararycan?",
            "nextDialogs": [
              "730730405"
            ]
          },
          "730730405": {
            "id": "730730405",
            "speakerId": 1002,
            "speakerName": "Ararycan",
            "text": "Ararycan doesn't remember, but little Nara must be protected. This much Ararycan knows.",
            "nextDialogs": [
              "730730406"
            ]
          },
          "730730406": {
            "id": "730730406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, we've no clue why this place was sealed by the Aranara, but this should be the entrance to the secret base, so let's call those two over.",
            "nextDialogs": [
              "730730407"
            ]
          },
          "730730407": {
            "id": "730730407",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Haha, I knew this was the place! Our secret base should be this way... How did you guys find it?",
            "nextDialogs": [
              "730730408"
            ]
          },
          "730730408": {
            "id": "730730408",
            "speakerId": 1002,
            "speakerName": "Ararycan",
            "text": "Ararycan did a great job.",
            "nextDialogs": [
              "730730409"
            ]
          },
          "730730409": {
            "id": "730730409",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "Eh, either way... Since you found the entrance to the cave, let's go in. We just have to find the Amiti Device next...",
            "nextDialogs": [
              "730730410"
            ]
          },
          "730730410": {
            "id": "730730410",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "It's pretty big inside. Don't get scared now..."
          }
        }
      }
    },
    {
      "subId": "7307303",
      "subQuestName": "Investigate the secret base",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730501"
        ],
        "dialogs": {
          "730730501": {
            "id": "730730501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow! This place is really huge! You were a pretty impressive kid, eh, Royinjan?",
            "nextDialogs": [
              "730730502"
            ]
          },
          "730730502": {
            "id": "730730502",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Not bad, eh? But it's much smaller than I remember.",
            "nextDialogs": [
              "730730504",
              "730730506"
            ]
          },
          "730730504": {
            "id": "730730504",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Haha, more than grown up. I'm an old man now.",
            "nextDialogs": [
              "730730507"
            ]
          },
          "730730507": {
            "id": "730730507",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "But this place really hasn't changed at all. It's like time stood still here.",
            "nextDialogs": [
              "730730508"
            ]
          },
          "730730508": {
            "id": "730730508",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Even the air smells the same. A single whiff brings back so many memories...",
            "nextDialogs": [
              "730730509"
            ]
          },
          "730730509": {
            "id": "730730509",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "Let's not waste time. Do you remember where the Amiti Device is?",
            "nextDialogs": [
              "730730510"
            ]
          },
          "730730510": {
            "id": "730730510",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Patience, youngster. Let's take a look around first.",
            "nextDialogs": [
              "730730511"
            ]
          },
          "730730511": {
            "id": "730730511",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "One thing has been bugging Paimon since we first walked in. What is this huge machine part?",
            "nextDialogs": [
              "730730512"
            ]
          },
          "730730512": {
            "id": "730730512",
            "speakerId": 1002,
            "speakerName": "Ararycan",
            "text": "Oh, Ararycan knows. This was moved here from the Giant Iron Mountain.",
            "nextDialogs": [
              "730730513"
            ]
          },
          "730730513": {
            "id": "730730513",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Giant Iron Mountain... You mean it was taken from the Ruin Golem from before?",
            "nextDialogs": [
              "730730514"
            ]
          },
          "730730514": {
            "id": "730730514",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "You noticed it too? Judging from the pattern, such parts should belong to the Ruin Golem, though I don't know why it was arranged in this fashion.",
            "nextDialogs": [
              "730730515"
            ]
          },
          "730730515": {
            "id": "730730515",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "Perhaps you really do have some academic talent. Would you like me to recommend you to study in the Akademiya once our project comes to a close?",
            "nextDialogs": [
              "730730516"
            ]
          },
          "730730516": {
            "id": "730730516",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "You're sure to make lots of friends there.",
            "nextDialogs": [
              "730730517"
            ]
          },
          "730730517": {
            "id": "730730517",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh, that's not what this is about... but thanks anyway.",
            "nextDialogs": [
              "730730518"
            ]
          },
          "730730518": {
            "id": "730730518",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But a child shouldn't have been able to move anything this big. So who piled it up here in this way?",
            "nextDialogs": [
              "730730519"
            ]
          },
          "730730519": {
            "id": "730730519",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Maybe it was a forest spirit! ...Nah, just kidding. I can't remember.",
            "nextDialogs": [
              "730730520"
            ]
          },
          "730730520": {
            "id": "730730520",
            "speakerId": 1002,
            "speakerName": "Ararycan",
            "text": "Ararycan knows! Ararycan moved it.",
            "nextDialogs": [
              "730730521"
            ]
          },
          "730730521": {
            "id": "730730521",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "How did you move something this big?",
            "nextDialogs": [
              "730730522"
            ]
          },
          "730730522": {
            "id": "730730522",
            "speakerId": 1002,
            "speakerName": "Ararycan",
            "text": "Ararycan can move it. Ararycan is very strong.",
            "nextDialogs": [
              "730730523"
            ]
          },
          "730730523": {
            "id": "730730523",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Haha, I remember two groups of us kids running around this big guy and play-fighting."
          },
          "730730506": {
            "id": "730730506",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "I was also a child at that time. I'm an old man now."
          }
        }
      }
    },
    {
      "subId": "7307304",
      "subQuestName": "Dig for the buried item",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7307305",
      "subQuestName": "Dig for the buried item",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730601"
        ],
        "dialogs": {
          "730730601": {
            "id": "730730601",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "C'mon, c'mon! Paimon wants to see what we've got... Eh? It's just a booklet.",
            "nextDialogs": [
              "730730602"
            ]
          },
          "730730602": {
            "id": "730730602",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Oooh, this is good stuff! This was our \"Adventure Handbook\" back in the day.",
            "nextDialogs": [
              "730730603"
            ]
          },
          "730730603": {
            "id": "730730603",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Adventure Handbook?",
            "nextDialogs": [
              "730730604"
            ]
          },
          "730730604": {
            "id": "730730604",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Don't you guys know about Adventure Handbooks? I thought you were adventurers from abroad based on how you look and the fact that you're here looking for treasure or something.",
            "nextDialogs": [
              "730730607"
            ]
          },
          "730730607": {
            "id": "730730607",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Right? Many adventurers write them. It's like an adventure journal, to record their experiences, plans, and even the clues to treasure locations.",
            "nextDialogs": [
              "730730608"
            ]
          },
          "730730608": {
            "id": "730730608",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "As you guys know, my grandfather was a great adventurer, though I didn't understand a lick of what he wrote into his adventure journal.",
            "nextDialogs": [
              "730730609"
            ]
          },
          "730730609": {
            "id": "730730609",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Still, I grew up wanting to be an adventurer, so I made my own imitation adventure handbook. You could say that's where I got my start.",
            "nextDialogs": [
              "730730610"
            ]
          },
          "730730610": {
            "id": "730730610",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "I know how important this is to you, but it won't help us find the thing we're looking for.",
            "nextDialogs": [
              "730730611"
            ]
          },
          "730730611": {
            "id": "730730611",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Now, now, not so fast. Didn't I tell you that I planned to find the Amiti Device? What happened then is recorded in this Adventure Handbook.",
            "nextDialogs": [
              "730730612"
            ]
          },
          "730730612": {
            "id": "730730612",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Let me see... I remember that the two of us... Wait a moment. Why are there three people in the drawing? Has my memory already gone that bad? Or is it because my eyes can't see well anymore?",
            "nextDialogs": [
              "730730613"
            ]
          },
          "730730613": {
            "id": "730730613",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "Do you need me to lend you my glasses? I have the latest model, as produced by the Akademiya.",
            "nextDialogs": [
              "730730614"
            ]
          },
          "730730614": {
            "id": "730730614",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "Sir Researcher, are you really that... Forget it, let me take a closer look... I'm pretty sure now that the Amiti Device should have been buried right here by yours truly.",
            "nextDialogs": [
              "730730615"
            ]
          },
          "730730615": {
            "id": "730730615",
            "speakerId": 1003,
            "speakerName": "Jazari",
            "text": "Great! So we just have to search this cave... is what I would say, if this place wasn't quite so big.",
            "nextDialogs": [
              "730730616"
            ]
          },
          "730730616": {
            "id": "730730616",
            "speakerId": 1000,
            "speakerName": "Royinjan",
            "text": "There's no need for that. The location of the device is recorded here. It should be..."
          }
        }
      }
    },
    {
      "subId": "7307306",
      "subQuestName": "Dig for the Amiti Device",
      "sceneId": null,
      "locations": [],

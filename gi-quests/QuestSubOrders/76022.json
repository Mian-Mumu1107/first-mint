  "subQuests": [
    {
      "subId": "7602201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760220101"
        ],
        "dialogs": {
          "760220101": {
            "id": "760220101",
            "speakerId": 21938,
            "speakerName": "Furious Samurai",
            "text": "Don't struggle if you don't wanna bleed — leave your Mora and walk away.",
            "nextDialogs": [
              "760220102"
            ]
          },
          "760220102": {
            "id": "760220102",
            "speakerId": 21935,
            "speakerName": "Peco",
            "text": "Help! Someone save me!",
            "nextDialogs": [
              "760220103"
            ]
          },
          "760220103": {
            "id": "760220103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, we should go help that guy!"
          }
        }
      }
    },
    {
      "subId": "7602204",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760220201"
        ],
        "dialogs": {
          "760220201": {
            "id": "760220201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Big guy! What do you think you're doing? Stop it right now!",
            "nextDialogs": [
              "760220202"
            ]
          },
          "760220202": {
            "id": "760220202",
            "speakerId": 21938,
            "speakerName": "Furious Samurai",
            "text": "Mora... No, no! It was you who killed Murasaki... You must die!",
            "nextDialogs": [
              "760220203"
            ]
          },
          "760220203": {
            "id": "760220203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Whoa! Watch out, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "7602203",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760220301"
        ],
        "dialogs": {
          "760220301": {
            "id": "760220301",
            "speakerId": 21935,
            "speakerName": "Peco",
            "text": "Thank you both so much for saving me! I'm Peco, a traveling merchant. If you ever run into me in the future, I'll make sure to give you the best deals around!",
            "nextDialogs": [
              "760220302"
            ]
          },
          "760220302": {
            "id": "760220302",
            "speakerId": 21935,
            "speakerName": "Peco",
            "text": "Today's my unlucky day... What did I do to deserve to run into this \"legend\"?",
            "nextDialogs": [
              "760220303"
            ]
          },
          "760220303": {
            "id": "760220303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Legend\"? Is that guy famous or something?",
            "nextDialogs": [
              "760220304"
            ]
          },
          "760220304": {
            "id": "760220304",
            "speakerId": 21935,
            "speakerName": "Peco",
            "text": "Not in a good way. Word gets around among us traders... A few colleagues said they ran into him and swore they'd never take this route again. I didn't believe them, figured they were exaggerating...",
            "nextDialogs": [
              "760220305"
            ]
          },
          "760220305": {
            "id": "760220305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're braver than you look.",
            "nextDialogs": [
              "760220306"
            ]
          },
          "760220306": {
            "id": "760220306",
            "speakerId": 21935,
            "speakerName": "Peco",
            "text": "We traveling merchants see all kinds of things, you know? And, well, sometimes stories grow in the telling...",
            "nextDialogs": [
              "760220307"
            ]
          },
          "760220307": {
            "id": "760220307",
            "speakerId": 21935,
            "speakerName": "Peco",
            "text": "But anyway — they call him \"Gonpachi.\" Rumor has it he got into trouble back in Inazuma and fled out here with his lover in tow.",
            "nextDialogs": [
              "760220308"
            ]
          },
          "760220308": {
            "id": "760220308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So that \"Murasaki\" he kept mumbling about was...",
            "nextDialogs": [
              "760220309"
            ]
          },
          "760220309": {
            "id": "760220309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Oh, right! That weirdo kept mumbling that name during the fight with {NICKNAME}.",
            "nextDialogs": [
              "760220310"
            ]
          },
          "760220310": {
            "id": "760220310",
            "speakerId": 21935,
            "speakerName": "Peco",
            "text": "Once you stray from the straight and narrow, it's hard to get back on track — even in a new place. Without honest work, you end up back where you started.",
            "nextDialogs": [
              "760220311"
            ]
          },
          "760220311": {
            "id": "760220311",
            "speakerId": 21935,
            "speakerName": "Peco",
            "text": "This lifestyle might work for a lone wolf. But living life by the sword... Sooner or later, you're bound to cross the wrong person.",
            "nextDialogs": [
              "760220312"
            ]
          },
          "760220312": {
            "id": "760220312",
            "speakerId": 21935,
            "speakerName": "Peco",
            "text": "From what I heard, that's how his lover met her end. Ever since then, he's been... well, not quite right in the head.",
            "nextDialogs": [
              "760220313"
            ]
          },
          "760220313": {
            "id": "760220313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*sigh* Robbing people is awful, but... knowing how he ended up like this makes Paimon feel kinda bad for him...",
            "nextDialogs": [
              "760220315",
              "760220317"
            ]
          },
          "760220315": {
            "id": "760220315",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "HEY! That's not the point of this story!",
            "nextDialogs": [
              "760220318"
            ]
          },
          "760220318": {
            "id": "760220318",
            "speakerId": 21935,
            "speakerName": "Peco",
            "text": "Alright, I won't keep you two any longer. Please, take this as a token of my gratitude."
          },
          "760220317": {
            "id": "760220317",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hehe, it's a good thing I've got you around! {NICKNAME}, my Mora guardian!"
          }
        }
      }
    },
    {
      "subId": "7602299",
      "subQuestName": "Additional",
      "sceneId": null,

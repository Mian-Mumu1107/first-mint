    {
      "subId": "7280706",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728070301"
        ],
        "dialogs": {
          "728070301": {
            "id": "728070301",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "You are... Ahh, you're that Traveler from abroad. What can I do for you?",
            "nextDialogs": [
              "728070302"
            ]
          },
          "728070302": {
            "id": "728070302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Hiiragi Chisato's Letter...",
            "nextDialogs": [
              "728070303"
            ]
          },
          "728070303": {
            "id": "728070303",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "This letter... Did Ms. Hiiragi really ask you to deliver this letter to me?",
            "nextDialogs": [
              "728070304"
            ]
          },
          "728070304": {
            "id": "728070304",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "This handwriting... It really is her... Thank goodness...",
            "nextDialogs": [
              "728070305"
            ]
          },
          "728070305": {
            "id": "728070305",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Thank you for making this trip, Traveler.",
            "nextDialogs": [
              "728070306"
            ]
          },
          "728070306": {
            "id": "728070306",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "As for the Travel Permit... As it's Ms. Hiiragi's personal request, I will naturally see it through.",
            "nextDialogs": [
              "728070307"
            ]
          },
          "728070307": {
            "id": "728070307",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "However, I'll need some time to prepare...",
            "nextDialogs": [
              "728070308"
            ]
          },
          "728070308": {
            "id": "728070308",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "How about this. Can you wait for me at the Kiminami Restaurant?",
            "nextDialogs": [
              "728070309"
            ]
          },
          "728070309": {
            "id": "728070309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why do you want to go there?",
            "nextDialogs": [
              "728070310"
            ]
          },
          "728070310": {
            "id": "728070310",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Well... I want a small favor from you.",
            "nextDialogs": [
              "728070311"
            ]
          },
          "728070311": {
            "id": "728070311",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Recently... I was also thinking of sending something to Ms. Hiiragi.",
            "nextDialogs": [
              "728070312"
            ]
          },
          "728070312": {
            "id": "728070312",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "I wrote a letter and also requested Ms. Kiminami to make some treats for me. I was planning to send them together to Ms. Hiiragi as a present.",
            "nextDialogs": [
              "728070313"
            ]
          },
          "728070313": {
            "id": "728070313",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "But if my father finds out about my plans, he might be upset... Just as I was pondering what to do, you showed up.",
            "nextDialogs": [
              "728070315",
              "728070321"
            ]
          },
          "728070315": {
            "id": "728070315",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Father doesn't want me to communicate with Ms. Hiiragi.",
            "nextDialogs": [
              "728070316"
            ]
          },
          "728070316": {
            "id": "728070316",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "I understand his concerns. After all, I am a member of the Kujou Clan and one of the enforcers of the Tenryou Commission.",
            "nextDialogs": [
              "728070317"
            ]
          },
          "728070317": {
            "id": "728070317",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Ms. Hiiragi is the young lady of the Kanjou Commission's Hiiragi Clan.",
            "nextDialogs": [
              "728070318"
            ]
          },
          "728070318": {
            "id": "728070318",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "If I were to get too close to her, it would be inevitable that someone might try to take advantage of our situation.",
            "nextDialogs": [
              "728070319"
            ]
          },
          "728070319": {
            "id": "728070319",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Even though it is only a present, in some people's eyes, it's a lot more than that.",
            "nextDialogs": [
              "728070326"
            ]
          },
          "728070326": {
            "id": "728070326",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Hehe, let's not talk about these trivial matters.",
            "nextDialogs": [
              "728070327"
            ]
          },
          "728070327": {
            "id": "728070327",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Traveler, please wait at the Kiminami Restaurant for me. After I approve the Travel Permit, I'll bring it to you."
          },
          "728070321": {
            "id": "728070321",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Father... He naturally has to be strict. I do understand why he's unwilling for me to communicate with Ms. Hiiragi.",
            "nextDialogs": [
              "728070322"
            ]
          },
          "728070322": {
            "id": "728070322",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "After all, I am a member of the Kujou Clan and one of the enforcers of the Tenryou Commission.",
            "nextDialogs": [
              "728070323"
            ]
          },
          "728070323": {
            "id": "728070323",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Ms. Hiiragi is the young lady of the Kanjou Commission's Hiiragi Clan.",
            "nextDialogs": [
              "728070324"
            ]
          },
          "728070324": {
            "id": "728070324",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "If I were to get too close to her, it would be inevitable that someone might try to take advantage of our situation.",
            "nextDialogs": [
              "728070325"
            ]
          },
          "728070325": {
            "id": "728070325",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Even though it is only a present, in some people's eyes, it's a lot more than that."
          }
        }
      }
    },
    {
      "subId": "7280702",
      "subQuestName": "Give the letter to Kujou Kamaji",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728070201"
        ],
        "dialogs": {
          "728070201": {
            "id": "728070201",
            "speakerId": 1001,
            "speakerName": "Sanada",
            "text": "*sigh* What a headache... Hi there, is there anything you want?",
            "nextDialogs": [
              "728070202"
            ]
          },
          "728070202": {
            "id": "728070202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Kamaji...",
            "nextDialogs": [
              "728070203"
            ]
          },
          "728070203": {
            "id": "728070203",
            "speakerId": 1001,
            "speakerName": "Sanada",
            "text": "Are you talking about Master Kamaji? What do you want from him?",
            "nextDialogs": [
              "728070204"
            ]
          },
          "728070204": {
            "id": "728070204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Show Chisato's Letter)",
            "nextDialogs": [
              "728070205"
            ]
          },
          "728070205": {
            "id": "728070205",
            "speakerId": 1001,
            "speakerName": "Sanada",
            "text": "You said this letter is from Ms. Hiiragi Chisato?",
            "nextDialogs": [
              "728070206"
            ]
          },
          "728070206": {
            "id": "728070206",
            "speakerId": 1001,
            "speakerName": "Sanada",
            "text": "If this letter is really from that Hiiragi Chisato...",
            "nextDialogs": [
              "728070207"
            ]
          },
          "728070207": {
            "id": "728070207",
            "speakerId": 1001,
            "speakerName": "Sanada",
            "text": "I think... You should talk to Master Kamaji directly. He's been taking walks near the bridge recently."
          }
        }
      }
    },

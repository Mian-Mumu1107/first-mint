    {
      "subId": "7280704",
      "subQuestName": "Go to Kiminami Restaurant to collect the snacks",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728070401"
        ],
        "dialogs": {
          "728070401": {
            "id": "728070401",
            "speakerId": 1002,
            "speakerName": "Kiminami Anna",
            "text": "Welcome to Kiminami Restaurant.",
            "nextDialogs": [
              "728070402"
            ]
          },
          "728070402": {
            "id": "728070402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Kamaji's treats...",
            "nextDialogs": [
              "728070403"
            ]
          },
          "728070403": {
            "id": "728070403",
            "speakerId": 1002,
            "speakerName": "Kiminami Anna",
            "text": "Oh, I've already prepared the treats that Master Kamaji ordered. I'll bring them to you now.",
            "nextDialogs": [
              "728070404"
            ]
          },
          "728070404": {
            "id": "728070404",
            "speakerId": 1002,
            "speakerName": "Kiminami Anna",
            "text": "But, I'm curious about who Master Kamaji will give these treats to...",
            "nextDialogs": [
              "728070405"
            ]
          },
          "728070405": {
            "id": "728070405",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "It's nothing more than a public relations gesture, Ms. Kiminami.",
            "nextDialogs": [
              "728070406"
            ]
          },
          "728070406": {
            "id": "728070406",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "A while back, Mr. Hiiragi Shinsuke presented my father with a batch of fine tea.",
            "nextDialogs": [
              "728070407"
            ]
          },
          "728070407": {
            "id": "728070407",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "My father knows that Mr. Hiiragi's beloved daughter Chisato likes treats, so he told me to prepare some as a gift in return.",
            "nextDialogs": [
              "728070408"
            ]
          },
          "728070408": {
            "id": "728070408",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "I was worried that the delivery might take too long, and there might also be unavoidable bumps during the journey... So I specifically asked for this Traveler to deliver them.",
            "nextDialogs": [
              "728070409"
            ]
          },
          "728070409": {
            "id": "728070409",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Ms. Kiminami, can I have a look at the treats, please? I want to make sure I haven't missed anything.",
            "nextDialogs": [
              "728070410"
            ]
          },
          "728070410": {
            "id": "728070410",
            "speakerId": 1002,
            "speakerName": "Kiminami Anna",
            "text": "Hmm... Sure, here are the treats. Please take a look.",
            "nextDialogs": [
              "728070411"
            ]
          },
          "728070411": {
            "id": "728070411",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Everything is there. Thank you, Ms. Kiminami.",
            "nextDialogs": [
              "728070412"
            ]
          },
          "728070412": {
            "id": "728070412",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Let us move out of the way, Traveler. I have a few more things to say to you.",
            "nextDialogs": [
              "728070413"
            ]
          },
          "728070413": {
            "id": "728070413",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "This is the Travel Permit. Please take it.",
            "nextDialogs": [
              "728070414"
            ]
          },
          "728070414": {
            "id": "728070414",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "With this Travel Permit, you can freely enter and leave Ritou.",
            "nextDialogs": [
              "728070415"
            ]
          },
          "728070415": {
            "id": "728070415",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thank you.",
            "nextDialogs": [
              "728070416"
            ]
          },
          "728070416": {
            "id": "728070416",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "It's fine. This permit will make your delivery a lot smoother.",
            "nextDialogs": [
              "728070417"
            ]
          },
          "728070417": {
            "id": "728070417",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Also... Here's the letter.",
            "nextDialogs": [
              "728070418"
            ]
          },
          "728070418": {
            "id": "728070418",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did you write this letter yourself?",
            "nextDialogs": [
              "728070419"
            ]
          },
          "728070419": {
            "id": "728070419",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Yes. I tried to write this letter in a... tactful manner. I hope Ms. Hiiragi won't be offended by it.",
            "nextDialogs": [
              "728070420"
            ]
          },
          "728070420": {
            "id": "728070420",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Please deliver this letter and the treats to Ms. Hiiragi.",
            "nextDialogs": [
              "728070421"
            ]
          },
          "728070421": {
            "id": "728070421",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do we have to go back again...",
            "nextDialogs": [
              "728070422"
            ]
          },
          "728070422": {
            "id": "728070422",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Hehe, but this time, you have the Travel Permit. You should have a lot more freedom than before.",
            "nextDialogs": [
              "728070423"
            ]
          },
          "728070423": {
            "id": "728070423",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "I'll leave it to you, Traveler. I also need to go back and deal with official matters.",
            "nextDialogs": [
              "728070424"
            ]
          },
          "728070424": {
            "id": "728070424",
            "speakerId": 1000,
            "speakerName": "Kujou Kamaji",
            "text": "Ugh, when will I be able to go there myself..."
          }
        }
      }
    },
    {
      "subId": "7280705",
      "subQuestName": "Report back to Hiiragi Chisato",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728070501"
        ],
        "dialogs": {
          "728070501": {
            "id": "728070501",
            "speakerId": 1003,
            "speakerName": "Hiiragi Chisato",
            "text": "Traveler, you've returned.",
            "nextDialogs": [
              "728070502"
            ]
          },
          "728070502": {
            "id": "728070502",
            "speakerId": 1003,
            "speakerName": "Hiiragi Chisato",
            "text": "I guess you've delivered my letter to Kamaji? ...Did you manage to get the Travel Permit as well?",
            "nextDialogs": [
              "728070504"
            ]
          },
          "728070504": {
            "id": "728070504",
            "speakerId": 1003,
            "speakerName": "Hiiragi Chisato",
            "text": "You don't have to thank me. You should be thanking Kamaji instead.",
            "nextDialogs": [
              "728070506"
            ]
          },
          "728070506": {
            "id": "728070506",
            "speakerId": 1003,
            "speakerName": "Hiiragi Chisato",
            "text": "Eh? What's this? Treats, and... a handwritten letter from Kamaji?",
            "nextDialogs": [
              "728070507"
            ]
          },
          "728070507": {
            "id": "728070507",
            "speakerId": 1003,
            "speakerName": "Hiiragi Chisato",
            "text": "Was it his request? These Tricolor Dango... He prepared them for me...",
            "nextDialogs": [
              "728070508"
            ]
          },
          "728070508": {
            "id": "728070508",
            "speakerId": 1003,
            "speakerName": "Hiiragi Chisato",
            "text": "Thank you, Traveler. I'll make sure to savor these treats. As for this letter... I'll read it with great care.",
            "nextDialogs": [
              "728070509"
            ]
          },
          "728070509": {
            "id": "728070509",
            "speakerId": 1003,
            "speakerName": "Hiiragi Chisato",
            "text": "Thank you for the hard work. Please, accept these items as thanks for your help.",
            "nextDialogs": [
              "728070510"
            ]
          },
          "728070510": {
            "id": "728070510",
            "speakerId": 1003,
            "speakerName": "Hiiragi Chisato",
            "text": "Who knows... I might need your help again in the future as well."
          }
        }
      }
    }
  ]
}
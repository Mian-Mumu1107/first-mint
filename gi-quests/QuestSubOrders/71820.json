    {
      "subId": "7182002",
      "subQuestName": "Talk to Verr Goldet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718200201"
        ],
        "dialogs": {
          "718200201": {
            "id": "718200201",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Each Lantern Rite is the same old story...",
            "nextDialogs": [
              "718200202"
            ]
          },
          "718200202": {
            "id": "718200202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "718200203"
            ]
          },
          "718200203": {
            "id": "718200203",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "We're in a bit of a pickle. A lot of our staff have gone back home to spend the Lantern Rite with their families. It's difficult to run the inn like this...",
            "nextDialogs": [
              "718200204"
            ]
          },
          "718200204": {
            "id": "718200204",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Greeting the guests, decorating the inn, and making preparations for the celebration...",
            "nextDialogs": [
              "718200205"
            ]
          },
          "718200205": {
            "id": "718200205",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "All on top of our regular responsibilities, of course... There's no way Smiley Yanxiao can keep up with this workload...",
            "nextDialogs": [
              "718200206"
            ]
          },
          "718200206": {
            "id": "718200206",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "If you don't mind, Traveler, could you lend him a hand?",
            "nextDialogs": [
              "718200207"
            ]
          },
          "718200207": {
            "id": "718200207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Leave it to me.",
            "nextDialogs": [
              "718200208"
            ]
          },
          "718200208": {
            "id": "718200208",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "I'm sure he'll appreciate it. You'll find him in the kitchen.",
            "nextDialogs": [
              "718200209"
            ]
          },
          "718200209": {
            "id": "718200209",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "I still have some things to finish up here..."
          }
        }
      }
    },
    {
      "subId": "7182003",
      "subQuestName": "Go visit Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718200301"
        ],
        "dialogs": {
          "718200301": {
            "id": "718200301",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Who's that!? The kitchen is staff only... Oh, it's you...",
            "nextDialogs": [
              "718200302"
            ]
          },
          "718200302": {
            "id": "718200302",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Do you need something? If you're looking to order food, it could take a while... It's incredibly busy at the moment.",
            "nextDialogs": [
              "718200305"
            ]
          },
          "718200305": {
            "id": "718200305",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "You came to help? Oh... I can't complain about that! Not when I'm completely swamped...",
            "nextDialogs": [
              "718200306"
            ]
          },
          "718200306": {
            "id": "718200306",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Could you go downstairs and get the cooking ingredients that just came in for me? I need them very urgently.",
            "nextDialogs": [
              "718200307"
            ]
          },
          "718200307": {
            "id": "718200307",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "While you're at it, you can also take these Xiao Lanterns and hang them on the two trees by the entrance to the inn... The innkeeper's been nagging me about it for way too long..."
          }
        }
      }
    },
    {
      "subId": "7182007",

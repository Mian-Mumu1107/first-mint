    {
      "subId": "7182015",
      "subQuestName": "Talk to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718201501"
        ],
        "dialogs": {
          "718201501": {
            "id": "718201501",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "How did it go? Is everything taken care of?",
            "nextDialogs": [
              "718201502"
            ]
          },
          "718201502": {
            "id": "718201502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yep, all done.",
            "nextDialogs": [
              "718201503"
            ]
          },
          "718201503": {
            "id": "718201503",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Thanks, I owe you big time. Now, I need to get these dishes out, pronto, or else the customers will start complaining..."
          }
        }
      }
    },
    {
      "subId": "7182016",
      "subQuestName": "Talk to Verr Goldet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718201601"
        ],
        "dialogs": {
          "718201601": {
            "id": "718201601",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Oh, you're back. Is Yanxiao...?",
            "nextDialogs": [
              "718201602"
            ]
          },
          "718201602": {
            "id": "718201602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He should be able to manage now.",
            "nextDialogs": [
              "718201603"
            ]
          },
          "718201603": {
            "id": "718201603",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "That's good. Thanks for your help...",
            "nextDialogs": [
              "718201604"
            ]
          },
          "718201604": {
            "id": "718201604",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Nothing here either...",
            "nextDialogs": [
              "718201607"
            ]
          },
          "718201607": {
            "id": "718201607",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Traveler? What a coincidence! I didn't expect you to be here...",
            "nextDialogs": [
              "718201608"
            ]
          },
          "718201608": {
            "id": "718201608",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "One could say I'm delivering Xiao Lanterns... Have you heard about Qingce Village? It's pretty far off from the city. Most of the villagers are either children or the elderly.",
            "nextDialogs": [
              "718201609"
            ]
          },
          "718201609": {
            "id": "718201609",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "So each year around the Lantern Rite, the Ministry of Civil Affairs delegates a representative to bring them some essentials.",
            "nextDialogs": [
              "718201610"
            ]
          },
          "718201610": {
            "id": "718201610",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "The first batch has already been delivered, but I'd like to go a step further and make sure that the festive atmosphere makes its way to the village as well.",
            "nextDialogs": [
              "718201611"
            ]
          },
          "718201611": {
            "id": "718201611",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "That's why I asked poet Qingzhou to prepare some lantern riddles and go to Qingce Village to entertain local children."
          }
        }
      }
    },

    {
      "subId": "7182019",
      "subQuestName": "Talk to Mr. Bohuan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718201901"
        ],
        "dialogs": {
          "718201901": {
            "id": "718201901",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "Thank you! Thank you! *sigh* I'm so careless...",
            "nextDialogs": [
              "718201902"
            ]
          },
          "718201902": {
            "id": "718201902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What were you up to here?",
            "nextDialogs": [
              "718201903"
            ]
          },
          "718201903": {
            "id": "718201903",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "I came here looking for materials. I thought it'd be nice to make some decorative writings and give them to my friends as Lantern Rite gifts...",
            "nextDialogs": [
              "718201904"
            ]
          },
          "718201904": {
            "id": "718201904",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "But I need a few bottles of special ink for those. It was supposed to be just a pleasant, little walk in search of the required ingredients...",
            "nextDialogs": [
              "718201905"
            ]
          },
          "718201905": {
            "id": "718201905",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "I would've never expected to come across all those monsters, never...",
            "nextDialogs": [
              "718201906"
            ]
          },
          "718201906": {
            "id": "718201906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Wang'ya's request...",
            "nextDialogs": [
              "718201907"
            ]
          },
          "718201907": {
            "id": "718201907",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "Go to Qingce Village and do some calligraphy for the villagers... No problem at all. You can count on me.",
            "nextDialogs": [
              "718201908"
            ]
          },
          "718201908": {
            "id": "718201908",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "Qingce Village... Oh, it's the one with a huge population of elderly people...",
            "nextDialogs": [
              "718201909"
            ]
          },
          "718201909": {
            "id": "718201909",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "Here's an idea. Why don't you help me find a Cor Lapis and a Qingxin? I need those to make some ink.",
            "nextDialogs": [
              "718201910"
            ]
          },
          "718201910": {
            "id": "718201910",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You make ink... out of those?",
            "nextDialogs": [
              "718201911"
            ]
          },
          "718201911": {
            "id": "718201911",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "Hahaha, there's a gap in your knowledge, I see. Powdered Cor Lapis dissolved in ink makes the characters shine with the most radiant shade of gold. Truly auspicious!",
            "nextDialogs": [
              "718201912"
            ]
          },
          "718201912": {
            "id": "718201912",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "Qingxin juice, on the other hand, adds a delicate, flowery fragrance to the natural scent of ink. If the ink itself is good enough, those two aromas will compliment each other beautifully.",
            "nextDialogs": [
              "718201915"
            ]
          },
          "718201915": {
            "id": "718201915",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "Ah, that's nothing compared to the lengths some connoisseurs are willing to go to produce their inks.",
            "nextDialogs": [
              "718201916"
            ]
          },
          "718201916": {
            "id": "718201916",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "Let's keep it simple this time. Just gather the materials and give them to me...",
            "nextDialogs": [
              "718201917"
            ]
          },
          "718201917": {
            "id": "718201917",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "Whew... I need a moment to catch my breath. Those monsters scared the life out of me..."
          }
        }
      }
    },
    {
      "subId": "7182020",
      "subQuestName": "Give the materials to Mr. Bohuan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718202001"
        ],
        "dialogs": {
          "718202001": {
            "id": "718202001",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "So, have you found the materials yet?"
          }
        }
      }
    },
    {
      "subId": "7182022",
      "subQuestName": "Talk to Mr. Bohuan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718202201"
        ],
        "dialogs": {
          "718202201": {
            "id": "718202201",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "Alright, I've got everything I need. You can go back to Wang'ya now. I'll head to Wangshu Inn after a short moment's respite."
          }
        }
      }
    },
    {
      "subId": "7182021",
      "subQuestName": "Go back and talk to Wang'ya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718202101"
        ],
        "dialogs": {
          "718202101": {
            "id": "718202101",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Hey, have you found Mr. Bohuan yet? Is he on board with my plan?",
            "nextDialogs": [
              "718202102"
            ]
          },
          "718202102": {
            "id": "718202102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He promised to go with you, but he'll need a moment to get here.",
            "nextDialogs": [
              "718202103"
            ]
          },
          "718202103": {
            "id": "718202103",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Great, I ran into Qingzhou earlier, and he seemed quite perturbed. He went out for a walk, saying that he needed to look for some inspiration.",
            "nextDialogs": [
              "718202104"
            ]
          },
          "718202104": {
            "id": "718202104",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "I'm beyond grateful. I'll wait for Mr. Bohuan here and fill him in on the details.",
            "nextDialogs": [
              "718202105"
            ]
          },
          "718202105": {
            "id": "718202105",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Then, I need to stay the course with all the unfinished matters in Liyue Harbor.",
            "nextDialogs": [
              "718202106"
            ]
          },
          "718202106": {
            "id": "718202106",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Looks like my back-and-forth trips between Wangshu Inn and Liyue Harbor will continue for a while.",
            "nextDialogs": [
              "718202107"
            ]
          },
          "718202107": {
            "id": "718202107",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "We'll head to Qingce Village as soon as I'm done with all the outstanding tasks. Should you wish to join us, you can meet us there.",
            "nextDialogs": [
              "718202108"
            ]
          },
          "718202108": {
            "id": "718202108",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Eh, if only I could handle my workload faster..."
          }
        }
      }
    },
    {
      "subId": "7182024",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718202401"
        ],
        "dialogs": {
          "718202401": {
            "id": "718202401",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "How many outstanding orders do we have... Let's see..."
          }
        }
      }
    },
    {
      "subId": "7182025",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718202501"
        ],
        "dialogs": {
          "718202501": {
            "id": "718202501",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "There's just too much to get through, and it doesn't seem that the Ministry of Civil Affairs can find anyone else to help...",
            "nextDialogs": [
              "718202502"
            ]
          },
          "718202502": {
            "id": "718202502",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Seems like I'm not going back home for the holidays again this year..."
          }
        }
      }
    },
    {
      "subId": "7182026",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718202601"
        ],
        "dialogs": {
          "718202601": {
            "id": "718202601",
            "speakerId": 2410,
            "speakerName": "Mr. Bohuan",
            "text": "Going to Qingce Village to do some calligraphy... Something right up my alley..."
          }
        }
      }
    }
  ]

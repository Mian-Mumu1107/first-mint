    },
    {
      "subId": "7081902",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708190201"
        ],
        "dialogs": {
          "708190201": {
            "id": "708190201",
            "speakerId": 1000,
            "speakerName": "Hannelore",
            "text": "Oh... thank you for your kindness. But as a sister of the Church of Favonius, I cannot accept such gifts.",
            "nextDialogs": [
              "708190202"
            ]
          },
          "708190202": {
            "id": "708190202",
            "speakerId": 1000,
            "speakerName": "Hannelore",
            "text": "For me, it is enough to breathe in a trace of this fragrance as it rides upon the sea wind. Beautiful things belong to the wind, not to any one person. That is the way of those who walk in faith.",
            "nextDialogs": [
              "708190203"
            ]
          },
          "708190203": {
            "id": "708190203",
            "speakerId": 1000,
            "speakerName": "Hannelore",
            "text": "Even so, your kindness, warm as the southern breeze, has reached me. Please accept this book as a small return gift.",
            "nextDialogs": [
              "708190204"
            ]
          },
          "708190204": {
            "id": "708190204",
            "speakerId": 1000,
            "speakerName": "Hannelore",
            "text": "May the Anemo Archon watch over you. And may the road ahead be filled, like this fragrance, with virtue, freedom, and compassion."
          }
        }
      }
    },
    {
      "subId": "7081903",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],

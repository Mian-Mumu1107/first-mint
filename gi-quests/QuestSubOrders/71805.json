  "subQuests": [
    {
      "subId": "7180502",
      "subQuestName": "Help Jifang deliver the book",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718050401"
        ],
        "dialogs": {
          "718050401": {
            "id": "718050401",
            "speakerId": 2009,
            "speakerName": "Gentry De'an",
            "text": "What is it, youngster?",
            "nextDialogs": [
              "718050402"
            ]
          },
          "718050402": {
            "id": "718050402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's the order you placed with Jifang.",
            "nextDialogs": [
              "718050403"
            ]
          },
          "718050403": {
            "id": "718050403",
            "speakerId": 2009,
            "speakerName": "Gentry De'an",
            "text": "The fourth volume of Rex Incognito? I placed this order eons ago. Why has it tarried till now?",
            "nextDialogs": [
              "718050404"
            ]
          },
          "718050404": {
            "id": "718050404",
            "speakerId": 2009,
            "speakerName": "Gentry De'an",
            "text": "Let me see. Huh? A first edition? Why, no wonder it took so long...",
            "nextDialogs": [
              "718050405"
            ]
          },
          "718050405": {
            "id": "718050405",
            "speakerId": 2009,
            "speakerName": "Gentry De'an",
            "text": "To think I'd assumed that Jifang had forgotten about my book amid all the other customers...",
            "nextDialogs": [
              "718050406"
            ]
          },
          "718050406": {
            "id": "718050406",
            "speakerId": 2009,
            "speakerName": "Gentry De'an",
            "text": "Thank you for delivering this book to me, youngster."
          }
        }
      }
    },
    {
      "subId": "7180503",
      "subQuestName": "Help Jifang deliver the book",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718050501"
        ],
        "dialogs": {
          "718050501": {
            "id": "718050501",
            "speakerId": 2003,
            "speakerName": "Uncle Tian",
            "text": "What can I do for you, youngster?",
            "nextDialogs": [
              "718050502"
            ]
          },
          "718050502": {
            "id": "718050502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's the order you placed with Jifang.",
            "nextDialogs": [
              "718050503"
            ]
          },
          "718050503": {
            "id": "718050503",
            "speakerId": 2003,
            "speakerName": "Uncle Tian",
            "text": "The what now? ...Oh, ah yes. I believe I ordered a copy of the Verses of Equilibrium at the Wanwen Bookhouse.",
            "nextDialogs": [
              "718050504"
            ]
          },
          "718050504": {
            "id": "718050504",
            "speakerId": 2003,
            "speakerName": "Uncle Tian",
            "text": "Indeed, indeed, this is the book that I wanted. Haha, I was beginning to think that Jifang might have forgotten about my order, what with the other customers and all...",
            "nextDialogs": [
              "718050505"
            ]
          },
          "718050505": {
            "id": "718050505",
            "speakerId": 2003,
            "speakerName": "Uncle Tian",
            "text": "But it's here now, and that's good. The binding is fairly good as well. Conscientious as always, that Jifang.",
            "nextDialogs": [
              "718050506"
            ]
          },
          "718050506": {
            "id": "718050506",
            "speakerId": 2003,
            "speakerName": "Uncle Tian",
            "text": "Thank you, youngster. I'll take this with me, now."
          }
        }
      }
    },
    {
      "subId": "7180506",
      "subQuestName": "Report back to Jifang",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718050601"
        ],
        "dialogs": {
          "718050601": {
            "id": "718050601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, about those two books...",
            "nextDialogs": [
              "718050602"
            ]
          },
          "718050602": {
            "id": "718050602",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "Have you delivered them?",
            "nextDialogs": [
              "718050603"
            ]
          },
          "718050603": {
            "id": "718050603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, I have.",
            "nextDialogs": [
              "718050604"
            ]
          },
          "718050604": {
            "id": "718050604",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "Thank you. Wanwen Bookhouse has managed to stay open all this time due to the support of our long-time customers.",
            "nextDialogs": [
              "718050605"
            ]
          },
          "718050605": {
            "id": "718050605",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "What's more, these customers are true lovers of books. It should gladden them greatly to receive good ones.",
            "nextDialogs": [
              "718050606"
            ]
          },
          "718050606": {
            "id": "718050606",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "Thanks so much for your help, Traveler. Please take this as compensation for your efforts.",
            "nextDialogs": [
              "718050607"
            ]
          },
          "718050607": {
            "id": "718050607",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "If you should ever wish to purchase any books, feel free to approach me."
          }
        }
      }
    },
    {
      "subId": "7180507",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718050701"
        ],
        "dialogs": {
          "718050701": {
            "id": "718050701",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "So, about those two books...",
            "nextDialogs": [
              "718050702"
            ]
          },
          "718050702": {
            "id": "718050702",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "The two of them are long-time customers of ours. I usually prepare their books beforehand.",
            "nextDialogs": [
              "718050703"
            ]
          },
          "718050703": {
            "id": "718050703",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "But I ended up dragging my feet a little this time due to the surge in business.",
            "nextDialogs": [
              "718050704"
            ]
          },
          "718050704": {
            "id": "718050704",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "They must have gotten impatient..."
          }
        }
      }
    },
    {
      "subId": "7180508",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718050801"
        ],
        "dialogs": {
          "718050801": {
            "id": "718050801",
            "speakerId": 2009,
            "speakerName": "Gentry De'an",
            "text": "Alas, Rex Lapis..."
          }
        }
      }
    },
    {
      "subId": "7180509",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718050901"
        ],
        "dialogs": {
          "718050901": {
            "id": "718050901",
            "speakerId": 2003,
            "speakerName": "Uncle Tian",
            "text": "\"They who read history shall learn how we rise and fall...\" So they say, but there are few who read history to learn these things nowadays..."
          }
        }
      }
    }
  ]
}
    {
      "subId": "7715301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771530101"
        ],
        "dialogs": {
          "771530101": {
            "id": "771530101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Pfft, Paimon thought he'd be at least half as tough as he sounded. But nope, no dice.",
            "nextDialogs": [
              "771530102"
            ]
          },
          "771530102": {
            "id": "771530102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's okay now. We've chased those bad guys off!",
            "nextDialogs": [
              "771530103"
            ]
          },
          "771530103": {
            "id": "771530103",
            "speakerId": 1001,
            "speakerName": "Kalash",
            "text": "Haha! Praise be! I'm outta here — seeya around!",
            "nextDialogs": [
              "771530104"
            ]
          },
          "771530104": {
            "id": "771530104",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "After making sure that there aren't any Volkodlak on his tail, the worker flees the scene.",
            "nextDialogs": [
              "771530105"
            ]
          },
          "771530105": {
            "id": "771530105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey! Wait—!",
            "nextDialogs": [
              "771530106"
            ]
          },
          "771530106": {
            "id": "771530106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hey, what about a thanks? Or, you know, a reward?",
            "nextDialogs": [
              "771530107"
            ]
          },
          "771530107": {
            "id": "771530107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh, what an ungrateful guy. Could've thanked us at least once...",
            "nextDialogs": [
              "771530108"
            ]
          },
          "771530108": {
            "id": "771530108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...Wait a minute. We're not doing this for someone's gratitude or the rewards! Well, not only that, anyway.",
            "nextDialogs": [
              "771530109"
            ]
          },
          "771530109": {
            "id": "771530109",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Forget it. We help a whole bunch without expecting anything in return anyway. Guess we're doing the whole \"super noble adventurer\" thing again today, then!",
            "nextDialogs": [
              "771530110"
            ]
          },
          "771530110": {
            "id": "771530110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Speaking of that, aren't you gonna leave?",
            "nextDialogs": [
              "771530111"
            ]
          },
          "771530111": {
            "id": "771530111",
            "speakerId": 1003,
            "speakerName": "Galiobo",
            "text": "What would be the point? Leave today, get dragged back here by them tomorrow.",
            "nextDialogs": [
              "771530112"
            ]
          },
          "771530112": {
            "id": "771530112",
            "speakerId": 1003,
            "speakerName": "Galiobo",
            "text": "Just leave, you two. You're no match for the Izmaylovs.",
            "nextDialogs": [
              "771530113"
            ]
          },
          "771530113": {
            "id": "771530113",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Heh. That might not be true, you know. Don't underestimate us!",
            "nextDialogs": [
              "771530114"
            ]
          },
          "771530114": {
            "id": "771530114",
            "speakerId": 1003,
            "speakerName": "Galiobo",
            "text": "*sigh* ... You don't understand."
          }
        }
      }
    },
    {
      "subId": "7715304",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771530401"
        ],
        "dialogs": {
          "771530401": {
            "id": "771530401",
            "speakerId": 1004,
            "speakerName": "Menacing Izmaylov",
            "text": "Eat this! Trying to book it without clearing your debt, huh!?",
            "nextDialogs": [
              "771530402"
            ]
          },
          "771530402": {
            "id": "771530402",
            "speakerId": 1001,
            "speakerName": "Kalash",
            "text": "Agh! Gentler, sir, please! How am I supposed to work off my debt if you break my bones...",
            "nextDialogs": [
              "771530403"
            ]
          },
          "771530403": {
            "id": "771530403",
            "speakerId": 1004,
            "speakerName": "Menacing Izmaylov",
            "text": "You glib little... Go on. Move it!",
            "nextDialogs": [
              "771530404"
            ]
          },
          "771530404": {
            "id": "771530404",
            "speakerId": 1001,
            "speakerName": "Kalash",
            "text": "Okay, okay!",
            "nextDialogs": [
              "771530405"
            ]
          },
          "771530405": {
            "id": "771530405",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The Volkodlak escorts the worker away...",
            "nextDialogs": [
              "771530406"
            ]
          },
          "771530406": {
            "id": "771530406",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, that's the one who ran previously! They really caught them, huh..."
          }
        }
      }
    },

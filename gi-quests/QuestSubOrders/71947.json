          "719470102": {
            "id": "719470102",
            "speakerId": 2122,
            "speakerName": "Wei Fengchen",
            "text": "The way the world is now, martial nomads who perform heroic deeds have grown few and far between, and those who seek justice like myself are fewer still.",

              "719470103"
            ]
          },
          "719470103": {
            "id": "719470103",
            "speakerId": 2122,
            "speakerName": "Wei Fengchen",
            "text": "Do not believe those stories written by that village bumpkin in the mountains. Those are not real heroes...",
            "nextDialogs": [
              "719470104"
            ]
          },
          "719470104": {
            "id": "719470104",
            "speakerId": 2122,
            "speakerName": "Wei Fengchen",
            "text": "I have written my experiences down here. Have a look — they should be enough to clear my name."

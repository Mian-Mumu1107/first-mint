        "dialogs": {
          "400480301": {
            "id": "400480301",
            "speakerId": 30106,
            "speakerName": "Enomoto",
            "text": "Come on, man, please! My whole life depends on this!",
            "nextDialogs": [
              "400480302"
            ]
          },
          "400480302": {
            "id": "400480302",
            "speakerId": 30107,
            "speakerName": "Imaizumi",
            "text": "I don't know any other girls, okay? There's no one I can introduce you to.",
            "nextDialogs": [
              "400480303"
            ]
          },
          "400480303": {
            "id": "400480303",
            "speakerId": 30106,
            "speakerName": "Enomoto",
            "text": "No, no, not that. There's no mirror here, so could you trim my beard for me? Just use your weapon, it'll be fine.",
            "nextDialogs": [
              "400480304"
            ]
          },
          "400480304": {
            "id": "400480304",
            "speakerId": 30107,
            "speakerName": "Imaizumi",
            "text": "I've met newly planted carrots with bushier beards than you. I think you're good."
          }
        }

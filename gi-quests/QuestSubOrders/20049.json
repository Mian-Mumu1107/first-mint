  "subQuests": [
    {
      "subId": "2004901",
      "subQuestName": "Talk to Nimrod",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490101"
        ],
        "dialogs": {
          "200490101": {
            "id": "200490101",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "Boy do I need a drink...",
            "nextDialogs": [
              "200490102"
            ]
          },
          "200490102": {
            "id": "200490102",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "But if Eury catches me drinking, it'll be the end of me.",
            "nextDialogs": [
              "200490103"
            ]
          },
          "200490103": {
            "id": "200490103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is everything okay?",
            "nextDialogs": [
              "200490104"
            ]
          },
          "200490104": {
            "id": "200490104",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "Huh? Oh... It's fine, I just fancy a little drink is all.",
            "nextDialogs": [
              "200490105"
            ]
          },
          "200490105": {
            "id": "200490105",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "My wife Eury can't stand it when I drink, though, so I never touch the stuff at home.",
            "nextDialogs": [
              "200490106"
            ]
          },
          "200490106": {
            "id": "200490106",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "All I can do is wait till she's gone out shopping and then slip out for a few quick ones.",
            "nextDialogs": [
              "200490107"
            ]
          },
          "200490107": {
            "id": "200490107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The first step is admitting you have a problem...",
            "nextDialogs": [
              "200490108"
            ]
          },
          "200490108": {
            "id": "200490108",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "Hey! Don't be like that. I'm hardly the only person in Mondstadt who's fond of a drink.",
            "nextDialogs": [
              "200490109"
            ]
          },
          "200490109": {
            "id": "200490109",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "But could you go and distract Eury for a while? Just long enough for one or two brews, you know?",
            "nextDialogs": [
              "200490110"
            ]
          },
          "200490110": {
            "id": "200490110",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "Whenever Eury goes shopping, all it takes is a little too much choice and she'll be there all day trying to make up her mind!",
            "nextDialogs": [
              "200490111"
            ]
          },
          "200490111": {
            "id": "200490111",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "She's guaranteed to keep thinking it over as long as you can keep making sure there's another option...",
            "nextDialogs": [
              "200490113",
              "200490115"
            ]
          },
          "200490113": {
            "id": "200490113",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "Haha, excellent! May your glasses forever flow with the fine wine of good fortune, my friends!"
          },
          "200490115": {
            "id": "200490115",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "Ho-ho, well that depends how long you can...",
            "nextDialogs": [
              "200490116"
            ]
          },
          "200490116": {
            "id": "200490116",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "...N—No, I just need enough time to enjoy one nice drink without having to down it...",
            "nextDialogs": [
              "200490117"
            ]
          },
          "200490117": {
            "id": "200490117",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "Just the one, I swear! You can always trust a tavern-goer in Mondstadt!"
          }
        }
      }
    },
    {
      "subId": "2004902",
      "subQuestName": "Find Eury",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490201"
        ],
        "dialogs": {
          "200490201": {
            "id": "200490201",
            "speakerId": 1463,
            "speakerName": "Eury",
            "text": "Hmm... Sunsettias or apples? Decisions, decisions...",
            "nextDialogs": [
              "200490202"
            ]
          },
          "200490202": {
            "id": "200490202",
            "speakerId": 1463,
            "speakerName": "Eury",
            "text": "*sigh* I wish Nimrod were here, I'd just pick what he wants...",
            "nextDialogs": [
              "200490203"
            ]
          },
          "200490203": {
            "id": "200490203",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Apologies, Eury ma'am. We're all out of sunsettias.",
            "nextDialogs": [
              "200490204"
            ]
          },
          "200490204": {
            "id": "200490204",
            "speakerId": 1463,
            "speakerName": "Eury",
            "text": "Oh, I see. Well, I guess it will have to be apples, then.",
            "nextDialogs": [
              "200490205"
            ]
          },
          "200490205": {
            "id": "200490205",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Ooh... Sorry Eury, I think these apples are starting to turn...",
            "nextDialogs": [
              "200490206"
            ]
          },
          "200490206": {
            "id": "200490206",
            "speakerId": 1463,
            "speakerName": "Eury",
            "text": "Really? Hmm... but there's no other choice.",
            "nextDialogs": [
              "200490207"
            ]
          },
          "200490207": {
            "id": "200490207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Allow us!",
            "nextDialogs": [
              "200490208"
            ]
          },
          "200490208": {
            "id": "200490208",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Huh? Allow you to...?",
            "nextDialogs": [
              "200490209"
            ]
          },
          "200490209": {
            "id": "200490209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "To help.",
            "nextDialogs": [
              "200490210"
            ]
          },
          "200490210": {
            "id": "200490210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Relax. We'll find some fresh <color=#00E1FFFF>sunsettias</color> for you.",
            "nextDialogs": [
              "200490211"
            ]
          },
          "200490211": {
            "id": "200490211",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "...You will? Um, well thanks...!",
            "nextDialogs": [
              "200490212"
            ]
          },
          "200490212": {
            "id": "200490212",
            "speakerId": 1463,
            "speakerName": "Eury",
            "text": "This is great, Nimrod much prefers sunsettias to apples. I'll wait here then."
          }
        }
      }
    },
    {
      "subId": "2004903",
      "subQuestName": "Find Sunsettia",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490301"
        ],
        "dialogs": {
          "200490301": {
            "id": "200490301",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "It's so kind of you to get me some sunsettias, Beatrice bought the last ones just before I got here."
          }
        }
      }
    },
    {
      "subId": "2004904",
      "subQuestName": "Give the Sunsettia",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490601"
        ],
        "dialogs": {
          "200490601": {
            "id": "200490601",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Did you find any sunsettias?",
            "nextDialogs": [
              "200490602"
            ]
          },
          "200490602": {
            "id": "200490602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Will these do?",
            "nextDialogs": [
              "200490603"
            ]
          },
          "200490603": {
            "id": "200490603",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Gosh, that's plenty! This is amazing, thank you!",
            "nextDialogs": [
              "200490604"
            ]
          },
          "200490604": {
            "id": "200490604",
            "speakerId": 1463,
            "speakerName": "Eury",
            "text": "They look really good!",
            "nextDialogs": [
              "200490605"
            ]
          },
          "200490605": {
            "id": "200490605",
            "speakerId": 1463,
            "speakerName": "Eury",
            "text": "...But these apples are so cheap. Maybe I should get some of each?"
          }
        }
      }
    },
    {
      "subId": "2004905",
      "subQuestName": "Report back to Nimrod",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490801"
        ],
        "dialogs": {
          "200490801": {
            "id": "200490801",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "Y—You're back? What's the... situation with Eury?",
            "nextDialogs": [
              "200490802"
            ]
          },
          "200490802": {
            "id": "200490802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Judging by the smell, I'd say he's had more than one...",
            "nextDialogs": [
              "200490803"
            ]
          },
          "200490803": {
            "id": "200490803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Eury is struggling with a big decision as we speak.",
            "nextDialogs": [
              "200490804"
            ]
          },
          "200490804": {
            "id": "200490804",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "Great... great! I, uh... I guess I have time for another then! Bartender—",
            "nextDialogs": [
              "200490805"
            ]
          },
          "200490805": {
            "id": "200490805",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oi! You said just the one! You said you swear!",
            "nextDialogs": [
              "200490806"
            ]
          },
          "200490806": {
            "id": "200490806",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "Hehe... I did, didn't I? Just the one... I swear— I swear this next one is just the one for me! Haha! Bartender...",
            "nextDialogs": [
              "200490807"
            ]
          },
          "200490807": {
            "id": "200490807",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "Thank you, my friends. Please, take these. My gift to you.",
            "nextDialogs": [
              "200490808"
            ]
          },
          "200490808": {
            "id": "200490808",
            "speakerId": 1461,
            "speakerName": "Nimrod",
            "text": "Now, I must get back to my wine! Wine o'clock doesn't come every day..."
          }
        }
      }
    },
    {
      "subId": "2004904",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490401"
        ],
        "dialogs": {
          "200490401": {
            "id": "200490401",
            "speakerId": 1463,
            "speakerName": "Eury",
            "text": "I really am grateful to you... You know what? My husband recently quit drinking for my sake, and he's been so miserable since...",
            "nextDialogs": [
              "200490402"
            ]
          },
          "200490402": {
            "id": "200490402",
            "speakerId": 1463,
            "speakerName": "Eury",
            "text": "Maybe some of his favorite fruit will cheer him up a bit.",
            "nextDialogs": [
              "200490403"
            ]
          },
          "200490403": {
            "id": "200490403",
            "speakerId": 1463,
            "speakerName": "Eury",
            "text": "That said... The apples are better value for money..."
          }
        }
      }
    },
    {
      "subId": "2004905",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490501"
        ],
        "dialogs": {
          "200490501": {
            "id": "200490501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, let's go get those sunsettias pronto!",
            "nextDialogs": [
              "200490502"
            ]
          },
          "200490502": {
            "id": "200490502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We need to keep Eury umm-ing and ahh-ing for as long as possible.",
            "nextDialogs": [
              "200490503"
            ]
          },
          "200490503": {
            "id": "200490503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is it just me or it is weird that Nimrod understands his wife so well?"
          }
        }
      }
    },
    {
      "subId": "2004907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200490701"
        ],
        "dialogs": {
          "200490701": {
            "id": "200490701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That should keep Eury pondering for a good while...",
            "nextDialogs": [
              "200490702"
            ]
          },
          "200490702": {
            "id": "200490702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's go and update Nimrod."
          }
        }
      }
    }
  ]
}
    {
      "subId": "2301003",
      "subQuestName": "Talk to Jafar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230100301"
        ],
        "dialogs": {
          "230100301": {
            "id": "230100301",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "That is an excellent sprig of Mint, indeed! Now, please wait here a while.",
            "nextDialogs": [
              "230100303"
            ]
          },
          "230100303": {
            "id": "230100303",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "This is the Minty Bean Soup, made with the ingredients you brought. Please help yourself.",
            "nextDialogs": [
              "230100304"
            ]
          },
          "230100304": {
            "id": "230100304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thank you.",
            "nextDialogs": [
              "230100305"
            ]
          },
          "230100305": {
            "id": "230100305",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "My pleasure. Enjoy your meal!",
            "nextDialogs": [
              "230100306"
            ]
          },
          "230100306": {
            "id": "230100306",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "To me, eating means leaving all my exhausting work and research behind for a time...",
            "nextDialogs": [
              "230100307"
            ]
          },
          "230100307": {
            "id": "230100307",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "I let my mind flow peacefully through that serene stream... this is how I relax.",
            "nextDialogs": [
              "230100308"
            ]
          },
          "230100308": {
            "id": "230100308",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "Well, enjoy your meal to the fullest. I hope that it can also put your mind at ease."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2301001",
      "subQuestName": "Talk to Jafar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230100101"
        ],
        "dialogs": {
          "230100101": {
            "id": "230100101",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "You seem to be in a rush, my friend. What's bothering you?",
            "nextDialogs": [
              "230100103",
              "230100106"
            ]
          },
          "230100103": {
            "id": "230100103",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "Ah... Indeed, I can see that you are tired and pressed for time.",
            "nextDialogs": [
              "230100104"
            ]
          },
          "230100104": {
            "id": "230100104",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "You must have something on your mind that needs to be resolved as soon as possible.",
            "nextDialogs": [
              "230100109"
            ]
          },
          "230100109": {
            "id": "230100109",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "Rather than rushing about, I'd like to invite you to have a delicious meal with me if you are willing to wait but a little while.",
            "nextDialogs": [
              "230100110"
            ]
          },
          "230100110": {
            "id": "230100110",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "Haste is indeed a normal part of life, yes... but as we often put it, even a raging river must sometimes flow peacefully through a serene stream.",
            "nextDialogs": [
              "230100111"
            ]
          },
          "230100111": {
            "id": "230100111",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "You must take a little break every now and then.",
            "nextDialogs": [
              "230100112"
            ]
          },
          "230100112": {
            "id": "230100112",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "Hmmm...",
            "nextDialogs": [
              "230100113"
            ]
          },
          "230100113": {
            "id": "230100113",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "Why don't we enjoy some Minty Bean Soup together?",
            "nextDialogs": [
              "230100114"
            ]
          },
          "230100114": {
            "id": "230100114",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "You don't have to pay me any Mora. Just help me find a sprig of Mint.",
            "nextDialogs": [
              "230100115"
            ]
          },
          "230100115": {
            "id": "230100115",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "Ah, yes — and don't be too picky when you search for that mint sprig.",
            "nextDialogs": [
              "230100116"
            ]
          },
          "230100116": {
            "id": "230100116",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "Remember, you are just looking for a regular sprig. You aren't looking for troubles of any kind."
          },
          "230100106": {
            "id": "230100106",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "Oh, that's good, that's good.",
            "nextDialogs": [
              "230100107"
            ]
          },
          "230100107": {
            "id": "230100107",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "Still, your steps are hurried. You seek to fix some problem or another, perhaps?",
            "nextDialogs": [
              "230100108"
            ]
          },
          "230100108": {
            "id": "230100108",
            "speakerId": 1000,
            "speakerName": "Jafar",
            "text": "Well, I don't know what problem it is that you seek to solve, but I have a suggestion..."
          }
        }
      }
    },
    {
      "subId": "2301002",
      "subQuestName": "Give the cooking ingredient to Jafar",
      "sceneId": null,
      "locations": [],
      "dialogue": {

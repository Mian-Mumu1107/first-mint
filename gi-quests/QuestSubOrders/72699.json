  "subQuests": [
    {
      "subId": "7269901",
      "subQuestName": "Talk to Yasuhiko Tarou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726990101"
        ],
        "dialogs": {
          "726990101": {
            "id": "726990101",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "I greatly look forward to this duel. I wonder what the extent of your skills is.",
            "nextDialogs": [
              "726990102"
            ]
          },
          "726990102": {
            "id": "726990102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh, what are you doing here...",
            "nextDialogs": [
              "726990103"
            ]
          },
          "726990103": {
            "id": "726990103",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "Actually, when I said previously that 4 warriors had joined, I was including myself in that list.",
            "nextDialogs": [
              "726990104"
            ]
          },
          "726990104": {
            "id": "726990104",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "I'm the organizer, yes, but there were just too few participants...",
            "nextDialogs": [
              "726990105"
            ]
          },
          "726990105": {
            "id": "726990105",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "And anyway, I was born for combat! Since there is a mighty foe before me, I must have my duel!",
            "nextDialogs": [
              "726990106"
            ]
          },
          "726990106": {
            "id": "726990106",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "...Hehe, I've been waiting to say that for a long time now!",
            "nextDialogs": [
              "726990107"
            ]
          },
          "726990107": {
            "id": "726990107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh, Paimon's not sure this person is right in the head.",
            "nextDialogs": [
              "726990108"
            ]
          },
          "726990108": {
            "id": "726990108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Best not to underestimate him all the same.",
            "nextDialogs": [
              "726990109"
            ]
          },
          "726990109": {
            "id": "726990109",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "Exactly! Your desire to show no partiality to your foes fills me with respect for you!",
            "nextDialogs": [
              "726990110"
            ]
          },
          "726990110": {
            "id": "726990110",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "Previously, if I had not looked down on our fourth contestant, I would not have suffered such a terrible defeat.",
            "nextDialogs": [
              "726990111"
            ]
          },
          "726990111": {
            "id": "726990111",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "#But the man I am today is not the man I was yesterday! Come on then, {NICKNAME}, let us duel!",
            "nextDialogs": [
              "726990115",
              "726990113"
            ]
          },
          "726990115": {
            "id": "726990115",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "Bring it on."
          },
          "726990113": {
            "id": "726990113",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "I understand. Take your time to prepare."
          }
        }
      }
    }
  ]
}
    {
      "subId": "7267506",
      "subQuestName": "Talk to Kichiboushi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726750601"
        ],
        "dialogs": {
          "726750601": {
            "id": "726750601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Next, let's bring Kichiboushi onboard The Alcor!",
            "nextDialogs": [
              "726750602"
            ]
          },
          "726750602": {
            "id": "726750602",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Not good. If boat sinks...",
            "nextDialogs": [
              "726750603"
            ]
          },
          "726750603": {
            "id": "726750603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Relax, this boat won't sink.",
            "nextDialogs": [
              "726750604"
            ]
          },
          "726750604": {
            "id": "726750604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This ship took us all the way to Inazuma.",
            "nextDialogs": [
              "726750605"
            ]
          },
          "726750605": {
            "id": "726750605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Exactly! And that's how we came to meet you and Ioroi. So don't worry, it'll be fine!",
            "nextDialogs": [
              "726750606"
            ]
          },
          "726750606": {
            "id": "726750606",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm! Understood.",
            "nextDialogs": [
              "726750607"
            ]
          },
          "726750607": {
            "id": "726750607",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Captain Beidou is a real steady hand, and so are the rest of her crew. Basically, this ship is the safest place on the high seas!",
            "nextDialogs": [
              "726750608"
            ]
          },
          "726750608": {
            "id": "726750608",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm! Yey!"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7267501",
      "subQuestName": "Go to Guyun Stone Forest",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726750101"
        ],
        "dialogs": {
          "726750101": {
            "id": "726750101",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Different from snow mountain. Not cold. No snow.",
            "nextDialogs": [
              "726750102"
            ]
          },
          "726750102": {
            "id": "726750102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This is Guyun Stone Forest! Legend has it that this is where Rex Lapis defeated that, uh, many-headed water snake thingamabob — what was its name again?",
            "nextDialogs": [
              "726750105"
            ]
          },
          "726750105": {
            "id": "726750105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right, that's the one! Osial, the Overlord of the Vortex! This is where it was defeated by Rex Lapis' stone spears and sealed.",
            "nextDialogs": [
              "726750106"
            ]
          },
          "726750106": {
            "id": "726750106",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Ooh!",
            "nextDialogs": [
              "726750107"
            ]
          },
          "726750107": {
            "id": "726750107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Cool, eh? But we fought with it too, y'know? Atop Ningguang's Jade Chamber...",
            "nextDialogs": [
              "726750108"
            ]
          },
          "726750108": {
            "id": "726750108",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Golden Crystalfly!",
            "nextDialogs": [
              "726750109"
            ]
          },
          "726750109": {
            "id": "726750109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, so that was what you were gushing over? C'mon, Paimon's telling a story over here!",
            "nextDialogs": [
              "726750110"
            ]
          },
          "726750110": {
            "id": "726750110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, it does look different from the ones in Inazuma...",
            "nextDialogs": [
              "726750111"
            ]
          },
          "726750111": {
            "id": "726750111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He's probably never seen a Crystalfly that wasn't purple...",
            "nextDialogs": [
              "726750112"
            ]
          },
          "726750112": {
            "id": "726750112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Well... Guess that's true. Alright, alright. Why don't you catch one for him, {NICKNAME}?"
          }
        }
      }
    },
    {
      "subId": "7267502",
      "subQuestName": "Give 1 Crystal Core to Kichiboushi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726750201"
        ],
        "dialogs": {
          "726750201": {
            "id": "726750201",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Kapow~ Crystalfly~ Golden Crystalfly!"
          }
        }
      }
    },
    {
      "subId": "7267503",
      "subQuestName": "Talk to Kichiboushi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726750301"
        ],
        "dialogs": {
          "726750301": {
            "id": "726750301",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "...",
            "nextDialogs": [
              "726750302"
            ]
          },
          "726750302": {
            "id": "726750302",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Not gold.",
            "nextDialogs": [
              "726750303"
            ]
          },
          "726750303": {
            "id": "726750303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? The Crystal Core really isn't golden!",
            "nextDialogs": [
              "726750306"
            ]
          },
          "726750306": {
            "id": "726750306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Come to think of it, Paimon's never really noticed this even though you've caught lots of Crystalflies in the past...",
            "nextDialogs": [
              "726750307"
            ]
          },
          "726750307": {
            "id": "726750307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Is this what they call \"disillusionment\"? You know, the thing that happens when you get older?",
            "nextDialogs": [
              "726750308"
            ]
          },
          "726750308": {
            "id": "726750308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Looks like you're in need of some training yourself, Paimon.",
            "nextDialogs": [
              "726750309"
            ]
          },
          "726750309": {
            "id": "726750309",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "White Fur, can do it.",
            "nextDialogs": [
              "726750310"
            ]
          },
          "726750310": {
            "id": "726750310",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Don't you \"you can do it\" Paimon! You're the one who's training, Kichiboushi.",
            "nextDialogs": [
              "726750311"
            ]
          },
          "726750311": {
            "id": "726750311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Still, it is kinda disappointing. Why are the Crystal Cores of Geo Crystalflies not gold?",
            "nextDialogs": [
              "726750312"
            ]
          },
          "726750312": {
            "id": "726750312",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Right. Gold Crystalfly, why not gold?"
          }
        }
      }
    },
    {
      "subId": "7267504",
      "subQuestName": "Go to a place from which you can see The Alcor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726750401"
        ],
        "dialogs": {
          "726750401": {
            "id": "726750401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "See The Alcor!",
            "nextDialogs": [
              "726750402"
            ]
          },
          "726750402": {
            "id": "726750402",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Amazing! So much water!",
            "nextDialogs": [
              "726750403"
            ]
          },
          "726750403": {
            "id": "726750403",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "And so big! So big, on the water!",
            "nextDialogs": [
              "726750404"
            ]
          },
          "726750404": {
            "id": "726750404",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "So big, must be heavy. Why not sinking?",
            "nextDialogs": [
              "726750405"
            ]
          },
          "726750405": {
            "id": "726750405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's because The Alcor is a ship.",
            "nextDialogs": [
              "726750406"
            ]
          },
          "726750406": {
            "id": "726750406",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "But, mud boat sink. Ioroi tell story. Story of rabbit, bake-danuki, and the mud boat.",
            "nextDialogs": [
              "726750407"
            ]
          },
          "726750407": {
            "id": "726750407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um, well, The Alcor isn't made of mud. That's why it won't sink.",
            "nextDialogs": [
              "726750408"
            ]
          },
          "726750408": {
            "id": "726750408",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Why will not-mud ship not sink?",
            "nextDialogs": [
              "726750409"
            ]
          },
          "726750409": {
            "id": "726750409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, you're becoming more fluent, Kichiboushi. But at the same time, how are we supposed to answer this question...",
            "nextDialogs": [
              "726750410"
            ]
          },
          "726750410": {
            "id": "726750410",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Right! Hehe, {NICKNAME}, why do ships float on the water's surface?",
            "nextDialogs": [
              "726750412",
              "726750415"
            ]
          },
          "726750412": {
            "id": "726750412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? Can Dendro really do that?",
            "nextDialogs": [
              "726750413"
            ]
          },
          "726750413": {
            "id": "726750413",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um... Then why don't hilichurls with wooden shields float?",
            "nextDialogs": [
              "726750416"
            ]
          },
          "726750416": {
            "id": "726750416",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mmmph. Didn't get it.",
            "nextDialogs": [
              "726750417"
            ]
          },
          "726750417": {
            "id": "726750417",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Don't worry, Kichiboushi. Someday, when you're older, you'll be as smart as Paimon! Then you'll understand all these things: why ships float, why it snows in Dragonspine... You'll know it all!"
          },
          "726750415": {
            "id": "726750415",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, is that how it is? Paimon gets it."
          }
        }
      }
    },

    {
      "subId": "7267508",
      "subQuestName": "Climb the mast",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726750801"
        ],
        "dialogs": {
          "726750801": {
            "id": "726750801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "See! The view's great, isn't it?",
            "nextDialogs": [
              "726750802"
            ]
          },
          "726750802": {
            "id": "726750802",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm! Very good!",
            "nextDialogs": [
              "726750803"
            ]
          },
          "726750803": {
            "id": "726750803",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Many mountains over there. What place is that?",
            "nextDialogs": [
              "726750804"
            ]
          },
          "726750804": {
            "id": "726750804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm? Well...",
            "nextDialogs": [
              "726750807"
            ]
          },
          "726750807": {
            "id": "726750807",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's right. That should be Mt. Yougou over there — and beneath it? That's where Chinju Forest is.",
            "nextDialogs": [
              "726750808"
            ]
          },
          "726750808": {
            "id": "726750808",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "So far. Ioroi, across the sea.",
            "nextDialogs": [
              "726750809"
            ]
          },
          "726750809": {
            "id": "726750809",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's right. But we'll be with you all the way!",
            "nextDialogs": [
              "726750810"
            ]
          },
          "726750810": {
            "id": "726750810",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm!",
            "nextDialogs": [
              "726750811"
            ]
          },
          "726750811": {
            "id": "726750811",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well then, where to next...",
            "nextDialogs": [
              "726750812"
            ]
          },
          "726750812": {
            "id": "726750812",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is there somewhere familiar where we can find some good food?"
          }
        }
      }
    },
    {
      "subId": "7226408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722640801"
        ],
        "dialogs": {
          "722640801": {
            "id": "722640801",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Take this child to see the outside world. That which I cannot do myself, I leave to you."
          }
        }
      }
    },
    {
      "subId": "7226414",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722641401"
        ],
        "dialogs": {
          "722641401": {
            "id": "722641401",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm! Training is fun!",
            "nextDialogs": [
              "722641403",
              "722641413"
            ]
          },
          "722641403": {
            "id": "722641403",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "Yellow Fur very strong. Kapow — big and round thing gone.",
            "nextDialogs": [
              "722641404"
            ]
          },
          "722641404": {
            "id": "722641404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's because I train regularly, you know?",
            "nextDialogs": [
              "722641405"
            ]
          },
          "722641405": {
            "id": "722641405",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm! Kichiboushi, become strong like Yellow Fur!",
            "nextDialogs": [
              "722641406"
            ]
          },
          "722641406": {
            "id": "722641406",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "Train, train, and train. Strong-strong!",
            "nextDialogs": [
              "722641407"
            ]
          },
          "722641407": {
            "id": "722641407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do you plan to do once you become stronger, Kichiboushi?",
            "nextDialogs": [
              "722641408"
            ]
          },
          "722641408": {
            "id": "722641408",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "Get back at Gyoubu Koban, mmhaha!",
            "nextDialogs": [
              "722641409"
            ]
          },
          "722641409": {
            "id": "722641409",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "Then make Ioroi not stone.",
            "nextDialogs": [
              "722641410"
            ]
          },
          "722641410": {
            "id": "722641410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Good luck. As for your training route, just leave it to us.",
            "nextDialogs": [
              "722641411"
            ]
          },
          "722641411": {
            "id": "722641411",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm!"
          },
          "722641413": {
            "id": "722641413",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "Yey!"
          }
        }
      }
    }
  ]
}
        "dialogs": {
          "191731498": {
            "id": "191731498",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Keep Tamimi a secret...)",
            "nextDialogs": [
              "191731499"
            ]
          },
          "191731499": {
            "id": "191731499",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Tell the whole truth...)"
          }

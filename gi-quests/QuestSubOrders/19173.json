    {
      "subId": "1917328",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191737101"
        ],
        "dialogs": {
          "191737101": {
            "id": "191737101",
            "speakerId": 12953,
            "speakerName": "Yellowed Note",
            "text": "\"...Tamimi's remodeling is going smoothly. As it is now, it can learn how to deal with various dangerous situations in the ruins on its own. I wish you could see it with your own eyes.\"",
            "nextDialogs": [
              "191737102"
            ]
          },
          "191737102": {
            "id": "191737102",
            "speakerId": 12953,
            "speakerName": "Yellowed Note",
            "text": "\"As I worked, I kept thinking that you'd do a better job at this than I could.\"",
            "nextDialogs": [
              "191737103"
            ]
          },
          "191737103": {
            "id": "191737103",
            "speakerId": 12953,
            "speakerName": "Yellowed Note",
            "text": "\"After all, you're the most exceptional student I've ever met.\""
          }
        }
      }
    },

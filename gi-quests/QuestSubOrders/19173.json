    {
      "subId": "1917305",
      "subQuestName": "Talk with Tighnari as you wait for the results",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191730501"
        ],
        "dialogs": {
          "191730501": {
            "id": "191730501",
            "speakerId": 12936,
            "speakerName": "Tired Villager",
            "text": "The ruins? Don't know anything. We were only hired to deliver water and supplies to them.",
            "nextDialogs": [
              "191730502"
            ]
          },
          "191730502": {
            "id": "191730502",
            "speakerId": 12936,
            "speakerName": "Tired Villager",
            "text": "Forget excavation — they won't even let us get close to the camp where they're staying."
          }
        }
      }
    },
    {
      "subId": "1917306",
      "subQuestName": "Go to the northeast of Hypostyle Desert",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191730601"
        ],
        "dialogs": {
          "191730601": {
            "id": "191730601",
            "speakerId": 12937,
            "speakerName": "Curious Villager",
            "text": "This area used to be ravaged by frequent sandstorms, but it's been calm lately for some reason...",
            "nextDialogs": [
              "191730602"
            ]
          },
          "191730602": {
            "id": "191730602",
            "speakerId": 12937,
            "speakerName": "Curious Villager",
            "text": "They say that this was done by a single traveler? But seriously, is such a thing even humanly possible?"
          }
        }
      }
    },
    {
      "subId": "1917307",
      "subQuestName": "Go to the excavation site",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191730701"
        ],
        "dialogs": {
          "191730701": {
            "id": "191730701",
            "speakerId": 12938,
            "speakerName": "Chatty Villager",
            "text": "That machine looks amazing! Could it be the legendary Ruin Wanderer?",
            "nextDialogs": [
              "191730702"
            ]
          },
          "191730702": {
            "id": "191730702",
            "speakerId": 12938,
            "speakerName": "Chatty Villager",
            "text": "The location seems to fit too... Might that legend actually be true?"
          }
        }
      }
    },

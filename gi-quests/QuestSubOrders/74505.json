        "dialogs": {
          "745050101": {
            "id": "745050101",
            "speakerId": 30413,
            "speakerName": "Armand",
            "text": "H—H—Hello, you t—two... My name is... is... A—A—Armand...",
            "nextDialogs": [
              "745050102"
            ]
          },
          "745050102": {
            "id": "745050102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You seem kinda nervous...",
            "nextDialogs": [
              "745050103"
            ]
          },
          "745050103": {
            "id": "745050103",
            "speakerId": 30413,
            "speakerName": "Armand",
            "text": "S—S—Sorry! I—I get like th—this when th—there are too many... p—p—people around...",
            "nextDialogs": [
              "745050104"
            ]
          },
          "745050104": {
            "id": "745050104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No worries, no worries. You don't have to rush, we're just here to try out the toy!",
            "nextDialogs": [
              "745050105"
            ]
          },
          "745050105": {
            "id": "745050105",
            "speakerId": 30413,
            "speakerName": "Armand",
            "text": "O—Oh. S—S—Sure... I have p—prepared a... h—h—handbook for you...",
            "nextDialogs": [
              "745050106"
            ]
          },
          "745050106": {
            "id": "745050106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aw, that's so nice of you, Armand! We'll read it carefully for sure.",
            "nextDialogs": [
              "745050107"
            ]
          },
          "745050107": {
            "id": "745050107",
            "speakerId": 30413,
            "speakerName": "Armand",
            "text": "I—It's alright if you d—don't read it. It's very s—s—simple and f—fun... D—Do you want to t—try?",
            "nextDialogs": [
              "745050108"
            ]
          },
          "745050108": {
            "id": "745050108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thanks, I'll give it a go.",
            "nextDialogs": [
              "745050109"
            ]
          },
          "745050109": {
            "id": "745050109",
            "speakerId": 30413,
            "speakerName": "Armand",
            "text": "I h—h—hope you... enjoy yourselves."
          }
        }
      }
    }
  ]

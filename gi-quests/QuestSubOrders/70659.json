  "subQuests": [
    {
      "subId": "7065901",
      "subQuestName": "Talk to Gygax",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706590101"
        ],
        "dialogs": {
          "706590101": {
            "id": "706590101",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "Hey there, fancy trying your hand at Windtrace?",
            "nextDialogs": [
              "706590102"
            ]
          },
          "706590102": {
            "id": "706590102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's Windtrace?",
            "nextDialogs": [
              "706590103"
            ]
          },
          "706590103": {
            "id": "706590103",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "I'm glad you asked. Windtrace is a game that's all about Mondstadt's history!",
            "nextDialogs": [
              "706590104"
            ]
          },
          "706590104": {
            "id": "706590104",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "I suppose you've heard of the aristocrats who once lived in Mondstadt City?",
            "nextDialogs": [
              "706590105"
            ]
          },
          "706590105": {
            "id": "706590105",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "They were tyrants, and their rule was brutal. Words cannot do justice to the way that people suffered at their hands...",
            "nextDialogs": [
              "706590106"
            ]
          },
          "706590106": {
            "id": "706590106",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "To fight back against their oppression, a group of brave citizens came together and formed an underground resistance.",
            "nextDialogs": [
              "706590107"
            ]
          },
          "706590107": {
            "id": "706590107",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "These valiant rebels engaged in operations throughout the city, becoming a major thorn in the side of the aristocrats.",
            "nextDialogs": [
              "706590108"
            ]
          },
          "706590108": {
            "id": "706590108",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "But the aristocrats retaliated, quickly training up their own team of henchmen to suppress the rebels.",
            "nextDialogs": [
              "706590109"
            ]
          },
          "706590109": {
            "id": "706590109",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "And so, the rebels fought duel after duel with the aristocrats' lackeys all across Mondstadt.",
            "nextDialogs": [
              "706590110"
            ]
          },
          "706590110": {
            "id": "706590110",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "Windtrace takes its inspiration from this thrilling chapter of Mondstadt's history! And it used to be quite popular, too...",
            "nextDialogs": [
              "706590111"
            ]
          },
          "706590111": {
            "id": "706590111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Used to be?",
            "nextDialogs": [
              "706590112"
            ]
          },
          "706590112": {
            "id": "706590112",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "Sadly, yes. Young people these days don't seem very interested in the game...",
            "nextDialogs": [
              "706590113"
            ]
          },
          "706590113": {
            "id": "706590113",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "But I can't let Windtrace fade into obscurity. So, I tweaked the rules a little to make it easier to get into and more fun.",
            "nextDialogs": [
              "706590114"
            ]
          },
          "706590114": {
            "id": "706590114",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "I also added a whole load of brand-new maps in. Hopefully, this will help to attract more people..."
          }
        }
      }
    },
    {
      "subId": "7065902",
      "subQuestName": "Talk to Gygax",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7065903",
      "subQuestName": "Talk to Gygax",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706590301"
        ],
        "dialogs": {
          "706590301": {
            "id": "706590301",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "Heh. But don't take my word for it — try it out for yourself!",
            "nextDialogs": [
              "706590304"
            ]
          },
          "706590304": {
            "id": "706590304",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "Alright, well, if you're ever interested to try it out, you know where to find me."
          }
        }
      }
    }
  ]
}
      "dialogue": {
        "startDialogs": [
          "726640101"
        ],
        "dialogs": {
          "726640101": {
            "id": "726640101",
            "speakerId": 1000,
            "speakerName": "Linyang",
            "text": "Hmm... I need to place another batch of treasure chests, don't I...",
            "nextDialogs": [
              "726640102"
            ]
          },
          "726640102": {
            "id": "726640102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did I hear someone mention treasure chests?",
            "nextDialogs": [
              "726640103"
            ]
          },
          "726640103": {
            "id": "726640103",
            "speakerId": 1000,
            "speakerName": "Linyang",
            "text": "Eh!? Oh, it's... it's you, Traveler! Are you here to take part in the Moonchase Festival as well?",
            "nextDialogs": [
              "726640104"
            ]
          },
          "726640104": {
            "id": "726640104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You could say that.",
            "nextDialogs": [
              "726640105"
            ]
          },
          "726640105": {
            "id": "726640105",
            "speakerId": 1000,
            "speakerName": "Linyang",
            "text": "Then you've come at the right time! The Adventurers' Guild is currently organizing an event to celebrate the festival.",
            "nextDialogs": [
              "726640106"
            ]
          },
          "726640106": {
            "id": "726640106",
            "speakerId": 1000,
            "speakerName": "Linyang",
            "text": "Would you like to know more?",
            "nextDialogs": [
              "726640110",
              "726640109"
            ]
          },
          "726640110": {
            "id": "726640110",
            "speakerId": 1000,
            "speakerName": "Linyang",
            "text": "During the Moonchase Festival, the Guild has placed Moonchase Charms in various places.",
            "nextDialogs": [
              "726640111"
            ]
          },
          "726640111": {
            "id": "726640111",
            "speakerId": 1000,
            "speakerName": "Linyang",
            "text": "Those who find these Charms can bring them back to us in exchange for various rewards.",
            "nextDialogs": [
              "726640112"
            ]
          },
          "726640112": {
            "id": "726640112",
            "speakerId": 1000,
            "speakerName": "Linyang",
            "text": "We've also dispatched a group of adventurers to place a large batch of special treasure chests out in the wild.",
            "nextDialogs": [
              "726640113"
            ]
          },
          "726640113": {
            "id": "726640113",
            "speakerId": 1000,
            "speakerName": "Linyang",
            "text": "These special treasure chests will come filled with all manner of goodies, which we've prepared just for this occasion!",
            "nextDialogs": [
              "726640114"
            ]
          },
          "726640114": {
            "id": "726640114",
            "speakerId": 1000,
            "speakerName": "Linyang",
            "text": "Other than these two activities, we've also got some tough challenges lined up for elite adventurers!",
            "nextDialogs": [
              "726640115"
            ]
          },
          "726640115": {
            "id": "726640115",
            "speakerId": 1000,
            "speakerName": "Linyang",
            "text": "As for the details, it's... Well, it involves invading a series of monster camps..."
          },
          "726640109": {
            "id": "726640109",
            "speakerId": 1000,
            "speakerName": "Linyang",
            "text": "No, no! This activity is super adventurer-like!"
          }
        }
      }
    }
  ]
}
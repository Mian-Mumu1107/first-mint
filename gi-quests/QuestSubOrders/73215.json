  "subQuests": [
    {
      "subId": "7321501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150101"
        ],
        "dialogs": {
          "732150101": {
            "id": "732150101",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "Hello, Nara friend! Um... I was supposed to tell you something, but I don't remember...",
            "nextDialogs": [
              "732150102"
            ]
          },
          "732150102": {
            "id": "732150102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's okay. We are just happy to see you again!",
            "nextDialogs": [
              "732150103"
            ]
          },
          "732150103": {
            "id": "732150103",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "Well, thank you.",
            "nextDialogs": [
              "732150105",
              "732150107"
            ]
          },
          "732150105": {
            "id": "732150105",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "She's not talking anymore, but she's doing well. Recovering too, the forest is... Thank you."
          },
          "732150107": {
            "id": "732150107",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "Forgetting...? Oh, because the power has been depleted, the Kusava. That's why it will flow away too, memory. Drop by drop, like dewdrops..."
          }
        }
      }
    },
    {
      "subId": "7321503",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150301"
        ],
        "dialogs": {
          "732150301": {
            "id": "732150301",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "Hello, and thank you! Golden Nara and White Floaty!",
            "nextDialogs": [
              "732150302"
            ]
          },
          "732150302": {
            "id": "732150302",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "What are you guys doing here?",
            "nextDialogs": [
              "732150303"
            ]
          },
          "732150303": {
            "id": "732150303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You said to remember to come back and play together!",
            "nextDialogs": [
              "732150304"
            ]
          },
          "732150304": {
            "id": "732150304",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "Oh, did I say that...?",
            "nextDialogs": [
              "732150306",
              "732150308"
            ]
          },
          "732150306": {
            "id": "732150306",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "I see...",
            "nextDialogs": [
              "732150309"
            ]
          },
          "732150309": {
            "id": "732150309",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "Anyway, thank you!"
          },
          "732150308": {
            "id": "732150308",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "Mm... No."
          }
        }
      }
    },
    {
      "subId": "7321504",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150401"
        ],
        "dialogs": {
          "732150401": {
            "id": "732150401",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "Hello, Golden Nara and White Floaty!",
            "nextDialogs": [
              "732150402"
            ]
          },
          "732150402": {
            "id": "732150402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hi! How've you been?",
            "nextDialogs": [
              "732150403"
            ]
          },
          "732150403": {
            "id": "732150403",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "Good! But why did you come here?",
            "nextDialogs": [
              "732150404"
            ]
          },
          "732150404": {
            "id": "732150404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh...?",
            "nextDialogs": [
              "732150405"
            ]
          },
          "732150405": {
            "id": "732150405",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "Well... It's troubling us. There must be a reason, but why you came here, I don't know...",
            "nextDialogs": [
              "732150406"
            ]
          },
          "732150406": {
            "id": "732150406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're familiar with this place after all the adventures we had with you guys!",
            "nextDialogs": [
              "732150407"
            ]
          },
          "732150407": {
            "id": "732150407",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "Oh... Really?",
            "nextDialogs": [
              "732150408"
            ]
          },
          "732150408": {
            "id": "732150408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He doesn't remember our past experiences..."
          }
        }
      }
    },
    {
      "subId": "7321505",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150501"
        ],
        "dialogs": {
          "732150501": {
            "id": "732150501",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Hello, Golden Nara! And you, Little White Floaty!",
            "nextDialogs": [
              "732150502"
            ]
          },
          "732150502": {
            "id": "732150502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph! Paimon is not little! Take a look in the mirror!",
            "nextDialogs": [
              "732150503"
            ]
          },
          "732150503": {
            "id": "732150503",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Hey, I'm not little either! Oh, right, what are you doing here?",
            "nextDialogs": [
              "732150504"
            ]
          },
          "732150504": {
            "id": "732150504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We just came back to see you guys.",
            "nextDialogs": [
              "732150505"
            ]
          },
          "732150505": {
            "id": "732150505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, we defeated a lot of bad guys in the past after all, and we sang together, and saved \"M—Mootaya\" together...",
            "nextDialogs": [
              "732150506"
            ]
          },
          "732150506": {
            "id": "732150506",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Mawtiyima!",
            "nextDialogs": [
              "732150507"
            ]
          },
          "732150507": {
            "id": "732150507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah!",
            "nextDialogs": [
              "732150508"
            ]
          },
          "732150508": {
            "id": "732150508",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Oh... Sorry... What you guys are saying must be true, but I don't remember...",
            "nextDialogs": [
              "732150509"
            ]
          },
          "732150509": {
            "id": "732150509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um...! I—It's okay! Don't be sad!",
            "nextDialogs": [
              "732150510"
            ]
          },
          "732150510": {
            "id": "732150510",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(He really doesn't remember...)"
          }
        }
      }
    },
    {
      "subId": "7321502",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150201"
        ],
        "dialogs": {
          "732150201": {
            "id": "732150201",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Hello, hello!",
            "nextDialogs": [
              "732150202"
            ]
          },
          "732150202": {
            "id": "732150202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hello, little one! Still remember us?",
            "nextDialogs": [
              "732150203"
            ]
          },
          "732150203": {
            "id": "732150203",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Darn White Floaty! I'm not a little one! Do you still remember the song I taught you?",
            "nextDialogs": [
              "732150204"
            ]
          },
          "732150204": {
            "id": "732150204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Of course.",
            "nextDialogs": [
              "732150205"
            ]
          },
          "732150205": {
            "id": "732150205",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Yes!",
            "nextDialogs": [
              "732150206"
            ]
          },
          "732150206": {
            "id": "732150206",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Then promise me that even if I forget my song... you'll remember it!"
          }
        }
      }
    },
    {
      "subId": "7321506",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150601"
        ],
        "dialogs": {
          "732150601": {
            "id": "732150601",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "Golden Nara, White Floaty! You're here!",
            "nextDialogs": [
              "732150602"
            ]
          },
          "732150602": {
            "id": "732150602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah! We're here!",
            "nextDialogs": [
              "732150603"
            ]
          },
          "732150603": {
            "id": "732150603",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "Hehehe... I probably forgot many things, so I need you to remind me...",
            "nextDialogs": [
              "732150604"
            ]
          },
          "732150604": {
            "id": "732150604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is it because of the Kusava?",
            "nextDialogs": [
              "732150605"
            ]
          },
          "732150605": {
            "id": "732150605",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "Yes... Aranaga should have mentioned it to you. Power is in memory, and no memory means no power...",
            "nextDialogs": [
              "732150606"
            ]
          },
          "732150606": {
            "id": "732150606",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "So... We must have experienced something in the past, but we don't remember anymore...",
            "nextDialogs": [
              "732150607"
            ]
          },
          "732150607": {
            "id": "732150607",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "Haha, but it's nothing to me! We can still start making new memories again, right?",
            "nextDialogs": [
              "732150608"
            ]
          },
          "732150608": {
            "id": "732150608",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yes! That's the spirit!"
          }
        }
      }
    },
    {
      "subId": "7321507",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150701"
        ],
        "dialogs": {
          "732150701": {
            "id": "732150701",
            "speakerId": 20578,
            "speakerName": "Aranaga",
            "text": "#Thank you, Nara {NICKNAME} and White Floaty. But now, needs us, Mawtiyima."
          }
        }
      }
    },
    {
      "subId": "7321508",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150801"
        ],
        "dialogs": {
          "732150801": {
            "id": "732150801",
            "speakerId": 20576,
            "speakerName": "Aranakin",
            "text": "Thank you! Don't forget to come see us! But we have to keep Mawtiyima company now, so next time!"
          }
        }
      }
    },
    {
      "subId": "7321509",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150901"
        ],
        "dialogs": {
          "732150901": {
            "id": "732150901",
            "speakerId": 20577,
            "speakerName": "Aragaru",
            "text": "#Bang bang! Ha! Nara {NICKNAME} and White Floaty are mighty! Happy to adventure with you! Thanks!"

        "dialogs": {
          "739070101": {
            "id": "739070101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't know...",
            "nextDialogs": [
              "739070102"
            ]
          },
          "739070102": {
            "id": "739070102",
            "speakerId": 4118,
            "speakerName": "Vasco",
            "text": "I understand. When you embark on an adventure, you can come across a variety of situations anywhere you go. And rainforests and deserts are infested with quite some strange things.",
            "nextDialogs": [
              "739070103"
            ]
          },
          "739070103": {
            "id": "739070103",
            "speakerId": 4118,
            "speakerName": "Vasco",
            "text": "But I'm not going to sea again anytime soon. I'll just wait and see.",
            "nextDialogs": [
              "739070104"
            ]
          },
          "739070104": {
            "id": "739070104",
            "speakerId": 4118,
            "speakerName": "Vasco",
            "text": "This bow is of little use to me now. Do you wish to take it?",
            "nextDialogs": [
              "739070105"
            ]
          },
          "739070105": {
            "id": "739070105",
            "speakerId": 4118,
            "speakerName": "Vasco",
            "text": "I thought ranged weapons like this might be useful at sea or on a deserted island, or even for bowfishing.",
            "nextDialogs": [
              "739070106"
            ]
          },
          "739070106": {
            "id": "739070106",
            "speakerId": 4118,
            "speakerName": "Vasco",
            "text": "Now that I think about it... Nah. Perhaps I should take it one step at a time and learn to use a dagger first."
          }
        }
      }
    }
  ]
}
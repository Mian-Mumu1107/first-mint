    {
      "subId": "7368805",
      "subQuestName": "Defeat Maguu Kengou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880501"
        ],
        "dialogs": {
          "736880501": {
            "id": "736880501",
            "speakerId": 1007,
            "speakerName": "Yuu",
            "text": "In the past, the Archon's Emissary always wore traditional outfits, but today is different."
          }
        }
      }
    },
    {
      "subId": "7368809",
      "subQuestName": "Defeat Maguu Kengou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880901"
        ],
        "dialogs": {
          "736880901": {
            "id": "736880901",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Are you ready, Traveler?",
            "nextDialogs": [
              "736880903",
              "736880905"
            ]
          },
          "736880903": {
            "id": "736880903",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Good. Let's give it our best. I look forward to fighting beside you."
          },
          "736880905": {
            "id": "736880905",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Oh, don't worry, there's still some time. Once you've taken care of everything, we can enter the arena together."
          }
        }
      }
    },
    {
      "subId": "7368806",
      "subQuestName": "Talk to Kamisato Ayaka",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7368803",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880301"
        ],
        "dialogs": {
          "736880301": {
            "id": "736880301",
            "speakerId": 1007,
            "speakerName": "Yuu",
            "text": "Hey look, Miss Kamisato and the Traveler have arrived!",
            "nextDialogs": [
              "736880302"
            ]
          },
          "736880302": {
            "id": "736880302",
            "speakerId": 1008,
            "speakerName": "Sae",
            "text": "Although I've seen illustrations of this outfit before, seeing Miss Kamisato wear it truly brings some unique flair.",
            "nextDialogs": [
              "736880303"
            ]
          },
          "736880303": {
            "id": "736880303",
            "speakerId": 1009,
            "speakerName": "Matsumae",
            "text": "It was worth lining up super early to get front-row seats. I'm really looking forward to today's match!",
            "nextDialogs": [
              "736880304"
            ]
          },
          "736880304": {
            "id": "736880304",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Wow, Ayaka became the center of attention the moment she appeared.",
            "nextDialogs": [
              "736880305"
            ]
          },
          "736880305": {
            "id": "736880305",
            "speakerId": 1001,
            "speakerName": "Reina",
            "text": "Ladies and gentlemen, your attention, please. The Warrior's Spirit exhibition match is about to begin. Please enter the arena in an orderly fashion and take your seats.",
            "nextDialogs": [
              "736880306"
            ]
          },
          "736880306": {
            "id": "736880306",
            "speakerId": 1001,
            "speakerName": "Reina",
            "text": "Miss Kamisato, Traveler, please come with me.",
            "nextDialogs": [
              "736880307"
            ]
          },
          "736880307": {
            "id": "736880307",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Are you ready, Traveler?",
            "nextDialogs": [
              "736880309",
              "736880311"
            ]
          },
          "736880309": {
            "id": "736880309",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Good. Let's give it our best. I look forward to fighting beside you."
          },
          "736880311": {
            "id": "736880311",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Oh, don't worry, there's still some time. Once you've taken care of everything, we can enter the arena together."
          }
        }
      }
    },
    {
      "subId": "7368806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880601"
        ],
        "dialogs": {
          "736880601": {
            "id": "736880601",
            "speakerId": 1008,
            "speakerName": "Sae",
            "text": "The Kamisato Art versus the Maguu Kengou... and don't forget the champion from the competition! This ticket was so worth it!"
          }
        }
      }
    },
    {
      "subId": "7368807",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880701"
        ],
        "dialogs": {
          "736880701": {
            "id": "736880701",
            "speakerId": 1009,
            "speakerName": "Matsumae",
            "text": "I wonder what Ayaka will look like wearing a Fontaine outfit..."

  "subQuests": [
    {
      "subId": "7368801",
      "subQuestName": "Listen to the announcement for the final results of the competition",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880101"
        ],
        "dialogs": {
          "736880101": {
            "id": "736880101",
            "speakerId": 1000,
            "speakerName": "Akatsuki Saemon Juuzou",
            "text": "Your skills are superb. I've been thoroughly bested.",
            "nextDialogs": [
              "736880102"
            ]
          },
          "736880102": {
            "id": "736880102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It was an honor to fight against you.",
            "nextDialogs": [
              "736880103"
            ]
          },
          "736880103": {
            "id": "736880103",
            "speakerId": 1001,
            "speakerName": "Reina",
            "text": "Ladies and gentlemen, after an exhilarating battle, the champion for the Warrior's Spirit Swordfighting Exhibition has been decided! Give it up for... the Traveler!",
            "nextDialogs": [
              "736880104"
            ]
          },
          "736880104": {
            "id": "736880104",
            "speakerId": 1001,
            "speakerName": "Reina",
            "text": "Tomorrow, we will conduct the final exhibition match... The Traveler and Miss Kamisato versus the Almighty Shogun's chosen envoy, an autonomous humanoid known as the \"Maguu Kengou.\"",
            "nextDialogs": [
              "736880105"
            ]
          },
          "736880105": {
            "id": "736880105",
            "speakerId": 1001,
            "speakerName": "Reina",
            "text": "We'll see you then!",
            "nextDialogs": [
              "736880106"
            ]
          },
          "736880106": {
            "id": "736880106",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "That was a most thrilling match, Traveler.",
            "nextDialogs": [
              "736880107"
            ]
          },
          "736880107": {
            "id": "736880107",
            "speakerId": 1003,
            "speakerName": "Hiiragi Chisato",
            "text": "Congratulations, Traveler. You've certainly earned your title as the champion!",
            "nextDialogs": [
              "736880108"
            ]
          },
          "736880108": {
            "id": "736880108",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Paimon had no idea that tomorrow's opponent would be the Maguu Kengou... That name sounds similar to that troublesome one we encountered on Yashiori Island. Oh, Paimon doesn't think it'll be an easy fight.",
            "nextDialogs": [
              "736880109"
            ]
          },
          "736880109": {
            "id": "736880109",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Don't worry, Paimon. The Shogun's chosen envoy may be strong, but tomorrow's match doesn't prohibit the use of Visions. We'll make a formidable team.",
            "nextDialogs": [
              "736880110"
            ]
          },
          "736880110": {
            "id": "736880110",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "As long as we can track its moves, an opportunity to strike back will present itself.",
            "nextDialogs": [
              "736880111"
            ]
          },
          "736880111": {
            "id": "736880111",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Oh, hearing your confidence sure makes Paimon feel better!",
            "nextDialogs": [
              "736880112"
            ]
          },
          "736880112": {
            "id": "736880112",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "I cannot guarantee that we will win, but we must try our best, if just to give the crowd a show they will not forget.",
            "nextDialogs": [
              "736880115"
            ]
          },
          "736880115": {
            "id": "736880115",
            "speakerId": 1003,
            "speakerName": "Hiiragi Chisato",
            "text": "I can tell you two are already raring to go, but it'd be best to conserve your energy and get some rest tonight.",
            "nextDialogs": [
              "736880116"
            ]
          },
          "736880116": {
            "id": "736880116",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "We'll also be able to see Ayaka's new outfit when we wake up tomorrow. Ayaka in a Fontaine dress... Oh, Paimon can't wait!",
            "nextDialogs": [
              "736880117"
            ]
          },
          "736880117": {
            "id": "736880117",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Ah, yes. Well..."
          }
        }
      }
    },
    {
      "subId": "7368802",
      "subQuestName": "Wait until the next day (5:00 – 12:00)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880201"
        ],
        "dialogs": {
          "736880201": {
            "id": "736880201",
            "speakerId": 1005,
            "speakerName": "Hirotatsu",
            "text": "Ah, you're finally here.",
            "nextDialogs": [
              "736880202"
            ]
          },
          "736880202": {
            "id": "736880202",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Ugh, it's Hirotatsu...",
            "nextDialogs": [
              "736880203"
            ]
          },
          "736880203": {
            "id": "736880203",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "The Traveler already beat you a few days ago and won the championship. What else do you have to say, hmmmm?",
            "nextDialogs": [
              "736880204"
            ]
          },
          "736880204": {
            "id": "736880204",
            "speakerId": 1005,
            "speakerName": "Hirotatsu",
            "text": "Don't worry, I'm not here to cause trouble. I just wanted to apologize. Traveler, I lost to you fair and square a few days ago.",
            "nextDialogs": [
              "736880205"
            ]
          },
          "736880205": {
            "id": "736880205",
            "speakerId": 1005,
            "speakerName": "Hirotatsu",
            "text": "Your swordsmanship is excellent. Each strike was precise but not aggressive, which speaks to your character. I ask your forgiveness for misjudging you and offending you with my words and actions.",
            "nextDialogs": [
              "736880208"
            ]
          },
          "736880208": {
            "id": "736880208",
            "speakerId": 1005,
            "speakerName": "Hirotatsu",
            "text": "The two of you must be here to pick up Miss Kamisato. She's in the dressing room right now and should be out soon.",
            "nextDialogs": [
              "736880209"
            ]
          },
          "736880209": {
            "id": "736880209",
            "speakerId": 1005,
            "speakerName": "Hirotatsu",
            "text": "Traveler, before the young lady comes out, I have a bit of a presumptuous request that I hope you can consider.",
            "nextDialogs": [
              "736880210"
            ]
          },
          "736880210": {
            "id": "736880210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure, what is it?",
            "nextDialogs": [
              "736880211"
            ]
          },
          "736880211": {
            "id": "736880211",
            "speakerId": 1005,
            "speakerName": "Hirotatsu",
            "text": "Although the young lady has never mentioned today's exhibition match to us retainers, she has spared a few hours every evening to practice her swordsmanship, despite how busy she is.",
            "nextDialogs": [
              "736880212"
            ]
          },
          "736880212": {
            "id": "736880212",
            "speakerId": 1005,
            "speakerName": "Hirotatsu",
            "text": "The young lady has always been diligent and conscientious. Although it's just an exhibition match and it won't matter if she loses, I trust that she will do her best to win.",
            "nextDialogs": [
              "736880213"
            ]
          },
          "736880213": {
            "id": "736880213",
            "speakerId": 1005,
            "speakerName": "Hirotatsu",
            "text": "As a retainer, I do believe in her of course, but... I still hope you can support the young lady in the arena and ensure her safety.",
            "nextDialogs": [
              "736880214"
            ]
          },
          "736880214": {
            "id": "736880214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry, I will.",
            "nextDialogs": [
              "736880215"
            ]
          },
          "736880215": {
            "id": "736880215",
            "speakerId": 1005,
            "speakerName": "Hirotatsu",
            "text": "Traveler, I leave the young lady in your hands.",
            "nextDialogs": [
              "736880217"
            ]
          },
          "736880217": {
            "id": "736880217",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Oh, that must be Ayaka!",
            "nextDialogs": [
              "736880218"
            ]
          },
          "736880218": {
            "id": "736880218",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Wow...",
            "nextDialogs": [
              "736880219"
            ]
          },
          "736880219": {
            "id": "736880219",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Oh? What's the matter? Why are you two so silent...? Is there something wrong with the outfit?",
            "nextDialogs": [
              "736880220"
            ]
          },
          "736880220": {
            "id": "736880220",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Not at all! Ayaka, you look amazing... You're radiating beauty!"
          }
        }
      }
    },
    {
      "subId": "7368803",
      "subQuestName": "Go to the Kamisato Estate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7368804",
      "subQuestName": "Go to the arena",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880401"
        ],
        "dialogs": {
          "736880401": {
            "id": "736880401",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Traveler, Ayaka, we're over here!",
            "nextDialogs": [
              "736880402"
            ]
          },
          "736880402": {
            "id": "736880402",
            "speakerId": 1003,
            "speakerName": "Hiiragi Chisato",
            "text": "That was an extraordinary match. I don't know much about swordsmanship, but even I was caught up in the tense atmosphere of the arena. My heart's still pounding even now.",
            "nextDialogs": [
              "736880403"
            ]
          },
          "736880403": {
            "id": "736880403",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Your opponent's moves kept surprising Paimon, but it seems like the two of you were prepared for that.",
            "nextDialogs": [
              "736880404"
            ]
          },
          "736880404": {
            "id": "736880404",
            "speakerId": 1006,
            "speakerName": "Kujou Sara",
            "text": "Traveler, Miss Kamisato, congratulations on winning the exhibition match.",
            "nextDialogs": [
              "736880405"
            ]
          },
          "736880405": {
            "id": "736880405",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Hey, it's Sara. You came to watch the competition too?",
            "nextDialogs": [
              "736880406"
            ]
          },
          "736880406": {
            "id": "736880406",
            "speakerId": 1006,
            "speakerName": "Kujou Sara",
            "text": "I was ordered by the Almighty Shogun to observe this competition. You two displayed remarkable swordsmanship and cooperation. Not only did you present the beauty of the sword arts to the audience, I was also able to learn quite a bit myself.",
            "nextDialogs": [
              "736880407"
            ]
          },
          "736880407": {
            "id": "736880407",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "I'm flattered.",
            "nextDialogs": [
              "736880408"
            ]
          },
          "736880408": {
            "id": "736880408",
            "speakerId": 1006,
            "speakerName": "Kujou Sara",
            "text": "All of you have been busy with various preparations for the competition. Today marks a perfect ending to this Warrior's Spirit event. Your efforts have been recognized by the Almighty Shogun.",
            "nextDialogs": [
              "736880409"
            ]
          },
          "736880409": {
            "id": "736880409",
            "speakerId": 1006,
            "speakerName": "Kujou Sara",
            "text": "I must return to the Tenshukaku and report on what happened at the exhibition match to the Almighty Shogun. Everyone, please excuse me.",
            "nextDialogs": [
              "736880411"
            ]
          },
          "736880411": {
            "id": "736880411",
            "speakerId": 1003,
            "speakerName": "Hiiragi Chisato",
            "text": "By the way, does everyone have plans now? If not, why don't we go to Uyuu Restaurant for a victory meal?",
            "nextDialogs": [
              "736880412"
            ]
          },
          "736880412": {
            "id": "736880412",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Great idea! We've been so focused on the competition lately that it's been a while since we've had a good meal! Let's go!",
            "nextDialogs": [
              "736880413"
            ]
          },
          "736880413": {
            "id": "736880413",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Whew...",
            "nextDialogs": [
              "736880414"
            ]
          },
          "736880414": {
            "id": "736880414",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong, Ayaka?",
            "nextDialogs": [
              "736880415"
            ]
          },
          "736880415": {
            "id": "736880415",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Oh, it's nothing. The effects of winning are only now starting to sink in. Kujou Sara said that she learned a lot from the fight, and so did I.",
            "nextDialogs": [
              "736880416"
            ]
          },
          "736880416": {
            "id": "736880416",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Although the audience members might not have noticed, there were many moments where I would've been in trouble if it weren't for you by my side drawing away the opponent's attacks.",
            "nextDialogs": [
              "736880417"
            ]
          },
          "736880417": {
            "id": "736880417",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Without you, it would've been impossible for me to win on my own. It's just as I expected, my swordsmanship is still far from your level.",
            "nextDialogs": [
              "736880420"
            ]
          },
          "736880420": {
            "id": "736880420",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Really? Hearing you say that makes me want to spar with you all of a sudden.",
            "nextDialogs": [
              "736880421"
            ]
          },
          "736880421": {
            "id": "736880421",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "To tell you the truth, I've been hoping for an opportunity to spar with you ever since we first met. That wish was half fulfilled today at the exhibition match.",
            "nextDialogs": [
              "736880422"
            ]
          },
          "736880422": {
            "id": "736880422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Next time, we'll find a chance to go a few rounds.",
            "nextDialogs": [
              "736880423"
            ]
          },
          "736880423": {
            "id": "736880423",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Sure. But... until then, make sure you take good care of your sword. If I ever manage to steal it one day, your life will also be in my hands.",
            "nextDialogs": [
              "736880424"
            ]
          },
          "736880424": {
            "id": "736880424",
            "speakerId": 1002,
            "speakerName": "Kamisato Ayaka",
            "text": "Hehe... I've always wanted to say something like that. Did it sound strange?"
          }
        }
      }
    },
    {
      "subId": "7368808",
      "subQuestName": "Enter the arena",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

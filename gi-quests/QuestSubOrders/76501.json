        ],
        "dialogs": {
          "765010801": {
            "id": "765010801",
            "speakerId": 1315,
            "speakerName": "Lauma",
            "text": "How did it go? Have you found the photo-taking material you envisioned?",
            "nextDialogs": [
              "765010804"
            ]
          },
          "765010804": {
            "id": "765010804",
            "speakerId": 1315,
            "speakerName": "Lauma",
            "text": "A wonderful proposition. That said, I don't see your Kamera anywhere on you. Without it, even the most peerless vistas cannot be transformed into pictures to be remembered, no?"
          }
        }
      }
    }

      "dialogue": {
        "startDialogs": [
          "700520101"
        ],
        "dialogs": {
          "700520101": {
            "id": "700520101",
            "speakerId": 1050,
            "speakerName": "Tighnari",
            "text": "#Hey there, {NICKNAME}. Seems like this sea of flowers caught your eye as well?",
            "nextDialogs": [
              "700520103",
              "700520105"
            ]
          },
          "700520103": {
            "id": "700520103",
            "speakerId": 1050,
            "speakerName": "Tighnari",
            "text": "Great idea. These flowers are all species I've never seen before... There's a real need to document them.",
            "nextDialogs": [
              "700520106"
            ]
          },
          "700520106": {
            "id": "700520106",
            "speakerId": 1050,
            "speakerName": "Tighnari",
            "text": "Hear me out... These flowers have developed some pretty miraculous traits — you'll see what I mean when you touch them...",
            "nextDialogs": [
              "700520107"
            ]
          },
          "700520107": {
            "id": "700520107",
            "speakerId": 1050,
            "speakerName": "Tighnari",
            "text": "And I think we should try to include these traits in our photos.",
            "nextDialogs": [
              "700520108"
            ]
          },
          "700520108": {
            "id": "700520108",
            "speakerId": 1050,
            "speakerName": "Tighnari",
            "text": "These flowers sure are gorgeous... It's almost like they've been enchanted.",
            "nextDialogs": [
              "700520109"
            ]
          },
          "700520109": {
            "id": "700520109",
            "speakerId": 1050,
            "speakerName": "Tighnari",
            "text": "It might seem a little weird for me to say that, but trust me, the natural world can produce marvels that are just as wondrous as magic.",
            "nextDialogs": [
              "700520110"
            ]
          },
          "700520110": {
            "id": "700520110",
            "speakerId": 1050,
            "speakerName": "Tighnari",
            "text": "Whenever I encounter such wonders, I just want to snap a picture right away.",
            "nextDialogs": [
              "700520111"
            ]
          },
          "700520111": {
            "id": "700520111",
            "speakerId": 1050,
            "speakerName": "Tighnari",
            "text": "In a sense, I suppose that lines up with your way of thinking as well.",
            "nextDialogs": [
              "700520112"
            ]
          },
          "700520112": {
            "id": "700520112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's time for your picture, Tighnari!",
            "nextDialogs": [
              "700520113"
            ]
          },
          "700520113": {
            "id": "700520113",
            "speakerId": 1050,
            "speakerName": "Tighnari",
            "text": "Fantastic. This is the perfect spot to take one.",
            "nextDialogs": [
              "700520114"
            ]
          },
          "700520114": {
            "id": "700520114",
            "speakerId": 1050,
            "speakerName": "Tighnari",
            "text": "Hmm, how should I pose for this picture... Do you have any suggestions?"
          },
          "700520105": {
            "id": "700520105",
            "speakerId": 1050,
            "speakerName": "Tighnari",
            "text": "You are? Haha, I guess it has been a long time since we last saw each other."
          }
        }
      }
    }
  ]

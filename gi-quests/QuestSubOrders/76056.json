  "subQuests": [
    {
      "subId": "7605601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760560201"
        ],
        "dialogs": {
          "760560201": {
            "id": "760560201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just a few? I can trade more than that if you'd like.",
            "nextDialogs": [
              "760560202"
            ]
          },
          "760560202": {
            "id": "760560202",
            "speakerId": 1000,
            "speakerName": "Terho",
            "text": "Haha, that's the spirit! Nothing beats a good ol' brawl between real fighters, am I right? Bielov, how about you start us off — go a few rounds with our guest, why don't you?",
            "nextDialogs": [
              "760560205"
            ]
          },
          "760560205": {
            "id": "760560205",
            "speakerId": 1001,
            "speakerName": "Bielov",
            "text": "You got it, Boss! I'll end this in three moves!"
          }
        }
      }
    },
    {
      "subId": "7605604",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760560401"
        ],
        "dialogs": {
          "760560401": {
            "id": "760560401",
            "speakerId": 1001,
            "speakerName": "Bielov",
            "text": "S-Sorry, boss... I let everyone down...",
            "nextDialogs": [
              "760560402"
            ]
          },
          "760560402": {
            "id": "760560402",
            "speakerId": 1000,
            "speakerName": "Terho",
            "text": "Hey, it's no big deal — we're just messing around. Bielov, go take a breather on the side.",
            "nextDialogs": [
              "760560403"
            ]
          },
          "760560403": {
            "id": "760560403",
            "speakerId": 1000,
            "speakerName": "Terho",
            "text": "You've got some slick moves, friend! The name's Terho — pleasure to meet you!",
            "nextDialogs": [
              "760560404"
            ]
          },
          "760560404": {
            "id": "760560404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#I'm {NICKNAME}. Pleased to meet you, too!",
            "nextDialogs": [
              "760560405"
            ]
          },
          "760560405": {
            "id": "760560405",
            "speakerId": 1000,
            "speakerName": "Terho",
            "text": "I can tell you've seen your fair share of real combat. Guess we'll need to step it up. That last bout didn't count — let's go again! Incali, you're up!",
            "nextDialogs": [
              "760560406"
            ]
          },
          "760560406": {
            "id": "760560406",
            "speakerId": 1002,
            "speakerName": "Incali",
            "text": "Hmph, Boss, you only think of me when we're in trouble... Honestly. Well then, skilled one, shall we begin?"
          }
        }
      }
    },
    {
      "subId": "7605605",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760560501"
        ],
        "dialogs": {
          "760560501": {
            "id": "760560501",
            "speakerId": 1002,
            "speakerName": "Incali",
            "text": "I—I lost...? To some random passerby?! Th—This can't be real!",
            "nextDialogs": [
              "760560502"
            ]
          },
          "760560502": {
            "id": "760560502",
            "speakerId": 1000,
            "speakerName": "Terho",
            "text": "Hmph, so even Incali couldn't win... I've definitely been taking you too lightly.",
            "nextDialogs": [
              "760560503"
            ]
          },
          "760560503": {
            "id": "760560503",
            "speakerId": 1001,
            "speakerName": "Bielov",
            "text": "It's not your fault, Boss. Who'd have thought someone that strong would just happen to walk by...",
            "nextDialogs": [
              "760560504"
            ]
          },
          "760560504": {
            "id": "760560504",
            "speakerId": 1002,
            "speakerName": "Incali",
            "text": "Boss! We can't let them off the hook...",
            "nextDialogs": [
              "760560505"
            ]
          },
          "760560505": {
            "id": "760560505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oh-ho, so we're not just here to spar then?",
            "nextDialogs": [
              "760560506"
            ]
          },
          "760560506": {
            "id": "760560506",
            "speakerId": 1000,
            "speakerName": "Terho",
            "text": "Don't get the wrong idea. Incali just means... We can't give up on winning so easily. After all, we're treasure hunters with a reputation to uphold.",
            "nextDialogs": [
              "760560507"
            ]
          },
          "760560507": {
            "id": "760560507",
            "speakerId": 1000,
            "speakerName": "Terho",
            "text": "#{NICKNAME}, I formally issue you a challenge. This time it's not just for fun — let's go all out and see what we're really made of!",
            "nextDialogs": [
              "760560508"
            ]
          },
          "760560508": {
            "id": "760560508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Then I'll take all three of you at once.",
            "nextDialogs": [
              "760560509"
            ]
          },
          "760560509": {
            "id": "760560509",
            "speakerId": 1000,
            "speakerName": "Terho",
            "text": "Alright then, we won't hold back!"
          }
        }
      }
    },
    {
      "subId": "7605606",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760560601"
        ],
        "dialogs": {
          "760560601": {
            "id": "760560601",
            "speakerId": 1002,
            "speakerName": "Incali",
            "text": "Can't believe I lost to this passerby... three times!",
            "nextDialogs": [
              "760560602"
            ]
          },
          "760560602": {
            "id": "760560602",
            "speakerId": 1001,
            "speakerName": "Bielov",
            "text": "No, no, you and I lost twice each, and the boss only lost once, so it's not that bad...",
            "nextDialogs": [
              "760560603"
            ]
          },
          "760560603": {
            "id": "760560603",
            "speakerId": 1000,
            "speakerName": "Terho",
            "text": "#Heh! A loss is a loss, no point brooding over it. This {NICKNAME}'s really something else!",
            "nextDialogs": [
              "760560604"
            ]
          },
          "760560604": {
            "id": "760560604",
            "speakerId": 1000,
            "speakerName": "Terho",
            "text": "You two can't even beat me on a good day — and now you've seen a real master in action. See? You've got a lot of training to do.",
            "nextDialogs": [
              "760560605"
            ]
          },
          "760560605": {
            "id": "760560605",
            "speakerId": 1000,
            "speakerName": "Terho",
            "text": "As for me? Hah... Maybe it's time to consider early retirement. I wonder if Vaino's training ground is still hiring..."
          }
        }
      }
    },
    {
      "subId": "7605607",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760560701"
        ],
        "dialogs": {
          "760560701": {
            "id": "760560701",
            "speakerId": 1000,
            "speakerName": "Terho",
            "text": "Ah, so you're back! Bielov, you're up first! So, friend, ready to go a few rounds with us?"
          }
        }
      }
    },
    {
      "subId": "7605601",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760560101"

        "dialogs": {
          "760560101": {
            "id": "760560101",
            "speakerId": 1000,
            "speakerName": "Terho",
            "text": "Hi, friend! Just gonna shoot targets all day? Doesn't that get a little dull? With skills like that, why not try trading a few blows with us?"
          }
        }
      }
    },
    {

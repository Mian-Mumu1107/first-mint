        ],
        "dialogs": {
          "730580101": {
            "id": "730580101",
            "speakerId": 1000,
            "speakerName": "Aragaru",
            "text": "Golden Nara and White Floaty, you are here again!",
            "nextDialogs": [
              "730580102"
            ]
          },
          "730580102": {
            "id": "730580102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa! Say hello before jumping out next time! You scared Paimon again!",
            "nextDialogs": [
              "730580105"
            ]
          },
          "730580105": {
            "id": "730580105",
            "speakerId": 1000,
            "speakerName": "Aragaru",
            "text": "Hmph... You're right... So, Golden Nara and White Floaty who don't look like bad guys, could you do me a favor?",
            "nextDialogs": [
              "730580106"
            ]
          },
          "730580106": {
            "id": "730580106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#Sure thing. I'm {NICKNAME}.",
            "nextDialogs": [
              "730580107"
            ]
          },
          "730580107": {
            "id": "730580107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And Paimon is Paimon, don't forget that again!",
            "nextDialogs": [
              "730580108"
            ]
          },
          "730580108": {
            "id": "730580108",
            "speakerId": 1000,
            "speakerName": "Aragaru",
            "text": "Again...? Uh... Ahem, I'm Aragaru!",
            "nextDialogs": [
              "730580109"
            ]
          },
          "730580109": {
            "id": "730580109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#We have been here with you, but you forgot it all... Ugh, too much explanation! {NICKNAME}, why don't we do that together?",
            "nextDialogs": [
              "730580110"
            ]
          },
          "730580110": {
            "id": "730580110",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You describe your adventure with Aragaru in detail.",
            "nextDialogs": [
              "730580111"
            ]
          },
          "730580111": {
            "id": "730580111",
            "speakerId": 1000,
            "speakerName": "Aragaru",
            "text": "Is that so...? I can't remember, but I somehow want to believe you... And you have the flower I gave, I can feel her.",
            "nextDialogs": [
              "730580112"
            ]
          },
          "730580112": {
            "id": "730580112",
            "speakerId": 1000,
            "speakerName": "Aragaru",
            "text": "Ah, right! The bad Nara set up a campsite. Let's see what they left there. Maybe we could know their plans!"
          }
        }
      }
    },

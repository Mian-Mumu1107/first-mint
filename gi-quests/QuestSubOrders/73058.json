    {
      "subId": "7305804",
      "subQuestName": "Talk to Aragaru",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730580201"
        ],
        "dialogs": {
          "730580201": {
            "id": "730580201",
            "speakerId": 1000,
            "speakerName": "Aragaru",
            "text": "How is it? Did you find anything?",
            "nextDialogs": [
              "730580202"
            ]
          },
          "730580202": {
            "id": "730580202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... Nothing but vague orders, and this! A dried flower!",
            "nextDialogs": [
              "730580203"
            ]
          },
          "730580203": {
            "id": "730580203",
            "speakerId": 1000,
            "speakerName": "Aragaru",
            "text": "Eh...! This flower, can I have it?",
            "nextDialogs": [
              "730580204"
            ]
          },
          "730580204": {
            "id": "730580204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's from the bad guys, aren't you afraid of getting poisoned... or something like that?",
            "nextDialogs": [
              "730580205"
            ]
          },
          "730580205": {
            "id": "730580205",
            "speakerId": 1000,
            "speakerName": "Aragaru",
            "text": "No need to worry, I have seen the flower before... The person, I should know... Please give it to me, okay?",
            "nextDialogs": [
              "730580206"
            ]
          },
          "730580206": {
            "id": "730580206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Of course, here.",
            "nextDialogs": [
              "730580207"
            ]
          },
          "730580207": {
            "id": "730580207",
            "speakerId": 1000,
            "speakerName": "Aragaru",
            "text": "#Thank you! Nara {NICKNAME} and White Floaty!",
            "nextDialogs": [
              "730580208"
            ]
          },
          "730580208": {
            "id": "730580208",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Aragaru brought the little dried flower to Mawtiyima Forest..."
          }
        }
      }
    },
    {

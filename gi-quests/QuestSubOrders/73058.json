          "730580401": {
            "id": "730580401",
            "speakerId": 1000,
            "speakerName": "Aragaru",
            "text": "Let's go to the bad Nara's campsite and find out what they're up to!",
            "nextDialogs": [
              "730580402"
            ]
          },
          "730580402": {
            "id": "730580402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How can you tell if someone's bad?",
            "nextDialogs": [
              "730580403"
            ]
          },
          "730580403": {
            "id": "730580403",
            "speakerId": 1000,
            "speakerName": "Aragaru",
            "text": "#Well, I can't really explain it, but Nara {NICKNAME} and White Floaty are not baddies for sure! I believe that!"
          }
        }

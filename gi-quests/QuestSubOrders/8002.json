        "dialogs": {
          "80020701": {
            "id": "80020701",
            "speakerId": 1005,
            "speakerName": "Abyss Herald",
            "text": "Hmph... The ceremony was interrupted. How fortunate for you.",
            "nextDialogs": [
              "80020702"
            ]
          },
          "80020702": {
            "id": "80020702",
            "speakerId": 1005,
            "speakerName": "Abyss Herald",
            "text": "How does an old spirit have such determined will...?",
            "nextDialogs": [
              "80020703"
            ]
          },
          "80020703": {
            "id": "80020703",
            "speakerId": 1005,
            "speakerName": "Abyss Herald",
            "text": "No matter. This is but a small unforeseen variable. Our grand scheme will not be affected.",
            "nextDialogs": [
              "80020704"
            ]
          },
          "80020704": {
            "id": "80020704",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It disappeared again...",
            "nextDialogs": [
              "80020707"
            ]
          },
          "80020707": {
            "id": "80020707",
            "speakerId": 1004,
            "speakerName": "Razor",
            "text": "Thank you, you came... just in time.",
            "nextDialogs": [
              "80020708"
            ]
          },
          "80020708": {
            "id": "80020708",
            "speakerId": 1006,
            "speakerName": "Boreas",
            "text": "Human Lupical... I am ashamed that you must see me in my present state.",
            "nextDialogs": [
              "80020709"
            ]
          },
          "80020709": {
            "id": "80020709",
            "speakerId": 1006,
            "speakerName": "Boreas",
            "text": "But still, the Abyss Herald underestimated my strength.",
            "nextDialogs": [
              "80020710"
            ]
          },
          "80020710": {
            "id": "80020710",
            "speakerId": 1004,
            "speakerName": "Razor",
            "text": "Lupus Boreas never refuses trial. But, scary outsider... not respect trial rules.",
            "nextDialogs": [
              "80020711"
            ]
          },
          "80020711": {
            "id": "80020711",
            "speakerId": 1004,
            "speakerName": "Razor",
            "text": "I, too, didn't see... the trap...",
            "nextDialogs": [
              "80020712"
            ]
          },
          "80020712": {
            "id": "80020712",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait... So you mean, the Abyss Order had everything prepared to corrupt Lupus Boreas' mind, then lured him out under the pretense of challenging him in a trial?"
          }
        }
      }

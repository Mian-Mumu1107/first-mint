    {
      "subId": "7318905",
      "subQuestName": "Talk to Soheil",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731100601"
        ],
        "dialogs": {
          "731100601": {
            "id": "731100601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We explored the Transparent Ruins.",
            "nextDialogs": [
              "731100602"
            ]
          },
          "731100602": {
            "id": "731100602",
            "speakerId": 1000,
            "speakerName": "Soheil",
            "text": "You went to the Transparent Ruins? Did you find anything?",
            "nextDialogs": [
              "731100603"
            ]
          },
          "731100603": {
            "id": "731100603",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Of course. Be prepared to be thunderstruck!",
            "nextDialogs": [
              "731100604"
            ]
          },
          "731100604": {
            "id": "731100604",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You recount your exploration of the Transparent Ruins to Soheil and give him the three stone slates.",
            "nextDialogs": [
              "731100605"
            ]
          },
          "731100605": {
            "id": "731100605",
            "speakerId": 1000,
            "speakerName": "Soheil",
            "text": "Aha! So King Deshret did indeed withhold a secret behind that unknown force. I shall get to the bottom of it.",
            "nextDialogs": [
              "731100606"
            ]
          },
          "731100606": {
            "id": "731100606",
            "speakerId": 1000,
            "speakerName": "Soheil",
            "text": "...",
            "nextDialogs": [
              "731100607"
            ]
          },
          "731100607": {
            "id": "731100607",
            "speakerId": 1000,
            "speakerName": "Soheil",
            "text": "This is...",
            "nextDialogs": [
              "731100608"
            ]
          },
          "731100608": {
            "id": "731100608",
            "speakerId": 1000,
            "speakerName": "Soheil",
            "text": "How could this be...?",
            "nextDialogs": [
              "731100609"
            ]
          },
          "731100609": {
            "id": "731100609",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, you look pale... Did you discover something terrible?",
            "nextDialogs": [
              "731100610"
            ]
          },
          "731100610": {
            "id": "731100610",
            "speakerId": 1000,
            "speakerName": "Soheil",
            "text": "Uh... No, sorry, they're not exactly \"terrible\"... The writings on the stone slates look complicated, but they're actually... Records of leave requests.",
            "nextDialogs": [
              "731100611"
            ]
          },
          "731100611": {
            "id": "731100611",
            "speakerId": 1000,
            "speakerName": "Soheil",
            "text": "In addition, the recorded excuses are not any different from that of the young scholars today...",
            "nextDialogs": [
              "731100612"
            ]
          },
          "731100612": {
            "id": "731100612",
            "speakerId": 1000,
            "speakerName": "Soheil",
            "text": "Phew, it's a good thing I failed to find a way to access the Transparent Ruins back in the day. I imagine that I would have been quite livid.",
            "nextDialogs": [
              "731100613"
            ]
          },
          "731100613": {
            "id": "731100613",
            "speakerId": 1000,
            "speakerName": "Soheil",
            "text": "Anyway, I must thank you for bringing the slates back. Perhaps I should go ask around about the excuses people make in Mondstadt. That could be enough for me to write a paper...",
            "nextDialogs": [
              "731100614"
            ]
          },
          "731100614": {
            "id": "731100614",
            "speakerId": 1000,
            "speakerName": "Soheil",
            "text": "\"Time Out From a Busy Schedule: On the Evolution of the Perception of Off-Days in Different Societies.\""
          }
        }
      }
    }
  ]
}
    {
      "subId": "7403301",
      "subQuestName": "Talk to Caterpillar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740330101"
        ],
        "dialogs": {
          "740330101": {
            "id": "740330101",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "No one comes here anymore after the Geode Mine Shaft was closed, and the devices here aren't meant for just anyone to handle.",
            "nextDialogs": [
              "740330102"
            ]
          },
          "740330102": {
            "id": "740330102",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "And that's exactly what happened this time. Someone tinkered with the drive valve and trapped their own companion.",
            "nextDialogs": [
              "740330103"
            ]
          },
          "740330103": {
            "id": "740330103",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Anyway, let's get it to open up the passage to <color=#00E1FFFF>Supply Warehouse 1</color>. By the way, if they offer you a drink, you'd best say no.",
            "nextDialogs": [
              "740330104"
            ]
          },
          "740330104": {
            "id": "740330104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Who's going to offer us a drink? And why won't we take it?",
            "nextDialogs": [
              "740330105"
            ]
          },
          "740330105": {
            "id": "740330105",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "You'll find out soon enough."
          }
        }
      }
    },

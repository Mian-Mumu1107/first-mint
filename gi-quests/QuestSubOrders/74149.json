    {
      "subId": "7414907",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741490701"
        ],
        "dialogs": {
          "741490701": {
            "id": "741490701",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Did you forget what I'd asked you to do? ...Ah, children and their memories.",
            "nextDialogs": [
              "741490702"
            ]
          },
          "741490702": {
            "id": "741490702",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "The first thing I asked you to help with is to clean near the entrance and the back of the house. The next is to feed a bit of fish to Nana, my cat."
          }
        }
      }
    },
    {
      "subId": "7414905",
      "subQuestName": "Report to Mr. Leroy",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741490501"
        ],
        "dialogs": {
          "741490501": {
            "id": "741490501",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "You're done?",
            "nextDialogs": [
              "741490502"
            ]
          },
          "741490502": {
            "id": "741490502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's right, Mr. Leroy. Also...",
            "nextDialogs": [
              "741490503"
            ]
          },
          "741490503": {
            "id": "741490503",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Hmm? What is it? Want some candy? Or would you like your pocket money now?",
            "nextDialogs": [
              "741490504"
            ]
          },
          "741490504": {
            "id": "741490504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "B—Both, hehehe...",
            "nextDialogs": [
              "741490505"
            ]
          },
          "741490505": {
            "id": "741490505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon...",
            "nextDialogs": [
              "741490506"
            ]
          },
          "741490506": {
            "id": "741490506",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Haha, what a greedy little child. Still, that's fine — that's exactly what little children should be like.",
            "nextDialogs": [
              "741490507"
            ]
          },
          "741490507": {
            "id": "741490507",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Especially little ladies as cute as you, Paimon. Macarons, pretty dresses, and lovely homes — that's what you deserve to have.",
            "nextDialogs": [
              "741490508"
            ]
          },
          "741490508": {
            "id": "741490508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hehe, Paimon reckons so too! Hey, {NICKNAME}, could we get...",
            "nextDialogs": [
              "741490509"
            ]
          },
          "741490509": {
            "id": "741490509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Nope.",
            "nextDialogs": [
              "741490510"
            ]
          },
          "741490510": {
            "id": "741490510",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Boo! Boo! You're so stingy!",
            "nextDialogs": [
              "741490513"
            ]
          },
          "741490513": {
            "id": "741490513",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon doesn't see how any of that stuff conflicts with having macarons, skirts, or big beautiful houses, though...",
            "nextDialogs": [
              "741490514"
            ]
          },
          "741490514": {
            "id": "741490514",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Heh, what's with the sudden argument? Tsk, kids. But a little banter now and then is good. That just shows that you're still children."
          }
        }
      }
    },

    {
      "subId": "201103",
      "subQuestName": "Talk to Beidou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20110301"
        ],
        "dialogs": {
          "20110301": {
            "id": "20110301",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Ah, you finally made it!",
            "nextDialogs": [
              "20110302"
            ]
          },
          "20110302": {
            "id": "20110302",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "All these years, come rain or storm, the Crux Fleet has never suffered a delay. If it were anyone else, I might've set sail already.",
            "nextDialogs": [
              "20110305"
            ]
          },
          "20110305": {
            "id": "20110305",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Hahaha, don't look too serious, I'm only joking. You're just on time, the crew have just finished making final preparations.",
            "nextDialogs": [
              "20110306"
            ]
          },
          "20110306": {
            "id": "20110306",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "*sigh* Well, now that everyone's here...",
            "nextDialogs": [
              "20110307"
            ]
          },
          "20110307": {
            "id": "20110307",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "We set sail for the land engulfed by storm and tempest... The nation of \"eternity\"!",
            "nextDialogs": [
              "20110308"
            ]
          },
          "20110308": {
            "id": "20110308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anchors aweigh!"
          }
        }
      }
    },

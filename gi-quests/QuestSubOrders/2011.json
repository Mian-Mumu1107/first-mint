  "subQuests": [
    {
      "subId": "201101",
      "subQuestName": "Ask Katheryne for information on going to Inazuma",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20110101"
        ],
        "dialogs": {
          "20110101": {
            "id": "20110101",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "Ad astra abyssosque! What can I do for you, Traveler?",
            "nextDialogs": [
              "20110104"
            ]
          },
          "20110104": {
            "id": "20110104",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "Ah yes, I've heard that you've already made arrangements with the captain of the Crux Fleet regarding your passage to Inazuma. Is that correct?",
            "nextDialogs": [
              "20110105"
            ]
          },
          "20110105": {
            "id": "20110105",
            "speakerId": 2078,
            "speakerName": "Katheryne",
            "text": "Now that I think about it, it's been quite some time since I last visited those lands. Unfortunately, I don't have any current intel that would be worth sharing with you.",
            "nextDialogs": [
              "20110106"
            ]
          },
          "20110106": {
            "id": "20110106",
            "speakerId": 2440,
            "speakerName": "Sea Drake",
            "text": "There you are! You're the Traveler that Beidou will be taking to Inazuma, right?"
          }
        }
      }
    },
    {
      "subId": "201102",
      "subQuestName": "Board the Alcor and find Beidou",

    {
      "subId": "201107",
      "subQuestName": "Talk to your contact, Thoma",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20110701"
        ],
        "dialogs": {
          "20110701": {
            "id": "20110701",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "So, you finally made it. You sure kept me waiting, Captain.",
            "nextDialogs": [
              "20110702"
            ]
          },
          "20110702": {
            "id": "20110702",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "And it appears we have a couple of stowaways... or perhaps I should say — honored guests.",
            "nextDialogs": [
              "20110703"
            ]
          },
          "20110703": {
            "id": "20110703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Shush!",
            "nextDialogs": [
              "20110704"
            ]
          },
          "20110704": {
            "id": "20110704",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "You can blame your Almighty Shogun. The tempests around Inazuma have been growing all the more fierce lately.",
            "nextDialogs": [
              "20110705"
            ]
          },
          "20110705": {
            "id": "20110705",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Though the fleet was fully up to the challenge, the inclement weather still caused some delay.",
            "nextDialogs": [
              "20110706"
            ]
          },
          "20110706": {
            "id": "20110706",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Now then, let me introduce everyone. This is Thoma, a trade partner that I've gotten to know recently.",
            "nextDialogs": [
              "20110707"
            ]
          },
          "20110707": {
            "id": "20110707",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "Heh, you don't know how long I've been waiting to see you.",
            "nextDialogs": [
              "20110708"
            ]
          },
          "20110708": {
            "id": "20110708",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Thoma, these two are—",
            "nextDialogs": [
              "20110709"
            ]
          },
          "20110709": {
            "id": "20110709",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "No need for introductions, their reputation precedes them. Seems even the stormy seas can't keep rumors of these outlanders' sterling deeds at bay.",
            "nextDialogs": [
              "20110712"
            ]
          },
          "20110712": {
            "id": "20110712",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, it's sure nice to hear you say that~",
            "nextDialogs": [
              "20110713"
            ]
          },
          "20110713": {
            "id": "20110713",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Ha, with any luck, it'll give you a head start here.",
            "nextDialogs": [
              "20110714"
            ]
          },
          "20110714": {
            "id": "20110714",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "#{NICKNAME}, Thoma's resided on Ritou for quite some time now. It wouldn't be going too far to say he's the fixer around these parts.",
            "nextDialogs": [
              "20110715"
            ]
          },
          "20110715": {
            "id": "20110715",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "If you run into any problems here, just talk to Thoma. But if he tries to pull any moves on you, I'll be sure to deal with him personally the next time I'm around.",
            "nextDialogs": [
              "20110716"
            ]
          },
          "20110716": {
            "id": "20110716",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "Hehehe, no need to worry. I'm sure we'll get along just fine.",
            "nextDialogs": [
              "20110717"
            ]
          },
          "20110717": {
            "id": "20110717",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Good. Then if it's all settled, I'll be going. I wouldn't want to be caught with my sails down here, I do have a wanted fugitive on board, after all.",
            "nextDialogs": [
              "20110718"
            ]
          },
          "20110718": {
            "id": "20110718",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, right. Kazuha...",
            "nextDialogs": [
              "20110719"
            ]
          },
          "20110719": {
            "id": "20110719",
            "speakerId": 1031,
            "speakerName": "Beidou",
            "text": "Until next time, Traveler. Remember to give it your all, no matter what perilous \"storms\" you may encounter."
          }
        }
      }
    }
  ]
}
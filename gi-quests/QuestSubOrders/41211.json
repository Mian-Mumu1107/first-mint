  "subQuests": [
    {
      "subId": "4121101",
      "subQuestName": "Meet with Albedo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412110101"
        ],
        "dialogs": {
          "412110101": {
            "id": "412110101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Albedo!",
            "nextDialogs": [
              "412110102"
            ]
          },
          "412110102": {
            "id": "412110102",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "You're back.",
            "nextDialogs": [
              "412110103"
            ]
          },
          "412110103": {
            "id": "412110103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Haha! We've been working hard on the sword, you know? Check it out!",
            "nextDialogs": [
              "412110104"
            ]
          },
          "412110104": {
            "id": "412110104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have a look.",
            "nextDialogs": [
              "412110105"
            ]
          },
          "412110105": {
            "id": "412110105",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "Hmm. Indeed.",
            "nextDialogs": [
              "412110106"
            ]
          },
          "412110106": {
            "id": "412110106",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "It is as I thought — this sword grows stronger as you use it in battle.",
            "nextDialogs": [
              "412110107"
            ]
          },
          "412110107": {
            "id": "412110107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "I thought that only applied to people.",
            "nextDialogs": [
              "412110108"
            ]
          },
          "412110108": {
            "id": "412110108",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "And that's precisely what makes it special.",
            "nextDialogs": [
              "412110109"
            ]
          },
          "412110109": {
            "id": "412110109",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "Ah yes, I should mention a more important matter first.",
            "nextDialogs": [
              "412110110"
            ]
          },
          "412110110": {
            "id": "412110110",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "I've investigated the area nearby, and I've discovered some unusual signs.",
            "nextDialogs": [
              "412110111"
            ]
          },
          "412110111": {
            "id": "412110111",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's not more thieves, is it?",
            "nextDialogs": [
              "412110114"
            ]
          },
          "412110114": {
            "id": "412110114",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That's true...",
            "nextDialogs": [
              "412110115"
            ]
          },
          "412110115": {
            "id": "412110115",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "I believe that these strange traces require investigation.",
            "nextDialogs": [
              "412110116"
            ]
          },
          "412110116": {
            "id": "412110116",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "Whether it be thieves or something else, we shall investigate, and we shall find out."
          }
        }
      }
    },
    {
      "subId": "4121102",
      "subQuestName": "Go to the investigation site",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412110201"
        ],
        "dialogs": {
          "412110201": {
            "id": "412110201",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "The Fatui? And they chose to attack us within the Treasure Hoarders' camp... Did they follow us here?",
            "nextDialogs": [
              "412110202"
            ]
          },
          "412110202": {
            "id": "412110202",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But why would they do that?",
            "nextDialogs": [
              "412110203"
            ]
          },
          "412110203": {
            "id": "412110203",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Did you go rile them up while we weren't looking?",
            "nextDialogs": [
              "412110204"
            ]
          },
          "412110204": {
            "id": "412110204",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "Did you?",
            "nextDialogs": [
              "412110207"
            ]
          },
          "412110207": {
            "id": "412110207",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Um, maybe it's something we all did, then...",
            "nextDialogs": [
              "412110208"
            ]
          },
          "412110208": {
            "id": "412110208",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "I think the Fatui are looking for this sword.",
            "nextDialogs": [
              "412110209"
            ]
          },
          "412110209": {
            "id": "412110209",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eh!? Weren't you keeping this sword super secret? How did they know it existed?",
            "nextDialogs": [
              "412110210"
            ]
          },
          "412110210": {
            "id": "412110210",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "Perhaps they caught sight of you using it on the mountain.",
            "nextDialogs": [
              "412110211"
            ]
          },
          "412110211": {
            "id": "412110211",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "If their eyes are any good, they'll definitely have seen how this sword stands out from the rest.",
            "nextDialogs": [
              "412110212"
            ]
          },
          "412110212": {
            "id": "412110212",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "They really want everything, don't they?",
            "nextDialogs": [
              "412110213"
            ]
          },
          "412110213": {
            "id": "412110213",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "Not quite, no.",
            "nextDialogs": [
              "412110214"
            ]
          },
          "412110214": {
            "id": "412110214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I remember hearing more about their activities recently too...",
            "nextDialogs": [
              "412110215"
            ]
          },
          "412110215": {
            "id": "412110215",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "The Fatui are collecting things related to the archons. This, I believe, is known to you.",
            "nextDialogs": [
              "412110216"
            ]
          },
          "412110216": {
            "id": "412110216",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh. Now that you mention it, we did hear Master Diluc say that.",
            "nextDialogs": [
              "412110217"
            ]
          },
          "412110217": {
            "id": "412110217",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "Durin is the sworn enemy of the Anemo Archon, and had power comparable to his.",
            "nextDialogs": [
              "412110218"
            ]
          },
          "412110218": {
            "id": "412110218",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "To say that it could rival the archons, or was related to them... Neither is an overstatement.",
            "nextDialogs": [
              "412110219"
            ]
          },
          "412110219": {
            "id": "412110219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No wonder they've set their sights on this sword.",
            "nextDialogs": [
              "412110220"
            ]
          },
          "412110220": {
            "id": "412110220",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So that's how it is...",
            "nextDialogs": [
              "412110221"
            ]
          },
          "412110221": {
            "id": "412110221",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "I made a new discovery while sketching nearby.",
            "nextDialogs": [
              "412110222"
            ]
          },
          "412110222": {
            "id": "412110222",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "There's an area up ahead that's quite remarkable. Its ley lines flow differently from any other.",
            "nextDialogs": [
              "412110223"
            ]
          },
          "412110223": {
            "id": "412110223",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "Nearby monsters have been attracted to it and have fallen under its influence. As a result, their constitutions have come to far surpass others of the same kind.",
            "nextDialogs": [
              "412110224"
            ]
          },
          "412110224": {
            "id": "412110224",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That seems convenient.",
            "nextDialogs": [
              "412110225"
            ]
          },
          "412110225": {
            "id": "412110225",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, we're here to help this sword grow, aren't we? Might as well go try it out on those monsters!",
            "nextDialogs": [
              "412110226"
            ]
          },
          "412110226": {
            "id": "412110226",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "Precisely my intention. Oh, and do remember to observe how various enemies affect this sword differently while you're at it, please."
          }
        }
      }
    },
    {
      "subId": "4121103",
      "subQuestName": "Speak to Albedo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412110401"
        ],
        "dialogs": {
          "412110401": {
            "id": "412110401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Lots of human activity here, that's for sure.",
            "nextDialogs": [
              "412110402"
            ]
          },
          "412110402": {
            "id": "412110402",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Looks like more than one person, too.",
            "nextDialogs": [
              "412110403"
            ]
          },
          "412110403": {
            "id": "412110403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Certainly seems like Treasure Hoarders.",
            "nextDialogs": [
              "412110404"
            ]
          },
          "412110404": {
            "id": "412110404",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So they have a camp here... Hmph! Here to steal, just as usual.",
            "nextDialogs": [
              "412110405"
            ]
          },
          "412110405": {
            "id": "412110405",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "It would be rather convenient to rob adventurers who come up here, yes.",
            "nextDialogs": [
              "412110406"
            ]
          },
          "412110406": {
            "id": "412110406",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's survival of the fittest here on this mountain, huh?",
            "nextDialogs": [
              "412110407"
            ]
          },
          "412110407": {
            "id": "412110407",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "All that stealing though, and still every last one of them's still poor as dirt...",
            "nextDialogs": [
              "412110410"
            ]
          },
          "412110410": {
            "id": "412110410",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmph! Anyone who calls us thieves gets no pity from Paimon!",
            "nextDialogs": [
              "412110411"
            ]
          },
          "412110411": {
            "id": "412110411",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Who's that? Who're these sniveling sneaks snooping around our camp?",
            "nextDialogs": [
              "412110412"
            ]
          },
          "412110412": {
            "id": "412110412",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Argh, we're busted!"
          }
        }
      }
    },

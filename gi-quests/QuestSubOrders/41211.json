    {
      "subId": "4121112",
      "subQuestName": "Speak to Albedo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412110301"
        ],
        "dialogs": {
          "412110301": {
            "id": "412110301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So, how did it feel?",
            "nextDialogs": [
              "412110304"
            ]
          },
          "412110304": {
            "id": "412110304",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "I have a hypothesis concerning this.",
            "nextDialogs": [
              "412110305"
            ]
          },
          "412110305": {
            "id": "412110305",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "Each time this sword absorbs power from the bodies of fallen enemies, it will resonate with Durin's remains, hidden somewhere on this mountain.",
            "nextDialogs": [
              "412110306"
            ]
          },
          "412110306": {
            "id": "412110306",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Holy moly, that sounds amazing!",
            "nextDialogs": [
              "412110307"
            ]
          },
          "412110307": {
            "id": "412110307",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "If my theory proves correct, this could mean that all the monsters here may be resonating with Durin's body.",
            "nextDialogs": [
              "412110308"
            ]
          },
          "412110308": {
            "id": "412110308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But why would they do that?",
            "nextDialogs": [
              "412110309"
            ]
          },
          "412110309": {
            "id": "412110309",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "I fear this may have to do with the origin of these monsters' powers.",
            "nextDialogs": [
              "412110310"
            ]
          },
          "412110310": {
            "id": "412110310",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "Durin is no ordinary beast. Even though it is long dead, the entire mountain is still held in thrall by its corpse.",
            "nextDialogs": [
              "412110311"
            ]
          },
          "412110311": {
            "id": "412110311",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "The dragon's mysterious power... may itself be a form of curse.",
            "nextDialogs": [
              "412110312"
            ]
          },
          "412110312": {
            "id": "412110312",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "We still don't have enough information. If we wish to understand more, more data is required. This is where you come in.",
            "nextDialogs": [
              "412110313"
            ]
          },
          "412110313": {
            "id": "412110313",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Guess story-time's become work-time...",
            "nextDialogs": [
              "412110314"
            ]
          },
          "412110314": {
            "id": "412110314",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "I have some research work that needs settling, so we will have to work separately for now. Let's meet up again near the broken bridge."
          }
        }
      }
    }
  ]
}
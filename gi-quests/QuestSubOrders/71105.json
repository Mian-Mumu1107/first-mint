    {
      "subId": "7110504",
      "subQuestName": "Enter the cavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7110505",
      "subQuestName": "Examine the cavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711050501"
        ],
        "dialogs": {
          "711050501": {
            "id": "711050501",
            "speakerId": 21220,
            "speakerName": "Someone's Notes",
            "text": "\"...I was worried about monsters from the start, but...\"",
            "nextDialogs": [
              "711050502"
            ]
          },
          "711050502": {
            "id": "711050502",
            "speakerId": 21220,
            "speakerName": "Someone's Notes",
            "text": "\"...So much... My thigh... Can't stop it...\"",
            "nextDialogs": [
              "711050503"
            ]
          },
          "711050503": {
            "id": "711050503",
            "speakerId": 21220,
            "speakerName": "Someone's Notes",
            "text": "\"...So sleepy... But Mt. Xuanlian is just up ahead... Xiangjun, I'll definitely get those blessed waters...\"",
            "nextDialogs": [
              "711050504"
            ]
          },
          "711050504": {
            "id": "711050504",
            "speakerId": 21220,
            "speakerName": "Someone's Notes",
            "text": "\"Xiangjun... I'll surely get those blessed waters...\"",
            "nextDialogs": [
              "711050505"
            ]
          },
          "711050505": {
            "id": "711050505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no... He was attacked by monsters and was badly wounded in the process... Wait, and he still wants to get water from Mt. Xuanlian even so!?",
            "nextDialogs": [
              "711050506"
            ]
          },
          "711050506": {
            "id": "711050506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's hurry — Paimon hopes we can help him!"
          }
        }
      }
    },
    {
      "subId": "7110506",
      "subQuestName": "Go near Mt. Xuanlian",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711050601"
        ],
        "dialogs": {
          "711050601": {
            "id": "711050601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm. This should be the place, right?",
            "nextDialogs": [
              "711050602"
            ]
          },
          "711050602": {
            "id": "711050602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why isn't anyone here? No trail to follow, either...",
            "nextDialogs": [
              "711050603"
            ]
          },
          "711050603": {
            "id": "711050603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Could he have gone back already?",
            "nextDialogs": [
              "711050604"
            ]
          },
          "711050604": {
            "id": "711050604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon doesn't think that would happen. He's been injured — could he have walked far?",
            "nextDialogs": [
              "711050605"
            ]
          },
          "711050605": {
            "id": "711050605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But he's not around here either.",
            "nextDialogs": [
              "711050606"
            ]
          },
          "711050606": {
            "id": "711050606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Could someone have met him on the road and rescued him? Paimon thinks that might have happened...",
            "nextDialogs": [
              "711050607"
            ]
          },
          "711050607": {
            "id": "711050607",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Shall we go back to Qiaoying Village and ask around?",
            "nextDialogs": [
              "711050608"
            ]
          },
          "711050608": {
            "id": "711050608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's get a bit of this \"blessed water\" first.",
            "nextDialogs": [
              "711050609"
            ]
          },
          "711050609": {
            "id": "711050609",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Oh, right. If Xiangjun's Grandpa was rescued, he might still need this.",
            "nextDialogs": [
              "711050610"
            ]
          },
          "711050610": {
            "id": "711050610",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#In for a Mora, in for it all, eh? You're so thoughtful, {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "7110507",
      "subQuestName": "Obtain the \"blessed waters\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7110508",
      "subQuestName": "Return to Qiaoying Village",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711050801"
        ],
        "dialogs": {
          "711050801": {
            "id": "711050801",
            "speakerId": 2491,
            "speakerName": "Uncle Luo",
            "text": "Ah, it's you, Traveler. You seem in a terrible hurry. Did some trouble come up?",
            "nextDialogs": [
              "711050802"
            ]
          },
          "711050802": {
            "id": "711050802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We... Well, do you know where Xiangjun and her grandfather live, Uncle Luo? We're looking for them.",
            "nextDialogs": [
              "711050803"
            ]
          },
          "711050803": {
            "id": "711050803",
            "speakerId": 2491,
            "speakerName": "Uncle Luo",
            "text": "Xiangjun? Never heard of her. Is she from around here? I'm sure I know everyone in the village...",
            "nextDialogs": [
              "711050804"
            ]
          },
          "711050804": {
            "id": "711050804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really? That can't be... We met a little girl outside who called herself Xiangjun, and said she lives in Qiaoying Village. She asked us to help her find her grandfather...",
            "nextDialogs": [
              "711050805"
            ]
          },
          "711050805": {
            "id": "711050805",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "She also has a big bamboo raft!",
            "nextDialogs": [
              "711050806"
            ]
          },
          "711050806": {
            "id": "711050806",
            "speakerId": 2491,
            "speakerName": "Uncle Luo",
            "text": "Well, you can find those quite easily, but Xiangjun... I'm fairly sure there's no one by that name in our village. What does her grandfather go by?",
            "nextDialogs": [
              "711050807"
            ]
          },
          "711050807": {
            "id": "711050807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He's an herb gatherer.",
            "nextDialogs": [
              "711050808"
            ]
          },
          "711050808": {
            "id": "711050808",
            "speakerId": 2491,
            "speakerName": "Uncle Luo",
            "text": "A herb gatherer? Let me think. We did have one, so I recall... But it's been three years since he passed...",
            "nextDialogs": [
              "711050809"
            ]
          },
          "711050809": {
            "id": "711050809",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He passed away!?",
            "nextDialogs": [
              "711050810"
            ]
          },
          "711050810": {
            "id": "711050810",
            "speakerId": 2491,
            "speakerName": "Uncle Luo",
            "text": "Aye. He encountered monsters in the wild and... *sigh* Still, I doubt that's who you're looking for.",
            "nextDialogs": [
              "711050811"
            ]
          },
          "711050811": {
            "id": "711050811",
            "speakerId": 2491,
            "speakerName": "Uncle Luo",
            "text": "He was always a little off his rocker, and he never got married, never mind having descendants of any sort.",
            "nextDialogs": [
              "711050812"
            ]
          },
          "711050812": {
            "id": "711050812",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait... What's going on here? So, that Xiangjun we met...",
            "nextDialogs": [
              "711050813"
            ]
          },
          "711050813": {
            "id": "711050813",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Could she have been the real demon!?",
            "nextDialogs": [
              "711050814"
            ]
          },
          "711050814": {
            "id": "711050814",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What sorts of herbs did your herb gatherer, well, gather?",
            "nextDialogs": [
              "711050815"
            ]
          },
          "711050815": {
            "id": "711050815",
            "speakerId": 2491,
            "speakerName": "Uncle Luo",
            "text": "Flowers and grasses, none of which we've ever seen. 'Fraid I only know this and that about tea, so I'd be little help here...",
            "nextDialogs": [
              "711050816"
            ]
          },
          "711050816": {
            "id": "711050816",
            "speakerId": 2491,
            "speakerName": "Uncle Luo",
            "text": "But I do remember that we found him near Mt. Xuanlian. He was still clutching a bottle of water.",
            "nextDialogs": [
              "711050817"
            ]
          },
          "711050817": {
            "id": "711050817",
            "speakerId": 2491,
            "speakerName": "Uncle Luo",
            "text": "He said that he had a divine plant in his yard that needed that sort of blessed water to grow. Load of hogwash if you ask me — I mean, it's all just river water. Nothing special about it! Why'd he have to give up his life on account of something like that...",
            "nextDialogs": [
              "711050818"
            ]
          },
          "711050818": {
            "id": "711050818",
            "speakerId": 2491,
            "speakerName": "Uncle Luo",
            "text": "*sigh* Still, after we buried him, we poured the water he obtained out in that yard of his. I hope that brought him some solace.",
            "nextDialogs": [
              "711050819"
            ]
          },
          "711050819": {
            "id": "711050819",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The blessed waters of Mt. Xuanlian? We went there and drew some water, too... So, this herb gatherer of yours...",
            "nextDialogs": [
              "711050820"
            ]
          },
          "711050820": {
            "id": "711050820",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I think we're talking about the same person.",
            "nextDialogs": [
              "711050821"
            ]
          },
          "711050821": {
            "id": "711050821",
            "speakerId": 2491,
            "speakerName": "Uncle Luo",
            "text": "Well, that's strange happenings, and no mistake... Why don't you come with me? I'll take you to that fellow's yard.",
            "nextDialogs": [
              "711050822"
            ]
          },
          "711050822": {
            "id": "711050822",
            "speakerId": 2491,
            "speakerName": "Uncle Luo",
            "text": "If you did draw water, I suppose you can just pour it out in his yard."
          }
        }
      }
    },

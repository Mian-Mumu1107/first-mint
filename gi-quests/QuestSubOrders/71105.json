  "subQuests": [
    {
      "subId": "7110501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711050101"
        ],
        "dialogs": {
          "711050101": {
            "id": "711050101",
            "speakerId": 21219,
            "speakerName": "???",
            "text": "Grandpa...",
            "nextDialogs": [
              "711050102"
            ]
          },
          "711050102": {
            "id": "711050102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm? Hey there, kiddo, what are you doing out here at night? What's your name?",
            "nextDialogs": [
              "711050103"
            ]
          },
          "711050103": {
            "id": "711050103",
            "speakerId": 1002,
            "speakerName": "Xiangjun",
            "text": "I'm Xiangjun... I'm looking for my Grandpa... He was kidnapped by demons...",
            "nextDialogs": [
              "711050104"
            ]
          },
          "711050104": {
            "id": "711050104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "D—Demons? Here? What sort?",
            "nextDialogs": [
              "711050105"
            ]
          },
          "711050105": {
            "id": "711050105",
            "speakerId": 1002,
            "speakerName": "Xiangjun",
            "text": "I... I don't know either... Grandpa said that they're in the mountains, so I shouldn't run around by myself... But it's been three days now, and he still isn't back from the mountains...",
            "nextDialogs": [
              "711050106"
            ]
          },
          "711050106": {
            "id": "711050106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He's just trying to scare you, right?",
            "nextDialogs": [
              "711050107"
            ]
          },
          "711050107": {
            "id": "711050107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon thinks so too... Did he say what he was doing in those mountains?",
            "nextDialogs": [
              "711050108"
            ]
          },
          "711050108": {
            "id": "711050108",
            "speakerId": 1002,
            "speakerName": "Xiangjun",
            "text": "Grandpa's the village's herb gatherer. He found a divine plant recently, one that's said to only grow when watered with the blessed waters near Mt. Xuanlian.",
            "nextDialogs": [
              "711050109"
            ]
          },
          "711050109": {
            "id": "711050109",
            "speakerId": 1002,
            "speakerName": "Xiangjun",
            "text": "So... Might he have bumped into some kind of demon guarding the water?",
            "nextDialogs": [
              "711050110"
            ]
          },
          "711050110": {
            "id": "711050110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Don't worry too much, Xiangjun. Your Grandpa might've just encountered some minor trouble. But it's also getting really late — mind if we send you home first?",
            "nextDialogs": [
              "711050111"
            ]
          },
          "711050111": {
            "id": "711050111",
            "speakerId": 1002,
            "speakerName": "Xiangjun",
            "text": "But I want to rescue him...",
            "nextDialogs": [
              "711050112"
            ]
          },
          "711050112": {
            "id": "711050112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We can help you.",
            "nextDialogs": [
              "711050113"
            ]
          },
          "711050113": {
            "id": "711050113",
            "speakerId": 1002,
            "speakerName": "Xiangjun",
            "text": "Really?",
            "nextDialogs": [
              "711050114"
            ]
          },
          "711050114": {
            "id": "711050114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's right! But if you don't go home, you might cause your Grandpa even more trouble.",
            "nextDialogs": [
              "711050115"
            ]
          },
          "711050115": {
            "id": "711050115",
            "speakerId": 1002,
            "speakerName": "Xiangjun",
            "text": "Ah, I... don't want to do that.",
            "nextDialogs": [
              "711050116"
            ]
          },
          "711050116": {
            "id": "711050116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Then let us look for him while you stay home, alright? Let's get you back to your home first.",
            "nextDialogs": [
              "711050117"
            ]
          },
          "711050117": {
            "id": "711050117",
            "speakerId": 1002,
            "speakerName": "Xiangjun",
            "text": "It's fine. I live in Qiaoying Village. I can head back myself.",
            "nextDialogs": [
              "711050118"
            ]
          },
          "711050118": {
            "id": "711050118",
            "speakerId": 1002,
            "speakerName": "Xiangjun",
            "text": "But... could you go look for Grandpa immediately? I'm worried about him...",
            "nextDialogs": [
              "711050119"
            ]
          },
          "711050119": {
            "id": "711050119",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, we'll be fine. That said... do you know where exactly he went?",
            "nextDialogs": [
              "711050120"
            ]
          },
          "711050120": {
            "id": "711050120",
            "speakerId": 1002,
            "speakerName": "Xiangjun",
            "text": "I only know that he went that way...",
            "nextDialogs": [
              "711050121"
            ]
          },
          "711050121": {
            "id": "711050121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "In that case, that's where we'll start.",
            "nextDialogs": [
              "711050122"
            ]
          },
          "711050122": {
            "id": "711050122",
            "speakerId": 1002,
            "speakerName": "Xiangjun",
            "text": "Thanks so much! I'll head back now. I won't cause you all any trouble... so I'll wait there for you!"
          }
        }
      }
    },
    {
      "subId": "7110502",
      "subQuestName": "Look for clues in the direction indicated by Xiangjun",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711050201"
        ],
        "dialogs": {
          "711050201": {
            "id": "711050201",
            "speakerId": 21220,
            "speakerName": "Someone's Notes",
            "text": "\"I overslept! I have to get back before tomorrow, or no one's going to watch Xiangjun... Ah, I'm a fool...!\"",
            "nextDialogs": [
              "711050202"
            ]
          },
          "711050202": {
            "id": "711050202",
            "speakerId": 21220,
            "speakerName": "Someone's Notes",
            "text": "\"If I remember right, there's a shortcut — a small road leading from Yaodie Valley to Mt. Xuanlian. Just need to get through that plus one mountain cave, and I should be golden...\"",
            "nextDialogs": [
              "711050203"
            ]
          },
          "711050203": {
            "id": "711050203",
            "speakerId": 21220,
            "speakerName": "Someone's Notes",
            "text": "\"I've heard that there are monsters nearby, but I have to give this a shot...\"",
            "nextDialogs": [
              "711050204"
            ]
          },
          "711050204": {
            "id": "711050204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This looks like something that her grandpa might've left behind. Seems like he took a small trail — let's go look for it as well!"
          }
        }
      }
    },
    {
      "subId": "7110503",
      "subQuestName": "Search for a \"path\"",
      "sceneId": null,
      "locations": [],

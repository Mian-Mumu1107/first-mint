  "subQuests": [
    {
      "subId": "1910101",
      "subQuestName": "Talk to Nimrod",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191010101"
        ],
        "dialogs": {
          "191010101": {
            "id": "191010101",
            "speakerId": 1000,
            "speakerName": "Nimrod",
            "text": "Mmm... drinks at The Cat's Tail. Not bad... not bad at all...",
            "nextDialogs": [
              "191010102"
            ]
          },
          "191010102": {
            "id": "191010102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Cat's Tail?",
            "nextDialogs": [
              "191010103"
            ]
          },
          "191010103": {
            "id": "191010103",
            "speakerId": 1000,
            "speakerName": "Nimrod",
            "text": "Oh hey, it's you, Traveler. ...Huh? Y—You've never heard of The Cat's Tail?",
            "nextDialogs": [
              "191010104"
            ]
          },
          "191010104": {
            "id": "191010104",
            "speakerId": 1000,
            "speakerName": "Nimrod",
            "text": "Judging from your expression, seems like you really don't know the place. Boy, have you been missing out...",
            "nextDialogs": [
              "191010105"
            ]
          },
          "191010105": {
            "id": "191010105",
            "speakerId": 1000,
            "speakerName": "Nimrod",
            "text": "The Cat's Tail is renowned for its incredible specialty drinks. I'm talking drinks you've definitely never tasted before.",
            "nextDialogs": [
              "191010106"
            ]
          },
          "191010106": {
            "id": "191010106",
            "speakerId": 1000,
            "speakerName": "Nimrod",
            "text": "And just as its name suggests, there are loads of cute kitties at The Cat's Tail.",
            "nextDialogs": [
              "191010107"
            ]
          },
          "191010107": {
            "id": "191010107",
            "speakerId": 1000,
            "speakerName": "Nimrod",
            "text": "Time simply starts slipping away when you're enjoying a delicious specialty cocktail and surrounded by a bunch of cute kitties...",
            "nextDialogs": [
              "191010110"
            ]
          },
          "191010110": {
            "id": "191010110",
            "speakerId": 1000,
            "speakerName": "Nimrod",
            "text": "Uh, but you don't seem of age to drink yet.",
            "nextDialogs": [
              "191010111"
            ]
          },
          "191010111": {
            "id": "191010111",
            "speakerId": 1000,
            "speakerName": "Nimrod",
            "text": "Well, that shouldn't be a problem, Diona will be there. She's the best bartender in all of Mondstadt!",
            "nextDialogs": [
              "191010112"
            ]
          },
          "191010112": {
            "id": "191010112",
            "speakerId": 1000,
            "speakerName": "Nimrod",
            "text": "It should be a piece of cake for her to whip you up a drink with no alcohol in it.",
            "nextDialogs": [
              "191010113"
            ]
          },
          "191010113": {
            "id": "191010113",
            "speakerId": 1000,
            "speakerName": "Nimrod",
            "text": "Oh, and not to mention, Diona is also pretty cute... just like a little kitty.",
            "nextDialogs": [
              "191010114"
            ]
          },
          "191010114": {
            "id": "191010114",
            "speakerId": 1000,
            "speakerName": "Nimrod",
            "text": "*hic* Oh no... did I say that out loud? Uh, please don't tell her I said that!",
            "nextDialogs": [
              "191010115"
            ]
          },
          "191010115": {
            "id": "191010115",
            "speakerId": 1000,
            "speakerName": "Nimrod",
            "text": "Anyway, if you want to check out The Cat's Tail for yourself, the entrance is just around the back.",
            "nextDialogs": [
              "191010116"
            ]
          },
          "191010116": {
            "id": "191010116",
            "speakerId": 1000,
            "speakerName": "Nimrod",
            "text": "I'm gonna... *hic* go over there and sober up a bit, I don't think I can handle a fifth round quite yet... I drank way too much already."
          }
        }
      }
    },

    {
      "subId": "2000901",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200090101"
        ],
        "dialogs": {
          "200090101": {
            "id": "200090101",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Traveler! Here! Over here!",
            "nextDialogs": [
              "200090102"
            ]
          },
          "200090102": {
            "id": "200090102",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Don't startle those hilichurls over there. Why are you always running off into hilichurl camps?",
            "nextDialogs": [
              "200090103"
            ]
          },
          "200090103": {
            "id": "200090103",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Forget it, it's not important. I've been researching Hilichurlian for some time, but I'd much rather get in some actual speaking practice than constantly going over books.",
            "nextDialogs": [
              "200090104"
            ]
          },
          "200090104": {
            "id": "200090104",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "I've finally stumbled across a whole hilichurl camp... I cannot let this opportunity pass me by!",
            "nextDialogs": [
              "200090105"
            ]
          },
          "200090105": {
            "id": "200090105",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "So, Traveler, can you go with me into the camp and help me find a hilichurl to practice with?"
          }
        }
      }
    }
  ]
}
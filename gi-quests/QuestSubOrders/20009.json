    {
      "subId": "2000902",
      "subQuestName": "Go to the hilichurl camp with Ella Musk",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200090201"
        ],
        "dialogs": {
          "200090201": {
            "id": "200090201",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Thankfully there's one awake right now.",
            "nextDialogs": [
              "200090202"
            ]
          },
          "200090202": {
            "id": "200090202",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "This is him, let's go over and say hi.",
            "nextDialogs": [
              "200090203"
            ]
          },
          "200090203": {
            "id": "200090203",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Be careful though, it would be rude of us to wake the others.",
            "nextDialogs": [
              "200090204"
            ]
          },
          "200090204": {
            "id": "200090204",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "We don't want them thinking we're storming into their camp to attack them.",
            "nextDialogs": [
              "200090205"
            ]
          },
          "200090205": {
            "id": "200090205",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "There's absolutely no way they would talk to us then."
          }
        }
      }
    },

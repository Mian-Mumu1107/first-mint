    {
      "subId": "2000908",
      "subQuestName": "Approach the hilichurl that is awake, but don't wake the others",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200090801"
        ],
        "dialogs": {
          "200090801": {
            "id": "200090801",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "I said not to startle the other hilichurls! Have you really never tried to approach a hilichurl camp quietly!?",
            "nextDialogs": [
              "200090802"
            ]
          },
          "200090802": {
            "id": "200090802",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Ugh. There's no more hilichurls left at this camp. Such a great opportunity, completely wasted. All I can do now is wait until next time."
          }
        }
      }
    },
    {
      "subId": "2000910",
      "subQuestName": "The hilichurls have been startled awake",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200091001"
        ],
        "dialogs": {
          "200091001": {
            "id": "200091001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Perhaps it's better that you go alone.",
            "nextDialogs": [
              "200091002"
            ]
          },
          "200091002": {
            "id": "200091002",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "That won't do! This is a rare opportunity. Even if you just want to slack off, I'm not letting you get off that easily!"
          }
        }
      }
    },
    {
      "subId": "2000914",
      "subQuestName": "Talk to the hilichurl with Ella Musk",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200090601"
        ],
        "dialogs": {
          "200090601": {
            "id": "200090601",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Olah! Muhe mimi, nye, eh... mosi aba?",
            "nextDialogs": [
              "200090602"
            ]
          },
          "200090602": {
            "id": "200090602",
            "speakerId": 1001,
            "speakerName": "Hilichurl",
            "text": "Yo mimi beru si?",
            "nextDialogs": [
              "200090603"
            ]
          },
          "200090603": {
            "id": "200090603",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Buka...mita nye, guru-guru...yo mosi ka?",
            "nextDialogs": [
              "200090604"
            ]
          },
          "200090604": {
            "id": "200090604",
            "speakerId": 1001,
            "speakerName": "Hilichurl",
            "text": "Ya odomu, Todo yo, buka guru-guru nye.",
            "nextDialogs": [
              "200090605"
            ]
          },
          "200090605": {
            "id": "200090605",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Mi? Dada! Valo.",
            "nextDialogs": [
              "200090606"
            ]
          },
          "200090606": {
            "id": "200090606",
            "speakerId": 1001,
            "speakerName": "Hilichurl",
            "text": "Valo, ya odomu.",
            "nextDialogs": [
              "200090607"
            ]
          },
          "200090607": {
            "id": "200090607",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Hehe, look at how he's acting. He seems so happy!",
            "nextDialogs": [
              "200090608"
            ]
          },
          "200090608": {
            "id": "200090608",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Looks like this time has finally been a success, and my Hilichurlian has finally improved."
          }
        }
      }
    },
    {
      "subId": "2000904",
      "subQuestName": "Talk to the hilichurl with Ella Musk",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200090301"
        ],
        "dialogs": {
          "200090301": {
            "id": "200090301",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Biat ye, ye pupu dada mosi! Plama ye upa dada!",
            "nextDialogs": [
              "200090302"
            ]
          },
          "200090302": {
            "id": "200090302",
            "speakerId": 1001,
            "speakerName": "Hilichurl",
            "text": "Dala beru yo!? Kundala muhe, kucha?",
            "nextDialogs": [
              "200090303"
            ]
          },
          "200090303": {
            "id": "200090303",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Kundala gusha! Hahaha!",
            "nextDialogs": [
              "200090304"
            ]
          },
          "200090304": {
            "id": "200090304",
            "speakerId": 1001,
            "speakerName": "Hilichurl",
            "text": "Biat ye, plata ye pupu!",
            "nextDialogs": [
              "200090305"
            ]
          },
          "200090305": {
            "id": "200090305",
            "speakerId": 1001,
            "speakerName": "Hilichurl",
            "text": "Movo unta nye kucha, mi dada tiga mitono!",
            "nextDialogs": [
              "200090306"
            ]
          },
          "200090306": {
            "id": "200090306",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Oh! I think he understood me! He seems to be taking out something to show us...",
            "nextDialogs": [
              "200090307"
            ]
          },
          "200090307": {
            "id": "200090307",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Oh, oh no! It's a weapon! Traveler, help me!"
          }
        }
      }
    },
    {
      "subId": "2000907",
      "subQuestName": "Control respawn",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200090701"
        ],
        "dialogs": {
          "200090701": {
            "id": "200090701",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "What do you think? My Hilichurlian is not bad, huh? Now that we can communicate, all that's needed to understand each other is time.",
            "nextDialogs": [
              "200090702"
            ]
          },
          "200090702": {
            "id": "200090702",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "That's what I hope for anyway. My dream, is to become friends with the hilichurls.",
            "nextDialogs": [
              "200090703"
            ]
          },
          "200090703": {
            "id": "200090703",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Oh, right! Before I forget — take this. It's a present from that hilichurl.",
            "nextDialogs": [
              "200090704"
            ]
          },
          "200090704": {
            "id": "200090704",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "A present from a hilichurl. Bet you never thought you'd see the day!",
            "nextDialogs": [
              "200090705"
            ]
          },
          "200090705": {
            "id": "200090705",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Well I better get going, I have so many new discoveries to note down. Perhaps we'll have a chance to meet again."
          }
        }
      }
    },
    {
      "subId": "2000911",
      "subQuestName": "Decide if 08 or 10 are complete",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200091101"
        ],
        "dialogs": {
          "200091101": {
            "id": "200091101",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Oh shoot! They've all been woken up!"
          }
        }
      }
    },
    {
      "subId": "2000905",
      "subQuestName": "Fend off the angry hilichurls",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200090501"
        ],
        "dialogs": {
          "200090501": {
            "id": "200090501",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Be careful though, it would be rude of us to wake the others.",
            "nextDialogs": [
              "200090502"
            ]
          },
          "200090502": {
            "id": "200090502",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "We don't want them thinking we're storming into their camp to attack them.",
            "nextDialogs": [
              "200090503"
            ]
          },
          "200090503": {
            "id": "200090503",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "There's absolutely no way they would talk to us then."
          }
        }
      }
    },
    {
      "subId": "2000906",
      "subQuestName": "Talk to Ella Musk",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200090401"
        ],
        "dialogs": {
          "200090401": {
            "id": "200090401",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Good thing you were here, otherwise I would have no idea what would have happened to me.",
            "nextDialogs": [
              "200090402"
            ]
          },
          "200090402": {
            "id": "200090402",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "I don't think I said anything wrong... Maybe my pronunciation was off...?",
            "nextDialogs": [
              "200090403"
            ]
          },
          "200090403": {
            "id": "200090403",
            "speakerId": 1000,
            "speakerName": "Ella Musk",
            "text": "Guess I better hit the books again and do some more research before trying again..."
          }
        }
      }
    },
    {
      "subId": "2000915",
      "subQuestName": "Talk to Ella Musk",
      "sceneId": null,

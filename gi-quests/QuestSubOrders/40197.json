{
  "lineCounts": {
    "Escoffier": 6,
    "Furina": 12,
    "Lepine-Pauline": 4,
    "Navia": 11,
    "Paimon": 8,
    "Player": 6
  },
  "subQuests": [
    {
      "subId": "4019701",
      "subQuestName": "Wait till 08:00 – 10:00 the next day",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401970101"
        ],
        "dialogs": {
          "401970101": {
            "id": "401970101",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Now that things have reached this point, we should add—",
            "nextDialogs": [
              "401970102"
            ]
          },
          "401970102": {
            "id": "401970102",
            "speakerId": 1308,
            "speakerName": "Escoffier",
            "text": "A pinch of salt?",
            "nextDialogs": [
              "401970103"
            ]
          },
          "401970103": {
            "id": "401970103",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "A dash of pepper, actually.",
            "nextDialogs": [
              "401970104"
            ]
          },
          "401970104": {
            "id": "401970104",
            "speakerId": 1308,
            "speakerName": "Escoffier",
            "text": "Ah, brilliant!",
            "nextDialogs": [
              "401970105"
            ]
          },
          "401970105": {
            "id": "401970105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh?",
            "nextDialogs": [
              "401970106"
            ]
          },
          "401970106": {
            "id": "401970106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You two aren't talking about a new dessert menu by any chance, are you?",
            "nextDialogs": [
              "401970107"
            ]
          },
          "401970107": {
            "id": "401970107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pepper sounds a bit out of place in a dessert.",
            "nextDialogs": [
              "401970108"
            ]
          },
          "401970108": {
            "id": "401970108",
            "speakerId": 1308,
            "speakerName": "Escoffier",
            "text": "Not desserts.",
            "nextDialogs": [
              "401970109"
            ]
          },
          "401970109": {
            "id": "401970109",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "We're talking about the script!",
            "nextDialogs": [
              "401970110"
            ]
          },
          "401970110": {
            "id": "401970110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Eh?",
            "nextDialogs": [
              "401970111"
            ]
          },
          "401970111": {
            "id": "401970111",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "My dear partner, photographer, rookie director... Our creativity must keep up with the overflowing enthusiasm of our fans!",
            "nextDialogs": [
              "401970112"
            ]
          },
          "401970112": {
            "id": "401970112",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "There's no room for dull scripts on my stage! Plot twists should strike the audience like a cloud of pepper, leaving them sneezing in surprise. ACHOO!",
            "nextDialogs": [
              "401970113"
            ]
          },
          "401970113": {
            "id": "401970113",
            "speakerId": 1308,
            "speakerName": "Escoffier",
            "text": "The same logic applies in catering.",
            "nextDialogs": [
              "401970114"
            ]
          },
          "401970114": {
            "id": "401970114",
            "speakerId": 1308,
            "speakerName": "Escoffier",
            "text": "I once heard Miss Emilie mention that pepper could be used in perfumes. Perhaps I could find a way to make it work in desserts too...",
            "nextDialogs": [
              "401970115"
            ]
          },
          "401970115": {
            "id": "401970115",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Hmm... A peppery kick to complement the delicate sweetness of cream, perhaps...?",
            "nextDialogs": [
              "401970116"
            ]
          },
          "401970116": {
            "id": "401970116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, the two of them seem to be working together so well...",
            "nextDialogs": [
              "401970117"
            ]
          },
          "401970117": {
            "id": "401970117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's struggling to imagine what a pepper cake would taste like, though!",
            "nextDialogs": [
              "401970118"
            ]
          },
          "401970118": {
            "id": "401970118",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Well, well, what do we have here? Escoffier's making a new cake?",
            "nextDialogs": [
              "401970119"
            ]
          },
          "401970119": {
            "id": "401970119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, and she's peppering in some new ideas.",
            "nextDialogs": [
              "401970120"
            ]
          },
          "401970120": {
            "id": "401970120",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "How exciting! When it's ready, do let me know — I'd love to try it!",
            "nextDialogs": [
              "401970121"
            ]
          },
          "401970121": {
            "id": "401970121",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is it just Paimon, or does it seem like everyone's even more enthusiastic now that they've finished their work?",
            "nextDialogs": [
              "401970122"
            ]
          },
          "401970122": {
            "id": "401970122",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Why shouldn't they be? When your hard work pays off... that's when you should celebrate!",
            "nextDialogs": [
              "401970123"
            ]
          },
          "401970123": {
            "id": "401970123",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "It's like a batch of fresh macarons — you should never let fear of sweetness stop you from adding all the filling you please.",
            "nextDialogs": [
              "401970124"
            ]
          },
          "401970124": {
            "id": "401970124",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "After all, if there's ever a time to pile on the sugar, it's when you're making macarons!",
            "nextDialogs": [
              "401970125"
            ]
          },
          "401970125": {
            "id": "401970125",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Pile on the sugar!",
            "nextDialogs": [
              "401970126"
            ]
          },
          "401970126": {
            "id": "401970126",
            "speakerId": 30423,
            "speakerName": "Lepine-Pauline",
            "text": "Pile on the sugar!",
            "nextDialogs": [
              "401970127"
            ]
          },
          "401970127": {
            "id": "401970127",
            "speakerId": 30423,
            "speakerName": "Lepine-Pauline",
            "text": "...And, why are we piling on the sugar?",
            "nextDialogs": [
              "401970128"
            ]
          },
          "401970128": {
            "id": "401970128",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Lepine-Pauline, you're here! Is it ready?",
            "nextDialogs": [
              "401970129"
            ]
          },
          "401970129": {
            "id": "401970129",
            "speakerId": 30423,
            "speakerName": "Lepine-Pauline",
            "text": "Of course! It all went according to plan!",
            "nextDialogs": [
              "401970130"
            ]
          },
          "401970130": {
            "id": "401970130",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Were you off on some kind of important task?",
            "nextDialogs": [
              "401970131"
            ]
          },
          "401970131": {
            "id": "401970131",
            "speakerId": 30423,
            "speakerName": "Lepine-Pauline",
            "text": "I was indeed! Please, accept this!",
            "nextDialogs": [
              "401970132"
            ]
          },
          "401970132": {
            "id": "401970132",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's this...?",
            "nextDialogs": [
              "401970133"
            ]
          },
          "401970133": {
            "id": "401970133",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh wow! It's a panoramic view of the amusement park, with everyone's illustrations on it!",
            "nextDialogs": [
              "401970134"
            ]
          },
          "401970134": {
            "id": "401970134",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Hehe, since the Film Fantasyland has been such a success, we decided to create a unique souvenir to remember it by.",
            "nextDialogs": [
              "401970135"
            ]
          },
          "401970135": {
            "id": "401970135",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "We built this park together, brick by brick. So we decided we'd all contribute to drawing this map together, too.",
            "nextDialogs": [
              "401970136"
            ]
          },
          "401970136": {
            "id": "401970136",
            "speakerId": 1308,
            "speakerName": "Escoffier",
            "text": "To be fair, it was mostly thanks to Miss Lepine-Pauline — she's our expert when it comes to drawing, after all. But we all did our best to leave our own marks too.",
            "nextDialogs": [
              "401970137"
            ]
          },
          "401970137": {
            "id": "401970137",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "That's right!",
            "nextDialogs": [
              "401970138"
            ]
          },
          "401970138": {
            "id": "401970138",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "#And on top of that, {NICKNAME}, I'm offering you a most special privilege.",
            "nextDialogs": [
              "401970139"
            ]
          },
          "401970139": {
            "id": "401970139",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "You get to add a mustache to my portrait!"
          }
        }
      }
    },
    {
      "subId": "4019706",
      "subQuestName": "Meet up with everyone at the Film Fantasyland",
      "sceneId": null,
      "locations": [],
      "dialogue": {

      }
    },
    {
      "subId": "4019702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401970201"
        ],
        "dialogs": {
          "401970201": {
            "id": "401970201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Awesome! Fancy a <color=#C4D6EAFF>white</color> one?",
            "nextDialogs": [
              "401970202"
            ]
          },
          "401970202": {
            "id": "401970202",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Cream-flavored, huh? Very traditional, but also... very delicious! Mm-hmm, you have my approval.",
            "nextDialogs": [
              "401970401"
            ]
          },
          "401970401": {
            "id": "401970401",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Alright then! Now that you're the proud owner of this commemorative map, you can draw as many different flavored mustaches on it as you like.",
            "nextDialogs": [
              "401970402"
            ]
          },
          "401970402": {
            "id": "401970402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, sounds like a pretty tasty map. We'll look after it well!",
            "nextDialogs": [
              "401970403"
            ]
          },
          "401970403": {
            "id": "401970403",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Great! Your satisfaction is our number one priority.",
            "nextDialogs": [
              "401970404"
            ]
          },
          "401970404": {
            "id": "401970404",
            "speakerId": 1075,
            "speakerName": "Navia",
            "text": "Everything's all in order — now it's time to relax. Forget about work, and just enjoy the park!"
          }
        }
      }
    },
    {
      "subId": "4019703",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401970301"
        ],
        "dialogs": {
          "401970301": {
            "id": "401970301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Splendiferous! Fancy a <color=#E77E70FF>red</color> one?",
            "nextDialogs": [
              "401970302"
            ]
          },
          "401970302": {
            "id": "401970302",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Bolognese sauce flavor...? Well, that sure counts as a surprise twist! You win this round!"
          }
        }
      }
    }
  ]
}
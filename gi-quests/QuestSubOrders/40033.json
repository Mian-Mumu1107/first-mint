    {
      "subId": "4003303",
      "subQuestName": "Report back to Ryuuji",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400330301"
        ],
        "dialogs": {
          "400330301": {
            "id": "400330301",
            "speakerId": 1000,
            "speakerName": "Ryuuji",
            "text": "Ah. Wonderful! This should be all of them now...",
            "nextDialogs": [
              "400330302"
            ]
          },
          "400330302": {
            "id": "400330302",
            "speakerId": 1000,
            "speakerName": "Ryuuji",
            "text": "...Wait. Why *isn't* it all of them?",
            "nextDialogs": [
              "400330303"
            ]
          },
          "400330303": {
            "id": "400330303",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh-oh... Why does Paimon feel like this is just dragging out?",
            "nextDialogs": [
              "400330304"
            ]
          },
          "400330304": {
            "id": "400330304",
            "speakerId": 1000,
            "speakerName": "Ryuuji",
            "text": "It is true that resolving cases sometimes requires a great deal of patience. Going the wrong way could end with you finding nothing at all.",
            "nextDialogs": [
              "400330305"
            ]
          },
          "400330305": {
            "id": "400330305",
            "speakerId": 1000,
            "speakerName": "Ryuuji",
            "text": "We have found a great deal of these little animals, so we are at least headed in the right direction.",
            "nextDialogs": [
              "400330306"
            ]
          },
          "400330306": {
            "id": "400330306",
            "speakerId": 1000,
            "speakerName": "Ryuuji",
            "text": "We might just have missed a few clues along the way or left a few locations un-searched, thus leading to our current impasse. It will be a temporary one, I believe.",
            "nextDialogs": [
              "400330307"
            ]
          },
          "400330307": {
            "id": "400330307",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ooh, Paimon gets it! You're saying that we'll need a bit of boom shaka-laka to finally clear this up!",
            "nextDialogs": [
              "400330308"
            ]
          },
          "400330308": {
            "id": "400330308",
            "speakerId": 1000,
            "speakerName": "Ryuuji",
            "text": "Mm, yes, you could say that we are presently boom shaka-lacking. But not by much, I would say — we have been making great progress thanks to the two of you.",
            "nextDialogs": [
              "400330311"
            ]
          },
          "400330311": {
            "id": "400330311",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That makes a ton of sense, Ryuuji!",
            "nextDialogs": [
              "400330312"
            ]
          },
          "400330312": {
            "id": "400330312",
            "speakerId": 1000,
            "speakerName": "Ryuuji",
            "text": "You flatter me. This is merely experience talking.",
            "nextDialogs": [
              "400330313"
            ]
          },
          "400330313": {
            "id": "400330313",
            "speakerId": 1000,
            "speakerName": "Ryuuji",
            "text": "The further down the truth is buried, the more value there is in uncovering it.",
            "nextDialogs": [
              "400330314"
            ]
          },
          "400330314": {
            "id": "400330314",
            "speakerId": 1000,
            "speakerName": "Ryuuji",
            "text": "It's just a shame that we don't have any additional information at the moment. Hmm...",
            "nextDialogs": [
              "400330315"
            ]
          },
          "400330315": {
            "id": "400330315",
            "speakerId": 1000,
            "speakerName": "Ryuuji",
            "text": "I suppose I'll simply report our present status to Sango.",
            "nextDialogs": [
              "400330316"
            ]
          },
          "400330316": {
            "id": "400330316",
            "speakerId": 1000,
            "speakerName": "Ryuuji",
            "text": "She should be able to consider some angles that haven't come to mind yet.",
            "nextDialogs": [
              "400330317"
            ]
          },
          "400330317": {
            "id": "400330317",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Sure! Paimon has faith in your good sense, after all!",
            "nextDialogs": [
              "400330318"
            ]
          },
          "400330318": {
            "id": "400330318",
            "speakerId": 1000,
            "speakerName": "Ryuuji",
            "text": "Then it's decided. Let's meet at the usual place once more clues emerge.",
            "nextDialogs": [
              "400330319"
            ]
          },
          "400330319": {
            "id": "400330319",
            "speakerId": 1000,
            "speakerName": "Ryuuji",
            "text": "If I am otherwise occupied at the time, you can just look for Sango directly."
          }
        }
      }
    },
    {
      "subId": "4003351",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400335101"
        ],
        "dialogs": {
          "400335101": {
            "id": "400335101",
            "speakerId": 1000,
            "speakerName": "Ryuuji",
            "text": "I will continue to investigate \"Black Shadow.\" The matter of the small animals is yours to resolve."
          }
        }
      }
    },
    {
      "subId": "4003352",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400335201"
        ],
        "dialogs": {
          "400335201": {
            "id": "400335201",
            "speakerId": 1002,
            "speakerName": "Sango",
            "text": "Don't worry, I've already made some initial deductions. Ryuuji will continue to investigate \"Black Shadow,\" while you will focus on rescuing those animals."
          }
        }
      }
    }
  ]
}
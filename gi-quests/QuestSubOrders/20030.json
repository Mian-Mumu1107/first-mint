  },
  "subQuests": [
    {
      "subId": "2003001",
      "subQuestName": "Paimon dialog",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200300101"
        ],
        "dialogs": {
          "200300101": {
            "id": "200300101",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Welcome to the <color=#00E1FFFF>Adventurers' Guild</color>. Actually, I have had my eye on you for a long time.",
            "nextDialogs": [
              "200300102"
            ]
          },
          "200300102": {
            "id": "200300102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#You've had your eye on {NICKNAME}, eh? Has {M#he}{F#she} been causing some mischief?",
            "nextDialogs": [
              "200300103"
            ]
          },
          "200300103": {
            "id": "200300103",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Oh, that is not what I meant at all. Being on the lookout for great adventurers is part of my job.",
            "nextDialogs": [
              "200300104"
            ]
          },
          "200300104": {
            "id": "200300104",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "When I look at you, I see one with the potential to rival the great adventurers of legends.",
            "nextDialogs": [
              "200300105"
            ]
          },
          "200300105": {
            "id": "200300105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon sees it too.",
            "nextDialogs": [
              "200300106"
            ]
          },
          "200300106": {
            "id": "200300106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Paimon always feels safe adventuring with {NICKNAME}.",
            "nextDialogs": [
              "200300107"
            ]
          },
          "200300107": {
            "id": "200300107",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Nevertheless, to the adventurer, experience is far more precious than potential.",
            "nextDialogs": [
              "200300108"
            ]
          },
          "200300108": {
            "id": "200300108",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "You must accumulate <color=#00E1FFFF>Adventure EXP</color> to increase your <color=#00E1FFFF>Adventure Rank</color>.",
            "nextDialogs": [
              "200300109"
            ]
          },
          "200300109": {
            "id": "200300109",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Time is of the essence. Allow me to brief you on—",
            "nextDialogs": [
              "200300110"
            ]
          },
          "200300110": {
            "id": "200300110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait! Are you saying we're like, official adventurers now?",
            "nextDialogs": [
              "200300111"
            ]
          },
          "200300111": {
            "id": "200300111",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Do not worry, the Adventurers' Guild does not charge a membership fee or impose any kind of duties on its members.",
            "nextDialogs": [
              "200300112"
            ]
          },
          "200300112": {
            "id": "200300112",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "In short, there are lots of benefits but no drawbacks to becoming a member.",
            "nextDialogs": [
              "200300116",
              "200300115"
            ]
          },
          "200300116": {
            "id": "200300116",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Basically, the Adventurers' Guild rewards you every time your Adventure Rank increases.",
            "nextDialogs": [
              "200300117"
            ]
          },
          "200300117": {
            "id": "200300117",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Here is a new members' gift for you. You will need to return here to claim rewards in the future.",
            "nextDialogs": [
              "200300118"
            ]
          },
          "200300118": {
            "id": "200300118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Adventure Rank Rewards"
          },
          "200300115": {
            "id": "200300115",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Haha... New recruits these days certainly do not beat around the bush."
          }
        }
      }
    },
    {
      "subId": "2003002",
      "subQuestName": "Talk to Katheryne for more details",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2003003",
      "subQuestName": "Talk to Katheryne for more details",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200300201"
        ],
        "dialogs": {
          "200300201": {
            "id": "200300201",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Without further ado, please allow me to officially welcome you, our new avid adventurer, into the Guild!",
            "nextDialogs": [
              "200300202"
            ]
          },
          "200300202": {
            "id": "200300202",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Here is your <color=#00E1FFFF>Adventurer Handbook</color>.",
            "nextDialogs": [
              "200300204",
              "200300206"
            ]
          },
          "200300204": {
            "id": "200300204",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "A new member coming aboard is a momentous occasion! A little ceremony is only fair.",
            "nextDialogs": [
              "200300207"
            ]
          },
          "200300207": {
            "id": "200300207",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "It has a record of available commissions and rewards.",
            "nextDialogs": [
              "200300208"
            ]
          },
          "200300208": {
            "id": "200300208",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "And it is also proof of your membership.",
            "nextDialogs": [
              "200300209"
            ]
          },
          "200300209": {
            "id": "200300209",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Oh, and one more thing.",
            "nextDialogs": [
              "200300210"
            ]
          },
          "200300210": {
            "id": "200300210",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Sometimes, you will find yourself stuck at a certain Adventure Rank.",
            "nextDialogs": [
              "200300211"
            ]
          },
          "200300211": {
            "id": "200300211",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "When this happens, you need to perform some impressive feats to gain further recognition from the Guild.",
            "nextDialogs": [
              "200300212"
            ]
          },
          "200300212": {
            "id": "200300212",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Impressive feats? Sounds like hazing to me.",
            "nextDialogs": [
              "200300213"
            ]
          },
          "200300213": {
            "id": "200300213",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "They are simply specific adventures that allow you to ascend to the next Adventure Rank on completion. Ascension adventures, if you will.",
            "nextDialogs": [
              "200300214"
            ]
          },
          "200300214": {
            "id": "200300214",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "But that will come later. Opportunities to win recognition will come as you gain more adventure experience.",
            "nextDialogs": [
              "200300215"
            ]
          },
          "200300215": {
            "id": "200300215",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "That will do for today. We will have plenty of chances to meet again in the future.",
            "nextDialogs": [
              "200300216"
            ]
          },
          "200300216": {
            "id": "200300216",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Ad astra abyssosque, Adventurer! With effort, you shall reach the stars and conquer the abyss!"
          },
          "200300206": {
            "id": "200300206",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "It is, in a way. But it has some practical uses too."
          }
        }
      }
    },

    {
      "subId": "100306",
      "subQuestName": "Talk to the chef",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10030601"
        ],
        "dialogs": {
          "10030601": {
            "id": "10030601",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Can't you see I'm on a break kid? Scram.",
            "nextDialogs": [
              "10030602"
            ]
          },
          "10030602": {
            "id": "10030602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Excuse me, we'd like an Almond To—",
            "nextDialogs": [
              "10030603"
            ]
          },
          "10030603": {
            "id": "10030603",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Scram!",
            "nextDialogs": [
              "10030604"
            ]
          },
          "10030604": {
            "id": "10030604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, this chef guy's service is about as good as that Wagner guy's back in Mondstadt.",
            "nextDialogs": [
              "10030605"
            ]
          },
          "10030605": {
            "id": "10030605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's for the boss, Goldet.",
            "nextDialogs": [
              "10030606"
            ]
          },
          "10030606": {
            "id": "10030606",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "...",
            "nextDialogs": [
              "10030607"
            ]
          },
          "10030607": {
            "id": "10030607",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "I see. If it's for the boss, then guess I don't have a choice now, do I?",
            "nextDialogs": [
              "10030608"
            ]
          },
          "10030608": {
            "id": "10030608",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "But my heart's not really in it right now, not enough to make a dessert as painstaking as Almond Tofu.",
            "nextDialogs": [
              "10030609"
            ]
          },
          "10030609": {
            "id": "10030609",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And why is that?",
            "nextDialogs": [
              "10030610"
            ]
          },
          "10030610": {
            "id": "10030610",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "A fencer's hand must be steady, so too must the hand of a chef.",
            "nextDialogs": [
              "10030611"
            ]
          },
          "10030611": {
            "id": "10030611",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "But my hands, I'm... they're not steady...",
            "nextDialogs": [
              "10030612"
            ]
          },
          "10030612": {
            "id": "10030612",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Because ahh, a traveler once told me that this inn... is haunted.",
            "nextDialogs": [
              "10030613"
            ]
          },
          "10030613": {
            "id": "10030613",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "And then, just now — just now! In the kitchen... I saw something... something not right.",
            "nextDialogs": [
              "10030614"
            ]
          },
          "10030614": {
            "id": "10030614",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(This chef looks so intimidating, but speak of ghosts and he becomes weak.)",
            "nextDialogs": [
              "10030615"
            ]
          },
          "10030615": {
            "id": "10030615",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "I keep thinking... even Wangshu Inn isn't safe. I—I can't keep a steady hand for something like Almond Tofu.",
            "nextDialogs": [
              "10030616"
            ]
          },
          "10030616": {
            "id": "10030616",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Alright {NICKNAME}. In the name of high-quality Almond Tofu, we need to go check this kitchen out."
          }
        }
      }
    },

    {
      "subId": "100315",
      "subQuestName": "Talk to Dusky Ming",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10031501"
        ],
        "dialogs": {
          "10031501": {
            "id": "10031501",
            "speakerId": 231101,
            "speakerName": "Dusky Ming",
            "text": "♪ Silly-churl, billy-churl ♪...",
            "nextDialogs": [
              "10031502"
            ]
          },
          "10031502": {
            "id": "10031502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Phew... Finally caught you. Paimon's pooped.",
            "nextDialogs": [
              "10031503"
            ]
          },
          "10031503": {
            "id": "10031503",
            "speakerId": 231101,
            "speakerName": "Dusky Ming",
            "text": "♪ Silly-billy hilichurl ♪ ...",
            "nextDialogs": [
              "10031504"
            ]
          },
          "10031504": {
            "id": "10031504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Haunting things isn't nice! Little girl, are you listening?",
            "nextDialogs": [
              "10031505"
            ]
          },
          "10031505": {
            "id": "10031505",
            "speakerId": 231101,
            "speakerName": "Dusky Ming",
            "text": "♪ Chilly-churl, frilly-churl ♪ ...",
            "nextDialogs": [
              "10031506"
            ]
          },
          "10031506": {
            "id": "10031506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Now listen here young lady!",
            "nextDialogs": [
              "10031507"
            ]
          },
          "10031507": {
            "id": "10031507",
            "speakerId": 231101,
            "speakerName": "Dusky Ming",
            "text": "...",
            "nextDialogs": [
              "10031508"
            ]
          },
          "10031508": {
            "id": "10031508",
            "speakerId": 231101,
            "speakerName": "Dusky Ming",
            "text": "Okay.",
            "nextDialogs": [
              "10031509"
            ]
          },
          "10031509": {
            "id": "10031509",
            "speakerId": 231101,
            "speakerName": "Dusky Ming",
            "text": "Dusky Ming won't tease the travelers at the inn anymore.",
            "nextDialogs": [
              "10031510"
            ]
          },
          "10031510": {
            "id": "10031510",
            "speakerId": 231101,
            "speakerName": "Dusky Ming",
            "text": "#Next time {NICKNAME} can come play with Dusky Ming.",
            "nextDialogs": [
              "10031511"
            ]
          },
          "10031511": {
            "id": "10031511",
            "speakerId": 231101,
            "speakerName": "Dusky Ming",
            "text": "If you don't come and play, Dusky Ming will come find you~"
          }
        }
      }
    },
    {
      "subId": "100316",
      "subQuestName": "Tell Smiley Yanxiao about what happened",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10031601"
        ],
        "dialogs": {
          "10031601": {
            "id": "10031601",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Wh-What... You really got the ghost to promise to stop haunting the inn?",
            "nextDialogs": [
              "10031602"
            ]
          },
          "10031602": {
            "id": "10031602",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Wow... You really are something...",
            "nextDialogs": [
              "10031603"
            ]
          },
          "10031603": {
            "id": "10031603",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "I am in your debt.",
            "nextDialogs": [
              "10031604"
            ]
          },
          "10031604": {
            "id": "10031604",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Please wait a moment. I'll make you the smoothest, silkiest bowl of Almond Tofu.",
            "nextDialogs": [
              "10031605"
            ]
          },
          "10031605": {
            "id": "10031605",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Haha, my hands are steadier than ever now that she's gone."
          }
        }
      }
    },
    {
      "subId": "100317",
      "subQuestName": "Talk to Xiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10031701"
        ],
        "dialogs": {
          "10031701": {
            "id": "10031701",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "...You two again.",
            "nextDialogs": [
              "10031702"
            ]
          },
          "10031702": {
            "id": "10031702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait! Don't go disappearing again.",
            "nextDialogs": [
              "10031703"
            ]
          },
          "10031703": {
            "id": "10031703",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "What's this?",
            "nextDialogs": [
              "10031704"
            ]
          },
          "10031704": {
            "id": "10031704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's your favorite, Almond Tofu! As well as this distant traveler's best dish — a Satisfying Salad.",
            "nextDialogs": [
              "10031705"
            ]
          },
          "10031705": {
            "id": "10031705",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}! Quick! Tell him everything before he finishes eating!",
            "nextDialogs": [
              "10031706"
            ]
          },
          "10031706": {
            "id": "10031706",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Rex Lapis... How could this be?",
            "nextDialogs": [
              "10031707"
            ]
          },
          "10031707": {
            "id": "10031707",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "I... can't imagine it. Though times have changed, I've never imagined a Liyue without him.",
            "nextDialogs": [
              "10031708"
            ]
          },
          "10031708": {
            "id": "10031708",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "The ruling Qixing... Just what role have they played in this?",
            "nextDialogs": [
              "10031709"
            ]
          },
          "10031709": {
            "id": "10031709",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "...",
            "nextDialogs": [
              "10031710"
            ]
          },
          "10031710": {
            "id": "10031710",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "I will seek Moon Carver, Mountain Shaper, and Cloud Retainer. It is time they too made their decisions.",
            "nextDialogs": [
              "10031713"
            ]
          },
          "10031713": {
            "id": "10031713",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Adepti do not turn on their responsibilities.",
            "nextDialogs": [
              "10031714"
            ]
          },
          "10031714": {
            "id": "10031714",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "I have my reasons to not want to be tainted by the mortal realm, but... responsibilities are responsibilities.",
            "nextDialogs": [
              "10031715"
            ]
          },
          "10031715": {
            "id": "10031715",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Our god is the God of Contracts after all.",
            "nextDialogs": [
              "10031716"
            ]
          },
          "10031716": {
            "id": "10031716",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait! Paimon still has one last question.",
            "nextDialogs": [
              "10031717"
            ]
          },
          "10031717": {
            "id": "10031717",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Hmm?",
            "nextDialogs": [
              "10031718"
            ]
          },
          "10031718": {
            "id": "10031718",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That... Dusky Ming. She's...",
            "nextDialogs": [
              "10031719"
            ]
          },
          "10031719": {
            "id": "10031719",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "When conquering demons, on occasion, you can come across spirits who have never hurt anyone, yet are also not yet able to be moved on.",
            "nextDialogs": [
              "10031720"
            ]
          },
          "10031720": {
            "id": "10031720",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "So I asked the innkeeper and the boss if they could keep her here for a time.",
            "nextDialogs": [
              "10031721"
            ]
          },
          "10031721": {
            "id": "10031721",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So really, Wangshu Inn was looking after her! Really keeping a wide range of business going, huh!"
          }
        }
      }
    },
    {
      "subId": "100303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10030304"
        ],
        "dialogs": {
          "10030304": {
            "id": "10030304",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "A Sigil of Permission? You came prepared.",
            "nextDialogs": [
              "10030305"
            ]
          },
          "10030305": {
            "id": "10030305",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Though this only prevents me from hurting you myself. Doesn't stop you from getting hurt in other ways.",
            "nextDialogs": [
              "10030306"
            ]
          },
          "10030306": {
            "id": "10030306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh... Paimon doesn't get it...",
            "nextDialogs": [
              "10030307"
            ]
          },
          "10030307": {
            "id": "10030307",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Too much contact with our world is breaking the rules."
          }
        }
      }
    },
    {
      "subId": "100387",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10038701"
        ],
        "dialogs": {
          "10038701": {
            "id": "10038701",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Ghosts are just another form of life on earth. It's certainly possible to deal with them on their own terms."
          }
        }
      }
    },
    {
      "subId": "100388",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10038801"
        ],
        "dialogs": {
          "10038801": {
            "id": "10038801",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Opportunities to meet an adeptus are rare and fleeting. Make the most of it."
          }
        }
      }
    },
    {
      "subId": "100389",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10038901"
        ],
        "dialogs": {
          "10038901": {
            "id": "10038901",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "I haven't enjoyed something so much in a long time. That dish was pure perfection."
          }
        }
      }
    },
    {
      "subId": "100390",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10039001"
        ],
        "dialogs": {
          "10039001": {
            "id": "10039001",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "May the G—Geo Lord protect you... May all the deities protect you!"
          }
        }
      }
    },
    {
      "subId": "100391",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10039101"
        ],
        "dialogs": {
          "10039101": {
            "id": "10039101",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "If the bosses hadn't been so good to me, there's no way I'd be putting up with this..."
          }
        }
      }
    },
    {
      "subId": "100392",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10039201"
        ],
        "dialogs": {
          "10039201": {
            "id": "10039201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Goodbye.",
            "nextDialogs": [
              "10039202"
            ]
          },
          "10039202": {
            "id": "10039202",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Safe travels."
          }
        }
      }
    },
    {
      "subId": "100393",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10039301"
        ],
        "dialogs": {
          "10039301": {
            "id": "10039301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell me about your husband.",
            "nextDialogs": [
              "10039302"
            ]
          },
          "10039302": {
            "id": "10039302",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Over there. He's the innkeeper.",
            "nextDialogs": [
              "10039303"
            ]
          },
          "10039303": {
            "id": "10039303",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Don't be led astray by the cheeky grin on his face. He is a rather formidable martial artist.",
            "nextDialogs": [
              "10039304"
            ]
          },
          "10039304": {
            "id": "10039304",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "I also practice martial arts, as do the kitchen staff. It is a hiring requirement.",
            "nextDialogs": [
              "10039305"
            ]
          },
          "10039305": {
            "id": "10039305",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "You have to have nimble use of your hands and feet when you're serving guests, don't you think?"
          }
        }
      }
    },
    {
      "subId": "100394",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10039401"
        ],
        "dialogs": {
          "10039401": {
            "id": "10039401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Who are you?",
            "nextDialogs": [
              "10039402"
            ]
          },
          "10039402": {
            "id": "10039402",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "My name is Goldet and I come from Mondstadt. I am the boss here at the Wangshu Inn.",
            "nextDialogs": [
              "10039403"
            ]
          },
          "10039403": {
            "id": "10039403",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Lest you think I was the boss' wife.",
            "nextDialogs": [
              "10039404"
            ]
          },
          "10039404": {
            "id": "10039404",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "I'm the boss, with a capital \"B-O-S-S.\"",
            "nextDialogs": [
              "10039406",
              "10039411"
            ]
          },
          "10039406": {
            "id": "10039406",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Hahaha, well I'd hardly be able to operate an inn in this location without connections with the Qixing.",
            "nextDialogs": [
              "10039407"
            ]
          },
          "10039407": {
            "id": "10039407",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "What I mean is I obviously need their approval.",
            "nextDialogs": [
              "10039408"
            ]
          },
          "10039408": {
            "id": "10039408",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "All that other nonsense is just rumors, though.",
            "nextDialogs": [
              "10039409"
            ]
          },
          "10039409": {
            "id": "10039409",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Speaking of which, have you got any interesting news to share?"
          },
          "10039411": {
            "id": "10039411",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "*sigh* ...This cat invited itself here... But it's cute, so I let it stay.",
            "nextDialogs": [
              "10039412"
            ]
          },
          "10039412": {
            "id": "10039412",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Its name is Wei. That was quite simply the first name we thought of.",
            "nextDialogs": [
              "10039413"
            ]
          },
          "10039413": {
            "id": "10039413",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "You might find Wei causes a bit of mischief — you know what cats are like. But please refrain from stooping to the same level yourself."
          }
        }
      }
    },
    {
      "subId": "100395",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10039501"
        ],
        "dialogs": {
          "10039501": {
            "id": "10039501",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Hello! ...A distinctive but elusive dress sense, defined yet atypical facial features, and followed around everywhere by a floating elf companion. Hmm... nope. Can't place you."
          }
        }
      }
    }
  ]
}
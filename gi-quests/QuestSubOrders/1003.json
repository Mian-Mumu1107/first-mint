            ]
          },
          "10030804": {
            "id": "10030804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "##@&%*!"
          }
        }
      }
    },
    {
      "subId": "100309",
      "subQuestName": "Tell Smiley Yanxiao about what happened",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10030901"
        ],
        "dialogs": {
          "10030901": {
            "id": "10030901",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "What!? You saw it too! There really is a ghost!",
            "nextDialogs": [
              "10030902"
            ]
          },
          "10030902": {
            "id": "10030902",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "What... How can I...",
            "nextDialogs": [
              "10030903"
            ]
          },
          "10030903": {
            "id": "10030903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay, so he's useless now. What do we do?",
            "nextDialogs": [
              "10030904"
            ]
          },
          "10030904": {
            "id": "10030904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Forget it. Let's just go see the boss lady again."
          }
        }
      }
    },
    {
      "subId": "100310",
      "subQuestName": "Seek help from Verr Goldet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10031001"
        ],
        "dialogs": {
          "10031001": {
            "id": "10031001",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Hehe... Scared of something so insignificant. Hard to believe he was once a notorious bandit.",
            "nextDialogs": [
              "10031002"
            ]
          },
          "10031002": {
            "id": "10031002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You don't seem that afraid of ghosts, boss lady.",
            "nextDialogs": [
              "10031003"
            ]
          },
          "10031003": {
            "id": "10031003",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Gods and ghosts, I've seen it all before.",
            "nextDialogs": [
              "10031004"
            ]
          },
          "10031004": {
            "id": "10031004",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Come to think of it, others don't seem to know there's an adeptus here at the inn, except for the boss lady...",
            "nextDialogs": [
              "10031005"
            ]
          },
          "10031005": {
            "id": "10031005",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Shh!",
            "nextDialogs": [
              "10031006"
            ]
          },
          "10031006": {
            "id": "10031006",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Say any more and you'll be divulging my little secret.",
            "nextDialogs": [
              "10031007"
            ]
          },
          "10031007": {
            "id": "10031007",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Right. Best you two be off. Go see to it that little ghost doesn't go scaring anybody else.",
            "nextDialogs": [
              "10031008"
            ]
          },
          "10031008": {
            "id": "10031008",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Not that I'm ordering you around. It's like the adeptus said, mortal souls are not as robust as those of the adepti.",
            "nextDialogs": [
              "10031009"
            ]
          },
          "10031009": {
            "id": "10031009",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "So as to not be harmed when dealing with the adepti, you can start by practicing with that ghost.",
            "nextDialogs": [
              "10031011"
            ]
          },
          "10031011": {
            "id": "10031011",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But how should we persuade the ghost?",
            "nextDialogs": [
              "10031013"
            ]
          },
          "10031013": {
            "id": "10031013",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "There is a calligraphy painting in the inn known as the Witness Sigil. It's been in circulation for over a thousand years. Go take a look at it.",
            "nextDialogs": [
              "10031014"
            ]
          },
          "10031014": {
            "id": "10031014",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Once you have, look for a place outside where you can see the exact same Witness Sigil formation."
          }
        }
      }
    },

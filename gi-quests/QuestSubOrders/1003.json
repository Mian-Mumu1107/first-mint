  "subQuests": [
    {
      "subId": "100301",
      "subQuestName": "Go to Wangshu Inn",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10030101"
        ],
        "dialogs": {
          "10030101": {
            "id": "10030101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, this seems to be Wangshu Inn."
          }
        }
      }
    },
    {
      "subId": "100303",
      "subQuestName": "Talk to Xiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10030301"
        ],
        "dialogs": {
          "10030301": {
            "id": "10030301",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Oh. It's you two.",
            "nextDialogs": [
              "10030302"
            ]
          },
          "10030302": {
            "id": "10030302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We meet again! Hiya!",
            "nextDialogs": [
              "10030303"
            ]
          },
          "10030303": {
            "id": "10030303",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Why do you insist on getting involved in the world of demons and adepti? You're breaking the rules too often.",
            "nextDialogs": [
              "10030308"
            ]
          },
          "10030308": {
            "id": "10030308",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Mortal souls are not as robust as those of adepti, nor can your blood carry this level of adeptal energy.",
            "nextDialogs": [
              "10030309"
            ]
          },
          "10030309": {
            "id": "10030309",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "It's for your own good. Leave. Now.",
            "nextDialogs": [
              "10030310"
            ]
          },
          "10030310": {
            "id": "10030310",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait a sec, we came here to...",
            "nextDialogs": [
              "10030311"
            ]
          },
          "10030311": {
            "id": "10030311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Argh! Paimon's... peeved! All he does is think about himself!",
            "nextDialogs": [
              "10030312"
            ]
          },
          "10030312": {
            "id": "10030312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon wants to give him an ugly nickname... but if you tick off an adeptus, the only thing you'll probably ever find in treasure chests is cabbages! Bleurgh!",
            "nextDialogs": [
              "10030313"
            ]
          },
          "10030313": {
            "id": "10030313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh... Guess we should go ask the boss lady of the inn about just how she manages to talk to adepti."
          }
        }
      }
    },
    {
      "subId": "100304",
      "subQuestName": "Ask the boss lady about Xiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10030401"
        ],
        "dialogs": {
          "10030401": {
            "id": "10030401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell me about that adeptus",
            "nextDialogs": [
              "10030402"
            ]
          },
          "10030402": {
            "id": "10030402",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Oh? You've already met Xiao?",
            "nextDialogs": [
              "10030403"
            ]
          },
          "10030403": {
            "id": "10030403",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Not bad. Not often he's in a good enough mood to agree to see people.",
            "nextDialogs": [
              "10030404"
            ]
          },
          "10030404": {
            "id": "10030404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's his good mood?",
            "nextDialogs": [
              "10030405"
            ]
          },
          "10030405": {
            "id": "10030405",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Oh yes, the adepti are very hard to come by. Many people go their whole lives praying to them, never once actually getting to see one.",
            "nextDialogs": [
              "10030406"
            ]
          },
          "10030406": {
            "id": "10030406",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "When the Geo Archon built Liyue, he borrowed power from the adepti.",
            "nextDialogs": [
              "10030407"
            ]
          },
          "10030407": {
            "id": "10030407",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "But most of them only know how to protect Liyue by fighting.",
            "nextDialogs": [
              "10030408"
            ]
          },
          "10030408": {
            "id": "10030408",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "So for many millennia, it has instead been humans who have led Liyue, whilst the adepti have lived hidden away on the outskirts.",
            "nextDialogs": [
              "10030409"
            ]
          },
          "10030409": {
            "id": "10030409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You really know a lot, huh boss lady.",
            "nextDialogs": [
              "10030410"
            ]
          },
          "10030410": {
            "id": "10030410",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "It's not \"boss lady,\" it's just boss...",
            "nextDialogs": [
              "10030411"
            ]
          },
          "10030411": {
            "id": "10030411",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Anyway, seen as you have the favor of the adepti, things should be a lot easier.",
            "nextDialogs": [
              "10030412"
            ]
          },
          "10030412": {
            "id": "10030412",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Well... If you wanna know my opinion... If you keep Xiao in a good mood, things should be okay.",
            "nextDialogs": [
              "10030413"
            ]
          },
          "10030413": {
            "id": "10030413",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Good mood? Can't really imagine what a \"good mood\" looks like for that \"Vigilant Yaksha.\"",
            "nextDialogs": [
              "10030414"
            ]
          },
          "10030414": {
            "id": "10030414",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Haha! Will be interesting, won't it?",
            "nextDialogs": [
              "10030415"
            ]
          },
          "10030415": {
            "id": "10030415",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "(Come to think of it, I've never seen him smile either...)",
            "nextDialogs": [
              "10030416"
            ]
          },
          "10030416": {
            "id": "10030416",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "How 'bout this — you go see the chef for a bowl of Almond Tofu, and a plate of whatever it is you are best at making.",
            "nextDialogs": [
              "10030417"
            ]
          },
          "10030417": {
            "id": "10030417",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Almond Tofu is one of the few human foods Xiao likes. The other dish is up to you.",
            "nextDialogs": [
              "10030418"
            ]
          },
          "10030418": {
            "id": "10030418",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Up to us, eh...? {NICKNAME}, what do you think you're the best at cooking?",
            "nextDialogs": [
              "10030420",
              "10030422"
            ]
          },
          "10030420": {
            "id": "10030420",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really hard to screw that one up, right?",
            "nextDialogs": [
              "10030423"
            ]
          },
          "10030423": {
            "id": "10030423",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But, if we're gonna be cooking for an adeptus, perhaps the Satisfying Salad would be the safer choice..."
          },
          "10030422": {
            "id": "10030422",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow! Never heard of that one! Paimon wants to try it!"
          }
        }
      }
    },
    {
      "subId": "100305",

          "708019103": {
            "id": "708019103",
            "speakerId": 1000,
            "speakerName": "Swan",
            "text": "To be honest, there are some locals who can't answer some of these questions.",
            "nextDialogs": [
              "708019104"
            ]
          },
          "708019104": {
            "id": "708019104",
            "speakerId": 1000,
            "speakerName": "Swan",
            "text": "Please, take this as a gift."

          "708011001"
        ],
        "dialogs": {
          "708011001": {
            "id": "708011001",
            "speakerId": 1000,
            "speakerName": "Swan",
            "text": "Now, please listen to my questions.",
            "nextDialogs": [
              "708011002"
            ]
          },
          "708011002": {
            "id": "708011002",
            "speakerId": 1000,
            "speakerName": "Swan",
            "text": "To the northwest of Mondstadt are some ruins. Legend holds that it was once a city where a tyrant ruled from his tower. It has since been occupied by Dvalin, who shelters himself there.",
            "nextDialogs": [
              "708011003"
            ]
          },
          "708011003": {
            "id": "708011003",
            "speakerId": 1000,
            "speakerName": "Swan",
            "text": "My question is this: What is the official name now given to these ruins by the Knights of Favonius?"
          }
        }
      }
    },
    {

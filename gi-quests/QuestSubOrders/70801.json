        "dialogs": {
          "708012401": {
            "id": "708012401",
            "speakerId": 1000,
            "speakerName": "Swan",
            "text": "Correct, \"strange yet respectable traveler,\" or indeed \"travelers,\" is the correct way to address those that we meet here who hail from lands beyond."
          }
        }
      }
    },
    {
      "subId": "7080125",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708012501"
        ],
        "dialogs": {
          "708012501": {
            "id": "708012501",
            "speakerId": 1000,
            "speakerName": "Swan",
            "text": "Ahem, no. The correct form is \"strange yet respectable traveler.\" I must stress that you cannot afford to be hazy on such details as an Honorary Knight."
          }
        }
      }
    },
    {
      "subId": "7080130",

  "subQuests": [
    {
      "subId": "37407",
      "subQuestName": "Go to the Cathedral with Venti",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3740701"
        ],
        "dialogs": {
          "3740701": {
            "id": "3740701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So this... \"Holy Lyre der Himmel\" is...",
            "nextDialogs": [
              "3740702"
            ]
          },
          "3740702": {
            "id": "3740702",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "One of the most treasured items in Mondstadt. It's the lyre that Barbatos used to play.",
            "nextDialogs": [
              "3740703"
            ]
          },
          "3740703": {
            "id": "3740703",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "With it, perhaps I can help Dvalin draw his gentle nature back out of this nightmare he's going through.",
            "nextDialogs": [
              "3740704"
            ]
          },
          "3740704": {
            "id": "3740704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Will it really stop Stormterror from causing more damage?",
            "nextDialogs": [
              "3740705"
            ]
          },
          "3740705": {
            "id": "3740705",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Of course. I'm the best bard in the world.",
            "nextDialogs": [
              "3740706"
            ]
          },
          "3740706": {
            "id": "3740706",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "There's not a single song I do not know, no matter if it's from the past, present, or future.",
            "nextDialogs": [
              "3740707"
            ]
          },
          "3740707": {
            "id": "3740707",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Look me in the eyes. Do you not find me trustworthy?",
            "nextDialogs": [
              "3740711"
            ]
          },
          "3740711": {
            "id": "3740711",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Hahaha, that one doesn't work on a bard.",
            "nextDialogs": [
              "3740712"
            ]
          },
          "3740712": {
            "id": "3740712",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So how can we get the Holy Lyre?",
            "nextDialogs": [
              "3740713"
            ]
          },
          "3740713": {
            "id": "3740713",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "It's said that it's enshrined deep within the Cathedral, somewhere safe.",
            "nextDialogs": [
              "3740714"
            ]
          },
          "3740714": {
            "id": "3740714",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "I'll go take a look around. You can come if you want."
          }
        }
      }
    },
    {
      "subId": "37401",

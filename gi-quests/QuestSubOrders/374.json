    {
      "subId": "37406",
      "subQuestName": "Talk to the sister",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3740401"
        ],
        "dialogs": {
          "3740401": {
            "id": "3740401",
            "speakerId": 1161,
            "speakerName": "Gotelinde",
            "text": "Barbatos bless you.",
            "nextDialogs": [
              "3740403",
              "3740405"
            ]
          },
          "3740403": {
            "id": "3740403",
            "speakerId": 1161,
            "speakerName": "Gotelinde",
            "text": "Ah, it's you! The newcomer of the Knights of Favonius, aren't you?",
            "nextDialogs": [
              "3740406"
            ]
          },
          "3740406": {
            "id": "3740406",
            "speakerId": 1161,
            "speakerName": "Gotelinde",
            "text": "So what brings you here? Tasks from the Acting Grand Master?",
            "nextDialogs": [
              "3740411"
            ]
          },
          "3740411": {
            "id": "3740411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, actually. The Knights of Favonius would like to borrow the Holy Lyre...",
            "nextDialogs": [
              "3740412"
            ]
          },
          "3740412": {
            "id": "3740412",
            "speakerId": 1161,
            "speakerName": "Gotelinde",
            "text": "Is that so?",
            "nextDialogs": [
              "3740413"
            ]
          },
          "3740413": {
            "id": "3740413",
            "speakerId": 1161,
            "speakerName": "Gotelinde",
            "text": "Not that I don't trust you. It's just that a suspicious bard came looking to borrow the Holy Lyre as well.",
            "nextDialogs": [
              "3740414"
            ]
          },
          "3740414": {
            "id": "3740414",
            "speakerId": 1161,
            "speakerName": "Gotelinde",
            "text": "He's full of nonsense and even called himself Barbatos. He must be up to something.",
            "nextDialogs": [
              "3740415"
            ]
          },
          "3740415": {
            "id": "3740415",
            "speakerId": 1161,
            "speakerName": "Gotelinde",
            "text": "There are regulations in place for the use of the Holy Lyre. Currently, it's only used in Ludi Harpastum.",
            "nextDialogs": [
              "3740416"
            ]
          },
          "3740416": {
            "id": "3740416",
            "speakerId": 1161,
            "speakerName": "Gotelinde",
            "text": "Signed documents from the Grand Master, Seneschal, and Community Representative are all required.",
            "nextDialogs": [
              "3740417"
            ]
          },
          "3740417": {
            "id": "3740417",
            "speakerId": 1161,
            "speakerName": "Gotelinde",
            "text": "So, may I see the document from the Knights of Favonius?"
          },
          "3740405": {
            "id": "3740405",
            "speakerId": 1161,
            "speakerName": "Gotelinde",
            "text": "I know you. You and Amber saved Mondstadt that day."
          }
        }
      }
    },
    {
      "subId": "37309",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3730901"
        ],
        "dialogs": {
          "3730901": {
            "id": "3730901",
            "speakerId": 1161,
            "speakerName": "Gotelinde",
            "text": "The Church has been a mess recently, and the Seneschal is not here... *sigh*"
          }
        }
      }
    },
    {
      "subId": "37502",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3750202"
        ],
        "dialogs": {
          "3750202": {
            "id": "3750202",
            "speakerId": 1162,
            "speakerName": "Otto",
            "text": "Man, this stinks. Having to stand around here all <color=#00E1FFFF>day</color> long, having to guard this entrance.\\nHey! Don't move! You can't go down there!",
            "nextDialogs": [
              "3750203"
            ]
          },
          "3750203": {
            "id": "3750203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems we're gonna have to wait until <color=#00E1FFFF>nightfall</color> to sneak in..."
          }
        }
      }
    }
  ]
}
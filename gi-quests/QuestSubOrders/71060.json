    {
      "subId": "7105911",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710591101"
        ],
        "dialogs": {
          "710591101": {
            "id": "710591101",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "What? Are you here to disturb my rest?",
            "nextDialogs": [
              "710591102"
            ]
          },
          "710591102": {
            "id": "710591102",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Nope, we just wanna talk to you, seeing you sitting here all by your lonesome.",
            "nextDialogs": [
              "710591105"
            ]
          },
          "710591105": {
            "id": "710591105",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Is that so? Thank you. You... remind me of Lyudochka.",
            "nextDialogs": [
              "710591106"
            ]
          },
          "710591106": {
            "id": "710591106",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "She's really enthusiastic, just like you... She kept sticking with me, telling me all sorts of things... I was the only one she often confided certain things to.",
            "nextDialogs": [
              "710591107"
            ]
          },
          "710591107": {
            "id": "710591107",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "*sigh* How I wish she was around. She's such a fun person. I bet you'd like her if you saw her."
          }
        }
      }
    },
    {
      "subId": "7105912",

            "speakerName": "Paimon",
            "text": "Nope, we just wanna talk to you, seeing as how you're sitting here all by your lonesome!",
            "nextDialogs": [
              "710591205"
            ]
          },
          "710591205": {
            "id": "710591205",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Is that so? Thank you. You... remind me of Lyudochka.",
            "nextDialogs": [
              "710591206"

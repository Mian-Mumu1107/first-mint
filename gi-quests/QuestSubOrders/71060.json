          },
          "710591208": {
            "id": "710591208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Lyudochka? Who is she?",
            "nextDialogs": [
              "710591209"
            ]
          },
          "710591209": {
            "id": "710591209",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "A friend of mine. Though she may appear serious, she's a funny little pumpkin.",
            "nextDialogs": [
              "710591210"
            ]
          },
          "710591210": {
            "id": "710591210",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "We were like sisters back in the House of the Hearth — I'd say that she was even dearer than a real sister. She liked to tease me... And she also looked after me.",
            "nextDialogs": [
              "710591211"
            ]
          },
          "710591211": {
            "id": "710591211",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "Haha, anyway, I have a hunch that she's doing fine out there. With this thought in mind, all the injuries that I got in this hell of a place seem to feel like nothing.",
            "nextDialogs": [
              "710591212"
            ]
          },
          "710591212": {
            "id": "710591212",
            "speakerId": 1001,
            "speakerName": "Katarina",
            "text": "I hope she's doing her job alright... Hope she doesn't think of me."
          }
        }
      }
    }

          },
          "721160402": {
            "id": "721160402",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Now, all we need to do is wait for our beacons to collect enough data.",
            "nextDialogs": [
              "721160403"
            ]
          },
          "721160403": {
            "id": "721160403",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Once we have that data on hand, I will make a few tweaks to this device accordingly.",
            "nextDialogs": [
              "721160404"
            ]
          },
          "721160404": {
            "id": "721160404",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Once all is ready, let us put a decisive end to this incident."
          }
        }
      }
    },

        "dialogs": {
          "721160101": {
            "id": "721160101",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "It'll take a while longer...",
            "nextDialogs": [
              "721160102"
            ]
          },
          "721160102": {
            "id": "721160102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you gathered all the necessary data?",
            "nextDialogs": [
              "721160103"
            ]
          },
          "721160103": {
            "id": "721160103",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Ah, it's you! Wonderful. We haven't quite collected all the data we need yet. I believe it will take a little more time.",
            "nextDialogs": [
              "721160104"
            ]
          },
          "721160104": {
            "id": "721160104",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "That said, I've taken this opportunity to think about the structure of the emergency purifier...",
            "nextDialogs": [
              "721160106",
              "721160108"
            ]
          },
          "721160106": {
            "id": "721160106",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Just a last-minute trick I've pulled.",
            "nextDialogs": [
              "721160109"
            ]
          },
          "721160109": {
            "id": "721160109",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "According to our previous discussions, we must deal with a two-pronged problem: the Fatui and the Tatarigami within.",
            "nextDialogs": [
              "721160110"
            ]
          },
          "721160110": {
            "id": "721160110",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "I trust you will be able to deal with the Fatui. My part in this, therefore, is to deal with the Tatarigami energy.",
            "nextDialogs": [
              "721160111"
            ]
          },
          "721160111": {
            "id": "721160111",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "This emergency purifier is a device that I have had purpose-built for that task. However, I'm going to need your help to complete it."
          },
          "721160108": {
            "id": "721160108",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "I suppose, although I would hesitate to provide this sort of aid during normal customer service..."
          }
        }
      }
    },

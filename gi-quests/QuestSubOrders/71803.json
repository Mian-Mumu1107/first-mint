        ],
        "dialogs": {
          "718030401": {
            "id": "718030401",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Have you defeated the Stonehide Lawachurl?",
            "nextDialogs": [
              "718030403",
              "718030405"
            ]
          },
          "718030403": {
            "id": "718030403",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Thanks, you've done us a favor. With this commission under our belt, we'll have no problem proving the Guild's ability."
          },
          "718030405": {
            "id": "718030405",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Thanks, you've done us a fav— say what now?"
          }
        }
      }
    },
    {
      "subId": "7180306",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718030501"
        ],
        "dialogs": {
          "718030501": {
            "id": "718030501",
            "speakerId": 20180,
            "speakerName": "Ash",
            "text": "Meow, meow... Meow?",
            "nextDialogs": [
              "718030502"
            ]
          },
          "718030502": {
            "id": "718030502",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "This cat is...",
            "nextDialogs": [
              "718030503"
            ]
          },
          "718030503": {
            "id": "718030503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It might be Ash.",
            "nextDialogs": [
              "718030504"
            ]
          },
          "718030504": {
            "id": "718030504",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Give me a moment, let me check its features against the list of features written down in the commission.",
            "nextDialogs": [
              "718030505"
            ]
          },
          "718030505": {
            "id": "718030505",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Let's see...",
            "nextDialogs": [
              "718030506"
            ]
          },
          "718030506": {
            "id": "718030506",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "It mostly checks out. This seems to be the cat we're looking for.",
            "nextDialogs": [
              "718030508"
            ]
          },
          "718030508": {
            "id": "718030508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The commissioner should be pleased.",
            "nextDialogs": [
              "718030509"
            ]
          },
          "718030509": {
            "id": "718030509",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Hah. After all those twists and turns, we came right back to looking for lost cats.",
            "nextDialogs": [
              "718030510"
            ]
          },
          "718030510": {
            "id": "718030510",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "I'm really not sure what to say...",
            "nextDialogs": [
              "718030511"
            ]
          },
          "718030511": {
            "id": "718030511",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "I'll report these commissions to their commissioners. Thank you very much — please accept this as compensation for doing us this favor.",
            "nextDialogs": [
              "718030512"
            ]
          },
          "718030512": {
            "id": "718030512",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Hmm, it seems that the commissioner for the cat-related commission has since moved. It'll take some time to contact them.",
            "nextDialogs": [
              "718030513"
            ]
          },
          "718030513": {
            "id": "718030513",
            "speakerId": 2016,
            "speakerName": "Lan",
            "text": "Guess I'll just have to take care of this rascal in the meantime.",
            "nextDialogs": [
              "718030514"
            ]
          },
          "718030514": {
            "id": "718030514",
            "speakerId": 20180,
            "speakerName": "Ash",
            "text": "Meow-meow, meow!"
          }
        }
      }

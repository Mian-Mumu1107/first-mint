    {
      "subId": "7006107",
      "subQuestName": "Tell Leopoldine the forest boar is gone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700610701"
        ],
        "dialogs": {
          "700610701": {
            "id": "700610701",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "Oh — you're back? How did it go?",
            "nextDialogs": [
              "700610702"
            ]
          },
          "700610702": {
            "id": "700610702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We chased it off!",
            "nextDialogs": [
              "700610703"
            ]
          },
          "700610703": {
            "id": "700610703",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "Ah, thank you so much. Here, this is for your trouble.",
            "nextDialogs": [
              "700610704"
            ]
          },
          "700610704": {
            "id": "700610704",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "Work deserves payment, after all.",
            "nextDialogs": [
              "700610705"
            ]
          },
          "700610705": {
            "id": "700610705",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "Now I can finally get the flower field back in order. Let's just hope no more \"inhuman\" visitors show up again..."
          }
        }
      }
    },
    {

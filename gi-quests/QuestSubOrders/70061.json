  "subQuests": [
    {
      "subId": "7006111",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700610101"
        ],
        "dialogs": {
          "700610101": {
            "id": "700610101",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "*sigh* Not again... Why does this keep happening? The field's a mess...",
            "nextDialogs": [
              "700610102"
            ]
          },
          "700610102": {
            "id": "700610102",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "At this rate, I won't be able to deliver the flowers on time. What am I supposed to tell my customers?",
            "nextDialogs": [
              "700610103"
            ]
          },
          "700610103": {
            "id": "700610103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "700610104"
            ]
          },
          "700610104": {
            "id": "700610104",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "Look at this. The whole field's wrecked... These flowers were coming in beautifully, and now they're ruined.",
            "nextDialogs": [
              "700610105"
            ]
          },
          "700610105": {
            "id": "700610105",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "All because of that menace!",
            "nextDialogs": [
              "700610106"
            ]
          },
          "700610106": {
            "id": "700610106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's inhuman!",
            "nextDialogs": [
              "700610107"
            ]
          },
          "700610107": {
            "id": "700610107",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "I know, right? ...Well. Not human at all, actually. It's a forest boar.",
            "nextDialogs": [
              "700610108"
            ]
          },
          "700610108": {
            "id": "700610108",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "For some reason, it keeps coming down here lately, nibbling the flowers and then flopping around in the middle of the field.",
            "nextDialogs": [
              "700610109"
            ]
          },
          "700610109": {
            "id": "700610109",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "And it's slippery. The moment anyone hears it and heads over, it takes off. Just now it nearly barreled into an elderly man passing by...",
            "nextDialogs": [
              "700610110"
            ]
          },
          "700610110": {
            "id": "700610110",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "It's outrageous. This fellow's a real boor, I tell you!",
            "nextDialogs": [
              "700610111"
            ]
          },
          "700610111": {
            "id": "700610111",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "Oh — wait... hold on. Aren't you the Honorary Knight? The hero who saved Mondstadt? Then please, I really need your help.",
            "nextDialogs": [
              "700610112"
            ]
          },
          "700610112": {
            "id": "700610112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright. I'll chase it off!",
            "nextDialogs": [
              "700610113"
            ]
          },
          "700610113": {
            "id": "700610113",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "That's such a relief... I think it headed toward the valley.",
            "nextDialogs": [
              "700610114"
            ]
          },
          "700610114": {
            "id": "700610114",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "It's a clever beastie. You might have to lure it out with flowers... though, well, you can see what's left of mine...",
            "nextDialogs": [
              "700610115"
            ]
          },
          "700610115": {
            "id": "700610115",
            "speakerId": 1000,
            "speakerName": "Leopoldine",
            "text": "Maybe grab a few Windrest Flowers along the way and use them as bait. Would serve it right to get fooled for once!"
          }
        }
      }
    },

    {
      "subId": "100015",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10001501"
        ],
        "dialogs": {
          "10001501": {
            "id": "10001501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wha... What's going on!?",
            "nextDialogs": [
              "10001502"
            ]
          },
          "10001502": {
            "id": "10001502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Did she just say Rex Lapis is...",
            "nextDialogs": [
              "10001503"
            ]
          },
          "10001503": {
            "id": "10001503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The Geo Archon... is... DEAD!?",
            "nextDialogs": [
              "10001504"
            ]
          },
          "10001504": {
            "id": "10001504",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh no, the Millelith! Looks like they're nabbing suspects who got too close.",
            "nextDialogs": [
              "10001505"
            ]
          },
          "10001505": {
            "id": "10001505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon's freaking out. The killer is amongst us!",
            "nextDialogs": [
              "10001506"
            ]
          },
          "10001506": {
            "id": "10001506",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait... we got close... are we suspects!?",
            "nextDialogs": [
              "10001507"
            ]
          },
          "10001507": {
            "id": "10001507",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, where are you going?"
          }
        }
      }
    },

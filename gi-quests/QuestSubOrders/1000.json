    {
      "subId": "100021",
      "subQuestName": "Pray and make a wish at Yujing Terrace",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10002101"
        ],
        "dialogs": {
          "10002101": {
            "id": "10002101",
            "speakerId": 1004,
            "speakerName": "Changshun",
            "text": "Oh, you also want a little adepti luck too?",
            "nextDialogs": [
              "10002102"
            ]
          },
          "10002102": {
            "id": "10002102",
            "speakerId": 1004,
            "speakerName": "Changshun",
            "text": "Haha, seems you know a lot! Making a wish during this time is sure to get you the blessings of both the Adepti and Rex Lapis himself.",
            "nextDialogs": [
              "10002103"
            ]
          },
          "10002103": {
            "id": "10002103",
            "speakerId": 1004,
            "speakerName": "Changshun",
            "text": "I've already made my wish, so you can take this.",
            "nextDialogs": [
              "10002104"
            ]
          },
          "10002104": {
            "id": "10002104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Great, thanks!",
            "nextDialogs": [
              "10002105"
            ]
          },
          "10002105": {
            "id": "10002105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#I wish I could find my {M#sister}{F#brother} soon..."
          }
        }
      }
    },
    {
      "subId": "100022",
      "subQuestName": "Pray and make a wish at Yujing Terrace",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10002201"
        ],
        "dialogs": {
          "10002201": {
            "id": "10002201",
            "speakerId": 1005,
            "speakerName": "Ivanovich",
            "text": "Your first time in Liyue? Actually, it's my first time to see the Rite of Descension too.",
            "nextDialogs": [
              "10002202"
            ]
          },
          "10002202": {
            "id": "10002202",
            "speakerId": 1005,
            "speakerName": "Ivanovich",
            "text": "Ah, look! That's Ms. Ningguang of the Liyue Qixing!",
            "nextDialogs": [
              "10002203"
            ]
          },
          "10002203": {
            "id": "10002203",
            "speakerId": 1005,
            "speakerName": "Ivanovich",
            "text": "Only those who have control in Liyue can preside over the Rite of Descension.",
            "nextDialogs": [
              "10002204"
            ]
          },
          "10002204": {
            "id": "10002204",
            "speakerId": 1005,
            "speakerName": "Ivanovich",
            "text": "Oh yeah, not sure if you knew, but most of the adepti appear in the form of various beasts.",
            "nextDialogs": [
              "10002205"
            ]
          },
          "10002205": {
            "id": "10002205",
            "speakerId": 1005,
            "speakerName": "Ivanovich",
            "text": "I heard that when attending these kinds of formal occasions, Rex Lapis himself appears as a celestial cross between two of Liyue's ancient mythical creatures...",
            "nextDialogs": [
              "10002206"
            ]
          },
          "10002206": {
            "id": "10002206",
            "speakerId": 1005,
            "speakerName": "Ivanovich",
            "text": "...Sorry, I shouldn't interrupt your wish. Please, take this.",
            "nextDialogs": [
              "10002207"
            ]
          },
          "10002207": {
            "id": "10002207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I wish I could get some leads from the Geo Archon..."
          }
        }
      }
    },

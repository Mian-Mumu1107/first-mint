        ],
        "dialogs": {
          "721080101": {
            "id": "721080101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're finally here! This must be the Chinju Forest.",
            "nextDialogs": [
              "721080102"
            ]
          },
          "721080102": {
            "id": "721080102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Miss Masked Maiden said that an old friend of hers is in here.",
            "nextDialogs": [
              "721080103"
            ]
          },
          "721080103": {
            "id": "721080103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, let's get moving!"
          }
        }
      }
    },

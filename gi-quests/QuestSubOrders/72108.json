    {
      "subId": "7210816",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721080401"
        ],
        "dialogs": {
          "721080401": {
            "id": "721080401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The Sky Kitsune Statue that was supposed to protect the ward... It's empty inside.",
            "nextDialogs": [
              "721080402"
            ]
          },
          "721080402": {
            "id": "721080402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Maybe it was hidden by Miss Mask's old friend. Let's go find out!",
            "nextDialogs": [
              "721080403"
            ]
          },
          "721080403": {
            "id": "721080403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Miss Mask,\" Paimon?",
            "nextDialogs": [
              "721080404"
            ]
          },
          "721080404": {
            "id": "721080404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon just came up with that nickname. How is it? Easier to remember, right?",
            "nextDialogs": [
              "721080407"
            ]
          },
          "721080407": {
            "id": "721080407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, forget it then... Anyway, let's find some clues first!"
          }
        }
      }
    },
    {
      "subId": "7210813",
      "subQuestName": "Defeat the hilichurls",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721081301"
        ],
        "dialogs": {
          "721081301": {
            "id": "721081301",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Once upon a time, I was the renowned bake-danuki, Ioroi. One of these days, I will definitely use eight huge...",
            "nextDialogs": [
              "721081302"
            ]
          },
          "721081302": {
            "id": "721081302",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Oh, it's you... Ahem... Our fates are twined now, so ask me whatever questions you may have.",
            "nextDialogs": [
              "721081304",
              "721081307",
              "721081312",
              "721081318",
              "721081320",
              "721081331",
              "721081338",
              "721081345"
            ]
          },
          "721081304": {
            "id": "721081304",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "I may just be a stone statue now, but I was once a big shot known as Ioroi, the Hidden Protector of the Grove.",
            "nextDialogs": [
              "721081305"
            ]
          },
          "721081305": {
            "id": "721081305",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "My job was to guard the Chinju Forest and everything in it. And as you can see, I've done a good job indeed!"
          },
          "721081307": {
            "id": "721081307",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Eh? Oh, you misunderstand. The hilichurls mean no harm to me. It's just that I haven't been able to look for people to play with ever since being turned into stone. They're the only ones who have kept me company.",
            "nextDialogs": [
              "721081308"
            ]
          },
          "721081308": {
            "id": "721081308",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "At first, I thought you were here with ill intentions because you're human. That's why I had them go after you. But it's good that you're okay.",
            "nextDialogs": [
              "721081309"
            ]
          },
          "721081309": {
            "id": "721081309",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Though we can't communicate and they may be a little dull-witted, I'd still count them among my companions after all this time.",
            "nextDialogs": [
              "721081310"
            ]
          },
          "721081310": {
            "id": "721081310",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "It is strange, though. There didn't use to be this many hilichurls in Inazuma. I can't remember when that started..."
          },
          "721081312": {
            "id": "721081312",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "I used to be a bake-danuki, free as can be! I wasn't famous or anything, but I was free indeed, and I had that sneaky kitsune around to compete with often.",
            "nextDialogs": [
              "721081313"
            ]
          },
          "721081313": {
            "id": "721081313",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "One day, the kitsune made a bet with me, claiming that I wouldn't be able to steal the Naku Weed from the Shogun's imperial garden. I accepted the challenge and almost got split in twain for it, just like Yashiori Island.",
            "nextDialogs": [
              "721081314"
            ]
          },
          "721081314": {
            "id": "721081314",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "And in the end...",
            "nextDialogs": [
              "721081315"
            ]
          },
          "721081315": {
            "id": "721081315",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "In the end, that sneaky kitsune pleaded with the Shogun on my behalf, and I was spared. Not only did the Shogun let me live, but she also bestowed upon me the sacred duty of the Protector of the Grove.",
            "nextDialogs": [
              "721081316"
            ]
          },
          "721081316": {
            "id": "721081316",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "I will never forget what happened. I owe my life to that sneaky kitsune..."
          },
          "721081318": {
            "id": "721081318",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Our kind have always lived on the lands of Narukami. Is there something confusing about that?"
          },
          "721081320": {
            "id": "721081320",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Err, how would I know...",
            "nextDialogs": [
              "721081321"
            ]
          },
          "721081321": {
            "id": "721081321",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Wait, it's probably because I stole that comb.",
            "nextDialogs": [
              "721081322"
            ]
          },
          "721081322": {
            "id": "721081322",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Like anyone would've known that the comb was meant to be used to make Sacred Sakura Daifukus!",
            "nextDialogs": [
              "721081323"
            ]
          },
          "721081323": {
            "id": "721081323",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "So, the sneaky kitsune had stopped appeared since challenging me to hide-and-seek that day.",
            "nextDialogs": [
              "721081324"
            ]
          },
          "721081324": {
            "id": "721081324",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "I tried everything to lure her out. I would cause all sorts of ruckus, knowing that she would always come and stop me.",
            "nextDialogs": [
              "721081325"
            ]
          },
          "721081325": {
            "id": "721081325",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "I turned the Lavender Melon in Konda Village into potatoes, and Sunsettias into tigers. The sneaky kitsune would normally turn up to stop me at that point, but this time was different.",
            "nextDialogs": [
              "721081326"
            ]
          },
          "721081326": {
            "id": "721081326",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "So I felt really angry afterwards and decided to go and destroy the statues of her kin. That was when I discovered the comb.",
            "nextDialogs": [
              "721081327"
            ]
          },
          "721081327": {
            "id": "721081327",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "I thought to myself, \"that sneaky kitsune would surely be flustered and appear if I stole this comb.\" So I did.",
            "nextDialogs": [
              "721081328"
            ]
          },
          "721081328": {
            "id": "721081328",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "In the end, a young human appeared instead of that sneaky kitsune. If mine mind serves me well, he was one of the three who learned their arts from the Yougou Tengu.",
            "nextDialogs": [
              "721081329"
            ]
          },
          "721081329": {
            "id": "721081329",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "I had no idea why he was so strong, but he was able to seal me and the others into the stone statues."
          },
          "721081331": {
            "id": "721081331",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Terrible, isn't it? That kitsune dared to challenged me to hide-and-seek.",
            "nextDialogs": [
              "721081332"
            ]
          },
          "721081332": {
            "id": "721081332",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "She even said \"Don't show yourself for anything,\" \"If anything happens, it's me using spells to provoke you.\" Weird, right?",
            "nextDialogs": [
              "721081333"
            ]
          },
          "721081333": {
            "id": "721081333",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "I'm a bake-danuki, as well as the Protector of the Grove. Naturally, I couldn't turn down a challenge of hide-and-seek in the Chinju Forest.",
            "nextDialogs": [
              "721081334"
            ]
          },
          "721081334": {
            "id": "721081334",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "I found a great spot and turned myself into an Onikabuto, so I could watch as she ran all over the place looking for me!",
            "nextDialogs": [
              "721081335"
            ]
          },
          "721081335": {
            "id": "721081335",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "However, she never came, and so the challenge goes on.",
            "nextDialogs": [
              "721081336"
            ]
          },
          "721081336": {
            "id": "721081336",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "I will keep waiting for that sneaky kitsune to come back and apologize to me. Hmph, actually, there's a lot she needs to apologize for! I'll have her know that I'm keeping score!"
          },
          "721081338": {
            "id": "721081338",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "The Chinju Forest used to be the territory of yours truly, Ioroi, the Hidden Protector of the Grove, and my kind, up until that human turned us into stone.",
            "nextDialogs": [
              "721081339"
            ]
          },
          "721081339": {
            "id": "721081339",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "So if you see stone statues that look like me, there's probably a bake-danuki sealed inside.",
            "nextDialogs": [
              "721081340"
            ]
          },
          "721081340": {
            "id": "721081340",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "However, the seals seem to have loosened recently. Kichiboushi and the others have returned to their original form, so there's still hope for me yet.",
            "nextDialogs": [
              "721081341"
            ]
          },
          "721081341": {
            "id": "721081341",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Hey, can you promise me something?",
            "nextDialogs": [
              "721081342"
            ]
          },
          "721081342": {
            "id": "721081342",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Be nice to my little bake-danuki when you see them out there.",
            "nextDialogs": [
              "721081343"
            ]
          },
          "721081343": {
            "id": "721081343",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "They've been sealed for so long... All they want to do is see the outside world."
          },
          "721081345": {
            "id": "721081345",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Ah, that person would probably recite some complicated poem right now... See you around.",
            "nextDialogs": [
              "721081346"
            ]
          },
          "721081346": {
            "id": "721081346",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Come and play with me when you are free. I mean... I'm a stone after all, so I've got nothing but time to play."
          }
        }
      }
    },
    {
      "subId": "7210814",
      "subQuestName": "Talk to the Weird Statue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721080701"
        ],
        "dialogs": {
          "721080701": {
            "id": "721080701",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Eek! I—I... Mine name is Ioroi. Do whatever you want! K—Kill me if that be your will!",
            "nextDialogs": [
              "721080702"
            ]
          },
          "721080702": {
            "id": "721080702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, the statue is talking! And it's so scared that it can barely string a sentence together!",
            "nextDialogs": [
              "721080703"
            ]
          },
          "721080703": {
            "id": "721080703",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "I am no statue! This unseemly appearance is but the work of a temporary seal! Mine name is Ioroi, the world-renowned bake-danuki!",
            "nextDialogs": [
              "721080706"
            ]
          },
          "721080706": {
            "id": "721080706",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "What? Are you telling me that folk nowadays have heard naught of Ioroi?",
            "nextDialogs": [
              "721080707"
            ]
          },
          "721080707": {
            "id": "721080707",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "The \"Tanuki Gyouen Scroll,\" \"Ioroi's Teapot,\" \"Kakushigami Oobayashi,\" \"Yougou Tanuki Gassen\"... Of these tales have you heard nothing?",
            "nextDialogs": [
              "721080708"
            ]
          },
          "721080708": {
            "id": "721080708",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Ah, how long has mine seal persisted..."
          }
        }
      }
    },

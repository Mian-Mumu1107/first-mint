    {
      "subId": "7613102",
      "subQuestName": "Go to the reverse side of the moon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761310201"
        ],
        "dialogs": {
          "761310201": {
            "id": "761310201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Give us a moment.",
            "nextDialogs": [
              "761310202"
            ]
          },
          "761310202": {
            "id": "761310202",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Don't worry. I'll be waiting right here."
          }

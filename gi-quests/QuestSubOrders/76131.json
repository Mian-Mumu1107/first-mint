    {
      "subId": "7613103",
      "subQuestName": "Find a way to enter the base",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7613104",
      "subQuestName": "Find a way to enter the base",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761310401"
        ],
        "dialogs": {
          "761310401": {
            "id": "761310401",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Looks like we can head deeper into the base from here.",
            "nextDialogs": [
              "761310402"
            ]
          },
          "761310402": {
            "id": "761310402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Who would've thought this base would still be operational? This is crazy.",
            "nextDialogs": [
              "761310403"
            ]
          },
          "761310403": {
            "id": "761310403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's dragon-tech for you.",
            "nextDialogs": [
              "761310404"
            ]
          },
          "761310404": {
            "id": "761310404",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "In that case, let's not disturb the fruits of their labor.",
            "nextDialogs": [
              "761310405"
            ]
          },
          "761310405": {
            "id": "761310405",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What are you talking about? Paimon thought we could turn this place upside down now that you're here.",
            "nextDialogs": [
              "761310406"
            ]
          },
          "761310406": {
            "id": "761310406",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "Aren't you afraid that things might turn out like when we came to the moon? We almost didn't make it onto the spaceship.",
            "nextDialogs": [
              "761310407"
            ]
          },
          "761310407": {
            "id": "761310407",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ah... Paimon completely forgot about that! Ugh. Seriously, why would a base even have a self-destruct system anyway...",
            "nextDialogs": [
              "761310408"
            ]
          },
          "761310408": {
            "id": "761310408",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Guess we'll have to keep a low profile, just like old times.",
            "nextDialogs": [
              "761310409"
            ]
          },
          "761310409": {
            "id": "761310409",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Yes. To be honest, I'd like to know what's inside too... and sneaking into my own \"home\" is quite... novel.",
            "nextDialogs": [
              "761310410"
            ]
          },
          "761310410": {
            "id": "761310410",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Also, now we're here, that strange sense of familiarity is only growing stronger..."
          }
        }
      }
    },
    {
      "subId": "7613105",
      "subQuestName": "Move deeper into the base",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761310501"
        ],
        "dialogs": {
          "761310501": {
            "id": "761310501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Gravity seems back to normal...",
            "nextDialogs": [
              "761310502"
            ]
          },
          "761310502": {
            "id": "761310502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Columbina! You're back! Was it you who fixed the problem just now? Talk about perfect timing...",
            "nextDialogs": [
              "761310503"
            ]
          },
          "761310503": {
            "id": "761310503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We were so worried! Where did you go?",
            "nextDialogs": [
              "761310504"
            ]
          },
          "761310504": {
            "id": "761310504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you alright?",
            "nextDialogs": [
              "761310505"
            ]
          },
          "761310505": {
            "id": "761310505",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "I'm sorry. I didn't expect the depths of this base to actually lead to the moon's core. It contains an extremely high concentration of ancient moon energy.",
            "nextDialogs": [
              "761310506"
            ]
          },
          "761310506": {
            "id": "761310506",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "When I suffused this base with kuuvahki, I accidentally came into contact with it and was swept into the moon's core.",
            "nextDialogs": [
              "761310507"
            ]
          },
          "761310507": {
            "id": "761310507",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So you really went there...? Paimon was starting to think this base was haunted!",
            "nextDialogs": [
              "761310508"
            ]
          },
          "761310508": {
            "id": "761310508",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Anyway, Paimon's glad you're okay! We just discovered some new info about Project Moongazer. It's...",
            "nextDialogs": [
              "761310509"
            ]
          },
          "761310509": {
            "id": "761310509",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "I already learned the truth at the moon's core...",
            "nextDialogs": [
              "761310510"
            ]
          },
          "761310510": {
            "id": "761310510",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "I discovered who you are as well, Ninnin.",
            "nextDialogs": [
              "761310511"
            ]
          },
          "761310511": {
            "id": "761310511",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "It seems that is where my mission lies. Please take me there.",
            "nextDialogs": [
              "761310512"
            ]
          },
          "761310512": {
            "id": "761310512",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Hmm...",
            "nextDialogs": [
              "761310513"
            ]
          },
          "761310513": {
            "id": "761310513",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What's wrong, Columbina? You look like you don't want her to go there..",
            "nextDialogs": [
              "761310514"
            ]
          },
          "761310514": {
            "id": "761310514",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Ninnin... cannot survive within the moon's core.",
            "nextDialogs": [
              "761310515"
            ]
          },
          "761310515": {
            "id": "761310515",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "But I must complete my mission.",
            "nextDialogs": [
              "761310516"
            ]
          },
          "761310516": {
            "id": "761310516",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Yes, but it does not wait for you there.",
            "nextDialogs": [
              "761310517"
            ]
          },
          "761310517": {
            "id": "761310517",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "What?",
            "nextDialogs": [
              "761310518"
            ]
          },
          "761310518": {
            "id": "761310518",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Your mission isn't to be accomplished at the moon's core. Rather, it is to be found in the place where everything began.",
            "nextDialogs": [
              "761310519"
            ]
          },
          "761310519": {
            "id": "761310519",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You mean the Eye of Ibni-Belum?",
            "nextDialogs": [
              "761310520"
            ]
          },
          "761310520": {
            "id": "761310520",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Yes, your mission is to activate Project Moongazer within the Eye.",
            "nextDialogs": [
              "761310521"
            ]
          },
          "761310521": {
            "id": "761310521",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "That requires a data key made from the ancient moon's power. I can journey to the moon's core once again to retrieve it for you, but it will take some time.",
            "nextDialogs": [
              "761310522"
            ]
          },
          "761310522": {
            "id": "761310522",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "Are you asking me... to return to the Eye and wait?",
            "nextDialogs": [
              "761310523"
            ]
          },
          "761310523": {
            "id": "761310523",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Would that be alright with you?",
            "nextDialogs": [
              "761310524"
            ]
          },
          "761310524": {
            "id": "761310524",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "...No. If I can't get the key myself... I'll wait for you here.",
            "nextDialogs": [
              "761310525"
            ]
          },
          "761310525": {
            "id": "761310525",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "If you don't come back... I won't leave.",
            "nextDialogs": [
              "761310526"
            ]
          },
          "761310526": {
            "id": "761310526",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "I want to stay here... and wait for my friend to return...",
            "nextDialogs": [
              "761310527"
            ]
          },
          "761310527": {
            "id": "761310527",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "I understand. Thank you, Ninnin. I'll be right back.",
            "nextDialogs": [
              "761310528"
            ]
          },
          "761310528": {
            "id": "761310528",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll go with you, Columbina.",
            "nextDialogs": [
              "761310529"
            ]
          },
          "761310529": {
            "id": "761310529",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "If you insist.",
            "nextDialogs": [
              "761310530"
            ]
          },
          "761310530": {
            "id": "761310530",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "H—Hang on, what about Eggie? Are we really going to leave her here all alone?",
            "nextDialogs": [
              "761310531"
            ]
          },
          "761310531": {
            "id": "761310531",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Don't worry, I sent a message to Maagees, and she's on her way.",
            "nextDialogs": [
              "761310532"
            ]
          },
          "761310532": {
            "id": "761310532",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "As long as she stays here, there's nothing else in this base that can harm her.",
            "nextDialogs": [
              "761310533"
            ]
          },
          "761310533": {
            "id": "761310533",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon's still a little worried, though. Maybe she should just stay here and keep Eggie company?",
            "nextDialogs": [
              "761310534"
            ]
          },
          "761310534": {
            "id": "761310534",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Huh? Don't you want to see what the moon's core looks like?",
            "nextDialogs": [
              "761310535"
            ]
          },
          "761310535": {
            "id": "761310535",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah, but Eggie will get lonely here if we leave her all alone.",
            "nextDialogs": [
              "761310536"
            ]
          },
          "761310536": {
            "id": "761310536",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "She's also Lusalim's daughter, which is, well, something she only just found out.",
            "nextDialogs": [
              "761310537"
            ]
          },
          "761310537": {
            "id": "761310537",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "News like that always takes some time to digest. And it's not easy to handle — what if she starts to overthink things and runs off somewhere dangerous?",
            "nextDialogs": [
              "761310538"
            ]
          },
          "761310538": {
            "id": "761310538",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So, Paimon's gonna stay here with her and wait for Maagees.",
            "nextDialogs": [
              "761310539"
            ]
          },
          "761310539": {
            "id": "761310539",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Just make sure to come back and tell Paimon what you see, okay?",
            "nextDialogs": [
              "761310540"
            ]
          },
          "761310540": {
            "id": "761310540",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "Thank you, Paimon. My estimation of you has gone up once again.",
            "nextDialogs": [
              "761310541"
            ]
          },
          "761310541": {
            "id": "761310541",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "In that case, Paimon will increase your snack allowance by one share! Now it's three for you and seven for Paimon.",
            "nextDialogs": [
              "761310542"
            ]
          },
          "761310542": {
            "id": "761310542",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon, acting like a big sister... How quickly they grow.",
            "nextDialogs": [
              "761310543"
            ]
          },
          "761310543": {
            "id": "761310543",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Heh, why so surprised? Paimon did watch Eggie grow up, y'know!",
            "nextDialogs": [
              "761310544"
            ]
          },
          "761310544": {
            "id": "761310544",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Alright, go on, go on! The sooner you go, the sooner you'll be back. Don't make us wait too long!",
            "nextDialogs": [
              "761310545"
            ]
          },
          "761310545": {
            "id": "761310545",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "#Alright. {NICKNAME}, come with me."
          }
        }
      }
    },
    {
      "subId": "7613106",
      "subQuestName": "Activate the terminal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761310601"
        ],
        "dialogs": {
          "761310601": {
            "id": "761310601",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Great! Here's another terminal!",
            "nextDialogs": [
              "761310602"
            ]
          },
          "761310602": {
            "id": "761310602",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Your time to shine, Eggie!",
            "nextDialogs": [
              "761310603"
            ]
          },
          "761310603": {
            "id": "761310603",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "Terminal activated. Requesting base data.",
            "nextDialogs": [
              "761310604"
            ]
          },
          "761310604": {
            "id": "761310604",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "Base data acquired.",
            "nextDialogs": [
              "761310605"
            ]
          },
          "761310605": {
            "id": "761310605",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "Searching for Project Moongazer... No data.",
            "nextDialogs": [
              "761310606"
            ]
          },
          "761310606": {
            "id": "761310606",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "Searching for Lusalim... There we go!",
            "nextDialogs": [
              "761310607"
            ]
          },
          "761310607": {
            "id": "761310607",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "I've located Lusalim's research lab. It's inside this base.",
            "nextDialogs": [
              "761310608"
            ]
          },
          "761310608": {
            "id": "761310608",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Haha, jackpot! Let's hurry over and check it out!",
            "nextDialogs": [
              "761310609"
            ]
          },
          "761310609": {
            "id": "761310609",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "Reading the base's engineering schematics and routes... Hmm... We just need to keep going forward, and we'll get there.",
            "nextDialogs": [
              "761310610"
            ]
          },
          "761310610": {
            "id": "761310610",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is there any other intel?",
            "nextDialogs": [
              "761310611"
            ]
          },
          "761310611": {
            "id": "761310611",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "Retrieving other data... Huh? \"The Lord of Darkness Who Returned From the Sea of Stars\"?",
            "nextDialogs": [
              "761310612"
            ]
          },
          "761310612": {
            "id": "761310612",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Who's that?",
            "nextDialogs": [
              "761310613"
            ]
          },
          "761310613": {
            "id": "761310613",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "The data indicates that the existence of this base... stems from the will of this \"Lord of Darkness.\"",
            "nextDialogs": [
              "761310614"
            ]
          },
          "761310614": {
            "id": "761310614",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "Its construction also dates to a much later time than any of the other facilities we've visited. Its bottom-most levels lead to the moon's core, into which a fissure has been carved.",
            "nextDialogs": [
              "761310615"
            ]
          },
          "761310615": {
            "id": "761310615",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "An endless stream of ancient moon energy surges from the fissure — it's what powers this base.",
            "nextDialogs": [
              "761310616"
            ]
          },
          "761310616": {
            "id": "761310616",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "Its purpose was to turn the moon into... a space-based weapon!",
            "nextDialogs": [
              "761310617"
            ]
          },
          "761310617": {
            "id": "761310617",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "S—Space-based weapon? Wait, is this \"Lord of Darkness\"...",
            "nextDialogs": [
              "761310618"
            ]
          },
          "761310618": {
            "id": "761310618",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's probably the returning dragon king, Nibelung.",
            "nextDialogs": [
              "761310619"
            ]
          },
          "761310619": {
            "id": "761310619",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So the dragon king returned!? Wow, we must be pretty special to have stumbled into a place like this...",
            "nextDialogs": [
              "761310620"
            ]
          },
          "761310620": {
            "id": "761310620",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "First, the Heavenly Principles arrived, then the dragon king, and now us!",
            "nextDialogs": [
              "761310621"
            ]
          },
          "761310621": {
            "id": "761310621",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ad astra abyssosque, as they say.",
            "nextDialogs": [
              "761310622"
            ]
          },
          "761310622": {
            "id": "761310622",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "In that case, we're gonna have to be really careful how we proceed.",
            "nextDialogs": [
              "761310623"
            ]
          },
          "761310623": {
            "id": "761310623",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "If something goes wrong, Columbina, you gotta protect us, okay— Huh? Hang on. Where's Columbina?",
            "nextDialogs": [
              "761310624"
            ]
          },
          "761310624": {
            "id": "761310624",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "She's gone!",
            "nextDialogs": [
              "761310625"
            ]
          },
          "761310625": {
            "id": "761310625",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...When did that happen?",
            "nextDialogs": [
              "761310626"
            ]
          },
          "761310626": {
            "id": "761310626",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon didn't even notice her leaving... Eggie, did you see where Columbina went?",
            "nextDialogs": [
              "761310627"
            ]
          },
          "761310627": {
            "id": "761310627",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "No, I was extracting the data from the terminal...",
            "nextDialogs": [
              "761310628"
            ]
          },
          "761310628": {
            "id": "761310628",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "O—Oh no... The one person keeping us safe just disappeared! Is this place... haunted or something?",
            "nextDialogs": [
              "761310629"
            ]
          },
          "761310629": {
            "id": "761310629",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Columbina wouldn't leave without saying something. There must be some reason for this.)",
            "nextDialogs": [
              "761310630"
            ]
          },
          "761310630": {
            "id": "761310630",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Something related to Eggie, perhaps? No, she was reading the data on the terminal.)",
            "nextDialogs": [
              "761310631"
            ]
          },
          "761310631": {
            "id": "761310631",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Could it have been...?)",
            "nextDialogs": [
              "761310632"
            ]
          },
          "761310632": {
            "id": "761310632",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Also, now we're here, that strange sense of familiarity is only growing stronger...",
            "nextDialogs": [
              "761310633"
            ]
          },
          "761310633": {
            "id": "761310633",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Columbina's disappearance might have something to do with that sense of familiarity she mentioned. What exactly is hiding inside this base?)",
            "nextDialogs": [
              "761310634"
            ]
          },
          "761310634": {
            "id": "761310634",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What do we do now!?",
            "nextDialogs": [
              "761310636",
              "761310638"
            ]
          },
          "761310636": {
            "id": "761310636",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "Yes. That place must hold the secrets this base conceals. We might find some clues about Columbina's disappearance there.",
            "nextDialogs": [
              "761310641"
            ]
          },
          "761310641": {
            "id": "761310641",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "That said, our route requires us to pass through the security systems ahead — we can't afford to trigger a base-wide alarm.",
            "nextDialogs": [
              "761310642"
            ]
          },
          "761310642": {
            "id": "761310642",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Is there a way to disable the security somehow? Let Paimon see..."
          },
          "761310638": {
            "id": "761310638",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon can tell you're just joking to keep the mood light... Be brave, Paimon, be brave!",
            "nextDialogs": [
              "761310639"
            ]
          },
          "761310639": {
            "id": "761310639",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We're gonna find Columbina! We're not leaving her behind!",
            "nextDialogs": [
              "761310640"
            ]
          },
          "761310640": {
            "id": "761310640",
            "speakerId": 1002,
            "speakerName": "Eggie",
            "text": "We should head to Lusalim's lab. That place must hold the secrets this base conceals. We might find some clues about Columbina's disappearance there."
          }
        }
      }
    },

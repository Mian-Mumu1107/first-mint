    {
      "subId": "7450602",
      "subQuestName": "Talk to Lepine-Pauline",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745060201"
        ],
        "dialogs": {
          "745060201": {
            "id": "745060201",
            "speakerId": 30423,
            "speakerName": "Lepine-Pauline",
            "text": "Snappity-snap, printy-printy-printy... Stackity stack stack stack!",
            "nextDialogs": [
              "745060202"
            ]
          },
          "745060202": {
            "id": "745060202",
            "speakerId": 30423,
            "speakerName": "Lepine-Pauline",
            "text": "Whoa! Those two are kinda big deals!",
            "nextDialogs": [
              "745060203"
            ]
          },
          "745060203": {
            "id": "745060203",
            "speakerId": 30423,
            "speakerName": "Lepine-Pauline",
            "text": "Hey, you two! Can I take your picture?",
            "nextDialogs": [
              "745060204"
            ]
          },
          "745060204": {
            "id": "745060204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh...? Does she mean us? Why does she want our picture?",
            "nextDialogs": [
              "745060207"
            ]
          },
          "745060207": {
            "id": "745060207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehehe... Guess we'd better get used to the celebrity treatment, huh? Can't blame the fans for wanting a photo of their heroes!",
            "nextDialogs": [
              "745060208"
            ]
          },
          "745060208": {
            "id": "745060208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But if this is for anything besides your own personal use, then we're legally allowed to charge you... Wait, what would they call it here? An appearance fee? Photoshoot fee?",
            "nextDialogs": [
              "745060209"
            ]
          },
          "745060209": {
            "id": "745060209",
            "speakerId": 30423,
            "speakerName": "Lepine-Pauline",
            "text": "Absolutely! It's just an honor to be able to photograph the ace adventurer duo. How does one-and-a-half million Mora sound?",
            "nextDialogs": [
              "745060210"
            ]
          },
          "745060210": {
            "id": "745060210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sure, that sounds fine!",
            "nextDialogs": [
              "745060211"
            ]
          },
          "745060211": {
            "id": "745060211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Hold up, how much did you say again? One-and-a-half million!? Did Paimon hear that right?",
            "nextDialogs": [
              "745060212"
            ]
          },
          "745060212": {
            "id": "745060212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's a lot of Mora for just one photograph... Maybe a little too much? Are we really worth all that?"
          }
        }
      }
    }
  ]
}
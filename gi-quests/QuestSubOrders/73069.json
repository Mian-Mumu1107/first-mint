    {
      "subId": "7306912",
      "subQuestName": "Talk to Arama",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730691201"
        ],
        "dialogs": {
          "730691201": {
            "id": "730691201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is this... the Vasara Tree? Doesn't seem as lively as Paimon imagined...",
            "nextDialogs": [
              "730691202"
            ]
          },
          "730691202": {
            "id": "730691202",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Yes, the corrosion from Marana is getting worse. It's not only the land. Marana exists in the Sarva, too.",
            "nextDialogs": [
              "730691203"
            ]
          },
          "730691203": {
            "id": "730691203",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Marana will speak of the horrors of death to the trees and flowers it corrodes. Life that did not know of death will then begin to wither.",
            "nextDialogs": [
              "730691204"
            ]
          },
          "730691204": {
            "id": "730691204",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "We have been fighting against Marana. Araji was also fighting hard against it.",
            "nextDialogs": [
              "730691205"
            ]
          },
          "730691205": {
            "id": "730691205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Araji? Isn't that someone you mentioned? An Aranara who lived in the past?",
            "nextDialogs": [
              "730691206"
            ]
          },
          "730691206": {
            "id": "730691206",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#Yes. Thank you, Araji. We've never met before, but your song sounds great. Please, leave the rest to me, Nara {NICKNAME}, and Paimon.",
            "nextDialogs": [
              "730691207"
            ]
          },
          "730691207": {
            "id": "730691207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How can we get the Vasoma Fruit?",
            "nextDialogs": [
              "730691208"
            ]
          },
          "730691208": {
            "id": "730691208",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "First, we must enter his dream to destroy Marana's lingering influence.",
            "nextDialogs": [
              "730691209"
            ]
          },
          "730691209": {
            "id": "730691209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait a second... When you say \"his dream,\" you mean that of the Vasara Tree?",
            "nextDialogs": [
              "730691210"
            ]
          },
          "730691210": {
            "id": "730691210",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Yes. If you are ready, reach out your hand and enter his dream..."
          }
        }
      }
    },
    {
      "subId": "7306916",
      "subQuestName": "Talk to Arama and enter the Vasara Tree's dream",
      "sceneId": null,
      "locations": [],
      "dialogue": {

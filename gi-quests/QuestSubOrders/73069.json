    {
      "subId": "7306913",
      "subQuestName": "Explore the dream of the Vasara Tree",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730691301"
        ],
        "dialogs": {
          "730691301": {
            "id": "730691301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon didn't expect Marana's corruption to be here too...",
            "nextDialogs": [
              "730691302"
            ]
          },
          "730691302": {
            "id": "730691302",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#Nara {NICKNAME} is amazing. You drove Marana away easily this time, too.",
            "nextDialogs": [
              "730691303"
            ]
          },
          "730691303": {
            "id": "730691303",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "The corrosion from Marana is getting worse. It's not just infecting the land. It is here, and even in Sarva.",
            "nextDialogs": [
              "730691304"
            ]
          },
          "730691304": {
            "id": "730691304",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Marana will speak of the horrors of death to the trees and flowers it corrodes. Life that did not know of death will then begin to wither.",
            "nextDialogs": [
              "730691305"
            ]
          },
          "730691305": {
            "id": "730691305",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "We have been fighting against Marana. Araji was also fighting hard against it.",
            "nextDialogs": [
              "730691306"
            ]
          },
          "730691306": {
            "id": "730691306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Araji? Isn't that someone you mentioned? An Aranara who lived in the past?",
            "nextDialogs": [
              "730691307"
            ]
          },
          "730691307": {
            "id": "730691307",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#Yes. Thank you, Araji. We've never met before, but your song sounds great. Please, leave the rest to me, Nara {NICKNAME}, and Paimon.",
            "nextDialogs": [
              "730691308"
            ]
          },
          "730691308": {
            "id": "730691308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do we need to enter the dream of the Vasara Tree this time too?",
            "nextDialogs": [
              "730691309"
            ]
          },
          "730691309": {
            "id": "730691309",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Yes. We must erase all traces of Marana's influence.",
            "nextDialogs": [
              "730691310"
            ]
          },
          "730691310": {
            "id": "730691310",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "That's right. If you are ready, reach out your hand and enter his dream..."
          }
        }
      }
    },

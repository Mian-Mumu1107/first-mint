    {
      "subId": "7306905",
      "subQuestName": "Play the music according to the pattern of the roses",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730690501"
        ],
        "dialogs": {
          "730690501": {
            "id": "730690501",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Ooh... This is Araji's song...",
            "nextDialogs": [
              "730690502"
            ]
          },
          "730690502": {
            "id": "730690502",
            "speakerId": 20665,
            "speakerName": "Arayasa",
            "text": "Ahh... I was able to hear your song again. Our promise can finally be fulfilled. Araji, I will carry your song with me and keep on singing.",
            "nextDialogs": [
              "730690503"
            ]
          },
          "730690503": {
            "id": "730690503",
            "speakerId": 20665,
            "speakerName": "Arayasa",
            "text": "Thank you, good Nara. Arayasa will not forget.",
            "nextDialogs": [
              "730690504"
            ]
          },
          "730690504": {
            "id": "730690504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh. Somehow Arayasa's kinda speaking normally!",
            "nextDialogs": [
              "730690505"
            ]
          },
          "730690505": {
            "id": "730690505",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#Thank you, Nara {NICKNAME} and Paimon! Arayasa and Araji are good friends, so he's been looking for this song all this time.",
            "nextDialogs": [
              "730690506"
            ]
          },
          "730690506": {
            "id": "730690506",
            "speakerId": 20665,
            "speakerName": "Arayasa",
            "text": "Araji is a... timid friend who liked to hide in quiet places and sing softly. His songs can open unknown paths. Now that you understand this song...",
            "nextDialogs": [
              "730690507"
            ]
          },
          "730690507": {
            "id": "730690507",
            "speakerId": 20665,
            "speakerName": "Arayasa",
            "text": "You'll be able to open the path to Ashvattha's Concourse located here.",
            "nextDialogs": [
              "730690508"
            ]
          },
          "730690508": {
            "id": "730690508",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Yep! You can leave the rest to us!",
            "nextDialogs": [
              "730690509"
            ]
          },
          "730690509": {
            "id": "730690509",
            "speakerId": 20665,
            "speakerName": "Arayasa",
            "text": "#Okay, let's meet at Festival Utsava, {M#handsome}{F#beautiful} Nara."
          }
        }
      }
    },

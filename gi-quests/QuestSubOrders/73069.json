  "subQuests": [
    {
      "subId": "7306918",
      "subQuestName": "Head to the designated location to look for clues about Ashvattha's Concourses",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730691801"
        ],
        "dialogs": {
          "730691801": {
            "id": "730691801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So this is...",
            "nextDialogs": [
              "730691802"
            ]
          },
          "730691802": {
            "id": "730691802",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Yes. This is a Vasoma Fruit.",
            "nextDialogs": [
              "730691803"
            ]
          },
          "730691803": {
            "id": "730691803",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "It is the accumulation of the dreams and memories gathered by the Vasara Tree. It's a precious fruit that can help us restore our strength.",
            "nextDialogs": [
              "730691804"
            ]
          },
          "730691804": {
            "id": "730691804",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "A large amount of energy must be consumed for the Ashvattha Tree to produce a Bija. That is why we must offer Vasoma Fruits.",
            "nextDialogs": [
              "730691805"
            ]
          },
          "730691805": {
            "id": "730691805",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#Keep the Vasoma Fruit safe, Nara {NICKNAME}!",
            "nextDialogs": [
              "730691806"
            ]
          },
          "730691806": {
            "id": "730691806",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm. You know what? Let's teach Arama the meaning of \"treasure\"!",
            "nextDialogs": [
              "730691807"
            ]
          },
          "730691807": {
            "id": "730691807",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Now then! \"Treasure\" refers to something very precious. This Vasoma Fruit contains lots of dreams and memories, and it can restore an Aranara's power. That makes it pretty rare and amazing, right?",
            "nextDialogs": [
              "730691808"
            ]
          },
          "730691808": {
            "id": "730691808",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "For things like Vasoma Fruits that are rare and precious, we call them \"treasure\"!",
            "nextDialogs": [
              "730691809"
            ]
          },
          "730691809": {
            "id": "730691809",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Ah, so this is what treasure means... I got it! Thank you, Paimon!",
            "nextDialogs": [
              "730691811",
              "730691813"
            ]
          },
          "730691811": {
            "id": "730691811",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Araja said that we'll need more than one Vasoma Fruit. That means we need to find other Ashvattha's Concourses, right?",
            "nextDialogs": [
              "730691814"
            ]
          },
          "730691814": {
            "id": "730691814",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#That's right. I'll do my best to find them! So long, Nara {NICKNAME} and Paimon!",
            "nextDialogs": [
              "730691815"
            ]
          },
          "730691815": {
            "id": "730691815",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "See you later, Arama!"
          },
          "730691813": {
            "id": "730691813",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What are you thanking Paimon for...? Anyway, Araja said that we'll need more than one Vasoma Fruit. That means we need to find other Ashvattha's Concourses, right?"
          }
        }
      }
    },
    {
      "subId": "7306903",
      "subQuestName": "Talk to Arama",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730690301"
        ],
        "dialogs": {
          "730690301": {
            "id": "730690301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We meet again, Arama!",
            "nextDialogs": [
              "730690302"
            ]
          },
          "730690302": {
            "id": "730690302",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "#Ooh! Nara {NICKNAME} and Paimon! Hello!",
            "nextDialogs": [
              "730690303"
            ]
          },
          "730690303": {
            "id": "730690303",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Right, this is Arayasa. We met here when we were looking for Ashvattha's Concourses.",
            "nextDialogs": [
              "730690304"
            ]
          },
          "730690304": {
            "id": "730690304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hello, Arayasa!",
            "nextDialogs": [
              "730690305"
            ]
          },
          "730690305": {
            "id": "730690305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hello!",
            "nextDialogs": [
              "730690306"
            ]
          },
          "730690306": {
            "id": "730690306",
            "speakerId": 20665,
            "speakerName": "Arayasa",
            "text": "#\"The next song is a poem about a {M#young woman}{F#young man} in search of the thing most dear to {M#her}{F#him}. At the journey's beginning, {M#her}{F#his} eyes were amber, without a hint of gloom...\"",
            "nextDialogs": [
              "730690307"
            ]
          },
          "730690307": {
            "id": "730690307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...?",
            "nextDialogs": [
              "730690310"
            ]
          },
          "730690310": {
            "id": "730690310",
            "speakerId": 20646,
            "speakerName": "Arama",
            "text": "Yes. Arayasa is one of the \"song gatherers\" who collect songs of all kinds. He is the boldest of them all, and often learns Nara songs.",
            "nextDialogs": [
              "730690311"
            ]
          },
          "730690311": {
            "id": "730690311",
            "speakerId": 20665,
            "speakerName": "Arayasa",
            "text": "\"Our destinies were like pearls born in the same hour...\""
          }
        }
      }
    },

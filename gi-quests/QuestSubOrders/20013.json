      "subQuestName": "Defeat the nearby enemies",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200130201"
        ],
        "dialogs": {
          "200130201": {
            "id": "200130201",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "Traveler, it's you! Thank you so much.",
            "nextDialogs": [
              "200130202"
            ]
          },
          "200130202": {
            "id": "200130202",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "Can I ask you for a favor...?",
            "nextDialogs": [
              "200130203"
            ]
          },
          "200130203": {
            "id": "200130203",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "This roadblock here is the only thing getting between me and my adventure...",
            "nextDialogs": [
              "200130204"
            ]
          },
          "200130204": {
            "id": "200130204",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "Can you get rid of it for me?",
            "nextDialogs": [
              "200130207",
              "200130208"
            ]
          },
          "200130207": {
            "id": "200130207",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "*sigh* I wish I was more like you... I'd be a veteran Adventurer by now!"
          },
          "200130208": {
            "id": "200130208",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "Please, I'm begging you... I can't let this be where my adventure ends!"
          }
        }
      }
    },
    {
      "subId": "2001303",
      "subQuestName": "Defeat all opponents and destroy the roadblocks",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200130301"
        ],
        "dialogs": {
          "200130301": {
            "id": "200130301",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "Thank you so much, Traveler.",
            "nextDialogs": [
              "200130302"
            ]
          },
          "200130302": {
            "id": "200130302",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "I was on my way to check out somewhere Stanley once went on an adventure. Had I known they would show up...",
            "nextDialogs": [
              "200130303"
            ]
          },
          "200130303": {
            "id": "200130303",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "I'm just not strong enough... I know for a fact that Stanley would have had no problem dealing with a group like that.",
            "nextDialogs": [
              "200130304"
            ]
          },
          "200130304": {
            "id": "200130304",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "Why don't you join me? Join me! ...Ugh, never mind, I can't have someone else doing even my adventuring for me...",
            "nextDialogs": [
              "200130305"
            ]
          },
          "200130305": {
            "id": "200130305",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "I'm going to get moving. This is for you, I've gathered loads on the way to supplement my rations.",
            "nextDialogs": [
              "200130306"
            ]
          },
          "200130306": {
            "id": "200130306",
            "speakerId": 1000,
            "speakerName": "Jack",
            "text": "...Even though they're not exactly rations."
          }
        }
      }
    },

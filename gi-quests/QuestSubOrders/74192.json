  "subQuests": [
    {
      "subId": "7419201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741920101"
        ],
        "dialogs": {
          "741920101": {
            "id": "741920101",
            "speakerId": 21236,
            "speakerName": "Canotila",
            "text": "I see: The flames on the throne have been extinguished, and the burnt ashes have once again turned into trees.",
            "nextDialogs": [
              "741920102"
            ]
          },
          "741920102": {
            "id": "741920102",
            "speakerId": 21236,
            "speakerName": "Canotila",
            "text": "Flowers bloom with your every step, bringing change to an otherwise inevitable decay in the future.",
            "nextDialogs": [
              "741920103"
            ]
          },
          "741920103": {
            "id": "741920103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Canotila?",
            "nextDialogs": [
              "741920104"
            ]
          },
          "741920104": {
            "id": "741920104",
            "speakerId": 21236,
            "speakerName": "Canotila",
            "text": "#Huh? It's {M#Mr.}{F#Ms.} {NICKNAME}! What brings you here?",
            "nextDialogs": [
              "741920105"
            ]
          },
          "741920105": {
            "id": "741920105",
            "speakerId": 21236,
            "speakerName": "Canotila",
            "text": "Um, right! The golden butterfly has returned. I need to go and see it! Goodbye!"
          }
        }
      }
    },
    {
      "subId": "7419202",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741920201"
        ],
        "dialogs": {
          "741920201": {
            "id": "741920201",
            "speakerId": 21237,
            "speakerName": "Canotila",
            "text": "*sob*",
            "nextDialogs": [
              "741920202"
            ]
          },
          "741920202": {
            "id": "741920202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Canotila...",
            "nextDialogs": [
              "741920203"
            ]
          },
          "741920203": {
            "id": "741920203",
            "speakerId": 21237,
            "speakerName": "Canotila",
            "text": "#Huh? {M#Mr.}{F#Ms.} {NICKNAME}... Who are you? I thought no one could get in here besides me.",
            "nextDialogs": [
              "741920204"
            ]
          },
          "741920204": {
            "id": "741920204",
            "speakerId": 21237,
            "speakerName": "Canotila",
            "text": "Wait, how do you know my name?",
            "nextDialogs": [
              "741920206",
              "741920208"
            ]
          },
          "741920206": {
            "id": "741920206",
            "speakerId": 21237,
            "speakerName": "Canotila",
            "text": "Liar! You must be just like those monsters..."
          },
          "741920208": {
            "id": "741920208",
            "speakerId": 21237,
            "speakerName": "Canotila",
            "text": "Oh... Always making her worry like this, I'm such a bad child...",
            "nextDialogs": [
              "741920209"
            ]
          },
          "741920209": {
            "id": "741920209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#I'm {NICKNAME}. Do you still remember me?",
            "nextDialogs": [
              "741920210"
            ]
          },
          "741920210": {
            "id": "741920210",
            "speakerId": 21237,
            "speakerName": "Canotila",
            "text": "#Right, {M#Mr.}{F#Ms.} {NICKNAME}... I remember now... Even though you're a giant monster who could swallow the world in one gulp, you are very kind."
          }
        }
      }
    },
    {
      "subId": "7419203",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741920301"
        ],
        "dialogs": {
          "741920301": {
            "id": "741920301",
            "speakerId": 21348,
            "speakerName": "Canotila",
            "text": "Since memories can be made into a book, if we reverse that logic, the contents of the book can also be written directly into memories...",
            "nextDialogs": [
              "741920302"
            ]
          },
          "741920302": {
            "id": "741920302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Canotila?",
            "nextDialogs": [
              "741920303"
            ]
          },
          "741920303": {
            "id": "741920303",
            "speakerId": 21348,
            "speakerName": "Canotila",
            "text": "#Ah, it's you, the strange {M#Mr.}{F#Ms.} {NICKNAME}. What is it? Do you need something from me?",
            "nextDialogs": [
              "741920304"
            ]
          },
          "741920304": {
            "id": "741920304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What were you talking about...",
            "nextDialogs": [
              "741920305"
            ]
          },
          "741920305": {
            "id": "741920305",
            "speakerId": 21348,
            "speakerName": "Canotila",
            "text": "Hmm. No matter how I think about this, converting memories into a book is quite an incredible deed...",
            "nextDialogs": [
              "741920306"
            ]
          },
          "741920306": {
            "id": "741920306",
            "speakerId": 21348,
            "speakerName": "Canotila",
            "text": "The creator of this book must've only been able to do this because they viewed the emotions in their memo{RUBY#[D]delusions}ries as the most precious thing in the world.",
            "nextDialogs": [
              "741920307"
            ]
          },
          "741920307": {
            "id": "741920307",
            "speakerId": 21348,
            "speakerName": "Canotila",
            "text": "That doesn't change how difficult it is to read, though...",
            "nextDialogs": [
              "741920308"
            ]
          },
          "741920308": {
            "id": "741920308",
            "speakerId": 21348,
            "speakerName": "Canotila",
            "text": "...And I'm not sure what kind of impact it will have on its readers. This is quite..."
          }
        }
      }
    },
    {
      "subId": "7419204",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741920401"
        ],
        "dialogs": {
          "741920401": {
            "id": "741920401",
            "speakerId": 21349,
            "speakerName": "Canotila",
            "text": "...",
            "nextDialogs": [
              "741920402"
            ]
          },
          "741920402": {
            "id": "741920402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Canotila?",
            "nextDialogs": [
              "741920403"
            ]
          },
          "741920403": {
            "id": "741920403",
            "speakerId": 21349,
            "speakerName": "Canotila",
            "text": "Huh? You're finally back! Don't disappear like that, don't you know how worrying it is? Just imagine what would happen if you never returned...",
            "nextDialogs": [
              "741920404"
            ]
          },
          "741920404": {
            "id": "741920404",
            "speakerId": 21349,
            "speakerName": "Canotila",
            "text": "Do you have any idea how long you were inside? It felt like the waiting would never end... Even the other Melusines had no idea how to help!",
            "nextDialogs": [
              "741920405"
            ]
          },
          "741920405": {
            "id": "741920405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(It seems like I've been here for quite a while, then.)",
            "nextDialogs": [
              "741920406"
            ]
          },
          "741920406": {
            "id": "741920406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, I've got to go.",
            "nextDialogs": [
              "741920407"
            ]
          },
          "741920407": {
            "id": "741920407",
            "speakerId": 21349,
            "speakerName": "Canotila",
            "text": "#What? {NICKNAME}, where are you going...",
            "nextDialogs": [
              "741920408"
            ]
          },
          "741920408": {
            "id": "741920408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry. I'll come back once I find you, Canotila.",
            "nextDialogs": [
              "741920409"
            ]
          },
          "741920409": {
            "id": "741920409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just wait for me a little longer, okay?",
            "nextDialogs": [
              "741920410"
            ]
          },
          "741920410": {
            "id": "741920410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I know that saying this to you won't change much.",
            "nextDialogs": [
              "741920413"
            ]
          },
          "741920413": {
            "id": "741920413",
            "speakerId": 21349,
            "speakerName": "Canotila",
            "text": "#{NICKNAME}..."
          }
        }
      }
    }
  ]
}
    },
    {
      "subId": "4114101",
      "subQuestName": "Talk to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411410101"
        ],
        "dialogs": {
          "411410101": {
            "id": "411410101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, I'm heading off.",
            "nextDialogs": [
              "411410102"
            ]
          },
          "411410102": {
            "id": "411410102",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Aye, best be about it.",
            "nextDialogs": [
              "411410103"
            ]
          },
          "411410103": {
            "id": "411410103",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Make sure you <color=#00E1FFFF>avoid monsters at all costs. If you get any weird elements on your person or take a hard knock, that food's toast</color>.",
            "nextDialogs": [
              "411410104"
            ]
          },
          "411410104": {
            "id": "411410104",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Needless to say, if the food's ruined, the customer isn't taking it.",
            "nextDialogs": [
              "411410105"
            ]
          },
          "411410105": {
            "id": "411410105",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "Alright, then, run along. Don't keep the customer waiting, now."
          }
        }
      }
    },
    {
      "subId": "4114102",
      "subQuestName": "Deliver the food to Laid Back Ling'guan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411410201"
        ],
        "dialogs": {
          "411410201": {
            "id": "411410201",
            "speakerId": 30027,
            "speakerName": "Laid Back Ling'guan",
            "text": "I've been strolling around here for so long. I wonder why my meal hasn't arrived yet..."
          }
        }
      }
    },
    {
      "subId": "4114103",
      "subQuestName": "Talk to Laid Back Ling'guan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411410601"
        ],
        "dialogs": {
          "411410601": {
            "id": "411410601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's the dish you ordered.",
            "nextDialogs": [
              "411410602"
            ]
          },
          "411410602": {
            "id": "411410602",
            "speakerId": 30027,
            "speakerName": "Laid Back Ling'guan",
            "text": "Well, better late than never... Mm, this Almond Tofu looks great.",
            "nextDialogs": [
              "411410603"
            ]
          },
          "411410603": {
            "id": "411410603",
            "speakerId": 30027,
            "speakerName": "Laid Back Ling'guan",
            "text": "Thanks a lot! Hehe... after all that walking, it's great to finally have something to eat."
          }
        }
      }
    },
    {
      "subId": "4114103",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411410301"
        ],
        "dialogs": {
          "411410301": {
            "id": "411410301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I heard that someone placed a custom order...",
            "nextDialogs": [
              "411410302"
            ]
          },
          "411410302": {
            "id": "411410302",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "That they did, alright. There's a guest lodging here named Ling'guan. She ordered a serving of Almond Tofu a while earlier and, after paying, wanted me to deliver it to someplace north of Dihua Marsh.",
            "nextDialogs": [
              "411410303"
            ]
          },
          "411410303": {
            "id": "411410303",
            "speakerId": 2204,
            "speakerName": "Smiley Yanxiao",
            "text": "But we've been really busy here at the inn, and I haven't the time to go out and deliver the food myself. If you could help me out, that would be great. I'll be sure to compensate you fairly."
          }
        }
      }
    },

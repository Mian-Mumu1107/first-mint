  },
  "subQuests": [
    {
      "subId": "7603101",
      "subQuestName": "Meet The Damselette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760310401"
        ],
        "dialogs": {
          "760310401": {
            "id": "760310401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Hmm? What are you looking at, {NICKNAME}?",
            "nextDialogs": [
              "760310402"
            ]
          },
          "760310402": {
            "id": "760310402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is that a... Chic Badger?",
            "nextDialogs": [
              "760310403"
            ]
          },
          "760310403": {
            "id": "760310403",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh, what's he doing here all alone? Is he looking for The Damselette?",
            "nextDialogs": [
              "760310404"
            ]
          },
          "760310404": {
            "id": "760310404",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It kinda seems like something scared him. C'mon, let's bring him inside with us."
          }
        }
      }
    },
    {
      "subId": "7603106",
      "subQuestName": "Enter the Silvermoon Hall",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760310101"
        ],
        "dialogs": {
          "760310101": {
            "id": "760310101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Columbina?",
            "nextDialogs": [
              "760310102"
            ]
          },
          "760310102": {
            "id": "760310102",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Zzz... Zzz...",
            "nextDialogs": [
              "760310103"
            ]
          },
          "760310103": {
            "id": "760310103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, she seems to be taking an afternoon nap. Guess we'll come back later.",
            "nextDialogs": [
              "760310104"
            ]
          },
          "760310104": {
            "id": "760310104",
            "speakerId": 1002,
            "speakerName": "Chic Badger",
            "text": "...!",
            "nextDialogs": [
              "760310105"
            ]
          },
          "760310105": {
            "id": "760310105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "No, wait! Don't go over there—",
            "nextDialogs": [
              "760310106"
            ]
          },
          "760310106": {
            "id": "760310106",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "...Mmph!",
            "nextDialogs": [
              "760310107"
            ]
          },
          "760310107": {
            "id": "760310107",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Ouch...",
            "nextDialogs": [
              "760310108"
            ]
          },
          "760310108": {
            "id": "760310108",
            "speakerId": 1002,
            "speakerName": "Chic Badger",
            "text": "...",
            "nextDialogs": [
              "760310109"
            ]
          },
          "760310109": {
            "id": "760310109",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Ah, you slipped? Don't worry, I'm not hurt. Hm? Oh, you two are here as well.",
            "nextDialogs": [
              "760310110"
            ]
          },
          "760310110": {
            "id": "760310110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Guess a Moon Goddess isn't immune to a few bumps and bruises...",
            "nextDialogs": [
              "760310111"
            ]
          },
          "760310111": {
            "id": "760310111",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "I don't mind little critters bumping into me, so long as the kuuvahki emanating from them reflects no ill-intent.",
            "nextDialogs": [
              "760310112"
            ]
          },
          "760310112": {
            "id": "760310112",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Did something happen? Why are you so afraid, little one?",
            "nextDialogs": [
              "760310113"
            ]
          },
          "760310113": {
            "id": "760310113",
            "speakerId": 1002,
            "speakerName": "Chic Badger",
            "text": "...",
            "nextDialogs": [
              "760310114"
            ]
          },
          "760310114": {
            "id": "760310114",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Hm, I see.",
            "nextDialogs": [
              "760310115"
            ]
          },
          "760310115": {
            "id": "760310115",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ooh, so you can understand these animals too?",
            "nextDialogs": [
              "760310116"
            ]
          },
          "760310116": {
            "id": "760310116",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "The moon shines high over Nod-Krai. All animals that grow beneath the light of kuuvahki can be considered \"familiars of the Moon Goddess.\"",
            "nextDialogs": [
              "760310117"
            ]
          },
          "760310117": {
            "id": "760310117",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So, what did this little guy say?",
            "nextDialogs": [
              "760310118"
            ]
          },
          "760310118": {
            "id": "760310118",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "That monsters have appeared where he lives. He was looking for Lauma, but the monsters chased him to this area...",
            "nextDialogs": [
              "760310119"
            ]
          },
          "760310119": {
            "id": "760310119",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ohh... No wonder he's so scared...",
            "nextDialogs": [
              "760310120"
            ]
          },
          "760310120": {
            "id": "760310120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Where should we take him?",
            "nextDialogs": [
              "760310121"
            ]
          },
          "760310121": {
            "id": "760310121",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Back to Lauma, I think. She will know how to handle this.",
            "nextDialogs": [
              "760310122"
            ]
          },
          "760310122": {
            "id": "760310122",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Alright, looks like it's another trip out for us. Since we're heading to the Frostmoon Scions, make sure you hide extra good this time!"
          }
        }
      }
    },
    {
      "subId": "7603102",
      "subQuestName": "Meet Lauma",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760310201"
        ],
        "dialogs": {
          "760310201": {
            "id": "760310201",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "...Good idea. I'll ask Kunegunda to bring more fruit over later. She will need rest over the next two days.",
            "nextDialogs": [
              "760310202"
            ]
          },
          "760310202": {
            "id": "760310202",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh, looks like Lauma's busy right now. Let's give her a moment.",
            "nextDialogs": [
              "760310203"
            ]
          },
          "760310203": {
            "id": "760310203",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "I realized, many years ago, that the Moonchanter is a figure of great importance to the Frostmoon Scions.",
            "nextDialogs": [
              "760310204"
            ]
          },
          "760310204": {
            "id": "760310204",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Sometimes, I think their task is even harder than that of a god.",
            "nextDialogs": [
              "760310205"
            ]
          },
          "760310205": {
            "id": "760310205",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Finally! She's got some free time. Let's—",
            "nextDialogs": [
              "760310206"
            ]
          },
          "760310206": {
            "id": "760310206",
            "speakerId": 1004,
            "speakerName": "Vanamo",
            "text": "My lady, some of the defensive structures over here require your attention.",
            "nextDialogs": [
              "760310207"
            ]
          },
          "760310207": {
            "id": "760310207",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "Of course. I'll see to that right away.",
            "nextDialogs": [
              "760310208"
            ]
          },
          "760310208": {
            "id": "760310208",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And off she goes again! She never gets a moment's rest, does she?",
            "nextDialogs": [
              "760310209"
            ]
          },
          "760310209": {
            "id": "760310209",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "C'mon, let's follow them. But, keep it quiet!"
          }
        }
      }
    },
    {
      "subId": "7603103",
      "subQuestName": "Follow Lauma",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760310301"
        ],
        "dialogs": {
          "760310301": {
            "id": "760310301",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "...This will do. Thank you.",
            "nextDialogs": [
              "760310302"
            ]
          },
          "760310302": {
            "id": "760310302",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "Come night or day, may the moonlight connect us.",
            "nextDialogs": [
              "760310303"
            ]
          },
          "760310303": {
            "id": "760310303",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "...Hmm? That saying has changed from when I last heard it.",
            "nextDialogs": [
              "760310304"
            ]
          },
          "760310304": {
            "id": "760310304",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey! That person left. C'mon, now's our chance!",
            "nextDialogs": [
              "760310305"
            ]
          },
          "760310305": {
            "id": "760310305",
            "speakerId": 1005,
            "speakerName": "Maciej",
            "text": "Lady Lauma!",
            "nextDialogs": [
              "760310306"
            ]
          },
          "760310306": {
            "id": "760310306",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Seriously!?",
            "nextDialogs": [
              "760310307"
            ]
          },
          "760310307": {
            "id": "760310307",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "...",
            "nextDialogs": [
              "760310308"
            ]
          },
          "760310308": {
            "id": "760310308",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "...Thank you for your hard work. Excuse me for a moment. I will be back shortly.",
            "nextDialogs": [
              "760310309"
            ]
          },
          "760310309": {
            "id": "760310309",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "...",
            "nextDialogs": [
              "760310310"
            ]
          },
          "760310310": {
            "id": "760310310",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "There is no one around. You can come out now.",
            "nextDialogs": [
              "760310311"
            ]
          },
          "760310311": {
            "id": "760310311",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, you knew we were here!?",
            "nextDialogs": [
              "760310312"
            ]
          },
          "760310312": {
            "id": "760310312",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "How could I possibly miss the \"Kuu{RUBY#[S]Moon Maiden}tar\" and her kuuvahki?",
            "nextDialogs": [
              "760310313"
            ]
          },
          "760310313": {
            "id": "760310313",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "Although... I'm not quite sure why you're following me. It's quite unnerving... being \"observed\" at work like this...",
            "nextDialogs": [
              "760310314"
            ]
          },
          "760310314": {
            "id": "760310314",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, um... S—Sorry about that. We wanted to ask you about something, but the time was never right... Hopefully, we didn't stress you out too much...",
            "nextDialogs": [
              "760310315"
            ]
          },
          "760310315": {
            "id": "760310315",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "Ah, I see... Understood. I'll handle it.",
            "nextDialogs": [
              "760310316"
            ]
          },
          "760310316": {
            "id": "760310316",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "To be honest, after seeing how busy you are, Paimon kinda feels bad asking you to do more work...",
            "nextDialogs": [
              "760310317"
            ]
          },
          "760310317": {
            "id": "760310317",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "Ah, it's nothing. Such is the duty of the Moonchanter.",
            "nextDialogs": [
              "760310318"
            ]
          },
          "760310318": {
            "id": "760310318",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "...",
            "nextDialogs": [
              "760310319"
            ]
          },
          "760310319": {
            "id": "760310319",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "...Hm?",
            "nextDialogs": [
              "760310320"
            ]
          },
          "760310320": {
            "id": "760310320",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "...Now that you have seen all this, \"Kuu{RUBY#[S]Moon Maiden}tar\", what do you think of the Frostmoon Scions today?",
            "nextDialogs": [
              "760310321"
            ]
          },
          "760310321": {
            "id": "760310321",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "760310322"
            ]
          },
          "760310322": {
            "id": "760310322",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "The atmosphere is much changed from how it was several centuries ago. It's a good kind of change.",
            "nextDialogs": [
              "760310323"
            ]
          },
          "760310323": {
            "id": "760310323",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "I'm glad to hear it... And I thank you for your kind words.",
            "nextDialogs": [
              "760310324"
            ]
          },
          "760310324": {
            "id": "760310324",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Give me your hand.",
            "nextDialogs": [
              "760310325"
            ]
          },
          "760310325": {
            "id": "760310325",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "#You too, {NICKNAME}.",
            "nextDialogs": [
              "760310326"
            ]
          },
          "760310326": {
            "id": "760310326",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "...Oh, um... Why?",
            "nextDialogs": [
              "760310327"
            ]
          },
          "760310327": {
            "id": "760310327",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "I like the current prayer you use around here.",
            "nextDialogs": [
              "760310328"
            ]
          },
          "760310328": {
            "id": "760310328",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "...Come night or day, may the moonlight connect us."
          }
        }
      }
    },

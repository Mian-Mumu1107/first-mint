{
  "lineCounts": {
    "Sabbah": 11
  },
  "subQuests": [
    {
      "subId": "7329002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732900201"
        ],
        "dialogs": {
          "732900201": {
            "id": "732900201",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "How I miss this sight... Here, your presents are ready too. Please, take them.",
            "nextDialogs": [
              "732900202"
            ]
          },
          "732900202": {
            "id": "732900202",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "They're all seeds of plants that won't grow here. If you have a yard somewhere else, you can watch them mature there.",
            "nextDialogs": [
              "732900203"
            ]
          },
          "732900203": {
            "id": "732900203",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Ah, I just rambled for a long time... But it feels good.",
            "nextDialogs": [
              "732900204"
            ]
          },
          "732900204": {
            "id": "732900204",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Before you got here, I really didn't have many friends, and it could get pretty lonely.",
            "nextDialogs": [
              "732900207"
            ]
          },
          "732900207": {
            "id": "732900207",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "Very few people in the village are into gardening.",
            "nextDialogs": [
              "732900208"
            ]
          },
          "732900208": {
            "id": "732900208",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "...Well, that's not entirely true. An old man living to the north of the village also plowed a plot to grow flowers.",
            "nextDialogs": [
              "732900209"
            ]
          },
          "732900209": {
            "id": "732900209",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I've visited him before. He's a slightly eccentric old man.",
            "nextDialogs": [
              "732900210"
            ]
          },
          "732900210": {
            "id": "732900210",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "I saw him planting stones, but he insisted that they were flowers, and even kicked me out.",
            "nextDialogs": [
              "732900211"
            ]
          },
          "732900211": {
            "id": "732900211",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "It must be lonely, living all by himself. I can understand that.",
            "nextDialogs": [
              "732900212"
            ]
          },
          "732900212": {
            "id": "732900212",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "You helped me with my Sumeru Roses... Maybe you can help him with his plants too.",
            "nextDialogs": [
              "732900213"
            ]
          },
          "732900213": {
            "id": "732900213",
            "speakerId": 4232,
            "speakerName": "Sabbah",
            "text": "You and Paimon should visit him if you get a chance."
          }
        }
      }
    }
  ]
}
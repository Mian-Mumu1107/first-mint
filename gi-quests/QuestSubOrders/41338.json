  "subQuests": [
    {
      "subId": "4133801",
      "subQuestName": "Talk to Tiantian",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413380101"
        ],
        "dialogs": {
          "413380101": {
            "id": "413380101",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "Hmm... Why didn't anyone come...",
            "nextDialogs": [
              "413380102"
            ]
          },
          "413380102": {
            "id": "413380102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is something the matter?",
            "nextDialogs": [
              "413380103"
            ]
          },
          "413380103": {
            "id": "413380103",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "Traveler! Could... could you hear me out? So it's the Lantern Rite right now, and the Guild was looking to hitch a ride on the festive cheer to do some advertising — to see if we could snag some new recruits.",
            "nextDialogs": [
              "413380104"
            ]
          },
          "413380104": {
            "id": "413380104",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "I hear that Brother Qian's come up with a game called... called a somethingy-screen. I don't wanna be left out!",
            "nextDialogs": [
              "413380105"
            ]
          },
          "413380105": {
            "id": "413380105",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "So I thought up a new activity. I call it... \"My First Adventure.\"",
            "nextDialogs": [
              "413380106"
            ]
          },
          "413380106": {
            "id": "413380106",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "Simply put, I wanted to use some Xiao Lanterns to mark out a gliding track.",
            "nextDialogs": [
              "413380107"
            ]
          },
          "413380107": {
            "id": "413380107",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "Then, anyone who wants to take part in this activity can just open up their wind glider and follow the Xiao Lanterns as they fly...",
            "nextDialogs": [
              "413380108"
            ]
          },
          "413380108": {
            "id": "413380108",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "You'd get to feel the thrill of adventure and take in the beautiful sights of Liyue, with Xiao Lanterns at your side the whole way! Sounds good, right?",
            "nextDialogs": [
              "413380109"
            ]
          },
          "413380109": {
            "id": "413380109",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "I'd originally designed two tracks, but when I went to notify the Millelith, they said that I needed to find a test flier who could evaluate them from a safety perspective first.",
            "nextDialogs": [
              "413380110"
            ]
          },
          "413380110": {
            "id": "413380110",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "You must have a lot of adventuring experience, right? Would you mind doing the evaluation for me?",
            "nextDialogs": [
              "413380111"
            ]
          },
          "413380111": {
            "id": "413380111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's have at it.",
            "nextDialogs": [
              "413380112"
            ]
          },
          "413380112": {
            "id": "413380112",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "Thanks so much for your help! Let's go to Mt. Tianheng, then. That's where the first track starts."
          }
        }
      }
    },
    {
      "subId": "4133802",
      "subQuestName": "Go to Mt. Tianheng to look for Tiantian",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413380203"
        ],
        "dialogs": {
          "413380203": {
            "id": "413380203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's showtime."
          }
        }
      }
    },
    {
      "subId": "4133803",
      "subQuestName": "Collect the Xiao Lanterns",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413380301"
        ],
        "dialogs": {
          "413380301": {
            "id": "413380301",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "This is the finish line. You're pretty good at this, aren't you... So, how did you find it?",
            "nextDialogs": [
              "413380304"
            ]
          },
          "413380304": {
            "id": "413380304",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "Hehe, of course! I put them there myself, you know.",
            "nextDialogs": [
              "413380305"
            ]
          },
          "413380305": {
            "id": "413380305",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "Well then, let's go to the next track, shall we?"
          }
        }
      }
    },
    {
      "subId": "4133804",
      "subQuestName": "Collect the Xiao Lanterns",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413380401"
        ],
        "dialogs": {
          "413380401": {
            "id": "413380401",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "Alright! This is where the track begins. Once again, the Xiao Lanterns are all in place.",
            "nextDialogs": [
              "413380402"
            ]
          },
          "413380402": {
            "id": "413380402",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "You can begin as soon as you're ready. Same deal as before, collect the lanterns as you head for the objective."
          }
        }
      }
    },
    {
      "subId": "4133805",
      "subQuestName": "Collect the Xiao Lanterns",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413380501"
        ],
        "dialogs": {
          "413380501": {
            "id": "413380501",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "So, now that you've tested both tracks out, what's your overall impression?",
            "nextDialogs": [
              "413380502"
            ]
          },
          "413380502": {
            "id": "413380502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They're not bad.",
            "nextDialogs": [
              "413380503"
            ]
          },
          "413380503": {
            "id": "413380503",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "Great! Guess I can report back to the Millelith now.",
            "nextDialogs": [
              "413380504"
            ]
          },
          "413380504": {
            "id": "413380504",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "I'm sure that a fun activity like this will attract lots of people to join the Guild.",
            "nextDialogs": [
              "413380505"
            ]
          },
          "413380505": {
            "id": "413380505",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "Ah, yes. Here's your remuneration for helping me evaluate those tracks. Please, take it."
          }
        }
      }
    },

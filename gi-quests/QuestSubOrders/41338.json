    {
      "subId": "4133802",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413380201"
        ],
        "dialogs": {
          "413380201": {
            "id": "413380201",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "This is where the track begins. See? The Xiao Lanterns are all in position.",
            "nextDialogs": [
              "413380202"
            ]
          },
          "413380202": {
            "id": "413380202",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "Alright then — you can begin whenever you're ready. Collect the Xiao Lanterns en route to your objective.",
            "nextDialogs": [
              "413380204"
            ]
          },
          "413380204": {
            "id": "413380204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let me get warmed up first...",
            "nextDialogs": [
              "413380205"
            ]
          },
          "413380205": {
            "id": "413380205",
            "speakerId": 1000,
            "speakerName": "Tiantian",
            "text": "Sure, just let me know once you're ready."
          }
        }
      }
    },
    {

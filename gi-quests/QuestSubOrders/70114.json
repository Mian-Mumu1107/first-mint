          "701140201"
        ],
        "dialogs": {
          "701140201": {
            "id": "701140201",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "Thank you for treating me, Miss Sandrone.",
            "nextDialogs": [
              "701140204"
            ]
          },
          "701140204": {
            "id": "701140204",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "Alright. Until we meet again."
          }
        }
      }
    },

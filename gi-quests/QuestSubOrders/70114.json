  "subQuests": [
    {
      "subId": "7011401",
      "subQuestName": "Head near Albedo's campsite in Dragonspine to begin the tea party",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701140101"
        ],
        "dialogs": {
          "701140101": {
            "id": "701140101",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "It's a rare occasion indeed when Miss Sandrone finds the time to visit Mondstadt.",
            "nextDialogs": [
              "701140102"
            ]
          },
          "701140102": {
            "id": "701140102",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "You provided such invaluable help when I was researching the numerological array. I wanted to thank you in person.",
            "nextDialogs": [
              "701140103"
            ]
          },
          "701140103": {
            "id": "701140103",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "You're too kind. But such things lie well outside my area of expertise. The credit for completing it should really be all yours.",
            "nextDialogs": [
              "701140104"
            ]
          },
          "701140104": {
            "id": "701140104",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "It was a team effort. Hmm... Come to think of it, where's Durin? Seeing as you're practically his guardian, I thought he would be unable to stray too far from your side.",
            "nextDialogs": [
              "701140105"
            ]
          },
          "701140105": {
            "id": "701140105",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "You're not entirely wrong.",
            "nextDialogs": [
              "701140106"
            ]
          },
          "701140106": {
            "id": "701140106",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "But recently, he's been making headway with his social skills, so I've been trying to encourage him to be a bit more independent.",
            "nextDialogs": [
              "701140107"
            ]
          },
          "701140107": {
            "id": "701140107",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "Aren't you worried about him?",
            "nextDialogs": [
              "701140108"
            ]
          },
          "701140108": {
            "id": "701140108",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "A little. In the past, if he was on his own and interacting with someone whose personality was... let's say \"strong,\" he tended to...",
            "nextDialogs": [
              "701140109"
            ]
          },
          "701140109": {
            "id": "701140109",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "Pick up bizarre habits? Mimic unusual verbal tics?",
            "nextDialogs": [
              "701140110"
            ]
          },
          "701140110": {
            "id": "701140110",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "Precisely. I take it you've experienced something similar, Miss Sandrone?",
            "nextDialogs": [
              "701140111"
            ]
          },
          "701140111": {
            "id": "701140111",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "Hmph, do you even need to ask? I'm practically an expert...",
            "nextDialogs": [
              "701140112"
            ]
          },
          "701140112": {
            "id": "701140112",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "Typically, after a meeting with Grand Master Varka, I'll take Durin to visit Sucrose and help with her research. It allows him to find his focus.",
            "nextDialogs": [
              "701140113"
            ]
          },
          "701140113": {
            "id": "701140113",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "But if he's spent too long with Acting Grand Master Jean, we'll pay a visit to Klee so he can rediscover how to relax.",
            "nextDialogs": [
              "701140114"
            ]
          },
          "701140114": {
            "id": "701140114",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "Sounds like a lot of work...",
            "nextDialogs": [
              "701140115"
            ]
          },
          "701140115": {
            "id": "701140115",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "Just looking after my family.",
            "nextDialogs": [
              "701140116"
            ]
          },
          "701140116": {
            "id": "701140116",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "How would you handle such situations?",
            "nextDialogs": [
              "701140117"
            ]
          },
          "701140117": {
            "id": "701140117",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "Me? I don't have the energy for that sort of mess...",
            "nextDialogs": [
              "701140118"
            ]
          },
          "701140118": {
            "id": "701140118",
            "speakerId": 1001,
            "speakerName": "Marionette",
            "text": "But it seems to me that if someone's good by nature, no matter how much they're influenced, they'll always return to their true self.",
            "nextDialogs": [
              "701140119"
            ]
          },
          "701140119": {
            "id": "701140119",
            "speakerId": 1000,
            "speakerName": "Albedo",
            "text": "Hmm... An excellent observation. Perhaps I can adopt this way of thinking."
          }
        }
      }
    },
    {
      "subId": "7011402",
      "subQuestName": "Head near Albedo's campsite in Dragonspine to begin the tea party",
      "sceneId": null,
      "locations": [],
      "dialogue": {

  "subQuests": [
    {
      "subId": "7471601",
      "subQuestName": "Talk to Freminet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747160101"
        ],
        "dialogs": {
          "747160101": {
            "id": "747160101",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Fantastic... That's pretty much all of the major junk retrieved.",
            "nextDialogs": [
              "747160102"
            ]
          },
          "747160102": {
            "id": "747160102",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "I'm sorry you've had to work so hard, you two.",
            "nextDialogs": [
              "747160103"
            ]
          },
          "747160103": {
            "id": "747160103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Don't feel like you have to apologize, Freminet! The way Paimon sees it, we haven't been \"working\" — we've been fishing up goodies!",
            "nextDialogs": [
              "747160106"
            ]
          },
          "747160106": {
            "id": "747160106",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Thank you... I've had such a happy and fulfilling time, and it's all thanks to you.",
            "nextDialogs": [
              "747160107"
            ]
          },
          "747160107": {
            "id": "747160107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You're welcome! Besides, it was a team effort! Aaaand, Paimon thinks you've made some real progress. You've been a great help both underwater and on land!",
            "nextDialogs": [
              "747160108"
            ]
          },
          "747160108": {
            "id": "747160108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's no need to blush.",
            "nextDialogs": [
              "747160109"
            ]
          },
          "747160109": {
            "id": "747160109",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Oh, uh... Alright.",
            "nextDialogs": [
              "747160110"
            ]
          },
          "747160110": {
            "id": "747160110",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "...",
            "nextDialogs": [
              "747160111"
            ]
          },
          "747160111": {
            "id": "747160111",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "I'm sorry, besides \"thank you,\" I really don't know what else to say at times like these.",
            "nextDialogs": [
              "747160112"
            ]
          },
          "747160112": {
            "id": "747160112",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Maybe... I still need a little more practice?",
            "nextDialogs": [
              "747160113"
            ]
          },
          "747160113": {
            "id": "747160113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Take your time, there's no hurry. Just keep working on it at your own pace!"
          }
        }
      }
    }
  ]
}
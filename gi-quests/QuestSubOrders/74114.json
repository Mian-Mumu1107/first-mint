  "subQuests": [
    {
      "subId": "7411402",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741140101"
        ],
        "dialogs": {
          "741140101": {
            "id": "741140101",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "No problem. Our box is waterproof. All we need to do is dive down and fetch it...",
            "nextDialogs": [
              "741140102"
            ]
          },
          "741140102": {
            "id": "741140102",
            "speakerId": 1001,
            "speakerName": "Xingye",
            "text": "Boss, none of us here knows how to dive.",
            "nextDialogs": [
              "741140103"
            ]
          },
          "741140103": {
            "id": "741140103",
            "speakerId": 1002,
            "speakerName": "Yifeng",
            "text": "I know how to swim, but diving's beyond me.",
            "nextDialogs": [
              "741140104"
            ]
          },
          "741140104": {
            "id": "741140104",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "Is... is the commission we posted at the Adventurers' Guild still on the board?",
            "nextDialogs": [
              "741140105"
            ]
          },
          "741140105": {
            "id": "741140105",
            "speakerId": 1002,
            "speakerName": "Yifeng",
            "text": "Boss, didn't you say before that we should hurry up and take the commission down?",
            "nextDialogs": [
              "741140106"
            ]
          },
          "741140106": {
            "id": "741140106",
            "speakerId": 1001,
            "speakerName": "Xingye",
            "text": "We did that yesterday. The guild said they can return us our prepaid commission posting fee today.",
            "nextDialogs": [
              "741140107"
            ]
          },
          "741140107": {
            "id": "741140107",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "Uh... If we want to send out a commission again, are we going to need to pay an additional service fee...",
            "nextDialogs": [
              "741140110"
            ]
          },
          "741140110": {
            "id": "741140110",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "#Adventurer... {NICKNAME}! You came right when we needed you!",
            "nextDialogs": [
              "741140111"
            ]
          },
          "741140111": {
            "id": "741140111",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "Can you dive? Or... can you help me find a diver with the ability and time to do a dive?",
            "nextDialogs": [
              "741140112"
            ]
          },
          "741140112": {
            "id": "741140112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You want to... do an underwater shoot?",
            "nextDialogs": [
              "741140113"
            ]
          },
          "741140113": {
            "id": "741140113",
            "speakerId": 1002,
            "speakerName": "Yifeng",
            "text": "We're hardly that capable. We also can't afford water-proof film equipment.",
            "nextDialogs": [
              "741140114"
            ]
          },
          "741140114": {
            "id": "741140114",
            "speakerId": 1001,
            "speakerName": "Xingye",
            "text": "It's purely because the box we put our films in fell into the water.",
            "nextDialogs": [
              "741140115"
            ]
          },
          "741140115": {
            "id": "741140115",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "#Alright, that's enough you two! {NICKNAME}, you gotta help us.",
            "nextDialogs": [
              "741140116"
            ]
          },
          "741140116": {
            "id": "741140116",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "Don't worry about the payment. I'll pay you upfront, just like last time."
          }
        }
      }
    },
    {
      "subId": "7411403",
      "subQuestName": "Retrieve the box containing films",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741140301"
        ],
        "dialogs": {
          "741140301": {
            "id": "741140301",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "#Aha! You're the best, {NICKNAME}. You're the absolute best!",
            "nextDialogs": [
              "741140302"
            ]
          },
          "741140302": {
            "id": "741140302",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "If it weren't for you, everything inside the case would have been lost.",
            "nextDialogs": [
              "741140303"
            ]
          },
          "741140303": {
            "id": "741140303",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "We need to get back to the city and give these films to Mr. Geisert.",
            "nextDialogs": [
              "741140304"
            ]
          },
          "741140304": {
            "id": "741140304",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "#And then... let's have a meal together. {NICKNAME}, if you're interested, you can come too.",
            "nextDialogs": [
              "741140305"
            ]
          },
          "741140305": {
            "id": "741140305",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "After we finish eating, I'll pay you your reward.",
            "nextDialogs": [
              "741140308"
            ]
          },
          "741140308": {
            "id": "741140308",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "Alright! It's settled.",
            "nextDialogs": [
              "741140309"
            ]
          },
          "741140309": {
            "id": "741140309",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "Yifeng, bring the films in this box over to Mr. Geisert later.",
            "nextDialogs": [
              "741140310"
            ]
          },
          "741140310": {
            "id": "741140310",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "Xingye, go get some good greens from nearby. I've been practicing my Poisson Seafood Soup, and it's time to show it off to Mr. Geisert.",
            "nextDialogs": [
              "741140311"
            ]
          },
          "741140311": {
            "id": "741140311",
            "speakerId": 1001,
            "speakerName": "Xingye",
            "text": "Boss, we're already going to the restaurant. Why do you still get to do things yourself?",
            "nextDialogs": [
              "741140312"
            ]
          },
          "741140312": {
            "id": "741140312",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "So that we can save costs...",
            "nextDialogs": [
              "741140313"
            ]
          },
          "741140313": {
            "id": "741140313",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "Ahem! It's settled. Let's get going.",
            "nextDialogs": [
              "741140314"
            ]
          },
          "741140314": {
            "id": "741140314",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "#{NICKNAME}, you can follow me."
          }
        }
      }
    },
    {
      "subId": "7411404",
      "subQuestName": "Report back to Ms. Qiu and her company",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7411405",
      "subQuestName": "Talk to Ms. Qiu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741140401"
        ],
        "dialogs": {
          "741140401": {
            "id": "741140401",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "This pot is pretty strange. Hmm... but it should be used the same way as the ones in Liyue.",
            "nextDialogs": [
              "741140402"
            ]
          },
          "741140402": {
            "id": "741140402",
            "speakerId": 1001,
            "speakerName": "Xingye",
            "text": "Boss, I got the veggies, but they're all out of Marcotte.",
            "nextDialogs": [
              "741140403"
            ]
          },
          "741140403": {
            "id": "741140403",
            "speakerId": 1001,
            "speakerName": "Xingye",
            "text": "I couldn't find any other store that sells it...",
            "nextDialogs": [
              "741140404"
            ]
          },
          "741140404": {
            "id": "741140404",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "#That's... the last ingredient we needed. Well, uh, {NICKNAME}...",
            "nextDialogs": [
              "741140407"
            ]
          },
          "741140407": {
            "id": "741140407",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "Thanks for your help. Don't worry, I know how adventurers work. This isn't a free favor."
          }
        }
      }
    },
    {
      "subId": "7411406",
      "subQuestName": "Give the Marcotte to Ms. Qiu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741140601"
        ],
        "dialogs": {
          "741140601": {
            "id": "741140601",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "#{NICKNAME}, I'd like to introduce you to a master filmmaker, Mr. Geisert.",
            "nextDialogs": [
              "741140602"
            ]
          },
          "741140602": {
            "id": "741140602",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "#Mr. Geisert, this is {NICKNAME}, a highly skilled adventurer.",
            "nextDialogs": [
              "741140603"
            ]
          },
          "741140603": {
            "id": "741140603",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "#If you plan to shoot an action film in the future, you should definitely consider casting {NICKNAME} as the lead!",
            "nextDialogs": [
              "741140604"
            ]
          },
          "741140604": {
            "id": "741140604",
            "speakerId": 1003,
            "speakerName": "Geisert",
            "text": "Haha, Ms. Qiu exaggerates. I'm not some filmmaking expert.",
            "nextDialogs": [
              "741140605"
            ]
          },
          "741140605": {
            "id": "741140605",
            "speakerId": 1003,
            "speakerName": "Geisert",
            "text": "I'm just someone who's somewhat familiar with the uses of lighting for filmmaking.",
            "nextDialogs": [
              "741140606"
            ]
          },
          "741140606": {
            "id": "741140606",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "Ah, you're too modest. The lighting in your films practically speaks for itself.",
            "nextDialogs": [
              "741140608",
              "741140610"
            ]
          },
          "741140608": {
            "id": "741140608",
            "speakerId": 1003,
            "speakerName": "Geisert",
            "text": "Yeah. In my lighting theory, I believe that the manipulation of lighting is the manipulation of emotion.",
            "nextDialogs": [
              "741140611"
            ]
          },
          "741140611": {
            "id": "741140611",
            "speakerId": 1003,
            "speakerName": "Geisert",
            "text": "But... how should I put this... My theories have yet to be regarded in Fontaine's film industry.",
            "nextDialogs": [
              "741140612"
            ]
          },
          "741140612": {
            "id": "741140612",
            "speakerId": 1003,
            "speakerName": "Geisert",
            "text": "Most directors prefer to use direct movement or the scene itself to illustrate their stories.",
            "nextDialogs": [
              "741140613"
            ]
          },
          "741140613": {
            "id": "741140613",
            "speakerId": 1003,
            "speakerName": "Geisert",
            "text": "I've shot a few films purely using lighting transitions to express narrative, but almost no one was interested.",
            "nextDialogs": [
              "741140614"
            ]
          },
          "741140614": {
            "id": "741140614",
            "speakerId": 1003,
            "speakerName": "Geisert",
            "text": "But now, at least one director thinks my lighting theory has value.",
            "nextDialogs": [
              "741140615"
            ]
          },
          "741140615": {
            "id": "741140615",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "Director? Me? Hahaha, don't jest. I was just a tea vendor.",
            "nextDialogs": [
              "741140616"
            ]
          },
          "741140616": {
            "id": "741140616",
            "speakerId": 1003,
            "speakerName": "Geisert",
            "text": "Who said a tea vendor can't be a director? I was just a journalist before.",
            "nextDialogs": [
              "741140617"
            ]
          },
          "741140617": {
            "id": "741140617",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "A journalist... Then you must be good at writing reports? Just like those in the papers.",
            "nextDialogs": [
              "741140618"
            ]
          },
          "741140618": {
            "id": "741140618",
            "speakerId": 1003,
            "speakerName": "Geisert",
            "text": "I suppose. What about it?",
            "nextDialogs": [
              "741140619"
            ]
          },
          "741140619": {
            "id": "741140619",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "Huh... Just as well...",
            "nextDialogs": [
              "741140620"
            ]
          },
          "741140620": {
            "id": "741140620",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "Ah! Nothing, nothing. Let's eat! We will have plenty of time to work together in the future, hahaha!",
            "nextDialogs": [
              "741140621"
            ]
          },
          "741140621": {
            "id": "741140621",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Everyone takes a seat to Ms. Qiu's forthright laughter.",
            "nextDialogs": [
              "741140622"
            ]
          },
          "741140622": {
            "id": "741140622",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "After the meal, Ms. Qiu makes an additional meal and stuffs it in your bag after packaging it..."
          },
          "741140610": {
            "id": "741140610",
            "speakerId": 1003,
            "speakerName": "Geisert",
            "text": "Of course. In my theories, lighting is the key way mood is expressed in a scene."
          }
        }
      }
    },
    {
      "subId": "7411408",
      "subQuestName": "Talk to Ms. Qiu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741140701"
        ],
        "dialogs": {
          "741140701": {
            "id": "741140701",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "Okay, gotta get this meal started as soon as possible. Gotta do this fast. Mr. Geisert is almost here..."
          }
        }
      }
    },

    {
      "subId": "7411402",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741140201"
        ],
        "dialogs": {
          "741140201": {
            "id": "741140201",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "*sigh* I hope the films won't be damaged by the water.",
            "nextDialogs": [
              "741140202"
            ]
          },
          "741140202": {
            "id": "741140202",
            "speakerId": 1002,
            "speakerName": "Yifeng",
            "text": "Don't worry Boss, the box is sealed tight. The water won't be getting in.",
            "nextDialogs": [
              "741140203"
            ]
          },
          "741140203": {
            "id": "741140203",
            "speakerId": 1001,
            "speakerName": "Xingye",
            "text": "Good thing our Film Kamera didn't fall in. Otherwise, it would be a total flop..."
          }
        }
      }
    },
    {
      "subId": "7411405",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741140501"
        ],
        "dialogs": {
          "741140501": {
            "id": "741140501",
            "speakerId": 1000,
            "speakerName": "Ms. Qiu",
            "text": "#{NICKNAME}, did you get the Marcotte?",
            "nextDialogs": [
              "741140502"
            ]
          },
          "741140502": {
            "id": "741140502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I got it."
          }
        }
      }
    }
  ]
}
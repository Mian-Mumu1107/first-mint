    {
      "subId": "4019903",
      "subQuestName": "Equip the item and talk to Yelan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401991201"
        ],
        "dialogs": {
          "401991201": {
            "id": "401991201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm ready to investigate.",
            "nextDialogs": [
              "401991202"
            ]
          },
          "401991202": {
            "id": "401991202",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Alright. I know you have an eye for detail, so use it to your advantage. You've got this."
          }
        }
      }
    },
    {
      "subId": "4019908",
      "subQuestName": "Investigate the suspicious area",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

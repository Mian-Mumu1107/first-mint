      }
    },
    {
      "subId": "4019909",
      "subQuestName": "Talk to Yelan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401990701"
        ],
        "dialogs": {
          "401990701": {
            "id": "401990701",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "This must be it! The secret base where they stash their goods! Definitely wasn't easy to find!",
            "nextDialogs": [
              "401990702"
            ]
          },
          "401990702": {
            "id": "401990702",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "#Well, well, looks like you tracked it down in no time at all! I see your potential as a solo field agent, {NICKNAME}.",
            "nextDialogs": [
              "401990703"
            ]
          },
          "401990703": {
            "id": "401990703",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Now, time to test out the key we found earlier. Let's see what surprises could be in store.",
            "nextDialogs": [
              "401990704"
            ]
          },
          "401990704": {
            "id": "401990704",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Mm, this isn't their home turf, so I doubt they had time to set more traps. Should make our lives easier.",
            "nextDialogs": [
              "401990705"
            ]
          },
          "401990705": {
            "id": "401990705",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "I'll take it from here. The last thing we want is to leave traces behind in there. Caution is the name of the game.",
            "nextDialogs": [
              "401990706"
            ]
          },
          "401990706": {
            "id": "401990706",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "You two keep a look-out. Make sure no one barges in while I'm in there.",
            "nextDialogs": [
              "401990707"
            ]
          },
          "401990707": {
            "id": "401990707",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#You got it! This is a first for us, but {NICKNAME} can do anything! {M#He's}{F#She's} got your back!",
            "nextDialogs": [
              "401990710"
            ]
          },
          "401990710": {
            "id": "401990710",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "G—Good point... Yelan doesn't make mistakes like that...",
            "nextDialogs": [
              "401990711"
            ]
          },
          "401990711": {
            "id": "401990711",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Yelan opens the door to the stronghold and observes the space. It appears to be an ordinary cellar...\\nDue to construction difficulties, the top and side walls couldn't be completely sealed, causing water from the soil to seep into the space...",
            "nextDialogs": [
              "401990712"
            ]
          },
          "401990712": {
            "id": "401990712",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Noticing this, Yelan covers her hands in a thin sheen of Hydro.\\nThis means she can touch the items in the space without leaving traces behind, because the water from her hands will vaporize over time.\\n Finally, Yelan enters the stronghold and begins to examine the items sealed within...",
            "nextDialogs": [
              "401990713"
            ]
          },
          "401990713": {
            "id": "401990713",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Alright, that's done. I've noted the features of all the porcelain items, vases, and teas stored here.",
            "nextDialogs": [
              "401990714"
            ]
          },
          "401990714": {
            "id": "401990714",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "We need to keep a look-out for these features at the auction and pinpoint the person attempting to purchase the corresponding goods. Then we can let them lead us to our main target.",
            "nextDialogs": [
              "401990715"
            ]
          },
          "401990715": {
            "id": "401990715",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wow, that was fast! You must do that all the time, huh?"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "4019901",
      "subQuestName": "Sample tea at Yilong Wharf",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401990101"
        ],
        "dialogs": {
          "401990101": {
            "id": "401990101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, the person drinking tea over there... Isn't that Yelan?",
            "nextDialogs": [
              "401990102"
            ]
          },
          "401990102": {
            "id": "401990102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ooh, looks like she's having some kind of tea party with friends! We're just in time!",
            "nextDialogs": [
              "401990105"
            ]
          },
          "401990105": {
            "id": "401990105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Uh, aren't we gonna go say hi?",
            "nextDialogs": [
              "401990106"
            ]
          },
          "401990106": {
            "id": "401990106",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Well, Officer Edler, after all that work, I think we've got them this time.",
            "nextDialogs": [
              "401990107"
            ]
          },
          "401990107": {
            "id": "401990107",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Might take a few days to wrap up things in the field. In the meantime, I think you've earned yourself a break.",
            "nextDialogs": [
              "401990108"
            ]
          },
          "401990108": {
            "id": "401990108",
            "speakerId": 1002,
            "speakerName": "Edler",
            "text": "Much appreciated, Miss Yelan. This case really took it out of me...",
            "nextDialogs": [
              "401990109"
            ]
          },
          "401990109": {
            "id": "401990109",
            "speakerId": 1002,
            "speakerName": "Edler",
            "text": "*sigh*... Thirteen strongholds... One thieving weasel after another! We rounded up so many people, you almost start to hope a few were innocent — just to balance it out.",
            "nextDialogs": [
              "401990110"
            ]
          },
          "401990110": {
            "id": "401990110",
            "speakerId": 1002,
            "speakerName": "Edler",
            "text": "I'm just glad we finally took down these crooks! Anyway, I'm gonna drop in on that old classmate of mine in Qiaoying Village and reminisce about old times.",
            "nextDialogs": [
              "401990111"
            ]
          },
          "401990111": {
            "id": "401990111",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Don't forget to take some tea and dim sum back to your friends at the Maison Gardiennage.",
            "nextDialogs": [
              "401990112"
            ]
          },
          "401990112": {
            "id": "401990112",
            "speakerId": 1003,
            "speakerName": "???",
            "text": "...",
            "nextDialogs": [
              "401990113"
            ]
          },
          "401990113": {
            "id": "401990113",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, looks like Yelan's friend left. Paimon kinda wanted to meet her..."
          }
        }
      }
    },
    {
      "subId": "4019904",
      "subQuestName": "Go to the suspicious area",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401990401"
        ],
        "dialogs": {
          "401990401": {
            "id": "401990401",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Alright, let's start our investigation here.",
            "nextDialogs": [
              "401990402"
            ]
          },
          "401990402": {
            "id": "401990402",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You follow Yelan through an uninhabited region in the northeast of Chenyu Vale...\\n With Yelan's help, you find a covert location from which to scout the beach.",
            "nextDialogs": [
              "401990403"
            ]
          },
          "401990403": {
            "id": "401990403",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "But you don't see any members of the Dark Financier's crew, nor anything else suspicious about the area.",
            "nextDialogs": [
              "401990404"
            ]
          },
          "401990404": {
            "id": "401990404",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So... We can all agree this is just a normal stretch of wilderness, right? Paimon doesn't see any bad guys to nab around here.",
            "nextDialogs": [
              "401990407"
            ]
          },
          "401990407": {
            "id": "401990407",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "#Well, it didn't take long for you to understand our role here, {NICKNAME}. Thinking like a top agent already... Impressive.",
            "nextDialogs": [
              "401990408"
            ]
          },
          "401990408": {
            "id": "401990408",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Like I said, we need to start small. If we want to track down the man himself, our best bet is to start with his goods. So, right now, finding his stock is our number one priority.",
            "nextDialogs": [
              "401990409"
            ]
          },
          "401990409": {
            "id": "401990409",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "And to do that, locating his hidden stronghold is imperative.",
            "nextDialogs": [
              "401990410"
            ]
          },
          "401990410": {
            "id": "401990410",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Which brings us to why we're here. Pretty good vantage point from up here, don't you think?",
            "nextDialogs": [
              "401990411"
            ]
          },
          "401990411": {
            "id": "401990411",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh, guess so... Paimon can see the port at Yilong Wharf, the boats in the distance, and some kind of tower... What's that for?",
            "nextDialogs": [
              "401990412"
            ]
          },
          "401990412": {
            "id": "401990412",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "It's a lighthouse. The Millelith use it to monitor the situation at sea. In addition, the flashing of the light can also serve as a means of communication."
          }
        }
      }
    },
    {
      "subId": "4019902",
      "subQuestName": "Equip the item and talk to Yelan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401990801"
        ],
        "dialogs": {
          "401990801": {
            "id": "401990801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm ready to investigate.",
            "nextDialogs": [
              "401990802"
            ]
          },
          "401990802": {
            "id": "401990802",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Remember, an eye for detail is key. Clues are often hidden in plain sight..."
          }
        }
      }
    },
    {
      "subId": "4019905",
      "subQuestName": "Investigate the suspicious area",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401990501"
        ],
        "dialogs": {
          "401990501": {
            "id": "401990501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Aaannd nothing out of the ordinary here either...",
            "nextDialogs": [
              "401990504"
            ]
          },
          "401990504": {
            "id": "401990504",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "That's right. No detail is too small to investigate. I believe in you."
          }
        }
      }
    },
    {
      "subId": "4019906",
      "subQuestName": "Talk to Yelan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401990601"
        ],
        "dialogs": {
          "401990601": {
            "id": "401990601",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Some good finds.",
            "nextDialogs": [
              "401990602"
            ]
          },
          "401990602": {
            "id": "401990602",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Whatever door this key opens could be critical to the investigation. And this carrier pigeon tube contains several coded messages.",
            "nextDialogs": [
              "401990603"
            ]
          },
          "401990603": {
            "id": "401990603",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh... So there really is evidence around here. It's like these guys aren't even afraid of getting caught!",
            "nextDialogs": [
              "401990604"
            ]
          },
          "401990604": {
            "id": "401990604",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What if the Millelith noticed them spying and decided to investigate?",
            "nextDialogs": [
              "401990605"
            ]
          },
          "401990605": {
            "id": "401990605",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "These objects suggest the Dark Financier's scouts were likely disguised as fishermen. People like that are trained not to crack under pressure...",
            "nextDialogs": [
              "401990606"
            ]
          },
          "401990606": {
            "id": "401990606",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "All they'd need to do is come up with a believable excuse, like needing a place to rest. The Millelith can't investigate or apprehend a civilian without probable cause.",
            "nextDialogs": [
              "401990607"
            ]
          },
          "401990607": {
            "id": "401990607",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh, Paimon can just see their smug faces, getting away with something like that...",
            "nextDialogs": [
              "401990610"
            ]
          },
          "401990610": {
            "id": "401990610",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Not to mention, the traces on these objects are fresh, which means the scout here is still active and wasn't among those caught by Officer Edler.",
            "nextDialogs": [
              "401990611"
            ]
          },
          "401990611": {
            "id": "401990611",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "So we need to stay vigilant. We can't let them know we're still on their tail.",
            "nextDialogs": [
              "401990612"
            ]
          },
          "401990612": {
            "id": "401990612",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Yelan takes out an elaborate set of tools and creates exact replicas of the key and coded messages found at the scene...\\n She then restores the scene to its original state, erasing any signs that an investigation has taken place.",
            "nextDialogs": [
              "401990613"
            ]
          },
          "401990613": {
            "id": "401990613",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "I had a hunch this area was being used as a look-out, and I was right. But that still leaves the question of where the goods are hidden...",
            "nextDialogs": [
              "401990614"
            ]
          },
          "401990614": {
            "id": "401990614",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "#Any ideas, {NICKNAME}?"
          }
        }
      }
    },

    {
      "subId": "4019999",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401999901"
        ],
        "dialogs": {
          "401999901": {
            "id": "401999901",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Phew, it's heating up out here. It's so draining, like being trapped in a sauna...",
            "nextDialogs": [
              "401999902"
            ]
          },
          "401999902": {
            "id": "401999902",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Isn't green tea meant to be good for chasing away the heat? Paimon thinks she heard that somewhere... Why don't we head to Yilong Wharf and give it a try?"
          }
        }
      }

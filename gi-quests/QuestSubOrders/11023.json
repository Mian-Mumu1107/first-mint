    {
      "subId": "1102303",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110230301"
        ],
        "dialogs": {
          "110230301": {
            "id": "110230301",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Look at this. It's filled halfway with salt.",
            "nextDialogs": [
              "110230302"
            ]
          },
          "110230302": {
            "id": "110230302",
            "speakerId": 1001,
            "speakerName": "Kliment",
            "text": "Just looks like a fancy salt holder. Seems like the God of Salt was a god lacking in treasures.",
            "nextDialogs": [
              "110230303"
            ]
          },
          "110230303": {
            "id": "110230303",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "According to my knowledge, it's no ordinary vessel. Although it is only half-full, it is also forever half-full — that is to say, it is bottomless.",
            "nextDialogs": [
              "110230304"
            ]
          },
          "110230304": {
            "id": "110230304",
            "speakerId": 1001,
            "speakerName": "Kliment",
            "text": "What!? You're saying that even if I pour the salt out, the amount inside won't change!?",
            "nextDialogs": [
              "110230305"
            ]
          },
          "110230305": {
            "id": "110230305",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Exactly.",
            "nextDialogs": [
              "110230306"
            ]
          },
          "110230306": {
            "id": "110230306",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Able to produce endless salt... The God of Salt is powerful indeed!",
            "nextDialogs": [
              "110230307"
            ]
          },
          "110230307": {
            "id": "110230307",
            "speakerId": 1001,
            "speakerName": "Kliment",
            "text": "Finally, after all that effort, I've found precious treasure! I claim this as mine!",
            "nextDialogs": [
              "110230308"
            ]
          },
          "110230308": {
            "id": "110230308",
            "speakerId": 1001,
            "speakerName": "Kliment",
            "text": "I just need to pour the endless salt into a thousand, or ten-thousand bags... I can sell it and make a fortune!",
            "nextDialogs": [
              "110230309"
            ]
          },
          "110230309": {
            "id": "110230309",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Hey! How can you use a relic of the God of Salt for such a shallow pursuit!?",
            "nextDialogs": [
              "110230310"
            ]
          },
          "110230310": {
            "id": "110230310",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "If Mr. Kliment wants this salt chalice, then the next object we find will belong to Miss Wanyan, according to the contract agreed upon.",
            "nextDialogs": [
              "110230311"
            ]
          },
          "110230311": {
            "id": "110230311",
            "speakerId": 1001,
            "speakerName": "Kliment",
            "text": "Of course, as we agreed, hehe. But how can anything be worth more than this rare find?",
            "nextDialogs": [
              "110230312"
            ]
          },
          "110230312": {
            "id": "110230312",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Since we have a contract, it's no use for me to fight with him...",
            "nextDialogs": [
              "110230313"
            ]
          },
          "110230313": {
            "id": "110230313",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Then let's move on, shall we?"
          }
        }
      }
    },
    {
      "subId": "1102304",
      "subQuestName": "Continue exploring",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1102305",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110230501"
        ],
        "dialogs": {
          "110230501": {
            "id": "110230501",
            "speakerId": 1001,
            "speakerName": "Kliment",
            "text": "Ha, just a simple ruler. Doesn't look to be worth anything.",
            "nextDialogs": [
              "110230502"
            ]
          },
          "110230502": {
            "id": "110230502",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "This... if I remember correctly, this is some kind of measuring tool.",
            "nextDialogs": [
              "110230503"
            ]
          },
          "110230503": {
            "id": "110230503",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Indeed. But the God of Salt imbued it with another power.",
            "nextDialogs": [
              "110230504"
            ]
          },
          "110230504": {
            "id": "110230504",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "When you stick this ruler in the ground, the surrounding area will become covered in salt, much like a rising tide covers the earth.",
            "nextDialogs": [
              "110230505"
            ]
          },
          "110230505": {
            "id": "110230505",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "The deeper it is stuck in the ground, the more salt will appear. It is essentially a \"bumper harvest\" of salt.",
            "nextDialogs": [
              "110230506"
            ]
          },
          "110230506": {
            "id": "110230506",
            "speakerId": 1001,
            "speakerName": "Kliment",
            "text": "Wh— Th—That's even better than the salt chalice!",
            "nextDialogs": [
              "110230507"
            ]
          },
          "110230507": {
            "id": "110230507",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Well then, according to our contract, the salt ruler goes to Miss Wanyan.",
            "nextDialogs": [
              "110230508"
            ]
          },
          "110230508": {
            "id": "110230508",
            "speakerId": 1001,
            "speakerName": "Kliment",
            "text": "No! Unacceptable! I paid for and organized this entire expedition. Why should I get the short end of the stick?",
            "nextDialogs": [
              "110230509"
            ]
          },
          "110230509": {
            "id": "110230509",
            "speakerId": 1001,
            "speakerName": "Kliment",
            "text": "And this girl has been useless. Why would she get anything!?",
            "nextDialogs": [
              "110230510"
            ]
          },
          "110230510": {
            "id": "110230510",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Oh boy, here we go again...",
            "nextDialogs": [
              "110230513"
            ]
          },
          "110230513": {
            "id": "110230513",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "So you are saying, you want to break the contract?",
            "nextDialogs": [
              "110230514"
            ]
          },
          "110230514": {
            "id": "110230514",
            "speakerId": 1001,
            "speakerName": "Kliment",
            "text": "So what if I break it? Now that I've seen how the mechanisms in this ruin work, I no longer need you.",
            "nextDialogs": [
              "110230515"
            ]
          },
          "110230515": {
            "id": "110230515",
            "speakerId": 1001,
            "speakerName": "Kliment",
            "text": "Let's not forget who hired who here. Why should I let YOU make the rules?",
            "nextDialogs": [
              "110230516"
            ]
          },
          "110230516": {
            "id": "110230516",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Because you agreed to a contract.",
            "nextDialogs": [
              "110230517"
            ]
          },
          "110230517": {
            "id": "110230517",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Rex Lapis once said: \"Ones who break their contracts shall suffer the Wrath of the Rock.\"",
            "nextDialogs": [
              "110230518"
            ]
          },
          "110230518": {
            "id": "110230518",
            "speakerId": 1001,
            "speakerName": "Kliment",
            "text": "That is one of your Liyue gods. I am from Snezhnaya, I—",
            "nextDialogs": [
              "110230519"
            ]
          },
          "110230519": {
            "id": "110230519",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "—Will \"suffer the Wrath of the Rock\" — you may find it rather unpleasant."
          }
        }
      }
    },
    {
      "subId": "1102306",
      "subQuestName": "Punish Kliment",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1102307",
      "subQuestName": "Talk to Zhongli and Wanyan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110230701"
        ],
        "dialogs": {
          "110230701": {
            "id": "110230701",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "I shall confiscate your treasure as well.",
            "nextDialogs": [
              "110230702"
            ]
          },
          "110230702": {
            "id": "110230702",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "You are not worthy to continue any further into the ruin. Leave this place.",
            "nextDialogs": [
              "110230703"
            ]
          },
          "110230703": {
            "id": "110230703",
            "speakerId": 1001,
            "speakerName": "Kliment",
            "text": "Darn you... Just you wait!",
            "nextDialogs": [
              "110230704"
            ]
          },
          "110230704": {
            "id": "110230704",
            "speakerId": 1001,
            "speakerName": "Kliment",
            "text": "",
            "nextDialogs": [
              "110230705"
            ]
          },
          "110230705": {
            "id": "110230705",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Some \"archaeological survey...\" He could only pretend for so long.",
            "nextDialogs": [
              "110230707",
              "110230709"
            ]
          },
          "110230707": {
            "id": "110230707",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Yeah, good thing Paimon can smell a liar from a mile away.",
            "nextDialogs": [
              "110230710"
            ]
          },
          "110230710": {
            "id": "110230710",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Kliment's wrongdoing stemmed from greed, yes. But besides greed, there are many other things that may tempt us to break contracts.",
            "nextDialogs": [
              "110230711"
            ]
          },
          "110230711": {
            "id": "110230711",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "When people see the object of their dreams, how many are really able to control their desire and follow the contract...?",
            "nextDialogs": [
              "110230712"
            ]
          },
          "110230712": {
            "id": "110230712",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "I think we should be honest with each other now.",
            "nextDialogs": [
              "110230713"
            ]
          },
          "110230713": {
            "id": "110230713",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Huh? Be honest about what?",
            "nextDialogs": [
              "110230714"
            ]
          },
          "110230714": {
            "id": "110230714",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "That in truth, not a single member of this \"archaeological expedition\" came here for archaeology.",
            "nextDialogs": [
              "110230715"
            ]
          },
          "110230715": {
            "id": "110230715",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Wh—Why do you say that?",
            "nextDialogs": [
              "110230716"
            ]
          },
          "110230716": {
            "id": "110230716",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Miss, you lack even the most basic archaeological knowledge and can recognize naught but a few simple relics. However, you are an expert when it comes to anything regarding the God of Salt.",
            "nextDialogs": [
              "110230717"
            ]
          },
          "110230717": {
            "id": "110230717",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "You aren't interested in archaeology or relics — what you're really interested in is the God of Salt.",
            "nextDialogs": [
              "110230718"
            ]
          },
          "110230718": {
            "id": "110230718",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "I believe those legends about the God of Salt that you mentioned on the Pearl Galley are passed down between generations at Yinyuan Hall...",
            "nextDialogs": [
              "110230719"
            ]
          },
          "110230719": {
            "id": "110230719",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Okay, that's enough!",
            "nextDialogs": [
              "110230720"
            ]
          },
          "110230720": {
            "id": "110230720",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "...Sir, you are indeed a man of great knowledge and talents. I seem to have been right to seek you out, once I plucked up my courage.",
            "nextDialogs": [
              "110230721"
            ]
          },
          "110230721": {
            "id": "110230721",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "You're right. I'm not a scholar of archaeology. I come from one of the Eight Trades under the jurisdiction of the Qixing — Yinyuan Hall of the salt industry.",
            "nextDialogs": [
              "110230722"
            ]
          },
          "110230722": {
            "id": "110230722",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Our ancestors were those protected by the God of Salt all those years ago, when the Archon War engulfed the land in chaos."
          },
          "110230709": {
            "id": "110230709",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Hey! Paimon likes Mora, but Paimon doesn't do bad things!"
          }
        }
      }
    },
    {
      "subId": "1102312",
      "subQuestName": "Proceed deeper within",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

      }
    },
    {
      "subId": "1102309",
      "subQuestName": "Examine the broken sword",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110230901"
        ],
        "dialogs": {
          "110230901": {
            "id": "110230901",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "This is... a sword?",
            "nextDialogs": [
              "110230902"
            ]
          },
          "110230902": {
            "id": "110230902",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Aha! It's a broken sword, this is proof! This proves that the God of Salt had to fight back, fight back against the evil Morax! But sadly, she was defeated...",
            "nextDialogs": [
              "110230903"
            ]
          },
          "110230903": {
            "id": "110230903",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "The power of this sword surely is much greater than that of the salt chalice and the salt ruler!",
            "nextDialogs": [
              "110230904"
            ]
          },
          "110230904": {
            "id": "110230904",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "If we can repair this sword, then we can show the world the mighty power of the God of Salt...",
            "nextDialogs": [
              "110230905"
            ]
          },
          "110230905": {
            "id": "110230905",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Hmm... It does look like something left behind after being defeated in battle.",
            "nextDialogs": [
              "110230906"
            ]
          },
          "110230906": {
            "id": "110230906",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Two pieces of a broken sword. From an archaeological perspective, these are two separate relics. According to the contract, you can only claim one.",
            "nextDialogs": [
              "110230907"
            ]
          },
          "110230907": {
            "id": "110230907",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Wh—Why? We were alternating claims to treasure, true, but Kliment is no longer here...",
            "nextDialogs": [
              "110230908"
            ]
          },
          "110230908": {
            "id": "110230908",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Yes, but the \"only one object per claim\" clause still holds true. You cannot take two relics at the same time.",
            "nextDialogs": [
              "110230909"
            ]
          },
          "110230909": {
            "id": "110230909",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Th—This logic...",
            "nextDialogs": [
              "110230910"
            ]
          },
          "110230910": {
            "id": "110230910",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Um... Zhongli, she seems like a good person, and no one is fighting over the treasure. How about you let this one slide, huh?",
            "nextDialogs": [
              "110230911"
            ]
          },
          "110230911": {
            "id": "110230911",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "When there's a contract, nothing can be allowed to \"slide.\" If the contract is not followed, then it is broken.",
            "nextDialogs": [
              "110230912"
            ]
          },
          "110230912": {
            "id": "110230912",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "No! If I only take one half, then it can't be repaired, and the power of the God of Salt cannot be restored...",
            "nextDialogs": [
              "110230913"
            ]
          },
          "110230913": {
            "id": "110230913",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "No matter what, I must be faithful to her...",
            "nextDialogs": [
              "110230914"
            ]
          },
          "110230914": {
            "id": "110230914",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Even if it breaks the contract, I don't care.",
            "nextDialogs": [
              "110230915"
            ]
          },
          "110230915": {
            "id": "110230915",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "So you are already decided? Hmm... Then there is a price to pay for breaking the contract.",
            "nextDialogs": [
              "110230916"
            ]
          },
          "110230916": {
            "id": "110230916",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Zhongli!",
            "nextDialogs": [
              "110230917"
            ]
          },
          "110230917": {
            "id": "110230917",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "That is to say, you consign yourself to \"suffer the Wrath of the Rock.\"",
            "nextDialogs": [
              "110230918"
            ]
          },
          "110230918": {
            "id": "110230918",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "That... that's okay. The God of Salt gave up her life to protect her people. My sacrifice is nothing compared to that.",
            "nextDialogs": [
              "110230919"
            ]
          },
          "110230919": {
            "id": "110230919",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Punish me however you want. Just let me take this proof of my faith!",
            "nextDialogs": [
              "110230920"
            ]
          },
          "110230920": {
            "id": "110230920",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "No, you can't hit her!",
            "nextDialogs": [
              "110230921"
            ]
          },
          "110230921": {
            "id": "110230921",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "...Perhaps that punishment would be easier for her, but...",
            "nextDialogs": [
              "110230922"
            ]
          },
          "110230922": {
            "id": "110230922",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "As punishment, I will tell you the truth.",
            "nextDialogs": [
              "110230923"
            ]
          },
          "110230923": {
            "id": "110230923",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Huh?",
            "nextDialogs": [
              "110230924"
            ]
          },
          "110230924": {
            "id": "110230924",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "The truth? You mean the truth is my punishment?",
            "nextDialogs": [
              "110230925"
            ]
          },
          "110230925": {
            "id": "110230925",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Yes. The truth that I am about to tell you shall be your price to pay for breaking the contract.",
            "nextDialogs": [
              "110230926"
            ]
          },
          "110230926": {
            "id": "110230926",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "I'm afraid to say that the God of Salt, Havria, was not the powerful god you imagine her to be.",
            "nextDialogs": [
              "110230927"
            ]
          },
          "110230927": {
            "id": "110230927",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Rather, she was a small and weak god who yielded to all other gods. When it came to war, she lost... never able to win a seat among The Seven.",
            "nextDialogs": [
              "110230928"
            ]
          },
          "110230928": {
            "id": "110230928",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Wh—What...!?",
            "nextDialogs": [
              "110230929"
            ]
          },
          "110230929": {
            "id": "110230929",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "During the Archon War, the gods of this world used all their strength and cunning to vie for control of Teyvat.",
            "nextDialogs": [
              "110230930"
            ]
          },
          "110230930": {
            "id": "110230930",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "But Havria instead chose to flee. She thought that by giving up before a fight could start, she could save herself and her people from the war.",
            "nextDialogs": [
              "110230931"
            ]
          },
          "110230931": {
            "id": "110230931",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "However, during such a long war, there is no end to the advances of aggressors.",
            "nextDialogs": [
              "110230932"
            ]
          },
          "110230932": {
            "id": "110230932",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "After making countless concessions, Havria had lost all of her lands until only one small haven remained.",
            "nextDialogs": [
              "110230933"
            ]
          },
          "110230933": {
            "id": "110230933",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "No... no... it can't be so...",
            "nextDialogs": [
              "110230934"
            ]
          },
          "110230934": {
            "id": "110230934",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "In her last days, she had not even a single blade to defend her people with.",
            "nextDialogs": [
              "110230935"
            ]
          },
          "110230935": {
            "id": "110230935",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "\"Not even a single blade?\" Then, this sword...",
            "nextDialogs": [
              "110230936"
            ]
          },
          "110230936": {
            "id": "110230936",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "This sword is not a relic belonging to the God of Salt... but is instead the murder weapon used to kill her.",
            "nextDialogs": [
              "110230937"
            ]
          },
          "110230937": {
            "id": "110230937",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Murder weapon?",
            "nextDialogs": [
              "110230938"
            ]
          },
          "110230938": {
            "id": "110230938",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "No! That's not true, that can't be true! You are trying to test my faith in the God of Salt!",
            "nextDialogs": [
              "110230939"
            ]
          },
          "110230939": {
            "id": "110230939",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "As I said before, I only state the facts.",
            "nextDialogs": [
              "110230940"
            ]
          },
          "110230940": {
            "id": "110230940",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Preposterous! Y—You are a follower of Morax, don't try to trick me!",
            "nextDialogs": [
              "110230941"
            ]
          },
          "110230941": {
            "id": "110230941",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "",
            "nextDialogs": [
              "110230942"
            ]
          },
          "110230942": {
            "id": "110230942",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Hey! Heyyy! Come back!",
            "nextDialogs": [
              "110230944",
              "110230946"
            ]
          },
          "110230944": {
            "id": "110230944",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "It is a punishment, after all. I did not want to tell her such cruel facts, but the contract was broken...",
            "nextDialogs": [
              "110230947"
            ]
          },
          "110230947": {
            "id": "110230947",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Let's follow her deeper into the ruin. There, I fear, we will find something that will leave her no choice but to face the truth."
          },
          "110230946": {
            "id": "110230946",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Indeed. Otherwise, why would I use the truth as punishment? I did not want to tell her such cruel facts, but the contract was broken..."
          }
        }
      }
    },
    {
      "subId": "1102310",
      "subQuestName": "Catch up to Wanyan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110231001"
        ],
        "dialogs": {
          "110231001": {
            "id": "110231001",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Uh... Are these statue thingies... running?"
          }
        }
      }
    },
    {
      "subId": "1102311",
      "subQuestName": "Talk to Wanyan and witness the truth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110231101"
        ],
        "dialogs": {
          "110231101": {
            "id": "110231101",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "This is the scene of the crime. Havria's body dissipated, leaving nothing but these traces of salt. Her dying moments have since been frozen in time to this very day.",
            "nextDialogs": [
              "110231102"
            ]
          },
          "110231102": {
            "id": "110231102",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "...",
            "nextDialogs": [
              "110231103"
            ]
          },
          "110231103": {
            "id": "110231103",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "The story continues that some among her people realized at last that this gentle, kind, but weak god could never protect anyone in wartime.",
            "nextDialogs": [
              "110231104"
            ]
          },
          "110231104": {
            "id": "110231104",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "The Archon War was cruel in the extreme. Instead of consigning her to the agony of defeat, they thought, perhaps it would be better to give her a quick release.",
            "nextDialogs": [
              "110231105"
            ]
          },
          "110231105": {
            "id": "110231105",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "But... what about these statue thingies?",
            "nextDialogs": [
              "110231106"
            ]
          },
          "110231106": {
            "id": "110231106",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "No matter how weak the god, the power that flows forth when they are slain is beyond the strength of mortal coils to bear.",
            "nextDialogs": [
              "110231107"
            ]
          },
          "110231107": {
            "id": "110231107",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Those who could not flee were thus transformed.",
            "nextDialogs": [
              "110231108"
            ]
          },
          "110231108": {
            "id": "110231108",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Those of her people who were untouched by this disaster left for Liyue, where they sought refuge with Rex Lapis.",
            "nextDialogs": [
              "110231109"
            ]
          },
          "110231109": {
            "id": "110231109",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Their descendants feared Havria's remnants and lived in terror that she had laid upon them an eternal curse...",
            "nextDialogs": [
              "110231110"
            ]
          },
          "110231110": {
            "id": "110231110",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "So they risked their lives to come here to break the sword, and offer up obeisances in hopes that her anger might be appeased.",
            "nextDialogs": [
              "110231111"
            ]
          },
          "110231111": {
            "id": "110231111",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "But they need not have done so. For how could a god who had never once resisted — even till the end — nurse hatred for her people in her heart?",
            "nextDialogs": [
              "110231112"
            ]
          },
          "110231112": {
            "id": "110231112",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "I—I... Even if this is so, I can't...",
            "nextDialogs": [
              "110231113"
            ]
          },
          "110231113": {
            "id": "110231113",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "This must be a lie... a false history... all of it!",
            "nextDialogs": [
              "110231114"
            ]
          },
          "110231114": {
            "id": "110231114",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "Don't you dare try to... shake my faith!",
            "nextDialogs": [
              "110231115"
            ]
          },
          "110231115": {
            "id": "110231115",
            "speakerId": 1000,
            "speakerName": "Wanyan",
            "text": "",
            "nextDialogs": [
              "110231116"
            ]
          },
          "110231116": {
            "id": "110231116",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Yikes, Zhongli didn't show any mercy this time, either...",
            "nextDialogs": [
              "110231117"
            ]
          },
          "110231117": {
            "id": "110231117",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "This is the price she must pay... Yet I would not call it a bad thing.",
            "nextDialogs": [
              "110231118"
            ]
          },
          "110231118": {
            "id": "110231118",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Judging by how she appeared, I fear that she will struggle for a time. But even if she may not escape that struggle immediately, simply recognizing the truth is good enough for now.",
            "nextDialogs": [
              "110231120",
              "110231122"
            ]
          },
          "110231120": {
            "id": "110231120",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Indeed. In ages past, Havria's story served as a warning to me as well.",
            "nextDialogs": [
              "110231123"
            ]
          },
          "110231123": {
            "id": "110231123",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Faith in a god who has already passed will do you no good.",
            "nextDialogs": [
              "110231124"
            ]
          },
          "110231124": {
            "id": "110231124",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "So it is for Havria, and so it is for Morax also.",
            "nextDialogs": [
              "110231125"
            ]
          },
          "110231125": {
            "id": "110231125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The people of Liyue will understand that one day.",
            "nextDialogs": [
              "110231126"
            ]
          },
          "110231126": {
            "id": "110231126",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Alright, then. Now, would you like to accompany me in taking a trip to Guyun Stone Forest?",
            "nextDialogs": [
              "110231127"
            ]
          },
          "110231127": {
            "id": "110231127",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Huh? What do you want to do, Zhongli?",
            "nextDialogs": [
              "110231128"
            ]
          },
          "110231128": {
            "id": "110231128",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "*sigh* ...",
            "nextDialogs": [
              "110231129"
            ]
          },
          "110231129": {
            "id": "110231129",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Treading old ground, telling old stories...",
            "nextDialogs": [
              "110231130"
            ]
          },
          "110231130": {
            "id": "110231130",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "...One cannot help but be reminded of old acquaintances."
          },
          "110231122": {
            "id": "110231122",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "No, indeed. How sharp of you — yet this is not a matter of wisdom. Only age."
          }
        }
      }
    },
    {
      "subId": "1102310",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110231002"
        ],
        "dialogs": {
          "110231002": {
            "id": "110231002",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "What will we find ahead...?",
            "nextDialogs": [
              "110231003"
            ]
          },
          "110231003": {
            "id": "110231003",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Salt. And betrayal."
          }
        }
      }
    }
  ]
}
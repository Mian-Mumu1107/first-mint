  },
  "subQuests": [
    {
      "subId": "2003401",
      "subQuestName": "Talk to Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200340101"
        ],
        "dialogs": {
          "200340101": {
            "id": "200340101",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Alright. Let's work hard today, too!",
            "nextDialogs": [
              "200340103",
              "200340107"
            ]
          },
          "200340103": {
            "id": "200340103",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Of course! Being an adventurer is really interesting!",
            "nextDialogs": [
              "200340104"
            ]
          },
          "200340104": {
            "id": "200340104",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Well... I still am a bit unfamiliar with what to do while undertaking commissions, though.",
            "nextDialogs": [
              "200340105"
            ]
          },
          "200340105": {
            "id": "200340105",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Traveler, would you mind coming with me again? I still have things I'd like to ask you.",
            "nextDialogs": [
              "200340108"
            ]
          },
          "200340108": {
            "id": "200340108",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Then let's set out. Today's commission is...",
            "nextDialogs": [
              "200340109"
            ]
          },
          "200340109": {
            "id": "200340109",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Huh... So we're escorting... another transport balloon."
          },
          "200340107": {
            "id": "200340107",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Would you? Hehe, sure! There's still so much I could learn from you."
          }
        }
      }
    },
    {
      "subId": "2003402",
      "subQuestName": "Go with Anna to complete her Adventurers' Guild commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200340201"
        ],
        "dialogs": {
          "200340201": {
            "id": "200340201",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Fischl. You ran off too quickly! That was really risky...",
            "nextDialogs": [
              "200340202"
            ]
          },
          "200340202": {
            "id": "200340202",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Hah! Mine thundering retribution spares not any evildoers...",
            "nextDialogs": [
              "200340203"
            ]
          },
          "200340203": {
            "id": "200340203",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Oh, it's Fischl and Bennett! Hello there!",
            "nextDialogs": [
              "200340204"
            ]
          },
          "200340204": {
            "id": "200340204",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Oh, it's you, Anna. And the Traveler, too! Are you on a commission?",
            "nextDialogs": [
              "200340205"
            ]
          },
          "200340205": {
            "id": "200340205",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "Ah, you have arrived, O you who art blessed by the Prinzessin! Surely were you led here by the weft of fate.",
            "nextDialogs": [
              "200340206"
            ]
          },
          "200340206": {
            "id": "200340206",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "Mein Fräulein wishes to say that she is pleased to have met you by chance.",
            "nextDialogs": [
              "200340207"
            ]
          },
          "200340207": {
            "id": "200340207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm accompanying Anna on her commission.",
            "nextDialogs": [
              "200340208"
            ]
          },
          "200340208": {
            "id": "200340208",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "That's right. The Traveler and I were just escorting this transport balloon.",
            "nextDialogs": [
              "200340209"
            ]
          },
          "200340209": {
            "id": "200340209",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "But all of a sudden, a whole bunch of Treasure Hoarders came charging at us...",
            "nextDialogs": [
              "200340210"
            ]
          },
          "200340210": {
            "id": "200340210",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Uh, I'm terribly sorry about that. That was my fault.",
            "nextDialogs": [
              "200340211"
            ]
          },
          "200340211": {
            "id": "200340211",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Fischl and I accepted a commission to investigate the whereabouts of a certain band of Treasure Hoarders.",
            "nextDialogs": [
              "200340212"
            ]
          },
          "200340212": {
            "id": "200340212",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Oz managed to catch their trail, and we were about to capture them... And then I tripped over a branch and fell over.",
            "nextDialogs": [
              "200340213"
            ]
          },
          "200340213": {
            "id": "200340213",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "The noise startled those Treasure Hoarders, who turned and fled. We had no choice but to keep chasing them...",
            "nextDialogs": [
              "200340214"
            ]
          },
          "200340214": {
            "id": "200340214",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "There was never any reason to fret. The violet light of conviction was ever fated to sever the destinies of those foul rogues.",
            "nextDialogs": [
              "200340215"
            ]
          },
          "200340215": {
            "id": "200340215",
            "speakerId": 10012,
            "speakerName": "Oz",
            "text": "But Mein Fräulein, was it not the Traveler who ultimately apprehended them?",
            "nextDialogs": [
              "200340216"
            ]
          },
          "200340216": {
            "id": "200340216",
            "speakerId": 10011,
            "speakerName": "Fischl",
            "text": "O—Oz!",
            "nextDialogs": [
              "200340217"
            ]
          },
          "200340217": {
            "id": "200340217",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "W—Well, anyway, thanks for your help this time. It really was fortunate that you were there to bar their path.",
            "nextDialogs": [
              "200340218"
            ]
          },
          "200340218": {
            "id": "200340218",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Looks like my luck's pretty good today, huh!",
            "nextDialogs": [
              "200340219"
            ]
          },
          "200340219": {
            "id": "200340219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Glad I could help.",
            "nextDialogs": [
              "200340220"
            ]
          },
          "200340220": {
            "id": "200340220",
            "speakerId": 1024,
            "speakerName": "Bennett",
            "text": "Hehe. Well then, guess we'll haul these Treasure Hoarders back to the Guild. Be careful now — and don't forget to watch your step!"
          }
        }
      }
    },
    {
      "subId": "2003403",
      "subQuestName": "Go with Anna to complete her Adventurers' Guild commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200340301"
        ],
        "dialogs": {
          "200340301": {
            "id": "200340301",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Bennett's as reliable as ever, I see.",
            "nextDialogs": [
              "200340302"
            ]
          },
          "200340302": {
            "id": "200340302",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "And Fischl... Her words are as impressive as ever!",
            "nextDialogs": [
              "200340304",
              "200340309"
            ]
          },
          "200340304": {
            "id": "200340304",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "My impression of him?",
            "nextDialogs": [
              "200340305"
            ]
          },
          "200340305": {
            "id": "200340305",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "When I first joined the Guild, he answered a lot of my questions and gave me lots of assistance.",
            "nextDialogs": [
              "200340306"
            ]
          },
          "200340306": {
            "id": "200340306",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "But I've heard that he has especially bad luck.",
            "nextDialogs": [
              "200340307"
            ]
          },
          "200340307": {
            "id": "200340307",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "That's just not fair. He's such a nice person...",
            "nextDialogs": [
              "200340313"
            ]
          },
          "200340313": {
            "id": "200340313",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Well, guess we've finished this commission either way. Thank you, Traveler. I'm going to report back to the Guild now.",
            "nextDialogs": [
              "200340314"
            ]
          },
          "200340314": {
            "id": "200340314",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Still, why did I get transport balloon escort a few days in a row? Doesn't the Guild have any other commissions?"
          },
          "200340309": {
            "id": "200340309",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Fischl? Well, um...",
            "nextDialogs": [
              "200340310"
            ]
          },
          "200340310": {
            "id": "200340310",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Sh—She's really awesome as well! Her archery is great, and she's cleared lots of commissions.",
            "nextDialogs": [
              "200340311"
            ]
          },
          "200340311": {
            "id": "200340311",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I don't really understand the things that she says...",
            "nextDialogs": [
              "200340312"
            ]
          },
          "200340312": {
            "id": "200340312",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "But she's still a very experienced adventurer. W—Wait, no, she's an investigator!"
          }
        }
      }
    },
    {
      "subId": "2003404",
      "subQuestName": "Fend off the Treasure Hoarders",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200340401"
        ],
        "dialogs": {
          "200340401": {
            "id": "200340401",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Please take care of Anna, Traveler. Her excitement might have gotten to her head lately...",
            "nextDialogs": [
              "200340402"
            ]
          },
          "200340402": {
            "id": "200340402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you not want her to become an adventurer?",
            "nextDialogs": [
              "200340403"
            ]
          },
          "200340403": {
            "id": "200340403",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "...",
            "nextDialogs": [
              "200340404"
            ]
          },
          "200340404": {
            "id": "200340404",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "I respect my sister's wishes.",
            "nextDialogs": [
              "200340405"
            ]
          },
          "200340405": {
            "id": "200340405",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Now that she's well again after such a long struggle with her illness, she deserves a chance to pursue her dreams.",
            "nextDialogs": [
              "200340406"
            ]
          },
          "200340406": {
            "id": "200340406",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "As her brother, I'll support her... all the way.",
            "nextDialogs": [
              "200340407"
            ]
          },
          "200340407": {
            "id": "200340407",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "That's all I have to say."
          }
        }
      }
    },

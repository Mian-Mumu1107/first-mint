    {
      "subId": "801112",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80110601"
        ],
        "dialogs": {
          "80110601": {
            "id": "80110601",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Caribert! Oh, thank goodness. He's still okay.",
            "nextDialogs": [
              "80110604"
            ]
          },
          "80110604": {
            "id": "80110604",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I... I have a strange feeling that what just happened was meant to be.",
            "nextDialogs": [
              "80110605"
            ]
          },
          "80110605": {
            "id": "80110605",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "For this to happen right at the moment when I was dreading worshiping at a Statue of The Seven... it's as if fate was calling to me.",
            "nextDialogs": [
              "80110606"
            ]
          },
          "80110606": {
            "id": "80110606",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "You say that I bowed before that thing, so perhaps... it might be just as effective?"
          }
        }
      }
    },

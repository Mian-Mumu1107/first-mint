    {
      "subId": "801101",
      "subQuestName": "Follow the hilichurl",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80110101"
        ],
        "dialogs": {
          "80110101": {
            "id": "80110101",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "That's... that's not Caribert.",
            "nextDialogs": [
              "80110104"
            ]
          },
          "80110104": {
            "id": "80110104",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Right. Caribert's scarf was a gift I once gave to his mother. I use it now as a marker of sorts.",
            "nextDialogs": [
              "80110105"
            ]
          },
          "80110105": {
            "id": "80110105",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "M—My eyes must be going... how could I not recognize my own son? Ugh, this decrepit body of mine... *sigh*"
          }
        }
      }
    },
    {
      "subId": "801102",
      "subQuestName": "Follow the hilichurl",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80110201"
        ],
        "dialogs": {
          "80110201": {
            "id": "80110201",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "What a ghastly place... Has it always existed? I swear I've never noticed it before...",
            "nextDialogs": [
              "80110204"
            ]
          },
          "80110204": {
            "id": "80110204",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Huh. It looks like they're... worshiping. Sometimes walking, sometimes kneeling in worship... And it appears to be in earnest.",
            "nextDialogs": [
              "80110205"
            ]
          },
          "80110205": {
            "id": "80110205",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I've never seen anything like this in all my life. What in the world does this place conceal?",
            "nextDialogs": [
              "80110206"
            ]
          },
          "80110206": {
            "id": "80110206",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Oh, there's only one way to find out.",
            "nextDialogs": [
              "80110207"
            ]
          },
          "80110207": {
            "id": "80110207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(The air here, and this creepy scene... it's eerily familiar...)"
          }
        }
      }
    },
    {
      "subId": "801114",
      "subQuestName": "Follow the hilichurl to the cavern",

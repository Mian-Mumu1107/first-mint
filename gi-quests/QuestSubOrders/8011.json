    {
      "subId": "801108",
      "subQuestName": "Talk to Eide",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80110401"
        ],
        "dialogs": {
          "80110401": {
            "id": "80110401",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Who was that? He was... he was...",
            "nextDialogs": [
              "80110404"
            ]
          },
          "80110404": {
            "id": "80110404",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "...He was a perfect being. I'm in awe.",
            "nextDialogs": [
              "80110405"
            ]
          },
          "80110405": {
            "id": "80110405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Huh?",
            "nextDialogs": [
              "80110406"
            ]
          },
          "80110406": {
            "id": "80110406",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "He had the most wondrous aura, a perilous yet beautiful power... Truly mesmerizing.",
            "nextDialogs": [
              "80110407"
            ]
          },
          "80110407": {
            "id": "80110407",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "And yet you were able to defeat him. Your strength is greater than I had imagined. Hehe..."
          }
        }
      }
    },

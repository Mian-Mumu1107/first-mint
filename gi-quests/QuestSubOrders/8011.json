    {
      "subId": "801103",
      "subQuestName": "Follow the hilichurl to the cavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80110301"
        ],
        "dialogs": {
          "80110301": {
            "id": "80110301",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Halt, humans. Fate has not granted you the right to enter this place...",
            "nextDialogs": [
              "80110302"
            ]
          },
          "80110302": {
            "id": "80110302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(An Abyss Herald? No, he doesn't look like someone from the Abyss Order...)",
            "nextDialogs": [
              "80110303"
            ]
          },
          "80110303": {
            "id": "80110303",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Hmm, do you insist on an audience?",
            "nextDialogs": [
              "80110304"
            ]
          },
          "80110304": {
            "id": "80110304",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "...Very well, then I grant you the trial of destiny."
          }
        }
      }
    },
    {
      "subId": "801104",
      "subQuestName": "Talk to Eide",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "801105",
      "subQuestName": "Continue exploring",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80110501"
        ],
        "dialogs": {
          "80110501": {
            "id": "80110501",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I think... we've made it to the end...",
            "nextDialogs": [
              "80110502"
            ]
          },
          "80110502": {
            "id": "80110502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What is that thing!?",
            "nextDialogs": [
              "80110503"
            ]
          },
          "80110503": {
            "id": "80110503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Wrapped in chains, hanging in midair, emanating a sinister aura... There's no mistaking it. It's just like the Defiled Statue!)",
            "nextDialogs": [
              "80110504"
            ]
          },
          "80110504": {
            "id": "80110504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(So it does have something to do with the Abyss Order. And these worshiping hilichurls remind me a little too much of the Grand Thief...)",
            "nextDialogs": [
              "80110505"
            ]
          },
          "80110505": {
            "id": "80110505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Eide, this place is bad news. We've got to go!",
            "nextDialogs": [
              "80110506"
            ]
          },
          "80110506": {
            "id": "80110506",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "...",
            "nextDialogs": [
              "80110507"
            ]
          },
          "80110507": {
            "id": "80110507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Eide?",
            "nextDialogs": [
              "80110508"
            ]
          },
          "80110508": {
            "id": "80110508",
            "speakerId": 1002,
            "speakerName": "Voice Inside the Head",
            "text": "...O dear creature, why do you bow down? For fear of the unknown? Or for a power that you covet?",
            "nextDialogs": [
              "80110509"
            ]
          },
          "80110509": {
            "id": "80110509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Whose voice is that? It must be coming from right inside my head... Can't Eide hear it?)",
            "nextDialogs": [
              "80110510"
            ]
          },
          "80110510": {
            "id": "80110510",
            "speakerId": 1002,
            "speakerName": "Voice Inside the Head",
            "text": "...O dear creature, why do you bow down? For I am no god... I am but a \"Sinner.\"",
            "nextDialogs": [
              "80110511"
            ]
          },
          "80110511": {
            "id": "80110511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(A \"Sinner\"...?)",
            "nextDialogs": [
              "80110512"
            ]
          },
          "80110512": {
            "id": "80110512",
            "speakerId": 1002,
            "speakerName": "Voice Inside the Head",
            "text": "You are like a flower born in sin yet pure, spotless... I know your fate well.",
            "nextDialogs": [
              "80110513"
            ]
          },
          "80110513": {
            "id": "80110513",
            "speakerId": 1002,
            "speakerName": "Voice Inside the Head",
            "text": "You need no longer hold back your resentment, nor accept the countless lies.",
            "nextDialogs": [
              "80110514"
            ]
          },
          "80110514": {
            "id": "80110514",
            "speakerId": 1002,
            "speakerName": "Voice Inside the Head",
            "text": "Go forth, become a transcendent one, rise beyond the fate bestowed upon you...",
            "nextDialogs": [
              "80110515"
            ]
          },
          "80110515": {
            "id": "80110515",
            "speakerId": 1002,
            "speakerName": "Voice Inside the Head",
            "text": "And I shall shed a tear at the end of time... as I gaze back upon your life.",
            "nextDialogs": [
              "80110516"
            ]
          },
          "80110516": {
            "id": "80110516",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(...Who in the world are you? What do these words mean?)",
            "nextDialogs": [
              "80110517"
            ]
          },
          "80110517": {
            "id": "80110517",
            "speakerId": 1002,
            "speakerName": "Voice Inside the Head",
            "text": "...",
            "nextDialogs": [
              "80110518"
            ]
          },
          "80110518": {
            "id": "80110518",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(The voice... it's gone...)",
            "nextDialogs": [
              "80110519"
            ]
          },
          "80110519": {
            "id": "80110519",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "!!!",
            "nextDialogs": [
              "80110520"
            ]
          },
          "80110520": {
            "id": "80110520",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Eide?",
            "nextDialogs": [
              "80110521"
            ]
          },
          "80110521": {
            "id": "80110521",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "*pant* *pant* ...What just happened?",
            "nextDialogs": [
              "80110522"
            ]
          },
          "80110522": {
            "id": "80110522",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "When I saw that thing, my heart was instantly at peace... I—I was overcome by a sense of awe... or joy, perhaps.",
            "nextDialogs": [
              "80110523"
            ]
          },
          "80110523": {
            "id": "80110523",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you alright now?",
            "nextDialogs": [
              "80110524"
            ]
          },
          "80110524": {
            "id": "80110524",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I am... I feel good, in fact... I—I feel better than I did before I came in here. How peculiar...",
            "nextDialogs": [
              "80110525"
            ]
          },
          "80110525": {
            "id": "80110525",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Something's not right about this place. We need to get out of here.",
            "nextDialogs": [
              "80110526"
            ]
          },
          "80110526": {
            "id": "80110526",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Oh, i—is that so? Alright, as you wish."
          }
        }
      }
    },

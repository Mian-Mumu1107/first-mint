    {
      "subId": "7306329",
      "subQuestName": "Talk to Aragaru",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730632901"
        ],
        "dialogs": {
          "730632901": {
            "id": "730632901",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Aragaru just needs to talk to the Barsam Flower, right?",
            "nextDialogs": [
              "730632902"
            ]
          },
          "730632902": {
            "id": "730632902",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Shh! Shh! Quiet, don't wake him.",
            "nextDialogs": [
              "730632903"
            ]
          },
          "730632903": {
            "id": "730632903",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Aragaru whispers with the Barsam Flower for a while...",
            "nextDialogs": [
              "730632904"
            ]
          },
          "730632904": {
            "id": "730632904",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "The Barsam Flower was woken up from his dream by us, he is very angry.",
            "nextDialogs": [
              "730632905"
            ]
          },
          "730632905": {
            "id": "730632905",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Eh?",
            "nextDialogs": [
              "730632906"
            ]
          },
          "730632906": {
            "id": "730632906",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "But if it's for Arahaoma, then I suppose we can be forgiven.",
            "nextDialogs": [
              "730632907"
            ]
          },
          "730632907": {
            "id": "730632907",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Barsam Flower, Barsam Flower, for Arahaoma, for Mawtiyima's revival... Please join us.",
            "nextDialogs": [
              "730632908"
            ]
          },
          "730632908": {
            "id": "730632908",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Huh? Oh... Ehh?",
            "nextDialogs": [
              "730632910",
              "730632912"
            ]
          },
          "730632910": {
            "id": "730632910",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon is trying to listen to the Barsam Flower's response!",
            "nextDialogs": [
              "730632913"
            ]
          },
          "730632913": {
            "id": "730632913",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Great! The Barsam Flower agreed to adventure with us!",
            "nextDialogs": [
              "730632914"
            ]
          },
          "730632914": {
            "id": "730632914",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yay! We got the Barsam Flower!",
            "nextDialogs": [
              "730632915"
            ]
          },
          "730632915": {
            "id": "730632915",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Hmm, and... the Barsam Flower said be careful with our heads.",
            "nextDialogs": [
              "730632916"
            ]
          },
          "730632916": {
            "id": "730632916",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "What does that mean?",
            "nextDialogs": [
              "730632917"
            ]
          },
          "730632917": {
            "id": "730632917",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Protect our heads and roots, or damage will be caused when water comes...",
            "nextDialogs": [
              "730632918"
            ]
          },
          "730632918": {
            "id": "730632918",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Eh? Wait... What is that sound?",
            "nextDialogs": [
              "730632919"
            ]
          },
          "730632919": {
            "id": "730632919",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Watch out!"
          },
          "730632912": {
            "id": "730632912",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "...Paimon can't hear anything."
          }
        }
      }
    },
    {
      "subId": "7306334",

    {
      "subId": "7306331",
      "subQuestName": "Talk to Aragaru",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730633101"
        ],
        "dialogs": {
          "730633101": {
            "id": "730633101",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "This is the place!",
            "nextDialogs": [
              "730633102"
            ]
          },
          "730633102": {
            "id": "730633102",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But this is... blocked by vines? There's no way we can get in!",
            "nextDialogs": [
              "730633103"
            ]
          },
          "730633103": {
            "id": "730633103",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Hehe! Don't fret, White Floaty! Watch me."
          }
        }
      }
    },
    {
      "subId": "7306320",
      "subQuestName": "Talk to Aragaru",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730632001"
        ],
        "dialogs": {
          "730632001": {
            "id": "730632001",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wow... How did you do that, Aragaru? Paimon wants to learn this!",
            "nextDialogs": [
              "730632004"
            ]
          },
          "730632004": {
            "id": "730632004",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Heh, Aragaru can talk with vines, so the vines will make way for Aragaru! The language of vines is like singing. It's hard to learn for Nara... But if Nara wants to learn, I will teach you!",
            "nextDialogs": [
              "730632005"
            ]
          },
          "730632005": {
            "id": "730632005",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon wants to learn! Please do teach Paimon later, Aragaru!",
            "nextDialogs": [
              "730632006"
            ]
          },
          "730632006": {
            "id": "730632006",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Okay, if I don't forget you!"
          }
        }
      }
    },

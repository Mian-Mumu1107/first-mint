      }
    },
    {
      "subId": "7306316",
      "subQuestName": "Talk to Aragaru",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730631601"
        ],
        "dialogs": {
          "730631601": {
            "id": "730631601",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "The Realm of Khab is up ahead, outside the cave... But we must be careful on the way there.",
            "nextDialogs": [
              "730631602"
            ]
          },
          "730631602": {
            "id": "730631602",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "This earth is where Nara sleep. Once here were stone homes Nara made. But after they fell asleep, plants came from their dreams and became owners of this place.",
            "nextDialogs": [
              "730631603"
            ]
          },
          "730631603": {
            "id": "730631603",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh...",
            "nextDialogs": [
              "730631604"
            ]
          },
          "730631604": {
            "id": "730631604",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Does White Floaty understand?",
            "nextDialogs": [
              "730631605"
            ]
          },
          "730631605": {
            "id": "730631605",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Not really...",
            "nextDialogs": [
              "730631606"
            ]
          },
          "730631606": {
            "id": "730631606",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Because Floaty is silly.",
            "nextDialogs": [
              "730631609"
            ]
          },
          "730631609": {
            "id": "730631609",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hey, whose side are you on!?"
          }
        }
      }
    },

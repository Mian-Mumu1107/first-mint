    {
      "subId": "7306336",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730633601"
        ],
        "dialogs": {
          "730633601": {
            "id": "730633601",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ahhh! *cough* *cough* *cough* Wh—Why did so much water gush out!? Paimon almost got drowned!",
            "nextDialogs": [
              "730633606",
              "730633605"
            ]
          },
          "730633606": {
            "id": "730633606",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Because the Realm of Khab is the Barsam Flower's dream. When the Barsam Flower wakes up, the dream will disperse into the air.",
            "nextDialogs": [
              "730633607"
            ]
          },
          "730633607": {
            "id": "730633607",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "So the weight of the water can't be withstood, and water will gush out! Whooo! Splash! Cool and refreshing.",
            "nextDialogs": [
              "730633608"
            ]
          },
          "730633608": {
            "id": "730633608",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmph... Let's see if you could still say the same if Paimon was washed away and never found back!",
            "nextDialogs": [
              "730633609"
            ]
          },
          "730633609": {
            "id": "730633609",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Hehe, Aragaru knows where Nara and White Floaty are. Plants can also tell me where you've gone. You'll be found!",
            "nextDialogs": [
              "730633610"
            ]
          },
          "730633610": {
            "id": "730633610",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "We have the Barsam Flower now, so next is to find the Zohrah Mushroom and the Yajna Grass before we can ask Aranaga to make the Arahaoma!"
          },
          "730633605": {
            "id": "730633605",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hey!"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7306322",
      "subQuestName": "Explore the Realm of Khab",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7306323",
      "subQuestName": "Talk to Aragaru",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730632301"
        ],
        "dialogs": {
          "730632301": {
            "id": "730632301",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "This is the Realm of Khab! This is where plants' sweet dreams hide!",
            "nextDialogs": [
              "730632302"
            ]
          },
          "730632302": {
            "id": "730632302",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "See? Growing over there is the Barsam Flower!",
            "nextDialogs": [
              "730632303"
            ]
          },
          "730632303": {
            "id": "730632303",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wow...",
            "nextDialogs": [
              "730632305",
              "730632307"
            ]
          },
          "730632305": {
            "id": "730632305",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yeah, a little bit too quiet... Paimon is having goosebumps...",
            "nextDialogs": [
              "730632308"
            ]
          },
          "730632308": {
            "id": "730632308",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "The Realm of Khab is very weak... Shroom-Kin came in, ate lots of nutrients, but the Barsam Flower is not hurt... Not yet.",
            "nextDialogs": [
              "730632309"
            ]
          },
          "730632309": {
            "id": "730632309",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Let's go lift his seal, then talk to him!",
            "nextDialogs": [
              "730632310"
            ]
          },
          "730632310": {
            "id": "730632310",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Okay, we'll lift the seal. Then you can go talk to him!"
          },
          "730632307": {
            "id": "730632307",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmm... Why does it look so odd...?"
          }
        }
      }
    },

    {
      "subId": "7306311",
      "subQuestName": "Investigate the rune surrounded by Fungi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730631101"
        ],
        "dialogs": {
          "730631101": {
            "id": "730631101",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Here, look!",
            "nextDialogs": [
              "730631102"
            ]
          },
          "730631102": {
            "id": "730631102",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "What's this...? It looks like a child's drawing... What's it supposed to be?",
            "nextDialogs": [
              "730631103"
            ]
          },
          "730631103": {
            "id": "730631103",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Memory! Aranara memories can store in tubers, in seeds, can flow in leaf veins... But Nara memories are carved in the stones!",
            "nextDialogs": [
              "730631104"
            ]
          },
          "730631104": {
            "id": "730631104",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Hehe, whenever the moon is high up in the sky, the three of us Aranara would come here, recall stories from the past, just like Nara!",
            "nextDialogs": [
              "730631105"
            ]
          },
          "730631105": {
            "id": "730631105",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmm... Then what's in this drawing?",
            "nextDialogs": [
              "730631106"
            ]
          },
          "730631106": {
            "id": "730631106",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "It's not a drawing, it's a rune... It's a river of light, and in it are flower stems blooming with stars. The river and stars send us brave Nara.",
            "nextDialogs": [
              "730631107"
            ]
          },
          "730631107": {
            "id": "730631107",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "The Grandmaster of Verdure cultivated the bud of wisdom in the hearts of brave Nara and let Aranara guide them... to the glimmering water cave.",
            "nextDialogs": [
              "730631108"
            ]
          },
          "730631108": {
            "id": "730631108",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Hmm... That's it. There are other runes nearby. Let's go and see them."
          }
        }
      }
    },

    {
      "subId": "7306305",
      "subQuestName": "Talk to the Aranara that suddenly appeared",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730630501"
        ],
        "dialogs": {
          "730630501": {
            "id": "730630501",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Golden Nara and White Floaty, you are here! I am Aragaru!",
            "nextDialogs": [
              "730630502"
            ]
          },
          "730630502": {
            "id": "730630502",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Plants and mushrooms told me you would come, I have waited a very long time!",
            "nextDialogs": [
              "730630503"
            ]
          },
          "730630503": {
            "id": "730630503",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Eh...? You know us...? Do you need us for something?",
            "nextDialogs": [
              "730630504"
            ]
          },
          "730630504": {
            "id": "730630504",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Yes! Something big, very big!!!",
            "nextDialogs": [
              "730630505"
            ]
          },
          "730630505": {
            "id": "730630505",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Whoa, slow down. Take your time.",
            "nextDialogs": [
              "730630506"
            ]
          },
          "730630506": {
            "id": "730630506",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Marana is growing, bigger and bigger. Forests are afraid to speak, afraid to breathe... Marana wants to eat them...",
            "nextDialogs": [
              "730630507"
            ]
          },
          "730630507": {
            "id": "730630507",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "To stop Marana, Aranaga is busy preparing the Arahaoma ritual. But Arahaoma... still needs the Barsam Flower.",
            "nextDialogs": [
              "730630508"
            ]
          },
          "730630508": {
            "id": "730630508",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon sees... But where can we find this Barsam Flower?",
            "nextDialogs": [
              "730630510"
            ]
          },
          "730630510": {
            "id": "730630510",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Heehee, Baaaarsaaam Flooower! Impressive, huh?",
            "nextDialogs": [
              "730630512"
            ]
          },
          "730630512": {
            "id": "730630512",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "The Barsam Flower is at where mushrooms grow. The place was Nara's home many, many moonrises and moonsets ago.",
            "nextDialogs": [
              "730630513"
            ]
          },
          "730630513": {
            "id": "730630513",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "But then... wet dirt covered Nara's dreams, and new plants grew in their memories. They were dried up and reborn generation after generation... That is the kind of place we want to go.",
            "nextDialogs": [
              "730630514"
            ]
          },
          "730630514": {
            "id": "730630514",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmm... Paimon doesn't quite understand, but it sounds pretty scary.",
            "nextDialogs": [
              "730630515"
            ]
          },
          "730630515": {
            "id": "730630515",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Not scary, not scary. Plants love places Nara are scared of. So, lots of plants there.",
            "nextDialogs": [
              "730630516"
            ]
          },
          "730630516": {
            "id": "730630516",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "There are runes left by Nara and Aranara there, for not forgetting and for recalling after forgetting. Go there and find the Barsam Flower!",
            "nextDialogs": [
              "730630517"
            ]
          },
          "730630517": {
            "id": "730630517",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmm... Then let's go to the place Aragaru's talking about!",
            "nextDialogs": [
              "730630518"
            ]
          },
          "730630518": {
            "id": "730630518",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Oh, right! And also Kusava!",
            "nextDialogs": [
              "730630519"
            ]
          },
          "730630519": {
            "id": "730630519",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "With Kusava, Aranara strong, strong! Can clear the path for everyone! Aragaru can smash the rocks! Hah! Yah! Boom!",
            "nextDialogs": [
              "730630520"
            ]
          },
          "730630520": {
            "id": "730630520",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Aragaru is so tiny, but so strong!",
            "nextDialogs": [
              "730630521"
            ]
          },
          "730630521": {
            "id": "730630521",
            "speakerId": 1001,
            "speakerName": "Aragaru",
            "text": "Hehe, yes, very strong! Hmm... But it has to be a cracked rock with green vines. Ones with no cracks, not strong enough to smash them."
          }
        }
      }
    },

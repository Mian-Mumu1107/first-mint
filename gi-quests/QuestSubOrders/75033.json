  "subQuests": [
    {
      "subId": "7503301",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750330101"
        ],
        "dialogs": {
          "750330101": {
            "id": "750330101",
            "speakerId": 1000,
            "speakerName": "Acomitl",
            "text": "Why must I persist? Why can't I just give up...? Forget it, I give up! Help me, Manyoya.",
            "nextDialogs": [
              "750330102"
            ]
          },
          "750330102": {
            "id": "750330102",
            "speakerId": 1001,
            "speakerName": "Matahga",
            "text": "What an embarrassment! Stop acting like a child and giving up whenever things don't go smoothly. How can you even call yourself a warrior? I'm ashamed to call you my brother.",
            "nextDialogs": [
              "750330103"
            ]
          },
          "750330103": {
            "id": "750330103",
            "speakerId": 1000,
            "speakerName": "Acomitl",
            "text": "And are you telling me you've never been stumped and needed help?",
            "nextDialogs": [
              "750330104"
            ]
          },
          "750330104": {
            "id": "750330104",
            "speakerId": 1001,
            "speakerName": "Matahga",
            "text": "I have, which is why I'm here to get Father and Manyoya's opinions on the fruits of my special training. I'm not a coward like you!",
            "nextDialogs": [
              "750330105"
            ]
          },
          "750330105": {
            "id": "750330105",
            "speakerId": 1002,
            "speakerName": "Manyoya",
            "text": "Acomitl, I believe the captain rejected your resignation so that you could give it more thought. Don't make important decisions in the heat of things.",
            "nextDialogs": [
              "750330106"
            ]
          },
          "750330106": {
            "id": "750330106",
            "speakerId": 1002,
            "speakerName": "Manyoya",
            "text": "Calm down and make your own choice. The most important thing is that you don't come to regret it.",
            "nextDialogs": [
              "750330107"
            ]
          },
          "750330107": {
            "id": "750330107",
            "speakerId": 1002,
            "speakerName": "Manyoya",
            "text": "I'm retired, and even I don't know what the future holds for me, so I fear I haven't the right to give you any guidance.",
            "nextDialogs": [
              "750330108"
            ]
          },
          "750330108": {
            "id": "750330108",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Whoa! So you three are siblings!",
            "nextDialogs": [
              "750330111"
            ]
          },
          "750330111": {
            "id": "750330111",
            "speakerId": 1004,
            "speakerName": "All Three Together",
            "text": "It's you two!?",
            "nextDialogs": [
              "750330112"
            ]
          },
          "750330112": {
            "id": "750330112",
            "speakerId": 1000,
            "speakerName": "Acomitl",
            "text": "My apologies, dear benefactor. My escape plan fell through."
          }
        }
      }
    },
    {
      "subId": "7503308",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750330801"
        ],
        "dialogs": {
          "750330801": {
            "id": "750330801",
            "speakerId": 1001,
            "speakerName": "Matahga",
            "text": "Another race? Haha! Just wait and see!",
            "nextDialogs": [
              "750330802"
            ]
          },
          "750330802": {
            "id": "750330802",
            "speakerId": 1002,
            "speakerName": "Manyoya",
            "text": "You're pretty confident. C'mon, Acomitl. We can't lose here!",
            "nextDialogs": [
              "750330803"
            ]
          },
          "750330803": {
            "id": "750330803",
            "speakerId": 1000,
            "speakerName": "Acomitl",
            "text": "Losing to you is whatever, but there's no way I'm losing to Matahga!",
            "nextDialogs": [
              "750330804"
            ]
          },
          "750330804": {
            "id": "750330804",
            "speakerId": 1000,
            "speakerName": "Acomitl",
            "text": "#{NICKNAME}, be sure to give it your all, too. Don't fall for Matahga's late-game pushes. He's been doing that for ages.",
            "nextDialogs": [
              "750330805"
            ]
          },
          "750330805": {
            "id": "750330805",
            "speakerId": 1000,
            "speakerName": "Acomitl",
            "text": "When you're ready, let my father know, and we'll fly together."
          }
        }
      }
    },
    {
      "subId": "7503302",
      "subQuestName": "Talk to Xueyoni to start the air race",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750331001"
        ],
        "dialogs": {
          "750331001": {
            "id": "750331001",
            "speakerId": 1005,
            "speakerName": "Xueyoni",
            "text": "Not bad, young one! Hahahaha!",
            "nextDialogs": [
              "750331002"
            ]
          },
          "750331002": {
            "id": "750331002",
            "speakerId": 1005,
            "speakerName": "Xueyoni",
            "text": "But you'll need more practice if you want to surpass my kids. Don't take it too hard, though! It's rare for anyone to achieve success in one go.",
            "nextDialogs": [
              "750331003"
            ]
          },
          "750331003": {
            "id": "750331003",
            "speakerId": 1005,
            "speakerName": "Xueyoni",
            "text": "If you want to try again, just come find me."
          }
        }
      }
    },
    {
      "subId": "7503305",
      "subQuestName": "Complete the air race",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750330501"
        ],
        "dialogs": {
          "750330501": {
            "id": "750330501",
            "speakerId": 1001,
            "speakerName": "Matahga",
            "text": "Haha! Sorry, but I pulled ahead this time!",
            "nextDialogs": [
              "750330502"
            ]
          },
          "750330502": {
            "id": "750330502",
            "speakerId": 1000,
            "speakerName": "Acomitl",
            "text": "Gah, Matahga, you annoying little... You've been like this since forever, always going all out in the second half!",
            "nextDialogs": [
              "750330503"
            ]
          },
          "750330503": {
            "id": "750330503",
            "speakerId": 1001,
            "speakerName": "Matahga",
            "text": "Feeling bitter? Catch me if you can, then! Haha!"
          }
        }
      }
    },

    {
      "subId": "7503302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750330201"
        ],
        "dialogs": {
          "750330201": {
            "id": "750330201",
            "speakerId": 1005,
            "speakerName": "Xueyoni",
            "text": "Come and fly with my kids, young one. It's not every day you get to compete with the Flower-Feather Clan's finest.",
            "nextDialogs": [
              "750330202"
            ]
          },
          "750330202": {
            "id": "750330202",
            "speakerId": 1005,
            "speakerName": "Xueyoni",
            "text": "Chase after the <color=#00E1FFFF>flying torch</color> on the course. Whoever catches it first wins. That's how I trained them when they were little.",
            "nextDialogs": [
              "750330203"
            ]
          },
          "750330203": {
            "id": "750330203",
            "speakerId": 1005,
            "speakerName": "Xueyoni",
            "text": "<color=#00E1FFFF>The torch is held by a balloon decorated with red feathers</color>, symbolizing the responsibility and honor that a warrior should bear. I made it for them.",
            "nextDialogs": [
              "750330204"
            ]
          },
          "750330204": {
            "id": "750330204",
            "speakerId": 1005,
            "speakerName": "Xueyoni",
            "text": "You'll recognize it once you see it. So, are you up for the contest?",
            "nextDialogs": [
              "750330206",
              "750330208"
            ]
          },
          "750330206": {
            "id": "750330206",
            "speakerId": 1005,
            "speakerName": "Xueyoni",
            "text": "Haha, great! Let's head to the starting point and get ready then."
          },
          "750330208": {
            "id": "750330208",
            "speakerId": 1005,
            "speakerName": "Xueyoni",
            "text": "Let us know when you're ready then."
          }
        }
      }
    },
    {
      "subId": "7503306",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750330601"
        ],
        "dialogs": {
          "750330601": {
            "id": "750330601",
            "speakerId": 1001,
            "speakerName": "Matahga",
            "text": "#Aw, I lost again. Even after all that practice, I still lost to {M#him}{F#her}.",
            "nextDialogs": [
              "750330602"
            ]
          },
          "750330602": {
            "id": "750330602",
            "speakerId": 1000,
            "speakerName": "Acomitl",
            "text": "I told you this ages ago. There's no end to thinking about winning. Gotta admire your drive to just charge ahead without fear, though.",
            "nextDialogs": [
              "750330603"
            ]
          },
          "750330603": {
            "id": "750330603",
            "speakerId": 1002,
            "speakerName": "Manyoya",
            "text": "Well, you were like that when you were younger, too, following behind me every day, talking about how you wanted to become a master Saurian tamer...",
            "nextDialogs": [
              "750330604"
            ]
          },
          "750330604": {
            "id": "750330604",
            "speakerId": 1000,
            "speakerName": "Acomitl",
            "text": "Quit teasing me, sis...",
            "nextDialogs": [
              "750330605"
            ]
          },
          "750330605": {
            "id": "750330605",
            "speakerId": 1005,
            "speakerName": "Xueyoni",
            "text": "You are all good children of mine, and fine warriors, too — and all warriors must face different challenges at different points...",
            "nextDialogs": [
              "750330606"
            ]
          },
          "750330606": {
            "id": "750330606",
            "speakerId": 1005,
            "speakerName": "Xueyoni",
            "text": "Which is fine. So long as your consciences are clear, I am proud of you."
          }
        }
      }
    },
    {
      "subId": "7503311",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750331101"
        ],
        "dialogs": {
          "750331101": {
            "id": "750331101",
            "speakerId": 1005,
            "speakerName": "Xueyoni",
            "text": "Not bad, young one! Hahahaha!",
            "nextDialogs": [
              "750331102"
            ]
          },
          "750331102": {
            "id": "750331102",
            "speakerId": 1005,
            "speakerName": "Xueyoni",
            "text": "But you'll need more practice if you want to surpass my kids. Don't take it too hard, though! It's rare for anyone to achieve success in one go.",
            "nextDialogs": [
              "750331103"
            ]
          },
          "750331103": {
            "id": "750331103",
            "speakerId": 1005,
            "speakerName": "Xueyoni",
            "text": "If you want to try again, just come find me."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2400401",
      "subQuestName": "Ask the two brothers on the ground",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240040101"
        ],
        "dialogs": {
          "240040101": {
            "id": "240040101",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Brother, let's hide over there. I bet it'll be better than the location she picked!",
            "nextDialogs": [
              "240040102"
            ]
          },
          "240040102": {
            "id": "240040102",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Hey, Verut, stay close to me! If you get lost, I won't be able to find you right away, you know!",
            "nextDialogs": [
              "240040105"
            ]
          },
          "240040105": {
            "id": "240040105",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Hey, it's you! Are you free by any chance? C'mon, hide with us! Lovi's probably hidden herself already.",
            "nextDialogs": [
              "240040106"
            ]
          },
          "240040106": {
            "id": "240040106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell me about Lovi...",
            "nextDialogs": [
              "240040107"
            ]
          },
          "240040107": {
            "id": "240040107",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "There's no time, c'mon! She knows this place really well... We need to find a better hiding spot!",
            "nextDialogs": [
              "240040108"
            ]
          },
          "240040108": {
            "id": "240040108",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Verut leaves in a hurry...",
            "nextDialogs": [
              "240040109"
            ]
          },
          "240040109": {
            "id": "240040109",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "*sigh* Verut... When will he listen...",
            "nextDialogs": [
              "240040110"
            ]
          },
          "240040110": {
            "id": "240040110",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Sorry, but I'll have to trouble you to go another round with us. Verut's really excited, for... whatever reason..."
          }
        }
      }
    },
    {
      "subId": "2400402",
      "subQuestName": "Find all the hiding kids",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240040201"
        ],
        "dialogs": {
          "240040201": {
            "id": "240040201",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "...I think I've read this page before.",
            "nextDialogs": [
              "240040204"
            ]
          },
          "240040204": {
            "id": "240040204",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Huh. You sure arrived quickly. I had only just started reading.",
            "nextDialogs": [
              "240040205"
            ]
          },
          "240040205": {
            "id": "240040205",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Lovi's father got her to pass this book to me. He even said that I could ask him about anything I didn't understand in it.",
            "nextDialogs": [
              "240040206"
            ]
          },
          "240040206": {
            "id": "240040206",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "But in truth... Heh. What is there in this book that I *do* understand...",
            "nextDialogs": [
              "240040207"
            ]
          },
          "240040207": {
            "id": "240040207",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Anyway, leaving that aside, I'll head back to our meeting point. You did find me, after all, and the rules are the rules."
          }
        }
      }
    },
    {
      "subId": "2400403",
      "subQuestName": "Find all the hiding kids",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240040301"
        ],
        "dialogs": {
          "240040301": {
            "id": "240040301",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Agh, you found me so quickly! I was just planning on switching locations...",
            "nextDialogs": [
              "240040302"
            ]
          },
          "240040302": {
            "id": "240040302",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Now I'll have to go back to the meeting point..."
          }
        }
      }
    },
    {
      "subId": "2400404",
      "subQuestName": "Find all the hiding kids",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240040401"
        ],
        "dialogs": {
          "240040401": {
            "id": "240040401",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Ugh, so you found me... Huh? Wait, who are you?",
            "nextDialogs": [
              "240040402"
            ]
          },
          "240040402": {
            "id": "240040402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A friend of Aurele and Verut.",
            "nextDialogs": [
              "240040403"
            ]
          },
          "240040403": {
            "id": "240040403",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Oh! They mentioned you before... Verut said you're really good at this.",
            "nextDialogs": [
              "240040404"
            ]
          },
          "240040404": {
            "id": "240040404",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Well, guess I got to see it for myself today. You really are good at this, huh?",
            "nextDialogs": [
              "240040405"
            ]
          },
          "240040405": {
            "id": "240040405",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "You got me good. Guess I'll head back to the meeting spot, then."
          }
        }
      }
    },
    {
      "subId": "2400405",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240040501"
        ],
        "dialogs": {
          "240040501": {
            "id": "240040501",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Why are you looking at me like that?",
            "nextDialogs": [
              "240040502"
            ]
          },
          "240040502": {
            "id": "240040502",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "You were secretly reading a book again, weren't you? You weren't playing seriously at all!",
            "nextDialogs": [
              "240040503"
            ]
          },
          "240040503": {
            "id": "240040503",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "That's right. Come on! Be serious!",
            "nextDialogs": [
              "240040504"
            ]
          },
          "240040504": {
            "id": "240040504",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Well, the two of you took the good spots, and I'm not very good at this... so I just went to read to pass the time, you know?",
            "nextDialogs": [
              "240040505"
            ]
          },
          "240040505": {
            "id": "240040505",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Bleh! You're a lying liar!",
            "nextDialogs": [
              "240040506"
            ]
          },
          "240040506": {
            "id": "240040506",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Hmph! Bookworm!",
            "nextDialogs": [
              "240040507"
            ]
          },
          "240040507": {
            "id": "240040507",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Seriously? Spare me...",
            "nextDialogs": [
              "240040510"
            ]
          },
          "240040510": {
            "id": "240040510",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Hehe, Lovi's really good at hide-and-seek. She knows all sorts of interesting hiding spots.",
            "nextDialogs": [
              "240040517"
            ]
          },
          "240040517": {
            "id": "240040517",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Hehehe, this place is pretty awesome when Lovi's around!",
            "nextDialogs": [
              "240040511"
            ]
          },
          "240040511": {
            "id": "240040511",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Verut climbs walls super fast, and he's really strong. He gave me a hand quite a few times.",
            "nextDialogs": [
              "240040512"
            ]
          },
          "240040512": {
            "id": "240040512",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "As long as we go together, I bet no one but you would be able to find us!",
            "nextDialogs": [
              "240040513"
            ]
          },
          "240040513": {
            "id": "240040513",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "Alright, I think we're more or less done for the day. Let's send you home first, Lovi.",
            "nextDialogs": [
              "240040514"
            ]
          },
          "240040514": {
            "id": "240040514",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "And then... you're gonna ask my dad questions again, right?",
            "nextDialogs": [
              "240040515"
            ]
          },
          "240040515": {
            "id": "240040515",
            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "W—Well, there are some things that I'll need to consult him about, you know...",
            "nextDialogs": [
              "240040516"
            ]
          },
          "240040516": {
            "id": "240040516",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Well, sure, my dad's definitely going to be home right now, so let's head back. My mom said that the two of you should stay for dinner, you know..."
          }
        }
      }
    },

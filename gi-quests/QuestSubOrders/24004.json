            "speakerId": 5063,
            "speakerName": "Aurele",
            "text": "This page is about...",
            "nextDialogs": [
              "240049902"
            ]
          },
          "240049902": {
            "id": "240049902",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Can't find me...",
            "nextDialogs": [
              "240049903"
            ]
          },
          "240049903": {
            "id": "240049903",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Hehe, not gonna catch me!",
            "nextDialogs": [
              "240049904"
            ]
          },
          "240049904": {
            "id": "240049904",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "I'm not gonna get found this time, hehe...",
            "nextDialogs": [
              "240049905"
            ]
          },
          "240049905": {
            "id": "240049905",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "No problems here..."
          }
        }
      }
    }

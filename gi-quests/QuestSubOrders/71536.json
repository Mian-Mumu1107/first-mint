  "subQuests": [
    {
      "subId": "7153601",
      "subQuestName": "Wait till 08:00 – 18:00 the next day",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715360101"
        ],
        "dialogs": {
          "715360101": {
            "id": "715360101",
            "speakerId": 1000,
            "speakerName": "Candace",
            "text": "#Happy Lantern Rite, {NICKNAME}. I heard about how you helped Dehya with the gift envelope. It was beautiful, thank you.",
            "nextDialogs": [
              "715360102"
            ]
          },
          "715360102": {
            "id": "715360102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Everything is settled back at the village, I'm guessing?",
            "nextDialogs": [
              "715360103"
            ]
          },
          "715360103": {
            "id": "715360103",
            "speakerId": 1000,
            "speakerName": "Candace",
            "text": "Yes, it's all thanks to Dehya and the others. I can rest a little easier knowing the village is still protected while I'm gone.",
            "nextDialogs": [
              "715360104"
            ]
          },
          "715360104": {
            "id": "715360104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Take this time to get some good rest.",
            "nextDialogs": [
              "715360105"
            ]
          },
          "715360105": {
            "id": "715360105",
            "speakerId": 1000,
            "speakerName": "Candace",
            "text": "I will. Dehya wants to visit Qiaoying Village in a few days.",
            "nextDialogs": [
              "715360106"
            ]
          },
          "715360106": {
            "id": "715360106",
            "speakerId": 1000,
            "speakerName": "Candace",
            "text": "She said the scenery is beautiful, and the village is known for their tea. It's a perfect gift for the people back home.",
            "nextDialogs": [
              "715360107"
            ]
          },
          "715360107": {
            "id": "715360107",
            "speakerId": 1000,
            "speakerName": "Candace",
            "text": "I was planning to follow the tradition here and make a few gift envelopes for them.",
            "nextDialogs": [
              "715360108"
            ]
          },
          "715360108": {
            "id": "715360108",
            "speakerId": 1000,
            "speakerName": "Candace",
            "text": "But, Dehya packed our schedule to the brim, and with all the running around, I'm not sure I'll have the time...",
            "nextDialogs": [
              "715360109"
            ]
          },
          "715360109": {
            "id": "715360109",
            "speakerId": 1000,
            "speakerName": "Candace",
            "text": "Dehya told me you're good at making gift envelopes. Could you show me how to make one?",
            "nextDialogs": [
              "715360110"
            ]
          },
          "715360110": {
            "id": "715360110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Of course, just leave it to me."
          }
        }
      }
    },

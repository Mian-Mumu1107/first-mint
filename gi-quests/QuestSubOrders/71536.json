        ],
        "dialogs": {
          "715360301": {
            "id": "715360301",
            "speakerId": 1000,
            "speakerName": "Candace",
            "text": "#So, that's how it's done... This gift envelope is wonderful, {NICKNAME}, thank you.",
            "nextDialogs": [
              "715360302"
            ]
          },
          "715360302": {
            "id": "715360302",
            "speakerId": 1000,
            "speakerName": "Candace",
            "text": "Now, I just need to make a few more to give alongside the souvenirs I bought. I'm sure the people back home will love them.",
            "nextDialogs": [
              "715360303"
            ]
          },
          "715360303": {
            "id": "715360303",
            "speakerId": 1000,
            "speakerName": "Candace",
            "text": "But, this one... I'm keeping just for me."
          }
        }
      }
    },

          },
          "705400102": {
            "id": "705400102",
            "speakerId": 1001,
            "speakerName": "Valerina",
            "text": "*whimper*... The cat is hissing at me, Miss Rosaria! I'm scared!",
            "nextDialogs": [
              "705400103"
            ]
          },
          "705400103": {
            "id": "705400103",
            "speakerId": 1002,
            "speakerName": "Rosaria",
            "text": "You should probably give him some space. Get too close, and all that swatting might catch you in the face.",
            "nextDialogs": [
              "705400104"
            ]
          },
          "705400104": {
            "id": "705400104",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Uh oh, seems like Valerina has run into some more cat-sized trouble...",
            "nextDialogs": [
              "705400107"
            ]
          },
          "705400107": {
            "id": "705400107",
            "speakerId": 1001,
            "speakerName": "Valerina",
            "text": "Honorary Knight! Cat Whisperer! This big cat just barged in here after Snowball! He must have spotted her when she went out for a walk and followed her all the way back here...",
            "nextDialogs": [
              "705400108"
            ]
          },
          "705400108": {
            "id": "705400108",
            "speakerId": 1002,
            "speakerName": "Rosaria",
            "text": "Easy, easy. No one's going to hurt you here.",
            "nextDialogs": [
              "705400109"
            ]
          },
          "705400109": {
            "id": "705400109",
            "speakerId": 1002,
            "speakerName": "Rosaria",
            "text": "All those evil things, all those bad people who forced you to do whatever it took to survive... They can't find you here. You're safe within these walls.",
            "nextDialogs": [
              "705400110"
            ]
          },
          "705400110": {
            "id": "705400110",
            "speakerId": 1002,
            "speakerName": "Rosaria",
            "text": "You're surrounded by good people now. Their constant hovering might get a little annoying, but it's all for your own good. Just relax. A life of leisure isn't a bad thing, you know. You just have to get used to it.",
            "nextDialogs": [
              "705400111"
            ]
          },
          "705400111": {
            "id": "705400111",
            "speakerId": 1000,
            "speakerName": "Big Ferocious Cat",
            "text": "*hiss*... *whimper*",
            "nextDialogs": [
              "705400112"
            ]
          },
          "705400112": {
            "id": "705400112",
            "speakerId": 1001,
            "speakerName": "Valerina",
            "text": "H—He understood all that?",
            "nextDialogs": [
              "705400113"
            ]
          },
          "705400113": {
            "id": "705400113",
            "speakerId": 1002,
            "speakerName": "Rosaria",
            "text": "Looks like it worked. Hah, smart cat.",
            "nextDialogs": [
              "705400114"
            ]
          },
          "705400114": {
            "id": "705400114",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Woah, this cat is waaay bigger than the others. His coloring looks like fresh-squeezed Bulle Fruit juice! And he's wearing a scarf too! Huh, looks like there's some sort of design on it... Oh! It's the symbol of the Knights of Favonius!",
            "nextDialogs": [
              "705400115"
            ]
          },
          "705400115": {
            "id": "705400115",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "He deserves a name fit for a knight, then! Hmm, he's pretty feisty. How about \"Sir Pouncelot\"?",
            "nextDialogs": [
              "705400116"
            ]
          },
          "705400116": {
            "id": "705400116",
            "speakerId": 1004,
            "speakerName": "Sir Pouncelot",
            "text": "Meow!",
            "nextDialogs": [
              "705400117"
            ]
          },
          "705400117": {
            "id": "705400117",
            "speakerId": 1002,
            "speakerName": "Rosaria",
            "text": "You really do have a way with cats. He looks way more at ease now.",
            "nextDialogs": [
              "705400118"
            ]
          },
          "705400118": {
            "id": "705400118",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Paimon thinks you deserve to take the credit this time. Sir Pouncelot seemed to calm right down after everything you said to him!"
          }
        }
      }
    }
  ]

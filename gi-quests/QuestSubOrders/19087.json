            "speakerId": 1001,
            "speakerName": "Noelle's Study Notes",
            "text": "\"Windwheel Asters commonly found at Stormterror's Lair and Windrise,\" \"Hit Ruin Guards in weak spots to gain upper hand\"...",
            "nextDialogs": [
              "190871202"
            ]
          },
          "190871202": {
            "id": "190871202",
            "speakerId": 1001,
            "speakerName": "Noelle's Study Notes",
            "text": "Each and every new detail learned during the adventure is recorded in neat and tidy handwriting — though it starts to get messier as you go down the page.",
            "nextDialogs": [
              "190871203"
            ]
          },
          "190871203": {
            "id": "190871203",
            "speakerId": 1001,
            "speakerName": "Noelle's Study Notes",
            "text": "Some vague descriptions are closely followed by precise annotations adding further detail. This seems to be evidence of the writer fighting a valiant battle against sleepiness."
          }
        }
      }
    },

{
  "lineCounts": {
    "Guy": 7,
    "Jilliana": 9,
    "Paimon": 4,
    "Player": 6,
    "Tunner": 22
  },
  "subQuests": [
    {
      "subId": "2006001",
      "subQuestName": "Talk to Tunner",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600101"
        ],
        "dialogs": {
          "200600101": {
            "id": "200600101",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "Hello there, honored guest! Do you happen to know my son, Guy? *coughing*",
            "nextDialogs": [
              "200600102"
            ]
          },
          "200600102": {
            "id": "200600102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "200600103"
            ]
          },
          "200600103": {
            "id": "200600103",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "Nothing, nothing... Just a stubborn cold that won't go away.",
            "nextDialogs": [
              "200600104"
            ]
          },
          "200600104": {
            "id": "200600104",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "I saw the sisters at the <color=#00E1FFFF>Church</color> about it but they weren't able to cure it, so they just prescribed some medicine to alleviate the symptoms.",
            "nextDialogs": [
              "200600105"
            ]
          },
          "200600105": {
            "id": "200600105",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "*sigh* I'm getting old though, so I can't walk very far. I've always had Moco and Hillie help collect my medicine in the past.",
            "nextDialogs": [
              "200600106"
            ]
          },
          "200600106": {
            "id": "200600106",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "They're busy today— *coughing* <color=#00E1FFFF>Jilliana</color> knows what to do though...",
            "nextDialogs": [
              "200600107"
            ]
          },
          "200600107": {
            "id": "200600107",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "All I need is someone to take the ingredients to her, and she'll prepare it. <color=#00E1FFFF>Three Sweet Flowers</color> is all she needs.",
            "nextDialogs": [
              "200600108"
            ]
          },
          "200600108": {
            "id": "200600108",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "Okay.",
            "nextDialogs": [
              "200600109"
            ]
          },
          "200600109": {
            "id": "200600109",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "*coughing* ...Th—Thank you.",
            "nextDialogs": [
              "200600112"
            ]
          },
          "200600112": {
            "id": "200600112",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "Get three sweet flowers and take them to Sister Jilliana at the Church, who will prepare the medicine. <color=#00E1FFFF>Don't say anything to Guy.</color>",
            "nextDialogs": [
              "200600113"
            ]
          },
          "200600113": {
            "id": "200600113",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "I heard the Church has some connection with the Knights of Favonius. So now that the young'un has joined the Knights, he needs to watch the way he talks and acts...",
            "nextDialogs": [
              "200600114"
            ]
          },
          "200600114": {
            "id": "200600114",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "God forbid he ends up doing something foolish on account of his old man. That would be terrible.",
            "nextDialogs": [
              "200600115"
            ]
          },
          "200600115": {
            "id": "200600115",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "Sorry — you've listened to me drone on long enough. I'll let you go. Have a safe journey."
          }
        }
      }
    },
    {
      "subId": "2006002",
      "subQuestName": "Collect Sweet Flowers",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600201"
        ],
        "dialogs": {
          "200600201": {
            "id": "200600201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alrighty... let's find us some <color=#00E1FFFF>sweet flowers</color>."
          }
        }
      }
    },
    {
      "subId": "2006004",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600401"
        ],
        "dialogs": {
          "200600401": {
            "id": "200600401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait a sec... It looks like we've got enough sweet flowers now.",
            "nextDialogs": [
              "200600402"
            ]
          },
          "200600402": {
            "id": "200600402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Shall we take them to <color=#00E1FFFF>Sister Jilliana</color>? Or you wanna gather some more?"
          }
        }
      }
    },
    {
      "subId": "2006005",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600501"
        ],
        "dialogs": {
          "200600501": {
            "id": "200600501",
            "speakerId": 1441,
            "speakerName": "Guy",
            "text": "Oh, hey! Are those sweet flowers you're holding? This may be a little presumptuous, but can I buy one off you?",
            "nextDialogs": [
              "200600502"
            ]
          },
          "200600502": {
            "id": "200600502",
            "speakerId": 1441,
            "speakerName": "Guy",
            "text": "My dad has had this awful cough for ages; I asked Jilliana for some cough medicine, but she was out of ingredients.",
            "nextDialogs": [
              "200600504",
              "200600507"
            ]
          },
          "200600504": {
            "id": "200600504",
            "speakerId": 1441,
            "speakerName": "Guy",
            "text": "Oh... I see. Never mind then.",
            "nextDialogs": [
              "200600505"
            ]
          },
          "200600505": {
            "id": "200600505",
            "speakerId": 1441,
            "speakerName": "Guy",
            "text": "Sorry for delaying you. You'd better get to the Cathedral quickly then, Jilliana should still be there."
          },
          "200600507": {
            "id": "200600507",
            "speakerId": 1441,
            "speakerName": "Guy",
            "text": "Huh? Oh, I get it... Unfortunately though, I have to guard the gate. I can't leave my post.",
            "nextDialogs": [
              "200600508"
            ]
          },
          "200600508": {
            "id": "200600508",
            "speakerId": 1441,
            "speakerName": "Guy",
            "text": "I even had to take time out of my lunch just to go and see Jilliana.",
            "nextDialogs": [
              "200600509"
            ]
          },
          "200600509": {
            "id": "200600509",
            "speakerId": 1441,
            "speakerName": "Guy",
            "text": "Alright, looking at you it seems you're fit to deliver medicine too. I won't take up any more of your time. If you get to the Cathedral quickly, Jilliana should still be there."
          }
        }
      }
    },
    {
      "subId": "2006008",
      "subQuestName": "Give the ingredients to Jilliana",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600801"
        ],
        "dialogs": {
          "200600801": {
            "id": "200600801",
            "speakerId": 1473,
            "speakerName": "Jilliana",
            "text": "The medicine is ready. But this medicine gives relief only, it won't treat the underlying condition. If he really wants to get better, he needs to keep taking his medicine and also get plenty of rest.",
            "nextDialogs": [
              "200600802"
            ]
          },
          "200600802": {
            "id": "200600802",
            "speakerId": 1473,
            "speakerName": "Jilliana",
            "text": "I must have told him a thousand times, but it just goes in one ear and out the other. No matter who speaks to him, he just says he'll be fine, he'll get by.",
            "nextDialogs": [
              "200600803"
            ]
          },
          "200600803": {
            "id": "200600803",
            "speakerId": 1473,
            "speakerName": "Jilliana",
            "text": "Well then. You'd better take Tunner his medicine as quick as you can.",
            "nextDialogs": [
              "200600804"
            ]
          },
          "200600804": {
            "id": "200600804",
            "speakerId": 1473,
            "speakerName": "Jilliana",
            "text": "Thank you.",
            "nextDialogs": [
              "200600805"
            ]
          },
          "200600805": {
            "id": "200600805",
            "speakerId": 1473,
            "speakerName": "Jilliana",
            "text": "You're welcome. I'm just doing my duty."
          }
        }
      }
    },
    {
      "subId": "2006010",
      "subQuestName": "Report back to Tunner",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600901"
        ],
        "dialogs": {
          "200600901": {
            "id": "200600901",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "*sigh* Will this blasted thing ever clear up...",
            "nextDialogs": [
              "200600903",
              "200600905"
            ]
          },
          "200600903": {
            "id": "200600903",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "Ah, thank you.",
            "nextDialogs": [
              "200600907"
            ]
          },
          "200600907": {
            "id": "200600907",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "I feel so ashamed that my son's out there fighting the good fight and there's absolutely nothing I can do to support him.",
            "nextDialogs": [
              "200600908"
            ]
          },
          "200600908": {
            "id": "200600908",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "The only thing I can do is to avoid bothering him...",
            "nextDialogs": [
              "200600909"
            ]
          },
          "200600909": {
            "id": "200600909",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "Please take these as a token of an old man's gratitude."
          },
          "200600905": {
            "id": "200600905",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "If I was going to confine myself to bed for any length of time, I'd have to get my little rascal to come home and look after me.",
            "nextDialogs": [
              "200600906"
            ]
          },
          "200600906": {
            "id": "200600906",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "I'll be alright, these old bones haven't given up on me just yet..."
          }
        }
      }
    },
    {
      "subId": "2006003",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600301"
        ],
        "dialogs": {
          "200600301": {
            "id": "200600301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems like we got enough now. Let's go and find <color=#00E1FFFF>Sister Jilliana</color>."
          }
        }
      }
    },
    {
      "subId": "2006006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600601"
        ],
        "dialogs": {
          "200600601": {
            "id": "200600601",
            "speakerId": 1473,
            "speakerName": "Jilliana",
            "text": "It might only be a cold, but if it persists it could turn into something more serious..."
          }
        }
      }
    },
    {
      "subId": "2006007",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200600701"
        ],
        "dialogs": {
          "200600701": {
            "id": "200600701",
            "speakerId": 1473,
            "speakerName": "Jilliana",
            "text": "That Tunner, honestly...",
            "nextDialogs": [
              "200600702"
            ]
          },
          "200600702": {
            "id": "200600702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm here to have some medicine prepared.",
            "nextDialogs": [
              "200600703"
            ]
          },
          "200600703": {
            "id": "200600703",
            "speakerId": 1473,
            "speakerName": "Jilliana",
            "text": "Oh? You're new. Where are Moco and Hillie?",
            "nextDialogs": [
              "200600704"
            ]
          },
          "200600704": {
            "id": "200600704",
            "speakerId": 1473,
            "speakerName": "Jilliana",
            "text": "I see you've brought the ingredients. Let me check..."
          }
        }
      }
    },
    {
      "subId": "2006010",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200601001"
        ],
        "dialogs": {
          "200601001": {
            "id": "200601001",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "She might be a sister, but that Jilliana is a very capable lady indeed. She took one look at me and figured out what my condition was straight away. Her medicine's also cheap, and best of all, it works.",
            "nextDialogs": [
              "200601002"
            ]
          },
          "200601002": {
            "id": "200601002",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "Hahaha, the way I look at it she doesn't seem much like a sister. Far more like a seasoned hunter who's spent years out in the wild...",
            "nextDialogs": [
              "200601003"
            ]
          },
          "200601003": {
            "id": "200601003",
            "speakerId": 1533,
            "speakerName": "Tunner",
            "text": "Goodness, just listen to me! Rabbiting on and making no sense whatsoever, as always. Right, time for you to see her about my medicine — and please don't repeat any of that nonsense you just heard."
          }
        }
      }
    }
  ]
}
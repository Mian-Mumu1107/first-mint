            "id": "400340401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh. This dog isn't leaving.",
            "nextDialogs": [
              "400340402"
            ]
          },
          "400340402": {
            "id": "400340402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Is it ill?"
          }
        }
      }

    {
      "subId": "4003411",
      "subQuestName": "Read the letter",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400341101"
        ],
        "dialogs": {
          "400341101": {
            "id": "400341101",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whew, we finally caught up.",
            "nextDialogs": [
              "400341102"
            ]
          },
          "400341102": {
            "id": "400341102",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "Eh? There's some kind of... letter over here.",
            "nextDialogs": [
              "400341103"
            ]
          },
          "400341103": {
            "id": "400341103",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "Let's read it. It is the last clue we have, after all.",
            "nextDialogs": [
              "400341104"
            ]
          },
          "400341104": {
            "id": "400341104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehehe, right! Let Paimon see...",
            "nextDialogs": [
              "400341105"
            ]
          },
          "400341105": {
            "id": "400341105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"To whomsoever...\" Something something... Ugh, it's all battered and stuff!",
            "nextDialogs": [
              "400341106"
            ]
          },
          "400341106": {
            "id": "400341106",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "It's probably \"to whomsoever should read this letter.\"",
            "nextDialogs": [
              "400341107"
            ]
          },
          "400341107": {
            "id": "400341107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh. Guess so. It goes on... \"Our clan's profession is the training of ninken, and to this end we have provided the ninja with a great many reliable companions.\"",
            "nextDialogs": [
              "400341108"
            ]
          },
          "400341108": {
            "id": "400341108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"...I fear that I am unlikely to return from this latest expedition of mine. I have no regrets, but if I were to still have worries, it would be for Kageroumaru.\"",
            "nextDialogs": [
              "400341109"
            ]
          },
          "400341109": {
            "id": "400341109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"He was too weak when he was young, and so he was left out when the ninja came to make contracts with their ninken. That mattered little to me. As a trainer, I refused to give up on a single dog.\"",
            "nextDialogs": [
              "400341110"
            ]
          },
          "400341110": {
            "id": "400341110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"Day after day of training passed, and with each day, Kageroumaru grew stronger. Unfortunately, he has no wish to make a contract with any ninja.\"",
            "nextDialogs": [
              "400341111"
            ]
          },
          "400341111": {
            "id": "400341111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"War has not broken out yet, but the Police Station's missives have become more urgent. I no longer have time to spend with him — it is time to go.\"",
            "nextDialogs": [
              "400341112"
            ]
          },
          "400341112": {
            "id": "400341112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"I can only leave this letter behind. If anyone should find it in the days to come, please help me take care of Kageroumaru.\"",
            "nextDialogs": [
              "400341113"
            ]
          },
          "400341113": {
            "id": "400341113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"He has a scar on his face that we got when he was young, and he holds himself in manner evidently different from other dogs.\"",
            "nextDialogs": [
              "400341114"
            ]
          },
          "400341114": {
            "id": "400341114",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "So the \"Kageroumaru\" the letter speaks of is...",
            "nextDialogs": [
              "400341115"
            ]
          },
          "400341115": {
            "id": "400341115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This fellow who brought us here, I guess.",
            "nextDialogs": [
              "400341116"
            ]
          },
          "400341116": {
            "id": "400341116",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "He really is very unique! Hang on, there's more stuff here...",
            "nextDialogs": [
              "400341117"
            ]
          },
          "400341117": {
            "id": "400341117",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"I understand that this is a presumptuous request, but I do not have any other choice. Also, should he wish to make a contract in the future and can bring the one he wishes to follow to this place, then the method to make a contract is as follows...\"",
            "nextDialogs": [
              "400341118"
            ]
          },
          "400341118": {
            "id": "400341118",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, seriously!? The writer canceled the most important bit out!",
            "nextDialogs": [
              "400341119"
            ]
          },
          "400341119": {
            "id": "400341119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Probably thought this was impossible.",
            "nextDialogs": [
              "400341120"
            ]
          },
          "400341120": {
            "id": "400341120",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "That is true. There was no evidence that would indicate otherwise from the beginning, after all.",
            "nextDialogs": [
              "400341121"
            ]
          },
          "400341121": {
            "id": "400341121",
            "speakerId": 1004,
            "speakerName": "Kageroumaru",
            "text": "Woof woof—",
            "nextDialogs": [
              "400341122"
            ]
          },
          "400341122": {
            "id": "400341122",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Eh? It ran off again, and into a building this time, too. C'mon, {NICKNAME}, after it!"
          }
        }
      }
    },
    {
      "subId": "4003408",
      "subQuestName": "Pursue Kageroumaru again",
      "sceneId": null,

    {
      "subId": "4003412",
      "subQuestName": "Defeat Kageroumaru",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4003409",
      "subQuestName": "Talk to Ryuuji",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400340901"
        ],
        "dialogs": {
          "400340901": {
            "id": "400340901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Well, that's that done. Still, that was strange. Kageroumaru seemed so friendly at first, and then before we knew it, we were in a fight! Thank goodness for {NICKNAME}, huh?",
            "nextDialogs": [
              "400340902"
            ]
          },
          "400340902": {
            "id": "400340902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#...Actually, why's Kageroumaru following you around, {NICKNAME}?",
            "nextDialogs": [
              "400340903"
            ]
          },
          "400340903": {
            "id": "400340903",
            "speakerId": 1004,
            "speakerName": "Kageroumaru",
            "text": "Woof, woof!",
            "nextDialogs": [
              "400340904"
            ]
          },
          "400340904": {
            "id": "400340904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This barking sounds... happier, somehow?",
            "nextDialogs": [
              "400340905"
            ]
          },
          "400340905": {
            "id": "400340905",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "How can you tell? Paimon didn't get it at all!",
            "nextDialogs": [
              "400340906"
            ]
          },
          "400340906": {
            "id": "400340906",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "#Unless I miss my guess, Kageroumaru is now {NICKNAME}'s ninken.",
            "nextDialogs": [
              "400340907"
            ]
          },
          "400340907": {
            "id": "400340907",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh?",
            "nextDialogs": [
              "400340908"
            ]
          },
          "400340908": {
            "id": "400340908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Huh.",
            "nextDialogs": [
              "400340909"
            ]
          },
          "400340909": {
            "id": "400340909",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "Well, I'm no expert on ninken contracts. However, they do say that a ninja must defeat a ninken to receive its acknowledgment.",
            "nextDialogs": [
              "400340910"
            ]
          },
          "400340910": {
            "id": "400340910",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "Ninja desire strong companions, and so too do ninken. Only through mutual recognition can such contracts be established. It certainly seems to be the case here, too.",
            "nextDialogs": [
              "400340911"
            ]
          },
          "400340911": {
            "id": "400340911",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#But {NICKNAME} isn't a ninja! And also... Uh...",
            "nextDialogs": [
              "400340912"
            ]
          },
          "400340912": {
            "id": "400340912",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um...",
            "nextDialogs": [
              "400340913"
            ]
          },
          "400340913": {
            "id": "400340913",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Something the matter, Paimon?",
            "nextDialogs": [
              "400340914"
            ]
          },
          "400340914": {
            "id": "400340914",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#...Promise Paimon something, {NICKNAME}!",
            "nextDialogs": [
              "400340915"
            ]
          },
          "400340915": {
            "id": "400340915",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's that?",
            "nextDialogs": [
              "400340916"
            ]
          },
          "400340916": {
            "id": "400340916",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You've gotta promise first!",
            "nextDialogs": [
              "400340917"
            ]
          },
          "400340917": {
            "id": "400340917",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh, sure, I promise.",
            "nextDialogs": [
              "400340918"
            ]
          },
          "400340918": {
            "id": "400340918",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Even if you're now contracted to Kageroumaru, never forget that Paimon's your bestest companion ever!",
            "nextDialogs": [
              "400340919"
            ]
          },
          "400340919": {
            "id": "400340919",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I promise never to forget that Paimon is my bestest companion ever.",
            "nextDialogs": [
              "400340920"
            ]
          },
          "400340920": {
            "id": "400340920",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yay!",
            "nextDialogs": [
              "400340923"
            ]
          },
          "400340923": {
            "id": "400340923",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh-huh! We're the best of friends!",
            "nextDialogs": [
              "400340924"
            ]
          },
          "400340924": {
            "id": "400340924",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "Ahem. It's nice to see that the two of you get along and all...",
            "nextDialogs": [
              "400340925"
            ]
          },
          "400340925": {
            "id": "400340925",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "But back to the topic at hand... If Kageroumaru really is so strong, then why did the person from before leave a letter asking someone to take care of him?",
            "nextDialogs": [
              "400340926"
            ]
          },
          "400340926": {
            "id": "400340926",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Ooh, ooh, Paimon knows this one! You see, Ryuuji, {NICKNAME} is super strong, right?",
            "nextDialogs": [
              "400340927"
            ]
          },
          "400340927": {
            "id": "400340927",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "Far beyond the norm for sure.",
            "nextDialogs": [
              "400340928"
            ]
          },
          "400340928": {
            "id": "400340928",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Right? But see, if someday, Paimon had to leave {NICKNAME}, Paimon would still be really worried. It's got nothing to do with whether {NICKNAME} is strong or not.",
            "nextDialogs": [
              "400340929"
            ]
          },
          "400340929": {
            "id": "400340929",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...Pfft, but that'll never happen! Paimon's just making an analogy and stuff, y'know? We won't split up, no way!",
            "nextDialogs": [
              "400340930"
            ]
          },
          "400340930": {
            "id": "400340930",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon...",
            "nextDialogs": [
              "400340931"
            ]
          },
          "400340931": {
            "id": "400340931",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "Your reasoning makes a lot of sense, Paimon. In which case, we're left with one final question. Why did this dog steal small animals from the villagers and then protect them?",
            "nextDialogs": [
              "400340932"
            ]
          },
          "400340932": {
            "id": "400340932",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, uh... Actually, that one's a toughie, even for Paimon...",
            "nextDialogs": [
              "400340933"
            ]
          },
          "400340933": {
            "id": "400340933",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#It's a real shame that Kageroumaru can't speak, either. Otherwise, we could just get {NICKNAME} to ask him!",
            "nextDialogs": [
              "400340934"
            ]
          },
          "400340934": {
            "id": "400340934",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I suggest we look for Sango instead.",
            "nextDialogs": [
              "400340935"
            ]
          },
          "400340935": {
            "id": "400340935",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ooh, that's right! Time for the brains of this operation to show her stuff, eh?",
            "nextDialogs": [
              "400340936"
            ]
          },
          "400340936": {
            "id": "400340936",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "Agreed. Allow me to return these animals first, and we shall meet up at the agency later."
          }
        }
      }
    },
    {
      "subId": "4003410",
      "subQuestName": "Report back to Sango",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400341001"
        ],
        "dialogs": {
          "400341001": {
            "id": "400341001",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "We're back, Sango. Here's what happened...",
            "nextDialogs": [
              "400341002"
            ]
          },
          "400341002": {
            "id": "400341002",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "Ah, so that's the case. I think I've got a pretty good idea why Kageroumaru was protecting the little animals.",
            "nextDialogs": [
              "400341003"
            ]
          },
          "400341003": {
            "id": "400341003",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "He must have been trying to make the other animals stronger.",
            "nextDialogs": [
              "400341004"
            ]
          },
          "400341004": {
            "id": "400341004",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "He must have been weak when he was little, only to become strong over time. It thus stands to reason that he wanted to help make the other animals stronger through training.",
            "nextDialogs": [
              "400341005"
            ]
          },
          "400341005": {
            "id": "400341005",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "But eventually, Kageroumaru found you, someone willing to protect the weak, and has thus acknowledged you as his master.",
            "nextDialogs": [
              "400341006"
            ]
          },
          "400341006": {
            "id": "400341006",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "This is also born from his sympathy for the weak.",
            "nextDialogs": [
              "400341007"
            ]
          },
          "400341007": {
            "id": "400341007",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "Well, that's what my deductions from the clues we currently have would say, anyway.",
            "nextDialogs": [
              "400341008"
            ]
          },
          "400341008": {
            "id": "400341008",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "As for the actual circumstances, I doubt I'm particularly far off, but since Kageroumaru can't speak, we won't get a firm answer either.",
            "nextDialogs": [
              "400341009"
            ]
          },
          "400341009": {
            "id": "400341009",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh. That really makes sense. As expected of the \"brains\" of this operation, eh?",
            "nextDialogs": [
              "400341010"
            ]
          },
          "400341010": {
            "id": "400341010",
            "speakerId": 1004,
            "speakerName": "Kageroumaru",
            "text": "Woof woof woof!",
            "nextDialogs": [
              "400341011"
            ]
          },
          "400341011": {
            "id": "400341011",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ehe, you're agreeing with Sango, aren't you?",
            "nextDialogs": [
              "400341012"
            ]
          },
          "400341012": {
            "id": "400341012",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "Haha. Thanks for the flattery, but that's not going to net you any discounts if you ever send me a commission. Still, I guess we can consider this case closed.",
            "nextDialogs": [
              "400341013"
            ]
          },
          "400341013": {
            "id": "400341013",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "Many thanks to the two of you, of course.",
            "nextDialogs": [
              "400341014"
            ]
          },
          "400341014": {
            "id": "400341014",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "Ah, yes. I almost forgot. How did you find using the Ubiquity Net?",
            "nextDialogs": [
              "400341017"
            ]
          },
          "400341017": {
            "id": "400341017",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "Alright, noted. I'll send your feedback to my friend. Thanks.",
            "nextDialogs": [
              "400341018"
            ]
          },
          "400341018": {
            "id": "400341018",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#No problem! Feel free to come to us if you ever have any problems. {NICKNAME} will be on the case in no time!",
            "nextDialogs": [
              "400341019"
            ]
          },
          "400341019": {
            "id": "400341019",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "You're indeed very skilled, Traveler. But there's no need for these pleasantries. Sentimentality is the enemy of truth, after all."
          }
        }
      }
    },
    {
      "subId": "4003451",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400345101"
        ],
        "dialogs": {
          "400345101": {
            "id": "400345101",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "Looks like this matter is coming to a close...",
            "nextDialogs": [
              "400345102"
            ]
          },
          "400345102": {
            "id": "400345102",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "What should we call this case... \"The Phantom Dog Owner\"? \"The Treasure Hoarder with Twelve Faces\"?",
            "nextDialogs": [
              "400345103"
            ]
          },
          "400345103": {
            "id": "400345103",
            "speakerId": 1000,
            "speakerName": "Sango",
            "text": "Ugh. Naming this case is going to be hard. Should just ask someone from Yae Publishing House next time, I think."
          }
        }
      }
    }
  ]
}
    {
      "subId": "4003406",
      "subQuestName": "Encounter the strange dog",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400340601"
        ],
        "dialogs": {
          "400340601": {
            "id": "400340601",
            "speakerId": 1003,
            "speakerName": "???",
            "text": "...",
            "nextDialogs": [
              "400340602"
            ]
          },
          "400340602": {
            "id": "400340602",
            "speakerId": 1003,
            "speakerName": "???",
            "text": "Woof!",
            "nextDialogs": [
              "400340603"
            ]
          },
          "400340603": {
            "id": "400340603",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "I—It's...",
            "nextDialogs": [
              "400340605",
              "400340607"
            ]
          },
          "400340605": {
            "id": "400340605",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh? No, c'mon, what sort of nickname is that?",
            "nextDialogs": [
              "400340609"
            ]
          },
          "400340609": {
            "id": "400340609",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "Well, whatever the case. He seems to have no desire to attack us...",
            "nextDialogs": [
              "400340610"
            ]
          },
          "400340610": {
            "id": "400340610",
            "speakerId": 1003,
            "speakerName": "???",
            "text": "Woof woof—",
            "nextDialogs": [
              "400340611"
            ]
          },
          "400340611": {
            "id": "400340611",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Aaaand he's gone.",
            "nextDialogs": [
              "400340612"
            ]
          },
          "400340612": {
            "id": "400340612",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "He's turning back to look at us every so often. Does he want us to follow?",
            "nextDialogs": [
              "400340613"
            ]
          },
          "400340613": {
            "id": "400340613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's catch up.",
            "nextDialogs": [
              "400340614"
            ]
          },
          "400340614": {
            "id": "400340614",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "Indeed. Perhaps the truth really is ahead... Perhaps things are just as Sango predicted..."
          },
          "400340607": {
            "id": "400340607",
            "speakerId": 1002,
            "speakerName": "Ryuuji",
            "text": "No, no. It should be \"Hat Dog.\""
          }
        }
      }
    },

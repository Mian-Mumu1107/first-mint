        "dialogs": {
          "719320101": {
            "id": "719320101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Has traveling been fun?",
            "nextDialogs": [
              "719320102"
            ]
          },
          "719320102": {
            "id": "719320102",
            "speakerId": 1000,
            "speakerName": "Tia",
            "text": "Yup! This is my first time outside Mondstadt. Everything here is so cool!",
            "nextDialogs": [
              "719320103"
            ]
          },
          "719320103": {
            "id": "719320103",
            "speakerId": 1000,
            "speakerName": "Tia",
            "text": "When I was small, I could only read \"Vera's Melancholy.\" I would imagine I was Vera, experiencing all kinds of amazing adventures!",
            "nextDialogs": [
              "719320104"
            ]
          },
          "719320104": {
            "id": "719320104",
            "speakerId": 1000,
            "speakerName": "Tia",
            "text": "I know! I'll give you this copy of \"Vera's Melancholy.\" I might have flipped through it a bit too much...",
            "nextDialogs": [
              "719320105"
            ]
          },
          "719320105": {
            "id": "719320105",
            "speakerId": 1000,
            "speakerName": "Tia",
            "text": "But I don't need it anymore, because I'm on a real adventure with Daddy. My experiences will be even more interesting than the novel!"
          }
        }
      }
    }
  ]

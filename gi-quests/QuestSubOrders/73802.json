      "dialogue": {
        "startDialogs": [
          "738020101"
        ],
        "dialogs": {
          "738020101": {
            "id": "738020101",
            "speakerId": 4019,
            "speakerName": "Katheryne",
            "text": "Ad astra abyssosque! Welcome to the Adventurers' Guild.",
            "nextDialogs": [
              "738020102"
            ]
          },
          "738020102": {
            "id": "738020102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hi, Katheryne.",
            "nextDialogs": [
              "738020103"
            ]
          },
          "738020103": {
            "id": "738020103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hello, Katheryne...",
            "nextDialogs": [
              "738020104"
            ]
          },
          "738020104": {
            "id": "738020104",
            "speakerId": 4019,
            "speakerName": "Katheryne",
            "text": "Greetings. You both look great today. Are you here to take commissions or deal with other affairs?",
            "nextDialogs": [
              "738020105"
            ]
          },
          "738020105": {
            "id": "738020105",
            "speakerId": 4019,
            "speakerName": "Katheryne",
            "text": "Why are you both staring at me? Is there something of significance that you would like to inquire about?",
            "nextDialogs": [
              "738020108"
            ]
          },
          "738020108": {
            "id": "738020108",
            "speakerId": 4019,
            "speakerName": "Katheryne",
            "text": "Understood. You seem like a seasoned adventurer already.",
            "nextDialogs": [
              "738020109"
            ]
          },
          "738020109": {
            "id": "738020109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You could say that.",
            "nextDialogs": [
              "738020110"
            ]
          },
          "738020110": {
            "id": "738020110",
            "speakerId": 4019,
            "speakerName": "Katheryne",
            "text": "Then you must be well acquainted with the Adventurers' Guild's way of operation. Therefore, I won't waste your time going over it.",
            "nextDialogs": [
              "738020111"
            ]
          },
          "738020111": {
            "id": "738020111",
            "speakerId": 4019,
            "speakerName": "Katheryne",
            "text": "If you have any questions for the Guild, please feel free to ask me at any time.",
            "nextDialogs": [
              "738020112"
            ]
          },
          "738020112": {
            "id": "738020112",
            "speakerId": 4019,
            "speakerName": "Katheryne",
            "text": "Please pitch in with the commissions in Sumeru City. Outstanding adventurers like you will surely be a great help to the people here.",
            "nextDialogs": [
              "738020113"
            ]
          },
          "738020113": {
            "id": "738020113",
            "speakerId": 4019,
            "speakerName": "Katheryne",
            "text": "Safe travels, Traveler. Ad astra abyssosque!"
          }
        }
      }
    }
  ]
}
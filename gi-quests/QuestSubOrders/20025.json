  "subQuests": [
    {
      "subId": "2002501",
      "subQuestName": "Talk to Wyatt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200250101"
        ],
        "dialogs": {
          "200250101": {
            "id": "200250101",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Traveler! You couldn't have picked a better time.",
            "nextDialogs": [
              "200250102"
            ]
          },
          "200250102": {
            "id": "200250102",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Last night, I was on my way to the city to deliver these goods, when suddenly, some shining orbs caught my eye.",
            "nextDialogs": [
              "200250103"
            ]
          },
          "200250103": {
            "id": "200250103",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "I—I'd had too much to drink, and... I just felt drawn to them, you know? I went to check it out and it turned out to be a huge group of slimes. They even bumped into me really hard!",
            "nextDialogs": [
              "200250104"
            ]
          },
          "200250104": {
            "id": "200250104",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "I panicked and ran, but lost my way. It took me forever to find my cart again. Then, this morning, I found out my <color=#00E1FFFF>key</color> was gone...",
            "nextDialogs": [
              "200250105"
            ]
          },
          "200250105": {
            "id": "200250105",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Could you help me look for it? It's got to be around here somewhere... I feel like it's right under my nose.",
            "nextDialogs": [
              "200250107",
              "200250109"
            ]
          },
          "200250107": {
            "id": "200250107",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Great! It's such a huge area, I just wouldn't know where to start looking."
          },
          "200250109": {
            "id": "200250109",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "This is such a huge area. I just don't know where to start looking. Please, you're the only one that can help me!"
          }
        }
      }
    },
    {
      "subId": "2002503",
      "subQuestName": "Use Elemental Sight to find the key",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2002504",
      "subQuestName": "Give the key to Wyatt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200250401"
        ],
        "dialogs": {
          "200250401": {
            "id": "200250401",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Found the key yet?",
            "nextDialogs": [
              "200250402"
            ]
          },
          "200250402": {
            "id": "200250402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I found this key — is it yours?",
            "nextDialogs": [
              "200250403"
            ]
          },
          "200250403": {
            "id": "200250403",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Yes! That's the one. I can't afford to let that happen again... I really must rein in my drinking.",
            "nextDialogs": [
              "200250404"
            ]
          },
          "200250404": {
            "id": "200250404",
            "speakerId": 155101,
            "speakerName": "Wyatt",
            "text": "Oh — and take these. Thanks for your help."
          }
        }
      }
    },
    {
      "subId": "2002502",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200250201"
        ],
        "dialogs": {
          "200250201": {
            "id": "200250201",
            "speakerId": 1551,
            "speakerName": "Wyatt",
            "text": "Have you found my key?",
            "nextDialogs": [
              "200250202"
            ]
          },
          "200250202": {
            "id": "200250202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm afraid not.",
            "nextDialogs": [
              "200250203"
            ]
          },
          "200250203": {
            "id": "200250203",
            "speakerId": 1551,
            "speakerName": "Wyatt",
            "text": "Well, it is quite a big search area... Good luck!"
          }
        }
      }
    }
  ]
}
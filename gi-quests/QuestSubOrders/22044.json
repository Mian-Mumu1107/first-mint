  },
  "subQuests": [
    {
      "subId": "2204401",
      "subQuestName": "Talk to Ooshima Junpei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220440101"
        ],
        "dialogs": {
          "220440101": {
            "id": "220440101",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Traveler, you're here! Did you come to pay respects?",
            "nextDialogs": [
              "220440102"
            ]
          },
          "220440102": {
            "id": "220440102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How's your wood carving going?",
            "nextDialogs": [
              "220440103"
            ]
          },
          "220440103": {
            "id": "220440103",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Oh, I'd say that I'm doing fine. I still need to fix the dimensions of the carvings, though.",
            "nextDialogs": [
              "220440104"
            ]
          },
          "220440104": {
            "id": "220440104",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "According to my initial thoughts, these carvings should fit snugly in a person's palm.",
            "nextDialogs": [
              "220440105"
            ]
          },
          "220440105": {
            "id": "220440105",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "That way, they can play with it easily.",
            "nextDialogs": [
              "220440106"
            ]
          },
          "220440106": {
            "id": "220440106",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Also, other than the carvings themselves, I think I should make some decorations.",
            "nextDialogs": [
              "220440107"
            ]
          },
          "220440107": {
            "id": "220440107",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "I've seen that when people make these carvings, they will also add some accessories on the side.",
            "nextDialogs": [
              "220440108"
            ]
          },
          "220440108": {
            "id": "220440108",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Things like flowers, animals, bases that have flowery patterns, things like that...",
            "nextDialogs": [
              "220440109"
            ]
          },
          "220440109": {
            "id": "220440109",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "I'd also like to put such decorative bases on my wood carvings. That said, due to sizing issues, we can only put one ornament on one wood carving...",
            "nextDialogs": [
              "220440110"
            ]
          },
          "220440110": {
            "id": "220440110",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "But I'm thinking that if the decorations are detachable, I can just put on whatever decorations my customers request.",
            "nextDialogs": [
              "220440111"
            ]
          },
          "220440111": {
            "id": "220440111",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "I'd probably want to start from simpler decorations... Something like Naku Weed.",
            "nextDialogs": [
              "220440112"
            ]
          },
          "220440112": {
            "id": "220440112",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "So, Traveler, could you help me gather 3 stalks of Naku Weed back to use for reference?",
            "nextDialogs": [
              "220440117",
              "220440115"
            ]
          },
          "220440117": {
            "id": "220440117",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Sorry, Traveler, but I'll be leaving this in your hands. Come back and look for me once you have those Naku Weeds."
          },
          "220440115": {
            "id": "220440115",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "If I can get three, I can view them in three different states.",
            "nextDialogs": [
              "220440116"
            ]
          },
          "220440116": {
            "id": "220440116",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "That way, I should be able to carve the best Naku Weed that I can."
          }
        }
      }
    },
    {
      "subId": "2204402",
      "subQuestName": "Give Ooshima Junpei three Naku Weed",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220440201"
        ],
        "dialogs": {
          "220440201": {
            "id": "220440201",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Have you gotten those Naku Weeds?"
          }
        }
      }
    },
    {
      "subId": "2204403",
      "subQuestName": "Talk to Ooshima Junpei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220440301"
        ],
        "dialogs": {
          "220440301": {
            "id": "220440301",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Oh, nice! These should do the trick. Thank you so much, Traveler!",
            "nextDialogs": [
              "220440302"
            ]
          },
          "220440302": {
            "id": "220440302",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Now, time to do a little investigating. How are we going to carve wood into the shape of Naku Weed...",
            "nextDialogs": [
              "220440303"
            ]
          },
          "220440303": {
            "id": "220440303",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "If I can make these decorations well enough and have a wide enough variety of them...",
            "nextDialogs": [
              "220440304"
            ]
          },
          "220440304": {
            "id": "220440304",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Maybe we'll be able to sell them separately..."
          }
        }
      }
    }
  ]
}
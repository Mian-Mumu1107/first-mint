  "subQuests": [
    {
      "subId": "4112402",
      "subQuestName": "Talk to Vile",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411240201"
        ],
        "dialogs": {
          "411240201": {
            "id": "411240201",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "Oh my, you're here at last. I've been waiting.",
            "nextDialogs": [
              "411240202"
            ]
          },
          "411240202": {
            "id": "411240202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Whatever for?",
            "nextDialogs": [
              "411240203"
            ]
          },
          "411240203": {
            "id": "411240203",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "Come on, don't be so cold. I have something very important to ask of you.",
            "nextDialogs": [
              "411240204"
            ]
          },
          "411240204": {
            "id": "411240204",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "I'm sure you've seen those meteorites. Though none of them landed inside the city of Mondstadt, the whole place is in an uproar all the same.",
            "nextDialogs": [
              "411240205"
            ]
          },
          "411240205": {
            "id": "411240205",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "And where there's muddied water, there will be fish that don't belong trying to slip in unnoticed.",
            "nextDialogs": [
              "411240207",
              "411240209"
            ]
          },
          "411240207": {
            "id": "411240207",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "Aha, aren't you keen? That's an experienced adventurer for you.",
            "nextDialogs": [
              "411240212"
            ]
          },
          "411240212": {
            "id": "411240212",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "Though the Knights are on high alert, there's bound to be some gaps in their defenses, what with having to send help to the areas around the city and all.",
            "nextDialogs": [
              "411240213"
            ]
          },
          "411240213": {
            "id": "411240213",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "Those money-grubbing Treasure Hoarders have surely made plans to slip through those gaps and \"make a killing,\" as they say."
          },
          "411240209": {
            "id": "411240209",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "Haha, of course not. How would they even blend in?",
            "nextDialogs": [
              "411240210"
            ]
          },
          "411240210": {
            "id": "411240210",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "I'm sure the knights would be all too ready for them if they even tried getting close to the walls.",
            "nextDialogs": [
              "411240211"
            ]
          },
          "411240211": {
            "id": "411240211",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "I'm talking about the Treasure Hoarders."
          }
        }
      }
    },

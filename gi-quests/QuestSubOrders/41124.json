    {
      "subId": "4112408",
      "subQuestName": "Report back to Vile",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411240801"
        ],
        "dialogs": {
          "411240801": {
            "id": "411240801",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "Have those Treasure Hoarders been taken care of?",
            "nextDialogs": [
              "411240802"
            ]
          },
          "411240802": {
            "id": "411240802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Very well taken care of, indeed.",
            "nextDialogs": [
              "411240803"
            ]
          },
          "411240803": {
            "id": "411240803",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "Haha, I'd expect no less from someone who's caught that gentleman's eye. You're very efficient.",
            "nextDialogs": [
              "411240804"
            ]
          },
          "411240804": {
            "id": "411240804",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "Here's your compensation. It was a... pleasure working with you.",
            "nextDialogs": [
              "411240805"
            ]
          },
          "411240805": {
            "id": "411240805",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "If fortune permits, we'll have a chance to do business again."
          }
        }
      }
    },
    {
      "subId": "4112452",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411245201"
        ],
        "dialogs": {
          "411245201": {
            "id": "411245201",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "You haven't set off yet? Ah, yes... You must have some other questions, then?",
            "nextDialogs": [
              "411245203",
              "411245206"
            ]
          },
          "411245203": {
            "id": "411245203",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "Hmm. That gentleman is an old acquaintance of yours, really. He says that you even fought side by side for a time.",
            "nextDialogs": [
              "411245204"
            ]
          },
          "411245204": {
            "id": "411245204",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "I can't give you his name, though. That would be on my head for sure."
          },
          "411245206": {
            "id": "411245206",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "You mean to say that even if we do defeat the three bands of Treasure Hoarders lured in by our messages, the rest will simply flee after hearing the news, yes?",
            "nextDialogs": [
              "411245207"
            ]
          },
          "411245207": {
            "id": "411245207",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "Well, that's true, but this is precisely the intention. That gentleman doesn't wish to catch them all, but to send them a little shock.",
            "nextDialogs": [
              "411245208"
            ]
          },
          "411245208": {
            "id": "411245208",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "Under the present circumstances, the Knights cannot spare the people to undertake a large manhunt.",
            "nextDialogs": [
              "411245209"
            ]
          },
          "411245209": {
            "id": "411245209",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "In any case, the falling meteorites are the top priority at present.",
            "nextDialogs": [
              "411245210"
            ]
          },
          "411245210": {
            "id": "411245210",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "As for Treasure Hoarders, they just need to be... convinced to stop making trouble for now."
          }
        }
      }
    },
    {
      "subId": "4112456",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411245601"
        ],
        "dialogs": {
          "411245601": {
            "id": "411245601",
            "speakerId": 1000,
            "speakerName": "Vile",
            "text": "Taking care of this lot of brigands should encourage the rest to behave a little."
          }
        }
      }
    }
  ]

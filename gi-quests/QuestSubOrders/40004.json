    {
      "subId": "4000402",
      "subQuestName": "Talk to Kaeya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400040201"
        ],
        "dialogs": {
          "400040201": {
            "id": "400040201",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "#Well, well, long time no see, {NICKNAME}!",
            "nextDialogs": [
              "400040202"
            ]
          },
          "400040202": {
            "id": "400040202",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Kaeya, we went to the Lantern Rite in Liyue!",
            "nextDialogs": [
              "400040203"
            ]
          },
          "400040203": {
            "id": "400040203",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Ah. Well, how was it? Fun?",
            "nextDialogs": [
              "400040204"
            ]
          },
          "400040204": {
            "id": "400040204",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Delicious!",
            "nextDialogs": [
              "400040205"
            ]
          },
          "400040205": {
            "id": "400040205",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Well then, you ought to be looking forward to Mondstadt's Ludi Harpastum. I'm sure it will be to your liking.",
            "nextDialogs": [
              "400040206"
            ]
          },
          "400040206": {
            "id": "400040206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Get to the point, Paimon.",
            "nextDialogs": [
              "400040207"
            ]
          },
          "400040207": {
            "id": "400040207",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Right, right! Kaeya, there's something we need to tell you about.",
            "nextDialogs": [
              "400040208"
            ]
          },
          "400040208": {
            "id": "400040208",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Hmm... Lantern supplies... Stockpile of wood, paper, and oil... At the very least, it sounds like an accident waiting to happen.",
            "nextDialogs": [
              "400040209"
            ]
          },
          "400040209": {
            "id": "400040209",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Haha, how very amusing. What makes you think I would recognize this symbol?",
            "nextDialogs": [
              "400040211",
              "400040216"
            ]
          },
          "400040211": {
            "id": "400040211",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, that about sums it up!",
            "nextDialogs": [
              "400040212"
            ]
          },
          "400040212": {
            "id": "400040212",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Hah. I'm flattered, but don't you think you might be overestimating me?",
            "nextDialogs": [
              "400040213"
            ]
          },
          "400040213": {
            "id": "400040213",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "There it is! At last, Kaeya displays the knightly virtue of modesty, perfectly articulated and masterfully delivered.",
            "nextDialogs": [
              "400040214"
            ]
          },
          "400040214": {
            "id": "400040214",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "My goodness, your stay in Liyue seems to have sharpened your wit and broadened your vocabulary.",
            "nextDialogs": [
              "400040220"
            ]
          },
          "400040220": {
            "id": "400040220",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Anyway, I digress. This is the symbol of the cross-border criminal organization you know as the Treasure Hoarders.",
            "nextDialogs": [
              "400040221"
            ]
          },
          "400040221": {
            "id": "400040221",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "If you are curious to know more, I can put you in touch with an informant on the inside.",
            "nextDialogs": [
              "400040222"
            ]
          },
          "400040222": {
            "id": "400040222",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Uhh, didn't you just say the Knights of Favonius don't have dealings with their enemies!?",
            "nextDialogs": [
              "400040223"
            ]
          },
          "400040223": {
            "id": "400040223",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "...This is my own personal informant. Nothing to do with the Knights of Favonius.",
            "nextDialogs": [
              "400040224"
            ]
          },
          "400040224": {
            "id": "400040224",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "A little later, make your way over to Windrise. I'll arrange for the informant to meet you there.",
            "nextDialogs": [
              "400040225"
            ]
          },
          "400040225": {
            "id": "400040225",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Thanks, Kaeya.",
            "nextDialogs": [
              "400040226"
            ]
          },
          "400040226": {
            "id": "400040226",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Oh, and remember: \"wine begets wisdom.\"",
            "nextDialogs": [
              "400040227"
            ]
          },
          "400040227": {
            "id": "400040227",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh?"
          },
          "400040216": {
            "id": "400040216",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Exactly!",
            "nextDialogs": [
              "400040217"
            ]
          },
          "400040217": {
            "id": "400040217",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Uh-ah! You should watch what you say, Honorary Knight.",
            "nextDialogs": [
              "400040218"
            ]
          },
          "400040218": {
            "id": "400040218",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "What do you mean, flirt with the dark side? The Knights of Favonius certainly does not have dealings with its enemies.",
            "nextDialogs": [
              "400040219"
            ]
          },
          "400040219": {
            "id": "400040219",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "That has to do with a certain knightly virtue called \"integrity.\""
          }
        }
      }
    },
    {
      "subId": "4000403",
      "subQuestName": "Talk to Kaeya's informant",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400040301"
        ],
        "dialogs": {
          "400040301": {
            "id": "400040301",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "Huh...",
            "nextDialogs": [
              "400040302"
            ]
          },
          "400040302": {
            "id": "400040302",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey! You're the guy, right? Kaeya's informant?",
            "nextDialogs": [
              "400040303"
            ]
          },
          "400040303": {
            "id": "400040303",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "Informant? Not me.",
            "nextDialogs": [
              "400040304"
            ]
          },
          "400040304": {
            "id": "400040304",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But... This is the place we agreed upon... and you're the only other one here, so...",
            "nextDialogs": [
              "400040305"
            ]
          },
          "400040305": {
            "id": "400040305",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "\"Place we agreed upon\"? Heh, I know nothing.",
            "nextDialogs": [
              "400040306"
            ]
          },
          "400040306": {
            "id": "400040306",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh, stop being so annoying!",
            "nextDialogs": [
              "400040308",
              "400040311"
            ]
          },
          "400040308": {
            "id": "400040308",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "Okay. Yeah, it's me.",
            "nextDialogs": [
              "400040309"
            ]
          },
          "400040309": {
            "id": "400040309",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "How was any of that even slightly necessary!?",
            "nextDialogs": [
              "400040316"
            ]
          },
          "400040316": {
            "id": "400040316",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "What do you want to know about?",
            "nextDialogs": [
              "400040317"
            ]
          },
          "400040317": {
            "id": "400040317",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "*sigh* Here's the situation...",
            "nextDialogs": [
              "400040318"
            ]
          },
          "400040318": {
            "id": "400040318",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "Okay. I see.",
            "nextDialogs": [
              "400040319"
            ]
          },
          "400040319": {
            "id": "400040319",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So? What can you tell us as an insider?",
            "nextDialogs": [
              "400040320"
            ]
          },
          "400040320": {
            "id": "400040320",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "I do not think this is the work of the Treasure Hoarders.",
            "nextDialogs": [
              "400040321"
            ]
          },
          "400040321": {
            "id": "400040321",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "The reason the Treasure Hoarders are able to sustain a giant cross-border operation is because they abide by one fundamental principle:",
            "nextDialogs": [
              "400040322"
            ]
          },
          "400040322": {
            "id": "400040322",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "Caution. Softly softly catchee monkey is the name of the game for them. By contrast, the idea of taking huge risks to try and make a fortune is utter folly in their eyes.",
            "nextDialogs": [
              "400040323"
            ]
          },
          "400040323": {
            "id": "400040323",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "Liyue has the adepti looking after it, doesn't it? And they're especially active during the Lantern Rite...",
            "nextDialogs": [
              "400040325"
            ]
          },
          "400040325": {
            "id": "400040325",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "There's just no way that we... sorry, \"they\"! Slip of the tongue — when you've been undercover as long as I have, heh, where was I... Oh, yes — There's just no way that they — the Treasure Hoarders — would dare make a move during the Lantern Rite.",
            "nextDialogs": [
              "400040326"
            ]
          },
          "400040326": {
            "id": "400040326",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "Also... the Treasure Hoarders' organization in Liyue recently received an anonymous letter.",
            "nextDialogs": [
              "400040327"
            ]
          },
          "400040327": {
            "id": "400040327",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Why would someone send them an anonymous letter? Trying to frame them, perhaps?",
            "nextDialogs": [
              "400040328"
            ]
          },
          "400040328": {
            "id": "400040328",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "Nobody knows. But what I can tell you is which branch of the Treasure Hoarders has the letter in their possession.",
            "nextDialogs": [
              "400040329"
            ]
          },
          "400040329": {
            "id": "400040329",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "...There. I've marked their location on the map for you.",
            "nextDialogs": [
              "400040330"
            ]
          },
          "400040330": {
            "id": "400040330",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Great. Well, Paimon thinks this was productive! {NICKNAME}, this is our only solid lead. Let's not waste it!",
            "nextDialogs": [
              "400040331"
            ]
          },
          "400040331": {
            "id": "400040331",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "If there's nothing more, I should get back to treasure hoarding. ...I mean, get back to those treasure-hoarding lowlifes. To spy on them. Heh."
          },
          "400040311": {
            "id": "400040311",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "Uh...",
            "nextDialogs": [
              "400040312"
            ]
          },
          "400040312": {
            "id": "400040312",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "400040313"
            ]
          },
          "400040313": {
            "id": "400040313",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "Okay... technically the wrong password, but... yes, it's something about wine, and assuming that something is the thing about it begetting wisdom, then...",
            "nextDialogs": [
              "400040314"
            ]
          },
          "400040314": {
            "id": "400040314",
            "speakerId": 1002,
            "speakerName": "Nimrod",
            "text": "Yeah, close enough. It's me.",
            "nextDialogs": [
              "400040315"
            ]
          },
          "400040315": {
            "id": "400040315",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "How was any of that even slightly necessary!?"
          }
        }
      }
    },
    {
      "subId": "4000405",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400040501"
        ],
        "dialogs": {
          "400040501": {
            "id": "400040501",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "What's the matter, Paimon? Did your investigation reach a dead end?",
            "nextDialogs": [
              "400040502"
            ]
          },
          "400040502": {
            "id": "400040502",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yes. It seems like this wasn't the Treasure Hoarders after all.",
            "nextDialogs": [
              "400040503"
            ]
          },
          "400040503": {
            "id": "400040503",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Well, I have some good news that might cheer you up. It came in just while you were out.",
            "nextDialogs": [
              "400040504"
            ]
          },
          "400040504": {
            "id": "400040504",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "It's from a... business associate of mine in Liyue. Who knows, you might find it helpful.",
            "nextDialogs": [
              "400040505"
            ]
          },
          "400040505": {
            "id": "400040505",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ooh what is it, what is it?",
            "nextDialogs": [
              "400040506"
            ]
          },
          "400040506": {
            "id": "400040506",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "The Treasure Hoarders' organization in Liyue has received an anonymous letter.",
            "nextDialogs": [
              "400040508"
            ]
          },
          "400040508": {
            "id": "400040508",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "I can only give you the letter's location. It is beyond my ability to find out its contents.",
            "nextDialogs": [
              "400040509"
            ]
          },
          "400040509": {
            "id": "400040509",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#No problemo! {NICKNAME}, this is our only solid lead. Let's not waste it!"
          }
        }
      }
    },
    {
      "subId": "4000406",
      "subQuestName": "Locate the Treasure Thieves using the information",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

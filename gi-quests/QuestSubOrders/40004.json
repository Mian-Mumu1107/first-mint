    {
      "subId": "4000409",
      "subQuestName": "Talk to the member of Treasure Thieves",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400040901"
        ],
        "dialogs": {
          "400040901": {
            "id": "400040901",
            "speakerId": 1003,
            "speakerName": "Bei'er",
            "text": "Sorry mate, wrong way. Wherever you think you're going, it's that way.",
            "nextDialogs": [
              "400040902"
            ]
          },
          "400040902": {
            "id": "400040902",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But isn't that the way to Liyue Harbor?",
            "nextDialogs": [
              "400040903"
            ]
          },
          "400040903": {
            "id": "400040903",
            "speakerId": 1003,
            "speakerName": "Bei'er",
            "text": "Right. Here is nowhere. So the other way is Liyue Harbor.",
            "nextDialogs": [
              "400040904"
            ]
          },
          "400040904": {
            "id": "400040904",
            "speakerId": 1004,
            "speakerName": "Crafty",
            "text": "If you're looking for somewhere to stay, I suggest you go to the Wangshu Inn. Fair prices, great customer service, and a wonderful view.",
            "nextDialogs": [
              "400040905"
            ]
          },
          "400040905": {
            "id": "400040905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Show us the anonymous letter.",
            "nextDialogs": [
              "400040906"
            ]
          },
          "400040906": {
            "id": "400040906",
            "speakerId": 1003,
            "speakerName": "Bei'er",
            "text": "...How do you know about the letter?",
            "nextDialogs": [
              "400040907"
            ]
          },
          "400040907": {
            "id": "400040907",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...Uh, one of Liyue's adepti told us about it!",
            "nextDialogs": [
              "400040908"
            ]
          },
          "400040908": {
            "id": "400040908",
            "speakerId": 1003,
            "speakerName": "Bei'er",
            "text": "Did they now? I somehow doubt that.",
            "nextDialogs": [
              "400040909"
            ]
          },
          "400040909": {
            "id": "400040909",
            "speakerId": 1005,
            "speakerName": "???",
            "text": "You should not doubt it. It was I who sent them to investigate.",
            "nextDialogs": [
              "400040910"
            ]
          },
          "400040910": {
            "id": "400040910",
            "speakerId": 1006,
            "speakerName": "Xiao",
            "text": "Any further questioning, you may direct to me.",
            "nextDialogs": [
              "400040911"
            ]
          },
          "400040911": {
            "id": "400040911",
            "speakerId": 1003,
            "speakerName": "Bei'er",
            "text": "...You're the Vigilant Yaksha!?",
            "nextDialogs": [
              "400040912"
            ]
          },
          "400040912": {
            "id": "400040912",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, watch your tone of voice! Or do you seriously wanna pick a fight with an adeptus?",
            "nextDialogs": [
              "400040913"
            ]
          },
          "400040913": {
            "id": "400040913",
            "speakerId": 1004,
            "speakerName": "Crafty",
            "text": "Uh, okay. It's not that we don't believe you're an adeptus, it's just... Everyone needs to look at the bigger picture here.",
            "nextDialogs": [
              "400040914"
            ]
          },
          "400040914": {
            "id": "400040914",
            "speakerId": 1003,
            "speakerName": "Bei'er",
            "text": "As you well know, we Treasure Hoarders are no serious threat to anyone. We're petty criminals, that's all.",
            "nextDialogs": [
              "400040915"
            ]
          },
          "400040915": {
            "id": "400040915",
            "speakerId": 1004,
            "speakerName": "Crafty",
            "text": "So if you are truly an adeptus, please... Show us some mercy, would you?",
            "nextDialogs": [
              "400040916"
            ]
          },
          "400040916": {
            "id": "400040916",
            "speakerId": 1003,
            "speakerName": "Bei'er",
            "text": "Of course, if it turns out you're not a real adeptus...",
            "nextDialogs": [
              "400040917"
            ]
          },
          "400040917": {
            "id": "400040917",
            "speakerId": 1004,
            "speakerName": "Crafty",
            "text": "Then please, don't blame our weapons for treating everyone equally..."
          }
        }
      }
    },

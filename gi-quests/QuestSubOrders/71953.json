          },
          "719530102": {
            "id": "719530102",
            "speakerId": 2003,
            "speakerName": "Uncle Tian",
            "text": "Fishing, you say... Well, it's certainly not a tool to hide my identity. I really do enjoy fishing.",
            "nextDialogs": [
              "719530103"
            ]
          },
          "719530103": {
            "id": "719530103",
            "speakerId": 2003,
            "speakerName": "Uncle Tian",
            "text": "After a life of struggle and strife, fishing is how I quiet down and clear my thoughts.",
            "nextDialogs": [
              "719530104"
            ]
          },
          "719530104": {
            "id": "719530104",
            "speakerId": 2003,
            "speakerName": "Uncle Tian",
            "text": "To be honest, I'm not even all that concerned about the value of my catches anymore... On the other hand, you seem quite concerned about that, don't you?",
            "nextDialogs": [
              "719530105"
            ]
          },
          "719530105": {
            "id": "719530105",
            "speakerId": 2003,
            "speakerName": "Uncle Tian",
            "text": "Haha, come now, of course I can see it. Here, you can take today's catch."
          }
        }
      }

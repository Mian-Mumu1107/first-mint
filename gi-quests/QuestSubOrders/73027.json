  "subQuests": [
    {
      "subId": "7302701",
      "subQuestName": "Leave the Ruin Golem",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730270101"
        ],
        "dialogs": {
          "730270101": {
            "id": "730270101",
            "speakerId": 20601,
            "speakerName": "Jazari",
            "text": "The gates to scholarship will open to whoever has a seeking heart.",
            "nextDialogs": [
              "730270102"
            ]
          },
          "730270102": {
            "id": "730270102",
            "speakerId": 20601,
            "speakerName": "Jazari",
            "text": "Now go for it with that in mind!"
          }
        }
      }
    },
    {
      "subId": "7302702",
      "subQuestName": "Check the area that was hit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730270201"
        ],
        "dialogs": {
          "730270201": {
            "id": "730270201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, Ararycan, what are you doing here?",
            "nextDialogs": [
              "730270202"
            ]
          },
          "730270202": {
            "id": "730270202",
            "speakerId": 20600,
            "speakerName": "Ararycan",
            "text": "Ararycan has been waiting for you here since Ararycan finished sowing the flowers.",
            "nextDialogs": [
              "730270203"
            ]
          },
          "730270203": {
            "id": "730270203",
            "speakerId": 20600,
            "speakerName": "Ararycan",
            "text": "But then, something just fell off the Great Iron Mountain. It almost hit Ararycan!",
            "nextDialogs": [
              "730270204"
            ]
          },
          "730270204": {
            "id": "730270204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no! We're sorry, Ararycan!",
            "nextDialogs": [
              "730270205"
            ]
          },
          "730270205": {
            "id": "730270205",
            "speakerId": 20600,
            "speakerName": "Ararycan",
            "text": "Paimon doesn't have to say sorry. Ararycan is fine. Ararycan is a fast runner, so Ararycan didn't get hit.",
            "nextDialogs": [
              "730270206"
            ]
          },
          "730270206": {
            "id": "730270206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just glad it didn't hurt you.",
            "nextDialogs": [
              "730270207"
            ]
          },
          "730270207": {
            "id": "730270207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The robot's severed arm must have broken the entrance to the underground ruins open. Well, at least it wasn't completely useless.",
            "nextDialogs": [
              "730270208"
            ]
          },
          "730270208": {
            "id": "730270208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Then let's go down and have a look. Who knows what nasty things wait for us down there!",
            "nextDialogs": [
              "730270209"
            ]
          },
          "730270209": {
            "id": "730270209",
            "speakerId": 20600,
            "speakerName": "Ararycan",
            "text": "Ararycan is going with you!"
          }
        }
      }
    },
    {
      "subId": "7302703",
      "subQuestName": "Enter the underground ruins",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730270301"
        ],
        "dialogs": {
          "730270301": {
            "id": "730270301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The glowing thing in there must be the Ruin Golem's Chaos Core. Y'know, the one Jazari talked about.",
            "nextDialogs": [
              "730270302"
            ]
          },
          "730270302": {
            "id": "730270302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's sealed by branches and vines, but something seems to be flowing out of it.",
            "nextDialogs": [
              "730270303"
            ]
          },
          "730270303": {
            "id": "730270303",
            "speakerId": 20600,
            "speakerName": "Ararycan",
            "text": "Ohh, it's the filthy stuff. Ararycan can feel it. This is what made the forest sick.",
            "nextDialogs": [
              "730270304"
            ]
          },
          "730270304": {
            "id": "730270304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, some Abyss Mages seem to be up to something around those big branches. This can't be good...",
            "nextDialogs": [
              "730270305"
            ]
          },
          "730270305": {
            "id": "730270305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon remembers Jazari said that the core's seal had been damaged. Maybe these Abyss Mages had something to do with it...",
            "nextDialogs": [
              "730270306"
            ]
          },
          "730270306": {
            "id": "730270306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, you should go and find a place to hide, Ararycan. Let's stop them!"
          }
        }
      }
    },
    {
      "subId": "7302704",
      "subQuestName": "Investigate the underground ruins",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730270401"
        ],
        "dialogs": {
          "730270401": {
            "id": "730270401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Phew, it's finally over!",
            "nextDialogs": [
              "730270402"
            ]
          },
          "730270402": {
            "id": "730270402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, it was a long journey, wasn't it?",
            "nextDialogs": [
              "730270404",
              "730270407"
            ]
          },
          "730270404": {
            "id": "730270404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh right, if he knows about the core, he can help us apply for some funding and all that stuff.",
            "nextDialogs": [
              "730270405"
            ]
          },
          "730270405": {
            "id": "730270405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#But Paimon's not gonna enroll in the Akademiya or anything. You aren't planning to either, right, {NICKNAME}?",
            "nextDialogs": [
              "730270409"
            ]
          },
          "730270409": {
            "id": "730270409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, we don't know what Marana's Avatar has to do with the Abyss Order yet, but it's a good thing that we cured the forest's illness all the same.",
            "nextDialogs": [
              "730270410"
            ]
          },
          "730270410": {
            "id": "730270410",
            "speakerId": 20600,
            "speakerName": "Ararycan",
            "text": "*sob* Thank you for helping Ararycan.",
            "nextDialogs": [
              "730270411"
            ]
          },
          "730270411": {
            "id": "730270411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're welcome, Ararycan.",
            "nextDialogs": [
              "730270412"
            ]
          },
          "730270412": {
            "id": "730270412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, what do you plan to do next, Ararycan?",
            "nextDialogs": [
              "730270413"
            ]
          },
          "730270413": {
            "id": "730270413",
            "speakerId": 20600,
            "speakerName": "Ararycan",
            "text": "Ararycan will celebrate Festival Utsava. But Ararycan worries about the forest's illness.",
            "nextDialogs": [
              "730270414"
            ]
          },
          "730270414": {
            "id": "730270414",
            "speakerId": 20600,
            "speakerName": "Ararycan",
            "text": "There's a chance that the bad things that made the forest sick will come back. Ararycan needs to guard the forest.",
            "nextDialogs": [
              "730270415"
            ]
          },
          "730270415": {
            "id": "730270415",
            "speakerId": 20600,
            "speakerName": "Ararycan",
            "text": "So Ararycan will come back here after Festival Utsava.",
            "nextDialogs": [
              "730270416"
            ]
          },
          "730270416": {
            "id": "730270416",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wow, Aranara really do have tough jobs.",
            "nextDialogs": [
              "730270417"
            ]
          },
          "730270417": {
            "id": "730270417",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "If you ever need any help, Ararycan, be sure to come to us!",
            "nextDialogs": [
              "730270418"
            ]
          },
          "730270418": {
            "id": "730270418",
            "speakerId": 20600,
            "speakerName": "Ararycan",
            "text": "Okay, Ararycan will.",
            "nextDialogs": [
              "730270419"
            ]
          },
          "730270419": {
            "id": "730270419",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe! Take care of yourself. We'll see each other soon!"
          },
          "730270407": {
            "id": "730270407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh yeah, and grandpa Royinjan will say, \"What an interesting story!\"",
            "nextDialogs": [
              "730270408"
            ]
          },
          "730270408": {
            "id": "730270408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Who'd know that we actually saved the forest?"
          }
        }
      }
    },

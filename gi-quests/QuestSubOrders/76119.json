              "761190204"
            ]
          },
          "761190204": {
            "id": "761190204",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon's curious... How exactly did you play with them earlier?",
            "nextDialogs": [
              "761190205"
            ]
          },
          "761190205": {
            "id": "761190205",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "You can't see anything if you don't use kuuvahki, but if you do use it, you'll see too clearly...",
            "nextDialogs": [
              "761190206"
            ]
          },
          "761190206": {
            "id": "761190206",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Well, I can open my eyes, right?",
            "nextDialogs": [
              "761190207"
            ]
          },
          "761190207": {
            "id": "761190207",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh yeah. Didn't think of that one..."
          }
        }
      }

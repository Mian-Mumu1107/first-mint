  },
  "subQuests": [
    {
      "subId": "7106605",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710660401"
        ],
        "dialogs": {
          "710660401": {
            "id": "710660401",
            "speakerId": 20220,
            "speakerName": "Weasel Thief Training Manual",
            "text": "\"...About the feeding schedule for Weasel Thieves...\"",
            "nextDialogs": [
              "710660402"
            ]
          },
          "710660402": {
            "id": "710660402",
            "speakerId": 20220,
            "speakerName": "Weasel Thief Training Manual",
            "text": "\"...Amateur Weasel Thief: Feed after noon to keep their excessive energy in check... Recommended Time: <color=#00E1FFFF>12:00–23:59</color>\"",
            "nextDialogs": [
              "710660403"
            ]
          },
          "710660403": {
            "id": "710660403",
            "speakerId": 20220,
            "speakerName": "Weasel Thief Training Manual",
            "text": "\"...Hoarder Weasel Thief: Feed before noon to allow a more flexible training schedule... Recommended Time: <color=#00E1FFFF>2:00–11:59</color>\"",
            "nextDialogs": [
              "710660404"
            ]
          },
          "710660404": {
            "id": "710660404",
            "speakerId": 20220,
            "speakerName": "Weasel Thief Training Manual",
            "text": "\"...Golden Weasel Thief: The most cunning of all. Limit its feeding and interacting window within two hours... Recommended Time: <color=#00E1FFFF>0:00–1:59</color>\"",
            "nextDialogs": [
              "710660405"
            ]
          },
          "710660405": {
            "id": "710660405",
            "speakerId": 20220,
            "speakerName": "Weasel Thief Training Manual",
            "text": "\"All Weasel Thieves listed above can be summoned during their respective feeding hours. Stand on a large rock and summon them by whistling. Avoid whistling for fun, as it may lead to unnecessary trouble!\"",
            "nextDialogs": [
              "710660406"
            ]
          },
          "710660406": {
            "id": "710660406",
            "speakerId": 20220,
            "speakerName": "Weasel Thief Training Manual",
            "text": "\"...By Erge. Weasel Thief Trainer on Duty This Month: Clitopho... Scheduled Days: 31 (Late: 27)...\"",
            "nextDialogs": [
              "710660407"
            ]
          },
          "710660407": {
            "id": "710660407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa! Don't the Treasure Hoarders ever take breaks?"
          }
        }
      }
    },
    {
      "subId": "7106601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710660701"
        ],
        "dialogs": {
          "710660701": {
            "id": "710660701",
            "speakerId": 2154,
            "speakerName": "Taliesin",
            "text": "Ahem... My bad. As a poet, I have a propensity for dramatic language and novel tales.",
            "nextDialogs": [
              "710660702"
            ]
          },
          "710660702": {
            "id": "710660702",
            "speakerId": 2154,
            "speakerName": "Taliesin",
            "text": "Hehe, truth be told, I found the ring in a Weasel Thieves' nest... It was well-preserved and eye-pleasing, so I kept it.",
            "nextDialogs": [
              "710660703"
            ]
          },
          "710660703": {
            "id": "710660703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph, so you're a thief too, you just stole from thieves!",
            "nextDialogs": [
              "710660704"
            ]
          },
          "710660704": {
            "id": "710660704",
            "speakerId": 2154,
            "speakerName": "Taliesin",
            "text": "Don't say that... I chanced upon it! That's right, it was chance! And though chance it be, the ring is quite precious to me all the same.",
            "nextDialogs": [
              "710660705"
            ]
          },
          "710660705": {
            "id": "710660705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you have any clue concerning the ring's whereabouts?",
            "nextDialogs": [
              "710660706"
            ]
          },
          "710660706": {
            "id": "710660706",
            "speakerId": 2154,
            "speakerName": "Taliesin",
            "text": "Yeah... I've heard that Weasel Thieves are often spotted around here. They might've stolen my ring while I was sleeping.",
            "nextDialogs": [
              "710660707"
            ]
          },
          "710660707": {
            "id": "710660707",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, so there really are people who take their rings off before going to bed...",
            "nextDialogs": [
              "710660708"
            ]
          },
          "710660708": {
            "id": "710660708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'd never heard of such people before, either.",
            "nextDialogs": [
              "710660709"
            ]
          },
          "710660709": {
            "id": "710660709",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, Paimon doesn't have that habit! You need to think about where to put the ring once you take it off, or you'll be wasting good beauty sleep.",
            "nextDialogs": [
              "710660710"
            ]
          },
          "710660710": {
            "id": "710660710",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do they even make rings tiny enough for you, Paimon?",
            "nextDialogs": [
              "710660711"
            ]
          },
          "710660711": {
            "id": "710660711",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph, of course they do! There's much you still don't know!",
            "nextDialogs": [
              "710660712"
            ]
          },
          "710660712": {
            "id": "710660712",
            "speakerId": 2154,
            "speakerName": "Taliesin",
            "text": "Enough. Please refrain from judging other people's way of living before proceeding to ramble on about your own! It's very rude!",
            "nextDialogs": [
              "710660713"
            ]
          },
          "710660713": {
            "id": "710660713",
            "speakerId": 2154,
            "speakerName": "Taliesin",
            "text": "...Anyway, if you want to help out... Please keep an eye out for Weasel Thief nests.",
            "nextDialogs": [
              "710660714"
            ]
          },
          "710660714": {
            "id": "710660714",
            "speakerId": 2154,
            "speakerName": "Taliesin",
            "text": "I've heard that there is a camp of suspicious Treasure Hoarders around here on the map... I've marked the location out for you.",
            "nextDialogs": [
              "710660715"
            ]
          },
          "710660715": {
            "id": "710660715",
            "speakerId": 2154,
            "speakerName": "Taliesin",
            "text": "It's said that Weasel Thieves are often spotted around here. Those sneaky Treasure Hoarders probably have something to do with them... Anyway, please take a look there.",
            "nextDialogs": [
              "710660716"
            ]
          },
          "710660716": {
            "id": "710660716",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph... A ring stolen from the Weasel Thieves, which was then stolen again by other Weasel Thieves. Paimon'd say it has gone back to its rightful owner!",
            "nextDialogs": [
              "710660717"
            ]
          },
          "710660717": {
            "id": "710660717",
            "speakerId": 2154,
            "speakerName": "Taliesin",
            "text": "Oh, come on, just stop it already!"
          }
        }
      }
    },
    {
      "subId": "7106602",
      "subQuestName": "Look for the ring that was stolen from Taliesin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710660201"
        ],
        "dialogs": {
          "710660201": {
            "id": "710660201",
            "speakerId": 2154,
            "speakerName": "Taliesin",
            "text": "You're back. Did you find it?",
            "nextDialogs": [
              "710660202"
            ]
          },
          "710660202": {
            "id": "710660202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Take a look. Is this your ring?"
          }
        }
      }
    },
    {
      "subId": "7106603",
      "subQuestName": "Give the ring back to Taliesin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710660301"
        ],
        "dialogs": {
          "710660301": {
            "id": "710660301",
            "speakerId": 2154,
            "speakerName": "Taliesin",
            "text": "Yes, it is! Thank you so much!",
            "nextDialogs": [
              "710660302"
            ]
          },
          "710660302": {
            "id": "710660302",
            "speakerId": 2154,
            "speakerName": "Taliesin",
            "text": "Please take these as your reward. It isn't much, but please don't feel offended. I'll compose verses to eulogize your deeds!"
          }
        }
      }
    },
    {
      "subId": "7106606",
      "subQuestName": "Give the ring back to Taliesin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710660601"
        ],
        "dialogs": {
          "710660601": {
            "id": "710660601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't believe this story."
          }
        }
      }
    },
    {
      "subId": "7106607",
      "subQuestName": "Give the ring back to Taliesin",
      "sceneId": null,

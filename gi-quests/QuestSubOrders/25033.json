    {
      "subId": "2503301",
      "subQuestName": "Talk to Tlatem",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250330101"
        ],
        "dialogs": {
          "250330101": {
            "id": "250330101",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Good boy, good boy! Eaten your fill today? Ready to train?",
            "nextDialogs": [
              "250330102"
            ]
          },
          "250330102": {
            "id": "250330102",
            "speakerId": 1001,
            "speakerName": "Qica",
            "text": "Raar, oroo, rrooh!",
            "nextDialogs": [
              "250330103"
            ]
          },
          "250330103": {
            "id": "250330103",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Pretty energetic today, aren't we? Awesome! Let's do this!",
            "nextDialogs": [
              "250330104"
            ]
          },
          "250330104": {
            "id": "250330104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yeah, let's do this!",
            "nextDialogs": [
              "250330106"
            ]
          },
          "250330106": {
            "id": "250330106",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Huh? Oh, hello there! We're doing some more mountain climbing training right now.",
            "nextDialogs": [
              "250330107"
            ]
          },
          "250330107": {
            "id": "250330107",
            "speakerId": 1001,
            "speakerName": "Qica",
            "text": "Rroo! Wrroo!",
            "nextDialogs": [
              "250330108"
            ]
          },
          "250330108": {
            "id": "250330108",
            "speakerId": 1001,
            "speakerName": "Qica",
            "text": "Wrooo, rrooh...",
            "nextDialogs": [
              "250330110",
              "250330113"
            ]
          },
          "250330110": {
            "id": "250330110",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Well... we're \"making progress.\" Qica's made it up a lot further this time.",
            "nextDialogs": [
              "250330111"
            ]
          },
          "250330111": {
            "id": "250330111",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "It's just that Qica's not very familiar with how you climb mountains, and...",
            "nextDialogs": [
              "250330116"
            ]
          },
          "250330116": {
            "id": "250330116",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Could you demonstrate for us again, by the way?"
          },
          "250330113": {
            "id": "250330113",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "That's right. Mom says I'm getting real good at caring for him.",
            "nextDialogs": [
              "250330114"
            ]
          },
          "250330114": {
            "id": "250330114",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Qica's improved loads. He can climb way higher than he could last time.",
            "nextDialogs": [
              "250330115"
            ]
          },
          "250330115": {
            "id": "250330115",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "It's just that Qica's not very familiar with how you climb mountains, and..."
          }
        }
      }
    },
    {
      "subId": "2503302",
      "subQuestName": "Climb to the top of the mountain",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250330201"
        ],
        "dialogs": {
          "250330201": {
            "id": "250330201",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "You're amazing! You're just about as fast as Mayta!",
            "nextDialogs": [
              "250330204"
            ]
          },
          "250330204": {
            "id": "250330204",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Heh, you're plenty fast already. Qica and I can't compare at all.",
            "nextDialogs": [
              "250330205"
            ]
          },
          "250330205": {
            "id": "250330205",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "*sigh* We'll be training for a long time before we can match you, I'd say...",
            "nextDialogs": [
              "250330206"
            ]
          },
          "250330206": {
            "id": "250330206",
            "speakerId": 1001,
            "speakerName": "Qica",
            "text": "Wroo, roooh..."
          }
        }
      }
    },
    {
      "subId": "2503303",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250330301"
        ],
        "dialogs": {
          "250330301": {
            "id": "250330301",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Wow, you're awesome! I still couldn't quite catch what you were doing...",
            "nextDialogs": [
              "250330302"
            ]
          },
          "250330302": {
            "id": "250330302",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "*sigh* We'll be training for a long time before we can match you, I'd say...",
            "nextDialogs": [
              "250330303"
            ]
          },
          "250330303": {
            "id": "250330303",
            "speakerId": 1001,
            "speakerName": "Qica",
            "text": "Wroo, roooh...",
            "nextDialogs": [
              "250330306"
            ]
          },
          "250330306": {
            "id": "250330306",
            "speakerId": 1001,
            "speakerName": "Qica",
            "text": "Oroo!? Hroo, Rrooh...",
            "nextDialogs": [
              "250330307"
            ]
          },
          "250330307": {
            "id": "250330307",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "That's a good boy, Qica. Remember what Uncle Yawar said? We'll get stronger as long as we keep working hard!",
            "nextDialogs": [
              "250330308"
            ]
          },
          "250330308": {
            "id": "250330308",
            "speakerId": 1001,
            "speakerName": "Qica",
            "text": "Roar...",
            "nextDialogs": [
              "250330309"
            ]
          },
          "250330309": {
            "id": "250330309",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Anyway, thanks a lot for your help. Here, have these fruits!",
            "nextDialogs": [
              "250330310"
            ]
          },
          "250330310": {
            "id": "250330310",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Qica just picked it up — and you know, he's moving way faster than he used to!",
            "nextDialogs": [
              "250330311"
            ]
          },
          "250330311": {
            "id": "250330311",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Hehe, I'm sure he's gotten this good because he's had you to look to as an example!",
            "nextDialogs": [
              "250330312"
            ]
          },
          "250330312": {
            "id": "250330312",
            "speakerId": 1001,
            "speakerName": "Qica",
            "text": "Wroo, rrooh!",
            "nextDialogs": [
              "250330313"
            ]
          },
          "250330313": {
            "id": "250330313",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Alright then, we're going to head back and look for Mayta. He should be back at the tribe settlement right now..."
          }
        }
      }

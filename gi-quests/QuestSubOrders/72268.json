    {
      "subId": "7226801",
      "subQuestName": "Talk to the afterimage in front of the seal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722680101"
        ],
        "dialogs": {
          "722680101": {
            "id": "722680101",
            "speakerId": 1000,
            "speakerName": "Uda",
            "text": "I am Uda of the Jibashiri. Hero of Sangonomiya, I acknowledge that you are worthy to take on this challenge.",
            "nextDialogs": [
              "722680102"
            ]
          },
          "722680102": {
            "id": "722680102",
            "speakerId": 1000,
            "speakerName": "Uda",
            "text": "I am in charge of the trial of \"wisdom.\" Go forth and solve all the puzzles to return the Flames of the High Gate to their places.",
            "nextDialogs": [
              "722680103"
            ]
          },
          "722680103": {
            "id": "722680103",
            "speakerId": 1000,
            "speakerName": "Uda",
            "text": "It is not bravery that advances bereft of wisdom, but foolhardiness instead!",
            "nextDialogs": [
              "722680104"
            ]
          },
          "722680104": {
            "id": "722680104",
            "speakerId": 1000,
            "speakerName": "Uda",
            "text": "I will await your completion of the challenge at the Tower of the Three Realms above."
          }
        }
      }
    },
    {
      "subId": "7226802",
      "subQuestName": "Release all the Flames of the High Gate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722680201"
        ],
        "dialogs": {
          "722680201": {
            "id": "722680201",
            "speakerId": 1000,
            "speakerName": "Uda",
            "text": "Go forth, hero of Sangonomiya, and take on the challenge!",
            "nextDialogs": [
              "722680202"
            ]
          },
          "722680202": {
            "id": "722680202",
            "speakerId": 1000,
            "speakerName": "Uda",
            "text": "Return all the Flames of the High Gate to their places."
          }
        }
      }
    },
    {
      "subId": "7226803",
      "subQuestName": "Release all the Flames of the High Gate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722680301"
        ],
        "dialogs": {
          "722680301": {
            "id": "722680301",
            "speakerId": 1000,
            "speakerName": "Uda",
            "text": "I, Uda of the Jibashiri, acknowledge your great valor.",
            "nextDialogs": [
              "722680302"
            ]
          },
          "722680302": {
            "id": "722680302",
            "speakerId": 1000,
            "speakerName": "Uda",
            "text": "Indeed, you are both \"extensive and meticulous\" in your wisdom.",
            "nextDialogs": [
              "722680303"
            ]
          },
          "722680303": {
            "id": "722680303",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "How can you tell a person's character from these trials?",
            "nextDialogs": [
              "722680304"
            ]
          },
          "722680304": {
            "id": "722680304",
            "speakerId": 1000,
            "speakerName": "Uda",
            "text": "To be honest, these words are praises that the Divine Priestess used to bestow upon skilled youths. They eventually came to be written on pennants at the Jibashiri headquarters."
          }
        }
      }
    },
    {
      "subId": "7226804",

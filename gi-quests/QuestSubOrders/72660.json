  "subQuests": [
    {
      "subId": "7266001",
      "subQuestName": "Talk to Kayabuki",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726600101"
        ],
        "dialogs": {
          "726600101": {
            "id": "726600101",
            "speakerId": 30065,
            "speakerName": "Kayabuki Ikkei",
            "text": "Why hello there, outlander! Do you have any interest in a little scrap, by any chance?",
            "nextDialogs": [
              "726600103",
              "726600105"
            ]
          },
          "726600103": {
            "id": "726600103",
            "speakerId": 30065,
            "speakerName": "Kayabuki Ikkei",
            "text": "Ah, wonderful! Glad I had my eye on the right person.",
            "nextDialogs": [
              "726600106"
            ]
          },
          "726600106": {
            "id": "726600106",
            "speakerId": 30065,
            "speakerName": "Kayabuki Ikkei",
            "text": "It's like this: recently, some people have organized a Hyakunin Ikki in secret again."
          },
          "726600105": {
            "id": "726600105",
            "speakerId": 30065,
            "speakerName": "Kayabuki Ikkei",
            "text": "Now, I wouldn't call this a commission..."
          }
        }
      }
    },
    {
      "subId": "7266002",
      "subQuestName": "Talk to Kayabuki",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726600201"
        ],
        "dialogs": {
          "726600201": {
            "id": "726600201",
            "speakerId": 30065,
            "speakerName": "Kayabuki Ikkei",
            "text": "Here we are.",
            "nextDialogs": [
              "726600202"
            ]
          },
          "726600202": {
            "id": "726600202",
            "speakerId": 30065,
            "speakerName": "Kayabuki Ikkei",
            "text": "You can enter the Hyakunin Ikki Dojo by stepping through this... rather suspicious door.",
            "nextDialogs": [
              "726600205"
            ]
          },
          "726600205": {
            "id": "726600205",
            "speakerId": 30065,
            "speakerName": "Kayabuki Ikkei",
            "text": "Though the Tengu-Kin have long been banned for flouting public order and morals, some still hold the Hyakunin Ikki free-for-all tournament from time to time.",
            "nextDialogs": [
              "726600206"
            ]
          },
          "726600206": {
            "id": "726600206",
            "speakerId": 30065,
            "speakerName": "Kayabuki Ikkei",
            "text": "Monsters, adventurers, and warriors who long for battle will be attracted here to engage in passionate battle on this stage.",
            "nextDialogs": [
              "726600207"
            ]
          },
          "726600207": {
            "id": "726600207",
            "speakerId": 30065,
            "speakerName": "Kayabuki Ikkei",
            "text": "Feel free to bring your friends and companions! After all, the \"Hyakunin\" in \"Hyakunin Ikki\" means the more, the merrier!",
            "nextDialogs": [
              "726600208"
            ]
          },
          "726600208": {
            "id": "726600208",
            "speakerId": 30065,
            "speakerName": "Kayabuki Ikkei",
            "text": "You seem like a well-traveled adventurer. You shouldn't lack for any companions to take part together with you.",
            "nextDialogs": [
              "726600209"
            ]
          },
          "726600209": {
            "id": "726600209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're not taking part?",
            "nextDialogs": [
              "726600210"
            ]
          },
          "726600210": {
            "id": "726600210",
            "speakerId": 30065,
            "speakerName": "Kayabuki Ikkei",
            "text": "Oh, of course I will — as a spectator, cheering you on!",
            "nextDialogs": [
              "726600211"
            ]
          },
          "726600211": {
            "id": "726600211",
            "speakerId": 30065,
            "speakerName": "Kayabuki Ikkei",
            "text": "In truth, my goal here is to write the most epic fighting novel ever and use it to take first prize in Yae Publishing House's \"This Novel Is Amazing!\" contest...",
            "nextDialogs": [
              "726600212"
            ]
          },
          "726600212": {
            "id": "726600212",
            "speakerId": 30065,
            "speakerName": "Kayabuki Ikkei",
            "text": "...And my gut tells me that your star will shine brightest in this arena."
          }
        }
      }
    }
  ]
}
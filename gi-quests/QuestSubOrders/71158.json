        "dialogs": {
          "711580301": {
            "id": "711580301",
            "speakerId": 1000,
            "speakerName": "Lan Yan",
            "text": "Another one finished. Mm, and the paint's all dry...",
            "nextDialogs": [
              "711580302"
            ]
          },
          "711580302": {
            "id": "711580302",
            "speakerId": 1000,
            "speakerName": "Lan Yan",
            "text": "Oh, happy holidays! Are you here for a Xiao Lantern too?",
            "nextDialogs": [
              "711580305"
            ]
          },
          "711580305": {
            "id": "711580305",
            "speakerId": 1000,
            "speakerName": "Lan Yan",
            "text": "You did? Oh! You made it yourself? I was going to weave one for you.",
            "nextDialogs": [
              "711580306"
            ]
          },
          "711580306": {
            "id": "711580306",
            "speakerId": 1000,
            "speakerName": "Lan Yan",
            "text": "In any case, here's to hoping every wish on our Xiao Lanterns comes true.",
            "nextDialogs": [
              "711580304"
            ]
          },
          "711580304": {
            "id": "711580304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are lots of people asking you for lanterns?",
            "nextDialogs": [
              "711580307"
            ]
          },
          "711580307": {
            "id": "711580307",
            "speakerId": 1000,
            "speakerName": "Lan Yan",
            "text": "Yep! You know how Miss Pingxi made a customizable lantern frame?",
            "nextDialogs": [
              "711580308"
            ]
          },
          "711580308": {
            "id": "711580308",
            "speakerId": 1000,
            "speakerName": "Lan Yan",
            "text": "Well, lots of people bought them to tinker with. Oh, Gaming got one too! I offered to help, but he was adamant about doing it himself.",
            "nextDialogs": [
              "711580309"
            ]
          },
          "711580309": {
            "id": "711580309",
            "speakerId": 1000,
            "speakerName": "Lan Yan",
            "text": "Some of my neighbors had an idea about what to make, but didn't know how to execute their vision, so they came to me for some hands-on help.",
            "nextDialogs": [
              "711580310"
            ]
          },
          "711580310": {
            "id": "711580310",
            "speakerId": 1000,
            "speakerName": "Lan Yan",
            "text": "And, after weaving them for everyone else, I made one for myself too.",
            "nextDialogs": [
              "711580311"
            ]
          },
          "711580311": {
            "id": "711580311",
            "speakerId": 1000,
            "speakerName": "Lan Yan",
            "text": "Now it's just time to release it... Huh... What wish should I write...?",
            "nextDialogs": [
              "711580312"
            ]
          },
          "711580312": {
            "id": "711580312",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You and Lan Yan release a Xiao Lantern together..."
          }
        }
      }
    }
  ]

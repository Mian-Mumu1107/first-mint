    {
      "subId": "30814",
      "subQuestName": "Talk to Lisa",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3081401"
        ],
        "dialogs": {
          "3081401": {
            "id": "3081401",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Dragon of the East, Lion of the South, Wolf of the North, Falcon of the West...",
            "nextDialogs": [
              "3081402"
            ]
          },
          "3081402": {
            "id": "3081402",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "They are the Four Winds of Mondstadt, affiliated with Barbatos, the God of Anemo.",
            "nextDialogs": [
              "3081403"
            ]
          },
          "3081403": {
            "id": "3081403",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "The Dragon of the East, Stormterror — its real name, is Dvalin.",
            "nextDialogs": [
              "3081404"
            ]
          },
          "3081404": {
            "id": "3081404",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Though most in Mondstadt seem to have forgotten that in all this \"Stormterror\" business.",
            "nextDialogs": [
              "3081405"
            ]
          },
          "3081405": {
            "id": "3081405",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "So now you know why Dvalin is only able to channel three of the Four Winds' power.",
            "nextDialogs": [
              "3081406"
            ]
          },
          "3081406": {
            "id": "3081406",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Because it has been consuming itself from the beginning.",
            "nextDialogs": [
              "3081409"
            ]
          },
          "3081409": {
            "id": "3081409",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Because of hatred, I presume.",
            "nextDialogs": [
              "3081410"
            ]
          },
          "3081410": {
            "id": "3081410",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hatred...?",
            "nextDialogs": [
              "3081411"
            ]
          },
          "3081411": {
            "id": "3081411",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Hatred for Mondstadt.",
            "nextDialogs": [
              "3081412"
            ]
          },
          "3081412": {
            "id": "3081412",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Hatred drove it to become something more powerful than the wind itself — to become Stormterror.",
            "nextDialogs": [
              "3081413"
            ]
          },
          "3081413": {
            "id": "3081413",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But why would one of The Four Winds...",
            "nextDialogs": [
              "3081414"
            ]
          },
          "3081414": {
            "id": "3081414",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hate the city it was supposed to protect?",
            "nextDialogs": [
              "3081415"
            ]
          },
          "3081415": {
            "id": "3081415",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "...",
            "nextDialogs": [
              "3081416"
            ]
          },
          "3081416": {
            "id": "3081416",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "As a child of Mondstadt, it's something that's really hard to say aloud.",
            "nextDialogs": [
              "3081417"
            ]
          },
          "3081417": {
            "id": "3081417",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Here, take this. It's a very old story from more than a century ago."
          }
        }
      }
    },

          },
          "3081102": {
            "id": "3081102",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "You're going to help me out too? How kind of you.",
            "nextDialogs": [
              "3081103"
            ]
          },
          "3081103": {
            "id": "3081103",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Don't hesitate to come to me if you need anything.",
            "nextDialogs": [
              "3081105",
              "3081109"
            ]
          },
          "3081105": {
            "id": "3081105",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Good question.",
            "nextDialogs": [
              "3081106"
            ]
          },
          "3081106": {
            "id": "3081106",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Basically, things other than that which require brawn... or brains.",
            "nextDialogs": [
              "3081107"
            ]
          },
          "3081107": {
            "id": "3081107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So... what does that leave?",
            "nextDialogs": [
              "3081111"
            ]
          },
          "3081111": {
            "id": "3081111",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "So you should as well."
          },
          "3081109": {
            "id": "3081109",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Hmm... Good question.",
            "nextDialogs": [
              "3081110"
            ]
          },
          "3081110": {
            "id": "3081110",
            "speakerId": 1007,
            "speakerName": "Lisa",
            "text": "Well, because Jean trusts me."
          }
        }

    {
      "subId": "7452004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745200401"
        ],
        "dialogs": {
          "745200401": {
            "id": "745200401",
            "speakerId": 1000,
            "speakerName": "Eula",
            "text": "#Ah, {NICKNAME}. Didn't expect to see you here.",
            "nextDialogs": [
              "745200404"
            ]
          },
          "745200404": {
            "id": "745200404",
            "speakerId": 1000,
            "speakerName": "Eula",
            "text": "A routine patrol, yeah. But as far as I'm concerned, this is a necessary activity that keeps me in fighting shape.",
            "nextDialogs": [
              "745200405"
            ]
          },
          "745200405": {
            "id": "745200405",
            "speakerId": 1000,
            "speakerName": "Eula",
            "text": "Mondstadt's enjoyed relative peace lately, and there have hardly been any threats worth mustering the Reconnaissance Company for. As a result, everyone's been going a bit soft.",
            "nextDialogs": [
              "745200406"
            ]
          },
          "745200406": {
            "id": "745200406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Work-life balance is a good thing, you know.",
            "nextDialogs": [
              "745200407"
            ]
          },
          "745200407": {
            "id": "745200407",
            "speakerId": 1000,
            "speakerName": "Eula",
            "text": "You're not wrong, but as Squad Leader, I must keep my combat strength up at all times.",
            "nextDialogs": [
              "745200408"
            ]
          },
          "745200408": {
            "id": "745200408",
            "speakerId": 1000,
            "speakerName": "Eula",
            "text": "After all, the swords of our enemies are not dulled by peace.",
            "nextDialogs": [
              "745200409"
            ]
          },
          "745200409": {
            "id": "745200409",
            "speakerId": 1000,
            "speakerName": "Eula",
            "text": "As such, I'm used to finding quiet places to practice my swordsmanship between patrols to make sure I don't get rusty."
          }
        }
      }
    }
  ]
}
    {
      "subId": "1504704",
      "subQuestName": "Meet up with Mualani",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150470401"
        ],
        "dialogs": {
          "150470401": {
            "id": "150470401",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "...Oh, so the facilities here are still under construction.",
            "nextDialogs": [
              "150470402"
            ]
          },
          "150470402": {
            "id": "150470402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Look, there's an iktomisaur employee! Should we ask him for help?",
            "nextDialogs": [
              "150470403"
            ]
          },
          "150470403": {
            "id": "150470403",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Hi there! Any chance you could give us a hand getting these built?",
            "nextDialogs": [
              "150470404"
            ]
          },
          "150470404": {
            "id": "150470404",
            "speakerId": 1002,
            "speakerName": "Iktomisaurus Chick",
            "text": "...",
            "nextDialogs": [
              "150470405"
            ]
          },
          "150470405": {
            "id": "150470405",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Um... Put... here... and build...",
            "nextDialogs": [
              "150470406"
            ]
          },
          "150470406": {
            "id": "150470406",
            "speakerId": 1002,
            "speakerName": "Iktomisaurus Chick",
            "text": "...",
            "nextDialogs": [
              "150470407"
            ]
          },
          "150470407": {
            "id": "150470407",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Doesn't look like he understands...",
            "nextDialogs": [
              "150470408"
            ]
          },
          "150470408": {
            "id": "150470408",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Yeah... Hmm, what should we do now?",
            "nextDialogs": [
              "150470409"
            ]
          },
          "150470409": {
            "id": "150470409",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "...Ohhhhh, hold on! A stroke of genius just came to me!",
            "nextDialogs": [
              "150470410"
            ]
          },
          "150470410": {
            "id": "150470410",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Eee!",
            "nextDialogs": [
              "150470411"
            ]
          },
          "150470411": {
            "id": "150470411",
            "speakerId": 1002,
            "speakerName": "Iktomisaurus Chick",
            "text": "...",
            "nextDialogs": [
              "150470412"
            ]
          },
          "150470412": {
            "id": "150470412",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Eee! Eee! Eee!",
            "nextDialogs": [
              "150470413"
            ]
          },
          "150470413": {
            "id": "150470413",
            "speakerId": 1002,
            "speakerName": "Iktomisaurus Chick",
            "text": "...",
            "nextDialogs": [
              "150470414"
            ]
          },
          "150470414": {
            "id": "150470414",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Hah, nope... Well at least we know he doesn't speak koholasaur!",
            "nextDialogs": [
              "150470415"
            ]
          },
          "150470415": {
            "id": "150470415",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why don't we just—",
            "nextDialogs": [
              "150470416"
            ]
          },
          "150470416": {
            "id": "150470416",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Oh, I've got another idea!",
            "nextDialogs": [
              "150470417"
            ]
          },
          "150470417": {
            "id": "150470417",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What now?",
            "nextDialogs": [
              "150470418"
            ]
          },
          "150470418": {
            "id": "150470418",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "I once heard Ifa mention that iktomisaurs go wild for Glowing Hornshrooms, and guess what I happen to have on me...?",
            "nextDialogs": [
              "150470419"
            ]
          },
          "150470419": {
            "id": "150470419",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "This has gotta be it! Once he eats this, we'll totally be on the same wavelength!",
            "nextDialogs": [
              "150470420"
            ]
          },
          "150470420": {
            "id": "150470420",
            "speakerId": 1002,
            "speakerName": "Iktomisaurus Chick",
            "text": "!",
            "nextDialogs": [
              "150470421"
            ]
          },
          "150470421": {
            "id": "150470421",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "There's no such thing as packing too much when you're heading out on a long trip... Kachina was spot on. Gotta remember to thank her for this...",
            "nextDialogs": [
              "150470422"
            ]
          },
          "150470422": {
            "id": "150470422",
            "speakerId": 1002,
            "speakerName": "Iktomisaurus Chick",
            "text": "...",
            "nextDialogs": [
              "150470423"
            ]
          },
          "150470423": {
            "id": "150470423",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uhhh, whatever that was, it's definitely not the wavelength Paimon's on...",
            "nextDialogs": [
              "150470424"
            ]
          },
          "150470424": {
            "id": "150470424",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "What a disaster... Day one, and there goes my dream of conquering all the challenges in Wavey Bay...",
            "nextDialogs": [
              "150470425"
            ]
          },
          "150470425": {
            "id": "150470425",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "#Got any ideas, {NICKNAME}, o great hero of Natlan...?",
            "nextDialogs": [
              "150470428"
            ]
          },
          "150470428": {
            "id": "150470428",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "#Okay, let's try that. Appreciate it, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "1504705",
      "subQuestName": "Meet up with Mualani",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150470501"
        ],
        "dialogs": {
          "150470501": {
            "id": "150470501",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You return, having indwelt an iktomisaurus...",
            "nextDialogs": [
              "150470502"
            ]
          },
          "150470502": {
            "id": "150470502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Mualani, we're back!",
            "nextDialogs": [
              "150470503"
            ]
          },
          "150470503": {
            "id": "150470503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "!",
            "nextDialogs": [
              "150470504"
            ]
          },
          "150470504": {
            "id": "150470504",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "#Oh, hey there! Aww, aren't you just the cutest? Wait, where'd {NICKNAME} go?",
            "nextDialogs": [
              "150470505"
            ]
          },
          "150470505": {
            "id": "150470505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Uh, {M#he}{F#she}... {M#His}{F#Her} stomach started acting up, so {M#he}{F#she} had to run to the bathroom...",
            "nextDialogs": [
              "150470506"
            ]
          },
          "150470506": {
            "id": "150470506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Seriously Paimon, that's such a lame cover story. Never mind, as long as Mualani buys it...)",
            "nextDialogs": [
              "150470507"
            ]
          },
          "150470507": {
            "id": "150470507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "!",
            "nextDialogs": [
              "150470508"
            ]
          },
          "150470508": {
            "id": "150470508",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "My, you're a friendly one! Wanna try a Glowing Hornshroom? Here, have at it!",
            "nextDialogs": [
              "150470509"
            ]
          },
          "150470509": {
            "id": "150470509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(A curious flavor, indeed. Thick, juicy, and surprisingly delicious, for a mushroom...)",
            "nextDialogs": [
              "150470510"
            ]
          },
          "150470510": {
            "id": "150470510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "!",
            "nextDialogs": [
              "150470511"
            ]
          },
          "150470511": {
            "id": "150470511",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Haha, glad you liked it! Here, they're all yours.",
            "nextDialogs": [
              "150470512"
            ]
          },
          "150470512": {
            "id": "150470512",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "C—Can I pet you? C'mon, let's be friends!",
            "nextDialogs": [
              "150470513"
            ]
          },
          "150470513": {
            "id": "150470513",
            "speakerId": 1002,
            "speakerName": "Iktomisaurus Chick",
            "text": "...",
            "nextDialogs": [
              "150470514"
            ]
          },
          "150470514": {
            "id": "150470514",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Also, could you... do me a favor?"
          }
        }
      }
    },
    {
      "subId": "1504706",
      "subQuestName": "Use the ability of an Iktomisaur to complete construction",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150470601"
        ],
        "dialogs": {
          "150470601": {
            "id": "150470601",
            "speakerId": 1002,
            "speakerName": "Iktomisaurus Chick",
            "text": "What is she yammering on about!? I don't understand. My friend asked me to look after this place... No one said anything about manual labor...",
            "nextDialogs": [
              "150470602"
            ]
          },
          "150470602": {
            "id": "150470602",
            "speakerId": 1002,
            "speakerName": "Iktomisaurus Chick",
            "text": "But those mushrooms tasted nice... If it means I can get some more of them..."
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "1504701",
      "subQuestName": "Head to the \"Twilight Cruise\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150470101"
        ],
        "dialogs": {
          "150470101": {
            "id": "150470101",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "You're here! Looks like the staff had to step out for a bit, but I've pretty much figured out how to take it for a spin... ahem, yeah, for testing purposes!",
            "nextDialogs": [
              "150470102"
            ]
          },
          "150470102": {
            "id": "150470102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Great, then show us the ropes!",
            "nextDialogs": [
              "150470103"
            ]
          },
          "150470103": {
            "id": "150470103",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Basically, one person rides the boat while the other sends signals to the saurian staff. Working as a team, the aim is to safely guide the boat to its destination.",
            "nextDialogs": [
              "150470104"
            ]
          },
          "150470104": {
            "id": "150470104",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "#So I'm pretty confident — 'cause when it comes to teamwork, {NICKNAME} and I have it down to a T!",
            "nextDialogs": [
              "150470105"
            ]
          },
          "150470105": {
            "id": "150470105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh really? Well, don't get too confident, or you might end up capsizing...",
            "nextDialogs": [
              "150470106"
            ]
          },
          "150470106": {
            "id": "150470106",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Whoa, Paimon, don't go around jinxing people!",
            "nextDialogs": [
              "150470107"
            ]
          },
          "150470107": {
            "id": "150470107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Okay, okay... Then Paimon wishes you... smooth sailing?",
            "nextDialogs": [
              "150470108"
            ]
          },
          "150470108": {
            "id": "150470108",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Hehe, that goes without saying.",
            "nextDialogs": [
              "150470109"
            ]
          },
          "150470109": {
            "id": "150470109",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "I'm actually kind of in the mood to ride the boat. I'm used to tough surfing challenges, so it'll be fun to switch it up!",
            "nextDialogs": [
              "150470112"
            ]
          },
          "150470112": {
            "id": "150470112",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "See, we're in perfect sync already! That's gotta be proof of our bond, huh?",
            "nextDialogs": [
              "150470113"
            ]
          },
          "150470113": {
            "id": "150470113",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Can't wait to pump up my inflatable swimsuit and bounce right onto the boat!"
          }
        }
      }
    },
    {

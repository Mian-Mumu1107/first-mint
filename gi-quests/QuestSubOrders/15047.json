    {
      "subId": "1504708",
      "subQuestName": "Meet up with Mualani",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150470801"
        ],
        "dialogs": {
          "150470801": {
            "id": "150470801",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Phew, looks like we're all done!",
            "nextDialogs": [
              "150470802"
            ]
          },
          "150470802": {
            "id": "150470802",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Thank you! I couldn't have done it without your help.",
            "nextDialogs": [
              "150470803"
            ]
          },
          "150470803": {
            "id": "150470803",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Mind if I pet you again? Aww, that's a good little buddy... You're the best!",
            "nextDialogs": [
              "150470804"
            ]
          },
          "150470804": {
            "id": "150470804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "!",
            "nextDialogs": [
              "150470805"
            ]
          },
          "150470805": {
            "id": "150470805",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um... Mualani, it's probably about time we took our friend back home.",
            "nextDialogs": [
              "150470806"
            ]
          },
          "150470806": {
            "id": "150470806",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "#Oh, sure. I'll wait here in case {NICKNAME} gets back in the meantime.",
            "nextDialogs": [
              "150470807"
            ]
          },
          "150470807": {
            "id": "150470807",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Such cute little things! Maybe I should get Granny to teach me some iktomisaur...",
            "nextDialogs": [
              "150470808"
            ]
          },
          "150470808": {
            "id": "150470808",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "#Oh, hey {NICKNAME}, how's the stomach?",
            "nextDialogs": [
              "150470809"
            ]
          },
          "150470809": {
            "id": "150470809",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Absolutely fine, thanks.",
            "nextDialogs": [
              "150470810"
            ]
          },
          "150470810": {
            "id": "150470810",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "Glad to hear it. Oh, you won't believe it — you just missed the sweetest little iktomisaur! Seriously, so adorable!",
            "nextDialogs": [
              "150470811"
            ]
          },
          "150470811": {
            "id": "150470811",
            "speakerId": 1000,
            "speakerName": "Mualani",
            "text": "It almost makes me wanna go stay with the Masters of the Night-Wind for a while, just so I can pick some more Glowing Hornshrooms and spend some time bonding with them!"
          }
        }
      }
    },

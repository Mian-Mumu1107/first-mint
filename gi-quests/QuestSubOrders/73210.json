          },
          "732100502": {
            "id": "732100502",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "The shelves are full of thin books. You browse through them, and find that they seem to be hospital documents such as medical records or financial statements.\\nYou shut the door in disappointment.",
            "nextDialogs": [
              "732100503"
            ]
          },
          "732100503": {
            "id": "732100503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon thought there would be some special treasure inside... Even the wooden barrels and crates we find on our adventures are better than this! At least those had cabbage or fowl inside...",
            "nextDialogs": [
              "732100504"
            ]
          },
          "732100504": {
            "id": "732100504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? What's this? It looks like it fell out from over here...",
            "nextDialogs": [
              "732100505"
            ]
          },
          "732100505": {
            "id": "732100505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let Paimon see... Maybe it'll lead us to treasure!",
            "nextDialogs": [
              "732100507"
            ]
          },
          "732100507": {
            "id": "732100507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh... Eleazar is so scary...",
            "nextDialogs": [
              "732100508"
            ]
          },
          "732100508": {
            "id": "732100508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, what does the other document say...?",
            "nextDialogs": [
              "732100510"
            ]
          },
          "732100510": {
            "id": "732100510",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Paimon didn't understand a thing!",
            "nextDialogs": [
              "732100511"
            ]
          },
          "732100511": {
            "id": "732100511",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "I didn't get it either...",
            "nextDialogs": [
              "732100512"
            ]
          },
          "732100512": {
            "id": "732100512",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon only understood the part that goes \"God's voice guides me\"... Does that mean there'll be unique voices guiding us here?",
            "nextDialogs": [
              "732100515"
            ]
          },
          "732100515": {
            "id": "732100515",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It could be underground water flow or creature activity...",
            "nextDialogs": [
              "732100516"
            ]
          },
          "732100516": {
            "id": "732100516",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah! Who knows, there might be some underground ruins! Let's listen for any sounds and take a closer look when we hear something!"
          }
        }

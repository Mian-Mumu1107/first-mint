    {
      "subId": "1907850",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190785001"
        ],
        "dialogs": {
          "190785001": {
            "id": "190785001",
            "speakerId": 13242,
            "speakerName": "Uzayr",
            "text": "Mr. Kaveh looked really angry...",
            "nextDialogs": [
              "190785002"
            ]
          },
          "190785002": {
            "id": "190785002",
            "speakerId": 13267,
            "speakerName": "Waiz",
            "text": "Who cares about him? Maybe he's just worried that we'll take all of his commissions once we finally graduate!",
            "nextDialogs": [
              "190785003"
            ]
          },
          "190785003": {
            "id": "190785003",
            "speakerId": 13268,
            "speakerName": "Tanisha",
            "text": "B—But that can't be it, right? Mr. Kaveh is super famous...",
            "nextDialogs": [
              "190785004"
            ]
          },
          "190785004": {
            "id": "190785004",
            "speakerId": 13267,
            "speakerName": "Waiz",
            "text": "Who knows? My dad told me that the more famous someone is, the more arrogant and stubborn they become. Approachable people like Mr. Alkami are the rare ones!"
          }
        }
      }
    },
    {
      "subId": "1907851",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190785101"
        ],
        "dialogs": {
          "190785101": {
            "id": "190785101",
            "speakerId": 12772,
            "speakerName": "Nabil",
            "text": "Hello. This institution has been shut down by order of the matra. We are currently conducting an investigation of all related personnel.",
            "nextDialogs": [
              "190785102"
            ]
          },
          "190785102": {
            "id": "190785102",
            "speakerId": 12772,
            "speakerName": "Nabil",
            "text": "Please come back tomorrow if you have any business here."
          }
        }
      }
    },
    {
      "subId": "1907852",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190785201"
        ],
        "dialogs": {
          "190785201": {
            "id": "190785201",
            "speakerId": 12741,
            "speakerName": "Noticeboard",
            "text": "A matra investigation has indicated that Alkami, the owner of this training center, coerced the families of his students to take on usurious loans with the intent of making huge profits.",
            "nextDialogs": [
              "190785202"
            ]
          },
          "190785202": {
            "id": "190785202",
            "speakerId": 12741,
            "speakerName": "Noticeboard",
            "text": "This training center is now closed. All recovered funds will be returned to the victims after confirmation with the relevant individuals."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2103001",
      "subQuestName": "Talk to Little Meng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210300101"
        ],
        "dialogs": {
          "210300101": {
            "id": "210300101",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Eh? These two ores aren't the same either?",
            "nextDialogs": [
              "210300102"
            ]
          },
          "210300102": {
            "id": "210300102",
            "speakerId": 2048,
            "speakerName": "Master Zhang",
            "text": "Of course not. The quality and price of anything forged from either of these types of ores would be completely different.",
            "nextDialogs": [
              "210300103"
            ]
          },
          "210300103": {
            "id": "210300103",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Um, but... But this is all we have left of these two types, right?",
            "nextDialogs": [
              "210300104"
            ]
          },
          "210300104": {
            "id": "210300104",
            "speakerId": 2048,
            "speakerName": "Master Zhang",
            "text": "*sigh*",
            "nextDialogs": [
              "210300105"
            ]
          },
          "210300105": {
            "id": "210300105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you two doing?",
            "nextDialogs": [
              "210300106"
            ]
          },
          "210300106": {
            "id": "210300106",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Hi there, Traveler! I'm currently helping Dad check on the ironware that he's ordered.",
            "nextDialogs": [
              "210300107"
            ]
          },
          "210300107": {
            "id": "210300107",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Mister Blacksmith over here is totally the best! He said he'd forge me a small sword, too!",
            "nextDialogs": [
              "210300108"
            ]
          },
          "210300108": {
            "id": "210300108",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "But he says that there haven't been enough raw materials to go around the store lately, so Dad's batch of ironware might be delayed...",
            "nextDialogs": [
              "210300109"
            ]
          },
          "210300109": {
            "id": "210300109",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "And I've got no idea when my sword will be ready, either...",
            "nextDialogs": [
              "210300110"
            ]
          },
          "210300110": {
            "id": "210300110",
            "speakerId": 2048,
            "speakerName": "Master Zhang",
            "text": "*sigh* Well, it can't be helped. We've been very busy lately, so we're more or less out of ore.",
            "nextDialogs": [
              "210300111"
            ]
          },
          "210300111": {
            "id": "210300111",
            "speakerId": 2048,
            "speakerName": "Master Zhang",
            "text": "The areas where ore is most plentiful are also occupied by many monsters, so I dare not go mining there...",
            "nextDialogs": [
              "210300112"
            ]
          },
          "210300112": {
            "id": "210300112",
            "speakerId": 2048,
            "speakerName": "Master Zhang",
            "text": "I can only try to tide this busy period over before asking an adventurer to escort me to an area where I can mine.",
            "nextDialogs": [
              "210300113"
            ]
          },
          "210300113": {
            "id": "210300113",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "But when will that be...",
            "nextDialogs": [
              "210300114"
            ]
          },
          "210300114": {
            "id": "210300114",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Actually, Traveler, I've heard that you're really good at beating monsters. Is that true?",
            "nextDialogs": [
              "210300115"
            ]
          },
          "210300115": {
            "id": "210300115",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "If it is, could you please help me out? Please...",
            "nextDialogs": [
              "210300118"
            ]
          },
          "210300118": {
            "id": "210300118",
            "speakerId": 2048,
            "speakerName": "Master Zhang",
            "text": "Traveler, are you going to check the situation out there? In that case, let me mark my usual mining spots on the map for you...",
            "nextDialogs": [
              "210300119"
            ]
          },
          "210300119": {
            "id": "210300119",
            "speakerId": 2048,
            "speakerName": "Master Zhang",
            "text": "Alright, that should do it. Be careful while you're there. Those places are crawling with monsters.",
            "nextDialogs": [
              "210300120"
            ]
          },
          "210300120": {
            "id": "210300120",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "I'm counting on you then, Traveler!"
          }
        }
      }
    },
    {
      "subId": "2103002",
      "subQuestName": "Go to where the monsters have gathered and defeat them",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210300201"
        ],
        "dialogs": {
          "210300201": {
            "id": "210300201",
            "speakerId": 2048,
            "speakerName": "Master Zhang",
            "text": "How are things going there, Traveler?",
            "nextDialogs": [
              "210300202"
            ]
          },
          "210300202": {
            "id": "210300202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They should be safe for now.",
            "nextDialogs": [
              "210300203"
            ]
          },
          "210300203": {
            "id": "210300203",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Wow, you're amazing!",
            "nextDialogs": [
              "210300204"
            ]
          },
          "210300204": {
            "id": "210300204",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Dad said that he will hire a few people to protect us while we're traveling.",
            "nextDialogs": [
              "210300205"
            ]
          },
          "210300205": {
            "id": "210300205",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "I just hope those people are as good as you are, Traveler...",
            "nextDialogs": [
              "210300206"
            ]
          },
          "210300206": {
            "id": "210300206",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Mister Blacksmith, does this mean that you can continue mining and making the ironware now?",
            "nextDialogs": [
              "210300207"
            ]
          },
          "210300207": {
            "id": "210300207",
            "speakerId": 2048,
            "speakerName": "Master Zhang",
            "text": "Hahaha, of course! Just give me a moment to prepare. I'll get those ores and be back in time to continue my work!",
            "nextDialogs": [
              "210300208"
            ]
          },
          "210300208": {
            "id": "210300208",
            "speakerId": 2048,
            "speakerName": "Master Zhang",
            "text": "That said, there is a limit to how much ore I can carry by myself. With any luck, that area should be free of monsters."
          }
        }
      }
    },
    {
      "subId": "2103003",
      "subQuestName": "Speak to Master Zhang",

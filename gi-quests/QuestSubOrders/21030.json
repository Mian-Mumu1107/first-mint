        "dialogs": {
          "210300301": {
            "id": "210300301",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "I'm counting on you then, Traveler!"
          }
        }
      }
    },
    {
      "subId": "2103004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210300401"
        ],
        "dialogs": {
          "210300401": {
            "id": "210300401",
            "speakerId": 12441,
            "speakerName": "Master Zhang",
            "text": "Be careful out there. Those mining spots are teeming with monsters."
          }
        }
      }
    }

    {
      "subId": "7310503",
      "subQuestName": "Stop the Treasure Hoarders",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7310505",
      "subQuestName": "Talk to the Treasure Hoarders",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731050501"
        ],
        "dialogs": {
          "731050501": {
            "id": "731050501",
            "speakerId": 20775,
            "speakerName": "Gobley",
            "text": "Please, have mercy! This is all just a big misunderstanding!",
            "nextDialogs": [
              "731050503",
              "731050506"
            ]
          },
          "731050503": {
            "id": "731050503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What have you done to Miss Alrani? Spill!",
            "nextDialogs": [
              "731050504"
            ]
          },
          "731050504": {
            "id": "731050504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Or... Or we will kick your butt!",
            "nextDialogs": [
              "731050507"
            ]
          },
          "731050507": {
            "id": "731050507",
            "speakerId": 20775,
            "speakerName": "Gobley",
            "text": "No, no, please... Please listen to me. You got it all wrong...",
            "nextDialogs": [
              "731050508"
            ]
          },
          "731050508": {
            "id": "731050508",
            "speakerId": 20775,
            "speakerName": "Gobley",
            "text": "We wouldn't dare mess with her. We are no match for her!"
          },
          "731050506": {
            "id": "731050506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Tell us what you know! Or... Or we'll kick your butt!"
          }
        }
      }
    },
    {
      "subId": "7310506",
      "subQuestName": "Look for Alrani",
      "sceneId": null,
      "locations": [],

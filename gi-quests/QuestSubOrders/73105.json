  "subQuests": [
    {
      "subId": "7310501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731050101"
        ],
        "dialogs": {
          "731050101": {
            "id": "731050101",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Alrani, where did you go...",
            "nextDialogs": [
              "731050102"
            ]
          },
          "731050102": {
            "id": "731050102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alrani?",
            "nextDialogs": [
              "731050103"
            ]
          },
          "731050103": {
            "id": "731050103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, Paimon remembers the name... The young lady who's always writing her thesis? The one we met at Watatsumi Island.",
            "nextDialogs": [
              "731050104"
            ]
          },
          "731050104": {
            "id": "731050104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right, she said she left Akademiya for some materials. She should have been back now.",
            "nextDialogs": [
              "731050105"
            ]
          },
          "731050105": {
            "id": "731050105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But the woman there seems really nervous... let's go ask her about it.",
            "nextDialogs": [
              "731050106"
            ]
          },
          "731050106": {
            "id": "731050106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "If Alrani did return to the Akademiya, we might as well stop by and say hello.",
            "nextDialogs": [
              "731050107"
            ]
          },
          "731050107": {
            "id": "731050107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Greetings. About Alrani...",
            "nextDialogs": [
              "731050108"
            ]
          },
          "731050108": {
            "id": "731050108",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Are you the Adventurers sent by the Adventurers' Guild!? Did you find Alrani?",
            "nextDialogs": [
              "731050109"
            ]
          },
          "731050109": {
            "id": "731050109",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "I know I've been pressing and I'm sorry for that. But she really worries me...",
            "nextDialogs": [
              "731050110"
            ]
          },
          "731050110": {
            "id": "731050110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, take it easy. We are not from the Adventurers' Guild. Just passing by.",
            "nextDialogs": [
              "731050111"
            ]
          },
          "731050111": {
            "id": "731050111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And you are...?",
            "nextDialogs": [
              "731050112"
            ]
          },
          "731050112": {
            "id": "731050112",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "You are not Adventurers? I'm so sorry. I haven't got any news from them. I'm so worried...",
            "nextDialogs": [
              "731050149"
            ]
          },
          "731050149": {
            "id": "731050149",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You tell the story of what you've been through with Alrani...",
            "nextDialogs": [
              "731050113"
            ]
          },
          "731050113": {
            "id": "731050113",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "So you are the Traveler Alrani keeps talking about...",
            "nextDialogs": [
              "731050114"
            ]
          },
          "731050114": {
            "id": "731050114",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "I'm Niloofar, researcher at the Akademiya... You could tell, right?",
            "nextDialogs": [
              "731050115"
            ]
          },
          "731050115": {
            "id": "731050115",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Be that as I am, I now devote most of my energy to teaching students on research.",
            "nextDialogs": [
              "731050116"
            ]
          },
          "731050116": {
            "id": "731050116",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Alrani is my student. She's been struggling with her thesis...",
            "nextDialogs": [
              "731050117"
            ]
          },
          "731050117": {
            "id": "731050117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You are... her mentor?",
            "nextDialogs": [
              "731050118"
            ]
          },
          "731050118": {
            "id": "731050118",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Miss Alrani said she had to rewrite many of her papers because they were disapproved by her mentor...",
            "nextDialogs": [
              "731050119"
            ]
          },
          "731050119": {
            "id": "731050119",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, this isn't the time for this. What happened to Miss Alrani?",
            "nextDialogs": [
              "731050120"
            ]
          },
          "731050120": {
            "id": "731050120",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "She... went missing...",
            "nextDialogs": [
              "731050121"
            ]
          },
          "731050121": {
            "id": "731050121",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Alrani came back all excited from Inazuma with a paper a while ago, which was about the folk culture of Watatsumi Island...",
            "nextDialogs": [
              "731050124"
            ]
          },
          "731050124": {
            "id": "731050124",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "I could tell. That paper is well written, and of a high standard in every respect...",
            "nextDialogs": [
              "731050125"
            ]
          },
          "731050125": {
            "id": "731050125",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "But... she submitted the paper too late! I asked her to send me the first draft in advance, but I never heard back.",
            "nextDialogs": [
              "731050126"
            ]
          },
          "731050126": {
            "id": "731050126",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "By the time she came back with the full version of her paper, someone had submitted one with exactly the same topic, which had already passed the preliminary review!",
            "nextDialogs": [
              "731050127"
            ]
          },
          "731050127": {
            "id": "731050127",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "I tried in every way to get her to pass the review, but she still didn't make it...",
            "nextDialogs": [
              "731050128"
            ]
          },
          "731050128": {
            "id": "731050128",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why's that? Miss Alrani started forming ideas for her papers long ago. How come it took so long...",
            "nextDialogs": [
              "731050129"
            ]
          },
          "731050129": {
            "id": "731050129",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait... Inazuma...",
            "nextDialogs": [
              "731050130"
            ]
          },
          "731050130": {
            "id": "731050130",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Sakoku Decree!",
            "nextDialogs": [
              "731050131"
            ]
          },
          "731050131": {
            "id": "731050131",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no...",
            "nextDialogs": [
              "731050132"
            ]
          },
          "731050132": {
            "id": "731050132",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "I've no idea how to break the news to her... I was going to think of a gentler way to let her know.",
            "nextDialogs": [
              "731050133"
            ]
          },
          "731050133": {
            "id": "731050133",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Then a motor mouth out of nowhere just spilled it all to her.",
            "nextDialogs": [
              "731050134"
            ]
          },
          "731050134": {
            "id": "731050134",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Then she went missing. I turned every stone in the Akademiya, and she was nowhere to be found. So I went to the Adventurers' Guild and put out a commission.",
            "nextDialogs": [
              "731050135"
            ]
          },
          "731050135": {
            "id": "731050135",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "They found nothing but Alrani's notebook at a place, and there was no sign of her.",
            "nextDialogs": [
              "731050136"
            ]
          },
          "731050136": {
            "id": "731050136",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "The Adventurers should still be searching for her everywhere...",
            "nextDialogs": [
              "731050137"
            ]
          },
          "731050137": {
            "id": "731050137",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "I... I don't know what to do... *sob*"
          }
        }
      }
    },

        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7310507",
      "subQuestName": "Talk to Alrani",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731050701"
        ],
        "dialogs": {
          "731050701": {
            "id": "731050701",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Alrani! Are you gonna come out of the cage or what!?",
            "nextDialogs": [
              "731050702"
            ]
          },
          "731050702": {
            "id": "731050702",
            "speakerId": 20088,
            "speakerName": "Alrani",
            "text": "No! No researcher, no academy anymore!",
            "nextDialogs": [
              "731050703"
            ]
          },
          "731050703": {
            "id": "731050703",
            "speakerId": 20088,
            "speakerName": "Alrani",
            "text": "I've paid you for this. Can't you leave me be!?",
            "nextDialogs": [
              "731050704"
            ]
          },
          "731050704": {
            "id": "731050704",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "You're stubborn, annoyingly stubborn...",
            "nextDialogs": [
              "731050707"
            ]
          },
          "731050707": {
            "id": "731050707",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He—Hello there...",
            "nextDialogs": [
              "731050708"
            ]
          },
          "731050708": {
            "id": "731050708",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Hmm? Oh, you are...",
            "nextDialogs": [
              "731050709"
            ]
          },
          "731050709": {
            "id": "731050709",
            "speakerId": 20088,
            "speakerName": "Alrani",
            "text": "Tr—Traveler! *sob*...",
            "nextDialogs": [
              "731050710"
            ]
          },
          "731050710": {
            "id": "731050710",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Miss Alrani, you really are here..."
          }
        }
      }
    },
    {
      "subId": "7310508",
      "subQuestName": "Report back to Niloofar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731050801"
        ],
        "dialogs": {
          "731050801": {
            "id": "731050801",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Traveler! Did you find Alrani?",
            "nextDialogs": [
              "731050802"
            ]
          },
          "731050802": {
            "id": "731050802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yes, but...",
            "nextDialogs": [
              "731050823"
            ]
          },
          "731050823": {
            "id": "731050823",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You tell Niloofar what happened and hand her the note...",
            "nextDialogs": [
              "731050803"
            ]
          },
          "731050803": {
            "id": "731050803",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Narzam? How...",
            "nextDialogs": [
              "731050804"
            ]
          },
          "731050804": {
            "id": "731050804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You know her?",
            "nextDialogs": [
              "731050805"
            ]
          },
          "731050805": {
            "id": "731050805",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Not personally. I heard someone mention her as some weird Treasure Hoarder.",
            "nextDialogs": [
              "731050806"
            ]
          },
          "731050806": {
            "id": "731050806",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "They say she would ask her victims a question when she plunders them.",
            "nextDialogs": [
              "731050807"
            ]
          },
          "731050807": {
            "id": "731050807",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Literature, Elements, all sorts of stuff. Even brain teasers.",
            "nextDialogs": [
              "731050808"
            ]
          },
          "731050808": {
            "id": "731050808",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "If you solve her problem, she will give back everything she looted, plus escorting you back to the city.",
            "nextDialogs": [
              "731050809"
            ]
          },
          "731050809": {
            "id": "731050809",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So she's a weirdo...",
            "nextDialogs": [
              "731050812"
            ]
          },
          "731050812": {
            "id": "731050812",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "No one knows. I know this because my mentor once met her in the wild.",
            "nextDialogs": [
              "731050813"
            ]
          },
          "731050813": {
            "id": "731050813",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Her question was: \"What quickly fills an empty room?\"",
            "nextDialogs": [
              "731050814"
            ]
          },
          "731050814": {
            "id": "731050814",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh...",
            "nextDialogs": [
              "731050815"
            ]
          },
          "731050815": {
            "id": "731050815",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's wind! Is Paimon right? It must be wind!",
            "nextDialogs": [
              "731050816"
            ]
          },
          "731050816": {
            "id": "731050816",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ugh... Candle light?",
            "nextDialogs": [
              "731050817"
            ]
          },
          "731050817": {
            "id": "731050817",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "My mentor answered, \"Elements are everywhere.\"",
            "nextDialogs": [
              "731050818"
            ]
          },
          "731050818": {
            "id": "731050818",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "731050819"
            ]
          },
          "731050819": {
            "id": "731050819",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's cheating!",
            "nextDialogs": [
              "731050820"
            ]
          },
          "731050820": {
            "id": "731050820",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Haha. Anyway, Narzam escorted my mentor back to the city and they practically had a goodbye in decorum.",
            "nextDialogs": [
              "731050821"
            ]
          },
          "731050821": {
            "id": "731050821",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "I wouldn't be so worried if Alrani is with her.",
            "nextDialogs": [
              "731050822"
            ]
          },
          "731050822": {
            "id": "731050822",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "But she can't stay there forever. I have to figure out a way to help her with her paper..."
          }
        }
      }
    },
    {
      "subId": "7310530",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731053001"
        ],
        "dialogs": {
          "731053001": {
            "id": "731053001",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Please be safe, Alrani...",
            "nextDialogs": [
              "731053003",
              "731053006"
            ]
          },
          "731053003": {
            "id": "731053003",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "She was quite a diligent kid. Though she always chased weird dead ends...",
            "nextDialogs": [
              "731053004"
            ]
          },
          "731053004": {
            "id": "731053004",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "She is more than qualified as a student, and I believe she will be so as a researcher."
          },
          "731053006": {
            "id": "731053006",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "To be honest, yes.",
            "nextDialogs": [
              "731053007"
            ]
          },
          "731053007": {
            "id": "731053007",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Paper review is complicated. You have to take into account your research focus, how extensive the references are...",
            "nextDialogs": [
              "731053008"
            ]
          },
          "731053008": {
            "id": "731053008",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "Also you should keep in mind any overlap or conflict between others' papers and your own. After your thesis proposal is submitted, you'll still bump into all kinds of difficulties.",
            "nextDialogs": [
              "731053009"
            ]
          },
          "731053009": {
            "id": "731053009",
            "speakerId": 20774,
            "speakerName": "Niloofar",
            "text": "*sigh* But I have to say, she's exceptionally unlucky..."
          }
        }
      }
    },
    {
      "subId": "7310531",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731053101"
        ],
        "dialogs": {
          "731053101": {
            "id": "731053101",
            "speakerId": 20776,
            "speakerName": "Narzam",
            "text": "Anything else?",
            "nextDialogs": [
              "731053103",
              "731053109"
            ]
          },
          "731053103": {
            "id": "731053103",
            "speakerId": 20776,
            "speakerName": "Narzam",
            "text": "\"Good\" to Alrani?",
            "nextDialogs": [
              "731053104"
            ]
          },
          "731053104": {
            "id": "731053104",
            "speakerId": 20776,
            "speakerName": "Narzam",
            "text": "Don't get me wrong. I do this for three simple reasons. First, Alrani has paid me for staying here.",
            "nextDialogs": [
              "731053105"
            ]
          },
          "731053105": {
            "id": "731053105",
            "speakerId": 20776,
            "speakerName": "Narzam",
            "text": "Second, I take only money, not lives. I'd ruin my reputation if I ditched her into the wild.",
            "nextDialogs": [
              "731053106"
            ]
          },
          "731053106": {
            "id": "731053106",
            "speakerId": 20776,
            "speakerName": "Narzam",
            "text": "Third, she's a learned lady who has a bright future.",
            "nextDialogs": [
              "731053107"
            ]
          },
          "731053107": {
            "id": "731053107",
            "speakerId": 20776,
            "speakerName": "Narzam",
            "text": "Being able to help her a little bit would give some credit to us Treasure Hoarders I guess? Hmph..."
          },
          "731053109": {
            "id": "731053109",
            "speakerId": 20776,
            "speakerName": "Narzam",
            "text": "No small amount. She said she earned that by making some \"fertilizers.\" Don't know what's that. Don't care.",
            "nextDialogs": [
              "731053110"
            ]
          },
          "731053110": {
            "id": "731053110",
            "speakerId": 20776,
            "speakerName": "Narzam",
            "text": "Anyways, she paid us, and we'll help her for now. That's it."
          }
        }
      }

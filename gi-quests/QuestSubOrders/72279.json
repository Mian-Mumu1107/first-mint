    {
      "subId": "7227903",
      "subQuestName": "Talk to Itto",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722790401"
        ],
        "dialogs": {
          "722790401": {
            "id": "722790401",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Hey hey, Traveler, Paimon! What's happening!",
            "nextDialogs": [
              "722790402"
            ]
          },
          "722790402": {
            "id": "722790402",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "You came here for the Irodori Festival, too? Oh, see, I knew it, great minds think alike, huh?",
            "nextDialogs": [
              "722790403"
            ]
          },
          "722790403": {
            "id": "722790403",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Hahahahaha!",
            "nextDialogs": [
              "722790404"
            ]
          },
          "722790404": {
            "id": "722790404",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "You're such a child.",
            "nextDialogs": [
              "722790405"
            ]
          },
          "722790405": {
            "id": "722790405",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "We're here to take care of a little problem.",
            "nextDialogs": [
              "722790406"
            ]
          },
          "722790406": {
            "id": "722790406",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Oh, oh right. Well, who's got a problem? The Arataki Gang considers it our born duty to help those in need!",
            "nextDialogs": [
              "722790409"
            ]
          },
          "722790409": {
            "id": "722790409",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Huh!?",
            "nextDialogs": [
              "722790410"
            ]
          },
          "722790410": {
            "id": "722790410",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "The Arataki Gang is the problem!",
            "nextDialogs": [
              "722790411"
            ]
          },
          "722790411": {
            "id": "722790411",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "The Tenryou Commission said you guys have been hogging the photo board and nobody else has had a chance to use it.",
            "nextDialogs": [
              "722790412"
            ]
          },
          "722790412": {
            "id": "722790412",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Oh... uh... well... no we haven't..."
          }
        }
      }
    },

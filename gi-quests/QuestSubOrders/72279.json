  "subQuests": [
    {
      "subId": "7227919",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722791901"
        ],
        "dialogs": {
          "722791901": {
            "id": "722791901",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "What a nice surprise meeting you guys here.",
            "nextDialogs": [
              "722791902"
            ]
          },
          "722791902": {
            "id": "722791902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What brings you here?",
            "nextDialogs": [
              "722791903"
            ]
          },
          "722791903": {
            "id": "722791903",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "Well, I heard that a certain well-known individual had made an appearance at the festival and taken quite a liking to the Tanuki photo board.",
            "nextDialogs": [
              "722791904"
            ]
          },
          "722791904": {
            "id": "722791904",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "Since the Yashiro Commission is the host of this festival, I felt I simply had to come and meet them in person.",
            "nextDialogs": [
              "722791905"
            ]
          },
          "722791905": {
            "id": "722791905",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "Red horns... If I'm not mistaken, you must be the esteemed Arataki Itto, leader of the widely renowned Arataki Gang, is that right?",
            "nextDialogs": [
              "722791906"
            ]
          },
          "722791906": {
            "id": "722791906",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Hahahahaha! Thoma, my bro, your eyes do not deceive you!",
            "nextDialogs": [
              "722791907"
            ]
          },
          "722791907": {
            "id": "722791907",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "And you are the housekeeper extraordinaire of the Kamisato Clan! You're quite the celebrity yourself, you know.",
            "nextDialogs": [
              "722791908"
            ]
          },
          "722791908": {
            "id": "722791908",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "Well, I'm flattered, Itto. And it's nice to meet you too, bro.",
            "nextDialogs": [
              "722791909"
            ]
          },
          "722791909": {
            "id": "722791909",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Whoa, there's a serious bromance developing here.",
            "nextDialogs": [
              "722791910"
            ]
          },
          "722791910": {
            "id": "722791910",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "I didn't expect to run into both Itto and the Traveler here.",
            "nextDialogs": [
              "722791911"
            ]
          },
          "722791911": {
            "id": "722791911",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "Speaking of which, I kind of count as the host here. So is anything wrong? Don't worry, you can tell me anything.",
            "nextDialogs": [
              "722791912"
            ]
          },
          "722791912": {
            "id": "722791912",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "It's all Itto! He wants to—",
            "nextDialogs": [
              "722791913"
            ]
          },
          "722791913": {
            "id": "722791913",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Ah, no no no, it's no big deal. We were just about to have a duel, and we're trying to think what format it should take.",
            "nextDialogs": [
              "722791914"
            ]
          },
          "722791914": {
            "id": "722791914",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "Oh... a duel...",
            "nextDialogs": [
              "722791915"
            ]
          },
          "722791915": {
            "id": "722791915",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "In that case, I have a suggestion. Since your duel is taking place at the Irodori Festival, why don't you have a volunteering competition?",
            "nextDialogs": [
              "722791916"
            ]
          },
          "722791916": {
            "id": "722791916",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "Then you can both do your part for the Irodori Festival while settling your duel at the same time. What do you think?",
            "nextDialogs": [
              "722791917"
            ]
          },
          "722791917": {
            "id": "722791917",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Volunteering competition? Hmm, sounds a little low-key. Not quite hard-core enough for the Arataki Gang...",
            "nextDialogs": [
              "722791918"
            ]
          },
          "722791918": {
            "id": "722791918",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "#I give this idea an interest rating of two points. One for {NICKNAME}, one for Thoma.",
            "nextDialogs": [
              "722791919"
            ]
          },
          "722791919": {
            "id": "722791919",
            "speakerId": 1003,
            "speakerName": "Mamoru",
            "text": "Boss means, uh... two points out of a hundred.",
            "nextDialogs": [
              "722791920"
            ]
          },
          "722791920": {
            "id": "722791920",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "Haha, yeah, this job isn't the most high-stakes, that's for sure. It just takes a little patience and responsibility.",
            "nextDialogs": [
              "722791921"
            ]
          },
          "722791921": {
            "id": "722791921",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "Also, since it's volunteering, by definition there's no remuneration. All you'll get is this special-edition drink from Sailing Breeze as a small token of appreciation...",
            "nextDialogs": [
              "722791922"
            ]
          },
          "722791922": {
            "id": "722791922",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "On second thought, this is nowhere near enough for the prestigious Arataki Gang. I don't know what I was thinking.",
            "nextDialogs": [
              "722791923"
            ]
          },
          "722791923": {
            "id": "722791923",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Wait, wait, wait a sec... What was that part about the, uh, token of appreciation?",
            "nextDialogs": [
              "722791924"
            ]
          },
          "722791924": {
            "id": "722791924",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "Oh, it's just a special-edition drink produced by Yae Publishing House and Sailing Breeze. It's really nothing special.",
            "nextDialogs": [
              "722791925"
            ]
          },
          "722791925": {
            "id": "722791925",
            "speakerId": 1004,
            "speakerName": "Akira",
            "text": "Boss! That's the one!",
            "nextDialogs": [
              "722791926"
            ]
          },
          "722791926": {
            "id": "722791926",
            "speakerId": 1005,
            "speakerName": "Genta",
            "text": "If we take this gig, we'll get that drink!",
            "nextDialogs": [
              "722791927"
            ]
          },
          "722791927": {
            "id": "722791927",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Oh... so uh, Thoma, my bro, my guy, my dude, maybe I didn't explain properly. When I said two points, that's out of a total of two.",
            "nextDialogs": [
              "722791928"
            ]
          },
          "722791928": {
            "id": "722791928",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "If there's one thing the Arataki Gang is known for, I kid you not, it's our patience and responsibility!",
            "nextDialogs": [
              "722791929"
            ]
          },
          "722791929": {
            "id": "722791929",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "It's an awesome idea, totally hard-core. Practically tailor-made just for me! Hahahahaha!",
            "nextDialogs": [
              "722791930"
            ]
          },
          "722791930": {
            "id": "722791930",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "#{NICKNAME}, let's do this for our duel, it'll be amazing! Whoever volunteers the hardest wins! What do you think?",
            "nextDialogs": [
              "722791931"
            ]
          },
          "722791931": {
            "id": "722791931",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "You didn't seem too interested in it just a second ago.",
            "nextDialogs": [
              "722791934"
            ]
          },
          "722791934": {
            "id": "722791934",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Hey, this is the mighty Arataki \"Above All, Bold-Blooded\" Itto you're talking to here! I'm a say-what-I-mean, mean-what-I-say, might-sound-mean-but-I-say-it-anyway kinda guy. And I say, we're gonna have this duel!",
            "nextDialogs": [
              "722791935"
            ]
          },
          "722791935": {
            "id": "722791935",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "AKA, doesn't-want-people-to-know-he's-only-doing-it-for-the-drinks kinda guy.",
            "nextDialogs": [
              "722791936"
            ]
          },
          "722791936": {
            "id": "722791936",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "If it's decided, then allow me to take the role of your judge.",
            "nextDialogs": [
              "722791937"
            ]
          },
          "722791937": {
            "id": "722791937",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "The volunteer work is simple. You just need to give your help to people who need it during the festival.",
            "nextDialogs": [
              "722791938"
            ]
          },
          "722791938": {
            "id": "722791938",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "I will assign some job requests that I've already received to you.",
            "nextDialogs": [
              "722791939"
            ]
          },
          "722791939": {
            "id": "722791939",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "If you're ready, we can begin."
          }
        }
      }
    },
    {
      "subId": "7227901",
      "subQuestName": "Talk to Kimura",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722790101"
        ],
        "dialogs": {
          "722790101": {
            "id": "722790101",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "So many complaints... What should I do?",
            "nextDialogs": [
              "722790102"
            ]
          },
          "722790102": {
            "id": "722790102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Need any help?",
            "nextDialogs": [
              "722790103"
            ]
          },
          "722790103": {
            "id": "722790103",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "Ah, are you the Traveler who my superiors said would come and help us out?",
            "nextDialogs": [
              "722790104"
            ]
          },
          "722790104": {
            "id": "722790104",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "You came at the perfect time. We're facing a small problem here.",
            "nextDialogs": [
              "722790105"
            ]
          },
          "722790105": {
            "id": "722790105",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "As you know, the Irodori Festival is underway.",
            "nextDialogs": [
              "722790106"
            ]
          },
          "722790106": {
            "id": "722790106",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "In addition to all the things on sale, there's a lot of free entertainment programs available.",
            "nextDialogs": [
              "722790107"
            ]
          },
          "722790107": {
            "id": "722790107",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "But today, we received numerous complaints that a group of people has been hogging the Tanuki photo board.",
            "nextDialogs": [
              "722790108"
            ]
          },
          "722790108": {
            "id": "722790108",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "They won't leave, so no one else gets to use it.",
            "nextDialogs": [
              "722790109"
            ]
          },
          "722790109": {
            "id": "722790109",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "*sigh* What a headache.",
            "nextDialogs": [
              "722790111",
              "722790116"
            ]
          },
          "722790111": {
            "id": "722790111",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "Well... we tried talking to them, but the original point of these entertainment facilities was to let people freely enjoy the festival.",
            "nextDialogs": [
              "722790112"
            ]
          },
          "722790112": {
            "id": "722790112",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "So in principle, it's open to everyone, and there's no time limit on usage.",
            "nextDialogs": [
              "722790113"
            ]
          },
          "722790113": {
            "id": "722790113",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "This means that as long as they haven't done anything technically illegal, even if they keep hogging it...",
            "nextDialogs": [
              "722790114"
            ]
          },
          "722790114": {
            "id": "722790114",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "...there is nothing we can do.",
            "nextDialogs": [
              "722790121"
            ]
          },
          "722790121": {
            "id": "722790121",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "So, can you try negotiating with them for us?",
            "nextDialogs": [
              "722790122"
            ]
          },
          "722790122": {
            "id": "722790122",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "If these complaints can't be resolved, and Madam Kujou finds out...",
            "nextDialogs": [
              "722790123"
            ]
          },
          "722790123": {
            "id": "722790123",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "...I'll lose my bonus this month for sure.",
            "nextDialogs": [
              "722790124"
            ]
          },
          "722790124": {
            "id": "722790124",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hogging a photo board, huh? We know who would do something like that...",
            "nextDialogs": [
              "722790125"
            ]
          },
          "722790125": {
            "id": "722790125",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Should we go and have a look, {NICKNAME}?",
            "nextDialogs": [
              "722790126"
            ]
          },
          "722790126": {
            "id": "722790126",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "Thank you so much! You'll find them by the Tanuki photo board just east of the square."
          },
          "722790116": {
            "id": "722790116",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "Uh... arrest them? Well, it would solve the immediate problem...",
            "nextDialogs": [
              "722790117"
            ]
          },
          "722790117": {
            "id": "722790117",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "But don't you think that if the Tenryou Commission starts arresting people without good cause, we'll soon have a bigger problem on our hands?",
            "nextDialogs": [
              "722790118"
            ]
          },
          "722790118": {
            "id": "722790118",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "The first thing we tried was negotiating with them. But ultimately, these facilities are open to everyone, and there's no time limit on usage.",
            "nextDialogs": [
              "722790119"
            ]
          },
          "722790119": {
            "id": "722790119",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "This means that as long as they haven't done anything technically illegal, even if they keep hogging it...",
            "nextDialogs": [
              "722790120"
            ]
          },
          "722790120": {
            "id": "722790120",
            "speakerId": 1006,
            "speakerName": "Kimura",
            "text": "...there is nothing we can do."
          }
        }
      }
    },
    {
      "subId": "7227902",

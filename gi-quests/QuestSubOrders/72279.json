    {
      "subId": "7227917",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722791701"
        ],
        "dialogs": {
          "722791701": {
            "id": "722791701",
            "speakerId": 1007,
            "speakerName": "Hiraizumi",
            "text": "I didn't expect the Irodori Festival to be so busy this time..."
          }
        }
      }
    },
    {
      "subId": "7227912",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722791201"
        ],
        "dialogs": {
          "722791201": {
            "id": "722791201",
            "speakerId": 1008,
            "speakerName": "Ishida",
            "text": "You've finished already? Wow, you work hard!",
            "nextDialogs": [
              "722791202"
            ]
          },
          "722791202": {
            "id": "722791202",
            "speakerId": 1008,
            "speakerName": "Ishida",
            "text": "You're wonderful people, all you volunteers. Thank you so much."
          }
        }
      }
    },
    {
      "subId": "7227904",
      "subQuestName": "Help the festival stall owner",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722790801"
        ],
        "dialogs": {
          "722790801": {
            "id": "722790801",
            "speakerId": 1008,
            "speakerName": "Ishida",
            "text": "Are you the volunteers? Perfect timing.",
            "nextDialogs": [
              "722790802"
            ]
          },
          "722790802": {
            "id": "722790802",
            "speakerId": 1008,
            "speakerName": "Ishida",
            "text": "As you can see, there's a lot of dust and dead leaves around my stand.",
            "nextDialogs": [
              "722790803"
            ]
          },
          "722790803": {
            "id": "722790803",
            "speakerId": 1008,
            "speakerName": "Ishida",
            "text": "I've just been so busy with my customers these past few days. I keep meaning to sweep up, but I just haven't found a spare moment...",
            "nextDialogs": [
              "722790804"
            ]
          },
          "722790804": {
            "id": "722790804",
            "speakerId": 1008,
            "speakerName": "Ishida",
            "text": "Can you help me clean up the place, please? Thank you so much!"
          }
        }
      }
    },
    {
      "subId": "7227905",
      "subQuestName": "Help to clean the area around the stall",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7227918",
      "subQuestName": "Help to clean the area around the stall",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722791801"
        ],
        "dialogs": {
          "722791801": {
            "id": "722791801",
            "speakerId": 1009,
            "speakerName": "Takeuchi",
            "text": "Ah, you must be the volunteers here to save the day.",
            "nextDialogs": [
              "722791802"
            ]
          },
          "722791802": {
            "id": "722791802",
            "speakerId": 1009,
            "speakerName": "Takeuchi",
            "text": "You must be tired. Put down the goods and have a rest.",
            "nextDialogs": [
              "722791803"
            ]
          },
          "722791803": {
            "id": "722791803",
            "speakerId": 1009,
            "speakerName": "Takeuchi",
            "text": "I heard the Yashiro Commission has arranged for Sailing Breeze to prepare some special drinks for the volunteers as a way of saying thank-you.",
            "nextDialogs": [
              "722791804"
            ]
          },
          "722791804": {
            "id": "722791804",
            "speakerId": 1009,
            "speakerName": "Takeuchi",
            "text": "Soy milk is actually one of the ingredients for the drink. It's freshly made every day!",
            "nextDialogs": [
              "722791805"
            ]
          },
          "722791805": {
            "id": "722791805",
            "speakerId": 1009,
            "speakerName": "Takeuchi",
            "text": "In fact, the last batch of soy milk we processed has just been sent over. You'll get to try it very soon.",
            "nextDialogs": [
              "722791806"
            ]
          },
          "722791806": {
            "id": "722791806",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "What!? So Sailing Breeze's special drink... has soy milk in it!?",
            "nextDialogs": [
              "722791807"
            ]
          },
          "722791807": {
            "id": "722791807",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Itto won't be able to drink that!",
            "nextDialogs": [
              "722791808"
            ]
          },
          "722791808": {
            "id": "722791808",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hurry, we've gotta get to Sailing Breeze before he does..."
          }
        }
      }
    },
    {
      "subId": "7227906",
      "subQuestName": "Report back to Ishida",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7227907",
      "subQuestName": "Help the visitor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722790901"
        ],
        "dialogs": {
          "722790901": {
            "id": "722790901",
            "speakerId": 1010,
            "speakerName": "Kid Kujirai",
            "text": "#Hey, {F#Miss}{M#Mister}! Come and help me!",
            "nextDialogs": [
              "722790902"
            ]
          },
          "722790902": {
            "id": "722790902",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hey, Kujirai, fancy meeting you here at the festival. But we don't have time to play games with you right now.",
            "nextDialogs": [
              "722790903"
            ]
          },
          "722790903": {
            "id": "722790903",
            "speakerId": 1010,
            "speakerName": "Kid Kujirai",
            "text": "I'm not playing games! I'm in trouble!",
            "nextDialogs": [
              "722790904"
            ]
          },
          "722790904": {
            "id": "722790904",
            "speakerId": 1010,
            "speakerName": "Kid Kujirai",
            "text": "I heard they were selling a new kind of Temari at the festival, so I came to check it out...",
            "nextDialogs": [
              "722790905"
            ]
          },
          "722790905": {
            "id": "722790905",
            "speakerId": 1010,
            "speakerName": "Kid Kujirai",
            "text": "But I couldn't find it anywhere, and then I went and lost my current one...",
            "nextDialogs": [
              "722790906"
            ]
          },
          "722790906": {
            "id": "722790906",
            "speakerId": 1010,
            "speakerName": "Kid Kujirai",
            "text": "*sobbing* It's gotta be nearby. I still had it a moment ago...",
            "nextDialogs": [
              "722790907"
            ]
          },
          "722790907": {
            "id": "722790907",
            "speakerId": 1010,
            "speakerName": "Kid Kujirai",
            "text": "#Can you help me, {F#Miss}{M#Mister}?",
            "nextDialogs": [
              "722790908"
            ]
          },
          "722790908": {
            "id": "722790908",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So basically, every time we run into you, we have to go Temari-hunting..."
          }
        }
      }
    },
    {
      "subId": "7227911",
      "subQuestName": "Find Kid Kujirai's Temari",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722791101"
        ],
        "dialogs": {
          "722791101": {
            "id": "722791101",
            "speakerId": 1008,
            "speakerName": "Ishida",
            "text": "I'm so grateful to have you helping out..."
          }
        }
      }
    },
    {
      "subId": "7227913",
      "subQuestName": "Talk to Kid Kujirai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722791501"
        ],
        "dialogs": {
          "722791501": {
            "id": "722791501",
            "speakerId": 1010,
            "speakerName": "Kid Kujirai",
            "text": "Great! Now I can play the Temari game again!",
            "nextDialogs": [
              "722791502"
            ]
          },
          "722791502": {
            "id": "722791502",
            "speakerId": 1010,
            "speakerName": "Kid Kujirai",
            "text": "#Thanks, {F#Miss}{M#Mister}!"
          }
        }
      }
    },
    {
      "subId": "7227908",
      "subQuestName": "Head to the port",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722791601"
        ],
        "dialogs": {
          "722791601": {
            "id": "722791601",
            "speakerId": 1007,
            "speakerName": "Hiraizumi",
            "text": "Are you the festival volunteers?",
            "nextDialogs": [
              "722791602"
            ]
          },
          "722791602": {
            "id": "722791602",
            "speakerId": 1007,
            "speakerName": "Hiraizumi",
            "text": "Great. I was just wondering what to do about these goods. It's been really busy lately, and all the workers at the port are swamped.",
            "nextDialogs": [
              "722791603"
            ]
          },
          "722791603": {
            "id": "722791603",
            "speakerId": 1007,
            "speakerName": "Hiraizumi",
            "text": "But I have to get all this fresh soy milk delivered to the warehouse as soon as possible. It'll go bad if it's left outside too long.",
            "nextDialogs": [
              "722791604"
            ]
          },
          "722791604": {
            "id": "722791604",
            "speakerId": 1007,
            "speakerName": "Hiraizumi",
            "text": "Can you please help me take it to the warehouse? My coworker, Takeuchi, will be waiting for you there. Thank you so much."
          }
        }
      }
    },
    {
      "subId": "7227914",
      "subQuestName": "Take the goods to the warehouse",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722791401"
        ],
        "dialogs": {
          "722791401": {
            "id": "722791401",
            "speakerId": 1010,
            "speakerName": "Kid Kujirai",
            "text": "Did you find my Temari yet?"
          }
        }
      }
    },
    {
      "subId": "7227915",
      "subQuestName": "Talk to Takeuchi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7227909",
      "subQuestName": "Go to Sailing Breeze",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7227910",
      "subQuestName": "Talk to Itto",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722791001"
        ],
        "dialogs": {
          "722791001": {
            "id": "722791001",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Hahahaha! What took you so long? I've been here ages — completed my tasks a long time ago.",
            "nextDialogs": [
              "722791002"
            ]
          },
          "722791002": {
            "id": "722791002",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "So there you have it, when volunteering's the name of the game, no one volunteers harder than Arataki Itto! Hahaha!",
            "nextDialogs": [
              "722791003"
            ]
          },
          "722791003": {
            "id": "722791003",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "#You lose, I win, {NICKNAME}, and to the victor go the special-edition spoils....",
            "nextDialogs": [
              "722791004"
            ]
          },
          "722791004": {
            "id": "722791004",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Behold, the drink of champions, created by Sailing Breeze in collaboration with Yae Publishing House, and as featured in the popular work, \"Pretty Please, Kitsune Guuji?\"!",
            "nextDialogs": [
              "722791005"
            ]
          },
          "722791005": {
            "id": "722791005",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "All this talk's making me thirsty — don't mind if I do! Hahahaha!",
            "nextDialogs": [
              "722791006"
            ]
          },
          "722791006": {
            "id": "722791006",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Drink of champions, it's time to come home!",
            "nextDialogs": [
              "722791009"
            ]
          },
          "722791009": {
            "id": "722791009",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "Glug, glug, ahhh... Itto downs the drink in one go.",
            "nextDialogs": [
              "722791010"
            ]
          },
          "722791010": {
            "id": "722791010",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Ahhhhhhhhhhhh! Wooh! That's the good stuff...",
            "nextDialogs": [
              "722791011"
            ]
          },
          "722791011": {
            "id": "722791011",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "That was a mighty fine drink... Although maybe it was a little past its prime...",
            "nextDialogs": [
              "722791012"
            ]
          },
          "722791012": {
            "id": "722791012",
            "speakerId": 1003,
            "speakerName": "Mamoru",
            "text": "Boss, they said they think there might be, uh...",
            "nextDialogs": [
              "722791013"
            ]
          },
          "722791013": {
            "id": "722791013",
            "speakerId": 1004,
            "speakerName": "Akira",
            "text": "B—Beans in the drink!",
            "nextDialogs": [
              "722791014"
            ]
          },
          "722791014": {
            "id": "722791014",
            "speakerId": 1001,
            "speakerName": "Arataki Itto",
            "text": "Huh!?",
            "nextDialogs": [
              "722791015"
            ]
          },
          "722791015": {
            "id": "722791015",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "A mighty figure falls to the ground.",
            "nextDialogs": [
              "722791016"
            ]
          },
          "722791016": {
            "id": "722791016",
            "speakerId": 1005,
            "speakerName": "Genta",
            "text": "Ah! The boss is down! The boss is down!",
            "nextDialogs": [
              "722791017"
            ]
          },
          "722791017": {
            "id": "722791017",
            "speakerId": 1003,
            "speakerName": "Mamoru",
            "text": "Quick! Get him to a doctor!",
            "nextDialogs": [
              "722791018"
            ]
          },
          "722791018": {
            "id": "722791018",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "What's wrong? Can't Arataki Itto drink soy products?",
            "nextDialogs": [
              "722791019"
            ]
          },
          "722791019": {
            "id": "722791019",
            "speakerId": 1004,
            "speakerName": "Akira",
            "text": "He's allergic to beans!",
            "nextDialogs": [
              "722791020"
            ]
          },
          "722791020": {
            "id": "722791020",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "Oh, my goodness... Okay! Quick, grab Itto and follow me. I'll get a doctor — I sure hope it's not too serious...",
            "nextDialogs": [
              "722791021"
            ]
          },
          "722791021": {
            "id": "722791021",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "#I'm sorry, {NICKNAME}. I didn't even consider this possibility. It was all my fault.",
            "nextDialogs": [
              "722791022"
            ]
          },
          "722791022": {
            "id": "722791022",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "Leave Itto to me. I'll make sure he stands again.",
            "nextDialogs": [
              "722791023"
            ]
          },
          "722791023": {
            "id": "722791023",
            "speakerId": 1000,
            "speakerName": "Thoma",
            "text": "Don't worry. I'll see you later.",
            "nextDialogs": [
              "722791024"
            ]
          },
          "722791024": {
            "id": "722791024",
            "speakerId": 1012,
            "speakerName": "Karpillia",
            "text": "So, your friend is allergic to beans. It's a very rare condition, though I have heard about it.",
            "nextDialogs": [
              "722791025"
            ]
          },
          "722791025": {
            "id": "722791025",
            "speakerId": 1012,
            "speakerName": "Karpillia",
            "text": "I'm so sorry that our drink caused such a problem. I feel terrible.",
            "nextDialogs": [
              "722791026"
            ]
          },
          "722791026": {
            "id": "722791026",
            "speakerId": 1012,
            "speakerName": "Karpillia",
            "text": "If you don't mind, please take this. This is a special drink formula with no soy milk.",
            "nextDialogs": [
              "722791027"
            ]
          },
          "722791027": {
            "id": "722791027",
            "speakerId": 1012,
            "speakerName": "Karpillia",
            "text": "I could see that your friend enjoyed this drink a lot. Although it tastes slightly different without the soy milk, I'm sure this version will be more suitable for your friend.",
            "nextDialogs": [
              "722791028"
            ]
          },
          "722791028": {
            "id": "722791028",
            "speakerId": 1012,
            "speakerName": "Karpillia",
            "text": "Please accept it, along with our sincere apologies."
          }
        }
      }
    },
    {
      "subId": "7227913",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

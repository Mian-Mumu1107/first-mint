        "dialogs": {
          "722791301": {
            "id": "722791301",
            "speakerId": 1010,
            "speakerName": "Kid Kujirai",
            "text": "*crying* Where'd my Temari go?"
          }
        }
      }
    },
    {
      "subId": "7227999",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722799901"
        ],
        "dialogs": {
          "722799901": {
            "id": "722799901",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Look! Well, if it isn't Arataki Itto and his gang!",
            "nextDialogs": [
              "722799902"
            ]
          },
          "722799902": {
            "id": "722799902",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon knew it was gonna be them! Let's go and see what all this is about.",
            "nextDialogs": [
              "722799905"
            ]
          },
          "722799905": {
            "id": "722799905",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Okay, one last job!",
            "nextDialogs": [
              "722799906"
            ]
          },
          "722799906": {
            "id": "722799906",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "We need to help move some goods at the port. Let's go."
          }
        }
      }
    }
  ]
}
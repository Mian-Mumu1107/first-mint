  "subQuests": [
    {
      "subId": "102408",
      "subQuestName": "Look for the guide to the Jade Chamber",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10210301"
        ],
        "dialogs": {
          "10210301": {
            "id": "10210301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(According to Keqing, this is what we should say...)",
            "nextDialogs": [
              "10210302"
            ]
          },
          "10210302": {
            "id": "10210302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Excuse me, do you sell the moon here?",
            "nextDialogs": [
              "10210303"
            ]
          },
          "10210303": {
            "id": "10210303",
            "speakerId": 10271,
            "speakerName": "Bu'yun",
            "text": "Yes. How many would you like?",
            "nextDialogs": [
              "10210304"
            ]
          },
          "10210304": {
            "id": "10210304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It is not convenient to speak of numbers here.",
            "nextDialogs": [
              "10210305"
            ]
          },
          "10210305": {
            "id": "10210305",
            "speakerId": 10271,
            "speakerName": "Bu'yun",
            "text": "Ah, well said. Please, use this to ascend to the Chamber... Ah, yes. Speaking of which — are you two the guests that Lady Ningguang has arranged to meet with today?",
            "nextDialogs": [
              "10210306"
            ]
          },
          "10210306": {
            "id": "10210306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yup!",
            "nextDialogs": [
              "10210307"
            ]
          },
          "10210307": {
            "id": "10210307",
            "speakerId": 10271,
            "speakerName": "Bu'yun",
            "text": "(And yet the code they used was not the one for guests, but for the Yuheng. What's going on here...)"
          }
        }
      }
    },
    {
      "subId": "102402",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10240201"
        ],
        "dialogs": {
          "10240201": {
            "id": "10240201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*panting* Paimon's exhausted...",
            "nextDialogs": [
              "10240202"
            ]
          },
          "10240202": {
            "id": "10240202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "If we hadn't happened to see the Jade Chamber flying over just as we came out of the Golden House, we really wouldn't have known which way to go...",
            "nextDialogs": [
              "10240203"
            ]
          },
          "10240203": {
            "id": "10240203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whew, did we make it in time? Is the Overlord of the Vortex still in the sea? It hasn't destroyed Liyue yet, has it?",
            "nextDialogs": [
              "10240204"
            ]
          },
          "10240204": {
            "id": "10240204",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "What... are you doing here?",
            "nextDialogs": [
              "10240205"
            ]
          },
          "10240205": {
            "id": "10240205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh... Hold on! It's the adepti! What are you doing on the Jade Chamber? Paimon thought you were arguing with the Qixing... Is the fighting over?",
            "nextDialogs": [
              "10240206"
            ]
          },
          "10240206": {
            "id": "10240206",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Faced with a calamity of such magnitude, we have agreed to put our differences aside for now and unite against this common enemy.",
            "nextDialogs": [
              "10240207"
            ]
          },
          "10240207": {
            "id": "10240207",
            "speakerId": 10286,
            "speakerName": "Moon Carver",
            "text": "Hmph!",
            "nextDialogs": [
              "10240208"
            ]
          },
          "10240208": {
            "id": "10240208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, Paimon gets it... So, how do you plan to defend Liyue?",
            "nextDialogs": [
              "10240209"
            ]
          },
          "10240209": {
            "id": "10240209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh... just seeing this Overlord of the Vortex guy puts a pit in Paimon's tummy, even from all the way out here.",
            "nextDialogs": [
              "10240210"
            ]
          },
          "10240210": {
            "id": "10240210",
            "speakerId": 1016,
            "speakerName": "Keqing",
            "text": "It's not just you. We've got new Millelith recruits who can't even stand at attention without shaking. The force of an ancient god's presence seems to be too much for ordinary people to handle.",
            "nextDialogs": [
              "10240211"
            ]
          },
          "10240211": {
            "id": "10240211",
            "speakerId": 1016,
            "speakerName": "Keqing",
            "text": "...Which is why we must stop that monster before it gets any closer to Liyue Harbor!",
            "nextDialogs": [
              "10240212"
            ]
          },
          "10240212": {
            "id": "10240212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So the Archon War was fought two thousand years ago against enemies like that thing? Now that's scary...",
            "nextDialogs": [
              "10240213"
            ]
          },
          "10240213": {
            "id": "10240213",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "...",
            "nextDialogs": [
              "10240214"
            ]
          },
          "10240214": {
            "id": "10240214",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So will the power of the Qixing, Millelith, and Adepti gathered here be enough to stop that god?",
            "nextDialogs": [
              "10240215"
            ]
          },
          "10240215": {
            "id": "10240215",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "We've already discussed this together, and our conclusion is... not necessarily.",
            "nextDialogs": [
              "10240216"
            ]
          },
          "10240216": {
            "id": "10240216",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What!? But all of you are supposed to be the guardians of Liyue. Can't you think of something?",
            "nextDialogs": [
              "10240217"
            ]
          },
          "10240217": {
            "id": "10240217",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "One certainly could.",
            "nextDialogs": [
              "10240218"
            ]
          },
          "10240218": {
            "id": "10240218",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh?",
            "nextDialogs": [
              "10240219"
            ]
          },
          "10240219": {
            "id": "10240219",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "The Qixing did once research the matter of the Guizhong Ballista when it piqued their fancy.",
            "nextDialogs": [
              "10240220"
            ]
          },
          "10240220": {
            "id": "10240220",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "And as fate would have it, one, who did craft the Guizhong Ballista with one's own hands, is here...",
            "nextDialogs": [
              "10240221"
            ]
          },
          "10240221": {
            "id": "10240221",
            "speakerId": 10258,
            "speakerName": "Cloud Retainer",
            "text": "For what could you mortals ever learn of adepti mechanisms? Yet it would take one but a little tinkering to turn this ballista into an engine of war beyond your wildest thoughts.",
            "nextDialogs": [
              "10240222"
            ]
          },
          "10240222": {
            "id": "10240222",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "Heh, I suppose this is one blessing from the adepti that we should be thankful for.",
            "nextDialogs": [
              "10240223"
            ]
          },
          "10240223": {
            "id": "10240223",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "So be it. We shall use the upgraded Guizhong Ballista to fight off that god. All the adepti here can lend their strength to man it.",
            "nextDialogs": [
              "10240224"
            ]
          },
          "10240224": {
            "id": "10240224",
            "speakerId": 10211,
            "speakerName": "Ningguang",
            "text": "We haven't a moment to spare. Our battle begins now!"
          }
        }
      }
    },
    {
      "subId": "102404",
      "subQuestName": "Repel the ancient god together",
      "sceneId": null,

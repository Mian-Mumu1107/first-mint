    {
      "subId": "7402426",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740242601"
        ],
        "dialogs": {
          "740242601": {
            "id": "740242601",
            "speakerId": 1000,
            "speakerName": "Sluasi",
            "text": "Ah, I see, so this is the color that you call \"white,\" yes?",
            "nextDialogs": [
              "740242602"
            ]
          },
          "740242602": {
            "id": "740242602",
            "speakerId": 1000,
            "speakerName": "Sluasi",
            "text": "I cannot help but feel that this is the exact opposite of what the \"sun's color\" is. Would its opposite, then, not be more suitable?",
            "nextDialogs": [
              "740242603"
            ]
          },
          "740242603": {
            "id": "740242603",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Its \"opposite\"... You mean black?",
            "nextDialogs": [
              "740242604"
            ]
          },
          "740242604": {
            "id": "740242604",
            "speakerId": 1000,
            "speakerName": "Sluasi",
            "text": "\"Black\"... Yes, that must be it. \"Black.\" A brilliant solution, esteemed Paimon. That must be the sun's color indeed!",
            "nextDialogs": [
              "740242608",
              "740242607"
            ]
          },
          "740242608": {
            "id": "740242608",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But why black, though?"
          },
          "740242607": {
            "id": "740242607",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, you cut that out!"
          }
        }
      }
    },
    {
      "subId": "7402427",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740242701"
        ],
        "dialogs": {
          "740242701": {
            "id": "740242701",
            "speakerId": 1000,
            "speakerName": "Sluasi",
            "text": "If I see something black, I will be able to mix a color as radiant as the sun..."
          }
        }
      }
    },
    {
      "subId": "7402428",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

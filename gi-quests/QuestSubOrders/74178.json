    "Havisham": 18,
    "Jingle": 22,
    "Paimon": 37,
    "Player": 27,
    "Redhead": 34,
    "Rouge": 20,
    "Seemingly Craven Redhead": 14,
    "Vicious-Looking Treasure Hoarder": 4
  },
  "subQuests": [
    {
      "subId": "7417802",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741780201"
        ],
        "dialogs": {
          "741780201": {
            "id": "741780201",
            "speakerId": 1000,
            "speakerName": "Composed-Looking Treasure Hoarder",
            "text": "#Hi, {M#bro}{F#girl}.",
            "nextDialogs": [
              "741780202"
            ]
          },
          "741780202": {
            "id": "741780202",
            "speakerId": 1001,
            "speakerName": "Vicious-Looking Treasure Hoarder",
            "text": "Today just isn't our day, eh?",
            "nextDialogs": [
              "741780203"
            ]
          },
          "741780203": {
            "id": "741780203",
            "speakerId": 1000,
            "speakerName": "Composed-Looking Treasure Hoarder",
            "text": "Tough luck for us both.",
            "nextDialogs": [
              "741780204"
            ]
          },
          "741780204": {
            "id": "741780204",
            "speakerId": 1001,
            "speakerName": "Vicious-Looking Treasure Hoarder",
            "text": "I see that you're out for a stroll with your pet, but you walked right into our camp.",
            "nextDialogs": [
              "741780205"
            ]
          },
          "741780205": {
            "id": "741780205",
            "speakerId": 1000,
            "speakerName": "Composed-Looking Treasure Hoarder",
            "text": "You'll pay for that.",
            "nextDialogs": [
              "741780206"
            ]
          },
          "741780206": {
            "id": "741780206",
            "speakerId": 1001,
            "speakerName": "Vicious-Looking Treasure Hoarder",
            "text": "We were about to call it a day, but thanks to you, we've got more work to do!",
            "nextDialogs": [
              "741780207"
            ]
          },
          "741780207": {
            "id": "741780207",
            "speakerId": 1000,
            "speakerName": "Composed-Looking Treasure Hoarder",
            "text": "Just our luck.",
            "nextDialogs": [
              "741780208"
            ]
          },
          "741780208": {
            "id": "741780208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon, what are we gonna do? We're being robbed!",
            "nextDialogs": [
              "741780209"
            ]
          },
          "741780209": {
            "id": "741780209",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "You're missing the point! First of all, Paimon is not a pet that needs to be taken for a walk!",
            "nextDialogs": [
              "741780210"
            ]
          },
          "741780210": {
            "id": "741780210",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Whatever... You think you're the boss? Paimon'll show you how wrong you are. It's show time!",
            "nextDialogs": [
              "741780211"
            ]
          },
          "741780211": {
            "id": "741780211",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#We're the legendary {NICKNAME} and Paimon! It's your last chance, outlaws! Surrender now, or prepare to meet your end!",
            "nextDialogs": [
              "741780212"
            ]
          },
          "741780212": {
            "id": "741780212",
            "speakerId": 1001,
            "speakerName": "Vicious-Looking Treasure Hoarder",
            "text": "Well, ain't that somethin'? A pet that talks! That could fetch a handsome sum on the market.",
            "nextDialogs": [
              "741780213"
            ]
          },
          "741780213": {
            "id": "741780213",
            "speakerId": 1000,
            "speakerName": "Composed-Looking Treasure Hoarder",
            "text": "A handsome sum indeed.",
            "nextDialogs": [
              "741780214"
            ]
          },
          "741780214": {
            "id": "741780214",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ehhhh!?",
            "nextDialogs": [
              "741780215"
            ]
          },
          "741780215": {
            "id": "741780215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Enough talk. Let's do this!",
            "nextDialogs": [
              "741780216"
            ]
          },
          "741780216": {
            "id": "741780216",
            "speakerId": 1003,
            "speakerName": "Seemingly Craven Redhead",
            "text": "W—Wait!",
            "nextDialogs": [
              "741780217"
            ]
          },
          "741780217": {
            "id": "741780217",
            "speakerId": 1003,
            "speakerName": "Seemingly Craven Redhead",
            "text": "Monsieur Havisham, Monsieur Jingle, I thought we had a deal! I promised to give you my goods, and in return, you wouldn't hurt any innocent people or animals in the interim.",
            "nextDialogs": [
              "741780218"
            ]
          },
          "741780218": {
            "id": "741780218",
            "speakerId": 1004,
            "speakerName": "Jingle",
            "text": "Hmm. Well, I suppose we've just met, so you probably haven't heard about our story. We used to be apprentices in the Court of Fontaine, but then we got kicked out. Do you know why?",
            "nextDialogs": [
              "741780219"
            ]
          },
          "741780219": {
            "id": "741780219",
            "speakerId": 1005,
            "speakerName": "Havisham",
            "text": "They said we didn't work hard enough.",
            "nextDialogs": [
              "741780220"
            ]
          },
          "741780220": {
            "id": "741780220",
            "speakerId": 1004,
            "speakerName": "Jingle",
            "text": "But no matter what comes our way, my brother and I always learn from our failures. So we lost our job because we didn't work hard enough? Then we'll be sure to work harder than anyone else at our next gig!",
            "nextDialogs": [
              "741780221"
            ]
          },
          "741780221": {
            "id": "741780221",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I also work harder than most when it comes to fighting crime.",
            "nextDialogs": [
              "741780222"
            ]
          },
          "741780222": {
            "id": "741780222",
            "speakerId": 1004,
            "speakerName": "Jingle",
            "text": "#Hah, {M#bro}{F#girl}, I'll admit that you don't look like the typical hero, but you've got guts. If a fight's what you want, that's what you'll get!",
            "nextDialogs": [
              "741780223"
            ]
          },
          "741780223": {
            "id": "741780223",
            "speakerId": 1005,
            "speakerName": "Havisham",
            "text": "I'll have you know that this isn't our first rodeo.",
            "nextDialogs": [
              "741780224"
            ]
          },
          "741780224": {
            "id": "741780224",
            "speakerId": 1003,
            "speakerName": "Seemingly Craven Redhead",
            "text": "Please! Would you all just hold your horses and listen to me? What good will it bring to fight each other?",
            "nextDialogs": [
              "741780225"
            ]
          },
          "741780225": {
            "id": "741780225",
            "speakerId": 1003,
            "speakerName": "Seemingly Craven Redhead",
            "text": "I would hate to see any of you get hurt.",
            "nextDialogs": [
              "741780226"
            ]
          },
          "741780226": {
            "id": "741780226",
            "speakerId": 1003,
            "speakerName": "Seemingly Craven Redhead",
            "text": "You know what? I've got enough money for all of us. I'm not sure if it's sufficient for your services, but I'm willing to pay double the ransom if you lay down your weapons.",
            "nextDialogs": [
              "741780227"
            ]
          },
          "741780227": {
            "id": "741780227",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Are you okay?",
            "nextDialogs": [
              "741780228"
            ]
          },
          "741780228": {
            "id": "741780228",
            "speakerId": 1003,
            "speakerName": "Seemingly Craven Redhead",
            "text": "Thank you for asking. I do miss my usual freedom, but apart from that, I'm fine.",
            "nextDialogs": [
              "741780229"
            ]
          },
          "741780229": {
            "id": "741780229",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "I thought they were the ones who locked you up! Then why don't you accept our help? Why are you offering them an even bigger ransom?",
            "nextDialogs": [
              "741780230"
            ]
          },
          "741780230": {
            "id": "741780230",
            "speakerId": 1003,
            "speakerName": "Seemingly Craven Redhead",
            "text": "My dear friend, sometimes you may encounter difficulties in life that you cannot overcome by yourself. I believe Monsieur Havisham and Monsieur Jingle have found themselves in such a pickle.",
            "nextDialogs": [
              "741780231"
            ]
          },
          "741780231": {
            "id": "741780231",
            "speakerId": 1003,
            "speakerName": "Seemingly Craven Redhead",
            "text": "I have the choice to save the lives of two people, or even four, all for the cost of a nigh nugatory sum of gold. Wouldn't you call that a fair deal?",
            "nextDialogs": [
              "741780232"
            ]
          },
          "741780232": {
            "id": "741780232",
            "speakerId": 1003,
            "speakerName": "Seemingly Craven Redhead",
            "text": "And you needn't worry about me. I have reached an agreement with them.",
            "nextDialogs": [
              "741780233"
            ]
          },
          "741780233": {
            "id": "741780233",
            "speakerId": 1003,
            "speakerName": "Seemingly Craven Redhead",
            "text": "In exchange for my freedom, I have offered to provide them with a batch of goods. This way, they will be furnished with a sufficient amount of capital to start a living that does not involve harming innocent people and animals.",
            "nextDialogs": [
              "741780234"
            ]
          },
          "741780234": {
            "id": "741780234",
            "speakerId": 1004,
            "speakerName": "Jingle",
            "text": "That's indeed what you said.",
            "nextDialogs": [
              "741780235"
            ]
          },
          "741780235": {
            "id": "741780235",
            "speakerId": 1005,
            "speakerName": "Havisham",
            "text": "That's indeed what we heard.",
            "nextDialogs": [
              "741780236"
            ]
          },
          "741780236": {
            "id": "741780236",
            "speakerId": 1004,
            "speakerName": "Jingle",
            "text": "All that for someone you had never met... You have a heart of gold, my friend! I'm so touched.",
            "nextDialogs": [
              "741780237"
            ]
          },
          "741780237": {
            "id": "741780237",
            "speakerId": 1005,
            "speakerName": "Havisham",
            "text": "#We are men of our word. We'll let you walk free today, lucky {M#bro}{F#girl} — and don't forget to take your pet with you!",
            "nextDialogs": [
              "741780238"
            ]
          },
          "741780238": {
            "id": "741780238",
            "speakerId": 1003,
            "speakerName": "Seemingly Craven Redhead",
            "text": "#That's good! Alright, {NICKNAME}, Paimon, you can both go home now!",
            "nextDialogs": [
              "741780239"
            ]
          },
          "741780239": {
            "id": "741780239",
            "speakerId": 1003,
            "speakerName": "Seemingly Craven Redhead",
            "text": "No need to worry about me. I'll take Monsieurs Havisham and Jingle to retrieve the goods they have been promised — an easy task if I ever saw one.",
            "nextDialogs": [
              "741780240"
            ]
          },
          "741780240": {
            "id": "741780240",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "The Treasure Hoarders free the redhead from his cage, and the three of them head east together.",
            "nextDialogs": [
              "741780241"
            ]
          },
          "741780241": {
            "id": "741780241",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#They're gone... {NICKNAME}, do you really think the Treasure Hoarders are gonna let him go? He doesn't seem like the sharpest knife in the drawer.",
            "nextDialogs": [
              "741780243",
              "741780245"
            ]
          },
          "741780243": {
            "id": "741780243",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "He might be the sort of person who wouldn't even harm a fly. Paimon thought that lot only existed in fairy tales.",
            "nextDialogs": [
              "741780246"
            ]
          },
          "741780246": {
            "id": "741780246",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ah! Paimon's dying to know what's going on! They just headed east. Why don't we follow them?"
          },
          "741780245": {
            "id": "741780245",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "What? Are you saying they're in this together? But they're already long gone at this point! If they did that to trick us..."
          }
        }
      }
    },
    {
      "subId": "7417803",
      "subQuestName": "Look for the Treasure Hoarders and the redhead",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7417804",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741780401"
        ],
        "dialogs": {
          "741780401": {
            "id": "741780401",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "There they are! Let's find a place to hide and observe.",
            "nextDialogs": [
              "741780402"
            ]
          },
          "741780402": {
            "id": "741780402",
            "speakerId": 1003,
            "speakerName": "Seemingly Craven Redhead",
            "text": "Here are the goods that we agreed upon. It's not much, but it should be enough to help you muddle through for a while.",
            "nextDialogs": [
              "741780403"
            ]
          },
          "741780403": {
            "id": "741780403",
            "speakerId": 1004,
            "speakerName": "Jingle",
            "text": "Lemme check... Heh, the exact amount you promised. No more, no less.",
            "nextDialogs": [
              "741780404"
            ]
          },
          "741780404": {
            "id": "741780404",
            "speakerId": 1005,
            "speakerName": "Havisham",
            "text": "You're not one for flim-flam. We respect that.",
            "nextDialogs": [
              "741780405"
            ]
          },
          "741780405": {
            "id": "741780405",
            "speakerId": 1004,
            "speakerName": "Jingle",
            "text": "Anyway, I'm sure this is just a drop in the ocean for you, and you wouldn't mind if we took a little more, right?",
            "nextDialogs": [
              "741780406"
            ]
          },
          "741780406": {
            "id": "741780406",
            "speakerId": 1005,
            "speakerName": "Havisham",
            "text": "I mean, you've got so much Mora that you don't think twice about parting with it. We'll do a better job looking after your fortune.",
            "nextDialogs": [
              "741780407"
            ]
          },
          "741780407": {
            "id": "741780407",
            "speakerId": 1003,
            "speakerName": "Seemingly Craven Redhead",
            "text": "*sigh* I was holding out hope that things would be different this time, but it always ends the same, doesn't it?",
            "nextDialogs": [
              "741780408"
            ]
          },
          "741780408": {
            "id": "741780408",
            "speakerId": 1005,
            "speakerName": "Havisham",
            "text": "Old tricks are what they are for a reason. If it ain't broke, don't fix it.",
            "nextDialogs": [
              "741780409"
            ]
          },
          "741780409": {
            "id": "741780409",
            "speakerId": 1004,
            "speakerName": "Jingle",
            "text": "I wonder, are you just as generous when begging for mercy?",
            "nextDialogs": [
              "741780410"
            ]
          },
          "741780410": {
            "id": "741780410",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#What do you say, {NICKNAME}? Should we help him out?",
            "nextDialogs": [
              "741780411"
            ]
          },
          "741780411": {
            "id": "741780411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Let's keep watching for a while.)",
            "nextDialogs": [
              "741780412"
            ]
          },
          "741780412": {
            "id": "741780412",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "(Huh? But... Well, you're the boss.)",
            "nextDialogs": [
              "741780413"
            ]
          },
          "741780413": {
            "id": "741780413",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "The redhead whistles, and two men leap out from a hidden spot in the woods.",
            "nextDialogs": [
              "741780414"
            ]
          },
          "741780414": {
            "id": "741780414",
            "speakerId": 1007,
            "speakerName": "Redhead",
            "text": "I'm afraid not. You see, we, too, have a few tried-and-true methods to get back everything you've filched from innocent people.",
            "nextDialogs": [
              "741780415"
            ]
          },
          "741780415": {
            "id": "741780415",
            "speakerId": 1008,
            "speakerName": "Blond Man",
            "text": "This is your last chance. Give yourselves up, and you'll save us the trouble of having to go through this whole song and dance.",
            "nextDialogs": [
              "741780416"
            ]
          },
          "741780416": {
            "id": "741780416",
            "speakerId": 1009,
            "speakerName": "Brunette Man",
            "text": "If you ever want a lesson taught, I'm always ready.",
            "nextDialogs": [
              "741780417"
            ]
          },
          "741780417": {
            "id": "741780417",
            "speakerId": 1004,
            "speakerName": "Jingle",
            "text": "Ha? Where did you two come from? And you... When did you get changed!?",
            "nextDialogs": [
              "741780418"
            ]
          },
          "741780418": {
            "id": "741780418",
            "speakerId": 1005,
            "speakerName": "Havisham",
            "text": "Hah, you're the real circus, aren't you? Get ready to be clowned on!"
          }
        }
      }
    },
    {
      "subId": "7417805",
      "subQuestName": "Help the redhead, or watch events unfold",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7417806",
      "subQuestName": "Talk to the redhead",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741780601"
        ],
        "dialogs": {
          "741780601": {
            "id": "741780601",
            "speakerId": 1004,
            "speakerName": "Jingle",
            "text": "You're ganging up on us!",
            "nextDialogs": [
              "741780602"
            ]
          },
          "741780602": {
            "id": "741780602",
            "speakerId": 1005,
            "speakerName": "Havisham",
            "text": "This ain't hardly fair.",
            "nextDialogs": [
              "741780603"
            ]
          },
          "741780603": {
            "id": "741780603",
            "speakerId": 1010,
            "speakerName": "Bleu",
            "text": "Boss, what should we do with them?",
            "nextDialogs": [
              "741780604"
            ]
          },
          "741780604": {
            "id": "741780604",
            "speakerId": 1007,
            "speakerName": "Redhead",
            "text": "Why not ask our friends over there?",
            "nextDialogs": [
              "741780605"
            ]
          },
          "741780605": {
            "id": "741780605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you guys robbers as well?",
            "nextDialogs": [
              "741780606"
            ]
          },
          "741780606": {
            "id": "741780606",
            "speakerId": 1007,
            "speakerName": "Redhead",
            "text": "Oh, that's a toughie. Yes and no.",
            "nextDialogs": [
              "741780607"
            ]
          },
          "741780607": {
            "id": "741780607",
            "speakerId": 1011,
            "speakerName": "Blanc",
            "text": "We only target bad guys, like these two here.",
            "nextDialogs": [
              "741780608"
            ]
          },
          "741780608": {
            "id": "741780608",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon's not sure Paimon entirely follows, but what Paimon does know is that these two are bad guys. They tried to rob us earlier!",
            "nextDialogs": [
              "741780609"
            ]
          },
          "741780609": {
            "id": "741780609",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "After that, you said that you'd give them valuable cargo for free, and lured the bad guys here into an ambush!",
            "nextDialogs": [
              "741780610"
            ]
          },
          "741780610": {
            "id": "741780610",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "That means you and the other two must be...",
            "nextDialogs": [
              "741780612",
              "741780616"
            ]
          },
          "741780612": {
            "id": "741780612",
            "speakerId": 1004,
            "speakerName": "Jingle",
            "text": "Lapdogs of the Maison Gardiennage? Pfft. You make me sick.",
            "nextDialogs": [
              "741780613"
            ]
          },
          "741780613": {
            "id": "741780613",
            "speakerId": 1007,
            "speakerName": "Redhead",
            "text": "Unfortunately for me, that's not the case. I don't agree with the things they do in pursuit of justice... but at least it is justice that they're after.",
            "nextDialogs": [
              "741780614"
            ]
          },
          "741780614": {
            "id": "741780614",
            "speakerId": 1007,
            "speakerName": "Redhead",
            "text": "That's something you lying good-for-nothings could never understand.",
            "nextDialogs": [
              "741780617"
            ]
          },
          "741780617": {
            "id": "741780617",
            "speakerId": 1007,
            "speakerName": "Redhead",
            "text": "Anyway, we're just a bunch of nobodies, but even nobodies have the right to believe in a cause, especially when it concerns matters of justice. There's no way we'd turn a blind eye to transgressions happening right in front of us.",
            "nextDialogs": [
              "741780618"
            ]
          },
          "741780618": {
            "id": "741780618",
            "speakerId": 1007,
            "speakerName": "Redhead",
            "text": "They have committed terrible crimes here. And even though they promised to let you walk free, they never intended to actually let that happen.",
            "nextDialogs": [
              "741780619"
            ]
          },
          "741780619": {
            "id": "741780619",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "How do you know what they're actually thinking?",
            "nextDialogs": [
              "741780620"
            ]
          },
          "741780620": {
            "id": "741780620",
            "speakerId": 1007,
            "speakerName": "Redhead",
            "text": "You must listen carefully, not only with your ears, but with your head, too.",
            "nextDialogs": [
              "741780621"
            ]
          },
          "741780621": {
            "id": "741780621",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Speaking of which, Penny did say...)",
            "nextDialogs": [
              "741780622"
            ]
          },
          "741780622": {
            "id": "741780622",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "You take a few deep breaths to cast aside a few unwanted thoughts and clear your head.",
            "nextDialogs": [
              "741780623"
            ]
          },
          "741780623": {
            "id": "741780623",
            "speakerId": 1007,
            "speakerName": "Redhead",
            "text": "Try to recall what they said.",
            "nextDialogs": [
              "741780624"
            ]
          },
          "741780624": {
            "id": "741780624",
            "speakerId": 1007,
            "speakerName": "Redhead",
            "text": "\"All that for some{RUBY#[D]What an idiot!}one you've never met... You have a heart {RUBY#[D]If your heart was real gold, then we'd be in business.}of gold, my friend! I'm so {RUBY#[D]Gold or not, I'm gonna rip it right out.}touched.\"",
            "nextDialogs": [
              "741780625"
            ]
          },
          "741780625": {
            "id": "741780625",
            "speakerId": 1007,
            "speakerName": "Redhead",
            "text": "#\"We are men {RUBY#[D]As if verbal agreements amount to anything.}of our word. We'll let you walk free today, {M#bro}{F#girl}{RUBY#[D]We'll be back to finish you once we're done with this moron.}, and take your pet with you!\""
          },
          "741780616": {
            "id": "741780616",
            "speakerId": 1007,
            "speakerName": "Redhead",
            "text": "Haha! If you want to teach unsavory characters a lesson, you must become yet more unsavory. Looks like you already know that."
          }
        }
      }
    },

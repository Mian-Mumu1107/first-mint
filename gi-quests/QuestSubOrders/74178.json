    {
      "subId": "7417899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741789906"
        ],
        "dialogs": {
          "741789906": {
            "id": "741789906",
            "speakerId": 1012,
            "speakerName": "Rouge",
            "text": "It's almost time. Let's set out for the Treasure Hoarder hideout in the south.",
            "nextDialogs": [
              "741789908"
            ]
          },
          "741789908": {
            "id": "741789908",
            "speakerId": 1012,
            "speakerName": "Rouge",
            "text": "So we meet again! Didn't you say you had a gift for us? Some broken ribs, if I recall correctly? I appreciate the sentiment, but I personally think that's a present that suits you far better.",
            "nextDialogs": [
              "741789909"
            ]
          },
          "741789909": {
            "id": "741789909",
            "speakerId": 1004,
            "speakerName": "Jingle",
            "text": "You liar! You never intended on letting us go!",
            "nextDialogs": [
              "741789910"
            ]
          },
          "741789910": {
            "id": "741789910",
            "speakerId": 1012,
            "speakerName": "Rouge",
            "text": "Well, I would say the same to you!"
          }
        }
      }
    }
  ]

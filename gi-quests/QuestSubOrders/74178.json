            "nextDialogs": [
              "741781118"
            ]
          },
          "741781118": {
            "id": "741781118",
            "speakerId": 1007,
            "speakerName": "Redhead",
            "text": "They have committed terrible crimes here. And even though they promised to let you walk free, they never intended to actually let that happen.",
            "nextDialogs": [
              "741781119"
            ]
          },
          "741781119": {
            "id": "741781119",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "How do you know what they're actually thinking?",
            "nextDialogs": [
              "741781120"
            ]
          },
          "741781120": {
            "id": "741781120",
            "speakerId": 1007,
            "speakerName": "Redhead",
            "text": "You must listen carefully, not only with your ears, but with your head, too.",
            "nextDialogs": [
              "741781121"
            ]
          },
          "741781121": {
            "id": "741781121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Not sure if I completely understood him, but it wouldn't hurt to try.)",
            "nextDialogs": [
              "741781122"
            ]
          },
          "741781122": {
            "id": "741781122",

  "subQuests": [
    {
      "subId": "7470301",
      "subQuestName": "Talk to Sandrone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747030101"
        ],
        "dialogs": {
          "747030101": {
            "id": "747030101",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Hold up... these accounts... are you sure you haven't miscalculated?",
            "nextDialogs": [
              "747030102"
            ]
          },
          "747030102": {
            "id": "747030102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm? Is something wrong?",
            "nextDialogs": [
              "747030103"
            ]
          },
          "747030103": {
            "id": "747030103",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "...Have you really made this much profit?",
            "nextDialogs": [
              "747030104"
            ]
          },
          "747030104": {
            "id": "747030104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Having second thoughts about your 30% cut?",
            "nextDialogs": [
              "747030105"
            ]
          },
          "747030105": {
            "id": "747030105",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Do you really think I'm that petty? I'm just amazed you've done such a good job running the aquarium.",
            "nextDialogs": [
              "747030106"
            ]
          },
          "747030106": {
            "id": "747030106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon thinks the Fontinalia Film Festival deserves some of the credit.",
            "nextDialogs": [
              "747030107"
            ]
          },
          "747030107": {
            "id": "747030107",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "This much revenue... Even after paying off the Wingalet's rent, there's still a sizable profit left over.",
            "nextDialogs": [
              "747030108"
            ]
          },
          "747030108": {
            "id": "747030108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Considering a career change?",
            "nextDialogs": [
              "747030109"
            ]
          },
          "747030109": {
            "id": "747030109",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Not in the least. I have no delusions regarding my business acumen. Constructing machines and studying formulas is where my passions lie.",
            "nextDialogs": [
              "747030110"
            ]
          },
          "747030110": {
            "id": "747030110",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "That said... Seeing this place transform from a fishless room into what it is now really has felt like a miracle.",
            "nextDialogs": [
              "747030111"
            ]
          },
          "747030111": {
            "id": "747030111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe, well, we owe you credit for lending us the space! It's so rewarding to see all our work bring so many people joy! Don't you think, Sandrone?",
            "nextDialogs": [
              "747030112"
            ]
          },
          "747030112": {
            "id": "747030112",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Hmph. Maybe a little.",
            "nextDialogs": [
              "747030113"
            ]
          },
          "747030113": {
            "id": "747030113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Only a little?",
            "nextDialogs": [
              "747030114"
            ]
          },
          "747030114": {
            "id": "747030114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Must be because she settled for 30%...",
            "nextDialogs": [
              "747030115"
            ]
          },
          "747030115": {
            "id": "747030115",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Ugh, I told you, I don't care about that!"
          }
        }
      }
    }
  ]
}
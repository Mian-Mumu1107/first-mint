    {
      "subId": "7224106",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722410601"
        ],
        "dialogs": {
          "722410601": {
            "id": "722410601",
            "speakerId": 20342,
            "speakerName": "Aberaku",
            "text": "My name is...",
            "nextDialogs": [
              "722410602"
            ]
          },
          "722410602": {
            "id": "722410602",
            "speakerId": 20342,
            "speakerName": "Aberaku",
            "text": "Aberaku, Helios-Forger!",
            "nextDialogs": [
              "722410603"
            ]
          },
          "722410603": {
            "id": "722410603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And Paimon's... well, Paimon.",
            "nextDialogs": [
              "722410605",
              "722410610"
            ]
          },
          "722410605": {
            "id": "722410605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, since he started it...",
            "nextDialogs": [
              "722410606"
            ]
          },
          "722410606": {
            "id": "722410606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Guess it's just good manners.",
            "nextDialogs": [
              "722410607"
            ]
          },
          "722410607": {
            "id": "722410607",
            "speakerId": 20342,
            "speakerName": "Aberaku",
            "text": "It is but a small matter. Indeed, it is I who has treated you with utter disregard, having come to receive you in such a tragic state.",
            "nextDialogs": [
              "722410608"
            ]
          },
          "722410608": {
            "id": "722410608",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Don't worry! We don't mind. Right, {NICKNAME}?",
            "nextDialogs": [
              "722410613"
            ]
          },
          "722410613": {
            "id": "722410613",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Still, why are you here, Mister?",
            "nextDialogs": [
              "722410614"
            ]
          },
          "722410614": {
            "id": "722410614",
            "speakerId": 20342,
            "speakerName": "Aberaku",
            "text": "I... I am the creator of the Helios, and this place is my... final resting place.",
            "nextDialogs": [
              "722410615"
            ]
          },
          "722410615": {
            "id": "722410615",
            "speakerId": 20342,
            "speakerName": "Aberaku",
            "text": "Falling asleep in a dark, icy place, never to wake... How could I just die like that? I, the Helios-Forger!",
            "nextDialogs": [
              "722410616"
            ]
          },
          "722410616": {
            "id": "722410616",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The creator of the Helios?",
            "nextDialogs": [
              "722410617"
            ]
          },
          "722410617": {
            "id": "722410617",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's the Helios?",
            "nextDialogs": [
              "722410618"
            ]
          },
          "722410618": {
            "id": "722410618",
            "speakerId": 20342,
            "speakerName": "Aberaku",
            "text": "Ah, right. Helios is what I called my creation in private.",
            "nextDialogs": [
              "722410619"
            ]
          },
          "722410619": {
            "id": "722410619",
            "speakerId": 20342,
            "speakerName": "Aberaku",
            "text": "Perhaps this is not known to you, but the people of Byakuyakoku call this thing...",
            "nextDialogs": [
              "722410620"
            ]
          },
          "722410620": {
            "id": "722410620",
            "speakerId": 20342,
            "speakerName": "Aberaku",
            "text": "The Dainichi Mikoshi.",
            "nextDialogs": [
              "722410621"
            ]
          },
          "722410621": {
            "id": "722410621",
            "speakerId": 20342,
            "speakerName": "Aberaku",
            "text": "Helios is the Dainichi Mikoshi, the solar chariot that drives the Hype{RUBY#[S]Byakuya no Hikari}rion."
          },
          "722410610": {
            "id": "722410610",
            "speakerId": 20342,
            "speakerName": "Aberaku",
            "text": "...I see. So you are a guest from afar.",
            "nextDialogs": [
              "722410611"
            ]
          },
          "722410611": {
            "id": "722410611",
            "speakerId": 20342,
            "speakerName": "Aberaku",
            "text": "I only regret that I have come to meet you in such a horrid state.",
            "nextDialogs": [
              "722410612"
            ]
          },
          "722410612": {
            "id": "722410612",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's alright!"
          }
        }
      }
    },

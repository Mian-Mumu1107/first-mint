        "dialogs": {
          "722140301": {
            "id": "722140301",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "How did it go? Were you able to get the Raw Meat?"
          }
        }
      }
    }
  ]
}
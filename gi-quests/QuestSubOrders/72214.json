  },
  "subQuests": [
    {
      "subId": "7221401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722140101"
        ],
        "dialogs": {
          "722140101": {
            "id": "722140101",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "This is... quite incredible...",
            "nextDialogs": [
              "722140102"
            ]
          },
          "722140102": {
            "id": "722140102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is the stone carving done?",
            "nextDialogs": [
              "722140103"
            ]
          },
          "722140103": {
            "id": "722140103",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "When we began, that stone did not look a thing like me. But with each passing glance, it becomes more and more so.",
            "nextDialogs": [
              "722140104"
            ]
          },
          "722140104": {
            "id": "722140104",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "You humans really are incredible.",
            "nextDialogs": [
              "722140105"
            ]
          },
          "722140105": {
            "id": "722140105",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "It is very noisy, yes, but I am the provisional head priestess. Such trivial matters are not worth complaining about.",
            "nextDialogs": [
              "722140106"
            ]
          },
          "722140106": {
            "id": "722140106",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Bring these fish to that tall human.",
            "nextDialogs": [
              "722140107"
            ]
          },
          "722140107": {
            "id": "722140107",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "They are good things, and may be considered his... \"celery.\"",
            "nextDialogs": [
              "722140109",
              "722140112"
            ]
          },
          "722140109": {
            "id": "722140109",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Meow, I did get Konbumaru to lead those children to try to catch some finches, but it did not turn out very well.",
            "nextDialogs": [
              "722140110"
            ]
          },
          "722140110": {
            "id": "722140110",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "For them, catching fish is still simpler."
          },
          "722140112": {
            "id": "722140112",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Meow meow meow, how bothersome of you.",
            "nextDialogs": [
              "722140113"
            ]
          },
          "722140113": {
            "id": "722140113",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Just give them to him — they are good things, after all."
          }
        }
      }
    },
    {
      "subId": "7221402",
      "subQuestName": "Bring the Fish to Ooshima Junpei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722140201"
        ],
        "dialogs": {
          "722140201": {
            "id": "722140201",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Well, this certainly looks the part now...",
            "nextDialogs": [
              "722140202"
            ]
          },
          "722140202": {
            "id": "722140202",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Haha, it's you. Do you think it looks a bit more like the Lady Priestess now?",
            "nextDialogs": [
              "722140204",
              "722140206"
            ]
          },
          "722140204": {
            "id": "722140204",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Right? Ah, I spent a few days burning the midnight oil on this, too...",
            "nextDialogs": [
              "722140207"
            ]
          },
          "722140207": {
            "id": "722140207",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Ah, I'm pretty hungry, I think... Time to go look for something to eat again...",
            "nextDialogs": [
              "722140208"
            ]
          },
          "722140208": {
            "id": "722140208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Neko sends you some fish.",
            "nextDialogs": [
              "722140209"
            ]
          },
          "722140209": {
            "id": "722140209",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Hmm, well, the Lady Priestess has my thanks, but uh... I think I'll look for food on my own...",
            "nextDialogs": [
              "722140210"
            ]
          },
          "722140210": {
            "id": "722140210",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "I've eaten fish for several straight days now. I don't think I could eat any more...",
            "nextDialogs": [
              "722140211"
            ]
          },
          "722140211": {
            "id": "722140211",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "I've been heading out to forage for food. When I'm lucky, I can grab a finch or a pigeon...",
            "nextDialogs": [
              "722140212"
            ]
          },
          "722140212": {
            "id": "722140212",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "*sigh* But what I'd like to have is some meat, you know? Some firm, juicy meat...",
            "nextDialogs": [
              "722140213"
            ]
          },
          "722140213": {
            "id": "722140213",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "So, uh, Traveler...",
            "nextDialogs": [
              "722140214"
            ]
          },
          "722140214": {
            "id": "722140214",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "If you don't mind, could you get me three servings of Raw Meat?",
            "nextDialogs": [
              "722140215"
            ]
          },
          "722140215": {
            "id": "722140215",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "I'm no good at hunting, so I haven't been able to get any meat these past few days... So please, give me a hand!"
          },
          "722140206": {
            "id": "722140206",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Well, of course. The Lady Priestess is quite a bit larger than your average cat, but if you want a more majestic statue, then it's got to be even larger still. This is a shrine statue, after all!"
          }
        }
      }
    },
    {
      "subId": "7221404",
      "subQuestName": "Give Ooshima Junpei three servings of Raw Meat",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722140401"
        ],
        "dialogs": {
          "722140401": {
            "id": "722140401",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Ooh... the marbling... Thank you both so much!",
            "nextDialogs": [
              "722140402"
            ]
          },
          "722140402": {
            "id": "722140402",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "I'll whip up a few good dishes in just a moment. With any luck, I might even finish my carving faster after eating, haha!",
            "nextDialogs": [
              "722140403"
            ]
          },
          "722140403": {
            "id": "722140403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do the two have in common, again?",
            "nextDialogs": [
              "722140404"
            ]
          },
          "722140404": {
            "id": "722140404",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Eating some good meat gives you the strength to keep going! It just wasn't the same with those fish. I couldn't help but feel like my hands were too weak for the work...",
            "nextDialogs": [
              "722140405"
            ]
          },
          "722140405": {
            "id": "722140405",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Honestly, I was starting to get worried that I might take longer than expected to finish the whole statue. Well, that's not a problem now, thanks to you!",
            "nextDialogs": [
              "722140406"
            ]
          },
          "722140406": {
            "id": "722140406",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "I mean, I am being employed by a... cat, sure, but one should always avoid asking for extensions.",
            "nextDialogs": [
              "722140407"
            ]
          },
          "722140407": {
            "id": "722140407",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Whatever the case, I'll get this one done as soon as I can... Come to think of it, the Lady Priestess said that once the statue is completed, something good will happen.",
            "nextDialogs": [
              "722140408"
            ]
          },
          "722140408": {
            "id": "722140408",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "I'm not sure what that means exactly, but well... I'm quite looking forward to it, actually.",
            "nextDialogs": [
              "722140409"
            ]
          },
          "722140409": {
            "id": "722140409",
            "speakerId": 3182,
            "speakerName": "Ooshima Junpei",
            "text": "Come back in a while and have a look at the final product."
          }
        }
      }
    },
    {
      "subId": "7221403",
      "subQuestName": "Give Ooshima Junpei three servings of Raw Meat",
      "sceneId": null,

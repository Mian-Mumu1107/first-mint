  "subQuests": [
    {
      "subId": "2301501",
      "subQuestName": "Talk to Ahangar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230150101"
        ],
        "dialogs": {
          "230150101": {
            "id": "230150101",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "This bearing is too large. It wouldn't fit...",
            "nextDialogs": [
              "230150102"
            ]
          },
          "230150102": {
            "id": "230150102",
            "speakerId": 1001,
            "speakerName": "Ahangar",
            "text": "Too small last time, and too big now! You're going to use up all my Iron Chunks!",
            "nextDialogs": [
              "230150103"
            ]
          },
          "230150103": {
            "id": "230150103",
            "speakerId": 1002,
            "speakerName": "Lutong",
            "text": "In fact, we are also about to use up all our Mora.",
            "nextDialogs": [
              "230150104"
            ]
          },
          "230150104": {
            "id": "230150104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you arguing about?",
            "nextDialogs": [
              "230150105"
            ]
          },
          "230150105": {
            "id": "230150105",
            "speakerId": 1001,
            "speakerName": "Ahangar",
            "text": "This man asked me to forge lots of iron tubes and gears, with different requirements for each and every one of them.",
            "nextDialogs": [
              "230150106"
            ]
          },
          "230150106": {
            "id": "230150106",
            "speakerId": 1001,
            "speakerName": "Ahangar",
            "text": "I'm already using up all my Iron Chunks to forge these... things for him!",
            "nextDialogs": [
              "230150107"
            ]
          },
          "230150107": {
            "id": "230150107",
            "speakerId": 1001,
            "speakerName": "Ahangar",
            "text": "But he doesn't think that's enough, he wants even more gears.",
            "nextDialogs": [
              "230150108"
            ]
          },
          "230150108": {
            "id": "230150108",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Please allow me to explain my work again, I'm sure you will understand...",
            "nextDialogs": [
              "230150109"
            ]
          },
          "230150109": {
            "id": "230150109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing here?",
            "nextDialogs": [
              "230150110"
            ]
          },
          "230150110": {
            "id": "230150110",
            "speakerId": 1002,
            "speakerName": "Lutong",
            "text": "Just let Mr. Garcia explain all this to Mr. Ahangar.",
            "nextDialogs": [
              "230150111"
            ]
          },
          "230150111": {
            "id": "230150111",
            "speakerId": 1002,
            "speakerName": "Lutong",
            "text": "Traveler, I... Well, Mr. Garcia needs a favor. Will you collect some Iron Chunks for us?",
            "nextDialogs": [
              "230150114"
            ]
          },
          "230150114": {
            "id": "230150114",
            "speakerId": 1002,
            "speakerName": "Lutong",
            "text": "About that... We have encountered some challenges, which were expected. Mr. Garcia is still pondering a solution.",
            "nextDialogs": [
              "230150115"
            ]
          },
          "230150115": {
            "id": "230150115",
            "speakerId": 1002,
            "speakerName": "Lutong",
            "text": "If this should interest you at some point in the future, feel free to ask Mr. Garcia for more information.",
            "nextDialogs": [
              "230150116"
            ]
          },
          "230150116": {
            "id": "230150116",
            "speakerId": 1002,
            "speakerName": "Lutong",
            "text": "I fear that no one really understands the exact mechanisms behind the machine, save him.",
            "nextDialogs": [
              "230150117"
            ]
          },
          "230150117": {
            "id": "230150117",
            "speakerId": 1002,
            "speakerName": "Lutong",
            "text": "But before that, please bring some Iron Chunks back here."
          }
        }
      }
    },
    {
      "subId": "2301502",
      "subQuestName": "Give three Iron Chunks to Lutong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230150201"
        ],
        "dialogs": {
          "230150201": {
            "id": "230150201",
            "speakerId": 1002,
            "speakerName": "Lutong",
            "text": "Did you bring the Iron Chunks?"
          }
        }
      }
    },
    {
      "subId": "2301503",
      "subQuestName": "Talk to Ahangar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230150301"
        ],
        "dialogs": {
          "230150301": {
            "id": "230150301",
            "speakerId": 1001,
            "speakerName": "Ahangar",
            "text": "Okay! Okay! I'll just forge the gears for you! Just... stop talking!",
            "nextDialogs": [
              "230150302"
            ]
          },
          "230150302": {
            "id": "230150302",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "But I haven't finished my explanation...",
            "nextDialogs": [
              "230150303"
            ]
          },
          "230150303": {
            "id": "230150303",
            "speakerId": 1001,
            "speakerName": "Ahangar",
            "text": "Now that we have the Iron Chunks, I'm going back to work. You, back off!",
            "nextDialogs": [
              "230150304"
            ]
          },
          "230150304": {
            "id": "230150304",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Ahangar swings his hammer so fiercely that Garcia has to back away from him...",
            "nextDialogs": [
              "230150305"
            ]
          },
          "230150305": {
            "id": "230150305",
            "speakerId": 1002,
            "speakerName": "Lutong",
            "text": "Let's leave Mr. Ahangar to his work. Here's your payment.",
            "nextDialogs": [
              "230150306"
            ]
          },
          "230150306": {
            "id": "230150306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I hope you will succeed this time.",
            "nextDialogs": [
              "230150307"
            ]
          },
          "230150307": {
            "id": "230150307",
            "speakerId": 1002,
            "speakerName": "Lutong",
            "text": "That means so much. Thank you, Traveler.",
            "nextDialogs": [
              "230150308"
            ]
          },
          "230150308": {
            "id": "230150308",
            "speakerId": 1002,
            "speakerName": "Lutong",
            "text": "I am... cautiously pessimistic about this.",
            "nextDialogs": [
              "230150309"
            ]
          },
          "230150309": {
            "id": "230150309",
            "speakerId": 1002,
            "speakerName": "Lutong",
            "text": "Mr. Garcia is a genius with machines. That much is beyond doubt.",
            "nextDialogs": [
              "230150310"
            ]
          },
          "230150310": {
            "id": "230150310",
            "speakerId": 1002,
            "speakerName": "Lutong",
            "text": "But if you ask me, the machine that Mr. Garcia envisions requires much more than just one \"genius.\""
          }
        }
      }
    },
    {
      "subId": "2301550",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230155001"
        ],
        "dialogs": {
          "230155001": {
            "id": "230155001",
            "speakerId": 1001,
            "speakerName": "Ahangar",
            "text": "What do you want all those gears and tubes for? Are you building an iron house or something?",
            "nextDialogs": [
              "230155002"
            ]
          },
          "230155002": {
            "id": "230155002",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "True enough, sir! A house it is, a house filled with gears — that is what I am building.",
            "nextDialogs": [
              "230155003"
            ]
          },
          "230155003": {
            "id": "230155003",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "I have named the area containing some of the gears the \"Storage,\" while the bearings and the rest of the gears make up the \"Numberbase.\"",
            "nextDialogs": [
              "230155004"
            ]
          },
          "230155004": {
            "id": "230155004",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "The gears in Storage are used for recording and storing numbers, and those in Numberbase for calculation.",
            "nextDialogs": [
              "230155005"
            ]
          },
          "230155005": {
            "id": "230155005",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "A sketch might help you understand. Do you happen to have some paper on you? No? Never mind, I'll draw on my clothes. That should make things clearer...",
            "nextDialogs": [
              "230155006"
            ]
          },
          "230155006": {
            "id": "230155006",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Pass me the coal, will you? Many thanks, please look at this..."
          }
        }
      }
    },
    {
      "subId": "2301599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230159901"
        ],
        "dialogs": {
          "230159901": {
            "id": "230159901",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "(I need to get this problem solved! But... no, never mind... no buts...)",
            "nextDialogs": [
              "230159902"
            ]
          },
          "230159902": {
            "id": "230159902",
            "speakerId": 1002,
            "speakerName": "Lutong",
            "text": "(Uh, regardless, there'll always be a way...)"
          }
        }
      }
    }
  ]
}
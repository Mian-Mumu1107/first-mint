          },
          "207420502": {
            "id": "207420502",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Did you get my Dandelion Seeds?",
            "nextDialogs": [
              "207420503"
            ]
          },
          "207420503": {
            "id": "207420503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "These are for you.",
            "nextDialogs": [
              "207420504"
            ]
          },
          "207420504": {
            "id": "207420504",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "...Thanks. I'll plant a new pot later.",
            "nextDialogs": [
              "207420505"
            ]
          },
          "207420505": {
            "id": "207420505",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "But I'm never, ever leaving it outside again!"
          }
        }
      }
    },

    {
      "subId": "2074206",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207420701"
        ],
        "dialogs": {
          "207420701": {
            "id": "207420701",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "",
            "nextDialogs": [
              "207420702"
            ]
          },
          "207420702": {
            "id": "207420702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, uh, did something happen?",
            "nextDialogs": [
              "207420703"
            ]
          },
          "207420703": {
            "id": "207420703",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "You! Donna told me all about it — she saw you blowing my dandelions away!",
            "nextDialogs": [
              "207420704"
            ]
          },
          "207420704": {
            "id": "207420704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh, sorry about that...",
            "nextDialogs": [
              "207420705"
            ]
          },
          "207420705": {
            "id": "207420705",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "I know — Donna told me all about it. You were the one who blew all my dandelions away, weren't you?",
            "nextDialogs": [
              "207420706"
            ]
          },
          "207420706": {
            "id": "207420706",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "If you needed Dandelion Seeds that much, you could just have gathered some out in the wild. I was caring for these ones!",
            "nextDialogs": [
              "207420707"
            ]
          },
          "207420707": {
            "id": "207420707",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Need I mention that these dandelions were the ones you helped me gather? Is this is really how you're going to treat them?"
          }
        }
      }
    },
    {
      "subId": "2074203",
      "subQuestName": "",
      "sceneId": null,

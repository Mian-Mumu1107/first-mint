    {
      "subId": "2074201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207420101"
        ],
        "dialogs": {
          "207420101": {
            "id": "207420101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "",
            "nextDialogs": [
              "207420102"
            ]
          },
          "207420102": {
            "id": "207420102",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Ah! The dandelions! They're all flying away!",
            "nextDialogs": [
              "207420103"
            ]
          },
          "207420103": {
            "id": "207420103",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "What are you doing? Do you have any idea how much effort it took for me to grow those!",
            "nextDialogs": [
              "207420104"
            ]
          },
          "207420104": {
            "id": "207420104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm scattering them far and wide...",
            "nextDialogs": [
              "207420105"
            ]
          },
          "207420105": {
            "id": "207420105",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "We're in the city! They won't get far before being blocked by those walls!",
            "nextDialogs": [
              "207420106"
            ]
          },
          "207420106": {
            "id": "207420106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This way, we'll be able to grow many more dandelions...",
            "nextDialogs": [
              "207420107"
            ]
          },
          "207420107": {
            "id": "207420107",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Well, why don't you take some dandelion seeds outside the city and scatter them there, then?",
            "nextDialogs": [
              "207420108"
            ]
          },
          "207420108": {
            "id": "207420108",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Ugh, my dandelions! They took so much effort to grow, too...",
            "nextDialogs": [
              "207420109"
            ]
          },
          "207420109": {
            "id": "207420109",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Y—You... If you needed dandelions, couldn't you go outside to gather some?",
            "nextDialogs": [
              "207420110"
            ]
          },
          "207420110": {
            "id": "207420110",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "These dandelions were the ones you helped me gather, too! It took a lot of care to make them grow... and this is how you treat them?"
          }
        }
      }
    },

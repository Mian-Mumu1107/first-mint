          "207420202": {
            "id": "207420202",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Growing flowers isn't that easy.",
            "nextDialogs": [
              "207420203"
            ]
          },
          "207420203": {
            "id": "207420203",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "...How about this, then? Find me some more Dandelion Seeds, and I'll plant them again myself."

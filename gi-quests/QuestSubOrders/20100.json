  "subQuests": [
    {
      "subId": "2010001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3580101"
        ],
        "dialogs": {
          "3580101": {
            "id": "3580101",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "...And once it was over I brought them straight here.",
            "nextDialogs": [
              "3580102"
            ]
          },
          "3580102": {
            "id": "3580102",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "Mondstadt welcomes you, windborne travelers.",
            "nextDialogs": [
              "3580103"
            ]
          },
          "3580103": {
            "id": "3580103",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "I am Jean, Acting Grand Master of the Knights of Favonius. This is Lisa, our resident Librarian.",
            "nextDialogs": [
              "3580104"
            ]
          },
          "3580104": {
            "id": "3580104",
            "speakerId": 1002,
            "speakerName": "Lisa",
            "text": "Oh! Are you sweeties here to help us out?",
            "nextDialogs": [
              "3580105"
            ]
          },
          "3580105": {
            "id": "3580105",
            "speakerId": 1002,
            "speakerName": "Lisa",
            "text": "You're both so adorable!",
            "nextDialogs": [
              "3580106"
            ]
          },
          "3580106": {
            "id": "3580106",
            "speakerId": 1002,
            "speakerName": "Lisa",
            "text": "Sadly, the timing is regrettable...",
            "nextDialogs": [
              "3580107"
            ]
          },
          "3580107": {
            "id": "3580107",
            "speakerId": 1002,
            "speakerName": "Lisa",
            "text": "Stormterror has caused quite a ruckus in the region since its recent resurgence.",
            "nextDialogs": [
              "3580108"
            ]
          },
          "3580108": {
            "id": "3580108",
            "speakerId": 1002,
            "speakerName": "Lisa",
            "text": "Simply put, Mondstadt's elemental sphere and ley lines are now akin to a yarn ball in the paws of a kitten.",
            "nextDialogs": [
              "3580109"
            ]
          },
          "3580109": {
            "id": "3580109",
            "speakerId": 1002,
            "speakerName": "Lisa",
            "text": "For a mage, it couldn't get much worse. My skin is one elemental particle away from a full-blown breakout.",
            "nextDialogs": [
              "3580110"
            ]
          },
          "3580110": {
            "id": "3580110",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "If it weren't for this interference, the Knights of Favonius would have better ways to help you than just putting up missing person posters.",
            "nextDialogs": [
              "3580111"
            ]
          },
          "3580111": {
            "id": "3580111",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "#We simply ask that you repose in Mondstadt while we help you seek out your {F#brother}{M#sister}.",
            "nextDialogs": [
              "3580113",
              "3580115"
            ]
          },
          "3580113": {
            "id": "3580113",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Paimon will help too!",
            "nextDialogs": [
              "3580116"
            ]
          },
          "3580116": {
            "id": "3580116",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "Good. In that case we need a plan.",
            "nextDialogs": [
              "3580117"
            ]
          },
          "3580117": {
            "id": "3580117",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "With Stormterror now directly attacking Mondstadt, we may have an opportunity to cut this problem off at the source.",
            "nextDialogs": [
              "3580118"
            ]
          },
          "3580118": {
            "id": "3580118",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "Lisa has revealed the sources of Stormterror's power with her detection magic.",
            "nextDialogs": [
              "3580119"
            ]
          },
          "3580119": {
            "id": "3580119",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "Is that so?",
            "nextDialogs": [
              "3580120"
            ]
          },
          "3580120": {
            "id": "3580120",
            "speakerId": 1002,
            "speakerName": "Lisa",
            "text": "They're located in the abandoned <color=#00E1FFFF>Four Winds' Temples</color>.",
            "nextDialogs": [
              "3580121"
            ]
          },
          "3580121": {
            "id": "3580121",
            "speakerId": 1002,
            "speakerName": "Lisa",
            "text": "Stormterror's ability to whip up these kinds of storms can be attributed to it drawing power from the temples.",
            "nextDialogs": [
              "3580122"
            ]
          },
          "3580122": {
            "id": "3580122",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "Our objective is to deal with <color=#00E1FFFF>three</color> of the four temples.",
            "nextDialogs": [
              "3580123"
            ]
          },
          "3580123": {
            "id": "3580123",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "I trust everyone understands why we are only dealing with three.",
            "nextDialogs": [
              "3580124"
            ]
          },
          "3580124": {
            "id": "3580124",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Paimon doesn't."
          },
          "3580115": {
            "id": "3580115",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Hey! Don't be such a slug! We should be a part of this too!"
          }
        }
      }
    },
    {

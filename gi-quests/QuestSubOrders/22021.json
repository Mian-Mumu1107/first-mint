  "subQuests": [
    {
      "subId": "2202101",
      "subQuestName": "Talk to Xudong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220210101"
        ],
        "dialogs": {
          "220210101": {
            "id": "220210101",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Get ready now, this dish is going to be amazing!",
            "nextDialogs": [
              "220210102"
            ]
          },
          "220210102": {
            "id": "220210102",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "My dish shall be similarly fantastic, so prepare yourself.",
            "nextDialogs": [
              "220210103"
            ]
          },
          "220210103": {
            "id": "220210103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you two doing?",
            "nextDialogs": [
              "220210104"
            ]
          },
          "220210104": {
            "id": "220210104",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hello, Traveler. Parvaneh and Julie are out gathering ingredients, and we were supposed to prepare a meal for them...",
            "nextDialogs": [
              "220210105"
            ]
          },
          "220210105": {
            "id": "220210105",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "But Uncle Munehisa and I had a minor disagreement about what to prepare.",
            "nextDialogs": [
              "220210106"
            ]
          },
          "220210106": {
            "id": "220210106",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "So we decided to each come up with a dish for a competition. The winner will get to set the theme for today's meals.",
            "nextDialogs": [
              "220210107"
            ]
          },
          "220210107": {
            "id": "220210107",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I'm making one of Liyue's specialties, Jewelry Soup.",
            "nextDialogs": [
              "220210108"
            ]
          },
          "220210108": {
            "id": "220210108",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "And I shall make my best dish, Tri-Flavored Skewer.",
            "nextDialogs": [
              "220210110",
              "220210112"
            ]
          },
          "220210110": {
            "id": "220210110",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Well, if you have time, we do need a judge...",
            "nextDialogs": [
              "220210113"
            ]
          },
          "220210113": {
            "id": "220210113",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "But since both of us need to prepare four servings of each dish despite only having two hands, we are a little overwhelmed.",
            "nextDialogs": [
              "220210114"
            ]
          },
          "220210114": {
            "id": "220210114",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "You can help us prepare the food before the judging begins.",
            "nextDialogs": [
              "220210115"
            ]
          },
          "220210115": {
            "id": "220210115",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "And of course, you can pick what dish to help with, since you are only one person."
          },
          "220210112": {
            "id": "220210112",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hahaha, that's right. We need a judge to try them."
          }
        }
      }
    },
    {
      "subId": "2202102",
      "subQuestName": "Help Xudong cook Jewelry Soup",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220210201"
        ],
        "dialogs": {
          "220210201": {
            "id": "220210201",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Done. Thank you, Traveler. It smells so good.",
            "nextDialogs": [
              "220210202"
            ]
          },
          "220210202": {
            "id": "220210202",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I'll try it first... Wow, that's great. The ingredients are cooked just right and it smells perfect.",
            "nextDialogs": [
              "220210203"
            ]
          },
          "220210203": {
            "id": "220210203",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "You could even call this a \"Perfect Jewelry Soup.\"",
            "nextDialogs": [
              "220210204"
            ]
          },
          "220210204": {
            "id": "220210204",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Okay, Uncle Munehisa, how's your cooking going? Ready to show it to the Traveler?",
            "nextDialogs": [
              "220210205"
            ]
          },
          "220210205": {
            "id": "220210205",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Well... I made a mistake. I realized that I didn't have enough Bird Eggs right after I started.",
            "nextDialogs": [
              "220210206"
            ]
          },
          "220210206": {
            "id": "220210206",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Although I did immediately go to get some Bird Eggs from the woods, the other ingredients were past their best by then.",
            "nextDialogs": [
              "220210207"
            ]
          },
          "220210207": {
            "id": "220210207",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Tri-Flavored Skewers made with ingredients that aren't fresh can no longer be considered a good meal.",
            "nextDialogs": [
              "220210208"
            ]
          },
          "220210208": {
            "id": "220210208",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I am ashamed to have been so negligent. I need to refine my skills more.",
            "nextDialogs": [
              "220210209"
            ]
          },
          "220210209": {
            "id": "220210209",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "You win this time. But next time, Xudong, I will definitely beat you.",
            "nextDialogs": [
              "220210211",
              "220210215"
            ]
          },
          "220210211": {
            "id": "220210211",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Haha, I promise that I won't be an easy opponent.",
            "nextDialogs": [
              "220210212"
            ]
          },
          "220210212": {
            "id": "220210212",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "By the way Traveler, these are for you. Thank you for helping us all this time.",
            "nextDialogs": [
              "220210213"
            ]
          },
          "220210213": {
            "id": "220210213",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Make sure to come next time we compete, too."
          },
          "220210215": {
            "id": "220210215",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I am not satisfied with just \"alright.\" Even in cooking, one has to have the heart to pursue perfection.",
            "nextDialogs": [
              "220210216"
            ]
          },
          "220210216": {
            "id": "220210216",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "This is the only way to become a master of the art of cooking.",
            "nextDialogs": [
              "220210217"
            ]
          },
          "220210217": {
            "id": "220210217",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Ah, I see. Exactly... That's exactly it!",
            "nextDialogs": [
              "220210218"
            ]
          },
          "220210218": {
            "id": "220210218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's right!",
            "nextDialogs": [
              "220210219"
            ]
          },
          "220210219": {
            "id": "220210219",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "The art of the sword and the art of cooking are the same in this regard, and to me, they are both part of the art of existence.",
            "nextDialogs": [
              "220210220"
            ]
          },
          "220210220": {
            "id": "220210220",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Great! Uh, way to go, Uncle Munehisa... I believe in you. Yeah...",
            "nextDialogs": [
              "220210221"
            ]
          },
          "220210221": {
            "id": "220210221",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Uh... I have no idea how to deal with someone who is so... serious. I guess only Julie can, but she's not here right now...",
            "nextDialogs": [
              "220210222"
            ]
          },
          "220210222": {
            "id": "220210222",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Honestly, I'm pretty shocked too.",
            "nextDialogs": [
              "220210223"
            ]
          },
          "220210223": {
            "id": "220210223",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "*cough* Well, thank you for your hard work, Traveler. Please take these. I—",
            "nextDialogs": [
              "220210224"
            ]
          },
          "220210224": {
            "id": "220210224",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Xudong, I'd like to ask you a few more questions about cooking. Do you have a moment?",
            "nextDialogs": [
              "220210225"
            ]
          },
          "220210225": {
            "id": "220210225",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Huh? Oh, right, yes! I'll be there! I'll be right there..."
          }
        }
      }
    },
    {
      "subId": "2202103",
      "subQuestName": "Help Kamei Munehisa cook Tri-Flavored Skewer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220210301"
        ],
        "dialogs": {
          "220210301": {
            "id": "220210301",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Hmm. The smell and how it looks... these Three Flavored Skewers should be called Extreme Skewers instead!",
            "nextDialogs": [
              "220210302"
            ]
          },
          "220210302": {
            "id": "220210302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Extreme... Skewers?",
            "nextDialogs": [
              "220210303"
            ]
          },
          "220210303": {
            "id": "220210303",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Hehe, I simply mean that it's a perfect dish... Well, would you look at the time. Xudong's Jewelry Soup should be ready now.",
            "nextDialogs": [
              "220210304"
            ]
          },
          "220210304": {
            "id": "220210304",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Of course! Here is my Jewelry Soup.",
            "nextDialogs": [
              "220210305"
            ]
          },
          "220210305": {
            "id": "220210305",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "It might be a bit overcooked because I didn't handle the timing perfectly, but the taste should be fine.",
            "nextDialogs": [
              "220210306"
            ]
          },
          "220210306": {
            "id": "220210306",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Let me taste it.",
            "nextDialogs": [
              "220210307"
            ]
          },
          "220210307": {
            "id": "220210307",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Well, it does have a slightly burnt taste. It's not bad enough to ruin the whole pot, but it is still a flaw in the end.",
            "nextDialogs": [
              "220210308"
            ]
          },
          "220210308": {
            "id": "220210308",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hahaha, I was in a hurry this time. Next time, I'll prepare all the ingredients in advance, so this won't happen.",
            "nextDialogs": [
              "220210309"
            ]
          },
          "220210309": {
            "id": "220210309",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "You win this time, but rest assured that I won't make the same mistake next time.",
            "nextDialogs": [
              "220210311",
              "220210315"
            ]
          },
          "220210311": {
            "id": "220210311",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hahaha... Yeah, I was careless. I'll have to be more mindful next time...",
            "nextDialogs": [
              "220210312"
            ]
          },
          "220210312": {
            "id": "220210312",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "By the way Traveler, these are for you. Thank you for helping us all this time.",
            "nextDialogs": [
              "220210313"
            ]
          },
          "220210313": {
            "id": "220210313",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Make sure to come next time we compete, too."
          },
          "220210315": {
            "id": "220210315",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Extreme Skewers? What does that mean?",
            "nextDialogs": [
              "220210316"
            ]
          },
          "220210316": {
            "id": "220210316",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "It means that these Tri-Flavored Skewer are of perfect quality.",
            "nextDialogs": [
              "220210317"
            ]
          },
          "220210317": {
            "id": "220210317",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "To have an \"extreme\" pursuit means that your heart can never satisfied with mere \"acceptability.\" Instead, the highest perfection is the goal.",
            "nextDialogs": [
              "220210318"
            ]
          },
          "220210318": {
            "id": "220210318",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Even in cooking, one must have the heart to pursue perfection. This is the only way to become a master of the art of cooking.",
            "nextDialogs": [
              "220210319"
            ]
          },
          "220210319": {
            "id": "220210319",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Ah, I see. Exactly... That's exactly it!",
            "nextDialogs": [
              "220210320"
            ]
          },
          "220210320": {
            "id": "220210320",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's right!",
            "nextDialogs": [
              "220210321"
            ]
          },
          "220210321": {
            "id": "220210321",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "The art of the sword and the art of cooking are the same in this regard, and to me, they are both part of the art of existence.",
            "nextDialogs": [
              "220210322"
            ]
          },
          "220210322": {
            "id": "220210322",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Come, Xudong. Allow me to tell you about the \"extreme\" path.",
            "nextDialogs": [
              "220210323"
            ]
          },
          "220210323": {
            "id": "220210323",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Huh? O—Okay. Just give me a second, I'll be right there. Traveler, here is your payment...",
            "nextDialogs": [
              "220210324"
            ]
          },
          "220210324": {
            "id": "220210324",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Uh... I have no idea how to deal with someone who is so... serious. I guess only Julie can, but she's not here right now...",
            "nextDialogs": [
              "220210325"
            ]
          },
          "220210325": {
            "id": "220210325",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just go get the Extreme Cookery experience.",
            "nextDialogs": [
              "220210326"
            ]
          },
          "220210326": {
            "id": "220210326",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Xudong?",
            "nextDialogs": [
              "220210327"
            ]
          },
          "220210327": {
            "id": "220210327",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Huh? I'm coming. Just a second! I'll be right there..."
          }
        }
      }
    },
    {
      "subId": "2202104",
      "subQuestName": "Help Xudong turn up the heat",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220210401"
        ],
        "dialogs": {
          "220210401": {

      }
    },
    {
      "subId": "2202105",
      "subQuestName": "Help Kamei Munehisa turn down the heat",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220210501"
        ],
        "dialogs": {
          "220210501": {
            "id": "220210501",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "How did it go? Did you get Bird Eggs?"
          }
        }
      }
    },
    {
      "subId": "2202111",
      "subQuestName": "Talk to Xudong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220210601"
        ],
        "dialogs": {
          "220210601": {
            "id": "220210601",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Then let's get started. Jewelry Soup requires Snapdragon, Tofu, and Lotus Heads...",
            "nextDialogs": [
              "220210602"
            ]
          },
          "220210602": {
            "id": "220210602",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Lotus Heads and Tofu... Luckily, there's still some left. But there's not enough Snapdragon...",
            "nextDialogs": [
              "220210603"
            ]
          },
          "220210603": {
            "id": "220210603",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Traveler, I'll be handling the ingredients. Just in case, can you please get me three more servings of Fresh Snapdragon?"
          }
        }
      }
    },
    {
      "subId": "2202112",
      "subQuestName": "Talk to Kamei Munehisa",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220210701"
        ],
        "dialogs": {
          "220210701": {
            "id": "220210701",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Thank you for your willingness to help. Tri-Flavored Skewer is simple to prepare, but it requires extra attention to the freshness of the ingredients.",
            "nextDialogs": [
              "220210702"
            ]
          },
          "220210702": {
            "id": "220210702",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I've gotten enough of every ingredient except Bird Eggs... Could you please fetch two fresh eggs for me, just in case?",
            "nextDialogs": [
              "220210704",
              "220210706"
            ]
          },
          "220210704": {
            "id": "220210704",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Thank you."
          },
          "220210706": {
            "id": "220210706",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "When I was still serving in the Shogunate, I used to make this sort of small dish to go with wine.",
            "nextDialogs": [
              "220210707"
            ]
          },
          "220210707": {
            "id": "220210707",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "But now...",
            "nextDialogs": [
              "220210708"
            ]
          },
          "220210708": {
            "id": "220210708",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Anyway, let's not talk about the past. I'm counting on you for the Bird Eggs.",
            "nextDialogs": [
              "220210709"
            ]
          },
          "220210709": {
            "id": "220210709",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I will be dealing with the ingredients here. Please bring the Bird Eggs to me as soon as you have them."
          }
        }
      }
    },

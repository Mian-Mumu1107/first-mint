    {
      "subId": "7600101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760010101"
        ],
        "dialogs": {
          "760010101": {
            "id": "760010101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Just a moment, if you don't mind! There's something Paimon wants to ask you two...",
            "nextDialogs": [
              "760010102"
            ]
          },
          "760010102": {
            "id": "760010102",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You present the items you obtained earlier to the two Lightkeepers. You also tell them about how a strange figure, dressed in Lightkeeper garb, fought by your side to repel the Wild Hunt...",
            "nextDialogs": [
              "760010103"
            ]
          },
          "760010103": {
            "id": "760010103",
            "speakerId": 7067,
            "speakerName": "Lushne",
            "text": "...Could it have been Sigurd? He hasn't been able to rest in peace, even until now, it seems. If only I could...",
            "nextDialogs": [
              "760010104"
            ]
          },
          "760010104": {
            "id": "760010104",
            "speakerId": 7066,
            "speakerName": "Sukhovykh",
            "text": "Cut it out, Lushne. This is not your burden to bear alone. As long as the Hunt exists, he will continue to fight them. All we can do is to fulfill our mission as best as we can.",
            "nextDialogs": [
              "760010105"
            ]
          },
          "760010105": {
            "id": "760010105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sooo... this Sigurd, he used to be a Lightkeeper as well, right?",
            "nextDialogs": [
              "760010106"
            ]
          },
          "760010106": {
            "id": "760010106",
            "speakerId": 7066,
            "speakerName": "Sukhovykh",
            "text": "Yes. He was a formidable Starshyna, and when the Wild Hunt swept over Nod-Krai, he fought valiantly till the end.",
            "nextDialogs": [
              "760010107"
            ]
          },
          "760010107": {
            "id": "760010107",
            "speakerId": 7066,
            "speakerName": "Sukhovykh",
            "text": "It's said that even mindless beasts flinch when they hear his warning bell, chilled to the bone and too terrified to press onward... And yet, you two somehow managed to recover his relics. How curious...",
            "nextDialogs": [
              "760010108"
            ]
          },
          "760010108": {
            "id": "760010108",
            "speakerId": 7066,
            "speakerName": "Sukhovykh",
            "text": "If you can, please take those relics to his grave. It lies near the eastern battlefield ruins on Lempo Isle.",
            "nextDialogs": [
              "760010109"
            ]
          },
          "760010109": {
            "id": "760010109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Will do.",
            "nextDialogs": [
              "760010110"
            ]
          },
          "760010110": {
            "id": "760010110",
            "speakerId": 7066,
            "speakerName": "Sukhovykh",
            "text": "Thank you. May the day soon come when his spirit may rest..."
          }
        }
      }
    },
    {

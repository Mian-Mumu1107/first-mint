  "subQuests": [
    {
      "subId": "7480001",
      "subQuestName": "Talk to Guijarro",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "748000101"
        ],
        "dialogs": {
          "748000101": {
            "id": "748000101",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "It can't be... It can't be...",
            "nextDialogs": [
              "748000102"
            ]
          },
          "748000102": {
            "id": "748000102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "748000103"
            ]
          },
          "748000103": {
            "id": "748000103",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "Ah! No! I swear I didn't do anything, please don't hurt me!",
            "nextDialogs": [
              "748000104"
            ]
          },
          "748000104": {
            "id": "748000104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What are you talking about? Why would we want to hurt you?",
            "nextDialogs": [
              "748000105"
            ]
          },
          "748000105": {
            "id": "748000105",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "I don't know! But I also don't know that you won't really hurt me!",
            "nextDialogs": [
              "748000108"
            ]
          },
          "748000108": {
            "id": "748000108",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "Oh! ...I've got it! It must be because I discovered your secret, right?",
            "nextDialogs": [
              "748000109"
            ]
          },
          "748000109": {
            "id": "748000109",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "I... I took the newspaper with your secret letter hidden inside it in the coffee shop?",
            "nextDialogs": [
              "748000110"
            ]
          },
          "748000110": {
            "id": "748000110",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "Or because I accidentally discovered your passphrase? Wait a moment, could it be that the fish I ate last night...",
            "nextDialogs": [
              "748000111"
            ]
          },
          "748000111": {
            "id": "748000111",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "I say, the reason that the fish had so few bones is because you already deboned that fish!",
            "nextDialogs": [
              "748000112"
            ]
          },
          "748000112": {
            "id": "748000112",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "Yes, yes, you wish to use the difference in the number of bones in each fish to send a message... But I accidentally bought this one and brought it back home with me...",
            "nextDialogs": [
              "748000113"
            ]
          },
          "748000113": {
            "id": "748000113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What the heck is this girl talking about? Paimon can't make heads or tails of it..."
          }
        }
      }
    },
    {
      "subId": "7480007",
      "subQuestName": "Head to the vicinity of the aquabus",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "748000201"
        ],
        "dialogs": {
          "748000201": {
            "id": "748000201",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "The aquabus is just over there... We'll board together in a bit."
          }
        }
      }
    },
    {
      "subId": "7480006",
      "subQuestName": "Talk to Guijarro",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "748000801"
        ],
        "dialogs": {
          "748000801": {
            "id": "748000801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Hey! Why are you crouching on the ground holding your head?",
            "nextDialogs": [
              "748000802"
            ]
          },
          "748000802": {
            "id": "748000802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did you hit your head or something? But there isn't anything here to hit your head on...",
            "nextDialogs": [
              "748000803"
            ]
          },
          "748000803": {
            "id": "748000803",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "Shh! Get over here! Lie down next to me! It's dangerous here...",
            "nextDialogs": [
              "748000804"
            ]
          },
          "748000804": {
            "id": "748000804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Here we go again...",
            "nextDialogs": [
              "748000805"
            ]
          },
          "748000805": {
            "id": "748000805",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "This aquabus doesn't have any kind of barrier on top! If you place two poles on either side, and run fishing line between them...",
            "nextDialogs": [
              "748000806"
            ]
          },
          "748000806": {
            "id": "748000806",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "Then when the aquabus passes through, that fishing line will suddenly become a knife that...",
            "nextDialogs": [
              "748000807"
            ]
          },
          "748000807": {
            "id": "748000807",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aaaah! Stop! Don't say any more!",
            "nextDialogs": [
              "748000808"
            ]
          },
          "748000808": {
            "id": "748000808",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "No, no, you don't even need two poles! One would be enough...",
            "nextDialogs": [
              "748000809"
            ]
          },
          "748000809": {
            "id": "748000809",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "And if you hung up some fishing line on it, with the hook just dangling there...",
            "nextDialogs": [
              "748000810"
            ]
          },
          "748000810": {
            "id": "748000810",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "Then the people on the aquabus would naturally be hooked, and left hanging in the air, and then...",
            "nextDialogs": [
              "748000811"
            ]
          },
          "748000811": {
            "id": "748000811",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Not listening not listening not listening... Paimon's not listening, lalalala!",
            "nextDialogs": [
              "748000812"
            ]
          },
          "748000812": {
            "id": "748000812",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "After listening to her this whole time, even Paimon's getting kinda scared...",
            "nextDialogs": [
              "748000813"
            ]
          },
          "748000813": {
            "id": "748000813",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's get off the aquabus as soon as we arrive at the station, alright?"
          }
        }
      }
    },
    {
      "subId": "7480003",
      "subQuestName": "Go to the café",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "748000401"
        ],
        "dialogs": {
          "748000401": {
            "id": "748000401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why are you hiding again? There's nothing around here!",
            "nextDialogs": [
              "748000402"
            ]
          },
          "748000402": {
            "id": "748000402",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "Can't you see that Gardemek? It's right in front of us!",
            "nextDialogs": [
              "748000405"
            ]
          },
          "748000405": {
            "id": "748000405",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "Shh! Quick, get out of there! What if it goes out of control?",
            "nextDialogs": [
              "748000406"
            ]
          },
          "748000406": {
            "id": "748000406",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "Or maybe its... its power core will suddenly explode! Or someone controlling it remotely will use it to attack us?",
            "nextDialogs": [
              "748000407"
            ]
          },
          "748000407": {
            "id": "748000407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It looks completely normal to me.",
            "nextDialogs": [
              "748000408"
            ]
          },
          "748000408": {
            "id": "748000408",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "That is exactly what makes me so scared! A meka that is operating normally suddenly losing control, and some poor unfortunate sop suddenly losing their life...",
            "nextDialogs": [
              "748000409"
            ]
          },
          "748000409": {
            "id": "748000409",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "Nobody would even be held responsible for such a thing! Perhaps the true culprit would never be found... No, it's simply too dangerous!",
            "nextDialogs": [
              "748000410"
            ]
          },
          "748000410": {
            "id": "748000410",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It already left, you can come out now!",
            "nextDialogs": [
              "748000411"
            ]
          },
          "748000411": {
            "id": "748000411",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "Phew... It didn't go out of control, truly unexpected. Our lives have been spared yet again."
          }
        }
      }
    },
    {
      "subId": "7480005",
      "subQuestName": "Go to the café",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "748000501"
        ],
        "dialogs": {
          "748000501": {
            "id": "748000501",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "Ah, right... That's true...",
            "nextDialogs": [
              "748000504"
            ]
          },
          "748000504": {
            "id": "748000504",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "#Well, thank you, {NICKNAME}. And thank you for escorting me here.",
            "nextDialogs": [
              "748000505"
            ]
          },
          "748000505": {
            "id": "748000505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You say \"escort,\" but all we did was walk with you here. We didn't do anything!"
          }
        }
      }
    },

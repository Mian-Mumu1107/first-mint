        "dialogs": {
          "748000601": {
            "id": "748000601",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "Yes, right... that must be it...",
            "nextDialogs": [
              "748000604"
            ]
          },
          "748000604": {
            "id": "748000604",
            "speakerId": 5268,
            "speakerName": "Guijarro",
            "text": "#Well, thank you, {NICKNAME}. And thank you for escorting me here.",
            "nextDialogs": [
              "748000605"
            ]
          },
          "748000605": {
            "id": "748000605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You say \"escort,\" but all we did was walk with you here. We didn't do anything!"
          },
          "748000699": {

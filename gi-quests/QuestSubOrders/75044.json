    {
      "subId": "7504407",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750440701"
        ],
        "dialogs": {
          "750440701": {
            "id": "750440701",
            "speakerId": 1003,
            "speakerName": "Eye-Catching Slogan",
            "text": "The Soaring Saurian is open all day! If you wish to join Matahga's special training, then come lift off from the Soaring Saurian! Note:",
            "nextDialogs": [
              "750440702"
            ]
          },
          "750440702": {
            "id": "750440702",
            "speakerId": 1003,
            "speakerName": "Eye-Catching Slogan",
            "text": "Up with serious, rigorous training! Down with sloth and slacking!",
            "nextDialogs": [
              "750440703"
            ]
          },
          "750440703": {
            "id": "750440703",
            "speakerId": 1003,
            "speakerName": "Eye-Catching Slogan",
            "text": "Laze about today, and be as trash tomorrow!",
            "nextDialogs": [
              "750440704"
            ]
          },
          "750440704": {
            "id": "750440704",
            "speakerId": 1003,
            "speakerName": "Eye-Catching Slogan",
            "text": "Only those who push forward boldly shall truly know greatness as Saurian riders!"
          }
        }
      }
    },
    {
      "subId": "7504408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750440801"
        ],
        "dialogs": {
          "750440801": {
            "id": "750440801",
            "speakerId": 1004,
            "speakerName": "Matahga! Remember!!!",
            "text": "The code is: Blow the left horn first, then the right one, then the left again, and finally the right... but blow 'em at your own peril!",
            "nextDialogs": [
              "750440802"
            ]
          },
          "750440802": {
            "id": "750440802",
            "speakerId": 1004,
            "speakerName": "Matahga! Remember!!!",
            "text": "Feeding a Saurian some Fowl is the best way to keep one in a good mood and avoid getting pecked!",
            "nextDialogs": [
              "750440803"
            ]
          },
          "750440803": {
            "id": "750440803",
            "speakerId": 1004,
            "speakerName": "Matahga! Remember!!!",
            "text": "(Seems like a reminder that someone called Matahga left for themselves. You can feel the intensity of the emotion in their words.)",
            "nextDialogs": [
              "750440804"
            ]
          },
          "750440804": {
            "id": "750440804",
            "speakerId": 1004,
            "speakerName": "Matahga! Remember!!!",
            "text": "(But surely putting exclamation marks at the end of every reminder is the same as putting none... Isn't it?)"
          }
        }
      }
    },
    {
      "subId": "7504417",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750441701"
        ],
        "dialogs": {
          "750441701": {
            "id": "750441701",
            "speakerId": 1005,
            "speakerName": "Barely-Legible Bulletin",
            "text": "\"...By the order of the Guardian of the{RUBY#[D]Yajaw K'ahk'} Sacred Flame, and the most benevolent and glorious Holy Sov{RUBY#[D]Ti'sakhuun}ereign, His Ma{RUBY#[D]Kalomte}jesty Och-Kan, labor is now being recruited from all tribes for the construction of water conservation infrastructure...\"",
            "nextDialogs": [
              "750441702"
            ]
          },
          "750441702": {
            "id": "750441702",
            "speakerId": 1005,
            "speakerName": "Barely-Legible Bulletin",
            "text": "\"...No fixed quotas, with all being based on voluntary participation... Building the alliance... We hope all tribes will actively respond...\""
          }
        }
      }
    },
    {
      "subId": "7504418",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750441801"
        ],
        "dialogs": {
          "750441801": {
            "id": "750441801",
            "speakerId": 1006,
            "speakerName": "Ancient Bulletin",
            "text": "\"By the order of the Guardian of the{RUBY#[D]Yajaw K'ahk'} Sacred Flame, and the most benevolent and glorious Holy Sov{RUBY#[D]Ti'sakhuun}ereign, His Ma{RUBY#[D]Kalomte}jesty Och-Kan, the cursed land is hereby sealed off, effective immediately. All members of the alliance are strictly prohibited from entering.\"",
            "nextDialogs": [
              "750441802"
            ]
          },
          "750441802": {
            "id": "750441802",
            "speakerId": 1006,
            "speakerName": "Ancient Bulletin",
            "text": "\"Those who enter without authorization will be officially recognized as enemies of the alliance. This is the joint declaration of (...) Nanatzcayan, Meztli, Huitztlan, and Teteocan.\""
          }
        }
      }
    },
    {
      "subId": "7504419",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750441901"
        ],
        "dialogs": {
          "750441901": {
            "id": "750441901",
            "speakerId": 1006,
            "speakerName": "Ancient Bulletin",
            "text": "\"Glory forever unto to the Guardian of the{RUBY#[D]Yajaw K'ahk'} Sacred Flame, the Great Pe{RUBY#[D]Q'atal Tzij}acemaker the most benevolent Holy Sov{RUBY#[D]Ti'sakhuun}ereign Och-Kan.\"",
            "nextDialogs": [
              "750441902"
            ]
          },
          "750441902": {
            "id": "750441902",
            "speakerId": 1006,
            "speakerName": "Ancient Bulletin",
            "text": "\"Given the slow overall progress of the drainage works in this area, minor adjustments are being made to the rotation system to ensure the alliance's inexorable triumph.\"",
            "nextDialogs": [
              "750441903"
            ]
          },
          "750441903": {
            "id": "750441903",
            "speakerId": 1006,
            "speakerName": "Ancient Bulletin",
            "text": "\"Workers will be divided into three teams, each team working sixteen hours, rotating every two days. Teams with exceptional performance will receive extra grain provisions.\"",
            "nextDialogs": [
              "750441904"
            ]
          },
          "750441904": {
            "id": "750441904",
            "speakerId": 1006,
            "speakerName": "Ancient Bulletin",
            "text": "\"The triumphant victory of <color=#00E1FFFF>draining the accumulated water</color> is close at hand. Once the ditches are completed, the <color=#00E1FFFF>water pump</color> can operate normally. Push a little harder!\""
          }
        }
      }
    },
    {
      "subId": "7504420",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750442001"
        ],
        "dialogs": {
          "750442001": {
            "id": "750442001",
            "speakerId": 1006,
            "speakerName": "Ancient Bulletin",
            "text": "\"...Compatriots, family, brothers and sisters who have dedicated themselves to the alliance's inexorable triumph...\"",
            "nextDialogs": [
              "750442002"
            ]
          },
          "750442002": {
            "id": "750442002",
            "speakerId": 1006,
            "speakerName": "Ancient Bulletin",
            "text": "\"...The most benevolent... has allocated a batch of new mechanisms from (...) to support transportation, (...) and <color=#00E1FFFF>underwater salvage</color>...\"",
            "nextDialogs": [
              "750442003"
            ]
          },
          "750442003": {
            "id": "750442003",
            "speakerId": 1006,
            "speakerName": "Ancient Bulletin",
            "text": "\"...Forward! Forward! Move forward at all costs... For the glorious future of the alliance, for our freedom and glory, for a homeland free from the evil dragons's oppression...\"",
            "nextDialogs": [
              "750442004"
            ]
          },
          "750442004": {
            "id": "750442004",
            "speakerId": 1007,
            "speakerName": "Vaguely-Readable Writings",
            "text": "\"...Without permission... it is forbidden to operate the <color=#00E1FFFF>control lever</color>... Accidental falls... have already caused the deaths of three workers...\""
          }
        }
      }
    },
    {
      "subId": "7504421",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750442101"
        ],
        "dialogs": {
          "750442101": {
            "id": "750442101",
            "speakerId": 1008,
            "speakerName": "Artisan's Memo (I)",
            "text": "\"...There's a small trail behind a stone wall to the north that leads to the top of the waterfall. It can be used as a <color=#00E1FFFF>storage area</color>...\"",
            "nextDialogs": [
              "750442102"
            ]
          },
          "750442102": {
            "id": "750442102",
            "speakerId": 1008,
            "speakerName": "Artisan's Memo (I)",
            "text": "\"...I left a few marks, just in case I forget the way later...\"",
            "nextDialogs": [
              "750442103"
            ]
          },
          "750442103": {
            "id": "750442103",
            "speakerId": 1008,
            "speakerName": "Artisan's Memo (I)",
            "text": "\"...Sayani's injuries took a turn for the worse. The humidity's to blame... I told her to rest, but she laughed it off... saying it would slow the squad down, resulting in everyone missing out on extra provisions...\"",
            "nextDialogs": [
              "750442104"
            ]
          },
          "750442104": {
            "id": "750442104",
            "speakerId": 1008,
            "speakerName": "Artisan's Memo (I)",
            "text": "\"...Once night falls, I'll sneak up to her with a torch to cauterize her wound while the others aren't watching, or her limbs will rot, too...\""
          }
        }
      }
    },
    {
      "subId": "7504424",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750442401"
        ],
        "dialogs": {
          "750442401": {
            "id": "750442401",
            "speakerId": 1005,
            "speakerName": "Barely-Legible Bulletin",
            "text": "\"...May glory eternal be... Peacemaker... Most benevolent... Och-Kan...\"",
            "nextDialogs": [
              "750442402"
            ]
          },
          "750442402": {
            "id": "750442402",
            "speakerId": 1005,
            "speakerName": "Barely-Legible Bulletin",
            "text": "...Artisans Mahutzintl, Tlanalco, and... those responsible for the construction of the water pump... deliberately slowed down, causing delays... The benevolent... imposed no punishment... only suspended rations for three weeks...",
            "nextDialogs": [
              "750442403"
            ]
          },
          "750442403": {
            "id": "750442403",
            "speakerId": 1005,
            "speakerName": "Barely-Legible Bulletin",
            "text": "\"...The <color=#00E1FFFF>stone key</color> that activates the <color=#00E1FFFF>water pump mechanism</color>... is kept at... no one is allowed to use it without permission... until other artisans are assigned...\""
          }
        }
      }
    },
    {
      "subId": "7504436",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750443601"
        ],
        "dialogs": {
          "750443601": {
            "id": "750443601",
            "speakerId": 1009,
            "speakerName": "\"Lavender Flower\"",
            "text": "(A romance novel written by Dorothy Leeckson. On its faded cover, a woman lies on a bed surrounded by flowers.)",
            "nextDialogs": [
              "750443602"
            ]
          },
          "750443602": {
            "id": "750443602",
            "speakerId": 1009,
            "speakerName": "\"Lavender Flower\"",
            "text": "(After skimming through the book, you feel warm and content, but haven't gained any useful insights.)",
            "nextDialogs": [
              "750443603"
            ]
          },
          "750443603": {
            "id": "750443603",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So... Was it her family's gardener or her best friend's cousin's brother-in-law?... Ugh, Paimon's head hurts!"
          }
        }
      }
    },
    {
      "subId": "7504437",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750443701"
        ],
        "dialogs": {
          "750443701": {
            "id": "750443701",
            "speakerId": 1010,
            "speakerName": "\"Detective Snowpaws\"",
            "text": "(The biography of Frank Drebin, retired Inspector of Fontaine's Marechaussee Phantom special police force. Yep, the Inspector is a vigorous white cat.)",
            "nextDialogs": [
              "750443702"
            ]
          },
          "750443702": {
            "id": "750443702",
            "speakerId": 1010,
            "speakerName": "\"Detective Snowpaws\"",
            "text": "(A big cat paw print is imprinted on the title page of this book, perhaps a special memento the Inspector has left for his subordinates.)",
            "nextDialogs": [
              "750443703"
            ]
          },
          "750443703": {
            "id": "750443703",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Seriously... Might as well write a book about Paimon too, called... The White-Haired Detective!"
          }
        }
      }
    },
    {
      "subId": "7504438",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750443801"
        ],
        "dialogs": {
          "750443801": {
            "id": "750443801",
            "speakerId": 1011,
            "speakerName": "\"History of Teyvat: Part I\"",
            "text": "(A work by Fontainian playwright, Jean Brooklyn. A book this thick can totally be used by shorter people to increase their height.)"
          }
        }
      }
    },
    {
      "subId": "7504439",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750443901"
        ],
        "dialogs": {
          "750443901": {
            "id": "750443901",
            "speakerId": 1012,
            "speakerName": "\"Fontainian Perfume Ad Collection\"",
            "text": "(A photo album that doesn't seem rather popular. It's filled with images of beautiful young ladies.)",
            "nextDialogs": [
              "750443902"
            ]
          },
          "750443902": {
            "id": "750443902",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmph... Just pictures of girls? Boring!"
          }
        }
      }
    },
    {
      "subId": "7504441",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750444101"
        ],
        "dialogs": {
          "750444101": {
            "id": "750444101",
            "speakerId": 1013,
            "speakerName": "Holy Sovereign's Notes (IV)",
            "text": "\"...The secret... necessary sacrifices... anything it takes...\"",
            "nextDialogs": [
              "750444102"
            ]
          },
          "750444102": {
            "id": "750444102",
            "speakerId": 1013,
            "speakerName": "Holy Sovereign's Notes (IV)",
            "text": "(Most of the rest of the content has been burned and is illegible.)"
          }
        }
      }
    },
    {
      "subId": "7504444",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750444401"
        ],
        "dialogs": {
          "750444401": {
            "id": "750444401",
            "speakerId": 1001,
            "speakerName": "Monetoo",
            "text": "?",
            "nextDialogs": [
              "750444402"
            ]
          },
          "750444402": {
            "id": "750444402",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "On closer inspection, it does seem odd that the only empty jar is the one in front of this Monetoo...",
            "nextDialogs": [
              "750444403"
            ]
          },
          "750444403": {
            "id": "750444403",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Did the other Monetoo find what they were looking for but this one didn't?",
            "nextDialogs": [
              "750444404"
            ]
          },
          "750444404": {
            "id": "750444404",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Poor thing... C'mon, {NICKNAME}, let's help it find the stuff that was meant to fit in this jar... Hmm. What would that be, though?",
            "nextDialogs": [
              "750444405"
            ]
          },
          "750444405": {
            "id": "750444405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Place)"
          }
        }
      }
    },
    {
      "subId": "7504445",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750444501"
        ],
        "dialogs": {
          "750444501": {
            "id": "750444501",
            "speakerId": 1001,
            "speakerName": "Monetoo",
            "text": "?",
            "nextDialogs": [
              "750444502"
            ]
          },
          "750444502": {
            "id": "750444502",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Umm, this doesn't look to be the right thing..."
          }
        }
      }
    },
    {
      "subId": "7504447",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750444701"
        ],
        "dialogs": {
          "750444701": {
            "id": "750444701",
            "speakerId": 1014,
            "speakerName": "A Child's Notes",
            "text": "(Childish, scribbled writings are visible:)",
            "nextDialogs": [
              "750444702"
            ]
          },
          "750444702": {
            "id": "750444702",
            "speakerId": 1014,
            "speakerName": "A Child's Notes",
            "text": "This game's called \"Bing Bong Ding Dong,\" and here's the rules:",
            "nextDialogs": [
              "750444703"
            ]
          },
          "750444703": {
            "id": "750444703",
            "speakerId": 1014,
            "speakerName": "A Child's Notes",
            "text": "1. When the Bing Bong Monetoo isn't ding-donging, ride on the Saurian statue's back to make it move forward.",
            "nextDialogs": [
              "750444704"
            ]
          },
          "750444704": {
            "id": "750444704",
            "speakerId": 1014,
            "speakerName": "A Child's Notes",
            "text": "2. Get off the Saurian statue when the Bing Bong Monetoo counts down to a \"ding!\" or you'll lose.",
            "nextDialogs": [
              "750444705"
            ]
          },
          "750444705": {
            "id": "750444705",
            "speakerId": 1014,
            "speakerName": "A Child's Notes",
            "text": "3. First one to run to the Bing Bong Monetoo wins!",
            "nextDialogs": [
              "750444706"
            ]
          },
          "750444706": {
            "id": "750444706",
            "speakerId": 1014,
            "speakerName": "A Child's Notes",
            "text": "And don't give me that \"isn't this just Red Light, Green Light?\" crap. Rules are important, and it's precisely because you don't respect the rules that you can't win!"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7504402",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750444601"
        ],
        "dialogs": {
          "750444601": {
            "id": "750444601",
            "speakerId": 1001,
            "speakerName": "Monetoo",
            "text": "!",
            "nextDialogs": [
              "750444602"
            ]
          },
          "750444602": {
            "id": "750444602",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ah, so this is what we're looking for — something with red in it!",
            "nextDialogs": [
              "750444603"
            ]
          },
          "750444603": {
            "id": "750444603",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wait... Huh? The stuff we threw in is gone... We did chuck something in, right? Something doesn't feel quite right here...",
            "nextDialogs": [
              "750444604"
            ]
          },
          "750444604": {
            "id": "750444604",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Is there something else in the jar?",
            "nextDialogs": [
              "750444605"
            ]
          },
          "750444605": {
            "id": "750444605",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "(Knock on the jar)"
          }
        }
      }
    },

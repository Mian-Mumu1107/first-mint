  "subQuests": [
    {
      "subId": "7335001",
      "subQuestName": "Talk to Augustus",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733500101"
        ],
        "dialogs": {
          "733500101": {
            "id": "733500101",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "A-Achoo! The smell of these spices is just too... A-ACHOO!",
            "nextDialogs": [
              "733500102"
            ]
          },
          "733500102": {
            "id": "733500102",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "I should just take a picture and go hide in my room...",
            "nextDialogs": [
              "733500103"
            ]
          },
          "733500103": {
            "id": "733500103",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "Traveler! Hey! Traveler! Hold on a second!",
            "nextDialogs": [
              "733500106"
            ]
          },
          "733500106": {
            "id": "733500106",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "I'd like your help with taking a picture, just one. It won't take long.",
            "nextDialogs": [
              "733500109"
            ]
          },
          "733500109": {
            "id": "733500109",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "*sigh* It's embarrassing to admit, but the aroma of the spices here is a little too strong for me...",
            "nextDialogs": [
              "733500110"
            ]
          },
          "733500110": {
            "id": "733500110",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "During my time in Fontaine, I never had food with even just a hint of spiciness, a pinch of salt is as much as I can take.",
            "nextDialogs": [
              "733500111"
            ]
          },
          "733500111": {
            "id": "733500111",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "Here, I'm sneezing so much that— ACHOO! I can't even hold the Kamera steadily...",
            "nextDialogs": [
              "733500112"
            ]
          },
          "733500112": {
            "id": "733500112",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "So, all I can do... is ask someone else to take a photo for me.",
            "nextDialogs": [
              "733500113"
            ]
          },
          "733500113": {
            "id": "733500113",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "You certainly seem to be a kind person, so... I'd like to ask for your help.",
            "nextDialogs": [
              "733500114"
            ]
          },
          "733500114": {
            "id": "733500114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're from Fontaine?",
            "nextDialogs": [
              "733500115"
            ]
          },
          "733500115": {
            "id": "733500115",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "Indeed. I'm very sorry that I forgot to introduce myself...",
            "nextDialogs": [
              "733500116"
            ]
          },
          "733500116": {
            "id": "733500116",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "I'm Augustus Lovelace, a researcher from Fontaine Research Institute of Kinetic Energy Engineering."
          }
        }
      }
    },
    {
      "subId": "7335002",
      "subQuestName": "Take a Photo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733500201"
        ],
        "dialogs": {
          "733500201": {
            "id": "733500201",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "Have you taken my picture?",
            "nextDialogs": [
              "733500202"
            ]
          },
          "733500202": {
            "id": "733500202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet.",
            "nextDialogs": [
              "733500203"
            ]
          },
          "733500203": {
            "id": "733500203",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "Oh, take your time. Taking a good photo is no easy task."
          }
        }
      }
    },
    {
      "subId": "7335003",
      "subQuestName": "Report back to Augustus",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733500301"
        ],
        "dialogs": {
          "733500301": {
            "id": "733500301",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "Not bad indeed. You have a gift.",
            "nextDialogs": [
              "733500302"
            ]
          },
          "733500302": {
            "id": "733500302",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "It's the first time in my travels that I've met someone with such control over composition and color.",
            "nextDialogs": [
              "733500303"
            ]
          },
          "733500303": {
            "id": "733500303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Where have your travels taken you?",
            "nextDialogs": [
              "733500304"
            ]
          },
          "733500304": {
            "id": "733500304",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "Ah, that, well... I could have come directly to Sumeru from Fontaine... after all, there's a line going straight to the Bayda Harbor in Sumeru.",
            "nextDialogs": [
              "733500312"
            ]
          },
          "733500312": {
            "id": "733500312",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "But as they say, it's about the journey, not the destination. So I chose a... more interesting route.",
            "nextDialogs": [
              "733500313"
            ]
          },
          "733500313": {
            "id": "733500313",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "First, I went from Lumidouce Harbor to Chenyu Vale, and then passed through Qingce Village on my way to the Stone Gate that separates Mondstadt from Liyue.",
            "nextDialogs": [
              "733500310"
            ]
          },
          "733500310": {
            "id": "733500310",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "After stopping by Dawn Winery, I decided to head south and visit Liyue Harbor.",
            "nextDialogs": [
              "733500305"
            ]
          },
          "733500305": {
            "id": "733500305",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "I embarked on a ferry to Port Ormos from Liyue Harbor, traveled northward along the river, and here I am standing before you.",
            "nextDialogs": [
              "733500306"
            ]
          },
          "733500306": {
            "id": "733500306",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "After all, my goal is to relax. Were I a brave warrior with a passion for adventure...",
            "nextDialogs": [
              "733500311"
            ]
          },
          "733500311": {
            "id": "733500311",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "...I might have decided to set out from Romaritime Harbor and followed the ancient path of the pilgrims, heading southward into the desert.",
            "nextDialogs": [
              "733500307"
            ]
          },
          "733500307": {
            "id": "733500307",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "Who knows? Maybe I'll try to cross the desert on the way back. Anyway, I've still got extra Mora to spend, and paying a visit to Natlan on the other side of the desert sounds nice too...",
            "nextDialogs": [
              "733500308"
            ]
          },
          "733500308": {
            "id": "733500308",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "Alright, I won't keep you any longer. Thank you for helping me with the photo, please accept this as a token of my gratitude.",
            "nextDialogs": [
              "733500309"
            ]
          },
          "733500309": {
            "id": "733500309",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "I'm off to write to Xavier. If he still won't come to Sumeru, then I might as well go back to Fontaine..."
          }
        }
      }
    },

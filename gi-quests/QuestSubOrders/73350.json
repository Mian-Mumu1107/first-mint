            ]
          },
          "733500416": {
            "id": "733500416",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "I'm Augustus Lovelace, a researcher from Fontaine Research Institute of Kinetic Energy Engineering."
          },
          "733500407": {
            "id": "733500407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's people everywhere.",
            "nextDialogs": [
              "733500408"
            ]
          },
          "733500408": {
            "id": "733500408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why did you ask me?"
          }
        }
      }
    },
    {
      "subId": "7335099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733509901"
        ],
        "dialogs": {
          "733509901": {
            "id": "733509901",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "(Ugh, has Xavier fallen under the spell of Inazuma? I'm certain the Yashiro Commission knows nothing about films anyway...)",
            "nextDialogs": [
              "733509902"
            ]
          },
          "733509902": {
            "id": "733509902",
            "speakerId": 1000,
            "speakerName": "Augustus Lovelace",
            "text": "(Couldn't he just slap together something for them and get out of there...?)",
            "nextDialogs": [
              "733509903"
            ]
          },
          "733509903": {
            "id": "733509903",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That should do it, let's show him the photo!"
          }
        }
      }
    }

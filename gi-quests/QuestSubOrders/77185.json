    {
      "subId": "7718501",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771850101"
        ],
        "dialogs": {
          "771850101": {
            "id": "771850101",
            "speakerId": 1002,
            "speakerName": "Anfissa",
            "text": "Heh heh... We'll be able to build a snowman soon. Isn't that so exciting, Boss???",
            "nextDialogs": [
              "771850102"
            ]
          },
          "771850102": {
            "id": "771850102",
            "speakerId": 1000,
            "speakerName": "Miroslava",
            "text": "Simmer down over there, Anfissa. Making a snowman is serious business. We need every snowball to be the exact right size to make this perfect, and we have to coordinate our efforts completely if we want the best possible result.",
            "nextDialogs": [
              "771850103"
            ]
          },
          "771850103": {
            "id": "771850103",
            "speakerId": 1000,
            "speakerName": "Miroslava",
            "text": "But the Angry Bears definitely need more hands on deck to make this happen... At the very least, we need someone who can make us the perfect snowballs..."
          }
        }
      }
    },
    {
      "subId": "7718503",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771850301"
        ],
        "dialogs": {
          "771850301": {
            "id": "771850301",
            "speakerId": 1000,
            "speakerName": "Miroslava",
            "text": "These are absolutely perfect snowballs... All they need is a decoration here and there now. I hereby name this snowman \"Big Cheese.\" From now on, Big Cheese will be a key member of the Angry Bears!",
            "nextDialogs": [
              "771850302"
            ]
          },
          "771850302": {
            "id": "771850302",
            "speakerId": 1000,
            "speakerName": "Miroslava",
            "text": "But of course, we still have another two snowmen to build... Would you like to give it a try?"
          }
        }
      }
    },
    {
      "subId": "7718505",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771850501"
        ],
        "dialogs": {
          "771850501": {
            "id": "771850501",
            "speakerId": 1000,
            "speakerName": "Miroslava",
            "text": "Krylov can decorate and name this second snowman... A personal touch or two is totally acceptable once the snowman is up to standard.",
            "nextDialogs": [
              "771850502"
            ]
          },
          "771850502": {
            "id": "771850502",
            "speakerId": 1001,
            "speakerName": "Krylov",
            "text": "Hmm... I know. I'm gonna call it \"Krylov's Number Two.\"",
            "nextDialogs": [
              "771850503"
            ]
          },
          "771850503": {
            "id": "771850503",
            "speakerId": 1000,
            "speakerName": "Miroslava",
            "text": "Um, not bad... Then the only one left would be Anfissa's. Please, if you could continue to help us, that'd be great."
          }
        }
      }
    },

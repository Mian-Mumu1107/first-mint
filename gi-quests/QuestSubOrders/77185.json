    {
      "subId": "7718501",
      "subQuestName": "Talk to Miroslava",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771850901"
        ],
        "dialogs": {
          "771850901": {
            "id": "771850901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You should know I'm a pro at making snowmen!",
            "nextDialogs": [
              "771850902"
            ]
          },
          "771850902": {
            "id": "771850902",
            "speakerId": 1000,
            "speakerName": "Miroslava",
            "text": "Oh? You sure sound like a confident grownup. Give it a try, then! And if you can give us the perfect snowballs we're looking for, I've got a reward for you!",
            "nextDialogs": [
              "771850903"
            ]
          },
          "771850903": {
            "id": "771850903",
            "speakerId": 1001,
            "speakerName": "Krylov",
            "text": "Remember, the snowballs must all be. Exactly. The. Same. Size...",
            "nextDialogs": [
              "771850904"
            ]
          },
          "771850904": {
            "id": "771850904",
            "speakerId": 1000,
            "speakerName": "Miroslava",
            "text": "Well, not exactly \"exactly,\" Krylov..."
          }
        }
      }
    },
    {
      "subId": "7718502",
      "subQuestName": "Help Miroslava build the perfect snowball",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771850201"
        ],
        "dialogs": {
          "771850201": {
            "id": "771850201",
            "speakerId": 1002,
            "speakerName": "Anfissa",
            "text": "Wow, that snowman is fire! I'm gonna call it... Hmm, I'm gonna call it the \"Super Snow Monsta\"! Let's go~~~~~",
            "nextDialogs": [
              "771850203"
            ]
          },
          "771850203": {
            "id": "771850203",
            "speakerId": 1000,
            "speakerName": "Miroslava",
            "text": "I like that name. It sounds impressive. And now our \"Snowman Squad\" is also finally complete.",
            "nextDialogs": [
              "771850204"
            ]
          },
          "771850204": {
            "id": "771850204",
            "speakerId": 1000,
            "speakerName": "Miroslava",
            "text": "Thank you. This is for you. I'd ask you to join us, but unfortunately, you're a little too old to be a member of the Angry Bears."
          }
        }
      }
    },
    {
      "subId": "7718503",

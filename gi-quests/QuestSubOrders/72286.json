    {
      "subId": "7228699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722869901"
        ],
        "dialogs": {
          "722869901": {
            "id": "722869901",
            "speakerId": 20625,
            "speakerName": "Sasano",
            "text": "You sure are straightforward.",
            "nextDialogs": [
              "722869902"
            ]
          },
          "722869902": {
            "id": "722869902",
            "speakerId": 20625,
            "speakerName": "Sasano",
            "text": "It's not like I want to make things difficult for Mr. Xavier... *sigh* Anyway, I hope you won't have to do it 11 times over like we had to."
          }
        }
      }
    }
  ]
}
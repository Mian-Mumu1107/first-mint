      }
    },
    {
      "subId": "7228606",
      "subQuestName": "Complete the \"Act I, Scene II\" film shoot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722860601"
        ],
        "dialogs": {
          "722860601": {
            "id": "722860601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm not ready yet.",
            "nextDialogs": [
              "722860602"
            ]
          },
          "722860602": {
            "id": "722860602",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "No problem at all. We still have time. Let's begin once you're ready."
          }
        }
      }
    },
    {
      "subId": "7228610",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722861001"
        ],
        "dialogs": {
          "722861001": {
            "id": "722861001",
            "speakerId": 3102,
            "speakerName": "Koharu",
            "text": "Excuse me, but did you come to oversee the filming at my master's request?",
            "nextDialogs": [
              "722861002"
            ]
          },
          "722861002": {
            "id": "722861002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It was Furuta who was a little worried about you.",
            "nextDialogs": [
              "722861003"
            ]
          },
          "722861003": {
            "id": "722861003",
            "speakerId": 3102,
            "speakerName": "Koharu",
            "text": "She was? I, uh... I guess I've not grown up enough yet if I'm still making her worry."
          }
        }
      }
    },
    {
      "subId": "7228611",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722861101"
        ],
        "dialogs": {
          "722861101": {
            "id": "722861101",
            "speakerId": 3073,
            "speakerName": "Sasano",
            "text": "This won't do. If this continues, we won't have a chance against... them.",
            "nextDialogs": [
              "722861102"
            ]
          },
          "722861102": {
            "id": "722861102",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "Smoother, Mr. Sasano, smoother!",
            "nextDialogs": [
              "722861103"
            ]
          },
          "722861103": {
            "id": "722861103",
            "speakerId": 3073,
            "speakerName": "Sasano",
            "text": "(These lines are just so awkward, though.)",
            "nextDialogs": [
              "722861104"
            ]
          },
          "722861104": {
            "id": "722861104",
            "speakerId": 3102,
            "speakerName": "Koharu",
            "text": "We'll have to sacrifice ourselves.",
            "nextDialogs": [
              "722861105"
            ]
          },
          "722861105": {
            "id": "722861105",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "With feeling, Ms. Koharu! Once more with feeling!",
            "nextDialogs": [
              "722861106"
            ]
          },
          "722861106": {
            "id": "722861106",
            "speakerId": 3102,
            "speakerName": "Koharu",
            "text": "(...)",
            "nextDialogs": [
              "722861110"
            ]
          },
          "722861110": {
            "id": "722861110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But I won't lose like this."
          }
        }
      }
    },
    {
      "subId": "7228607",
      "subQuestName": "Talk to Xavier",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722860701"
        ],
        "dialogs": {
          "722860701": {
            "id": "722860701",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "...Mr. Sasano, Ms. Koharu, I'm disappointed in both of you.",
            "nextDialogs": [
              "722860702"
            ]
          },
          "722860702": {
            "id": "722860702",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "The difference between these crude shots and a true film is like... like Mondstadt's Dandelion Wine and Apple Cider — one is alcohol, one isn't. They simply aren't the same thing.",
            "nextDialogs": [
              "722860703"
            ]
          },
          "722860703": {
            "id": "722860703",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Heavens above, I just don't even know how to describe it.",
            "nextDialogs": [
              "722860704"
            ]
          },
          "722860704": {
            "id": "722860704",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "You can't remember your lines, your readings are all over the place, and you're not giving me any emotion! How am I supposed to work with that?",
            "nextDialogs": [
              "722860705"
            ]
          },
          "722860705": {
            "id": "722860705",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "This is a crime, a crime against art. This can't go on, my friends.",
            "nextDialogs": [
              "722860706"
            ]
          },
          "722860706": {
            "id": "722860706",
            "speakerId": 3073,
            "speakerName": "Sasano",
            "text": "...",
            "nextDialogs": [
              "722860707"
            ]
          },
          "722860707": {
            "id": "722860707",
            "speakerId": 3073,
            "speakerName": "Sasano",
            "text": "I'm really sorry that you're so disappointed, but I don't plan to continue taking part in this.",
            "nextDialogs": [
              "722860708"
            ]
          },
          "722860708": {
            "id": "722860708",
            "speakerId": 3102,
            "speakerName": "Koharu",
            "text": "You can reprimand or punish me, but I'm not going to keep doing this either.",
            "nextDialogs": [
              "722860709"
            ]
          },
          "722860709": {
            "id": "722860709",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Mr. Sasano?",
            "nextDialogs": [
              "722860710"
            ]
          },
          "722860710": {
            "id": "722860710",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "I mean, I know that there have been some issues with these performances, but it's nothing a few more rehearsals can't fix!",
            "nextDialogs": [
              "722860711"
            ]
          },
          "722860711": {
            "id": "722860711",
            "speakerId": 3102,
            "speakerName": "Koharu",
            "text": "There's no need. We could practice a hundred times and I still wouldn't understand what your script is about.",
            "nextDialogs": [
              "722860712"
            ]
          },
          "722860712": {
            "id": "722860712",
            "speakerId": 3073,
            "speakerName": "Sasano",
            "text": "I share the sentiment. Why would these two characters suddenly sacrifice themselves and run off to where the enemy is?",
            "nextDialogs": [
              "722860713"
            ]
          },
          "722860713": {
            "id": "722860713",
            "speakerId": 3073,
            "speakerName": "Sasano",
            "text": "No matter how you look at it, it just doesn't make any sense. They are just dragging the main character down.",
            "nextDialogs": [
              "722860714"
            ]
          },
          "722860714": {
            "id": "722860714",
            "speakerId": 3073,
            "speakerName": "Sasano",
            "text": "And the lines at the end are so awkward I feel embarrassed just reading them.",
            "nextDialogs": [
              "722860715"
            ]
          },
          "722860715": {
            "id": "722860715",
            "speakerId": 3073,
            "speakerName": "Sasano",
            "text": "In short, I quit. Goodbye.",
            "nextDialogs": [
              "722860716"
            ]
          },
          "722860716": {
            "id": "722860716",
            "speakerId": 3102,
            "speakerName": "Koharu",
            "text": "Yup. That's that, then.",
            "nextDialogs": [
              "722860717"
            ]
          },
          "722860717": {
            "id": "722860717",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Eh? How could you...",
            "nextDialogs": [
              "722860718"
            ]
          },
          "722860718": {
            "id": "722860718",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "With Sasano and Koharu gone, we shan't have enough actors to continue filming! This is bad...",
            "nextDialogs": [
              "722860719"
            ]
          },
          "722860719": {
            "id": "722860719",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "I...",
            "nextDialogs": [
              "722860720"
            ]
          },
          "722860720": {
            "id": "722860720",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There, there. It's okay.",
            "nextDialogs": [
              "722860721"
            ]
          },
          "722860721": {
            "id": "722860721",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Ah, I am so sorry. Your efforts... I fear they shall go to waste now.",
            "nextDialogs": [
              "722860724"
            ]
          },
          "722860724": {
            "id": "722860724",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "I'm just... I confess, I'm at a loss for words. I'm going to <color=#00E1FFFF>Uyuu Restaurant</color> for a moment. I need to be alone. I'm sorry.",
            "nextDialogs": [
              "722860725"
            ]
          },
          "722860725": {
            "id": "722860725",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "We'll talk about this matter the next time we meet.",
            "nextDialogs": [
              "722860726"
            ]
          },
          "722860726": {
            "id": "722860726",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Now Xavier's gone too. Seems like he's in pretty bad shape.",
            "nextDialogs": [
              "722860727"
            ]
          },
          "722860727": {
            "id": "722860727",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He must be taking the argument they had earlier really hard. Do you think we should go cheer him up a bit?",
            "nextDialogs": [
              "722860728"
            ]
          },
          "722860728": {
            "id": "722860728",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hm... Paimon remembers him mentioning <color=#00E1FFFF>Uyuu Restaurant</color>. If you think we should go, then let's go look for him."
          }
        }
      }
    },
    {
      "subId": "7228608",
      "subQuestName": "Go to Uyuu Restaurant",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722860801"
        ],
        "dialogs": {
          "722860801": {
            "id": "722860801",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Heh, you found me. *burp*",
            "nextDialogs": [
              "722860802"
            ]
          },
          "722860802": {
            "id": "722860802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeesh, it reeks of booze around here. You're drunk, aren't you, Xavier?",
            "nextDialogs": [
              "722860804",
              "722860808"
            ]
          },
          "722860804": {
            "id": "722860804",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "D—Don't say that. It's ru... ruining the vibe! You sound like my mom. *burp* Come on, lesh drink together.",
            "nextDialogs": [
              "722860805"
            ]
          },
          "722860805": {
            "id": "722860805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe some other time.",
            "nextDialogs": [
              "722860806"
            ]
          },
          "722860806": {
            "id": "722860806",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Huh? What kinda friend are you? You're no fun.",
            "nextDialogs": [
              "722860811"
            ]
          },
          "722860811": {
            "id": "722860811",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Wasn't it just, um, right, when we were filming. I was... being questioned. Madly so! Yesh!",
            "nextDialogs": [
              "722860812"
            ]
          },
          "722860812": {
            "id": "722860812",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Actually, I don't blame Ms. Koharu. *burp* Or Mr. Sasano. They were very cooperative at first.",
            "nextDialogs": [
              "722860813"
            ]
          },
          "722860813": {
            "id": "722860813",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "That is to say, or I think that is to say, it's probably 'cause I'm, um, not that talented."
          },
          "722860808": {
            "id": "722860808",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Ooh, wait, no — I remember you saying that you wanted to give up drinking. You gotta stay on that wagon, okay?",
            "nextDialogs": [
              "722860809"
            ]
          },
          "722860809": {
            "id": "722860809",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "When did I say that...?",
            "nextDialogs": [
              "722860810"
            ]
          },
          "722860810": {
            "id": "722860810",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "It musta been in my dream."
          }
        }
      }
    },
    {
      "subId": "7228609",
      "subQuestName": "Talk to Xavier",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7228615",
      "subQuestName": "Talk to Xavier",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722861701"
        ],
        "dialogs": {
          "722861701": {
            "id": "722861701",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "*burp*",
            "nextDialogs": [
              "722861704"
            ]
          },
          "722861704": {
            "id": "722861704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aw, you're a good guy, Xavier! You're Paimon's best friend! Well... one of them, anyway!",
            "nextDialogs": [
              "722861705"
            ]
          },
          "722861705": {
            "id": "722861705",
            "speakerId": 3007,
            "speakerName": "Okazaki Rikuto",
            "text": "How was everything?",
            "nextDialogs": [
              "722861706"
            ]
          },
          "722861706": {
            "id": "722861706",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Simply divine! I could taste the lake in your rice and fish. That sweet and delicate aroma is just like what I'd have in my hometown of Petrichor.",
            "nextDialogs": [
              "722861707"
            ]
          },
          "722861707": {
            "id": "722861707",
            "speakerId": 3007,
            "speakerName": "Okazaki Rikuto",
            "text": "Haha, is that so? I'm glad you liked it.",
            "nextDialogs": [
              "722861708"
            ]
          },
          "722861708": {
            "id": "722861708",
            "speakerId": 3007,
            "speakerName": "Okazaki Rikuto",
            "text": "Now, I didn't mean to eavesdrop, but this film you mentioned sounds very interesting indeed. Could you tell me more about it, if you wouldn't mind?",
            "nextDialogs": [
              "722861709"
            ]
          },
          "722861709": {
            "id": "722861709",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "You and Xavier explain the film to Okazaki Rikuto and show him the script as well.",
            "nextDialogs": [
              "722861710"
            ]
          },
          "722861710": {
            "id": "722861710",
            "speakerId": 3007,
            "speakerName": "Okazaki Rikuto",
            "text": "Ooh, so this outlander has the resolve to stand up and fight when things get tough. Impressive.",
            "nextDialogs": [
              "722861711"
            ]
          },
          "722861711": {
            "id": "722861711",
            "speakerId": 3007,
            "speakerName": "Okazaki Rikuto",
            "text": "But to be honest, there is so little thought or hesitation involved here that this person barely seems human at all.",
            "nextDialogs": [
              "722861712"
            ]
          },
          "722861712": {
            "id": "722861712",
            "speakerId": 3007,
            "speakerName": "Okazaki Rikuto",
            "text": "When they meet an enemy they can't beat, they summon up the courage to charge anyway... and they actually triumph. That sort of daring is actually rather frightening.",
            "nextDialogs": [
              "722861713"
            ]
          },
          "722861713": {
            "id": "722861713",
            "speakerId": 3007,
            "speakerName": "Okazaki Rikuto",
            "text": "You're still young, Mr. Xavier. I take it that you've never experienced such life-threatening situations before?",
            "nextDialogs": [
              "722861714"
            ]
          },
          "722861714": {
            "id": "722861714",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Certainly not \"life-threatening,\" no. But is this the reason why my script has been criticized? Hmm...",
            "nextDialogs": [
              "722861715"
            ]
          },
          "722861715": {
            "id": "722861715",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Well, let me put it this way. Is having an identical experience first strictly necessary to writing a good story?",
            "nextDialogs": [
              "722861716"
            ]
          },
          "722861716": {
            "id": "722861716",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "From what I understand, quite a number of great authors are homebodies.",
            "nextDialogs": [
              "722861717"
            ]
          },
          "722861717": {
            "id": "722861717",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Besides, I find this no-nonsense, swords-drawn approach very Inazuma-esque.",
            "nextDialogs": [
              "722861718"
            ]
          },
          "722861718": {
            "id": "722861718",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Since I've come to Inazuma, I should make some films with that Inazuma flair.",
            "nextDialogs": [
              "722861719"
            ]
          },
          "722861719": {
            "id": "722861719",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Mr. Kayabuki's original work was also in this style, and in order to preserve these unique elements, I've decided to honor the source.",
            "nextDialogs": [
              "722861720"
            ]
          },
          "722861720": {
            "id": "722861720",
            "speakerId": 3007,
            "speakerName": "Okazaki Rikuto",
            "text": "Ah, you mean Kayabuki Ikkei? An interesting lad, to be sure.",
            "nextDialogs": [
              "722861721"
            ]
          },
          "722861721": {
            "id": "722861721",
            "speakerId": 3007,
            "speakerName": "Okazaki Rikuto",
            "text": "Xavier, I'm moved by your dedication to film. I can't help but be reminded of a story I once heard...",
            "nextDialogs": [
              "722861722"
            ]
          },
          "722861722": {
            "id": "722861722",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Ah! Sitting in a restaurant, eating, and listening to stories like this is also so... so Inazuma! I love it."
          }
        }
      }
    },
    {
      "subId": "7228616",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722861601"
        ],
        "dialogs": {
          "722861601": {
            "id": "722861601",
            "speakerId": 3007,
            "speakerName": "Okazaki Rikuto",
            "text": "We're honored that you appreciate Erika's work so much. It's only right that we extend our opening hours for you.",
            "nextDialogs": [
              "722861602"
            ]
          },
          "722861602": {
            "id": "722861602",
            "speakerId": 3007,
            "speakerName": "Okazaki Rikuto",
            "text": "After you leave, we'll tidy up a little, then have Erika go take a rest."
          }
        }
      }
    },
    {
      "subId": "7228614",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722861401"
        ],
        "dialogs": {
          "722861401": {
            "id": "722861401",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "The story is quite complete, but it's lacking some emotional turmoil. Hmm...",
            "nextDialogs": [
              "722861404"
            ]
          },
          "722861404": {
            "id": "722861404",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "Heavens forgive me, I'm a real souse this morning, I am. I left my friend in the restaurant after completely forgetting about them!",
            "nextDialogs": [
              "722861405"
            ]
          },
          "722861405": {
            "id": "722861405",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "But I think I can now write an all-new, presentable script and give this one more shot. It'll definitely work this time. No, I'll make it work.",
            "nextDialogs": [
              "722861406"
            ]
          },
          "722861406": {
            "id": "722861406",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "Please allow me a little more time. Just one day will suffice.",
            "nextDialogs": [
              "722861407"
            ]
          },
          "722861407": {
            "id": "722861407",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "*sigh*... But it's going to be tricky with those two actors. Ms. Koharu and Mr. Sasano don't seem keen on trying again.",
            "nextDialogs": [
              "722861408"
            ]
          },
          "722861408": {
            "id": "722861408",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "But I can't blame them either. I'll just have to think of something when the time comes.",
            "nextDialogs": [
              "722861409"
            ]
          },
          "722861409": {
            "id": "722861409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Can I help in any way?",
            "nextDialogs": [
              "722861410"
            ]
          },
          "722861410": {
            "id": "722861410",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "No, no, no, I couldn't ask for anything more comforting than having you here to listen to me vent.",
            "nextDialogs": [
              "722861411"
            ]
          },
          "722861411": {
            "id": "722861411",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "#My dear {NICKNAME}, you are indeed a great listener.",
            "nextDialogs": [
              "722861412"
            ]
          },
          "722861412": {
            "id": "722861412",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "Ms. Paimon, if my behavior was at all untoward just now, can you forgive me? I didn't mean you any offense.",
            "nextDialogs": [
              "722861413"
            ]
          },
          "722861413": {
            "id": "722861413",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh? \"Ms. Paimon\"... That has a nice ring to it! Alright then, the magnanimous Paimon has decided to forgive you.",
            "nextDialogs": [
              "722861414"
            ]
          },
          "722861414": {
            "id": "722861414",
            "speakerId": 20624,
            "speakerName": "Xavier",
            "text": "Wonderful! I feel much better now. Let's meet tomorrow at <color=#00E1FFFF>Komore Teahouse</color>. I'll bring an even better script, you'll see!",
            "nextDialogs": [
              "722861415"
            ]
          },
          "722861415": {
            "id": "722861415",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's great that he's so motivated, but it's like Mr. Okazaki said... Is it really okay for him to do it all by himself?",
            "nextDialogs": [
              "722861416"
            ]
          },
          "722861416": {
            "id": "722861416",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He says he's gonna write a brand-new script in one day. That's a scary big job, isn't it?",
            "nextDialogs": [
              "722861417"
            ]
          },
          "722861417": {
            "id": "722861417",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'd like to help him.",
            "nextDialogs": [
              "722861418"
            ]
          },
          "722861418": {
            "id": "722861418",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, maybe you should let Xavier work out the script by himself. Paimon thinks we can help him with his actor problem instead.",
            "nextDialogs": [
              "722861419"
            ]
          },
          "722861419": {
            "id": "722861419",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll go talk to the actors.",
            "nextDialogs": [
              "722861420"
            ]
          },
          "722861420": {
            "id": "722861420",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, that should take a load off his back."
          }
        }
      }
    },

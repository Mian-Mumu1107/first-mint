    {
      "subId": "7228604",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722860401"
        ],
        "dialogs": {
          "722860401": {
            "id": "722860401",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Well, if you're ready, we can go ahead and begin a test shot."
          }
        }
      }

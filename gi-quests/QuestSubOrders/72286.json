  "subQuests": [
    {
      "subId": "7228601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722860101"
        ],
        "dialogs": {
          "722860101": {
            "id": "722860101",
            "speakerId": 3101,
            "speakerName": "Furuta",
            "text": "Oh, hello. It's been a while since I saw you last.",
            "nextDialogs": [
              "722860103",
              "722860105"
            ]
          },
          "722860103": {
            "id": "722860103",
            "speakerId": 3101,
            "speakerName": "Furuta",
            "text": "Is that so? I must be getting on in years. My memory just isn't what it used to be.",
            "nextDialogs": [
              "722860106"
            ]
          },
          "722860106": {
            "id": "722860106",
            "speakerId": 3101,
            "speakerName": "Furuta",
            "text": "Ah me! Not only is my memory like a sieve, but I'm finding myself more and more puzzled by what the younger folk are interested in.",
            "nextDialogs": [
              "722860107"
            ]
          },
          "722860107": {
            "id": "722860107",
            "speakerId": 3101,
            "speakerName": "Furuta",
            "text": "Before, a young'un from Fontaine came here, saying that he was making a \"film,\" and chatted on and on with the master of the house.",
            "nextDialogs": [
              "722860108"
            ]
          },
          "722860108": {
            "id": "722860108",
            "speakerId": 3101,
            "speakerName": "Furuta",
            "text": "Goodness, and he kept saying, um... \"Dear.\" Throwing around a word like that all willy-nilly, does he have no shame?"
          },
          "722860105": {
            "id": "722860105",
            "speakerId": 3101,
            "speakerName": "Furuta",
            "text": "Haha, I knew it. Now, I may be getting on in years and losing my memory, but at least I didn't forget that."
          }
        }
      }
    },
    {
      "subId": "7228602",
      "subQuestName": "Look for Xavier",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7228603",
      "subQuestName": "Learn about the progress of Xavier's film shoot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722860301"
        ],
        "dialogs": {
          "722860301": {
            "id": "722860301",
            "speakerId": 3073,
            "speakerName": "Sasano",
            "text": "This is the 11th time. I just don't get it.",
            "nextDialogs": [
              "722860302"
            ]
          },
          "722860302": {
            "id": "722860302",
            "speakerId": 3102,
            "speakerName": "Koharu",
            "text": "Ugh... Just say it. What was the problem this time?",
            "nextDialogs": [
              "722860303"
            ]
          },
          "722860303": {
            "id": "722860303",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "The problem this time, Ms. Koharu, is that your performance just now was completely passionless.",
            "nextDialogs": [
              "722860304"
            ]
          },
          "722860304": {
            "id": "722860304",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "When I wrote those lines, my heart was bursting with an... an empty yet fervent passion, yes, empty yet fervent.",
            "nextDialogs": [
              "722860305"
            ]
          },
          "722860305": {
            "id": "722860305",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "I need you to be more patient. Use your voice to express this rich emotion.",
            "nextDialogs": [
              "722860306"
            ]
          },
          "722860306": {
            "id": "722860306",
            "speakerId": 3102,
            "speakerName": "Koharu",
            "text": "Huh? An \"empty yet fervent passion\"? What does that even mean?",
            "nextDialogs": [
              "722860307"
            ]
          },
          "722860307": {
            "id": "722860307",
            "speakerId": 3073,
            "speakerName": "Sasano",
            "text": "Wait a minute, didn't the casting call say that the script was written by a famous writer?",
            "nextDialogs": [
              "722860308"
            ]
          },
          "722860308": {
            "id": "722860308",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "That's absolutely right! This story was adapted from a novel written by the renowned author Kayabuki Ikkei. And who adapted it, you might ask? None other than myself.",
            "nextDialogs": [
              "722860309"
            ]
          },
          "722860309": {
            "id": "722860309",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Ms. Koharu, Mr. Sasano, I am very sorry for making you both go over this so many times.",
            "nextDialogs": [
              "722860310"
            ]
          },
          "722860310": {
            "id": "722860310",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "But it's all worth it for the sake of artistic perfection. As such, I hope that...",
            "nextDialogs": [
              "722860311"
            ]
          },
          "722860311": {
            "id": "722860311",
            "speakerId": 3073,
            "speakerName": "Sasano",
            "text": "Hold on, I only know one Kayabuki Ikkei, and everything he submitted to the Yae Publishing House always got rejected.",
            "nextDialogs": [
              "722860312"
            ]
          },
          "722860312": {
            "id": "722860312",
            "speakerId": 3073,
            "speakerName": "Sasano",
            "text": "But he wouldn't accept that, so he started publishing his own novels, but not a single one sold in the end.",
            "nextDialogs": [
              "722860313"
            ]
          },
          "722860313": {
            "id": "722860313",
            "speakerId": 3073,
            "speakerName": "Sasano",
            "text": "Don't tell me that we've been put through the wringer 11 times for something that guy wrote?",
            "nextDialogs": [
              "722860314"
            ]
          },
          "722860314": {
            "id": "722860314",
            "speakerId": 3102,
            "speakerName": "Koharu",
            "text": "Argh! I've had enough of this nonsense!",
            "nextDialogs": [
              "722860315"
            ]
          },
          "722860315": {
            "id": "722860315",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Err, that doesn't look good. Seems like Koharu's seconds away from flying off the handle.",
            "nextDialogs": [
              "722860316"
            ]
          },
          "722860316": {
            "id": "722860316",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's go say hello.",
            "nextDialogs": [
              "722860317"
            ]
          },
          "722860317": {
            "id": "722860317",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um... So, Xavier, are you guys filming?",
            "nextDialogs": [
              "722860318"
            ]
          },
          "722860318": {
            "id": "722860318",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Long time no see.",
            "nextDialogs": [
              "722860319"
            ]
          },
          "722860319": {
            "id": "722860319",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "#Oh, {NICKNAME} and Paimon, my dear friends! How marvelous it is to see familiar faces at a time like this.",
            "nextDialogs": [
              "722860320"
            ]
          },
          "722860320": {
            "id": "722860320",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "As you can see, following \"The Seventh Samurai,\" I finally came up with a way to secure the necessary resources to shoot another film.",
            "nextDialogs": [
              "722860321"
            ]
          },
          "722860321": {
            "id": "722860321",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "The lead role hasn't been decided yet, but thanks to Lord Kamisato's generosity, the funds, props, and nearly all the other early-stage problems have already been taken care of.",
            "nextDialogs": [
              "722860322"
            ]
          },
          "722860322": {
            "id": "722860322",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "If you don't mind, could I ask if you maybe, possibly, at all remember our agreement from before?",
            "nextDialogs": [
              "722860327",
              "722860325"
            ]
          },
          "722860327": {
            "id": "722860327",
            "speakerId": 3102,
            "speakerName": "Koharu",
            "text": "#Eh, {NICKNAME}'s a friend of the Yashiro Commissioner. So you all know each other?",
            "nextDialogs": [
              "722860328"
            ]
          },
          "722860328": {
            "id": "722860328",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "#That's right, {NICKNAME} was the first friend I made in Inazuma. The Fatui who dumped a bunch of work on me and those non-communicative samurai don't count.",
            "nextDialogs": [
              "722860329"
            ]
          },
          "722860329": {
            "id": "722860329",
            "speakerId": 3102,
            "speakerName": "Koharu",
            "text": "#If you made friends with {NICKNAME}, I guess you can't be all bad.",
            "nextDialogs": [
              "722860330"
            ]
          },
          "722860330": {
            "id": "722860330",
            "speakerId": 3073,
            "speakerName": "Sasano",
            "text": "Well, it seems like Xavier's got some chops after all...",
            "nextDialogs": [
              "722860331"
            ]
          },
          "722860331": {
            "id": "722860331",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're very good friends.",
            "nextDialogs": [
              "722860332"
            ]
          },
          "722860332": {
            "id": "722860332",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "You really think so? Even though I've never said so, I for my part have considered you a true friend right from the start.",
            "nextDialogs": [
              "722860333"
            ]
          },
          "722860333": {
            "id": "722860333",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "You aren't just my \"dear friend,\" you're my esteemed, reliable, true friend."
          },
          "722860325": {
            "id": "722860325",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Ah, of course, of course — it's already been a long time since then, after all. You must've had many other important matters to take care of, so it's completely understandable that our first meeting didn't leave an impression.",
            "nextDialogs": [
              "722860326"
            ]
          },
          "722860326": {
            "id": "722860326",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Don't worry, I'm not surprised or disappointed. Really."
          }
        }
      }
    },
    {
      "subId": "7228604",
      "subQuestName": "Talk to Xavier to begin the shoot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722860501"
        ],
        "dialogs": {
          "722860501": {
            "id": "722860501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm ready.",
            "nextDialogs": [
              "722860502"
            ]
          },
          "722860502": {
            "id": "722860502",
            "speakerId": 3162,
            "speakerName": "Xavier",
            "text": "Good, good! Then let's begin."
          }
        }
      }
    },
    {
      "subId": "7228605",
      "subQuestName": "Complete the \"Act I, Scene II\" film shoot",
      "sceneId": null,
      "locations": [],

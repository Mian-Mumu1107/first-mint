  "subQuests": [
    {
      "subId": "7900010",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "680020501"
        ],
        "dialogs": {
          "680020501": {
            "id": "680020501",
            "speakerId": 1000,
            "speakerName": "Echoing Conch",
            "text": "\"The tides are getting higher by the year. If the water level rises much further, we will stand very little chance of survival...\"",
            "nextDialogs": [
              "680020502"
            ]
          },
          "680020502": {
            "id": "680020502",
            "speakerId": 1000,
            "speakerName": "Echoing Conch",
            "text": "\"There's no other choice. I must tell everyone to pack up their belongings and move to higher ground.\"",
            "nextDialogs": [
              "680020503"
            ]
          },
          "680020503": {
            "id": "680020503",
            "speakerId": 1000,
            "speakerName": "Echoing Conch",
            "text": "\"Mother!\"",
            "nextDialogs": [
              "680020504"
            ]
          },
          "680020504": {
            "id": "680020504",
            "speakerId": 1000,
            "speakerName": "Echoing Conch",
            "text": "\"What's wrong?\"",
            "nextDialogs": [
              "680020505"
            ]
          },
          "680020505": {
            "id": "680020505",
            "speakerId": 1000,
            "speakerName": "Echoing Conch",
            "text": "\"The tide reached us, so I told everyone to run and get to higher ground. But the family heirloom — I'm sorry... It was a choice between that and getting everyone to safety, so I... I didn't have enough time to get it.\"",
            "nextDialogs": [
              "680020506"
            ]
          },
          "680020506": {
            "id": "680020506",
            "speakerId": 1000,
            "speakerName": "Echoing Conch",
            "text": "\"It's right in <color=#37FFFF>the center of the island</color>. If the water recedes sometime, or if someone gets in from outside, we'll just have to get them to find it for us.\""
          }
        }
      }
    },

    {
      "subId": "7900006",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790000401"
        ],
        "dialogs": {
          "790000401": {
            "id": "790000401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Found it! Treasure, treasure... Wonder what'll we find inside...",
            "nextDialogs": [
              "790000402"
            ]
          },
          "790000402": {
            "id": "790000402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? There's a lock on it. And it's coded, too... Looks like we'll need the code to open it...",
            "nextDialogs": [
              "790000405",
              "790000407"
            ]
          },
          "790000405": {
            "id": "790000405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait! What will happen if the stuff inside breaks as well?",
            "nextDialogs": [
              "790000406"
            ]
          },
          "790000406": {
            "id": "790000406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's find a way to unlock it instead, shall we?",
            "nextDialogs": [
              "790000410"
            ]
          },
          "790000410": {
            "id": "790000410",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But since this chest contains \"family heirlooms\" and is locked using a code...",
            "nextDialogs": [
              "790000411"
            ]
          },
          "790000411": {
            "id": "790000411",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's gotta mean that the person who locked it thinks that the code they left behind is easy enough to remember.",
            "nextDialogs": [
              "790000412"
            ]
          },
          "790000412": {
            "id": "790000412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like our only chance are those conches that store sounds.",
            "nextDialogs": [
              "790000413"
            ]
          },
          "790000413": {
            "id": "790000413",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's listen to the sounds inside those conches again. Let's hope that they can give us some clues about the code..."
          },
          "790000407": {
            "id": "790000407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But Paimon doesn't see any stone tablets, potraits, notes, carvings or notes nearby...",
            "nextDialogs": [
              "790000408"
            ]
          },
          "790000408": {
            "id": "790000408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's a dearth of scholars, Treasure Hoarders, and adventurers, too.",
            "nextDialogs": [
              "790000409"
            ]
          },
          "790000409": {
            "id": "790000409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah. Hmm... This is an unprecedented test!"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2200201",
      "subQuestName": "Talk to Little Lulu, Little Fei, and Little Meng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220020101"
        ],
        "dialogs": {
          "220020101": {
            "id": "220020101",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Lulu, how come I'm the captain again?",
            "nextDialogs": [
              "220020102"
            ]
          },
          "220020102": {
            "id": "220020102",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Because it's way more fun when you're the captain.",
            "nextDialogs": [
              "220020103"
            ]
          },
          "220020103": {
            "id": "220020103",
            "speakerId": 1002,
            "speakerName": "Little Fei",
            "text": "Well, as long as Lulu's happy... then I'm fine with it.",
            "nextDialogs": [
              "220020104"
            ]
          },
          "220020104": {
            "id": "220020104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "220020105"
            ]
          },
          "220020105": {
            "id": "220020105",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "We're playing a game!",
            "nextDialogs": [
              "220020106"
            ]
          },
          "220020106": {
            "id": "220020106",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Meng is the captain, Fei is first mate and I'm a rich merchant.",
            "nextDialogs": [
              "220020107"
            ]
          },
          "220020107": {
            "id": "220020107",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "All we're missing is the pirate. The pirate's supposed to come and rob us.",
            "nextDialogs": [
              "220020108"
            ]
          },
          "220020108": {
            "id": "220020108",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "You can be the pirate if you wanna play with us?",
            "nextDialogs": [
              "220020110",
              "220020112"
            ]
          },
          "220020110": {
            "id": "220020110",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Yay!",
            "nextDialogs": [
              "220020113"
            ]
          },
          "220020113": {
            "id": "220020113",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Okay, come and let us know when you're ready."
          },
          "220020112": {
            "id": "220020112",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "It's just a game! Don't worry, I know you're a good person in real life."
          }
        }
      }
    },
    {
      "subId": "2200202",
      "subQuestName": "Talk to \"rich merchant\" Little Lulu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220020201"
        ],
        "dialogs": {
          "220020201": {
            "id": "220020201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm ready.",
            "nextDialogs": [
              "220020202"
            ]
          },
          "220020202": {
            "id": "220020202",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Woohoo! We're starting!",
            "nextDialogs": [
              "220020203"
            ]
          },
          "220020203": {
            "id": "220020203",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "You have to start.",
            "nextDialogs": [
              "220020204"
            ]
          },
          "220020204": {
            "id": "220020204",
            "speakerId": 1003,
            "speakerName": "<UNKNOWN>",
            "text": "Avast ye! I be here to rob yer!",
            "nextDialogs": [
              "220020205"
            ]
          },
          "220020205": {
            "id": "220020205",
            "speakerId": 1000,
            "speakerName": "Little Meng",
            "text": "Hah! In broad daylight? Good luck, the Millelith men are right there watching!",
            "nextDialogs": [
              "220020206"
            ]
          },
          "220020206": {
            "id": "220020206",
            "speakerId": 1002,
            "speakerName": "Little Fei",
            "text": "Lulu, come quickly! We must escape...",
            "nextDialogs": [
              "220020207"
            ]
          },
          "220020207": {
            "id": "220020207",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Hello Mr. Pirate. What are you here to rob?",
            "nextDialogs": [
              "220020208"
            ]
          },
          "220020208": {
            "id": "220020208",
            "speakerId": 1003,
            "speakerName": "<UNKNOWN>",
            "text": "Er... Mora? ...Ar!",
            "nextDialogs": [
              "220020212"
            ]
          },
          "220020212": {
            "id": "220020212",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "But I don't have much Mora...",
            "nextDialogs": [
              "220020213"
            ]
          },
          "220020213": {
            "id": "220020213",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Daddy says that on a boat, the most valuable thing is the merchants' goods.",
            "nextDialogs": [
              "220020214"
            ]
          },
          "220020214": {
            "id": "220020214",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "How about this. Why don't you go and find some valuable things to use in the game?",
            "nextDialogs": [
              "220020215"
            ]
          },
          "220020215": {
            "id": "220020215",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Then we'll have goods for you to try and steal!",
            "nextDialogs": [
              "220020216"
            ]
          },
          "220020216": {
            "id": "220020216",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Hmm... Lotus Heads will do.",
            "nextDialogs": [
              "220020217"
            ]
          },
          "220020217": {
            "id": "220020217",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "We three all love eating Lotus Heads. If you're being a naughty pirate, the naughtiest thing you could do is steal our favorite food!"
          }
        }
      }
    },
    {
      "subId": "2200203",
      "subQuestName": "Find Lotus Head",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220020301"
        ],
        "dialogs": {
          "220020301": {
            "id": "220020301",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Have you found the Lotus Heads yet?",
            "nextDialogs": [
              "220020302"
            ]
          },
          "220020302": {
            "id": "220020302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got them.",
            "nextDialogs": [
              "220020303"
            ]
          },
          "220020303": {
            "id": "220020303",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Yay!",
            "nextDialogs": [
              "220020304"
            ]
          },
          "220020304": {
            "id": "220020304",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Meng! Fei! Come and eat these Lotus Heads with me!",
            "nextDialogs": [
              "220020305"
            ]
          },
          "220020305": {
            "id": "220020305",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Hey! Paimon thought we were supposed to be robbing you?",
            "nextDialogs": [
              "220020306"
            ]
          },
          "220020306": {
            "id": "220020306",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Oh, yeah... Well here you are, take this Mora and stuff.",
            "nextDialogs": [
              "220020307"
            ]
          },
          "220020307": {
            "id": "220020307",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "You're really great at playing a pirate. Not everyone has what it takes to steal all this stuff from a little kid.",
            "nextDialogs": [
              "220020308"
            ]
          },
          "220020308": {
            "id": "220020308",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Paimon has a feeling that this kid is subtly mocking us...",
            "nextDialogs": [
              "220020309"
            ]
          },
          "220020309": {
            "id": "220020309",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Thanks for your help and it was fun playing with you. Please play with us again soon!"
          }
        }
      }
    },
    {

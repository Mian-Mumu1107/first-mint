        ],
        "dialogs": {
          "220020501": {
            "id": "220020501",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Found the Lotus Heads?",
            "nextDialogs": [
              "220020502"
            ]
          },
          "220020502": {
            "id": "220020502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet.",
            "nextDialogs": [
              "220020503"
            ]
          },
          "220020503": {
            "id": "220020503",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "Okay, just keep looking. Take your time... but hopefully not too much time.",
            "nextDialogs": [
              "220020504"
            ]
          },
          "220020504": {
            "id": "220020504",
            "speakerId": 1001,
            "speakerName": "Little Lulu",
            "text": "We've been playing for ages, I'm getting hungry now..."
          }
        }
      }
    }

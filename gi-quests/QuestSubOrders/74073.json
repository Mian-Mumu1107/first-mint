            ]
          },
          "740732303": {
            "id": "740732303",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Looks that way.",
            "nextDialogs": [
              "740732304"
            ]
          },
          "740732304": {
            "id": "740732304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just who is...?",
            "nextDialogs": [
              "740732305"
            ]
          },
          "740732305": {
            "id": "740732305",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "It's Jakob.",
            "nextDialogs": [
              "740732306"
            ]
          },
          "740732306": {
            "id": "740732306",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "We had an altercation with him inside Elynas once... Clarification: Recently, not \"once.\"",
            "nextDialogs": [
              "740732307"
            ]
          },
          "740732307": {
            "id": "740732307",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "When I saw that unfortunate victim at the gate, I knew it was his handiwork. It seems he's still active after all.",
            "nextDialogs": [
              "740732308"
            ]
          },

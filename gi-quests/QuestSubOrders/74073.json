    {
      "subId": "7407308",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740733201"
        ],
        "dialogs": {
          "740733201": {
            "id": "740733201",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You carefully inspect the top of the mechanism, but you don't find anything.",
            "nextDialogs": [
              "740733202"
            ]
          },
          "740733202": {
            "id": "740733202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's nothing here?",
            "nextDialogs": [
              "740733203"
            ]
          },
          "740733203": {
            "id": "740733203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no! It looks like someone already took whatever was here.",
            "nextDialogs": [
              "740733204"
            ]
          },
          "740733204": {
            "id": "740733204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But who?"
          }
        }
      }
    },
    {
      "subId": "7407305",
      "subQuestName": "Obtain the \"Memory\" piece",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740732101"
        ],
        "dialogs": {
          "740732101": {
            "id": "740732101",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You carefully inspect the top of the mechanism, but you don't find anything.",
            "nextDialogs": [
              "740732102"
            ]
          },
          "740732102": {
            "id": "740732102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's nothing here?",
            "nextDialogs": [
              "740732103"
            ]
          },
          "740732103": {
            "id": "740732103",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "It looks like something was here, but someone else took it.",
            "nextDialogs": [
              "740732104"
            ]
          },
          "740732104": {
            "id": "740732104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, doesn't that mean that our plan's already failed?",
            "nextDialogs": [
              "740732105"
            ]
          },
          "740732105": {
            "id": "740732105",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "The birth of \"Reason\" requires the merging of the four Orthants. If we can get the rest of them, we still have a chance.",
            "nextDialogs": [
              "740732106"
            ]
          },
          "740732106": {
            "id": "740732106",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "In that case, we'd better hurry to the next area."
          }
        }
      }
    },
    {
      "subId": "7407303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740730301"
        ],
        "dialogs": {
          "740730301": {
            "id": "740730301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oceanid tears.",
            "nextDialogs": [
              "740730302"
            ]
          },
          "740730302": {
            "id": "740730302",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "I'll just pretend you tried to say something romantic.",
            "nextDialogs": [
              "740730303"
            ]
          },
          "740730303": {
            "id": "740730303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's obviously not the right answer.",
            "nextDialogs": [
              "740730304"
            ]
          },
          "740730304": {
            "id": "740730304",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "#What do you think the answer is, Knight {NICKNAME}?"
          }
        }
      }
    },
    {
      "subId": "7407305",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740730501"
        ],
        "dialogs": {
          "740730501": {
            "id": "740730501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like someone was just here. Did they already figure out the little mechanism up ahead?",
            "nextDialogs": [
              "740730502"
            ]
          },
          "740730502": {
            "id": "740730502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's a bonfire that's still burning over there on the ground.",
            "nextDialogs": [
              "740730503"
            ]
          },
          "740730503": {
            "id": "740730503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, why is there a bonfire in a place like this?",
            "nextDialogs": [
              "740730504"
            ]
          },
          "740730504": {
            "id": "740730504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let me see what's written on the stone tablet.",
            "nextDialogs": [
              "740730505"
            ]
          },
          "740730505": {
            "id": "740730505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Lo, this place is the Or... Orth...\"",
            "nextDialogs": [
              "740730506"
            ]
          },
          "740730506": {
            "id": "740730506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Orthant.",
            "nextDialogs": [
              "740730507"
            ]
          },
          "740730507": {
            "id": "740730507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"...Orthant of Memory, the Hall of Memory, the Room of Memory...\"",
            "nextDialogs": [
              "740730508"
            ]
          },
          "740730508": {
            "id": "740730508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Born in an instant\"... \"Often contradicting, your company in eternal rest, never separated\"... \"Fire cannot burn it\"...",
            "nextDialogs": [
              "740730509"
            ]
          },
          "740730509": {
            "id": "740730509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A riddle, eh?",
            "nextDialogs": [
              "740730510"
            ]
          },
          "740730510": {
            "id": "740730510",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The answer has gotta be fire! There's a bonfire nearby.",
            "nextDialogs": [
              "740730511"
            ]
          },
          "740730511": {
            "id": "740730511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just what kind of riddle contains its own answer...",
            "nextDialogs": [
              "740730512"
            ]
          },
          "740730512": {
            "id": "740730512",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, that's right! What do you think it is, then?"
          }
        }
      }
    },
    {
      "subId": "7407322",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740732201"
        ],
        "dialogs": {
          "740732201": {
            "id": "740732201",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You carefully inspect the top of the mechanism, but you don't find anything.",
            "nextDialogs": [
              "740732202"
            ]
          },
          "740732202": {
            "id": "740732202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's nothing here either...",
            "nextDialogs": [
              "740732203"
            ]
          },
          "740732203": {
            "id": "740732203",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "What exactly are we looking for, Caterpillar?",
            "nextDialogs": [
              "740732204"
            ]
          },
          "740732204": {
            "id": "740732204",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "We're looking for the materials necessary to forge the Holy Blade of Narzissenkreuz.",
            "nextDialogs": [
              "740732205"
            ]
          },
          "740732205": {
            "id": "740732205",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "The Ordo was able to reproduce the four requisite hypothetical substances here in the material world, based on the esoteric philosophies of the underground kingdom and ancient Fontaine.",
            "nextDialogs": [
              "740732206"
            ]
          },
          "740732206": {
            "id": "740732206",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "I do not understand.",
            "nextDialogs": [
              "740732207"
            ]
          },
          "740732207": {
            "id": "740732207",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "These enigmatic substances are purely experiential. You could say they are even further beyond ordinary logic than elemental power.",
            "nextDialogs": [
              "740732208"
            ]
          },
          "740732208": {
            "id": "740732208",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "I entered all introductory to intermediate level textbooks from the Akademiya's Spantamad into my memory banks decades ago. There is nothing mysterious about elemental power.",
            "nextDialogs": [
              "740732209"
            ]
          },
          "740732209": {
            "id": "740732209",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Is that so? Anyway, to sum up, this is born of the confluence of traditions from Fontaine and technology from the ancient underground kingdom.",
            "nextDialogs": [
              "740732210"
            ]
          },
          "740732210": {
            "id": "740732210",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "And thus, four types of substance came into being: Memory, Wish, Soul, and Persona.",
            "nextDialogs": [
              "740732211"
            ]
          },
          "740732211": {
            "id": "740732211",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "To avoid any possible ambiguity, let's call them the \"Memory\" piece, \"Wish\" piece, \"Soul\" piece, and \"Persona\" piece.",
            "nextDialogs": [
              "740732212"
            ]
          },
          "740732212": {
            "id": "740732212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why are these used to make the Holy Blade?",
            "nextDialogs": [
              "740732213"
            ]
          },
          "740732213": {
            "id": "740732213",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "In the Narzissenkreuz Ordo's brand of mystical philosophy, the temple is a microcosm of the universe, the members are stand-ins for the gods, and the holy oil is tempered willpower.",
            "nextDialogs": [
              "740732214"
            ]
          },
          "740732214": {
            "id": "740732214",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "The Holy Blade, on the other hand, is \"reason,\" that which cuts everything open. It can only be born out of consummate human will.",
            "nextDialogs": [
              "740732215"
            ]
          },
          "740732215": {
            "id": "740732215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Quite abstruse.",
            "nextDialogs": [
              "740732216"
            ]
          },
          "740732216": {
            "id": "740732216",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "That's esotericism for you. If it looks similar enough, you can latch onto it, and when this kind of thing becomes magic, fiction becomes reality.",
            "nextDialogs": [
              "740732217"
            ]
          },
          "740732217": {
            "id": "740732217",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Anyway, we should make our way to the next area now."
          }
        }
      }
    },
    {
      "subId": "7407323",

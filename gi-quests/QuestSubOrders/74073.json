  "subQuests": [
    {
      "subId": "7407301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740730101"
        ],
        "dialogs": {
          "740730101": {
            "id": "740730101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The bonfire is still burning. Wait, why is there a bonfire here? This is just a ruin...",
            "nextDialogs": [
              "740730102"
            ]
          },
          "740730102": {
            "id": "740730102",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "Let me see what's written on the stone tablet.",
            "nextDialogs": [
              "740730103"
            ]
          },
          "740730103": {
            "id": "740730103",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "\"Lo, this place is the Orthant of Memory, the Hall of Memory, the Room of Memory.\"",
            "nextDialogs": [
              "740730104"
            ]
          },
          "740730104": {
            "id": "740730104",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "\"Born in an instant\"... \"Often contradicting, your company in eternal rest, never separated\"... \"Fire cannot burn it\"...",
            "nextDialogs": [
              "740730105"
            ]
          },
          "740730105": {
            "id": "740730105",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Riddles, huh? Ancient Fontainian civilization loved them, and the Narzissenkreuz Ordo enjoyed them too. I'm not sure if they were just into old stuff, or if this was genuine interest.",
            "nextDialogs": [
              "740730106"
            ]
          },
          "740730106": {
            "id": "740730106",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "I have already tried keyword searches on all of them, but have found no answers.",
            "nextDialogs": [
              "740730107"
            ]
          },
          "740730107": {
            "id": "740730107",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "But this riddle has already been solved. Maybe the answer has something to do with the bonfire.",
            "nextDialogs": [
              "740730108"
            ]
          },
          "740730108": {
            "id": "740730108",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "Is there any point in thinking about riddles that have already been solved?",
            "nextDialogs": [
              "740730109"
            ]
          },
          "740730109": {
            "id": "740730109",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Yes, there is. Just like you and I are both like this now, but we must still search out what happened in the past.",
            "nextDialogs": [
              "740730110"
            ]
          },
          "740730110": {
            "id": "740730110",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "You've got a point.",
            "nextDialogs": [
              "740730111"
            ]
          },
          "740730111": {
            "id": "740730111",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "#What do you think the answer is, Knight {NICKNAME}?"
          }
        }
      }
    },
    {
      "subId": "7407302",
      "subQuestName": "Find the Seal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740730201"
        ],
        "dialogs": {
          "740730201": {
            "id": "740730201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Products of lithiasis. Y'know, like kidney stones and such.",
            "nextDialogs": [
              "740730202"
            ]
          },
          "740730202": {
            "id": "740730202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's true that fires don't destroy them, and they stay within our organs and tissues... But they aren't born in an instant, right?",
            "nextDialogs": [
              "740730203"
            ]
          },
          "740730203": {
            "id": "740730203",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "They are formed by unhealthy dietary habits over a long period of time, Ms. Paimon.",
            "nextDialogs": [
              "740730204"
            ]
          },
          "740730204": {
            "id": "740730204",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "#What do you think the answer is, Knight {NICKNAME}?"
          }
        }
      }
    },
    {
      "subId": "7407307",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740730701"
        ],
        "dialogs": {
          "740730701": {
            "id": "740730701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Shadows.",
            "nextDialogs": [
              "740730702"
            ]
          },
          "740730702": {
            "id": "740730702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, shadows does seem like the right answer! They are with us for our entire lives, and can't be burned by fire.",
            "nextDialogs": [
              "740730703"
            ]
          },
          "740730703": {
            "id": "740730703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But what's the point in figuring out the answer to a riddle that's already been solved?"
          }
        }
      }
    },
    {
      "subId": "7407303",
      "subQuestName": "Study the Riddle Slate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740730401"
        ],
        "dialogs": {
          "740730401": {
            "id": "740730401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Shadows.",
            "nextDialogs": [
              "740730402"
            ]
          },
          "740730402": {
            "id": "740730402",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Yes, shadows.",
            "nextDialogs": [
              "740730403"
            ]
          },
          "740730403": {
            "id": "740730403",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "The instant a beam of light shines, a shadow is born.",
            "nextDialogs": [
              "740730404"
            ]
          },
          "740730404": {
            "id": "740730404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We know the answer, but someone's already opened the door. So, what do we do now?",
            "nextDialogs": [
              "740730405"
            ]
          },
          "740730405": {
            "id": "740730405",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "We go inside now, of course. It's a race against time to see if we can find what we're looking for before the person who solved the riddle before us does."
          }
        }
      }
    },

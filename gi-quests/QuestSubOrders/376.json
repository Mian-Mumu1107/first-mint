    {
      "subId": "37603",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3760301"
        ],
        "dialogs": {
          "3760301": {
            "id": "3760301",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "I say we make a run for the tavern.",
            "nextDialogs": [
              "3760302"
            ]
          },
          "3760302": {
            "id": "3760302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why would we wanna do that!?",
            "nextDialogs": [
              "3760303"
            ]
          },
          "3760303": {
            "id": "3760303",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "We can blend in with the crowd of drinkers.",
            "nextDialogs": [
              "3760304"
            ]
          },
          "3760304": {
            "id": "3760304",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Also, in all the commotion my wandering hands would go unnoticed.",
            "nextDialogs": [
              "3760305"
            ]
          },
          "3760305": {
            "id": "3760305",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You are gross! Just wait till we're out of this and Paimon will teach you a lesson!"
          }
        }
      }
    },
    {
      "subId": "37604",
      "subQuestName": "Hide in the tavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3760401"
        ],
        "dialogs": {
          "3760401": {
            "id": "3760401",
            "speakerId": 1002,
            "speakerName": "Charles",
            "text": "Master Diluc, this is this week's accounts.",
            "nextDialogs": [
              "3760402"
            ]
          },
          "3760402": {
            "id": "3760402",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "Hmm... The disaster has greatly affected business.",
            "nextDialogs": [
              "3760403"
            ]
          },
          "3760403": {
            "id": "3760403",
            "speakerId": 1002,
            "speakerName": "Charles",
            "text": "Well, let's hope it all ends soon.",
            "nextDialogs": [
              "3760404"
            ]
          },
          "3760404": {
            "id": "3760404",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Hi, we'd like a seat at your, uhh... least conspicuous table.",
            "nextDialogs": [
              "3760405"
            ]
          },
          "3760405": {
            "id": "3760405",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "Umm... The second floor has fewer customers. You'd be less conspicuous up there...",
            "nextDialogs": [
              "3760406"
            ]
          },
          "3760406": {
            "id": "3760406",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "But aren't you a bard? Why not sit front and center?",
            "nextDialogs": [
              "3760407"
            ]
          },
          "3760407": {
            "id": "3760407",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Hahaha, let's save the paid performance for next time. We'll be heading up now, see you in a bit!",
            "nextDialogs": [
              "3760408"
            ]
          },
          "3760408": {
            "id": "3760408",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "Hey, keep an eye on them. There's something strange about that bard. I'll go ask around.",
            "nextDialogs": [
              "3760409"
            ]
          },
          "3760409": {
            "id": "3760409",
            "speakerId": 1002,
            "speakerName": "Charles",
            "text": "Ask who exactly?",
            "nextDialogs": [
              "3760410"
            ]
          },
          "3760410": {
            "id": "3760410",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "The \"protectors\" of Mondstadt..."
          }
        }
      }
    },
    {
      "subId": "37605",
      "subQuestName": "Answer Diluc's questions",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "37606",
      "subQuestName": "Hide on the second floor of the tavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3760601"
        ],
        "dialogs": {
          "3760601": {
            "id": "3760601",
            "speakerId": 1004,
            "speakerName": "Otto",
            "text": "Ah, Master Diluc. Have you seen two thieves around?",
            "nextDialogs": [
              "3760602"
            ]
          },
          "3760602": {
            "id": "3760602",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "What happened? Why have you mobilized so many guards?",
            "nextDialogs": [
              "3760603"
            ]
          },
          "3760603": {
            "id": "3760603",
            "speakerId": 1005,
            "speakerName": "Miles",
            "text": "Haven't you heard, Master Diluc? Two thieves were trying to steal the Holy Lyre!",
            "nextDialogs": [
              "3760604"
            ]
          },
          "3760604": {
            "id": "3760604",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "Oh? How odd.",
            "nextDialogs": [
              "3760605"
            ]
          },
          "3760605": {
            "id": "3760605",
            "speakerId": 1005,
            "speakerName": "Miles",
            "text": "Isn't it? The Holy Lyre is a treasure that was played by the God of Anemo themselves. Such a precious piece of cultural heritage—",
            "nextDialogs": [
              "3760606"
            ]
          },
          "3760606": {
            "id": "3760606",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "Why would one want to steal something they can't sell off? Would pay better to steal from my cellars...",
            "nextDialogs": [
              "3760607"
            ]
          },
          "3760607": {
            "id": "3760607",
            "speakerId": 1004,
            "speakerName": "Otto",
            "text": "Huh?",
            "nextDialogs": [
              "3760608"
            ]
          },
          "3760608": {
            "id": "3760608",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "Sorry, off topic. Believe they headed that way.",
            "nextDialogs": [
              "3760609"
            ]
          },
          "3760609": {
            "id": "3760609",
            "speakerId": 1005,
            "speakerName": "Miles",
            "text": "Understood. Thank you, Master Diluc!"
          }
        }
      }
    },
    {
      "subId": "37608",
      "subQuestName": "Talk to Diluc",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3760701"
        ],
        "dialogs": {
          "3760701": {
            "id": "3760701",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Today I think I'll have a glass of...",
            "nextDialogs": [
              "3760702"
            ]
          },
          "3760702": {
            "id": "3760702",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "You can put down that bottle you stole from behind the counter.",
            "nextDialogs": [
              "3760703"
            ]
          },
          "3760703": {
            "id": "3760703",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "...something cold.",
            "nextDialogs": [
              "3760704"
            ]
          },
          "3760704": {
            "id": "3760704",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "Right. I want answers.",
            "nextDialogs": [
              "3760705"
            ]
          },
          "3760705": {
            "id": "3760705",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Lemme finish my drink first? I'll pay you — well, with a performance.",
            "nextDialogs": [
              "3760706"
            ]
          },
          "3760706": {
            "id": "3760706",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "It's not about money. You seem too young to be drinking.",
            "nextDialogs": [
              "3760707"
            ]
          },
          "3760707": {
            "id": "3760707",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "No need to worry. When I started drinking, you were still—",
            "nextDialogs": [
              "3760709"
            ]
          },
          "3760709": {
            "id": "3760709",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Oh, you wanna ask \"Who's this?\" Am I right?",
            "nextDialogs": [
              "3760711"
            ]
          },
          "3760711": {
            "id": "3760711",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "He is Master <color=#00E1FFFF>Diluc</color>, the boss of... ah, the owner of this tavern.",
            "nextDialogs": [
              "3760712"
            ]
          },
          "3760712": {
            "id": "3760712",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "He's very famous. By the way, his dandelion wine is one of my favorites.",
            "nextDialogs": [
              "3760713"
            ]
          },
          "3760713": {
            "id": "3760713",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Though most of the time I can only afford a bottle or two...",
            "nextDialogs": [
              "3760714"
            ]
          },
          "3760714": {
            "id": "3760714",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "I just heard about some thieves from the guards.",
            "nextDialogs": [
              "3760715"
            ]
          },
          "3760715": {
            "id": "3760715",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "For the record, I like your guts for trying to steal the Holy Lyre der Himmel.",
            "nextDialogs": [
              "3760716"
            ]
          },
          "3760716": {
            "id": "3760716",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "Even if you are fools... but we don't often get to see people like you.",
            "nextDialogs": [
              "3760717"
            ]
          },
          "3760717": {
            "id": "3760717",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It wasn't us that stole it! The real thief is still out there!",
            "nextDialogs": [
              "3760718"
            ]
          },
          "3760718": {
            "id": "3760718",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "This is the hotshot of the Knights of Favonius. Why would someone so aspiring steal Mondstadt's sacred treasure?",
            "nextDialogs": [
              "3760719"
            ]
          },
          "3760719": {
            "id": "3760719",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "Hotshot...? Oh, so it's you.",
            "nextDialogs": [
              "3760720"
            ]
          },
          "3760720": {
            "id": "3760720",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "So, you and the bard are close friends?"
          }
        }
      }
    },
    {

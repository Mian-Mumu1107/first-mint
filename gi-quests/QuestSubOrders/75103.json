            ]
          },
          "751030215": {
            "id": "751030215",
            "speakerId": 1001,
            "speakerName": "Pania",
            "text": "#Could be that they can't even see the fish I laid out from that far away. If you could lure them ashore, {M#Big Bro}{F#Big Sis}, they'd take the bait for sure!",
            "nextDialogs": [
              "751030216"
            ]
          },
          "751030216": {

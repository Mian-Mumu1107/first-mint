            ]
          },
          "200700403": {
            "id": "200700403",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Well, these experiments have produced good results. It seems as though preservation at low temperatures is a viable solution, hehe.",
            "nextDialogs": [

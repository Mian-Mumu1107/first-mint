  "subQuests": [
    {
      "subId": "2007015",
      "subQuestName": "Talk to Flora",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200700501"
        ],
        "dialogs": {
          "200700501": {
            "id": "200700501",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Here, over here!",
            "nextDialogs": [
              "200700502"
            ]
          },
          "200700502": {
            "id": "200700502",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Do you still remember the flowers that I asked you to store on Dragonspine?",
            "nextDialogs": [
              "200700503"
            ]
          },
          "200700503": {
            "id": "200700503",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "It's been a day since then, and I'd like to see the results of our cold storage experiment.",
            "nextDialogs": [
              "200700504"
            ]
          },
          "200700504": {
            "id": "200700504",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Could you help me go up the mountain and bring those flowers back?",
            "nextDialogs": [
              "200700506",
              "200700508"
            ]
          },
          "200700506": {
            "id": "200700506",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "I'm counting on you, then. I'll be waiting here, so do come back soon."
          },
          "200700508": {
            "id": "200700508",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "You forgot? You put them <color=#00E1FFFF>beside a Statue of The Seven</color>, <color=#00E1FFFF>by a body of water in the mountains</color>, and <color=#00E1FFFF>near a cavern</color>.",
            "nextDialogs": [
              "200700509"
            ]
          },
          "200700509": {
            "id": "200700509",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Let me help you mark them on your map again."
          }
        }
      }
    },

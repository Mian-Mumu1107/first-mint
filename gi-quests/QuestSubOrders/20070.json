    {
      "subId": "2007001",
      "subQuestName": "Retrieve the package near the cavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200700101"
        ],
        "dialogs": {
          "200700101": {
            "id": "200700101",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "How are the flowers that we stored away on Dragonspine earlier?",
            "nextDialogs": [
              "200700102"
            ]
          },
          "200700102": {
            "id": "200700102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I only managed to retrieve one container...",
            "nextDialogs": [
              "200700103"
            ]
          },
          "200700103": {
            "id": "200700103",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "The others couldn't be retrieved? Um... Well, alright then. It is quite hard to predict conditions on that mountain, after all.",
            "nextDialogs": [
              "200700104"
            ]
          },
          "200700104": {
            "id": "200700104",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "But if we only have one, then we can't make any comparisons. I suppose we'll just have to wait for another opportunity...",
            "nextDialogs": [
              "200700105"
            ]
          },
          "200700105": {
            "id": "200700105",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Thank you for taking the trouble, though. Here, I prepared these as compensation — I might need to call upon your help in the future as well."
          }
        }
      }
    },
    {
      "subId": "2007006",
      "subQuestName": "Follow the trail to search for the package",
      "sceneId": null,
      "locations": [],

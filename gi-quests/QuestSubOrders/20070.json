    {
      "subId": "2007003",
      "subQuestName": "Defeat the Treasure Hoarders",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200700301"
        ],
        "dialogs": {
          "200700301": {
            "id": "200700301",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "How are the flowers that we stored away on Dragonspine earlier?",
            "nextDialogs": [
              "200700302"
            ]
          },
          "200700302": {
            "id": "200700302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I have them all here.",
            "nextDialogs": [
              "200700303"
            ]
          },
          "200700303": {
            "id": "200700303",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "All of them? That's great! Here, let me see.",
            "nextDialogs": [
              "200700304"
            ]
          },
          "200700304": {
            "id": "200700304",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Hehe, not bad at all. Hmm... Looks like this method really does work.",
            "nextDialogs": [
              "200700305"
            ]
          },
          "200700305": {
            "id": "200700305",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "The only problem is that Dragonspine is really far from Mondstadt. I can't be troubling you every time, either. I have to find some other way in future...",
            "nextDialogs": [
              "200700306"
            ]
          },
          "200700306": {
            "id": "200700306",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Thank you very much, all the same. Here's your compensation, please take it!"
          }
        }
      }
    },
    {
      "subId": "2007007",
      "subQuestName": "Apologize to Flora",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200700201"
        ],
        "dialogs": {
          "200700201": {
            "id": "200700201",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "How are the flowers?",
            "nextDialogs": [
              "200700202"
            ]
          },
          "200700202": {
            "id": "200700202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm sorry...",
            "nextDialogs": [
              "200700203"
            ]
          },
          "200700203": {
            "id": "200700203",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Eh? What happened?",
            "nextDialogs": [
              "200700204"
            ]
          },
          "200700204": {
            "id": "200700204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I broke the containers and flowers by accident...",
            "nextDialogs": [
              "200700205"
            ]
          },
          "200700205": {
            "id": "200700205",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "B—By accident!?",
            "nextDialogs": [
              "200700206"
            ]
          },
          "200700206": {
            "id": "200700206",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Ugh... I specifically picked those flowers out. You can't find such good flowers just anywhere...",
            "nextDialogs": [
              "200700207"
            ]
          },
          "200700207": {
            "id": "200700207",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Is Dragonspine so dangerous that even an adventurer like you couldn't keep one container from...",
            "nextDialogs": [
              "200700208"
            ]
          },
          "200700208": {
            "id": "200700208",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Still, thanks for making that trip for me. Please take these as thanks. Now, if you'll excuse me, I have to go tend to my flowers.",
            "nextDialogs": [
              "200700209"
            ]
          },
          "200700209": {
            "id": "200700209",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "*sigh* Maybe I should try the method that Sara suggested after all..."
          }
        }
      }
    },

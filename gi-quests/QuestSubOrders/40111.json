  "subQuests": [
    {
      "subId": "4011111",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401111101"
        ],
        "dialogs": {
          "401111101": {
            "id": "401111101",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "I won, I won!",
            "nextDialogs": [
              "401111103",
              "401111107"
            ]
          },
          "401111103": {
            "id": "401111103",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Thanks. I can't wait to tell my mom... this'll make her really happy, won't it?",
            "nextDialogs": [
              "401111104"
            ]
          },
          "401111104": {
            "id": "401111104",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Mom was the one who kept telling me I should join the tournament, so I'm gonna give the prizes to her!",
            "nextDialogs": [
              "401111105"
            ]
          },
          "401111105": {
            "id": "401111105",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "I really wish my dad could see me now..."
          },
          "401111107": {
            "id": "401111107",
            "speakerId": 1000,
            "speakerName": "Timmie",
            "text": "Bye! Ah, Genius Invokation is sooo much fun..."
          }
        }
      }
    },
    {
      "subId": "4011112",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401111201"
        ],
        "dialogs": {
          "401111201": {
            "id": "401111201",
            "speakerId": 1001,
            "speakerName": "Mika",
            "text": "Wait, why's everyone leaving? ...Did I miss it...?",
            "nextDialogs": [
              "401111202"
            ]
          },
          "401111202": {
            "id": "401111202",
            "speakerId": 1002,
            "speakerName": "Huffman",
            "text": "Ah Mika, too bad you weren't here to see it. I'm afraid that... Captain Kaeya lost.",
            "nextDialogs": [
              "401111203"
            ]
          },
          "401111203": {
            "id": "401111203",
            "speakerId": 1001,
            "speakerName": "Mika",
            "text": "What!?",
            "nextDialogs": [
              "401111204"
            ]
          },
          "401111204": {
            "id": "401111204",
            "speakerId": 1001,
            "speakerName": "Mika",
            "text": "Tell me everything! What happened?",
            "nextDialogs": [
              "401111205"
            ]
          },
          "401111205": {
            "id": "401111205",
            "speakerId": 1002,
            "speakerName": "Huffman",
            "text": "Well, I don't know much about Genius Invokation myself, but I did try to follow along by listening in to what everyone was saying...",
            "nextDialogs": [
              "401111206"
            ]
          },
          "401111206": {
            "id": "401111206",
            "speakerId": 1002,
            "speakerName": "Huffman",
            "text": "Captain Kaeya took out one of Timmie's character cards right at the start, giving him an early advantage.",
            "nextDialogs": [
              "401111207"
            ]
          },
          "401111207": {
            "id": "401111207",
            "speakerId": 1002,
            "speakerName": "Huffman",
            "text": "But I guess that was all part of his opponent's strategy...? In any case, Timmie spent the first few rounds stocking up cards in his hand, and then swung the game with a brutal offensive right at the end.",
            "nextDialogs": [
              "401111208"
            ]
          },
          "401111208": {
            "id": "401111208",
            "speakerId": 1002,
            "speakerName": "Huffman",
            "text": "Hmm, but y'know, maybe the match was already over from the moment they flipped the coin and determined that Kaeya would go second...",
            "nextDialogs": [
              "401111209"
            ]
          },
          "401111209": {
            "id": "401111209",
            "speakerId": 1002,
            "speakerName": "Huffman",
            "text": "*sigh* I need a drink...",
            "nextDialogs": [
              "401111210"
            ]
          },
          "401111210": {
            "id": "401111210",
            "speakerId": 1001,
            "speakerName": "Mika",
            "text": "Calm down, bro. Now's not the time to start drinking your sorrows away.",
            "nextDialogs": [
              "401111211"
            ]
          },
          "401111211": {
            "id": "401111211",
            "speakerId": 1001,
            "speakerName": "Mika",
            "text": "Knowing Captain Kaeya, he wouldn't want to see you upset over his loss.",
            "nextDialogs": [
              "401111212"
            ]
          },
          "401111212": {
            "id": "401111212",
            "speakerId": 1001,
            "speakerName": "Mika",
            "text": "Hey, why don't we learn how to play, too? Maybe then, we'll get to play against Captain Kaeya some day! Hehe... Though, I'm sure we'd lose pretty badly to him.",
            "nextDialogs": [
              "401111213"
            ]
          },
          "401111213": {
            "id": "401111213",
            "speakerId": 1002,
            "speakerName": "Huffman",
            "text": "Hah, yeah, you're right, Mika. Not a bad plan."
          }
        }
      }
    },
    {
      "subId": "4011113",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401111301"
        ],
        "dialogs": {
          "401111301": {
            "id": "401111301",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "Hey there. Something else you wanted to discuss?",
            "nextDialogs": [
              "401111303"
            ]
          },
          "401111303": {
            "id": "401111303",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "The game's really caught on lately. It's a part of everyday life now — everywhere you go, you see people playing it.",
            "nextDialogs": [
              "401111304"
            ]
          },
          "401111304": {
            "id": "401111304",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "In fact, some people have even given up drinking in order to keep a clear head during the game.",
            "nextDialogs": [
              "401111305"
            ]
          },
          "401111305": {
            "id": "401111305",
            "speakerId": 1003,
            "speakerName": "Kaeya",
            "text": "Hehe, I'm sure Diona will be happy to hear that."
          }
        }
      }
    },
    {
      "subId": "4011114",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401111401"
        ],
        "dialogs": {
          "401111401": {
            "id": "401111401",
            "speakerId": 1004,
            "speakerName": "Eichendorff",
            "text": "What an amazing tournament. That Timmie, huh... He really has a gift for this.",
            "nextDialogs": [
              "401111402"
            ]
          },
          "401111402": {
            "id": "401111402",
            "speakerId": 1005,
            "speakerName": "Lennard",
            "text": "Yeah, who saw that coming... But at least I can feel a little better about losing to him now."
          }
        }
      }
    },
    {
      "subId": "4011115",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401111501"
        ],
        "dialogs": {
          "401111501": {
            "id": "401111501",
            "speakerId": 1006,
            "speakerName": "Charlotte",
            "text": "\"City on the Lake Teems With Talent in TCG Tournament as Young Prodigy Bests Favonian Cavalry Captain\"...",
            "nextDialogs": [
              "401111502"
            ]
          },
          "401111502": {
            "id": "401111502",
            "speakerId": 1006,
            "speakerName": "Charlotte",
            "text": "Hmm, this title saves face for the Knights, but lacks a little \"oomph\"...",
            "nextDialogs": [
              "401111503"
            ]
          },
          "401111503": {
            "id": "401111503",
            "speakerId": 1006,
            "speakerName": "Charlotte",
            "text": "\"Top Strategic Mind of the Knights of Favonius Outsmarted by Bridge Boy in Five-Round Failure\"...",
            "nextDialogs": [
              "401111504"
            ]
          },
          "401111504": {
            "id": "401111504",
            "speakerId": 1006,
            "speakerName": "Charlotte",
            "text": "\"Captain's Championship Hopes Crushed in Dazzling Dark Horse Defeat\"...",
            "nextDialogs": [
              "401111505"
            ]
          },
          "401111505": {
            "id": "401111505",
            "speakerId": 1006,
            "speakerName": "Charlotte",
            "text": "Hmm... Maybe I should stick with my first draft...?"
          }
        }
      }
    },
    {
      "subId": "4011131",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401113101"
        ],
        "dialogs": {
          "401113101": {
            "id": "401113101",
            "speakerId": 1007,
            "speakerName": "Hu Tao",
            "text": "By the way, does Captain Beidou play Genius Invokation TCG, by any chance?",
            "nextDialogs": [
              "401113102"
            ]
          },
          "401113102": {
            "id": "401113102",
            "speakerId": 1008,
            "speakerName": "Kaedehara Kazuha",
            "text": "Yes. In fact, she's one of the best in the whole Crux Fleet.",
            "nextDialogs": [
              "401113103"
            ]
          },
          "401113103": {
            "id": "401113103",
            "speakerId": 1007,
            "speakerName": "Hu Tao",
            "text": "Would you mind putting in a word for me, Kazuha? I'm a long-time fan of Captain Beidou's. I've always hoped I'll get to make friends with her some day, but so far I've never had the chance.",
            "nextDialogs": [
              "401113104"
            ]
          },
          "401113104": {
            "id": "401113104",
            "speakerId": 1008,
            "speakerName": "Kaedehara Kazuha",
            "text": "Sure. But please be gentle when you inevitably defeat her in Genius Invokation."
          }
        }
      }
    },
    {
      "subId": "4011132",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401113201"
        ],
        "dialogs": {
          "401113201": {
            "id": "401113201",
            "speakerId": 1009,
            "speakerName": "Ningguang",
            "text": "I've heard that even the unofficial Genius Invokation tournament is enjoying a huge turnout. Many serious TCG players have registered for both the official and unofficial ones.",
            "nextDialogs": [
              "401113202"
            ]
          },
          "401113202": {
            "id": "401113202",
            "speakerId": 1009,
            "speakerName": "Ningguang",
            "text": "As for me... I don't mind trying my hand at the trending games from time to time, though I still prefer chess.",
            "nextDialogs": [
              "401113203"
            ]
          },
          "401113203": {
            "id": "401113203",
            "speakerId": 1009,
            "speakerName": "Ningguang",
            "text": "But when it comes down to it, whatever differences there may be between the various games around, they all share one important thing in common: They bring friends together."
          }
        }
      }
    },
    {
      "subId": "4011133",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401113301"
        ],
        "dialogs": {
          "401113301": {
            "id": "401113301",
            "speakerId": 1006,
            "speakerName": "Charlotte",
            "text": "Hi there, my name's Charlotte. I'm a reporter for The Steambird.",
            "nextDialogs": [
              "401113302"
            ]
          },
          "401113302": {
            "id": "401113302",
            "speakerId": 1006,
            "speakerName": "Charlotte",
            "text": "Could I borrow a moment of your time for a brief interview?",
            "nextDialogs": [
              "401113303"
            ]
          },
          "401113303": {
            "id": "401113303",
            "speakerId": 1010,
            "speakerName": "Brother Qian",
            "text": "*sigh* Sure, go ahead.",
            "nextDialogs": [
              "401113304"
            ]
          },
          "401113304": {
            "id": "401113304",
            "speakerId": 1006,
            "speakerName": "Charlotte",
            "text": "You made a promising start in this competition, leaving many contenders in the dust on your way to the finals, before narrowly missing out on a championship win when you lost to Director Hu Tao of the Wangsheng Funeral Parlor. It must be difficult for you, knowing how close you came to victory.",
            "nextDialogs": [
              "401113305"
            ]
          },
          "401113305": {
            "id": "401113305",
            "speakerId": 1006,
            "speakerName": "Charlotte",
            "text": "With this in mind, would you like to share your thoughts on how the final match played out?",
            "nextDialogs": [
              "401113306"
            ]
          },
          "401113306": {
            "id": "401113306",
            "speakerId": 1010,
            "speakerName": "Brother Qian",
            "text": "Uhh...",
            "nextDialogs": [
              "401113307"
            ]
          },
          "401113307": {
            "id": "401113307",
            "speakerId": 1010,
            "speakerName": "Brother Qian",
            "text": "Sorry, do you want an answer for the media, or do you want my actual thoughts?",
            "nextDialogs": [
              "401113308"
            ]
          },
          "401113308": {
            "id": "401113308",
            "speakerId": 1006,
            "speakerName": "Charlotte",
            "text": "I'd like to hear your actual thoughts, of course.",
            "nextDialogs": [
              "401113309"
            ]
          },
          "401113309": {
            "id": "401113309",
            "speakerId": 1010,
            "speakerName": "Brother Qian",
            "text": "*sigh*",
            "nextDialogs": [
              "401113310"
            ]
          },
          "401113310": {
            "id": "401113310",
            "speakerId": 1010,
            "speakerName": "Brother Qian",
            "text": "Well, I've always said that playing cards is seventy percent skill and thirty percent luck... But when your opponent rolls six dice of the same element at once, there's no coming back from that, not even with adeptus-level skills... so there was no hope for a mere adventurer like me."
          }
        }
      }
    },
    {
      "subId": "4011151",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401115101"
        ],
        "dialogs": {
          "401115101": {
            "id": "401115101",
            "speakerId": 1011,
            "speakerName": "Arataki Itto",
            "text": "Whew, that match between fox lady and fish lady really got my blood racing! The sweat's practically boiling off my forehead!",
            "nextDialogs": [
              "401115102"
            ]
          },
          "401115102": {
            "id": "401115102",
            "speakerId": 1012,
            "speakerName": "Kuki Shinobu",
            "text": "Yes, yes. I'm sure all of Ritou knows how excited you are, but the gang's all waiting for us. We should be heading back now.",
            "nextDialogs": [
              "401115103"
            ]
          },
          "401115103": {
            "id": "401115103",
            "speakerId": 1011,
            "speakerName": "Arataki Itto",
            "text": "Ehh, they can wait a little longer... At least let my compadre and I play one last match! You can't say no to that... Pretty please?",
            "nextDialogs": [
              "401115105",
              "401115108"
            ]
          },
          "401115105": {
            "id": "401115105",
            "speakerId": 1011,
            "speakerName": "Arataki Itto",
            "text": "That's my compadre! I knew you'd be down to duel! Only you understand a hardcore TCG player like me!",
            "nextDialogs": [
              "401115106"
            ]
          },
          "401115106": {
            "id": "401115106",
            "speakerId": 1012,
            "speakerName": "Kuki Shinobu",
            "text": "Seriously, what will I do with you two..."
          },
          "401115108": {
            "id": "401115108",
            "speakerId": 1011,
            "speakerName": "Arataki Itto",
            "text": "...Fine.",
            "nextDialogs": [
              "401115109"
            ]
          },
          "401115109": {
            "id": "401115109",
            "speakerId": 1011,
            "speakerName": "Arataki Itto",
            "text": "It's okay, I don't blame you... But you should probably leave. You don't wanna see a grown oni cry..."
          }
        }
      }
    },
    {
      "subId": "4011152",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401115201"
        ],
        "dialogs": {
          "401115201": {
            "id": "401115201",
            "speakerId": 1013,
            "speakerName": "Sangonomiya Kokomi",
            "text": "General Kujou, could I have a word with you?",
            "nextDialogs": [
              "401115202"
            ]
          },
          "401115202": {
            "id": "401115202",
            "speakerId": 1014,
            "speakerName": "Kujou Sara",
            "text": "Yes. Congratulations on your victory, Sangonomiya Kokomi.",
            "nextDialogs": [
              "401115203"
            ]
          },
          "401115203": {
            "id": "401115203",
            "speakerId": 1013,
            "speakerName": "Sangonomiya Kokomi",
            "text": "I wanted to express my gratitude for the helpful advice you provided before the match.",
            "nextDialogs": [
              "401115204"
            ]
          },
          "401115204": {
            "id": "401115204",
            "speakerId": 1014,
            "speakerName": "Kujou Sara",
            "text": "It was nothing. Anyone with a good head on their shoulders knows that skill and strategy ultimately determine the winner. In any case, it was an exciting match to watch.",
            "nextDialogs": [
              "401115205"
            ]
          },
          "401115205": {
            "id": "401115205",
            "speakerId": 1013,
            "speakerName": "Sangonomiya Kokomi",
            "text": "It was unfortunate that you didn't register for the tournament as well.",
            "nextDialogs": [
              "401115206"
            ]
          },
          "401115206": {
            "id": "401115206",
            "speakerId": 1014,
            "speakerName": "Kujou Sara",
            "text": "I'm afraid I'd be no match for you.",
            "nextDialogs": [
              "401115207"
            ]
          },
          "401115207": {
            "id": "401115207",
            "speakerId": 1013,
            "speakerName": "Sangonomiya Kokomi",
            "text": "Don't say that. You're not so different from me... seeking chances to hone your skills in the game, considering countermeasures, and competing with others as if they're friends.",
            "nextDialogs": [
              "401115208"
            ]
          },
          "401115208": {
            "id": "401115208",
            "speakerId": 1014,
            "speakerName": "Kujou Sara",
            "text": "...Perhaps you have a point.",
            "nextDialogs": [
              "401115209"
            ]
          },
          "401115209": {
            "id": "401115209",
            "speakerId": 1014,
            "speakerName": "Kujou Sara",
            "text": "In that case, let's play a match of Genius Invokation before you depart from Narukami Island.",
            "nextDialogs": [
              "401115210"
            ]
          },
          "401115210": {
            "id": "401115210",
            "speakerId": 1013,
            "speakerName": "Sangonomiya Kokomi",
            "text": "It would be my pleasure."
          }
        }
      }
    },
    {
      "subId": "4011153",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401115301"
        ],
        "dialogs": {
          "401115301": {
            "id": "401115301",
            "speakerId": 1006,
            "speakerName": "Charlotte",
            "text": "I heard you refer to the opponent as a \"kitsune youkai\" earlier, could you tell me a little more about that?",
            "nextDialogs": [
              "401115302"
            ]
          },
          "401115302": {
            "id": "401115302",
            "speakerId": 1006,
            "speakerName": "Charlotte",
            "text": "Don't leave out any details. Who knows, maybe there's something I'll be able to use in my news piece.",
            "nextDialogs": [
              "401115303"
            ]
          },
          "401115303": {
            "id": "401115303",
            "speakerId": 1015,
            "speakerName": "Kirara",
            "text": "Oh! I'd better not, I'm afraid of saying something wrong. Besides, I'm not really the most qualified youkai to answer questions.",
            "nextDialogs": [
              "401115304"
            ]
          },
          "401115304": {
            "id": "401115304",
            "speakerId": 1006,
            "speakerName": "Charlotte",
            "text": "Okay, then maybe you could help explain why a kitsune would have any interest in Fried Tofu.",
            "nextDialogs": [
              "401115305"
            ]
          },
          "401115305": {
            "id": "401115305",
            "speakerId": 1015,
            "speakerName": "Kirara",
            "text": "Ah, now your questions are making me hungry.",
            "nextDialogs": [
              "401115306"
            ]
          },
          "401115306": {
            "id": "401115306",
            "speakerId": 1015,
            "speakerName": "Kirara",
            "text": "Why don't I just take you to try some Kitsune Ramen here in Inazuma? I can explain while we eat."
          }
        }
      }
    },
    {
      "subId": "4011199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401119901"
        ],
        "dialogs": {
          "401119901": {
            "id": "401119901",
            "speakerId": 1016,
            "speakerName": "Tighnari",
            "text": "(I really didn't see that coming...)"
          }
        }
      }
    }
  ]
}
    "The Damselette": 51
  },
  "subQuests": [
    {
      "subId": "7605201",
      "subQuestName": "Meet The Damselette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760520101"
        ],
        "dialogs": {
          "760520101": {
            "id": "760520101",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "760520102"
            ]
          },
          "760520102": {
            "id": "760520102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Columbina, are you okay? You look a bit out of sorts.",
            "nextDialogs": [
              "760520103"
            ]
          },
          "760520103": {
            "id": "760520103",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Oh, it's you two. I'm alright...",
            "nextDialogs": [
              "760520104"
            ]
          },
          "760520104": {
            "id": "760520104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Is she thinking about the moon again...?)",
            "nextDialogs": [
              "760520105"
            ]
          },
          "760520105": {
            "id": "760520105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is there anything we can do to help?",
            "nextDialogs": [
              "760520106"
            ]
          },
          "760520106": {
            "id": "760520106",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I...",
            "nextDialogs": [
              "760520107"
            ]
          },
          "760520107": {
            "id": "760520107",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "760520108"
            ]
          },
          "760520108": {
            "id": "760520108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's okay! Just tell us! Even if it's something small, you'll feel much better once it's off your chest.",
            "nextDialogs": [
              "760520109"
            ]
          },
          "760520109": {
            "id": "760520109",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I... would like to try a drink from the tavern.",
            "nextDialogs": [
              "760520110"
            ]
          },
          "760520110": {
            "id": "760520110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...What!?",
            "nextDialogs": [
              "760520111"
            ]
          },
          "760520111": {
            "id": "760520111",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "...*sigh*",
            "nextDialogs": [
              "760520112"
            ]
          },
          "760520112": {
            "id": "760520112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sorry... Paimon was just a little surprised. You never talk about wanting things for yourself, so...",
            "nextDialogs": [
              "760520113"
            ]
          },
          "760520113": {
            "id": "760520113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And, that's it? Just... a drink?",
            "nextDialogs": [
              "760520114"
            ]
          },
          "760520114": {
            "id": "760520114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What, were you expecting her to think bigger?",
            "nextDialogs": [
              "760520115"
            ]
          },
          "760520115": {
            "id": "760520115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, kinda. At least something a bit more monumental... Like, \"Bring me the moon.\"",
            "nextDialogs": [
              "760520116"
            ]
          },
          "760520116": {
            "id": "760520116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But, on second thought, it does kinda make sense. Columbina can't go wherever she wants right now, so a trip to the tavern might as well be a trip to the moon...",
            "nextDialogs": [
              "760520117"
            ]
          },
          "760520117": {
            "id": "760520117",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "It's not just how things are now. Even back when I was with the Fatui, when there was no order to capture me... everyone still kept their distance whenever I went out for a walk.",
            "nextDialogs": [
              "760520118"
            ]
          },
          "760520118": {
            "id": "760520118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Third of the Fatui Harbingers... That title alone is enough to scare off people who don't know her.)",
            "nextDialogs": [
              "760520119"
            ]
          },
          "760520119": {
            "id": "760520119",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait a sec, come to think of it... Maybe this isn't as hard as Paimon first thought...",
            "nextDialogs": [
              "760520120"
            ]
          },
          "760520120": {
            "id": "760520120",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#A tavern is kind of out of the question, but a drink... Now, that we can do! {NICKNAME}'s got this!",
            "nextDialogs": [
              "760520121"
            ]
          },
          "760520121": {
            "id": "760520121",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "...Really?",
            "nextDialogs": [
              "760520122"
            ]
          },
          "760520122": {
            "id": "760520122",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, but don't set your expectations too high...",
            "nextDialogs": [
              "760520123"
            ]
          },
          "760520123": {
            "id": "760520123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Any flavor preferences?",
            "nextDialogs": [
              "760520124"
            ]
          },
          "760520124": {
            "id": "760520124",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Flavor...",
            "nextDialogs": [
              "760520125"
            ]
          },
          "760520125": {
            "id": "760520125",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I don't have much experience ordering drinks, so I'm not sure where to start...",
            "nextDialogs": [
              "760520126"
            ]
          },
          "760520126": {
            "id": "760520126",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Perhaps something that isn't too... heavy?",
            "nextDialogs": [
              "760520127"
            ]
          },
          "760520127": {
            "id": "760520127",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Umm, what do you mean by \"heavy\"?",
            "nextDialogs": [
              "760520128"
            ]
          },
          "760520128": {
            "id": "760520128",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Heavy like... a Fatui overcoat.",
            "nextDialogs": [
              "760520129"
            ]
          },
          "760520129": {
            "id": "760520129",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That comparison makes it even more confusing...",
            "nextDialogs": [
              "760520132"
            ]
          },
          "760520132": {
            "id": "760520132",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Okay. Whatever you think."
          }
        }
      }
    },
    {
      "subId": "7605202",
      "subQuestName": "Mix drinks",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760520301"
        ],
        "dialogs": {
          "760520301": {
            "id": "760520301",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": ""
          }
        }
      }
    },
    {
      "subId": "7605204",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760520401"
        ],
        "dialogs": {
          "760520401": {
            "id": "760520401",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Hm, I've smelled something like this before.",
            "nextDialogs": [
              "760520402"
            ]
          },
          "760520402": {
            "id": "760520402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, really? Where?",
            "nextDialogs": [
              "760520403"
            ]
          },
          "760520403": {
            "id": "760520403",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "In Sandrone's room. She had a drink that smelled like this. The aroma caught my interest, and when she noticed... she just held on to the drink for ages without finishing it.",
            "nextDialogs": [
              "760520404"
            ]
          },
          "760520404": {
            "id": "760520404",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "It was like... she was waiting for me to ask about it.",
            "nextDialogs": [
              "760520405"
            ]
          },
          "760520405": {
            "id": "760520405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So... did you?",
            "nextDialogs": [
              "760520406"
            ]
          },
          "760520406": {
            "id": "760520406",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Yes.",
            "nextDialogs": [
              "760520407"
            ]
          },
          "760520407": {
            "id": "760520407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What did you ask?",
            "nextDialogs": [
              "760520408"
            ]
          },
          "760520408": {
            "id": "760520408",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Shouldn't you be drinking engine oil instead?",
            "nextDialogs": [
              "760520409"
            ]
          },
          "760520409": {
            "id": "760520409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And... how did she respond?",
            "nextDialogs": [
              "760520410"
            ]
          },
          "760520410": {
            "id": "760520410",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Um...",
            "nextDialogs": [
              "760520411"
            ]
          },
          "760520411": {
            "id": "760520411",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "She said something quite unpleasant. It doesn't bear repeating.",
            "nextDialogs": [
              "760520412"
            ]
          },
          "760520412": {
            "id": "760520412",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "760520413"
            ]
          },
          "760520413": {
            "id": "760520413",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You lost interest after a single sip!?",
            "nextDialogs": [
              "760520414"
            ]
          },
          "760520414": {
            "id": "760520414",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Sorry, it was a little bitter... all in all, not very good. No wonder Sandrone looked so sour when she drank it.",
            "nextDialogs": [
              "760520415"
            ]
          },
          "760520415": {
            "id": "760520415",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon thinks there might've been other reasons for that..."
          }
        }
      }
    },
    {
      "subId": "7605205",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760520501"
        ],
        "dialogs": {
          "760520501": {
            "id": "760520501",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "*glug*... *glug*...",
            "nextDialogs": [
              "760520502"
            ]
          },
          "760520502": {
            "id": "760520502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, that was quick! Looks like she loves it!",
            "nextDialogs": [
              "760520503"
            ]
          },
          "760520503": {
            "id": "760520503",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Hm... completely flavorless.",
            "nextDialogs": [
              "760520504"
            ]
          },
          "760520504": {
            "id": "760520504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "F—f—flavorless!?",
            "nextDialogs": [
              "760520505"
            ]
          },
          "760520505": {
            "id": "760520505",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Yes.",
            "nextDialogs": [
              "760520508"
            ]
          },
          "760520508": {
            "id": "760520508",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Oh... Thanks, but no need.",
            "nextDialogs": [
              "760520509"
            ]
          },
          "760520509": {
            "id": "760520509",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "There was a time when I failed to understand why people felt such joy at harvest time. Then, one day, I reached out to touch a piece of ripe fruit hanging from a branch...",
            "nextDialogs": [
              "760520510"
            ]
          },
          "760520510": {
            "id": "760520510",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I sensed vitality in the very texture of its skin — the organic embodiment of sunlight, water, earth, and air.",
            "nextDialogs": [
              "760520511"
            ]
          },
          "760520511": {
            "id": "760520511",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "With each bite, I felt a refreshing sweetness surge over me like waves of cool white foam.",
            "nextDialogs": [
              "760520512"
            ]
          },
          "760520512": {
            "id": "760520512",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "And that's how I came to understand the irresistible power of aroma.",
            "nextDialogs": [
              "760520513"
            ]
          },
          "760520513": {
            "id": "760520513",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, that's interesting!",
            "nextDialogs": [
              "760520514"
            ]
          },
          "760520514": {
            "id": "760520514",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Then, we complete nature's cycle by taking that life force for ourselves.",
            "nextDialogs": [
              "760520515"
            ]
          },
          "760520515": {
            "id": "760520515",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh, that suddenly turned kinda dark...",
            "nextDialogs": [
              "760520516"
            ]
          },
          "760520516": {
            "id": "760520516",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "That is why I prefer fresh fruit. It allows me to see what I took from this world, exactly as it was before I took it.",
            "nextDialogs": [
              "760520517"
            ]
          },
          "760520517": {
            "id": "760520517",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "And reminds me of what I owe this world in return..."
          }
        }
      }
    },
    {
      "subId": "7605206",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760520601"
        ],
        "dialogs": {
          "760520601": {
            "id": "760520601",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Here, try it for yourselves. This Lakkaberry is very sweet, so make sure you savor it."
          }
        }
      }
    },
    {
      "subId": "7605203",
      "subQuestName": "Talk to The Damselette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760520201"
        ],
        "dialogs": {
          "760520201": {
            "id": "760520201",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Hmm...",
            "nextDialogs": [
              "760520202"
            ]
          },
          "760520202": {
            "id": "760520202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, what do you think?",
            "nextDialogs": [
              "760520203"
            ]
          },
          "760520203": {
            "id": "760520203",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "It reminds me of a time long, long ago, when I was living with the Frostmoon Scions...",
            "nextDialogs": [
              "760520204"
            ]
          },
          "760520204": {
            "id": "760520204",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The people used to make a kind of tea brewed with fresh mint leaves, spices, and dried berries.",
            "nextDialogs": [
              "760520205"
            ]
          },
          "760520205": {
            "id": "760520205",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Whenever I passed by their homes, there was always a subtle herbal aroma wafting from the windows...",
            "nextDialogs": [
              "760520206"
            ]
          },
          "760520206": {
            "id": "760520206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did you ever get to try it?",
            "nextDialogs": [
              "760520207"
            ]
          },
          "760520207": {
            "id": "760520207",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I wanted to, but never got the chance.",
            "nextDialogs": [
              "760520208"
            ]
          },
          "760520208": {
            "id": "760520208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, why not...?",
            "nextDialogs": [
              "760520209"
            ]
          },
          "760520209": {
            "id": "760520209",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "When a \"Goddess\" arrives at your door and asks, \"May I try your tea?\"... No one dares to offer up the \"rustic tea\" thrown together for their own consumption...",
            "nextDialogs": [
              "760520210"
            ]
          },
          "760520210": {
            "id": "760520210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah... Yeah.",
            "nextDialogs": [
              "760520211"
            ]
          },
          "760520211": {
            "id": "760520211",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "What I received in the end was more like an \"offering\" for the divine, complete with ornate packaging and all.",
            "nextDialogs": [
              "760520212"
            ]
          },
          "760520212": {
            "id": "760520212",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Not that it tasted bad, per se... But, it was missing that sense of... \"home.\"",
            "nextDialogs": [
              "760520213"
            ]
          },
          "760520213": {
            "id": "760520213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, now we can fix that!",
            "nextDialogs": [
              "760520214"
            ]
          },
          "760520214": {
            "id": "760520214",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Mmm...",
            "nextDialogs": [
              "760520215"
            ]
          },
          "760520215": {
            "id": "760520215",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The flavor is delightful.",
            "nextDialogs": [
              "760520216"
            ]
          },
          "760520216": {
            "id": "760520216",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "...Though I must say, the idea of adding milk seems quite unorthodox to me.",
            "nextDialogs": [
              "760520217"
            ]
          },
          "760520217": {
            "id": "760520217",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, well this is a Mondstadt recipe. People love adding milk, cream, and sugar to their tea over there.",
            "nextDialogs": [
              "760520218"
            ]
          },
          "760520218": {
            "id": "760520218",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "It's novel... but in a good way.",
            "nextDialogs": [
              "760520219"
            ]
          },
          "760520219": {
            "id": "760520219",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Phew, glad you like it!",
            "nextDialogs": [
              "760520220"
            ]
          },
          "760520220": {
            "id": "760520220",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Mm... Thank you.",
            "nextDialogs": [
              "760520221"
            ]
          },
          "760520221": {
            "id": "760520221",
            "speakerId": 1318,
            "speakerName": "The Damselette",

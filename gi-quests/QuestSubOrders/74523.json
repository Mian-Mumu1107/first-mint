      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745230401"
        ],
        "dialogs": {
          "745230401": {
            "id": "745230401",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "The wind here carries a touch of sea-salt and the distant woody scent of merchant ships... and it brings news of old friends, too.",
            "nextDialogs": [
              "745230402"
            ]
          },
          "745230402": {
            "id": "745230402",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "#Have you been well, {NICKNAME}?",
            "nextDialogs": [
              "745230405"
            ]
          },
          "745230405": {
            "id": "745230405",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "The Crux is presently docked in Inazuma for resupply. I decided to take the rare opportunity to visit my homeland, to take in its sights and sounds, and listen to the wind that blows here.",
            "nextDialogs": [
              "745230406"
            ]
          },
          "745230406": {
            "id": "745230406",
            "speakerId": 1032,
            "speakerName": "Kaedehara Kazuha",
            "text": "The winds of Ritou are always more clamorous than elsewhere, mixed with partings and reunions, hope and confusion... It is a place where you can hear a great many stories."
          }
        }
      }
    }
  ]

        ],
        "dialogs": {
          "191725101": {
            "id": "191725101",
            "speakerId": 1003,
            "speakerName": "Nadwah",
            "text": "Archon be praised, I can finally send a report to my superiors! Thank you so much!",
            "nextDialogs": [
              "191725102"
            ]
          },
          "191725102": {
            "id": "191725102",
            "speakerId": 1003,
            "speakerName": "Nadwah",
            "text": "I have no idea how we might have persuaded her otherwise..."
          }
        }
      }
    },
    {
      "subId": "1917252",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191725201"
        ],
        "dialogs": {
          "191725201": {
            "id": "191725201",
            "speakerId": 1001,
            "speakerName": "Anis",
            "text": "Is Madam Faruzan really going to mentor me? What an honor!",
            "nextDialogs": [
              "191725202"
            ]
          },
          "191725202": {
            "id": "191725202",
            "speakerId": 1001,
            "speakerName": "Anis",
            "text": "Ah, I'm sure she'll say \"helping with illustrations isn't mentoring\"... So, ah, don't tell her I said that."
          }
        }
      }
    },
    {
      "subId": "1917253",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191725301"
        ],
        "dialogs": {
          "191725301": {
            "id": "191725301",
            "speakerId": 1000,
            "speakerName": "Mamdouh",
            "text": "No wonder she's so well-respected at the Akademiya. When I first saw her, I thought she might be unreliable because she's so young...",
            "nextDialogs": [
              "191725302"
            ]
          },
          "191725302": {
            "id": "191725302",
            "speakerId": 1000,
            "speakerName": "Mamdouh",
            "text": "Ah! Don't let her know I said that. Anis warned me about that before..."
          }
        }
      }
    },
    {
      "subId": "1917254",

              "191725504"
            ]
          },
          "191725504": {
            "id": "191725504",
            "speakerId": 1007,
            "speakerName": "Tighnari",
            "text": "It's fine. Collei has already filled me in, more or less.",
            "nextDialogs": [
              "191725505"
            ]
          },
          "191725505": {
            "id": "191725505",
            "speakerId": 1007,
            "speakerName": "Tighnari",
            "text": "I've also managed to settle some of the problems on my side, so I've got time to wait for Madam Faruzan to arrive.",
            "nextDialogs": [
              "191725506"
            ]
          },
          "191725506": {
            "id": "191725506",
            "speakerId": 1007,
            "speakerName": "Tighnari",
            "text": "Can you help me find out how she's faring in two days' time?"

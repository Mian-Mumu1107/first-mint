  "subQuests": [
    {
      "subId": "2201401",
      "subQuestName": "Talk to Xudong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220140101"
        ],
        "dialogs": {
          "220140101": {
            "id": "220140101",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hey, Traveler. Nice to see you again.",
            "nextDialogs": [
              "220140103",
              "220140105"
            ]
          },
          "220140103": {
            "id": "220140103",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Remember how I promised you a meal? I'm making preparations for it right now.",
            "nextDialogs": [
              "220140106"
            ]
          },
          "220140106": {
            "id": "220140106",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "We've been collecting fresh ingredients from everywhere to make a great meal.",
            "nextDialogs": [
              "220140107"
            ]
          },
          "220140107": {
            "id": "220140107",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I've almost got enough ingredients, so I'm trying to figure out how to cook them.",
            "nextDialogs": [
              "220140108"
            ]
          },
          "220140108": {
            "id": "220140108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Where are Julie and Parvaneh?",
            "nextDialogs": [
              "220140109"
            ]
          },
          "220140109": {
            "id": "220140109",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Well, Parvaneh is out tracking down more ingredients for the \"ultimate seasoning\" that she wanted to make.",
            "nextDialogs": [
              "220140110"
            ]
          },
          "220140110": {
            "id": "220140110",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "She took Julie outdoors with her on that search... They said they wouldn't go too far from town, though, so don't worry.",
            "nextDialogs": [
              "220140111"
            ]
          },
          "220140111": {
            "id": "220140111",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "However, I do need your help with something. Although I have a lot of fresh ingredients, I don't have... the inspiration I need to make a breakthrough.",
            "nextDialogs": [
              "220140112"
            ]
          },
          "220140112": {
            "id": "220140112",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Look at these. Seagrass... Sea Ganoderma, and... uh, Sakura Bloom...",
            "nextDialogs": [
              "220140113"
            ]
          },
          "220140113": {
            "id": "220140113",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "They are quite fresh, but I have no idea where to start.",
            "nextDialogs": [
              "220140114"
            ]
          },
          "220140114": {
            "id": "220140114",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I was going to ask a local chef in Inazuma for advice. But if I did that, I'd end up with the usual Inazuma cuisine. It's nothing new.",
            "nextDialogs": [
              "220140115"
            ]
          },
          "220140115": {
            "id": "220140115",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "So I thought of using Inazuman ingredients like the chefs from Liyue. That way, I might be able to make something new and exciting.",
            "nextDialogs": [
              "220140116"
            ]
          },
          "220140116": {
            "id": "220140116",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Traveler, could you please go to Liyue and consult Chef Mao of the Wanmin Restaurant for me?"
          },
          "220140105": {
            "id": "220140105",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hahaha, that's exactly what I'm prepping for!"
          }
        }
      }
    },
    {
      "subId": "2201402",
      "subQuestName": "Go to Wanmin Restaurant",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220140201"
        ],
        "dialogs": {
          "220140201": {
            "id": "220140201",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Huh? Traveler, what are you doing here? Want me to whip something tasty up again?",
            "nextDialogs": [
              "220140202"
            ]
          },
          "220140202": {
            "id": "220140202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm actually here for your advice...",
            "nextDialogs": [
              "220140203"
            ]
          },
          "220140203": {
            "id": "220140203",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Xudong went to Inazuma to cook?... He really has quite a bit of determination.",
            "nextDialogs": [
              "220140204"
            ]
          },
          "220140204": {
            "id": "220140204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you know him?",
            "nextDialogs": [
              "220140205"
            ]
          },
          "220140205": {
            "id": "220140205",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Sort of. We had a cooking rivalry once, and it was... a stalemate.",
            "nextDialogs": [
              "220140206"
            ]
          },
          "220140206": {
            "id": "220140206",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "He said he wanted to travel the world looking for a breakthrough... I never thought he would actually do it.",
            "nextDialogs": [
              "220140207"
            ]
          },
          "220140207": {
            "id": "220140207",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Still, it looks like he's hit a wall...",
            "nextDialogs": [
              "220140209",
              "220140211"
            ]
          },
          "220140209": {
            "id": "220140209",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "I can't guarantee it will work, but I'll try my best.",
            "nextDialogs": [
              "220140214"
            ]
          },
          "220140214": {
            "id": "220140214",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Seagrass... Sea Ganoderma... and... Sakura Bloom? These are strange ingredients...",
            "nextDialogs": [
              "220140215"
            ]
          },
          "220140215": {
            "id": "220140215",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "If I took the Seagrass and Sea Ganoderma alone, I think I could make a dish... but we'll need some additional things.",
            "nextDialogs": [
              "220140216"
            ]
          },
          "220140216": {
            "id": "220140216",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Traveler, could you please go and find some Jueyun Chili and Fowl for me?"
          },
          "220140211": {
            "id": "220140211",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Xiangling... True, she's always been a very creative cook. Maybe she can figure out a solution.",
            "nextDialogs": [
              "220140212"
            ]
          },
          "220140212": {
            "id": "220140212",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "But she's gone to Qingce Village to pick bamboo shoots at the moment, so she isn't here. It'll take a while to find her.",
            "nextDialogs": [
              "220140213"
            ]
          },
          "220140213": {
            "id": "220140213",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Xudong must be waiting anxiously. Let me see if I can solve his problem."
          }
        }
      }
    },
    {
      "subId": "2201403",
      "subQuestName": "Give the Jueyun Chili and Fowl to Chef Mao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220140301"
        ],
        "dialogs": {
          "220140301": {
            "id": "220140301",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Have you gotten the Jueyun Chili and Fowl?"
          }
        }
      }
    },
    {
      "subId": "2201404",
      "subQuestName": "Speak to Chef Mao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220140401"
        ],
        "dialogs": {
          "220140401": {
            "id": "220140401",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "That should be enough. Hold on a moment. I'll see what I can do with these ingredients...",
            "nextDialogs": [
              "220140402"
            ]
          },
          "220140402": {
            "id": "220140402",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Done. Still, I feel like it's not all that different from the dishes I usually make...",
            "nextDialogs": [
              "220140403"
            ]
          },
          "220140403": {
            "id": "220140403",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Take this dish back to Xudong. Hopefully, it'll solve his problem..."
          }
        }
      }
    },
    {
      "subId": "2201405",
      "subQuestName": "Talk to Xudong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220140601"
        ],
        "dialogs": {
          "220140601": {
            "id": "220140601",
            "speakerId": 1012,
            "speakerName": "Xiangling",
            "text": "These bamboo shoots look pretty good. I'll dig some up...",
            "nextDialogs": [
              "220140602"
            ]
          },
          "220140602": {
            "id": "220140602",
            "speakerId": 1012,
            "speakerName": "Xiangling",
            "text": "Huh? It's you. What brings you here? Want me to whip something tasty up again?",
            "nextDialogs": [
              "220140607",
              "220140605"
            ]
          },
          "220140607": {
            "id": "220140607",
            "speakerId": 1012,
            "speakerName": "Xiangling",
            "text": "Oh. Handling ingredients from Inazuma using techniques from Liyue...",
            "nextDialogs": [
              "220140608"
            ]
          },
          "220140608": {
            "id": "220140608",
            "speakerId": 1012,
            "speakerName": "Xiangling",
            "text": "Hehe. You've come to the right chef! I've heard of an Inazuman technique where you wrap ingredients in flour and fry them.",
            "nextDialogs": [
              "220140609"
            ]
          },
          "220140609": {
            "id": "220140609",
            "speakerId": 1012,
            "speakerName": "Xiangling",
            "text": "It's called tempura and it's served with a special dipping sauce.",
            "nextDialogs": [
              "220140610"
            ]
          },
          "220140610": {
            "id": "220140610",
            "speakerId": 1012,
            "speakerName": "Xiangling",
            "text": "I was particularly interested in the dipping sauce when I tried making tempura.",
            "nextDialogs": [
              "220140615"
            ]
          },
          "220140615": {
            "id": "220140615",
            "speakerId": 1012,
            "speakerName": "Xiangling",
            "text": "I've tried so many ingredients: Whopperflower Nectar, Flaming Flower...",
            "nextDialogs": [
              "220140611"
            ]
          },
          "220140611": {
            "id": "220140611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is it made with Slime Condensate, by any chance?",
            "nextDialogs": [
              "220140612"
            ]
          },
          "220140612": {
            "id": "220140612",
            "speakerId": 1012,
            "speakerName": "Xiangling",
            "text": "No, no. Slime Condensate isn't appropriate for this dish.",
            "nextDialogs": [
              "220140616"
            ]
          },
          "220140616": {
            "id": "220140616",
            "speakerId": 1012,
            "speakerName": "Xiangling",
            "text": "Still, I prefer adding the powder from Electro Cicin wings to give it a more layered texture.",
            "nextDialogs": [
              "220140613"
            ]
          },
          "220140613": {
            "id": "220140613",
            "speakerId": 1012,
            "speakerName": "Xiangling",
            "text": "Just in case you forget, I'll write it down. Then you can show it to Xudong.",
            "nextDialogs": [
              "220140614"
            ]
          },
          "220140614": {
            "id": "220140614",
            "speakerId": 1012,
            "speakerName": "Xiangling",
            "text": "*sigh* I wish I could go to Inazuma. There must be so many ingredients I haven't used yet."
          },
          "220140605": {
            "id": "220140605",
            "speakerId": 1012,
            "speakerName": "Xiangling",
            "text": "Oh, you went to the restaurant? Hmm. But now that I've had another look, you don't look like you're here for a meal.",
            "nextDialogs": [
              "220140606"
            ]
          },
          "220140606": {
            "id": "220140606",
            "speakerId": 1012,
            "speakerName": "Xiangling",
            "text": "Are you having some culinary problems, then?"
          }
        }
      }
    },
    {
      "subId": "2201407",
      "subQuestName": "Talk to Xudong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220140701"
        ],
        "dialogs": {
          "220140701": {
            "id": "220140701",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Oh, you're back. What did Chef Mao say?"
          }
        }
      }
    },
    {
      "subId": "2201408",
      "subQuestName": "Talk to Xudong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220140801"
        ],
        "dialogs": {
          "220140801": {
            "id": "220140801",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "This dish... let me give it a try...",
            "nextDialogs": [
              "220140802"
            ]
          },
          "220140802": {
            "id": "220140802",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "The taste is great and the combination of the ingredients is also really good. As expected of Chef Mao.",
            "nextDialogs": [
              "220140803"
            ]
          },
          "220140803": {
            "id": "220140803",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "However, I still feel like it's missing a little something...",
            "nextDialogs": [
              "220140804"
            ]
          },
          "220140804": {
            "id": "220140804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The boom shaka-laka feeling, I suppose.",
            "nextDialogs": [
              "220140805"
            ]
          },
          "220140805": {
            "id": "220140805",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I don't know... *sigh* I'll think about it. At least Chef Mao has given me an idea.",
            "nextDialogs": [
              "220140806"
            ]
          },
          "220140806": {
            "id": "220140806",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Thank you for your help. Please take these.",
            "nextDialogs": [
              "220140807"
            ]
          },
          "220140807": {
            "id": "220140807",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "How on earth am I going to make a truly unique dish..."
          }
        }
      }
    },
    {
      "subId": "2201409",
      "subQuestName": "Talk to Xudong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220140901"
        ],
        "dialogs": {
          "220140901": {
            "id": "220140901",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Xiangling... wrote this? It must have been hard to find her. Thank you for your help.",
            "nextDialogs": [
              "220140903"
            ]
          },
          "220140903": {
            "id": "220140903",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Let's see... Whopperflower Nectar... Flaming Flower... and Electro Cicin wing powder...",
            "nextDialogs": [
              "220140904"
            ]
          },
          "220140904": {
            "id": "220140904",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Rather... unexpected, I must say.",
            "nextDialogs": [
              "220140905"
            ]
          },
          "220140905": {
            "id": "220140905",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I'll look into this... In the meantime, please take these as thanks.",
            "nextDialogs": [
              "220140906"
            ]
          },
          "220140906": {
            "id": "220140906",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Ahem... I better read these notes and put them away quickly. I can't let Parvaneh find them..."
          }
        }
      }
    },
    {

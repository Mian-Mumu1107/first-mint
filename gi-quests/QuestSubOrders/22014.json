            "speakerName": "Xudong",
            "text": "Oh, you're back. What did Chef Mao say?"
          }
        }
      }
    },
    {
      "subId": "2201410",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220141001"
        ],
        "dialogs": {
          "220141001": {
            "id": "220141001",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I sure hope Chef Mao has some good ideas..."
          }
        }
      }
    },
    {
      "subId": "2201499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220149901"
        ],
        "dialogs": {
          "220149901": {
            "id": "220149901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wanmin Restaurant... Paimon remembers that name. That's the restaurant Xiangling and her father run, right?",
            "nextDialogs": [
              "220149902"
            ]
          },
          "220149902": {
            "id": "220149902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It would be great if we could ask Xiangling for advice. She's really good at cooking.",
            "nextDialogs": [
              "220149903"
            ]
          },
          "220149903": {
            "id": "220149903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Who knows, we might even get something that's got that boom shaka-laka!"
          }
        }
      }
    }
  ]
}
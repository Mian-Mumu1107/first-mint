    {
      "subId": "46409",
      "subQuestName": "Talk to Huffman",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4641201"
        ],
        "dialogs": {
          "4641201": {
            "id": "4641201",
            "speakerId": 1009,
            "speakerName": "Huffman",
            "text": "Greetings. I thought I heard something, so I came to check it out.",
            "nextDialogs": [
              "4641202"
            ]
          },
          "4641202": {
            "id": "4641202",
            "speakerId": 1009,
            "speakerName": "Huffman",
            "text": "Did you see anything out of the ordinary?",
            "nextDialogs": [
              "4641203"
            ]
          },
          "4641203": {
            "id": "4641203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Nope. Nuh-uh. Not here. Nothing. Zilch.",
            "nextDialogs": [
              "4641204"
            ]
          },
          "4641204": {
            "id": "4641204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...Unless you're looking for the Darknight Hero, in which case—",
            "nextDialogs": [
              "4641207"
            ]
          },
          "4641207": {
            "id": "4641207",
            "speakerId": 1009,
            "speakerName": "Huffman",
            "text": "The Darknight Hero? You saw him?",
            "nextDialogs": [
              "4641208"
            ]
          },
          "4641208": {
            "id": "4641208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Oh, ahh... The Darknight Hero, is ahh... {M#him}{F#her}!",
            "nextDialogs": [
              "4641209"
            ]
          },
          "4641209": {
            "id": "4641209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "4641210"
            ]
          },
          "4641210": {
            "id": "4641210",
            "speakerId": 1009,
            "speakerName": "Huffman",
            "text": "You! The hero who safeguards Mondstadt from the shadows! On behalf of the Knights of Favonius, I thank you for your service to this city!",
            "nextDialogs": [
              "4641211"
            ]
          },
          "4641211": {
            "id": "4641211",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Heh... it's nothing, really... you're too kind...",
            "nextDialogs": [
              "4641212"
            ]
          },
          "4641212": {
            "id": "4641212",
            "speakerId": 1009,
            "speakerName": "Huffman",
            "text": "Wait a second... Aren't you the Traveler that just arrived in the city?",
            "nextDialogs": [
              "4641213"
            ]
          },
          "4641213": {
            "id": "4641213",
            "speakerId": 1009,
            "speakerName": "Huffman",
            "text": "Rumors were circulating about the Darknight Hero long before you ever arrived here.",
            "nextDialogs": [
              "4641214"
            ]
          },
          "4641214": {
            "id": "4641214",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh... Ah...",
            "nextDialogs": [
              "4641215"
            ]
          },
          "4641215": {
            "id": "4641215",
            "speakerId": 1009,
            "speakerName": "Huffman",
            "text": "...Why would you lie to me about that?"
          }
        }
      }
    },

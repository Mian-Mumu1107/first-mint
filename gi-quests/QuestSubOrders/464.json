  "subQuests": [
    {
      "subId": "46401",
      "subQuestName": "Ask Charles about the recent rumors",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4640101"
        ],
        "dialogs": {
          "4640101": {
            "id": "4640101",
            "speakerId": 1000,
            "speakerName": "Charles",
            "text": "So you've got a taste for adventure too, huh?",
            "nextDialogs": [
              "4640102"
            ]
          },
          "4640102": {
            "id": "4640102",
            "speakerId": 1000,
            "speakerName": "Charles",
            "text": "I must say, the patrons have been in a bit of a buzz lately.",
            "nextDialogs": [
              "4640103"
            ]
          },
          "4640103": {
            "id": "4640103",
            "speakerId": 1000,
            "speakerName": "Charles",
            "text": "Though the topic on everyone's lips is more of an urban legend than actual news.",
            "nextDialogs": [
              "4640104"
            ]
          },
          "4640104": {
            "id": "4640104",
            "speakerId": 1000,
            "speakerName": "Charles",
            "text": "Even minding my own business I still end up hearing all about it.",
            "nextDialogs": [
              "4640105"
            ]
          },
          "4640105": {
            "id": "4640105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh-oh... It's not one of those scary urban legends, is it?",
            "nextDialogs": [
              "4640106"
            ]
          },
          "4640106": {
            "id": "4640106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "If so, Paimon needs to take a deep breath first!",
            "nextDialogs": [
              "4640107"
            ]
          },
          "4640107": {
            "id": "4640107",
            "speakerId": 1000,
            "speakerName": "Charles",
            "text": "Hahaha, it's not a particularly scary story, no... At least, not for most people...",
            "nextDialogs": [
              "4640108"
            ]
          },
          "4640108": {
            "id": "4640108",
            "speakerId": 1000,
            "speakerName": "Charles",
            "text": "It's the tale of... the Darknight Hero!",
            "nextDialogs": [
              "4640109"
            ]
          },
          "4640109": {
            "id": "4640109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Argh!!!",
            "nextDialogs": [
              "4640111",
              "4640114"
            ]
          },
          "4640111": {
            "id": "4640111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Did the bartender just say something?",
            "nextDialogs": [
              "4640112"
            ]
          },
          "4640112": {
            "id": "4640112",
            "speakerId": 1000,
            "speakerName": "Charles",
            "text": "You weren't even listening?",
            "nextDialogs": [
              "4640116"
            ]
          },
          "4640116": {
            "id": "4640116",
            "speakerId": 1000,
            "speakerName": "Charles",
            "text": "Anyway, the Darknight Hero.",
            "nextDialogs": [
              "4640117"
            ]
          },
          "4640117": {
            "id": "4640117",
            "speakerId": 1000,
            "speakerName": "Charles",
            "text": "It is said that he appears in the middle of the night to fight evil and uphold justice.",
            "nextDialogs": [
              "4640118"
            ]
          },
          "4640118": {
            "id": "4640118",
            "speakerId": 1000,
            "speakerName": "Charles",
            "text": "But to be honest, I don't have much interest in such rumors.",
            "nextDialogs": [
              "4640119"
            ]
          },
          "4640119": {
            "id": "4640119",
            "speakerId": 1000,
            "speakerName": "Charles",
            "text": "Unless of course he can help take care of the more belligerent patrons after they've had a few too many...",
            "nextDialogs": [
              "4640120"
            ]
          },
          "4640120": {
            "id": "4640120",
            "speakerId": 1000,
            "speakerName": "Charles",
            "text": "I would happily take that as proof of his existence."
          },
          "4640114": {
            "id": "4640114",
            "speakerId": 1000,
            "speakerName": "Charles",
            "text": "Hey. Look, do you want to hear the story or not?",
            "nextDialogs": [
              "4640115"
            ]
          },
          "4640115": {
            "id": "4640115",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wha— What did the bartender just say?"
          }
        }
      }
    },
    {
      "subId": "46402",
      "subQuestName": "Ask the bystanders at the fountain plaza for information",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4640201"
        ],
        "dialogs": {
          "4640201": {
            "id": "4640201",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "You want to find out about the Darknight Hero?",
            "nextDialogs": [
              "4640202"
            ]
          },
          "4640202": {
            "id": "4640202",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "Look no further. It's me! I am the Darknight Hero.",
            "nextDialogs": [
              "4640204",
              "4640206"
            ]
          },
          "4640204": {
            "id": "4640204",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "*giggle* You're right, I'm not. I was joking.",
            "nextDialogs": [
              "4640207"
            ]
          },
          "4640207": {
            "id": "4640207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Huh...",
            "nextDialogs": [
              "4640208"
            ]
          },
          "4640208": {
            "id": "4640208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Heh...",
            "nextDialogs": [
              "4640209"
            ]
          },
          "4640209": {
            "id": "4640209",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "Heh. Jokes aside, I do think that the Darknight Hero and I have one thing in common.",
            "nextDialogs": [
              "4640210"
            ]
          },
          "4640210": {
            "id": "4640210",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What's that?",
            "nextDialogs": [
              "4640211"
            ]
          },
          "4640211": {
            "id": "4640211",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "It's... the way he sticks to his principles... coming out here night after night, fighting for justice, keeping Mondstadt safe...",
            "nextDialogs": [
              "4640212"
            ]
          },
          "4640212": {
            "id": "4640212",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, so you're a nocturnal vigilante too?",
            "nextDialogs": [
              "4640213"
            ]
          },
          "4640213": {
            "id": "4640213",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "N—No, I just mean, he must be seriously rich.",
            "nextDialogs": [
              "4640214"
            ]
          },
          "4640214": {
            "id": "4640214",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why is that?",
            "nextDialogs": [
              "4640215"
            ]
          },
          "4640215": {
            "id": "4640215",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "People only start worrying about spiritual fulfillment once they have enough material wealth.",
            "nextDialogs": [
              "4640216"
            ]
          },
          "4640216": {
            "id": "4640216",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "It's the same in every hero story, isn't it?",
            "nextDialogs": [
              "4640217"
            ]
          },
          "4640217": {
            "id": "4640217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So... you just wanted to flaunt your wealth.",
            "nextDialogs": [
              "4640218"
            ]
          },
          "4640218": {
            "id": "4640218",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "Heh. No, it's nothing like that. I just have too much time on my hands these days.",
            "nextDialogs": [
              "4640219"
            ]
          },
          "4640219": {
            "id": "4640219",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Same difference, you are the boss of the Cat's Tail after all...",
            "nextDialogs": [
              "4640220"
            ]
          },
          "4640220": {
            "id": "4640220",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "Why don't you ask the guards at the <color=#00E1FFFF>city gate</color>?",
            "nextDialogs": [
              "4640221"
            ]
          },
          "4640221": {
            "id": "4640221",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "They do night shifts all the time, they must know something."
          },
          "4640206": {
            "id": "4640206",
            "speakerId": 1002,
            "speakerName": "Margaret",
            "text": "...I'm joking. Don't take everything so seriously."
          }
        }
      }
    },
    {
      "subId": "46403",
      "subQuestName": "Ask the guards around the city gate for information",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4640301"
        ],
        "dialogs": {
          "4640301": {
            "id": "4640301",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "You want to know about... him?",
            "nextDialogs": [
              "4640302"
            ]
          },
          "4640302": {
            "id": "4640302",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "In fact, I'm one of the few who has seen him with my own two eyes.",
            "nextDialogs": [
              "4640303"
            ]
          },
          "4640303": {
            "id": "4640303",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Great! This is the guy we need to talk to.",
            "nextDialogs": [
              "4640304"
            ]
          },
          "4640304": {
            "id": "4640304",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So... just who is the Darknight Hero?",
            "nextDialogs": [
              "4640305"
            ]
          },
          "4640305": {
            "id": "4640305",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "Whoa— S—Slow down, let me start from the beginning.",
            "nextDialogs": [
              "4640306"
            ]
          },
          "4640306": {
            "id": "4640306",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "Well, I was patrolling one night, when suddenly I heard something. I rushed over to check it out.",
            "nextDialogs": [
              "4640307"
            ]
          },
          "4640307": {
            "id": "4640307",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "I saw a gang of suspicious-looking fellows who looked like they were up to no good.",
            "nextDialogs": [
              "4640308"
            ]
          },
          "4640308": {
            "id": "4640308",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "So I quickly hid.",
            "nextDialogs": [
              "4640309"
            ]
          },
          "4640309": {
            "id": "4640309",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hid? You're supposed to be a guard!",
            "nextDialogs": [
              "4640310"
            ]
          },
          "4640310": {
            "id": "4640310",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "That was when... he appeared.",
            "nextDialogs": [
              "4640311"
            ]
          },
          "4640311": {
            "id": "4640311",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "He was dressed in black from head to toe, perfectly hidden in the night.",
            "nextDialogs": [
              "4640312"
            ]
          },
          "4640312": {
            "id": "4640312",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "The way he crept up on those bad guys, it must have felt like a living nightmare.",
            "nextDialogs": [
              "4640313"
            ]
          },
          "4640313": {
            "id": "4640313",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow...",
            "nextDialogs": [
              "4640314"
            ]
          },
          "4640314": {
            "id": "4640314",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "Guess what I did next?",
            "nextDialogs": [
              "4640316",
              "4640319"
            ]
          },
          "4640316": {
            "id": "4640316",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "I wasn't the bad guy! Why would I need to run away?",
            "nextDialogs": [
              "4640317"
            ]
          },
          "4640317": {
            "id": "4640317",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "...Still, I did leave the scene. I didn't want to be a nuisance to the Darknight Hero.",
            "nextDialogs": [
              "4640320"
            ]
          },
          "4640320": {
            "id": "4640320",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "...So instead, I headed to the Knights of Favonius' residence.",
            "nextDialogs": [
              "4640321"
            ]
          },
          "4640321": {
            "id": "4640321",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You think the Darknight Hero might be one of the Knights?",
            "nextDialogs": [
              "4640322"
            ]
          },
          "4640322": {
            "id": "4640322",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "Correct. I thought, \"Surely someone with such a strong sense of justice and who voluntarily protects Mondstadt is exactly the kind of person you'd find in the Knights of Favonius.\"",
            "nextDialogs": [
              "4640323"
            ]
          },
          "4640323": {
            "id": "4640323",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "*sigh* But it seems I was wrong.",
            "nextDialogs": [
              "4640324"
            ]
          },
          "4640324": {
            "id": "4640324",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "I checked everywhere, and there were no signs of anyone having left the building.",
            "nextDialogs": [
              "4640325"
            ]
          },
          "4640325": {
            "id": "4640325",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So you're saying whoever it is can't be from the Knights of Favonius after all?",
            "nextDialogs": [
              "4640326"
            ]
          },
          "4640326": {
            "id": "4640326",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "Yes. But I just can't understand... Why would someone like that not want to join the Knights?",
            "nextDialogs": [
              "4640327"
            ]
          },
          "4640327": {
            "id": "4640327",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "I'm sure they would warmly welcome someone of his abilities.",
            "nextDialogs": [
              "4640328"
            ]
          },
          "4640328": {
            "id": "4640328",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So the point you're trying to make is... You don't know who the Darknight Hero is either?",
            "nextDialogs": [
              "4640329"
            ]
          },
          "4640329": {
            "id": "4640329",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "Hey, don't be like that! At least by talking to me you've ruled out a few more people...",
            "nextDialogs": [
              "4640330"
            ]
          },
          "4640330": {
            "id": "4640330",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "Anyway, try asking at the <color=#00E1FFFF>Flower Shop</color>. I heard a girl there's been talking about the time he rescued her."
          },
          "4640319": {
            "id": "4640319",
            "speakerId": 1003,
            "speakerName": "Lawrence",
            "text": "Heh... I would probably have just gotten in the way as far as the Darknight Hero is concerned."
          }
        }
      }
    },
    {
      "subId": "46404",
      "subQuestName": "Ask the preoccupied girl for information",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4640401"
        ],
        "dialogs": {
          "4640401": {
            "id": "4640401",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "What's wrong with me...",
            "nextDialogs": [
              "4640402"
            ]
          },
          "4640402": {
            "id": "4640402",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "Why can't I get him out of my mind...",
            "nextDialogs": [
              "4640403"
            ]
          },
          "4640403": {
            "id": "4640403",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ah, hello? We'd like to ask you about the Darknight Hero—",
            "nextDialogs": [
              "4640404"
            ]
          },
          "4640404": {
            "id": "4640404",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "MY HERO! ...Oh, sorry! Just hearing his name gets me lost in thought... Hang on, how did you know who I was talking about?",
            "nextDialogs": [
              "4640405"
            ]
          },
          "4640405": {
            "id": "4640405",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "Is it that obvious?",
            "nextDialogs": [
              "4640406"
            ]
          },
          "4640406": {
            "id": "4640406",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "Oh no, what am I going to do...? If Master Diluc ever finds out—",
            "nextDialogs": [
              "4640407"
            ]
          },
          "4640407": {
            "id": "4640407",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? What's Diluc got to do with this?",
            "nextDialogs": [
              "4640408"
            ]
          },
          "4640408": {
            "id": "4640408",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "Ugh... Well, I guess I might as well spill the beans then.",
            "nextDialogs": [
              "4640409"
            ]
          },
          "4640409": {
            "id": "4640409",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "I used to think Diluc was the one for me.",
            "nextDialogs": [
              "4640410"
            ]
          },
          "4640410": {
            "id": "4640410",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "But ever since the time I was rescued by the Darknight Hero... I—I just don't know anymore...",
            "nextDialogs": [
              "4640411"
            ]
          },
          "4640411": {
            "id": "4640411",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wowee, you saw the Darknight Hero? For real? What's he like?",
            "nextDialogs": [
              "4640412"
            ]
          },
          "4640412": {
            "id": "4640412",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "It all happened so fast... I was so scared...",
            "nextDialogs": [
              "4640413"
            ]
          },
          "4640413": {
            "id": "4640413",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "All I remember is seeing a flash of fire... but I felt safe. I only saw his silhouette but it felt so... familiar.",
            "nextDialogs": [
              "4640415",
              "4640418"
            ]
          },
          "4640415": {
            "id": "4640415",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "Who knows? Now that you mention it, a Pyro Vision does seem like a good explanation.",
            "nextDialogs": [
              "4640416"
            ]
          },
          "4640416": {
            "id": "4640416",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "It lit up the whole area in an instant. I remember that very well.",
            "nextDialogs": [
              "4640421"
            ]
          },
          "4640421": {
            "id": "4640421",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oookay then! Well, thanks for the intel Donna. See you around!",
            "nextDialogs": [
              "4640422"
            ]
          },
          "4640422": {
            "id": "4640422",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So, based on what we know so far...",
            "nextDialogs": [
              "4640423"
            ]
          },
          "4640423": {
            "id": "4640423",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "All we need to do is find a wealthy, Vision-wielding vigilante who is not one of the Knights.",
            "nextDialogs": [
              "4640424"
            ]
          },
          "4640424": {
            "id": "4640424",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... Nope, still no idea.",
            "nextDialogs": [
              "4640425"
            ]
          },
          "4640425": {
            "id": "4640425",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But we already asked so many people. Guess we got to see for ourselves.",
            "nextDialogs": [
              "4640426"
            ]
          },
          "4640426": {
            "id": "4640426",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's take a look around the city at nighttime — if we're lucky, we just might bump into him."
          },
          "4640418": {
            "id": "4640418",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "Hmm... That I really do not know.",
            "nextDialogs": [
              "4640419"
            ]
          },
          "4640419": {
            "id": "4640419",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "Perhaps it was... fate?",
            "nextDialogs": [
              "4640420"
            ]
          },
          "4640420": {
            "id": "4640420",
            "speakerId": 1004,
            "speakerName": "Donna",
            "text": "You know? When you meet someone and it feels like... like you've known them your whole life?"
          }
        }
      }
    },
    {
      "subId": "46405",
      "subQuestName": "Wander Mondstadt at night (18:00 – 06:00)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4640501"
        ],
        "dialogs": {
          "4640501": {
            "id": "4640501",
            "speakerId": 1005,
            "speakerName": "Diluc",
            "text": "After managing to steer clear of the guards' patrol route... I never anticipated I'd run into you instead.",
            "nextDialogs": [
              "4640504"
            ]
          },
          "4640504": {
            "id": "4640504",
            "speakerId": 1005,
            "speakerName": "Diluc",
            "text": "\"Darknight Hero...\"? Sounds awfully derivative to me. Please tell me you didn't come up with that.",
            "nextDialogs": [
              "4640505"
            ]
          },
          "4640505": {
            "id": "4640505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "How is this the first you've heard of the name? Every man and his dog in Mondstadt is yapping about the Darknight Hero!",
            "nextDialogs": [
              "4640506"
            ]
          },
          "4640506": {
            "id": "4640506",
            "speakerId": 1005,
            "speakerName": "Diluc",
            "text": "I do not concern myself with idle chatter... Though, I suppose I may take the idleness of others as a sign that peace prevails.",
            "nextDialogs": [
              "4640507"
            ]
          },
          "4640507": {
            "id": "4640507",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huzzah! The Great Mystery of the Darknight Hero of Mondstadt... We solved it!",
            "nextDialogs": [
              "4640508"
            ]
          },
          "4640508": {
            "id": "4640508",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Now then, Mr. Darknight Hero—",
            "nextDialogs": [
              "4640509"
            ]
          },
          "4640509": {
            "id": "4640509",
            "speakerId": 1005,
            "speakerName": "Diluc",
            "text": "Please, stop calling me that. Seriously, it makes me uncomfortable.",
            "nextDialogs": [
              "4640510"
            ]
          },
          "4640510": {
            "id": "4640510",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hah, not surprised. It's the stupidest superhero name Paimon's ever heard. You should come up with something more original.",
            "nextDialogs": [
              "4640552"
            ]
          },
          "4640552": {
            "id": "4640552",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Like...",
            "nextDialogs": [
              "4640553"
            ]
          },
          "4640553": {
            "id": "4640553",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Emm... \"Captain Pie...\"",
            "nextDialogs": [
              "4640554"
            ]
          },
          "4640554": {
            "id": "4640554",
            "speakerId": 1005,
            "speakerName": "Diluc",
            "text": "Pie?",
            "nextDialogs": [
              "4640555"
            ]
          },
          "4640555": {
            "id": "4640555",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pie?",
            "nextDialogs": [
              "4640556"
            ]
          },
          "4640556": {
            "id": "4640556",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Captain Pyro!",
            "nextDialogs": [
              "4640557"
            ]
          },
          "4640557": {
            "id": "4640557",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Tell us Captain Pyro, what happened here today?",
            "nextDialogs": [
              "4640511"
            ]
          },
          "4640511": {
            "id": "4640511",
            "speakerId": 1005,
            "speakerName": "Diluc",
            "text": "...",
            "nextDialogs": [
              "4640512"
            ]
          },
          "4640512": {
            "id": "4640512",
            "speakerId": 1005,
            "speakerName": "Diluc",
            "text": "It was the Abyss Order.",
            "nextDialogs": [
              "4640513"
            ]
          },
          "4640513": {
            "id": "4640513",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Them again?",
            "nextDialogs": [
              "4640514"
            ]
          },
          "4640514": {
            "id": "4640514",
            "speakerId": 1005,
            "speakerName": "Diluc",
            "text": "I don't know what the devil they're plotting this time. It seems they're performing some initial reconnaissance.",
            "nextDialogs": [
              "4640515"
            ]
          },
          "4640515": {
            "id": "4640515",
            "speakerId": 1005,
            "speakerName": "Diluc",
            "text": "Considering that I've proven myself to be one step ahead of them on countless occasions, their persistence is... unusual."
          }
        }
      }
    },

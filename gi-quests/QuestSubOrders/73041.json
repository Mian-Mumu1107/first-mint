            ]
          },
          "730410603": {
            "id": "730410603",
            "speakerId": 1001,
            "speakerName": "Aranishat",
            "text": "Wah... All weak. Only Golden Nara is strong...",
            "nextDialogs": [
              "730410604"
            ]
          },
          "730410604": {
            "id": "730410604",
            "speakerId": 1000,
            "speakerName": "Aralila",
            "text": "This is bad! Must train Ararakalari. With very strong Ararakalari, Nara friend won't be able to find me!",
            "nextDialogs": [

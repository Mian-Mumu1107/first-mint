            ]
          },
          "730410606": {
            "id": "730410606",
            "speakerId": 1000,
            "speakerName": "Aralila",
            "text": "Are you afraid of losing? There's no need to care about winning or losing when playing games!",
            "nextDialogs": [
              "730410609"
            ]
          },
          "730410609": {
            "id": "730410609",
            "speakerId": 1000,
            "speakerName": "Aralila",
            "text": "Even though I lost, I had fun. Golden Nara is a good Nara after all.",
            "nextDialogs": [
              "730410610"
            ]
          },
          "730410610": {
            "id": "730410610",
            "speakerId": 1001,
            "speakerName": "Aranishat",
            "text": "Our Nara friend wins. Awesome! Please take our flowers!",
            "nextDialogs": [
              "730410611"
            ]
          },
          "730410611": {
            "id": "730410611",
            "speakerId": 1000,
            "speakerName": "Aralila",
            "text": "Thank you, good Nara! You are a good friend!"
          },
          "730410608": {
            "id": "730410608",
            "speakerId": 1001,
            "speakerName": "Aranishat",
            "text": "Yeah! I won't lose next time!"
          }
        }
      }

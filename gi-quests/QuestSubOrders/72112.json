    {
      "subId": "7211220",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130701"
        ],
        "dialogs": {
          "721130701": {
            "id": "721130701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ms. Gendou's attitude is the same as ever, huh... Anyway, let's check the slip's contents.",
            "nextDialogs": [
              "721130702"
            ]
          },
          "721130702": {
            "id": "721130702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? This is...",
            "nextDialogs": [
              "721130703"
            ]
          },
          "721130703": {
            "id": "721130703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, Paimon gets it. This must refer to some bad guy who needs defeating!",
            "nextDialogs": [
              "721130704"
            ]
          },
          "721130704": {
            "id": "721130704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, that's gotta be it. So, Ms. Gendou, you're a secret agent who's using this method to communicate and wipe out those who try to harm Inazuma, right?",
            "nextDialogs": [
              "721130705"
            ]
          },
          "721130705": {
            "id": "721130705",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "You talk too much.",
            "nextDialogs": [
              "721130706"
            ]
          },
          "721130706": {
            "id": "721130706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Welp! S-sorry! Please don't sic the \"Shuumatsu\" on us!",
            "nextDialogs": [
              "721130707"
            ]
          },
          "721130707": {
            "id": "721130707",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Leave now.",
            "nextDialogs": [
              "721130708"
            ]
          },
          "721130708": {
            "id": "721130708",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're leaving right now! Let's go to the place shown in the picture and see if we can find our target!"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7211235",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721123501"
        ],
        "dialogs": {
          "721123501": {
            "id": "721123501",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "You want a fortune slip?",
            "nextDialogs": [
              "721123502"
            ]
          },
          "721123502": {
            "id": "721123502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Geez, she's so cold.",
            "nextDialogs": [
              "721123503"
            ]
          },
          "721123503": {
            "id": "721123503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, I'd like one...",
            "nextDialogs": [
              "721123504"
            ]
          },
          "721123504": {
            "id": "721123504",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Got it. Here's how it goes. First, shake this... thing over here.",
            "nextDialogs": [
              "721123505"
            ]
          },
          "721123505": {
            "id": "721123505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Isn't it called a Fortune Slip Box?",
            "nextDialogs": [
              "721123506"
            ]
          },
          "721123506": {
            "id": "721123506",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Yes. A Bamboo Slip will drop out from it. Give it to me, and I'll give you a matching strip of paper.",
            "nextDialogs": [
              "721123507"
            ]
          },
          "721123507": {
            "id": "721123507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm pretty sure they say it's a Fortune Slip...",
            "nextDialogs": [
              "721123508"
            ]
          },
          "721123508": {
            "id": "721123508",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Whatever.",
            "nextDialogs": [
              "721123509"
            ]
          },
          "721123509": {
            "id": "721123509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's got a question! If... What do we do if we get one that means bad luck?",
            "nextDialogs": [
              "721123510"
            ]
          },
          "721123510": {
            "id": "721123510",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "It's fate. You got a problem with that? Huh?",
            "nextDialogs": [
              "721123511"
            ]
          },
          "721123511": {
            "id": "721123511",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh!?",
            "nextDialogs": [
              "721123512"
            ]
          },
          "721123512": {
            "id": "721123512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Isn't there that shelf-like thing outside we can use to...",
            "nextDialogs": [
              "721123513"
            ]
          },
          "721123513": {
            "id": "721123513",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Tsk.",
            "nextDialogs": [
              "721123514"
            ]
          },
          "721123514": {
            "id": "721123514",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did she seriously just say \"tsk\"?",
            "nextDialogs": [
              "721123515"
            ]
          },
          "721123515": {
            "id": "721123515",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Let me see... Oh right, so it's like this. \"Tie the inauspicious slip onto the Fortune Slip Hanger to change ill fortune to good\"...",
            "nextDialogs": [
              "721123516"
            ]
          },
          "721123516": {
            "id": "721123516",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Ah, right! If you get a slip with ill fortune, just tie it to that shelf, that'll do.",
            "nextDialogs": [
              "721123517"
            ]
          },
          "721123517": {
            "id": "721123517",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Huh, what a bunch of... No, sorry. We at the Grand Narukami Shrine are most gentle indeed. Even if you should draw a slip with bad luck, you shall have a chance to turn it around.",
            "nextDialogs": [
              "721123518"
            ]
          },
          "721123518": {
            "id": "721123518",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Something about this doesn't seem right...",
            "nextDialogs": [
              "721123519"
            ]
          },
          "721123519": {
            "id": "721123519",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Let's go draw a slip, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "7211236",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721123601"
        ],
        "dialogs": {
          "721123601": {
            "id": "721123601",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Give me that bamboo slip.",
            "nextDialogs": [
              "721123602"
            ]
          },
          "721123602": {
            "id": "721123602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "R—Right.",
            "nextDialogs": [
              "721123603"
            ]
          },
          "721123603": {
            "id": "721123603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This shrine really seems to lack the whole divine affection thing, huh...",
            "nextDialogs": [
              "721123604"
            ]
          },
          "721123604": {
            "id": "721123604",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Here.",
            "nextDialogs": [
              "721123605"
            ]
          },
          "721123605": {
            "id": "721123605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's see how our luck's going...",
            "nextDialogs": [
              "721123606"
            ]
          },
          "721123606": {
            "id": "721123606",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Ah, yes. You can only draw one fortune slip each day. Please remember that.",
            "nextDialogs": [
              "721123607"
            ]
          },
          "721123607": {
            "id": "721123607",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "It's too tiring otherwise... Wait, no. If not, you won't be able to use the Fortune Slip Hanger to... No, that's not right either. What was I supposed to say?",
            "nextDialogs": [
              "721123608"
            ]
          },
          "721123608": {
            "id": "721123608",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "\"Fortune slips are the manifestation of our archon's will. It is our place as mortals to respect it and do all we can.\"",
            "nextDialogs": [
              "721123609"
            ]
          },
          "721123609": {
            "id": "721123609",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "See? Elegantly put. So please remember, you can only draw one fortune slip each day."
          }
        }
      }
    },
    {
      "subId": "7211215",

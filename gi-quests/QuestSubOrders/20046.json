  "subQuests": [
    {
      "subId": "2004601",
      "subQuestName": "Talk to Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200460101"
        ],
        "dialogs": {
          "200460101": {
            "id": "200460101",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Alright. Let's work hard today, too!",
            "nextDialogs": [
              "200460103",
              "200460107"
            ]
          },
          "200460103": {
            "id": "200460103",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Of course! Being an adventurer is really interesting!",
            "nextDialogs": [
              "200460104"
            ]
          },
          "200460104": {
            "id": "200460104",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Well... I still am a bit unfamiliar with what to do while undertaking commissions, though.",
            "nextDialogs": [
              "200460105"
            ]
          },
          "200460105": {
            "id": "200460105",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Traveler, would you mind coming with me again? I still have things I'd like to ask you.",
            "nextDialogs": [
              "200460108"
            ]
          },
          "200460108": {
            "id": "200460108",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Then let's set out. Today's commission is...",
            "nextDialogs": [
              "200460109"
            ]
          },
          "200460109": {
            "id": "200460109",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Huh... So we're escorting... another transport balloon."
          },
          "200460107": {
            "id": "200460107",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Would you? Hehe, sure! There's still so much I could learn from you."
          }
        }
      }
    },
    {
      "subId": "2004602",
      "subQuestName": "Go with Anna to complete her Adventurers' Guild commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200460201"
        ],
        "dialogs": {
          "200460201": {
            "id": "200460201",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "And we're done! Thanks, Traveler. This went pretty well, I think.",
            "nextDialogs": [
              "200460202"
            ]
          },
          "200460202": {
            "id": "200460202",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "But is this the usual fare for adventurers?",
            "nextDialogs": [
              "200460204",
              "200460206"
            ]
          },
          "200460204": {
            "id": "200460204",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "What's with that hapless tone...",
            "nextDialogs": [
              "200460207"
            ]
          },
          "200460207": {
            "id": "200460207",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Is that so... Nice! I'll keep working at it, then!",
            "nextDialogs": [
              "200460208"
            ]
          },
          "200460208": {
            "id": "200460208",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Once I've saved up enough Mora, I'll bring my brother and our parents out on a trip!",
            "nextDialogs": [
              "200460209"
            ]
          },
          "200460209": {
            "id": "200460209",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "My brother always wanted to travel... But I fell ill, and he had to stay back to take care of me.",
            "nextDialogs": [
              "200460210"
            ]
          },
          "200460210": {
            "id": "200460210",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "But I'm well now, and I've even become an adventurer.",
            "nextDialogs": [
              "200460211"
            ]
          },
          "200460211": {
            "id": "200460211",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Hehe. When the time comes, I'll help my brother fulfill some of his dreams too!"
          },
          "200460206": {
            "id": "200460206",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Hey, not that tired look..."
          }
        }
      }
    },
    {
      "subId": "2004603",
      "subQuestName": "Go with Anna to complete her Adventurers' Guild commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200460301"
        ],
        "dialogs": {
          "200460301": {
            "id": "200460301",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Please take care of Anna, Traveler. Her excitement might have gotten to her head lately...",
            "nextDialogs": [
              "200460302"
            ]
          },
          "200460302": {
            "id": "200460302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you not want her to become an adventurer?",
            "nextDialogs": [
              "200460303"
            ]
          },
          "200460303": {
            "id": "200460303",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "...",
            "nextDialogs": [
              "200460304"
            ]
          },
          "200460304": {
            "id": "200460304",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "I respect my sister's wishes.",
            "nextDialogs": [
              "200460305"
            ]
          },
          "200460305": {
            "id": "200460305",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Now that she's well again after such a long struggle with her illness, she deserves a chance to pursue her dreams.",
            "nextDialogs": [
              "200460306"
            ]
          },
          "200460306": {
            "id": "200460306",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "As her brother, I'll support her... all the way.",
            "nextDialogs": [
              "200460307"
            ]
          },
          "200460307": {
            "id": "200460307",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "That's all I have to say."
          }
        }
      }
    },

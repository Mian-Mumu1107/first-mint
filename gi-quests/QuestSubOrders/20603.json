    {
      "subId": "2060304",
      "subQuestName": "Check the suspicious location and eliminate any threats",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "206030401"
        ],
        "dialogs": {
          "206030401": {
            "id": "206030401",
            "speakerId": 1409,
            "speakerName": "Cyrus",
            "text": "A signboard blown away by the wind... Flowers blown away by the wind... A lost cat... *sigh* It is as I expected..."
          }
        }
      }
    },
    {
      "subId": "2060305",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "206030501"
        ],
        "dialogs": {
          "206030501": {
            "id": "206030501",
            "speakerId": 1409,
            "speakerName": "Cyrus",
            "text": "Back so soon? Well then, I suppose nothing serious is happening...",
            "nextDialogs": [
              "206030502"
            ]
          },
          "206030502": {
            "id": "206030502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No, there's still a lot of monster activity.",
            "nextDialogs": [
              "206030503"
            ]
          },
          "206030503": {
            "id": "206030503",
            "speakerId": 1409,
            "speakerName": "Cyrus",
            "text": "What? There are still monsters wandering around, and in even greater numbers than before?",
            "nextDialogs": [
              "206030504"
            ]
          },
          "206030504": {
            "id": "206030504",
            "speakerId": 1409,
            "speakerName": "Cyrus",
            "text": "That's strange. Wasn't the large force that attacked Mondstadt defeated previously? Why are they still skulking about in the area?",
            "nextDialogs": [
              "206030505"
            ]
          },
          "206030505": {
            "id": "206030505",
            "speakerId": 1409,
            "speakerName": "Cyrus",
            "text": "Could they have some other plans? ...I must gather the adventurers and re-issue our commissions. We cannot take these monsters lightly.",
            "nextDialogs": [
              "206030506"
            ]
          },
          "206030506": {
            "id": "206030506",
            "speakerId": 1409,
            "speakerName": "Cyrus",
            "text": "Conducting careful investigations into the activities of monsters in the wild falls within the purview of the Adventurers' Guild. It's time to show everyone what we're made of!",
            "nextDialogs": [
              "206030507"
            ]
          },
          "206030507": {
            "id": "206030507",
            "speakerId": 1409,
            "speakerName": "Cyrus",
            "text": "Ah, yes. Please take these as thanks for you efforts."
          }
        }
      }
    },

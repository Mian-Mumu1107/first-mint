    {
      "subId": "7052001",
      "subQuestName": "Go back to the shop and check how the charity event is going",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705200101"
        ],
        "dialogs": {
          "705200101": {
            "id": "705200101",
            "speakerId": 1000,
            "speakerName": "Bernhard",
            "text": "Honorary Knight, Paimon! Good news! We have some new helpers!",
            "nextDialogs": [
              "705200102"
            ]
          },
          "705200102": {
            "id": "705200102",
            "speakerId": 1000,
            "speakerName": "Bernhard",
            "text": "These two store owners heard about our charity sale. They want to donate their earnings and join us.",
            "nextDialogs": [
              "705200103"
            ]
          },
          "705200103": {
            "id": "705200103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What? A donation? Are you sure?",
            "nextDialogs": [
              "705200104"
            ]
          },
          "705200104": {
            "id": "705200104",
            "speakerId": 1002,
            "speakerName": "Mats",
            "text": "Absolutely!",
            "nextDialogs": [
              "705200105"
            ]
          },
          "705200105": {
            "id": "705200105",
            "speakerId": 1002,
            "speakerName": "Mats",
            "text": "Each extra donation means one extra person getting the help they need. Both Pauline and I think that's more important than us making more money than we technically need.",
            "nextDialogs": [
              "705200106"
            ]
          },
          "705200106": {
            "id": "705200106",
            "speakerId": 1003,
            "speakerName": "Pauline",
            "text": "This year's Weinlesefest is busier than previous years, so we met our target earnings more quickly than we expected. That's enough for us.",
            "nextDialogs": [
              "705200107"
            ]
          },
          "705200107": {
            "id": "705200107",
            "speakerId": 1003,
            "speakerName": "Pauline",
            "text": "It doesn't seem right to leave the important task of caring for our most vulnerable to you alone. We just want to help however we can. Please, it's the least we can do.",
            "nextDialogs": [
              "705200108"
            ]
          },
          "705200108": {
            "id": "705200108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We are extremely grateful.",
            "nextDialogs": [
              "705200109"
            ]
          },
          "705200109": {
            "id": "705200109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah! Ahh, this is the warmest, fuzziest feeling ever...",
            "nextDialogs": [
              "705200110"
            ]
          },
          "705200110": {
            "id": "705200110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm, but this does mean that we'll have to change the name of our shop! Uhh, how about... Favonian Goodies and Buddies.",
            "nextDialogs": [
              "705200113"
            ]
          },
          "705200113": {
            "id": "705200113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Alright, let's give this all we've got and make this a charity event to remember!",
            "nextDialogs": [
              "705200114"
            ]
          },
          "705200114": {
            "id": "705200114",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "With two new staff, the scale of the charity sale grows...",
            "nextDialogs": [
              "705200115"
            ]
          },
          "705200115": {
            "id": "705200115",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Over here for snacks, fresh flowers, and general goods! Folks, grab bargains at Favonian Goodies and Buddies!",
            "nextDialogs": [
              "705200116"
            ]
          },
          "705200116": {
            "id": "705200116",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Hey, look, it's Albedo!",
            "nextDialogs": [
              "705200117"
            ]
          },
          "705200117": {
            "id": "705200117",
            "speakerId": 1005,
            "speakerName": "Albedo",
            "text": "Hello there."
          }
        }
      }
    },

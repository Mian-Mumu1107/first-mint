  "subQuests": [
    {
      "subId": "4133501",
      "subQuestName": "Talk to Vermeer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413350101"
        ],
        "dialogs": {
          "413350101": {
            "id": "413350101",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "No this isn't right, and that's not right either...",
            "nextDialogs": [
              "413350102"
            ]
          },
          "413350102": {
            "id": "413350102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "413350103"
            ]
          },
          "413350103": {
            "id": "413350103",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Oh, hello. I'm just here collecting some materials.",
            "nextDialogs": [
              "413350104"
            ]
          },
          "413350104": {
            "id": "413350104",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Given that the Lantern Rite festival is already in full swing, I was thinking about how I could create a painting that depicts Liyue Harbor during the festival.",
            "nextDialogs": [
              "413350105"
            ]
          },
          "413350105": {
            "id": "413350105",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "*sigh* Maybe it's a problem with my technique or something, but no matter what I do, the painting just doesn't feel right.",
            "nextDialogs": [
              "413350106"
            ]
          },
          "413350106": {
            "id": "413350106",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Maybe a change of scenery would give me more inspiration, but I can't seem to find anywhere better...",
            "nextDialogs": [
              "413350107"
            ]
          },
          "413350107": {
            "id": "413350107",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Traveler, do you know of any scenic spots that would be suitable for painting?",
            "nextDialogs": [
              "413350108"
            ]
          },
          "413350108": {
            "id": "413350108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll have a look around!",
            "nextDialogs": [
              "413350109"
            ]
          },
          "413350109": {
            "id": "413350109",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Oh, good. Let's have a look together then. Maybe we'll be able to find a nice scenic spot."
          }
        }
      }
    },
    {
      "subId": "4133502",
      "subQuestName": "Look for suitable scenery",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4133503",
      "subQuestName": "Talk to Qingzhou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413350301"
        ],
        "dialogs": {
          "413350301": {
            "id": "413350301",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Now here's a good view of the landscape... Oh, who's this?",
            "nextDialogs": [
              "413350302"
            ]
          },
          "413350302": {
            "id": "413350302",
            "speakerId": 1001,
            "speakerName": "Qingzhou",
            "text": "My name is Qingzhou, my liege. I might add that I consider myself a poet, if I may be so bold. And you are...",
            "nextDialogs": [
              "413350303"
            ]
          },
          "413350303": {
            "id": "413350303",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Ah, so you're a poet? Haha. Well, I'm a painter and I'm looking for some scenic spots nearby to help give me some inspiration.",
            "nextDialogs": [
              "413350304"
            ]
          },
          "413350304": {
            "id": "413350304",
            "speakerId": 1001,
            "speakerName": "Qingzhou",
            "text": "Inspiration, you say? Why, this is quite a coincidence. I myself am also seeking a stroke of inspiration. May I be so bold as to ask the purpose for which you seek to be inspired?",
            "nextDialogs": [
              "413350305"
            ]
          },
          "413350305": {
            "id": "413350305",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Certainly. I intend to paint a scene of Liyue Harbor during the Lantern Rite. This traveler here was assisting me in my search for a suitable landscape.",
            "nextDialogs": [
              "413350306"
            ]
          },
          "413350306": {
            "id": "413350306",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "And may I ask what you are seeking inspiration for?",
            "nextDialogs": [
              "413350307"
            ]
          },
          "413350307": {
            "id": "413350307",
            "speakerId": 1001,
            "speakerName": "Qingzhou",
            "text": "Yes, quite the coincidence indeed. I also intend to write a poem about Liyue Harbor during the Lantern Rite. I'm seeking inspiration, just as you are.",
            "nextDialogs": [
              "413350308"
            ]
          },
          "413350308": {
            "id": "413350308",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "I see...",
            "nextDialogs": [
              "413350309"
            ]
          },
          "413350309": {
            "id": "413350309",
            "speakerId": 1001,
            "speakerName": "Qingzhou",
            "text": "Hmm...",
            "nextDialogs": [
              "413350310"
            ]
          },
          "413350310": {
            "id": "413350310",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Wouldn't a poem be a little too simple? How could an amazing festival like the Lantern Rite and Liyue Harbor itself possibly fit into a few lines of poetry?",
            "nextDialogs": [
              "413350311"
            ]
          },
          "413350311": {
            "id": "413350311",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Hah, if you ask me, only a great painting could properly capture the essence of the festival.",
            "nextDialogs": [
              "413350312"
            ]
          },
          "413350312": {
            "id": "413350312",
            "speakerId": 1001,
            "speakerName": "Qingzhou",
            "text": "A great painting, you say? Hehe, I fear that such a work would only be a waste of good brush and ink. A painting could never truly capture the subtle charm of the Lantern Rite and would fail to accurately render the spirit of Liyue.",
            "nextDialogs": [
              "413350313"
            ]
          },
          "413350313": {
            "id": "413350313",
            "speakerId": 1001,
            "speakerName": "Qingzhou",
            "text": "Furthermore, could the grandeur of a land as magnificent as Liyue ever possibly be captured in a painting?",
            "nextDialogs": [
              "413350314"
            ]
          },
          "413350314": {
            "id": "413350314",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Haha, I think a painting would be better.",
            "nextDialogs": [
              "413350315"
            ]
          },
          "413350315": {
            "id": "413350315",
            "speakerId": 1001,
            "speakerName": "Qingzhou",
            "text": "Hehe, and I think a poem would be better suited.",
            "nextDialogs": [
              "413350316"
            ]
          },
          "413350316": {
            "id": "413350316",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Whoa, calm down you two.",
            "nextDialogs": [
              "413350317"
            ]
          },
          "413350317": {
            "id": "413350317",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Arguing like this won't solve anything. I propose we each create a work depicting Liyue Harbor during the Lantern Rite...",
            "nextDialogs": [
              "413350318"
            ]
          },
          "413350318": {
            "id": "413350318",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Once we've both finished our works, we can put them on display and invite someone to judge them. What do you say?",
            "nextDialogs": [
              "413350319"
            ]
          },
          "413350319": {
            "id": "413350319",
            "speakerId": 1001,
            "speakerName": "Qingzhou",
            "text": "Your proposition is acceptable. I shall await your presence at Wangshu Inn once you have completed your... painting. Then we shall entreat an impartial judge to critique our work.",
            "nextDialogs": [
              "413350320"
            ]
          },
          "413350320": {
            "id": "413350320",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Good, you have a deal.",
            "nextDialogs": [
              "413350321"
            ]
          },
          "413350321": {
            "id": "413350321",
            "speakerId": 1001,
            "speakerName": "Qingzhou",
            "text": "It's settled then. If you would excuse me, I shall take my leave now.",
            "nextDialogs": [
              "413350322"
            ]
          },
          "413350322": {
            "id": "413350322",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "He sure does talk big for a poet. And to think he actually believes that the Lantern Rite and Liyue Harbor can be expressed with a few lines of poetry, hah!",
            "nextDialogs": [
              "413350323"
            ]
          },
          "413350323": {
            "id": "413350323",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "I'll show him! He won't even stand a chance once I finish my painting.",
            "nextDialogs": [
              "413350324"
            ]
          },
          "413350324": {
            "id": "413350324",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "I'll need to pour all my creativity into this one. In fact, I should even specially prepare some paints and brushes for this particular piece.",
            "nextDialogs": [
              "413350325"
            ]
          },
          "413350325": {
            "id": "413350325",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Traveler, could I trouble you to help me collect some special materials?",
            "nextDialogs": [
              "413350327"
            ]
          },
          "413350327": {
            "id": "413350327",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Good, I'm counting on you. Now let me think...",
            "nextDialogs": [
              "413350329"
            ]
          },
          "413350329": {
            "id": "413350329",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Oh, I'll need you to collect Whopperflower Nectar from a Pyro Whopperflower.",
            "nextDialogs": [
              "413350330"
            ]
          },
          "413350330": {
            "id": "413350330",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "With that, I'll be able to make mix some special paint."
          }
        }
      }
    },
    {
      "subId": "4133506",

    {
      "subId": "4133507",
      "subQuestName": "Report back to Vermeer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413350701"
        ],
        "dialogs": {
          "413350701": {
            "id": "413350701",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "So, were you able to get the Whopperflower Nectar I need?",
            "nextDialogs": [
              "413350702"
            ]
          },
          "413350702": {
            "id": "413350702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here it is.",
            "nextDialogs": [
              "413350703"
            ]
          },
          "413350703": {
            "id": "413350703",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Let me see here. Oh, here we go... Yes, this will do just fine.",
            "nextDialogs": [
              "413350704"
            ]
          },
          "413350704": {
            "id": "413350704",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Once the paint is ready, all we'll need to do is find a suitable landscape and then I can start painting.",
            "nextDialogs": [
              "413350705"
            ]
          },
          "413350705": {
            "id": "413350705",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Humph, just wait until that poet sees my painting...",
            "nextDialogs": [
              "413350706"
            ]
          },
          "413350706": {
            "id": "413350706",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Ah, I've just remembered! It's a tradition to release Xiao Lanterns during Liyue's Lantern Rite. People even write wishes on the lanterns, right?",
            "nextDialogs": [
              "413350707"
            ]
          },
          "413350707": {
            "id": "413350707",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Hehehe, I've even prepared a Xiao Lantern here, and as for the wish... Well, I won't tell you, otherwise it might not come true.",
            "nextDialogs": [
              "413350708"
            ]
          },
          "413350708": {
            "id": "413350708",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "Oh, I nearly forgot, these are for you. I guess you could consider them your reward. Thanks for the help!",
            "nextDialogs": [
              "413350709"
            ]
          },
          "413350709": {
            "id": "413350709",
            "speakerId": 1000,
            "speakerName": "Vermeer",
            "text": "I can't wait to see the look on that poet's face when he sees my painting."
          }
        }
      }
    },
    {
      "subId": "4133508",

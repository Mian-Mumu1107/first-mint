            "id": "752650603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Seems that Manou guy's selling counterfeits.",
            "nextDialogs": [
              "752650607"
            ]
          },
          "752650607": {
            "id": "752650607",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon knew it! Total scam! And trying to trick us like that... We can't let him get away with it!"
          }
        }
      }
    },
    {
      "subId": "7526503",
      "subQuestName": "",

        "dialogs": {
          "752650301": {
            "id": "752650301",
            "speakerId": 22014,
            "speakerName": "Manou",
            "text": "Hey! Buddy! I've got some real nice stuff here— hold on... You two again!?",
            "nextDialogs": [
              "752650302"
            ]
          },
          "752650302": {
            "id": "752650302",
            "speakerId": 22014,
            "speakerName": "Manou",
            "text": "I told you, I'm not selling to you! Now scram! Get out of the way.",
            "nextDialogs": [
              "752650303"
            ]
          },
          "752650303": {
            "id": "752650303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! This is your last chance to apologize!",
            "nextDialogs": [
              "752650304"
            ]
          },
          "752650304": {
            "id": "752650304",
            "speakerId": 22014,
            "speakerName": "Manou",
            "text": "What's your problem?",
            "nextDialogs": [
              "752650305"
            ]
          },
          "752650305": {
            "id": "752650305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're selling counterfeits.",
            "nextDialogs": [
              "752650306"
            ]
          },
          "752650306": {
            "id": "752650306",
            "speakerId": 22014,
            "speakerName": "Manou",
            "text": "Yeah? So what? Mind your own business."
          }
        }
      }
    },

          "752650101"
        ],
        "dialogs": {
          "752650101": {
            "id": "752650101",
            "speakerId": 22014,
            "speakerName": "Manou",
            "text": "Hey! Buddy! I've got some real nice stuff here, great prices too! Wanna take a look?",
            "nextDialogs": [
              "752650102"
            ]
          },
          "752650102": {
            "id": "752650102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Aren't these Koholasaur dolls? Paimon's seen them at the Easybreeze Market.",
            "nextDialogs": [
              "752650103"
            ]
          },
          "752650103": {
            "id": "752650103",
            "speakerId": 22014,
            "speakerName": "Manou",
            "text": "That's right! But mine're cheaper, only half the price.",
            "nextDialogs": [
              "752650104"
            ]
          },
          "752650104": {
            "id": "752650104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How come they're so cheap?",
            "nextDialogs": [
              "752650105"
            ]
          },
          "752650105": {
            "id": "752650105",
            "speakerId": 22014,
            "speakerName": "Manou",
            "text": "Hehe, don't worry about it, buddy. I've got my ways.",
            "nextDialogs": [
              "752650106"
            ]
          },
          "752650106": {
            "id": "752650106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They're cheap all right, but these colors look a bit off... These aren't knock-offs, are they?",
            "nextDialogs": [
              "752650107"
            ]
          },
          "752650107": {
            "id": "752650107",
            "speakerId": 22014,
            "speakerName": "Manou",
            "text": "Knock-offs!? What do you know, little know-it-all? Get lost!",
            "nextDialogs": [
              "752650108"
            ]
          },
          "752650108": {
            "id": "752650108",
            "speakerId": 22014,
            "speakerName": "Manou",
            "text": "Shoo, shoo! I'm not selling to you anymore!"
          }
        }
      }
    },
    {
      "subId": "7526502",
      "subQuestName": "",
      "sceneId": null,

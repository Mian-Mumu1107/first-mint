    {
      "subId": "7266107",
      "subQuestName": "Tail the Treasure Hoarders",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726610701"
        ],
        "dialogs": {
          "726610701": {
            "id": "726610701",
            "speakerId": 1002,
            "speakerName": "Old-School Qi",
            "text": "Hey, you guys, do you think this shabby rock is worth anything? It's so rare that it's hidden in the ore.",
            "nextDialogs": [
              "726610702"
            ]
          },
          "726610702": {
            "id": "726610702",
            "speakerId": 1003,
            "speakerName": "Fleein' Lin",
            "text": "Oh please, what do you mean by shabby rock, have you touched a book before in your life? It's called a fossil. A fossil, get it?",
            "nextDialogs": [
              "726610703"
            ]
          },
          "726610703": {
            "id": "726610703",
            "speakerId": 1003,
            "speakerName": "Fleein' Lin",
            "text": "Not only is it worth a fortune, this alone can buy half of Liyue Harbor! Go back and read more!",
            "nextDialogs": [
              "726610704"
            ]
          },
          "726610704": {
            "id": "726610704",
            "speakerId": 1004,
            "speakerName": "Klutzy Bazi",
            "text": "Really? Is it worth that much? Then, with what we have in the camp, wouldn't we be really weather?",
            "nextDialogs": [
              "726610705"
            ]
          },
          "726610705": {
            "id": "726610705",
            "speakerId": 1003,
            "speakerName": "Fleein' Lin",
            "text": "It's \"wealthy!\" You should go and read more too!",
            "nextDialogs": [
              "726610706"
            ]
          },
          "726610706": {
            "id": "726610706",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! That guy over there, hand over the fossil!",
            "nextDialogs": [
              "726610707"
            ]
          },
          "726610707": {
            "id": "726610707",
            "speakerId": 1003,
            "speakerName": "Fleein' Lin",
            "text": "Ah! Who is it? Darn...we've been spotted... Brothers, get them!"
          }
        }
      }
    },

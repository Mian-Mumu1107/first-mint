    {
      "subId": "7266105",
      "subQuestName": "Investigate the ore pile",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726610501"
        ],
        "dialogs": {
          "726610501": {
            "id": "726610501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "All that's left is some Ore Slag. Seems like someone took something from here.",
            "nextDialogs": [
              "726610502"
            ]
          },
          "726610502": {
            "id": "726610502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh?! Is that...a Treasure Hoarder?",
            "nextDialogs": [
              "726610503"
            ]
          },
          "726610503": {
            "id": "726610503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Could it be them who removed the object from the rock scraps?",
            "nextDialogs": [
              "726610504"
            ]
          },
          "726610504": {
            "id": "726610504",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Quick! Follow them! Their encampment must be around here, whatever was hidden in the rock scraps must be there!",
            "nextDialogs": [
              "726610505"
            ]
          },
          "726610505": {
            "id": "726610505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's go.",
            "nextDialogs": [
              "726610506"
            ]
          },
          "726610506": {
            "id": "726610506",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We have be to sneaky, very sneaky. We mustn't be caught."
          }
        }
      }
    },

            "speakerId": -1,
            "speakerName": "Player",
            "text": "<color=#FFCC33FF>Any news?</color>",
            "nextDialogs": [
              "706890101"
            ]
          },
          "706890101": {
            "id": "706890101",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "#Ah, {NICKNAME}, you've come at just the right time — I have something for you.",
            "nextDialogs": [
              "706890104"
            ]
          },
          "706890104": {
            "id": "706890104",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "...You're certainly very familiar with the kind of work we do, but I'm afraid this has nothing to do with any of the above commissions.",
            "nextDialogs": [
              "706890105"
            ]
          },
          "706890105": {
            "id": "706890105",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Please, take this brand-new Adventurers' Guild notebook."
          }
        }
      }

    {
      "subId": "101601",
      "subQuestName": "Go to Third-Round Knockout",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10160101"
        ],
        "dialogs": {
          "10160101": {
            "id": "10160101",
            "speakerId": 1000,
            "speakerName": "Zhongli",
            "text": "Ah, you're here. There's no need to order, I've already done so.",
            "nextDialogs": [
              "10160102"
            ]
          },
          "10160102": {
            "id": "10160102",
            "speakerId": 1000,
            "speakerName": "Zhongli",
            "text": "\"Third-Round Knockout\" is not for lightweights, like those taverns in Mondstadt. Here, the owner does not take such unorthodox orders as fruit juice.",
            "nextDialogs": [
              "10160103"
            ]
          },
          "10160103": {
            "id": "10160103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, does this mean I can order wine this time?",
            "nextDialogs": [
              "10160104"
            ]
          },
          "10160104": {
            "id": "10160104",
            "speakerId": 1000,
            "speakerName": "Zhongli",
            "text": "I ordered some wine-fermented sweet rice balls for you, if that counts.",
            "nextDialogs": [
              "10160105"
            ]
          },
          "10160105": {
            "id": "10160105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I guess I should have expected this...",
            "nextDialogs": [
              "10160106"
            ]
          },
          "10160106": {
            "id": "10160106",
            "speakerId": 1001,
            "speakerName": "Iron Tongue Tian",
            "text": "...If it is to your liking, dear customers, I shall continue the tale of Lady Ningguang's Jade Chamber.",
            "nextDialogs": [
              "10160107"
            ]
          },
          "10160107": {
            "id": "10160107",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hey, there's even a storyteller here! Great atmosphere!",
            "nextDialogs": [
              "10160108"
            ]
          },
          "10160108": {
            "id": "10160108",
            "speakerId": 1000,
            "speakerName": "Zhongli",
            "text": "Besides fine wine, the excellent ambience is the reason why this place is so well-loved.",
            "nextDialogs": [
              "10160109"
            ]
          },
          "10160109": {
            "id": "10160109",
            "speakerId": 1000,
            "speakerName": "Zhongli",
            "text": "But when I say ambience, I refer to a different sort from the one the Teyvat Travel Guide uses to judge other establishments.",
            "nextDialogs": [
              "10160110"
            ]
          },
          "10160110": {
            "id": "10160110",
            "speakerId": 1001,
            "speakerName": "Iron Tongue Tian",
            "text": "As you all know, high above the land of Liyue lies a pavilion in the clouds, a palace in the mist...",
            "nextDialogs": [
              "10160111"
            ]
          },
          "10160111": {
            "id": "10160111",
            "speakerId": 1001,
            "speakerName": "Iron Tongue Tian",
            "text": "What does it mean to have all-seeing eyes? This, my friends: Lady Ningguang's masterwork that bridges earth and sky.",
            "nextDialogs": [
              "10160112"
            ]
          },
          "10160112": {
            "id": "10160112",
            "speakerId": 1001,
            "speakerName": "Iron Tongue Tian",
            "text": "Imagine. The weather is clear, and you gaze down from the deck on the world below...",
            "nextDialogs": [
              "10160113"
            ]
          },
          "10160113": {
            "id": "10160113",
            "speakerId": 1001,
            "speakerName": "Iron Tongue Tian",
            "text": "Behold! The glorious sights of Liyue Harbor, stretching out far and wide!",
            "nextDialogs": [
              "10160201"
            ]
          },
          "10160201": {
            "id": "10160201",
            "speakerId": 1001,
            "speakerName": "Iron Tongue Tian",
            "text": "These are but scraps of paper, and yet they guide Lady Ningguang's hand — such is their value.",
            "nextDialogs": [
              "10160202"
            ]
          },
          "10160202": {
            "id": "10160202",
            "speakerId": 1001,
            "speakerName": "Iron Tongue Tian",
            "text": "Merely grasping one or two of them will surely gift you a fragment of her wisdom — enough to stay a step or two ahead of your peers.",
            "nextDialogs": [
              "10160203"
            ]
          },
          "10160203": {
            "id": "10160203",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Tianquan Ningguang... feels like we're hearing this name a lot.",
            "nextDialogs": [
              "10160204"
            ]
          },
          "10160204": {
            "id": "10160204",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Liyue locals talk about her, the Fatui hate her, she's most likely the one who hid the Exuvia, and we saw her at the Rite of Descension...",
            "nextDialogs": [
              "10160205"
            ]
          },
          "10160205": {
            "id": "10160205",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Huh, Paimon wonders what sort of person she is.",
            "nextDialogs": [
              "10160207"
            ]
          },
          "10160207": {
            "id": "10160207",
            "speakerId": 1003,
            "speakerName": "???",
            "text": "At last, I have found you, you who returned from Jueyun Karst.",
            "nextDialogs": [
              "10160208"
            ]
          },
          "10160208": {
            "id": "10160208",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Who's there!?",
            "nextDialogs": [
              "10160209"
            ]
          },
          "10160209": {
            "id": "10160209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon, we gotta go... !",
            "nextDialogs": [
              "10160210"
            ]
          },
          "10160210": {
            "id": "10160210",
            "speakerId": 1003,
            "speakerName": "???",
            "text": "Wait! I am not with the Millelith, nor am I here to claim your bounty.",
            "nextDialogs": [
              "10160211"
            ]
          },
          "10160211": {
            "id": "10160211",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "However, I am an emissary of the Liyue Qixing. My name is Ganyu, secretary at the Yuehai Pavilion, and I have come specifically to meet you.",
            "nextDialogs": [
              "10160214"
            ]
          },
          "10160214": {
            "id": "10160214",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "Well, in concrete terms, I am the corporate secretary for the Qixing. At the moment, I am serving as Lady Ningguang's special emissary.",
            "nextDialogs": [
              "10160215"
            ]
          },
          "10160215": {
            "id": "10160215",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ningguang sent you? We were literally just talking about her...",
            "nextDialogs": [
              "10160216"
            ]
          },
          "10160216": {
            "id": "10160216",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "My apologies, you who have returned from Jueyun Karst... I am duty-bound, and cannot extend my courtesy to you in full.",
            "nextDialogs": [
              "10160217"
            ]
          },
          "10160217": {
            "id": "10160217",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "But I have with me a letter from Lady Ningguang. She extends a formal invitation to you in her capacity as Tianquan.",
            "nextDialogs": [
              "10160218"
            ]
          },
          "10160218": {
            "id": "10160218",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "She invites you to her palace in the sky.",
            "nextDialogs": [
              "10160219"
            ]
          },
          "10160219": {
            "id": "10160219",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "An official invitation...?",
            "nextDialogs": [
              "10160220"
            ]
          },
          "10160220": {
            "id": "10160220",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "Lady Ningguang said this:",
            "nextDialogs": [
              "10160221"
            ]
          },
          "10160221": {
            "id": "10160221",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "#\"Invite {F#her}{M#him} to come here.\"",
            "nextDialogs": [
              "10160222"
            ]
          },
          "10160222": {
            "id": "10160222",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "#\"I wish to meet {F#her}{M#him}.\"",
            "nextDialogs": [
              "10160223"
            ]
          },
          "10160223": {
            "id": "10160223",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "\"At the Jade Chamber, together, we shall snip every one of these entwining dark threads.\""
          }
        }
      }
    },
    {
      "subId": "101608",
      "subQuestName": "Sit next to Zhongli",
      "sceneId": null,

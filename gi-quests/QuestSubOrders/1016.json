    {
      "subId": "101603",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10160301"
        ],
        "dialogs": {
          "10160301": {
            "id": "10160301",
            "speakerId": 1000,
            "speakerName": "Zhongli",
            "text": "Ningguang... Ganyu...",
            "nextDialogs": [
              "10160302"
            ]
          },
          "10160302": {
            "id": "10160302",
            "speakerId": 1000,
            "speakerName": "Zhongli",
            "text": "I wonder where we will find them amid these dark tides?"
          }
        }
      }
    },
    {
      "subId": "101610",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10161001"
        ],
        "dialogs": {
          "10161001": {
            "id": "10161001",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "And with that, the emissary who called herself Ganyu just disappeared...",
            "nextDialogs": [
              "10161002"
            ]
          },
          "10161002": {
            "id": "10161002",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But we've received an invitation from the Liyue Qixing. Paimon still can't believe it!",
            "nextDialogs": [
              "10161003"
            ]
          },
          "10161003": {
            "id": "10161003",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}! We'll be meeting people that have way more money than Paimon could ever count... We should be on our best manners!",
            "nextDialogs": [
              "10161006"
            ]
          },
          "10161006": {
            "id": "10161006",
            "speakerId": 1000,
            "speakerName": "Zhongli",
            "text": "Hah... An invitation to visit the Jade Chamber is a rare honor, indeed.",
            "nextDialogs": [
              "10161007"
            ]
          },
          "10161007": {
            "id": "10161007",
            "speakerId": 1000,
            "speakerName": "Zhongli",
            "text": "You'd best be on your way now. But don't forget about the Rite of Parting. Once you've finished at the Jade Chamber, meet me at Dihua Marsh.",
            "nextDialogs": [
              "10161008"
            ]
          },
          "10161008": {
            "id": "10161008",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Don't worry, we won't forget! Dihua Marsh. We'll see you there!"
          }
        }
      }
    }
  ]
}
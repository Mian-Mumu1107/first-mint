        "dialogs": {
          "401251101": {
            "id": "401251101",
            "speakerId": 1000,
            "speakerName": "Kaeya",
            "text": "You don't plan on taking the shell back with you, Miss Sangonomiya?",
            "nextDialogs": [
              "401251102"
            ]
          },
          "401251102": {
            "id": "401251102",
            "speakerId": 1001,
            "speakerName": "Sangonomiya Kokomi",
            "text": "No, I think it's better if it stays here with Idyia.",
            "nextDialogs": [
              "401251103"
            ]
          },
          "401251103": {
            "id": "401251103",
            "speakerId": 1001,
            "speakerName": "Sangonomiya Kokomi",
            "text": "Watatsumi Island has something new to treasure now, and slowly but surely, people are seeing progress in pursuing their aspirations.",
            "nextDialogs": [
              "401251104"
            ]
          },
          "401251104": {
            "id": "401251104",
            "speakerId": 1001,
            "speakerName": "Sangonomiya Kokomi",
            "text": "It'll be of more use here, where it can protect this bottle domain, and the dreams of all who journey through here."
          }
        }
      }
    },
    {
      "subId": "4012512",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401251201"
        ],
        "dialogs": {
          "401251201": {
            "id": "401251201",
            "speakerId": 1002,
            "speakerName": "Collei",
            "text": "...If we start at Aaru Village and take a slight detour, we'll be able to see Caravan Ribat and Pardis Dhyai on the way to Sumeru City...",
            "nextDialogs": [
              "401251202"
            ]
          },
          "401251202": {
            "id": "401251202",
            "speakerId": 1003,
            "speakerName": "Eula",
            "text": "Ah, very good...",
            "nextDialogs": [
              "401251203"
            ]
          },
          "401251203": {
            "id": "401251203",
            "speakerId": 1004,
            "speakerName": "Lessig",
            "text": "Planning to do any souvenir shopping along the way? You can just focus on buying the gifts, I'll carry the bags!",
            "nextDialogs": [
              "401251204"
            ]
          },
          "401251204": {
            "id": "401251204",
            "speakerId": 1004,
            "speakerName": "Lessig",
            "text": "Don't worry about the weight, I can handle it! As long as it's nothing too gigantic, I'll fit it in the bag!",
            "nextDialogs": [
              "401251205"
            ]
          },
          "401251205": {
            "id": "401251205",
            "speakerId": 1003,
            "speakerName": "Eula",
            "text": "Calm down, how many people do you think we'll be buying for...?",
            "nextDialogs": [
              "401251206"
            ]
          },
          "401251206": {
            "id": "401251206",
            "speakerId": 1005,
            "speakerName": "Klee",
            "text": "Mom, Albedo, Master Jean, Razor... Ooh, and Diona, and Mona, and Fischl...",
            "nextDialogs": [
              "401251207"
            ]
          },
          "401251207": {
            "id": "401251207",
            "speakerId": 1003,
            "speakerName": "Eula",
            "text": "Hmph, what's that look for?",
            "nextDialogs": [
              "401251208"
            ]
          },
          "401251208": {
            "id": "401251208",
            "speakerId": 1002,
            "speakerName": "Collei",
            "text": "Nothing, nothing...",
            "nextDialogs": [
              "401251209"
            ]
          },
          "401251209": {
            "id": "401251209",
            "speakerId": 1002,
            "speakerName": "Collei",
            "text": "So, Klee, what are you planning to buy for everyone?",
            "nextDialogs": [
              "401251210"
            ]
          },
          "401251210": {
            "id": "401251210",
            "speakerId": 1005,
            "speakerName": "Klee",
            "text": "Ummm... Sunsettia-flavor candies! And big Fungi caps! And, and...",
            "nextDialogs": [
              "401251211"
            ]
          },
          "401251211": {
            "id": "401251211",
            "speakerId": 1005,
            "speakerName": "Klee",
            "text": "...And loads and loads of storybooks for everyone!",
            "nextDialogs": [
              "401251212"
            ]
          },
          "401251212": {
            "id": "401251212",
            "speakerId": 1005,
            "speakerName": "Klee",
            "text": "But I haven't decided what to get for Mom yet...",
            "nextDialogs": [
              "401251213"
            ]
          },
          "401251213": {
            "id": "401251213",
            "speakerId": 1003,
            "speakerName": "Eula",
            "text": "There's no rush. Let's see what they've got, and if you're still unsure, we can help you decide.",
            "nextDialogs": [
              "401251214"
            ]
          },
          "401251214": {
            "id": "401251214",
            "speakerId": 1005,
            "speakerName": "Klee",
            "text": "Yay! Thanks, you two!"
          }
        }
      }
    }
  ]

    {
      "subId": "7516601",
      "subQuestName": "Enter the huge space beneath the volcano",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751660101"
        ],
        "dialogs": {
          "751660101": {
            "id": "751660101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh... Who'd have thought there'd be such a huge space underneath this volcano?",
            "nextDialogs": [
              "751660102"
            ]
          },
          "751660102": {
            "id": "751660102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And it's wall-to-wall Abyss in here... Now that Paimon thinks about it, the Abyss covering the entrance probably crawled up from down here...",
            "nextDialogs": [
              "751660103"
            ]
          },
          "751660103": {
            "id": "751660103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "O Chosen of Dragons, the power of blazing fire now rests within you...",
            "nextDialogs": [
              "751660104"
            ]
          },
          "751660104": {
            "id": "751660104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Go forth and vanquish the great enemy cloaked in shadow!",
            "nextDialogs": [
              "751660105"
            ]
          },
          "751660105": {
            "id": "751660105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh. What's this fuzzy warm strength Paimon feels all over...?",
            "nextDialogs": [
              "751660106"
            ]
          },
          "751660106": {
            "id": "751660106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh, that's a \"later\" question. Let's use it to send the Abyss packing, right here and now!",
            "nextDialogs": [
              "751660107"
            ]
          },
          "751660107": {
            "id": "751660107",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!"
          }
        }
      }
    },

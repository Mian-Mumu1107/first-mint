{
  "lineCounts": {
    "Andrei": 3,
    "Childe": 53,
    "Paimon": 29,
    "Player": 19,
    "Teucer": 41
  },
  "subQuests": [
    {
      "subId": "1101201",
      "subQuestName": "Go to Liyue's Institute for Toy Research",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120101"
        ],
        "dialogs": {
          "110120101": {
            "id": "110120101",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Here we are — welcome to Liyue's Institute of Toy Research.",
            "nextDialogs": [
              "110120102"
            ]
          },
          "110120102": {
            "id": "110120102",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Yeah, we're here! I can already hear the sounds of machinery inside. Awesome!",
            "nextDialogs": [
              "110120103"
            ]
          },
          "110120103": {
            "id": "110120103",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "What is this place? And how do you know about it?",
            "nextDialogs": [
              "110120104"
            ]
          },
          "110120104": {
            "id": "110120104",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Based on my limited understanding, I believe this is one of Dottore's research facilities.",
            "nextDialogs": [
              "110120105"
            ]
          },
          "110120105": {
            "id": "110120105",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Dottore is another one of the Fatui Harbingers. He loves tinkering with old things, it's a... personal passion of his. So, he converted these ruins into a Ruin Guard research lab.",
            "nextDialogs": [
              "110120106"
            ]
          },
          "110120106": {
            "id": "110120106",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Eh? So the Ruin Guards are built by the Fatui!?",
            "nextDialogs": [
              "110120107"
            ]
          },
          "110120107": {
            "id": "110120107",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "No. They have much closer connections to the Abyss, so strictly speaking, they're as much our enemies as anyone else's... We just do research, nothing more.",
            "nextDialogs": [
              "110120108"
            ]
          },
          "110120108": {
            "id": "110120108",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "As to why the Ruin Guards have been moving outside of this area recently... I can only imagine that he's gotten bored of playing around with them, and has lost interest in this place.",
            "nextDialogs": [
              "110120109"
            ]
          },
          "110120109": {
            "id": "110120109",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wow, yet another Harbinger with a bad attitude!",
            "nextDialogs": [
              "110120110"
            ]
          },
          "110120110": {
            "id": "110120110",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But at least this explains why you were totally okay with bringing Teucer here. Seems you did your homework ahead of time.",
            "nextDialogs": [
              "110120111"
            ]
          },
          "110120111": {
            "id": "110120111",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Well... I wouldn't go quite that far. I actually have no idea what this place is like on the inside.",
            "nextDialogs": [
              "110120112"
            ]
          },
          "110120112": {
            "id": "110120112",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "W—Wait, so... are you or are you not worried about your brother's safety?",
            "nextDialogs": [
              "110120113"
            ]
          },
          "110120113": {
            "id": "110120113",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Of course I am... But no matter what the danger is, I will parry it. Isn't that what any older brother would do?",
            "nextDialogs": [
              "110120114"
            ]
          },
          "110120114": {
            "id": "110120114",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Even Teucer understands that, now he knows what he's fighting for... It's the very same reason that has nestled in my own heart for so many years...",
            "nextDialogs": [
              "110120115"
            ]
          },
          "110120115": {
            "id": "110120115",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "What are you guys chatting about? Come on, let's go in!",
            "nextDialogs": [
              "110120116"
            ]
          },
          "110120116": {
            "id": "110120116",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Haha, alright. Follow me."
          }
        }
      }
    },
    {
      "subId": "1101202",
      "subQuestName": "Talk to Childe",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1101211",
      "subQuestName": "Enter the Institute for Toy Research",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110121101"
        ],
        "dialogs": {
          "110121101": {
            "id": "110121101",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Hey.",
            "nextDialogs": [
              "110121102"
            ]
          },
          "110121102": {
            "id": "110121102",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Childe? So you were here this whole time. What are you hiding for? Why didn't you come and say goodbye?",
            "nextDialogs": [
              "110121103"
            ]
          },
          "110121103": {
            "id": "110121103",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Partings are special moments. If he spent his final moments in Liyue seeing me all haggard and weak like this... That's not a memory I want him to leave with.",
            "nextDialogs": [
              "110121104"
            ]
          },
          "110121104": {
            "id": "110121104",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Still, it is a shame that I couldn't see him off by myself...",
            "nextDialogs": [
              "110121105"
            ]
          },
          "110121105": {
            "id": "110121105",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "*sigh* I should have been the one taking him back. I do have subordinates to escort him, but I still feel a little uneasy.",
            "nextDialogs": [
              "110121106"
            ]
          },
          "110121106": {
            "id": "110121106",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Geez, don't you think you've spoiled him enough already?",
            "nextDialogs": [
              "110121107"
            ]
          },
          "110121107": {
            "id": "110121107",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Haha. I can't quite explain it, but somehow I felt much more at ease leaving him in your care. And to think that not long ago, we...",
            "nextDialogs": [
              "110121108"
            ]
          },
          "110121108": {
            "id": "110121108",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Ah, yes. I almost forgot. Remuneration for your services — which I really couldn't have done without this time.",
            "nextDialogs": [
              "110121109"
            ]
          },
          "110121109": {
            "id": "110121109",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Aha, so you do have a heart after all!",
            "nextDialogs": [
              "110121110"
            ]
          },
          "110121110": {
            "id": "110121110",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "One other thing: don't forget our promise, now. Let's have a rematch when we get the chance.",
            "nextDialogs": [
              "110121111"
            ]
          },
          "110121111": {
            "id": "110121111",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "—This time, with my honor as a Harbinger on the line.",
            "nextDialogs": [
              "110121114"
            ]
          },
          "110121114": {
            "id": "110121114",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "You'd best go rest up first! Don't come crying to us when you lose all over again!",
            "nextDialogs": [
              "110121115"
            ]
          },
          "110121115": {
            "id": "110121115",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Hahaha... Regardless of who wins or loses our next bout, I'd also like to invite you over to my home.",
            "nextDialogs": [
              "110121116"
            ]
          },
          "110121116": {
            "id": "110121116",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "I'll introduce you to my other siblings, Tonia and Anthon. They're great kids, and I'm very proud of them both.",
            "nextDialogs": [
              "110121117"
            ]
          },
          "110121117": {
            "id": "110121117",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "We'll take you up on that offer! Mostly because we already made a pinkie promise to Teucer.",
            "nextDialogs": [
              "110121118"
            ]
          },
          "110121118": {
            "id": "110121118",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Haha, I'm sure that he'll be very excited to see you too. Well, that settles it. I'm looking forward to it, now...",
            "nextDialogs": [
              "110121119"
            ]
          },
          "110121119": {
            "id": "110121119",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Farewell, my friends — till we meet again, in Snezhnaya."
          }
        }
      }
    },
    {
      "subId": "1101203",
      "subQuestName": "Protect Teucer, find a way to meet up with him",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110121001"
        ],
        "dialogs": {
          "110121001": {
            "id": "110121001",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Phew, back together at last. You're not hurt, are you, Teucer?",
            "nextDialogs": [
              "110121002"
            ]
          },
          "110121002": {
            "id": "110121002",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Hurt? No way. This was really fun!",
            "nextDialogs": [
              "110121003"
            ]
          },
          "110121003": {
            "id": "110121003",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Fun for you, maybe — we were all scared to death...",
            "nextDialogs": [
              "110121004"
            ]
          },
          "110121004": {
            "id": "110121004",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "What's over there... Wow, this room is huge! Is this where Mr. Cyclops takes his friends when they come to visit?",
            "nextDialogs": [
              "110121005"
            ]
          },
          "110121005": {
            "id": "110121005",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "It is. Impressive, isn't it? Now, how about a little game of hide-and-seek?",
            "nextDialogs": [
              "110121006"
            ]
          },
          "110121006": {
            "id": "110121006",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Uh... Now? But...",
            "nextDialogs": [
              "110121007"
            ]
          },
          "110121007": {
            "id": "110121007",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Hehe... I have a surprise for you, you know.",
            "nextDialogs": [
              "110121008"
            ]
          },
          "110121008": {
            "id": "110121008",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "A surprise! What sort of surprise?",
            "nextDialogs": [
              "110121009"
            ]
          },
          "110121009": {
            "id": "110121009",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Don't worry, you'll have the chance to look for it later. But before that, you have to close your eyes, turn around, and count down from 60.",
            "nextDialogs": [
              "110121010"
            ]
          },
          "110121010": {
            "id": "110121010",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Okay... 60 is a really long time, though."
          }
        }
      }
    },
    {
      "subId": "1101213",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120901"
        ],
        "dialogs": {
          "110120901": {
            "id": "110120901",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Oh, the door opened! Was that you?",
            "nextDialogs": [
              "110120902"
            ]
          },
          "110120902": {
            "id": "110120902",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "That's right. But give me a moment over here, Teucer. I need to make sure that everything's safe...",
            "nextDialogs": [
              "110120903"
            ]
          },
          "110120903": {
            "id": "110120903",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "*sigh* Maybe I shouldn't have spoiled him quite so much."
          }
        }
      }
    },
    {
      "subId": "1101210",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120601"
        ],
        "dialogs": {
          "110120601": {
            "id": "110120601",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Teucer, see that big stone cube in front of you? I need your help.",
            "nextDialogs": [
              "110120602"
            ]
          },
          "110120602": {
            "id": "110120602",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Yay! Do I really get to help my big brother out?",
            "nextDialogs": [
              "110120603"
            ]
          },
          "110120603": {
            "id": "110120603",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "You bet. Now, I'll count down from three, and then we touch it together. Ready? Three... two... one..."
          }
        }
      }
    },
    {
      "subId": "1101204",
      "subQuestName": "Eliminate the Ruin Guard threat",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120401"
        ],
        "dialogs": {
          "110120401": {
            "id": "110120401",
            "speakerId": 1003,
            "speakerName": "Andrei",
            "text": "#{M#Sir}{F#Ma'am}, young master Teucer, I've been waiting for you.",
            "nextDialogs": [
              "110120402"
            ]
          },
          "110120402": {
            "id": "110120402",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Did Childe send you?",
            "nextDialogs": [
              "110120403"
            ]
          },
          "110120403": {
            "id": "110120403",
            "speakerId": 1003,
            "speakerName": "Andrei",
            "text": "That's correct. Master Childe instructed me to arrange for young master Teucer's return trip. Please come this way...",
            "nextDialogs": [
              "110120404"
            ]
          },
          "110120404": {
            "id": "110120404",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Who're you? My big brother always tells me never to go off with strangers!",
            "nextDialogs": [
              "110120405"
            ]
          },
          "110120405": {
            "id": "110120405",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But you've been following us around this whole time...",
            "nextDialogs": [
              "110120406"
            ]
          },
          "110120406": {
            "id": "110120406",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "#Yeah, that's because I've known who you are all along, {M#Mr. Nice Guy}{F#Ms. Nice Lady}.",
            "nextDialogs": [
              "110120407"
            ]
          },
          "110120407": {
            "id": "110120407",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Um... What?",
            "nextDialogs": [
              "110120408"
            ]
          },
          "110120408": {
            "id": "110120408",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "My brother told us all about you in a letter he sent back home. Sister Tonia read it to me.",
            "nextDialogs": [
              "110120409"
            ]
          },
          "110120409": {
            "id": "110120409",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "I actually recognized you the moment I saw you. I just... couldn't remember your name.",
            "nextDialogs": [
              "110120410"
            ]
          },
          "110120410": {
            "id": "110120410",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "What a strange twist of fate.",
            "nextDialogs": [
              "110120412",
              "110120414"
            ]
          },
          "110120412": {
            "id": "110120412",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Hee-hee...",
            "nextDialogs": [
              "110120415"
            ]
          },
          "110120415": {
            "id": "110120415",
            "speakerId": 1003,
            "speakerName": "Andrei",
            "text": "Young master Teucer, the boat to Snezhnaya will dock soon. We'd best prepare for boarding.",
            "nextDialogs": [
              "110120416"
            ]
          },
          "110120416": {
            "id": "110120416",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Gee, time really flies when you're having fun...",
            "nextDialogs": [
              "110120417"
            ]
          },
          "110120417": {
            "id": "110120417",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "#Well then, see you, {M#Mr. Nice Guy}{F#Ms. Nice Lady}!",
            "nextDialogs": [
              "110120418"
            ]
          },
          "110120418": {
            "id": "110120418",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "I'll wait for you back home. You definitely, definitely have to come visit Snezhnaya sometime!"
          },
          "110120414": {
            "id": "110120414",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Not at all. In fact, he said that if he ever had the chance, he'd quit his job and join you on your adventures!"
          }
        }
      }
    },
    {
      "subId": "1101209",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120701"
        ],
        "dialogs": {
          "110120701": {
            "id": "110120701",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "This... This is everything I've ever dreamed of! It's Mr. Cyclops world!",
            "nextDialogs": [
              "110120704"
            ]
          },
          "110120704": {
            "id": "110120704",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wow... He actually pulled it off! And the way he knocked those Ruin Guards around was like they really were kids' toys...",
            "nextDialogs": [
              "110120705"
            ]
          },
          "110120705": {
            "id": "110120705",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But Paimon wonders if he'll be alright after using Foul Legacy Transformation again...",
            "nextDialogs": [
              "110120706"
            ]
          },
          "110120706": {
            "id": "110120706",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Awesome! Hee-hee!",
            "nextDialogs": [
              "110120707"
            ]
          },
          "110120707": {
            "id": "110120707",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Boy, if these Mr. Cyclopses weren't so big, I'd sure love to take one home.",
            "nextDialogs": [
              "110120708"
            ]
          },
          "110120708": {
            "id": "110120708",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Wait... Where'd he go? Where'd my brother go?",
            "nextDialogs": [
              "110120709"
            ]
          },
          "110120709": {
            "id": "110120709",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Aren't you guys supposed to be playing hide-and-seek?",
            "nextDialogs": [
              "110120710"
            ]
          },
          "110120710": {
            "id": "110120710",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Oh, that's right! I was so excited that I forgot all about our game!",
            "nextDialogs": [
              "110120711"
            ]
          },
          "110120711": {
            "id": "110120711",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "#Well {M#mister}{F#lady}, let's look for him together, okay?"
          }
        }
      }
    },
    {
      "subId": "1101205",
      "subQuestName": "Find Childe and talk to him",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120201"
        ],
        "dialogs": {
          "110120201": {
            "id": "110120201",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "It's a good thing that you two found me first... Looks like using the Foul Legacy Transformation while I was still injured took more out of me than I'd thought...",
            "nextDialogs": [
              "110120202"
            ]
          },
          "110120202": {
            "id": "110120202",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "I've no idea what I'd do if Teucer saw me like this — look at me, deflated as a burst balloon...",
            "nextDialogs": [
              "110120204"
            ]
          },
          "110120204": {
            "id": "110120204",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Haha! As I recall, you have siblings too, yes?",
            "nextDialogs": [
              "110120205"
            ]
          },
          "110120205": {
            "id": "110120205",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "I figured that you probably wouldn't take me out in front of my little brother.",
            "nextDialogs": [
              "110120206"
            ]
          },
          "110120206": {
            "id": "110120206",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Really milking this situation, huh?",
            "nextDialogs": [
              "110120208"
            ]
          },
          "110120208": {
            "id": "110120208",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Like I said... I can never pass on an opportunity to test my limits.",
            "nextDialogs": [
              "110120209"
            ]
          },
          "110120209": {
            "id": "110120209",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "And that's why I, Tartaglia, am always getting stronger. *chuckles*",
            "nextDialogs": [
              "110120210"
            ]
          },
          "110120210": {
            "id": "110120210",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Anyway, childhood dreams are all too easily shattered. Even if you just leave them be, they will fall to pieces all by themselves.",
            "nextDialogs": [
              "110120211"
            ]
          },
          "110120211": {
            "id": "110120211",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "So, someone has to protect them, right?",
            "nextDialogs": [
              "110120212"
            ]
          },
          "110120212": {
            "id": "110120212",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "If you make a promise, you keep it, if you make a mistake, you apologize...",
            "nextDialogs": [
              "110120213"
            ]
          },
          "110120213": {
            "id": "110120213",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "And if you give someone a dream, you defend it to the end...",
            "nextDialogs": [
              "110120214"
            ]
          },
          "110120214": {
            "id": "110120214",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "That is what family is all about, isn't it?",
            "nextDialogs": [
              "110120215"
            ]
          },
          "110120215": {
            "id": "110120215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "110120216"
            ]
          },
          "110120216": {
            "id": "110120216",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Aha... Remind you of something, did I?",
            "nextDialogs": [
              "110120217"
            ]
          },
          "110120217": {
            "id": "110120217",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "*cough* Ugh...",
            "nextDialogs": [
              "110120218"
            ]
          },
          "110120218": {
            "id": "110120218",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Quit the tough guy act, already! You need to see a doctor right away, mister!",
            "nextDialogs": [
              "110120219"
            ]
          },
          "110120219": {
            "id": "110120219",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "A fine suggestion, but first... I have a little something for Teucer. Please give it to him on my behalf.",
            "nextDialogs": [
              "110120220"
            ]
          },
          "110120220": {
            "id": "110120220",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Eh, is this... a Mr. Cyclops action figure?",
            "nextDialogs": [
              "110120221"
            ]
          },
          "110120221": {
            "id": "110120221",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Indeed. I had it made to order by a smith some time back. I had intended to give it to him on my return to Snezhnaya, but it seems that it would make a better souvenir at this point.",
            "nextDialogs": [
              "110120222"
            ]
          },
          "110120222": {
            "id": "110120222",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wow... Now Paimon thinks about it, Childe's family are really lucky to have him, aren't they?",
            "nextDialogs": [
              "110120223"
            ]
          },
          "110120223": {
            "id": "110120223",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Hah. I'll also need you to explain my abrupt departure to Teucer.",
            "nextDialogs": [
              "110120224"
            ]
          },
          "110120224": {
            "id": "110120224",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "You'll help me out, won't you?"
          }
        }
      }
    },
    {
      "subId": "1101220",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120301"
        ],
        "dialogs": {
          "110120301": {
            "id": "110120301",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "I can't find him anywhere... where did he go...",
            "nextDialogs": [
              "110120303",
              "110120305"
            ]
          },
          "110120303": {
            "id": "110120303",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Really? Where is he?",
            "nextDialogs": [
              "110120306"
            ]
          },
          "110120306": {
            "id": "110120306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A huge number of people suddenly wanted to buy Mr. Cyclopses!",
            "nextDialogs": [
              "110120307"
            ]
          },
          "110120307": {
            "id": "110120307",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Y—Yeah, so he had to leave in a real hurry. He didn't abandon you here on purpose.",
            "nextDialogs": [
              "110120308"
            ]
          },
          "110120308": {
            "id": "110120308",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Oh... Th—That's great!",
            "nextDialogs": [
              "110120309"
            ]
          },
          "110120309": {
            "id": "110120309",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "But still, I was kinda hoping we could play here a little longer..."
          },
          "110120305": {
            "id": "110120305",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "What? Why... why would he leave without me?"
          }
        }
      }
    },

    {
      "subId": "1101208",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120801"
        ],
        "dialogs": {
          "110120801": {
            "id": "110120801",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Brother... someone was saying that Mr. Cyclops is a killing machine...",
            "nextDialogs": [
              "110120802"
            ]
          },
          "110120802": {
            "id": "110120802",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Were they, now? What a silly thing for them to say... And you shouldn't go repeating it either, Teucer, you're far too young to be talking about such violent topics.",
            "nextDialogs": [
              "110120803"
            ]
          },
          "110120803": {
            "id": "110120803",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Yeah, I knew that they were lying, anyways. Mr. Cyclops is here to defeat the bad guys and protect the world. He's my favorite toy!",
            "nextDialogs": [
              "110120804"
            ]
          },
          "110120804": {
            "id": "110120804",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Right. With Mr. Cyclops around, the bad guys won't ever get you.",
            "nextDialogs": [
              "110120805"
            ]
          },
          "110120805": {
            "id": "110120805",
            "speakerId": 1001,
            "speakerName": "Teucer",
            "text": "Hee-hee, that's right! Okay, I'm going to go play with Mr. Cyclops now!",
            "nextDialogs": [
              "110120806"
            ]
          },
          "110120806": {
            "id": "110120806",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "Hey, Teucer, wait up...",
            "nextDialogs": [
              "110120807"
            ]
          },
          "110120807": {
            "id": "110120807",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Th—The door's shut! Will Teucer be alright?",
            "nextDialogs": [
              "110120808"
            ]
          },
          "110120808": {
            "id": "110120808",
            "speakerId": 1000,
            "speakerName": "Childe",
            "text": "There's another path over there — let's move!"
          }
        }
      }
    }
  ]

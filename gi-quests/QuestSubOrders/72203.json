    {
      "subId": "7220304",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722030401"
        ],
        "dialogs": {
          "722030401": {
            "id": "722030401",
            "speakerId": 1000,
            "speakerName": "Nonno",
            "text": "Ah, if only everyone was as good at this as you!",
            "nextDialogs": [
              "722030402"
            ]
          },
          "722030402": {
            "id": "722030402",
            "speakerId": 1000,
            "speakerName": "Nonno",
            "text": "We're good friends now, aren't we?"
          }
        }
      }
    },
    {
      "subId": "7220305",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722030501"
        ],
        "dialogs": {
          "722030501": {
            "id": "722030501",
            "speakerId": 1000,
            "speakerName": "Nonno",
            "text": "Haha, you found me again!",
            "nextDialogs": [
              "722030502"
            ]
          },
          "722030502": {
            "id": "722030502",
            "speakerId": 1000,
            "speakerName": "Nonno",
            "text": "Y'know, I'll miss you, but... I came this time to say goodbye. The golden man says we've gotta go.",
            "nextDialogs": [
              "722030503"
            ]
          },
          "722030503": {
            "id": "722030503",
            "speakerId": 1000,
            "speakerName": "Nonno",
            "text": "But don't worry about me! Where I'm going, there's tons of people to play with! I wish you could come too, but the golden man says that it's not time yet...",
            "nextDialogs": [
              "722030504"
            ]
          },
          "722030504": {
            "id": "722030504",
            "speakerId": 1000,
            "speakerName": "Nonno",
            "text": "It's totally fine, though! Totally! I'll just wait for you there... and if I can't wait, I'll turn into little bits of light and look for you in your dreams!",
            "nextDialogs": [
              "722030505"
            ]
          },
          "722030505": {
            "id": "722030505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have a good trip, now.",
            "nextDialogs": [
              "722030506"
            ]
          },
          "722030506": {
            "id": "722030506",
            "speakerId": 1000,
            "speakerName": "Nonno",
            "text": "Yeah, I will! It was fun playing with you. Thanks a bunch!",
            "nextDialogs": [
              "722030507"
            ]
          },
          "722030507": {
            "id": "722030507",
            "speakerId": 1000,
            "speakerName": "Nonno",
            "text": "I won't be alone anymore, this is great..."
          }
        }
      }
    },

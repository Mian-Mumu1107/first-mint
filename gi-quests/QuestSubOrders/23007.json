    {
      "subId": "2300708",
      "subQuestName": "Give the soil to Akim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230070801"
        ],
        "dialogs": {
          "230070801": {
            "id": "230070801",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Have you found the soil that I need?"
          }
        }
      }
    },
    {
      "subId": "2300709",
      "subQuestName": "Talk to Akim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230070901"
        ],
        "dialogs": {
          "230070901": {
            "id": "230070901",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "That's exactly what I want. You're a great help!",
            "nextDialogs": [
              "230070902"
            ]
          },
          "230070902": {
            "id": "230070902",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "This soil is sticky to the touch. Is this because there's some Slime Condensate mixed in it? I wonder if this can be mixed together with other soil types...",
            "nextDialogs": [
              "230070903"
            ]
          },
          "230070903": {
            "id": "230070903",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Anyway, thank you for your help, and please take your payment.",
            "nextDialogs": [
              "230070904"
            ]
          },
          "230070904": {
            "id": "230070904",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Oh, perhaps we should call it \"Concresoil\" or something..."
          }
        }
      }
    },
    {
      "subId": "2300710",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230071001"
        ],
        "dialogs": {
          "230071001": {
            "id": "230071001",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "This is exactly what I'm looking for. You're a great help! I'll start some experiments with this later.",
            "nextDialogs": [
              "230071002"
            ]
          },
          "230071002": {
            "id": "230071002",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Thank you so much. Please take this as your reward.",
            "nextDialogs": [
              "230071003"
            ]
          },
          "230071003": {
            "id": "230071003",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "If I can mix different soils together, will the mixture be more durable...?"
          }
        }
      }
    },
    {
      "subId": "2300711",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230071101"
        ],
        "dialogs": {
          "230071101": {
            "id": "230071101",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Yes, this is exactly what I want. You're a great help!",
            "nextDialogs": [
              "230071102"
            ]
          },
          "230071102": {
            "id": "230071102",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Hmm... It's softer than I expected. The adhesion is fine, but it doesn't provide enough support...",
            "nextDialogs": [
              "230071103"
            ]
          },
          "230071103": {
            "id": "230071103",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "It's okay, though. As those wise folk put it, \"No tall building was built in a day.\"",
            "nextDialogs": [
              "230071104"
            ]
          },
          "230071104": {
            "id": "230071104",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I suppose creating the kind of soil I want couldn't be that easy either...",
            "nextDialogs": [
              "230071105"
            ]
          },
          "230071105": {
            "id": "230071105",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Thank you so much. Please take this as your payment.",
            "nextDialogs": [
              "230071106"
            ]
          },
          "230071106": {
            "id": "230071106",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I'll try some other options later."
          }
        }
      }
    },

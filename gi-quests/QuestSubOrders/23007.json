  "subQuests": [
    {
      "subId": "2300701",
      "subQuestName": "Talk to Akim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230070101"
        ],
        "dialogs": {
          "230070101": {
            "id": "230070101",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Isn't there a better material...",
            "nextDialogs": [
              "230070102"
            ]
          },
          "230070102": {
            "id": "230070102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What material?",
            "nextDialogs": [
              "230070103"
            ]
          },
          "230070103": {
            "id": "230070103",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Sorry, I was talking to myself again. The fickle weather's been causing all sorts of problems with houses. I've never been this busy.",
            "nextDialogs": [
              "230070104"
            ]
          },
          "230070104": {
            "id": "230070104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Aren't you a potter?",
            "nextDialogs": [
              "230070105"
            ]
          },
          "230070105": {
            "id": "230070105",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Yeah, but I'm also a bricklayer. You see, it's all about the soil in either case. Not much of a difference.",
            "nextDialogs": [
              "230070106"
            ]
          },
          "230070106": {
            "id": "230070106",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Have you heard that saying? \"Learning is like building a house. If you want to build a tall one, you must lay a solid foundation.\"",
            "nextDialogs": [
              "230070107"
            ]
          },
          "230070107": {
            "id": "230070107",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "\"And if you want to expand your knowledge, you need to ensure that your foundations are solid. A shifting foundation will only lead to collapse...\"",
            "nextDialogs": [
              "230070108"
            ]
          },
          "230070108": {
            "id": "230070108",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Those smart higher-ups always say so. I don't really get it, but it's clear to me that they regard building houses to be as important as learning!",
            "nextDialogs": [
              "230070111"
            ]
          },
          "230070111": {
            "id": "230070111",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Anyway, when you think of a house's foundations, you think of building materials.",
            "nextDialogs": [
              "230070112"
            ]
          },
          "230070112": {
            "id": "230070112",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Soil is the binding and support material, so if its stability and adaptability can be increased, our houses will be more durable. And I won't have to be this busy anymore."
          }
        }
      }
    },
    {
      "subId": "2300702",
      "subQuestName": "Go to the place Akim recommended",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230070201"
        ],
        "dialogs": {
          "230070201": {
            "id": "230070201",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I've come up with a few ideas, and today, I'm planning to find some soil soaked in Slime Condensate.",
            "nextDialogs": [
              "230070202"
            ]
          },
          "230070202": {
            "id": "230070202",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I've found out about a place where Slimes gather. Can you head there and find me some soil?",
            "nextDialogs": [
              "230070204",
              "230070207"
            ]
          },
          "230070204": {
            "id": "230070204",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I'll leave it to you then. It doesn't matter if you take those Slimes down or not. Just bring some of the soil near them back.",
            "nextDialogs": [
              "230070205"
            ]
          },
          "230070205": {
            "id": "230070205",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I'll mark the place on the map for you..."
          },
          "230070207": {
            "id": "230070207",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I would love to, but I still have some pottery to handle.",
            "nextDialogs": [
              "230070208"
            ]
          },
          "230070208": {
            "id": "230070208",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Don't worry. I'll take care of the payment. Thanks a lot!",
            "nextDialogs": [
              "230070209"
            ]
          },
          "230070209": {
            "id": "230070209",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I'll mark the place on the map for you, so please head there and look for it.",
            "nextDialogs": [
              "230070210"
            ]
          },
          "230070210": {
            "id": "230070210",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I'll leave it to you then. It doesn't matter if you take those Slimes down or not. Just bring some of the soil near them back."
          }
        }
      }
    },
    {
      "subId": "2300703",
      "subQuestName": "Go to the place Akim marked and get the soil",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230070301"
        ],
        "dialogs": {
          "230070301": {
            "id": "230070301",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I've come up with a few ideas, and today... I'm planning to find some soil that is constantly exposed to elemental creatures.",
            "nextDialogs": [
              "230070302"
            ]
          },
          "230070302": {
            "id": "230070302",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Whopperflowers will be a good option. The soil where such creatures grow may have distinctive features.",
            "nextDialogs": [
              "230070303"
            ]
          },
          "230070303": {
            "id": "230070303",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "But I'm just a bricklayer, and well, hitting Whopperflowers with a brick is hardly going to help me get a hold of that soil...",
            "nextDialogs": [
              "230070304"
            ]
          },
          "230070304": {
            "id": "230070304",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "So, Traveler, could you help me do this?",
            "nextDialogs": [
              "230070306",
              "230070309"
            ]
          },
          "230070306": {
            "id": "230070306",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Thank you. And don't forget, we're looking for soil where Whopperflowers grow!",
            "nextDialogs": [
              "230070307"
            ]
          },
          "230070307": {
            "id": "230070307",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I know a place where Whopperflowers appear, or so it is said."
          },
          "230070309": {
            "id": "230070309",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I would love to, but I still have some pottery to handle.",
            "nextDialogs": [
              "230070310"
            ]
          },
          "230070310": {
            "id": "230070310",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Don't worry. I'll take care of the payment. Thanks a lot!",
            "nextDialogs": [
              "230070311"
            ]
          },
          "230070311": {
            "id": "230070311",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I'll mark the place on the map for you, so please head there and look for it.",
            "nextDialogs": [
              "230070312"
            ]
          },
          "230070312": {
            "id": "230070312",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Thank you. And don't forget, we're looking for soil where Whopperflowers grow!"
          }
        }
      }
    },
    {
      "subId": "2300704",
      "subQuestName": "Go to the place Akim recommended",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230070401"
        ],
        "dialogs": {
          "230070401": {
            "id": "230070401",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I've come up with a few ideas, and I'm planning to find some moist soil today.",
            "nextDialogs": [
              "230070402"
            ]
          },
          "230070402": {
            "id": "230070402",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "With adequate moisture and strong adhesion, it should be perfect for fixing cracks.",
            "nextDialogs": [
              "230070404",
              "230070407"
            ]
          },
          "230070404": {
            "id": "230070404",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "It would be great if you could help. I will mark the location on your map. Please go look for it...",
            "nextDialogs": [
              "230070405"
            ]
          },
          "230070405": {
            "id": "230070405",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Topsoil is not gonna work, so you'll have to dig deeper. I'm counting on you!"
          },
          "230070407": {
            "id": "230070407",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I would love to, but I still have some pottery to handle.",
            "nextDialogs": [
              "230070408"
            ]
          },
          "230070408": {
            "id": "230070408",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Don't worry. I'll take care of the payment. Thanks a lot!",
            "nextDialogs": [
              "230070409"
            ]
          },
          "230070409": {
            "id": "230070409",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "I'll mark the place on the map for you, so please head there and look for it.",
            "nextDialogs": [
              "230070410"
            ]
          },
          "230070410": {
            "id": "230070410",
            "speakerId": 1000,
            "speakerName": "Akim",
            "text": "Ordinary topsoil is not gonna work, so you'll need to dig deeper."
          }
        }
      }
    },

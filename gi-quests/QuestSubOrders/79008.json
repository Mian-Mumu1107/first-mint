        "dialogs": {
          "790080101": {
            "id": "790080101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This should be it!",
            "nextDialogs": [
              "790080102"
            ]
          },
          "790080102": {
            "id": "790080102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm? Looks like there's a letter next to it, too...",
            "nextDialogs": [
              "790080103"
            ]
          },
          "790080103": {
            "id": "790080103",
            "speakerId": 1001,
            "speakerName": "Barbara's Letter",
            "text": "To a friend who may have the fortune to come here,",
            "nextDialogs": [
              "790080104"
            ]
          },
          "790080104": {
            "id": "790080104",
            "speakerId": 1001,
            "speakerName": "Barbara's Letter",
            "text": "Hello there, person from afar. If you're reading this letter, then you must have found the harpastum I left here.",
            "nextDialogs": [
              "790080105"
            ]
          },
          "790080105": {
            "id": "790080105",
            "speakerId": 1001,
            "speakerName": "Barbara's Letter",
            "text": "The Golden Apple Archipelago is full of many games that involve harpasta, and I and my friends spent a most wonderful summer here.",
            "nextDialogs": [
              "790080106"
            ]
          },
          "790080106": {
            "id": "790080106",
            "speakerId": 1001,
            "speakerName": "Barbara's Letter",
            "text": "As such, I've left a harpastum that I made myself here, in the hopes that you, who have found that harpastum, can experience the same joys as I.",
            "nextDialogs": [
              "790080107"
            ]
          },
          "790080107": {
            "id": "790080107",
            "speakerId": 1001,
            "speakerName": "Barbara's Letter",
            "text": "Please enjoy the sunshine, the sea breeze, and the summer games to fullest.",
            "nextDialogs": [
              "790080108"
            ]
          },
          "790080108": {
            "id": "790080108",
            "speakerId": 1001,
            "speakerName": "Barbara's Letter",
            "text": "—Barbara",
            "nextDialogs": [
              "790080109"
            ]
          },
          "790080109": {
            "id": "790080109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, that's Barbara for you! Guess we've got ourselves a harpastum now, so come on, let's go play!"
          }
        }
      }
    },

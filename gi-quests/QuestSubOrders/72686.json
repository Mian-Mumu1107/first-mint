{
  "lineCounts": {
    "Paimon": 4,
    "Player": 5,
    "Yasuhiko Tarou": 14
  },
  "subQuests": [
    {
      "subId": "7268601",
      "subQuestName": "Talk to Yasuhiko Tarou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726860101"
        ],
        "dialogs": {
          "726860101": {
            "id": "726860101",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "Might I ask for your name?",
            "nextDialogs": [
              "726860102"
            ]
          },
          "726860102": {
            "id": "726860102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#I'm {NICKNAME}.",
            "nextDialogs": [
              "726860103"
            ]
          },
          "726860103": {
            "id": "726860103",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "Good, I've written it down. May I ask if you are willing to put your honor as a warrior on the line?",
            "nextDialogs": [
              "726860106"
            ]
          },
          "726860106": {
            "id": "726860106",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "Mm? Are you not, then, a warrior who has come forth to take part in this contest?",
            "nextDialogs": [
              "726860107"
            ]
          },
          "726860107": {
            "id": "726860107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Never heard of such a thing.",
            "nextDialogs": [
              "726860108"
            ]
          },
          "726860108": {
            "id": "726860108",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "Have you not heard of the \"Clash of Lone Blades\"?",
            "nextDialogs": [
              "726860109"
            ]
          },
          "726860109": {
            "id": "726860109",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "That can't be, I should have put up notices.",
            "nextDialogs": [
              "726860110"
            ]
          },
          "726860110": {
            "id": "726860110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Where did you put them up?",
            "nextDialogs": [
              "726860111"
            ]
          },
          "726860111": {
            "id": "726860111",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "Here.",
            "nextDialogs": [
              "726860112"
            ]
          },
          "726860112": {
            "id": "726860112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "C'mon, that's no use at all! No one's gonna see that, much less come over!",
            "nextDialogs": [
              "726860113"
            ]
          },
          "726860113": {
            "id": "726860113",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "Hmph! This is all the Yashiro Commission's fault, what with their \"no weapons or fighting during the Irodori Festival\" nonsense. I applied to organize duels on Ritou, but they refused, and wouldn't let me put up advertisements, either.",
            "nextDialogs": [
              "726860114"
            ]
          },
          "726860114": {
            "id": "726860114",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "So I could only put the arena here and place the sign nearby.",
            "nextDialogs": [
              "726860115"
            ]
          },
          "726860115": {
            "id": "726860115",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "That said, we have already had 4 applicants. If we also include you, that makes 5.",
            "nextDialogs": [
              "726860116"
            ]
          },
          "726860116": {
            "id": "726860116",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Huh, so people actually joined. That's odd. Speaking of which, Paimon can't quite remember why you came here either, {NICKNAME}...",
            "nextDialogs": [
              "726860117"
            ]
          },
          "726860117": {
            "id": "726860117",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "The way I see it, you were able to find this place without any prior hints. This must mean that you are a warrior with a formidable spirit indeed.",
            "nextDialogs": [
              "726860118"
            ]
          },
          "726860118": {
            "id": "726860118",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "Those who hanker after martial prowess will always be attracted to one another. This is the way of the world — and there is little need to be surprised by it.",
            "nextDialogs": [
              "726860119"
            ]
          },
          "726860119": {
            "id": "726860119",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon has no idea what world you live in.",
            "nextDialogs": [
              "726860120"
            ]
          },
          "726860120": {
            "id": "726860120",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "Hehe. But still, would you be willing to take part?",
            "nextDialogs": [
              "726860121"
            ]
          },
          "726860121": {
            "id": "726860121",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "If you can defeat each of the four challengers, you will receive a reward, as a matter of course.",
            "nextDialogs": [
              "726860122"
            ]
          },
          "726860122": {
            "id": "726860122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll give it some consideration.",
            "nextDialogs": [
              "726860123"
            ]
          },
          "726860123": {
            "id": "726860123",
            "speakerId": 1000,
            "speakerName": "Yasuhiko Tarou",
            "text": "Well then, please do take your time."
          }
        }
      }
    }
  ]
}
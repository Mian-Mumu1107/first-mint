    {
      "subId": "35604",
      "subQuestName": "Talk to Amber",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3560401"
        ],
        "dialogs": {
          "3560401": {
            "id": "3560401",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "So, the present I want to give you is...",
            "nextDialogs": [
              "3560402"
            ]
          },
          "3560402": {
            "id": "3560402",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "A <color=#00E1FFFF>Wind Glider</color>!",
            "nextDialogs": [
              "3560403"
            ]
          },
          "3560403": {
            "id": "3560403",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Outriders use them to ride the wind, and the people of Mondstadt love using them too.",
            "nextDialogs": [
              "3560404"
            ]
          },
          "3560404": {
            "id": "3560404",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "I brought you here to give it to you so you can experience it right away!",
            "nextDialogs": [
              "3560405"
            ]
          },
          "3560405": {
            "id": "3560405",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, you're really excited about these wind gliders, huh!",
            "nextDialogs": [
              "3560406"
            ]
          },
          "3560406": {
            "id": "3560406",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Well that's because the wind is the heart and soul of Mondstadt!",
            "nextDialogs": [
              "3560407"
            ]
          },
          "3560407": {
            "id": "3560407",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Alrighty then, enough talk! Let's give it a whirl!",
            "nextDialogs": [
              "3560408"
            ]
          },
          "3560408": {
            "id": "3560408",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "It's easy to use, but you still need to pay attention to my instructions."
          }
        }
      }
    },

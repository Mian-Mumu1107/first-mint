  "subQuests": [
    {
      "subId": "35601",
      "subQuestName": "Talk to Amber",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3560101"
        ],
        "dialogs": {
          "3560101": {
            "id": "3560101",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Let me officially introduce the city of wind, dandelions, and freedom —",
            "nextDialogs": [
              "3560102"
            ]
          },
          "3560102": {
            "id": "3560102",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Travelers under the protection of the Knights of Favonius — Welcome to Mondstadt!",
            "nextDialogs": [
              "3560103"
            ]
          },
          "3560103": {
            "id": "3560103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Finally, no more having to camp outdoors!",
            "nextDialogs": [
              "3560104"
            ]
          },
          "3560104": {
            "id": "3560104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But... the city folk don't look too cheery.",
            "nextDialogs": [
              "3560105"
            ]
          },
          "3560105": {
            "id": "3560105",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Everyone's been put out of place by Stormterror recently.",
            "nextDialogs": [
              "3560106"
            ]
          },
          "3560106": {
            "id": "3560106",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "But everything will turn out fine as long as Jean's with us!",
            "nextDialogs": [
              "3560107"
            ]
          },
          "3560107": {
            "id": "3560107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Jean?",
            "nextDialogs": [
              "3560108"
            ]
          },
          "3560108": {
            "id": "3560108",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Acting Grand Master of the Knights of Favonius — Jean, Defender of Mondstadt.",
            "nextDialogs": [
              "3560109"
            ]
          },
          "3560109": {
            "id": "3560109",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "With Jean on our side, surely even the vicious Stormterror will be no match for us.",
            "nextDialogs": [
              "3560112"
            ]
          },
          "3560112": {
            "id": "3560112",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "#Before I take you guys to the Knights of Favonius Headquarters, I have a present for you, {NICKNAME}.",
            "nextDialogs": [
              "3560113"
            ]
          },
          "3560113": {
            "id": "3560113",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "It's a reward for helping me clear out that hilichurl camp.",
            "nextDialogs": [
              "3560114"
            ]
          },
          "3560114": {
            "id": "3560114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "He-Hey! Why doesn't Paimon get a reward?",
            "nextDialogs": [
              "3560115"
            ]
          },
          "3560115": {
            "id": "3560115",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Ahh... Because this reward is useless to you, Paimon.",
            "nextDialogs": [
              "3560116"
            ]
          },
          "3560116": {
            "id": "3560116",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "But I'll treat you to a traditional Mondstadt delicacy — Sticky Honey Roast.",
            "nextDialogs": [
              "3560117"
            ]
          },
          "3560117": {
            "id": "3560117",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Sticky Honey Roast!",
            "nextDialogs": [
              "3560118"
            ]
          },
          "3560118": {
            "id": "3560118",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Come with me, we'll head to the city's ahh... <color=#00E1FFFF>high ground</color>."
          }
        }
      }
    },
    {
      "subId": "35603",
      "subQuestName": "Go to the location designated by Amber",
      "sceneId": null,
      "locations": [],

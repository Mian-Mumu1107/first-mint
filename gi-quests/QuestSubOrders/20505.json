  "subQuests": [
    {
      "subId": "2050501",
      "subQuestName": "Talk to Katheryne",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205050101"
        ],
        "dialogs": {
          "205050101": {
            "id": "205050101",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Sorry to bother you again.",
            "nextDialogs": [
              "205050103",
              "205050105"
            ]
          },
          "205050103": {
            "id": "205050103",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "I am delighted to hear that. In which case, let me try to make this quick...",
            "nextDialogs": [
              "205050106"
            ]
          },
          "205050106": {
            "id": "205050106",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "We are most grateful for your commission completion to date. The guild's reputation has grown stronger as a result.",
            "nextDialogs": [
              "205050107"
            ]
          },
          "205050107": {
            "id": "205050107",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "However, another consequence is that we are receiving an unprecedented number of requests — more than our current numbers can handle.",
            "nextDialogs": [
              "205050108"
            ]
          },
          "205050108": {
            "id": "205050108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You want us to do some recruitment for you?",
            "nextDialogs": [
              "205050109"
            ]
          },
          "205050109": {
            "id": "205050109",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Ahh... No. Although I appreciate the offer — it would be fantastic to have some new members...",
            "nextDialogs": [
              "205050110"
            ]
          },
          "205050110": {
            "id": "205050110",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "But scrambling to officially recruit new members at this stage would not really solve our immediate problems.",
            "nextDialogs": [
              "205050111"
            ]
          },
          "205050111": {
            "id": "205050111",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "So what I want to ask is — Would your friends have the time to help out?"
          },
          "205050105": {
            "id": "205050105",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Hahaha... Bingo! And I presume you are interested."
          }
        }
      }
    },
    {
      "subId": "2050502",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205050201"
        ],
        "dialogs": {
          "205050201": {
            "id": "205050201",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "You can dispatch someone on an expedition at any time, and they will still be able to join you in your adventures should you need them.",
            "nextDialogs": [
              "205050202"
            ]
          },
          "205050202": {
            "id": "205050202",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "You can also choose the length of time for the expedition. After your friend returns, just come here and confirm the outcome.",
            "nextDialogs": [
              "205050203"
            ]
          },
          "205050203": {
            "id": "205050203",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "As your Adventure Rank increases, more dangerous expeditions will become available to you.",
            "nextDialogs": [
              "205050204"
            ]
          },
          "205050204": {
            "id": "205050204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "After all, with epic power comes epic responsibility!",
            "nextDialogs": [
              "205050205"
            ]
          },
          "205050205": {
            "id": "205050205",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "And of course, matching risk with experience is also for everyone's safety.",
            "nextDialogs": [
              "205050206"
            ]
          },
          "205050206": {
            "id": "205050206",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Thanks again for your help. I hope you and your friends can help out with our expeditions as much as possible."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7250001",
      "subQuestName": "Talk to Mamoru",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "725000101"
        ],
        "dialogs": {
          "725000101": {
            "id": "725000101",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "Bad news!",
            "nextDialogs": [
              "725000102"
            ]
          },
          "725000102": {
            "id": "725000102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "725000103"
            ]
          },
          "725000103": {
            "id": "725000103",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "Boss got arrested again!",
            "nextDialogs": [
              "725000104"
            ]
          },
          "725000104": {
            "id": "725000104",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "Just now, someone from the Tenryou Commission came to post a notice on the bulletin board saying our festival has to be suspended.",
            "nextDialogs": [
              "725000105"
            ]
          },
          "725000105": {
            "id": "725000105",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "I don't know what happened. I think maybe the boss sent some flyers to Tenshukaku.",
            "nextDialogs": [
              "725000106"
            ]
          },
          "725000106": {
            "id": "725000106",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "He did say that the Shogun would definitely not wanna miss the Almighty Arataki Great and Glorious Drumalong Festival, after all!",
            "nextDialogs": [
              "725000107"
            ]
          },
          "725000107": {
            "id": "725000107",
            "speakerId": 12276,
            "speakerName": "Akira",
            "text": "Hmm... Well, I think Boss is right. The Almighty Shogun would definitely wanna come to the festival.",
            "nextDialogs": [
              "725000108"
            ]
          },
          "725000108": {
            "id": "725000108",
            "speakerId": 12277,
            "speakerName": "Genta",
            "text": "Yeah... don't you agree?",
            "nextDialogs": [
              "725000109"
            ]
          },
          "725000109": {
            "id": "725000109",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "Come on, who cares what we think?",
            "nextDialogs": [
              "725000110"
            ]
          },
          "725000110": {
            "id": "725000110",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "Anyway, the boss was arrested on the spot by the Okuzumeshuu. They took him to the Tenryou Commission.",
            "nextDialogs": [
              "725000111"
            ]
          },
          "725000111": {
            "id": "725000111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you going to do?",
            "nextDialogs": [
              "725000112"
            ]
          },
          "725000112": {
            "id": "725000112",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "Shinobu's probably on the case by now.",
            "nextDialogs": [
              "725000113"
            ]
          },
          "725000113": {
            "id": "725000113",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "I heard the Okuzumeshuu charged the boss with causing a disturbance in a restricted military zone.",
            "nextDialogs": [
              "725000114"
            ]
          },
          "725000114": {
            "id": "725000114",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "Then Madam Kujou Sara changed it to obstructing the public order.",
            "nextDialogs": [
              "725000115"
            ]
          },
          "725000115": {
            "id": "725000115",
            "speakerId": 12277,
            "speakerName": "Genta",
            "text": "Ahhhhh, that despicable Kujou Tengu! How can she get away with charging Boss with a felony over something like this!",
            "nextDialogs": [
              "725000116"
            ]
          },
          "725000116": {
            "id": "725000116",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "You idiot! That's a misdemeanor, she downgraded the offense. Usually, you just get a warning for that...",
            "nextDialogs": [
              "725000117"
            ]
          },
          "725000117": {
            "id": "725000117",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "Anyway, I guess we'll just have to wait until the boss gets out before seeing what to do about the festival.",
            "nextDialogs": [
              "725000118"
            ]
          },
          "725000118": {
            "id": "725000118",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "Don't worry, Traveler. With Shinobu on the case, everything's gonna turn out just fine.",
            "nextDialogs": [
              "725000119"
            ]
          },
          "725000119": {
            "id": "725000119",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "You've been so supportive of our festival. When the boss gets out, I'm sure he'll want to thank you in person!",
            "nextDialogs": [
              "725000120"
            ]
          },
          "725000120": {
            "id": "725000120",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "I hope your journey, like our festival, will go from strength to strength.",
            "nextDialogs": [
              "725000121"
            ]
          },
          "725000121": {
            "id": "725000121",
            "speakerId": 1003,
            "speakerName": "Arataki Gang Members",
            "text": "From strength to strength!"
          }
        }
      }
    }
  ]
}
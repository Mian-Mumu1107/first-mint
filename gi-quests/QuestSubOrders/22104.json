  "subQuests": [
    {
      "subId": "2210401",
      "subQuestName": "Talk to Verr Goldet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221040101"
        ],
        "dialogs": {
          "221040101": {
            "id": "221040101",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "This is getting so stressful...",
            "nextDialogs": [
              "221040102"
            ]
          },
          "221040102": {
            "id": "221040102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "221040103"
            ]
          },
          "221040103": {
            "id": "221040103",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Oh, my apologies! When did you get here?",
            "nextDialogs": [
              "221040104"
            ]
          },
          "221040104": {
            "id": "221040104",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "The monster presence in this area is steadily growing, and although my husband insists they wouldn't dare set foot in the inn...",
            "nextDialogs": [
              "221040105"
            ]
          },
          "221040105": {
            "id": "221040105",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "He's the only one sufficiently prepared to fight back if they ever did. That concerns me a little.",
            "nextDialogs": [
              "221040106"
            ]
          },
          "221040106": {
            "id": "221040106",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "If you can spare the time, could you secure the surrounding area for me?",
            "nextDialogs": [
              "221040109",
              "221040110"
            ]
          },
          "221040109": {
            "id": "221040109",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "You have my gratitude.",
            "nextDialogs": [
              "221040113"
            ]
          },
          "221040113": {
            "id": "221040113",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "I am grateful for your help. You will be adequately compensated."
          },
          "221040110": {
            "id": "221040110",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Huh? There's nothing out-of-the-ordinary about the inn. It's just a little out of the way and sees a lot of traffic.",
            "nextDialogs": [
              "221040111"
            ]
          },
          "221040111": {
            "id": "221040111",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "But it's worthwhile. Travelers braving the wilderness need somewhere to get a good night's sleep and eat a proper meal.",
            "nextDialogs": [
              "221040112"
            ]
          },
          "221040112": {
            "id": "221040112",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "That's what my husband and I think, anyway. It's the simple truth."
          }
        }
      }
    },
    {
      "subId": "2210402",
      "subQuestName": "Go and check the suspicious location",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221040201"
        ],
        "dialogs": {
          "221040201": {
            "id": "221040201",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Is it done?",
            "nextDialogs": [
              "221040202"
            ]
          },
          "221040202": {
            "id": "221040202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet.",
            "nextDialogs": [
              "221040203"
            ]
          },
          "221040203": {
            "id": "221040203",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Take your time... And please, be careful. Something about this area just makes me uneasy."
          }
        }
      }
    },
    {
      "subId": "2210403",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221040301"
        ],
        "dialogs": {
          "221040301": {
            "id": "221040301",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Is it done?",
            "nextDialogs": [
              "221040302"
            ]
          },
          "221040302": {
            "id": "221040302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes.",
            "nextDialogs": [
              "221040303"
            ]
          },
          "221040303": {
            "id": "221040303",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Wonderful. I think we can all afford to relax now.",
            "nextDialogs": [
              "221040304"
            ]
          },
          "221040304": {
            "id": "221040304",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "As promised — compensation for your trouble."
          }
        }
      }
    },

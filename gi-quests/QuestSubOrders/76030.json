    {
      "subId": "7603005",
      "subQuestName": "Talk to The Damselette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760300501"
        ],
        "dialogs": {
          "760300501": {
            "id": "760300501",
            "speakerId": 15604,
            "speakerName": "Rijeka",
            "text": "*whimper* ... Huh? What's this...",
            "nextDialogs": [
              "760300502"
            ]
          },
          "760300502": {
            "id": "760300502",
            "speakerId": 15604,
            "speakerName": "Rijeka",
            "text": "It's... so pretty...",
            "nextDialogs": [
              "760300503"
            ]
          },
          "760300503": {
            "id": "760300503",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "That should do it.",
            "nextDialogs": [
              "760300504"
            ]
          },
          "760300504": {
            "id": "760300504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And off she goes. That trail of stone should lead her back to the Frostmoon Enclave.",
            "nextDialogs": [
              "760300505"
            ]
          },
          "760300505": {
            "id": "760300505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Columbina says she doesn't want to be treated like a god, but she helps those in need all the same...)",
            "nextDialogs": [
              "760300506"
            ]
          },
          "760300506": {
            "id": "760300506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, but what about the painting...",
            "nextDialogs": [
              "760300507"
            ]
          },
          "760300507": {
            "id": "760300507",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "It's alright.",
            "nextDialogs": [
              "760300508"
            ]
          },
          "760300508": {
            "id": "760300508",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "We can finish it some other time.",
            "nextDialogs": [
              "760300509"
            ]
          },
          "760300509": {
            "id": "760300509",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I like watching people find their way back home, to the place where they belong."
          }
        }
      }
    },

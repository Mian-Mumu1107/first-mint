    {
      "subId": "7603003",
      "subQuestName": "Talk to The Damselette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760300301"
        ],
        "dialogs": {
          "760300301": {
            "id": "760300301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This should be enough, right? Feels like we grabbed a whole bunch.",
            "nextDialogs": [
              "760300302"
            ]
          },
          "760300302": {
            "id": "760300302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "C'mon, let's head back. Can't leave that artwork incomplete forever, right?",
            "nextDialogs": [
              "760300303"
            ]
          },
          "760300303": {
            "id": "760300303",
            "speakerId": 15604,
            "speakerName": "Rijeka",
            "text": "*sob*",
            "nextDialogs": [
              "760300304"
            ]
          },
          "760300304": {
            "id": "760300304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aaahh! Quick, hide! Someone's here!",
            "nextDialogs": [
              "760300305"
            ]
          },
          "760300305": {
            "id": "760300305",
            "speakerId": 15604,
            "speakerName": "Rijeka",
            "text": "*sob* Where am I... Mommy... I wanna go home...",
            "nextDialogs": [
              "760300306"
            ]
          },
          "760300306": {
            "id": "760300306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like she's one of the Frostmoon Scions. Is she lost?",
            "nextDialogs": [
              "760300307"
            ]
          },
          "760300307": {
            "id": "760300307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll go help her...",
            "nextDialogs": [
              "760300308"
            ]
          },
          "760300308": {
            "id": "760300308",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "You will?",
            "nextDialogs": [
              "760300309"
            ]
          },
          "760300309": {
            "id": "760300309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, of course! She sure looks like she needs it!",
            "nextDialogs": [
              "760300310"
            ]
          },
          "760300310": {
            "id": "760300310",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The Frostmoon Scions are deeply wary of outsiders, correct? You have no antlers, the hour is late... What if you scare her off instead...",
            "nextDialogs": [
              "760300311"
            ]
          },
          "760300311": {
            "id": "760300311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay, that could happen, but we can't just do nothing!",
            "nextDialogs": [
              "760300312"
            ]
          },
          "760300312": {
            "id": "760300312",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Hmm... Come with me, then.",
            "nextDialogs": [
              "760300313"
            ]
          },
          "760300313": {
            "id": "760300313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh?"
          }
        }
      }
    },

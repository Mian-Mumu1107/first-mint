  "subQuests": [
    {
      "subId": "7603001",
      "subQuestName": "Meet The Damselette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760300101"
        ],
        "dialogs": {
          "760300101": {
            "id": "760300101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm. The atmosphere's a little unusual today. Are you decorating this flower field, Columbina?",
            "nextDialogs": [
              "760300102"
            ]
          },
          "760300102": {
            "id": "760300102",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Ah, that wasn't me. It was them.",
            "nextDialogs": [
              "760300103"
            ]
          },
          "760300103": {
            "id": "760300103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You mean... the kuuhenki?",
            "nextDialogs": [
              "760300104"
            ]
          },
          "760300104": {
            "id": "760300104",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Yes. These stones emit a faint light upon absorbing kuuvahki. The kuuhenki are quite fond of them.",
            "nextDialogs": [
              "760300105"
            ]
          },
          "760300105": {
            "id": "760300105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So they just... put them on the ground and play with them?",
            "nextDialogs": [
              "760300106"
            ]
          },
          "760300106": {
            "id": "760300106",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Not exactly. Come over here and look.",
            "nextDialogs": [
              "760300107"
            ]
          },
          "760300107": {
            "id": "760300107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh...?",
            "nextDialogs": [
              "760300108"
            ]
          },
          "760300108": {
            "id": "760300108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh! It forms a picture when you look at it from above!",
            "nextDialogs": [
              "760300109"
            ]
          },
          "760300109": {
            "id": "760300109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Looks like we're a chunk short, though...",
            "nextDialogs": [
              "760300110"
            ]
          },
          "760300110": {
            "id": "760300110",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "That's right. I need to go collect some more.",
            "nextDialogs": [
              "760300111"
            ]
          },
          "760300111": {
            "id": "760300111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, so you're heading out?",
            "nextDialogs": [
              "760300112"
            ]
          },
          "760300112": {
            "id": "760300112",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Yes, I know just the place — it's graced by the moon, so these kinds of stones are abundant.",
            "nextDialogs": [
              "760300113"
            ]
          },
          "760300113": {
            "id": "760300113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Want us to come with?",
            "nextDialogs": [
              "760300114"
            ]
          },
          "760300114": {
            "id": "760300114",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Sure.",
            "nextDialogs": [
              "760300115"
            ]
          },
          "760300115": {
            "id": "760300115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright, then let's get collecting! We wanna see what the finished picture looks like, too!"
          }
        }
      }
    },

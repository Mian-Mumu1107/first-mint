  "subQuests": [
    {
      "subId": "2400701",
      "subQuestName": "Talk to Lovi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240070101"
        ],
        "dialogs": {
          "240070101": {
            "id": "240070101",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Lovi, did you find something good?",
            "nextDialogs": [
              "240070102"
            ]
          },
          "240070102": {
            "id": "240070102",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Nope, there's nothing here at all!",
            "nextDialogs": [
              "240070103"
            ]
          },
          "240070103": {
            "id": "240070103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "240070104"
            ]
          },
          "240070104": {
            "id": "240070104",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "We're looking for treasure! Hehe... Would you like to join us?",
            "nextDialogs": [
              "240070106",
              "240070109"
            ]
          },
          "240070106": {
            "id": "240070106",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Don't listen to Verut's bragging. We're just looking to fish up some components.",
            "nextDialogs": [
              "240070107"
            ]
          },
          "240070107": {
            "id": "240070107",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Well, the components are treasure... Huh? There should be some here...",
            "nextDialogs": [
              "240070114"
            ]
          },
          "240070114": {
            "id": "240070114",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Looks like we're not going to find anything here. Shall we go somewhere else?",
            "nextDialogs": [
              "240070115"
            ]
          },
          "240070115": {
            "id": "240070115",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Sure! Let's go a little further up ahead."
          },
          "240070109": {
            "id": "240070109",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "He went to look for Mr. Delerue with some questions.",
            "nextDialogs": [
              "240070110"
            ]
          },
          "240070110": {
            "id": "240070110",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "As for us, we had to be good and stay good... and search for treasure.",
            "nextDialogs": [
              "240070111"
            ]
          },
          "240070111": {
            "id": "240070111",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Hehe, so... would you like to join us?",
            "nextDialogs": [
              "240070112"
            ]
          },
          "240070112": {
            "id": "240070112",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Don't listen to Verut's bragging. We're just looking to fish up some components.",
            "nextDialogs": [
              "240070113"
            ]
          },
          "240070113": {
            "id": "240070113",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Well, the components are treasure... Huh? There should be some here..."
          }
        }
      }
    },
    {
      "subId": "2400702",
      "subQuestName": "Look for \"treasure\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240070201"
        ],
        "dialogs": {
          "240070201": {
            "id": "240070201",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "There's just some rotten cardboard here... and no components.",
            "nextDialogs": [
              "240070202"
            ]
          },
          "240070202": {
            "id": "240070202",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "That's weird. I fished a few gears out of the water here just yesterday."
          }
        }
      }
    },
    {
      "subId": "2400703",
      "subQuestName": "Look for \"treasure\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240070301"
        ],
        "dialogs": {
          "240070301": {
            "id": "240070301",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Found one! This gear is quite complete. There's even a whole bearing over here.",
            "nextDialogs": [
              "240070302"
            ]
          },
          "240070302": {
            "id": "240070302",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Nice, we can use these!"
          }
        }
      }
    },
    {
      "subId": "2400704",
      "subQuestName": "Look for \"treasure\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240070401"
        ],
        "dialogs": {
          "240070401": {
            "id": "240070401",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "These are... tattered clothes? Their colors have run completely...",
            "nextDialogs": [
              "240070402"
            ]
          },
          "240070402": {
            "id": "240070402",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Has someone fished around this area already? There are no components here at all..."
          }
        }
      }
    },
    {
      "subId": "2400705",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240070501"
        ],
        "dialogs": {
          "240070501": {
            "id": "240070501",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Let me see... We can use this gear, and if we saw this bearing open...",
            "nextDialogs": [
              "240070502"
            ]
          },
          "240070502": {
            "id": "240070502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you looking for this for?",
            "nextDialogs": [
              "240070503"
            ]
          },
          "240070503": {
            "id": "240070503",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "I'm trying to make my own clockwork puppet. Actually, I've been secretly looking into knowledge related to that.",
            "nextDialogs": [
              "240070504"
            ]
          },
          "240070504": {
            "id": "240070504",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Once I figure it all out, I'm going to make a huge Clockwork Meka — now that'll stun Daddy!",
            "nextDialogs": [
              "240070505"
            ]
          },
          "240070505": {
            "id": "240070505",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "I've read lots of books in his room, and I've made some basic components according to the instructions therein.",
            "nextDialogs": [
              "240070506"
            ]
          },
          "240070506": {
            "id": "240070506",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "I'm pretty sure that mek's within reach so long as I keep working at it!",
            "nextDialogs": [
              "240070507"
            ]
          },
          "240070507": {
            "id": "240070507",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "But I can't study these things in the city, or he'll find out — and that would ruin the surprise.",
            "nextDialogs": [
              "240070508"
            ]
          },
          "240070508": {
            "id": "240070508",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "That's how this place became Lovi's secret clockwork research base. As for me... Well, I'm her assistant.",
            "nextDialogs": [
              "240070509"
            ]
          },
          "240070509": {
            "id": "240070509",
            "speakerId": 5021,
            "speakerName": "Lovi",
            "text": "Well, assistant, talk is cheap! Let's start our research. Today, we must make a moving mechanical arm!",
            "nextDialogs": [
              "240070510"
            ]
          },
          "240070510": {
            "id": "240070510",
            "speakerId": 5062,
            "speakerName": "Verut",
            "text": "Aye aye, ma'am! Let our research begin!"
          }
        }
      }
    },

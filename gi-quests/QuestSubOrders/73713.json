      "dialogue": {
        "startDialogs": [
          "737130101"
        ],
        "dialogs": {
          "737130101": {
            "id": "737130101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ta-da! We're here! Let's go in from this shallow bit. It'll feel like we're walking into a painting — one that unfolds right before our very eyes!",
            "nextDialogs": [
              "737130102"
            ]
          },
          "737130102": {
            "id": "737130102",
            "speakerId": 17042,
            "speakerName": "Marine",
            "text": "Ah... It's you. And you've brought some new companions? Are they... Fungi? I've only ever read about them...",
            "nextDialogs": [
              "737130103"
            ]
          },
          "737130103": {
            "id": "737130103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What a lovely surprise, a Melusine's hanging out here!",
            "nextDialogs": [
              "737130106"
            ]
          },
          "737130106": {
            "id": "737130106",
            "speakerId": 17042,
            "speakerName": "Marine",
            "text": "I'm not \"hanging out,\" I'm picking Tidalga for this year's pickled batch. A lot of the others have returned to the village to help too.",
            "nextDialogs": [
              "737130107"
            ]
          },
          "737130107": {
            "id": "737130107",
            "speakerId": 17042,
            "speakerName": "Marine",
            "text": "Enghiene and little Roxane both took leave to come back and help. They're hard at work right now, and I'll be heading into the water myself in a bit.",
            "nextDialogs": [
              "737130108"
            ]
          },
          "737130108": {
            "id": "737130108",
            "speakerId": 17042,
            "speakerName": "Marine",
            "text": "You know... Enghiene wasn't wrong. The blue Fungi really do look a bit like Tidalga...",
            "nextDialogs": [
              "737130109"
            ]
          },
          "737130109": {
            "id": "737130109",
            "speakerId": 17042,
            "speakerName": "Marine",
            "text": "Not in a food sense! I just meant they're cute. Nothing else...",
            "nextDialogs": [
              "737130110"
            ]
          },
          "737130110": {
            "id": "737130110",
            "speakerId": 30969,
            "speakerName": "Bongo-Head",
            "text": "♫♪~",
            "nextDialogs": [
              "737130111"
            ]
          },
          "737130111": {
            "id": "737130111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe~ You've got a good eye for cuteness!"
          }
        }
      }
    }
  ]

    {
      "subId": "4001101",
      "subQuestName": "Chat about the island",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110101"
        ],
        "dialogs": {
          "400110101": {
            "id": "400110101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ahh... The weather's so nice. Still feels like Paimon's dreaming.",
            "nextDialogs": [
              "400110102"
            ]
          },
          "400110102": {
            "id": "400110102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Good morning! Wh—Wha, what's with everyone's clothes!?",
            "nextDialogs": [
              "400110103"
            ]
          },
          "400110103": {
            "id": "400110103",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Hehe! So, how do we look?",
            "nextDialogs": [
              "400110104"
            ]
          },
          "400110104": {
            "id": "400110104",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "We changed into summer clothes! Although we didn't come here to have fun, we don't want to miss out on a beautiful summer day by the sea!",
            "nextDialogs": [
              "400110105"
            ]
          },
          "400110105": {
            "id": "400110105",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Th—This doesn't look weird, does it?",
            "nextDialogs": [
              "400110106"
            ]
          },
          "400110106": {
            "id": "400110106",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Such light and summery clothing definitely doesn't suit me... Ah, hehe... pardon me.",
            "nextDialogs": [
              "400110109"
            ]
          },
          "400110109": {
            "id": "400110109",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Really...? Thank you, Traveler.",
            "nextDialogs": [
              "400110110"
            ]
          },
          "400110110": {
            "id": "400110110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's surprising that Master Jean would specially pack summer clothes.",
            "nextDialogs": [
              "400110111"
            ]
          },
          "400110111": {
            "id": "400110111",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Oh no, my big sister would never pack these herself. Lisa and I picked them out for her.",
            "nextDialogs": [
              "400110112"
            ]
          },
          "400110112": {
            "id": "400110112",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Blurting out \"big sister\" and not even realizing it... Barbara's drunk on summer already!",
            "nextDialogs": [
              "400110113"
            ]
          },
          "400110113": {
            "id": "400110113",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "There's quite a story behind these summer clothes...",
            "nextDialogs": [
              "400110114"
            ]
          },
          "400110114": {
            "id": "400110114",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "I thought Lisa's pouch was to be used for an emergency. I didn't expect it to contain a set of summer clothing.",
            "nextDialogs": [
              "400110115"
            ]
          },
          "400110115": {
            "id": "400110115",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "All these accessories, too... Definitely Lisa's handiwork.",
            "nextDialogs": [
              "400110116"
            ]
          },
          "400110116": {
            "id": "400110116",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Everyone in the Knights of Favonius is always trying to have me take leave. I suppose I do push myself too much...",
            "nextDialogs": [
              "400110117"
            ]
          },
          "400110117": {
            "id": "400110117",
            "speakerId": 1003,
            "speakerName": "???",
            "text": "Everyone, come over here!",
            "nextDialogs": [
              "400110118"
            ]
          },
          "400110118": {
            "id": "400110118",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "That's Klee's voice!",
            "nextDialogs": [
              "400110119"
            ]
          },
          "400110119": {
            "id": "400110119",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "I saw something weird.",
            "nextDialogs": [
              "400110120"
            ]
          },
          "400110120": {
            "id": "400110120",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? What's going on? What do you mean by something weird?",
            "nextDialogs": [
              "400110121"
            ]
          },
          "400110121": {
            "id": "400110121",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Look at the ocean!",
            "nextDialogs": [
              "400110122"
            ]
          },
          "400110122": {
            "id": "400110122",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "See? There's something weird floating on the water!",
            "nextDialogs": [
              "400110123"
            ]
          },
          "400110123": {
            "id": "400110123",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "That narrow device... It seems to be a buoy.",
            "nextDialogs": [
              "400110124"
            ]
          },
          "400110124": {
            "id": "400110124",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "But we didn't see anything when we arrived here yesterday...",
            "nextDialogs": [
              "400110125"
            ]
          },
          "400110125": {
            "id": "400110125",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Dodo-King must have put them there!",
            "nextDialogs": [
              "400110126"
            ]
          },
          "400110126": {
            "id": "400110126",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Strange devices that just appear overnight... Something doesn't add up.",
            "nextDialogs": [
              "400110127"
            ]
          },
          "400110127": {
            "id": "400110127",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Well, since he hasn't revealed himself to us, does that mean he's changed his mind? Or maybe...",
            "nextDialogs": [
              "400110128"
            ]
          },
          "400110128": {
            "id": "400110128",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Maybe these buoys are a clue and he's waiting for me to find him!",
            "nextDialogs": [
              "400110129"
            ]
          },
          "400110129": {
            "id": "400110129",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "So could that be why these buoys have suddenly appeared?",
            "nextDialogs": [
              "400110130"
            ]
          },
          "400110130": {
            "id": "400110130",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's take a closer look and find out.",
            "nextDialogs": [
              "400110131"
            ]
          },
          "400110131": {
            "id": "400110131",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Right, we won't solve anything by guessing on-shore.",
            "nextDialogs": [
              "400110132"
            ]
          },
          "400110132": {
            "id": "400110132",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Is it okay to go out there though?",
            "nextDialogs": [
              "400110133"
            ]
          },
          "400110133": {
            "id": "400110133",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Perhaps, but we must investigate the buoys regardless.",
            "nextDialogs": [
              "400110134"
            ]
          },
          "400110134": {
            "id": "400110134",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "It's hard to say what will be waiting for us at sea. Just in case, prepare yourselves for combat.",
            "nextDialogs": [
              "400110135"
            ]
          },
          "400110135": {
            "id": "400110135",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Once you are ready, please assemble here, and we'll head over on the boat together."
          }
        }
      }
    },
    {
      "subId": "4001102",
      "subQuestName": "Confirm your combat readiness",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110201"
        ],
        "dialogs": {
          "400110201": {
            "id": "400110201",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "What could those buoys possibly mean...?",
            "nextDialogs": [
              "400110203",
              "400110207"
            ]
          },
          "400110203": {
            "id": "400110203",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "These islands are isolated from the outside world, like a secret Domain crafted by nature itself.",
            "nextDialogs": [
              "400110204"
            ]
          },
          "400110204": {
            "id": "400110204",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "We were guided here by the letter and with the assistance of Venti and Dvalin... Everything seems a bit too serendipitous. I'm a little concerned.",
            "nextDialogs": [
              "400110205"
            ]
          },
          "400110205": {
            "id": "400110205",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "But I'm here to protect you all, so please don't worry. Come what may, I will face it head-on."
          },
          "400110207": {
            "id": "400110207",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Ah... Su—Summer clothes, they're, uh... They were a surprise that Lisa prepared for me. My guess is that it was originally Barbara's suggestion.",
            "nextDialogs": [
              "400110208"
            ]
          },
          "400110208": {
            "id": "400110208",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Barbara said that it's so rare for us to get a chance to come to an island, we should change into summer clothing to set the atmosphere.",
            "nextDialogs": [
              "400110209"
            ]
          },
          "400110209": {
            "id": "400110209",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "However, I'm not used to this style of clothing. *sigh* I hope wearing this doesn't look too odd."
          }
        }
      }
    },

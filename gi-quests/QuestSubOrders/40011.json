    {
      "subId": "4001109",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110901"
        ],
        "dialogs": {
          "400110901": {
            "id": "400110901",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Have you finished your preparations?",
            "nextDialogs": [
              "400110903",
              "400110905"
            ]
          },
          "400110903": {
            "id": "400110903",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "There is no need to rush. Take your time organizing your things. I will wait for you all here."
          },
          "400110905": {
            "id": "400110905",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Great, then let's head to the <color=#00E1FFFF>boat</color>."
          }
        }
      }
    },

    {
      "subId": "4001106",
      "subQuestName": "Check out the mysterious person before you",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110601"
        ],
        "dialogs": {
          "400110601": {
            "id": "400110601",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Everyone, please be careful!",
            "nextDialogs": [
              "400110602"
            ]
          },
          "400110602": {
            "id": "400110602",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Is that a really tall person?",
            "nextDialogs": [
              "400110603"
            ]
          },
          "400110603": {
            "id": "400110603",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "It resembles a human, but something's not quite right.",
            "nextDialogs": [
              "400110604"
            ]
          },
          "400110604": {
            "id": "400110604",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Dodo-King, I see you! You can, uh, Arb... Arbi...",
            "nextDialogs": [
              "400110605"
            ]
          },
          "400110605": {
            "id": "400110605",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Arbitrate!",
            "nextDialogs": [
              "400110606"
            ]
          },
          "400110606": {
            "id": "400110606",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Right! You can arbitrate Klee!",
            "nextDialogs": [
              "400110607"
            ]
          },
          "400110607": {
            "id": "400110607",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh! What is this kid saying!?",
            "nextDialogs": [
              "400110608"
            ]
          },
          "400110608": {
            "id": "400110608",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "She obviously doesn't understand what that word means...",
            "nextDialogs": [
              "400110609"
            ]
          },
          "400110609": {
            "id": "400110609",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Hey, Dodo-King! Why are you ignoring me?",
            "nextDialogs": [
              "400110610"
            ]
          },
          "400110610": {
            "id": "400110610",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Is it because I took too long and made you angry? Then... I'm sorry!",
            "nextDialogs": [
              "400110611"
            ]
          },
          "400110611": {
            "id": "400110611",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Huh, and now she's apologizing? I didn't see that coming...",
            "nextDialogs": [
              "400110612"
            ]
          },
          "400110612": {
            "id": "400110612",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Hello! Dodo-King!",
            "nextDialogs": [
              "400110613"
            ]
          },
          "400110613": {
            "id": "400110613",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "It looks like they're not interested in Klee at all.",
            "nextDialogs": [
              "400110614"
            ]
          },
          "400110614": {
            "id": "400110614",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "It's some kind of humanoid machine. No response... It must be damaged.",
            "nextDialogs": [
              "400110615"
            ]
          },
          "400110615": {
            "id": "400110615",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Oh, do you recognize it?",
            "nextDialogs": [
              "400110616"
            ]
          },
          "400110616": {
            "id": "400110616",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "No, I can only guess. It looks completely out of place on this island... Look at its clothes. It appears like it came from Inazuma.",
            "nextDialogs": [
              "400110617"
            ]
          },
          "400110617": {
            "id": "400110617",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Inazuma? But isn't that really far away?",
            "nextDialogs": [
              "400110618"
            ]
          },
          "400110618": {
            "id": "400110618",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So this machine isn't from around here?",
            "nextDialogs": [
              "400110619"
            ]
          },
          "400110619": {
            "id": "400110619",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "It would appear so. This area of the sea is independent and does not border any country, so it certainly seems out of place here.",
            "nextDialogs": [
              "400110620"
            ]
          },
          "400110620": {
            "id": "400110620",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "But given Inazuma's current situation, how could something like this occur...?",
            "nextDialogs": [
              "400110621"
            ]
          },
          "400110621": {
            "id": "400110621",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "An abandoned machine... Weird! Did someone bring it here?",
            "nextDialogs": [
              "400110622"
            ]
          },
          "400110622": {
            "id": "400110622",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Oh no! Dodo-King isn't moving anymore!",
            "nextDialogs": [
              "400110623"
            ]
          },
          "400110623": {
            "id": "400110623",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Klee, maybe Dodo-King is tired.",
            "nextDialogs": [
              "400110624"
            ]
          },
          "400110624": {
            "id": "400110624",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Right, right, Dodo-King is probably asleep. He was waiting so patiently for you and then *yawn* — nap time!",
            "nextDialogs": [
              "400110625"
            ]
          },
          "400110625": {
            "id": "400110625",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Let's go with Klee to play elsewhere and come back once Dodo-King wakes up.",
            "nextDialogs": [
              "400110626"
            ]
          },
          "400110626": {
            "id": "400110626",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Really?",
            "nextDialogs": [
              "400110627"
            ]
          },
          "400110627": {
            "id": "400110627",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Of course!",
            "nextDialogs": [
              "400110628"
            ]
          },
          "400110628": {
            "id": "400110628",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Hm... No, I get it now!",
            "nextDialogs": [
              "400110629"
            ]
          },
          "400110629": {
            "id": "400110629",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "This isn't Dodo-King. The real Dodo-King is somewhere else.",
            "nextDialogs": [
              "400110630"
            ]
          },
          "400110630": {
            "id": "400110630",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Huh? I—Is that right?",
            "nextDialogs": [
              "400110631"
            ]
          },
          "400110631": {
            "id": "400110631",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "I won't give up. Dodo-King, just wait! We'll find you!",
            "nextDialogs": [
              "400110632"
            ]
          },
          "400110632": {
            "id": "400110632",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And there she goes again... Whew, she's got a lot of spirit.",
            "nextDialogs": [
              "400110633"
            ]
          },
          "400110633": {
            "id": "400110633",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Klee, wait for us!"
          }
        }
      }
    },
    {
      "subId": "4001107",
      "subQuestName": "Examine your environment",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110701"
        ],
        "dialogs": {
          "400110701": {
            "id": "400110701",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Honorary Knight, look here!",
            "nextDialogs": [
              "400110702"
            ]
          },
          "400110702": {
            "id": "400110702",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? What's this?",
            "nextDialogs": [
              "400110703"
            ]
          },
          "400110703": {
            "id": "400110703",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Look at these stacked-up stones and small flowers...",
            "nextDialogs": [
              "400110704"
            ]
          },
          "400110704": {
            "id": "400110704",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "It feels like a memorial for someone.",
            "nextDialogs": [
              "400110707"
            ]
          },
          "400110707": {
            "id": "400110707",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Hey, you're embarrassing me...",
            "nextDialogs": [
              "400110708"
            ]
          },
          "400110708": {
            "id": "400110708",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But the only other thing around here is that machine in Inazuman clothing.",
            "nextDialogs": [
              "400110709"
            ]
          },
          "400110709": {
            "id": "400110709",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Could the memorial be for the machine?",
            "nextDialogs": [
              "400110710"
            ]
          },
          "400110710": {
            "id": "400110710",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Perhaps it once performed some deed that merited a memorial.",
            "nextDialogs": [
              "400110711"
            ]
          },
          "400110711": {
            "id": "400110711",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "...",
            "nextDialogs": [
              "400110712"
            ]
          },
          "400110712": {
            "id": "400110712",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Everything we've seen here indicates that there was once a human presence in these waters. Still, there isn't enough for us to infer what kind of civilization it was.",
            "nextDialogs": [
              "400110713"
            ]
          },
          "400110713": {
            "id": "400110713",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "And up to now, we still have yet to see any people or gravestones.",
            "nextDialogs": [
              "400110714"
            ]
          },
          "400110714": {
            "id": "400110714",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Master Jean, can I go over there and have a look?",
            "nextDialogs": [
              "400110715"
            ]
          },
          "400110715": {
            "id": "400110715",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Yes, but be careful!",
            "nextDialogs": [
              "400110716"
            ]
          },
          "400110716": {
            "id": "400110716",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Okay!",
            "nextDialogs": [
              "400110717"
            ]
          },
          "400110717": {
            "id": "400110717",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How many secrets do these islands hold?",
            "nextDialogs": [
              "400110718"
            ]
          },
          "400110718": {
            "id": "400110718",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Klee is too young to have a proper sense of danger. Traveler, the rest of us must stay alert to the situation.",
            "nextDialogs": [
              "400110719"
            ]
          },
          "400110719": {
            "id": "400110719",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Honestly speaking, I thought that letter was only a prank at first.",
            "nextDialogs": [
              "400110720"
            ]
          },
          "400110720": {
            "id": "400110720",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That's what we thought.",
            "nextDialogs": [
              "400110721"
            ]
          },
          "400110721": {
            "id": "400110721",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "I suspected as much too, but who would send a prank letter to a child?",
            "nextDialogs": [
              "400110722"
            ]
          },
          "400110722": {
            "id": "400110722",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "A letter that guides us to activate mechanisms on a deserted archipelago... It's bizarre.",
            "nextDialogs": [
              "400110723"
            ]
          },
          "400110723": {
            "id": "400110723",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "It makes me wonder whether this isn't some kind of trap, long in the making. We must keep our guard up.",
            "nextDialogs": [
              "400110724"
            ]
          },
          "400110724": {
            "id": "400110724",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Miss Barbara!",
            "nextDialogs": [
              "400110725"
            ]
          },
          "400110725": {
            "id": "400110725",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Klee, what's wrong?",
            "nextDialogs": [
              "400110726"
            ]
          },
          "400110726": {
            "id": "400110726",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Do you think that Dodo-King doesn't want to see Klee?",
            "nextDialogs": [
              "400110727"
            ]
          },
          "400110727": {
            "id": "400110727",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Why would the Dodo-King not want to see you, Klee?",
            "nextDialogs": [
              "400110728"
            ]
          },
          "400110728": {
            "id": "400110728",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Dodoco loves me, an—and I love Dodoco, so Dodo-King can never separate us. That's why Dodo-King doesn't want to see us...",
            "nextDialogs": [
              "400110729"
            ]
          },
          "400110729": {
            "id": "400110729",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "*whimper* Klee doesn't want him to separate us.",
            "nextDialogs": [
              "400110730"
            ]
          },
          "400110730": {
            "id": "400110730",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "...",
            "nextDialogs": [
              "400110731"
            ]
          },
          "400110731": {
            "id": "400110731",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Hey Klee, do you know what this is?",
            "nextDialogs": [
              "400110732"
            ]
          },
          "400110732": {
            "id": "400110732",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "It's a harpastum!",
            "nextDialogs": [
              "400110733"
            ]
          },
          "400110733": {
            "id": "400110733",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "I heard my big sis— Uh, Master Jean say that Klee always wanted to play harpastum, right?",
            "nextDialogs": [
              "400110734"
            ]
          },
          "400110734": {
            "id": "400110734",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Yeah! Klee was just thinking about Ludi Harpastum!",
            "nextDialogs": [
              "400110735"
            ]
          },
          "400110735": {
            "id": "400110735",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "I made this harpastum especially for you. Now every day can be Ludi Harpastum, hee-hee!",
            "nextDialogs": [
              "400110736"
            ]
          },
          "400110736": {
            "id": "400110736",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Yay!",
            "nextDialogs": [
              "400110737"
            ]
          },
          "400110737": {
            "id": "400110737",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The kindness of a deaconess...",
            "nextDialogs": [
              "400110738"
            ]
          },
          "400110738": {
            "id": "400110738",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "So keep your chin up, Klee! After we meet Dodo-King, we can all help you convince him to let you and Dodoco stay together.",
            "nextDialogs": [
              "400110739"
            ]
          },
          "400110739": {
            "id": "400110739",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Okay!",
            "nextDialogs": [
              "400110740"
            ]
          },
          "400110740": {
            "id": "400110740",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's double our efforts. We have to find him.",
            "nextDialogs": [
              "400110741"
            ]
          },
          "400110741": {
            "id": "400110741",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Yeah!",
            "nextDialogs": [
              "400110742"
            ]
          },
          "400110742": {
            "id": "400110742",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Leave it to us Klee. This Dodo-jerk can't hide forever.",
            "nextDialogs": [
              "400110743"
            ]
          },
          "400110743": {
            "id": "400110743",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Even if it takes a thousand years and a thousand searches... uh, w—we'll get him! Ahem...",
            "nextDialogs": [
              "400110744"
            ]
          },
          "400110744": {
            "id": "400110744",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But until then, let's have a good look around the area!"
          }
        }
      }
    },
    {
      "subId": "4001111",
      "subQuestName": "Listen to everyone's opinion",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4001104",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110401"
        ],
        "dialogs": {
          "400110401": {
            "id": "400110401",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Hmm, I need to bring Jumpy Dumpties, Dodoco, and... myself!",
            "nextDialogs": [
              "400110407",
              "400110403"
            ]
          },
          "400110407": {
            "id": "400110407",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Dodo-King must have placed those things in the ocean! He's a bad guy!",
            "nextDialogs": [
              "400110408"
            ]
          },
          "400110408": {
            "id": "400110408",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "But I will bravely face him and do my best for Dodoco!",
            "nextDialogs": [
              "400110409"
            ]
          },
          "400110409": {
            "id": "400110409",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "#{F#Miss}{M#Mr.} Honorary Knight, thank you for helping me."
          },
          "400110403": {
            "id": "400110403",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "I like summer! But not just summer.",
            "nextDialogs": [
              "400110404"
            ]
          },
          "400110404": {
            "id": "400110404",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "I also like fall. Oh yes, and I also like spring and winter!",
            "nextDialogs": [
              "400110405"
            ]
          },
          "400110405": {
            "id": "400110405",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Even though winter's very cold, I have Jumpy Dumpty. Whenever I feel cold, I blow something up."
          }
        }
      }
    }
  ]
}
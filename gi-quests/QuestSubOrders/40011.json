    {
      "subId": "4001103",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110301"
        ],
        "dialogs": {
          "400110301": {
            "id": "400110301",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Hmm? Is there anything I can do?",
            "nextDialogs": [
              "400110303",
              "400110307"
            ]
          },
          "400110303": {
            "id": "400110303",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "I just want to say that the ocean here is beautiful!",
            "nextDialogs": [
              "400110304"
            ]
          },
          "400110304": {
            "id": "400110304",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Sea and sun — a summer dream come true!",
            "nextDialogs": [
              "400110305"
            ]
          },
          "400110305": {
            "id": "400110305",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "I really want to have a seaside performance! It would be amazing, I just know it!"
          },
          "400110307": {
            "id": "400110307",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "How do I look? Not bad, right?",
            "nextDialogs": [
              "400110308"
            ]
          },
          "400110308": {
            "id": "400110308",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "I wanted to surprise everyone, so I specifically chose an outfit complementing an island atmosphere.",
            "nextDialogs": [
              "400110309"
            ]
          },
          "400110309": {
            "id": "400110309",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Oh, but please don't worry! Even if I'm wearing summer clothes, I'm still just as reliable in battle!"
          }
        }
      }
    },
    {
      "subId": "4001104",
      "subQuestName": "Talk to everyone about the changes to the island",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110501"
        ],
        "dialogs": {
          "400110501": {
            "id": "400110501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ah, what's going on here? This part of the ocean is way too mysterious!",
            "nextDialogs": [
              "400110502"
            ]
          },
          "400110502": {
            "id": "400110502",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "This whole stretch of land just rose out of the water!",
            "nextDialogs": [
              "400110503"
            ]
          },
          "400110503": {
            "id": "400110503",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "Dodo-King, Dodo-King, I'm gonna catch you! Hehe!",
            "nextDialogs": [
              "400110504"
            ]
          },
          "400110504": {
            "id": "400110504",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Looks like Klee's as energetic as ever.",
            "nextDialogs": [
              "400110505"
            ]
          },
          "400110505": {
            "id": "400110505",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Before the ground started shaking, I heard the sound of machinery. I believe there may be an immense mechanical structure under this region of the ocean.",
            "nextDialogs": [
              "400110506"
            ]
          },
          "400110506": {
            "id": "400110506",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "With the entire archipelago situated on a mechanical framework, it could be activated to raise each island from beneath the water.",
            "nextDialogs": [
              "400110507"
            ]
          },
          "400110507": {
            "id": "400110507",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Something like that would be nothing short of a miracle... Could it be the power of the Anemo Archon, Barbatos?",
            "nextDialogs": [
              "400110508"
            ]
          },
          "400110508": {
            "id": "400110508",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, probably not. Paimon feels like this is more likely a deliberate set-up...",
            "nextDialogs": [
              "400110509"
            ]
          },
          "400110509": {
            "id": "400110509",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "It's incredible, no matter how you think of it. Using a letter to draw us here and these challenges involving various mechanisms... This so-called Dodo-King is no amateur.",
            "nextDialogs": [
              "400110510"
            ]
          },
          "400110510": {
            "id": "400110510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I agree with Jean.",
            "nextDialogs": [
              "400110511"
            ]
          },
          "400110511": {
            "id": "400110511",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Aw, there goes the holiday mood...",
            "nextDialogs": [
              "400110512"
            ]
          },
          "400110512": {
            "id": "400110512",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "...",
            "nextDialogs": [
              "400110513"
            ]
          },
          "400110513": {
            "id": "400110513",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Well, either way, I will do my best to remain vigilant.",
            "nextDialogs": [
              "400110514"
            ]
          },
          "400110514": {
            "id": "400110514",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wow! Master Jean's so cool when she's determined!",
            "nextDialogs": [
              "400110515"
            ]
          },
          "400110515": {
            "id": "400110515",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon and I will also exercise increased caution.",
            "nextDialogs": [
              "400110516"
            ]
          },
          "400110516": {
            "id": "400110516",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Thank you for your understanding.",
            "nextDialogs": [
              "400110517"
            ]
          },
          "400110517": {
            "id": "400110517",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "I found him! It's Dodo-King!",
            "nextDialogs": [
              "400110518"
            ]
          },
          "400110518": {
            "id": "400110518",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "He's over on that island! Hee-hee, gotcha!",
            "nextDialogs": [
              "400110519"
            ]
          },
          "400110519": {
            "id": "400110519",
            "speakerId": 1004,
            "speakerName": "Klee",
            "text": "You wanted Klee to come find you, so here Klee comes! Jumpy Dumpties, get ready~! Let's go!",
            "nextDialogs": [
              "400110520"
            ]
          },
          "400110520": {
            "id": "400110520",
            "speakerId": 1001,
            "speakerName": "Barbara",
            "text": "Is that... <color=#00E1FFFF>a platform in the middle of the ocean</color>?",
            "nextDialogs": [
              "400110521"
            ]
          },
          "400110521": {
            "id": "400110521",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Something has appeared. Everyone, we can take a closer look, but please be on guard."
          }
        }
      }
    },
    {
      "subId": "4001105",

  "subQuests": [
    {
      "subId": "48101",
      "subQuestName": "Talk to Amber",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4810101"
        ],
        "dialogs": {
          "4810101": {
            "id": "4810101",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "#Hey {NICKNAME}! I've been looking for you everywhere! How's that wind glider I gave you last time?",
            "nextDialogs": [
              "4810104"
            ]
          },
          "4810104": {
            "id": "4810104",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Seems like it's really growing on you!",
            "nextDialogs": [
              "4810105"
            ]
          },
          "4810105": {
            "id": "4810105",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "But then again, you don't have a gliding license, do you?",
            "nextDialogs": [
              "4810106"
            ]
          },
          "4810106": {
            "id": "4810106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A gliding license? Hmm... What's that?",
            "nextDialogs": [
              "4810107"
            ]
          },
          "4810107": {
            "id": "4810107",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Isn't it obvious? You gotta have a gliding license to legally glide in Mondstadt.",
            "nextDialogs": [
              "4810108"
            ]
          },
          "4810108": {
            "id": "4810108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Oh... but {NICKNAME} and Paimon have been gliding for ages now. This is the first we've heard about it!",
            "nextDialogs": [
              "4810109"
            ]
          },
          "4810109": {
            "id": "4810109",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Yeah, you've been gliding all over the place... Everyone's noticed!",
            "nextDialogs": [
              "4810110"
            ]
          },
          "4810110": {
            "id": "4810110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh-he.",
            "nextDialogs": [
              "4810111"
            ]
          },
          "4810111": {
            "id": "4810111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Sooo... You came looking for us because you wanna give us a gliding license?",
            "nextDialogs": [
              "4810112"
            ]
          },
          "4810112": {
            "id": "4810112",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "No way! The Knights of Favonius have strict rules.",
            "nextDialogs": [
              "4810113"
            ]
          },
          "4810113": {
            "id": "4810113",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "You need to pass an exam, and only then will the Knights issue your license.",
            "nextDialogs": [
              "4810114"
            ]
          },
          "4810114": {
            "id": "4810114",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "#Today I'm here as an examiner, to oversee {NICKNAME}'s official gliding exam!",
            "nextDialogs": [
              "4810115"
            ]
          },
          "4810115": {
            "id": "4810115",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "I gave you your wind glider, so this is my responsibility — at least, that's what Acting Grand Master Jean would say.",
            "nextDialogs": [
              "4810116"
            ]
          },
          "4810116": {
            "id": "4810116",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "An exam! What a pain in the butt. Then again, since Amber is the examiner..."
          }
        }
      }
    },

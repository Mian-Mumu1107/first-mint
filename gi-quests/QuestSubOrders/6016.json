    {
      "subId": "601615",
      "subQuestName": "Defend Nasha Town",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60161501"
        ],
        "dialogs": {
          "60161501": {
            "id": "60161501",
            "speakerId": 1007,
            "speakerName": "The Doctor",
            "text": "You're looking well. I trust you've had a good couple of days?",
            "nextDialogs": [
              "60161502"
            ]
          },
          "60161502": {
            "id": "60161502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Dottore!",
            "nextDialogs": [
              "60161503"
            ]
          },
          "60161503": {
            "id": "60161503",
            "speakerId": 1007,
            "speakerName": "The Doctor",
            "text": "It's actually a good thing, in my view. If the subjects of my experiment were to die prematurely, it would throw quite a wrench in the works.",
            "nextDialogs": [
              "60161504"
            ]
          },
          "60161504": {
            "id": "60161504",
            "speakerId": 1007,
            "speakerName": "The Doctor",
            "text": "And so, I must thank you all for your resilience.",
            "nextDialogs": [
              "60161505"
            ]
          },
          "60161505": {
            "id": "60161505",
            "speakerId": 1007,
            "speakerName": "The Doctor",
            "text": "We are no longer on the same level, but you are nonetheless worthy of my respect. A creator-god should be merciful and gracious, after all.",
            "nextDialogs": [
              "60161506"
            ]
          },
          "60161506": {
            "id": "60161506",
            "speakerId": 1007,
            "speakerName": "The Doctor",
            "text": "And in any case, it is only right that, before I end your lives, the world is informed of the arrival of their new god."
          }
        }
      }
    },

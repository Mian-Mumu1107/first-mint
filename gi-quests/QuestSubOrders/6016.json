    {
      "subId": "601602",
      "subQuestName": "Talk to Marionette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60160201"
        ],
        "dialogs": {
          "60160201": {
            "id": "60160201",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Ah, you're here.",
            "nextDialogs": [
              "60160202"
            ]
          },
          "60160202": {
            "id": "60160202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Sandrone! How are things going?",
            "nextDialogs": [
              "60160203"
            ]
          },
          "60160203": {
            "id": "60160203",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Glad you asked. You two are about to become the first people to lay eyes upon my masterpiece... Or should that be the first person and the first, uh... Specter?",
            "nextDialogs": [
              "60160204"
            ]
          },
          "60160204": {
            "id": "60160204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey!",
            "nextDialogs": [
              "60160205"
            ]
          },
          "60160205": {
            "id": "60160205",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Eh, whatever. Come. Feast your eyes on this.",
            "nextDialogs": [
              "60160206"
            ]
          },
          "60160206": {
            "id": "60160206",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, we've never seen something like this before!",
            "nextDialogs": [
              "60160207"
            ]
          },
          "60160207": {
            "id": "60160207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It looks impressive!",
            "nextDialogs": [
              "60160208"
            ]
          },
          "60160208": {
            "id": "60160208",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "This meter displays the progress of my formula. Currently, it's still making the most important connections.",
            "nextDialogs": [
              "60160209"
            ]
          },
          "60160209": {
            "id": "60160209",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Once it's finished running, I'll deliver it right to your side, and then, we can finally bring Columbina back.",
            "nextDialogs": [
              "60160210"
            ]
          },
          "60160210": {
            "id": "60160210",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What do you mean, deliver it? Can't you just tell us over the Dodocommunication Device? It'll just be some numbers, right?",
            "nextDialogs": [
              "60160211"
            ]
          },
          "60160211": {
            "id": "60160211",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Ugh. You're such a greenhorn. This isn't the kind of formula you solve in math class. It's a highly complex algorithm capable of constructing a framework of rules.",
            "nextDialogs": [
              "60160212"
            ]
          },
          "60160212": {
            "id": "60160212",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "...Whatever. We'll be here all day if I start trying to explain it. All you need to know is, the formula must be completed before we can bring Columbina back.",
            "nextDialogs": [
              "60160213"
            ]
          },
          "60160213": {
            "id": "60160213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it.",
            "nextDialogs": [
              "60160214"
            ]
          },
          "60160214": {
            "id": "60160214",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "I'll share the data with you. Nicole's agreed to let me use her information channel, so we just need to use the Dodocommunication Device like so, and...",
            "nextDialogs": [
              "60160215"
            ]
          },
          "60160215": {
            "id": "60160215",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "There. Now you can check in on my progress.",
            "nextDialogs": [
              "60160216"
            ]
          },
          "60160216": {
            "id": "60160216",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, look at that! You're amazing, Sandrone!",
            "nextDialogs": [
              "60160217"
            ]
          },
          "60160217": {
            "id": "60160217",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Pfft, about time you recognized my genius! Took you long enough! Hahaha.",
            "nextDialogs": [
              "60160218"
            ]
          },
          "60160218": {
            "id": "60160218",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Anyway, that's all from me. You should check on the others if you have time — make sure we don't have any weak links in the chain.",
            "nextDialogs": [
              "60160219"
            ]
          },
          "60160219": {
            "id": "60160219",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "That might sound harsh to you, but close supervision is a common practice in the Fatui. Not looking to catch anyone out — I just care about everything going smoothly, that's all.",
            "nextDialogs": [
              "60160220"
            ]
          },
          "60160220": {
            "id": "60160220",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "I'm kinda stuck here while the formula's running, so I need you to be my second pair of eyes in the meantime."
          }
        }
      }
    },
    {
      "subId": "601603",
      "subQuestName": "Talk to your companions",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60160301"
        ],
        "dialogs": {
          "60160301": {
            "id": "60160301",
            "speakerId": 1002,
            "speakerName": "Flins",
            "text": "#{NICKNAME}, Paimon. A pleasure to see you both.",
            "nextDialogs": [
              "60160302"
            ]
          },
          "60160302": {
            "id": "60160302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Flins! How's everything coming along?",
            "nextDialogs": [
              "60160303"
            ]
          },
          "60160303": {
            "id": "60160303",
            "speakerId": 1002,
            "speakerName": "Flins",
            "text": "Fairly well, if I do say so myself. Personally, I am ready to confront Dottore head-on.",
            "nextDialogs": [
              "60160304"
            ]
          },
          "60160304": {
            "id": "60160304",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ooh, you sound much more serious than usual.",
            "nextDialogs": [
              "60160305"
            ]
          },
          "60160305": {
            "id": "60160305",
            "speakerId": 1002,
            "speakerName": "Flins",
            "text": "To be honest, I am not usually fond of exercising my full strength. For one thing, it's hardly conducive to maintaining a low profile. Besides, I believe one should have the right to choose when to show their hand.",
            "nextDialogs": [
              "60160306"
            ]
          },
          "60160306": {
            "id": "60160306",
            "speakerId": 1002,
            "speakerName": "Flins",
            "text": "I am conserving my strength until the moment of battle is upon us. Anything to boost our chances of victory.",
            "nextDialogs": [
              "60160307"
            ]
          },
          "60160307": {
            "id": "60160307",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Seeing you get in the zone like this really puts Paimon at ease. Huh, {NICKNAME}?",
            "nextDialogs": [
              "60160310"
            ]
          },
          "60160310": {
            "id": "60160310",
            "speakerId": 1002,
            "speakerName": "Flins",
            "text": "I consider it an honor to have your trust.",
            "nextDialogs": [
              "60160311"
            ]
          },
          "60160311": {
            "id": "60160311",
            "speakerId": 1002,
            "speakerName": "Flins",
            "text": "Rest well. I look forward to seeing you both in your element during the battle."
          }
        }
      }
    },
    {
      "subId": "601604",
      "subQuestName": "Talk to your companions",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60160401"
        ],
        "dialogs": {
          "60160401": {
            "id": "60160401",
            "speakerId": 1003,
            "speakerName": "Nefer",
            "text": "Yes, Miss Moonchanter? What are you staring at?",
            "nextDialogs": [
              "60160402"
            ]
          },
          "60160402": {
            "id": "60160402",
            "speakerId": 1004,
            "speakerName": "Lauma",
            "text": "You always address me in the strangest ways. \"Lady Moonchanter\" one minute, \"Miss Moonchanter\" the next...",
            "nextDialogs": [
              "60160403"
            ]
          },
          "60160403": {
            "id": "60160403",
            "speakerId": 1003,
            "speakerName": "Nefer",
            "text": "Yes, and? Are either of those incorrect?",
            "nextDialogs": [
              "60160404"
            ]
          },
          "60160404": {
            "id": "60160404",
            "speakerId": 1004,
            "speakerName": "Lauma",
            "text": "Not as such. It's just that I simply call you \"Nefer\" nowadays.",
            "nextDialogs": [
              "60160405"
            ]
          },
          "60160405": {
            "id": "60160405",
            "speakerId": 1003,
            "speakerName": "Nefer",
            "text": "Uh-huh, that's my name. What's your point?",
            "nextDialogs": [
              "60160406"
            ]
          },
          "60160406": {
            "id": "60160406",
            "speakerId": 1004,
            "speakerName": "Lauma",
            "text": "The point is, I don't add any honorifics or titles.",
            "nextDialogs": [
              "60160407"
            ]
          },
          "60160407": {
            "id": "60160407",
            "speakerId": 1003,
            "speakerName": "Nefer",
            "text": "Meaning what?",
            "nextDialogs": [
              "60160408"
            ]
          },
          "60160408": {
            "id": "60160408",
            "speakerId": 1004,
            "speakerName": "Lauma",
            "text": "That... maybe we're on friendlier terms now than we used to be.",
            "nextDialogs": [
              "60160409"
            ]
          },
          "60160409": {
            "id": "60160409",
            "speakerId": 1003,
            "speakerName": "Nefer",
            "text": "Is that how you see it? And I thought I was the one with eye damage.",
            "nextDialogs": [
              "60160410"
            ]
          },
          "60160410": {
            "id": "60160410",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Nefer! Lauma!",
            "nextDialogs": [
              "60160411"
            ]
          },
          "60160411": {
            "id": "60160411",
            "speakerId": 1004,
            "speakerName": "Lauma",
            "text": "#Paimon. {NICKNAME}.",
            "nextDialogs": [
              "60160412"
            ]
          },
          "60160412": {
            "id": "60160412",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Just swinging by to check in on you! How are things going? Did you manage to get some rest?",
            "nextDialogs": [
              "60160413"
            ]
          },
          "60160413": {
            "id": "60160413",
            "speakerId": 1003,
            "speakerName": "Nefer",
            "text": "Don't worry about me. I won't slow us down.",
            "nextDialogs": [
              "60160414"
            ]
          },
          "60160414": {
            "id": "60160414",
            "speakerId": 1004,
            "speakerName": "Lauma",
            "text": "And I give my all to ensure our victory.",
            "nextDialogs": [
              "60160415"
            ]
          },
          "60160415": {
            "id": "60160415",
            "speakerId": 1004,
            "speakerName": "Lauma",
            "text": "Ah, yes. Allow me to give you two a quick checkup...",
            "nextDialogs": [
              "60160416"
            ]
          },
          "60160416": {
            "id": "60160416",
            "speakerId": 1004,
            "speakerName": "Lauma",
            "text": "...All done. You're both in good shape.",
            "nextDialogs": [
              "60160419"
            ]
          },
          "60160419": {
            "id": "60160419",
            "speakerId": 1003,
            "speakerName": "Nefer",
            "text": "You're welcome. You'll have your work cut out for you in this battle against Dottore, so make sure to get some rest in first.",
            "nextDialogs": [
              "60160420"
            ]
          },
          "60160420": {
            "id": "60160420",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Paimon will keep an eye on {M#him}{F#her}, don't you worry!",
            "nextDialogs": [
              "60160421"
            ]
          },
          "60160421": {
            "id": "60160421",
            "speakerId": 1004,
            "speakerName": "Lauma",
            "text": "I'm glad to hear it. Take good care of yourself too, Paimon.",
            "nextDialogs": [
              "60160422"
            ]
          },
          "60160422": {
            "id": "60160422",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Sure thing!"
          }
        }
      }
    },
    {
      "subId": "601605",
      "subQuestName": "Talk to your companions",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60160501"
        ],
        "dialogs": {
          "60160501": {
            "id": "60160501",
            "speakerId": 1005,
            "speakerName": "Durin",
            "text": "Thankfully, Miss Nicole has come to our aid. Nasha Town is now looking very well defended!",
            "nextDialogs": [
              "60160502"
            ]
          },
          "60160502": {
            "id": "60160502",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "Golden flame... Yes, that's Nicole's power, alright.",
            "nextDialogs": [
              "60160503"
            ]
          },
          "60160503": {
            "id": "60160503",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "Based on the latest message from Grand Master Varka, it sounds like they've reached an agreement.",
            "nextDialogs": [
              "60160504"
            ]
          },
          "60160504": {
            "id": "60160504",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "The situation should be more stable with her assistance. Everyone will have at least some degree of protection.",
            "nextDialogs": [
              "60160505"
            ]
          },
          "60160505": {
            "id": "60160505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Albedo, Durin!",
            "nextDialogs": [
              "60160506"
            ]
          },
          "60160506": {
            "id": "60160506",
            "speakerId": 1005,
            "speakerName": "Durin",
            "text": "Hello there, you two!",
            "nextDialogs": [
              "60160507"
            ]
          },
          "60160507": {
            "id": "60160507",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "Are you well-rested?",
            "nextDialogs": [
              "60160508"
            ]
          },
          "60160508": {
            "id": "60160508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thanks for your concern. I'm doing alright.",
            "nextDialogs": [
              "60160509"
            ]
          },
          "60160509": {
            "id": "60160509",
            "speakerId": 1005,
            "speakerName": "Durin",
            "text": "That's good to hear.",
            "nextDialogs": [
              "60160510"
            ]
          },
          "60160510": {
            "id": "60160510",
            "speakerId": 1005,
            "speakerName": "Durin",
            "text": "As per the plan, Albedo and I will be in charge of Nasha Town.",
            "nextDialogs": [
              "60160511"
            ]
          },
          "60160511": {
            "id": "60160511",
            "speakerId": 1005,
            "speakerName": "Durin",
            "text": "As Dottore's energy field expands, it's creeping ever closer in that direction... but we will do our best to hold our position.",
            "nextDialogs": [
              "60160512"
            ]
          },
          "60160512": {
            "id": "60160512",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "We've fought side-by-side many times before, and always with great success.",
            "nextDialogs": [
              "60160513"
            ]
          },
          "60160513": {
            "id": "60160513",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "I believe this time will be no different. So don't worry about us — focus on fighting Dottore."
          }
        }
      }
    },

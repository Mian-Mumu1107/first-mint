    {
      "subId": "601607",
      "subQuestName": "Defeat the opponent(s) before you",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60160701"
        ],
        "dialogs": {
          "60160701": {
            "id": "60160701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(...!)",
            "nextDialogs": [
              "60160702"
            ]
          },
          "60160702": {
            "id": "60160702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Hostiles incoming... Are these The Doctor's minions?)",
            "nextDialogs": [
              "60160703"
            ]
          },
          "60160703": {
            "id": "60160703",
            "speakerId": 1003,
            "speakerName": "Nefer",
            "text": "Here they come. That's quite a horde.",
            "nextDialogs": [
              "60160704"
            ]
          },
          "60160704": {
            "id": "60160704",
            "speakerId": 1004,
            "speakerName": "Lauma",
            "text": "As we expected.",
            "nextDialogs": [
              "60160705"
            ]
          },
          "60160705": {
            "id": "60160705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Get ready, everyone!",
            "nextDialogs": [
              "60160706"
            ]
          },
          "60160706": {
            "id": "60160706",
            "speakerId": 1002,
            "speakerName": "Flins",
            "text": "Take your positions and prepare to engage!",
            "nextDialogs": [
              "60160707"
            ]
          },
          "60160707": {
            "id": "60160707",
            "speakerId": 1006,
            "speakerName": "Albedo",
            "text": "Let's begin.",
            "nextDialogs": [
              "60160708"
            ]
          },
          "60160708": {
            "id": "60160708",
            "speakerId": 1005,
            "speakerName": "Durin",
            "text": "I'm at the ready!"
          }
        }
      }
    },

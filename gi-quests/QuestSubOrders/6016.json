    {
      "subId": "600399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60039904"
        ],
        "dialogs": {
          "60039904": {
            "id": "60039904",
            "speakerId": 1008,
            "speakerName": "Il Dottore",
            "text": "My apologies. I had not intended to take your teammates from you.",
            "nextDialogs": [
              "60039905"
            ]
          },
          "60039905": {
            "id": "60039905",
            "speakerId": 1008,
            "speakerName": "Il Dottore",
            "text": "But you have a choice in the matter. Obey, and I can release them.",
            "nextDialogs": [
              "60039906"
            ]
          },
          "60039906": {
            "id": "60039906",
            "speakerId": 1008,
            "speakerName": "Il Dottore",
            "text": "An excellent deal, if you ask me. Won't you consider it?"
          }
        }
      }
    },
    {
      "subId": "601699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60169901"
        ],
        "dialogs": {
          "60169901": {
            "id": "60169901",
            "speakerId": 1002,
            "speakerName": "Flins",
            "text": "Oh... I've been moved inside another space, and it's sealed off.",
            "nextDialogs": [
              "60169902"
            ]
          },
          "60169902": {
            "id": "60169902",
            "speakerId": 1002,
            "speakerName": "Flins",
            "text": "Looking at the structure of it... It seems like Dottore intends to trap us here.",
            "nextDialogs": [
              "60169903"
            ]
          },
          "60169903": {
            "id": "60169903",
            "speakerId": 1002,
            "speakerName": "Flins",
            "text": "There's no exit. Our endurance is about to be put to the test.",
            "nextDialogs": [
              "60169904"
            ]
          },
          "60169904": {
            "id": "60169904",
            "speakerId": 1004,
            "speakerName": "Lauma",
            "text": "Looks like Dottore has opted for a divide and conquer strategy...",
            "nextDialogs": [
              "60169905"
            ]
          },
          "60169905": {
            "id": "60169905",
            "speakerId": 1004,
            "speakerName": "Lauma",
            "text": "But we will not allow him to triumph.",
            "nextDialogs": [
              "60169906"
            ]
          },
          "60169906": {
            "id": "60169906",
            "speakerId": 1004,
            "speakerName": "Lauma",
            "text": "Now, I shall pray for our victory.",
            "nextDialogs": [
              "60169907"
            ]
          },
          "60169907": {
            "id": "60169907",
            "speakerId": 1003,
            "speakerName": "Nefer",
            "text": "What's this supposed to be? A knockoff version of the space Columbina got trapped in?",
            "nextDialogs": [
              "60169908"
            ]
          },
          "60169908": {
            "id": "60169908",
            "speakerId": 1003,
            "speakerName": "Nefer",
            "text": "Huh... There really is no way out...",
            "nextDialogs": [
              "60169909"
            ]
          },
          "60169909": {
            "id": "60169909",
            "speakerId": 1003,
            "speakerName": "Nefer",
            "text": "We'll see about that, Dottore.",
            "nextDialogs": [
              "60169910"
            ]
          },
          "60169910": {
            "id": "60169910",
            "speakerId": 1010,
            "speakerName": "Columbina",
            "text": "I grant you the new moon's blessing.",
            "nextDialogs": [
              "60169911"
            ]
          },
          "60169911": {
            "id": "60169911",
            "speakerId": 1010,
            "speakerName": "Columbina",
            "text": "The new moon shines upon you.",
            "nextDialogs": [
              "60169912"
            ]
          },
          "60169912": {
            "id": "60169912",
            "speakerId": 1008,
            "speakerName": "Il Dottore",
            "text": "I am growing weary of your stubborn resistance..."
          }
        }
      }
    }
  ]
}
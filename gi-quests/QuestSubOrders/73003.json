        ],
        "dialogs": {
          "730030601": {
            "id": "730030601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Eh? Paimon's sure this was the place...",
            "nextDialogs": [
              "730030602"
            ]
          },
          "730030602": {
            "id": "730030602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Rana! Can you hear Paimon?",
            "nextDialogs": [
              "730030604"
            ]
          },
          "730030604": {
            "id": "730030604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No answer... Darn it! What happened?",
            "nextDialogs": [
              "730030605"
            ]
          },
          "730030605": {
            "id": "730030605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hm...? These traces...",
            "nextDialogs": [
              "730030607"
            ]
          },
          "730030607": {
            "id": "730030607",
            "speakerId": 1005,
            "speakerName": "Paimon",

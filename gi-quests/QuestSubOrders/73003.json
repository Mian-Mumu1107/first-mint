    {
      "subId": "7300312",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730030201"
        ],
        "dialogs": {
          "730030201": {
            "id": "730030201",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "Iotham... What happened...",
            "nextDialogs": [
              "730030202"
            ]
          },
          "730030202": {
            "id": "730030202",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "#Wah, Rana... and {NICKNAME}...",
            "nextDialogs": [
              "730030203"
            ]
          },
          "730030203": {
            "id": "730030203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? What're you doing in... a Withering Zone... And there are so many monsters...",
            "nextDialogs": [
              "730030204"
            ]
          },
          "730030204": {
            "id": "730030204",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "...",
            "nextDialogs": [
              "730030207"
            ]
          },
          "730030207": {
            "id": "730030207",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "No... There's no time...",
            "nextDialogs": [
              "730030208"
            ]
          },
          "730030208": {
            "id": "730030208",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "#Darn it! {NICKNAME}, let's do this together!",
            "nextDialogs": [
              "730030209"
            ]
          },
          "730030209": {
            "id": "730030209",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "Iotham, wait here and don't move! We're coming to rescue you!"
          }
        }
      }
    },
    {
      "subId": "7300305",
      "subQuestName": "Try to clean up the Withering Zone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730030501"
        ],
        "dialogs": {
          "730030501": {
            "id": "730030501",
            "speakerId": 4327,
            "speakerName": "Alphonso",
            "text": "#Iotham? Why are you... and {NICKNAME}...",
            "nextDialogs": [
              "730030502"
            ]
          },
          "730030502": {
            "id": "730030502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's urgent, so we'll make this quick...",
            "nextDialogs": [
              "730030503"
            ]
          },
          "730030503": {
            "id": "730030503",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "You quickly explain what happened.",
            "nextDialogs": [
              "730030504"
            ]
          },
          "730030504": {
            "id": "730030504",
            "speakerId": 4327,
            "speakerName": "Alphonso",
            "text": "...I see. Iotham, you go rest up.",
            "nextDialogs": [
              "730030505"
            ]
          },
          "730030505": {
            "id": "730030505",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "Okay. I'm sorry, Alphonso...",
            "nextDialogs": [
              "730030506"
            ]
          },
          "730030506": {
            "id": "730030506",
            "speakerId": 4327,
            "speakerName": "Alphonso",
            "text": "#It's fine, what matters is that you're okay... Wait here a moment, {NICKNAME}. I'll go with you as soon as I prepare some medicine.",
            "nextDialogs": [
              "730030507"
            ]
          },
          "730030507": {
            "id": "730030507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's no time. This is the location, head there as soon as you can.",
            "nextDialogs": [
              "730030508"
            ]
          },
          "730030508": {
            "id": "730030508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, we have to hurry back to look after Rana...",
            "nextDialogs": [
              "730030509"
            ]
          },
          "730030509": {
            "id": "730030509",
            "speakerId": 4327,
            "speakerName": "Alphonso",
            "text": "Eh? Wait..."
          }
        }
      }
    },

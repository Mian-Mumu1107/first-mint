    {
      "subId": "7300301",
      "subQuestName": "Return to Vimara Village",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730030101"
        ],
        "dialogs": {
          "730030101": {
            "id": "730030101",
            "speakerId": 16701,
            "speakerName": "Rana",
            "text": "I'm so glad you both could come with me. Still, I'll need to report the expansion of the nearby Withering Zone to Tighnari.",
            "nextDialogs": [
              "730030102"
            ]
          },
          "730030102": {
            "id": "730030102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? Is that... the kid from Vimara Village?",
            "nextDialogs": [
              "730030103"
            ]
          },
          "730030103": {
            "id": "730030103",
            "speakerId": 16701,
            "speakerName": "Rana",
            "text": "Eh? Iotham! Wait up!"
          }
        }
      }
    },
    {
      "subId": "7300303",
      "subQuestName": "Look for Iotham",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730030301"
        ],
        "dialogs": {
          "730030301": {
            "id": "730030301",
            "speakerId": 16701,
            "speakerName": "Rana",
            "text": "Whew... Hah... Finally...",
            "nextDialogs": [
              "730030302"
            ]
          },
          "730030302": {
            "id": "730030302",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "Rana... Waaah...",
            "nextDialogs": [
              "730030303"
            ]
          },
          "730030303": {
            "id": "730030303",
            "speakerId": 16701,
            "speakerName": "Rana",
            "text": "Iotham... It's okay, little man, there's nothing to cry about. Look... If I can tell them about what I felt in the Withering Zone... to those Akademiya researchers... they'll be able to take care of The Withering for good...",
            "nextDialogs": [
              "730030304"
            ]
          },
          "730030304": {
            "id": "730030304",
            "speakerId": 16701,
            "speakerName": "Rana",
            "text": "#And... did you see... me fight? No... did you see {NICKNAME} fight? Be sure to thank {M#him}{F#her}...",
            "nextDialogs": [
              "730030305"
            ]
          },
          "730030305": {
            "id": "730030305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Rana...",
            "nextDialogs": [
              "730030307"
            ]
          },
          "730030307": {
            "id": "730030307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Rana, you'd better rest now...",
            "nextDialogs": [
              "730030309"
            ]
          },
          "730030309": {
            "id": "730030309",
            "speakerId": 16701,
            "speakerName": "Rana",
            "text": "Ha... haha... it's fine. I just feel a little dizzy, that's all. And a little tired...",
            "nextDialogs": [
              "730030310"
            ]
          },
          "730030310": {
            "id": "730030310",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "Rana... I'm sorry...",
            "nextDialogs": [
              "730030311"
            ]
          },
          "730030311": {
            "id": "730030311",
            "speakerId": 16701,
            "speakerName": "Rana",
            "text": "Wh... What are you talking about? You're my little tiger, so no more crying! You're okay, aren't you? Does anything hurt, Iotham...? Do you feel dizzy, weak, or...",
            "nextDialogs": [
              "730030312"
            ]
          },
          "730030312": {
            "id": "730030312",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "I'm fine, but Rana, you...",
            "nextDialogs": [
              "730030313"
            ]
          },
          "730030313": {
            "id": "730030313",
            "speakerId": 16701,
            "speakerName": "Rana",
            "text": "It's nothing... I'll be fine. I'm a battle-hardened Forest Watcher, after all! Let's go!"
          }
        }
      }
    },
    {
      "subId": "7300304",
      "subQuestName": "Go into the depths of the cave to look for Iotham",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730030401"
        ],
        "dialogs": {
          "730030401": {
            "id": "730030401",
            "speakerId": 16701,
            "speakerName": "Rana",
            "text": "Don't worry about me... You guys go ahead."
          }
        }
      }
    },
    {
      "subId": "7300310",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730031001"
        ],
        "dialogs": {
          "730031001": {
            "id": "730031001",
            "speakerId": 20758,
            "speakerName": "Fatui Sergeant",
            "text": "...Who are you people? Don't get in our way.",
            "nextDialogs": [
              "730031002"
            ]
          },
          "730031002": {
            "id": "730031002",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "Hmph, I should be asking you that question! I'm a Forest Watcher here, and I'm in the middle of searching for a missing child. State your names!",
            "nextDialogs": [
              "730031005"
            ]
          },
          "730031005": {
            "id": "730031005",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "Huh? So, these are the Fatui that Alphonso mentioned? State your business.",
            "nextDialogs": [
              "730031006"
            ]
          },
          "730031006": {
            "id": "730031006",
            "speakerId": 20758,
            "speakerName": "Fatui Sergeant",
            "text": "Alphonso...? Whatever, don't think you'll be getting out of here without a fight!",
            "nextDialogs": [
              "730031007"
            ]
          },
          "730031007": {
            "id": "730031007",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "Well, looks like we're not gonna be able to talk this one out!"
          }
        }
      }
    },
    {
      "subId": "7300311",
      "subQuestName": "Defeat the Fatui",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730031101"
        ],
        "dialogs": {
          "730031101": {
            "id": "730031101",
            "speakerId": 16701,
            "speakerName": "Rana",
            "text": "#Thank goodness you were here, {NICKNAME}...",
            "nextDialogs": [
              "730031105",
              "730031104"
            ]
          },
          "730031105": {
            "id": "730031105",
            "speakerId": 16701,
            "speakerName": "Rana",
            "text": "Looks like Alphonso wasn't kidding, these Fatui guys are dangerous...",
            "nextDialogs": [
              "730031106"
            ]
          },
          "730031106": {
            "id": "730031106",
            "speakerId": 16701,
            "speakerName": "Rana",
            "text": "Anyway, we can talk more about that later. Iotham must be somewhere deeper in the cave. We'd better keep moving."
          },
          "730031104": {
            "id": "730031104",
            "speakerId": 16701,
            "speakerName": "Rana",
            "text": "Really? Hehe, probably because you and Paimon were by my side."
          }
        }
      }
    },
    {

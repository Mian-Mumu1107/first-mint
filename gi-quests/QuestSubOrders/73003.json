    {
      "subId": "7300314",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730030801"
        ],
        "dialogs": {
          "730030801": {
            "id": "730030801",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "#I'm sorry... {NICKNAME}, Paimon, I need to rest... Wait for me, Iotham.",
            "nextDialogs": [
              "730030802"
            ]
          },
          "730030802": {
            "id": "730030802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Rana, are you really okay...?",
            "nextDialogs": [
              "730030803"
            ]
          },
          "730030803": {
            "id": "730030803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll go get help...",
            "nextDialogs": [
              "730030804"
            ]
          },
          "730030804": {
            "id": "730030804",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "No, no, it's fine... I just need... a little rest...",
            "nextDialogs": [
              "730030805"
            ]
          },
          "730030805": {
            "id": "730030805",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "I'm sorry, Rana... I'm sorry...",
            "nextDialogs": [
              "730030806"
            ]
          },
          "730030806": {
            "id": "730030806",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "Really... How many times do I have to say it? I'm fine! But I'm very angry...",
            "nextDialogs": [
              "730030807"
            ]
          },
          "730030807": {
            "id": "730030807",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "You promised me... that you wouldn't go into the forest. Once I'm all rested up, I'll teach you a lesson about breaking promises... you little rascal...",
            "nextDialogs": [
              "730030808"
            ]
          },
          "730030808": {
            "id": "730030808",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "Waaah... Alphonso said that the mushrooms here are huge! And I just wanted to bring you some fresh mushrooms to eat... to give you energy...",
            "nextDialogs": [
              "730030809"
            ]
          },
          "730030809": {
            "id": "730030809",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "Dummy... You didn't need to do that. Just thinking of you guys gives me energy...",
            "nextDialogs": [
              "730030810"
            ]
          },
          "730030810": {
            "id": "730030810",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "Still, hahaha... the mushrooms here really are huge... They'd definitely taste great in a curry...",
            "nextDialogs": [
              "730030811"
            ]
          },
          "730030811": {
            "id": "730030811",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did Alphonso let you come here?",
            "nextDialogs": [
              "730030812"
            ]
          },
          "730030812": {
            "id": "730030812",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "No... Alphonso also told me not to go running off. But I wanted to give Rana something tasty to eat, so I...",
            "nextDialogs": [
              "730030813"
            ]
          },
          "730030813": {
            "id": "730030813",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "Alphonso wouldn't do that, he's Iotham's big brother...",
            "nextDialogs": [
              "730030814"
            ]
          },
          "730030814": {
            "id": "730030814",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon understands... But Iotham, how did you get stuck in the Withering Zone?",
            "nextDialogs": [
              "730030815"
            ]
          },
          "730030815": {
            "id": "730030815",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "When I was in the forest, I thought someone was following me... I got scared, I thought it was Marana's Avatar... So, I just kept running... *sob*",
            "nextDialogs": [
              "730030816"
            ]
          },
          "730030816": {
            "id": "730030816",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "And I ended up running into Marana...",
            "nextDialogs": [
              "730030817"
            ]
          },
          "730030817": {
            "id": "730030817",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "?",
            "nextDialogs": [
              "730030819",
              "730030824"
            ]
          },
          "730030819": {
            "id": "730030819",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "That's... The Withering.",
            "nextDialogs": [
              "730030820"
            ]
          },
          "730030820": {
            "id": "730030820",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "Oh... Yeah, The Withering.",
            "nextDialogs": [
              "730030821"
            ]
          },
          "730030821": {
            "id": "730030821",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Marana's Avatar\"?",
            "nextDialogs": [
              "730030822"
            ]
          },
          "730030822": {
            "id": "730030822",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "Uh-huh. It does bad things in the world for Marana... It's a big black thing...",
            "nextDialogs": [
              "730030828"
            ]
          },
          "730030828": {
            "id": "730030828",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Marana... What a strange name.",
            "nextDialogs": [
              "730030829"
            ]
          },
          "730030829": {
            "id": "730030829",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "Mm... How did I know that Marana is The Withering...? Dang it... everything's spinning...",
            "nextDialogs": [
              "730030830"
            ]
          },
          "730030830": {
            "id": "730030830",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "Iotham, what was that green thing just now?",
            "nextDialogs": [
              "730030831"
            ]
          },
          "730030831": {
            "id": "730030831",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "...",
            "nextDialogs": [
              "730030832"
            ]
          },
          "730030832": {
            "id": "730030832",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "That was Ararakalari... It can protect people from the corrosion of Marana.",
            "nextDialogs": [
              "730030833"
            ]
          },
          "730030833": {
            "id": "730030833",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "More and more things I don't understand...",
            "nextDialogs": [
              "730030834"
            ]
          },
          "730030834": {
            "id": "730030834",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "This is... a kind of forest magic. It's also a kind of music... It's an Ara..."
          },
          "730030824": {
            "id": "730030824",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "Uh-huh. It does bad things in the world for Marana... It's a big black thing...",
            "nextDialogs": [
              "730030825"
            ]
          },
          "730030825": {
            "id": "730030825",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Marana\"?",
            "nextDialogs": [
              "730030826"
            ]
          },
          "730030826": {
            "id": "730030826",
            "speakerId": 4198,
            "speakerName": "Rana",
            "text": "That's... The Withering.",
            "nextDialogs": [
              "730030827"
            ]
          },
          "730030827": {
            "id": "730030827",
            "speakerId": 20594,
            "speakerName": "Iotham",
            "text": "Oh... Yeah, The Withering."
          }
        }
      }
    },

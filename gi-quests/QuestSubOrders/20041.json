{
  "lineCounts": {
    "Doolan": 1,
    "Patchi the Curious": 14,
    "Player": 5
  },
  "subQuests": [
    {
      "subId": "2004101",
      "subQuestName": "Talk to Patchi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200410101"
        ],
        "dialogs": {
          "200410101": {
            "id": "200410101",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "There's no such THING as a perfect plan when you're on an adventure! How are you going to make any progress at all if you keep deliberating like this?",
            "nextDialogs": [
              "200410102"
            ]
          },
          "200410102": {
            "id": "200410102",
            "speakerId": 1001,
            "speakerName": "Doolan",
            "text": "If the plan isn't perfect, then we need to be prepared for anything!",
            "nextDialogs": [
              "200410103"
            ]
          },
          "200410103": {
            "id": "200410103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you arguing about?",
            "nextDialogs": [
              "200410104"
            ]
          },
          "200410104": {
            "id": "200410104",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "I am a researcher of ancient ruins, and I wish to embark on a field trip to the Thousand Winds Temple. But I don't deal well with situations involving combat.",
            "nextDialogs": [
              "200410105"
            ]
          },
          "200410105": {
            "id": "200410105",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "Mr. Doolan here is an adventurer, and has taken it upon himself to make all the necessary arrangements for the temple investigation.",
            "nextDialogs": [
              "200410106"
            ]
          },
          "200410106": {
            "id": "200410106",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "Now, I do not mean to be critical of Doolan in any way, and I know that those Ruin Guards can be a real nuisance... but he insists on devising a fully comprehensive adventure plan down to the last detail, to which end he calls meeting after meeting...",
            "nextDialogs": [
              "200410107"
            ]
          },
          "200410107": {
            "id": "200410107",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "We've had research, investigation, and amendments, followed by supplementary research, further investigation, and round-two amendments... Ahh, I just can't take it anymore!",
            "nextDialogs": [
              "200410108"
            ]
          },
          "200410108": {
            "id": "200410108",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "Now he says he's found new evidence of monsters camping out next to the temple.",
            "nextDialogs": [
              "200410109"
            ]
          },
          "200410109": {
            "id": "200410109",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "I'm begging you, clear them out for me, would you? Just to shut him up, even if it doesn't get us inside the temple...",
            "nextDialogs": [
              "200410112"
            ]
          },
          "200410112": {
            "id": "200410112",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "I appreciate the gesture, but take it from me...",
            "nextDialogs": [
              "200410113"
            ]
          },
          "200410113": {
            "id": "200410113",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "...You'll find those monsters far less stressful to deal with than one of his meetings!"
          }
        }
      }
    },
    {
      "subId": "2004102",
      "subQuestName": "Clear out the monster camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200410201"
        ],
        "dialogs": {
          "200410201": {
            "id": "200410201",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "So, have you wiped out the monsters' camps?",
            "nextDialogs": [
              "200410202"
            ]
          },
          "200410202": {
            "id": "200410202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not just yet...",
            "nextDialogs": [
              "200410203"
            ]
          },
          "200410203": {
            "id": "200410203",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "Please do it as soon as you can. Before Doolan finds yet another piece of evidence to pursue and ponder..."
          }
        }
      }
    },
    {
      "subId": "2004103",
      "subQuestName": "Talk to Patchi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200410301"
        ],
        "dialogs": {
          "200410301": {
            "id": "200410301",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "Have you wiped out the monsters' camps yet?",
            "nextDialogs": [
              "200410302"
            ]
          },
          "200410302": {
            "id": "200410302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, they're all gone.",
            "nextDialogs": [
              "200410303"
            ]
          },
          "200410303": {
            "id": "200410303",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "Wonderful. I will speak with him at once about a proposed means of entry into the temple.",
            "nextDialogs": [
              "200410304"
            ]
          },
          "200410304": {
            "id": "200410304",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "He'll have no excuse to pull me into a meeting this time!"
          }
        }
      }
    }
  ]
}
    {
      "subId": "2203703",
      "subQuestName": "Talk to Konda Densuke",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220370301"
        ],
        "dialogs": {
          "220370301": {
            "id": "220370301",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "Have you cleared them all?",
            "nextDialogs": [
              "220370302"
            ]
          },
          "220370302": {
            "id": "220370302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "All the mushrooms are here.",
            "nextDialogs": [
              "220370303"
            ]
          },
          "220370303": {
            "id": "220370303",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "That's all? I remember there being be a lot more. Did you really clear them all out?",
            "nextDialogs": [
              "220370304"
            ]
          },
          "220370304": {
            "id": "220370304",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "Anyway, you have my appreciation, youngster. Take this as payment.",
            "nextDialogs": [
              "220370305"
            ]
          },
          "220370305": {
            "id": "220370305",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "I have to say that these fertilizers are quite amazing. The mushrooms grew so quickly. If only they could help the crops grow this fast as well...",
            "nextDialogs": [
              "220370306"
            ]
          },
          "220370306": {
            "id": "220370306",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "When I've got the time, I will surely come buy some more and try them out..."
          }
        }
      }
    },
    {
      "subId": "2203704",
      "subQuestName": "Talk to Konda Densuke",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220370403"
        ],
        "dialogs": {
          "220370403": {
            "id": "220370403",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "Have you cleared them all?",
            "nextDialogs": [
              "220370404"
            ]
          },
          "220370404": {
            "id": "220370404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got all the mushrooms right here.",
            "nextDialogs": [
              "220370405"
            ]
          },
          "220370405": {
            "id": "220370405",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "There were so many mushrooms, but looks like you did get them all.",
            "nextDialogs": [
              "220370406"
            ]
          },
          "220370406": {
            "id": "220370406",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "Thank you, youngster. I really don't know what I would do without your help. Take this as a token of my gratitude.",
            "nextDialogs": [
              "220370407"
            ]
          },
          "220370407": {
            "id": "220370407",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "I have to say that these fertilizers are quite amazing. The mushrooms grew so quickly. If only they could help the crops grow this fast as well...",
            "nextDialogs": [
              "220370408"
            ]
          },
          "220370408": {
            "id": "220370408",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "When I've got the time, I will surely come buy some more and try them out..."
          }
        }
      }
    }
  ]

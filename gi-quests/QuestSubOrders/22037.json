  "subQuests": [
    {
      "subId": "2203701",
      "subQuestName": "Talk to Vahid",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220370101"
        ],
        "dialogs": {
          "220370101": {
            "id": "220370101",
            "speakerId": 3080,
            "speakerName": "Vahid",
            "text": "Oh no... how did this happen?",
            "nextDialogs": [
              "220370102"
            ]
          },
          "220370102": {
            "id": "220370102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "220370103"
            ]
          },
          "220370103": {
            "id": "220370103",
            "speakerId": 3080,
            "speakerName": "Vahid",
            "text": "Traveler, I was just looking for you!",
            "nextDialogs": [
              "220370104"
            ]
          },
          "220370104": {
            "id": "220370104",
            "speakerId": 3080,
            "speakerName": "Vahid",
            "text": "Do you still remember Konda Densuke? He came to the store several days ago, asking about the fertilizers.",
            "nextDialogs": [
              "220370105"
            ]
          },
          "220370105": {
            "id": "220370105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is he satisfied with the fertilizers?",
            "nextDialogs": [
              "220370106"
            ]
          },
          "220370106": {
            "id": "220370106",
            "speakerId": 3080,
            "speakerName": "Vahid",
            "text": "I wouldn't put it in those terms. Strictly speaking, I think Mr. Konda Densuke is feeling lost.",
            "nextDialogs": [
              "220370107"
            ]
          },
          "220370107": {
            "id": "220370107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Lost?",
            "nextDialogs": [
              "220370108"
            ]
          },
          "220370108": {
            "id": "220370108",
            "speakerId": 3080,
            "speakerName": "Vahid",
            "text": "Well, here's the thing. After your previous promotion, Mr. Densuke did use our fertilizers according to your instructions.",
            "nextDialogs": [
              "220370109"
            ]
          },
          "220370109": {
            "id": "220370109",
            "speakerId": 3080,
            "speakerName": "Vahid",
            "text": "However, although the crops did grow well, at the same time... a lot of mushrooms came out of nowhere...",
            "nextDialogs": [
              "220370110"
            ]
          },
          "220370110": {
            "id": "220370110",
            "speakerId": 3080,
            "speakerName": "Vahid",
            "text": "To be honest, after Mr. Konda told me about it, I am also feeling a bit lost.",
            "nextDialogs": [
              "220370111"
            ]
          },
          "220370111": {
            "id": "220370111",
            "speakerId": 3080,
            "speakerName": "Vahid",
            "text": "But anyway, it definitely has something to do with the fertilizers.",
            "nextDialogs": [
              "220370112"
            ]
          },
          "220370112": {
            "id": "220370112",
            "speakerId": 3080,
            "speakerName": "Vahid",
            "text": "Traveler, could you please go to Konda Village and help Mr. Konda clear those mushrooms out of his fields?",
            "nextDialogs": [
              "220370114",
              "220370117"
            ]
          },
          "220370114": {
            "id": "220370114",
            "speakerId": 3080,
            "speakerName": "Vahid",
            "text": "That I will. I will be doing some research in the store to see what exactly caused this...",
            "nextDialogs": [
              "220370115"
            ]
          },
          "220370115": {
            "id": "220370115",
            "speakerId": 3080,
            "speakerName": "Vahid",
            "text": "*sigh* If only Alrani were here. She would definitely have found the cause already."
          },
          "220370117": {
            "id": "220370117",
            "speakerId": 3080,
            "speakerName": "Vahid",
            "text": "If she was here, we would have figured it out quite quickly.",
            "nextDialogs": [
              "220370118"
            ]
          },
          "220370118": {
            "id": "220370118",
            "speakerId": 3080,
            "speakerName": "Vahid",
            "text": "But she hasn't returned yet, and I have no idea where she went.",
            "nextDialogs": [
              "220370119"
            ]
          },
          "220370119": {
            "id": "220370119",
            "speakerId": 3080,
            "speakerName": "Vahid",
            "text": "I can only count on you, Traveler. I will be doing some research in the store to see what exactly caused this..."
          }
        }
      }
    },
    {
      "subId": "2203702",
      "subQuestName": "Talk to Konda Densuke",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220370201"
        ],
        "dialogs": {
          "220370201": {
            "id": "220370201",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "What is the matter with these mushrooms...",
            "nextDialogs": [
              "220370205",
              "220370204"
            ]
          },
          "220370205": {
            "id": "220370205",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "Were you sent by Mr. Vahid to help me clear them away?",
            "nextDialogs": [
              "220370206"
            ]
          },
          "220370206": {
            "id": "220370206",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "Hmm, then they're all yours. There are way too many mushrooms in the field. It's not a job for an old timer like me.",
            "nextDialogs": [
              "220370207"
            ]
          },
          "220370207": {
            "id": "220370207",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "How could these mushrooms have grown so fast..."
          },
          "220370204": {
            "id": "220370204",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "Oh, the mushrooms? Well, there's no shortage of them on my dining table, that's for sure."
          }
        }
      }
    },
    {
      "subId": "2203705",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220370501"
        ],
        "dialogs": {
          "220370501": {
            "id": "220370501",
            "speakerId": 3151,
            "speakerName": "Konda Densuke",
            "text": "Why did these mushrooms grow so quickly?"
          }
        }
      }
    },
    {
      "subId": "2203706",
      "subQuestName": "Pull out the Mushrooms in the field",

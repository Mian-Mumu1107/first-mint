    {
      "subId": "2503206",
      "subQuestName": "Report back to Zicheng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250320601"
        ],
        "dialogs": {
          "250320601": {
            "id": "250320601",
            "speakerId": 1000,
            "speakerName": "Zicheng",
            "text": "You're back! Have you finished taking the picture?",
            "nextDialogs": [
              "250320602"
            ]
          },
          "250320602": {
            "id": "250320602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That I have.",
            "nextDialogs": [
              "250320603"
            ]
          },
          "250320603": {
            "id": "250320603",
            "speakerId": 1000,
            "speakerName": "Zicheng",
            "text": "Wow, you're good. Much better than my assistant for sure. Whenever he takes pictures of the sites we're surveying, we're looking at several takes, minimum.",
            "nextDialogs": [
              "250320604"
            ]
          },
          "250320604": {
            "id": "250320604",
            "speakerId": 1000,
            "speakerName": "Zicheng",
            "text": "If we had you on the survey team, I bet we'd have ruined a few Kameras less.",
            "nextDialogs": [
              "250320605"
            ]
          },
          "250320605": {
            "id": "250320605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Can you really use this to help write poetry?",
            "nextDialogs": [
              "250320606"
            ]
          },
          "250320606": {
            "id": "250320606",
            "speakerId": 1000,
            "speakerName": "Zicheng",
            "text": "I... think so? Well, and if I can't make it work, I'll just use the picture as a postcard.",
            "nextDialogs": [
              "250320607"
            ]
          },
          "250320607": {
            "id": "250320607",
            "speakerId": 1000,
            "speakerName": "Zicheng",
            "text": "I'll write some wish-you-were-heres on the back and have it sent to the Ministry. No one'll say nothin', not after the gift!",
            "nextDialogs": [
              "250320608"
            ]
          },
          "250320608": {
            "id": "250320608",
            "speakerId": 1000,
            "speakerName": "Zicheng",
            "text": "*cough* That's the last resort, though. In the meantime, I'll give this \"writing a good poem\" business some thought...",
            "nextDialogs": [
              "250320609"
            ]
          },
          "250320609": {
            "id": "250320609",
            "speakerId": 1000,
            "speakerName": "Zicheng",
            "text": "The five winds... surge? ... No, roil, perhaps... Wait a moment. How many tribes does Natlan have anyway?"
          }
        }
      }
    },

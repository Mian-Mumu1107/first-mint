  "subQuests": [
    {
      "subId": "2007301",
      "subQuestName": "Talk to Riese",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200730101"
        ],
        "dialogs": {
          "200730101": {
            "id": "200730101",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "Traveler! Wonderful timing. Could you do me a favor?",
            "nextDialogs": [
              "200730102"
            ]
          },
          "200730102": {
            "id": "200730102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do you need?",
            "nextDialogs": [
              "200730103"
            ]
          },
          "200730103": {
            "id": "200730103",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "As you've no doubt seen, the conditions up here are horrendous. Even experienced adventurers would not dare to claim that they can handle all that Dragonspine can throw at them.",
            "nextDialogs": [
              "200730104"
            ]
          },
          "200730104": {
            "id": "200730104",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "I have orders from the Acting Grand Master to stand guard here and warn all citizens not to go up the mountain.",
            "nextDialogs": [
              "200730105"
            ]
          },
          "200730105": {
            "id": "200730105",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "However, while I have been able to persuade many citizens not to do so, those adventurers...",
            "nextDialogs": [
              "200730106"
            ]
          },
          "200730106": {
            "id": "200730106",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "I'm sure you know what I mean when I say that there's no use trying to convince them. They just want to go up that mountain.",
            "nextDialogs": [
              "200730107"
            ]
          },
          "200730107": {
            "id": "200730107",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "I've lost count of the number of matters I've had to resolve involving the adventurers... But they just keep coming anyway, and their ranks never thin.",
            "nextDialogs": [
              "200730108"
            ]
          },
          "200730108": {
            "id": "200730108",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "Trying to manage them all is an impossible task... As such, I've decided to prepare some supplies for them in designated spots on Dragonspine.",
            "nextDialogs": [
              "200730109"
            ]
          },
          "200730109": {
            "id": "200730109",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "In this way, those adventurers who have suffered a reverse and are preparing to turn back will have more opportunities to extricate themselves from the mountain.",
            "nextDialogs": [
              "200730110"
            ]
          },
          "200730110": {
            "id": "200730110",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "However, if some reckless fool drunk on their good fortune were to get too far up, then they'd only have themselves to rely on...",
            "nextDialogs": [
              "200730111"
            ]
          },
          "200730111": {
            "id": "200730111",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "So, could you help bring these supplies up the mountain?",
            "nextDialogs": [
              "200730113",
              "200730115"
            ]
          },
          "200730113": {
            "id": "200730113",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "I shall be counting on you, then. *sigh* If only those adventurers had as good a sword-arm and as sensible a head on their shoulders as you do...",
            "nextDialogs": [
              "200730117"
            ]
          },
          "200730117": {
            "id": "200730117",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "I've marked three locations out on your map. You simply have to place <color=#00E1FFFF>one serving of Ham</color> at each place.",
            "nextDialogs": [
              "200730118"
            ]
          },
          "200730118": {
            "id": "200730118",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "*sigh* I wish those adventurers had a little more self-awareness..."
          },
          "200730115": {
            "id": "200730115",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "Whether they will or not... It's better to have them than not.",
            "nextDialogs": [
              "200730116"
            ]
          },
          "200730116": {
            "id": "200730116",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "In such terrible conditions as the ones we have on this mountain, the more supplies we have, the better. All told, I'm counting on your help."
          }
        }
      }
    },
    {
      "subId": "2007302",
      "subQuestName": "Place the food supplies at the first location",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200730201"
        ],
        "dialogs": {
          "200730201": {
            "id": "200730201",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "Have you placed all the supplies?",
            "nextDialogs": [
              "200730202"
            ]
          },
          "200730202": {
            "id": "200730202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They're all where they need to be.",
            "nextDialogs": [
              "200730203"
            ]
          },
          "200730203": {
            "id": "200730203",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "That's wonderful. I can rest easy now.",
            "nextDialogs": [
              "200730204"
            ]
          },
          "200730204": {
            "id": "200730204",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "Still, I hope that those who go up the mountain will come sufficiently prepared and that they shan't have to use these emergency foodstuffs.",
            "nextDialogs": [
              "200730205"
            ]
          },
          "200730205": {
            "id": "200730205",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "Come to think of it, your clothes seem a little thin, too. Is this the latest fashion in Mondstadt or something?",
            "nextDialogs": [
              "200730206"
            ]
          },
          "200730206": {
            "id": "200730206",
            "speakerId": 1000,
            "speakerName": "Riese",
            "text": "Whatever the case, please take these as a token of my thanks, and go put on some extra layers."
          }
        }
      }
    },
    {

    {
      "subId": "200804",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20080401"
        ],
        "dialogs": {
          "20080401": {
            "id": "20080401",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Please be careful..."
          }
        }
      }
    },
    {
      "subId": "200899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20089901"
        ],
        "dialogs": {
          "20089901": {
            "id": "20089901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Inazuma's not such a bad place, Paimon's having a pretty good time! But... we should probably go and see about the \"next operation\" that Thoma and Ayaka were talking about, right?",
            "nextDialogs": [
              "20089902"
            ]
          },
          "20089902": {
            "id": "20089902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "As usual, it's the first stop, Komore Teahouse. Are you ready to head over?"
          }
        }
      }
    },
    {
      "subId": "4002015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400201501"
        ],
        "dialogs": {
          "400201501": {
            "id": "400201501",
            "speakerId": 12172,
            "speakerName": "Watanabe",
            "text": "Ugh! I failed again... The disgrace of it!",
            "nextDialogs": [
              "400201502"
            ]
          },
          "400201502": {
            "id": "400201502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell me about the Tenryou Commission...",
            "nextDialogs": [
              "400201503"
            ]
          },
          "400201503": {
            "id": "400201503",
            "speakerId": 12172,
            "speakerName": "Watanabe",
            "text": "As you can see, the times have changed. The Tenryou Commission is currently redeploying its defenses all across Inazuma.",
            "nextDialogs": [
              "400201504"
            ]
          },
          "400201504": {
            "id": "400201504",
            "speakerId": 12172,
            "speakerName": "Watanabe",
            "text": "Though we're not as efficient or brave as Madam Kujou Sara makes us out to be, we spare no effort in protecting Inazuma and stopping these monsters from ravaging the land..."
          }
        }
      }
    },
    {
      "subId": "4002115",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400211501"
        ],
        "dialogs": {
          "400211501": {
            "id": "400211501",
            "speakerId": 12172,
            "speakerName": "Watanabe",
            "text": "I knew we could count on Madam Kujou Sara! The reinforcements she sent are all seasoned veterans!",
            "nextDialogs": [
              "400211502"
            ]
          },
          "400211502": {
            "id": "400211502",
            "speakerId": 12172,
            "speakerName": "Watanabe",
            "text": "With experienced fighters on hand, no amount of monsters can breach this pass!",
            "nextDialogs": [
              "400211503"
            ]
          },
          "400211503": {
            "id": "400211503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About your wounds...",
            "nextDialogs": [
              "400211504"
            ]
          },
          "400211504": {
            "id": "400211504",
            "speakerId": 12172,
            "speakerName": "Watanabe",
            "text": "Ha, nothing more than a scratch! Tenryou Commission samurai don't back down in critical moments like these!",
            "nextDialogs": [
              "400211505"
            ]
          },
          "400211505": {
            "id": "400211505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What a valiant spirit! No wonder people are starting to feel more at ease!"
          }
        }
      }
    },
    {
      "subId": "4002212",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400221201"
        ],
        "dialogs": {
          "400221201": {
            "id": "400221201",
            "speakerId": 12172,
            "speakerName": "Watanabe",
            "text": "The situation seems to be stabilizing... Madam Kujou Sara won't feel pressured to take action.",
            "nextDialogs": [
              "400221202"
            ]
          },
          "400221202": {
            "id": "400221202",
            "speakerId": 12172,
            "speakerName": "Watanabe",
            "text": "No need to rush. We'll launch a general offensive as soon as Madam Kujou Sara finishes with her business in the city, and take down this Domain in one go!",
            "nextDialogs": [
              "400221203"
            ]
          },
          "400221203": {
            "id": "400221203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We should hurry, they seem pretty amped up..."
          }
        }
      }
    },
    {
      "subId": "4002303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400230301"
        ],
        "dialogs": {
          "400230301": {
            "id": "400230301",
            "speakerId": 30067,
            "speakerName": "Shiki Taishou",
            "text": "Those who seek ultimate attainment, can find it in practices of this Mystic Onmyou Chamber.",
            "nextDialogs": [
              "400230302"
            ]
          },
          "400230302": {
            "id": "400230302",
            "speakerId": 30067,
            "speakerName": "Shiki Taishou",
            "text": "Of course, rushing straight for the strongest opponent may set you back. Know yourself, and proceed in accordance with your abilities."
          }
        }
      }
    }
  ]
}
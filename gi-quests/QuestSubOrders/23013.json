{
  "lineCounts": {
    "Garcia": 42,
    "Lutong": 34,
    "Player": 15
  },
  "subQuests": [
    {
      "subId": "2301301",
      "subQuestName": "Talk to Garcia",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230130101"
        ],
        "dialogs": {
          "230130101": {
            "id": "230130101",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Lutong, my dear Lutong, are you sure... this is the place?",
            "nextDialogs": [
              "230130102"
            ]
          },
          "230130102": {
            "id": "230130102",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Yes, Mr. Garcia, this is where Slimes are most often found.",
            "nextDialogs": [
              "230130103"
            ]
          },
          "230130103": {
            "id": "230130103",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "I am most certain of that. However...",
            "nextDialogs": [
              "230130104"
            ]
          },
          "230130104": {
            "id": "230130104",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Would you agree that the Slimes are mildly overwhelming in quantity?",
            "nextDialogs": [
              "230130105"
            ]
          },
          "230130105": {
            "id": "230130105",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Mr. Garcia, this is how we end up when we are caught short financially.",
            "nextDialogs": [
              "230130108"
            ]
          },
          "230130108": {
            "id": "230130108",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Traveler! What a coincidence!",
            "nextDialogs": [
              "230130109"
            ]
          },
          "230130109": {
            "id": "230130109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing here?",
            "nextDialogs": [
              "230130110"
            ]
          },
          "230130110": {
            "id": "230130110",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Haha. Why, I'm here for...",
            "nextDialogs": [
              "230130111"
            ]
          },
          "230130111": {
            "id": "230130111",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Trouble.",
            "nextDialogs": [
              "230130112"
            ]
          },
          "230130112": {
            "id": "230130112",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Valiant adventure! Please, Lutong, could you not...",
            "nextDialogs": [
              "230130113"
            ]
          },
          "230130113": {
            "id": "230130113",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "As you wish, sir.",
            "nextDialogs": [
              "230130114"
            ]
          },
          "230130114": {
            "id": "230130114",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "In truth, I'm here to look for Slime Condensate to use as the lubricant for my Numbering Machine.",
            "nextDialogs": [
              "230130115"
            ]
          },
          "230130115": {
            "id": "230130115",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Unfortunately, most of the Slime Condensate on sale is of low quality as it's kept for too long. Besides...",
            "nextDialogs": [
              "230130116"
            ]
          },
          "230130116": {
            "id": "230130116",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Mr. Garcia purchased too many books...",
            "nextDialogs": [
              "230130117"
            ]
          },
          "230130117": {
            "id": "230130117",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Oh come now, those were... necessary expenditures — that left us short of Mora, yes, but still!",
            "nextDialogs": [
              "230130118"
            ]
          },
          "230130118": {
            "id": "230130118",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "That's why we came here, to collect some fresh Slime Condensate ourselves.",
            "nextDialogs": [
              "230130119"
            ]
          },
          "230130119": {
            "id": "230130119",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "But as you can see, though our good Lutong is from Liyue, he knows neither martial arts nor culinary skills.",
            "nextDialogs": [
              "230130120"
            ]
          },
          "230130120": {
            "id": "230130120",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Fortunately, I have a gift for accounting... all thanks to the complex tax rules of the Ministry of Civil Affairs.",
            "nextDialogs": [
              "230130121"
            ]
          },
          "230130121": {
            "id": "230130121",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "...As for me, I can't possibly hit anyone with the components of my Numbering Machine.",
            "nextDialogs": [
              "230130122"
            ]
          },
          "230130122": {
            "id": "230130122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you need my help?",
            "nextDialogs": [
              "230130123"
            ]
          },
          "230130123": {
            "id": "230130123",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Well, in a sense...",
            "nextDialogs": [
              "230130124"
            ]
          },
          "230130124": {
            "id": "230130124",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Yes.",
            "nextDialogs": [
              "230130125"
            ]
          },
          "230130125": {
            "id": "230130125",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Lutong, do we... um... do we have any Mora left?",
            "nextDialogs": [
              "230130126"
            ]
          },
          "230130126": {
            "id": "230130126",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Well, I believe we'll find a way to get by after we pay the Traveler.",
            "nextDialogs": [
              "230130127"
            ]
          },
          "230130127": {
            "id": "230130127",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Splendid. Traveler, I'd appreciate it if you could kindly retrieve some Slime Condensate for me."
          }
        }
      }
    },
    {
      "subId": "2301302",
      "subQuestName": "Acquire fresh Slime Condensate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230130201"
        ],
        "dialogs": {
          "230130201": {
            "id": "230130201",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Lutong, our Mora...",
            "nextDialogs": [
              "230130202"
            ]
          },
          "230130202": {
            "id": "230130202",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "We'll get by, Mr. Garcia.",
            "nextDialogs": [
              "230130203"
            ]
          },
          "230130203": {
            "id": "230130203",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "There is an old saying in Liyue, \"When your path is blocked by a mountain, there will be a way through.\" I think this describes precisely where we are right now.",
            "nextDialogs": [
              "230130204"
            ]
          },
          "230130204": {
            "id": "230130204",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "It means that when a mountain stands in our way, we will always find a way to get over it.",
            "nextDialogs": [
              "230130205"
            ]
          },
          "230130205": {
            "id": "230130205",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Aha! That's a clever metaphor. Then I suppose our situation is not quite so dire.",
            "nextDialogs": [
              "230130206"
            ]
          },
          "230130206": {
            "id": "230130206",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Still, Mr. Garcia, do you think the person who originally penned those words found a way across the mountain?",
            "nextDialogs": [
              "230130207"
            ]
          },
          "230130207": {
            "id": "230130207",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Eh? Come now, Lutong, don't jinx it..."
          }
        }
      }
    },
    {
      "subId": "2301303",
      "subQuestName": "Report back to Garcia",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230130301"
        ],
        "dialogs": {
          "230130301": {
            "id": "230130301",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Traveler, have you obtained the Slime Condensate?",
            "nextDialogs": [
              "230130302"
            ]
          },
          "230130302": {
            "id": "230130302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it right here.",
            "nextDialogs": [
              "230130303"
            ]
          },
          "230130303": {
            "id": "230130303",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Wonderful! This should suffice. I'll continue my experiments once I return. With this as the lubricant, my Numbering Machine will definitely...",
            "nextDialogs": [
              "230130304"
            ]
          },
          "230130304": {
            "id": "230130304",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "I must attend to my research now. Lutong, please take care of the remaining affairs.",
            "nextDialogs": [
              "230130305"
            ]
          },
          "230130305": {
            "id": "230130305",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Yes, sir.",
            "nextDialogs": [
              "230130306"
            ]
          },
          "230130306": {
            "id": "230130306",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Here's your payment, Traveler. Thank you ever so much for your help.",
            "nextDialogs": [
              "230130307"
            ]
          },
          "230130307": {
            "id": "230130307",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "And um... in my humble opinion, we might be in need of your help in the future.",
            "nextDialogs": [
              "230130308"
            ]
          },
          "230130308": {
            "id": "230130308",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Rest assured. As long as the accounts are in my hands, you will be paid fairly.",
            "nextDialogs": [
              "230130309"
            ]
          },
          "230130309": {
            "id": "230130309",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "*sigh* ...Actually, I came to travel with Mr. Garcia because I didn't want to spend my whole life doing accounts in a department of the Ministry of Civil Affairs like my parents do.",
            "nextDialogs": [
              "230130310"
            ]
          },
          "230130310": {
            "id": "230130310",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "But now... in addition to working with Mr. Garcia on his calculations, I also need to help him sort out his accounts...",
            "nextDialogs": [
              "230130311"
            ]
          },
          "230130311": {
            "id": "230130311",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "I guess this is what they call destiny..."
          }
        }
      }
    },
    {
      "subId": "2301311",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230131101"
        ],
        "dialogs": {
          "230131101": {
            "id": "230131101",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Once again, Mr. Garcia, I sincerely suggest that we sell a few books to raise some Mora.",
            "nextDialogs": [
              "230131102"
            ]
          },
          "230131102": {
            "id": "230131102",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "No! Not for the world! Lutong, my dear, you are asking me to put my soul up for sale!",
            "nextDialogs": [
              "230131103"
            ]
          },
          "230131103": {
            "id": "230131103",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "But sir, no one bids for souls.",
            "nextDialogs": [
              "230131106"
            ]
          },
          "230131106": {
            "id": "230131106",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Oh, Traveler? What brings you here?",
            "nextDialogs": [
              "230131107"
            ]
          },
          "230131107": {
            "id": "230131107",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Um... My last experiment failed. There was something wrong with my dilution of the Slime Condensate...",
            "nextDialogs": [
              "230131108"
            ]
          },
          "230131108": {
            "id": "230131108",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Instead of lubricating the bearings of the Numbering Machine, the lubricant actually made them more likely to get stuck.",
            "nextDialogs": [
              "230131109"
            ]
          },
          "230131109": {
            "id": "230131109",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "As such, I need more Slime Condensate for further experiments. Could you..."
          }
        }
      }
    },
    {
      "subId": "2301350",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230135001"
        ],
        "dialogs": {
          "230135001": {
            "id": "230135001",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Sir, this might be the place we're looking for. Now we just have to return with some hires...",
            "nextDialogs": [
              "230135002"
            ]
          },
          "230135002": {
            "id": "230135002",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Sir? Mr. Garcia, are you listening to me?",
            "nextDialogs": [
              "230135003"
            ]
          },
          "230135003": {
            "id": "230135003",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Yeah? Oh... Of course, I'm listening. Let's go back and hire someone. It won't take long.",
            "nextDialogs": [
              "230135004"
            ]
          },
          "230135004": {
            "id": "230135004",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is... is everything alright?",
            "nextDialogs": [
              "230135005"
            ]
          },
          "230135005": {
            "id": "230135005",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Traveler, ha... It's all right. I'm fine. Do I look I have a problem?",
            "nextDialogs": [
              "230135006"
            ]
          },
          "230135006": {
            "id": "230135006",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Now I am 100% committed to the research on the Numbering Machine, and I feel that I am only one step away from success.",
            "nextDialogs": [
              "230135007"
            ]
          },
          "230135007": {
            "id": "230135007",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "If you're willing to help, would you please get some Slime Condensate for me?",
            "nextDialogs": [
              "230135008"
            ]
          },
          "230135008": {
            "id": "230135008",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Since you are here, I don't have to go back to the city to hire people. Now that I have made a little money now, I can offer you a better payment.",
            "nextDialogs": [
              "230135011"
            ]
          },
          "230135011": {
            "id": "230135011",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "I will leave this part to you, Traveler. As for me, I have to think about how to change the structure of the mechanism..."
          }
        }
      }
    },
    {
      "subId": "2301351",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230135101"
        ],
        "dialogs": {
          "230135101": {
            "id": "230135101",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Traveler, thanks for coming.",
            "nextDialogs": [
              "230135104"
            ]
          },
          "230135104": {
            "id": "230135104",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "You're right, it's Ms. Kaia. Though Mr. Garcia doesn't talk about it, he gets distracted more and more often at work.",
            "nextDialogs": [
              "230135105"
            ]
          },
          "230135105": {
            "id": "230135105",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "And he never went to that café again. Now he just asks me to buy it for him.",
            "nextDialogs": [
              "230135106"
            ]
          },
          "230135106": {
            "id": "230135106",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Even Mr. Ahangar came to tell me that he could talk to Mr. Garcia if it's necessary.",
            "nextDialogs": [
              "230135107"
            ]
          },
          "230135107": {
            "id": "230135107",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "I don't know how to straighten Mr. Garcia out, as I have no experience dealing with this kind of situation.",
            "nextDialogs": [
              "230135108"
            ]
          },
          "230135108": {
            "id": "230135108",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "*sigh* Looks like there is another hurdle in front of me and Mr. Garcia..."
          }
        }
      }
    },
    {
      "subId": "2301352",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230135201"
        ],
        "dialogs": {
          "230135201": {
            "id": "230135201",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Traveler, have you obtained the Slime Condensate?",
            "nextDialogs": [
              "230135202"
            ]
          },
          "230135202": {
            "id": "230135202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it right here.",
            "nextDialogs": [
              "230135203"
            ]
          },
          "230135203": {
            "id": "230135203",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "Well, that's enough. Lutong, can you pay the Traveler first?",
            "nextDialogs": [
              "230135204"
            ]
          },
          "230135204": {
            "id": "230135204",
            "speakerId": 1000,
            "speakerName": "Garcia",
            "text": "I need to check the quality of these Slime Condensate first...",
            "nextDialogs": [
              "230135205"
            ]
          },
          "230135205": {
            "id": "230135205",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "Here's your payment, Traveler. Thank you for your help.",
            "nextDialogs": [
              "230135206"
            ]
          },
          "230135206": {
            "id": "230135206",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "You are welcomed to swing by anytime.",
            "nextDialogs": [
              "230135207"
            ]
          },
          "230135207": {
            "id": "230135207",
            "speakerId": 1001,
            "speakerName": "Lutong",
            "text": "If Mr. Garcia's mental state is too... unwell, maybe I'll need your help."
          }
        }
      }
    }
  ]
}
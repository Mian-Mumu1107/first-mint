  },
  "subQuests": [
    {
      "subId": "7907201",
      "subQuestName": "Talk to Devitt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790720101"
        ],
        "dialogs": {
          "790720101": {
            "id": "790720101",
            "speakerId": 1000,
            "speakerName": "Devitt",
            "text": "#Oh my, what an honor. You must be {NICKNAME}, in which case, the one by your side must be your companion, Ms. Paimon.",
            "nextDialogs": [
              "790720102"
            ]
          },
          "790720102": {
            "id": "790720102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe, right in one! That's us!",
            "nextDialogs": [
              "790720103"
            ]
          },
          "790720103": {
            "id": "790720103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're that famous, are we?",
            "nextDialogs": [
              "790720104"
            ]
          },
          "790720104": {
            "id": "790720104",
            "speakerId": 1000,
            "speakerName": "Devitt",
            "text": "News travels quickly to, from, and through Constellation Metropole.",
            "nextDialogs": [
              "790720105"
            ]
          },
          "790720105": {
            "id": "790720105",
            "speakerId": 1000,
            "speakerName": "Devitt",
            "text": "I must say that you're right on time — I was just putting the finishing touches on this game of mine, named \"Flying Hats.\"",
            "nextDialogs": [
              "790720106"
            ]
          },
          "790720106": {
            "id": "790720106",
            "speakerId": 1000,
            "speakerName": "Devitt",
            "text": "I can't be like the eponymous hatter in the \"Flying Hatter,\" who gave everyone a lovely hat, I fear...",
            "nextDialogs": [
              "790720107"
            ]
          },
          "790720107": {
            "id": "790720107",
            "speakerId": 1000,
            "speakerName": "Devitt",
            "text": "But I believe that \"Flying Hats\" will bring joy to those who play it.",
            "nextDialogs": [
              "790720108"
            ]
          },
          "790720108": {
            "id": "790720108",
            "speakerId": 1000,
            "speakerName": "Devitt",
            "text": "I've also designed three completely different gameplay modes for it... Don't worry, don't worry, the rules aren't too complicated!",
            "nextDialogs": [
              "790720109"
            ]
          },
          "790720109": {
            "id": "790720109",
            "speakerId": 1000,
            "speakerName": "Devitt",
            "text": "You'll figure it out after just one game, I guarantee it.",
            "nextDialogs": [
              "790720111",
              "790720113"
            ]
          },
          "790720111": {
            "id": "790720111",
            "speakerId": 1000,
            "speakerName": "Devitt",
            "text": "Alrighty-righty then. This way, please."
          },
          "790720113": {
            "id": "790720113",
            "speakerId": 1000,
            "speakerName": "Devitt",
            "text": "Oh, it's quite alright. Just come find me whenever you've got the time. I'll be staying here for time being."
          }
        }
      }
    }
  ]
}
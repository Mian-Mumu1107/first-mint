  "subQuests": [
    {
      "subId": "1020201",
      "subQuestName": "Go back to the Knights' headquarters and report to Jean",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102020101"
        ],
        "dialogs": {
          "102020101": {
            "id": "102020101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Klee? You're here too?",
            "nextDialogs": [
              "102020102"
            ]
          },
          "102020102": {
            "id": "102020102",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "I... *sobbing* I turned myself in.",
            "nextDialogs": [
              "102020103"
            ]
          },
          "102020103": {
            "id": "102020103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...Huh?",
            "nextDialogs": [
              "102020104"
            ]
          },
          "102020104": {
            "id": "102020104",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "*sobbing* I... M—My bomb... I—I hurt someone...",
            "nextDialogs": [
              "102020105"
            ]
          },
          "102020105": {
            "id": "102020105",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "*sobbing* I broke the rules... I'll never see the light of day again...",
            "nextDialogs": [
              "102020106"
            ]
          },
          "102020106": {
            "id": "102020106",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Klee, I need you to answer me. You said someone was injured. Where are they?",
            "nextDialogs": [
              "102020107"
            ]
          },
          "102020107": {
            "id": "102020107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wait! There's been a misunderstanding.",
            "nextDialogs": [
              "102020108"
            ]
          },
          "102020108": {
            "id": "102020108",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Why is that?",
            "nextDialogs": [
              "102020109"
            ]
          },
          "102020109": {
            "id": "102020109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The person that Klee blew up was an Abyss Mage.",
            "nextDialogs": [
              "102020110"
            ]
          },
          "102020110": {
            "id": "102020110",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "But... But Mr. Fluffball was only a thief... He didn't deserve to blow up...",
            "nextDialogs": [
              "102020111"
            ]
          },
          "102020111": {
            "id": "102020111",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, come on now... Paimon already told you that the Abyss Mages are the bad guys...",
            "nextDialogs": [
              "102020112"
            ]
          },
          "102020112": {
            "id": "102020112",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And actually, they're the worst kind of bad guys you can imagine. They don't just hate the good guys, they hate all people... Their enemy is... humanity itself.",
            "nextDialogs": [
              "102020113"
            ]
          },
          "102020113": {
            "id": "102020113",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "Mr. Fluffball... was a bad guy on purpose? ...Mr. Fluffball is the enemy of humanity!?",
            "nextDialogs": [
              "102020114"
            ]
          },
          "102020114": {
            "id": "102020114",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "Wha... what!? I don't get it!",
            "nextDialogs": [
              "102020115"
            ]
          },
          "102020115": {
            "id": "102020115",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "This was an oversight on my part.",
            "nextDialogs": [
              "102020116"
            ]
          },
          "102020116": {
            "id": "102020116",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "I did not tell you these things before because you are still young.",
            "nextDialogs": [
              "102020117"
            ]
          },
          "102020117": {
            "id": "102020117",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "In fact, the Abyss Order is a hostile force in Mondstadt which has been unusually active lately.",
            "nextDialogs": [
              "102020118"
            ]
          },
          "102020118": {
            "id": "102020118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Because of Mondstadt's most powerful treasure?",
            "nextDialogs": [
              "102020119"
            ]
          },
          "102020119": {
            "id": "102020119",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Aha, that's it! Paimon understands now!",
            "nextDialogs": [
              "102020120"
            ]
          },
          "102020120": {
            "id": "102020120",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "They were tracking down poor Klee because they'd heard rumors about her treasure!",
            "nextDialogs": [
              "102020121"
            ]
          },
          "102020121": {
            "id": "102020121",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Just like the way Paimon's first reaction was to try and get her hands on... ahh, no— to try and get the facts on the treasure.",
            "nextDialogs": [
              "102020122"
            ]
          },
          "102020122": {
            "id": "102020122",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "So... does that mean...",
            "nextDialogs": [
              "102020123"
            ]
          },
          "102020123": {
            "id": "102020123",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "In light of your contribution on this matter, I will allow you to take part in the next Ludi Harpastum.",
            "nextDialogs": [
              "102020124"
            ]
          },
          "102020124": {
            "id": "102020124",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "Ludi Harpastum! Whoa!",
            "nextDialogs": [
              "102020127"
            ]
          },
          "102020127": {
            "id": "102020127",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "#{M#Mr.}{F#Miss} Honorary Knight, you've gotta come too!",
            "nextDialogs": [
              "102020128"
            ]
          },
          "102020128": {
            "id": "102020128",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Woop-de-doo, it's a happy ending!",
            "nextDialogs": [
              "102020129"
            ]
          },
          "102020129": {
            "id": "102020129",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Except...",
            "nextDialogs": [
              "102020131"
            ]
          },
          "102020131": {
            "id": "102020131",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Klee, where did you hide the treasure to begin with?",
            "nextDialogs": [
              "102020132"
            ]
          },
          "102020132": {
            "id": "102020132",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "I... Um...",
            "nextDialogs": [
              "102020133"
            ]
          },
          "102020133": {
            "id": "102020133",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Were you trying to blow up the fish in Starfell Lake again?",
            "nextDialogs": [
              "102020134"
            ]
          },
          "102020134": {
            "id": "102020134",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "I wasn't! I swear I wasn't!",
            "nextDialogs": [
              "102020135"
            ]
          },
          "102020135": {
            "id": "102020135",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "(She's giving us that look that means, play along...)",
            "nextDialogs": [
              "102020136"
            ]
          },
          "102020136": {
            "id": "102020136",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Uh-oh, Jean noticed it too...)",
            "nextDialogs": [
              "102020137"
            ]
          },
          "102020137": {
            "id": "102020137",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Klee?",
            "nextDialogs": [
              "102020138"
            ]
          },
          "102020138": {
            "id": "102020138",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "I'll see myself to <color=#00E1FFFF>solitary confinement</color>... *sobbing*",
            "nextDialogs": [
              "102020139"
            ]
          },
          "102020139": {
            "id": "102020139",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon bets Klee must get bored in there all by herself..."
          }
        }
      }
    },

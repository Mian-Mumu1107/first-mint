    {
      "subId": "1020204",
      "subQuestName": "Find the door of the confinement room in Knight's headquarters.",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102020401"
        ],
        "dialogs": {
          "102020401": {
            "id": "102020401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Guess whooo~?",
            "nextDialogs": [
              "102020402"
            ]
          },
          "102020402": {
            "id": "102020402",
            "speakerId": 1003,
            "speakerName": "???",
            "text": "That's Paimon's voice I hear!",
            "nextDialogs": [
              "102020405"
            ]
          },
          "102020405": {
            "id": "102020405",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "Ooh, ooh, yes, please! Wait — no, I... I can't. Klee needs to be a good girl and think about what she did... Stop tempting me!",
            "nextDialogs": [
              "102020406"
            ]
          },
          "102020406": {
            "id": "102020406",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "Anyway, while I'm grounded, I'm making an extra-special new treasure... the Ludi Harpastum version!",
            "nextDialogs": [
              "102020407"
            ]
          },
          "102020407": {
            "id": "102020407",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "When you say \"treasure...\"",
            "nextDialogs": [
              "102020408"
            ]
          },
          "102020408": {
            "id": "102020408",
            "speakerId": 1001,
            "speakerName": "Klee",
            "text": "Tee-hee... I made it into the shape of a harpastum and everything! It looks so cute..."
          }
        }
      }
    }
  ]

    {
      "subId": "7311007",
      "subQuestName": "Talk to Soheil",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731100501"
        ],
        "dialogs": {
          "731100501": {
            "id": "731100501",
            "speakerId": 4245,
            "speakerName": "Soheil",
            "text": "Now that the three ruins have been fully explored, I can finally put my thoughts to rest.",
            "nextDialogs": [
              "731100502"
            ]
          },
          "731100502": {
            "id": "731100502",
            "speakerId": 4245,
            "speakerName": "Soheil",
            "text": "Well then, to celebrate the strengthening of our friendship, I shall prepare more gifts of gratitude for our big hero and little hero.",
            "nextDialogs": [
              "731100504",
              "731100506"
            ]
          },
          "731100504": {
            "id": "731100504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's nothing, really! Plus, we found lots of treasure based on your notes! So, how's your paper going?",
            "nextDialogs": [
              "731100507"
            ]
          },
          "731100507": {
            "id": "731100507",
            "speakerId": 4245,
            "speakerName": "Soheil",
            "text": "The papers... Yeah, even though I've collected enough materials, I no longer depend on churning out volumes.",
            "nextDialogs": [
              "731100508"
            ]
          },
          "731100508": {
            "id": "731100508",
            "speakerId": 4245,
            "speakerName": "Soheil",
            "text": "It's a breakthrough I'm after... I must still go into the Mausoleum of King Deshret myself.",
            "nextDialogs": [
              "731100509"
            ]
          },
          "731100509": {
            "id": "731100509",
            "speakerId": 20821,
            "speakerName": "Hulwani",
            "text": "But the sage said...",
            "nextDialogs": [
              "731100510"
            ]
          },
          "731100510": {
            "id": "731100510",
            "speakerId": 4245,
            "speakerName": "Soheil",
            "text": "Yes, I get it, it's always about the sage with you... I'm just griping, that's all.",
            "nextDialogs": [
              "731100511"
            ]
          },
          "731100511": {
            "id": "731100511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do you need a breakthrough for?",
            "nextDialogs": [
              "731100512"
            ]
          },
          "731100512": {
            "id": "731100512",
            "speakerId": 4245,
            "speakerName": "Soheil",
            "text": "To become a candidate for the next sage, of course.",
            "nextDialogs": [
              "731100513"
            ]
          },
          "731100513": {
            "id": "731100513",
            "speakerId": 4245,
            "speakerName": "Soheil",
            "text": "To outsiders, the difference between a researcher and a sage is that of a small fruit and a larger fruit.",
            "nextDialogs": [
              "731100514"
            ]
          },
          "731100514": {
            "id": "731100514",
            "speakerId": 4245,
            "speakerName": "Soheil",
            "text": "In reality, the gap is even greater than the difference between a hilichurl and slime."
          },
          "731100506": {
            "id": "731100506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's right! We got treasure and you got inspiration for your papers."
          }
        }
      }
    },
    {

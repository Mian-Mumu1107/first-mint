        "dialogs": {
          "731100301": {
            "id": "731100301",
            "speakerId": 4245,
            "speakerName": "Soheil",
            "text": "You're back. Did you find anything special in the desert?",
            "nextDialogs": [
              "731100302"
            ]
          },
          "731100302": {
            "id": "731100302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet.",
            "nextDialogs": [
              "731100303"
            ]
          },
          "731100303": {
            "id": "731100303",
            "speakerId": 4245,
            "speakerName": "Soheil",
            "text": "Alright. If you do find anything, please share them with me and quench my thirst for knowledge."
          }
        }

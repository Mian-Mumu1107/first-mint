  "subQuests": [
    {
      "subId": "7610101",
      "subQuestName": "Head to Piramida",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761010101"
        ],
        "dialogs": {
          "761010101": {
            "id": "761010101",
            "speakerId": 1324,
            "speakerName": "Illuga",
            "text": "#{NICKNAME}, Paimon!",
            "nextDialogs": [
              "761010102"
            ]
          },
          "761010102": {
            "id": "761010102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, looks like we're right on time! This place is absolutely buzzin'!",
            "nextDialogs": [
              "761010103"
            ]
          },
          "761010103": {
            "id": "761010103",
            "speakerId": 1324,
            "speakerName": "Illuga",
            "text": "Everyone's been hard at work these past few days. Now that things have finally settled down, we were able to find a moment to bring everyone together.",
            "nextDialogs": [
              "761010104"
            ]
          },
          "761010104": {
            "id": "761010104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It couldn't have been easy for you either.",
            "nextDialogs": [
              "761010105"
            ]
          },
          "761010105": {
            "id": "761010105",
            "speakerId": 1324,
            "speakerName": "Illuga",
            "text": "I only did what was expected of me. But... if you hadn't stepped in when you did, I imagine things might've ended very differently. We might've still won... but not without paying a steeper price.",
            "nextDialogs": [
              "761010106"
            ]
          },
          "761010106": {
            "id": "761010106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Come on, we're in this together, aren't we? No need to be so serious!",
            "nextDialogs": [
              "761010107"
            ]
          },
          "761010107": {
            "id": "761010107",
            "speakerId": 1324,
            "speakerName": "Illuga",
            "text": "Yeah, you're right. Oh, looks like Gramps is about to speak.",
            "nextDialogs": [
              "761010108"
            ]
          },
          "761010108": {
            "id": "761010108",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "To all our comrades and kin — this isn't just a celebration. It's a moment to honor the struggle behind our triumph.",
            "nextDialogs": [
              "761010109"
            ]
          },
          "761010109": {
            "id": "761010109",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "Let us not forget, while we toast this victory, those who gave everything to make it possible. With their blood, they fulfilled the vow we all once made.",
            "nextDialogs": [
              "761010110"
            ]
          },
          "761010110": {
            "id": "761010110",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "During this battle, the \"Nightmare Orioles\" Investigation Squad, led by Illuga, took on what was perhaps the most perilous assignment of all.",
            "nextDialogs": [
              "761010111"
            ]
          },
          "761010111": {
            "id": "761010111",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "#Notably, {NICKNAME} and {M#his}{F#her} companion stepped forward without hesitation in a time of crisis and stood with us, playing a vital role in the operation's success.",
            "nextDialogs": [
              "761010112"
            ]
          },
          "761010112": {
            "id": "761010112",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "They braved every danger, pressed on through the storm, and carved a path to victory from the depths of despair.",
            "nextDialogs": [
              "761010113"
            ]
          },
          "761010113": {
            "id": "761010113",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "The legacy of their deeds, and of all who fought for the living and those yet to come, will be written into history, never to fade.",
            "nextDialogs": [
              "761010114"
            ]
          },
          "761010114": {
            "id": "761010114",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "Yes, we are victorious! That victory came at a heavy price, yes, and we may pause to mourn, to remember the fallen... but we must not be broken by grief.",
            "nextDialogs": [
              "761010115"
            ]
          },
          "761010115": {
            "id": "761010115",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "The future we fought for is within reach, and we carry the fire of those who lit the way before us. Their light must keep shining, and so we must press on.",
            "nextDialogs": [
              "761010116"
            ]
          },
          "761010116": {
            "id": "761010116",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "But today, let us raise our glasses: to victory, to the brave souls whose courage will never be forgotten, and to the future we vowed to protect."
          }
        }
      }
    },
    {
      "subId": "7610102",
      "subQuestName": "Talk to the Lightkeeper",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761010201"
        ],
        "dialogs": {
          "761010201": {
            "id": "761010201",
            "speakerId": 22320,
            "speakerName": "Olav",
            "text": "Illuga! Finally! Starshyna Nikita's been looking all over for you!",
            "nextDialogs": [
              "761010202"
            ]
          },
          "761010202": {
            "id": "761010202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Starshyna... Nikita?",
            "nextDialogs": [
              "761010203"
            ]
          },
          "761010203": {
            "id": "761010203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Wait, {NICKNAME}, Nikita... isn't that the same old guy who asked us to look for the Silver Lampwick?",
            "nextDialogs": [
              "761010204"
            ]
          },
          "761010204": {
            "id": "761010204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Didn't he say he was just a regular Ratnik?",
            "nextDialogs": [
              "761010207"
            ]
          },
          "761010207": {
            "id": "761010207",
            "speakerId": 1324,
            "speakerName": "Illuga",
            "text": "Ah, my old pops... He probably just meant it as a bit of fun.",
            "nextDialogs": [
              "761010208"
            ]
          },
          "761010208": {
            "id": "761010208",
            "speakerId": 1324,
            "speakerName": "Illuga",
            "text": "We can talk about that later. For now, let's go update him."
          }
        }
      }
    },
    {
      "subId": "7610103",
      "subQuestName": "Report to the old man",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761010301"
        ],
        "dialogs": {
          "761010301": {
            "id": "761010301",
            "speakerId": 1324,
            "speakerName": "Illuga",
            "text": "Gramps, we're back!",
            "nextDialogs": [
              "761010302"
            ]
          },
          "761010302": {
            "id": "761010302",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "Back safe, I see. How are things at Kipumaki Cliff?",
            "nextDialogs": [
              "761010303"
            ]
          },
          "761010303": {
            "id": "761010303",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You give a quick rundown of what happened...",
            "nextDialogs": [
              "761010304"
            ]
          },
          "761010304": {
            "id": "761010304",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "Just as I thought... It's clear as day even from here. The Pillar of Embla has fallen to the Abyss... and that undying fiend they call the \"Professor.\"",
            "nextDialogs": [
              "761010305"
            ]
          },
          "761010305": {
            "id": "761010305",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "That said, it's been quiet for now. I can only assume Miss Alia is still fighting to keep it at bay.",
            "nextDialogs": [
              "761010306"
            ]
          },
          "761010306": {
            "id": "761010306",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "She's holding the line for us, and we must make the most of this window.",
            "nextDialogs": [
              "761010307"
            ]
          },
          "761010307": {
            "id": "761010307",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "Thanks to Flins and the others, preparations are nearly complete.",
            "nextDialogs": [
              "761010308"
            ]
          },
          "761010308": {
            "id": "761010308",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "And now that you've brought back the Spiralblade, the Arrow of Terpikeraunas is finally ready.",
            "nextDialogs": [
              "761010309"
            ]
          },
          "761010309": {
            "id": "761010309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Umm... what's the \"Arrow of Terpikeraunas\"? Is it another super-powerful relic, like the Silver Lampwick and the Spiralblade?",
            "nextDialogs": [
              "761010310"
            ]
          },
          "761010310": {
            "id": "761010310",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "Haha, it surpasses them both.",
            "nextDialogs": [
              "761010311"
            ]
          },
          "761010311": {
            "id": "761010311",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "Five centuries ago, the Torchforger lacked the strength to vanquish the undying fiend, managing only to seal it beneath Kipumaki Cliff. Even so, he did not waver. Together with the first Moonchanter, they pressed on in hope of a future victory.",
            "nextDialogs": [
              "761010312"
            ]
          },
          "761010312": {
            "id": "761010312",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "They forged this bow and arrow with ancient craft, so that when the day came to end the undying fiend, it would be ready. Since then, it has been passed down through generations of Lightkeepers.",
            "nextDialogs": [
              "761010313"
            ]
          },
          "761010313": {
            "id": "761010313",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "Now, at last, the time has come for it to fulfill its destiny.",
            "nextDialogs": [
              "761010314"
            ]
          },
          "761010314": {
            "id": "761010314",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa... That sounds amazing! What does it look like? Can we see it?",
            "nextDialogs": [
              "761010315"
            ]
          },
          "761010315": {
            "id": "761010315",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "You've seen it already, silly. In fact, we're inside it.",
            "nextDialogs": [
              "761010317",
              "761010319"
            ]
          },
          "761010317": {
            "id": "761010317",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Y—You're not about to fire us off with it or something... right? Right!?",
            "nextDialogs": [
              "761010320"
            ]
          },
          "761010320": {
            "id": "761010320",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "This great mead hall was built to house the Arrow of Terpikeraunas, and the Spiralblade you retrieved is the arrowhead it had long been missing.",
            "nextDialogs": [
              "761010321"
            ]
          },
          "761010321": {
            "id": "761010321",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "Once the Spiralblade is set in place, the Arrow will be ready to fire.",
            "nextDialogs": [
              "761010322"
            ]
          },
          "761010322": {
            "id": "761010322",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This thing's a fireplace, though!",
            "nextDialogs": [
              "761010323"
            ]
          },
          "761010323": {
            "id": "761010323",
            "speakerId": 1324,
            "speakerName": "Illuga",
            "text": "Indeed it is! But it also serves as the mechanism that shapes the Spiralblade into the arrowhead.",
            "nextDialogs": [
              "761010324"
            ]
          },
          "761010324": {
            "id": "761010324",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "We need to act before the Cataclysm Egg hatches. This bow and arrow have been passed down for this moment — to end the threat once and for all!",
            "nextDialogs": [
              "761010325"
            ]
          },
          "761010325": {
            "id": "761010325",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "While you prepare the shot, that undying fiend will likely lash out one last time. Whatever comes our way, we'll stop it.",
            "nextDialogs": [
              "761010326"
            ]
          },
          "761010326": {
            "id": "761010326",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "The launching of the Arrow of Terpikeraunas is in your hands."
          },
          "761010319": {
            "id": "761010319",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#So {NICKNAME} really is our last-resort weapon! ... No, wait, that's gotta be a joke!"
          }
        }
      }
    },
    {
      "subId": "7610104",
      "subQuestName": "Load the Spiralblade",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761010401"
        ],
        "dialogs": {
          "761010401": {
            "id": "761010401",
            "speakerId": 22320,
            "speakerName": "Olav",
            "text": "Illuga! Finally! Starshyna Nikita's been looking all over for you!",
            "nextDialogs": [
              "761010402"
            ]
          },
          "761010402": {
            "id": "761010402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Starshyna... Nikita?",
            "nextDialogs": [
              "761010403"
            ]
          },
          "761010403": {
            "id": "761010403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Wait, {NICKNAME}, Nikita... isn't that the old guy we bumped into back in Piramida?",
            "nextDialogs": [
              "761010404"
            ]
          },
          "761010404": {
            "id": "761010404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Didn't he say he was just a regular Ratnik?",
            "nextDialogs": [
              "761010407"
            ]
          },
          "761010407": {
            "id": "761010407",
            "speakerId": 1324,
            "speakerName": "Illuga",
            "text": "Ah, my old pops... He probably just meant it as a bit of fun.",
            "nextDialogs": [
              "761010408"
            ]
          },
          "761010408": {
            "id": "761010408",
            "speakerId": 1324,
            "speakerName": "Illuga",
            "text": "We can talk about that later. For now, let's go update him."
          }
        }
      }
    },
    {
      "subId": "7610105",
      "subQuestName": "Load the Spiralblade",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761010501"
        ],
        "dialogs": {
          "761010501": {
            "id": "761010501",
            "speakerId": 7180,
            "speakerName": "Nikita",
            "text": "Go now. Get the sacred blade in place."
          }
        }
      }
    },
    {
      "subId": "7610106",
      "subQuestName": "Go to the plaza",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761010601"
        ],
        "dialogs": {
          "761010601": {
            "id": "761010601",
            "speakerId": 1324,
            "speakerName": "Illuga",
            "text": "I just wish Bjorn could've been here too...",
            "nextDialogs": [
              "761010602"
            ]
          },
          "761010602": {
            "id": "761010602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He would've been proud.",
            "nextDialogs": [
              "761010603"
            ]
          },
          "761010603": {
            "id": "761010603",
            "speakerId": 1324,
            "speakerName": "Illuga",
            "text": "Yeah, I'll go visit him in a few days. Let him know how things are in the city... He'd want to know."
          }
        }
      }
    },
    {
      "subId": "7610108",
      "subQuestName": "Activate the amplifier(s)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761010801"
        ],
        "dialogs": {
          "761010801": {
            "id": "761010801",
            "speakerId": 7184,
            "speakerName": "Rollon",
            "text": "#I hope the food's to your liking, {NICKNAME}.",
            "nextDialogs": [
              "761010802"
            ]
          },
          "761010802": {
            "id": "761010802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "If only we could party like this every day...",
            "nextDialogs": [
              "761010803"
            ]
          },
          "761010803": {
            "id": "761010803",
            "speakerId": 7184,
            "speakerName": "Rollon",
            "text": "Every day? That might be a bit much...",
            "nextDialogs": [
              "761010804"
            ]
          },
          "761010804": {
            "id": "761010804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm just joking!",
            "nextDialogs": [
              "761010805"
            ]
          },
          "761010805": {
            "id": "761010805",
            "speakerId": 7184,
            "speakerName": "Rollon",
            "text": "Are you? Still, I can see your point. Let's hope we get more days like this to celebrate."
          }
        }
      }
    },

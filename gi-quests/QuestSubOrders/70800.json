    {
      "subId": "7080006",
      "subQuestName": "Talk to Allan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708000601"
        ],
        "dialogs": {
          "708000601": {
            "id": "708000601",
            "speakerId": 1001,
            "speakerName": "Allan",
            "text": "I... I'm saved... Thank you so much.",
            "nextDialogs": [
              "708000602"
            ]
          },
          "708000602": {
            "id": "708000602",
            "speakerId": 1001,
            "speakerName": "Allan",
            "text": "I never thought that hunting one forest boar could get this hairy...",
            "nextDialogs": [
              "708000603"
            ]
          },
          "708000603": {
            "id": "708000603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, about the ingredients Brook wants...",
            "nextDialogs": [
              "708000604"
            ]
          },
          "708000604": {
            "id": "708000604",
            "speakerId": 1001,
            "speakerName": "Allan",
            "text": "Oh, did Brook send you? Well, I do have the fresh Raw Meat she wants with me.",
            "nextDialogs": [
              "708000605"
            ]
          },
          "708000605": {
            "id": "708000605",
            "speakerId": 1001,
            "speakerName": "Allan",
            "text": "But I got careless while pursuing the boar and alerted the nearby monsters by mistake.",
            "nextDialogs": [
              "708000606"
            ]
          },
          "708000606": {
            "id": "708000606",
            "speakerId": 1001,
            "speakerName": "Allan",
            "text": "I got what I came for, but I was also surrounded by monsters...",
            "nextDialogs": [
              "708000607"
            ]
          },
          "708000607": {
            "id": "708000607",
            "speakerId": 1001,
            "speakerName": "Allan",
            "text": "Could you deliver the meat to Brook, Traveler? I need to go into the city and get my wounds treated at the Cathedral first...",
            "nextDialogs": [
              "708000608"
            ]
          },
          "708000608": {
            "id": "708000608",
            "speakerId": 1001,
            "speakerName": "Allan",
            "text": "*sigh* Ah, Draff is going to give me an earful again, I just know it..."
          }
        }
      }
    },
    {
      "subId": "7080007",
      "subQuestName": "Return to Springvale and talk to Brook",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708000701"
        ],
        "dialogs": {
          "708000701": {
            "id": "708000701",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Ah, you're back. Have you brought the Raw Meat with you?",
            "nextDialogs": [
              "708000702"
            ]
          },
          "708000702": {
            "id": "708000702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it right here.",
            "nextDialogs": [
              "708000703"
            ]
          },
          "708000703": {
            "id": "708000703",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Hmm, let me see... It does seem very fresh indeed. I think this will do. This meat will serve as our main ingredient... Now we just need some condiment that brings out the \"taste of the wind\"...",
            "nextDialogs": [
              "708000704"
            ]
          },
          "708000704": {
            "id": "708000704",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "And when we're talking about that... We can only be speaking of \"Dandelion Seeds.\"",
            "nextDialogs": [
              "708000705"
            ]
          },
          "708000705": {
            "id": "708000705",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Could you help me gather some Dandelion Seeds, Traveler?",
            "nextDialogs": [
              "708000706"
            ]
          },
          "708000706": {
            "id": "708000706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure.",
            "nextDialogs": [
              "708000707"
            ]
          },
          "708000707": {
            "id": "708000707",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Great! I'll leave it to you then. I'm going to prepare this meat in the meantime. Once you've gathered those Dandelion Seeds, just bring them straight back to me."
          }
        }
      }
    },
    {
      "subId": "7080008",
      "subQuestName": "Give a set of Dandelion Seeds to Brook",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708000801"
        ],
        "dialogs": {
          "708000801": {
            "id": "708000801",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Do you have the Dandelion Seeds ready?"
          }
        }
      }
    },
    {
      "subId": "7080009",
      "subQuestName": "Talk to Brook",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708000901"
        ],
        "dialogs": {
          "708000901": {
            "id": "708000901",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Thank you. Everything's ready now.",
            "nextDialogs": [
              "708000902"
            ]
          },
          "708000902": {
            "id": "708000902",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Ah, right. This is for you. Please consider it my thanks for your help.",
            "nextDialogs": [
              "708000903"
            ]
          },
          "708000903": {
            "id": "708000903",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "But how should we prepare this food such that it will take up the \"taste of the wind\"?",
            "nextDialogs": [
              "708000904"
            ]
          },
          "708000904": {
            "id": "708000904",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Cooking, frying... Hmm, no, perhaps we should place the original flavor of the ingredients front and center, before scattering the Dandelion Seeds on once the dish is ready..."
          }
        }
      }
    },
    {
      "subId": "7080010",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708001001"
        ],
        "dialogs": {
          "708001001": {
            "id": "708001001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "708001002"
            ]
          },
          "708001002": {
            "id": "708001002",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "You're... Oh, I remember you. You were Xiangling's assistant, weren't you?",
            "nextDialogs": [
              "708001003"
            ]
          },
          "708001003": {
            "id": "708001003",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "The memories of our culinary duel are still fresh in my mind.",
            "nextDialogs": [
              "708001004"
            ]
          },
          "708001004": {
            "id": "708001004",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "I may have lost to her the last time, but this time, I will create a dish that has the \"taste of the wind.\" Then I'll take it and ask her for a rematch!",
            "nextDialogs": [
              "708001005"
            ]
          },
          "708001005": {
            "id": "708001005",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "I specially commissioned an adventurer to help me go to Dragonspine and obtain some Chilled Meat for this dish.",
            "nextDialogs": [
              "708001006"
            ]
          },
          "708001006": {
            "id": "708001006",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "However, that adventurer — Schuster was his name, I think — has yet to return...",
            "nextDialogs": [
              "708001007"
            ]
          },
          "708001007": {
            "id": "708001007",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "I've heard that Dragonspine is a very dangerous place. I wonder if he might have run into some trouble... Could you help me search for him?",
            "nextDialogs": [
              "708001008"
            ]
          },
          "708001008": {
            "id": "708001008",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I could do that, no problem.",
            "nextDialogs": [
              "708001009"
            ]
          },
          "708001009": {
            "id": "708001009",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Thanks for your willingness to help. Make sure to light some fires to keep warm. Dragonspine is very cold, after all."
          }
        }
      }
    },
    {
      "subId": "7080011",
      "subQuestName": "Go to Dragonspine and find Schuster",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708001101"
        ],
        "dialogs": {
          "708001101": {
            "id": "708001101",
            "speakerId": 1002,
            "speakerName": "Terrified Schuster",
            "text": "C—Cold... Why is it s—so cold...",
            "nextDialogs": [
              "708001102"
            ]
          },
          "708001102": {
            "id": "708001102",
            "speakerId": 1002,
            "speakerName": "Terrified Schuster",
            "text": "C—Can someone... Can someone help me make a fire?"
          }
        }
      }
    },
    {
      "subId": "7080012",
      "subQuestName": "Light the fire",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7080013",
      "subQuestName": "Talk to Terrified Schuster",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708001301"
        ],
        "dialogs": {
          "708001301": {
            "id": "708001301",
            "speakerId": 1002,
            "speakerName": "Terrified Schuster",
            "text": "I—I've been revived...",
            "nextDialogs": [
              "708001302"
            ]
          },
          "708001302": {
            "id": "708001302",
            "speakerId": 1002,
            "speakerName": "Terrified Schuster",
            "text": "Y—You lit the fire... Th—Thank you, good-hearted traveler... Thank you...",
            "nextDialogs": [
              "708001303"
            ]
          },
          "708001303": {
            "id": "708001303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you alright?",
            "nextDialogs": [
              "708001304"
            ]
          },
          "708001304": {
            "id": "708001304",
            "speakerId": 1002,
            "speakerName": "Terrified Schuster",
            "text": "A little warmer, that's for sure. I'll be fine... I was originally commissioned to come here to obtain some Chilled Meat...",
            "nextDialogs": [
              "708001305"
            ]
          },
          "708001305": {
            "id": "708001305",
            "speakerId": 1002,
            "speakerName": "Terrified Schuster",
            "text": "I started out trying to look for some on the outskirts of Dragonspine, but as I walked, I misplaced my tinder — and that was before I also got lost by mistake...",
            "nextDialogs": [
              "708001306"
            ]
          },
          "708001306": {
            "id": "708001306",
            "speakerId": 1002,
            "speakerName": "Terrified Schuster",
            "text": "If you hadn't arrived, I don't know what I would have done. You have my thanks.",
            "nextDialogs": [
              "708001307"
            ]
          },
          "708001307": {
            "id": "708001307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, what're you going to do about Brook's commission?",
            "nextDialogs": [
              "708001308"
            ]
          },
          "708001308": {
            "id": "708001308",
            "speakerId": 1002,
            "speakerName": "Terrified Schuster",
            "text": "Ah, so Brook sent you to find me, huh... *sigh* She must be beside herself right now, I imagine. But as it stands, I haven't the energy to travel all the way to give her this meat...",
            "nextDialogs": [
              "708001309"
            ]
          },
          "708001309": {
            "id": "708001309",
            "speakerId": 1002,
            "speakerName": "Terrified Schuster",
            "text": "I'm sorry to ask this of you, Traveler, but could you help me deliver this Chilled Meat to her?",
            "nextDialogs": [
              "708001310"
            ]
          },
          "708001310": {
            "id": "708001310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You can count on me.",
            "nextDialogs": [
              "708001311"
            ]
          },
          "708001311": {
            "id": "708001311",
            "speakerId": 1002,
            "speakerName": "Terrified Schuster",
            "text": "Thank you so much. As for me, I need to head down to that campsite in the foothills to get a bowl of hot soup..."
          }
        }
      }
    },
    {
      "subId": "7080015",
      "subQuestName": "Return to Springvale and talk to Brook",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708001501"
        ],
        "dialogs": {
          "708001501": {
            "id": "708001501",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Oh, you're back.",
            "nextDialogs": [
              "708001502"
            ]
          },
          "708001502": {
            "id": "708001502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Back with the meat, yes.",
            "nextDialogs": [
              "708001503"
            ]
          },
          "708001503": {
            "id": "708001503",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Oh, that's great! Wait... what about Schuster? He isn't in trouble, is he?",
            "nextDialogs": [
              "708001504"
            ]
          },
          "708001504": {
            "id": "708001504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No, he should be alright.",
            "nextDialogs": [
              "708001505"
            ]
          },
          "708001505": {
            "id": "708001505",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "That's good. It's good that nothing serious happened. Once I've finished this dish, I should bring him a serving too, I think.",
            "nextDialogs": [
              "708001506"
            ]
          },
          "708001506": {
            "id": "708001506",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Speaking of that, this Chilled Meat really is different from normal meat. Perhaps a dish made from it really will have that certain... boom shaka-laka...",
            "nextDialogs": [
              "708001507"
            ]
          },
          "708001507": {
            "id": "708001507",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Still, I think that Dandelion Seeds will be needed to make something that bears the \"taste of the wind.\"",
            "nextDialogs": [
              "708001508"
            ]
          },
          "708001508": {
            "id": "708001508",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "But if we only do that, I feel that the result wouldn't be much different from any normal meat-based cuisine. We need some sort of decisive condiment.",
            "nextDialogs": [
              "708001509"
            ]
          },
          "708001509": {
            "id": "708001509",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Oh right! That's it! In truth, I've actually met Xiangling a few more times since our contest, and I heard about a dish known as Mushroom Slime Stew from her.",
            "nextDialogs": [
              "708001510"
            ]
          },
          "708001510": {
            "id": "708001510",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "I've never used such strange and curious ingredients before... However, amazing dishes require equally unique ingredients.",
            "nextDialogs": [
              "708001511"
            ]
          },
          "708001511": {
            "id": "708001511",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Traveler, if I might trouble you again, could you help me look for some Slime Condensate and some Dandelion Seeds?",
            "nextDialogs": [
              "708001512"
            ]
          },
          "708001512": {
            "id": "708001512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure thing.",
            "nextDialogs": [
              "708001513"
            ]
          },
          "708001513": {
            "id": "708001513",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Great, I'm counting on you, then. I'll continue to ponder my recipe here."
          }
        }
      }
    },
    {
      "subId": "7080016",
      "subQuestName": "Give the Dandelion Seeds and Slime Condensate to Brook",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708001601"
        ],
        "dialogs": {
          "708001601": {
            "id": "708001601",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Have you gotten the Slime Condensate and Dandelion Seeds ready?"
          }
        }
      }
    },
    {
      "subId": "7080017",
      "subQuestName": "Talk to Brook",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708001701"
        ],
        "dialogs": {
          "708001701": {
            "id": "708001701",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Wonderful. Now we can truly begin. Thank you so much.",
            "nextDialogs": [
              "708001702"
            ]
          },
          "708001702": {
            "id": "708001702",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "With this Chilled Meat and these two ingredients, I will surely be able to make a dish with true boom shaka-laka!",
            "nextDialogs": [
              "708001703"
            ]
          },
          "708001703": {
            "id": "708001703",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Ah, yes, here's something. Take it as thanks for your help."
          }
        }
      }
    },
    {
      "subId": "7080018",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708001801"
        ],
        "dialogs": {
          "708001801": {
            "id": "708001801",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Why isn't he here yet..."
          }
        }
      }
    },
    {
      "subId": "7080019",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708001901"
        ],
        "dialogs": {
          "708001901": {
            "id": "708001901",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "This dish must evoke the Windblume Festival somehow..."
          }
        }
      }
    },
    {
      "subId": "7080020",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708002001"
        ],
        "dialogs": {
          "708002001": {
            "id": "708002001",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "I've heard of Chilled Meat from other chefs as well. It's said that this type of meat has a unique flavor...",
            "nextDialogs": [
              "708002002"
            ]
          },
          "708002002": {
            "id": "708002002",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "With these ingredients, I hope to make a dish that has some of that boom-shaka-laka..."
          }
        }
      }
    }
  ]
}
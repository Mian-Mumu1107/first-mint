  "subQuests": [
    {
      "subId": "7080002",
      "subQuestName": "Talk to Brook",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708000201"
        ],
        "dialogs": {
          "708000201": {
            "id": "708000201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is something wrong?",
            "nextDialogs": [
              "708000202"
            ]
          },
          "708000202": {
            "id": "708000202",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Actually, I was planning to create a new dish based on the theme of the Windblume Festival — specifically, the \"taste of the wind,\" and I'm currently preparing the necessary ingredients.",
            "nextDialogs": [
              "708000203"
            ]
          },
          "708000203": {
            "id": "708000203",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "I commissioned Allan to help me go to Brightcrown Canyon to hunt for the freshest meat, but he hasn't returned yet, even after so long...",
            "nextDialogs": [
              "708000204"
            ]
          },
          "708000204": {
            "id": "708000204",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "At this rate, my ingredients won't be fresh any longer. Could you help me go to Brightcrown Canyon to see what the situation's like?",
            "nextDialogs": [
              "708000205"
            ]
          },
          "708000205": {
            "id": "708000205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I've got you covered.",
            "nextDialogs": [
              "708000206"
            ]
          },
          "708000206": {
            "id": "708000206",
            "speakerId": 1000,
            "speakerName": "Brook",
            "text": "Thanks! I'll let you try out my new dish once you return!"
          }
        }
      }
    },
    {

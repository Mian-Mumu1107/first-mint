    {
      "subId": "800510",
      "subQuestName": "Examine what the Black Serpent Knights were protecting",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80051001"
        ],
        "dialogs": {
          "80051001": {
            "id": "80051001",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh!? What's this?",
            "nextDialogs": [
              "80051002"
            ]
          },
          "80051002": {
            "id": "80051002",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "...So the Black Serpent Knights have nothing to do with the Abyss Order's secret. Huh, I should have guessed.",
            "nextDialogs": [
              "80051003"
            ]
          },
          "80051003": {
            "id": "80051003",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So what exactly is going on with these hilichurls?",
            "nextDialogs": [
              "80051004"
            ]
          },
          "80051004": {
            "id": "80051004",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "As I said, for these hilichurls, the end is nigh.",
            "nextDialogs": [
              "80051007"
            ]
          },
          "80051007": {
            "id": "80051007",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "They have grown old and fearful of the light, even become one with the darkness. And yet the curse continues to corrode them.",
            "nextDialogs": [
              "80051008"
            ]
          },
          "80051008": {
            "id": "80051008",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But why would the Black Serpent Knights wanna stay here and guard them?",
            "nextDialogs": [
              "80051009"
            ]
          },
          "80051009": {
            "id": "80051009",
            "speakerId": 1003,
            "speakerName": "Black Serpent Knight of Old",
            "text": "!!!",
            "nextDialogs": [
              "80051010"
            ]
          },
          "80051010": {
            "id": "80051010",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Aah! More of them are closing in!",
            "nextDialogs": [
              "80051011"
            ]
          },
          "80051011": {
            "id": "80051011",
            "speakerId": 1003,
            "speakerName": "Black Serpent Knight of Old",
            "text": "!!!"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "800501",
      "subQuestName": "Investigate the ruins ahead and find a path",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80050101"
        ],
        "dialogs": {
          "80050101": {
            "id": "80050101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "There are signs of hilichurl activity here. Could these be the hilichurls the requester was talking about?",
            "nextDialogs": [
              "80050102"
            ]
          },
          "80050102": {
            "id": "80050102",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Requester? ...In fact, hold on. You still haven't told me what you're doing here. I doubt that most travelers would have any reason to venture down this way.",
            "nextDialogs": [
              "80050103"
            ]
          },
          "80050103": {
            "id": "80050103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We took a commission from the Adventurers' Guild to investigate The Chasm. Apparently, a whole load of hilichurls have been gathering here, and the requester wants to know why.",
            "nextDialogs": [
              "80050104"
            ]
          },
          "80050104": {
            "id": "80050104",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And now, it looks like we've finally found our first clue...",
            "nextDialogs": [
              "80050105"
            ]
          },
          "80050105": {
            "id": "80050105",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Do you want the answer?",
            "nextDialogs": [
              "80050106"
            ]
          },
          "80050106": {
            "id": "80050106",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? You mean, you know something about this?",
            "nextDialogs": [
              "80050107"
            ]
          },
          "80050107": {
            "id": "80050107",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "As it happens, I do.",
            "nextDialogs": [
              "80050110"
            ]
          },
          "80050110": {
            "id": "80050110",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "It's understandable that you did not perceive anything unusual. What makes this place so strange is that...",
            "nextDialogs": [
              "80050111"
            ]
          },
          "80050111": {
            "id": "80050111",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "...the environment here weakens the effect of the curse.",
            "nextDialogs": [
              "80050112"
            ]
          },
          "80050112": {
            "id": "80050112",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "The curse? Oh! Paimon remembers, last time you guys were saying that Khaenri'ah's people were cursed to immortality or something...",
            "nextDialogs": [
              "80050113"
            ]
          },
          "80050113": {
            "id": "80050113",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "For centuries, I have suffered daily from the curse that was laid upon me. But here... I suddenly feel a small amount of relief from this suffering.",
            "nextDialogs": [
              "80050114"
            ]
          },
          "80050114": {
            "id": "80050114",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "And right here, right now, I can feel my body sending a strong message to me... It is telling me, \"stay.\"",
            "nextDialogs": [
              "80050115"
            ]
          },
          "80050115": {
            "id": "80050115",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So this place weakens the curse? That's pretty incredible, but how?",
            "nextDialogs": [
              "80050116"
            ]
          },
          "80050116": {
            "id": "80050116",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "That I shall need to investigate. But to the best of my knowledge, the Abyss Order does not have the technology to achieve this."
          }
        }
      }
    },
    {
      "subId": "800502",
      "subQuestName": "Defeat the Black Serpent Knights",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "800503",
      "subQuestName": "Talk to Dainsleif",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80050301"
        ],
        "dialogs": {
          "80050301": {
            "id": "80050301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What were those? And why did they attack us all of a sudden?",
            "nextDialogs": [
              "80050302"
            ]
          },
          "80050302": {
            "id": "80050302",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Black Serpent Knights. They once belonged to the Royal Guard of Khaenri'ah.",
            "nextDialogs": [
              "80050303"
            ]
          },
          "80050303": {
            "id": "80050303",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait a second! Royal Guard? So... they used to be your troops!?",
            "nextDialogs": [
              "80050304"
            ]
          },
          "80050304": {
            "id": "80050304",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Yes, they were. But now, the curse engulfs them, and they fight with none of the honor they once had...",
            "nextDialogs": [
              "80050305"
            ]
          },
          "80050305": {
            "id": "80050305",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Because they've become pawns of the Abyss now?",
            "nextDialogs": [
              "80050306"
            ]
          },
          "80050306": {
            "id": "80050306",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "...Let's continue on.",
            "nextDialogs": [
              "80050307"
            ]
          },
          "80050307": {
            "id": "80050307",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, Dain...",
            "nextDialogs": [
              "80050308"
            ]
          },
          "80050308": {
            "id": "80050308",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Hmm?",
            "nextDialogs": [
              "80050309"
            ]
          },
          "80050309": {
            "id": "80050309",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "...",
            "nextDialogs": [
              "80050310"
            ]
          },
          "80050310": {
            "id": "80050310",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Seems we missed one...",
            "nextDialogs": [
              "80050311"
            ]
          },
          "80050311": {
            "id": "80050311",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "...",
            "nextDialogs": [
              "80050312"
            ]
          },
          "80050312": {
            "id": "80050312",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Wait, stand down. There's something different about this one...",
            "nextDialogs": [
              "80050313"
            ]
          },
          "80050313": {
            "id": "80050313",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "...It's disappeared.",
            "nextDialogs": [
              "80050314"
            ]
          },
          "80050314": {
            "id": "80050314",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What the heck? What was going on with that one? Was it trying to say something?",
            "nextDialogs": [
              "80050315"
            ]
          },
          "80050315": {
            "id": "80050315",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "(How is this possible... How could he have retained self-awareness for 500 years without... it?)",
            "nextDialogs": [
              "80050316"
            ]
          },
          "80050316": {
            "id": "80050316",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "(But more importantly, why did he seem so familiar...)",
            "nextDialogs": [
              "80050317"
            ]
          },
          "80050317": {
            "id": "80050317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe he recognized you.",
            "nextDialogs": [
              "80050318"
            ]
          },
          "80050318": {
            "id": "80050318",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "That would be a miraculous outcome indeed for a cataclysm that brought total doom and destruction... Or perhaps it was just a coincidence.",
            "nextDialogs": [
              "80050319"
            ]
          },
          "80050319": {
            "id": "80050319",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "We should press onward, to the city."
          }
        }
      }
    },
    {
      "subId": "800504",
      "subQuestName": "Go to the entrance to the ruins",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80050401"
        ],
        "dialogs": {
          "80050401": {
            "id": "80050401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Looks like there's a strange energy surrounding the city. We can't go any further.",
            "nextDialogs": [
              "80050402"
            ]
          },
          "80050402": {
            "id": "80050402",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Guess there should be a mechanism or something around here, right? Traveler, looks like it's time to get into ruin-exploring mode!",
            "nextDialogs": [
              "80050405"
            ]
          },
          "80050405": {
            "id": "80050405",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Don't waste your time.",
            "nextDialogs": [
              "80050406"
            ]
          },
          "80050406": {
            "id": "80050406",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh...!?",
            "nextDialogs": [
              "80050407"
            ]
          },
          "80050407": {
            "id": "80050407",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Khaenri'ah's technology, Abyssal power... Two things I couldn't be more familiar with. They're just cheap tricks to me.",
            "nextDialogs": [
              "80050408"
            ]
          },
          "80050408": {
            "id": "80050408",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Okay! So the Abyss Order really is trying to hide something here, right?",
            "nextDialogs": [
              "80050409"
            ]
          },
          "80050409": {
            "id": "80050409",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... Dain seems like he really understands what's going on here. No wonder the Abyss Order doesn't want him around."
          }
        }
      }
    },
    {
      "subId": "800520",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80052001"
        ],
        "dialogs": {
          "80052001": {
            "id": "80052001",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So there's no Abyss Order secrets to be found here... Just a bunch of hilichurls nearing the end of their existence.",
            "nextDialogs": [
              "80052002"
            ]
          },
          "80052002": {
            "id": "80052002",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We probably shouldn't disturb them."
          }
        }
      }
    },
    {
      "subId": "800505",
      "subQuestName": "Go to the lit room in the ruins",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80050501"
        ],
        "dialogs": {
          "80050501": {
            "id": "80050501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Aah, Black Serpent Knights!",
            "nextDialogs": [
              "80050502"
            ]
          },
          "80050502": {
            "id": "80050502",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Is this where they're based? Or wait, are they guarding something here?",
            "nextDialogs": [
              "80050503"
            ]
          },
          "80050503": {
            "id": "80050503",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "We are likely drawing near to whatever the Abyss Order is trying to hide. Let's take them out first."
          }
        }
      }
    },

        ],
        "dialogs": {
          "80052301": {
            "id": "80052301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon's never seen such well-behaved hilichurls before. Paimon wonders if it has anything to do with being an old soul."

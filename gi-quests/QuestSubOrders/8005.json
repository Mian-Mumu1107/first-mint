    },
    {
      "subId": "800599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80059901"
        ],
        "dialogs": {
          "80059901": {
            "id": "80059901",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whew, that was the last of them! Now, let's see what it was they were trying to hide.",
            "nextDialogs": [
              "80059903"
            ]
          },
          "80059903": {
            "id": "80059903",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Dain... Why so quiet?",
            "nextDialogs": [
              "80059904"
            ]
          },
          "80059904": {
            "id": "80059904",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "I'm just thinking, nothing more. If you're trying to console me, I can assure you there is no need.",
            "nextDialogs": [
              "80059905"
            ]
          },
          "80059905": {
            "id": "80059905",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmph! Fine...",
            "nextDialogs": [
              "80059906"
            ]
          },
          "80059906": {
            "id": "80059906",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey look, vines. You should be able to climb up, right?",
            "nextDialogs": [
              "80059907"
            ]
          },
          "80059907": {
            "id": "80059907",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Halfdan jumped down over there. Let's follow him."
          }
        }
      }

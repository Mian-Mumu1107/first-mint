        "startDialogs": [
          "80050801"
        ],
        "dialogs": {
          "80050801": {
            "id": "80050801",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh no, more Black Serpent Knights!",
            "nextDialogs": [
              "80050802"
            ]
          },
          "80050802": {
            "id": "80050802",
            "speakerId": 1003,
            "speakerName": "Black Serpent Knight of Old",
            "text": "!!!",
            "nextDialogs": [
              "80050803"
            ]
          },
          "80050803": {
            "id": "80050803",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh, they're not coming after us. Are they just trying to scare us off?",
            "nextDialogs": [
              "80050804"
            ]
          },
          "80050804": {
            "id": "80050804",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "These knights seem like they're hiding something behind them...",
            "nextDialogs": [
              "80050805"
            ]
          },
          "80050805": {
            "id": "80050805",
            "speakerId": 1003,
            "speakerName": "Black Serpent Knight of Old",
            "text": "!!!",
            "nextDialogs": [
              "80050806"
            ]
          },
          "80050806": {
            "id": "80050806",
            "speakerId": 1001,
            "speakerName": "Dainsleif",
            "text": "Hold on, I think they...",
            "nextDialogs": [
              "80050807"
            ]
          },
          "80050807": {
            "id": "80050807",
            "speakerId": 1003,
            "speakerName": "Black Serpent Knight of Old",
            "text": "!!!",
            "nextDialogs": [
              "80050808"
            ]
          },
          "80050808": {
            "id": "80050808",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Aah, they're coming! Quick, get them!"
          }
        }
      }
    },
    {
      "subId": "800509",

    {
      "subId": "800514",
      "subQuestName": "Go to the chamber at the center of the ruins' summit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80051401"
        ],
        "dialogs": {
          "80051401": {
            "id": "80051401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey look, there's no door sealing this room off. Looks like we can finally head to the room in the center.",
            "nextDialogs": [
              "80051402"
            ]
          },
          "80051402": {
            "id": "80051402",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "C'mon, let's go!"
          }

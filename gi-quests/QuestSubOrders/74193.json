  "subQuests": [
    {
      "subId": "7419301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741930101"
        ],
        "dialogs": {
          "741930101": {
            "id": "741930101",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "#Paimon! {NICKNAME}!",
            "nextDialogs": [
              "741930102"
            ]
          },
          "741930102": {
            "id": "741930102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, it's you, Pahsiv! Nice to see you again! What are you doing around here?",
            "nextDialogs": [
              "741930103"
            ]
          },
          "741930103": {
            "id": "741930103",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv... working! Pahsiv... tired! Pahsiv... lie down!",
            "nextDialogs": [
              "741930104"
            ]
          },
          "741930104": {
            "id": "741930104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? You're... working?",
            "nextDialogs": [
              "741930105"
            ]
          },
          "741930105": {
            "id": "741930105",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Foggy Forest Branch... Foggy Forest Branch... very throw!",
            "nextDialogs": [
              "741930106"
            ]
          },
          "741930106": {
            "id": "741930106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? What's a Foggy Forest Branch?",
            "nextDialogs": [
              "741930107"
            ]
          },
          "741930107": {
            "id": "741930107",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Foggy Forest Branch... Information!",
            "nextDialogs": [
              "741930108"
            ]
          },
          "741930108": {
            "id": "741930108",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Willow, collect. Fog, handle. Spring, send.",
            "nextDialogs": [
              "741930109"
            ]
          },
          "741930109": {
            "id": "741930109",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Foggy Forest Branch... Mist information!",
            "nextDialogs": [
              "741930110"
            ]
          },
          "741930110": {
            "id": "741930110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So you mean it's information about the Foggy Forest Path?",
            "nextDialogs": [
              "741930111"
            ]
          },
          "741930111": {
            "id": "741930111",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv!",
            "nextDialogs": [
              "741930112"
            ]
          },
          "741930112": {
            "id": "741930112",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Foggy Forest Branch... very throw! Very many places!",
            "nextDialogs": [
              "741930113"
            ]
          },
          "741930113": {
            "id": "741930113",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv... searching! Pahsiv... tired! Pahsiv... eat! Pahsiv... lie down!",
            "nextDialogs": [
              "741930114"
            ]
          },
          "741930114": {
            "id": "741930114",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Foggy Forest Branch... Very not many! But boxes, very many!",
            "nextDialogs": [
              "741930115"
            ]
          },
          "741930115": {
            "id": "741930115",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "#Ah... Thank you Paimon, thank you {NICKNAME}, here!",
            "nextDialogs": [
              "741930116"
            ]
          },
          "741930116": {
            "id": "741930116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You found us a treasure chest again?",
            "nextDialogs": [
              "741930117"
            ]
          },
          "741930117": {
            "id": "741930117",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv! Box, treasure, flower, shiny, sweet, very many!",
            "nextDialogs": [
              "741930118"
            ]
          },
          "741930118": {
            "id": "741930118",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, so there's other stuff, too? Y'know, Pahsiv, you're real nice, but it'd be bad if we kept taking your stuff for free. Why don't we exchange things instead?",
            "nextDialogs": [
              "741930119"
            ]
          },
          "741930119": {
            "id": "741930119",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Ex... change?",
            "nextDialogs": [
              "741930120"
            ]
          },
          "741930120": {
            "id": "741930120",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's right! We're friends, and friends should exchange gifts in earnest with one another!",
            "nextDialogs": [
              "741930121"
            ]
          },
          "741930121": {
            "id": "741930121",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, we're gonna help you find your Foggy Forest Branches, and exchange those for your stuff. Whaddya say?",
            "nextDialogs": [
              "741930122"
            ]
          },
          "741930122": {
            "id": "741930122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And we can get you some stuff to eat, too.",
            "nextDialogs": [
              "741930123"
            ]
          },
          "741930123": {
            "id": "741930123",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right, we can do that! You're having a hard time by yourself, after all.",
            "nextDialogs": [
              "741930124"
            ]
          },
          "741930124": {
            "id": "741930124",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Eat! Tidalga! Pahsiv!",
            "nextDialogs": [
              "741930125"
            ]
          },
          "741930125": {
            "id": "741930125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You like Tidalga?",
            "nextDialogs": [
              "741930126"
            ]
          },
          "741930126": {
            "id": "741930126",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Tidalga! Tidalga! Tidalga Tidalga Tidalga!",
            "nextDialogs": [
              "741930127"
            ]
          },
          "741930127": {
            "id": "741930127",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, does that mean you eat five meals, or five Tidalga a day? Uh... Wow, you might have Paimon beat for appetite!",
            "nextDialogs": [
              "741930128"
            ]
          },
          "741930128": {
            "id": "741930128",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, what about the Branches, then? Can we find 'em by following the Foggy Forest Path?",
            "nextDialogs": [
              "741930129"
            ]
          },
          "741930129": {
            "id": "741930129",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Melusine...",
            "nextDialogs": [
              "741930130"
            ]
          },
          "741930130": {
            "id": "741930130",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Foggy Forest Branch... very throw! Very many places! Very Erinnyes!",
            "nextDialogs": [
              "741930131"
            ]
          },
          "741930131": {
            "id": "741930131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Branches are all over Erinnyes, then?",
            "nextDialogs": [
              "741930132"
            ]
          },
          "741930132": {
            "id": "741930132",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "#Smart {NICKNAME}! Pahsiv!",
            "nextDialogs": [
              "741930133"
            ]
          },
          "741930133": {
            "id": "741930133",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Foggy Path has flowers. Branches, also flowers!",
            "nextDialogs": [
              "741930134"
            ]
          },
          "741930134": {
            "id": "741930134",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Branch, branch, branch, branch, branch, branch... Number!",
            "nextDialogs": [
              "741930135"
            ]
          },
          "741930135": {
            "id": "741930135",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh. Ooh, Paimon gets it now. The Branches can be found in places with the same flowers as the Foggy Forest Path, and there are six locations, right?",
            "nextDialogs": [
              "741930136"
            ]
          },
          "741930136": {
            "id": "741930136",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Smart Paimon! Pahsiv!",
            "nextDialogs": [
              "741930137"
            ]
          },
          "741930137": {
            "id": "741930137",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, guess we're all clear now, eh? Make sure you rest up, Pahsiv. Just leave this to us!",
            "nextDialogs": [
              "741930138"
            ]
          },
          "741930138": {
            "id": "741930138",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "#Paimon, {NICKNAME}, good thing! So, slowly, slowly! Pahsiv!"
          }
        }
      }
    },

          }
        }
      }
    },
    {
      "subId": "7419303",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741930301"
        ],
        "dialogs": {
          "741930301": {
            "id": "741930301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's nice to see you so happy, Pahsiv, but uh, what are we gonna use these for, again?",
            "nextDialogs": [
              "741930302"
            ]
          },
          "741930302": {
            "id": "741930302",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Foggy Forest Branch, very many useful! New Valet, very many useful!",
            "nextDialogs": [
              "741930303"
            ]
          },
          "741930303": {
            "id": "741930303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So this is something New Valet needs?",
            "nextDialogs": [
              "741930304"
            ]
          },
          "741930304": {
            "id": "741930304",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv! Branch... Information!",
            "nextDialogs": [
              "741930305"
            ]
          },
          "741930305": {
            "id": "741930305",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "#Ah... Thank you, Paimon, thank you, {NICKNAME}. Treasure, give!"
          }
        }
      }
    },

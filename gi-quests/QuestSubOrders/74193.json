          "741930206": {
            "id": "741930206",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "#Thanks, Paimon. Thanks, {NICKNAME}! Thanks, Tidalga!",
            "nextDialogs": [

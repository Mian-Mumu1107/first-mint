    {
      "subId": "7419305",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741930501"
        ],
        "dialogs": {
          "741930501": {
            "id": "741930501",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Boxes... Treasures... Melusine...",
            "nextDialogs": [
              "741930502"
            ]
          },
          "741930502": {
            "id": "741930502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um, Pahsiv, did we run you all outta stuff?",
            "nextDialogs": [
              "741930503"
            ]
          },
          "741930503": {
            "id": "741930503",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv... go out! Pahsiv... find!",
            "nextDialogs": [
              "741930504"
            ]
          },
          "741930504": {
            "id": "741930504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's fine if you don't have anything with you.",
            "nextDialogs": [
              "741930505"
            ]
          },
          "741930505": {
            "id": "741930505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's right. We can just give you Tidalga anyway!",
            "nextDialogs": [
              "741930506"
            ]
          },
          "741930506": {
            "id": "741930506",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Melusine!",
            "nextDialogs": [
              "741930507"
            ]
          },
          "741930507": {
            "id": "741930507",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "#Paimon, friend... earnest! {NICKNAME}, friend... earnest! So... swap!",
            "nextDialogs": [
              "741930508"
            ]
          },
          "741930508": {
            "id": "741930508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um, well, alright then. How long will you be out, Pahsiv? Are we gonna see you around?",
            "nextDialogs": [
              "741930509"
            ]
          },
          "741930509": {
            "id": "741930509",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "See... around?",
            "nextDialogs": [
              "741930510"
            ]
          },
          "741930510": {
            "id": "741930510",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, that's how we express the desire to meet again!",
            "nextDialogs": [
              "741930511"
            ]
          },
          "741930511": {
            "id": "741930511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"See you around\" is how we say goodbye.",
            "nextDialogs": [
              "741930512"
            ]
          },
          "741930512": {
            "id": "741930512",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's right. We did say previously that we'll teach you how to say goodbye, didn't we? Well, why don't you try saying it?",
            "nextDialogs": [
              "741930513"
            ]
          },
          "741930513": {
            "id": "741930513",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Good... bye?",
            "nextDialogs": [
              "741930514"
            ]
          },
          "741930514": {
            "id": "741930514",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, do you not know what that means?",
            "nextDialogs": [
              "741930515"
            ]
          },
          "741930515": {
            "id": "741930515",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Well, you can consider it a sort of exchange or swap, too. Kinda like swapping one tomorrow for another...",
            "nextDialogs": [
              "741930516"
            ]
          },
          "741930516": {
            "id": "741930516",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You take a bit of your tomorrow and give it to us, and we'll give a bit of ours to you — and that's how we'll meet again! What do you think? Get it now?",
            "nextDialogs": [
              "741930517"
            ]
          },
          "741930517": {
            "id": "741930517",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Swap tomorrow... for tomorrow! Pahsiv!",
            "nextDialogs": [
              "741930518"
            ]
          },
          "741930518": {
            "id": "741930518",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, looks like you get it! In that case, let's say \"see you around\" for now — that way, we'll definitely meet again!",
            "nextDialogs": [
              "741930519"
            ]
          },
          "741930519": {
            "id": "741930519",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "See you around! Pahsiv!",
            "nextDialogs": [
              "741930520"
            ]
          },
          "741930520": {
            "id": "741930520",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "See ya!",
            "nextDialogs": [
              "741930521"
            ]
          },
          "741930521": {
            "id": "741930521",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "#See you, {NICKNAME}! See you, Paimon!"
          }
        }
      }
    }
  ]
}
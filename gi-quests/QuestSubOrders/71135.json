        "dialogs": {
          "711350201": {
            "id": "711350201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow! What do you know? We've already collected so much adeptal energy already!",
            "nextDialogs": [
              "711350205",
              "711350204"
            ]
          },
          "711350205": {
            "id": "711350205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "According to what Fujin said before, all this adeptal energy should be used on the Votive Rainjade. That way, Qiaoying Village can reap the results next year!",
            "nextDialogs": [
              "711350206"
            ]
          },
          "711350206": {
            "id": "711350206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "When that happens, Paimon'll have Uncle Luo prepare all kinds of amazing food for her! Let Paimon think... Mmm, like teacakes, squab, braised meatball, honey char siu, oooh, and, and...",
            "nextDialogs": [
              "711350207"
            ]
          },
          "711350207": {
            "id": "711350207",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Tea brew, perhaps?",
            "nextDialogs": [
              "711350208"
            ]
          },
          "711350208": {
            "id": "711350208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh right! And Chenyu Brew, of course! Paimon's gotta write all this down... eh? Wait, who's there?",
            "nextDialogs": [
              "711350209"
            ]
          },
          "711350209": {
            "id": "711350209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "F—Fujin!?",
            "nextDialogs": [
              "711350210"
            ]
          },
          "711350210": {
            "id": "711350210",
            "speakerId": 21094,
            "speakerName": "Fujin",
            "text": "Hehe, sorry about that. I didn't scare you, did I?",
            "nextDialogs": [
              "711350211"
            ]
          },
          "711350211": {
            "id": "711350211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You can assume human form again!",
            "nextDialogs": [
              "711350212"
            ]
          },
          "711350212": {
            "id": "711350212",
            "speakerId": 21094,
            "speakerName": "Fujin",
            "text": "Yes! Did one not say that one was not seriously injured, and needed merely the briefest of rests to return to my favored form?",
            "nextDialogs": [
              "711350213"
            ]
          },
          "711350213": {
            "id": "711350213",
            "speakerId": 21094,
            "speakerName": "Fujin",
            "text": "Thank you both for gathering all that adeptal energy for the Rainjade as I rested. Next year's bountiful harvest will in no small way be thanks to your efforts."
          },
          "711350204": {
            "id": "711350204",
            "speakerId": 1005,
            "speakerName": "Paimon",

  },
  "subQuests": [
    {
      "subId": "7351101",
      "subQuestName": "Talk to the anxious researcher",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735110101"
        ],
        "dialogs": {
          "735110101": {
            "id": "735110101",
            "speakerId": 1000,
            "speakerName": "Shriya",
            "text": "That fool... running headfirst into the desert like that! Do something, Fodil, please! Give him a hand!",
            "nextDialogs": [
              "735110102"
            ]
          },
          "735110102": {
            "id": "735110102",
            "speakerId": 1001,
            "speakerName": "Fodil",
            "text": "Apologies. The garrison in the village is limited, and since we're tied up with keeping them from causing any trouble, we can't afford to spare any strength for now.",
            "nextDialogs": [
              "735110103"
            ]
          },
          "735110103": {
            "id": "735110103",
            "speakerId": 1000,
            "speakerName": "Shriya",
            "text": "But that fool has been bending over backwards to deal with them! At least, in the name of mutual interest...",
            "nextDialogs": [
              "735110104"
            ]
          },
          "735110104": {
            "id": "735110104",
            "speakerId": 1001,
            "speakerName": "Fodil",
            "text": "Well, it's not that we don't want to help. But the guards are now spread thinly across the desert on the lookout for them. Getting a team together is going to take time...",
            "nextDialogs": [
              "735110105"
            ]
          },
          "735110105": {
            "id": "735110105",
            "speakerId": 1000,
            "speakerName": "Shriya",
            "text": "How could this be... If we return to Caravan Ribat for help, it will most certainly be too late...",
            "nextDialogs": [
              "735110108"
            ]
          },
          "735110108": {
            "id": "735110108",
            "speakerId": 1000,
            "speakerName": "Shriya",
            "text": "Eh? You guys are...",
            "nextDialogs": [
              "735110109"
            ]
          },
          "735110109": {
            "id": "735110109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just another adventurer passing by.",
            "nextDialogs": [
              "735110110"
            ]
          },
          "735110110": {
            "id": "735110110",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#And {M#his}{F#her} best friend, Paimon!",
            "nextDialogs": [
              "735110111"
            ]
          },
          "735110111": {
            "id": "735110111",
            "speakerId": 1000,
            "speakerName": "Shriya",
            "text": "Adventurers? Really!? Thank the heavens! There's help for Vinayak, at last!",
            "nextDialogs": [
              "735110112"
            ]
          },
          "735110112": {
            "id": "735110112",
            "speakerId": 1000,
            "speakerName": "Shriya",
            "text": "#{M#Mr.}{F#Ms.} Adventurer! Please save Vinayak. We'll make sure to reward you handsomely!",
            "nextDialogs": [
              "735110113"
            ]
          },
          "735110113": {
            "id": "735110113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "First, tell me what's going on.",
            "nextDialogs": [
              "735110114"
            ]
          },
          "735110114": {
            "id": "735110114",
            "speakerId": 1001,
            "speakerName": "Fodil",
            "text": "Well, the desert has become more dangerous than before, thanks to those wretched vermin running amok. It's for the best that I fill you in on the situation before making plans.",
            "nextDialogs": [
              "735110115"
            ]
          },
          "735110115": {
            "id": "735110115",
            "speakerId": 1000,
            "speakerName": "Shriya",
            "text": "Eh... you guys are right. Sorry, I was a little anxious.",
            "nextDialogs": [
              "735110116"
            ]
          },
          "735110116": {
            "id": "735110116",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon's been hearing you talk about a certain \"them\" this whole time. What are they anyway?",
            "nextDialogs": [
              "735110117"
            ]
          },
          "735110117": {
            "id": "735110117",
            "speakerId": 1001,
            "speakerName": "Fodil",
            "text": "A swarm of Wenut. For some reason, they have recently become unusually violent, hiding in sandstorms to attack unsuspecting prey passing by."
          }
        }
      }
    },
    {
      "subId": "7351102",
      "subQuestName": "Look for Vinayak",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7351103",
      "subQuestName": "Talk to Vinayak",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735110301"
        ],
        "dialogs": {
          "735110301": {
            "id": "735110301",
            "speakerId": 1003,
            "speakerName": "Vinayak",
            "text": "Getting in from this angle, and using the terrain for cover... As long as the angle of sunlight isn't higher than... And my speed is no lower than... Hmm, that still isn't it!",
            "nextDialogs": [
              "735110302"
            ]
          },
          "735110302": {
            "id": "735110302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you trying to figure out?",
            "nextDialogs": [
              "735110303"
            ]
          },
          "735110303": {
            "id": "735110303",
            "speakerId": 1003,
            "speakerName": "Vinayak",
            "text": "A viable route to recover the components without having to face the monsters... Thanks to the Wenut, all my precious components got swept up by those monsters...",
            "nextDialogs": [
              "735110304"
            ]
          },
          "735110304": {
            "id": "735110304",
            "speakerId": 1003,
            "speakerName": "Vinayak",
            "text": "Whoa! Who are you? When did you show up!?",
            "nextDialogs": [
              "735110305"
            ]
          },
          "735110305": {
            "id": "735110305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I've been listening to you talk to yourself for a while now...",
            "nextDialogs": [
              "735110306"
            ]
          },
          "735110306": {
            "id": "735110306",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Relax. We're not bad guys. Your friend sent us!",
            "nextDialogs": [
              "735110307"
            ]
          },
          "735110307": {
            "id": "735110307",
            "speakerId": 1003,
            "speakerName": "Vinayak",
            "text": "Friend? Could it be Shriya? No, she clearly said she wouldn't care if I was taken by the monsters...",
            "nextDialogs": [
              "735110308"
            ]
          },
          "735110308": {
            "id": "735110308",
            "speakerId": 1003,
            "speakerName": "Vinayak",
            "text": "Ah, I see. She sent you to get the components, right?",
            "nextDialogs": [
              "735110309"
            ]
          },
          "735110309": {
            "id": "735110309",
            "speakerId": 1003,
            "speakerName": "Vinayak",
            "text": "It doesn't matter if I'm taken by the monsters, but it will definitely matter if the components aren't recovered... Yeah, that sounds like something she would say.",
            "nextDialogs": [
              "735110310"
            ]
          },
          "735110310": {
            "id": "735110310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...You could put it that way.",
            "nextDialogs": [
              "735110311"
            ]
          },
          "735110311": {
            "id": "735110311",
            "speakerId": 1003,
            "speakerName": "Vinayak",
            "text": "Still, thanks all the same. I'm racking my brain trying to figure this out. I was this close to rushing out and just taking it one step at a time.",
            "nextDialogs": [
              "735110312"
            ]
          },
          "735110312": {
            "id": "735110312",
            "speakerId": 1003,
            "speakerName": "Vinayak",
            "text": "...One wrong step, and I'll get caught by the monsters.",
            "nextDialogs": [
              "735110313"
            ]
          },
          "735110313": {
            "id": "735110313",
            "speakerId": 1003,
            "speakerName": "Vinayak",
            "text": "Eh... If I wasn't here, and with Shriya being such a klutz... who else would be going to take care of these machines!?",
            "nextDialogs": [
              "735110314"
            ]
          },
          "735110314": {
            "id": "735110314",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "No wonder Shriya was so worried... This guy thinks about nothing but his mechanical components...",
            "nextDialogs": [
              "735110315"
            ]
          },
          "735110315": {
            "id": "735110315",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, let's go and get the components before he gets himself in trouble!"
          }
        }
      }
    },
    {
      "subId": "7351105",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735110501"
        ],
        "dialogs": {
          "735110501": {
            "id": "735110501",
            "speakerId": 1000,
            "speakerName": "Shriya",
            "text": "I hope he doesn't get the hare-brained idea to dive right into the horde of monsters and start picking up components..."
          }
        }
      }
    },
    {
      "subId": "7351106",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735110601"
        ],
        "dialogs": {
          "735110601": {
            "id": "735110601",
            "speakerId": 1001,
            "speakerName": "Fodil",
            "text": "These Wenut have become very violent recently, so be extra careful."
          }
        }
      }
    }
  ]
}
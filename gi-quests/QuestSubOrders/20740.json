          "207400701"
        ],
        "dialogs": {
          "207400701": {
            "id": "207400701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, about those dandelions...",
            "nextDialogs": [
              "207400702"
            ]
          },
          "207400702": {
            "id": "207400702",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Dandelions can be found just outside Mondstadt, but I have to clean up the shop, and simply don't have time to leave...",
            "nextDialogs": [
              "207400703"
            ]
          },
          "207400703": {
            "id": "207400703",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "So please, help me gather a batch of Dandelion Seeds."
          }
        }
      }

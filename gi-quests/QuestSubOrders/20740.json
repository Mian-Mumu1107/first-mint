    {
      "subId": "2074004",
      "subQuestName": "Pick some fresh flowers",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207400401"
        ],
        "dialogs": {
          "207400401": {
            "id": "207400401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About those flowers...",
            "nextDialogs": [
              "207400402"
            ]
          },
          "207400402": {
            "id": "207400402",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Did you finish getting the flowers?",
            "nextDialogs": [
              "207400403"
            ]
          },
          "207400403": {
            "id": "207400403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got 'em right here.",
            "nextDialogs": [
              "207400404"
            ]
          },
          "207400404": {
            "id": "207400404",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "These are all so fresh... Thank you. With these flowers out at the storefront, we're sure to attract a lot of customers.",
            "nextDialogs": [
              "207400405"
            ]
          },
          "207400405": {
            "id": "207400405",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "If I could make another small request... the wind also blew all the dandelions we had away.",
            "nextDialogs": [
              "207400406"
            ]
          },
          "207400406": {
            "id": "207400406",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Although dandelions being carried away by the wind isn't a bad thing...",
            "nextDialogs": [
              "207400407"
            ]
          },
          "207400407": {
            "id": "207400407",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "But it still seem strange for a florist's in Mondstadt to not have dandelions.",
            "nextDialogs": [
              "207400408"
            ]
          },
          "207400408": {
            "id": "207400408",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Dandelions can't just be plucked and brought back — they have to be regrown from scratch.",
            "nextDialogs": [
              "207400409"
            ]
          },
          "207400409": {
            "id": "207400409",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "So could you help fetch a batch of Dandelion Seeds for me?",
            "nextDialogs": [
              "207400411",
              "207400413"
            ]
          },
          "207400411": {
            "id": "207400411",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "I'm counting on you, then. I recall that there are lots of dandelions just outside Mondstadt."
          },
          "207400413": {
            "id": "207400413",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "There are lots of dandelions outside the city. You should be able to get them easily."
          }
        }
      }
    },

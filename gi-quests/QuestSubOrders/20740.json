    {
      "subId": "2074010",
      "subQuestName": "Report back to Flora",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207400501"
        ],
        "dialogs": {
          "207400501": {
            "id": "207400501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, about those dandelions...",
            "nextDialogs": [
              "207400502"
            ]
          },
          "207400502": {
            "id": "207400502",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Have you managed to get the dandelions?",
            "nextDialogs": [
              "207400503"
            ]
          },
          "207400503": {
            "id": "207400503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I have them.",
            "nextDialogs": [
              "207400504"
            ]
          },
          "207400504": {
            "id": "207400504",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Thank you. This should be enough. I'll sow the seeds into these pots...",
            "nextDialogs": [
              "207400505"
            ]
          },
          "207400505": {
            "id": "207400505",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "...Along with those flowers that you found for me earlier.",
            "nextDialogs": [
              "207400506"
            ]
          },
          "207400506": {
            "id": "207400506",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Ah, yes. I have to thank you, don't I? This is a little token, please take it.",
            "nextDialogs": [
              "207400507"
            ]
          },
          "207400507": {
            "id": "207400507",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Now, I have to quickly put these flowers inside these pots here. Then the dandelions seeds go there..."
          }
        }
      }
    },
    {
      "subId": "2074012",
      "subQuestName": "Report back to Flora",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207400509"
        ],
        "dialogs": {
          "207400509": {
            "id": "207400509",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Oh, right. The Dandelion Seeds have only just been sown, so there's nothing in the pot... I guess I'll have to take them off display for the time being.",
            "nextDialogs": [
              "207400510"
            ]
          },
          "207400510": {
            "id": "207400510",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Ah, I really hope they grow up soon..."
          }
        }
      }
    },
    {
      "subId": "2074006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207400601"
        ],
        "dialogs": {
          "207400601": {
            "id": "207400601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About those flowers...",
            "nextDialogs": [
              "207400602"
            ]
          },
          "207400602": {
            "id": "207400602",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "You can find small lamp grass and sweet flowers in the Whispering Woods. Windrise is where you'll find windwheel asters, and you can find cecilias on Starsnatch Cliff.",
            "nextDialogs": [
              "207400603"
            ]
          },
          "207400603": {
            "id": "207400603",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "You can definitely get the freshest flowers from these areas.",
            "nextDialogs": [
              "207400604"
            ]
          },
          "207400604": {
            "id": "207400604",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Once you've finished picking them, please bring them back to me as quickly as possible."
          }
        }
      }
    },
    {
      "subId": "2074007",

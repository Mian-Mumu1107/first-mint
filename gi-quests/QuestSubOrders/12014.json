  },
  "subQuests": [
    {
      "subId": "1201401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120140101"
        ],
        "dialogs": {
          "120140101": {
            "id": "120140101",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "I think I'll stay here for a bit longer. The show is still not quite over in my heart.",
            "nextDialogs": [
              "120140102"
            ]
          },
          "120140102": {
            "id": "120140102",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Oh, but if you wanted to chat, I'll happily oblige.",
            "nextDialogs": [
              "120140104",
              "120140109",
              "120140116"
            ]
          },
          "120140104": {
            "id": "120140104",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Matsuzaka and the others are still waiting for me so we can go hunt down the Great Mujina Youkai. I'm like a big sister to them, so I can't go back on my word.",
            "nextDialogs": [
              "120140105"
            ]
          },
          "120140105": {
            "id": "120140105",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Also, I want to go and ask everyone what they thought of the fireworks.",
            "nextDialogs": [
              "120140106"
            ]
          },
          "120140106": {
            "id": "120140106",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "And over the next few days, I'd also like to thank everyone for their support.",
            "nextDialogs": [
              "120140107"
            ]
          },
          "120140107": {
            "id": "120140107",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "That includes you and Paimon, too, of course."
          },
          "120140109": {
            "id": "120140109",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "For you guys...",
            "nextDialogs": [
              "120140110"
            ]
          },
          "120140110": {
            "id": "120140110",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "I'll do it for free!",
            "nextDialogs": [
              "120140111"
            ]
          },
          "120140111": {
            "id": "120140111",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "I did kind of force it on you, after all. Not to mention that I dragged you along with me and gave you all sorts of trouble along the way. Hehe, I'd feel bad if I charged you any Mora.",
            "nextDialogs": [
              "120140112"
            ]
          },
          "120140112": {
            "id": "120140112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you sure? I feel bad...",
            "nextDialogs": [
              "120140113"
            ]
          },
          "120140113": {
            "id": "120140113",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "#It's fine. ...Look, how about we make a deal: After you find your {F#brother}{M#sister}, tell {F#him}{M#her} to come to Naganohara Fireworks for all {F#his}{M#her} fireworks needs. That way, I'll get another customer. Sound fair?",
            "nextDialogs": [
              "120140114"
            ]
          },
          "120140114": {
            "id": "120140114",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "#Also, it'd be nice to meet {F#him}{M#her}."
          },
          "120140116": {
            "id": "120140116",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "I'll kick their butts again!",
            "nextDialogs": [
              "120140117"
            ]
          },
          "120140117": {
            "id": "120140117",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "Hahaha, I'm joking. Didn't I tell you that my family deals with the Commissions quite a bit?",
            "nextDialogs": [
              "120140118"
            ]
          },
          "120140118": {
            "id": "120140118",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "We have an easy enough time of it. At the worst, we'd have to apologize, smile, and pay a fine. It wouldn't be the end of the world.",
            "nextDialogs": [
              "120140119"
            ]
          },
          "120140119": {
            "id": "120140119",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "You two should be careful, though. Without the same connections, you can't afford to be as reckless as me, hee-hee."
          }
        }
      }
    }
  ]
}
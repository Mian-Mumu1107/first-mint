          },
          "749050102": {
            "id": "749050102",
            "speakerId": 5134,
            "speakerName": "Everallin",
            "text": "To be honest, I am not sure if my understanding of the sea's depth is the same as that which human beings sense.",
            "nextDialogs": [
              "749050103"
            ]
          },
          "749050103": {
            "id": "749050103",
            "speakerId": 5134,
            "speakerName": "Everallin",
            "text": "All I know is, diving is difficult for most human beings, and requires a heavy set of clothing and a lot of training.",
            "nextDialogs": [
              "749050104"
            ]
          },
          "749050104": {
            "id": "749050104",
            "speakerId": 5134,
            "speakerName": "Everallin",
            "text": "Do you know how to dive? It's okay if you don't. I brought these from the sea, and I want to share them with you."
          }
        }

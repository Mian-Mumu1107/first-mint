  "subQuests": [
    {
      "subId": "2200401",
      "subQuestName": "Talk to Jiangxue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220040101"
        ],
        "dialogs": {
          "220040101": {
            "id": "220040101",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "I hope I catch something eventually...",
            "nextDialogs": [
              "220040102"
            ]
          },
          "220040102": {
            "id": "220040102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "220040103"
            ]
          },
          "220040103": {
            "id": "220040103",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "Preparing to reel in the biggest catch you've ever seen!",
            "nextDialogs": [
              "220040104"
            ]
          },
          "220040104": {
            "id": "220040104",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "I have a friend who enjoys cooking. If I catch a nice big fish for him, I bet it'll make him happy.",
            "nextDialogs": [
              "220040105"
            ]
          },
          "220040105": {
            "id": "220040105",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "The only thing is, monsters keep stirring up trouble here, which disturbs the fish.",
            "nextDialogs": [
              "220040106"
            ]
          },
          "220040106": {
            "id": "220040106",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "I sense strong elemental power in you. Would you be willing to deal with the monsters for me, so I can finally catch that fish?",
            "nextDialogs": [
              "220040108",
              "220040110"
            ]
          },
          "220040108": {
            "id": "220040108",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "Thank you.",
            "nextDialogs": [
              "220040112"
            ]
          },
          "220040112": {
            "id": "220040112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But how do you know when the monsters will get here?",
            "nextDialogs": [
              "220040113"
            ]
          },
          "220040113": {
            "id": "220040113",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "Seeing is believing. Look out behind you.",
            "nextDialogs": [
              "220040114"
            ]
          },
          "220040114": {
            "id": "220040114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hah! That's the oldest trick in the book—"
          },
          "220040110": {
            "id": "220040110",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "I once had a Vision, too. I don't bother using it anymore, but I can still sense elemental power when I want to.",
            "nextDialogs": [
              "220040111"
            ]
          },
          "220040111": {
            "id": "220040111",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "With the power of the elements on your side, these monsters should be a piece of cake for you."
          }
        }
      }
    },
    {
      "subId": "2200402",
      "subQuestName": "Defeat opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220040201"
        ],
        "dialogs": {
          "220040201": {
            "id": "220040201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yikes! Where did they all come from!? This just makes no sense..."
          }
        }
      }
    },
    {
      "subId": "2200403",
      "subQuestName": "Defeat opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220040301"
        ],
        "dialogs": {
          "220040301": {
            "id": "220040301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You... you got them! But Paimon didn't see you lift a finger...",
            "nextDialogs": [
              "220040302"
            ]
          },
          "220040302": {
            "id": "220040302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Who ARE you?",
            "nextDialogs": [
              "220040303"
            ]
          },
          "220040303": {
            "id": "220040303",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "Just a fisherman.",
            "nextDialogs": [
              "220040304"
            ]
          },
          "220040304": {
            "id": "220040304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hmm... This doesn't add up.",
            "nextDialogs": [
              "220040305"
            ]
          },
          "220040305": {
            "id": "220040305",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "You're right, it doesn't. Lots of things in this world don't add up.",
            "nextDialogs": [
              "220040306"
            ]
          },
          "220040306": {
            "id": "220040306",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "The chef from the inn, for example. He used to be a sword fighter, now he loves to cook. He's stony-faced but has a heart of gold.",
            "nextDialogs": [
              "220040307"
            ]
          },
          "220040307": {
            "id": "220040307",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "And the boss. She's a Mondstadter, but nobody from Mondstadt knows her.",
            "nextDialogs": [
              "220040308"
            ]
          },
          "220040308": {
            "id": "220040308",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "And... you. You don't have a Vision, yet you can still use elemental power.",
            "nextDialogs": [
              "220040309"
            ]
          },
          "220040309": {
            "id": "220040309",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "Some things don't add up, but that doesn't always mean they are to be feared.",
            "nextDialogs": [
              "220040310"
            ]
          },
          "220040310": {
            "id": "220040310",
            "speakerId": 1000,
            "speakerName": "Jiangxue",
            "text": "Take these as a token of my thanks. I want to carry on fishing now."
          }
        }
      }
    },

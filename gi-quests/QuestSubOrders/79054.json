          }
        }
      }
    },
    {
      "subId": "7905403",
      "subQuestName": "Go to the platform and take a photo of the night sky",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790540301"
        ],
        "dialogs": {
          "790540301": {
            "id": "790540301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Jeroney, we're back~! See, this is the photo! Check it out!",
            "nextDialogs": [
              "790540302"
            ]
          },
          "790540302": {
            "id": "790540302",
            "speakerId": 13249,
            "speakerName": "Jeroney",
            "text": "...Wow, it looks just like what my eyes would see.",
            "nextDialogs": [
              "790540303"
            ]
          },
          "790540303": {
            "id": "790540303",
            "speakerId": 13249,
            "speakerName": "Jeroney",
            "text": "Are you really giving me this photo?",
            "nextDialogs": [
              "790540304"
            ]
          },
          "790540304": {
            "id": "790540304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Of course, we took it just for you!",
            "nextDialogs": [
              "790540305"
            ]
          },
          "790540305": {
            "id": "790540305",
            "speakerId": 13249,
            "speakerName": "Jeroney",
            "text": "Haha, thank you... thank you so much. I never thought I'd see such amazing technology. With technology like this, maybe one day we will also be able to build a Choo-Choo Cart outside the Mirage.",
            "nextDialogs": [
              "790540306"
            ]
          },
          "790540306": {
            "id": "790540306",
            "speakerId": 13249,
            "speakerName": "Jeroney",
            "text": "What a gorgeous night sky... If only we had technology like this back then, then... then he would have been able to see this beautiful sight whenever he wanted."
          }
        }
      }
    },
    {
      "subId": "7905404",
      "subQuestName": "Report back to Jeroney",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7905404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790540401"
        ],
        "dialogs": {
          "790540401": {
            "id": "790540401",
            "speakerId": 13249,
            "speakerName": "Jeroney",
            "text": "Photos... I can't believe something so amazing exists already. Now, it's possible to keep a record of all kinds of amazing scenery...",
            "nextDialogs": [
              "790540402"
            ]
          },
          "790540402": {
            "id": "790540402",
            "speakerId": 13249,
            "speakerName": "Jeroney",
            "text": "#Well, {NICKNAME}, did you finish taking the photo? I'm really looking forward to seeing your photo of the starry sky!"
          }
        }
      }
    }
  ]
}
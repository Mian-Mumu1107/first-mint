        "dialogs": {
          "756759901": {
            "id": "756759901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Phew, we sure had tons of fun at the dance party!",
            "nextDialogs": [
              "756759902"
            ]
          },
          "756759902": {
            "id": "756759902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon wonders how everyone else is feeling..."
          }
        }
      }
    }

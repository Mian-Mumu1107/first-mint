  "subQuests": [
    {
      "subId": "7567501",
      "subQuestName": "Go to the Easybreeze Holiday Resort",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "756750101"
        ],
        "dialogs": {
          "756750101": {
            "id": "756750101",
            "speakerId": 17041,
            "speakerName": "Enghiene",
            "text": "Hey... Yah!",
            "nextDialogs": [
              "756750102"
            ]
          },
          "756750102": {
            "id": "756750102",
            "speakerId": 17041,
            "speakerName": "Enghiene",
            "text": "My head's already full of music — dance, dance!",
            "nextDialogs": [
              "756750103"
            ]
          },
          "756750103": {
            "id": "756750103",
            "speakerId": 17043,
            "speakerName": "Sedile",
            "text": "Sway, sway~",
            "nextDialogs": [
              "756750104"
            ]
          },
          "756750104": {
            "id": "756750104",
            "speakerId": 17044,
            "speakerName": "Manaia",
            "text": "So happy~",
            "nextDialogs": [
              "756750105"
            ]
          },
          "756750105": {
            "id": "756750105",
            "speakerId": 17045,
            "speakerName": "Moo",
            "text": "Krraaa!",
            "nextDialogs": [
              "756750106"
            ]
          },
          "756750106": {
            "id": "756750106",
            "speakerId": 17042,
            "speakerName": "Marine",
            "text": "Made some extra money too.",
            "nextDialogs": [
              "756750107"
            ]
          },
          "756750107": {
            "id": "756750107",
            "speakerId": 17041,
            "speakerName": "Enghiene",
            "text": "Huh? Since when?",
            "nextDialogs": [
              "756750108"
            ]
          },
          "756750108": {
            "id": "756750108",
            "speakerId": 17042,
            "speakerName": "Marine",
            "text": "Nusta was swamped, so I helped out her trainees and cleared out a few monster nests.",
            "nextDialogs": [
              "756750109"
            ]
          },
          "756750109": {
            "id": "756750109",
            "speakerId": 17042,
            "speakerName": "Marine",
            "text": "In Natlan, fighting and dancing are equally exhilarating. I like it.",
            "nextDialogs": [
              "756750110"
            ]
          },
          "756750110": {
            "id": "756750110",
            "speakerId": 31091,
            "speakerName": "Nusta",
            "text": "Thanks for that, Marine. I wanted the rookies to get more training, but they still couldn't handle that mission on their own.",
            "nextDialogs": [
              "756750111"
            ]
          },
          "756750111": {
            "id": "756750111",
            "speakerId": 31091,
            "speakerName": "Nusta",
            "text": "I'll make them train harder when we get back!",
            "nextDialogs": [
              "756750112"
            ]
          },
          "756750112": {
            "id": "756750112",
            "speakerId": 17042,
            "speakerName": "Marine",
            "text": "No need — they did great. Just didn't expect the nest to have seven times the estimated number of monsters.",
            "nextDialogs": [
              "756750113"
            ]
          },
          "756750113": {
            "id": "756750113",
            "speakerId": 17042,
            "speakerName": "Marine",
            "text": "And the Flower-Feather Clan pays pretty well. I even saved enough to get a gift for Aeval.",
            "nextDialogs": [
              "756750114"
            ]
          },
          "756750114": {
            "id": "756750114",
            "speakerId": 17041,
            "speakerName": "Enghiene",
            "text": "But your vacation's about over too, right?",
            "nextDialogs": [
              "756750115"
            ]
          },
          "756750115": {
            "id": "756750115",
            "speakerId": 17041,
            "speakerName": "Enghiene",
            "text": "A few more days, then I'll start thinking about booking the return ship.",
            "nextDialogs": [
              "756750116"
            ]
          },
          "756750116": {
            "id": "756750116",
            "speakerId": 17042,
            "speakerName": "Marine",
            "text": "No rush, we can still dance. Roxane, Letellier, Chenee, and Frejus have all been competing for jobs lately, so I won't steal their thunder.",
            "nextDialogs": [
              "756750117"
            ]
          },
          "756750117": {
            "id": "756750117",
            "speakerId": 17043,
            "speakerName": "Sedile",
            "text": "Then let's just keep dancing and keep having fun!",
            "nextDialogs": [
              "756750118"
            ]
          },
          "756750118": {
            "id": "756750118",
            "speakerId": 17044,
            "speakerName": "Manaia",
            "text": "When you're tired, eat. When you're full, sleep. No worries at all!",
            "nextDialogs": [
              "756750119"
            ]
          },
          "756750119": {
            "id": "756750119",
            "speakerId": 17045,
            "speakerName": "Moo",
            "text": "Raargh!",
            "nextDialogs": [
              "756750120"
            ]
          },
          "756750120": {
            "id": "756750120",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "The Melusines and the little Koholasaurus lined up and bounced their way toward the stage.",
            "nextDialogs": [
              "756750121"
            ]
          },
          "756750121": {
            "id": "756750121",
            "speakerId": 31091,
            "speakerName": "Nusta",
            "text": "What a lovely group of guests...",
            "nextDialogs": [
              "756750122"
            ]
          },
          "756750122": {
            "id": "756750122",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, looks like you're enjoying yourself too, Nusta.",
            "nextDialogs": [
              "756750125"
            ]
          },
          "756750125": {
            "id": "756750125",
            "speakerId": 31091,
            "speakerName": "Nusta",
            "text": "Really? Then I suppose I must attend every dance party from now on.",
            "nextDialogs": [
              "756750126"
            ]
          },
          "756750126": {
            "id": "756750126",
            "speakerId": 31091,
            "speakerName": "Nusta",
            "text": "I'll make sure those kiddos who call me \"ma'am\" or even \"auntie\"... will one day realize I'm younger than them in spirit!",
            "nextDialogs": [
              "756750127"
            ]
          },
          "756750127": {
            "id": "756750127",
            "speakerId": 31091,
            "speakerName": "Nusta",
            "text": "And I believe future dance parties should be just like this one — if anything, they should happen more often! I'm all for making it a monthly tradition!"
          }
        }
      }
    },
    {
      "subId": "7567599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

      }
    },
    {
      "subId": "1001008",
      "subQuestName": "Talk to Klee",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100100801"
        ],
        "dialogs": {
          "100100801": {
            "id": "100100801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Phew, that's that...",
            "nextDialogs": [
              "100100802"
            ]
          },
          "100100802": {
            "id": "100100802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The note implied things wouldn't be that simple. Guess it was because of those monsters.",
            "nextDialogs": [
              "100100803"
            ]
          },
          "100100803": {
            "id": "100100803",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "But that means... We passed the trial!",
            "nextDialogs": [
              "100100804"
            ]
          },
          "100100804": {
            "id": "100100804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, yep! Now then, let's check out what's in this box...",
            "nextDialogs": [
              "100100805"
            ]
          },
          "100100805": {
            "id": "100100805",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Oh, it's...",
            "nextDialogs": [
              "100100806"
            ]
          },
          "100100806": {
            "id": "100100806",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A tiny hat?",
            "nextDialogs": [
              "100100807"
            ]
          },
          "100100807": {
            "id": "100100807",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "A hat for Dodoco!",
            "nextDialogs": [
              "100100808"
            ]
          },
          "100100808": {
            "id": "100100808",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "In the Dodo Clan, only the awesomest and bestest Dodocos in the land can earn the acknowledgment of the Dodo-King!",
            "nextDialogs": [
              "100100809"
            ]
          },
          "100100809": {
            "id": "100100809",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Their job is to help out and protect all the other Dodocos, so the Dodo-King gives them a special hat.",
            "nextDialogs": [
              "100100810"
            ]
          },
          "100100810": {
            "id": "100100810",
            "speakerId": 10090,

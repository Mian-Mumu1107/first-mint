  "subQuests": [
    {
      "subId": "1001001",
      "subQuestName": "Go to the Knights of Favonius Headquarters",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100100101"
        ],
        "dialogs": {
          "100100101": {
            "id": "100100101",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Hmm... Dodoco...",
            "nextDialogs": [
              "100100102"
            ]
          },
          "100100102": {
            "id": "100100102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey there, Klee!",
            "nextDialogs": [
              "100100103"
            ]
          },
          "100100103": {
            "id": "100100103",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "#{M#Mr.}{F#Miss} Honorary Knight! Paimon!",
            "nextDialogs": [
              "100100104"
            ]
          },
          "100100104": {
            "id": "100100104",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Dodoco needs help! Mom said you were coming, but I didn't know it'd be so soon!",
            "nextDialogs": [
              "100100105"
            ]
          },
          "100100105": {
            "id": "100100105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Dodoco... needs help?",
            "nextDialogs": [
              "100100106"
            ]
          },
          "100100106": {
            "id": "100100106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, for Pete's sake... Is that the task?",
            "nextDialogs": [
              "100100107"
            ]
          },
          "100100107": {
            "id": "100100107",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "What? No, for Klee's sake! And for Dodoco, too!",
            "nextDialogs": [
              "100100108"
            ]
          },
          "100100108": {
            "id": "100100108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No, Paimon knows that. She was asking about the task. You know what that is, right? It's like a...",
            "nextDialogs": [
              "100100110",
              "100100114"
            ]
          },
          "100100110": {
            "id": "100100110",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "?",
            "nextDialogs": [
              "100100111"
            ]
          },
          "100100111": {
            "id": "100100111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Thank you, Honorary Knight of Fav-Obvious.",
            "nextDialogs": [
              "100100112"
            ]
          },
          "100100112": {
            "id": "100100112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, um... A task is... Gah, why is it so hard to describe!? It's like... helping Dodoco! Yeah! That's a task!",
            "nextDialogs": [
              "100100119"
            ]
          },
          "100100119": {
            "id": "100100119",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Oh! Thanks, Paimon. That kinda makes more sense, although not really.",
            "nextDialogs": [
              "100100120"
            ]
          },
          "100100120": {
            "id": "100100120",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Anyway, let's go help Dodoco now!",
            "nextDialogs": [
              "100100121"
            ]
          },
          "100100121": {
            "id": "100100121",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hold on. What kind of help does Dodoco need?",
            "nextDialogs": [
              "100100122"
            ]
          },
          "100100122": {
            "id": "100100122",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Oh, right. Well, every Dodoco's gotta find a red four-leaf clover to become a super special Dodoco.",
            "nextDialogs": [
              "100100123"
            ]
          },
          "100100123": {
            "id": "100100123",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Then, Dodoco needs to become friends with lots of people and can make it through the Dodo-King's trial. Once that's done, she can then become a super awesome...",
            "nextDialogs": [
              "100100124"
            ]
          },
          "100100124": {
            "id": "100100124",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Dodo-Sorcerer!",
            "nextDialogs": [
              "100100125"
            ]
          },
          "100100125": {
            "id": "100100125",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "...That's what Mom said, anyway.",
            "nextDialogs": [
              "100100126"
            ]
          },
          "100100126": {
            "id": "100100126",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, a Dodo-King being in charge of a Dodo-Sorcerer... Makes sense, actually.",
            "nextDialogs": [
              "100100127"
            ]
          },
          "100100127": {
            "id": "100100127",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um, but specifically, what do we need to do?",
            "nextDialogs": [
              "100100128"
            ]
          },
          "100100128": {
            "id": "100100128",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "No idea.",
            "nextDialogs": [
              "100100129"
            ]
          },
          "100100129": {
            "id": "100100129",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "But Mom said that you two would tell me.",
            "nextDialogs": [
              "100100130"
            ]
          },
          "100100130": {
            "id": "100100130",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "R—Right... Well, let's have a look at this book then...",
            "nextDialogs": [
              "100100131"
            ]
          },
          "100100131": {
            "id": "100100131",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Oh! There's a note inside it!",
            "nextDialogs": [
              "100100132"
            ]
          },
          "100100132": {
            "id": "100100132",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, let's see what it says...",
            "nextDialogs": [
              "100100133"
            ]
          },
          "100100133": {
            "id": "100100133",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...At the first stage of the trial, Dodoco arrived in a forest of whispering leaves. There, past layer upon layer of hurdles, a secret lay buried, waiting to be uncovered...",
            "nextDialogs": [
              "100100134"
            ]
          },
          "100100134": {
            "id": "100100134",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems like part of a story about Dodoco...",
            "nextDialogs": [
              "100100135"
            ]
          },
          "100100135": {
            "id": "100100135",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Oh, I know where that forest is! It's where I go to blast— Ahem, where I go to play a lot!",
            "nextDialogs": [
              "100100136"
            ]
          },
          "100100136": {
            "id": "100100136",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "C'mon, everyone! Follow me!",
            "nextDialogs": [
              "100100137"
            ]
          },
          "100100137": {
            "id": "100100137",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright, let's go!"
          },
          "100100114": {
            "id": "100100114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, something that needs doing!",
            "nextDialogs": [
              "100100115"
            ]
          },
          "100100115": {
            "id": "100100115",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Oh! So, like... when I go blast-fishing with Jumpy Dumpty?",
            "nextDialogs": [
              "100100116"
            ]
          },
          "100100116": {
            "id": "100100116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No, no! A \"task\" isn't just something you wanna do!",
            "nextDialogs": [
              "100100117"
            ]
          },
          "100100117": {
            "id": "100100117",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "I'm confused...",
            "nextDialogs": [
              "100100118"
            ]
          },
          "100100118": {
            "id": "100100118",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*sigh* It's like... When your mom tells you to do something! That's a \"task\"!"
          }
        }
      }
    },
    {
      "subId": "1001003",
      "subQuestName": "Go to the Whispering Woods",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100100301"
        ],
        "dialogs": {
          "100100301": {
            "id": "100100301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's with all the weird stuff around here? And why are there so many Hilichurls?",
            "nextDialogs": [
              "100100302"
            ]
          },
          "100100302": {
            "id": "100100302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, maybe the Hilichurls brought it all here?",
            "nextDialogs": [
              "100100303"
            ]
          },
          "100100303": {
            "id": "100100303",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Ohhhh, I bet this is where we find the turtles!",
            "nextDialogs": [
              "100100304"
            ]
          },
          "100100304": {
            "id": "100100304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Close, but the note said \"hurdles,\" not \"turtles.\"",
            "nextDialogs": [
              "100100305"
            ]
          },
          "100100305": {
            "id": "100100305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And whatever we're looking for is supposed to be buried past all \"the hurdles\"... Huh, are there any other clues around?",
            "nextDialogs": [
              "100100306"
            ]
          },
          "100100306": {
            "id": "100100306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is there no Dodo-device that can help us out here?",
            "nextDialogs": [
              "100100307"
            ]
          },
          "100100307": {
            "id": "100100307",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Uh... nope.",
            "nextDialogs": [
              "100100308"
            ]
          },
          "100100308": {
            "id": "100100308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What should we do, then?",
            "nextDialogs": [
              "100100309"
            ]
          },
          "100100309": {
            "id": "100100309",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Hmm... Mom says the best thing to do when you run into a problem is to try and fix it!",
            "nextDialogs": [
              "100100310"
            ]
          },
          "100100310": {
            "id": "100100310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Then let us be rid of these hurdles.",
            "nextDialogs": [
              "100100311"
            ]
          },
          "100100311": {
            "id": "100100311",
            "speakerId": 10090,
            "speakerName": "Klee",
            "text": "Yeah!"
          }
        }
      }
    },
    {
      "subId": "1001002",

        ],
        "dialogs": {
          "4800303": {
            "id": "4800303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's try this again.",
            "nextDialogs": [
              "4800304"
            ]
          },
          "4800304": {
            "id": "4800304",

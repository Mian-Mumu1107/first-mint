          "4800401"
        ],
        "dialogs": {
          "4800401": {
            "id": "4800401",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "You nailed it! But it's no surprise, given the way you handle your glider in a storm.",
            "nextDialogs": [
              "4800402"
            ]
          },
          "4800402": {
            "id": "4800402",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "The next part of the exam is in Mondstadt. See you there, don't keep me waiting!"
          }
        }
      }
    },
    {
      "subId": "48003",
      "subQuestName": "Follow Amber's instructions and take the exam again",
      "sceneId": null,

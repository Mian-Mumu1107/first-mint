    {
      "subId": "7614305",
      "subQuestName": "Open the way to the moon's core",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761430501"
        ],
        "dialogs": {
          "761430501": {
            "id": "761430501",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "We're back.",
            "nextDialogs": [
              "761430502"
            ]
          },
          "761430502": {
            "id": "761430502",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, Columbina! Looks like things went just dandy for you two at the moon's core, huh?",
            "nextDialogs": [
              "761430503"
            ]
          },
          "761430503": {
            "id": "761430503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We did indeed learn a lot.",
            "nextDialogs": [
              "761430504"
            ]
          },
          "761430504": {
            "id": "761430504",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh? So you know where Eggie came from, and what Project Moongazer's all about?",
            "nextDialogs": [
              "761430505"
            ]
          },
          "761430505": {
            "id": "761430505",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Yes, and the key to unlock the Moongazer module — it's all right here.",
            "nextDialogs": [
              "761430506"
            ]
          },
          "761430506": {
            "id": "761430506",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "I'll hand it over to you now, Ninnin.",
            "nextDialogs": [
              "761430507"
            ]
          },
          "761430507": {
            "id": "761430507",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Once you've read the information here, you'll know what your mission is.",
            "nextDialogs": [
              "761430508"
            ]
          },
          "761430508": {
            "id": "761430508",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "Thank you! I have been waiting for this moment.",
            "nextDialogs": [
              "761430509"
            ]
          },
          "761430509": {
            "id": "761430509",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "...",
            "nextDialogs": [
              "761430510"
            ]
          },
          "761430510": {
            "id": "761430510",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Columbina? {NICKNAME}? Why do you two look so serious?",
            "nextDialogs": [
              "761430511"
            ]
          },
          "761430511": {
            "id": "761430511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Because her mission involves unknown risks.",
            "nextDialogs": [
              "761430512"
            ]
          },
          "761430512": {
            "id": "761430512",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "What kind of risks?",
            "nextDialogs": [
              "761430513"
            ]
          },
          "761430513": {
            "id": "761430513",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "You'll find out by the time you're done reading.",
            "nextDialogs": [
              "761430514"
            ]
          },
          "761430514": {
            "id": "761430514",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "...",
            "nextDialogs": [
              "761430515"
            ]
          },
          "761430515": {
            "id": "761430515",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon's a little confused... What exactly is Eggie's mission?",
            "nextDialogs": [
              "761430516"
            ]
          },
          "761430516": {
            "id": "761430516",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "As Eggie reads the information, you tell Paimon everything.",
            "nextDialogs": [
              "761430517"
            ]
          },
          "761430517": {
            "id": "761430517",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Sending a message into the starry sky? So that's what Project Moongazer's all about...",
            "nextDialogs": [
              "761430518"
            ]
          },
          "761430518": {
            "id": "761430518",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So the risk is... we could expose Teyvat? Are you serious? This... Ugh, this is a tough call...",
            "nextDialogs": [
              "761430519"
            ]
          },
          "761430519": {
            "id": "761430519",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Eggie... are you alright?",
            "nextDialogs": [
              "761430520"
            ]
          },
          "761430520": {
            "id": "761430520",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "...",
            "nextDialogs": [
              "761430521"
            ]
          },
          "761430521": {
            "id": "761430521",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hey, don't be sad! We can still talk this over, right?",
            "nextDialogs": [
              "761430522"
            ]
          },
          "761430522": {
            "id": "761430522",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Remember those snacks? We can split 'em fifty-fifty, no problem!",
            "nextDialogs": [
              "761430523"
            ]
          },
          "761430523": {
            "id": "761430523",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "No, I'm not sad.",
            "nextDialogs": [
              "761430524"
            ]
          },
          "761430524": {
            "id": "761430524",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "But you're crying!",
            "nextDialogs": [
              "761430525"
            ]
          },
          "761430525": {
            "id": "761430525",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "I'm not sad. And I'm not crying. This is just... just...",
            "nextDialogs": [
              "761430526"
            ]
          },
          "761430526": {
            "id": "761430526",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "A toast to those who came before.",
            "nextDialogs": [
              "761430527"
            ]
          },
          "761430527": {
            "id": "761430527",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "#Columbina, {NICKNAME}, Paimon. Thank you.",
            "nextDialogs": [
              "761430528"
            ]
          },
          "761430528": {
            "id": "761430528",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "You're my friends. I don't want to make things difficult for you, so I'm willing to... give up on my mission.",
            "nextDialogs": [
              "761430529"
            ]
          },
          "761430529": {
            "id": "761430529",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Eggie...",
            "nextDialogs": [
              "761430530"
            ]
          },
          "761430530": {
            "id": "761430530",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "It's okay, Paimon. I'm not the first to have executed this plan.",
            "nextDialogs": [
              "761430531"
            ]
          },
          "761430531": {
            "id": "761430531",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "My predecessors have long since sent our voices out into the stars.",
            "nextDialogs": [
              "761430532"
            ]
          },
          "761430532": {
            "id": "761430532",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "Those voices, so filled with courage, must have traveled to the farthest reaches of the starry skies by now.",
            "nextDialogs": [
              "761430533"
            ]
          },
          "761430533": {
            "id": "761430533",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "As long as those voices endure, silence cannot reign across the universe, and that is enough.",
            "nextDialogs": [
              "761430534"
            ]
          },
          "761430534": {
            "id": "761430534",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "#{NICKNAME}... have you made up your mind?",
            "nextDialogs": [
              "761430536",
              "761430547"
            ]
          },
          "761430536": {
            "id": "761430536",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "I agree.",
            "nextDialogs": [
              "761430537"
            ]
          },
          "761430537": {
            "id": "761430537",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "Y—You really think so?",
            "nextDialogs": [
              "761430538"
            ]
          },
          "761430538": {
            "id": "761430538",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Can we really take that risk?",
            "nextDialogs": [
              "761430539"
            ]
          },
          "761430539": {
            "id": "761430539",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Moongazer has already been executed many times.",
            "nextDialogs": [
              "761430540"
            ]
          },
          "761430540": {
            "id": "761430540",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "The false sky used to conceal Teyvat has also been opened more than once.",
            "nextDialogs": [
              "761430541"
            ]
          },
          "761430541": {
            "id": "761430541",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "The Frost Moon has existed outside the false sky for thousands of years. Yet even now, there are no traces of Abyssal corruption here.",
            "nextDialogs": [
              "761430542"
            ]
          },
          "761430542": {
            "id": "761430542",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh? You mean this might not be as dangerous as we thought?",
            "nextDialogs": [
              "761430543"
            ]
          },
          "761430543": {
            "id": "761430543",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "There are many possibilities. Perhaps the Abyss isn't constantly watching this place, or perhaps the great ruler of the firmament has taken other measures...",
            "nextDialogs": [
              "761430544"
            ]
          },
          "761430544": {
            "id": "761430544",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "And to minimize risks, I will also use my power as the Moon Goddess to shield any message that Ninnin might send.",
            "nextDialogs": [
              "761430545"
            ]
          },
          "761430545": {
            "id": "761430545",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Huh? What does that mean?",
            "nextDialogs": [
              "761430549"
            ]
          },
          "761430549": {
            "id": "761430549",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Kuuvahki and the ancient moon's energy are both, in essence, the power of the Light Realm. As such, I can infuse my power into the transmitted messages.",
            "nextDialogs": [
              "761430550"
            ]
          },
          "761430550": {
            "id": "761430550",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Once the data passes through the false sky, I can also use that same power to monitor the surrounding area.",
            "nextDialogs": [
              "761430551"
            ]
          },
          "761430551": {
            "id": "761430551",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "If there's danger, I can erase the information. That way, we won't be discovered.",
            "nextDialogs": [
              "761430552"
            ]
          },
          "761430552": {
            "id": "761430552",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh? That sounds great! But... can you maintain your power the whole time?",
            "nextDialogs": [
              "761430553"
            ]
          },
          "761430553": {
            "id": "761430553",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Well, my strength does have limits. I can only keep it going up to a certain distance.",
            "nextDialogs": [
              "761430554"
            ]
          },
          "761430554": {
            "id": "761430554",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "I will try to shield the message as far as possible. At that point, its source will not be so easily traced.",
            "nextDialogs": [
              "761430555"
            ]
          },
          "761430555": {
            "id": "761430555",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That sounds more feasible.",
            "nextDialogs": [
              "761430556"
            ]
          },
          "761430556": {
            "id": "761430556",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "But... will this hurt you?",
            "nextDialogs": [
              "761430557"
            ]
          },
          "761430557": {
            "id": "761430557",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Don't worry. We have the support of an entire moon here, you know.",
            "nextDialogs": [
              "761430558"
            ]
          },
          "761430558": {
            "id": "761430558",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So, are you ready, Eggie? Once you've made up your mind, there'll be no turning back!",
            "nextDialogs": [
              "761430559"
            ]
          },
          "761430559": {
            "id": "761430559",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "...Can I ask one more question?",
            "nextDialogs": [
              "761430560"
            ]
          },
          "761430560": {
            "id": "761430560",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Yes?",
            "nextDialogs": [
              "761430561"
            ]
          },
          "761430561": {
            "id": "761430561",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "Why would you do all this for me?",
            "nextDialogs": [
              "761430562"
            ]
          },
          "761430562": {
            "id": "761430562",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Because we're friends.",
            "nextDialogs": [
              "761430563"
            ]
          },
          "761430563": {
            "id": "761430563",
            "speakerId": 1003,
            "speakerName": "Eggie",
            "text": "That's it?",
            "nextDialogs": [
              "761430564"
            ]
          },
          "761430564": {
            "id": "761430564",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Yes. That's all the reason I need."
          },
          "761430547": {
            "id": "761430547",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "And what if I could use my power as the Moon Goddess to shield the messages that Ninnin sends?",
            "nextDialogs": [
              "761430548"
            ]
          },
          "761430548": {
            "id": "761430548",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What does that mean?"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7614312",
      "subQuestName": "Take the plunge into Moonheart Chasm",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761431201"
        ],
        "dialogs": {
          "761431201": {
            "id": "761431201",
            "speakerId": 1000,
            "speakerName": "Terminal",
            "text": "...Unable to... accurately pinpoint your coordinates... I cannot know how long... this reply reaches you...",
            "nextDialogs": [
              "761431202"
            ]
          },
          "761431202": {
            "id": "761431202",
            "speakerId": 1000,
            "speakerName": "Terminal",
            "text": "...But I'd like to... respond... at this very moment...",
            "nextDialogs": [
              "761431203"
            ]
          },
          "761431203": {
            "id": "761431203",
            "speakerId": 1000,
            "speakerName": "Terminal",
            "text": "...We are travelers... who have traversed the universe alone for a long time... and your voices... it is as if a bonfire has suddenly lit up a dark forest...",
            "nextDialogs": [
              "761431204"
            ]
          },
          "761431204": {
            "id": "761431204",
            "speakerId": 1000,
            "speakerName": "Terminal",
            "text": "...You take great risks... yet you are fearless... You inspire us and warm our hearts...",
            "nextDialogs": [
              "761431205"
            ]
          },
          "761431205": {
            "id": "761431205",
            "speakerId": 1000,
            "speakerName": "Terminal",
            "text": "...I believe... in this moment... it is the gravity of the starry sea and destiny... that connects you and me...",
            "nextDialogs": [
              "761431206"
            ]
          },
          "761431206": {
            "id": "761431206",
            "speakerId": 1000,
            "speakerName": "Terminal",
            "text": "...In the future... we will try... to find your... planet... but not now, unfortunately... We're still dealing with... some trouble...",
            "nextDialogs": [
              "761431207"
            ]
          },
          "761431207": {
            "id": "761431207",
            "speakerId": 1000,
            "speakerName": "Terminal",
            "text": "(...A burst of signal static...)",
            "nextDialogs": [
              "761431208"
            ]
          },
          "761431208": {
            "id": "761431208",
            "speakerId": 1000,
            "speakerName": "Terminal",
            "text": "#{M#...Aether! Are you ready?}{F#...Lumine, how're we doing?}",
            "nextDialogs": [
              "761431209"
            ]
          },
          "761431209": {
            "id": "761431209",
            "speakerId": 1000,
            "speakerName": "Terminal",
            "text": "#{M#...One moment, Lumine...}{F#...Almost ready, Aether...}",
            "nextDialogs": [
              "761431210"
            ]
          },
          "761431210": {
            "id": "761431210",
            "speakerId": 1000,
            "speakerName": "Terminal",
            "text": "(...A burst of signal static...)",
            "nextDialogs": [
              "761431211"
            ]
          },
          "761431211": {
            "id": "761431211",
            "speakerId": 1000,
            "speakerName": "Terminal",
            "text": "...Well then... My regards to you...",
            "nextDialogs": [
              "761431212"
            ]
          },
          "761431212": {
            "id": "761431212",
            "speakerId": 1000,
            "speakerName": "Terminal",
            "text": "...Just as you said, the sea of stars is vast and boundless, and we are not alone...",
            "nextDialogs": [
              "761431213"
            ]
          },
          "761431213": {
            "id": "761431213",
            "speakerId": 1000,
            "speakerName": "Terminal",
            "text": "...Let us meet again beneath the starry skies..."
          }
        }
      }
    },
    {
      "subId": "7614302",
      "subQuestName": "Pass through the launch silo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761430201"
        ],
        "dialogs": {
          "761430201": {
            "id": "761430201",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "We made it down.",
            "nextDialogs": [
              "761430202"
            ]
          },
          "761430202": {
            "id": "761430202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is this the moon's core?",
            "nextDialogs": [
              "761430203"
            ]
          },
          "761430203": {
            "id": "761430203",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "No, that's still up ahead. With you coming along, we'll have to enter it the normal way.",
            "nextDialogs": [
              "761430204"
            ]
          },
          "761430204": {
            "id": "761430204",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "As for this place... it is the masterpiece of that Dragon Lord of Darkness",
            "nextDialogs": [
              "761430205"
            ]
          },
          "761430205": {
            "id": "761430205",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "He reforged the moon into a terrifying weapon, and this is its launch silo.",
            "nextDialogs": [
              "761430206"
            ]
          },
          "761430206": {
            "id": "761430206",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "The lunar core, the source of the moon's power, became artillery fire aimed at Teyvat.",
            "nextDialogs": [
              "761430207"
            ]
          },
          "761430207": {
            "id": "761430207",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "However, that primordial ruler ultimately met defeat at the hands of the Heavenly Principles. This place is no longer a threat.",
            "nextDialogs": [
              "761430208"
            ]
          },
          "761430208": {
            "id": "761430208",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Let's continue on."
          }
        }
      }
    },
    {
      "subId": "7614303",
      "subQuestName": "Advance down the correct path",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761430301"
        ],
        "dialogs": {
          "761430301": {
            "id": "761430301",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Beneath this door is where we need to go.",
            "nextDialogs": [
              "761430302"
            ]
          },
          "761430302": {
            "id": "761430302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Looks like we'll need a key to open it.",
            "nextDialogs": [
              "761430303"
            ]
          },
          "761430303": {
            "id": "761430303",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "You already have it with you.",
            "nextDialogs": [
              "761430304"
            ]
          },
          "761430304": {
            "id": "761430304",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "This is Lusalim's final facility — the one before was the Lunar Veil Laboratory, which is now the lunar sea.",
            "nextDialogs": [
              "761430305"
            ]
          },
          "761430305": {
            "id": "761430305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You mean the Ancient Moon's Fount?",
            "nextDialogs": [
              "761430306"
            ]
          },
          "761430306": {
            "id": "761430306",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "That's the one.",
            "nextDialogs": [
              "761430307"
            ]
          },
          "761430307": {
            "id": "761430307",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Hmm? Has the system detected us?",
            "nextDialogs": [
              "761430308"
            ]
          },
          "761430308": {
            "id": "761430308",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Regardless, they can do nothing to stop us."
          }
        }
      }
    },
    {
      "subId": "7614304",
      "subQuestName": "Advance down the correct path",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761430401"
        ],
        "dialogs": {
          "761430401": {
            "id": "761430401",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Maagees has already picked Paimon and Ninnin up and is heading back. We can get going once you're ready.",
            "nextDialogs": [
              "761430403",
              "761430405"
            ]
          },
          "761430403": {
            "id": "761430403",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Then let's go."
          },
          "761430405": {
            "id": "761430405",
            "speakerId": 1001,
            "speakerName": "Columbina",
            "text": "Alright. Still, we shouldn't delay for too long."
          }
        }
      }
    },

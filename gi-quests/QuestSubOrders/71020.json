        }
      }
    },
    {
      "subId": "7102010",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710201501"
        ],
        "dialogs": {
          "710201501": {
            "id": "710201501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just go and explain the situation...",
            "nextDialogs": [
              "710201502"
            ]
          },
          "710201502": {
            "id": "710201502",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "But I still have some time, I should just work harder to finish these reports..."
          }
        }
      }
    },
    {
      "subId": "7102011",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710201601"
        ],
        "dialogs": {

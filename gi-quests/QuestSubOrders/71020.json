    {
      "subId": "7102002",
      "subQuestName": "Give the invoice to Jiangzhou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710205001"
        ],
        "dialogs": {
          "710205001": {
            "id": "710205001",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "Okay then... With a bit more time, I'll touch up the plan and fix some minor issues.",
            "nextDialogs": [
              "710205002"
            ]
          },
          "710205002": {
            "id": "710205002",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "I'll submit it when I'm done touching it up.",
            "nextDialogs": [
              "710205003"
            ]
          },
          "710205003": {
            "id": "710205003",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "I hope everyone really enjoys this year's Lantern Rite..."
          }
        }
      }
    },
    {
      "subId": "7102016",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710204001"
        ],
        "dialogs": {
          "710204001": {
            "id": "710204001",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "No, that's not quite right either...",
            "nextDialogs": [
              "710204002"
            ]
          },
          "710204002": {
            "id": "710204002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Clerk Zhao told me to give this to you...",
            "nextDialogs": [
              "710204003"
            ]
          },
          "710204003": {
            "id": "710204003",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "Hmm? About the plans for Lantern Rite...",
            "nextDialogs": [
              "710204004"
            ]
          },
          "710204004": {
            "id": "710204004",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "Ah, I'm writing that right now. But it feels like it's missing something, so I keep editing it.",
            "nextDialogs": [
              "710204005"
            ]
          },
          "710204005": {
            "id": "710204005",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "Everybody needs to do their very best for a big festival like Lantern Rite. So... I can't submit this plan just yet."
          }
        }
      }
    },
    {
      "subId": "7102017",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710204101"
        ],
        "dialogs": {
          "710204101": {
            "id": "710204101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're running out of time...",
            "nextDialogs": [
              "710204102"
            ]
          },
          "710204102": {
            "id": "710204102",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "I know I can come up with the best plan, I just need a bit more time..."
          }
        }
      }
    },
    {
      "subId": "7102018",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710204201"
        ],
        "dialogs": {
          "710204201": {
            "id": "710204201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just submit it now.",

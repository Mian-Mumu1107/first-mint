            "id": "710201401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's no time...",
            "nextDialogs": [
              "710201402"
            ]
          },
          "710201402": {
            "id": "710201402",
            "speakerId": 1000,
            "speakerName": "Nervous An",

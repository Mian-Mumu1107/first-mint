      }
    },
    {
      "subId": "7102022",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710204601"
        ],
        "dialogs": {
          "710204601": {
            "id": "710204601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Submit it first, you can change more later.",
            "nextDialogs": [
              "710204602"
            ]
          },
          "710204602": {
            "id": "710204602",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "Are you joking? Lantern Rite is a serious festival, there are procedures."
          }
        }
      }
    },
    {
      "subId": "7102023",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710204701"
        ],
        "dialogs": {
          "710204701": {
            "id": "710204701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Get ideas from last year's plan...",
            "nextDialogs": [
              "710204702"
            ]
          },
          "710204702": {
            "id": "710204702",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "I've already been looking at last year's Lantern Rite. But... even though it was very popular among residents, I still think I can come up with something really special."
          }
        }
      }
    },
    {
      "subId": "7102024",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710204801"
        ],
        "dialogs": {
          "710204801": {
            "id": "710204801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Be confident...",
            "nextDialogs": [
              "710204802"
            ]
          },
          "710204802": {
            "id": "710204802",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "What good is confidence if the people of Liyue don't like it?"
          }
        }
      }
    },
    {
      "subId": "7102025",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710204901"
        ],
        "dialogs": {
          "710204901": {
            "id": "710204901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Then... keep thinking?",
            "nextDialogs": [
              "710204902"
            ]
          },
          "710204902": {
            "id": "710204902",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "Yes! Give me a bit more time and I'll be able to write the perfect plan."
          }
        }
      }
    },
    {
      "subId": "7102004",
      "subQuestName": "Report back to Clerk Zhao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710206101"
        ],
        "dialogs": {
          "710206101": {
            "id": "710206101",
            "speakerId": 1001,
            "speakerName": "Clerk Zhao",
            "text": "You're back. Thank you so much, Nervous An and Jiangzhou already sent me a message.",
            "nextDialogs": [
              "710206102"
            ]
          },
          "710206102": {
            "id": "710206102",
            "speakerId": 1001,
            "speakerName": "Clerk Zhao",
            "text": "They said they will definitely submit their work on time.",
            "nextDialogs": [
              "710206103"
            ]
          },
          "710206103": {
            "id": "710206103",
            "speakerId": 1001,
            "speakerName": "Clerk Zhao",
            "text": "Excellent... At the very least I can sleep well tonight...",
            "nextDialogs": [
              "710206104"
            ]
          },
          "710206104": {
            "id": "710206104",
            "speakerId": 1001,
            "speakerName": "Clerk Zhao",
            "text": "Take these as thanks. You have really been a great help.",
            "nextDialogs": [
              "710206105"
            ]
          },
          "710206105": {
            "id": "710206105",
            "speakerId": 1001,
            "speakerName": "Clerk Zhao",
            "text": "After this ordeal, I'm sure they won't repeat this kind of mistake again..."
          }
        }
      }
    },
    {
      "subId": "7102021",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710202101"
        ],
        "dialogs": {
          "710202101": {
            "id": "710202101",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "I mean, you've seen how busy I am.",
            "nextDialogs": [
              "710202102"
            ]
          },
          "710202102": {
            "id": "710202102",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "All of these different tasks to do at once, and all equally important.",
            "nextDialogs": [
              "710202103"
            ]
          },
          "710202103": {
            "id": "710202103",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "Darn, looks like I'll simply have to put off this report to another time."
          }
        }
      }
    },
    {
      "subId": "7102051",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710205101"
        ],
        "dialogs": {
          "710205101": {
            "id": "710205101",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "No... The people of Liyue have been eagerly looking forward to Lantern Rite.",
            "nextDialogs": [
              "710205102"
            ]
          },
          "710205102": {
            "id": "710205102",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "Nobody will be satisfied if it's just a touched-up version of last year's plan.",
            "nextDialogs": [
              "710205103"
            ]
          },
          "710205103": {
            "id": "710205103",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "Don't try to stop me... I still need to make some changes, need to make the perfect plan..."
          }
        }
      }
    },
    {
      "subId": "7102062",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710206201"
        ],
        "dialogs": {
          "710206201": {
            "id": "710206201",
            "speakerId": 1001,
            "speakerName": "Clerk Zhao",
            "text": "What? They still can't finish on time?",
            "nextDialogs": [
              "710206202"
            ]
          },
          "710206202": {
            "id": "710206202",
            "speakerId": 1001,
            "speakerName": "Clerk Zhao",
            "text": "Another extension? Do they want to do this job or not?",
            "nextDialogs": [
              "710206203"
            ]
          },

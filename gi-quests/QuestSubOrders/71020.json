              "710201802"
            ]
          },
          "710201802": {
            "id": "710201802",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "I know, I know... This is my job, I can't rely on other people to do it for."
          }
        }
      }
    },
    {
      "subId": "7102014",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710201901"
        ],
        "dialogs": {
          "710201901": {
            "id": "710201901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Prioritize your work better next time.",

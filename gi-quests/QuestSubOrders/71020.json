    {
      "subId": "7102003",
      "subQuestName": "Give the invoice to Nervous An",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710202001"
        ],
        "dialogs": {
          "710202001": {
            "id": "710202001",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "*sigh* I thought about it, but there's just not enough time... I have to work harder.",
            "nextDialogs": [
              "710202002"
            ]
          },
          "710202002": {
            "id": "710202002",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "I'll burn the midnight oil tonight, and tomorrow, and the day after that... see if I can finish recording all the ships in the harbor.",
            "nextDialogs": [
              "710202003"
            ]
          },
          "710202003": {
            "id": "710202003",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "After all, this was the very first report I started working on, so it shouldn't be the last one I submit."
          }
        }
      }
    },
    {
      "subId": "7102005",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710201001"
        ],
        "dialogs": {
          "710201001": {
            "id": "710201001",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "Oh boy, now I'm in trouble...",
            "nextDialogs": [
              "710201002"
            ]
          },
          "710201002": {
            "id": "710201002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Clerk Zhao told me to give this to you...",
            "nextDialogs": [
              "710201003"
            ]
          },
          "710201003": {
            "id": "710201003",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "Huh? She needs a report of all the ships in the harbor!?",
            "nextDialogs": [
              "710201004"
            ]
          },
          "710201004": {
            "id": "710201004",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "This... I actually had started keeping track of this at the very start...",
            "nextDialogs": [
              "710201005"
            ]
          },
          "710201005": {
            "id": "710201005",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "But then there's also the imported goods report, the reports on crew information, and the customs report...",
            "nextDialogs": [
              "710201006"
            ]
          },
          "710201006": {
            "id": "710201006",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "There's just sooo much to keep track of — report this, record that, I simply can't keep up with it all."
          }
        }
      }
    },
    {
      "subId": "7102006",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710201101"
        ],
        "dialogs": {
          "710201101": {
            "id": "710201101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hire some help...",
            "nextDialogs": [
              "710201102"
            ]
          },
          "710201102": {
            "id": "710201102",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "I want to, but it will take some time to find someone, so that won't help me finish the work at hand..."
          }
        }
      }
    },
    {
      "subId": "7102007",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710201201"
        ],
        "dialogs": {
          "710201201": {
            "id": "710201201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just do this report that Clerk Zhao wants first.",
            "nextDialogs": [
              "710201202"
            ]
          },
          "710201202": {
            "id": "710201202",
            "speakerId": 1000,
            "speakerName": "Nervous An",
            "text": "Hahaha! I don't even have enough time to remember all the information I need to report, let alone fill it out..."
          }
        }
      }
    },
    {
      "subId": "7102008",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710201301"
        ],
        "dialogs": {
          "710201301": {
            "id": "710201301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do the most important reports first.",
            "nextDialogs": [
              "710201302"
            ]
          },
          "710201302": {
            "id": "710201302",
            "speakerId": 1000,
            "speakerName": "Nervous An",

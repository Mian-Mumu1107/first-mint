              "710204202"
            ]
          },
          "710204202": {
            "id": "710204202",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "What!? I can't carelessly submit what amounts to a rough draft, this is Liyue's most important festival!"
          }
        }
      }
    },
    {
      "subId": "7102019",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710204301"
        ],
        "dialogs": {
          "710204301": {
            "id": "710204301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It will never be perfect.",
            "nextDialogs": [
              "710204302"
            ]
          },
          "710204302": {
            "id": "710204302",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "That may be true, but I should strive for perfection, no?"
          }
        }
      }
    },
    {
      "subId": "7102020",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710204401"
        ],
        "dialogs": {
          "710204401": {
            "id": "710204401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Any plan is better than no plan.",
            "nextDialogs": [
              "710204402"
            ]
          },
          "710204402": {
            "id": "710204402",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "That's true, but I shouldn't submit a plan that has something wrong with it, should I?"
          }
        }
      }
    },
    {
      "subId": "7102021",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710204501"
        ],
        "dialogs": {
          "710204501": {
            "id": "710204501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's nothing wrong with your plan.",
            "nextDialogs": [
              "710204502"
            ]
          },
          "710204502": {
            "id": "710204502",
            "speakerId": 1002,
            "speakerName": "Jiangzhou",
            "text": "Hmm, it may not have any glaring problems, but at least let me improve it even more."
          }

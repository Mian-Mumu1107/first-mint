        ],
        "dialogs": {
          "200670801": {
            "id": "200670801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You need to make sure that you're below the wind glider.",
            "nextDialogs": [
              "200670802"
            ]
          },
          "200670802": {
            "id": "200670802",
            "speakerId": 10003,
            "speakerName": "Anna",
            "text": "Ah, alright, I see..."
          }

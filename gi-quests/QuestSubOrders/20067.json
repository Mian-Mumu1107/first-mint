        ],
        "dialogs": {
          "200670301": {
            "id": "200670301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That depends on how good the person doing the gliding is.",
            "nextDialogs": [
              "200670302"
            ]
          },
          "200670302": {
            "id": "200670302",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Huh..."
          }
        }
      }
    },
    {
      "subId": "2006704",
      "subQuestName": "Talk to Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200671401"
        ],
        "dialogs": {
          "200671401": {
            "id": "200671401",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Wow, you're really good at this! No wonder Amber said that I could learn a thing or two from you.",
            "nextDialogs": [
              "200671402"
            ]
          },
          "200671402": {
            "id": "200671402",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Hehe, with you as my coach, this exam will be a cinch!",
            "nextDialogs": [
              "200671403"
            ]
          },
          "200671403": {
            "id": "200671403",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Thanks so much! Here, these are for you. I'm off to revise some more!",
            "nextDialogs": [
              "200671404"
            ]
          },
          "200671404": {
            "id": "200671404",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I wonder what color my wind glider should be...",
            "nextDialogs": [
              "200671405"
            ]
          },
          "200671405": {
            "id": "200671405",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Blue? Green? Maybe a bit of both, perhaps?"
          }
        }
      }
    },
    {
      "subId": "2006705",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200670501"
        ],
        "dialogs": {
          "200670501": {
            "id": "200670501",
            "speakerId": 10003,
            "speakerName": "Anna",
            "text": "Second question: what should we take note of when using wind gliders?"
          }
        }
      }
    },
    {
      "subId": "2006706",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200670601"
        ],
        "dialogs": {
          "200670601": {
            "id": "200670601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "To select appropriate take-off points and to assume the correct take-off posture.",
            "nextDialogs": [
              "200670602"
            ]
          },
          "200670602": {
            "id": "200670602",
            "speakerId": 10003,
            "speakerName": "Anna",
            "text": "Oh..."
          }
        }
      }
    },
    {
      "subId": "2006701",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200670101"
        ],
        "dialogs": {
          "200670101": {
            "id": "200670101",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Where did I go wrong...",
            "nextDialogs": [
              "200670102"
            ]
          },
          "200670102": {
            "id": "200670102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's up?",
            "nextDialogs": [
              "200670103"
            ]
          },
          "200670103": {
            "id": "200670103",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Traveler... I...",
            "nextDialogs": [
              "200670104"
            ]
          },
          "200670104": {
            "id": "200670104",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I studied pretty hard after your previous coaching session.",
            "nextDialogs": [
              "200670105"
            ]
          },
          "200670105": {
            "id": "200670105",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "After that, I asked Jack to help me do a mock test.",
            "nextDialogs": [
              "200670106"
            ]
          },
          "200670106": {
            "id": "200670106",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I... I failed that mock exam.",
            "nextDialogs": [
              "200670107"
            ]
          },
          "200670107": {
            "id": "200670107",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I'm not sure where things went wrong. Traveler, could you coach me again?",
            "nextDialogs": [
              "200670110"
            ]
          },
          "200670110": {
            "id": "200670110",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Thanks for your help, Traveler!",
            "nextDialogs": [
              "200670111"
            ]
          },
          "200670111": {
            "id": "200670111",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "So... First off, how many people can a single wind glider carry while airborne?"
          }
        }
      }
    },
    {
      "subId": "2006704",
      "subQuestName": "Additional",
      "sceneId": null,

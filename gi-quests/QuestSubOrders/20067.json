        ],
        "dialogs": {
          "200670201": {
            "id": "200670201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "One person per glider.",
            "nextDialogs": [
              "200670202"
            ]
          },
          "200670202": {
            "id": "200670202",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I see..."
          }
        }
      }
    },
    {
      "subId": "2006703",
      "subQuestName": "Demonstrate how to use a wind glider to Anna",
      "sceneId": null,

            "id": "200670701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Taking off using Anemo Slimes is always an interesting option.",
            "nextDialogs": [
              "200670702"
            ]
          },
          "200670702": {
            "id": "200670702",
            "speakerId": 10003,
            "speakerName": "Anna",
            "text": "Is that so..."
          }
        }
      }
    },
    {
      "subId": "2006708",
      "subQuestName": "Additional",

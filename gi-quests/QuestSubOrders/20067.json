    {
      "subId": "2006701",
      "subQuestName": "Talk to Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200671301"
        ],
        "dialogs": {
          "200671301": {
            "id": "200671301",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Hmm... I think I've more or less got it all down now! But I won't get anywhere just by listening...",
            "nextDialogs": [
              "200671302"
            ]
          },
          "200671302": {
            "id": "200671302",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "Traveler, could you give me a demonstration of wind glider usage?",
            "nextDialogs": [
              "200671305"
            ]
          },
          "200671305": {
            "id": "200671305",
            "speakerId": 1405,
            "speakerName": "Anna",
            "text": "I sure will! Let's get going, then!"
          }
        }
      }
    },
    {
      "subId": "2006702",
      "subQuestName": "Demonstrate how to use a wind glider to Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {

  "subQuests": [
    {
      "subId": "7611801",
      "subQuestName": "Meet Columbina",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761180101"
        ],
        "dialogs": {
          "761180101": {
            "id": "761180101",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "...",
            "nextDialogs": [
              "761180102"
            ]
          },
          "761180102": {
            "id": "761180102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Is it just Paimon, or do you smell something yummy too?",
            "nextDialogs": [
              "761180103"
            ]
          },
          "761180103": {
            "id": "761180103",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "...",
            "nextDialogs": [
              "761180104"
            ]
          },
          "761180104": {
            "id": "761180104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Columbina's having a feast for one!",
            "nextDialogs": [
              "761180105"
            ]
          },
          "761180105": {
            "id": "761180105",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "#{NICKNAME}, Paimon...",
            "nextDialogs": [
              "761180106"
            ]
          },
          "761180106": {
            "id": "761180106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Looks like someone's enjoying herself...",
            "nextDialogs": [
              "761180107"
            ]
          },
          "761180107": {
            "id": "761180107",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Would you like to try some as well?",
            "nextDialogs": [
              "761180108"
            ]
          },
          "761180108": {
            "id": "761180108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No, no, you go ahead.",
            "nextDialogs": [
              "761180109"
            ]
          },
          "761180109": {
            "id": "761180109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We don't usually see you eating here! Did you go out just to buy it?",
            "nextDialogs": [
              "761180110"
            ]
          },
          "761180110": {
            "id": "761180110",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Lauma gave it to me.",
            "nextDialogs": [
              "761180111"
            ]
          },
          "761180111": {
            "id": "761180111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, she sure takes good care of you, huh?",
            "nextDialogs": [
              "761180112"
            ]
          },
          "761180112": {
            "id": "761180112",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "On the condition that I don't leave.",
            "nextDialogs": [
              "761180113"
            ]
          },
          "761180113": {
            "id": "761180113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, what!? Isn't that just a bribe so you'll accept house arrest? And a cheap one, at that!",
            "nextDialogs": [
              "761180114"
            ]
          },
          "761180114": {
            "id": "761180114",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "She also brought me some interesting books and exquisitely made toys...",
            "nextDialogs": [
              "761180115"
            ]
          },
          "761180115": {
            "id": "761180115",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um, now it sounds more like a mother going out on a business trip and the kid she's leaving at home...",
            "nextDialogs": [
              "761180116"
            ]
          },
          "761180116": {
            "id": "761180116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did Lauma explain her reasoning?",
            "nextDialogs": [
              "761180117"
            ]
          },
          "761180117": {
            "id": "761180117",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "She just told me not to go out for the time being, and to be especially sure to avoid the Frostmoon Scions.",
            "nextDialogs": [
              "761180118"
            ]
          },
          "761180118": {
            "id": "761180118",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "I asked the animals who came to deliver my meals, but Lauma had instructed them to remain silent, and so they did.",
            "nextDialogs": [
              "761180119"
            ]
          },
          "761180119": {
            "id": "761180119",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh, that's...",
            "nextDialogs": [
              "761180120"
            ]
          },
          "761180120": {
            "id": "761180120",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "If I had to guess, she is preparing something that has to do with me.",
            "nextDialogs": [
              "761180121"
            ]
          },
          "761180121": {
            "id": "761180121",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Worry not. I have never considered staying here boring in the first place. The food is good, and much to my liking. Not going out is fine with me.",
            "nextDialogs": [
              "761180122"
            ]
          },
          "761180122": {
            "id": "761180122",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "And if the Scions are indeed preparing for something... Well, all the more reason not to interrupt them.",
            "nextDialogs": [
              "761180123"
            ]
          },
          "761180123": {
            "id": "761180123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Want us to go ask around?",
            "nextDialogs": [
              "761180124"
            ]
          },
          "761180124": {
            "id": "761180124",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah. Paimon's kinda curious now, too.",
            "nextDialogs": [
              "761180125"
            ]
          },
          "761180125": {
            "id": "761180125",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "You can... but you should be prepared.",
            "nextDialogs": [
              "761180126"
            ]
          },
          "761180126": {
            "id": "761180126",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "She likely knows you'll come to see me, so she may not tell you anything at all."
          }
        }
      }
    },
    {
      "subId": "7611802",
      "subQuestName": "Meet Lauma",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761180301"
        ],
        "dialogs": {
          "761180301": {
            "id": "761180301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You wanna renovate the statue of Kuutar!?",
            "nextDialogs": [
              "761180302"
            ]
          },
          "761180302": {
            "id": "761180302",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "Precisely so.",
            "nextDialogs": [
              "761180303"
            ]
          },
          "761180303": {
            "id": "761180303",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "No longer is she the wingless Kuu{RUBY#[S]Moon Maiden}tar who could only gaze at the moon beyond the skies in solitude.",
            "nextDialogs": [
              "761180304"
            ]
          },
          "761180304": {
            "id": "761180304",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "We witnessed her unfurling her wings, and know she has regained the freedom to live.",
            "nextDialogs": [
              "761180305"
            ]
          },
          "761180305": {
            "id": "761180305",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "As such, it is only right that the statue, too, be restored.",
            "nextDialogs": [
              "761180306"
            ]
          },
          "761180306": {
            "id": "761180306",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That does sound like a good idea!",
            "nextDialogs": [
              "761180307"
            ]
          },
          "761180307": {
            "id": "761180307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you told the other Frostmoon Scions about this?",
            "nextDialogs": [
              "761180308"
            ]
          },
          "761180308": {
            "id": "761180308",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "That I have. I spoke to them of the Moon Goddess's sacrifice, and her return...",
            "nextDialogs": [
              "761180309"
            ]
          },
          "761180309": {
            "id": "761180309",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "And of how we stood against the force that pollutes this world with the guidance of that gentle light.",
            "nextDialogs": [
              "761180310"
            ]
          },
          "761180310": {
            "id": "761180310",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "Everyone was delighted to hear of her return, so I took the opportunity to convey Columbina's thoughts to them...",
            "nextDialogs": [
              "761180311"
            ]
          },
          "761180311": {
            "id": "761180311",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "That she wants to see us as family, and would like us to do the same for her.",
            "nextDialogs": [
              "761180312"
            ]
          },
          "761180312": {
            "id": "761180312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And what did everyone say?",
            "nextDialogs": [
              "761180313"
            ]
          },
          "761180313": {
            "id": "761180313",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "...",
            "nextDialogs": [
              "761180314"
            ]
          },
          "761180314": {
            "id": "761180314",
            "speakerId": 1003,
            "speakerName": "Zirnytsia",
            "text": "The Lady Moon Goddess...",
            "nextDialogs": [
              "761180315"
            ]
          },
          "761180315": {
            "id": "761180315",
            "speakerId": 1004,
            "speakerName": "Lauha",
            "text": "Would we... not be overstepping by regarding her as family?",
            "nextDialogs": [
              "761180316"
            ]
          },
          "761180316": {
            "id": "761180316",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "I believe that this is what Columbina genuinely wishes for.",
            "nextDialogs": [
              "761180317"
            ]
          },
          "761180317": {
            "id": "761180317",
            "speakerId": 1005,
            "speakerName": "Kunegunda",
            "text": "(I can't believe the Lady Moonchanter referred to our Moon Goddess by her first name!)",
            "nextDialogs": [
              "761180318"
            ]
          },
          "761180318": {
            "id": "761180318",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "Perhaps you may all yet recall the words I spoke not long ago.",
            "nextDialogs": [
              "761180319"
            ]
          },
          "761180319": {
            "id": "761180319",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "\"The road shall be paved with truth, and we shall pave it ourselves.\"",
            "nextDialogs": [
              "761180320"
            ]
          },
          "761180320": {
            "id": "761180320",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "I will not ask all of you to make the same choice as I, but I do have words I would like to share with you this day.",
            "nextDialogs": [
              "761180321"
            ]
          },
          "761180321": {
            "id": "761180321",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "\"If we wish to invite the moonlight in to stay, we must first open doors that once were tightly shut.\"",
            "nextDialogs": [
              "761180322"
            ]
          },
          "761180322": {
            "id": "761180322",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "...That is what happened. Considering the situation over the past few days, things seem to have gone better than I thought they might have.",
            "nextDialogs": [
              "761180323"
            ]
          },
          "761180323": {
            "id": "761180323",
            "speakerId": 1006,
            "speakerName": "Maciej",
            "text": "Lady Lauma. A new batch of stone has arrived at the warehouse.",
            "nextDialogs": [
              "761180324"
            ]
          },
          "761180324": {
            "id": "761180324",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "Understood. I'll be right over.",
            "nextDialogs": [
              "761180325"
            ]
          },
          "761180325": {
            "id": "761180325",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "Could you keep what I said, including what you've seen, a secret from Columbina — at least for now? I'd like this to be a surprise.",
            "nextDialogs": [
              "761180326"
            ]
          },
          "761180326": {
            "id": "761180326",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon knows you mean well, but seriously, you sure do love your surprises... You, and your Moon Goddess...",
            "nextDialogs": [
              "761180327"
            ]
          },
          "761180327": {
            "id": "761180327",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "My lips are sealed.",
            "nextDialogs": [
              "761180328"
            ]
          },
          "761180328": {
            "id": "761180328",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, Lauma, about Paimon's hush money... Er, Paimon meant to say, we don't happen to have any spare Feast of the Moon servings today, do we?",
            "nextDialogs": [
              "761180329"
            ]
          },
          "761180329": {
            "id": "761180329",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "That we do. Come, let me prepare some for you. Oh, and one more thing..."
          }
        }
      }
    },
    {
      "subId": "7611803",
      "subQuestName": "Report to Columbina",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761180401"
        ],
        "dialogs": {
          "761180401": {
            "id": "761180401",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Ah, you're back.",
            "nextDialogs": [
              "761180402"
            ]
          },
          "761180402": {
            "id": "761180402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Guess what, Columbina? You were right, Lauma didn't tell us a thing!",
            "nextDialogs": [
              "761180403"
            ]
          },
          "761180403": {
            "id": "761180403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She seems quite busy, though.",
            "nextDialogs": [
              "761180404"
            ]
          },
          "761180404": {
            "id": "761180404",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So we'll be keeping you company over the next few days. You just sit tight and keep those expectations high!",
            "nextDialogs": [
              "761180405"
            ]
          },
          "761180405": {
            "id": "761180405",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Expectations for... what exactly?",
            "nextDialogs": [
              "761180406"
            ]
          },
          "761180406": {
            "id": "761180406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ack...! Oh! Uh, nothing! We don't know a thing, honest!",
            "nextDialogs": [
              "761180407"
            ]
          },
          "761180407": {
            "id": "761180407",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Hehe... Very well, then. I look forward to spending the next few days with you.",
            "nextDialogs": [
              "761180408"
            ]
          },
          "761180408": {
            "id": "761180408",
            "speakerId": 1007,
            "speakerName": "Longplume Ibis",
            "text": "!!!",
            "nextDialogs": [
              "761180409"
            ]
          },
          "761180409": {
            "id": "761180409",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ooh, here comes our food... Wait a minute. Where's the grub?",
            "nextDialogs": [
              "761180410"
            ]
          },
          "761180410": {
            "id": "761180410",
            "speakerId": 1007,
            "speakerName": "Longplume Ibis",
            "text": "!!!",
            "nextDialogs": [
              "761180411"
            ]
          },
          "761180411": {
            "id": "761180411",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "It says, \"The time has come.\" Do you know what that means?",
            "nextDialogs": [
              "761180412"
            ]
          },
          "761180412": {
            "id": "761180412",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ohhhhh, Paimon gets it now.",
            "nextDialogs": [
              "761180413"
            ]
          },
          "761180413": {
            "id": "761180413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Columbina.",
            "nextDialogs": [
              "761180414"
            ]
          },
          "761180414": {
            "id": "761180414",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Yes?",
            "nextDialogs": [
              "761180415"
            ]
          },
          "761180415": {
            "id": "761180415",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You usually wear a blindfold, don't you?",
            "nextDialogs": [
              "761180416"
            ]
          },
          "761180416": {
            "id": "761180416",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Yes. What of it?",
            "nextDialogs": [
              "761180417"
            ]
          },
          "761180417": {
            "id": "761180417",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But you can use kuuvahki to observe the outside world even so, right?",
            "nextDialogs": [
              "761180418"
            ]
          },
          "761180418": {
            "id": "761180418",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "That's right. If anything, I sense things more clearly this way.",
            "nextDialogs": [
              "761180419"
            ]
          },
          "761180419": {
            "id": "761180419",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Then, uh, could we ask you to deliberately not sense any changes outside for the time being?",
            "nextDialogs": [
              "761180420"
            ]
          },
          "761180420": {
            "id": "761180420",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "So that this can be a \"pleasant surprise\"?",
            "nextDialogs": [
              "761180421"
            ]
          },
          "761180421": {
            "id": "761180421",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...Sounds like you've already guessed what this is about...",
            "nextDialogs": [
              "761180422"
            ]
          },
          "761180422": {
            "id": "761180422",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Alright. I see. In that case, would you take my hand?"
          }
        }
      }
    },
    {
      "subId": "7611804",
      "subQuestName": "Head to the statue of Kuutar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761180501"
        ],
        "dialogs": {
          "761180501": {
            "id": "761180501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Here we are.",
            "nextDialogs": [
              "761180502"
            ]
          },
          "761180502": {
            "id": "761180502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You can open your eyes now.",
            "nextDialogs": [
              "761180503"
            ]
          },
          "761180503": {
            "id": "761180503",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "...",
            "nextDialogs": [
              "761180504"
            ]
          },
          "761180504": {
            "id": "761180504",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "(She really did open her eyes!)",
            "nextDialogs": [
              "761180505"
            ]
          },
          "761180505": {
            "id": "761180505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(I just said that without thinking...)",
            "nextDialogs": [
              "761180506"
            ]
          },
          "761180506": {
            "id": "761180506",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "It's beautiful...",
            "nextDialogs": [
              "761180507"
            ]
          },
          "761180507": {
            "id": "761180507",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "This pair of wings makes it look all the more complete.",
            "nextDialogs": [
              "761180508"
            ]
          },
          "761180508": {
            "id": "761180508",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "This is a gift we Frostmoon Scions would like to give you, Columbina.",
            "nextDialogs": [
              "761180509"
            ]
          },
          "761180509": {
            "id": "761180509",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "To celebrate our goddess who can now fly free, whose fingers can at last touch the place she calls \"home.\"",
            "nextDialogs": [
              "761180510"
            ]
          },
          "761180510": {
            "id": "761180510",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "...The me from before would only be reminded of the confusion I felt upon being born whenever I looked upon this statue.",
            "nextDialogs": [
              "761180511"
            ]
          },
          "761180511": {
            "id": "761180511",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "But now, what I feel is the warmth of a \"home.\"",
            "nextDialogs": [
              "761180512"
            ]
          },
          "761180512": {
            "id": "761180512",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Perhaps, like this statue, I have chosen to stay here even though I now have wings.",
            "nextDialogs": [
              "761180513"
            ]
          },
          "761180513": {
            "id": "761180513",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "...Thank you all.",
            "nextDialogs": [
              "761180514"
            ]
          },
          "761180514": {
            "id": "761180514",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "We do have another gift prepared, but you'll have to walk with me a bit farther.",
            "nextDialogs": [
              "761180515"
            ]
          },
          "761180515": {
            "id": "761180515",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? There's another surprise?",
            "nextDialogs": [
              "761180516"
            ]
          },
          "761180516": {
            "id": "761180516",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "My fellow Scions and I have organized a simple welcome banquet in the forest.",
            "nextDialogs": [
              "761180517"
            ]
          },
          "761180517": {
            "id": "761180517",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "From now on, this will be your home as well, Columbina.",
            "nextDialogs": [
              "761180518"
            ]
          },
          "761180518": {
            "id": "761180518",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "Whenever you grow homesick, please, feel free to remain here and enjoy our hospitality, meager though it may be.",
            "nextDialogs": [
              "761180519"
            ]
          },
          "761180519": {
            "id": "761180519",
            "speakerId": 1000,
            "speakerName": "Columbina",
            "text": "Sure. I will.",
            "nextDialogs": [
              "761180520"
            ]
          },
          "761180520": {
            "id": "761180520",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, what do you know? The moon's up.",
            "nextDialogs": [
              "761180521"
            ]
          },
          "761180521": {
            "id": "761180521",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "Let's go, then.",
            "nextDialogs": [
              "761180522"
            ]
          },
          "761180522": {
            "id": "761180522",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "It is my hope that every night may be as wonderful as that Moon-Prayer Night.",
            "nextDialogs": [
              "761180523"
            ]
          },
          "761180523": {
            "id": "761180523",
            "speakerId": 1002,
            "speakerName": "Lauma",
            "text": "Welcome home, Columbina."
          }
        }
      }
    }
  ]
}
    {
      "subId": "2103607",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210360701"
        ],
        "dialogs": {
          "210360701": {
            "id": "210360701",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "*huff* That was tough...",
            "nextDialogs": [
              "210360702"
            ]
          },
          "210360702": {
            "id": "210360702",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "I apologize. Look at me, making a fool of myself. I didn't expect that I would be so nervous when confronting real monsters...",
            "nextDialogs": [
              "210360703"
            ]
          },
          "210360703": {
            "id": "210360703",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Needless to say, I still need more training. Anyway, thank you, Traveler. Please, take these as your reward.",
            "nextDialogs": [
              "210360704"
            ]
          },
          "210360704": {
            "id": "210360704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you really leaving?",
            "nextDialogs": [
              "210360705"
            ]
          },
          "210360705": {
            "id": "210360705",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "I haven't fully decided yet. I still need more time to think it through. Meanwhile, I'll see if I can convince Que'er to leave with me..."
          }
        }
      }
    },

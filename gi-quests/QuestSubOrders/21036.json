    {
      "subId": "2103601",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210360101"
        ],
        "dialogs": {
          "210360101": {
            "id": "210360101",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Traveler, we meet again.",
            "nextDialogs": [
              "210360103",
              "210360105"
            ]
          },
          "210360103": {
            "id": "210360103",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Indeed I am. It's just... so much harder than I expected. I don't know if I'm really that weak, or if I've adopted the wrong method...",
            "nextDialogs": [
              "210360108"
            ]
          },
          "210360108": {
            "id": "210360108",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Anyway, enough about that. The last time when we fought monsters together, your moves turned out to be quite inspirational.",
            "nextDialogs": [
              "210360109"
            ]
          },
          "210360109": {
            "id": "210360109",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Traveler, please do me a favor and accompany me for another round of training, will you?",
            "nextDialogs": [
              "210360110"
            ]
          },
          "210360110": {
            "id": "210360110",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "And just like the last time, monster fight or cross-country training? All up to you."
          },
          "210360105": {
            "id": "210360105",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Well... She said she had things to do in the city recently, and she hasn't returned...",
            "nextDialogs": [
              "210360106"
            ]
          },
          "210360106": {
            "id": "210360106",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "I've paid her a couple of visits, but she just sends Zhiruo out to make me go away. She still refuses to see me.",
            "nextDialogs": [
              "210360107"
            ]
          },
          "210360107": {
            "id": "210360107",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "*sigh* I honestly don't know what to say to her now..."
          }
        }
      }
    },

    {
      "subId": "2103608",
      "subQuestName": "Begin training",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210360801"
        ],
        "dialogs": {
          "210360801": {
            "id": "210360801",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "*huff* *huff* How... How could you... run so fast...",
            "nextDialogs": [
              "210360803",
              "210360805"
            ]
          },
          "210360803": {
            "id": "210360803",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "I—I concede...",
            "nextDialogs": [
              "210360806"
            ]
          },
          "210360806": {
            "id": "210360806",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "*huff* Finally I get to catch my breath. Oh my, never thought it could be so exhausting...",
            "nextDialogs": [
              "210360807"
            ]
          },
          "210360807": {
            "id": "210360807",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Thank you for the demonstration, Traveler. Please, take these as your reward."
          },
          "210360805": {
            "id": "210360805",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "*huff* You are absolutely right..."
          }
        }
      }
    },

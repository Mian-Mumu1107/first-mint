  "subQuests": [
    {
      "subId": "2103601",
      "subQuestName": "Talk to Sun Yu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210360201"
        ],
        "dialogs": {
          "210360201": {
            "id": "210360201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Monster fight.",
            "nextDialogs": [
              "210360202"
            ]
          },
          "210360202": {
            "id": "210360202",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Brilliant! I've long wanted to put the swordsmanship I learned into practice...",
            "nextDialogs": [
              "210360203"
            ]
          },
          "210360203": {
            "id": "210360203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm afraid you can't see my moves clearly.",
            "nextDialogs": [
              "210360204"
            ]
          },
          "210360204": {
            "id": "210360204",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Y—You are really that skilled? Hahaha, well, then please do me another favor and slow down a bit.",
            "nextDialogs": [
              "210360205"
            ]
          },
          "210360205": {
            "id": "210360205",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Let's see... There's one place where monsters gather right ahead. Let's go there first, shall we?"
          }
        }
      }
    },
    {
      "subId": "2103606",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210360301"
        ],
        "dialogs": {
          "210360301": {
            "id": "210360301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Cross-country training.",
            "nextDialogs": [
              "210360302"
            ]
          },
          "210360302": {
            "id": "210360302",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Brilliant! I've asked an adventurer to help me chart an off-road route... You know, it was only with her help that I was able to train here at all.",
            "nextDialogs": [
              "210360303"
            ]
          },
          "210360303": {
            "id": "210360303",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "She said I just need to reach the destination as quickly as possible. But it seems that I was never quick enough...",
            "nextDialogs": [
              "210360304"
            ]
          },
          "210360304": {
            "id": "210360304",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "So, can you demonstrate how to do it quickly? I'll try my best to keep up.",
            "nextDialogs": [
              "210360308",
              "210360307"
            ]
          },
          "210360308": {
            "id": "210360308",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Anyway, I'll be counting on you then. Let's head to the starting point, shall we?"
          },
          "210360307": {
            "id": "210360307",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "I—I'll certainly try. But to be completely honest, I wasn't built a runner in any sense..."
          }
        }
      }
    },
    {

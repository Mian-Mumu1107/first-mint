    {
      "subId": "2103604",
      "subQuestName": "Talk to Sun Yu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210360401"
        ],
        "dialogs": {
          "210360401": {
            "id": "210360401",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "*huff* That was tough...",
            "nextDialogs": [
              "210360402"
            ]
          },
          "210360402": {
            "id": "210360402",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Look at me, making a fool of myself again. I guess I haven't made much progress after all...",
            "nextDialogs": [
              "210360403"
            ]
          },
          "210360403": {
            "id": "210360403",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Needless to say, I still need more training. Thank you, Traveler. Please, take these as your reward.",
            "nextDialogs": [
              "210360404"
            ]
          },
          "210360404": {
            "id": "210360404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How are you going to leave Liyue?",
            "nextDialogs": [
              "210360405"
            ]
          },
          "210360405": {
            "id": "210360405",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Well... My current plan is to take the merchant's boat and travel by water.",
            "nextDialogs": [
              "210360406"
            ]
          },
          "210360406": {
            "id": "210360406",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "As for my first stop... I'm thinking about Fontaine. I'll probably stay there for a while and make further plans from there.",
            "nextDialogs": [
              "210360407"
            ]
          },
          "210360407": {
            "id": "210360407",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "*sigh* I wonder if I'll be able to convince Que'er to travel with me..."
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "7217501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721750101"
        ],
        "dialogs": {
          "721750101": {
            "id": "721750101",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "Ah, so you're still on this island as well. That's great.",
            "nextDialogs": [
              "721750102"
            ]
          },
          "721750102": {
            "id": "721750102",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "How have you been lately? Any shocking discoveries? Let's hear them, shall we?",
            "nextDialogs": [
              "721750104",
              "721750106"
            ]
          },
          "721750104": {
            "id": "721750104",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "Ah, but that's normal. Don't sweat it, I'd say. Islands like this never lack for mysteries, and I have full confidence that you'll stumble upon something eventually.",
            "nextDialogs": [
              "721750107"
            ]
          },
          "721750107": {
            "id": "721750107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Actually, Paimon's got a question. What are you doing here, Roald?",
            "nextDialogs": [
              "721750108"
            ]
          },
          "721750108": {
            "id": "721750108",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "Me? Oh, I was just packing my things up and preparing to leave.",
            "nextDialogs": [
              "721750109"
            ]
          },
          "721750109": {
            "id": "721750109",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "The fog here is too bizarre. Step into it for a bit, and you lose your way... And before you know it, you're right back where you started.",
            "nextDialogs": [
              "721750110"
            ]
          },
          "721750110": {
            "id": "721750110",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "I'd forgotten the path that Kama pointed out to me before, so I tried looking for some natives to show me the way, but I couldn't find any path no matter how I tried...",
            "nextDialogs": [
              "721750111"
            ]
          },
          "721750111": {
            "id": "721750111",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "My compass, the shadows on the ground... None of these help in telling directions here... I've even tried using my shoes, but nope! I couldn't take a single step further into the fog.",
            "nextDialogs": [
              "721750112"
            ]
          },
          "721750112": {
            "id": "721750112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Your... shoes?",
            "nextDialogs": [
              "721750113"
            ]
          },
          "721750113": {
            "id": "721750113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He means that he used them as waymarkers.",
            "nextDialogs": [
              "721750114"
            ]
          },
          "721750114": {
            "id": "721750114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What...!?",
            "nextDialogs": [
              "721750115"
            ]
          },
          "721750115": {
            "id": "721750115",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "#Haha! As expected of you, {NICKNAME}! You're well-versed in adventuring tricks, indeed! You've got much to learn, Paimon!",
            "nextDialogs": [
              "721750116"
            ]
          },
          "721750116": {
            "id": "721750116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, much to learn you have, Paimon.",
            "nextDialogs": [
              "721750117"
            ]
          },
          "721750117": {
            "id": "721750117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, come on, that's just called trying your luck! Paimon doesn't have to learn that!",
            "nextDialogs": [
              "721750118"
            ]
          },
          "721750118": {
            "id": "721750118",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "Either way, my progress has ground to a halt.",
            "nextDialogs": [
              "721750119"
            ]
          },
          "721750119": {
            "id": "721750119",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "*sigh* If I had tied a rope to a nearby tree and tried to advance while holding on to its other end tightly, I could probably have made a few more attempts.",
            "nextDialogs": [
              "721750120"
            ]
          },
          "721750120": {
            "id": "721750120",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So why didn't you try again?",
            "nextDialogs": [
              "721750121"
            ]
          },
          "721750121": {
            "id": "721750121",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "I used up the backup shoes that I brought along to help tell which way I was going..."
          },
          "721750106": {
            "id": "721750106",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "Is that so? Haha! Well, don't let me slow you down, then!"
          }
        }
      }
    },
    {
      "subId": "7217517",
      "subQuestName": "Give Roald the Fluorescent Fungus",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7217510",
      "subQuestName": "Give Roald the Fluorescent Fungus",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721750301"
        ],
        "dialogs": {
          "721750301": {
            "id": "721750301",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "Hmm, this should be enough, yes! Thank you ever so much!",
            "nextDialogs": [
              "721750302"
            ]
          },
          "721750302": {
            "id": "721750302",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "By the way, if you find anything interesting near the island's ceremonial site, do give me a shout as well.",
            "nextDialogs": [
              "721750303"
            ]
          },
          "721750303": {
            "id": "721750303",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "Hmm. Ah, yes. I do believe that you have a Fontaine-built Kamera with you, right? That's a rather expensive gadget to be sure... I should really get myself one of those, should my budget allow.",
            "nextDialogs": [
              "721750304"
            ]
          },
          "721750304": {
            "id": "721750304",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "I've heard local historians say that the ancient natives of Tsurumi Island would use paintings to depict ancient, now-unremembered history onto the rock walls of caves, and that most of these murals have lasted over a thousand years now...",
            "nextDialogs": [
              "721750305"
            ]
          },
          "721750305": {
            "id": "721750305",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "During my previous trip here, I was able to catch a glimpse of these images by ceremonial fire-light... They occupied my thoughts for several restless nights, and were most hard to forget indeed.",
            "nextDialogs": [
              "721750306"
            ]
          },
          "721750306": {
            "id": "721750306",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "I don't believe that anyone has ever witnessed the murals in full, but if you could bring back proof of their existence, this will surely constitute a major breakthrough for the Adventurers' Guild in the field of historical academia.",
            "nextDialogs": [
              "721750307"
            ]
          },
          "721750307": {
            "id": "721750307",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "If you find those legendary murals, take as many clear pictures of them as you can. I will purchase the photos from you for use in my diaries for a fair price and reward you for your trouble to boot.",
            "nextDialogs": [
              "721750308"
            ]
          },
          "721750308": {
            "id": "721750308",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "What do you say? Is this arrangement acceptable?",
            "nextDialogs": [
              "721750310",
              "721750312"
            ]
          },
          "721750310": {
            "id": "721750310",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "Thank you very much!"
          },
          "721750312": {
            "id": "721750312",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "I'll... I'll try my best."
          }
        }
      }
    },
    {
      "subId": "7217504",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721750401"
        ],
        "dialogs": {
          "721750401": {
            "id": "721750401",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "Hello there, you two! Found anything lately?",
            "nextDialogs": [
              "721750403",
              "721750406"
            ]
          },
          "721750403": {
            "id": "721750403",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "No rush. I'll be here waiting!",
            "nextDialogs": [
              "721750404"
            ]
          },
          "721750404": {
            "id": "721750404",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "Thanks for the Fluorescent Fungi you gave me, by the way. They're really fresh!",
            "nextDialogs": [
              "721750407"
            ]
          },
          "721750407": {
            "id": "721750407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, yeah, easy for you to say. Didn't we give you those mushrooms in the first place?",
            "nextDialogs": [
              "721750408"
            ]
          },
          "721750408": {
            "id": "721750408",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "Ah, come now, don't sweat the small stuff. I mean, I've been eating them, haven't I?",
            "nextDialogs": [
              "721750409"
            ]
          },
          "721750409": {
            "id": "721750409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...You... You forgetful..."
          },
          "721750406": {
            "id": "721750406",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "Rest here for a bit if you're tired, maybe have a Fluorescent Fungus or two!"
          }
        }
      }
    },

    {
      "subId": "7217518",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721751801"
        ],
        "dialogs": {
          "721751801": {
            "id": "721751801",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "#We meet again, {NICKNAME}, and your, uh, um...",
            "nextDialogs": [
              "721751802"
            ]
          },
          "721751802": {
            "id": "721751802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...?",
            "nextDialogs": [
              "721751803"
            ]
          },
          "721751803": {
            "id": "721751803",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "Could I ask what you'd sell this flying fellow for? I think she's quite interesting!",
            "nextDialogs": [
              "721751804"
            ]
          },
          "721751804": {
            "id": "721751804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh!?",
            "nextDialogs": [
              "721751806",
              "721751808"
            ]
          },
          "721751806": {
            "id": "721751806",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He's clearly not alright! This guy's having that amnesia thing again!",
            "nextDialogs": [
              "721751809"
            ]
          },
          "721751809": {
            "id": "721751809",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "What on earth are you saying... *hurk*",
            "nextDialogs": [
              "721751810"
            ]
          },
          "721751810": {
            "id": "721751810",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "*hurk*... Ahahahaha!",
            "nextDialogs": [
              "721751811"
            ]
          },
          "721751811": {
            "id": "721751811",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "??",
            "nextDialogs": [
              "721751812"
            ]
          },
          "721751812": {
            "id": "721751812",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "???",
            "nextDialogs": [
              "721751813"
            ]
          },
          "721751813": {
            "id": "721751813",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "Hahahaha! *cough* Ahahah! Just... Just look at the looks on your faces! Hehahah!",
            "nextDialogs": [
              "721751814"
            ]
          },
          "721751814": {
            "id": "721751814",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "I'm done... I'm out of breath... S—Sorry... This... Ahahaha... This is a favored \"joke\" of mine, you know?",
            "nextDialogs": [
              "721751815"
            ]
          },
          "721751815": {
            "id": "721751815",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's not funny at all!"
          },
          "721751808": {
            "id": "721751808",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's right! Why does it seem like he's gotten worse instead!?"
          }
        }
      }
    },

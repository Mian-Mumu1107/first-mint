    {
      "subId": "7217506",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721750601"
        ],
        "dialogs": {
          "721750601": {
            "id": "721750601",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "#Hello there, {NICKNAME}! And hello there, {NICKNAME}'s gabby fairy friend!",
            "nextDialogs": [
              "721750602"
            ]
          },
          "721750602": {
            "id": "721750602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And hello to you too, Mister Forgetful!",
            "nextDialogs": [
              "721750603"
            ]
          },
          "721750603": {
            "id": "721750603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon. Is. Paimon! Don't you forget that!",
            "nextDialogs": [
              "721750604"
            ]
          },
          "721750604": {
            "id": "721750604",
            "speakerId": 20333,
            "speakerName": "Roald",
            "text": "I won't, Little Paimon.",
            "nextDialogs": [
              "721750605"
            ]
          },
          "721750605": {
            "id": "721750605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Wait, were you just playing Paimon!? Where did your manners go?",
            "nextDialogs": [
              "721750606"
            ]
          },
          "721750606": {
            "id": "721750606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#You know what, {NICKNAME}? Just give this guy those weird mushrooms already. Paimon's not talking to him!",
            "nextDialogs": [
              "721750607"
            ]
          },
          "721750607": {
            "id": "721750607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Will this be enough?"
          }
        }
      }
    },

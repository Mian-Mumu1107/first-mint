    {
      "subId": "7226203",
      "subQuestName": "Take a picture of Kichiboushi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722620301"
        ],
        "dialogs": {
          "722620301": {
            "id": "722620301",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Ooh... Why...",
            "nextDialogs": [
              "722620302"
            ]
          },
          "722620302": {
            "id": "722620302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Come on, Kichiboushi, why did you just charge straight into the hilichurl stronghold?",
            "nextDialogs": [
              "722620303"
            ]
          },
          "722620303": {
            "id": "722620303",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Thought we could... play...",
            "nextDialogs": [
              "722620304"
            ]
          },
          "722620304": {
            "id": "722620304",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh? Why? The hilichurls are dangerous monsters...",
            "nextDialogs": [
              "722620306",
              "722620308"
            ]
          },
          "722620306": {
            "id": "722620306",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Come on! Kichiboushi isn't anywhere as seasoned a combatant as you!",
            "nextDialogs": [
              "722620309"
            ]
          },
          "722620309": {
            "id": "722620309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hmm, when we first met in Chinju Forest...",
            "nextDialogs": [
              "722620310"
            ]
          },
          "722620310": {
            "id": "722620310",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's right! Weren't you hiding in the form of some other object while being surrounded by hilichurls?",
            "nextDialogs": [
              "722620311"
            ]
          },
          "722620311": {
            "id": "722620311",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "When we first met... First met... I'm thinking... Ooh, yes.",
            "nextDialogs": [
              "722620312"
            ]
          },
          "722620312": {
            "id": "722620312",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Then, was playing Hide-and-Seek with the hilichurl. Forest hilichurls do not attack bake-danuki. They play with us often.",
            "nextDialogs": [
              "722620313"
            ]
          },
          "722620313": {
            "id": "722620313",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh? So you've developed a harmonious relationship?",
            "nextDialogs": [
              "722620314"
            ]
          },
          "722620314": {
            "id": "722620314",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Not knowing why the hilichurls here are like this. Mmm...",
            "nextDialogs": [
              "722620315"
            ]
          },
          "722620315": {
            "id": "722620315",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Either way, you need to be more careful out here. Even when it comes to hilichurls... Well, especially when it comes to the hilichurls...",
            "nextDialogs": [
              "722620316"
            ]
          },
          "722620316": {
            "id": "722620316",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Ugh, this is getting complicated. You explain, {NICKNAME}.",
            "nextDialogs": [
              "722620317"
            ]
          },
          "722620317": {
            "id": "722620317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You need to differentiate between the good people and the bad.",
            "nextDialogs": [
              "722620318"
            ]
          },
          "722620318": {
            "id": "722620318",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yup! That's how you can protect yourself in the future.",
            "nextDialogs": [
              "722620319"
            ]
          },
          "722620319": {
            "id": "722620319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But don't forget to keep a good and open heart.",
            "nextDialogs": [
              "722620320"
            ]
          },
          "722620320": {
            "id": "722620320",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yup, that's right! That'll help you enjoy the good things in life!",
            "nextDialogs": [
              "722620321"
            ]
          },
          "722620321": {
            "id": "722620321",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm...",
            "nextDialogs": [
              "722620322"
            ]
          },
          "722620322": {
            "id": "722620322",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "#{NICKNAME} and Paimon say complicated things. Kichiboushi not understand.",
            "nextDialogs": [
              "722620323"
            ]
          },
          "722620323": {
            "id": "722620323",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "But Kichiboushi knows you're good people. So Kichiboushi learn.",
            "nextDialogs": [
              "722620324"
            ]
          },
          "722620324": {
            "id": "722620324",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Alright, enough of that for now. For now, time to learn how to fish from {NICKNAME}.",
            "nextDialogs": [
              "722620325"
            ]
          },
          "722620325": {
            "id": "722620325",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm! Fishing!"
          },
          "722620308": {
            "id": "722620308",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, there's no need to scare him either!"
          }
        }
      }
    },
    {
      "subId": "7226204",
      "subQuestName": "Talk to Kichiboushi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722620201"
        ],
        "dialogs": {
          "722620201": {
            "id": "722620201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And it's done!",
            "nextDialogs": [
              "722620202"
            ]
          },
          "722620202": {
            "id": "722620202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Next up...",
            "nextDialogs": [
              "722620203"
            ]
          },
          "722620203": {
            "id": "722620203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "How about this? Kichiboushi, have you ever gone fishing?",
            "nextDialogs": [
              "722620204"
            ]
          },
          "722620204": {
            "id": "722620204",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Fishing?",
            "nextDialogs": [
              "722620205"
            ]
          },
          "722620205": {
            "id": "722620205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Looks like you haven't. Alright then, let's head for the water's edge!",
            "nextDialogs": [
              "722620206"
            ]
          },
          "722620206": {
            "id": "722620206",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Yey!"
          }
        }
      }
    },
    {
      "subId": "7226205",
      "subQuestName": "Catch up with Kichiboushi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722620501"
        ],
        "dialogs": {
          "722620501": {
            "id": "722620501",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Really to play with the water.",
            "nextDialogs": [
              "722620502"
            ]
          },
          "722620502": {
            "id": "722620502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not now, you'll scare the fish off.",
            "nextDialogs": [
              "722620503"
            ]
          },
          "722620503": {
            "id": "722620503",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm. Okay."
          }
        }
      }
    },
    {
      "subId": "7226206",
      "subQuestName": "Defeat the hilichurls",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722620601"
        ],
        "dialogs": {
          "722620601": {
            "id": "722620601",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Hmm. Why not go into water to catchy fish?",
            "nextDialogs": [
              "722620605"
            ]
          },
          "722620605": {
            "id": "722620605",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's right! Fishing is a great way to train!"
          }
        }
      }
    },

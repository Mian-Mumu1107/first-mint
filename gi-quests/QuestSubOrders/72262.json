    {
      "subId": "7226208",
      "subQuestName": "Head to your destination",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722620401"
        ],
        "dialogs": {
          "722620401": {
            "id": "722620401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Haha, this place looks pretty good.",
            "nextDialogs": [
              "722620402"
            ]
          },
          "722620402": {
            "id": "722620402",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Kichiboushi wants to play with water!",
            "nextDialogs": [
              "722620403"
            ]
          },
          "722620403": {
            "id": "722620403",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, hey, not now! You'll scare the fish away!",
            "nextDialogs": [
              "722620404"
            ]
          },
          "722620404": {
            "id": "722620404",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You teach Kichiboushi the basics of fishing.\\nYou try to keep things simple, but as to how much he understands...",
            "nextDialogs": [
              "722620405"
            ]
          },
          "722620405": {
            "id": "722620405",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Fish!",
            "nextDialogs": [
              "722620406"
            ]
          },
          "722620406": {
            "id": "722620406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it?",
            "nextDialogs": [
              "722620407"
            ]
          },
          "722620407": {
            "id": "722620407",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mmhaha! Fish are silly. Get tricked by food!",
            "nextDialogs": [
              "722620409",
              "722620411"
            ]
          },
          "722620409": {
            "id": "722620409",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, come on!",
            "nextDialogs": [
              "722620413"
            ]
          },
          "722620413": {
            "id": "722620413",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, everyone likes gourmet food!",
            "nextDialogs": [
              "722620414"
            ]
          },
          "722620414": {
            "id": "722620414",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Well then, {NICKNAME}, time to show Kichiboushi what you can do!"
          },
          "722620411": {
            "id": "722620411",
            "speakerId": 1000,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm?"
          }
        }
      }
    },

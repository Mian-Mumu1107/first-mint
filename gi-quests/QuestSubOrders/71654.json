    {
      "subId": "7165402",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716540201"
        ],
        "dialogs": {
          "716540201": {
            "id": "716540201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wow... this teapot seems even bigger inside than Madame Ping's. There's even a great big house in the middle, too!",
            "nextDialogs": [
              "716540202"
            ]
          },
          "716540202": {
            "id": "716540202",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh, but there's just a whole load of nothing around it...",
            "nextDialogs": [
              "716540204",
              "716540206"
            ]
          },
          "716540204": {
            "id": "716540204",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon can't do that! Well, you're the one with a sword, anyway — you do it!",
            "nextDialogs": [
              "716540207"
            ]
          },
          "716540207": {
            "id": "716540207",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Still... why is it so empty here apart from that house?",
            "nextDialogs": [
              "716540208"
            ]
          },
          "716540208": {
            "id": "716540208",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, wait a second, what is that?"
          },
          "716540206": {
            "id": "716540206",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey! There's a perfectly good house right over there. Why should Paimon have to live in a hole in the ground!?"
          }
        }
      }
    },

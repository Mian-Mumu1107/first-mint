{
  "lineCounts": {
    "Fatuus' Journal": 6,
    "The Submerged Ruins Bell's Toll": 1,
    "The Sunken Ruins Bell's Toll": 1
  },
  "subQuests": [
    {
      "subId": "7104301",
      "subQuestName": "Take the path that leads deeper in",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710430101"
        ],
        "dialogs": {
          "710430101": {
            "id": "710430101",
            "speakerId": 20525,
            "speakerName": "Fatuus' Journal",
            "text": "\"...Serzhant Anton has discovered a large bell to the southeast. The rock walls have \"their\" script all over it...\"",
            "nextDialogs": [
              "710430102"
            ]
          },
          "710430102": {
            "id": "710430102",
            "speakerId": 20525,
            "speakerName": "Fatuus' Journal",
            "text": "\"...This is very similar to the large bell that the Kapitan-Poruchik discovered in the ruins to the northwest. Perhaps...\"",
            "nextDialogs": [
              "710430103"
            ]
          },
          "710430103": {
            "id": "710430103",
            "speakerId": 20525,
            "speakerName": "Fatuus' Journal",
            "text": "\"...We dispatched Snezhevna and Fadeyka to ring the two bells in their respective corners...\"",
            "nextDialogs": [
              "710430104"
            ]
          },
          "710430104": {
            "id": "710430104",
            "speakerId": 20525,
            "speakerName": "Fatuus' Journal",
            "text": "\"...As the terrifying tolls reverberated through the stone, the black fog dissipated. What a strange phenomenon... it's almost like the bells were announcing someone's arrival...\"",
            "nextDialogs": [
              "710430105"
            ]
          },
          "710430105": {
            "id": "710430105",
            "speakerId": 20525,
            "speakerName": "Fatuus' Journal",
            "text": "\"...Ten were lost, two vanguard squads took immense damage. The Kapitan-Poruchik ordered a retreat...\"",
            "nextDialogs": [
              "710430106"
            ]
          },
          "710430106": {
            "id": "710430106",
            "speakerId": 20525,
            "speakerName": "Fatuus' Journal",
            "text": "(A simple map falls out from the diary. The map marks out the two bells in the northwest and the southeast, with two ominous skulls to go with them.)"
          }
        }
      }
    },

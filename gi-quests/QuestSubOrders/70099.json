  "subQuests": [
    {
      "subId": "7009901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700990101"
        ],
        "dialogs": {
          "700990101": {
            "id": "700990101",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Some people just won't listen. I already told you, now's not the time to go up the mountain.",
            "nextDialogs": [
              "700990102"
            ]
          },
          "700990102": {
            "id": "700990102",
            "speakerId": 1001,
            "speakerName": "Huffman",
            "text": "Easy there, Old Mann. Let's calm down and talk this out.",
            "nextDialogs": [
              "700990103"
            ]
          },
          "700990103": {
            "id": "700990103",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "We were getting along just fine earlier at the Night Brew, too.",
            "nextDialogs": [
              "700990104"
            ]
          },
          "700990104": {
            "id": "700990104",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "But the moment I mentioned I was heading for Windrest Peak, he grabbed me and dragged me all the way here.",
            "nextDialogs": [
              "700990105"
            ]
          },
          "700990105": {
            "id": "700990105",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh, Huffman. What's going on here?",
            "nextDialogs": [
              "700990106"
            ]
          },
          "700990106": {
            "id": "700990106",
            "speakerId": 1001,
            "speakerName": "Huffman",
            "text": "As you can see, Old Mann is trying his best to keep people away from Windrest Peak.",
            "nextDialogs": [
              "700990107"
            ]
          },
          "700990107": {
            "id": "700990107",
            "speakerId": 1001,
            "speakerName": "Huffman",
            "text": "Anyway, let me introduce you. This is Lipphart, an adventurer.",
            "nextDialogs": [
              "700990108"
            ]
          },
          "700990108": {
            "id": "700990108",
            "speakerId": 1003,
            "speakerName": "Mann",
            "text": "What I saw... What I felt... It was terrifying! Surely you don't wish to hear it?",
            "nextDialogs": [
              "700990109"
            ]
          },
          "700990109": {
            "id": "700990109",
            "speakerId": 1004,
            "speakerName": "Lipphart",
            "text": "Doesn't look like I'm going anywhere today, so let's hear it. Consider it an extension of our drinking and bragging session from earlier.",
            "nextDialogs": [
              "700990110"
            ]
          },
          "700990110": {
            "id": "700990110",
            "speakerId": 1004,
            "speakerName": "Lipphart",
            "text": "So, what sort of \"great peril\" are we facing here?",
            "nextDialogs": [
              "700990111"
            ]
          },
          "700990111": {
            "id": "700990111",
            "speakerId": 1003,
            "speakerName": "Mann",
            "text": "The sanatorium's haunted! Seriously! I saw them ghosts with my own eyes!",
            "nextDialogs": [
              "700990112"
            ]
          },
          "700990112": {
            "id": "700990112",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ghosts!?",
            "nextDialogs": [
              "700990113"
            ]
          },
          "700990113": {
            "id": "700990113",
            "speakerId": 1003,
            "speakerName": "Mann",
            "text": "It happened last night..."
          }
        }
      }
    },

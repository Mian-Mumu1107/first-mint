        ],
        "dialogs": {
          "411220901": {
            "id": "411220901",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "So, how has it gone? Have they all seen the Orders?",
            "nextDialogs": [
              "411220902"
            ]
          },
          "411220902": {
            "id": "411220902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They did, but...",
            "nextDialogs": [
              "411220903"
            ]
          },
          "411220903": {
            "id": "411220903",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "\"But\"? Did something happen?"
          }
        }
      }
    },
    {

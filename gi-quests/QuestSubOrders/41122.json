        "startDialogs": [
          "411225601"
        ],
        "dialogs": {
          "411225601": {
            "id": "411225601",
            "speakerId": 1583,
            "speakerName": "Harry",
            "text": "Oh, I'll be heading out soon. You go first. Once we've both completed our work, we'll meet back here."
          }

            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Welcome... Oh hey, it's you! My gemstone suppliers...",
            "nextDialogs": [
              "740580302"
            ]
          },
          "740580302": {
            "id": "740580302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yup! We brought lots of that ore, as promised!"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7405801",
      "subQuestName": "Talk to Puca",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740580101"
        ],
        "dialogs": {
          "740580101": {
            "id": "740580101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Puca, we're back!",
            "nextDialogs": [
              "740580102"
            ]
          },
          "740580102": {
            "id": "740580102",
            "speakerId": 5322,
            "speakerName": "Puca",
            "text": "#{NICKNAME} and Paimon! Are you here to play with me?",
            "nextDialogs": [
              "740580103"
            ]
          },
          "740580103": {
            "id": "740580103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um, not really! You told us that we could ask you anything related to ore veins and gemstones, right?",
            "nextDialogs": [
              "740580104"
            ]
          },
          "740580104": {
            "id": "740580104",
            "speakerId": 5322,
            "speakerName": "Puca",
            "text": "Yep! I've collected all the pretty stones around the area. What exactly do you wanna ask about?",
            "nextDialogs": [
              "740580105"
            ]
          },
          "740580105": {
            "id": "740580105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's about that stone we found last time...",
            "nextDialogs": [
              "740580106"
            ]
          },
          "740580106": {
            "id": "740580106",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You tell Puca about how you sold the strange ore to the gemstone merchant...",
            "nextDialogs": [
              "740580107"
            ]
          },
          "740580107": {
            "id": "740580107",
            "speakerId": 5322,
            "speakerName": "Puca",
            "text": "Huh? People outside really thought that it was a precious gemstone? But I've even shown it to my sister before... Humans really are hard to understand...",
            "nextDialogs": [
              "740580108"
            ]
          },
          "740580108": {
            "id": "740580108",
            "speakerId": 5322,
            "speakerName": "Puca",
            "text": "But I know a lot of places with stones like this! If you want, I'll show you where they are.",
            "nextDialogs": [
              "740580109"
            ]
          },
          "740580109": {
            "id": "740580109",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Puca marks the locations of the strange ore on your map.",
            "nextDialogs": [
              "740580110"
            ]
          },
          "740580110": {
            "id": "740580110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That'll be great. Thanks, Puca! Oh, right, here's the Mora that Chesil paid us as an advance fee. We could give you half, y'know!",
            "nextDialogs": [
              "740580111"
            ]
          },
          "740580111": {
            "id": "740580111",
            "speakerId": 5322,
            "speakerName": "Puca",
            "text": "Oh, it's alright. We don't really need anything like that in the village, anyway... not to mention how you've helped me so much, too!"
          }
        }
      }
    },
    {
      "subId": "7405804",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740580401"
        ],
        "dialogs": {
          "740580401": {
            "id": "740580401",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Welcome... Oh hey, it's you!",
            "nextDialogs": [
              "740580402"
            ]
          },
          "740580402": {
            "id": "740580402",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Do you have the ore you agreed to bring?",
            "nextDialogs": [
              "740580403"
            ]
          },
          "740580403": {
            "id": "740580403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet.",
            "nextDialogs": [
              "740580404"
            ]
          },
          "740580404": {
            "id": "740580404",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Well, the craftsmen are still processing the previous sample, so it's not too urgent...",
            "nextDialogs": [
              "740580405"
            ]
          },
          "740580405": {
            "id": "740580405",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "But if we managed to get our hands on more supplies, the craftsmen might just become newly inspired, eh?",
            "nextDialogs": [
              "740580406"
            ]
          },
          "740580406": {
            "id": "740580406",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "I'll still be here waiting for your good news."
          }
        }
      }
    },
    {
      "subId": "7405805",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740580501"
        ],
        "dialogs": {
          "740580501": {
            "id": "740580501",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Welcome! We meet again.",
            "nextDialogs": [
              "740580502"
            ]
          },
          "740580502": {
            "id": "740580502",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "The ore you brought last time is still being processed at the moment, so I cannot show you the finished product yet. I'm afraid you must wait a bit longer..."
          }
        }
      }
    },
    {
      "subId": "7405802",
      "subQuestName": "Collect Strange Ore",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740580201"
        ],
        "dialogs": {
          "740580201": {
            "id": "740580201",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Whoa, you found so much... This is an enormous help!",
            "nextDialogs": [
              "740580202"
            ]
          },
          "740580202": {
            "id": "740580202",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "I already sent the ore to the workshop, but I still haven't received my sample product yet. It could be because the artisans aren't familiar with working a gem of this kind and ran into some trouble...",
            "nextDialogs": [
              "740580203"
            ]
          },
          "740580203": {
            "id": "740580203",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "But worry not! I trust my judgment.",
            "nextDialogs": [
              "740580204"
            ]
          },
          "740580204": {
            "id": "740580204",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "I'm planning to turn them into accessories that'll no doubt become the newest craze all across Fontaine.",
            "nextDialogs": [
              "740580205"
            ]
          },
          "740580205": {
            "id": "740580205",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "You'll see what the final product looks like the next time you visit! I'll give you some samples as a gift when the time comes.",
            "nextDialogs": [
              "740580206"
            ]
          },
          "740580206": {
            "id": "740580206",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Or perhaps... you might see the most fashionable of the nobility wearing them before you even arrive, haha.",
            "nextDialogs": [
              "740580207"
            ]
          },
          "740580207": {
            "id": "740580207",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Alright then, you're always welcome to come back another time."
          }
        }
      }
    },
    {
      "subId": "7405803",
      "subQuestName": "Take the ore you've gathered to Chesil",
      "sceneId": null,
      "locations": [],

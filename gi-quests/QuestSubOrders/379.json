    {
      "subId": "37902",
      "subQuestName": "Talk to Venti",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3790201"
        ],
        "dialogs": {
          "3790201": {
            "id": "3790201",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Welcome back!",
            "nextDialogs": [
              "3790202"
            ]
          },
          "3790202": {
            "id": "3790202",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Ah, this is the Holy Lyre! You managed to retrieve it!",
            "nextDialogs": [
              "3790203"
            ]
          },
          "3790203": {
            "id": "3790203",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "The pattern of flowing wind carved on the rosewood... and the strings still feel cool to the touch too. Oh, the memories...",
            "nextDialogs": [
              "3790204"
            ]
          },
          "3790204": {
            "id": "3790204",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "What do you think, Venti? Can you summon Dvalin?",
            "nextDialogs": [
              "3790205"
            ]
          },
          "3790205": {
            "id": "3790205",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Although this lyre is the real thing, I doubt that it's going to work.",
            "nextDialogs": [
              "3790206"
            ]
          },
          "3790206": {
            "id": "3790206",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "As you can see, the lyre has been through a thousand years of history. Its Anemo power has run dry.",
            "nextDialogs": [
              "3790207"
            ]
          },
          "3790207": {
            "id": "3790207",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "In this condition, you couldn't play music fit for even Diluc's tavern with it...",
            "nextDialogs": [
              "3790208"
            ]
          },
          "3790208": {
            "id": "3790208",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "Bards fight to get on the stage of my tavern. Don't make assumptions!",
            "nextDialogs": [
              "3790209"
            ]
          },
          "3790209": {
            "id": "3790209",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Is that really important right now, Master Diluc!?",
            "nextDialogs": [
              "3790210"
            ]
          },
          "3790210": {
            "id": "3790210",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "And you — did you just borrow the Holy Lyre to play music for drunkards to hear?",
            "nextDialogs": [
              "3790211"
            ]
          },
          "3790211": {
            "id": "3790211",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Hehe.",
            "nextDialogs": [
              "3790212"
            ]
          },
          "3790212": {
            "id": "3790212",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "What do you mean \"hehe\"!?",
            "nextDialogs": [
              "3790213"
            ]
          },
          "3790213": {
            "id": "3790213",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Anyway, we won't be able to call Dvalin with it.",
            "nextDialogs": [
              "3790214"
            ]
          },
          "3790214": {
            "id": "3790214",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "The lyre itself is fine, but the strings...",
            "nextDialogs": [
              "3790215"
            ]
          },
          "3790215": {
            "id": "3790215",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "You're up, outlander!",
            "nextDialogs": [
              "3790218"
            ]
          },
          "3790218": {
            "id": "3790218",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Relax! It's not broken.",
            "nextDialogs": [
              "3790219"
            ]
          },
          "3790219": {
            "id": "3790219",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "It's just that the intensity of its Anemo power has greatly diminished.",
            "nextDialogs": [
              "3790220"
            ]
          },
          "3790220": {
            "id": "3790220",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "#{NICKNAME}, do you still have Dvalin's Teardrop Crystal with you?",
            "nextDialogs": [
              "3790221"
            ]
          },
          "3790221": {
            "id": "3790221",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "*nods*"
          }
        }
      }
    },
    {
      "subId": "37903",
      "subQuestName": "Use Dvalin's Teardrop Crystal on the Holy Lyre",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3790301"
        ],
        "dialogs": {
          "3790301": {
            "id": "3790301",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "There's no time to lose. Use it on the Holy Lyre now!"
          }
        }
      }
    },
    {
      "subId": "37904",
      "subQuestName": "Talk to Jean",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3790401"
        ],
        "dialogs": {
          "3790401": {
            "id": "3790401",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "It worked, as expected.",
            "nextDialogs": [
              "3790402"
            ]
          },
          "3790402": {
            "id": "3790402",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "This youthful glow...",
            "nextDialogs": [
              "3790403"
            ]
          },
          "3790403": {
            "id": "3790403",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Praising yourself? Really?",
            "nextDialogs": [
              "3790404"
            ]
          },
          "3790404": {
            "id": "3790404",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "...I was talking about the Holy Lyre.",
            "nextDialogs": [
              "3790405"
            ]
          },
          "3790405": {
            "id": "3790405",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "#Thanks to {NICKNAME} having purified the crystal, the Holy Lyre won't continue to lose power.",
            "nextDialogs": [
              "3790406"
            ]
          },
          "3790406": {
            "id": "3790406",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "That said, its power is far from replenished. It'd be great if we could get more tears.",
            "nextDialogs": [
              "3790408"
            ]
          },
          "3790408": {
            "id": "3790408",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "How can we gather more?",
            "nextDialogs": [
              "3790411"
            ]
          },
          "3790411": {
            "id": "3790411",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "I can surmise that Dvalin will already be crying...",
            "nextDialogs": [
              "3790412"
            ]
          },
          "3790412": {
            "id": "3790412",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Suffering alone in some deserted place...",
            "nextDialogs": [
              "3790413"
            ]
          },
          "3790413": {
            "id": "3790413",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "Dvalin...",
            "nextDialogs": [
              "3790414"
            ]
          },
          "3790414": {
            "id": "3790414",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Poor baby...",
            "nextDialogs": [
              "3790415"
            ]
          },
          "3790415": {
            "id": "3790415",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "This is not something that an Honorary Knight can accomplish alone. I will mobilize the rest of the knights to assist.",
            "nextDialogs": [
              "3790416"
            ]
          },
          "3790416": {
            "id": "3790416",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "#When you get the Teardrop Crystal, please let {NICKNAME} perform the purification process.",
            "nextDialogs": [
              "3790417"
            ]
          },
          "3790417": {
            "id": "3790417",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Leave it to me.",
            "nextDialogs": [
              "3790418"
            ]
          },
          "3790418": {
            "id": "3790418",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Heroes supporting each other and setting out on a journey together... How exciting!",
            "nextDialogs": [
              "3790419"
            ]
          },
          "3790419": {
            "id": "3790419",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Lemme come up with a song for you...",
            "nextDialogs": [
              "3790420"
            ]
          },
          "3790420": {
            "id": "3790420",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Is that all you're going to do? Just sing?",
            "nextDialogs": [
              "3790421"
            ]
          },
          "3790421": {
            "id": "3790421",
            "speakerId": 1000,
            "speakerName": "Venti",
            "text": "Wouldn't be much of a bard if I didn't now, would I?",
            "nextDialogs": [
              "3790422"
            ]
          },
          "3790422": {
            "id": "3790422",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Hmph. You're so cheeky... You deserve an ugly nickname.",
            "nextDialogs": [
              "3790423"
            ]
          },
          "3790423": {
            "id": "3790423",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Oh, Paimon knows! From now on, you'll be known as \"<color=#00E1FFFF>Tone-Deaf Bard</color>\"!"
          }
        }
      }
    }
  ]
}
        ],
        "dialogs": {
          "411490601": {
            "id": "411490601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's the dish you ordered.",
            "nextDialogs": [
              "411490602"
            ]
          },
          "411490602": {
            "id": "411490602",
            "speakerId": 1001,
            "speakerName": "Short-Tempered Wallit",
            "text": "Oh, it's finally here, is it? Give it here — I have things to do and places to be.",
            "nextDialogs": [
              "411490603"
            ]
          },
          "411490603": {
            "id": "411490603",
            "speakerId": 1001,
            "speakerName": "Short-Tempered Wallit",
            "text": "I've heard that you can find suitable brewing ingredients around these parts..."

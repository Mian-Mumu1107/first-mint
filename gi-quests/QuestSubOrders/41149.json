    {
      "subId": "4114903",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411490301"
        ],
        "dialogs": {
          "411490301": {
            "id": "411490301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I heard that someone placed a custom order...",
            "nextDialogs": [
              "411490302"
            ]
          },
          "411490302": {
            "id": "411490302",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "That's right. Great timing, Traveler! Wallit ordered a stack of Tea Break Pancakes from us earlier. Don't worry, he's already paid beforehand.",
            "nextDialogs": [
              "411490303"
            ]
          },
          "411490303": {
            "id": "411490303",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "He wants us to bring it to a place south of Brightcrown Canyon...",
            "nextDialogs": [
              "411490304"
            ]
          },
          "411490304": {
            "id": "411490304",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "But we've been getting more and more take-out orders lately for some reason, and we can barely keep up.",
            "nextDialogs": [
              "411490305"
            ]
          },
          "411490305": {
            "id": "411490305",
            "speakerId": 1000,
            "speakerName": "Sara",
            "text": "If you don't mind, could you help us with this delivery?"
          }
        }
      }
    },

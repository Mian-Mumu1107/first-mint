    {
      "subId": "7902708",
      "subQuestName": "Go collect the treasure",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790271001"
        ],
        "dialogs": {
          "790271001": {
            "id": "790271001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kosekimaru, Kosekimaru!",
            "nextDialogs": [
              "790271002"
            ]
          },
          "790271002": {
            "id": "790271002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We found the treasure. Look, it's a model pirate ship! Your intuition finally worked this time!",
            "nextDialogs": [
              "790271003"
            ]
          },
          "790271003": {
            "id": "790271003",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, what's the other thing you wanted to tell us?",
            "nextDialogs": [
              "790271004"
            ]
          },
          "790271004": {
            "id": "790271004",
            "speakerId": 1002,
            "speakerName": "Kosekimaru",
            "text": "...",
            "nextDialogs": [
              "790271005"
            ]
          },
          "790271005": {
            "id": "790271005",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kosekimaru?",
            "nextDialogs": [
              "790271006"
            ]
          },
          "790271006": {
            "id": "790271006",
            "speakerId": 1002,
            "speakerName": "Kosekimaru",
            "text": "(The ship named Kosekimaru does not respond...)",
            "nextDialogs": [
              "790271009"
            ]
          },
          "790271009": {
            "id": "790271009",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Hmph, but he said he'd tell us when we returned.",
            "nextDialogs": [
              "790271010"
            ]
          },
          "790271010": {
            "id": "790271010",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kosekimaru... you're a big fat liar!"
          }
        }
      }
    },

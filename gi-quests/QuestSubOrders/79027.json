    {
      "subId": "7902706",
      "subQuestName": "Talk to Kosekimaru",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790270601"
        ],
        "dialogs": {
          "790270601": {
            "id": "790270601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whew, that was close. Paimon was sure we were gonna sink!",
            "nextDialogs": [
              "790270602"
            ]
          },
          "790270602": {
            "id": "790270602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kosekimaru, you're amazing!",
            "nextDialogs": [
              "790270603"
            ]
          },
          "790270603": {
            "id": "790270603",
            "speakerId": 1002,
            "speakerName": "Kosekimaru",
            "text": "#Haha, a talking ship is still just a ship. {NICKNAME}'s superb sailing skill was what saw us safely through the storm.",
            "nextDialogs": [
              "790270606"
            ]
          },
          "790270606": {
            "id": "790270606",
            "speakerId": 1002,
            "speakerName": "Kosekimaru",
            "text": "Haha, I'd rather not.",
            "nextDialogs": [
              "790270607"
            ]
          },
          "790270607": {
            "id": "790270607",
            "speakerId": 1002,
            "speakerName": "Kosekimaru",
            "text": "*sigh* I'm afraid I may have triggered the thunderstorm. These waters are less stable than they once were...",
            "nextDialogs": [
              "790270608"
            ]
          },
          "790270608": {
            "id": "790270608",
            "speakerId": 1002,
            "speakerName": "Kosekimaru",
            "text": "#But... we've arrived! {NICKNAME}, Paimon, the treasure is right up there!",
            "nextDialogs": [
              "790270609"
            ]
          },
          "790270609": {
            "id": "790270609",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Isn't this the place we first visited when we were looking for treasure? There was nothing here but half of Kosekimaru's hull!",
            "nextDialogs": [
              "790270610"
            ]
          },
          "790270610": {
            "id": "790270610",
            "speakerId": 1002,
            "speakerName": "Kosekimaru",
            "text": "I am certain that there's treasure up there this time. It's... What did I call it again? It's the intuition of a mighty pirate ship!",
            "nextDialogs": [
              "790270611"
            ]
          },
          "790270611": {
            "id": "790270611",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait a minute... You said you had two things to tell us, right? And the first one was that you'd remembered your name. What was the other one?",
            "nextDialogs": [
              "790270612"
            ]
          },
          "790270612": {
            "id": "790270612",
            "speakerId": 1002,
            "speakerName": "Kosekimaru",
            "text": "Hahaha, I thought you'd already forgotten. I'll tell you when you come back!"
          }
        }
      }
    },

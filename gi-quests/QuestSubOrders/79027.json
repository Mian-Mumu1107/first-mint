  "subQuests": [
    {
      "subId": "7902701",
      "subQuestName": "Talk to Miitoboru",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790270101"
        ],
        "dialogs": {
          "790270101": {
            "id": "790270101",
            "speakerId": 20729,
            "speakerName": "Miitoboru",
            "text": "Ahoy, here you are. I thought you'd be too busy flying around the islands with those wings o' yours.",
            "nextDialogs": [
              "790270102"
            ]
          },
          "790270102": {
            "id": "790270102",
            "speakerId": 20729,
            "speakerName": "Miitoboru",
            "text": "Bet you've long forgotten your old mate Miitoboru, sitting there slowly soaking away in the ocean.",
            "nextDialogs": [
              "790270103"
            ]
          },
          "790270103": {
            "id": "790270103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're here now, aren't we!",
            "nextDialogs": [
              "790270104"
            ]
          },
          "790270104": {
            "id": "790270104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, you said you needed our help. What's up?",
            "nextDialogs": [
              "790270105"
            ]
          },
          "790270105": {
            "id": "790270105",
            "speakerId": 20729,
            "speakerName": "Miitoboru",
            "text": "It's not that important... Remember when you helped me find the missing pieces of my body?",
            "nextDialogs": [
              "790270106"
            ]
          },
          "790270106": {
            "id": "790270106",
            "speakerId": 20729,
            "speakerName": "Miitoboru",
            "text": "How can I put it... I'm not sure if it's because I've fulfilled my wishes, or if these waters are slowly diminishing my ability to talk...",
            "nextDialogs": [
              "790270107"
            ]
          },
          "790270107": {
            "id": "790270107",
            "speakerId": 20729,
            "speakerName": "Miitoboru",
            "text": "Recently, I find myself sleeping most of the time rather than staying conscious...",
            "nextDialogs": [
              "790270110"
            ]
          },
          "790270110": {
            "id": "790270110",
            "speakerId": 20729,
            "speakerName": "Miitoboru",
            "text": "#I see... So it's because of some contraption that I became your Waverider and could communicate with you, {NICKNAME}...",
            "nextDialogs": [
              "790270111"
            ]
          },
          "790270111": {
            "id": "790270111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh... Does that mean that once the effects of the machine wear off, Miitoboru won't be able to talk anymore?",
            "nextDialogs": [
              "790270112"
            ]
          },
          "790270112": {
            "id": "790270112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#We gotta do something before it's too late, {NICKNAME}...",
            "nextDialogs": [
              "790270113"
            ]
          },
          "790270113": {
            "id": "790270113",
            "speakerId": 20729,
            "speakerName": "Miitoboru",
            "text": "Haha, there'll be no need for that, Paimon... I am quite content that I had the chance to talk to you at all.",
            "nextDialogs": [
              "790270114"
            ]
          },
          "790270114": {
            "id": "790270114",
            "speakerId": 20729,
            "speakerName": "Miitoboru",
            "text": "Argh... The more I think about it, for me, as a ship, to have gotten to talk to you in the past few days... It really is a wondrous thing, the stuff dreams are made of...",
            "nextDialogs": [
              "790270115"
            ]
          },
          "790270115": {
            "id": "790270115",
            "speakerId": 20729,
            "speakerName": "Miitoboru",
            "text": "But now, I need to ask you for one more favor...",
            "nextDialogs": [
              "790270116"
            ]
          },
          "790270116": {
            "id": "790270116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell us.",
            "nextDialogs": [
              "790270117"
            ]
          },
          "790270117": {
            "id": "790270117",
            "speakerId": 20729,
            "speakerName": "Miitoboru",
            "text": "Remember when I told you that once we found my body, I'd take you for a cruise? Well, it seems my body was reduced to a slew of sorry shipwrecks...",
            "nextDialogs": [
              "790270125"
            ]
          },
          "790270125": {
            "id": "790270125",
            "speakerId": 20729,
            "speakerName": "Miitoboru",
            "text": "And most of the treasure was taken away, leaving nothing good for you...",
            "nextDialogs": [
              "790270118"
            ]
          },
          "790270118": {
            "id": "790270118",
            "speakerId": 20729,
            "speakerName": "Miitoboru",
            "text": "But this time, I swear as a mighty pirate ship, there be treasure ahoy, and a fine treasure at that! Or else may I be strangled by seagrass and fed to the fish! Just trust me one last time!",
            "nextDialogs": [
              "790270119"
            ]
          },
          "790270119": {
            "id": "790270119",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Well, {NICKNAME}, since Miitoboru probably won't be able to speak soon...",
            "nextDialogs": [
              "790270120"
            ]
          },
          "790270120": {
            "id": "790270120",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#And... Since there really is treasure this time... Let's go, {NICKNAME}!"
          }
        }
      }
    },

          "706950101": {
            "id": "706950101",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Dragonspine can be a cold and miserable place. If you're gonna invite spectators to come and watch an event here, you gotta make it worth their while.",
            "nextDialogs": [
              "706950102"
            ]
          },
          "706950102": {
            "id": "706950102",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Hopefully, these stalls will keep people entertained and make the atmosphere in the camp more relaxed.",
            "nextDialogs": [
              "706950103"
            ]
          },
          "706950103": {
            "id": "706950103",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "I'm also taking the chance to hand out some little trinkets for the teams to decorate their tents with.",
            "nextDialogs": [
              "706950104"
            ]
          },
          "706950104": {
            "id": "706950104",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Here you go — these are for The Soulblazers.",
            "nextDialogs": [
              "706950105"
            ]
          },
          "706950105": {
            "id": "706950105",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Best of luck in the competition, and don't forget to have fun!"
          }
        }
      }
    }
  ]

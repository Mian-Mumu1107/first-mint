  "subQuests": [
    {
      "subId": "7211301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130101"
        ],
        "dialogs": {
          "721130101": {
            "id": "721130101",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "You want a fortune slip?",
            "nextDialogs": [
              "721130102"
            ]
          },
          "721130102": {
            "id": "721130102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Geez, she's so cold.",
            "nextDialogs": [
              "721130103"
            ]
          },
          "721130103": {
            "id": "721130103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, I'd like one...",
            "nextDialogs": [
              "721130104"
            ]
          },
          "721130104": {
            "id": "721130104",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Got it. Here's how it goes. First, shake this... thing over here.",
            "nextDialogs": [
              "721130105"
            ]
          },
          "721130105": {
            "id": "721130105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Isn't it called a Fortune Slip Box?",
            "nextDialogs": [
              "721130106"
            ]
          },
          "721130106": {
            "id": "721130106",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Yes. A Bamboo Slip will drop out from it. Give it to me, and I'll give you a matching strip of paper.",
            "nextDialogs": [
              "721130107"
            ]
          },
          "721130107": {
            "id": "721130107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm pretty sure they say it's a Fortune Slip...",
            "nextDialogs": [
              "721130108"
            ]
          },
          "721130108": {
            "id": "721130108",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Whatever.",
            "nextDialogs": [
              "721130109"
            ]
          },
          "721130109": {
            "id": "721130109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's got a question! If... What do we do if we get one that means bad luck?",
            "nextDialogs": [
              "721130110"
            ]
          },
          "721130110": {
            "id": "721130110",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "It's fate. You got a problem with that? Huh?",
            "nextDialogs": [
              "721130111"
            ]
          },
          "721130111": {
            "id": "721130111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh!?",
            "nextDialogs": [
              "721130112"
            ]
          },
          "721130112": {
            "id": "721130112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Isn't there that shelf-like thing outside we can use to...",
            "nextDialogs": [
              "721130113"
            ]
          },
          "721130113": {
            "id": "721130113",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Tsk.",
            "nextDialogs": [
              "721130114"
            ]
          },
          "721130114": {
            "id": "721130114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did she seriously just say \"tsk\"?",
            "nextDialogs": [
              "721130115"
            ]
          },
          "721130115": {
            "id": "721130115",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Let me see... Oh right, so it's like this. \"Tie the inauspicious slip onto the Fortune Slip Hanger to change ill fortune to good\"...",
            "nextDialogs": [
              "721130116"
            ]
          },
          "721130116": {
            "id": "721130116",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Ah, right! If you get a slip with ill fortune, just tie it to that shelf, that'll do.",
            "nextDialogs": [
              "721130117"
            ]
          },
          "721130117": {
            "id": "721130117",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Huh, what a bunch of... No, sorry. We at the Grand Narukami Shrine are most gentle indeed. Even if you should draw a slip with bad luck, you shall have a chance to turn it around.",
            "nextDialogs": [
              "721130118"
            ]
          },
          "721130118": {
            "id": "721130118",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Something about this doesn't seem right...",
            "nextDialogs": [
              "721130119"
            ]
          },
          "721130119": {
            "id": "721130119",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Let's go draw a slip, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "7211302",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130201"
        ],
        "dialogs": {
          "721130201": {
            "id": "721130201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let Paimon see, let Paimon see.",
            "nextDialogs": [
              "721130202"
            ]
          },
          "721130202": {
            "id": "721130202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow! It says very auspicious. Yeah!",
            "nextDialogs": [
              "721130203"
            ]
          },
          "721130203": {
            "id": "721130203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like today's Paimon's lucky day!",
            "nextDialogs": [
              "721130204"
            ]
          },
          "721130204": {
            "id": "721130204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yours?",
            "nextDialogs": [
              "721130205"
            ]
          },
          "721130205": {
            "id": "721130205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's right! Your fortune is Paimon's fortune! And vice versa, Paimon's fortune is also your fortune.",
            "nextDialogs": [
              "721130206"
            ]
          },
          "721130206": {
            "id": "721130206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "When Paimon eats good food, that's good fortune. So, for the sake of your fortune, please give Paimon some good food."
          }
        }
      }
    },
    {
      "subId": "7211303",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130301"
        ],
        "dialogs": {
          "721130301": {
            "id": "721130301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let Paimon see, let Paimon see.",
            "nextDialogs": [
              "721130302"
            ]
          },
          "721130302": {
            "id": "721130302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, not bad.",
            "nextDialogs": [
              "721130303"
            ]
          },
          "721130303": {
            "id": "721130303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Being with Paimon will certainly bring you good fortune!"
          }
        }
      }
    },
    {
      "subId": "7211304",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130401"
        ],
        "dialogs": {
          "721130401": {
            "id": "721130401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let Paimon see, let Paimon see.",
            "nextDialogs": [
              "721130402"
            ]
          },
          "721130402": {
            "id": "721130402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh, it's inauspicious!",
            "nextDialogs": [
              "721130403"
            ]
          },
          "721130403": {
            "id": "721130403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon remembers this scenario! It said... to \"tie the inauspicious slip onto the Fortune Slip Hanger.\"",
            "nextDialogs": [
              "721130404"
            ]
          },
          "721130404": {
            "id": "721130404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"And then treat Paimon to some good food. That will help change the bad luck into good!\"",
            "nextDialogs": [
              "721130405"
            ]
          },
          "721130405": {
            "id": "721130405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is that so?",
            "nextDialogs": [
              "721130406"
            ]
          },
          "721130406": {
            "id": "721130406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Of course! Are you questioning the wisdom of the ancients?",
            "nextDialogs": [
              "721130407"
            ]
          },
          "721130407": {
            "id": "721130407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The wisdom of the ancients is incredible! Anyway, let's find the Fortune Slip Hanger first!"
          }
        }
      }
    },
    {
      "subId": "7211306",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130601"
        ],
        "dialogs": {
          "721130601": {
            "id": "721130601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? What's this? Looks like someone's notes. Let Paimon see...",
            "nextDialogs": [
              "721130602"
            ]
          },
          "721130602": {
            "id": "721130602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"... Shuumatsu... Fatui... plot against...\"",
            "nextDialogs": [
              "721130603"
            ]
          },
          "721130603": {
            "id": "721130603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What is this? It's a mess, and it's all covered in stains. Paimon can't really read it.",
            "nextDialogs": [
              "721130604"
            ]
          },
          "721130604": {
            "id": "721130604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Could be a clue to some treasure.",
            "nextDialogs": [
              "721130605"
            ]
          },
          "721130605": {
            "id": "721130605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That makes sense! Let Paimon have another look.",
            "nextDialogs": [
              "721130606"
            ]
          },
          "721130606": {
            "id": "721130606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"... when deciphering the slip, the secret code... \"",
            "nextDialogs": [
              "721130609"
            ]
          },
          "721130609": {
            "id": "721130609",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let Paimon see! \"...The first half is 'In the middle of a hazy night'... \"",
            "nextDialogs": [
              "721130610"
            ]
          },
          "721130610": {
            "id": "721130610",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It cuts off here, and Paimon can't tell what the second half is.",
            "nextDialogs": [
              "721130611"
            ]
          },
          "721130611": {
            "id": "721130611",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But since it used a secret code, there must be some kind of secret to be found, right?",
            "nextDialogs": [
              "721130612"
            ]
          },
          "721130612": {
            "id": "721130612",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Either way, this seems important. Next time we decipher our fortune slip, let's try to match the secret codes, shall we?"
          }
        }
      }
    },
    {
      "subId": "7211312",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721131101"
        ],
        "dialogs": {
          "721131101": {
            "id": "721131101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#(Hey, {NICKNAME}!)",
            "nextDialogs": [
              "721131102"
            ]
          },
          "721131102": {
            "id": "721131102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(According to that Ms. Gendou, this Ms. Gendou is...)",
            "nextDialogs": [
              "721131103"
            ]
          },
          "721131103": {
            "id": "721131103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Yeah, a Fatui knockoff.)",
            "nextDialogs": [
              "721131104"
            ]
          },
          "721131104": {
            "id": "721131104",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Ah, we meet again. Want to check your fortune as well? Or...",
            "nextDialogs": [
              "721131105"
            ]
          },
          "721131105": {
            "id": "721131105",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "If you need a listening ear or if you have something to discuss, I can help too.",
            "nextDialogs": [
              "721131108"
            ]
          },
          "721131108": {
            "id": "721131108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ms. Gendou is so friendly!",
            "nextDialogs": [
              "721131109"
            ]
          },
          "721131109": {
            "id": "721131109",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Is that so? Hehe, that's what many people have told me lately. It feels good.",
            "nextDialogs": [
              "721131110"
            ]
          },
          "721131110": {
            "id": "721131110",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "It's always been my dream to work at a beautiful shrine like this.",
            "nextDialogs": [
              "721131111"
            ]
          },
          "721131111": {
            "id": "721131111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(She is a Fatuus in disguise.)",
            "nextDialogs": [
              "721131112"
            ]
          },
          "721131112": {
            "id": "721131112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(Hmm... but she's quite friendly...)"
          }
        }
      }
    },
    {
      "subId": "7211308",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130801"
        ],
        "dialogs": {
          "721130801": {
            "id": "721130801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Where did Ms. Gendou go?",
            "nextDialogs": [
              "721130802"
            ]
          },
          "721130802": {
            "id": "721130802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, this is slightly distressing...",
            "nextDialogs": [
              "721130803"
            ]
          },
          "721130803": {
            "id": "721130803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right? What if she doesn't return? How will Paimon know today's fortune?",
            "nextDialogs": [
              "721130804"
            ]
          },
          "721130804": {
            "id": "721130804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? There's a slip here. Let Paimon have a look...",
            "nextDialogs": [
              "721130805"
            ]
          },
          "721130805": {
            "id": "721130805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We shouldn't...",
            "nextDialogs": [
              "721130806"
            ]
          },
          "721130806": {
            "id": "721130806",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It doesn't matter! It could be a clue!",
            "nextDialogs": [
              "721130807"
            ]
          },
          "721130807": {
            "id": "721130807",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? This is...",
            "nextDialogs": [
              "721130808"
            ]
          },
          "721130808": {
            "id": "721130808",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems like we're to go to... this place and receive further instructions...?",
            "nextDialogs": [
              "721130809"
            ]
          },
          "721130809": {
            "id": "721130809",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's go find out!"
          }
        }
      }
    },
    {
      "subId": "7211314",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130701"
        ],
        "dialogs": {
          "721130701": {
            "id": "721130701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ms. Gendou's attitude is the same as ever, huh... Anyway, let's check the slip's contents.",
            "nextDialogs": [
              "721130702"
            ]
          },
          "721130702": {
            "id": "721130702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? This is...",
            "nextDialogs": [
              "721130703"
            ]
          },
          "721130703": {
            "id": "721130703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, Paimon gets it. This must refer to some bad guy who needs defeating!",
            "nextDialogs": [
              "721130704"
            ]
          },
          "721130704": {
            "id": "721130704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, that's gotta be it. So, Ms. Gendou, you're a secret agent who's using this method to communicate and wipe out those who try to harm Inazuma, right?",
            "nextDialogs": [
              "721130705"
            ]
          },
          "721130705": {
            "id": "721130705",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "You talk too much.",
            "nextDialogs": [
              "721130706"
            ]
          },
          "721130706": {
            "id": "721130706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Welp! S-sorry! Please don't sic the \"Shuumatsu\" on us!",
            "nextDialogs": [
              "721130707"
            ]
          },
          "721130707": {
            "id": "721130707",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Leave now.",
            "nextDialogs": [
              "721130708"
            ]
          },
          "721130708": {
            "id": "721130708",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're leaving right now! Let's go to the place shown in the picture and see if we can find our target!"
          }
        }
      }
    },
    {
      "subId": "7211309",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130901"
        ],
        "dialogs": {
          "721130901": {
            "id": "721130901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This is the place, right?",
            "nextDialogs": [
              "721130902"
            ]
          },
          "721130902": {
            "id": "721130902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's nothing special here...",
            "nextDialogs": [
              "721130903"
            ]
          },
          "721130903": {
            "id": "721130903",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "You showed up indeed, just as I expected."
          }
        }
      }
    },
    {
      "subId": "7211311",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721131001"
        ],
        "dialogs": {
          "721131001": {
            "id": "721131001",
            "speakerId": 20317,
            "speakerName": "Gendou Ringo",
            "text": "Who are you, exactly, and what are your intentions?",
            "nextDialogs": [
              "721131002"
            ]
          },
          "721131002": {
            "id": "721131002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's our line! What were you doing, Ms. Gendou, attacking us like that?",
            "nextDialogs": [
              "721131003"
            ]
          },
          "721131003": {
            "id": "721131003",
            "speakerId": 20317,
            "speakerName": "Gendou Ringo",
            "text": "How rude. Answer my question.",
            "nextDialogs": [
              "721131004"
            ]
          },
          "721131004": {
            "id": "721131004",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#I'm {NICKNAME}.",
            "nextDialogs": [
              "721131005"
            ]
          },
          "721131005": {
            "id": "721131005",
            "speakerId": 20317,
            "speakerName": "Gendou Ringo",
            "text": "Oh, I know your names, alright. Now, tell me. Where did you hear the secret code from?",
            "nextDialogs": [
              "721131007",
              "721131009"
            ]
          },
          "721131007": {
            "id": "721131007",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, what are you saying!? Just tell Ms. Gendou what happened already! Can't you see the super scary look in her eyes?",
            "nextDialogs": [
              "721131010"
            ]
          },
          "721131010": {
            "id": "721131010",
            "speakerId": 20317,
            "speakerName": "Gendou Ringo",
            "text": "I see. So you chanced upon those notes. In that case, Momoka must be...",
            "nextDialogs": [
              "721131011"
            ]
          },
          "721131011": {
            "id": "721131011",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Who's Momoka?",
            "nextDialogs": [
              "721131012"
            ]
          },
          "721131012": {
            "id": "721131012",
            "speakerId": 20317,
            "speakerName": "Gendou Ringo",
            "text": "She was the one who penned those notes, and she was a colleague of mine. Unfortunately, she will no longer be able to continue serving Inazuma. A true shame...",
            "nextDialogs": [
              "721131013"
            ]
          },
          "721131013": {
            "id": "721131013",
            "speakerId": 20317,
            "speakerName": "Gendou Ringo",
            "text": "I'm sure you must have many questions. I suppose it couldn't hurt to answer them.",
            "nextDialogs": [
              "721131014"
            ]
          },
          "721131014": {
            "id": "721131014",
            "speakerId": 20317,
            "speakerName": "Gendou Ringo",
            "text": "Momoka and I are both ninja of the Shuumatsuban. Our task is to rid Inazuma of external threats, and these \"strips of paper\" are one of the ways in which we communicate our missions.",
            "nextDialogs": [
              "721131015"
            ]
          },
          "721131015": {
            "id": "721131015",
            "speakerId": 20317,
            "speakerName": "Gendou Ringo",
            "text": "As a result, we have also endured a lot of resentment and peril. For example, from those dangerous people who have infiltrated our nation..."
          },
          "721131009": {
            "id": "721131009",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We found an abandoned camp on a hill..."
          }
        }
      }
    },
    {
      "subId": "7211305",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130501"
        ],
        "dialogs": {
          "721130501": {
            "id": "721130501",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Give me that bamboo slip.",
            "nextDialogs": [
              "721130502"
            ]
          },
          "721130502": {
            "id": "721130502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "R—Right.",
            "nextDialogs": [
              "721130503"
            ]
          },
          "721130503": {
            "id": "721130503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This shrine really seems to lack the whole divine affection thing, huh...",
            "nextDialogs": [
              "721130504"
            ]
          },
          "721130504": {
            "id": "721130504",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Here.",
            "nextDialogs": [
              "721130505"
            ]
          },
          "721130505": {
            "id": "721130505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's see how our luck's going...",
            "nextDialogs": [
              "721130506"
            ]
          },
          "721130506": {
            "id": "721130506",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Ah, yes. You can only draw one fortune slip each day. Please remember that.",
            "nextDialogs": [
              "721130507"
            ]
          },
          "721130507": {
            "id": "721130507",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "It's too tiring otherwise... Wait, no. If not, you won't be able to use the Fortune Slip Hanger to... No, that's not right either. What was I supposed to say?",
            "nextDialogs": [
              "721130508"
            ]
          },
          "721130508": {
            "id": "721130508",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "\"Fortune slips are the manifestation of our archon's will. It is our place as mortals to respect it and do all we can.\"",
            "nextDialogs": [
              "721130509"
            ]
          },
          "721130509": {
            "id": "721130509",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "See? Elegantly put. So please remember, you can only draw one fortune slip each day."
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "7151301",
      "subQuestName": "Talk to Huixing",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715130301"
        ],
        "dialogs": {
          "715130301": {
            "id": "715130301",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "Looking great, no? All of the decorations were handpicked by the Captain. She wanted her brothers and sisters on duty to feel like they were at home for the festival!",
            "nextDialogs": [
              "715130302"
            ]
          },
          "715130302": {
            "id": "715130302",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "Not only that, before the Lantern Rite, the Captain gave each of us a bonus and organized several big feasts.",
            "nextDialogs": [
              "715130303"
            ]
          },
          "715130303": {
            "id": "715130303",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "The food for every feast is ordered from reputable restaurants, such as the Wanmin Restaurant, which we always frequent, and Xinyue Kiosk and Liuli Pavilion.",
            "nextDialogs": [
              "715130304"
            ]
          },
          "715130304": {
            "id": "715130304",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "Everyone ate and drank their fill!",
            "nextDialogs": [
              "715130305"
            ]
          },
          "715130305": {
            "id": "715130305",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon wants to check those out, too!",
            "nextDialogs": [
              "715130306"
            ]
          },
          "715130306": {
            "id": "715130306",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, a bonus and a feast? That's great! Paimon had no idea that Beidou also had such an eye for detail!",
            "nextDialogs": [
              "715130307"
            ]
          },
          "715130307": {
            "id": "715130307",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "Actually, the Captain has always been meticulously keeping the fleet's affairs in order.",
            "nextDialogs": [
              "715130308"
            ]
          },
          "715130308": {
            "id": "715130308",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "Not only do we crew members get paid very well, but during past Lantern Rites, she's also prepared gifts for our families!",
            "nextDialogs": [
              "715130309"
            ]
          },
          "715130309": {
            "id": "715130309",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "Before, the Captain got some business information from the Tianquan on how to improve management strategy for the Crux.",
            "nextDialogs": [
              "715130310"
            ]
          },
          "715130310": {
            "id": "715130310",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "The revenue of the fleet has soared, so the Captain has also increased our pay. In this way, the crew will be in tip-top shape for any challenge.",
            "nextDialogs": [
              "715130311"
            ]
          },
          "715130311": {
            "id": "715130311",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "When the new recruits hear about how well the Crux fleet treats its crew, they'll be extra motivated.",
            "nextDialogs": [
              "715130314"
            ]
          },
          "715130314": {
            "id": "715130314",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh? During Lantern Rite, shouldn't everyone be on vacation? You guys seem to be... working overtime.",
            "nextDialogs": [
              "715130315"
            ]
          },
          "715130315": {
            "id": "715130315",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "It's not like that, don't worry!",
            "nextDialogs": [
              "715130316"
            ]
          },
          "715130316": {
            "id": "715130316",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "The Captain has done all the research in advance. Some of the crew were given early leave, while the others were given days off later on.",
            "nextDialogs": [
              "715130317"
            ]
          },
          "715130317": {
            "id": "715130317",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "Thus, everyone gets time off, and there will always be someone to man the Alcor!",
            "nextDialogs": [
              "715130318"
            ]
          },
          "715130318": {
            "id": "715130318",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "I was among the group that got earlier vacation time, and I came back to my post completely refreshed! I'm currently getting ready for my training examination: \"Vigilance at Sea.\"",
            "nextDialogs": [
              "715130319"
            ]
          },
          "715130319": {
            "id": "715130319",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Vigilant... what now?"
          }
        }
      }
    },
    {
      "subId": "7151301",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715130101"
        ],
        "dialogs": {
          "715130101": {
            "id": "715130101",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "#Hello, {NICKNAME} and Paimon. Happy Lantern Rite!",
            "nextDialogs": [
              "715130102"
            ]
          },
          "715130102": {
            "id": "715130102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Thank you! Paimon also wishes you well!",
            "nextDialogs": [
              "715130103"
            ]
          },
          "715130103": {
            "id": "715130103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Happy Lantern Rite!",
            "nextDialogs": [
              "715130104"
            ]
          },
          "715130104": {
            "id": "715130104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, how do you know us? Are you...",
            "nextDialogs": [
              "715130105"
            ]
          },
          "715130105": {
            "id": "715130105",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "I'm Huixing, the navigator of the Crux fleet. I'm also responsible for fleet-related events for this Lantern Rite.",
            "nextDialogs": [
              "715130106"
            ]
          },
          "715130106": {
            "id": "715130106",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "I heard about your stories from Captain Beidou. You guys are also brave heroes, how admirable!",
            "nextDialogs": [
              "715130107"
            ]
          },
          "715130107": {
            "id": "715130107",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "If you have any questions about the Alcor, I will do my best to give you a detailed, thorough answer!",
            "nextDialogs": [
              "715130108"
            ]
          },
          "715130108": {
            "id": "715130108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "How nice!",
            "nextDialogs": [
              "715130109"
            ]
          },
          "715130109": {
            "id": "715130109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We definitely want to know more about the Alcor, and if we're curious about anything, we'll definitely ask you.",
            "nextDialogs": [
              "715130110"
            ]
          },
          "715130110": {
            "id": "715130110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "In fact, this time, the Alcor has a lot of seaborne goods and decorations, and it's as bustling as in the city!"
          }
        }
      }
    },
    {
      "subId": "7151302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715130201"
        ],
        "dialogs": {
          "715130201": {
            "id": "715130201",
            "speakerId": 1000,
            "speakerName": "Huixing",
            "text": "#Long time no see, {NICKNAME} and Paimon! Happy Lantern Rite!",
            "nextDialogs": [
              "715130202"
            ]
          },
          "715130202": {
            "id": "715130202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Thank you, Huixing! Paimon also wishes you well!",
            "nextDialogs": [
              "715130203"
            ]
          },
          "715130203": {
            "id": "715130203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Happy Lantern Rite!",
            "nextDialogs": [
              "715130204"
            ]
          },
          "715130204": {
            "id": "715130204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We've seen that the Alcor has a lot of seaborne goods and decorations, and it's as bustling as in the city!"
          }
        }
      }
    }
  ]
}
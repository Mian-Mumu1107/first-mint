  "subQuests": [
    {
      "subId": "7004801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700480101"
        ],
        "dialogs": {
          "700480101": {
            "id": "700480101",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "#Ah, it's you, {NICKNAME}. Sorry, I didn't realize you were here...",
            "nextDialogs": [
              "700480102"
            ]
          },
          "700480102": {
            "id": "700480102",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "This resort is huge, and there's barely anyone I recognize. Luckily, I've run into you.",
            "nextDialogs": [
              "700480103"
            ]
          },
          "700480103": {
            "id": "700480103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you up to, Freminet?",
            "nextDialogs": [
              "700480104"
            ]
          },
          "700480104": {
            "id": "700480104",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "I'm observing the sea around Natlan. There are aquatic creatures here I've never seen before, like those two over there.",
            "nextDialogs": [
              "700480109",
              "700480107"
            ]
          },
          "700480109": {
            "id": "700480109",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Natlan's ecology is so different from Fontaine's, it's truly something special. If only everyone from the \"House\" could come here to see it...",
            "nextDialogs": [
              "700480110"
            ]
          },
          "700480110": {
            "id": "700480110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You could always show them pictures of the resort. I'll help.",
            "nextDialogs": [
              "700480111"
            ]
          },
          "700480111": {
            "id": "700480111",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Pictures? That's a wonderful idea! That way, I can record the scenery so I never forget.",
            "nextDialogs": [
              "700480112"
            ]
          },
          "700480112": {
            "id": "700480112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And we'll get a picture of you while we're at it.",
            "nextDialogs": [
              "700480113"
            ]
          },
          "700480113": {
            "id": "700480113",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "A picture of... me? Really?",
            "nextDialogs": [
              "700480114"
            ]
          },
          "700480114": {
            "id": "700480114",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "I, umm, I'm not turning you down... I'm just not used to standing in front of a Kamera.",
            "nextDialogs": [
              "700480115"
            ]
          },
          "700480115": {
            "id": "700480115",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "\"Father\" once told me that if I kept hiding myself away, I'd end up worrying those who care about me.",
            "nextDialogs": [
              "700480116"
            ]
          },
          "700480116": {
            "id": "700480116",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "So... I've been wanting to kick this bad habit. Alright, since you offered, I guess it's time to get my picture taken!",
            "nextDialogs": [
              "700480117"
            ]
          },
          "700480117": {
            "id": "700480117",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Ah... Do you have any ideas for how I should pose?"
          },
          "700480107": {
            "id": "700480107",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "The Iudex...? They look so different. I can't believe they're related.",
            "nextDialogs": [
              "700480108"
            ]
          },
          "700480108": {
            "id": "700480108",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Could it be that the same organisms grow differently depending on whether they live in Fontaine or Natlan?"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7304204",
      "subQuestName": "Talk to Arakanta",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730420601"
        ],
        "dialogs": {
          "730420601": {
            "id": "730420601",
            "speakerId": 4197,
            "speakerName": "Arakanta",
            "text": "So much fun! Arakanta is very happy playing games with Golden Nara! And Nara is so fast! So amazing! Like a real tiger!",
            "nextDialogs": [
              "730420602"
            ]
          },
          "730420602": {
            "id": "730420602",
            "speakerId": 4197,
            "speakerName": "Arakanta",
            "text": "It is fun playing with other Aranara and real Rishboland Tigers, but playing with our new friend, our Nara friend, is even more fun!",
            "nextDialogs": [
              "730420603"
            ]
          },
          "730420603": {
            "id": "730420603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why would the Rishboland Tiger chase Aranara?",
            "nextDialogs": [
              "730420604"
            ]
          },
          "730420604": {
            "id": "730420604",
            "speakerId": 4197,
            "speakerName": "Arakanta",
            "text": "The Rishboland Tiger and Aranara are friends, and friends play together. But Arakanta noticed that Nara are afraid of the Rishboland Tiger. That's why Arakanta came up with a new game for Festival Utsava!",
            "nextDialogs": [
              "730420605"
            ]
          },
          "730420605": {
            "id": "730420605",
            "speakerId": 4197,
            "speakerName": "Arakanta",
            "text": "Thank you, Nara. Here is an Aranara flower for Golden Nara!"
          }
        }
      }
    },
    {
      "subId": "7304201",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730420101"
        ],
        "dialogs": {
          "730420101": {
            "id": "730420101",
            "speakerId": 4197,
            "speakerName": "Arakanta",
            "text": "Golden Nara, Arakanta has heard so much about you. You are a good Nara. Will you play with Arakanta?",
            "nextDialogs": [
              "730420102"
            ]
          },
          "730420102": {
            "id": "730420102",
            "speakerId": 4197,
            "speakerName": "Arakanta",
            "text": "Arakanta's game is simple and fun! Listen to the rules, Nara...",
            "nextDialogs": [
              "730420103"
            ]
          },
          "730420103": {
            "id": "730420103",
            "speakerId": 4197,
            "speakerName": "Arakanta",
            "text": "Arakanta will summon a lot of Dendro particles, which are \"Aranara\" hiding in the circle. Nara is a big and powerful \"Rishboland Tiger.\" Come and chase \"Aranara\"!",
            "nextDialogs": [
              "730420104"
            ]
          },
          "730420104": {
            "id": "730420104",
            "speakerId": 4197,
            "speakerName": "Arakanta",
            "text": "If the \"Rishboland Tiger\" catches all the Aranara in a short time, then Nara wins!",
            "nextDialogs": [
              "730420105"
            ]
          },
          "730420105": {
            "id": "730420105",
            "speakerId": 4197,
            "speakerName": "Arakanta",
            "text": "Good? Nara willing to play game with Arakanta now?"
          }
        }
      }
    },

    {
      "subId": "7450801",
      "subQuestName": "Talk to the two people at the stall",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745080101"
        ],
        "dialogs": {
          "745080101": {
            "id": "745080101",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "After a while, you and Paimon arrive at the Lil' Fungi's Fun-Tastic Fiesta booth...",
            "nextDialogs": [
              "745080102"
            ]
          },
          "745080102": {
            "id": "745080102",
            "speakerId": 1001,
            "speakerName": "Enghiene",
            "text": "Mmm! I love these soft, bouncy, smooth, squishy Fungi! Hehe, I want to keep playing!",
            "nextDialogs": [
              "745080103"
            ]
          },
          "745080103": {
            "id": "745080103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And you are...",
            "nextDialogs": [
              "745080104"
            ]
          },
          "745080104": {
            "id": "745080104",
            "speakerId": 1001,
            "speakerName": "Enghiene",
            "text": "I'm Enghiene, and I was Turenna's drillmaster before she entered the Special Patrol!",
            "nextDialogs": [
              "745080105"
            ]
          },
          "745080105": {
            "id": "745080105",
            "speakerId": 1001,
            "speakerName": "Enghiene",
            "text": "I'm nothing like her, you hear? Nothing! I'm not going to grovel before you just because you're Super Zenith Boss-Level Forces!",
            "nextDialogs": [
              "745080106"
            ]
          },
          "745080106": {
            "id": "745080106",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Uh, so this super arrogant Melusine... used to be Turenna's drillmaster?",
            "nextDialogs": [
              "745080107"
            ]
          },
          "745080107": {
            "id": "745080107",
            "speakerId": 1003,
            "speakerName": "Haniyyah",
            "text": "Don't worry, Golden Comet, Silver Companion!",
            "nextDialogs": [
              "745080108"
            ]
          },
          "745080108": {
            "id": "745080108",
            "speakerId": 1003,
            "speakerName": "Haniyyah",
            "text": "Ms. Turenna received new orders not long ago, and has returned to the Special Patrol's base.",
            "nextDialogs": [
              "745080109"
            ]
          },
          "745080109": {
            "id": "745080109",
            "speakerId": 1003,
            "speakerName": "Haniyyah",
            "text": "Before departing, she asked Ms. Enghiene to watch the event area in her place.",
            "nextDialogs": [
              "745080110"
            ]
          },
          "745080110": {
            "id": "745080110",
            "speakerId": 1003,
            "speakerName": "Haniyyah",
            "text": "She loves Lil' Fungi's Fun-Tastic Fiesta, and we're always playing it.",
            "nextDialogs": [
              "745080111"
            ]
          },
          "745080111": {
            "id": "745080111",
            "speakerId": 1001,
            "speakerName": "Enghiene",
            "text": "That's right! I love both the tabletop game, and those round Fungi in real life!",
            "nextDialogs": [
              "745080112"
            ]
          },
          "745080112": {
            "id": "745080112",
            "speakerId": 1001,
            "speakerName": "Enghiene",
            "text": "They're soft, bouncy, smooth, and squishy... just like Tidalga... Hehehe...",
            "nextDialogs": [
              "745080115"
            ]
          },
          "745080115": {
            "id": "745080115",
            "speakerId": 1001,
            "speakerName": "Enghiene",
            "text": "I won't! I just want to hold them and rub my face against them. Haniyyah didn't mind when I pinched Kindlejoy!",
            "nextDialogs": [
              "745080116"
            ]
          },
          "745080116": {
            "id": "745080116",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "That's... That's the most you can do! Only we can hold Bongo-Head!",
            "nextDialogs": [
              "745080117"
            ]
          },
          "745080117": {
            "id": "745080117",
            "speakerId": 1001,
            "speakerName": "Enghiene",
            "text": "You're so stingy! I want them both!",
            "nextDialogs": [
              "745080118"
            ]
          },
          "745080118": {
            "id": "745080118",
            "speakerId": 1001,
            "speakerName": "Enghiene",
            "text": "Haniyyah said you're experts at the game. How about a round against me?",
            "nextDialogs": [
              "745080119"
            ]
          },
          "745080119": {
            "id": "745080119",
            "speakerId": 1001,
            "speakerName": "Enghiene",
            "text": "If I win, I'm going to hold and pinch Bongo-Head!",
            "nextDialogs": [
              "745080120"
            ]
          },
          "745080120": {
            "id": "745080120",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Grr, she's looking down on us!",
            "nextDialogs": [
              "745080121"
            ]
          },
          "745080121": {
            "id": "745080121",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Let's do this, {NICKNAME}! As early adopters of the game, we need to show her what we're made of!"
          }
        }
      }
    },

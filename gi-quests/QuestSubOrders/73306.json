  "subQuests": [
    {
      "subId": "7305525",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730552501"
        ],
        "dialogs": {
          "730552501": {
            "id": "730552501",
            "speakerId": 1000,
            "speakerName": "Tirzad",
            "text": "...Oh, it's you. Is there anything else you want to discuss?",
            "nextDialogs": [
              "730552503",
              "730552508",
              "730552512"
            ]
          },
          "730552503": {
            "id": "730552503",
            "speakerId": 1000,
            "speakerName": "Tirzad",
            "text": "To think that I remained doubtful of him until the end. I'm such an awful person...",
            "nextDialogs": [
              "730552504"
            ]
          },
          "730552504": {
            "id": "730552504",
            "speakerId": 1000,
            "speakerName": "Tirzad",
            "text": "Now, all I have for him is gratitude...",
            "nextDialogs": [
              "730552505"
            ]
          },
          "730552505": {
            "id": "730552505",
            "speakerId": 1000,
            "speakerName": "Tirzad",
            "text": "I've never been able to commit before this, whether in academics or in life... But that ends now. I will take the path I believe in, no matter how difficult it may be...",
            "nextDialogs": [
              "730552506"
            ]
          },
          "730552506": {
            "id": "730552506",
            "speakerId": 1000,
            "speakerName": "Tirzad",
            "text": "This is the least I can do to pay my respects to him..."
          },
          "730552508": {
            "id": "730552508",
            "speakerId": 1000,
            "speakerName": "Tirzad",
            "text": "To be honest, I'm starting to doubt the credibility of the articles I've read...",
            "nextDialogs": [
              "730552509"
            ]
          },
          "730552509": {
            "id": "730552509",
            "speakerId": 1000,
            "speakerName": "Tirzad",
            "text": "That prayer... It gives me a strange feeling that I can't put a finger on. And Samail too... What he said... I think I should study it further once I get back.",
            "nextDialogs": [
              "730552510"
            ]
          },
          "730552510": {
            "id": "730552510",
            "speakerId": 1000,
            "speakerName": "Tirzad",
            "text": "Of course, my main mission is still to write my paper like I originally planned."
          },
          "730552512": {
            "id": "730552512",
            "speakerId": 1000,
            "speakerName": "Tirzad",
            "text": "*sigh* I, too, wish that I could do something for her, but...",
            "nextDialogs": [
              "730552513"
            ]
          },
          "730552513": {
            "id": "730552513",
            "speakerId": 1000,
            "speakerName": "Tirzad",
            "text": "I can't...",
            "nextDialogs": [
              "730552514"
            ]
          },
          "730552514": {
            "id": "730552514",
            "speakerId": 1000,
            "speakerName": "Tirzad",
            "text": "And she refuses to say anything. If she would just speak her desire, I would be willing to do anything in my power to help her...!"
          }
        }
      }
    },
    {
      "subId": "7305526",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730552601"
        ],
        "dialogs": {
          "730552601": {
            "id": "730552601",
            "speakerId": 1001,
            "speakerName": "Jeht",
            "text": "Sorry... I'm still not very good at controlling my emotions.",
            "nextDialogs": [
              "730552602"
            ]
          },
          "730552602": {
            "id": "730552602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't apologize.",
            "nextDialogs": [
              "730552603"
            ]
          },
          "730552603": {
            "id": "730552603",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yeah... We know you're going through a tough time.",
            "nextDialogs": [
              "730552604"
            ]
          },
          "730552604": {
            "id": "730552604",
            "speakerId": 1001,
            "speakerName": "Jeht",
            "text": "Thank you... May your travels be smooth.",
            "nextDialogs": [
              "730552605"
            ]
          },
          "730552605": {
            "id": "730552605",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh, Paimon hopes that everything will go well for you too... Paimon's sure it will!"
          }
        }
      }
    },
    {
      "subId": "7305527",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730552701"
        ],
        "dialogs": {
          "730552701": {
            "id": "730552701",
            "speakerId": 1003,
            "speakerName": "Bonifaz",
            "text": "Where are Omid and Mirsad? Are they...",
            "nextDialogs": [
              "730552702"
            ]
          },
          "730552702": {
            "id": "730552702",
            "speakerId": 1004,
            "speakerName": "Nachtigal",
            "text": "Don't worry. They're both fine. It's just that... they have other plans so they won't continue working with us.",
            "nextDialogs": [
              "730552703"
            ]
          },
          "730552703": {
            "id": "730552703",
            "speakerId": 1003,
            "speakerName": "Bonifaz",
            "text": "Huh? What do we do? We can't handle all the work with only the two of us. We've gotta hire more people! But who'd want to come to Aaru Village...",
            "nextDialogs": [
              "730552704"
            ]
          },
          "730552704": {
            "id": "730552704",
            "speakerId": 1003,
            "speakerName": "Bonifaz",
            "text": "Forget it, let's discuss this later. Anyway, Cyrus got back safely. That's at least something to be happy about, right? I'm never letting it go to such a dangerous place again.",
            "nextDialogs": [
              "730552705"
            ]
          },
          "730552705": {
            "id": "730552705",
            "speakerId": 1004,
            "speakerName": "Nachtigal",
            "text": "What are you talking about? We're Sumpter Beast merchants. What are we going to eat if our Sumpter Beasts don't work?",
            "nextDialogs": [
              "730552706"
            ]
          },
          "730552706": {
            "id": "730552706",
            "speakerId": 1004,
            "speakerName": "Nachtigal",
            "text": "You can't simply fill your belly with wind. Even if you could, open your mouth here, and I guarantee that you'll get a mouthful of sand instead...",
            "nextDialogs": [
              "730552707"
            ]
          },
          "730552707": {
            "id": "730552707",
            "speakerId": 1003,
            "speakerName": "Bonifaz",
            "text": "But we can't let Cyrus take risks. You look pretty strong to me, so why don't you carry our goods instead?",
            "nextDialogs": [
              "730552708"
            ]
          },
          "730552708": {
            "id": "730552708",
            "speakerId": 1004,
            "speakerName": "Nachtigal",
            "text": "?"
          }
        }
      }
    }
  ]
}
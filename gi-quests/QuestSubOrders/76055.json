  "subQuests": [
    {
      "subId": "7605501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760550101"
        ],
        "dialogs": {
          "760550101": {
            "id": "760550101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(<color=#FFCC33FF>Lauma</color> seems to have heard something...)",
            "nextDialogs": [
              "760550102"
            ]
          },
          "760550102": {
            "id": "760550102",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "...Strange. I'm sure I just heard something.",
            "nextDialogs": [
              "760550103"
            ]
          },
          "760550103": {
            "id": "760550103",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "(Ah, guests! Come, come! Spin the wheel, then stop the wheel, and then there'll be good food!)",
            "nextDialogs": [
              "760550104"
            ]
          },
          "760550104": {
            "id": "760550104",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "(Huh? Why aren't you spinning the wheel? Go on, spin it. Good food awaits!)",
            "nextDialogs": [
              "760550105"
            ]
          },
          "760550105": {
            "id": "760550105",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "That sounds... like a little puppy? Spin the wheel for good food... What does that mean?",
            "nextDialogs": [
              "760550106"
            ]
          },
          "760550106": {
            "id": "760550106",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "(Ho there, guests! You can speak to me! Well, please spin the wheel, then, or I shan't have anything delicious to eat!)",
            "nextDialogs": [
              "760550107"
            ]
          },
          "760550107": {
            "id": "760550107",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "Are you hungry, then? I've brought some biscuits. Here, have one.",
            "nextDialogs": [
              "760550108"
            ]
          },
          "760550108": {
            "id": "760550108",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "(Hmm? You're not spinning the wheel, but you want to give me food... Hmm, sure. I'll grab some first. Why not?)",
            "nextDialogs": [
              "760550109"
            ]
          },
          "760550109": {
            "id": "760550109",
            "speakerId": 1002,
            "speakerName": "Pavlov",
            "text": "(Thank you, guest. Pavlov's the name, and thanks for the biscuit. It was dee-licious! Still, you didn't spin the wheel.)",
            "nextDialogs": [
              "760550110"
            ]
          },
          "760550110": {
            "id": "760550110",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "You're quite welcome... But if I might ask, what do you mean by \"spinning the wheel\"?",
            "nextDialogs": [
              "760550111"
            ]
          },
          "760550111": {
            "id": "760550111",
            "speakerId": 1002,
            "speakerName": "Pavlov",
            "text": "(If the wheel is spun, then stopped, good food will drop down. That's how it always is.)",
            "nextDialogs": [
              "760550112"
            ]
          },
          "760550112": {
            "id": "760550112",
            "speakerId": 1002,
            "speakerName": "Pavlov",
            "text": "(Won't you spin the wheel, dear guest? Everyone feels happy after spinning it.)",
            "nextDialogs": [
              "760550113"
            ]
          },
          "760550113": {
            "id": "760550113",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "I suppose I shan't. It seems... you are living well here?",
            "nextDialogs": [
              "760550114"
            ]
          },
          "760550114": {
            "id": "760550114",
            "speakerId": 1002,
            "speakerName": "Pavlov",
            "text": "(Of course, of course! People play with me, the wheel plays with me, and there's good food.)",
            "nextDialogs": [
              "760550115"
            ]
          },
          "760550115": {
            "id": "760550115",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "Then that is well. Say hello to your owner for me. I'll be off now.",
            "nextDialogs": [
              "760550116"
            ]
          },
          "760550116": {
            "id": "760550116",
            "speakerId": 1002,
            "speakerName": "Pavlov",
            "text": "(Ohh... See you, guest! Come again!)"
          }
        }
      }
    },
    {
      "subId": "7605502",
      "subQuestName": "Additional",
      "sceneId": null,

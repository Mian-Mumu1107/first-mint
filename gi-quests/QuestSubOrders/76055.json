              "760550315"
            ]
          },
          "760550315": {
            "id": "760550315",
            "speakerId": 1003,
            "speakerName": "Columbina",
            "text": "I see... Yes, good food is important. Here, take the rest of these as well.",
            "nextDialogs": [

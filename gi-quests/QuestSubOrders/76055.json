            "id": "760550201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Hmm? Is that some <color=#FFCC33FF>small animal</color> I hear...?)",
            "nextDialogs": [
              "760550202"
            ]
          },
          "760550202": {
            "id": "760550202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(If there was someone present who could understand animal speech, perhaps they'd be able to pinpoint the source of this sound...)"
          }
        }
      }
    },

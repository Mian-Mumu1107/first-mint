  "subQuests": [
    {
      "subId": "7403901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740390901"
        ],
        "dialogs": {
          "740390901": {
            "id": "740390901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll help you. Let's go.",
            "nextDialogs": [
              "740390902"
            ]
          },
          "740390902": {
            "id": "740390902",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Just don't go drinking yourself into danger!"
          }
        }
      }
    },
    {
      "subId": "7403902",
      "subQuestName": "Talk to Verenata",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740390501"
        ],
        "dialogs": {
          "740390501": {
            "id": "740390501",
            "speakerId": 1001,
            "speakerName": "Verenata",
            "text": "Thank you! Let's try the first type, then!",
            "nextDialogs": [
              "740390502"
            ]
          },
          "740390502": {
            "id": "740390502",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Don't drink too much of it, {NICKNAME}! Just spit it out if something feels off, okay?",
            "nextDialogs": [
              "740390503"
            ]
          },
          "740390503": {
            "id": "740390503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry, Paimon, I'll be fine.",
            "nextDialogs": [
              "740390504"
            ]
          },
          "740390504": {
            "id": "740390504",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmph. Paimon's just worried, you know...",
            "nextDialogs": [
              "740390505"
            ]
          },
          "740390505": {
            "id": "740390505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm ready. Pass me the potion.",
            "nextDialogs": [
              "740390506"
            ]
          },
          "740390506": {
            "id": "740390506",
            "speakerId": 1001,
            "speakerName": "Verenata",
            "text": "This one's called the Super-Duper Potion, and it'll make you super strong! Well... in theory, at least.",
            "nextDialogs": [
              "740390507"
            ]
          },
          "740390507": {
            "id": "740390507",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You take the potion from Verenata and drink it in one go.\\nIt has a pungent odor that's hard to bear, but it tastes sweet and sticky, and isn't hard to swallow.\\nOtherwise, however, your body has no reaction to it.",
            "nextDialogs": [
              "740390508"
            ]
          },
          "740390508": {
            "id": "740390508",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "At her direction, you then wait until some Breacher Primuses become active."
          }
        }
      }
    },
    {
      "subId": "7403903",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],

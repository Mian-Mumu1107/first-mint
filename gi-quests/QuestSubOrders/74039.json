    {
      "subId": "7403904",
      "subQuestName": "Talk to Verenata",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740390601"
        ],
        "dialogs": {
          "740390601": {
            "id": "740390601",
            "speakerId": 1001,
            "speakerName": "Verenata",
            "text": "U—Um, so, did you defeat those creatures so easily because of the Super-Duper Potion?",
            "nextDialogs": [
              "740390603",
              "740390606"
            ]
          },
          "740390603": {
            "id": "740390603",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What kind of awful advertising slogan is that...",
            "nextDialogs": [
              "740390604"
            ]
          },
          "740390604": {
            "id": "740390604",
            "speakerId": 1001,
            "speakerName": "Verenata",
            "text": "Ah, thank you, thank you! So it was due to the potion's effects, then. I guess that's a Master Potioneer's recipe for you!",
            "nextDialogs": [
              "740390609"
            ]
          },
          "740390609": {
            "id": "740390609",
            "speakerId": 1001,
            "speakerName": "Verenata",
            "text": "Alright then. Let's bring the Super-Duper Potion testing to a close first. Next, let's test this Coasty-Toasty Potion!",
            "nextDialogs": [
              "740390610"
            ]
          },
          "740390610": {
            "id": "740390610",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Did you, uh, come up with these names yourself?",
            "nextDialogs": [
              "740390611"
            ]
          },
          "740390611": {
            "id": "740390611",
            "speakerId": 1001,
            "speakerName": "Verenata",
            "text": "No, I'm no good at making up names, so I just let others help me come up with much better ones...",
            "nextDialogs": [
              "740390612"
            ]
          },
          "740390612": {
            "id": "740390612",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, don't say that... Really, and for something like potions, the name should let you know what it does right away anyway, right?",
            "nextDialogs": [
              "740390613"
            ]
          },
          "740390613": {
            "id": "740390613",
            "speakerId": 1001,
            "speakerName": "Verenata",
            "text": "Hmm. I've never heard that before... But you're right! That's what a Master Potioneer should be like!",
            "nextDialogs": [
              "740390614"
            ]
          },
          "740390614": {
            "id": "740390614",
            "speakerId": 1001,
            "speakerName": "Verenata",
            "text": "#*cough* A—Anyway, are you ready to test this potion, {NICKNAME}?",
            "nextDialogs": [
              "740390615"
            ]
          },
          "740390615": {
            "id": "740390615",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure, let's start.",
            "nextDialogs": [
              "740390616"
            ]
          },
          "740390616": {
            "id": "740390616",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh boy, this one smells like a disaster too...",
            "nextDialogs": [
              "740390617"
            ]
          },
          "740390617": {
            "id": "740390617",
            "speakerId": 1001,
            "speakerName": "Verenata",
            "text": "Theoretically, this Coasty-Toasty Potion will spare you from the effects of the cold and keep you warm! Yeah. Probably.",
            "nextDialogs": [
              "740390618"
            ]
          },
          "740390618": {
            "id": "740390618",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You take the potion from Verenata. It smells like dusty, musty old leather...\\nYou hesitate for a moment before drinking it all in one gulp. It's not a bad tasting drink, being spicy with hints of cinnamon and ginger... It reminds you of a crackling fireplace on a rainy day.\\nOtherwise, however, your body has no reaction to it.",
            "nextDialogs": [
              "740390619"
            ]
          },
          "740390619": {
            "id": "740390619",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Afterwards, you rest for a while at her instruction."
          },
          "740390606": {
            "id": "740390606",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eh? But it smelled terrible...",
            "nextDialogs": [
              "740390607"
            ]
          },
          "740390607": {
            "id": "740390607",
            "speakerId": 1001,
            "speakerName": "Verenata",
            "text": "Huh... Is that so? Did I get something wrong?",
            "nextDialogs": [
              "740390608"
            ]
          },
          "740390608": {
            "id": "740390608",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Don't be so down. At least it wasn't poisonous... We can take that as a win, right?"
          }
        }
      }
    },
    {
      "subId": "7403905",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {

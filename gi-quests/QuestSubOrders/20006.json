    {
      "subId": "2000610",
      "subQuestName": "Give the fee to Sara at the restaurant",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200060401"
        ],
        "dialogs": {
          "200060401": {
            "id": "200060401",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Deliver meal fee",
            "nextDialogs": [
              "200060402"
            ]
          },
          "200060402": {
            "id": "200060402",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "You're back! Did the delivery go okay?",
            "nextDialogs": [
              "200060403"
            ]
          },
          "200060403": {
            "id": "200060403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's the fee.",
            "nextDialogs": [
              "200060404"
            ]
          },
          "200060404": {
            "id": "200060404",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Let me check... Yep! Thanks!",
            "nextDialogs": [
              "200060405"
            ]
          },
          "200060405": {
            "id": "200060405",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Here, this <color=#00E1FFFF>Delicious Crab, Ham & Veggie Bake</color> is for you. It's fresh out of the oven, eat it while it's hot."
          }
        }
      }

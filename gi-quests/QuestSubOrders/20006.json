    {
      "subId": "2000603",
      "subQuestName": "Deliver the food to Lively Orlean",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200060201"
        ],
        "dialogs": {
          "200060201": {
            "id": "200060201",
            "speakerId": 159401,
            "speakerName": "Lively Orlean",
            "text": "Thanks! Ugh, these slimes are such a pain.",
            "nextDialogs": [
              "200060202"
            ]
          },
          "200060202": {
            "id": "200060202",
            "speakerId": 159401,
            "speakerName": "Lively Orlean",
            "text": "If I hadn't had such low blood sugar, I'd have taught them a lesson myself...",
            "nextDialogs": [
              "200060203"
            ]
          },
          "200060203": {
            "id": "200060203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Your meal, ma'am.",
            "nextDialogs": [
              "200060204"
            ]
          },
          "200060204": {
            "id": "200060204",
            "speakerId": 159401,
            "speakerName": "Lively Orlean",
            "text": "Mmm... Smells carroty and meaty... It's a shame it didn't get here sooner, I would have sent those slimes flying if I'd been fighting on a full stomach!",
            "nextDialogs": [
              "200060205"
            ]
          },
          "200060205": {
            "id": "200060205",
            "speakerId": 159401,
            "speakerName": "Lively Orlean",
            "text": "Can't be helped I suppose. Here's the money, take it back to Sara for me."
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "2000601",
      "subQuestName": "Talk to Sara at Good Hunter",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200060101"
        ],
        "dialogs": {
          "200060101": {
            "id": "200060101",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Order for delivery",
            "nextDialogs": [
              "200060102"
            ]
          },
          "200060102": {
            "id": "200060102",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Welcome to Good Hunter— Oh, hello Traveler! You've come just at the right time.",
            "nextDialogs": [
              "200060103"
            ]
          },
          "200060103": {
            "id": "200060103",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Sorry, I know you must be hungry, but could you do something for me?",
            "nextDialogs": [
              "200060104"
            ]
          },
          "200060104": {
            "id": "200060104",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Miss Orlean from Springvale ordered a <color=#00E1FFFF>Sticky Honey Roast</color>, but I hear Springvale's crawling with slimes these days...",
            "nextDialogs": [
              "200060105"
            ]
          },
          "200060105": {
            "id": "200060105",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "I don't dare attempt the journey myself... Could you deliver this order to <color=#00E1FFFF>Orlean in Springvale</color> for me?",
            "nextDialogs": [
              "200060108",
              "200060110"
            ]
          },
          "200060108": {
            "id": "200060108",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Rest assured there'll be a hearty meal waiting for you on your return!",
            "nextDialogs": [
              "200060109"
            ]
          },
          "200060109": {
            "id": "200060109",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "I'm counting on you!"
          },
          "200060110": {
            "id": "200060110",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Once you've done what I ask, I'll treat you to something from the Good Hunter special menu! Much obliged."
          }
        }
      }
    },
    {

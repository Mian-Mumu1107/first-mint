  "subQuests": [
    {
      "subId": "2204501",
      "subQuestName": "Talk to Ooshima Junpei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220450101"
        ],
        "dialogs": {
          "220450101": {
            "id": "220450101",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Hmm, this still doesn't feel quite right...",
            "nextDialogs": [
              "220450102"
            ]
          },
          "220450102": {
            "id": "220450102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "220450103"
            ]
          },
          "220450103": {
            "id": "220450103",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Ah, Traveler, you're here! Just the person I wanted to see.",
            "nextDialogs": [
              "220450104"
            ]
          },
          "220450104": {
            "id": "220450104",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Recently, I've gotten the feeling that the wood carvings I've been making... don't have... you know, life.",
            "nextDialogs": [
              "220450106"
            ]
          },
          "220450106": {
            "id": "220450106",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Oh, that's not what I mean...",
            "nextDialogs": [
              "220450108"
            ]
          },
          "220450108": {
            "id": "220450108",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Hmm. How do I explain this? What I'm looking for is...",
            "nextDialogs": [
              "220450109"
            ]
          },
          "220450109": {
            "id": "220450109",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "You see, our provisional head priestess is mostly asleep, but at times, she will wake and wander about.",
            "nextDialogs": [
              "220450110"
            ]
          },
          "220450110": {
            "id": "220450110",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "While on her walks, she will hop or jump, pounce at some fallen leaves, or stretch, and things like that...",
            "nextDialogs": [
              "220450111"
            ]
          },
          "220450111": {
            "id": "220450111",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "I want to capture that in motion. I want to make carvings using these actions as a basis. That's what I mean by \"life.\""
          }
        }
      }
    },
    {
      "subId": "2204502",
      "subQuestName": "Take a picture of Neko from the right side",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220450201"
        ],
        "dialogs": {
          "220450201": {
            "id": "220450201",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "I'll leave the picture-taking business to you. Just bring them to me once you're done."
          }
        }
      }
    },
    {
      "subId": "2204503",
      "subQuestName": "Take a picture of Neko from the left side",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220450301"
        ],
        "dialogs": {
          "220450301": {
            "id": "220450301",
            "speakerId": 1001,
            "speakerName": "Neko",
            "text": "Mm? What are you doing?",
            "nextDialogs": [
              "220450302"
            ]
          },
          "220450302": {
            "id": "220450302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Taking pictures.",
            "nextDialogs": [
              "220450303"
            ]
          },
          "220450303": {
            "id": "220450303",
            "speakerId": 1001,
            "speakerName": "Neko",
            "text": "...And what are those? You truly are strange.",
            "nextDialogs": [
              "220450304"
            ]
          },
          "220450304": {
            "id": "220450304",
            "speakerId": 1001,
            "speakerName": "Neko",
            "text": "Eh, it matters not. Continue as you were — just refrain from messing the shrine up."
          }
        }
      }
    },
    {
      "subId": "2204504",
      "subQuestName": "Give the pictures to Ooshima Junpei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220450401"
        ],
        "dialogs": {
          "220450401": {
            "id": "220450401",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "How did it go? Did you get the pictures?",
            "nextDialogs": [
              "220450402"
            ]
          },
          "220450402": {
            "id": "220450402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wasn't that hard.",
            "nextDialogs": [
              "220450403"
            ]
          },
          "220450403": {
            "id": "220450403",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Let me see... Ooh! This angle... This pose... Pretty good! Pretty good indeed!",
            "nextDialogs": [
              "220450406"
            ]
          },
          "220450406": {
            "id": "220450406",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Oh, they'll more than do!",
            "nextDialogs": [
              "220450407"
            ]
          },
          "220450407": {
            "id": "220450407",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Thank you so much, Traveler. Please take these. I'll start practicing in just a moment.",
            "nextDialogs": [
              "220450408"
            ]
          },
          "220450408": {
            "id": "220450408",
            "speakerId": 1000,
            "speakerName": "Ooshima Junpei",
            "text": "Oh ho ho, this is pretty good..."
          }
        }
      }
    }
  ]

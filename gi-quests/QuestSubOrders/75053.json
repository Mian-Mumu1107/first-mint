        ],
        "dialogs": {
          "750530301": {
            "id": "750530301",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "No more prizes left. No more prizes, no more challenge.",
            "nextDialogs": [
              "750530302"
            ]
          },
          "750530302": {
            "id": "750530302",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "Any other questions?",
            "nextDialogs": [
              "750530304",
              "750530308",
              "750530312"
            ]
          },
          "750530304": {
            "id": "750530304",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "Passed down in the tribe from long ago...",
            "nextDialogs": [
              "750530305"
            ]
          },
          "750530305": {
            "id": "750530305",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "Keen eyes are critical to us, the Flower-Feather Clan.",
            "nextDialogs": [
              "750530306"
            ]
          },
          "750530306": {
            "id": "750530306",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "This generation, I am in charge."
          },
          "750530308": {
            "id": "750530308",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "Previous injury. Fell from a very high place...",
            "nextDialogs": [
              "750530309"
            ]
          },
          "750530309": {
            "id": "750530309",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "Throat and chest... Can't speak like before.",
            "nextDialogs": [
              "750530310"
            ]
          },
          "750530310": {
            "id": "750530310",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "But I don't think it's... too terrible."
          },
          "750530312": {
            "id": "750530312",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "Wish you well. Goodbye."
          }
        }

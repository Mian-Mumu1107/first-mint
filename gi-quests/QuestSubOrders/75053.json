      "dialogue": {
        "startDialogs": [
          "750530101"
        ],
        "dialogs": {
          "750530101": {
            "id": "750530101",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "Hey, outlander. You've a good pair of eyes... Wanna test them by setting your \"Eyes on the Feathered Prize\"?",
            "nextDialogs": [
              "750530102"
            ]
          },
          "750530102": {
            "id": "750530102",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "Hone your vision, and be rewarded.",
            "nextDialogs": [
              "750530103"
            ]
          },
          "750530103": {
            "id": "750530103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, that's a concise explanation. Maybe too concise. Barely feels like you said anything at all...",
            "nextDialogs": [
              "750530104"
            ]
          },
          "750530104": {
            "id": "750530104",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "Detailed rules for later, if you want to try.",
            "nextDialogs": [
              "750530105"
            ]
          },
          "750530105": {
            "id": "750530105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's hear the rules, then.",
            "nextDialogs": [
              "750530106"
            ]
          },
          "750530106": {
            "id": "750530106",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "Three Qucusaurs will fly off. Keep your eye on the middle one...",
            "nextDialogs": [
              "750530107"
            ]
          },
          "750530107": {
            "id": "750530107",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "When they all fly back, <color=#00E1FFFF>recognize... the one originally in the middle</color>. That's it.",
            "nextDialogs": [
              "750530108"
            ]
          },
          "750530108": {
            "id": "750530108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Err, so they'll switch positions mid-flight, and we gotta figure out which one was originally in the center?",
            "nextDialogs": [
              "750530109"
            ]
          },
          "750530109": {
            "id": "750530109",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "Correct indeed.",
            "nextDialogs": [
              "750530110"
            ]
          },
          "750530110": {
            "id": "750530110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh... No wonder you call this eyesight training.",
            "nextDialogs": [
              "750530111"
            ]
          },
          "750530111": {
            "id": "750530111",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "Start simple to test the waters?",
            "nextDialogs": [
              "750530112"
            ]
          },
          "750530112": {
            "id": "750530112",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "And if there's no trouble, we play for real.",
            "nextDialogs": [
              "750530113"
            ]
          },
          "750530113": {
            "id": "750530113",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "Rewards are yours if you succeed.",
            "nextDialogs": [
              "750530115",
              "750530117"
            ]
          },
          "750530115": {
            "id": "750530115",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "Fine. I will be here."
          },
          "750530117": {
            "id": "750530117",
            "speakerId": 1000,
            "speakerName": "Muepu",
            "text": "When ready, hit the target and start!"
          }
        }
      }
    },

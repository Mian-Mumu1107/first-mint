  "subQuests": [
    {
      "subId": "7469401",
      "subQuestName": "Talk to Beidou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746940101"
        ],
        "dialogs": {
          "746940101": {
            "id": "746940101",
            "speakerId": 1000,
            "speakerName": "Beidou",
            "text": "So, what you're saying is that this card I drew is actually pretty good?",
            "nextDialogs": [
              "746940102"
            ]
          },
          "746940102": {
            "id": "746940102",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Haha, fate is simply fate. It makes no distinction between bad and good.",
            "nextDialogs": [
              "746940103"
            ]
          },
          "746940103": {
            "id": "746940103",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "However, talking solely about the upright Strength card you drew, one of its interpretations actually fits your profession well.",
            "nextDialogs": [
              "746940104"
            ]
          },
          "746940104": {
            "id": "746940104",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "This card symbolizes passion, courage, confidence, and desire, as well as perfect, unfaltering love.",
            "nextDialogs": [
              "746940105"
            ]
          },
          "746940105": {
            "id": "746940105",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "No matter what surprises fate throws your way, I believe you will take control and steer a steady course.",
            "nextDialogs": [
              "746940106"
            ]
          },
          "746940106": {
            "id": "746940106",
            "speakerId": 1000,
            "speakerName": "Beidou",
            "text": "Hahahaha! Don't flatter me! By our rules, a good fortune means paying extra for the reading.",
            "nextDialogs": [
              "746940107"
            ]
          },
          "746940107": {
            "id": "746940107",
            "speakerId": 1000,
            "speakerName": "Beidou",
            "text": "Here, I'll leave my coin pouch with you. If you have the time, could you read the fortunes of my crew?",
            "nextDialogs": [
              "746940108"
            ]
          },
          "746940108": {
            "id": "746940108",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Haha, that's the first time I've received a request like this.",
            "nextDialogs": [
              "746940109"
            ]
          },
          "746940109": {
            "id": "746940109",
            "speakerId": 1000,
            "speakerName": "Beidou",
            "text": "We've sailed this ship from one corner of Teyvat to the other, braving the winds and waves. After so many years at sea, there isn't one among them who doesn't harbor troubles of their own.",
            "nextDialogs": [
              "746940110"
            ]
          },
          "746940110": {
            "id": "746940110",
            "speakerId": 1000,
            "speakerName": "Beidou",
            "text": "I may be their captain, but there are things even I can't help them with.",
            "nextDialogs": [
              "746940111"
            ]
          },
          "746940111": {
            "id": "746940111",
            "speakerId": 1000,
            "speakerName": "Beidou",
            "text": "So running into a fortune-teller like you, it made me think you might be able to help set their minds at ease.",
            "nextDialogs": [
              "746940112"
            ]
          },
          "746940112": {
            "id": "746940112",
            "speakerId": 1000,
            "speakerName": "Beidou",
            "text": "As for recompense, that won't be a problem. We've done good business on our way here, and dragged in quite the haul...",
            "nextDialogs": [
              "746940113"
            ]
          },
          "746940113": {
            "id": "746940113",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "As intriguing an offer as that is, I'm afraid I'll have to pass. I fear there aren't enough cards in my deck for such a sizable crew.",
            "nextDialogs": [
              "746940114"
            ]
          },
          "746940114": {
            "id": "746940114",
            "speakerId": 1000,
            "speakerName": "Beidou",
            "text": "#Ah, {NICKNAME}, Paimon? I haven't seen you in a long time! Are you here to have your fortunes read, too?",
            "nextDialogs": [
              "746940117"
            ]
          },
          "746940117": {
            "id": "746940117",
            "speakerId": 1000,
            "speakerName": "Beidou",
            "text": "I'm here on business, of course. And to help a certain someone scout out new trade opportunities while I'm at it."
          }
        }
      }
    },

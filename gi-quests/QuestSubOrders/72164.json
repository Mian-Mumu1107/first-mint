  "subQuests": [
    {
      "subId": "7216438",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721640101"
        ],
        "dialogs": {
          "721640101": {
            "id": "721640101",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Nya, meow... That box has proven its worth indeed...",
            "nextDialogs": [
              "721640102"
            ]
          },
          "721640102": {
            "id": "721640102",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Ah, you return. The box you repaired has proved its efficacy quite well.",
            "nextDialogs": [
              "721640103"
            ]
          },
          "721640103": {
            "id": "721640103",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Not long after your departure, two humans in green came to the shrine, meow, meow.",
            "nextDialogs": [
              "721640104"
            ]
          },
          "721640104": {
            "id": "721640104",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Not only did they offer up some Mora, but the tall, green human seemed most excited to hear me speak. How easily startled you humans are, really...",
            "nextDialogs": [
              "721640105"
            ]
          },
          "721640105": {
            "id": "721640105",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Regardless, the Offering Box is a most wondrous artifact. Perhaps repairing another shall attract yet more people?",
            "nextDialogs": [
              "721640106"
            ]
          },
          "721640106": {
            "id": "721640106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh, that's not how that works...",
            "nextDialogs": [
              "721640107"
            ]
          },
          "721640107": {
            "id": "721640107",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Is that so? Human matters are so very bothersome.",
            "nextDialogs": [
              "721640108"
            ]
          },
          "721640108": {
            "id": "721640108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "P—Paimon thinks this has got way more to do with the state of the shrine...",
            "nextDialogs": [
              "721640109"
            ]
          },
          "721640109": {
            "id": "721640109",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "And what of my shrine?",
            "nextDialogs": [
              "721640112"
            ]
          },
          "721640112": {
            "id": "721640112",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Ho, is that so? Those little rascals quite enjoy playing amongst the piles of fallen leaves.",
            "nextDialogs": [
              "721640113"
            ]
          },
          "721640113": {
            "id": "721640113",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Ah, but if one yet recalls clearly, Hibiki used to use a long stick with pointy ends to build a pile of leaves. Now, if she did it, it must be the right thing to do."
          }
        }
      }
    },
    {
      "subId": "7216439",
      "subQuestName": "Clean the dirt around Asase Shrine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7216443",
      "subQuestName": "Report back to Neko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721640201"
        ],
        "dialogs": {
          "721640201": {
            "id": "721640201",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Is your \"cleanup\" complete?",
            "nextDialogs": [
              "721640202"
            ]
          },
          "721640202": {
            "id": "721640202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Everything's spick and span.",
            "nextDialogs": [
              "721640203"
            ]
          },
          "721640203": {
            "id": "721640203",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Meow, meow. That is good. I have also chased those little crawlies away.",
            "nextDialogs": [
              "721640204"
            ]
          },
          "721640204": {
            "id": "721640204",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Why, this shrine is looking more and more the part. The box is repaired, and the shrine itself is clean... Yes, more people shall surely come to pay their respects.",
            "nextDialogs": [
              "721640205"
            ]
          },
          "721640205": {
            "id": "721640205",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Meow, meow... We must return this shrine to its former glory, yes... Meow...",
            "nextDialogs": [
              "721640206"
            ]
          },
          "721640206": {
            "id": "721640206",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "We shall stop here. Thank you for your help thus far... meow, meow...",
            "nextDialogs": [
              "721640207"
            ]
          },
          "721640207": {
            "id": "721640207",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Speaking your language is... so tiring...",
            "nextDialogs": [
              "721640208"
            ]
          },
          "721640208": {
            "id": "721640208",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "I am going to rest. Perhaps your aid shall be required later also...",
            "nextDialogs": [
              "721640209"
            ]
          },
          "721640209": {
            "id": "721640209",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "When that time comes, do return here to... meow, meow..."
          }
        }
      }
    },
    {
      "subId": "7216403",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721640301"
        ],
        "dialogs": {
          "721640301": {
            "id": "721640301",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Meow! Yes, this work was given specifically to me by Hibiki. A vital task to be completed by no other.",
            "nextDialogs": [
              "721640303",
              "721640312"
            ]
          },
          "721640303": {
            "id": "721640303",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "My name is Neko — a name bestowed by Hibiki.",
            "nextDialogs": [
              "721640304"
            ]
          },
          "721640304": {
            "id": "721640304",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "It was she who often came out to receive guests at the shrine, and so I was not obligated to manage such affairs.",
            "nextDialogs": [
              "721640305"
            ]
          },
          "721640305": {
            "id": "721640305",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "I had neither name nor title then. I slept where she wished, and played with whomever she willed.",
            "nextDialogs": [
              "721640306"
            ]
          },
          "721640306": {
            "id": "721640306",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "One day, Hibiki said that she would call me \"Neko,\" on account of my habit of sleeping.",
            "nextDialogs": [
              "721640307"
            ]
          },
          "721640307": {
            "id": "721640307",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Hibiki is presently absent, but a shrine is no shrine without a head priestess, and so I have taken up that post.",
            "nextDialogs": [
              "721640308"
            ]
          },
          "721640308": {
            "id": "721640308",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "That is also why I hope to restore the shrine to its former liveliness before Hibiki returns.",
            "nextDialogs": [
              "721640309"
            ]
          },
          "721640309": {
            "id": "721640309",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Once she returns, I can fall asleep in her bosom, and not have to wait for her to repair the Offering Box, or for her to use that long stick of hers to clear the fallen leaves.",
            "nextDialogs": [
              "721640310"
            ]
          },
          "721640310": {
            "id": "721640310",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Well, I shall leave those tasks to you. There are some sneaky bugs that have stolen into the shrine, and they must now be driven out."
          },
          "721640312": {
            "id": "721640312",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "It was Hibiki. Domeki would help her sometimes, too.",
            "nextDialogs": [
              "721640313"
            ]
          },
          "721640313": {
            "id": "721640313",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Hibiki often took that stick and waved it back and forth before sunrise. She would also pour water on the ground. Ugh, water...",
            "nextDialogs": [
              "721640314"
            ]
          },
          "721640314": {
            "id": "721640314",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Wait. Did she pour the water first? I do not quite recall the sequence of events...",
            "nextDialogs": [
              "721640315"
            ]
          },
          "721640315": {
            "id": "721640315",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "Domeki would come by at times as well, and he would use crossed metal plates to go snicker-snack! And the branches and leaves would come falling down."
          }
        }
      }
    },
    {
      "subId": "7216404",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721640401"
        ],
        "dialogs": {
          "721640401": {
            "id": "721640401",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "We must... return this shrine to its former glory, yes... Meow...",
            "nextDialogs": [
              "721640402"
            ]
          },
          "721640402": {
            "id": "721640402",
            "speakerId": 3189,
            "speakerName": "Neko",
            "text": "When will Hibiki... finally return... meow..."
          }
        }
      }
    }
  ]
}
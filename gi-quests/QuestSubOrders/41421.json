  "subQuests": [
    {
      "subId": "4142101",
      "subQuestName": "Go to the Mondstadt Adventurers' Guild and talk to Katheryne",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414210101"
        ],
        "dialogs": {
          "414210101": {
            "id": "414210101",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Hello there, Traveler. How have things been?",
            "nextDialogs": [
              "414210102"
            ]
          },
          "414210102": {
            "id": "414210102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Has something strange happened again, Katheryne?",
            "nextDialogs": [
              "414210103"
            ]
          },
          "414210103": {
            "id": "414210103",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Compared to previous major incidents, this one is not the most peculiar. However, it is still quite serious, as it risks having a great impact on Mondstadt's economy.",
            "nextDialogs": [
              "414210106"
            ]
          },
          "414210106": {
            "id": "414210106",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "Recently, the bodies of water near the winery have turned bitter without any warning. If this persists, Mondstadt's wine industry may be wiped out in just a few years.",
            "nextDialogs": [
              "414210107"
            ]
          },
          "414210107": {
            "id": "414210107",
            "speakerId": 1000,
            "speakerName": "Katheryne",
            "text": "For more details, please speak with Connor at the winery."
          }
        }
      }
    },
    {
      "subId": "4142102",
      "subQuestName": "Go to Dawn Winery and speak to Connor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414210201"
        ],
        "dialogs": {
          "414210201": {
            "id": "414210201",
            "speakerId": 1002,
            "speakerName": "Connor",
            "text": "Are you the people sent by the Adventurers' Guild?",
            "nextDialogs": [
              "414210202"
            ]
          },
          "414210202": {
            "id": "414210202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's us!",
            "nextDialogs": [
              "414210203"
            ]
          },
          "414210203": {
            "id": "414210203",
            "speakerId": 1002,
            "speakerName": "Connor",
            "text": "Well, that's a relief. Now, as for the matter at hand — rather than listening to me explain it, you may as well experience it for yourselves.",
            "nextDialogs": [
              "414210204"
            ]
          },
          "414210204": {
            "id": "414210204",
            "speakerId": 1002,
            "speakerName": "Connor",
            "text": "This is a bottle of water that we drew just recently. It is hygienic, don't worry — we've put it through its purification paces. Have a taste and see.",
            "nextDialogs": [
              "414210205"
            ]
          },
          "414210205": {
            "id": "414210205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, oh, Paimon wants some too, Paimon wants a try!",
            "nextDialogs": [
              "414210206"
            ]
          },
          "414210206": {
            "id": "414210206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Let's take a sip...)",
            "nextDialogs": [
              "414210207"
            ]
          },
          "414210207": {
            "id": "414210207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ugh! Blergh! It's so bitter...",
            "nextDialogs": [
              "414210208"
            ]
          },
          "414210208": {
            "id": "414210208",
            "speakerId": 1002,
            "speakerName": "Connor",
            "text": "This bitterness cannot be removed via conventional purification processes, so it's not an issue of the water's composition. I suspect it must be some mysterious elemental phenomenon.",
            "nextDialogs": [
              "414210209"
            ]
          },
          "414210209": {
            "id": "414210209",
            "speakerId": 1002,
            "speakerName": "Connor",
            "text": "As such, this water can't be used to make wine at all.",
            "nextDialogs": [
              "414210210"
            ]
          },
          "414210210": {
            "id": "414210210",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That must've been tough for the nearby fish as well, right?",
            "nextDialogs": [
              "414210211"
            ]
          },
          "414210211": {
            "id": "414210211",
            "speakerId": 1002,
            "speakerName": "Connor",
            "text": "We tried cooking some of the fish killed by the bitter water. All the food we made turned out bitter, too.",
            "nextDialogs": [
              "414210212"
            ]
          },
          "414210212": {
            "id": "414210212",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon... hadn't quite thought that far.",
            "nextDialogs": [
              "414210213"
            ]
          },
          "414210213": {
            "id": "414210213",
            "speakerId": 1002,
            "speakerName": "Connor",
            "text": "Anyway, that's the situation. If you're looking for somewhere to start, my gut tells me you should investigate northward. Additionally, I wonder if Liyue's Bishui River or the waters of Qingce Village have been affected..."
          }
        }
      }
    },
    {
      "subId": "4142103",

  "subQuests": [
    {
      "subId": "1502607",
      "subQuestName": "Go to the Masters of the Night-Wind",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150260701"
        ],
        "dialogs": {
          "150260701": {
            "id": "150260701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? What are the Fatui doing here?",
            "nextDialogs": [
              "150260702"
            ]
          },
          "150260702": {
            "id": "150260702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's a little concerning... Let's go over there and see what they're up to.",
            "nextDialogs": [
              "150260703"
            ]
          },
          "150260703": {
            "id": "150260703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Also, how did they get this close to a tribal settlement?",
            "nextDialogs": [
              "150260706"
            ]
          },
          "150260706": {
            "id": "150260706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh... All the Fatui left in Natlan are probably The Captain's subordinates. That basically makes them followers of one of Natlan's heroes.",
            "nextDialogs": [
              "150260707"
            ]
          },
          "150260707": {
            "id": "150260707",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Still, once a Fatuus always a Fatuus. Something seems off, seeing them here... Let's go check it out!"
          }
        }
      }
    },
    {
      "subId": "1502601",
      "subQuestName": "Question the suspicious Fatui",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150260101"
        ],
        "dialogs": {
          "150260101": {
            "id": "150260101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ahem! What are you guys doing here?",
            "nextDialogs": [
              "150260102"
            ]
          },
          "150260102": {
            "id": "150260102",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Heh, following orders. If you have a problem, take it up with our employer.",
            "nextDialogs": [
              "150260103"
            ]
          },
          "150260103": {
            "id": "150260103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, what's with the attitude? Can the Fatui even work for a private employer?",
            "nextDialogs": [
              "150260104"
            ]
          },
          "150260104": {
            "id": "150260104",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Ahem! This is Grudoc — I hired him to be my bodyguard in Natlan. As you can see, he's not the sociable type. I'm sorry for any offense.",
            "nextDialogs": [
              "150260105"
            ]
          },
          "150260105": {
            "id": "150260105",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "My original plan was to hire someone from the local tribes, but a priest recommended Grudoc and his squad.",
            "nextDialogs": [
              "150260106"
            ]
          },
          "150260106": {
            "id": "150260106",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I was told they were capable fighters and had the time to spare, so they fit the bill... It seems like the Fatui's reputation in Natlan is quite positive.",
            "nextDialogs": [
              "150260107"
            ]
          },
          "150260107": {
            "id": "150260107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, that's what happened... Then, you must be from Fontaine?",
            "nextDialogs": [
              "150260108"
            ]
          },
          "150260108": {
            "id": "150260108",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "#Precisely! Montluson, at your service. I work in the publication business. And you two... Wait, you must be {NICKNAME} and {M#his}{F#her} fairy companion!",
            "nextDialogs": [
              "150260109"
            ]
          },
          "150260109": {
            "id": "150260109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, you know us?",
            "nextDialogs": [
              "150260110"
            ]
          },
          "150260110": {
            "id": "150260110",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "A golden-haired Traveler with a floating companion... There's no mistake!",
            "nextDialogs": [
              "150260111"
            ]
          },
          "150260111": {
            "id": "150260111",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "Your exploits in Fontaine have all the makings of a best-selling series! I'd be a failure of a book merchant if I couldn't recognize you.",
            "nextDialogs": [
              "150260112"
            ]
          },
          "150260112": {
            "id": "150260112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Wow, we're really famous at this point, {NICKNAME}!",
            "nextDialogs": [
              "150260113"
            ]
          },
          "150260113": {
            "id": "150260113",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "It's truly my lucky day! I know this is sudden, but I was actually looking for you two... You see, I have a favor to ask.",
            "nextDialogs": [
              "150260114"
            ]
          },
          "150260114": {
            "id": "150260114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, you... chased us all the way to Natlan? That's a little creepy...",
            "nextDialogs": [
              "150260115"
            ]
          },
          "150260115": {
            "id": "150260115",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "You'll be generously rewarded, I promise you!",
            "nextDialogs": [
              "150260116"
            ]
          },
          "150260116": {
            "id": "150260116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Well, at least he got straight to the point. Should we hear what he has to say?",
            "nextDialogs": [
              "150260119"
            ]
          },
          "150260119": {
            "id": "150260119",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*ahem*... Alright, we'll hear your request.",
            "nextDialogs": [
              "150260120"
            ]
          },
          "150260120": {
            "id": "150260120",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "You know the great shaman, Citlali, right? I need her help with something!",
            "nextDialogs": [
              "150260121"
            ]
          },
          "150260121": {
            "id": "150260121",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh... Yeah, but the chances of her helping a random stranger just because we asked...",
            "nextDialogs": [
              "150260122"
            ]
          },
          "150260122": {
            "id": "150260122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "With her personality? Pretty slim...",
            "nextDialogs": [
              "150260123"
            ]
          },
          "150260123": {
            "id": "150260123",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, Citlali really doesn't like dealing with strangers...",
            "nextDialogs": [
              "150260124"
            ]
          },
          "150260124": {
            "id": "150260124",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "I heard about that from other members of her tribe. But, they told me if one person could convince her, it would be the golden-haired Traveler.",
            "nextDialogs": [
              "150260125"
            ]
          },
          "150260125": {
            "id": "150260125",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "If you manage it, I'll even double your pay!",
            "nextDialogs": [
              "150260126"
            ]
          },
          "150260126": {
            "id": "150260126",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "150260127"
            ]
          },
          "150260127": {
            "id": "150260127",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why do you need her help?",
            "nextDialogs": [
              "150260128"
            ]
          },
          "150260128": {
            "id": "150260128",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, yeah... We should definitely get to the bottom of that first.",
            "nextDialogs": [
              "150260129"
            ]
          },
          "150260129": {
            "id": "150260129",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "It's kind of a long story, and there's tribal history involved, so you should hear it from an expert. Allier, if you could...",
            "nextDialogs": [
              "150260130"
            ]
          },
          "150260130": {
            "id": "150260130",
            "speakerId": 14648,
            "speakerName": "Allier",
            "text": "Of course! I don't often have an eager audience for this kind of thing... Nice to meet you. The name's Allier — I'm a Researcher from the Fontaine Research Institute.",
            "nextDialogs": [
              "150260131"
            ]
          },
          "150260131": {
            "id": "150260131",
            "speakerId": 14648,
            "speakerName": "Allier",
            "text": "Unlike most researchers, I have a keen interest in ancient ruins. That's why I was invited to join Monsieur Montluson's team.",
            "nextDialogs": [
              "150260132"
            ]
          },
          "150260132": {
            "id": "150260132",
            "speakerId": 14648,
            "speakerName": "Allier",
            "text": "Have you heard the legend of the great shaman, Huitzilin?"
          }
        }
      }
    },
    {
      "subId": "1502602",
      "subQuestName": "Go to Citlali's home",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150260201"
        ],
        "dialogs": {
          "150260201": {
            "id": "150260201",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "So, this is where the great shaman lives? A bit... far from civilization, isn't it? I hope the person who pointed us in this direction wasn't mistaken...",
            "nextDialogs": [
              "150260202"
            ]
          },
          "150260202": {
            "id": "150260202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "For someone like Citlali, it actually makes a lot of sense.",
            "nextDialogs": [
              "150260203"
            ]
          },
          "150260203": {
            "id": "150260203",
            "speakerId": 14648,
            "speakerName": "Allier",
            "text": "Is this graffiti her work, too? I wonder if it's a cultural practice... If I could just copy it down—",
            "nextDialogs": [
              "150260204"
            ]
          },
          "150260204": {
            "id": "150260204",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "We're here for a reason, Allier. As agreed, you two can do the talking, and we'll wait for you here.",
            "nextDialogs": [
              "150260205"
            ]
          },
          "150260205": {
            "id": "150260205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay, we'll go knock on the door! Hopefully she's not hungover...",
            "nextDialogs": [
              "150260206"
            ]
          },
          "150260206": {
            "id": "150260206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Citlali? Are you there? We need your help with something!",
            "nextDialogs": [
              "150260207"
            ]
          },
          "150260207": {
            "id": "150260207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...No response. Maybe she's not home?",
            "nextDialogs": [
              "150260208"
            ]
          },
          "150260208": {
            "id": "150260208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's try her other name.",
            "nextDialogs": [
              "150260209"
            ]
          },
          "150260209": {
            "id": "150260209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, uh... Granny Itztli? Are you home?",
            "nextDialogs": [
              "150260210"
            ]
          },
          "150260210": {
            "id": "150260210",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "The door is thrown open, and you're met with the pungent smell of alcohol.",
            "nextDialogs": [
              "150260211"
            ]
          },
          "150260211": {
            "id": "150260211",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Hey, kid! If you're here to challenge me, book an appointment first!",
            "nextDialogs": [
              "150260212"
            ]
          },
          "150260212": {
            "id": "150260212",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(So, Citlali's a real hermit, huh...)",
            "nextDialogs": [
              "150260213"
            ]
          },
          "150260213": {
            "id": "150260213",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "#...{NICKNAME}!",
            "nextDialogs": [
              "150260214"
            ]
          },
          "150260214": {
            "id": "150260214",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "The door closes abruptly.",
            "nextDialogs": [
              "150260215"
            ]
          },
          "150260215": {
            "id": "150260215",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Looks like we came at a bad time.",
            "nextDialogs": [
              "150260216"
            ]
          },
          "150260216": {
            "id": "150260216",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "*ahem*! Are you still there? Just come in, we can talk inside.",
            "nextDialogs": [
              "150260217"
            ]
          },
          "150260217": {
            "id": "150260217",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, at least we didn't get turned away..."
          }
        }
      }
    },
    {
      "subId": "1502603",
      "subQuestName": "Enter Citlali's home",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1502604",
      "subQuestName": "Talk to Citlali",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150260401"
        ],
        "dialogs": {
          "150260401": {
            "id": "150260401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, so this is where Citlali lives...",
            "nextDialogs": [
              "150260402"
            ]
          },
          "150260402": {
            "id": "150260402",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "I, uh, didn't have time to fully clean up the place... Complain if you want. Menial housework means nothing to a great shaman like myself.",
            "nextDialogs": [
              "150260403"
            ]
          },
          "150260403": {
            "id": "150260403",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Besides, in light novels, people who keep everything neat and tidy are always too boring to be the protagonists.",
            "nextDialogs": [
              "150260404"
            ]
          },
          "150260404": {
            "id": "150260404",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Also, I'm not a hermit. I'm just above superficial rules of societal etiquette.",
            "nextDialogs": [
              "150260405"
            ]
          },
          "150260405": {
            "id": "150260405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "She sure does care a lot about what we think of her...",
            "nextDialogs": [
              "150260406"
            ]
          },
          "150260406": {
            "id": "150260406",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Oh, and that spell I used to transfer my senses to you... You're not still, uh, experiencing the side-effects, are you?",
            "nextDialogs": [
              "150260407"
            ]
          },
          "150260407": {
            "id": "150260407",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "It's my duty as a great shaman to check that kind of thing.",
            "nextDialogs": [
              "150260408"
            ]
          },
          "150260408": {
            "id": "150260408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, you mean when we could hear your thoughts? Nope! It's been so long. We don't have to worry about that anymore, right?",
            "nextDialogs": [
              "150260409"
            ]
          },
          "150260409": {
            "id": "150260409",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "#Then, why do I hear {NICKNAME}'s thoughts in my head?",
            "nextDialogs": [
              "150260410"
            ]
          },
          "150260410": {
            "id": "150260410",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What?",
            "nextDialogs": [
              "150260411"
            ]
          },
          "150260411": {
            "id": "150260411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Oh, she heard me call her a hermit... That bothers her? I thought she was \"above superficial rules of societal etiquette\"...)",
            "nextDialogs": [
              "150260412"
            ]
          },
          "150260412": {
            "id": "150260412",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "I can still hear you, y'know!",
            "nextDialogs": [
              "150260413"
            ]
          },
          "150260413": {
            "id": "150260413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I apologize for offending you...",
            "nextDialogs": [
              "150260414"
            ]
          },
          "150260414": {
            "id": "150260414",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Don't bother, I'll find a way to fix it. First you hear my thoughts, now I'm hearing your thoughts...",
            "nextDialogs": [
              "150260415"
            ]
          },
          "150260415": {
            "id": "150260415",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "It was just a simple spell. I use it on you, and now it's on the fritz...",
            "nextDialogs": [
              "150260416"
            ]
          },
          "150260416": {
            "id": "150260416",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Forget it. Just tell me why you're here.",
            "nextDialogs": [
              "150260417"
            ]
          },
          "150260417": {
            "id": "150260417",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, someone asked us... to ask you... to be their consultant. They have questions about the history of Natlan.",
            "nextDialogs": [
              "150260418"
            ]
          },
          "150260418": {
            "id": "150260418",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "So, they asked the hero of Natlan to put in a good word? Sounds like they know I don't usually trouble myself with other people's problems.",
            "nextDialogs": [
              "150260419"
            ]
          },
          "150260419": {
            "id": "150260419",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The pay is really good!",
            "nextDialogs": [
              "150260420"
            ]
          },
          "150260420": {
            "id": "150260420",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Doesn't matter. I'm busy.",
            "nextDialogs": [
              "150260421"
            ]
          },
          "150260421": {
            "id": "150260421",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "She sure doesn't look busy... Paimon knew this wouldn't get us anywhere...",
            "nextDialogs": [
              "150260422"
            ]
          },
          "150260422": {
            "id": "150260422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What if the request comes from me?",
            "nextDialogs": [
              "150260423"
            ]
          },
          "150260423": {
            "id": "150260423",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "From you...",
            "nextDialogs": [
              "150260424"
            ]
          },
          "150260424": {
            "id": "150260424",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, we were given a sacred duty to help your tribe weave a special scroll!",
            "nextDialogs": [
              "150260425"
            ]
          },
          "150260425": {
            "id": "150260425",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Huh? So, you're the appointed ones this time?",
            "nextDialogs": [
              "150260426"
            ]
          },
          "150260426": {
            "id": "150260426",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We were surprised, too! After all, we have no idea how to weave a scroll like that.",
            "nextDialogs": [
              "150260427"
            ]
          },
          "150260427": {
            "id": "150260427",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But, with Chief Biram's help, we were able to make some progress!",
            "nextDialogs": [
              "150260428"
            ]
          },
          "150260428": {
            "id": "150260428",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We still haven't succeeded, but we learned that the key to weaving the scroll is a special kind of color.",
            "nextDialogs": [
              "150260429"
            ]
          },
          "150260429": {
            "id": "150260429",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The historical event those men want to ask about also involves color. If you help them, you might end up helping us, too!",
            "nextDialogs": [
              "150260430"
            ]
          },
          "150260430": {
            "id": "150260430",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "...",
            "nextDialogs": [
              "150260431"
            ]
          },
          "150260431": {
            "id": "150260431",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "She's giving us that face again... Did Paimon not explain things clearly?",
            "nextDialogs": [
              "150260432"
            ]
          },
          "150260432": {
            "id": "150260432",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "I can't decide whether this twist is completely out of the blue, or if it was foreshadowed all along...",
            "nextDialogs": [
              "150260433"
            ]
          },
          "150260433": {
            "id": "150260433",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um... Does that mean you won't help us?",
            "nextDialogs": [
              "150260434"
            ]
          },
          "150260434": {
            "id": "150260434",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "I... I need to think about it.",
            "nextDialogs": [
              "150260435"
            ]
          },
          "150260435": {
            "id": "150260435",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Then, there's still hope!",
            "nextDialogs": [
              "150260436"
            ]
          },
          "150260436": {
            "id": "150260436",
            "speakerId": 14649,
            "speakerName": "Grudoc",
            "text": "Hey! What's the hold-up? Just give us an answer already!",
            "nextDialogs": [
              "150260437"
            ]
          },
          "150260437": {
            "id": "150260437",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Y—You agreed to let us do the talking!",
            "nextDialogs": [
              "150260438"
            ]
          },
          "150260438": {
            "id": "150260438",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Ugh...",
            "nextDialogs": [
              "150260439"
            ]
          },
          "150260439": {
            "id": "150260439",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Citlali..."
          }
        }
      }
    },
    {
      "subId": "1502605",
      "subQuestName": "Leave Citlali's home",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1502606",
      "subQuestName": "Catch up to Citlali",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150260601"
        ],
        "dialogs": {
          "150260601": {
            "id": "150260601",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "Stand down, Grudoc! As your employer, if I tell you to wait, then you wait.",
            "nextDialogs": [
              "150260602"
            ]
          },
          "150260602": {
            "id": "150260602",
            "speakerId": 14649,
            "speakerName": "Grudoc",
            "text": "Understood.",
            "nextDialogs": [
              "150260603"
            ]
          },
          "150260603": {
            "id": "150260603",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "You're the great shaman who's been alive for centuries? But you're so... Ahem, apologies for the disturbance. Grudoc is a recent hire — so difficult to restrain sometimes.",
            "nextDialogs": [
              "150260604"
            ]
          },
          "150260604": {
            "id": "150260604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Phew... You're lucky you didn't force Citlali's hand.",
            "nextDialogs": [
              "150260605"
            ]
          },
          "150260605": {
            "id": "150260605",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "Well, since you're here, how about a discussion...?",
            "nextDialogs": [
              "150260606"
            ]
          },
          "150260606": {
            "id": "150260606",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Do you have any idea who I am? Did you think Granny Itztli would be fooled by your little performance?",
            "nextDialogs": [
              "150260607"
            ]
          },
          "150260607": {
            "id": "150260607",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "Um...",
            "nextDialogs": [
              "150260608"
            ]
          },
          "150260608": {
            "id": "150260608",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "I have no intention of speaking to you. Your \"recent hire\" interrupted me right as I was about to make an important decision.",
            "nextDialogs": [
              "150260609"
            ]
          },
          "150260609": {
            "id": "150260609",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Pull a trick like that again, and I'll make your lives a living horror novel, except ten times worse. That's all I came out here to say.",
            "nextDialogs": [
              "150260610"
            ]
          },
          "150260610": {
            "id": "150260610",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa...",
            "nextDialogs": [
              "150260611"
            ]
          },
          "150260611": {
            "id": "150260611",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "#{NICKNAME}, we have a discussion to finish.",
            "nextDialogs": [
              "150260612"
            ]
          },
          "150260612": {
            "id": "150260612",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "You live up to your name, Granny Itztli. I apologize for the offence. I'm just surprised the Battle of Seven Colors didn't pique your interest...",
            "nextDialogs": [
              "150260613"
            ]
          },
          "150260613": {
            "id": "150260613",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "You're investigating the Battle of Seven Colors?",
            "nextDialogs": [
              "150260614"
            ]
          },
          "150260614": {
            "id": "150260614",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "#Ah, {NICKNAME} didn't get to that part?",
            "nextDialogs": [
              "150260615"
            ]
          },
          "150260615": {
            "id": "150260615",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "#Yes, I thought {NICKNAME} could help me convince you. But, if I'm not mistaken, you have a personal interest in this matter, don't you?",
            "nextDialogs": [
              "150260616"
            ]
          },
          "150260616": {
            "id": "150260616",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "I heard that the great shaman, Huitzilin, was a friend of yours. You two must have been close...",
            "nextDialogs": [
              "150260617"
            ]
          },
          "150260617": {
            "id": "150260617",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "If I can resolve the controversy and prove the Battle took place, I'll include it in my next collection. Then, all of Teyvat will learn the truth.",
            "nextDialogs": [
              "150260618"
            ]
          },
          "150260618": {
            "id": "150260618",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "With your support, your friend's heroic deeds will once again be known throughout the land... Inspiring, don't you think?",
            "nextDialogs": [
              "150260621"
            ]
          },
          "150260621": {
            "id": "150260621",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "If this is really about that duty, then... Fine, I'll help you.",
            "nextDialogs": [
              "150260622"
            ]
          },
          "150260622": {
            "id": "150260622",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "I'm honored—",
            "nextDialogs": [
              "150260623"
            ]
          },
          "150260623": {
            "id": "150260623",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "#Save it — I agreed to help {NICKNAME}, not you. You'll just have to leech what you can.",
            "nextDialogs": [
              "150260624"
            ]
          },
          "150260624": {
            "id": "150260624",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, at least she agreed to help...",
            "nextDialogs": [
              "150260625"
            ]
          },
          "150260625": {
            "id": "150260625",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Looks like my friendship with Citlali came in handy after all. I never took her to be the heartless type, anyway.)",
            "nextDialogs": [
              "150260626"
            ]
          },
          "150260626": {
            "id": "150260626",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Who are you calling heartless?",
            "nextDialogs": [
              "150260627"
            ]
          },
          "150260627": {
            "id": "150260627",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "#Not a problem! I always planned to work with {NICKNAME}.",
            "nextDialogs": [
              "150260628"
            ]
          },
          "150260628": {
            "id": "150260628",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "So, did you directly experience any events of the Battle? Do you have any idea where it took place? Can you think of any relics we could use to prove it?",
            "nextDialogs": [
              "150260629"
            ]
          },
          "150260629": {
            "id": "150260629",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Talk at me why don't you...",
            "nextDialogs": [
              "150260630"
            ]
          },
          "150260630": {
            "id": "150260630",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "Um...",
            "nextDialogs": [
              "150260631"
            ]
          },
          "150260631": {
            "id": "150260631",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'd like to know, too.",
            "nextDialogs": [
              "150260632"
            ]
          },
          "150260632": {
            "id": "150260632",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Fine — no, no, and no.",
            "nextDialogs": [
              "150260633"
            ]
          },
          "150260633": {
            "id": "150260633",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "Uh...",
            "nextDialogs": [
              "150260634"
            ]
          },
          "150260634": {
            "id": "150260634",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "I did live during the same era as her, but that doesn't mean we experienced the same events. I've lived a long time, but I'm not a walking encyclopedia.",
            "nextDialogs": [
              "150260635"
            ]
          },
          "150260635": {
            "id": "150260635",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "You decide the angle of your investigation, and I'll provide answers if I'm familiar with the subject.",
            "nextDialogs": [
              "150260636"
            ]
          },
          "150260636": {
            "id": "150260636",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "...Alright. Even if you didn't witness the battle yourself, you still lived through that era. Your insights are very valuable!",
            "nextDialogs": [
              "150260637"
            ]
          },
          "150260637": {
            "id": "150260637",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "Allier, you had an idea about where to start, yes?",
            "nextDialogs": [
              "150260638"
            ]
          },
          "150260638": {
            "id": "150260638",
            "speakerId": 14648,
            "speakerName": "Allier",
            "text": "Oh, well, my plan was to consult the members of the tribe in charge of recording history.",
            "nextDialogs": [
              "150260639"
            ]
          },
          "150260639": {
            "id": "150260639",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "Then, let's start there.",
            "nextDialogs": [
              "150260640"
            ]
          },
          "150260640": {
            "id": "150260640",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "#{NICKNAME}, what do you say to officially working together? After all, it appears I can only get Miss Citlali's help through you.",
            "nextDialogs": [
              "150260641"
            ]
          },
          "150260641": {
            "id": "150260641",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sounds good."
          }
        }
      }
    },
    {
      "subId": "1502650",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150265001"
        ],
        "dialogs": {
          "150265001": {
            "id": "150265001",
            "speakerId": 14648,
            "speakerName": "Allier",
            "text": "A great shaman who has lived for hundreds of years... If she agrees to help us, there are so many things we could research!",
            "nextDialogs": [
              "150265002"
            ]
          },
          "150265002": {
            "id": "150265002",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "Allier, as the provider of your research funding, I suggest you focus on our current mission. It's very important to me.",
            "nextDialogs": [
              "150265003"
            ]
          },
          "150265003": {
            "id": "150265003",
            "speakerId": 14648,
            "speakerName": "Allier",
            "text": "Sorry. Maybe, if we get a chance in the future, then...",
            "nextDialogs": [
              "150265004"
            ]
          },
          "150265004": {
            "id": "150265004",
            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "We'll cross that bridge when we come to it."
          }
        }
      }
    },
    {
      "subId": "1502699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150269999"
        ],
        "dialogs": {
          "150269999": {
            "id": "150269999",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Citlali suddenly walks out, and you rush after her."
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "7405029",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740502201"
        ],
        "dialogs": {
          "740502201": {
            "id": "740502201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Hm? {NICKNAME}, look over there. It looks like someone left some notes...",
            "nextDialogs": [
              "740502202"
            ]
          },
          "740502202": {
            "id": "740502202",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...During the observation of maritime creatures, a Blubberbeast pup was rescued from a ray-style clockwork meka that lost control...\"",
            "nextDialogs": [
              "740502203"
            ]
          },
          "740502203": {
            "id": "740502203",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...Basic biological tests were conducted... Turned out it is much weaker than regular Blubberbeasts. If it is returned to its original habitat, the estimated chance of survival would be no more than 20%...\"",
            "nextDialogs": [
              "740502204"
            ]
          },
          "740502204": {
            "id": "740502204",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...A conclusion has been made. The Blubberbeast will be kept and taken care of in the observatory station. If it can grow up healthily, its estimated chance of survival will be increased to approximately 70%...\"",
            "nextDialogs": [
              "740502205"
            ]
          },
          "740502205": {
            "id": "740502205",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...After giving it some thought, I decided to name it 'Berrypuff.' Though it doesn't resemble berries in any way, it looked really happy when I gave it one, so Berrypuff it is.\"",
            "nextDialogs": [
              "740502206"
            ]
          },
          "740502206": {
            "id": "740502206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Turn page.)",
            "nextDialogs": [
              "740502207"
            ]
          },
          "740502207": {
            "id": "740502207",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...The research funds have been withdrawn by the supervisor, who said that the funds will be re-purposed for something like 'An Innovative Circuit Design Using Clockwork Meka to Simulate the Rock-Paper-Scissors Game and Its Sociological Impact'...\"",
            "nextDialogs": [
              "740502213"
            ]
          },
          "740502213": {
            "id": "740502213",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...Even such nonsense can be approved. What are those people even thinking...\"",
            "nextDialogs": [
              "740502208"
            ]
          },
          "740502208": {
            "id": "740502208",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...I should've gone to Sumeru and joined the Amurta there... These guys should just become mechanisms themselves if they care about those so much!\"",
            "nextDialogs": [
              "740502209"
            ]
          },
          "740502209": {
            "id": "740502209",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...I have no choice but to go back first... But I can't find a way to take Berrypuff with me... It can't adapt to the environment on land. I have to leave it here...\"",
            "nextDialogs": [
              "740502210"
            ]
          },
          "740502210": {
            "id": "740502210",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"If my calculations are correct, the rest of the food should be enough to last Berrypuff and allow it to grow up healthily...\"",
            "nextDialogs": [
              "740502211"
            ]
          },
          "740502211": {
            "id": "740502211",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, the handwriting looks pretty new...",
            "nextDialogs": [
              "740502212"
            ]
          },
          "740502212": {
            "id": "740502212",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Paimon can't stop wondering if the Blubberbeast in the note is doing alright... {NICKNAME}, shall we go in and check it out?"
          }
        }
      }
    },
    {
      "subId": "7405001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740500101"
        ],
        "dialogs": {
          "740500101": {
            "id": "740500101",
            "speakerId": 1002,
            "speakerName": "Blubberbeast",
            "text": "Blub...",
            "nextDialogs": [
              "740500102"
            ]
          },
          "740500102": {
            "id": "740500102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "This should be the \"Berrypuff\" that was mentioned in the note. Poor thing, it looks pale and haggard...",
            "nextDialogs": [
              "740500103"
            ]
          },
          "740500103": {
            "id": "740500103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh, did that engineer really believe their calculations were correct? The food has already run out!",
            "nextDialogs": [
              "740500104"
            ]
          },
          "740500104": {
            "id": "740500104",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Maybe the Fontaine Research Institute blew up because it's full of people like this... Anyway, {NICKNAME}, let's give it some food!",
            "nextDialogs": [
              "740500105"
            ]
          },
          "740500105": {
            "id": "740500105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What do Blubberbeasts eat though? Hmmm... if there's some fish...",
            "nextDialogs": [
              "740500106"
            ]
          },
          "740500106": {
            "id": "740500106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But this area should be teeming with fish...",
            "nextDialogs": [
              "740500107"
            ]
          },
          "740500107": {
            "id": "740500107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmmm, it could be that it's too weak to catch up to the fish... So let's try feeding it the stuff we've got instead, shall we?"
          }
        }
      }
    },
    {
      "subId": "7405002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740500201"
        ],
        "dialogs": {
          "740500201": {
            "id": "740500201",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "(The helpless little Blubberbeast gazes at you with vigilance, though it has no more strength to run away.)"
          }
        }
      }
    },
    {
      "subId": "7405003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740500301"
        ],
        "dialogs": {
          "740500301": {
            "id": "740500301",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "The Blubberbeast sniffs at the food in your hands tentatively while glancing at you warily. It does not sense malicious intent from you, and cautiously takes a bite...\\n...Though it was slightly hesitant at first, it quickly becomes ravenous, wolfing down all the food you hand to it. Seems like it has been starving for quite some time...",
            "nextDialogs": [
              "740500302"
            ]
          },
          "740500302": {
            "id": "740500302",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "After a while, the Blubberbeast regains its stamina and barks twice at you before clapping its belly, seemingly its way of offering thanks to a stranger...",
            "nextDialogs": [
              "740500303"
            ]
          },
          "740500303": {
            "id": "740500303",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "Blub blub...",
            "nextDialogs": [
              "740500304"
            ]
          },
          "740500304": {
            "id": "740500304",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Heehee, it looks very happy and it's not that scared of us anymore!",
            "nextDialogs": [
              "740500305"
            ]
          },
          "740500305": {
            "id": "740500305",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yes, yes, eat to your heart's content, then you'll recover!",
            "nextDialogs": [
              "740500306"
            ]
          },
          "740500306": {
            "id": "740500306",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Although... Paimon doesn't think we can just leave it alone... {NICKNAME}, how about we come back and check on this Blubberbeast every now and then?"
          }
        }
      }
    },
    {
      "subId": "7405024",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740502401"
        ],
        "dialogs": {
          "740502401": {
            "id": "740502401",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "Blub blub!",
            "nextDialogs": [
              "740502402"
            ]
          },
          "740502402": {
            "id": "740502402",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Heehee, Berrypuff seems to be able to recognize us now!",
            "nextDialogs": [
              "740502403"
            ]
          },
          "740502403": {
            "id": "740502403",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That's right! It's us again! We brought you food too!",
            "nextDialogs": [
              "740502404"
            ]
          },
          "740502404": {
            "id": "740502404",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, let's feed Berrypuff something delicious just like last time, shall we?",
            "nextDialogs": [
              "740500401"
            ]
          },
          "740500401": {
            "id": "740500401",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "(For some reason, the Blubberbeast doesn't seem to be paying attention to you...)"
          }
        }
      }
    },
    {
      "subId": "7405006",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740500501"
        ],
        "dialogs": {
          "740500501": {
            "id": "740500501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Why aren't you eating anymore...",
            "nextDialogs": [
              "740500503",
              "740500505"
            ]
          },
          "740500503": {
            "id": "740500503",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, but Berrypuff doesn't look that energetic? If it already ate, it should be more active, right?",
            "nextDialogs": [
              "740500506"
            ]
          },
          "740500506": {
            "id": "740500506",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, speaking about not being picky, it seems to be looking in that direction...",
            "nextDialogs": [
              "740500507"
            ]
          },
          "740500507": {
            "id": "740500507",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "Blub... blub!!!",
            "nextDialogs": [
              "740500508"
            ]
          },
          "740500508": {
            "id": "740500508",
            "speakerId": 1002,
            "speakerName": "Blubberbeast",
            "text": "Blub...",
            "nextDialogs": [
              "740500509"
            ]
          },
          "740500509": {
            "id": "740500509",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ahhh! There is another Blubberbeast trapped by waterweeds!",
            "nextDialogs": [
              "740500510"
            ]
          },
          "740500510": {
            "id": "740500510",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#So that's why it's been acting weirdly. It's too worried about its partner to eat! {NICKNAME}, let's cut off the waterweeds and set its friend free!"
          },
          "740500505": {
            "id": "740500505",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "No, that won't work! Being picky is bad! Well, Paimon wants to say that, but Berrypuff really looks pretty tired, so maybe pickiness is not the problem here..."
          }
        }
      }
    },
    {
      "subId": "7405007",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740500701"
        ],
        "dialogs": {
          "740500701": {
            "id": "740500701",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "This time, the Blubberbeast sniffs the food you hand over inquiringly, before swallowing it in one gulp, happily clapping its stomach afterward.",
            "nextDialogs": [
              "740500702"
            ]
          },
          "740500702": {
            "id": "740500702",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "The Blubberbeast circles you a few times as if in thanks and then turns around. Through the partition of crystalline transparence, it joins its kindred in something akin to a song, their voices joyous...",
            "nextDialogs": [
              "740500703"
            ]
          },
          "740500703": {
            "id": "740500703",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yeah, that should do it!",
            "nextDialogs": [
              "740500704"
            ]
          },
          "740500704": {
            "id": "740500704",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#It seems like it's having a lot of fun with its own kind! {NICKNAME}, maybe we should leave them be for now."
          }
        }
      }
    },
    {
      "subId": "7405008",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740500801"
        ],
        "dialogs": {
          "740500801": {
            "id": "740500801",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "(The Blubberbeast looks anxious and keeps staring at a particular direction...)"
          }
        }
      }
    },
    {
      "subId": "7405025",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740502501"
        ],
        "dialogs": {
          "740502501": {
            "id": "740502501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ahhh, so this is where it was hiding!",
            "nextDialogs": [
              "740502502"
            ]
          },
          "740502502": {
            "id": "740502502",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "Blub blub...",
            "nextDialogs": [
              "740502503"
            ]
          },
          "740502503": {
            "id": "740502503",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Don't be afraid. It's us! {NICKNAME}, let's feed Berrypuff, just like we did before!"
          }
        }
      }
    },
    {
      "subId": "7405010",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740501001"
        ],
        "dialogs": {
          "740501001": {
            "id": "740501001",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "Blub?",
            "nextDialogs": [
              "740501002"
            ]
          },
          "740501002": {
            "id": "740501002",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Berrypuff doesn't seem to be scared now. Is it because it can sense there's no danger now?",
            "nextDialogs": [
              "740501003"
            ]
          },
          "740501003": {
            "id": "740501003",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Good. Let's give it some food, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "7405011",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740501101"
        ],
        "dialogs": {
          "740501101": {
            "id": "740501101",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "The Blubberbeast sniffs the food you offer and scarfs it down without hesitation before affectionately licking your hand.\\nIt then swims to one side and begins a joyous chorus with its friend through the glass...",
            "nextDialogs": [
              "740501102"
            ]
          },
          "740501102": {
            "id": "740501102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Heehee, it is getting close with us!",
            "nextDialogs": [
              "740501103"
            ]
          },
          "740501103": {
            "id": "740501103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You gotta get better soon! Once you fully recover, you can go back to the sea and play with your own kind again!"
          }
        }
      }
    },
    {
      "subId": "7405012",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740500901"
        ],
        "dialogs": {
          "740500901": {
            "id": "740500901",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmph? Strange, it still looks like it has no appetite...",
            "nextDialogs": [
              "740500902"
            ]
          },
          "740500902": {
            "id": "740500902",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Its friend that was trapped by the seagrass is over there, so it shouldn't have anything to worry about, right? ...Maybe it's sick?",
            "nextDialogs": [
              "740500903"
            ]
          },
          "740500903": {
            "id": "740500903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There might be something troubling it on the other side...",
            "nextDialogs": [
              "740500904"
            ]
          },
          "740500904": {
            "id": "740500904",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Other side?",
            "nextDialogs": [
              "740500905"
            ]
          },
          "740500905": {
            "id": "740500905",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Hm... We can't see it from over here. {NICKNAME}, how about we go over and take a look?"
          }
        }
      }
    },
    {
      "subId": "7405013",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740501301"
        ],
        "dialogs": {
          "740501301": {
            "id": "740501301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "I—It's not eating at all...",
            "nextDialogs": [
              "740501302"
            ]
          },
          "740501302": {
            "id": "740501302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It keeps looking over at that direction...",
            "nextDialogs": [
              "740501303"
            ]
          },
          "740501303": {
            "id": "740501303",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? That direction?",
            "nextDialogs": [
              "740501304"
            ]
          },
          "740501304": {
            "id": "740501304",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa! Paimon can't see what's going on back there clearly...",
            "nextDialogs": [
              "740501305"
            ]
          },
          "740501305": {
            "id": "740501305",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Strange... Berrypuff's friend is usually here, but it hasn't shown up at all today.",
            "nextDialogs": [
              "740501306"
            ]
          },
          "740501306": {
            "id": "740501306",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon thinks she heard that Blubberbeasts can communicate using songs we can't hear...",
            "nextDialogs": [
              "740501307"
            ]
          },
          "740501307": {
            "id": "740501307",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Oh no, could it be trapped in the seagrass over there like last time? {NICKNAME}, let's go over and check it out!"
          }
        }
      }
    },
    {
      "subId": "7405014",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740501401"
        ],
        "dialogs": {
          "740501401": {
            "id": "740501401",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "♪~",
            "nextDialogs": [
              "740501402"
            ]
          },
          "740501402": {
            "id": "740501402",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It seems to be in much better spirits than last time! It should make a full recovery soon and return to the sea with its companion!"
          }
        }
      }
    },
    {
      "subId": "7405026",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740502601"
        ],
        "dialogs": {
          "740502601": {
            "id": "740502601",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Berrypuff seems a bit uneasy... Maybe it's hungry?",
            "nextDialogs": [
              "740502602"
            ]
          },
          "740502602": {
            "id": "740502602",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Let's feed it some food, {NICKNAME}!",
            "nextDialogs": [
              "740502603"
            ]
          },
          "740502603": {
            "id": "740502603",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "Blub blub...!"
          }
        }
      }
    },
    {
      "subId": "7405016",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740501601"
        ],
        "dialogs": {
          "740501601": {
            "id": "740501601",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa, it's gotten so big! Maybe we should start calling it Berrypuffier!",
            "nextDialogs": [
              "740501612"
            ]
          },
          "740501612": {
            "id": "740501612",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And it looks really healthy too, all thanks to our hard work feeding it!",
            "nextDialogs": [
              "740501602"
            ]
          },
          "740501602": {
            "id": "740501602",
            "speakerId": 1005,
            "speakerName": "Berrypuffier",
            "text": "Blub blub!",
            "nextDialogs": [
              "740501603"
            ]
          },
          "740501603": {
            "id": "740501603",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, if that is the case, perhaps we should send it back to the sea? It is its home, after all.",
            "nextDialogs": [
              "740501604"
            ]
          },
          "740501604": {
            "id": "740501604",
            "speakerId": 1005,
            "speakerName": "Berrypuffier",
            "text": "Blub...?",
            "nextDialogs": [
              "740501605"
            ]
          },
          "740501605": {
            "id": "740501605",
            "speakerId": 1005,
            "speakerName": "Berrypuffier",
            "text": "(The Blubberbeast seems to understand your intention and looks a bit hesitant...)",
            "nextDialogs": [
              "740501606"
            ]
          },
          "740501606": {
            "id": "740501606",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm? Doesn't it want to leave?",
            "nextDialogs": [
              "740501607"
            ]
          },
          "740501607": {
            "id": "740501607",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, Paimon understands. This place must already feel like home.",
            "nextDialogs": [
              "740501608"
            ]
          },
          "740501608": {
            "id": "740501608",
            "speakerId": 1005,
            "speakerName": "Berrypuffier",
            "text": "Blub...",
            "nextDialogs": [
              "740501609"
            ]
          },
          "740501609": {
            "id": "740501609",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Heehee, it's okay! Though the sea is a vast place, you can come back anytime you want!",
            "nextDialogs": [
              "740501610"
            ]
          },
          "740501610": {
            "id": "740501610",
            "speakerId": 1005,
            "speakerName": "Berrypuffier",
            "text": "...",
            "nextDialogs": [
              "740501611"
            ]
          },
          "740501611": {
            "id": "740501611",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You take the Blubberbeast outside..."
          }
        }
      }
    },
    {
      "subId": "7405017",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740501701"
        ],
        "dialogs": {
          "740501701": {
            "id": "740501701",
            "speakerId": 1005,
            "speakerName": "Berrypuffier",
            "text": "Blub... blub...",
            "nextDialogs": [
              "740501702"
            ]
          },
          "740501702": {
            "id": "740501702",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm? It's looking at the direction of the aquarium, no? Doesn't want to leave, huh?",
            "nextDialogs": [
              "740501703"
            ]
          },
          "740501703": {
            "id": "740501703",
            "speakerId": 1005,
            "speakerName": "Berrypuffier",
            "text": "Blub... blub!",
            "nextDialogs": [
              "740501704"
            ]
          },
          "740501704": {
            "id": "740501704",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, it doesn't seem to mean that...",
            "nextDialogs": [
              "740501705"
            ]
          },
          "740501705": {
            "id": "740501705",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh! Its old friend is here!",
            "nextDialogs": [
              "740501706"
            ]
          },
          "740501706": {
            "id": "740501706",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Even though you've grown up, you should still have fun with your friends!",
            "nextDialogs": [
              "740501707"
            ]
          },
          "740501707": {
            "id": "740501707",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Goodbye, Berrypuff. Take good care of yourself!",
            "nextDialogs": [
              "740501708"
            ]
          },
          "740501708": {
            "id": "740501708",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "The grown-up Blubberbeast seems a little reluctant to leave. It comes to you and gently rubs your cheek, as if saying goodbye. Before swimming away, it seems to remember something. It bows its head, bites your sleeve lightly, then raises its head again, and barks softly in the direction of the aquarium twice..."
          }
        }
      }
    },
    {
      "subId": "7405019",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740501901"
        ],
        "dialogs": {
          "740501901": {
            "id": "740501901",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "♪~",
            "nextDialogs": [
              "740501902"
            ]
          },
          "740501902": {
            "id": "740501902",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Heehee, looks like you're really happy. If you recover soon, you'll be able to go out and play with your friend!",
            "nextDialogs": [
              "740501903"
            ]
          },
          "740501903": {
            "id": "740501903",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Alright, Paimon thinks it's full already. Let's come back later.",
            "nextDialogs": [
              "740501904"
            ]
          },
          "740501904": {
            "id": "740501904",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Hmmm... Seeing Berrypuff eat is making Paimon hungry... {NICKNAME}, let's get Paimon some food, too!"
          }
        }
      }
    },
    {
      "subId": "7405020",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],

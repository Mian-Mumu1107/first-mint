              "740502002"
            ]
          },
          "740502002": {
            "id": "740502002",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Heehee, it seems really happy to be with its friend!",
            "nextDialogs": [
              "740502003"
            ]
          },
          "740502003": {
            "id": "740502003",
            "speakerId": 1000,
            "speakerName": "Paimon",

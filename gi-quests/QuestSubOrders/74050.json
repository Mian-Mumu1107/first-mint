    {
      "subId": "7405021",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740501501"
        ],
        "dialogs": {
          "740501501": {
            "id": "740501501",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You offer some food and Berrypuff quickly swims out and unhesitatingly devours the treat.\\nYou tentatively reach out a hand to pet the little Blubberbeast. It feels softer and warmer than you expected, almost as if you're running your hands across a plush toy made from velvet.",
            "nextDialogs": [
              "740501502"
            ]
          },
          "740501502": {
            "id": "740501502",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe! It trusts us completely now!",
            "nextDialogs": [
              "740501503"
            ]
          },
          "740501503": {
            "id": "740501503",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Looks like the Blubberbeast will grow up very soon! Oh, Paimon can't wait!",
            "nextDialogs": [
              "740501504"
            ]
          },
          "740501504": {
            "id": "740501504",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Why don't we come back to visit it again later, {NICKNAME}?"
          }
        }
      }
    },
    {
      "subId": "7405027",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740502701"
        ],
        "dialogs": {
          "740502701": {
            "id": "740502701",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "Blub...",
            "nextDialogs": [
              "740502702"
            ]
          },
          "740502702": {
            "id": "740502702",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Looks like Berrypuff is concerned about what's happening over there... Let's go and check it out, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "7405006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740500601"
        ],
        "dialogs": {
          "740500601": {
            "id": "740500601",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "♪~",
            "nextDialogs": [
              "740500602"
            ]
          },
          "740500602": {
            "id": "740500602",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Heehee, it looks very happy! Well then, {NICKNAME}, let's give it some food!"
          }
        }
      }
    },
    {
      "subId": "7405012",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740501201"
        ],
        "dialogs": {
          "740501201": {
            "id": "740501201",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "(The Blubberbeast gently bites your sleeve and looks very anxious and upset. Seems as if it is trying to pull you to a certain direction...)"
          }
        }
      }
    },
    {
      "subId": "7405014",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740501403"
        ],
        "dialogs": {
          "740501403": {
            "id": "740501403",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ohh, so it lost its appetite because it was worried about its friend!",
            "nextDialogs": [
              "740501404"
            ]
          },
          "740501404": {
            "id": "740501404",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But why would there be this many clockwork meka around here? And they're even attacking innocent animals... Shouldn't the Fontaine Research Institute do something about all this?",
            "nextDialogs": [
              "740501405"
            ]
          },
          "740501405": {
            "id": "740501405",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Anyway, {NICKNAME}, let's give it the food we prepared!"
          }
        }
      }
    },
    {
      "subId": "7405018",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740501801"
        ],
        "dialogs": {
          "740501801": {
            "id": "740501801",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "...Blub?",
            "nextDialogs": [
              "740501803",
              "740501806"
            ]
          },
          "740501803": {
            "id": "740501803",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "(Berrypuff gazes at you with a confused look and pats its belly a couple of times. Seems it does not understand what you want...)",
            "nextDialogs": [
              "740501804"
            ]
          },
          "740501804": {
            "id": "740501804",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... Seems like Berrypuff can't grasp such a kind of movement for now, but it might be able to learn once it's grown a bit more!"
          },
          "740501806": {
            "id": "740501806",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "(Berrypuff takes a few sniffs of your food but does not eat it. Instead, it turns away...)",
            "nextDialogs": [
              "740501807"
            ]
          },
          "740501807": {
            "id": "740501807",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#We just fed it a while ago. It is probably not hungry now. Let's come back later, {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "7405021",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740502101"
        ],
        "dialogs": {
          "740502101": {
            "id": "740502101",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "Blub?",
            "nextDialogs": [
              "740502103",
              "740502106"
            ]
          },
          "740502103": {
            "id": "740502103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa! Berrypuff can pull off such complicated movements now!",
            "nextDialogs": [
              "740502104"
            ]
          },
          "740502104": {
            "id": "740502104",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe, our effort sure paid off! Now Berrypuff should be just fine after it returns to the sea!"
          },
          "740502106": {
            "id": "740502106",
            "speakerId": 1003,
            "speakerName": "Berrypuff",
            "text": "(Berrypuff sniffs your food and bows its head gently to rub it against your hand, but it doesn't seem to be hungry...)",
            "nextDialogs": [
              "740502107"
            ]
          },
          "740502107": {
            "id": "740502107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#We just fed it a while ago. It is probably not hungry now. Let's come back later, {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "7405023",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740502301"
        ],
        "dialogs": {
          "740502301": {
            "id": "740502301",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...During the observation of maritime creatures, a Blubberbeast pup was rescued from a ray-style clockwork meka that lost control...\"",
            "nextDialogs": [
              "740502302"
            ]
          },
          "740502302": {
            "id": "740502302",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...Basic biological tests were conducted... Turned out it is much weaker than regular Blubberbeasts. If it is returned to its original habitat, the estimated chance of survival would be no more than 20%...\"",
            "nextDialogs": [
              "740502303"
            ]
          },
          "740502303": {
            "id": "740502303",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...A conclusion has been made. The Blubberbeast will be kept and taken care of in the observatory station. If it can grow up healthily, its estimated chance of survival will be increased to approximately 70%...\"",
            "nextDialogs": [
              "740502304"
            ]
          },
          "740502304": {
            "id": "740502304",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...After giving it some thought, I decided to name it 'Berrypuff.' Though it doesn't resemble berries in any way, it looked really happy when I gave it one, so Berrypuff it is.\"",
            "nextDialogs": [
              "740502305"
            ]
          },
          "740502305": {
            "id": "740502305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Turn page.)",
            "nextDialogs": [
              "740502306"
            ]
          },
          "740502306": {
            "id": "740502306",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...The research funds have been withdrawn by the supervisor, who said that the funds will be re-purposed for something like 'An Innovative Circuit Design Using Clockwork Meka to Simulate the Rock-Paper-Scissors Game and Its Sociological Impact'...\"",
            "nextDialogs": [
              "740502310"
            ]
          },
          "740502310": {
            "id": "740502310",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...Even such nonsense can be approved. What are those people even thinking...\"",
            "nextDialogs": [
              "740502307"
            ]
          },
          "740502307": {
            "id": "740502307",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...I should've gone to Sumeru and joined the Amurta there... These guys should just become mechanisms themselves if they care about those so much!\"",
            "nextDialogs": [
              "740502308"
            ]
          },
          "740502308": {
            "id": "740502308",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"...I have no choice but to go back first... But I can't find a way to take Berrypuff with me... It can't adapt to the environment on land. I have to leave it here...\"",
            "nextDialogs": [
              "740502309"
            ]
          },
          "740502309": {
            "id": "740502309",
            "speakerId": 1001,
            "speakerName": "Engineer's Notes",
            "text": "\"If my calculations are correct, the rest of the food should be enough to last Berrypuff and allow it to grow up healthily...\""
          }
        }
      }
    },

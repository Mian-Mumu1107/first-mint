            "speakerId": -1,
            "speakerName": "Player",
            "text": "Good luck, you can do it.",
            "nextDialogs": [
              "719250102"
            ]
          },
          "719250102": {
            "id": "719250102",
            "speakerId": 2304,
            "speakerName": "Dongdong",
            "text": "Thanks! You're one of the few people in the village to encourage me!",
            "nextDialogs": [
              "719250103"
            ]
          },
          "719250103": {
            "id": "719250103",
            "speakerId": 2304,
            "speakerName": "Dongdong",
            "text": "All the other villagers say I'll never become a big hero like my dad, because I don't drink my milk...",
            "nextDialogs": [
              "719250104"
            ]
          },
          "719250104": {
            "id": "719250104",
            "speakerId": 2304,
            "speakerName": "Dongdong",
            "text": "But who says heroes have to drink milk? That stuff tastes so weird.",
            "nextDialogs": [
              "719250105"
            ]
          },
          "719250105": {
            "id": "719250105",
            "speakerId": 2304,
            "speakerName": "Dongdong",
            "text": "Still, it'd be a shame to let it all go to waste... Why don't you take it instead?",
            "nextDialogs": [
              "719250106"
            ]
          },
          "719250106": {
            "id": "719250106",
            "speakerId": 2304,
            "speakerName": "Dongdong",
            "text": "Just don't tell anyone, okay!"
          }
        }
      }
    }

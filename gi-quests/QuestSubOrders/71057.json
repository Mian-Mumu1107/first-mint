    {
      "subId": "7105709",
      "subQuestName": "Bring Uncle He back to camp to meet Jinwu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710570601"
        ],
        "dialogs": {
          "710570601": {
            "id": "710570601",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Mushroom meat... Hee-hee... A mushroom meal in my tummy, small mushrooms, mushroom creatures, big mushrooms... Hee-hee...",
            "nextDialogs": [
              "710570602"
            ]
          },
          "710570602": {
            "id": "710570602",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Uncle He? What's happened to your face?",
            "nextDialogs": [
              "710570603"
            ]
          },
          "710570603": {
            "id": "710570603",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "*sigh*... I knew you were alive! To think that your family even invited me to your funeral! I refused to go, you know. Told them that nothing was certain yet without a body.",
            "nextDialogs": [
              "710570604"
            ]
          },
          "710570604": {
            "id": "710570604",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Look at your face. It must've been tough for you, being trapped in the mine like that. But anyway, I'm glad that you're still alive!",
            "nextDialogs": [
              "710570605"
            ]
          },
          "710570605": {
            "id": "710570605",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Being alive is good, yes! Living, breathing mushrooms are delicious! Hee-hee...",
            "nextDialogs": [
              "710570606"
            ]
          },
          "710570606": {
            "id": "710570606",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Uncle He?",
            "nextDialogs": [
              "710570607"
            ]
          },
          "710570607": {
            "id": "710570607",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "He was like this when we found him.",
            "nextDialogs": [
              "710570608"
            ]
          },
          "710570608": {
            "id": "710570608",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "He wasn't quite all there... and he kept saying that he wanted to eat mushrooms.",
            "nextDialogs": [
              "710570609"
            ]
          },
          "710570609": {
            "id": "710570609",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Mushrooms...",
            "nextDialogs": [
              "710570610"
            ]
          },
          "710570610": {
            "id": "710570610",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "The Chasm is a dangerous place for ordinary people. Plants and fungi growing here could also be harmful to the human body. That's why Huishan Hall has set strict rules against eating these things.",
            "nextDialogs": [
              "710570611"
            ]
          },
          "710570611": {
            "id": "710570611",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "But Uncle He's been trapped down here all these years with nothing else to eat.",
            "nextDialogs": [
              "710570612"
            ]
          },
          "710570612": {
            "id": "710570612",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "How am I supposed to face his family with him in this state?",
            "nextDialogs": [
              "710570615"
            ]
          },
          "710570615": {
            "id": "710570615",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Now that you mention it, Khedive might be able to help. After all, he's a scholar from Sumeru. He must've conducted some research on mushrooms.",
            "nextDialogs": [
              "710570616"
            ]
          },
          "710570616": {
            "id": "710570616",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Please wait here. I'll bring him over to check up on Uncle He.",
            "nextDialogs": [
              "710570617"
            ]
          },
          "710570617": {
            "id": "710570617",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Mushroom meat... mushroom meat...",
            "nextDialogs": [
              "710570618"
            ]
          },
          "710570618": {
            "id": "710570618",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "*sigh* With how messed up Uncle He is, Paimon's really not sure if he can recover.",
            "nextDialogs": [
              "710570619"
            ]
          },
          "710570619": {
            "id": "710570619",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "If he goes back to his family like this, they'll still be pretty saddened...",
            "nextDialogs": [
              "710570620"
            ]
          },
          "710570620": {
            "id": "710570620",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "You can't just kidnap me here while I was halfway through my report, Jinwu! I know you're in charge of the team's safety, but you can't just disturb my research like that...",
            "nextDialogs": [
              "710570621"
            ]
          },
          "710570621": {
            "id": "710570621",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "I'm seriously considering cutting your budget as they proposed.",
            "nextDialogs": [
              "710570622"
            ]
          },
          "710570622": {
            "id": "710570622",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Never mind the budget.",
            "nextDialogs": [
              "710570623"
            ]
          },
          "710570623": {
            "id": "710570623",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Please check on this man here...",
            "nextDialogs": [
              "710570624"
            ]
          },
          "710570624": {
            "id": "710570624",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "It's itchy inside my earsies... Hee-hee...",
            "nextDialogs": [
              "710570625"
            ]
          },
          "710570625": {
            "id": "710570625",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "Huh? Who is he? And why does he look like that?",
            "nextDialogs": [
              "710570626"
            ]
          },
          "710570626": {
            "id": "710570626",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "#Did you find him, {NICKNAME}? ...Seriously, how are you always able to stumble upon such peculiar events...",
            "nextDialogs": [
              "710570627"
            ]
          },
          "710570627": {
            "id": "710570627",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "Then... How was he like when you found him?",
            "nextDialogs": [
              "710570628"
            ]
          },
          "710570628": {
            "id": "710570628",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You tell Khedive what happened to Uncle He...\\nKhedive performs a careful examination on him.",
            "nextDialogs": [
              "710570629"
            ]
          },
          "710570629": {
            "id": "710570629",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "He's fine. It's not a big deal.",
            "nextDialogs": [
              "710570630"
            ]
          },
          "710570630": {
            "id": "710570630",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "You know how he always complains about the itchiness in his ears? That's because the spores of the fungi have entered his ears.",
            "nextDialogs": [
              "710570631"
            ]
          },
          "710570631": {
            "id": "710570631",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "Although long-term consumption of this type of fungus — I mean, mushroom — does impair one's sanity, it doesn't hurt the body.",
            "nextDialogs": [
              "710570632"
            ]
          },
          "710570632": {
            "id": "710570632",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "So you're saying he can recover?",
            "nextDialogs": [
              "710570633"
            ]
          },
          "710570633": {
            "id": "710570633",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "I've already cleared his body of the fungi and made some medicine to treat his neurological disorder.",
            "nextDialogs": [
              "710570634"
            ]
          },
          "710570634": {
            "id": "710570634",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "He's very likely to recover if given ample rest.",
            "nextDialogs": [
              "710570635"
            ]
          },
          "710570635": {
            "id": "710570635",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "I see. Then, about the cost of the medicine...",
            "nextDialogs": [
              "710570636"
            ]
          },
          "710570636": {
            "id": "710570636",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "None of the ingredients are expensive — they're only worth a month's meals at Xinyue Kiosk. It's not a big deal.",
            "nextDialogs": [
              "710570637"
            ]
          },
          "710570637": {
            "id": "710570637",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Uh... I—I'll figure out some way to repay you...",
            "nextDialogs": [
              "710570638"
            ]
          },
          "710570638": {
            "id": "710570638",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "No need to repay me — as a matter of fact, this incident gives me something new to write in my report.",
            "nextDialogs": [
              "710570639"
            ]
          },
          "710570639": {
            "id": "710570639",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "Ever since I came across these peculiar mushrooms in The Chasm, I've been curious about the long-term consequences of eating them, but I haven't found a willing assistant yet."
          }
        }
      }
    },
    {
      "subId": "7105712",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710571201"
        ],
        "dialogs": {
          "710571201": {
            "id": "710571201",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "My ears aren't itchy anymore... But...",
            "nextDialogs": [
              "710571202"
            ]
          },
          "710571202": {
            "id": "710571202",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Mushroom meat, *sigh*, where can I find more?"
          }
        }
      }
    }
  ]
}
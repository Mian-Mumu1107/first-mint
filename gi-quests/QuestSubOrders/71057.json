  "subQuests": [
    {
      "subId": "7105701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710570701"
        ],
        "dialogs": {
          "710570701": {
            "id": "710570701",
            "speakerId": 1000,
            "speakerName": "Work Handbook",
            "text": "(A miner's log, with the name \"He\" on its cover — probably the name of the owner.)",
            "nextDialogs": [
              "710570706"
            ]
          },
          "710570706": {
            "id": "710570706",
            "speakerId": 1000,
            "speakerName": "Work Handbook",
            "text": "(On the first few pages, it reads:)",
            "nextDialogs": [
              "710570702"
            ]
          },
          "710570702": {
            "id": "710570702",
            "speakerId": 1000,
            "speakerName": "Work Handbook",
            "text": "\"Qi Ding's been looking for his daughter's toy, but it's nowhere to be found. Lemme go deeper into the mine and see if I can find it for him...\"",
            "nextDialogs": [
              "710570703"
            ]
          },
          "710570703": {
            "id": "710570703",
            "speakerId": 1000,
            "speakerName": "Work Handbook",
            "text": "\"...There's an itching in my ears...\"",
            "nextDialogs": [
              "710570704"
            ]
          },
          "710570704": {
            "id": "710570704",
            "speakerId": 1000,
            "speakerName": "Work Handbook",
            "text": "\"...It's so itchy, like bugs in my ears... Ugh, it just won't give me a rest. I'm gonna run out of food soon. According to that voice, I... Huh. But is this mushroom really edible?\"",
            "nextDialogs": [
              "710570705"
            ]
          },
          "710570705": {
            "id": "710570705",
            "speakerId": 1000,
            "speakerName": "Work Handbook",
            "text": "On the following pages, it reads: \"I can hear it. Hee-hee, mushroom meat... hee-hee... mushroom meat. So delicious... Hahaha, mushroom meat...\""
          }
        }
      }
    },
    {
      "subId": "7105702",
      "subQuestName": "Talk to Uncle He",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710570133"
        ],
        "dialogs": {
          "710570133": {
            "id": "710570133",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You suddenly hear whispering coming from behind you:\\n\"Hee-hee... mushroom meat... Hee-hee...\"",
            "nextDialogs": [
              "710570101"
            ]
          },
          "710570101": {
            "id": "710570101",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "You... Hee-hee, what are you doing here?",
            "nextDialogs": [
              "710570102"
            ]
          },
          "710570102": {
            "id": "710570102",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Whoa! This guy looks terrible!",
            "nextDialogs": [
              "710570103"
            ]
          },
          "710570103": {
            "id": "710570103",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "#And he just popped up without making a single noise, {NICKNAME}...",
            "nextDialogs": [
              "710570104"
            ]
          },
          "710570104": {
            "id": "710570104",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Could he be...",
            "nextDialogs": [
              "710570105"
            ]
          },
          "710570105": {
            "id": "710570105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Probably not.",
            "nextDialogs": [
              "710570106"
            ]
          },
          "710570106": {
            "id": "710570106",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Hee-hee, wh—why are you here?",
            "nextDialogs": [
              "710570107"
            ]
          },
          "710570107": {
            "id": "710570107",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Have you run out of food as well?",
            "nextDialogs": [
              "710570108"
            ]
          },
          "710570108": {
            "id": "710570108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you Uncle He?",
            "nextDialogs": [
              "710570109"
            ]
          },
          "710570109": {
            "id": "710570109",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Huh... Huh? Youngster, what are you saying? I can't hear you.",
            "nextDialogs": [
              "710570110"
            ]
          },
          "710570110": {
            "id": "710570110",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "I'm asking if you are Uncle He!",
            "nextDialogs": [
              "710570111"
            ]
          },
          "710570111": {
            "id": "710570111",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Oooh, yes. Hee-hee, that's me-hee-hee.",
            "nextDialogs": [
              "710570112"
            ]
          },
          "710570112": {
            "id": "710570112",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Are you also trapped here like me? Did you run out of food too? *sigh* ... How unlucky.",
            "nextDialogs": [
              "710570113"
            ]
          },
          "710570113": {
            "id": "710570113",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Hee-hee, but no worries. I've got some food here... You must be famished... Hee-hee...",
            "nextDialogs": [
              "710570114"
            ]
          },
          "710570114": {
            "id": "710570114",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Now that topic's making Paimon's tummy grumble.",
            "nextDialogs": [
              "710570117"
            ]
          },
          "710570117": {
            "id": "710570117",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Uh... You're right. He seems a bit cooked in the head, and what's with that strange complexion? Paimon bets it has to do with the mushroom meat!",
            "nextDialogs": [
              "710570118"
            ]
          },
          "710570118": {
            "id": "710570118",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Mushroom meat? Hee-hee, yes, it's delicious!",
            "nextDialogs": [
              "710570119"
            ]
          },
          "710570119": {
            "id": "710570119",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Here, would you like some?",
            "nextDialogs": [
              "710570120"
            ]
          },
          "710570120": {
            "id": "710570120",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Hahaha, how do you like it? Mm... What—",
            "nextDialogs": [
              "710570121"
            ]
          },
          "710570121": {
            "id": "710570121",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "What's the matter?",
            "nextDialogs": [
              "710570122"
            ]
          },
          "710570122": {
            "id": "710570122",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "The mushroom meat is gone!",
            "nextDialogs": [
              "710570123"
            ]
          },
          "710570123": {
            "id": "710570123",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "...Y'know what? Forget it, let's go back to the camp now!",
            "nextDialogs": [
              "710570124"
            ]
          },
          "710570124": {
            "id": "710570124",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "I'm not going! I've run out of mushroom meat!",
            "nextDialogs": [
              "710570125"
            ]
          },
          "710570125": {
            "id": "710570125",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Without it, I won't even have the strength to walk. I'm not going anywhere... No mushroom meat... and no food anywhere else.",
            "nextDialogs": [
              "710570126"
            ]
          },
          "710570126": {
            "id": "710570126",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "But with mushroom meat, I can go anywhere!",
            "nextDialogs": [
              "710570127"
            ]
          },
          "710570127": {
            "id": "710570127",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Then, where can we find you some?",
            "nextDialogs": [
              "710570128"
            ]
          },
          "710570128": {
            "id": "710570128",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Mushroom meat... Oh, hee-hee, I know where it is. Lemme find some for us. Let's fill our tummies and then we'll have the strength to work!",
            "nextDialogs": [
              "710570129"
            ]
          },
          "710570129": {
            "id": "710570129",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "It should be around here...",
            "nextDialogs": [
              "710570130"
            ]
          },
          "710570130": {
            "id": "710570130",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "#Well, {NICKNAME}, Paimon guesses we can only do as he says.",
            "nextDialogs": [
              "710570131"
            ]
          },
          "710570131": {
            "id": "710570131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This does seem to be the only option now.",
            "nextDialogs": [
              "710570132"
            ]
          },
          "710570132": {
            "id": "710570132",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Mushroom meat... Hee-hee... big mushroom meat..."
          }
        }
      }
    },
    {
      "subId": "7105703",
      "subQuestName": "Collect \"mushroom meat\" together with Uncle He",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710570301"
        ],
        "dialogs": {
          "710570301": {
            "id": "710570301",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Mushroom meat... Hee-hee... A mushroom meal in my tummy, small mushrooms, mushroom creatures, big mushrooms... Hee-hee...",
            "nextDialogs": [
              "710570302"
            ]
          },
          "710570302": {
            "id": "710570302",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Uncle He? What's happened to your face?",
            "nextDialogs": [
              "710570303"
            ]
          },
          "710570303": {
            "id": "710570303",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "*sigh*... I knew you were alive! To think that your family even invited me to your funeral! I refused to go, you know. Told them that nothing was certain yet without a body.",
            "nextDialogs": [
              "710570304"
            ]
          },
          "710570304": {
            "id": "710570304",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Look at your face. It must've been tough for you, being trapped in the mine like that. But anyway, I'm glad that you're still alive!",
            "nextDialogs": [
              "710570305"
            ]
          },
          "710570305": {
            "id": "710570305",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Being alive is good, yes! Living, breathing mushrooms are delicious! Hee-hee...",
            "nextDialogs": [
              "710570306"
            ]
          },
          "710570306": {
            "id": "710570306",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Uncle He?",
            "nextDialogs": [
              "710570307"
            ]
          },
          "710570307": {
            "id": "710570307",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "He was like this when we found him.",
            "nextDialogs": [
              "710570308"
            ]
          },
          "710570308": {
            "id": "710570308",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "He wasn't quite all there... and he kept saying that he wanted to eat mushrooms.",
            "nextDialogs": [
              "710570309"
            ]
          },
          "710570309": {
            "id": "710570309",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Mushrooms...",
            "nextDialogs": [
              "710570310"
            ]
          },
          "710570310": {
            "id": "710570310",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "The Chasm is a dangerous place for ordinary people. Plants and fungi growing here could also be harmful to the human body. That's why Huishan Hall has set strict rules against eating these things.",
            "nextDialogs": [
              "710570311"
            ]
          },
          "710570311": {
            "id": "710570311",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "But Uncle He's been trapped down here all these years with nothing else to eat.",
            "nextDialogs": [
              "710570312"
            ]
          },
          "710570312": {
            "id": "710570312",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "How am I supposed to face his family with him in this state?",
            "nextDialogs": [
              "710570315"
            ]
          },
          "710570315": {
            "id": "710570315",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Now that you mention it, Khedive might be able to help. After all, he's a scholar from Sumeru. He must've conducted some research on mushrooms.",
            "nextDialogs": [
              "710570316"
            ]
          },
          "710570316": {
            "id": "710570316",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Please wait here. I'll bring him over to check up on Uncle He.",
            "nextDialogs": [
              "710570317"
            ]
          },
          "710570317": {
            "id": "710570317",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "Mushroom meat... mushroom meat...",
            "nextDialogs": [
              "710570318"
            ]
          },
          "710570318": {
            "id": "710570318",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "*sigh* With how messed up Uncle He is, Paimon's really not sure if he can recover.",
            "nextDialogs": [
              "710570319"
            ]
          },
          "710570319": {
            "id": "710570319",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "If he goes back to his family like this, they'll still be pretty saddened...",
            "nextDialogs": [
              "710570320"
            ]
          },
          "710570320": {
            "id": "710570320",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "You can't just kidnap me here while I was halfway through my report, Jinwu! I know you're in charge of the team's safety, but you can't just disturb my research like that...",
            "nextDialogs": [
              "710570321"
            ]
          },
          "710570321": {
            "id": "710570321",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "I'm seriously considering cutting your budget as they proposed.",
            "nextDialogs": [
              "710570322"
            ]
          },
          "710570322": {
            "id": "710570322",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Never mind the budget.",
            "nextDialogs": [
              "710570323"
            ]
          },
          "710570323": {
            "id": "710570323",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Please check on this man here...",
            "nextDialogs": [
              "710570324"
            ]
          },
          "710570324": {
            "id": "710570324",
            "speakerId": 1004,
            "speakerName": "Uncle He",
            "text": "It's so itchy inside my earsies... Hee-hee...",
            "nextDialogs": [
              "710570325"
            ]
          },
          "710570325": {
            "id": "710570325",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "Huh? Who is he? And why does he look like that?",
            "nextDialogs": [
              "710570326"
            ]
          },
          "710570326": {
            "id": "710570326",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "#Did you find him, {NICKNAME}? ...Seriously, how are you always able to stumble upon such peculiar events...",
            "nextDialogs": [
              "710570327"
            ]
          },
          "710570327": {
            "id": "710570327",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "Then... How was he like when you found him?",
            "nextDialogs": [
              "710570328"
            ]
          },
          "710570328": {
            "id": "710570328",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You tell Khedive what happened to Uncle He...\\nKhedive performs a careful examination on him.",
            "nextDialogs": [
              "710570329"
            ]
          },
          "710570329": {
            "id": "710570329",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "He's fine. It's not a big deal.",
            "nextDialogs": [
              "710570330"
            ]
          },
          "710570330": {
            "id": "710570330",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "You know how he always complains about the itchiness in his ears? That's because the spores of the fungi have entered his ears.",
            "nextDialogs": [
              "710570331"
            ]
          },
          "710570331": {
            "id": "710570331",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "Although long-term consumption of this type of fungus — I mean, mushroom — does impair one's sanity, it doesn't hurt the body.",
            "nextDialogs": [
              "710570332"
            ]
          },
          "710570332": {
            "id": "710570332",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "So you're saying he can recover?",
            "nextDialogs": [
              "710570333"
            ]
          },
          "710570333": {
            "id": "710570333",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "I've already cleared his body of the fungi and made some medicine to treat his neurological disorder.",
            "nextDialogs": [
              "710570334"
            ]
          },
          "710570334": {
            "id": "710570334",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "He's very likely to recover if given ample rest.",
            "nextDialogs": [
              "710570335"
            ]
          },
          "710570335": {
            "id": "710570335",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "I see. Then, about the cost of the medicine...",
            "nextDialogs": [
              "710570336"
            ]
          },
          "710570336": {
            "id": "710570336",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "None of the ingredients are expensive — they're only worth a month's meals at Xinyue Kiosk. It's not a big deal.",
            "nextDialogs": [
              "710570337"
            ]
          },
          "710570337": {
            "id": "710570337",
            "speakerId": 1005,
            "speakerName": "Jinwu",
            "text": "Uh... I—I'll figure out some way to repay you...",
            "nextDialogs": [
              "710570338"
            ]
          },
          "710570338": {
            "id": "710570338",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "No need to repay me — as a matter of fact, this incident gives me something new to write in my report.",
            "nextDialogs": [
              "710570339"
            ]
          },
          "710570339": {
            "id": "710570339",
            "speakerId": 1006,
            "speakerName": "Khedive",
            "text": "Ever since I came across these peculiar mushrooms in The Chasm, I've been curious about the long-term consequences of eating them, but I haven't found a willing assistant yet."
          }
        }
      }
    },
    {
      "subId": "7105704",
      "subQuestName": "Defeat the Floating Fungi",
      "sceneId": null,
      "locations": [],
      "dialogue": {

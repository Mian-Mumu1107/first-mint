  "subQuests": [
    {
      "subId": "7710501",
      "subQuestName": "Go to the marked location",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771050101"
        ],
        "dialogs": {
          "771050101": {
            "id": "771050101",
            "speakerId": 1000,
            "speakerName": "Eye of Graeae",
            "text": "I see. The fragment lies within the garden — more precisely, within the great tree there.",
            "nextDialogs": [
              "771050122"
            ]
          },
          "771050122": {
            "id": "771050122",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Okay, let's go have a look...",
            "nextDialogs": [
              "771050102"
            ]
          },
          "771050102": {
            "id": "771050102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hi there! Would it be all right if we went in and looked around?",
            "nextDialogs": [
              "771050103"
            ]
          },
          "771050103": {
            "id": "771050103",
            "speakerId": 1002,
            "speakerName": "Ladon",
            "text": "...",
            "nextDialogs": [
              "771050104"
            ]
          },
          "771050104": {
            "id": "771050104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh, we're visiting from somewhere far, far away, and we've never seen a garden as wonderful as this one before...",
            "nextDialogs": [
              "771050105"
            ]
          },
          "771050105": {
            "id": "771050105",
            "speakerId": 1002,
            "speakerName": "Ladon",
            "text": "Ah, visitors from a distant land. Thank you for the compliment. When Larisa was still alive, she would come by often for some work here and there. The plants all thrived under her care.",
            "nextDialogs": [
              "771050106"
            ]
          },
          "771050106": {
            "id": "771050106",
            "speakerId": 1002,
            "speakerName": "Ladon",
            "text": "At that time, that big tree over there would bear the biggest, most beautiful fruits. But after she left us for good, no matter how or what I tried, that tree would simply bear fruit no more...",
            "nextDialogs": [
              "771050107"
            ]
          },
          "771050107": {
            "id": "771050107",
            "speakerId": 1002,
            "speakerName": "Ladon",
            "text": "But there is more to this garden than that tree, wouldn't you agree?",
            "nextDialogs": [
              "771050108"
            ]
          },
          "771050108": {
            "id": "771050108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So, do you think we can get in there? For, uh, you know, a closer look at its beauty?",
            "nextDialogs": [
              "771050109"
            ]
          },
          "771050109": {
            "id": "771050109",
            "speakerId": 1002,
            "speakerName": "Ladon",
            "text": "Ha, I'm afraid not.",
            "nextDialogs": [
              "771050110"
            ]
          },
          "771050110": {
            "id": "771050110",
            "speakerId": 1002,
            "speakerName": "Ladon",
            "text": "The garden is currently under maintenance, and no one's allowed in there except the fae help. I apologize, but rules are rules.",
            "nextDialogs": [
              "771050111"
            ]
          },
          "771050111": {
            "id": "771050111",
            "speakerId": 1002,
            "speakerName": "Ladon",
            "text": "But you are absolutely welcome to look at the garden from here. Didn't you say that you come from a distant land? You can tell me some stories while you admire the view.",
            "nextDialogs": [
              "771050112"
            ]
          },
          "771050112": {
            "id": "771050112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Just hold on a sec, please!",
            "nextDialogs": [
              "771050113"
            ]
          },
          "771050113": {
            "id": "771050113",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Paimon pulls you aside so that the Snegovik standing guard won't hear you...",
            "nextDialogs": [
              "771050114"
            ]
          },
          "771050114": {
            "id": "771050114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ugh... He had Paimon thinking for a second that he was gonna let us in! And then he said no! What are we gonna do now???",
            "nextDialogs": [
              "771050115"
            ]
          },
          "771050115": {
            "id": "771050115",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, how about we skirt around and see if we can climb over a wall somewhere?",
            "nextDialogs": [
              "771050116"
            ]
          },
          "771050116": {
            "id": "771050116",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm, but it's gonna look a little weird if the both of us disappear at the same time. That's gonna raise an eyebrow, don't you think?",
            "nextDialogs": [
              "771050117"
            ]
          },
          "771050117": {
            "id": "771050117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Then I'll have to trouble you to occupy him for a little while, Paimon.",
            "nextDialogs": [
              "771050118"
            ]
          },
          "771050118": {
            "id": "771050118",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Mine?",
            "nextDialogs": [
              "771050119"
            ]
          },
          "771050119": {
            "id": "771050119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You know that I'm not the chatty type.",
            "nextDialogs": [
              "771050120"
            ]
          },
          "771050120": {
            "id": "771050120",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's true... Well, you can leave it to Paimon then!",
            "nextDialogs": [
              "771050121"
            ]
          },
          "771050121": {
            "id": "771050121",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But it's got to be a quick in-and-out, you hear? Even Teyvat's best guide has only so many stories to tell..."
          }
        }
      }
    },
    {
      "subId": "7710502",
      "subQuestName": "Sneak into the garden to recover the fragment",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771050201"
        ],
        "dialogs": {
          "771050201": {
            "id": "771050201",
            "speakerId": 1002,
            "speakerName": "Ladon",
            "text": "Well then, little one. Tell me more about what it's like out there.",
            "nextDialogs": [
              "771050202"
            ]
          },
          "771050202": {
            "id": "771050202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Sure...",
            "nextDialogs": [
              "771050203"
            ]
          },
          "771050203": {
            "id": "771050203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#({NICKNAME}, just like we planned, Paimon'll keep him talking. You sneak around from the side!)"
          }
        }
      }
    },
    {
      "subId": "7710503",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771050301"
        ],
        "dialogs": {
          "771050301": {
            "id": "771050301",
            "speakerId": 1002,
            "speakerName": "Ladon",
            "text": "...Wow, I never knew that. I really learned something new today.",
            "nextDialogs": [
              "771050302"
            ]
          },
          "771050302": {
            "id": "771050302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's right, that's right... Oh look, Paimon's friend is here. Gotta go. We, uh, have something to attend to.",
            "nextDialogs": [
              "771050303"
            ]
          },
          "771050303": {
            "id": "771050303",
            "speakerId": 1002,
            "speakerName": "Ladon",
            "text": "Don't worry about me. It's been great talking to you. Please come back to visit when you have the time!",
            "nextDialogs": [
              "771050304"
            ]
          },
          "771050304": {
            "id": "771050304",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Heh... sure...",
            "nextDialogs": [
              "771050305"
            ]
          },
          "771050305": {
            "id": "771050305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did I interrupt something? You two seemed to be having a good time.",
            "nextDialogs": [
              "771050306"
            ]
          },
          "771050306": {
            "id": "771050306",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Ugh, you're finally back, {NICKNAME}! This is the first time ever Paimon's gotten tired from all that talking...",
            "nextDialogs": [
              "771050307"
            ]
          },
          "771050307": {
            "id": "771050307",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon's got to rest and talk a little less for now... Yes. That's what Paimon's going to do."
          }
        }
      }
    },
    {
      "subId": "7710599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771059901"
        ],
        "dialogs": {
          "771059901": {
            "id": "771059901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Paimon's got the guard distracted... Now's my chance to find another way into the garden.)",
            "nextDialogs": [
              "771059903"
            ]
          },
          "771059903": {
            "id": "771059903",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa! Flowers and grass, all the way up here? Is this really still the snowy mountain?",
            "nextDialogs": [
              "771059904"
            ]
          },
          "771059904": {
            "id": "771059904",
            "speakerId": 1000,
            "speakerName": "Eye of Graeae",
            "text": "I feel it... The presence is getting stronger. The fragment of power is here."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7615301",
      "subQuestName": "Talk to Dhabit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761530101"
        ],
        "dialogs": {
          "761530101": {
            "id": "761530101",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "The publishing trade hardly makes a living these days. Maybe I should just focus on investments...",
            "nextDialogs": [
              "761530102"
            ]
          },
          "761530102": {
            "id": "761530102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let me see the investment coupons.",
            "nextDialogs": [
              "761530103"
            ]
          },
          "761530103": {
            "id": "761530103",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Here you go. 2,000 Mora per coupon, with each investment tenure maturing weekly. Now then, into the pouch it goes...",
            "nextDialogs": [
              "761530104"
            ]
          },
          "761530104": {
            "id": "761530104",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "...Ugh!",
            "nextDialogs": [
              "761530105"
            ]
          },
          "761530105": {
            "id": "761530105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "761530106"
            ]
          },
          "761530106": {
            "id": "761530106",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Oh hello, Jahoda. What are you doing here? Does Lady Nefer...",
            "nextDialogs": [
              "761530107"
            ]
          },
          "761530107": {
            "id": "761530107",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Oh, no, no, I'm just out shopping with my friend.",
            "nextDialogs": [
              "761530108"
            ]
          },
          "761530108": {
            "id": "761530108",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Heh, looks like your investment business is doing really well, Boss Dhabit.",
            "nextDialogs": [
              "761530109"
            ]
          },
          "761530109": {
            "id": "761530109",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Oh, it's nothing, nothing, haha... just a small venture to make ends meet.",
            "nextDialogs": [
              "761530110"
            ]
          },
          "761530110": {
            "id": "761530110",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "(Just look at her... She's being all sly and probing! I bet she's here on Nefer's orders. Tch.)",
            "nextDialogs": [
              "761530111"
            ]
          },
          "761530111": {
            "id": "761530111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Can this really make money?",
            "nextDialogs": [
              "761530112"
            ]
          },
          "761530112": {
            "id": "761530112",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Of course! Boss Nef says that Boss Dhabit is the most reputable AND the most capable businessman. Investing with him is definitely a safe bet.",
            "nextDialogs": [
              "761530113"
            ]
          },
          "761530113": {
            "id": "761530113",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Yes, yes... haha...",
            "nextDialogs": [
              "761530114"
            ]
          },
          "761530114": {
            "id": "761530114",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "(Nefer! I knew it!)",
            "nextDialogs": [
              "761530115"
            ]
          },
          "761530115": {
            "id": "761530115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Then, when I can expect the payout on my investment...?",
            "nextDialogs": [
              "761530116"
            ]
          },
          "761530116": {
            "id": "761530116",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Today! Right this very day. You just bought our brand-new... short-term investment coupon! Profits and losses on this one are settled instantly!",
            "nextDialogs": [
              "761530117"
            ]
          },
          "761530117": {
            "id": "761530117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kinda feels like you just made all that up...",
            "nextDialogs": [
              "761530118"
            ]
          },
          "761530118": {
            "id": "761530118",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Uh... Don't worry about it. A—Anyway, thanks for buying our short-term investment coupon!",
            "nextDialogs": [
              "761530119"
            ]
          },
          "761530119": {
            "id": "761530119",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Here's your investment return. Have a wonderful day!",
            "nextDialogs": [
              "761530122"
            ]
          },
          "761530122": {
            "id": "761530122",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really? Heehee, then Paimon wants one shaped like a little bird! That's Paimon's favorite!",
            "nextDialogs": [
              "761530123"
            ]
          },
          "761530123": {
            "id": "761530123",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Oh? I'll come with you two then. I can get one for Boss too.",
            "nextDialogs": [
              "761530124"
            ]
          },
          "761530124": {
            "id": "761530124",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "M-Miss Jahoda, please wait!",
            "nextDialogs": [
              "761530125"
            ]
          },
          "761530125": {
            "id": "761530125",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Um... Do you happen to have a message for me from Lady Nefer by any chance...?",
            "nextDialogs": [
              "761530126"
            ]
          },
          "761530126": {
            "id": "761530126",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Oh. Boss said, \"We've located what you're looking for.\"",
            "nextDialogs": [
              "761530127"
            ]
          },
          "761530127": {
            "id": "761530127",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "\"Do have patience, Mr. Dhabit. One step at a time — that's how proper business is done.\"",
            "nextDialogs": [
              "761530128"
            ]
          },
          "761530128": {
            "id": "761530128",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Yes, yes, of course. Lady Nefer is right... In that case, I'll be counting on you two..."
          }
        }
      }
    },

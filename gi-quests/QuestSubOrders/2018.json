  "subQuests": [
    {
      "subId": "201802",
      "subQuestName": "Return to the Grand Narukami Shrine and look for Yae Miko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20180201"
        ],
        "dialogs": {
          "20180201": {
            "id": "20180201",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "Lady Guuji. Here I am, as promised. Rest assured I came here alone and told no one about this trip.",
            "nextDialogs": [
              "20180202"
            ]
          },
          "20180202": {
            "id": "20180202",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "I knew you would keep your promise, after all... I'm sure you've barely been able to take your mind off it these past few days — have you managed to get any sleep at all?",
            "nextDialogs": [
              "20180203"
            ]
          },
          "20180203": {
            "id": "20180203",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "I—I... You're quite mistaken. I would never doubt the leaders of my clan.",
            "nextDialogs": [
              "20180204"
            ]
          },
          "20180204": {
            "id": "20180204",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "So. Where is your proof?",
            "nextDialogs": [
              "20180205"
            ]
          },
          "20180205": {
            "id": "20180205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here.",
            "nextDialogs": [
              "20180206"
            ]
          },
          "20180206": {
            "id": "20180206",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Ah, how wonderful. Everyone's keeping their promises today.",
            "nextDialogs": [
              "20180207"
            ]
          },
          "20180207": {
            "id": "20180207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You wouldn't believe what we had to go through to get our hands on this stuff.",
            "nextDialogs": [
              "20180208"
            ]
          },
          "20180208": {
            "id": "20180208",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Hand them to Sara. She can examine them for herself.",
            "nextDialogs": [
              "20180209"
            ]
          },
          "20180209": {
            "id": "20180209",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "What is this?",
            "nextDialogs": [
              "20180210"
            ]
          },
          "20180210": {
            "id": "20180210",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "...I see this document bears the official seal of the head of the Kujou Clan. And it doesn't look like a forgery...",
            "nextDialogs": [
              "20180211"
            ]
          },
          "20180211": {
            "id": "20180211",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "I don't understand... Not a single word about the resistance, Sangonomiya, or the situation on the front line...",
            "nextDialogs": [
              "20180212"
            ]
          },
          "20180212": {
            "id": "20180212",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "What about the soldiers who gave their lives on the front line, or the hardship endured by the people? Do they deserve no mention!?",
            "nextDialogs": [
              "20180213"
            ]
          },
          "20180213": {
            "id": "20180213",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "Utter disregard for human life. Why would they want to hide it?",
            "nextDialogs": [
              "20180214"
            ]
          },
          "20180214": {
            "id": "20180214",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "For the sake of the Vision Hunt Decree, of course. Don't you think the Shogun might reconsider her policy if all of the things you just mentioned appeared in this report?",
            "nextDialogs": [
              "20180215"
            ]
          },
          "20180215": {
            "id": "20180215",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "So the Tenryou Commission... They are deliberately deceiving the Shogun?",
            "nextDialogs": [
              "20180216"
            ]
          },
          "20180216": {
            "id": "20180216",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Yes. Now... who else do you think might be benefiting from the Vision Hunt Decree?",
            "nextDialogs": [
              "20180217"
            ]
          },
          "20180217": {
            "id": "20180217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I also have a confidential letter here.",
            "nextDialogs": [
              "20180218"
            ]
          },
          "20180218": {
            "id": "20180218",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This is a letter from the Tenryou Commission to the Fatui. The head of the Kujou Clan kept this a secret from the Shogun, too.",
            "nextDialogs": [
              "20180219"
            ]
          },
          "20180219": {
            "id": "20180219",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "...",
            "nextDialogs": [
              "20180220"
            ]
          },
          "20180220": {
            "id": "20180220",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Well? The things you wanted to see, but also wished not to see, are here before you.",
            "nextDialogs": [
              "20180221"
            ]
          },
          "20180221": {
            "id": "20180221",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Surely... you aren't planning to turn a blind eye to them?",
            "nextDialogs": [
              "20180222"
            ]
          },
          "20180222": {
            "id": "20180222",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "So everything I've ever held on to... it's all... How could they... Argh!",
            "nextDialogs": [
              "20180223"
            ]
          },
          "20180223": {
            "id": "20180223",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "This betrayal is unforgivable... Takayuki, you've got some explaining to do!",
            "nextDialogs": [
              "20180224"
            ]
          },
          "20180224": {
            "id": "20180224",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kujou Sara seems pretty angry, huh. Looks like our Tenryou rebellion is successfully underway.",
            "nextDialogs": [
              "20180227"
            ]
          },
          "20180227": {
            "id": "20180227",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yup yup, let's catch up with her.",
            "nextDialogs": [
              "20180228"
            ]
          },
          "20180228": {
            "id": "20180228",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Hold on, Traveler. There's something else we need to discuss.",
            "nextDialogs": [
              "20180229"
            ]
          },
          "20180229": {
            "id": "20180229",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh?",
            "nextDialogs": [
              "20180230"
            ]
          },
          "20180230": {
            "id": "20180230",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Last time you entered the Plane of Euthymia, it was in front of the Statue of the Omnipresent God, correct?",
            "nextDialogs": [
              "20180231"
            ]
          },
          "20180231": {
            "id": "20180231",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Correct.",
            "nextDialogs": [
              "20180232"
            ]
          },
          "20180232": {
            "id": "20180232",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "You must find a way to recreate the circumstances of that day.",
            "nextDialogs": [
              "20180233"
            ]
          },
          "20180233": {
            "id": "20180233",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "If you can get the Raiden Shogun to \"open her heart\" to you once more before the Statue of the Omnipresent God, you will have the opportunity you need...",
            "nextDialogs": [
              "20180234"
            ]
          },
          "20180234": {
            "id": "20180234",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I will do my best.",
            "nextDialogs": [
              "20180235"
            ]
          },
          "20180235": {
            "id": "20180235",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Take this with you as a farewell gift.",
            "nextDialogs": [
              "20180236"
            ]
          },
          "20180236": {
            "id": "20180236",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What is it?",
            "nextDialogs": [
              "20180237"
            ]
          },
          "20180237": {
            "id": "20180237",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "The omamori from the Grand Narukami Shrine are very potent indeed. I thought I'd put one aside for you."
          }
        }
      }
    },
    {
      "subId": "201803",
      "subQuestName": "Follow Kujou Sara to the Tenryou Commission Headquarters",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20180301"
        ],
        "dialogs": {
          "20180301": {
            "id": "20180301",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "You followed me here? You've got guts, I'll give you that.",
            "nextDialogs": [
              "20180302"
            ]
          },
          "20180302": {
            "id": "20180302",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "Since you are witnesses, I suppose I can shield you from arrest — at least until I have received an explanation from Takayuki.",
            "nextDialogs": [
              "20180303"
            ]
          },
          "20180303": {
            "id": "20180303",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "But... if it turns out that you have been deceptive in this matter, then not only will you be arrested immediately, but you'll also be charged with one more crime. Do I make myself clear?",
            "nextDialogs": [
              "20180306"
            ]
          },
          "20180306": {
            "id": "20180306",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "Hmph. Good."
          }
        }
      }
    },

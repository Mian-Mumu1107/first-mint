            "text": "!!!",
            "nextDialogs": [
              "760500903"
            ]
          },
          "760500903": {
            "id": "760500903",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe, guess this means we did good?",
            "nextDialogs": [
              "760500904"
            ]
          },
          "760500904": {
            "id": "760500904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They really are so soft and squishy.",
            "nextDialogs": [
              "760500905"
            ]
          },
          "760500905": {
            "id": "760500905",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, we get a reward even though we got it wrong? Huh, well... Paimon doesn't mind a consolation prize.",
            "nextDialogs": [
              "760500906"
            ]
          },
          "760500906": {
            "id": "760500906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Who's a good little kuuhenki...",
            "nextDialogs": [
              "760500907"
            ]
          },
          "760500907": {
            "id": "760500907",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "The kuuhenki have taken a liking to you.",
            "nextDialogs": [
              "760500908"
            ]
          },
          "760500908": {
            "id": "760500908",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "I can feel it... They are at ease in your presence.",
            "nextDialogs": [
              "760500909"
            ]
          },
          "760500909": {
            "id": "760500909",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "Just as Rimehorn Deer fawns are given to bathing in the moonlight, so too are the kuuhenki drawn to that which radiates from your heart.",
            "nextDialogs": [
              "760500910"
            ]
          },
          "760500910": {
            "id": "760500910",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh? And what would that be, exactly?",
            "nextDialogs": [
              "760500911"
            ]
          },
          "760500911": {
            "id": "760500911",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "A certain kindness and gentleness, I suppose."
          }
        }
      }
    },
    {

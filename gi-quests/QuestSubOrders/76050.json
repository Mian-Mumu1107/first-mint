    {
      "subId": "7605001",
      "subQuestName": "Meet The Damselette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760500101"
        ],
        "dialogs": {
          "760500101": {
            "id": "760500101",
            "speakerId": 1000,
            "speakerName": "Kuuhenki",
            "text": "~!",
            "nextDialogs": [
              "760500102"
            ]
          },
          "760500102": {
            "id": "760500102",
            "speakerId": 1000,
            "speakerName": "Kuuhenki",
            "text": "!!!",
            "nextDialogs": [
              "760500103"
            ]
          },
          "760500103": {
            "id": "760500103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, it's so lively here today! All those kuuhenki are dancing around Columbina!",
            "nextDialogs": [
              "760500104"
            ]
          },
          "760500104": {
            "id": "760500104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh, wait a sec... That's not dancing. Looks more like they're trying to... bury her alive in a pile of cuteness!",
            "nextDialogs": [
              "760500105"
            ]
          },
          "760500105": {
            "id": "760500105",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "H—Help me...",
            "nextDialogs": [
              "760500106"
            ]
          },
          "760500106": {
            "id": "760500106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Give me your hand.",
            "nextDialogs": [
              "760500107"
            ]
          },
          "760500107": {
            "id": "760500107",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "Phew... Thank you...",
            "nextDialogs": [
              "760500108"
            ]
          },
          "760500108": {
            "id": "760500108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why were the kuuhenki acting like that just now...? They're not usually that energetic, are they?",
            "nextDialogs": [
              "760500109"
            ]
          },
          "760500109": {
            "id": "760500109",
            "speakerId": 1000,
            "speakerName": "Kuuhenki",
            "text": "~!",
            "nextDialogs": [
              "760500110"
            ]
          },
          "760500110": {
            "id": "760500110",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "Well...",
            "nextDialogs": [
              "760500111"
            ]
          },
          "760500111": {
            "id": "760500111",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "I decided to play a game with the little ones, and it seems they became quite invested...",
            "nextDialogs": [
              "760500112"
            ]
          },
          "760500112": {
            "id": "760500112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Crowding around you like that after playtime... Kinda like puppies, aren't they?",
            "nextDialogs": [
              "760500113"
            ]
          },
          "760500113": {
            "id": "760500113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe that's their way of showing gratitude.",
            "nextDialogs": [
              "760500114"
            ]
          },
          "760500114": {
            "id": "760500114",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "Mm... Only this time, their gratitude felt more like getting caught in an unexpected snow drift...",
            "nextDialogs": [
              "760500115"
            ]
          },
          "760500115": {
            "id": "760500115",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You say that, but Paimon bets you never pass up a chance to spoil them!",
            "nextDialogs": [
              "760500116"
            ]
          },
          "760500116": {
            "id": "760500116",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "In any case, would the two of you like to give it a try?",
            "nextDialogs": [
              "760500118",
              "760500120"
            ]
          },
          "760500118": {
            "id": "760500118",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "Hm... That can be arranged. You just need to get the right answer.",
            "nextDialogs": [
              "760500121"
            ]
          },
          "760500121": {
            "id": "760500121",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, sure thing. It'll be cool to see what sort of game's got the kuuhenki so obsessed.",
            "nextDialogs": [
              "760500122"
            ]
          },
          "760500122": {
            "id": "760500122",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "Go on now.",
            "nextDialogs": [
              "760500123"
            ]
          },
          "760500123": {
            "id": "760500123",
            "speakerId": 1000,
            "speakerName": "Kuuhenki",
            "text": "~!",
            "nextDialogs": [
              "760500124"
            ]
          },
          "760500124": {
            "id": "760500124",
            "speakerId": 1000,
            "speakerName": "Kuuhenki",
            "text": "!!!"
          },
          "760500120": {
            "id": "760500120",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "Yes."
          }
        }
      }
    },
    {

      "dialogue": {
        "startDialogs": [
          "760500301"
        ],
        "dialogs": {
          "760500301": {
            "id": "760500301",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "All you need to do is guess the image.",
            "nextDialogs": [
              "760500302"
            ]
          },
          "760500302": {
            "id": "760500302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? B—But... it's way too abstract!",
            "nextDialogs": [
              "760500303"
            ]
          },
          "760500303": {
            "id": "760500303",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Did you actually manage to get the right answer when you played, Columbina?",
            "nextDialogs": [
              "760500304"
            ]
          },
          "760500304": {
            "id": "760500304",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "No, I guessed wrong more often than not.",
            "nextDialogs": [
              "760500305"
            ]
          },
          "760500305": {
            "id": "760500305",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Huh, well Paimon's gonna quit while she's ahead... Why don't you take a guess, {NICKNAME}?",
            "nextDialogs": [
              "760500307",
              "760500311",
              "760500316"
            ]
          },
          "760500307": {
            "id": "760500307",
            "speakerId": 1000,
            "speakerName": "Kuuhenki",
            "text": "!!!",
            "nextDialogs": [
              "760500308"
            ]
          },
          "760500308": {
            "id": "760500308",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa, that reaction must mean...",
            "nextDialogs": [
              "760500309"
            ]
          },
          "760500309": {
            "id": "760500309",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "Congratulations, your answer is correct."
          },
          "760500311": {
            "id": "760500311",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yikes! A Long-Necked Rhino with a serious neck injury, maybe!",
            "nextDialogs": [
              "760500312"
            ]
          },
          "760500312": {
            "id": "760500312",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "Hmm... I've never seen such a creature before.",
            "nextDialogs": [
              "760500313"
            ]
          },
          "760500313": {
            "id": "760500313",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "The correct answer was \"Rimehorn Deer.\"",
            "nextDialogs": [
              "760500314"
            ]
          },
          "760500314": {
            "id": "760500314",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "Come back now, little ones."
          },
          "760500316": {
            "id": "760500316",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You sure have a wild imagination...",
            "nextDialogs": [
              "760500317"
            ]
          },
          "760500317": {
            "id": "760500317",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "Heh... An amusing answer, to be sure.",
            "nextDialogs": [
              "760500318"
            ]
          },
          "760500318": {
            "id": "760500318",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "The correct answer was \"Rimehorn Deer.\"",
            "nextDialogs": [
              "760500319"
            ]
          },
          "760500319": {
            "id": "760500319",
            "speakerId": 1002,
            "speakerName": "The Damselette",
            "text": "Come back now, little ones."
          }
        }
      }

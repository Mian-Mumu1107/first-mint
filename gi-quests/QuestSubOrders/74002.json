    {
      "subId": "7400208",
      "subQuestName": "Talk to Ann",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740020801"
        ],
        "dialogs": {
          "740020801": {
            "id": "740020801",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "We've finally found it... The most precious of treasures...",
            "nextDialogs": [
              "740020802"
            ]
          },
          "740020802": {
            "id": "740020802",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It looks like a pocketwatch.",
            "nextDialogs": [
              "740020803"
            ]
          },
          "740020803": {
            "id": "740020803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Seems like it's not moving anymore...",
            "nextDialogs": [
              "740020804"
            ]
          },
          "740020804": {
            "id": "740020804",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, it has been in water all this time, so it should've broken down long ago, right?",
            "nextDialogs": [
              "740020805"
            ]
          },
          "740020805": {
            "id": "740020805",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "This is... full of Princess Lyris's precious time.",
            "nextDialogs": [
              "740020806"
            ]
          },
          "740020806": {
            "id": "740020806",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "...",
            "nextDialogs": [
              "740020807"
            ]
          },
          "740020807": {
            "id": "740020807",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "Let's go back to the tower and meet up with our friends."
          }
        }
      }
    },
    {
      "subId": "7400219",

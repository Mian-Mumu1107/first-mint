    {
      "subId": "7400228",
      "subQuestName": "Talk to Ann",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7400225",
      "subQuestName": "Talk to Ann",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740030101"
        ],
        "dialogs": {
          "740030101": {
            "id": "740030101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon's... kinda... dizzy. There are so many books here...",
            "nextDialogs": [
              "740030105",
              "740030104"
            ]
          },
          "740030105": {
            "id": "740030105",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "This place... This library has existed since long, long before we arrived.",
            "nextDialogs": [
              "740030106"
            ]
          },
          "740030106": {
            "id": "740030106",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "Their contents seem to be ancient dramas. Children love to read books, but there is much they won't understand, so they will often ask adults to read the stories to them.",
            "nextDialogs": [
              "740030107"
            ]
          },
          "740030107": {
            "id": "740030107",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "In the books, where there is an evil dragon, there must be heroes who hunt the dragon. If there is a mage, there must be a wandering knight. The Reconquista must come to pass, and the princess must be saved.",
            "nextDialogs": [
              "740030108"
            ]
          },
          "740030108": {
            "id": "740030108",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "And of course, a chime will sound, and the tale of adventure will come to a halt.",
            "nextDialogs": [
              "740030109"
            ]
          },
          "740030109": {
            "id": "740030109",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "Yet it will not end. There will be another adventure, and another, and another one after that, until the children grow up and leave this place.",
            "nextDialogs": [
              "740030110"
            ]
          },
          "740030110": {
            "id": "740030110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ann?",
            "nextDialogs": [
              "740030111"
            ]
          },
          "740030111": {
            "id": "740030111",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "Huh? I... Sorry, it felt like memories and feelings suddenly... flooded into my mind. How strange.",
            "nextDialogs": [
              "740030112"
            ]
          },
          "740030112": {
            "id": "740030112",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh. Well, as long as you're alright... Paimon thought you might have been bewitched by Narcissus's magic or something!",
            "nextDialogs": [
              "740030113"
            ]
          },
          "740030113": {
            "id": "740030113",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "Urk. That might actually be so!",
            "nextDialogs": [
              "740030114"
            ]
          },
          "740030114": {
            "id": "740030114",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmmm... Well, what do we do next?",
            "nextDialogs": [
              "740030115"
            ]
          },
          "740030115": {
            "id": "740030115",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "I'm not sure either...",
            "nextDialogs": [
              "740030116"
            ]
          },
          "740030116": {
            "id": "740030116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Whatever the case, let's have a look around.",
            "nextDialogs": [
              "740030117"
            ]
          },
          "740030117": {
            "id": "740030117",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yup. First off... Huh, there's a door over there, but it looks like there's no way through it.",
            "nextDialogs": [
              "740030118"
            ]
          },
          "740030118": {
            "id": "740030118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You two should be able to get across.",
            "nextDialogs": [
              "740030119"
            ]
          },
          "740030119": {
            "id": "740030119",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, you're Ann's knight right now, you know. This will all be pointless if you don't come along!",
            "nextDialogs": [
              "740030120"
            ]
          },
          "740030120": {
            "id": "740030120",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "That's right!",
            "nextDialogs": [
              "740030121"
            ]
          },
          "740030121": {
            "id": "740030121",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "This tile sticks out like a sore thumb..."
          },
          "740030104": {
            "id": "740030104",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What makes you think there'd be secret underground bookstore ruins anywhere in Fontaine?"
          }
        }
      }
    },

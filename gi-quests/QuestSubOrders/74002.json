    {
      "subId": "7400203",
      "subQuestName": "Talk to Ann",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740020301"
        ],
        "dialogs": {
          "740020301": {
            "id": "740020301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Weren't we just flying up into the sky in a bubble?",
            "nextDialogs": [
              "740020302"
            ]
          },
          "740020302": {
            "id": "740020302",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "Yes, we were.",
            "nextDialogs": [
              "740020303"
            ]
          },
          "740020303": {
            "id": "740020303",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And we kept going up, and up, and up, until we crashed headfirst into the water, right?",
            "nextDialogs": [
              "740020304"
            ]
          },
          "740020304": {
            "id": "740020304",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "Yes. Is there something wrong?",
            "nextDialogs": [
              "740020305"
            ]
          },
          "740020305": {
            "id": "740020305",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Uh, there's so much wrong with this that Paimon doesn't even know where to start...",
            "nextDialogs": [
              "740020308"
            ]
          },
          "740020308": {
            "id": "740020308",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh. You know what? Paimon's just not gonna ask! The Princess's treasure should be around here somewhere, right?",
            "nextDialogs": [
              "740020309"
            ]
          },
          "740020309": {
            "id": "740020309",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "Yes. It is there, protected by a three-layered seal.",
            "nextDialogs": [
              "740020310"
            ]
          },
          "740020310": {
            "id": "740020310",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Where? Oh, you mean that? Hmm, while that outer bubble is pretty big, the treasure seems to be inside a really small chest.",
            "nextDialogs": [
              "740020311"
            ]
          },
          "740020311": {
            "id": "740020311",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And it looks like there are some threads of flowing water connected to the big bubble...",
            "nextDialogs": [
              "740020312"
            ]
          },
          "740020312": {
            "id": "740020312",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "It seems as if the Bubble Formation here will not attack us. Hmm, in that case, let's use it to break the seals!",
            "nextDialogs": [
              "740020313"
            ]
          },
          "740020313": {
            "id": "740020313",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "We just need to <color=#00E1FFFF>guide its projectiles to the bubble rings connected to the flowing water</color>. That should transfer the force of the projectile through the water and weaken the seals.",
            "nextDialogs": [
              "740020314"
            ]
          },
          "740020314": {
            "id": "740020314",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yeah, those bubbles are pretty scary...",
            "nextDialogs": [
              "740020315"
            ]
          },
          "740020315": {
            "id": "740020315",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "One, two, three... Looks like there are <color=#00E1FFFF>three strands of water</color>. Once we deal with them, the treasure should be ours!",
            "nextDialogs": [
              "740020316"
            ]
          },
          "740020316": {
            "id": "740020316",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "#That's right. It's in your hands, Knight {NICKNAME} and Paimon!"
          }
        }
      }
    },

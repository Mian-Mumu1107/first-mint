    {
      "subId": "7400223",
      "subQuestName": "Reach the top floor of the tower",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7400216",
      "subQuestName": "Reach the top floor of the tower",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740021601"
        ],
        "dialogs": {
          "740021601": {
            "id": "740021601",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm? It's just a portal... Where does this one lead, though?",
            "nextDialogs": [
              "740021602"
            ]
          },
          "740021602": {
            "id": "740021602",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "Hmm... I'm not sure either, to be honest. I have never considered what would happen after we entered the tower.",
            "nextDialogs": [
              "740021603"
            ]
          },
          "740021603": {
            "id": "740021603",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh. Oh well. In that case, let's proceed with caution.",
            "nextDialogs": [
              "740021605"
            ]
          },
          "740021605": {
            "id": "740021605",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Come on! Both!",
            "nextDialogs": [
              "740021607"
            ]
          },
          "740021607": {
            "id": "740021607",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "Yes. We should be careful. We're the only ones the Princess can rely on."
          }
        }
      }
    },

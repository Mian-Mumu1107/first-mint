    {
      "subId": "7400210",
      "subQuestName": "Break the \"tower\" seal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740021001"
        ],
        "dialogs": {
          "740021001": {
            "id": "740021001",
            "speakerId": 1002,
            "speakerName": "Petit Chou",
            "text": "You're back!",
            "nextDialogs": [
              "740021002"
            ]
          },
          "740021002": {
            "id": "740021002",
            "speakerId": 1003,
            "speakerName": "Al",
            "text": "Colonel Kate and Mori linked up with us while you were out.",
            "nextDialogs": [
              "740021003"
            ]
          },
          "740021003": {
            "id": "740021003",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe. We're back with the Princess's treasure!",
            "nextDialogs": [
              "740021004"
            ]
          },
          "740021004": {
            "id": "740021004",
            "speakerId": 1004,
            "speakerName": "Colonel Kate",
            "text": "Well done, soldier! You've made a fine contribution. The Resistance Front is proud of you!",
            "nextDialogs": [
              "740021005"
            ]
          },
          "740021005": {
            "id": "740021005",
            "speakerId": 1003,
            "speakerName": "Al",
            "text": "Kate, now isn't the time...",
            "nextDialogs": [
              "740021006"
            ]
          },
          "740021006": {
            "id": "740021006",
            "speakerId": 1005,
            "speakerName": "Jak",
            "text": "#Not so fast, \"Colonel.\" {NICKNAME} is a contact of the Orchestre, not cannon-fodder from some no-name army.",
            "nextDialogs": [
              "740021007"
            ]
          },
          "740021007": {
            "id": "740021007",
            "speakerId": 1004,
            "speakerName": "Colonel Kate",
            "text": "#Ha! Your orchestra couldn't hold {NICKNAME}. Not unless you wanted to name it after {M#him}{F#her} instead!",
            "nextDialogs": [
              "740021008"
            ]
          },
          "740021008": {
            "id": "740021008",
            "speakerId": 1005,
            "speakerName": "Jak",
            "text": "#Hmph! And what of your rank? You may as well give it to {NICKNAME}, no?",
            "nextDialogs": [
              "740021009"
            ]
          },
          "740021009": {
            "id": "740021009",
            "speakerId": 1005,
            "speakerName": "Jak",
            "text": "The soldiers bleed while commanders steal the glory. This is quite ordinary. But you, now you're special! A \"colonel\" who not only does nothing, but even lets his troops take credit for victory!",
            "nextDialogs": [
              "740021010"
            ]
          },
          "740021010": {
            "id": "740021010",
            "speakerId": 1004,
            "speakerName": "Colonel Kate",
            "text": "You...! While you were whiling your time away here, I was taking out the Bubble Formations in the waters above. If not for that, they would not have gained the treasure so easily!",
            "nextDialogs": [
              "740021012"
            ]
          },
          "740021012": {
            "id": "740021012",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wow, you sound like a female protagonist in a novel! Well, uh, how about this? Let's just call the organizations Colonel Paimon's Resistance Front and the Orchestre Paimon!",
            "nextDialogs": [
              "740021013"
            ]
          },
          "740021013": {
            "id": "740021013",
            "speakerId": 1006,
            "speakerName": "Jak & Colonel Kate",
            "text": "?",
            "nextDialogs": [
              "740021016"
            ]
          },
          "740021016": {
            "id": "740021016",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "Ugh! That's it, I'm done! Mori, get him!",
            "nextDialogs": [
              "740021017"
            ]
          },
          "740021017": {
            "id": "740021017",
            "speakerId": 1007,
            "speakerName": "Mori",
            "text": "Woof, woof! Bad person!",
            "nextDialogs": [
              "740021018"
            ]
          },
          "740021018": {
            "id": "740021018",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "Mori bowls Jak over.\\n\\n",
            "nextDialogs": [
              "740021019"
            ]
          },
          "740021019": {
            "id": "740021019",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "Mori bowls Jak over.\\nKate laughs at him...\\nOnly to also be knocked over by Mori.",
            "nextDialogs": [
              "740021020"
            ]
          },
          "740021020": {
            "id": "740021020",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "The altercation is eventually calmed by Al and Petit Chou's mediation.",
            "nextDialogs": [
              "740021021"
            ]
          },
          "740021021": {
            "id": "740021021",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "Honestly...",
            "nextDialogs": [
              "740021022"
            ]
          },
          "740021022": {
            "id": "740021022",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Mori's really reliable at times like this, uh... Y'know, in some ways...",
            "nextDialogs": [
              "740021023"
            ]
          },
          "740021023": {
            "id": "740021023",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's get to business, shall we?",
            "nextDialogs": [
              "740021024"
            ]
          },
          "740021024": {
            "id": "740021024",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "That's right! We'll get nowhere if we keep arguing, and the more we go nowhere, the more we're gonna argue...",
            "nextDialogs": [
              "740021025"
            ]
          },
          "740021025": {
            "id": "740021025",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "Yes... You're both right.",
            "nextDialogs": [
              "740021026"
            ]
          },
          "740021026": {
            "id": "740021026",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Let's have a speech then, Ann! Y'know, the rousing kind!",
            "nextDialogs": [
              "740021027"
            ]
          },
          "740021027": {
            "id": "740021027",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "Eh? But...",
            "nextDialogs": [
              "740021028"
            ]
          },
          "740021028": {
            "id": "740021028",
            "speakerId": 1003,
            "speakerName": "Al",
            "text": "I approve of Paimon's suggestion. Is it not at such times that an adventure team's leader should step up to the plate?",
            "nextDialogs": [
              "740021029"
            ]
          },
          "740021029": {
            "id": "740021029",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "But I'm not good at speeches... and can you really call me the \"leader\"...?",
            "nextDialogs": [
              "740021030"
            ]
          },
          "740021030": {
            "id": "740021030",
            "speakerId": 1004,
            "speakerName": "Colonel Kate",
            "text": "As surely as I am a colonel, I affirm that you would be the best officer for this adventure team.",
            "nextDialogs": [
              "740021031"
            ]
          },
          "740021031": {
            "id": "740021031",
            "speakerId": 1005,
            "speakerName": "Jak",
            "text": "My views on the title of \"Colonel\" aside, we are in accord.",
            "nextDialogs": [
              "740021032"
            ]
          },
          "740021032": {
            "id": "740021032",
            "speakerId": 1002,
            "speakerName": "Petit Chou",
            "text": "#I... I don't know much about leaders, or glory, or whatever, but if not for you, and if not for {NICKNAME} and Paimon, whom you brought here, I don't know what would've become of me...",
            "nextDialogs": [
              "740021033"
            ]
          },
          "740021033": {
            "id": "740021033",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "...",
            "nextDialogs": [
              "740021034"
            ]
          },
          "740021034": {
            "id": "740021034",
            "speakerId": 1001,
            "speakerName": "Ann",
            "text": "#Knight {NICKNAME}, Paimon, what do you say?"
          }
        }
      }
    },

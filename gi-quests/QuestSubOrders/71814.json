    {
      "subId": "7181405",
      "subQuestName": "Pass the box to Baiwen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718140401"
        ],
        "dialogs": {
          "718140401": {
            "id": "718140401",
            "speakerId": 2143,
            "speakerName": "Baiwen",
            "text": "Hello, how may I help you?",
            "nextDialogs": [
              "718140402"
            ]
          },
          "718140402": {
            "id": "718140402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I picked this up from the sea...",
            "nextDialogs": [
              "718140403"
            ]
          },
          "718140403": {
            "id": "718140403",
            "speakerId": 2143,
            "speakerName": "Baiwen",
            "text": "Hmm? Allow me to have a look.",
            "nextDialogs": [
              "718140404"
            ]
          },
          "718140404": {
            "id": "718140404",
            "speakerId": 2143,
            "speakerName": "Baiwen",
            "text": "Yes, this does indeed come from the Jade Chamber.",
            "nextDialogs": [
              "718140405"
            ]
          },
          "718140405": {
            "id": "718140405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Anything specific you could tell me?",
            "nextDialogs": [
              "718140406"
            ]
          },
          "718140406": {
            "id": "718140406",
            "speakerId": 2143,
            "speakerName": "Baiwen",
            "text": "Well, the contents consist of several documents and an announcement that has yet to undergo review. To think that they are still so well-preserved... How unexpected.",
            "nextDialogs": [
              "718140407"
            ]
          },
          "718140407": {
            "id": "718140407",
            "speakerId": 2143,
            "speakerName": "Baiwen",
            "text": "Still, your find should save us some work. Cleaning up after this mess really has proved an unending font of busywork.",
            "nextDialogs": [
              "718140408"
            ]
          },
          "718140408": {
            "id": "718140408",
            "speakerId": 2143,
            "speakerName": "Baiwen",
            "text": "Still, thank you for bringing these to us. Do take this as a token of our appreciation."
          }
        }
      }
    },

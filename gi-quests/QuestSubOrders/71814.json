    {
      "subId": "7181403",
      "subQuestName": "Clear the flotsam from the south wharf",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718140301"
        ],
        "dialogs": {
          "718140301": {
            "id": "718140301",
            "speakerId": 2065,
            "speakerName": "Kun",
            "text": "Have you finished the cleanup?",
            "nextDialogs": [
              "718140302"
            ]
          },
          "718140302": {
            "id": "718140302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I found these things...",
            "nextDialogs": [
              "718140303"
            ]
          },
          "718140303": {
            "id": "718140303",
            "speakerId": 2065,
            "speakerName": "Kun",
            "text": "Hmm... I suppose you can just keep that Mora. It isn't much, so I suppose you can keep it as compensation for your help.",
            "nextDialogs": [
              "718140304"
            ]
          },
          "718140304": {
            "id": "718140304",
            "speakerId": 2065,
            "speakerName": "Kun",
            "text": "This box, on the other hand, is unknown to me. You might want to pass it on to Baiwen.",
            "nextDialogs": [
              "718140305"
            ]
          },
          "718140305": {
            "id": "718140305",
            "speakerId": 2065,
            "speakerName": "Kun",
            "text": "She's currently attending to some business at Yuehai Pavilion. Perhaps she might know what it is."
          }
        }
      }
    },
    {

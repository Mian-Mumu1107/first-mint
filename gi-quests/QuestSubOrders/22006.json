  },
  "subQuests": [
    {
      "subId": "2200601",
      "subQuestName": "Talk to Bao'er",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220060101"
        ],
        "dialogs": {
          "220060101": {
            "id": "220060101",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "I can't find it anywhere...",
            "nextDialogs": [
              "220060102"
            ]
          },
          "220060102": {
            "id": "220060102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What did you lose this time...",
            "nextDialogs": [
              "220060103"
            ]
          },
          "220060103": {
            "id": "220060103",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Oh, this time I haven't lost anything yet — I'm still looking for it! But I can't find it anywhere...",
            "nextDialogs": [
              "220060104"
            ]
          },
          "220060104": {
            "id": "220060104",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Where could it be? After all the effort I've gone to to confirm its whereabouts...",
            "nextDialogs": [
              "220060105"
            ]
          },
          "220060105": {
            "id": "220060105",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Help me search for it, would you? We can't let something like this stay lost!",
            "nextDialogs": [
              "220060108",
              "220060110"
            ]
          },
          "220060108": {
            "id": "220060108",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Okay, you take that side, I'll take this side.",
            "nextDialogs": [
              "220060109"
            ]
          },
          "220060109": {
            "id": "220060109",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "We have to find it!"
          },
          "220060110": {
            "id": "220060110",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "It's... uh, it's an... It's really ancient, anyway! Dates back a thousand— no, all the way back to the Archon War, in fact.",
            "nextDialogs": [
              "220060111"
            ]
          },
          "220060111": {
            "id": "220060111",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Basically, it's a very precious relic and it simply cannot stay lost! So help me find it."
          }
        }
      }
    },
    {
      "subId": "2200602",
      "subQuestName": "Search for the item Bao'er lost",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

    {
      "subId": "2200606",
      "subQuestName": "Talk to Bao'er",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220060601"
        ],
        "dialogs": {
          "220060601": {
            "id": "220060601",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "What took you so long? Did you find anything?",
            "nextDialogs": [
              "220060604",
              "220060606"
            ]
          },
          "220060604": {
            "id": "220060604",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Huh... It's not bad, but... It doesn't look anything like the one I was looking for.",
            "nextDialogs": [
              "220060605"
            ]
          },
          "220060605": {
            "id": "220060605",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Still, a relic is a relic, so I'll take care of it. Don't worry, I'll see it gets put to good use.",
            "nextDialogs": [
              "220060609"
            ]
          },
          "220060609": {
            "id": "220060609",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Thanks for your help. In return, take these.",
            "nextDialogs": [
              "220060610"
            ]
          },
          "220060610": {
            "id": "220060610",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "*sigh* But that other lost relic, I hope it's okay..."
          },
          "220060606": {
            "id": "220060606",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "It's a nice item, but not the one I was looking for.",
            "nextDialogs": [
              "220060607"
            ]
          },
          "220060607": {
            "id": "220060607",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Wait, you don't know how to take proper care of relics, do you? You might damage it.",
            "nextDialogs": [
              "220060608"
            ]
          },
          "220060608": {
            "id": "220060608",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Best if I take care of it. I'll make sure it's put to good use."
          }
        }
      }
    },
    {
      "subId": "2200604",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220060401"
        ],
        "dialogs": {
          "220060401": {
            "id": "220060401",

  "subQuests": [
    {
      "subId": "1104001",
      "subQuestName": "Go to Mondstadt's alchemy store",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1104002",
      "subQuestName": "Speak to the young lady at the store",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110400201"
        ],
        "dialogs": {
          "110400201": {
            "id": "110400201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh, looks like Timaeus isn't here today...",
            "nextDialogs": [
              "110400202"
            ]
          },
          "110400202": {
            "id": "110400202",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "(Customers!?)",
            "nextDialogs": [
              "110400203"
            ]
          },
          "110400203": {
            "id": "110400203",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "Oh! Um... Pardon me, are you looking for Timaeus?",
            "nextDialogs": [
              "110400204"
            ]
          },
          "110400204": {
            "id": "110400204",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "No no! Just strange for him to not be around. Paimon always sees him standing here.",
            "nextDialogs": [
              "110400205"
            ]
          },
          "110400205": {
            "id": "110400205",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "I see. He was called away by Albedo a little while ago. I was called over to attend to the store.",
            "nextDialogs": [
              "110400206"
            ]
          },
          "110400206": {
            "id": "110400206",
            "speakerId": 1002,
            "speakerName": "Sucrose",
            "text": "I'm Sucrose, Albedo's assistant. If you have any alchemy-related queries, you could always ask me. I'd... do my best to help.",
            "nextDialogs": [
              "110400208",
              "110400210"
            ]
          },
          "110400208": {
            "id": "110400208",
            "speakerId": 1002,
            "speakerName": "Sucrose",
            "text": "I... Actually, I'm not very good at this kind of thing.",
            "nextDialogs": [
              "110400211"
            ]
          },
          "110400211": {
            "id": "110400211",
            "speakerId": 1002,
            "speakerName": "Sucrose",
            "text": "M—My apologies, I don't get out too often. I'm usually in the laboratory, where there aren't many others to talk to.",
            "nextDialogs": [
              "110400212"
            ]
          },
          "110400212": {
            "id": "110400212",
            "speakerId": 1002,
            "speakerName": "Sucrose",
            "text": "If you need any help, just call my name. If not, I'll... I'll be reading a book — over there. Mm.",
            "nextDialogs": [
              "110400213"
            ]
          },
          "110400213": {
            "id": "110400213",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Mm-hmm, thanks! No worries, we're all clued up on the basics of alchemy, aren't we, {NICKNAME}?"
          },
          "110400210": {
            "id": "110400210",
            "speakerId": 1002,
            "speakerName": "Sucrose",
            "text": "Huh? D—Do I look nervous?"
          }
        }
      }
    },
    {
      "subId": "1104003",
      "subQuestName": "Head to the entrance of Dragonspine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110400301"
        ],
        "dialogs": {
          "110400301": {
            "id": "110400301",
            "speakerId": 1002,
            "speakerName": "Sucrose",
            "text": "My apologies, I don't really know how else to describe him...",
            "nextDialogs": [
              "110400302"
            ]
          },
          "110400302": {
            "id": "110400302",
            "speakerId": 1002,
            "speakerName": "Sucrose",
            "text": "If I could sketch you his portrait I would, but my pencil strokes are no match for his."
          }
        }
      }
    },
    {
      "subId": "1104004",
      "subQuestName": "Get close to the two people talking",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110400401"
        ],
        "dialogs": {
          "110400401": {
            "id": "110400401",
            "speakerId": 1003,
            "speakerName": "Barbara",
            "text": "S—Sister Rosaria, so here you are! Choir practice is about to—",
            "nextDialogs": [
              "110400402"
            ]
          },
          "110400402": {
            "id": "110400402",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "I've told you already, I don't go in for that kind of thing. I've got more important matters to attend to.",
            "nextDialogs": [
              "110400403"
            ]
          },
          "110400403": {
            "id": "110400403",
            "speakerId": 1003,
            "speakerName": "Barbara",
            "text": "But... this event has commemorative significance. The church hopes that all sisters will be present...",
            "nextDialogs": [
              "110400404"
            ]
          },
          "110400404": {
            "id": "110400404",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "\"Hopes\"!? That's odd, 'cause I don't recall a \"fulfill the hopes of others\" clause in my job description.",
            "nextDialogs": [
              "110400405"
            ]
          },
          "110400405": {
            "id": "110400405",
            "speakerId": 1003,
            "speakerName": "Barbara",
            "text": "I— I mean sure, but...",
            "nextDialogs": [
              "110400406"
            ]
          },
          "110400406": {
            "id": "110400406",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "But what? You're the event organizer, aren't you? Do you not find it the least bit odd...?",
            "nextDialogs": [
              "110400407"
            ]
          },
          "110400407": {
            "id": "110400407",
            "speakerId": 1003,
            "speakerName": "Barbara",
            "text": "Wh—What do you mean?",
            "nextDialogs": [
              "110400408"
            ]
          },
          "110400408": {
            "id": "110400408",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "This far out from Mondstadt, at this hour? Even if you set out right now, I'll wager you'd still miss the opening ceremony.",
            "nextDialogs": [
              "110400409"
            ]
          },
          "110400409": {
            "id": "110400409",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "Who knows? Maybe this is someone's grand plan to make a fool out of you.",
            "nextDialogs": [
              "110400410"
            ]
          },
          "110400410": {
            "id": "110400410",
            "speakerId": 1003,
            "speakerName": "Barbara",
            "text": "Huh!? Th—That can't be! People aren't like that!",
            "nextDialogs": [
              "110400411"
            ]
          },
          "110400411": {
            "id": "110400411",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "Hah! Evidence decides what people are like, not your feelings. *sigh* Maybe you're a little too trusting of other people.",
            "nextDialogs": [
              "110400412"
            ]
          },
          "110400412": {
            "id": "110400412",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "Don't fret, nobody's gonna blame you if you go back empty-handed. I can't imagine anyone else was delusional enough to think I was gonna show up.",
            "nextDialogs": [
              "110400413"
            ]
          },
          "110400413": {
            "id": "110400413",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "But if you dally any longer, you really won't make it.",
            "nextDialogs": [
              "110400414"
            ]
          },
          "110400414": {
            "id": "110400414",
            "speakerId": 1003,
            "speakerName": "Barbara",
            "text": "...You're right! It's a very important commemorative event. If I'm late, then... R—Right, I've got to get going!",
            "nextDialogs": [
              "110400415"
            ]
          },
          "110400415": {
            "id": "110400415",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, seems like that sister's an expert in making people believe anything she wants.",
            "nextDialogs": [
              "110400416"
            ]
          },
          "110400416": {
            "id": "110400416",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "I thought I heard something — who are you, and why are you eavesdropping?",
            "nextDialogs": [
              "110400417"
            ]
          },
          "110400417": {
            "id": "110400417",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We'd better watch out! She seems like a dangerous villain... Or a trickster at best.",
            "nextDialogs": [
              "110400418"
            ]
          },
          "110400418": {
            "id": "110400418",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "Oh really? I'm a member of the long-standing Favonius Church. You're an eavesdropping pixie from who knows where, and you think I'M the trickster?",
            "nextDialogs": [
              "110400419"
            ]
          },
          "110400419": {
            "id": "110400419",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, she heard that!? But Paimon was whispering so quietly...",
            "nextDialogs": [
              "110400420"
            ]
          },
          "110400420": {
            "id": "110400420",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "And as for this outlander you seem to be following... Huh — so it's you.",
            "nextDialogs": [
              "110400421"
            ]
          },
          "110400421": {
            "id": "110400421",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "The Honorary Knight that saved us from Stormterror. Well, then, given your status, I won't press you on your reasons for eavesdropping.",
            "nextDialogs": [
              "110400422"
            ]
          },
          "110400422": {
            "id": "110400422",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "Otherwise, depending on your answer, I could've arrested you on the spot.",
            "nextDialogs": [
              "110400423"
            ]
          },
          "110400423": {
            "id": "110400423",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What!? Do the sisters of Mondstadt have the authority to arrest people now?",
            "nextDialogs": [
              "110400424"
            ]
          },
          "110400424": {
            "id": "110400424",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "We can't go turning a blind eye to hidden dangers can we? Why shouldn't Sisters have a sense of justice?",
            "nextDialogs": [
              "110400425"
            ]
          },
          "110400425": {
            "id": "110400425",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmph, that doesn't sound right. But Paimon can't think of a good comeback...",
            "nextDialogs": [
              "110400426"
            ]
          },
          "110400426": {
            "id": "110400426",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "Let's talk about you. What are you doing in the mountains?",
            "nextDialogs": [
              "110400431",
              "110400429"
            ]
          },
          "110400431": {
            "id": "110400431",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "If it's him you're after, I made a point of noting his tracks.",
            "nextDialogs": [
              "110400432"
            ]
          },
          "110400432": {
            "id": "110400432",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "Many people have made their way up after the snowstorm. Let's hope they're still there.",
            "nextDialogs": [
              "110400433"
            ]
          },
          "110400433": {
            "id": "110400433",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So... are you also looking for him?",
            "nextDialogs": [
              "110400434"
            ]
          },
          "110400434": {
            "id": "110400434",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "No, this is just a professional habit of mine. I sensed elemental traces in these tracks. Never hurts to be vigilant."
          },
          "110400429": {
            "id": "110400429",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "But you're only a traveler, I doubt you have any great skill in alchemy.",
            "nextDialogs": [
              "110400430"
            ]
          },
          "110400430": {
            "id": "110400430",
            "speakerId": 1004,
            "speakerName": "Rosaria",
            "text": "Whatever, I had a notion of who you were seeking."
          }
        }
      }
    },
    {
      "subId": "1104003",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110400311"
        ],
        "dialogs": {
          "110400311": {
            "id": "110400311",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Sucrose is a whole lot less nervous once she gets talking about alchemy and research, huh. Is that what all researchers are like?",
            "nextDialogs": [
              "110400312"
            ]
          },
          "110400312": {
            "id": "110400312",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Anyway, let's go and look for Albedo.",
            "nextDialogs": [
              "110400313"
            ]
          },
          "110400313": {
            "id": "110400313",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Rosaria said there were elemental traces in the tracks. They should show up pretty clearly with Elemental Sight!"
          }
        }
      }
    },
    {
      "subId": "1104005",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110400501"
        ],
        "dialogs": {
          "110400501": {
            "id": "110400501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Looks like Timaeus isn't here today...",
            "nextDialogs": [
              "110400502"
            ]
          },
          "110400502": {
            "id": "110400502",
            "speakerId": 1002,
            "speakerName": "Sucrose",
            "text": "(Hm? Wait, are these two...)",
            "nextDialogs": [
              "110400503"
            ]
          },
          "110400503": {
            "id": "110400503",
            "speakerId": 1002,
            "speakerName": "Sucrose",
            "text": "#Oh! Um... Hello, {NICKNAME} and Paimon. Pardon me, are you looking for Timaeus?",
            "nextDialogs": [
              "110400504"
            ]
          },
          "110400504": {
            "id": "110400504",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "No no! Just strange for him to not be around. Paimon always sees him standing here.",
            "nextDialogs": [
              "110400505"
            ]
          },
          "110400505": {
            "id": "110400505",
            "speakerId": 1002,
            "speakerName": "Sucrose",
            "text": "I see. He was called away by Albedo a little while ago. I was called over to attend to the store.",
            "nextDialogs": [
              "110400506"
            ]
          },
          "110400506": {
            "id": "110400506",
            "speakerId": 1002,
            "speakerName": "Sucrose",
            "text": "If you need any help, just call my name. If not, I'll... I'll be reading a book — over there.",
            "nextDialogs": [
              "110400507"
            ]
          },
          "110400507": {
            "id": "110400507",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Mm-hmm, thanks! No worries, we're all clued up on the basics of alchemy, aren't we, {NICKNAME}?",
            "nextDialogs": [
              "110400508"
            ]
          },
          "110400508": {
            "id": "110400508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Mm-hmm, no need to trouble you.",
            "nextDialogs": [
              "110400509"
            ]
          },
          "110400509": {
            "id": "110400509",
            "speakerId": 1002,
            "speakerName": "Sucrose",
            "text": "I guess it's no surprise coming from the one who repelled Stormterror...",
            "nextDialogs": [
              "110400510"
            ]
          },
          "110400510": {
            "id": "110400510",
            "speakerId": 1002,
            "speakerName": "Sucrose",
            "text": "Actually, since it's you... I bet you're someone who'd be able to help Albedo.",
            "nextDialogs": [
              "110400511"
            ]
          },
          "110400511": {
            "id": "110400511",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "There's that name again: \"Albedo.\" You and Timaeus mentioned him the last time we met, right? Is he also an alchemist in Mondstadt?"
          }
        }
      }
    }
  ]
}
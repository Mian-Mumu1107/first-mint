    {
      "subId": "7510807",
      "subQuestName": "Deliver food to your animal friends",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751080701"
        ],
        "dialogs": {
          "751080701": {
            "id": "751080701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Here comes something yummy! Don't just play around — you have to replenish your energy, too.",
            "nextDialogs": [
              "751080702"
            ]
          },
          "751080702": {
            "id": "751080702",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751080703"
            ]
          },
          "751080703": {
            "id": "751080703",
            "speakerId": 21689,
            "speakerName": "Weakened Blubberbeast",
            "text": "A... Aooouhh!",
            "nextDialogs": [
              "751080704"
            ]
          },
          "751080704": {
            "id": "751080704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, looks like they're having a great time. Will you choke if you eat upside down like that, though...?",
            "nextDialogs": [
              "751080705"
            ]
          },
          "751080705": {
            "id": "751080705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Stay safe. Don't be like that Blubberbeast.",
            "nextDialogs": [
              "751080706"
            ]
          },
          "751080706": {
            "id": "751080706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, what's with that patronizing tone? Paimon's no Blubberbeast. She's not gonna be so silly as to eat like that.",
            "nextDialogs": [
              "751080707"
            ]
          },
          "751080707": {
            "id": "751080707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Try it yourself and you'll see.",
            "nextDialogs": [
              "751080708"
            ]
          },
          "751080708": {
            "id": "751080708",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Paimon's not gonna eat like that — she isn't a Blubberbeast anyway!",
            "nextDialogs": [
              "751080709"
            ]
          },
          "751080709": {
            "id": "751080709",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "The Blubberbeast seems to have recovered enough strength for it to flap over and tumble into the sea...",
            "nextDialogs": [
              "751080719"
            ]
          },
          "751080719": {
            "id": "751080719",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Mmm... Aourgh!",
            "nextDialogs": [
              "751080710"
            ]
          },
          "751080710": {
            "id": "751080710",
            "speakerId": 1005,
            "speakerName": "Now-Healthy Blubberbeast",
            "text": "Aohh! Woo... Arr!",
            "nextDialogs": [
              "751080712"
            ]
          },
          "751080712": {
            "id": "751080712",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, it's gone...",
            "nextDialogs": [
              "751080713"
            ]
          },
          "751080713": {
            "id": "751080713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's just how things are. I mean, it's not indigenous to Natlan.",
            "nextDialogs": [
              "751080715"
            ]
          },
          "751080715": {
            "id": "751080715",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrooh...",
            "nextDialogs": [
              "751080716"
            ]
          },
          "751080716": {
            "id": "751080716",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Don't be sad, {REALNAME[ID(2)|SHOWHOST(true)]}. You had so much fun just now, and you're already friends!",
            "nextDialogs": [
              "751080717"
            ]
          },
          "751080717": {
            "id": "751080717",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, Paimon's got a feeling that this isn't the last we've seen of that Blubberbeast!",
            "nextDialogs": [
              "751080718"
            ]
          },
          "751080718": {
            "id": "751080718",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!"
          }
        }
      }
    },
    {
      "subId": "7510802",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751080201"
        ],
        "dialogs": {
          "751080201": {
            "id": "751080201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We said we were going to cook, but what exactly should we make?",
            "nextDialogs": [
              "751080202"
            ]
          },
          "751080202": {
            "id": "751080202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Blubberbeasts live in the water, so it must eat fish, right? Let's do a fish dish, then.",
            "nextDialogs": [
              "751080203"
            ]
          },
          "751080203": {
            "id": "751080203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#If we want the Blubberbeast and {REALNAME[ID(2)|SHOWHOST(true)]} to eat well... Natlan's special Grilled Fish in Mint Sauce might be a pretty good choice.",
            "nextDialogs": [
              "751080206"
            ]
          },
          "751080206": {
            "id": "751080206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright, let's get started then. Paimon will give you some pointers while you're at it!"
          }
        }
      }
    },
    {
      "subId": "7510813",
      "subQuestName": "Additional",

  "subQuests": [
    {
      "subId": "7510801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751080101"
        ],
        "dialogs": {
          "751080101": {
            "id": "751080101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We said we were going to cook, but what exactly should we make?",
            "nextDialogs": [
              "751080102"
            ]
          },
          "751080102": {
            "id": "751080102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... We used to feed fish to the Blubberbeast Berrypuff, didn't we? In that case, a fish dish should do just fine!",
            "nextDialogs": [
              "751080103"
            ]
          },
          "751080103": {
            "id": "751080103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#If we want the Blubberbeast and {REALNAME[ID(2)|SHOWHOST(true)]} to eat well... Natlan's special Grilled Fish in Mint Sauce might be a pretty good choice.",
            "nextDialogs": [
              "751080106"
            ]
          },
          "751080106": {
            "id": "751080106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright, let's get started then. Paimon will give you some pointers while you're at it!"
          }
        }
      }
    },
    {
      "subId": "7510803",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751080301"
        ],
        "dialogs": {
          "751080301": {
            "id": "751080301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sure enough, there are still some Saurians locked up here...",
            "nextDialogs": [
              "751080302"
            ]
          },
          "751080302": {
            "id": "751080302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Who'd have thought they'd persist in their wicked ways and keep hurting Saurians, even after we destroyed their base...",
            "nextDialogs": [
              "751080303"
            ]
          },
          "751080303": {
            "id": "751080303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Had we known, we could've chased them down and wiped them all out.",
            "nextDialogs": [
              "751080305",
              "751080307"
            ]
          },
          "751080305": {
            "id": "751080305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "True. Now let's save 'em, quick!",
            "nextDialogs": [
              "751080308"
            ]
          },
          "751080308": {
            "id": "751080308",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!"
          },
          "751080307": {
            "id": "751080307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Paimon can hardly imagine you being like that, {NICKNAME}... Anyway, let's help 'em first!"
          }
        }
      }
    },
    {
      "subId": "7510804",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751080401"
        ],
        "dialogs": {
          "751080401": {
            "id": "751080401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm? Why are there Saurians in the cages here?",
            "nextDialogs": [
              "751080402"
            ]
          },
          "751080402": {
            "id": "751080402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Something's not right here... Wait. Could they all have been captured by those people?",
            "nextDialogs": [
              "751080403"
            ]
          },
          "751080403": {
            "id": "751080403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Have we busted some kinda Saurian trafficking ring without even realizing it?",
            "nextDialogs": [
              "751080405",
              "751080407"
            ]
          },
          "751080405": {
            "id": "751080405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's right! Now let's get all these Saurians outta here!",
            "nextDialogs": [
              "751080408"
            ]
          },
          "751080408": {
            "id": "751080408",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!"
          },
          "751080407": {
            "id": "751080407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "C'mon, it matters a lot — that the kidnapped Saurians can now regain their freedom, that is. Let's help them, pronto!"
          }
        }
      }
    },
    {
      "subId": "7510805",
      "subQuestName": "Rescue the animals",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751080501"
        ],
        "dialogs": {
          "751080501": {
            "id": "751080501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, there's a... Blubberbeast in here? How in the world—? Guess bad guys really will sell anything...",
            "nextDialogs": [
              "751080502"
            ]
          },
          "751080502": {
            "id": "751080502",
            "speakerId": 1002,
            "speakerName": "Victimized Blubberbeast",
            "text": "Awrr... Bluboo!",
            "nextDialogs": [
              "751080503"
            ]
          },
          "751080503": {
            "id": "751080503",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rroo... Mrrooh!",
            "nextDialogs": [
              "751080504"
            ]
          },
          "751080504": {
            "id": "751080504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Huh? You're kinda interested in the Blubberbeast, aren't you, {REALNAME[ID(2)|SHOWHOST(true)]}?",
            "nextDialogs": [
              "751080505"
            ]
          },
          "751080505": {
            "id": "751080505",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]} listens intently to the cries of the Blubberbeast and, seemingly understanding something, lifts the creature by the tail to take it over to the shallows, where they play together.",
            "nextDialogs": [
              "751080512"
            ]
          },
          "751080512": {
            "id": "751080512",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751080508"
            ]
          },
          "751080508": {
            "id": "751080508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sure does! Maybe they can become friends?",
            "nextDialogs": [
              "751080509"
            ]
          },
          "751080509": {
            "id": "751080509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But that Blubberbeast doesn't seem to have the slightest bit of strength, and its two... Err, paws...? Either way, they don't seem able to flap around much.",
            "nextDialogs": [
              "751080510"
            ]
          },
          "751080510": {
            "id": "751080510",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There wasn't even a plate of food around... Perhaps they've been locked up so long that they're starving.",
            "nextDialogs": [
              "751080511"
            ]
          },
          "751080511": {
            "id": "751080511",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#If that's so, let's make something for the Blubberbeast and {REALNAME[ID(2)|SHOWHOST(true)]} to eat!"
          }
        }
      }
    },
    {
      "subId": "7510802",

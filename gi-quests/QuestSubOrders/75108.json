            ]
          },
          "751081302": {
            "id": "751081302",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Arawr?",
            "nextDialogs": [
              "751081303"
            ]
          },
          "751081303": {
            "id": "751081303",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Awwrr...",
            "nextDialogs": [
              "751081304"
            ]
          },
          "751081304": {
            "id": "751081304",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751081305"
            ]
          },
          "751081305": {
            "id": "751081305",
            "speakerId": 21689,
            "speakerName": "Weakened Blubberbeast",
            "text": "Aouh?",
            "nextDialogs": [
              "751081306"
            ]
          },
          "751081306": {
            "id": "751081306",
            "speakerId": 21689,
            "speakerName": "Weakened Blubberbeast",
            "text": "Aouh...",
            "nextDialogs": [
              "751081307"
            ]
          },
          "751081307": {
            "id": "751081307",
            "speakerId": 21689,
            "speakerName": "Weakened Blubberbeast",
            "text": "Auh!",
            "nextDialogs": [
              "751081308"
            ]
          },
          "751081308": {
            "id": "751081308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon can't understand their conversation at all, but it seems they've reached an understanding...?",
            "nextDialogs": [
              "751081311"
            ]
          },
          "751081311": {
            "id": "751081311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Makes sense. Even though the Blubberbeast doesn't have much strength, it feels like they're really happy — and Paimon feels happy for 'em, too!"
          }
        }
      }

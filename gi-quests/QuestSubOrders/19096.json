        "dialogs": {
          "190960901": {
            "id": "190960901",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Winery rules state that whoever picks the most grapes without damaging them gets to drink the first glass from the new batch."
          }
        }
      }
    },
    {
      "subId": "1909611",
      "subQuestName": "Pick grapes",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190961101"
        ],
        "dialogs": {
          "190961101": {
            "id": "190961101",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Where's Kaeya? Gone already?",
            "nextDialogs": [
              "190961102"
            ]
          },
          "190961102": {
            "id": "190961102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Kaeya's still here. What're you working on?",
            "nextDialogs": [
              "190961103"
            ]
          },
          "190961103": {
            "id": "190961103",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Right now, just the usual day-to-day winery business. But I'll be attending a meeting in Elzer's place shortly.",
            "nextDialogs": [
              "190961104"
            ]
          },
          "190961104": {
            "id": "190961104",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "The meeting concerns research and development of new beverages, and involves collaboration between several different wineries. It makes more sense for me to attend, anyway.",
            "nextDialogs": [
              "190961105"
            ]
          },
          "190961105": {
            "id": "190961105",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Kaeya can answer any questions you might have while I'm not here. He's quite familiar with the winery."
          }
        }
      }
    },
    {

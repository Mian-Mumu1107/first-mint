            ]
          },
          "772150312": {
            "id": "772150312",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "To attend... Lady Pavlina's wedding.",
            "nextDialogs": [
              "772150313"
            ]
          },
          "772150313": {
            "id": "772150313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhhh... but...",
            "nextDialogs": [
              "772150314"
            ]
          },
          "772150314": {
            "id": "772150314",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The wedding's already over.",
            "nextDialogs": [
              "772150315"
            ]
          },
          "772150315": {
            "id": "772150315",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "Is... the wedding... over?",
            "nextDialogs": [
              "772150316"
            ]
          },
          "772150316": {
            "id": "772150316",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yup.",
            "nextDialogs": [
              "772150317"
            ]
          },
          "772150317": {
            "id": "772150317",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Scheskaya told me what happened at the House...",
            "nextDialogs": [
              "772150318"
            ]
          },
          "772150318": {
            "id": "772150318",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "Ah, my Lady... in the end, nothing has changed.",
            "nextDialogs": [
              "772150319"
            ]
          },
          "772150319": {
            "id": "772150319",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "But all that pain, all that resentment, everything that tortured her spirit, did go away in the end...",
            "nextDialogs": [
              "772150320"
            ]
          },
          "772150320": {
            "id": "772150320",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "*Sigh* I suppose that does mean that she did find release in the end... didn't she?"
          }
        }
      }
    },

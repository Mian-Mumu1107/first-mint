  "subQuests": [
    {
      "subId": "7721502",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772150201"
        ],
        "dialogs": {
          "772150201": {
            "id": "772150201",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "Hey, you over there... and your little minion too... Could you please stop for a moment? I'd like to share something with you.",
            "nextDialogs": [
              "772150202"
            ]
          },
          "772150202": {
            "id": "772150202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you talking to me?",
            "nextDialogs": [
              "772150203"
            ]
          },
          "772150203": {
            "id": "772150203",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "Yes, you.",
            "nextDialogs": [
              "772150204"
            ]
          },
          "772150204": {
            "id": "772150204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Who's she calling a minion...? Oh, Paimon?",
            "nextDialogs": [
              "772150205"
            ]
          },
          "772150205": {
            "id": "772150205",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "Yes, the two of you.",
            "nextDialogs": [
              "772150206"
            ]
          },
          "772150206": {
            "id": "772150206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's not a minion, gee. We're traveling together... Anyway, what do you want to tell us?",
            "nextDialogs": [
              "772150207"
            ]
          },
          "772150207": {
            "id": "772150207",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "...I'm actually scouting for suitable guests.",
            "nextDialogs": [
              "772150208"
            ]
          },
          "772150208": {
            "id": "772150208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Guests?",
            "nextDialogs": [
              "772150209"
            ]
          },
          "772150209": {
            "id": "772150209",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "Yes. I'm from the House of Hesperides in the mountains. That's the residence of Lady Pavlina, princess of the Snegovik, and other fae...",
            "nextDialogs": [
              "772150210"
            ]
          },
          "772150210": {
            "id": "772150210",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "And now, we're looking for... exalted guests to attend the princess's wedding. That's why I've been sent down here to look for the most suitable and worthy individuals...",
            "nextDialogs": [
              "772150211"
            ]
          },
          "772150211": {
            "id": "772150211",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "The two of you certainly seem to fit that criterion, what with your extraordinary temperaments and dress. I wonder if we may have the honor of hosting you at the House?",
            "nextDialogs": [
              "772150212"
            ]
          },
          "772150212": {
            "id": "772150212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah... So you want us to attend the princess's wedding at some... house in the mountains...",
            "nextDialogs": [
              "772150213"
            ]
          },
          "772150213": {
            "id": "772150213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So that in— oh, that's right. We already have the invite.",
            "nextDialogs": [
              "772150214"
            ]
          },
          "772150214": {
            "id": "772150214",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "Oh, is that so?",
            "nextDialogs": [
              "772150215"
            ]
          },
          "772150215": {
            "id": "772150215",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "...Ah, looks like this is all the work of fate. The two of you are destined to be guests of the House of Hesperides, no matter how the invite falls into your hands.",
            "nextDialogs": [
              "772150216"
            ]
          },
          "772150216": {
            "id": "772150216",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "In that case, simply take the invite and show it when you arrive at the House of Hesperides. That will get you into Lady Pavlina's wedding...",
            "nextDialogs": [
              "772150217"
            ]
          },
          "772150217": {
            "id": "772150217",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "Although I'd dearly love to travel with you, I have yet to complete the task Lady Pavlina has given me...",
            "nextDialogs": [
              "772150218"
            ]
          },
          "772150218": {
            "id": "772150218",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's fine. We'll find our way to that... um... whatever house you were talking about! That name's too darn long!",
            "nextDialogs": [
              "772150219"
            ]
          },
          "772150219": {
            "id": "772150219",
            "speakerId": 1000,
            "speakerName": "Myeshskaya",
            "text": "Heh. I wish the both you a most pleasant time at the House, then..."
          }
        }
      }
    },

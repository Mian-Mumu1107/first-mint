              "698390106"
            ]
          },
          "698390106": {
            "id": "698390106",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "That depends on your fortune. We are currently preparing new slips.",
            "nextDialogs": [
              "698390107"
            ]
          },
          "698390107": {
            "id": "698390107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And how do I check that fortune?",
            "nextDialogs": [
              "698390108"
            ]
          },
          "698390108": {
            "id": "698390108",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "Draw a slip.",
            "nextDialogs": [
              "698390109"
            ]
          },
          "698390109": {
            "id": "698390109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...And when can I draw a slip?",
            "nextDialogs": [
              "698390110"
            ]
          },
          "698390110": {
            "id": "698390110",
            "speakerId": 15465,
            "speakerName": "Gendou Ringo",
            "text": "That depends on your fortune."
          }
        }

  "subQuests": [
    {
      "subId": "7273601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "727360101"
        ],
        "dialogs": {
          "727360101": {
            "id": "727360101",
            "speakerId": 13019,
            "speakerName": "Grandmaster Hanakado",
            "text": "Splendid, splendid!",
            "nextDialogs": [
              "727360102"
            ]
          },
          "727360102": {
            "id": "727360102",
            "speakerId": 13019,
            "speakerName": "Grandmaster Hanakado",
            "text": "I did not expect the Arataki Gang to defeat so many mighty beetle fighters. It seems that you are well-versed in this art.",
            "nextDialogs": [
              "727360103"
            ]
          },
          "727360103": {
            "id": "727360103",
            "speakerId": 13019,
            "speakerName": "Grandmaster Hanakado",
            "text": "I take back what I once said. You are respectable and worthy opponents, and I must face you as such — with my full strength!",
            "nextDialogs": [
              "727360104"
            ]
          },
          "727360104": {
            "id": "727360104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alrighty! Bull-Chucker, you're our leader. It's your time to shine!",
            "nextDialogs": [
              "727360105"
            ]
          },
          "727360105": {
            "id": "727360105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And, uh, don't take what was said earlier seriously!",
            "nextDialogs": [
              "727360108"
            ]
          },
          "727360108": {
            "id": "727360108",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Hahahahahaha! Oh, it's on! The final showdown, and my soon-to-be final victory!",
            "nextDialogs": [
              "727360109"
            ]
          },
          "727360109": {
            "id": "727360109",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "I don't know how you've been leading your crew, but the results speak for themselves: The Arataki Gang rules!",
            "nextDialogs": [
              "727360110"
            ]
          },
          "727360110": {
            "id": "727360110",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Grandmaster Hanakado, get ready to battle!"
          }
        }
      }
    },
    {
      "subId": "7273602",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "727360201"
        ],
        "dialogs": {
          "727360201": {
            "id": "727360201",
            "speakerId": 13019,
            "speakerName": "Grandmaster Hanakado",
            "text": "I see. I see... Let us battle once more. This time, I'll see through all of your methods.",
            "nextDialogs": [
              "727360202"
            ]
          },
          "727360202": {
            "id": "727360202",
            "speakerId": 13019,
            "speakerName": "Grandmaster Hanakado",
            "text": "Victory and defeat no longer seem so important... Let's just battle for fun, shall we?",
            "nextDialogs": [
              "727360203"
            ]
          },
          "727360203": {
            "id": "727360203",
            "speakerId": 13019,
            "speakerName": "Grandmaster Hanakado",
            "text": "It's rare that I should find such a great opponent. It would be a shame to end our battles so soon, would it not?",
            "nextDialogs": [
              "727360204"
            ]
          },
          "727360204": {
            "id": "727360204",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Sure! Bring it on!",
            "nextDialogs": [
              "727360205"
            ]
          },
          "727360205": {
            "id": "727360205",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "But seeing through my secret beetle-fighting techniques? Nah, little fella, that ain't gonna happen!",
            "nextDialogs": [
              "727360206"
            ]
          },
          "727360206": {
            "id": "727360206",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "If you'll admit that I'm the stronger beetle fighter, I'll fight you for as many rounds as you want!",
            "nextDialogs": [
              "727360207"
            ]
          },
          "727360207": {
            "id": "727360207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, looks like Bull-Chucker and Grandmaster Hanakado are still raring to go... Well, let's leave them to it! They can battle beetles till the beetle-battling's done!"
          }
        }
      }
    }
  ]
}
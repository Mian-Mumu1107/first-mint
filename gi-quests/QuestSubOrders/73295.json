    {
      "subId": "7329506",
      "subQuestName": "Talk to Pepper",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732950601"
        ],
        "dialogs": {
          "732950601": {
            "id": "732950601",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eh? Isn't this Pepper? It seems to be guarding something, too! Wait, this feels kinda familiar...",
            "nextDialogs": [
              "732950602"
            ]
          },
          "732950602": {
            "id": "732950602",
            "speakerId": 1001,
            "speakerName": "Dog",
            "text": "(It seems to have recognized you and wags its tail.)",
            "nextDialogs": [
              "732950603"
            ]
          },
          "732950603": {
            "id": "732950603",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, is it guarding Julien's sketches?",
            "nextDialogs": [
              "732950604"
            ]
          },
          "732950604": {
            "id": "732950604",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Pepper barks twice before leaving quickly...",
            "nextDialogs": [
              "732950605"
            ]
          },
          "732950605": {
            "id": "732950605",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And there it goes again. It was like this the last time as well... Speaking of which, what do the hilichurls need sketches for?",
            "nextDialogs": [
              "732950607",
              "732950609"
            ]
          },
          "732950607": {
            "id": "732950607",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Uh, would they though..."
          },
          "732950609": {
            "id": "732950609",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Ugh! You have an awful imagination, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "7329507",

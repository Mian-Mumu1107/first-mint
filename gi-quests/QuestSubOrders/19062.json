          "1906203302": {
            "id": "1906203302",
            "speakerId": 11001,
            "speakerName": "Alois",
            "text": "On another note, that drink's made me realize just how empty my stomach is...",
            "nextDialogs": [
              "1906203303"
            ]
          },
          "1906203303": {
            "id": "1906203303",
            "speakerId": 1027,
            "speakerName": "Noelle",
            "text": "Oh, so you're hungry too!",
            "nextDialogs": [
              "1906203304"
            ]
          },
          "1906203304": {
            "id": "1906203304",
            "speakerId": 1027,
            "speakerName": "Noelle",
            "text": "...How terrible of me. If I'd realized, I would've saved some pancakes for you.",
            "nextDialogs": [
              "1906203305"
            ]
          },
          "1906203305": {
            "id": "1906203305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not to worry. Let's go to the Good Hunter restaurant.",
            "nextDialogs": [
              "1906203306"
            ]
          },
          "1906203306": {
            "id": "1906203306",
            "speakerId": 11001,
            "speakerName": "Alois",
            "text": "Oh, good idea! That sounds like a good place!"
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "7220401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040101"
        ],
        "dialogs": {
          "722040101": {
            "id": "722040101",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Kito, Kina, you're back...?",
            "nextDialogs": [
              "722040102"
            ]
          },
          "722040102": {
            "id": "722040102",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Really now, you should stop running around all the time. These old legs can't keep up with the two of you! And what would we do if the two of you got into any trouble, hmm?",
            "nextDialogs": [
              "722040105"
            ]
          },
          "722040105": {
            "id": "722040105",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "What? Come now, how could you children say that to an old lady? You'll break my heart...",
            "nextDialogs": [
              "722040106"
            ]
          },
          "722040106": {
            "id": "722040106",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Well, since you're here, don't go running off for now, alright? Keep Granny company for a bit."
          }
        }
      }
    },
    {
      "subId": "7220408",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040801"
        ],
        "dialogs": {
          "722040801": {
            "id": "722040801",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Kito and Kina... They are still here on this island, aren't they?",
            "nextDialogs": [
              "722040802"
            ]
          },
          "722040802": {
            "id": "722040802",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Ah, those kids... How they worry me..."
          }
        }
      }
    },
    {
      "subId": "7220402",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040301"
        ],
        "dialogs": {
          "722040301": {
            "id": "722040301",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "*sigh* It's all getting less and less clear now... Everything's getting foggier and foggier...",
            "nextDialogs": [
              "722040304"
            ]
          },
          "722040304": {
            "id": "722040304",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "*sigh* My memory's growing worse by the day. I suppose that's getting old for you...",
            "nextDialogs": [
              "722040305"
            ]
          },
          "722040305": {
            "id": "722040305",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "But what shall I do? I don't know if Kito and Kina are hungry, or whether they're safe as they play outside..."
          }
        }
      }
    },
    {
      "subId": "7220409",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040901"
        ],
        "dialogs": {
          "722040901": {
            "id": "722040901",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Ah, you're here. Kito! Kina! Come on now, greet our guest!",
            "nextDialogs": [
              "722040902"
            ]
          },
          "722040902": {
            "id": "722040902",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "...Oh, where have they gone off to... I'm very sorry about this.",
            "nextDialogs": [
              "722040903"
            ]
          },
          "722040903": {
            "id": "722040903",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Hmm, actually, what was your name again?",
            "nextDialogs": [
              "722040906"
            ]
          },
          "722040906": {
            "id": "722040906",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "*sigh* I... I'm soon to depart, aren't I?",
            "nextDialogs": [
              "722040907"
            ]
          },
          "722040907": {
            "id": "722040907",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Depart\"?",
            "nextDialogs": [
              "722040908"
            ]
          },
          "722040908": {
            "id": "722040908",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "The boatman has come to see me quite often lately.",
            "nextDialogs": [
              "722040909"
            ]
          },
          "722040909": {
            "id": "722040909",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "He comes quietly each time, wearing his golden fur clothes, his long gold pants, with a crown of gold silk on his head...",
            "nextDialogs": [
              "722040910"
            ]
          },
          "722040910": {
            "id": "722040910",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Just like my mother told me, and just like I told Kito and Kina... He comes to take us aboard his silver boat, aboard his boat he'll take us...",
            "nextDialogs": [
              "722040911"
            ]
          },
          "722040911": {
            "id": "722040911",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "The boat will sail and sail, across a glittering river, into the land of dreams. There, there shall be no fog, and there shall be a great golden hall, with seventy cradles, and seventy more again... They will rock back and forth, back and forth...",
            "nextDialogs": [
              "722040912"
            ]
          },
          "722040912": {
            "id": "722040912",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "There we will sleep and become motes of light... And we shall become the dreams of this world's children..."
          }
        }
      }
    },
    {
      "subId": "7220403",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040501"
        ],
        "dialogs": {
          "722040501": {
            "id": "722040501",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Ah, is that Abe? How do the mushrooms in your home fare? Haha... Don't you go bothering the priest again. I won't agree no matter how many times he asks!",
            "nextDialogs": [
              "722040502"
            ]
          },
          "722040502": {
            "id": "722040502",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Haha! I mean, I'm sorry, but I have my hands full taking care of the house on my own. Most sorry, hehe...",
            "nextDialogs": [
              "722040503"
            ]
          },
          "722040503": {
            "id": "722040503",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Sorry... *sigh* I'm sorry...",
            "nextDialogs": [
              "722040506"
            ]
          },
          "722040506": {
            "id": "722040506",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Ah! You! You... Come on, get in here, before you embarrass us!"
          }
        }
      }
    },
    {
      "subId": "7220410",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722041001"
        ],
        "dialogs": {
          "722041001": {
            "id": "722041001",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "*sigh* Those children...",
            "nextDialogs": [
              "722041002"
            ]
          },
          "722041002": {
            "id": "722041002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This is from Kito and Kina."
          }
        }
      }
    },
    {
      "subId": "7220404",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040701"
        ],
        "dialogs": {
          "722040701": {
            "id": "722040701",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Oh. Oh, hello, hello...",
            "nextDialogs": [
              "722040702"
            ]
          },
          "722040702": {
            "id": "722040702",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "I'm most sorry, but my mind's getting less clear the older I get. Could I ask who you are again? Have we ever met?",
            "nextDialogs": [
              "722040705"
            ]
          },
          "722040705": {
            "id": "722040705",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "I've never heard such a name before. Did you come from the outside?",
            "nextDialogs": [
              "722040706"
            ]
          },
          "722040706": {
            "id": "722040706",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "That's awfully strange. You shouldn't have been able to come ashore without the Great Thunderbird's leave..."
          }
        }
      }
    },
    {
      "subId": "7220411",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722041101"
        ],
        "dialogs": {
          "722041101": {
            "id": "722041101",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "I'm sorry, but I cannot come onboard yet...",
            "nextDialogs": [
              "722041102"
            ]
          },
          "722041102": {
            "id": "722041102",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Those I love have yet to board..."
          }
        }
      }
    },
    {
      "subId": "7220406",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040601"
        ],
        "dialogs": {
          "722040601": {
            "id": "722040601",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "...Did you say that he was holding onto... these?",
            "nextDialogs": [
              "722040602"
            ]
          },
          "722040602": {
            "id": "722040602",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "What... What were you thinking... What in the world were you thinking?"
          }
        }
      }
    },
    {
      "subId": "7220412",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722041201"
        ],
        "dialogs": {
          "722041201": {
            "id": "722041201",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Ah, this scent... This is Kito's sachet, is it not?",
            "nextDialogs": [
              "722041202"
            ]
          },
          "722041202": {
            "id": "722041202",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "This can only mean that they've gotten tired of playing and are leaving now, yes?",
            "nextDialogs": [
              "722041203"
            ]
          },
          "722041203": {
            "id": "722041203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm not entirely sure what you mean, but... \"yes,\" I guess.",
            "nextDialogs": [
              "722041204"
            ]
          },
          "722041204": {
            "id": "722041204",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Thank you, outsider... Farewell.",
            "nextDialogs": [
              "722041205"
            ]
          },
          "722041205": {
            "id": "722041205",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "The cypresses silver, the river of dreams... Take me there, dear boatman..."
          }
        }
      }
    },
    {
      "subId": "7220402",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040201"
        ],
        "dialogs": {
          "722040201": {
            "id": "722040201",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Alright then, alright. Guess Granny needs a little nap now... *snoring*",
            "nextDialogs": [
              "722040202"
            ]
          },
          "722040202": {
            "id": "722040202",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "You two be careful now... Don't run off too far... *snoring*"
          }
        }
      }
    },
    {
      "subId": "7220404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040401"
        ],
        "dialogs": {
          "722040401": {
            "id": "722040401",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "But not now. Go on, go on and play. Granny will still be here.",
            "nextDialogs": [
              "722040402"
            ]
          },
          "722040402": {
            "id": "722040402",
            "speakerId": 20426,
            "speakerName": "Una",
            "text": "Petals, hey, petals, ho, where is the homeland where you grow?"
          }
        }
      }
    }
  ]
}
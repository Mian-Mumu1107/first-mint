    {
      "subId": "7001601",
      "subQuestName": "Talk to the hilichurl",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700160101"
        ],
        "dialogs": {
          "700160101": {
            "id": "700160101",
            "speakerId": 1000,
            "speakerName": "Lonely Hilichurl",
            "text": "...Yaya dala?",
            "nextDialogs": [
              "700160102"
            ]
          },
          "700160102": {
            "id": "700160102",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "Mimi tomo, mimi mosi mita, Muhe mita?",
            "nextDialogs": [
              "700160103"
            ]
          },
          "700160103": {
            "id": "700160103",
            "speakerId": 1000,
            "speakerName": "Lonely Hilichurl",
            "text": "Mita...? Gusha... Dada ika odomu Plata mimi, mimi mosi gusha...",
            "nextDialogs": [
              "700160104"
            ]
          },
          "700160104": {
            "id": "700160104",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "Mimi tomo, mimi plata yaya ika! Mimi mani ye!",
            "nextDialogs": [
              "700160105"
            ]
          },
          "700160105": {
            "id": "700160105",
            "speakerId": 1000,
            "speakerName": "Lonely Hilichurl",
            "text": "Mani...? Dada! Kundala zido mi, mi dada, mimi tomo!",
            "nextDialogs": [
              "700160106"
            ]
          },
          "700160106": {
            "id": "700160106",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Seems they're really getting into their conversation...",
            "nextDialogs": [
              "700160109"
            ]
          },
          "700160109": {
            "id": "700160109",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "It just isn't fond of talking. But I still managed to get the information we needed.",
            "nextDialogs": [
              "700160110"
            ]
          },
          "700160110": {
            "id": "700160110",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "All we need to do is defeat its enemy. That's where you guys come in!",
            "nextDialogs": [
              "700160111"
            ]
          },
          "700160111": {
            "id": "700160111",
            "speakerId": 1000,
            "speakerName": "Lonely Hilichurl",
            "text": "Dada, Valo!"
          }
        }
      }
    },

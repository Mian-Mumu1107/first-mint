            ]
          },
          "700160203": {
            "id": "700160203",
            "speakerId": 1000,
            "speakerName": "Lonely Hilichurl",
            "text": "Mi mito nye. Mi mito du, du ya mito Wei.",
            "nextDialogs": [
              "700160204"
            ]
          },
          "700160204": {
            "id": "700160204",
            "speakerId": 1001,
            "speakerName": "Ella Musk",
            "text": "It directed us to this location. It said someone here will have seen it before.",
            "nextDialogs": [
              "700160205"
            ]
          },
          "700160205": {
            "id": "700160205",
            "speakerId": -1,

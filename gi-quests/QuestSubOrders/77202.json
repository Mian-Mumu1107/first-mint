    {
      "subId": "7720204",
      "subQuestName": "Talk to Martos",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772020401"
        ],
        "dialogs": {
          "772020401": {
            "id": "772020401",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "*panting* ... Oh, Tsaritsa be praised... Scared me to death there... If I'd fallen into the water, that would've been the end of me.",
            "nextDialogs": [
              "772020402"
            ]
          },
          "772020402": {
            "id": "772020402",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "Thanks, you two. I'm Martos... Sorry...",
            "nextDialogs": [
              "772020403"
            ]
          },
          "772020403": {
            "id": "772020403",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Why are you apologizing?",
            "nextDialogs": [
              "772020404"
            ]
          },
          "772020404": {
            "id": "772020404",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "...I wanted to tell you that that block of ice wasn't at all solid, but I just... couldn't get the words out while I was up there. I can't say why.",
            "nextDialogs": [
              "772020405"
            ]
          },
          "772020405": {
            "id": "772020405",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Eh, you were probably just feeling a bit too weak, y'know? Anyway, feeling better now?",
            "nextDialogs": [
              "772020406"
            ]
          },
          "772020406": {
            "id": "772020406",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "Yes, much better. Thanks to you two, to be honest... Um, might I know your names?",
            "nextDialogs": [
              "772020407"
            ]
          },
          "772020407": {
            "id": "772020407",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You introduce yourselves to Martos.",
            "nextDialogs": [
              "772020408"
            ]
          },
          "772020408": {
            "id": "772020408",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "#{NICKNAME} and Paimon... I see.",
            "nextDialogs": [
              "772020409"
            ]
          },
          "772020409": {
            "id": "772020409",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...That said, Martos, what brings you here at all, out in the ice and snow?",
            "nextDialogs": [
              "772020410"
            ]
          },
          "772020410": {
            "id": "772020410",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "Prime Ice Sculpting. That's what I came here to learn...",
            "nextDialogs": [
              "772020411"
            ]
          },
          "772020411": {
            "id": "772020411",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Prime Ice Sculpting?",
            "nextDialogs": [
              "772020412"
            ]
          },
          "772020412": {
            "id": "772020412",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "That's right! *cough* I was headed to the House of Hesperides. Its owner is the Duchess of the Snegovik, one exceedingly skilled at this art...",
            "nextDialogs": [
              "772020413"
            ]
          },
          "772020413": {
            "id": "772020413",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "Many a masterpiece was created by her hand, even the snowflake at the heart of the Zapolyarny Palace plaza and the sculptures made in the likeness of crystal ores that stand before the ducal mansion of Novokitezhgrad...",
            "nextDialogs": [
              "772020414"
            ]
          },
          "772020414": {
            "id": "772020414",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "Humans cannot call upon Prime Ice as the fae do... but we can learn to use hammer and chisel to bring forth similar beauty.",
            "nextDialogs": [
              "772020415"
            ]
          },
          "772020415": {
            "id": "772020415",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "Thanks to you two, I'm one step closer to the mansion!",
            "nextDialogs": [
              "772020416"
            ]
          },
          "772020416": {
            "id": "772020416",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, you're still going up the mountain, then?",
            "nextDialogs": [
              "772020417"
            ]
          },
          "772020417": {
            "id": "772020417",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "Well, I'm here already, aren't I? It would be such a shame to turn back now...",
            "nextDialogs": [
              "772020418"
            ]
          },
          "772020418": {
            "id": "772020418",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But...",
            "nextDialogs": [
              "772020421"
            ]
          },
          "772020421": {
            "id": "772020421",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "Alright, I will.",
            "nextDialogs": [
              "772020422"
            ]
          },
          "772020422": {
            "id": "772020422",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You help him start a fire here and give him a share of your food and water.",
            "nextDialogs": [
              "772020423"
            ]
          },
          "772020423": {
            "id": "772020423",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, you've had something to eat and drink, and you're all warmed up, too. Now you're good to go!",
            "nextDialogs": [
              "772020424"
            ]
          },
          "772020424": {
            "id": "772020424",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "Th—Thank you two, truly.",
            "nextDialogs": [
              "772020425"
            ]
          },
          "772020425": {
            "id": "772020425",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "If I do indeed learn this art, I will surely, surely make you a great sculpture!"
          }
        }
      }
    },

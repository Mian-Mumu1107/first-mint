  "subQuests": [
    {
      "subId": "7720205",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772020101"
        ],
        "dialogs": {
          "772020101": {
            "id": "772020101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, there's no one in the tent, but not much snow buildup either...",
            "nextDialogs": [
              "772020102"
            ]
          },
          "772020102": {
            "id": "772020102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "How would even come here, anyway? How strange...",
            "nextDialogs": [
              "772020103"
            ]
          },
          "772020103": {
            "id": "772020103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What's this? An adventure notebook?",
            "nextDialogs": [
              "772020104"
            ]
          },
          "772020104": {
            "id": "772020104",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "\"The blizzard plastered itself to my face like a mask, almost sealing my eyes shut. I could not find the homeward way, let alone a path to the House of Hesperides...\"",
            "nextDialogs": [
              "772020105"
            ]
          },
          "772020105": {
            "id": "772020105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "\"Fortunately, I was able to find a cave to avoid the storm, but my stocks of food are bottoming out... Perhaps I should never have... No. No. This is a trial set before me. It must be.\"",
            "nextDialogs": [
              "772020106"
            ]
          },
          "772020106": {
            "id": "772020106",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "\"I must reach the mansion and meet the great lady... I must witness true Prime Ice artisanship.\"",
            "nextDialogs": [
              "772020107"
            ]
          },
          "772020107": {
            "id": "772020107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "\"But how will I get out of here? Perhaps I can continue to explore this cave first...\"",
            "nextDialogs": [
              "772020108"
            ]
          },
          "772020108": {
            "id": "772020108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "\"Hmm. I think I've gotten used to the temperature in here. Everything's starting to warm up just a little...\"",
            "nextDialogs": [
              "772020109"
            ]
          },
          "772020109": {
            "id": "772020109",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa, is this person okay? Seems like he's frozen so bad, he's starting to hallucinate.",
            "nextDialogs": [
              "772020111",
              "772020113"
            ]
          },
          "772020111": {
            "id": "772020111",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Come on, you know that feeling warm in a snowy place like this is the last thing you wanna have happen!",
            "nextDialogs": [
              "772020114"
            ]
          },
          "772020114": {
            "id": "772020114",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "According to his notes, he's proceeding through this cave... Let's go on ahead as well. Can't be sure if he can still be saved, though..."
          },
          "772020113": {
            "id": "772020113",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yeah..."
          }
        }
      }
    },
    {
      "subId": "7720201",
      "subQuestName": "Explore the cave",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7720202",
      "subQuestName": "Help the person in the icy cave",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772020201"
        ],
        "dialogs": {
          "772020201": {
            "id": "772020201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Good thing we didn't fall straight into the water...",
            "nextDialogs": [
              "772020202"
            ]
          },
          "772020202": {
            "id": "772020202",
            "speakerId": 1001,
            "speakerName": "Maltus",
            "text": "Ohh, b—be careful... This ice block's starting to move...",
            "nextDialogs": [
              "772020203"
            ]
          },
          "772020203": {
            "id": "772020203",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Don't worry, we'll get you outta here."
          }
        }
      }
    },

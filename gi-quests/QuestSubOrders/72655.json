    {
      "subId": "7265503",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726550301"
        ],
        "dialogs": {
          "726550301": {
            "id": "726550301",
            "speakerId": 1000,
            "speakerName": "Muzhen",
            "text": "Hmm? Do you need to warm up or anything?",
            "nextDialogs": [
              "726550304"
            ]
          },
          "726550304": {
            "id": "726550304",
            "speakerId": 1000,
            "speakerName": "Muzhen",
            "text": "Well, I'm a Technical Officer, so I don't know much about world history, I'm afraid.",
            "nextDialogs": [
              "726550305"
            ]
          },
          "726550305": {
            "id": "726550305",
            "speakerId": 1000,
            "speakerName": "Muzhen",
            "text": "Nonetheless, I believe these ruins to be related to the great disaster that occurred five hundred years ago...",
            "nextDialogs": [
              "726550306"
            ]
          },
          "726550306": {
            "id": "726550306",
            "speakerId": 1000,
            "speakerName": "Muzhen",
            "text": "I grew up listening to old sailors tell that tale, you know? They said that neither land nor sea could escape the reach of the Abyss...",
            "nextDialogs": [
              "726550307"
            ]
          },
          "726550307": {
            "id": "726550307",
            "speakerId": 1000,
            "speakerName": "Muzhen",
            "text": "But to me, those were no different from the ghost stories they tell to scare children.",
            "nextDialogs": [
              "726550308"
            ]
          },
          "726550308": {
            "id": "726550308",
            "speakerId": 1000,
            "speakerName": "Muzhen",
            "text": "I mean, only the terrors you can see are true, after all!"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7265501",
      "subQuestName": "Talk to Muzhen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726550101"
        ],
        "dialogs": {
          "726550101": {
            "id": "726550101",
            "speakerId": 1000,
            "speakerName": "Muzhen",
            "text": "Well, looks like we've finally located our target! Great! Guess I can go back to the ship and get some sleep!",
            "nextDialogs": [
              "726550102"
            ]
          },
          "726550102": {
            "id": "726550102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What? You're gonna leave just like that?",
            "nextDialogs": [
              "726550103"
            ]
          },
          "726550103": {
            "id": "726550103",
            "speakerId": 1000,
            "speakerName": "Muzhen",
            "text": "Of course not, we're so close! Let's head out right now and capture ourselves a Ruin machine!",
            "nextDialogs": [
              "726550104"
            ]
          },
          "726550104": {
            "id": "726550104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh, and here Paimon thought you were going to return to the ship!",
            "nextDialogs": [
              "726550105"
            ]
          },
          "726550105": {
            "id": "726550105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "*sigh* Well, never mind. Let's follow her!"
          }
        }
      }
    },
    {
      "subId": "7265502",
      "subQuestName": "Go to the ruins",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726550201"
        ],
        "dialogs": {
          "726550201": {
            "id": "726550201",
            "speakerId": 1000,
            "speakerName": "Muzhen",
            "text": "Haha, this is the place!",
            "nextDialogs": [
              "726550202"
            ]
          },
          "726550202": {
            "id": "726550202",
            "speakerId": 1000,
            "speakerName": "Muzhen",
            "text": "To think that there would be underground ruins here too... *gulp*",
            "nextDialogs": [
              "726550205"
            ]
          },
          "726550205": {
            "id": "726550205",
            "speakerId": 1000,
            "speakerName": "Muzhen",
            "text": "N—Nothing, it's nothing.",
            "nextDialogs": [
              "726550206"
            ]
          },
          "726550206": {
            "id": "726550206",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You don't look so good. Are you unwell?",
            "nextDialogs": [
              "726550207"
            ]
          },
          "726550207": {
            "id": "726550207",
            "speakerId": 1000,
            "speakerName": "Muzhen",
            "text": "Haha. I just don't normally get off the boat, so this ruin entrance is... well, quite a sight.",
            "nextDialogs": [
              "726550208"
            ]
          },
          "726550208": {
            "id": "726550208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Really? Paimon doesn't think so.",
            "nextDialogs": [
              "726550209"
            ]
          },
          "726550209": {
            "id": "726550209",
            "speakerId": 1000,
            "speakerName": "Muzhen",
            "text": "S—Still, the Captain's order still needs completing. I'm sure you're really curious as to what treasures lie within as well, aren't you, Traveler?",
            "nextDialogs": [
              "726550210"
            ]
          },
          "726550210": {
            "id": "726550210",
            "speakerId": 1000,
            "speakerName": "Muzhen",
            "text": "So, could I invite you, experienced and skilled as you are, to take the lead?",
            "nextDialogs": [
              "726550211"
            ]
          },
          "726550211": {
            "id": "726550211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're hopeless...",
            "nextDialogs": [
              "726550212"
            ]
          },
          "726550212": {
            "id": "726550212",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That she is! Come on, Traveler, lets go!"
          }
        }
      }
    },
    {
      "subId": "7265503",

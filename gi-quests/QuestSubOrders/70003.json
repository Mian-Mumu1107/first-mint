  "subQuests": [
    {
      "subId": "7000301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700030101"
        ],
        "dialogs": {
          "700030101": {
            "id": "700030101",
            "speakerId": 1000,
            "speakerName": "Aramis",
            "text": "Oh, what am I to do...",
            "nextDialogs": [
              "700030102"
            ]
          },
          "700030102": {
            "id": "700030102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you need help with anything?",
            "nextDialogs": [
              "700030103"
            ]
          },
          "700030103": {
            "id": "700030103",
            "speakerId": 1000,
            "speakerName": "Aramis",
            "text": "Whenever the Windblume Festival rolls along, people will always offer up all manner of flowers to the Archon statue. Then a gust of wind comes, and off they go, flying every which way.",
            "nextDialogs": [
              "700030104"
            ]
          },
          "700030104": {
            "id": "700030104",
            "speakerId": 1000,
            "speakerName": "Aramis",
            "text": "We've had to spend no small amount of effort to clear these withered flowers out. But while I can handle the flowers and leaves in the plaza itself, there's not much I can do about the ones that get onto roofs and the city walls.",
            "nextDialogs": [
              "700030105"
            ]
          },
          "700030105": {
            "id": "700030105",
            "speakerId": 1000,
            "speakerName": "Aramis",
            "text": "Definitely not with these knees of mine. They really aren't holding up well...",
            "nextDialogs": [
              "700030106"
            ]
          },
          "700030106": {
            "id": "700030106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll lend you a hand.",
            "nextDialogs": [
              "700030107"
            ]
          },
          "700030107": {
            "id": "700030107",
            "speakerId": 1000,
            "speakerName": "Aramis",
            "text": "You would? Oh, that's wonderful. Those withered flowers are pretty obvious. You should be able to see them the moment you get on top of a roof."
          }
        }
      }
    },
    {
      "subId": "7000302",
      "subQuestName": "Talk to Aramis",
      "sceneId": null,
      "locations": [],
      "dialogue": {

      }
    },
    {
      "subId": "7000303",
      "subQuestName": "Clear the piles of floral debris off the rooftop",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700030301"
        ],
        "dialogs": {
          "700030301": {
            "id": "700030301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa, there really are heaps of withered flowers. Quickly, let's clear these piles out."
          }
        }
      }
    },
    {
      "subId": "7000304",
      "subQuestName": "Clear the piles of floral debris off the rooftop",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700030401"
        ],
        "dialogs": {
          "700030401": {
            "id": "700030401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? What's that sound? Sounds like a cat...",
            "nextDialogs": [
              "700030402"
            ]
          },
          "700030402": {
            "id": "700030402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm, where is it... Let's keep an eye out while we're cleaning up."
          }
        }
      }
    },
    {
      "subId": "7000305",
      "subQuestName": "Clear the piles of floral debris off the city walls",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700030501"
        ],
        "dialogs": {
          "700030501": {
            "id": "700030501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh, guess there really was a cat. Wonder why it's over here...",
            "nextDialogs": [
              "700030502"
            ]
          },
          "700030502": {
            "id": "700030502",
            "speakerId": 1002,
            "speakerName": "Lost Cat",
            "text": "Meow... Meeeow...",
            "nextDialogs": [
              "700030505"
            ]
          },
          "700030505": {
            "id": "700030505",
            "speakerId": 1002,
            "speakerName": "Lost Cat",
            "text": "Meow-meow!",
            "nextDialogs": [
              "700030506"
            ]
          },
          "700030506": {
            "id": "700030506",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um, hate to break it to you, but Paimon doesn't think it understands a thing you just said...",
            "nextDialogs": [
              "700030507"
            ]
          },
          "700030507": {
            "id": "700030507",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's get it down from here first. Maybe Aramis knows who it belongs to."
          }
        }
      }
    },
    {
      "subId": "7000306",
      "subQuestName": "Search for the kitty",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700030601"
        ],
        "dialogs": {
          "700030601": {
            "id": "700030601",
            "speakerId": 1000,
            "speakerName": "Aramis",
            "text": "I'm sorry, I don't think I've seen it. If I did, I'm sure I would have had some impression.",
            "nextDialogs": [
              "700030602"
            ]
          },
          "700030602": {
            "id": "700030602",
            "speakerId": 1003,
            "speakerName": "Margaret",
            "text": "Oh, I see... That little darling really loves flowers. I thought that she might have chased them here.",
            "nextDialogs": [
              "700030603"
            ]
          },
          "700030603": {
            "id": "700030603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Someone looking for a cat?",
            "nextDialogs": [
              "700030604"
            ]
          },
          "700030604": {
            "id": "700030604",
            "speakerId": 1002,
            "speakerName": "Lost Cat",
            "text": "Meow... Meow!",
            "nextDialogs": [
              "700030605"
            ]
          },
          "700030605": {
            "id": "700030605",
            "speakerId": 1003,
            "speakerName": "Margaret",
            "text": "Is that... Butterfly? Oh, it really is you! Where have you been?",
            "nextDialogs": [
              "700030606"
            ]
          },
          "700030606": {
            "id": "700030606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "On the city walls.",
            "nextDialogs": [
              "700030607"
            ]
          },
          "700030607": {
            "id": "700030607",
            "speakerId": 1003,
            "speakerName": "Margaret",
            "text": "So it's just as I thought, then... Thank you so much. Butterfly here loves to chase flowers. She's been a real headache during this time, what with there being flowers all over the city and all.",
            "nextDialogs": [
              "700030608"
            ]
          },
          "700030608": {
            "id": "700030608",
            "speakerId": 1003,
            "speakerName": "Margaret",
            "text": "Thank you once again — your next drink's on me the next time you visit The Cat's Tail. Well, the non-alcoholic ones, at least.",
            "nextDialogs": [
              "700030611"
            ]
          },
          "700030611": {
            "id": "700030611",
            "speakerId": 1003,
            "speakerName": "Margaret",
            "text": "Haha... Once again, thank you. See you around, and happy Windblume Festival.",
            "nextDialogs": [
              "700030612"
            ]
          },
          "700030612": {
            "id": "700030612",
            "speakerId": 1000,
            "speakerName": "Aramis",
            "text": "Well, I never — so cats are attracted to the flowers too. What a busy festival... Still, it's good that you found that cat.",
            "nextDialogs": [
              "700030613"
            ]
          },
          "700030613": {
            "id": "700030613",
            "speakerId": 1000,
            "speakerName": "Aramis",
            "text": "If you'd asked me to climb up there to rescue it, I'm afraid my knees would have given up the ghost...",
            "nextDialogs": [
              "700030614"
            ]
          },
          "700030614": {
            "id": "700030614",
            "speakerId": 1000,
            "speakerName": "Aramis",
            "text": "Well then, thank you for your trouble. Here's a little something for your work."
          }
        }
      }
    },
    {
      "subId": "7000308",

      "subId": "7000302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700030201"
        ],
        "dialogs": {
          "700030201": {
            "id": "700030201",
            "speakerId": 1000,
            "speakerName": "Aramis",
            "text": "*sigh* More steps here, and a couple of roofs there, up and down, up and down... I don't know how long my knees will last at this rate..."
          }
        }
      }
    }
  ]

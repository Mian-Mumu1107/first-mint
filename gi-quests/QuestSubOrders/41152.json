    {
      "subId": "4115203",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411520301"
        ],
        "dialogs": {
          "411520301": {
            "id": "411520301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I heard that someone placed a custom order...",
            "nextDialogs": [
              "411520302"
            ]
          },
          "411520302": {
            "id": "411520302",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Well, here's what happened. Silio ordered a serving of Mondstadt Hash Brown, and said that he'd like it delivered around this time.",
            "nextDialogs": [
              "411520303"
            ]
          },
          "411520303": {
            "id": "411520303",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "This hash brown is particularly fragile. If you shake it too much, it might fall apart. <color=#00E1FFFF>Please deliver it in time</color> so that it can maintain its crumbly mouthfeel.",
            "nextDialogs": [
              "411520304"
            ]
          },
          "411520304": {
            "id": "411520304",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "If something happens to you out there, please bring that serving back, and I'll prepare a new one for you."
          }
        }
      }
    },
    {

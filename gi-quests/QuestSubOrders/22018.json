    {
      "subId": "2201814",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220181401"
        ],
        "dialogs": {
          "220181401": {
            "id": "220181401",
            "speakerId": 3015,
            "speakerName": "Shimura Kanbei",
            "text": "Darn it... Who on earth would have done this...",
            "nextDialogs": [
              "220181402"
            ]
          },
          "220181402": {
            "id": "220181402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you Shimura Kanbei?",
            "nextDialogs": [
              "220181403"
            ]
          },
          "220181403": {
            "id": "220181403",
            "speakerId": 3015,
            "speakerName": "Shimura Kanbei",
            "text": "Ah, yes, I am, and you are... Oh! If it isn't Ryuuji!",
            "nextDialogs": [
              "220181404"
            ]
          },
          "220181404": {
            "id": "220181404",
            "speakerId": 3015,
            "speakerName": "Shimura Kanbei",
            "text": "Has Miss Sango found out who that rascal is? Why, I'm going to whoop...",
            "nextDialogs": [
              "220181405"
            ]
          },
          "220181405": {
            "id": "220181405",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "She has not found the culprit yet.",
            "nextDialogs": [
              "220181406"
            ]
          },
          "220181406": {
            "id": "220181406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, about the theft...",
            "nextDialogs": [
              "220181407"
            ]
          },
          "220181407": {
            "id": "220181407",
            "speakerId": 3015,
            "speakerName": "Shimura Kanbei",
            "text": "I've told Miss Sango everything that I know. I drank too much and fell asleep straight away.",
            "nextDialogs": [
              "220181408"
            ]
          },
          "220181408": {
            "id": "220181408",
            "speakerId": 3015,
            "speakerName": "Shimura Kanbei",
            "text": "When I woke up, all the Mora in the store was gone!",
            "nextDialogs": [
              "220181409"
            ]
          },
          "220181409": {
            "id": "220181409",
            "speakerId": 3015,
            "speakerName": "Shimura Kanbei",
            "text": "Curses... Who would do such a thing..."
          }
        }
      }
    },
    {
      "subId": "2201815",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220181501"
        ],
        "dialogs": {
          "220181501": {
            "id": "220181501",
            "speakerId": 12108,
            "speakerName": "Ishikawa Hachirou",
            "text": "Have you seen my... Vision...",
            "nextDialogs": [
              "220181502"
            ]
          },
          "220181502": {
            "id": "220181502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You had a Vision?",
            "nextDialogs": [
              "220181503"
            ]
          },
          "220181503": {
            "id": "220181503",
            "speakerId": 12108,
            "speakerName": "Ishikawa Hachirou",
            "text": "I did... I did... It was right here... Where did it go...",
            "nextDialogs": [
              "220181504"
            ]
          },
          "220181504": {
            "id": "220181504",
            "speakerId": 12108,
            "speakerName": "Ishikawa Hachirou",
            "text": "Where did it go... Wah...",
            "nextDialogs": [
              "220181505"
            ]
          },
          "220181505": {
            "id": "220181505",
            "speakerId": 12108,
            "speakerName": "Ishikawa Hachirou",
            "text": "...Sorry, brother... I lost my Vision too... Wah..."
          }
        }
      }
    },
    {
      "subId": "2201816",
      "subQuestName": "Additional",
      "sceneId": null,

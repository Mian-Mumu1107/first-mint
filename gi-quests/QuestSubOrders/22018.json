          },
          "220182106": {
            "id": "220182106",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "Ask Katheryne if you doubt my alibi.",
            "nextDialogs": [
              "220182107"
            ]
          },
          "220182107": {
            "id": "220182107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you seen anyone around who seems suspicious?",
            "nextDialogs": [
              "220182108"
            ]
          },
          "220182108": {
            "id": "220182108",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "Anyone suspicious?",
            "nextDialogs": [
              "220182109"
            ]
          },
          "220182109": {
            "id": "220182109",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "No, sorry, I haven't seen anyone like that.",
            "nextDialogs": [
              "220182110"
            ]
          },
          "220182110": {
            "id": "220182110",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "All my attention has been on my work. It's been exceptionally busy recently."
          }
        }
      }
    }
  ]

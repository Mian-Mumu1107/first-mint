      "dialogue": {
        "startDialogs": [
          "220180901"
        ],
        "dialogs": {
          "220180901": {
            "id": "220180901",
            "speakerId": 3001,
            "speakerName": "Yayoi Nanatsuki",
            "text": "Sorry, I didn't see anything... In fact, I didn't know about it until I was woken up by the sound of Mr. Kanbei's roaring..."
          }
        }
      }
    },
    {
      "subId": "2201810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220181001"
        ],
        "dialogs": {
          "220181001": {
            "id": "220181001",
            "speakerId": 3001,
            "speakerName": "Yayoi Nanatsuki",
            "text": "Hello... How may I help you?",
            "nextDialogs": [
              "220181002"
            ]
          },
          "220181002": {
            "id": "220181002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the theft at Shimura's...",
            "nextDialogs": [
              "220181003"
            ]
          },
          "220181003": {
            "id": "220181003",
            "speakerId": 3001,
            "speakerName": "Yayoi Nanatsuki",
            "text": "Well, I sure did hear about it. It was hard not to hear Mr. Kanbei's angry voice...",
            "nextDialogs": [
              "220181004"
            ]
          },
          "220181004": {
            "id": "220181004",
            "speakerId": 3001,
            "speakerName": "Yayoi Nanatsuki",
            "text": "Wait. Are you asking if I saw anything?",
            "nextDialogs": [
              "220181005"
            ]
          },
          "220181005": {
            "id": "220181005",
            "speakerId": 3001,
            "speakerName": "Yayoi Nanatsuki",
            "text": "Sorry, I didn't see anything... In fact, I didn't know about it until I was woken up by the sound of Mr. Kanbei's roaring...",
            "nextDialogs": [
              "220181006"
            ]
          },
          "220181006": {
            "id": "220181006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you seen anyone around who seems suspicious?",
            "nextDialogs": [
              "220181007"
            ]
          },
          "220181007": {
            "id": "220181007",
            "speakerId": 3001,
            "speakerName": "Yayoi Nanatsuki",
            "text": "Suspicious people? Well... I didn't see anyone suspicious.",
            "nextDialogs": [
              "220181008"
            ]
          },
          "220181008": {
            "id": "220181008",
            "speakerId": 3001,
            "speakerName": "Yayoi Nanatsuki",
            "text": "Not to mention how the atmosphere in the city is really tense right now. If there was anyone suspicious, they would probably have been taken away by the Doushin for questioning by now..."
          }
        }
      }
    },
    {
      "subId": "2201811",

        ],
        "dialogs": {
          "220182001": {
            "id": "220182001",
            "speakerId": 12108,
            "speakerName": "Ishikawa Hachirou",
            "text": "The Vision Hunt Decree is over... I... This...",
            "nextDialogs": [
              "220182002"
            ]
          },
          "220182002": {
            "id": "220182002",
            "speakerId": 12108,
            "speakerName": "Ishikawa Hachirou",
            "text": "H—How did it all end so quickly...",
            "nextDialogs": [
              "220182003"
            ]
          },
          "220182003": {
            "id": "220182003",
            "speakerId": 12108,
            "speakerName": "Ishikawa Hachirou",
            "text": "No, I have to find some other way..."
          }
        }
      }
    },

    {
      "subId": "2201817",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220181701"
        ],
        "dialogs": {
          "220181701": {
            "id": "220181701",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "Hmm? May I help you with something?",
            "nextDialogs": [
              "220181702"
            ]
          },
          "220181702": {
            "id": "220181702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the theft at Shimura's...",
            "nextDialogs": [
              "220181703"
            ]
          },
          "220181703": {
            "id": "220181703",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "That? I heard about it.",
            "nextDialogs": [
              "220181704"
            ]
          },
          "220181704": {
            "id": "220181704",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "If you're looking for a witness, I'm sorry, I don't have any information of value.",
            "nextDialogs": [
              "220181705"
            ]
          },
          "220181705": {
            "id": "220181705",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "I was busy working at the Adventurers' Guild at the time when the theft occurred.",
            "nextDialogs": [
              "220181706"
            ]
          },
          "220181706": {
            "id": "220181706",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "If you need proof that I was on Guild premises at the time, you can ask Katheryne.",
            "nextDialogs": [
              "220181707"
            ]
          },
          "220181707": {
            "id": "220181707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you seen anyone around who seems suspicious?",
            "nextDialogs": [
              "220181708"
            ]
          },
          "220181708": {
            "id": "220181708",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "Suspicious?",
            "nextDialogs": [
              "220181709"
            ]
          },
          "220181709": {
            "id": "220181709",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "To be honest, it's a bit hard for me to tell.",
            "nextDialogs": [
              "220181710"
            ]
          },
          "220181710": {
            "id": "220181710",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "If you take the Vision Hunt Decree into account... there's just far too many people whose actions might be interpreted as \"suspicious.\""
          }
        }
      }
    },
    {
      "subId": "2201818",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

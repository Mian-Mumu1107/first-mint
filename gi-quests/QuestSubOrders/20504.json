  "subQuests": [
    {
      "subId": "2050401",
      "subQuestName": "Talk to the shop owner, Marjorie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205040101"
        ],
        "dialogs": {
          "205040101": {
            "id": "205040101",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "Welcome. Every treasure here is unique, guaranteed.",
            "nextDialogs": [
              "205040102"
            ]
          },
          "205040102": {
            "id": "205040102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe... Yep, there's nothing here that Paimon recognizes, that's for sure.",
            "nextDialogs": [
              "205040103"
            ]
          },
          "205040103": {
            "id": "205040103",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "Haha, what did I tell you! These are all rare items brought back by adventurers from all corners of the world.",
            "nextDialogs": [
              "205040104"
            ]
          },
          "205040104": {
            "id": "205040104",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "Is there anything that catches your eye?",
            "nextDialogs": [
              "205040107"
            ]
          },
          "205040107": {
            "id": "205040107",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "No need! I forgot to mention, I operate on a trading basis. Goods for goods — no Mora accepted here.",
            "nextDialogs": [
              "205040108"
            ]
          },
          "205040108": {
            "id": "205040108",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "I've been trying to make something a bit special recently, and I need a lot of <color=#00E1FFFF>Anemo Sigils</color> to decorate it with.",
            "nextDialogs": [
              "205040109"
            ]
          },
          "205040109": {
            "id": "205040109",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "Do you have any <color=#00E1FFFF>Anemo Sigils</color> with you?"
          }
        }
      }
    },
    {
      "subId": "2050402",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205040201"
        ],
        "dialogs": {
          "205040201": {
            "id": "205040201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look! Doesn't that shop look interesting?"
          }
        }
      }
    },
    {
      "subId": "2050403",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205040301"
        ],
        "dialogs": {
          "205040301": {
            "id": "205040301",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "<color=#00E1FFFF>Anemo Sigils</color> appear all over Mondstadt. If you find yourself short, just keep exploring.",
            "nextDialogs": [
              "205040302"
            ]
          },
          "205040302": {
            "id": "205040302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are they really just for decoration?",
            "nextDialogs": [
              "205040303"
            ]
          },
          "205040303": {
            "id": "205040303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Absolutely! What could be more beautiful than a gift from the Anemo Archon?",
            "nextDialogs": [
              "205040304"
            ]
          },
          "205040304": {
            "id": "205040304",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "Haha, okay, you got me.",
            "nextDialogs": [
              "205040305"
            ]
          },
          "205040305": {
            "id": "205040305",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "It's actually more complicated than that, but it's easier for people to understand if I just say it's for decoration.",
            "nextDialogs": [
              "205040306"
            ]
          },
          "205040306": {
            "id": "205040306",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "Obviously the reason I need <color=#00E1FFFF>Anemo Sigils</color> is because they have properties that other materials cannot provide.",
            "nextDialogs": [
              "205040308",
              "205040310"
            ]
          },
          "205040308": {
            "id": "205040308",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "Haha, of course! I guarantee you will be quite surprised at the result.",
            "nextDialogs": [
              "205040312"
            ]
          },
          "205040312": {
            "id": "205040312",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "Do come again soon — and bring me lots and lots of <color=#00E1FFFF>Anemo Sigils</color> next time!",
            "nextDialogs": [
              "205040313"
            ]
          },
          "205040313": {
            "id": "205040313",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "Please also visit if you come across any weird and wonderful treasures on your adventures!"
          },
          "205040310": {
            "id": "205040310",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But it's working... Paimon's curious now!",
            "nextDialogs": [
              "205040311"
            ]
          },
          "205040311": {
            "id": "205040311",
            "speakerId": 10005,
            "speakerName": "Marjorie",
            "text": "Haha! Well it wouldn't be much of a surprise if I gave everything away, now would it?"
          }
        }
      }
    }
  ]
}
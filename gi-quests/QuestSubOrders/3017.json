  "subQuests": [
    {
      "subId": "301701",
      "subQuestName": "Go to Gandharva Ville",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30170101"
        ],
        "dialogs": {
          "30170101": {
            "id": "30170101",
            "speakerId": 12697,
            "speakerName": "Tashfin",
            "text": "Hold it right there.",
            "nextDialogs": [
              "30170102"
            ]
          },
          "30170102": {
            "id": "30170102",
            "speakerId": 12697,
            "speakerName": "Tashfin",
            "text": "#A {M#blond}{F#blonde}-haired traveler and a floating fairy... We've got you, alright. Take a look around — you've fallen right into our trap.",
            "nextDialogs": [
              "30170103"
            ]
          },
          "30170103": {
            "id": "30170103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah! Are you mercenaries from the Corps of Thirty? Did you come here to arrest us?",
            "nextDialogs": [
              "30170104"
            ]
          },
          "30170104": {
            "id": "30170104",
            "speakerId": 12697,
            "speakerName": "Tashfin",
            "text": "Corps of Thirty? We're nothing like those government lapdogs who don't even get scraps for their work.",
            "nextDialogs": [
              "30170105"
            ]
          },
          "30170105": {
            "id": "30170105",
            "speakerId": 12697,
            "speakerName": "Tashfin",
            "text": "We are an elite brigade that commands the highest commission rate in all of Sumeru. We're here on the orders of a client known only as \"The Outcast.\"",
            "nextDialogs": [
              "30170106"
            ]
          },
          "30170106": {
            "id": "30170106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"The Outcast\"... An outcast from the Akademiya?",
            "nextDialogs": [
              "30170107"
            ]
          },
          "30170107": {
            "id": "30170107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sounds like The Doctor.",
            "nextDialogs": [
              "30170108"
            ]
          },
          "30170108": {
            "id": "30170108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But why wouldn't The Doctor just send the Fatui after us?",
            "nextDialogs": [
              "30170111"
            ]
          },
          "30170111": {
            "id": "30170111",
            "speakerId": 12697,
            "speakerName": "Tashfin",
            "text": "Hmph, still wasting time on idle chit-chat? We'll shut you up soon enough. Get them!",
            "nextDialogs": [
              "30170112"
            ]
          },
          "30170112": {
            "id": "30170112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#You're up, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "301702",
      "subQuestName": "Defeat the ambushing Eremites",
      "sceneId": null,
      "locations": [],

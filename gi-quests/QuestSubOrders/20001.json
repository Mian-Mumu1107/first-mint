      "dialogue": {
        "startDialogs": [
          "200011001"
        ],
        "dialogs": {
          "200011001": {
            "id": "200011001",
            "speakerId": 140301,
            "speakerName": "Quinn",
            "text": "Thank you so much, Traveler.",
            "nextDialogs": [
              "200011002"
            ]
          },
          "200011002": {
            "id": "200011002",
            "speakerId": 140301,
            "speakerName": "Quinn",
            "text": "My plan was to pick some fruit here then sell it back in the city.",
            "nextDialogs": [
              "200011003"
            ]
          },
          "200011003": {
            "id": "200011003",
            "speakerId": 140301,
            "speakerName": "Quinn",
            "text": "I hadn't counted on being held up by a roadblock... and then set upon by that group.",
            "nextDialogs": [
              "200011004"
            ]
          },
          "200011004": {
            "id": "200011004",
            "speakerId": 140301,
            "speakerName": "Quinn",
            "text": "Okay, I'm going back to Mondstadt. Do stop by the shop if you're ever in town!",
            "nextDialogs": [
              "200011005"
            ]
          },
          "200011005": {
            "id": "200011005",
            "speakerId": 140301,
            "speakerName": "Quinn",
            "text": "Take these as a token of my gratitude. See how fresh they are? That's why Beatrice is always trying to buy them from me."
          }
        }
      }
    },
    {
      "subId": "2000109",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200010901"
        ],
        "dialogs": {
          "200010901": {
            "id": "200010901",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Thanks for getting rid of them, Traveler.",
            "nextDialogs": [
              "200010902"
            ]
          },
          "200010902": {
            "id": "200010902",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Thank goodness you came. *sigh* But I'm stuck here while this roadblock continues.",
            "nextDialogs": [
              "200010903"
            ]
          },
          "200010903": {
            "id": "200010903",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "If this keeps up much longer, all this fruit is going to go bad... after I spent so long gathering it, too.",
            "nextDialogs": [
              "200010904"
            ]
          },
          "200010904": {
            "id": "200010904",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Can you get rid of the roadblock for me?",
            "nextDialogs": [
              "200010907",
              "200010908"
            ]
          },
          "200010907": {
            "id": "200010907",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Wonderful. I can't thank you enough!"
          },
          "200010908": {
            "id": "200010908",
            "speakerId": 1403,
            "speakerName": "Quinn",
            "text": "Oh... Really? I figured if you help someone out, you see it through all the way... Anyway, you're the only hope I've got."
          }
        }
      }
    }

        "dialogs": {
          "749410101": {
            "id": "749410101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You know how to repair meka?",
            "nextDialogs": [
              "749410102"
            ]
          },
          "749410102": {
            "id": "749410102",
            "speakerId": 5211,
            "speakerName": "Denichere",
            "text": "I used to work in a project team that built meka, but the project leads kept changing.",
            "nextDialogs": [
              "749410103"
            ]
          },
          "749410103": {
            "id": "749410103",
            "speakerId": 5211,
            "speakerName": "Denichere",
            "text": "And every new lead would redo all the work from the beginning.",
            "nextDialogs": [
              "749410104"
            ]
          },
          "749410104": {
            "id": "749410104",
            "speakerId": 5211,
            "speakerName": "Denichere",
            "text": "I just couldn't stand it, so I spoke to Heinry and eventually transferred to his Fonta project team.",
            "nextDialogs": [
              "749410105"
            ]
          },
          "749410105": {
            "id": "749410105",
            "speakerId": 5211,
            "speakerName": "Denichere",
            "text": "Though I never thought I'd have to fix them again after all this time...",
            "nextDialogs": [
              "749410106"
            ]
          },
          "749410106": {
            "id": "749410106",
            "speakerId": 5211,
            "speakerName": "Denichere",
            "text": "Oh, I brought some extra parts that I'm not going to use. Take them, maybe they'll come in handy."
          }
        }
      }
    }
  ]

{
  "lineCounts": {
    "Komakata": 19,
    "Player": 5
  },
  "subQuests": [
    {
      "subId": "7265601",
      "subQuestName": "Talk to Komakata",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726560101"
        ],
        "dialogs": {
          "726560101": {
            "id": "726560101",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "Come, try your hand at Theater Mechanicus!",
            "nextDialogs": [
              "726560103",
              "726560107"
            ]
          },
          "726560103": {
            "id": "726560103",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "W—Welcome! I am a local representative for this new game from Liyue. It's called Theater Mechanicus!",
            "nextDialogs": [
              "726560104"
            ]
          },
          "726560104": {
            "id": "726560104",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "In short, it is a game that can be played on a board. It was first invented by Ms. Ruijin from Liyue.",
            "nextDialogs": [
              "726560105"
            ]
          },
          "726560105": {
            "id": "726560105",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "Well, according to Ms. Ruijin, I am one of their overseas agents.",
            "nextDialogs": [
              "726560111"
            ]
          },
          "726560111": {
            "id": "726560111",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "After I obtained... umm... the distribution rights, Ms. Ruijin sent me a complete set of Theater Mechanicus and the business model that goes with it.",
            "nextDialogs": [
              "726560112"
            ]
          },
          "726560112": {
            "id": "726560112",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "Although it initially got confiscated by the Outlander Affairs Agency... It took me a while to get this copy of the game back.",
            "nextDialogs": [
              "726560113"
            ]
          },
          "726560113": {
            "id": "726560113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why did the Outlander Affairs Agency confiscate this...",
            "nextDialogs": [
              "726560114"
            ]
          },
          "726560114": {
            "id": "726560114",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "They'll confiscate anything from overseas...",
            "nextDialogs": [
              "726560115"
            ]
          },
          "726560115": {
            "id": "726560115",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "Anyway. Let's not talk about this.",
            "nextDialogs": [
              "726560116"
            ]
          },
          "726560116": {
            "id": "726560116",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "Do you see these things laid out on the table here? These are all important items used in Theater Mechanicus.",
            "nextDialogs": [
              "726560117"
            ]
          },
          "726560117": {
            "id": "726560117",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "Does it feel like Liyue? Hahaha, this version was tailor-made according to the descriptions in Ms. Ruijin's letter.",
            "nextDialogs": [
              "726560118"
            ]
          },
          "726560118": {
            "id": "726560118",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "I even had someone make this table... It cost me a fortune.",
            "nextDialogs": [
              "726560119"
            ]
          },
          "726560119": {
            "id": "726560119",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "And per Ms. Ruijin's suggestions, I added new features to Theater Mechanicus.",
            "nextDialogs": [
              "726560120"
            ]
          },
          "726560120": {
            "id": "726560120",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "Well... Anyway, it's better to learn through practice. Why don't you just give it a go? You'll understand after you play it."
          },
          "726560107": {
            "id": "726560107",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "Welcome... Huh? So you know Theater Mechanicus?",
            "nextDialogs": [
              "726560108"
            ]
          },
          "726560108": {
            "id": "726560108",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "Ah... I see. You must've played it in Liyue before.",
            "nextDialogs": [
              "726560109"
            ]
          },
          "726560109": {
            "id": "726560109",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "Ms. Ruijin told me that she promoted the game during the Lantern Rite... So it did work after all.",
            "nextDialogs": [
              "726560110"
            ]
          },
          "726560110": {
            "id": "726560110",
            "speakerId": 1000,
            "speakerName": "Komakata",
            "text": "Well, according to Ms. Ruijin, I'm a local representative of Theater Mechanicus in Inazuma."
          }
        }
      }
    },
    {
      "subId": "7265602",
      "subQuestName": "Try Theater Mechanicus",
      "sceneId": null,

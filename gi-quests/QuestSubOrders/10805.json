        "dialogs": {
          "698140101": {
            "id": "698140101",
            "speakerId": 1000,
            "speakerName": "Diona",
            "text": "Pew-Pew~!",
            "nextDialogs": [
              "698140104"
            ]
          },
          "698140104": {
            "id": "698140104",
            "speakerId": 1000,
            "speakerName": "Diona",
            "text": "Hmph. Hunters of the Kätzlein bloodline return successful even when they go solo.",
            "nextDialogs": [
              "698140105"
            ]
          },
          "698140105": {
            "id": "698140105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wouldn't shouting \"Pew-Pew\" scare the animals off?",
            "nextDialogs": [
              "698140106"
            ]
          },
          "698140106": {
            "id": "698140106",
            "speakerId": 1000,
            "speakerName": "Diona",
            "text": "N—No way! Can't you see that my arrows fly faster than the sound of my voice?",
            "nextDialogs": [
              "698140107"
            ]
          },
          "698140107": {
            "id": "698140107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ah, so the \"pew-pew\" is for a cutesy, dramatic effect...",
            "nextDialogs": [
              "698140108"
            ]
          },
          "698140108": {
            "id": "698140108",
            "speakerId": 1000,
            "speakerName": "Diona",
            "text": "Hey, cut that out! I can hear you, you know! Don't underestimate Kätzlein ears!",
            "nextDialogs": [
              "698140109"
            ]
          },
          "698140109": {
            "id": "698140109",
            "speakerId": 1000,
            "speakerName": "Diona",
            "text": "Hmph. Whatever, I'm not going to argue with you. Here, have some meat. I caught more than I need, and I'd have shared it with everyone anyway if I brought it back."
          }
        }
      }
    }
  ]

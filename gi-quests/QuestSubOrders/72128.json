            "id": "721280801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I want to open a chest.",
            "nextDialogs": [
              "721280802"
            ]
          },
          "721280802": {
            "id": "721280802",
            "speakerId": 1000,
            "speakerName": "Takashi",

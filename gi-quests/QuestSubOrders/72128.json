    },
    {
      "subId": "7212809",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721280102"
        ],
        "dialogs": {
          "721280102": {
            "id": "721280102",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "Whoa there, wait a second. You can't just open these chests as you please.",
            "nextDialogs": [
              "721280104"
            ]
          },
          "721280104": {
            "id": "721280104",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "Of course. I placed them here specially.",
            "nextDialogs": [
              "721280106"
            ]
          },
          "721280106": {
            "id": "721280106",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "They're filled with all kinds of treasures, carefully gathered by me.",
            "nextDialogs": [
              "721280107"
            ]
          },
          "721280107": {
            "id": "721280107",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "If you want to open them, that can be arranged... However, first, you have to give me something in exchange."
          }
        }
      }
    },
    {
      "subId": "7212810",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721280201"
        ],
        "dialogs": {
          "721280201": {
            "id": "721280201",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "Hmm? Are you a traveler? Haha, you've come at a good time. I have some good news for you.",
            "nextDialogs": [
              "721280202"
            ]
          },
          "721280202": {
            "id": "721280202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Does it involve these treasure chests?",
            "nextDialogs": [
              "721280203"
            ]
          },
          "721280203": {
            "id": "721280203",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "That's right, it's the treasure chests.",
            "nextDialogs": [
              "721280204"
            ]
          },
          "721280204": {
            "id": "721280204",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "They're filled with all kinds of treasures, carefully gathered by me.",
            "nextDialogs": [
              "721280205"
            ]
          },
          "721280205": {
            "id": "721280205",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "For just a little something in return, you can open the chests and get your hands on the treasures inside.",
            "nextDialogs": [
              "721280207"
            ]
          },
          "721280207": {
            "id": "721280207",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "Hahaha, actually, I don't want any Mora.",
            "nextDialogs": [
              "721280209"
            ]
          },
          "721280209": {
            "id": "721280209",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "What I want is a kind of conch.",
            "nextDialogs": [
              "721280210"
            ]
          },
          "721280210": {
            "id": "721280210",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "You should be able to find plenty of them around the beach.",
            "nextDialogs": [
              "721280211"
            ]
          },
          "721280211": {
            "id": "721280211",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "If you want to open the treasure chests and get your hands on what's inside, bring me some of those conches in exchange.",
            "nextDialogs": [
              "721280212"
            ]
          },
          "721280212": {
            "id": "721280212",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "But... I'm not going to tell you what's inside. What treasures you end up with will come down to how lucky you are.",
            "nextDialogs": [
              "721280213"
            ]
          },
          "721280213": {
            "id": "721280213",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "What do you think? If you want to open these treasure chests, just hand me some conches."
          }
        }
      }
    },
    {
      "subId": "7212803",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721280401"
        ],
        "dialogs": {
          "721280401": {
            "id": "721280401",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "Nice one! These are just the kind of conches I wanted. Go ahead, pick a treasure chest and open it.",
            "nextDialogs": [
              "721280404"
            ]
          },
          "721280404": {
            "id": "721280404",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "Sorry, these chests are one at a time, I'm afraid.",
            "nextDialogs": [
              "721280405"
            ]
          },
          "721280405": {
            "id": "721280405",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "Okay, go ahead and take your pick. Best of luck, hehe."
          }
        }
      }
    },
    {
      "subId": "7212805",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721280501"
        ],
        "dialogs": {
          "721280501": {
            "id": "721280501",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "I take it you've opened one of the chests? Hahaha, I hope you got lucky.",
            "nextDialogs": [
              "721280502"
            ]
          },
          "721280502": {
            "id": "721280502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So you're collecting these conches?",
            "nextDialogs": [
              "721280503"
            ]
          },
          "721280503": {
            "id": "721280503",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "Bingo. Yes, I am collecting them.",
            "nextDialogs": [
              "721280504"
            ]
          },
          "721280504": {
            "id": "721280504",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "But I can't tell you why for now.",
            "nextDialogs": [
              "721280506",
              "721280510"
            ]
          },
          "721280506": {
            "id": "721280506",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "From a business point of view, there most certainly is.",
            "nextDialogs": [
              "721280507"
            ]
          },
          "721280507": {
            "id": "721280507",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "\"Conches that were once influenced by Tatarigami\"... Hahaha, they're sure to fetch a good price!",
            "nextDialogs": [
              "721280508"
            ]
          },
          "721280508": {
            "id": "721280508",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "Ahem! Anyway, you provide me with conches, I provide you with chests. Got it?",
            "nextDialogs": [
              "721280511"
            ]
          },
          "721280511": {
            "id": "721280511",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "Anyway, that's your opportunity this time around used up.",
            "nextDialogs": [
              "721280512"
            ]
          },
          "721280512": {
            "id": "721280512",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "If you want to open another treasure chest, come back with some more conches later on."
          },
          "721280510": {
            "id": "721280510",
            "speakerId": 1000,
            "speakerName": "Takashi",
            "text": "They're just conches for goodness' sake. Don't be so paranoid."
          }
        }
      }
    },

              "750910902"
            ]
          },
          "750910902": {
            "id": "750910902",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "Ah, how I long to know, how I yearn to know, my Treasure Stone..."
          }
        }
      }
    },
    {

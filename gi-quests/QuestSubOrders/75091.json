  "subQuests": [
    {
      "subId": "7509101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750910101"
        ],
        "dialogs": {
          "750910101": {
            "id": "750910101",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "One, two... Mmm, three...",
            "nextDialogs": [
              "750910102"
            ]
          },
          "750910102": {
            "id": "750910102",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "Hmm, hmm... One, two...",
            "nextDialogs": [
              "750910103"
            ]
          },
          "750910103": {
            "id": "750910103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon, sound the weirdo alarm!",
            "nextDialogs": [
              "750910104"
            ]
          },
          "750910104": {
            "id": "750910104",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "Ah, if you ask me, the only weirdos round here are you outlanders... Ho... hoho... This sure isn't the type of place you'd expect to see outlanders...",
            "nextDialogs": [
              "750910105"
            ]
          },
          "750910105": {
            "id": "750910105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is this some kind of... forbidden place? Or sacred place?",
            "nextDialogs": [
              "750910106"
            ]
          },
          "750910106": {
            "id": "750910106",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "Nope, just some place I discovered, completely by chance... a place of buried treasure. Mmm, well come on then you two, huddle up. Can you hear it? This very special rock before you... this is... the \"Treasure Stone\"...",
            "nextDialogs": [
              "750910107"
            ]
          },
          "750910107": {
            "id": "750910107",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "The low humming noise it makes rises and falls, almost like... the sound of breathing.",
            "nextDialogs": [
              "750910109",
              "750910111"
            ]
          },
          "750910109": {
            "id": "750910109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's only breathing... What's so hard about that?",
            "nextDialogs": [
              "750910112"
            ]
          },
          "750910112": {
            "id": "750910112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A rock... can breathe?",
            "nextDialogs": [
              "750910113"
            ]
          },
          "750910113": {
            "id": "750910113",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "Yes, and not only that... If you press your ear against it, you can hear a beat too... even the sound of rock grinding against rock beneath its coarse surface...",
            "nextDialogs": [
              "750910114"
            ]
          },
          "750910114": {
            "id": "750910114",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "Hehe.. Hoho... Such wonderful sounds.",
            "nextDialogs": [
              "750910115"
            ]
          },
          "750910115": {
            "id": "750910115",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "And, and... If you feed it small rocks, it'll give you even better, shinier rocks in return...",
            "nextDialogs": [
              "750910116"
            ]
          },
          "750910116": {
            "id": "750910116",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "Aaaah, simply incredible, is it not? Look at these gemstones... look! One, two...",
            "nextDialogs": [
              "750910117"
            ]
          },
          "750910117": {
            "id": "750910117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, so that's what you were doing when we came over just now, counting gems...",
            "nextDialogs": [
              "750910118"
            ]
          },
          "750910118": {
            "id": "750910118",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "Yes, and I can tell that after gobbling up all these rocks, the Treasure Stone has become even stronger, even more powerful than before...",
            "nextDialogs": [
              "750910119"
            ]
          },
          "750910119": {
            "id": "750910119",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "This must be... a miracle! Ah, my Treasure Stone... my precious..."
          },
          "750910111": {
            "id": "750910111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, what's so amazing about being able to breathe... Wait, why are we even talking about this?"
          }
        }
      }
    },
    {
      "subId": "7509102",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750910201"
        ],
        "dialogs": {
          "750910201": {
            "id": "750910201",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "Mmm... Patience, patience is the key. When things have quietened down, I'll feed these to the Treasure Stone...",
            "nextDialogs": [
              "750910202"
            ]
          },
          "750910202": {
            "id": "750910202",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "Just give it some time, hehe, and it'll produce some even better rocks... Hehe... One, two..."
          }
        }
      }
    },
    {
      "subId": "7509103",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750910301"
        ],
        "dialogs": {
          "750910301": {
            "id": "750910301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, something actually did grow out of it...",
            "nextDialogs": [
              "750910302"
            ]
          },
          "750910302": {
            "id": "750910302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "All hail the Treasure St... Wait a sec, you didn't just place those on top, did you?",
            "nextDialogs": [
              "750910303"
            ]
          },
          "750910303": {
            "id": "750910303",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "...Heh, hehe, do I look like I would do something so foolish?",
            "nextDialogs": [
              "750910304"
            ]
          },
          "750910304": {
            "id": "750910304",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "Thanks to those rocks you brought, the Treasure Stone is even more energetic than it was before. Oh, can't you hear it...?",
            "nextDialogs": [
              "750910305"
            ]
          },
          "750910305": {
            "id": "750910305",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "That sound, pulsing as the magma that flows beneath the earth, is just like... Ah, like a heartbeat...",
            "nextDialogs": [
              "750910306"
            ]
          },
          "750910306": {
            "id": "750910306",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "I knew it... I knew I just had to find some other rocks to feed it...",
            "nextDialogs": [
              "750910307"
            ]
          },
          "750910307": {
            "id": "750910307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh... Paimon's not hearing anything...",
            "nextDialogs": [
              "750910308"
            ]
          },
          "750910308": {
            "id": "750910308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Can you hear it, {NICKNAME}?",
            "nextDialogs": [
              "750910310",
              "750910312"
            ]
          },
          "750910310": {
            "id": "750910310",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right...",
            "nextDialogs": [
              "750910313"
            ]
          },
          "750910313": {
            "id": "750910313",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "Hehe, outlanders... Or perhaps I should say, distinguished guests from afar...",
            "nextDialogs": [
              "750910314"
            ]
          },
          "750910314": {
            "id": "750910314",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "If you are able, please find me some more rocks... better, more beautiful ones... The power of the Treasure Stone will not disappoint you...",
            "nextDialogs": [
              "750910315"
            ]
          },
          "750910315": {
            "id": "750910315",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "I can feel it in my bones... I can tell that this will be good for it...",
            "nextDialogs": [
              "750910316"
            ]
          },
          "750910316": {
            "id": "750910316",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why does it feel like we're falling deeper and deeper into a trap...",
            "nextDialogs": [
              "750910317"
            ]
          },
          "750910317": {
            "id": "750910317",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#What do you think, {NICKNAME}?",
            "nextDialogs": [
              "750910318"
            ]
          },
          "750910318": {
            "id": "750910318",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "If it means we'll be able to get our hands on some better rocks...",
            "nextDialogs": [
              "750910319"
            ]
          },
          "750910319": {
            "id": "750910319",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's definitely worth a try...",
            "nextDialogs": [
              "750910320"
            ]
          },
          "750910320": {
            "id": "750910320",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "Hehe, great! So this time, you'll pick some even better rocks than before, and you'll give them straight to me... And with even better rocks to feed upon, the Treasure Stone will surely become more powerful than ever..."
          },
          "750910312": {
            "id": "750910312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No way! You're just trying to scare Paimon again!"
          }
        }
      }
    },
    {
      "subId": "7509104",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

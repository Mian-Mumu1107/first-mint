    {
      "subId": "7509109",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750910901"
        ],
        "dialogs": {
          "750910901": {
            "id": "750910901",
            "speakerId": 21633,
            "speakerName": "Qispi",
            "text": "Haha... So this is Trishiraite, a stone that does not grow within the borders of Natlan. When the Treasure Stone consumes it, it will surely be able to... absorb its power.",

    {
      "subId": "7607611",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760761101"
        ],
        "dialogs": {
          "760761101": {
            "id": "760761101",
            "speakerId": 1314,
            "speakerName": "Flins",
            "text": "Hello there, friend. A pleasure to meet you again amidst the graves.",
            "nextDialogs": [
              "760761102"
            ]
          },
          "760761102": {
            "id": "760761102",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You describe the \"Oath Lantern\" you saw and the incomprehensible words inscribed upon it.",
            "nextDialogs": [
              "760761103"
            ]
          },
          "760761103": {
            "id": "760761103",
            "speakerId": 1314,
            "speakerName": "Flins",
            "text": "\"The winds awaken, the leaves whirl round\"... This is the oath those who join the Lightkeepers swear.",
            "nextDialogs": [
              "760761104"
            ]
          },
          "760761104": {
            "id": "760761104",
            "speakerId": 1314,
            "speakerName": "Flins",
            "text": "Usually, each of us will carry our own lantern, only abandoning our charge to care for it when we have no other choice.",
            "nextDialogs": [
              "760761105"
            ]
          },
          "760761105": {
            "id": "760761105",
            "speakerId": 1314,
            "speakerName": "Flins",
            "text": "Each masterless lantern, therefore, is a marker of misfortune, a tragedy that fills me with sorrow.",
            "nextDialogs": [
              "760761106"
            ]
          },
          "760761106": {
            "id": "760761106",
            "speakerId": 1314,
            "speakerName": "Flins",
            "text": "But they knew that such would be their inevitable fate from the moment they made their oaths.",
            "nextDialogs": [
              "760761107"
            ]
          },
          "760761107": {
            "id": "760761107",
            "speakerId": 1314,
            "speakerName": "Flins",
            "text": "If there was anything else we could do for them, it would be remembering the oaths they made.",
            "nextDialogs": [
              "760761108"
            ]
          },
          "760761108": {
            "id": "760761108",
            "speakerId": 1314,
            "speakerName": "Flins",
            "text": "To bear and defend \"lanterns alight with eternal hope\"... That was their dearest wish."
          }
        }
      }
    },

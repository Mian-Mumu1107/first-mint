{
  "lineCounts": {
    "Player": 48,
    "The Damselette": 57
  },
  "subQuests": [
    {
      "subId": "603201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60172001"
        ],
        "dialogs": {
          "60172001": {
            "id": "60172001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Our spaceship...",
            "nextDialogs": [
              "60172002"
            ]
          },
          "60172002": {
            "id": "60172002",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "It's huge... I suppose that the moon is the only place one could hide it.",
            "nextDialogs": [
              "60172003"
            ]
          },
          "60172003": {
            "id": "60172003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "60172004"
            ]
          },
          "60172004": {
            "id": "60172004",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "#It'll be alright, {NICKNAME}.",
            "nextDialogs": [
              "60172005"
            ]
          },
          "60172005": {
            "id": "60172005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Huh?",
            "nextDialogs": [
              "60172006"
            ]
          },
          "60172006": {
            "id": "60172006",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "The way you feel in this moment, I went through it too, on Moon-Prayer Night. The door was right in front of me, but I struggled to find the courage to step through.",
            "nextDialogs": [
              "60172007"
            ]
          },
          "60172007": {
            "id": "60172007",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Solitude for me once meant living a life in which even I was absent. Before I met you, that was the only life I knew.",
            "nextDialogs": [
              "60172008"
            ]
          },
          "60172008": {
            "id": "60172008",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "But that night, solitude meant throwing away the life I had gained after meeting all of you...",
            "nextDialogs": [
              "60172009"
            ]
          },
          "60172009": {
            "id": "60172009",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Columbina...",
            "nextDialogs": [
              "60172010"
            ]
          },
          "60172010": {
            "id": "60172010",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Go. Retrieve the part of your life that once was lost. Trust me, you will lose nothing by doing so.",
            "nextDialogs": [
              "60172011"
            ]
          },
          "60172011": {
            "id": "60172011",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Look. Teyvat is right there. All our friends are down there waiting for us.",
            "nextDialogs": [
              "60172012"
            ]
          },
          "60172012": {
            "id": "60172012",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...You're right. Thanks, Columbina.",
            "nextDialogs": [
              "60172013"
            ]
          },
          "60172013": {
            "id": "60172013",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(...)",
            "nextDialogs": [
              "60172014"
            ]
          },
          "60172014": {
            "id": "60172014",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "♪~♪~",
            "nextDialogs": [
              "60172015"
            ]
          },
          "60172015": {
            "id": "60172015",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "60172016"
            ]
          },
          "60172016": {
            "id": "60172016",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Hmm? Finished?",
            "nextDialogs": [
              "60172017"
            ]
          },
          "60172017": {
            "id": "60172017",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yeah.",
            "nextDialogs": [
              "60172018"
            ]
          },
          "60172018": {
            "id": "60172018",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Why did you take your eye mask off?",
            "nextDialogs": [
              "60172019"
            ]
          },
          "60172019": {
            "id": "60172019",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Well... Since my return, I've decided to take more opportunities to see the world with my own eyes.",
            "nextDialogs": [
              "60172020"
            ]
          },
          "60172020": {
            "id": "60172020",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Besides... I've always wondered how Teyvat looks from the moon.",
            "nextDialogs": [
              "60172021"
            ]
          },
          "60172021": {
            "id": "60172021",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And what do you think?",
            "nextDialogs": [
              "60172022"
            ]
          },
          "60172022": {
            "id": "60172022",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "It's beautiful. I could spend a whole day here just gazing at it.",
            "nextDialogs": [
              "60172023"
            ]
          },
          "60172023": {
            "id": "60172023",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "What about you? What do you think of the truth you found?",
            "nextDialogs": [
              "60172024"
            ]
          },
          "60172024": {
            "id": "60172024",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "60172025"
            ]
          },
          "60172025": {
            "id": "60172025",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "I haven't looked at another person's expression in a long time, but... I think yours is saying... it was neither good nor bad?",
            "nextDialogs": [
              "60172026"
            ]
          },
          "60172026": {
            "id": "60172026",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Heh. Keep this up, and it won't be long before you give Nefer a run for her money.",
            "nextDialogs": [
              "60172027"
            ]
          },
          "60172027": {
            "id": "60172027",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Oh... I don't think that's going to happen. I'm much more used to sensing what's going on around me with kuuvahki. I think I'll save my eyes for seeing special moments I really want to remember.",
            "nextDialogs": [
              "60172028"
            ]
          },
          "60172028": {
            "id": "60172028",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I... read the spaceship's flight logs.",
            "nextDialogs": [
              "60172029"
            ]
          },
          "60172029": {
            "id": "60172029",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#I always assumed that this was my first time in Teyvat... I thought that {M#Lumine}{F#Aether} and I must have been hibernating in space for centuries on end...",
            "nextDialogs": [
              "60172030"
            ]
          },
          "60172030": {
            "id": "60172030",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But the logs show that our spaceship flew over the skies of Teyvat once before. A long, long time ago.",
            "nextDialogs": [
              "60172031"
            ]
          },
          "60172031": {
            "id": "60172031",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Flew over? So you didn't you land?",
            "nextDialogs": [
              "60172032"
            ]
          },
          "60172032": {
            "id": "60172032",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No. The ship barely came to a stop before flying on again.",
            "nextDialogs": [
              "60172033"
            ]
          },
          "60172033": {
            "id": "60172033",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "After that, it continued traveling through space for a long time. Some of the data is corrupted, but I suspect that it kept flying for thousands of years.",
            "nextDialogs": [
              "60172034"
            ]
          },
          "60172034": {
            "id": "60172034",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It was only after that that the ship made a forced landing in Nod-Krai...",
            "nextDialogs": [
              "60172035"
            ]
          },
          "60172035": {
            "id": "60172035",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "60172036"
            ]
          },
          "60172036": {
            "id": "60172036",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#(When {M#Lumine}{F#Aether} found me, {M#she}{F#he} came from outside the ship...)",
            "nextDialogs": [
              "60172037"
            ]
          },
          "60172037": {
            "id": "60172037",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#(Could this mean that {M#she}{F#he} left the ship long before I did? Maybe even... during our first pass over Teyvat?)",
            "nextDialogs": [
              "60172038"
            ]
          },
          "60172038": {
            "id": "60172038",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Are you alright?",
            "nextDialogs": [
              "60172039"
            ]
          },
          "60172039": {
            "id": "60172039",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes... I can feel that the truth is coming together, one small piece at a time.",
            "nextDialogs": [
              "60172040"
            ]
          },
          "60172040": {
            "id": "60172040",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#I remember {M#Lumine}{F#Aether} telling me that when {M#she}{F#he} first arrived in Khaenri'ah, {M#she}{F#he} could not recall the past...",
            "nextDialogs": [
              "60172041"
            ]
          },
          "60172041": {
            "id": "60172041",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#So this might be something that even {M#she}{F#he} doesn't know...",
            "nextDialogs": [
              "60172042"
            ]
          },
          "60172042": {
            "id": "60172042",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...Here, I made some space for you. Your mind must be racing, and this seems like the perfect place to relax and clear your head.",
            "nextDialogs": [
              "60172043"
            ]
          },
          "60172043": {
            "id": "60172043",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oh! ...Wait, there's one more thing!",
            "nextDialogs": [
              "60172044"
            ]
          },
          "60172044": {
            "id": "60172044",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "What is it?",
            "nextDialogs": [
              "60172045"
            ]
          },
          "60172045": {
            "id": "60172045",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wait here a moment...!",
            "nextDialogs": [
              "60172046"
            ]
          },
          "60172046": {
            "id": "60172046",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "60172047"
            ]
          },
          "60172047": {
            "id": "60172047",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Hey, Columbina.",
            "nextDialogs": [
              "60172048"
            ]
          },
          "60172048": {
            "id": "60172048",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Hmm...? Is that... a new outfit?",
            "nextDialogs": [
              "60172049"
            ]
          },
          "60172049": {
            "id": "60172049",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "An old one, technically. It's been in a cabinet inside the ship this whole time.",
            "nextDialogs": [
              "60172050"
            ]
          },
          "60172050": {
            "id": "60172050",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#It's a matching pair with {M#Lumine}{F#Aether}'s. {M#She}{F#He} always liked this set more...",
            "nextDialogs": [
              "60172051"
            ]
          },
          "60172051": {
            "id": "60172051",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Huh. I don't think there's a huge difference.",
            "nextDialogs": [
              "60172052"
            ]
          },
          "60172052": {
            "id": "60172052",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Really?",
            "nextDialogs": [
              "60172053"
            ]
          },
          "60172053": {
            "id": "60172053",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Yes. It's still the same you. You're the same person, no matter what clothes you wear.",
            "nextDialogs": [
              "60172054"
            ]
          },
          "60172054": {
            "id": "60172054",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Haha... Only Columbina would make an observation like that...)",
            "nextDialogs": [
              "60172055"
            ]
          },
          "60172055": {
            "id": "60172055",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "#...{NICKNAME}, do you consider Teyvat your home?",
            "nextDialogs": [
              "60172056"
            ]
          },
          "60172056": {
            "id": "60172056",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#(Home is... wherever {M#Lumine}{F#Aether} is. But then, after all the time I've spent here, and everything I've been through...)",
            "nextDialogs": [
              "60172057"
            ]
          },
          "60172057": {
            "id": "60172057",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Yes, I'd say it's my home.",
            "nextDialogs": [
              "60172058"
            ]
          },
          "60172058": {
            "id": "60172058",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Would you change your answer if Teyvat changed appearance? I mean... if the truth about Teyvat turned out to be different than what you thought.",
            "nextDialogs": [
              "60172059"
            ]
          },
          "60172059": {
            "id": "60172059",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...I don't know. But I don't think so.",
            "nextDialogs": [
              "60172060"
            ]
          },
          "60172060": {
            "id": "60172060",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The truth is not what matters most to me about Teyvat.",
            "nextDialogs": [
              "60172061"
            ]
          },
          "60172061": {
            "id": "60172061",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "60172062"
            ]
          },
          "60172062": {
            "id": "60172062",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "When I was first born, I longed for a home...",
            "nextDialogs": [
              "60172063"
            ]
          },
          "60172063": {
            "id": "60172063",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "And when you get something before you're mature enough to understand the world, you just take it at face value.",
            "nextDialogs": [
              "60172064"
            ]
          },
          "60172064": {
            "id": "60172064",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "I thought that a home was a transaction. You give me what I want, and I'll do the same for you.",
            "nextDialogs": [
              "60172065"
            ]
          },
          "60172065": {
            "id": "60172065",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "But you and your friends taught me what a true home should look like. You never asked for anything, yet you gave so generously to me.",
            "nextDialogs": [
              "60172066"
            ]
          },
          "60172066": {
            "id": "60172066",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's because your friendship matters to us. It was worth it.",
            "nextDialogs": [
              "60172067"
            ]
          },
          "60172067": {
            "id": "60172067",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Haha... In the past, I thought that my birth in Nod-Krai must have been a mistake.",
            "nextDialogs": [
              "60172068"
            ]
          },
          "60172068": {
            "id": "60172068",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "But after journeying to the distant past where the story began, I realized that it was I who chose Nod-Krai to be my future home.",
            "nextDialogs": [
              "60172069"
            ]
          },
          "60172069": {
            "id": "60172069",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Now, I am glad that I made that choice.",
            "nextDialogs": [
              "60172070"
            ]
          },
          "60172070": {
            "id": "60172070",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm sure your friends are just as glad.",
            "nextDialogs": [
              "60172071"
            ]
          },
          "60172071": {
            "id": "60172071",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "In fact, I intend to make the same choice today as I did back then.",
            "nextDialogs": [
              "60172072"
            ]
          },
          "60172072": {
            "id": "60172072",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do you mean?",
            "nextDialogs": [
              "60172073"
            ]
          },
          "60172073": {
            "id": "60172073",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Well, I've given the Eternal Moon's marrow to Lauma, and the Iridescent Moon's Marrow to Arlecchino.",
            "nextDialogs": [
              "60172074"
            ]
          },
          "60172074": {
            "id": "60172074",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "And now, I shall return my kuuvahki to Nod-Krai again, that it may continue to protect my chosen home.",
            "nextDialogs": [
              "60172075"
            ]
          },
          "60172075": {
            "id": "60172075",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wait! But what about your body...",
            "nextDialogs": [
              "60172076"
            ]
          },
          "60172076": {
            "id": "60172076",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Hmm? ...Oh, are you worried that I'll disappear again?",
            "nextDialogs": [
              "60172077"
            ]
          },
          "60172077": {
            "id": "60172077",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Haha... I won't, not this time. The Frost Moon has now entered the false sky, and I am the Trilune Goddess.",
            "nextDialogs": [
              "60172078"
            ]
          },
          "60172078": {
            "id": "60172078",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "I am only returning to Nod-Krai the part of me that it needs. I am giving what I can... because my home is worth it.",
            "nextDialogs": [
              "60172079"
            ]
          },
          "60172079": {
            "id": "60172079",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Oh, and I have something for you too.",
            "nextDialogs": [
              "60172080"
            ]
          },
          "60172080": {
            "id": "60172080",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "For me?",
            "nextDialogs": [
              "60172081"
            ]
          },
          "60172081": {
            "id": "60172081",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Yes. Come closer...",
            "nextDialogs": [
              "60172082"
            ]
          },
          "60172082": {
            "id": "60172082",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...!",
            "nextDialogs": [
              "60172083"
            ]
          },
          "60172083": {
            "id": "60172083",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What was that?",
            "nextDialogs": [
              "60172084"
            ]
          },
          "60172084": {
            "id": "60172084",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "I lifted some of the restrictions this world placed on you. I trust this will help in your future adventures?",
            "nextDialogs": [
              "60172085"
            ]
          },
          "60172085": {
            "id": "60172085",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(My power... It feels like it's grown. I can use the elements more freely now...)",
            "nextDialogs": [
              "60172086"
            ]
          },
          "60172086": {
            "id": "60172086",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Thank you. This will be a great help.",
            "nextDialogs": [
              "60172087"
            ]
          },
          "60172087": {
            "id": "60172087",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "You're welcome. I see you as family, and after everything you've done for me, I... In fact, no. It's not because I owe you. It's because you're worth it.",
            "nextDialogs": [
              "60172088"
            ]
          },
          "60172088": {
            "id": "60172088",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Here. This flower is for you.",
            "nextDialogs": [
              "60172089"
            ]
          },
          "60172089": {
            "id": "60172089",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hmm? Isn't this a Moon-Prayer Blossom?",
            "nextDialogs": [
              "60172090"
            ]
          },
          "60172090": {
            "id": "60172090",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Yes. Don't worry, you will never see these flowers lose their color again.",
            "nextDialogs": [
              "60172091"
            ]
          },
          "60172091": {
            "id": "60172091",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "I'm finally discovering the joy of giving... How I wish I'd learned this sooner.",
            "nextDialogs": [
              "60172092"
            ]
          },
          "60172092": {
            "id": "60172092",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hey, better late than never.",
            "nextDialogs": [
              "60172093"
            ]
          },
          "60172093": {
            "id": "60172093",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Hehe...",
            "nextDialogs": [
              "60172094"
            ]
          },
          "60172094": {
            "id": "60172094",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you thinking about now?",
            "nextDialogs": [
              "60172095"
            ]
          },
          "60172095": {
            "id": "60172095",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Why don't you take a guess? You get... one shot.",
            "nextDialogs": [
              "60172096"
            ]
          },
          "60172096": {
            "id": "60172096",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't think I'll get it in one guess. But I'm sure it's a happy thought...",
            "nextDialogs": [
              "60172097"
            ]
          },
          "60172097": {
            "id": "60172097",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "That's kind of a sneaky answer... I can't say you got it wrong.",
            "nextDialogs": [
              "60172098"
            ]
          },
          "60172098": {
            "id": "60172098",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Down in Teyvat, the moon seems so far away. I felt it might always lie beyond my reach...",
            "nextDialogs": [
              "60172099"
            ]
          },
          "60172099": {
            "id": "60172099",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "But on the moon, everything feels so close by.",
            "nextDialogs": [
              "60172701"
            ]
          },
          "60172701": {
            "id": "60172701",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "The haze that once enshrouded the skies has finally been dispersed. I feel like a traveler on a winter's night, starting a new chapter in my tale by the warmth of a bonfire.",
            "nextDialogs": [
              "60172702"
            ]
          },
          "60172702": {
            "id": "60172702",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "I don't have a lot of luggage, but I do have a lot of hope for the future.",
            "nextDialogs": [
              "60172703"
            ]
          },
          "60172703": {
            "id": "60172703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Haha... Well, what's next?",
            "nextDialogs": [
              "60172704"
            ]
          },
          "60172704": {
            "id": "60172704",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Next?",
            "nextDialogs": [
              "60172705"
            ]
          },
          "60172705": {
            "id": "60172705",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "To start with... I want to stay here just a little longer.",
            "nextDialogs": [
              "60172706"
            ]
          },
          "60172706": {
            "id": "60172706",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "After that, let's return home and continue our journey."
          }
        }
      }
    }
  ]

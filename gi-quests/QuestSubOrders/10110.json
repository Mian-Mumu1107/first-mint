    {
      "subId": "1011007",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101100701"
        ],
        "dialogs": {
          "101100701": {
            "id": "101100701",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Hmm... How about <color=#00E1FFFF>Ellin</color>? Someone of her age surely must have some imagination left, don't you think?"
          }
        }
      }
    },
    {
      "subId": "1011008",

    {
      "subId": "1011009",
      "subQuestName": "Talk to Ellin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101100901"
        ],
        "dialogs": {
          "101100901": {
            "id": "101100901",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Whew! Thank you. It's clear I still have a long way to go in my training.",
            "nextDialogs": [
              "101100902"
            ]
          },
          "101100902": {
            "id": "101100902",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "So modest! I for one think you're quite the pro at this already.",
            "nextDialogs": [
              "101100903"
            ]
          },
          "101100903": {
            "id": "101100903",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Well, I'm exhausted from training, so clearly my fitness needs some work. One day, though... I'll smash all the training dummies in Mondstadt...",
            "nextDialogs": [
              "101100904"
            ]
          },
          "101100904": {
            "id": "101100904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ellin, Ellin, she's our girl! If she can't do it... um, hilichurl!",
            "nextDialogs": [
              "101100905"
            ]
          },
          "101100905": {
            "id": "101100905",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Thanks... Shoot, I got so caught up here I forgot there's something I was supposed to do today!",
            "nextDialogs": [
              "101100906"
            ]
          },
          "101100906": {
            "id": "101100906",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Ugh... But I'm so sore from training, I can hardly move...",
            "nextDialogs": [
              "101100907"
            ]
          },
          "101100907": {
            "id": "101100907",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Honorary Knight, could you deliver a message to Jack for me?",
            "nextDialogs": [
              "101100909",
              "101100914"
            ]
          },
          "101100909": {
            "id": "101100909",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "He's a friend of mine. Recently started as an adventurer.",
            "nextDialogs": [
              "101100910"
            ]
          },
          "101100910": {
            "id": "101100910",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "We were gonna meet up tonight and discuss adventure plans... Could you let him know it'll have to be another day?",
            "nextDialogs": [
              "101100911"
            ]
          },
          "101100911": {
            "id": "101100911",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "If I'm not mistaken, you should find him at the <color=#00E1FFFF>Temple of the Lion</color>. He's adventuring with Stanley today.",
            "nextDialogs": [
              "101100912"
            ]
          },
          "101100912": {
            "id": "101100912",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Stanley's a truly legendary adventurer, renowned in all of Mondstadt. He once set foot in the Mare Jivari.",
            "nextDialogs": [
              "101100917"
            ]
          },
          "101100917": {
            "id": "101100917",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Temple of the Lion? Sure, I miss that place!",
            "nextDialogs": [
              "101100918"
            ]
          },
          "101100918": {
            "id": "101100918",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Great! Thank you so much."
          },
          "101100914": {
            "id": "101100914",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "He's gone adventuring at the <color=#00E1FFFF>Temple of the Lion</color> with Stanley today.",
            "nextDialogs": [
              "101100915"
            ]
          },
          "101100915": {
            "id": "101100915",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Stanley's a truly legendary adventurer, renowned in all of Mondstadt. He once set foot in the Mare Jivari.",
            "nextDialogs": [
              "101100916"
            ]
          },
          "101100916": {
            "id": "101100916",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "We were gonna meet up tonight and discuss adventure plans... Could you let him know it'll have to be another day?"
          }
        }
      }
    }
  ]
}
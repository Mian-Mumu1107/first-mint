  "subQuests": [
    {
      "subId": "1011001",
      "subQuestName": "Head to a certain spot in the Anemo God Statue Plaza",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101100101"
        ],
        "dialogs": {
          "101100101": {
            "id": "101100101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hey, {NICKNAME}... look over there!",
            "nextDialogs": [
              "101100102"
            ]
          },
          "101100102": {
            "id": "101100102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "She's... all by herself, right?",
            "nextDialogs": [
              "101100103"
            ]
          },
          "101100103": {
            "id": "101100103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Because she's acting as if she's talking and laughing with somebody else... Uhhh! Paimon's creeped out...",
            "nextDialogs": [
              "101100104"
            ]
          },
          "101100104": {
            "id": "101100104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I had an imaginary friend too when I was a kid.",
            "nextDialogs": [
              "101100105"
            ]
          },
          "101100105": {
            "id": "101100105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#What? You mean you used to act like that too, {NICKNAME}?",
            "nextDialogs": [
              "101100106"
            ]
          },
          "101100106": {
            "id": "101100106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh... so is this... an invisible friend who hangs out with you sometimes? Or... do they just exist in your imagination?",
            "nextDialogs": [
              "101100108",
              "101100110"
            ]
          },
          "101100108": {
            "id": "101100108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Imaginary... imagination...",
            "nextDialogs": [
              "101100111"
            ]
          },
          "101100111": {
            "id": "101100111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Oh, you must mean \"imagined friend,\" right? Why didn't you just say so!",
            "nextDialogs": [
              "101100112"
            ]
          },
          "101100112": {
            "id": "101100112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, this \"imaginary friend\" of yours... When does Paimon get to meet them?"
          },
          "101100110": {
            "id": "101100110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Imagination... imaginary..."
          }
        }
      }
    },
    {
      "subId": "1011002",
      "subQuestName": "Check in with Flora",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101100203"
        ],
        "dialogs": {
          "101100203": {
            "id": "101100203",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "There it is. Behold, a floaty imaginary friend for floaty-headed Flora: A Bloatty Floatty!",
            "nextDialogs": [
              "101100204"
            ]
          },
          "101100204": {
            "id": "101100204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, imaginary friends can be plants now!?",
            "nextDialogs": [
              "101100205"
            ]
          },
          "101100205": {
            "id": "101100205",
            "speakerId": 1425,
            "speakerName": "Flora",
            "text": "Hehehe, hi Traveler, hi Bard.",
            "nextDialogs": [
              "101100208"
            ]
          },
          "101100208": {
            "id": "101100208",
            "speakerId": 1425,
            "speakerName": "Flora",
            "text": "Sure. How can I help?"
          }
        }
      }
    },
    {
      "subId": "1011003",
      "subQuestName": "Go see Timmie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101100304"
        ],
        "dialogs": {
          "101100304": {
            "id": "101100304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "N—No way!",
            "nextDialogs": [
              "101100305"
            ]
          },
          "101100305": {
            "id": "101100305",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Well. That... is unexpected.",
            "nextDialogs": [
              "101100306"
            ]
          },
          "101100306": {
            "id": "101100306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Timmie's imaginary friend is a R—Ruin Guard!?",
            "nextDialogs": [
              "101100309"
            ]
          },
          "101100309": {
            "id": "101100309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's freaking out right now... That thing is sure to attack us!",
            "nextDialogs": [
              "101100310"
            ]
          },
          "101100310": {
            "id": "101100310",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Haha... What say you we postpone our conversation with Timmie for the time being?"
          }
        }
      }
    },
    {
      "subId": "1011004",
      "subQuestName": "Drop in on the adults in the tavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101100404"
        ],
        "dialogs": {
          "101100404": {
            "id": "101100404",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "The thing about wine is, you have to drink it at the tavern or you miss out on half the fun.",
            "nextDialogs": [
              "101100405"
            ]
          },
          "101100405": {
            "id": "101100405",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Seems to me you'd find some way of keeping yourself amused even if you drank alone.",
            "nextDialogs": [
              "101100406"
            ]
          },
          "101100406": {
            "id": "101100406",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Haha, if I didn't know any better, I would say you're being deliberately uncivil.",
            "nextDialogs": [
              "101100407"
            ]
          },
          "101100407": {
            "id": "101100407",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Just... drink responsibly on my premises, okay?",
            "nextDialogs": [
              "101100408"
            ]
          },
          "101100408": {
            "id": "101100408",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Oh? And if I did have one too many, what then? You'd throw me out along with the trash, is that it?",
            "nextDialogs": [
              "101100409"
            ]
          },
          "101100409": {
            "id": "101100409",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "\"Throw you out\"?",
            "nextDialogs": [
              "101100410"
            ]
          },
          "101100410": {
            "id": "101100410",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "You know... the same way you threw out Father's legacy? You sold off his mansion — or maybe you've forgotten?",
            "nextDialogs": [
              "101100411"
            ]
          },
          "101100411": {
            "id": "101100411",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I see no reason to cling to things that have outlived their purpose.",
            "nextDialogs": [
              "101100412"
            ]
          },
          "101100412": {
            "id": "101100412",
            "speakerId": 1004,
            "speakerName": "Kaeya",
            "text": "Is that so? Then I trust you were most swift indeed to part with a certain vase?",
            "nextDialogs": [
              "101100413"
            ]
          },
          "101100413": {
            "id": "101100413",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Sorry, I have no recollection.",
            "nextDialogs": [
              "101100414"
            ]
          },
          "101100414": {
            "id": "101100414",
            "speakerId": 1577,
            "speakerName": "Reckless Pallad",
            "text": "That's odd. Master Diluc, I'm sure I saw such a vase in your home — a beautiful one, unmistakable, in fact...",
            "nextDialogs": [
              "101100415"
            ]
          },
          "101100415": {
            "id": "101100415",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems our suspicions were right... Grown-ups don't appear to have imaginary friends.",
            "nextDialogs": [
              "101100416"
            ]
          },
          "101100416": {
            "id": "101100416",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Like I said — a lack of childlike wonder.",
            "nextDialogs": [
              "101100417"
            ]
          },
          "101100417": {
            "id": "101100417",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Seems adults are the same everywhere.",
            "nextDialogs": [
              "101100418"
            ]
          },
          "101100418": {
            "id": "101100418",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So people just stop dreaming when they grow up? Okay, well, Paimon for one never wants to grow up!",
            "nextDialogs": [
              "101100419"
            ]
          },
          "101100419": {
            "id": "101100419",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Hmm... This raises an interesting question: At what age, exactly, do people's imaginary friends disappear?",
            "nextDialogs": [
              "101100420"
            ]
          },
          "101100420": {
            "id": "101100420",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Let's... go and check."
          }
        }
      }
    },
    {
      "subId": "1011005",
      "subQuestName": "See how Ellin is doing",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101100703"
        ],
        "dialogs": {
          "101100703": {
            "id": "101100703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Jean! What is Jean doing here?",
            "nextDialogs": [
              "101100704"
            ]
          },
          "101100704": {
            "id": "101100704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is Master Jean Ellin's imaginary friend?",
            "nextDialogs": [
              "101100706",
              "101100708"
            ]
          },
          "101100706": {
            "id": "101100706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So she's so determined to become a knight that she... Okay, that's kinda weird.",
            "nextDialogs": [
              "101100709"
            ]
          },
          "101100709": {
            "id": "101100709",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "Hmm? Oh, hello. What are you guys doing?",
            "nextDialogs": [
              "101100710"
            ]
          },
          "101100710": {
            "id": "101100710",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are you always training here?",
            "nextDialogs": [
              "101100711"
            ]
          },
          "101100711": {
            "id": "101100711",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "You bet. Today, I heard Stanley talking about his adventures. It was incredible! It got me really pumped up.",
            "nextDialogs": [
              "101100712"
            ]
          },
          "101100712": {
            "id": "101100712",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "I hope I can be as outstanding as him one day.",
            "nextDialogs": [
              "101100713"
            ]
          },
          "101100713": {
            "id": "101100713",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "So that you can fight shoulder to shoulder with Master Jean?",
            "nextDialogs": [
              "101100714"
            ]
          },
          "101100714": {
            "id": "101100714",
            "speakerId": 1605,
            "speakerName": "Ellin",
            "text": "I—I mean, obviously I want to become a knight! ...And if I got to go on an adventure with Jean herself... Well, even better!",
            "nextDialogs": [
              "101100715"
            ]
          },
          "101100715": {
            "id": "101100715",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems Ellin reeeally looks up to Jean."
          },
          "101100708": {
            "id": "101100708",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, she's so conscientious it's... terrifying!"
          }
        }
      }
    },
    {
      "subId": "1011010",
      "subQuestName": "Destroy all the training dummies",
      "sceneId": null,

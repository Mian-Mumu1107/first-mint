    {
      "subId": "1303805",
      "subQuestName": "Go to the ceremonial hall",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130380301"
        ],
        "dialogs": {
          "130380301": {
            "id": "130380301",
            "speakerId": 1005,
            "speakerName": "Duaenre",
            "text": "We gather on this day to perform once more the Rite of Duels, with the greatest of all sages, Lord Hermanubis as our witness, for his power and authority is present in our midst.",
            "nextDialogs": [
              "130380302"
            ]
          },
          "130380302": {
            "id": "130380302",
            "speakerId": 1005,
            "speakerName": "Duaenre",
            "text": "This is our most sacred of ceremonies, and no disruption from the audience shall be tolerated. It is incumbent upon all to observe the duel with the utmost respect and reverence throughout the proceedings.",
            "nextDialogs": [
              "130380303"
            ]
          },
          "130380303": {
            "id": "130380303",
            "speakerId": 1005,
            "speakerName": "Duaenre",
            "text": "Representing the Temple of Silence: The defenders.",
            "nextDialogs": [
              "130380304"
            ]
          },
          "130380304": {
            "id": "130380304",
            "speakerId": 1004,
            "speakerName": "Sethos",
            "text": "Grandfather, you're here.",
            "nextDialogs": [
              "130380305"
            ]
          },
          "130380305": {
            "id": "130380305",
            "speakerId": 1006,
            "speakerName": "Bamoun",
            "text": "*cough* ...A Rite of Duels, after all these years... I am surprised by your decision, Sethos.",
            "nextDialogs": [
              "130380306"
            ]
          },
          "130380306": {
            "id": "130380306",
            "speakerId": 1004,
            "speakerName": "Sethos",
            "text": "I know what I'm doing, Grandfather. Just leave it to me.",
            "nextDialogs": [
              "130380307"
            ]
          },
          "130380307": {
            "id": "130380307",
            "speakerId": 1005,
            "speakerName": "Duaenre",
            "text": "Representing the Akademiya: The challengers.",
            "nextDialogs": [
              "130380308"
            ]
          },
          "130380308": {
            "id": "130380308",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Ready. We will fight to have our voices heard.",
            "nextDialogs": [
              "130380309"
            ]
          },
          "130380309": {
            "id": "130380309",
            "speakerId": 1005,
            "speakerName": "Duaenre",
            "text": "Warriors, take your positions and decide on the order of battle.",
            "nextDialogs": [
              "130380310"
            ]
          },
          "130380310": {
            "id": "130380310",
            "speakerId": 1005,
            "speakerName": "Duaenre",
            "text": "We come not to debate what brings our challengers here, nor what will become of the defeated duelists. Duelists, the might of Hermanubis himself is at stake here. Now, fight, fight until the rightful victor is proclaimed!",
            "nextDialogs": [
              "130380311"
            ]
          },
          "130380311": {
            "id": "130380311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll go first.",
            "nextDialogs": [
              "130380312"
            ]
          },
          "130380312": {
            "id": "130380312",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Huh? Are you sure?",
            "nextDialogs": [
              "130380313"
            ]
          },
          "130380313": {
            "id": "130380313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm sure. We want to keep our morale up.",
            "nextDialogs": [
              "130380314"
            ]
          },
          "130380314": {
            "id": "130380314",
            "speakerId": 1002,
            "speakerName": "Tighnari",
            "text": "#I agree. {NICKNAME} is very strong. Sending {F#her}{M#him} out first will definitely intimidate the opposing side.",
            "nextDialogs": [
              "130380315"
            ]
          },
          "130380315": {
            "id": "130380315",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "Okay, then you're second.",
            "nextDialogs": [
              "130380316"
            ]
          },
          "130380316": {
            "id": "130380316",
            "speakerId": 1002,
            "speakerName": "Tighnari",
            "text": "Sure.",
            "nextDialogs": [
              "130380317"
            ]
          },
          "130380317": {
            "id": "130380317",
            "speakerId": 1001,
            "speakerName": "Cyno",
            "text": "We have decided.",
            "nextDialogs": [
              "130380318"
            ]
          },
          "130380318": {
            "id": "130380318",
            "speakerId": 1004,
            "speakerName": "Sethos",
            "text": "So have we. Let's begin."
          }
        }
      }
    },
    {

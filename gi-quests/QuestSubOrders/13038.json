    {
      "subId": "1303811",
      "subQuestName": "Prepare for the second bout",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130380801"
        ],
        "dialogs": {
          "130380801": {
            "id": "130380801",
            "speakerId": 1005,
            "speakerName": "Duaenre",
            "text": "A swift end to the first bout. I now invite the duelists of the second bout to please step forward.",
            "nextDialogs": [
              "130380802"
            ]
          },
          "130380802": {
            "id": "130380802",
            "speakerId": 1005,
            "speakerName": "Duaenre",
            "text": "When you're both ready, you may begin.",
            "nextDialogs": [
              "130380803"
            ]
          },
          "130380803": {
            "id": "130380803",
            "speakerId": 1002,
            "speakerName": "Tighnari",
            "text": "Let's begin."
          }
        }
      }
    },
    {
      "subId": "1303807",
      "subQuestName": "Participate in the second bout",
      "sceneId": null,
      "locations": [],
      "dialogue": {

  "subQuests": [
    {
      "subId": "2001509",
      "subQuestName": "Talk to Ella Musk",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200150901"
        ],
        "dialogs": {
          "200150901": {
            "id": "200150901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure, let me go drag one out for you.",
            "nextDialogs": [
              "200150902"
            ]
          },
          "200150902": {
            "id": "200150902",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "Wait! No! My word, just who exactly taught you to go bashing hilichurls around like that!?",
            "nextDialogs": [
              "200150903"
            ]
          },
          "200150903": {
            "id": "200150903",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "Let's compose ourselves, go over there together, and politely introduce ourselves."
          }
        }
      }
    },

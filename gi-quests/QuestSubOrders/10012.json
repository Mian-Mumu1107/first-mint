  "subQuests": [
    {
      "subId": "1001201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100120101"
        ],
        "dialogs": {
          "100120101": {
            "id": "100120101",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "*sigh* It pains me to say it, but my sword-swinging days are over. If I went with you, I'd only get in the way.",
            "nextDialogs": [
              "100120102"
            ]
          },
          "100120102": {
            "id": "100120102",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "Guess I'll be handling today's routine work all by my lonesome."
          }
        }
      }
    },
    {
      "subId": "1001202",
      "subQuestName": "Go to where Adorno lives",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100120201"
        ],
        "dialogs": {
          "100120201": {
            "id": "100120201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Grandpa Adorno!",
            "nextDialogs": [
              "100120202"
            ]
          },
          "100120202": {
            "id": "100120202",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "Oh, little Paimon, and the Honorary Knight!",
            "nextDialogs": [
              "100120203"
            ]
          },
          "100120203": {
            "id": "100120203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Feeling better today?",
            "nextDialogs": [
              "100120204"
            ]
          },
          "100120204": {
            "id": "100120204",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "Right as rain! I wasn't really injured yesterday. Theodore had a look at me, and frankly, I'm feeling better than ever!",
            "nextDialogs": [
              "100120205"
            ]
          },
          "100120205": {
            "id": "100120205",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "I've his treatment to thank for my continued vigor. Without his help, they'd probably have buried me years ago.",
            "nextDialogs": [
              "100120206"
            ]
          },
          "100120206": {
            "id": "100120206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Theodore... You mean the apprentice medic from the 8th Company? He didn't look all that skilled to Paimon...",
            "nextDialogs": [
              "100120207"
            ]
          },
          "100120207": {
            "id": "100120207",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "He once aspired to be a knight fighting on the front lines, but perhaps the physician's path suits him better.",
            "nextDialogs": [
              "100120208"
            ]
          },
          "100120208": {
            "id": "100120208",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "Anyway, enough about that for now. Did you guys come here looking for Lohen?",
            "nextDialogs": [
              "100120209"
            ]
          },
          "100120209": {
            "id": "100120209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, he disappeared after trying the Simulation Training Bubble yesterday. We can't find him anywhere...",
            "nextDialogs": [
              "100120210"
            ]
          },
          "100120210": {
            "id": "100120210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did he come back here?",
            "nextDialogs": [
              "100120211"
            ]
          },
          "100120211": {
            "id": "100120211",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "Yeah, he left a note this morning... Said he wanted to apologize for what happened yesterday.",
            "nextDialogs": [
              "100120212"
            ]
          },
          "100120212": {
            "id": "100120212",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "He confessed that yesterday was all just an act, and that he couldn't stand this bone-dry daily routine, so, to make up for it...",
            "nextDialogs": [
              "100120213"
            ]
          },
          "100120213": {
            "id": "100120213",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "\"...I'll wipe out every last one of those annoying monsters.\"",
            "nextDialogs": [
              "100120214"
            ]
          },
          "100120214": {
            "id": "100120214",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's how he apologizes? Heh. Totally his style.",
            "nextDialogs": [
              "100120217"
            ]
          },
          "100120217": {
            "id": "100120217",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "Hmm... Ordinary monsters pose no threat to him. What worries me is that something like what happened yesterday might happen again...",
            "nextDialogs": [
              "100120218"
            ]
          },
          "100120218": {
            "id": "100120218",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "If you could keep an eye on him, that would certainly put me at ease.",
            "nextDialogs": [
              "100120219"
            ]
          },
          "100120219": {
            "id": "100120219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Mmhmm, I'll keep an eye out."
          }
        }
      }
    },
    {
      "subId": "1001203",
      "subQuestName": "Look for Lohen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100120301"
        ],
        "dialogs": {
          "100120301": {
            "id": "100120301",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "A short while earlier...",
            "nextDialogs": [
              "100120302"
            ]
          },
          "100120302": {
            "id": "100120302",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "Guess you're the last one... You'd better put up a good fight!",
            "nextDialogs": [
              "100120303"
            ]
          },
          "100120303": {
            "id": "100120303",
            "speakerId": 1004,
            "speakerName": "Experimental Monster",
            "text": "—!",
            "nextDialogs": [
              "100120304"
            ]
          },
          "100120304": {
            "id": "100120304",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "...Hmm? Who's there!",
            "nextDialogs": [
              "100120305"
            ]
          },
          "100120305": {
            "id": "100120305",
            "speakerId": 1004,
            "speakerName": "Experimental Monster",
            "text": "...!",
            "nextDialogs": [
              "100120306"
            ]
          },
          "100120306": {
            "id": "100120306",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "Ugh... It ran away...",
            "nextDialogs": [
              "100120307"
            ]
          },
          "100120307": {
            "id": "100120307",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "—I never thought a winery owner would care so much about hunting monsters.",
            "nextDialogs": [
              "100120308"
            ]
          },
          "100120308": {
            "id": "100120308",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "Or could it be you're after something else?",
            "nextDialogs": [
              "100120309"
            ]
          },
          "100120309": {
            "id": "100120309",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "And what about you? Are monsters all you aim to eradicate?",
            "nextDialogs": [
              "100120310"
            ]
          },
          "100120310": {
            "id": "100120310",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Given how the previous scene was so clean that \"nothing\" was left behind...",
            "nextDialogs": [
              "100120311"
            ]
          },
          "100120311": {
            "id": "100120311",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "Oh? First I've heard of it.",
            "nextDialogs": [
              "100120312"
            ]
          },
          "100120312": {
            "id": "100120312",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "In that case, why don't we examine the monsters here? Perhaps we'll discover what it is about them that's attracting so much attention.",
            "nextDialogs": [
              "100120313"
            ]
          },
          "100120313": {
            "id": "100120313",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "...Ah, forget it. I'll go after the one that got away. Investigations and the like aren't really my style.",
            "nextDialogs": [
              "100120314"
            ]
          },
          "100120314": {
            "id": "100120314",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "See you around... Diluc.",
            "nextDialogs": [
              "100120315"
            ]
          },
          "100120315": {
            "id": "100120315",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "...That's the gist of everything that happened before you arrived.",
            "nextDialogs": [
              "100120316"
            ]
          },
          "100120316": {
            "id": "100120316",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's he tryin' to pull, seriously... Forget \"Punching Bag Knight,\" he should be the \"Needs-A-Punch Knight\"!",
            "nextDialogs": [
              "100120319"
            ]
          },
          "100120319": {
            "id": "100120319",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah! Adorno talked about 'em yesterday... Sounded like they're kinda weird, but they haven't hurt anyone yet?",
            "nextDialogs": [
              "100120320"
            ]
          },
          "100120320": {
            "id": "100120320",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Which is partly down to someone secretly eliminating them... and partly down to them preferring to attack their own kind whenever hunger strikes.",
            "nextDialogs": [
              "100120321"
            ]
          },
          "100120321": {
            "id": "100120321",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They attack... their own kind?",
            "nextDialogs": [
              "100120322"
            ]
          },
          "100120322": {
            "id": "100120322",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Yes. Eyewitness reports are scarce, so we can't be certain, but the monster remains here do show signs that they've been fighting each other.",
            "nextDialogs": [
              "100120323"
            ]
          },
          "100120323": {
            "id": "100120323",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Forming packs, yet killing each other... It's not the behavior of naturally occurring monsters.",
            "nextDialogs": [
              "100120324"
            ]
          },
          "100120324": {
            "id": "100120324",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's certainly strange...",
            "nextDialogs": [
              "100120325"
            ]
          },
          "100120325": {
            "id": "100120325",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? But if these monsters will attack each other, can't we just wait for them to wipe themselves out? Why be so vigilant?",
            "nextDialogs": [
              "100120326"
            ]
          },
          "100120326": {
            "id": "100120326",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Because such beasts, bearing Ursa's Flesh, have appeared before, and not just once, either.",
            "nextDialogs": [
              "100120327"
            ]
          },
          "100120327": {
            "id": "100120327",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Varka!",
            "nextDialogs": [
              "100120328"
            ]
          },
          "100120328": {
            "id": "100120328",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Well, this is a coincidence. Honorary Knight, Paimon, and you too, Diluc.",
            "nextDialogs": [
              "100120329"
            ]
          },
          "100120329": {
            "id": "100120329",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "...So, the Knights of Favonius are not entirely ignorant of this anomaly.",
            "nextDialogs": [
              "100120330"
            ]
          },
          "100120330": {
            "id": "100120330",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Yes... The tragedy Eroch wrought cannot — and will not — be allowed to happen again.",
            "nextDialogs": [
              "100120331"
            ]
          },
          "100120331": {
            "id": "100120331",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did you just say... Ursa's Flesh? Is this somehow related to that Eroch guy?",
            "nextDialogs": [
              "100120332"
            ]
          },
          "100120332": {
            "id": "100120332",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "In his pursuit of transcendent power, he once conspired with one of Dottore's Segments to extract a serum containing the power of Ursa the Drake from the dragon's flesh.",
            "nextDialogs": [
              "100120333"
            ]
          },
          "100120333": {
            "id": "100120333",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "When the reckoning with the Knights came, he and his cohorts all injected themselves with that serum... causing us quite a bit of trouble.",
            "nextDialogs": [
              "100120334"
            ]
          },
          "100120334": {
            "id": "100120334",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Their strength and bloodthirst increased in equal measure, and consumed by madness, they even attacked each other.",
            "nextDialogs": [
              "100120335"
            ]
          },
          "100120335": {
            "id": "100120335",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Ironically, Eroch ultimately failed to control that power. Not only did he turn his sword against his followers, but he went to his own demise in the process.",
            "nextDialogs": [
              "100120336"
            ]
          },
          "100120336": {
            "id": "100120336",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ursa the Drake... What exactly is it? How could it have such terrifying power?"
          }
        }
      }
    },
    {
      "subId": "1001204",
      "subQuestName": "Go to the target's location",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100120401"
        ],
        "dialogs": {
          "100120401": {
            "id": "100120401",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "As expected, the Knights of Favonius are acting swiftly...",
            "nextDialogs": [
              "100120402"
            ]
          },
          "100120402": {
            "id": "100120402",
            "speakerId": 16499,
            "speakerName": "Theodore",
            "text": "There's a crowd gathering up ahead... Something about this feels wrong...",
            "nextDialogs": [
              "100120403"
            ]
          },
          "100120403": {
            "id": "100120403",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "That's... Adorno!",
            "nextDialogs": [
              "100120404"
            ]
          },
          "100120404": {
            "id": "100120404",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "A few hours ago...",
            "nextDialogs": [
              "100120405"
            ]
          },
          "100120405": {
            "id": "100120405",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "Hah... I finally found you!",
            "nextDialogs": [
              "100120406"
            ]
          },
          "100120406": {
            "id": "100120406",
            "speakerId": 16617,
            "speakerName": "Northland Cat",
            "text": "Meow...",
            "nextDialogs": [
              "100120407"
            ]
          },
          "100120407": {
            "id": "100120407",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "Keep a close eye on it now. Don't let it stray too far from you again, alright?",
            "nextDialogs": [
              "100120408"
            ]
          },
          "100120408": {
            "id": "100120408",
            "speakerId": 1774,
            "speakerName": "Moricztill",
            "text": "Thank you... Thank you, Grandpa Adorno!",
            "nextDialogs": [
              "100120409"
            ]
          },
          "100120409": {
            "id": "100120409",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "And don't run off into the countryside alone looking for it again. I know you're worried about it, but Hannelore's worried about you, too. We'll keep this our secret this time, but don't let it happen again.",
            "nextDialogs": [
              "100120410"
            ]
          },
          "100120410": {
            "id": "100120410",
            "speakerId": 1774,
            "speakerName": "Moricztill",
            "text": "Okay... I understand.",
            "nextDialogs": [
              "100120411"
            ]
          },
          "100120411": {
            "id": "100120411",
            "speakerId": 16617,
            "speakerName": "Northland Cat",
            "text": "Meow...!",
            "nextDialogs": [
              "100120412"
            ]
          },
          "100120412": {
            "id": "100120412",
            "speakerId": 1004,
            "speakerName": "Experimental Monster",
            "text": "*roar*",
            "nextDialogs": [
              "100120413"
            ]
          },
          "100120413": {
            "id": "100120413",
            "speakerId": 1774,
            "speakerName": "Moricztill",
            "text": "Ah! A... A monster?",
            "nextDialogs": [
              "100120414"
            ]
          },
          "100120414": {
            "id": "100120414",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "A monster? How did it get here... Something about this one doesn't look right...",
            "nextDialogs": [
              "100120415"
            ]
          },
          "100120415": {
            "id": "100120415",
            "speakerId": 1774,
            "speakerName": "Moricztill",
            "text": "A—Ah... Ah...",
            "nextDialogs": [
              "100120416"
            ]
          },
          "100120416": {
            "id": "100120416",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "Don't be afraid! I'm here with you! Now stand up and get out of here!",
            "nextDialogs": [
              "100120417"
            ]
          },
          "100120417": {
            "id": "100120417",
            "speakerId": 1774,
            "speakerName": "Moricztill",
            "text": "B—But...",
            "nextDialogs": [
              "100120418"
            ]
          },
          "100120418": {
            "id": "100120418",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "Run back home! Don't you worry — Gramps here... is a knight!"
          }
        }
      }
    },
    {
      "subId": "1001205",
      "subQuestName": "Check on Adorno's situation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100120501"
        ],
        "dialogs": {
          "100120501": {
            "id": "100120501",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "...The knights who arrived later defeated the monster... Its power far exceeded what is normal.",
            "nextDialogs": [
              "100120502"
            ]
          },
          "100120502": {
            "id": "100120502",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Adorno fought it tooth and nail to buy time until they arrived.",
            "nextDialogs": [
              "100120503"
            ]
          },
          "100120503": {
            "id": "100120503",
            "speakerId": 16499,
            "speakerName": "Theodore",
            "text": "Adorno... Adorno!",
            "nextDialogs": [
              "100120504"
            ]
          },
          "100120504": {
            "id": "100120504",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "Hah...",
            "nextDialogs": [
              "100120505"
            ]
          },
          "100120505": {
            "id": "100120505",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "...It's fine. You know my condition... I wouldn't have made it this far without your help.",
            "nextDialogs": [
              "100120506"
            ]
          },
          "100120506": {
            "id": "100120506",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "Fighting one last time to save others sure makes me feel more like a knight than lying in bed ever did! ... *cough*",
            "nextDialogs": [
              "100120507"
            ]
          },
          "100120507": {
            "id": "100120507",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "I'm sorry to do this to you now... I know you worked hard on those treatments...",
            "nextDialogs": [
              "100120508"
            ]
          },
          "100120508": {
            "id": "100120508",
            "speakerId": 16499,
            "speakerName": "Theodore",
            "text": "I...",
            "nextDialogs": [
              "100120509"
            ]
          },
          "100120509": {
            "id": "100120509",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "Lohen... The title of \"Benevolent Knight,\" and the 5th Company's captaincy...",
            "nextDialogs": [
              "100120510"
            ]
          },
          "100120510": {
            "id": "100120510",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "I...",
            "nextDialogs": [
              "100120511"
            ]
          },
          "100120511": {
            "id": "100120511",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "—If you don't want them, just let them go. Be true to yourself, that's all that matters.",
            "nextDialogs": [
              "100120512"
            ]
          },
          "100120512": {
            "id": "100120512",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "...",
            "nextDialogs": [
              "100120513"
            ]
          },
          "100120513": {
            "id": "100120513",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "...Lohen, come with me for a moment.",
            "nextDialogs": [
              "100120514"
            ]
          },
          "100120514": {
            "id": "100120514",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "The Investigative Team's analysis shows that the monster that attacked Adorno bears Ursa's mark.",
            "nextDialogs": [
              "100120515"
            ]
          },
          "100120515": {
            "id": "100120515",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "...!",
            "nextDialogs": [
              "100120516"
            ]
          },
          "100120516": {
            "id": "100120516",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Do you still intend to remain silent now that things have got this far?",
            "nextDialogs": [
              "100120517"
            ]
          },
          "100120517": {
            "id": "100120517",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "...",
            "nextDialogs": [
              "100120518"
            ]
          },
          "100120518": {
            "id": "100120518",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "This isn't an interrogation. You can remain silent if you wish, but I hope you'll choose to come clean.",
            "nextDialogs": [
              "100120519"
            ]
          },
          "100120519": {
            "id": "100120519",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "—I'll talk.",
            "nextDialogs": [
              "100120520"
            ]
          },
          "100120520": {
            "id": "100120520",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "...I'll confess everything and accept whatever punishment awaits. But, please...",
            "nextDialogs": [
              "100120521"
            ]
          },
          "100120521": {
            "id": "100120521",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "Please give me one more night. Tomorrow, I'll go to the Knights of Favonius and explain everything.",
            "nextDialogs": [
              "100120522"
            ]
          },
          "100120522": {
            "id": "100120522",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "...I swear it on my honor as a knight.",
            "nextDialogs": [
              "100120523"
            ]
          },
          "100120523": {
            "id": "100120523",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "*sigh*",
            "nextDialogs": [
              "100120524"
            ]
          },
          "100120524": {
            "id": "100120524",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "...That's the first time I've heard you swear such an oath in all this time we've worked together.",
            "nextDialogs": [
              "100120525"
            ]
          },
          "100120525": {
            "id": "100120525",
            "speakerId": 1326,
            "speakerName": "Lohen",
            "text": "I know it doesn't carry much weight.",
            "nextDialogs": [
              "100120526"
            ]
          },
          "100120526": {
            "id": "100120526",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Then let's use the Benevolent Knight's name to balance the scales.",
            "nextDialogs": [
              "100120527"
            ]
          },
          "100120527": {
            "id": "100120527",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Please keep your promise this time, Lohen.",
            "nextDialogs": [
              "100120528"
            ]
          },
          "100120528": {
            "id": "100120528",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "...I'm sorry, Theodore...",
            "nextDialogs": [
              "100120529"
            ]
          },
          "100120529": {
            "id": "100120529",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "I'd intended to make Lohen captain and leave my title to you... I know how much you've yearned for that title since you were little...",
            "nextDialogs": [
              "100120530"
            ]
          },
          "100120530": {
            "id": "100120530",
            "speakerId": 16499,
            "speakerName": "Theodore",
            "text": "It's not your fault, Mr. Adorno...",
            "nextDialogs": [
              "100120531"
            ]
          },
          "100120531": {
            "id": "100120531",
            "speakerId": 16499,
            "speakerName": "Theodore",
            "text": "I don't possess the talent that helped Lohen pass the Knights' exams so easily...",
            "nextDialogs": [
              "100120532"
            ]
          },
          "100120532": {
            "id": "100120532",
            "speakerId": 16499,
            "speakerName": "Theodore",
            "text": "Years of work, and I'm still stuck as a trainee medic... How could I ever inherit your title?",
            "nextDialogs": [
              "100120533"
            ]
          },
          "100120533": {
            "id": "100120533",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "*cough*... Medics... Knights... We're all protecting people, aren't we?",
            "nextDialogs": [
              "100120534"
            ]
          },
          "100120534": {
            "id": "100120534",
            "speakerId": 16498,
            "speakerName": "Adorno",
            "text": "The way I see it, you earn that title every day...",
            "nextDialogs": [
              "100120535"
            ]
          },
          "100120535": {
            "id": "100120535",
            "speakerId": 16499,
            "speakerName": "Theodore",
            "text": "...No. In truth, I've done so much wrong...",
            "nextDialogs": [
              "100120536"
            ]
          },
          "100120536": {
            "id": "100120536",
            "speakerId": 16499,
            "speakerName": "Theodore",
            "text": "And what I'm about to do... is worse still...",
            "nextDialogs": [
              "100120537"
            ]
          },
          "100120537": {
            "id": "100120537",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "...So you agreed to his request. Just like that?",
            "nextDialogs": [
              "100120538"
            ]
          },
          "100120538": {
            "id": "100120538",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "What else should I have done? Ask him to submit a report for my approval? Please. Spare us both.",
            "nextDialogs": [
              "100120539"
            ]
          },
          "100120539": {
            "id": "100120539",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "I know how much Adorno means to him, so I trust the weight of his vow.",
            "nextDialogs": [
              "100120540"
            ]
          },
          "100120540": {
            "id": "100120540",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "There once was a man who made many promises to my father in the name of chivalry, yet in the end, he betrayed their friendship.",
            "nextDialogs": [
              "100120541"
            ]
          },
          "100120541": {
            "id": "100120541",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "\"Warped obsessions and the passage of time can turn friends into foes as easily as the wind changes its course.\"",
            "nextDialogs": [
              "100120542"
            ]
          },
          "100120542": {
            "id": "100120542",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "...Quoting Crepus, are we? That really takes me back.",
            "nextDialogs": [
              "100120543"
            ]
          },
          "100120543": {
            "id": "100120543",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did you guys... all know each other back in the day?",
            "nextDialogs": [
              "100120544"
            ]
          },
          "100120544": {
            "id": "100120544",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Once, there were three spirited young men who imagined their futures together.",
            "nextDialogs": [
              "100120545"
            ]
          },
          "100120545": {
            "id": "100120545",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "One was a rich young {RUBY#[D]Crepus}master. He dreamed of becoming a knight, but ended up inheriting the family winery.",
            "nextDialogs": [
              "100120546"
            ]
          },
          "100120546": {
            "id": "100120546",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Next came the hot-headed rule-b{RUBY#[S]Varka}reaker, who ended up leading the Knights of Favonius.",
            "nextDialogs": [
              "100120547"
            ]
          },
          "100120547": {
            "id": "100120547",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "And the last {RUBY#[S]Eroch}one... obtained neither the wealth he desired, nor the power he yearned for.",
            "nextDialogs": [
              "100120548"
            ]
          },
          "100120548": {
            "id": "100120548",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Obsession was all that was left, piling up day after day into a towering spire.",
            "nextDialogs": [
              "100120551"
            ]
          },
          "100120551": {
            "id": "100120551",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is that how Eroch... let The Doctor worm his way in?",
            "nextDialogs": [
              "100120552"
            ]
          },
          "100120552": {
            "id": "100120552",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "Eroch made his own choices, no matter what was said to him.",
            "nextDialogs": [
              "100120553"
            ]
          },
          "100120553": {
            "id": "100120553",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "I understand his reasoning, but that doesn't mean I pity him. And it certainly doesn't mean I'll make the same mistakes again.",
            "nextDialogs": [
              "100120554"
            ]
          },
          "100120554": {
            "id": "100120554",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "I'm keeping a close eye on my subordinates this time...",
            "nextDialogs": [
              "100120555"
            ]
          },
          "100120555": {
            "id": "100120555",
            "speakerId": 1771,
            "speakerName": "Lietzberg",
            "text": "B—Bad news!",
            "nextDialogs": [
              "100120556"
            ]
          },
          "100120556": {
            "id": "100120556",
            "speakerId": 1310,
            "speakerName": "Varka",
            "text": "—Hey, I haven't finished talking yet!",
            "nextDialogs": [
              "100120557"
            ]
          },
          "100120557": {
            "id": "100120557",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That voice... Did it come from where Adorno was just now?"
          }
        }
      }
    },
    {
      "subId": "1001299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100129901"
        ],
        "dialogs": {
          "100129901": {
            "id": "100129901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That Lohen! He just upped and left yesterday without saying a word...",
            "nextDialogs": [
              "100129902"
            ]
          },
          "100129902": {
            "id": "100129902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's check in with Adorno and see if he's there.",
            "nextDialogs": [
              "100129903"
            ]
          },
          "100129903": {
            "id": "100129903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So many monsters... Huh? Wait, isn't that... Diluc?"
          }
        }
      }
    }
  ]
}
    {
      "subId": "1200210",
      "subQuestName": "Tell Shizhuang the Strong where to find Cor Lapis",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120021001"
        ],
        "dialogs": {
          "120021001": {
            "id": "120021001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Here, we've made a note of the carts' locations. All five of them. Can you sell us the Cor Lapis now?",
            "nextDialogs": [
              "120021002"
            ]
          },
          "120021002": {
            "id": "120021002",
            "speakerId": 1628,
            "speakerName": "Shizhuang the Strong",
            "text": "Ah wonderful, thank you both. Yes, let's make this official. I also hope you could put in a good word with your boss for me.",
            "nextDialogs": [
              "120021008"
            ]
          },
          "120021008": {
            "id": "120021008",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Done and dusted! Yeah!",
            "nextDialogs": [
              "120021004",
              "120021006"
            ]
          },
          "120021004": {
            "id": "120021004",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We make a great team, don't we?",
            "nextDialogs": [
              "120021007"
            ]
          },
          "120021007": {
            "id": "120021007",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Now for the final stop on our Cor Lapis crawl — to Chang the Ninth's place!"
          },
          "120021006": {
            "id": "120021006",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's got a knack for this business malarkey, don't ya think?"
          }
        }
      }
    },
    {
      "subId": "1200211",
      "subQuestName": "Purchase Chang the Ninth's ore",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120030101"
        ],
        "dialogs": {
          "120030101": {
            "id": "120030101",
            "speakerId": 1624,
            "speakerName": "Chang the Ninth",
            "text": "Just who I was hoping to see! I was just thinking to myself, Gentry Maocai's thugs have been mysteriously absent for a while now...",
            "nextDialogs": [
              "120030102"
            ]
          },
          "120030102": {
            "id": "120030102",
            "speakerId": 1624,
            "speakerName": "Chang the Ninth",
            "text": "You wouldn't know anything about that, would you?",
            "nextDialogs": [
              "120030103"
            ]
          },
          "120030103": {
            "id": "120030103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, don't worry... You won't be hearing from them again!",
            "nextDialogs": [
              "120030104"
            ]
          },
          "120030104": {
            "id": "120030104",
            "speakerId": 1624,
            "speakerName": "Chang the Ninth",
            "text": "Oh? ...Wh—What happened?",
            "nextDialogs": [
              "120030105"
            ]
          },
          "120030105": {
            "id": "120030105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not only that, but we'd like to purchase your Cor Lapis.",
            "nextDialogs": [
              "120030106"
            ]
          },
          "120030106": {
            "id": "120030106",
            "speakerId": 1624,
            "speakerName": "Chang the Ninth",
            "text": "Eh!? ...O—Oh, I see now — you're in this trade too. So, you're trying to beat him to the post, eh? Appearances can be deceiving, that's for sure.",
            "nextDialogs": [
              "120030107"
            ]
          },
          "120030107": {
            "id": "120030107",
            "speakerId": 1624,
            "speakerName": "Chang the Ninth",
            "text": "...But I don't care who you are, a discount of seventy percent is simply impossible. The maximum I can do is forty percent off, and even then I'm only breaking even—",
            "nextDialogs": [
              "120030108"
            ]
          },
          "120030108": {
            "id": "120030108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No need. We'll take it at the market rate.",
            "nextDialogs": [
              "120030109"
            ]
          },
          "120030109": {
            "id": "120030109",
            "speakerId": 1624,
            "speakerName": "Chang the Ninth",
            "text": "You mean... you're not trying to force the price down? ...Wh—What's going on!? Have I died and gone to heaven!?",
            "nextDialogs": [
              "120030110"
            ]
          },
          "120030110": {
            "id": "120030110",
            "speakerId": 1624,
            "speakerName": "Chang the Ninth",
            "text": "I can't believe it! I will make a profit on this batch after all!",
            "nextDialogs": [
              "120030111"
            ]
          },
          "120030111": {
            "id": "120030111",
            "speakerId": 1624,
            "speakerName": "Chang the Ninth",
            "text": "...But Gentry Maocai's thugs could still come back after I've sold it...",
            "nextDialogs": [
              "120030112"
            ]
          },
          "120030112": {
            "id": "120030112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "If Paimon told you they're not gonna bother you again, then you'd better believe they're not gonna bother you again!",
            "nextDialogs": [
              "120030115"
            ]
          },
          "120030115": {
            "id": "120030115",
            "speakerId": 1624,
            "speakerName": "Chang the Ninth",
            "text": "Hmm... Okay then. My situation can hardly get worse from here in any case.",
            "nextDialogs": [
              "120030116"
            ]
          },
          "120030116": {
            "id": "120030116",
            "speakerId": 1624,
            "speakerName": "Chang the Ninth",
            "text": "But tell me, what on earth do you plan to do with so much Cor Lapis?",
            "nextDialogs": [
              "120030117"
            ]
          },
          "120030117": {
            "id": "120030117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Actually, it's for a commission. Can't go into too much detail."
          }
        }
      }
    },
    {
      "subId": "1200044",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

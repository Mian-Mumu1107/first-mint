        "dialogs": {
          "120004401": {
            "id": "120004401",
            "speakerId": 1628,
            "speakerName": "Shizhuang the Strong",
            "text": "Found them all? I remember there are five carts in total.",
            "nextDialogs": [
              "120004402"
            ]
          },
          "120004402": {
            "id": "120004402",
            "speakerId": 1628,
            "speakerName": "Shizhuang the Strong",
            "text": "They shouldn't be far. Thanks again for helping me find them."
          }
        }
      }
    },

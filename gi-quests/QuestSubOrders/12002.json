    {
      "subId": "1200219",
      "subQuestName": "Use Elemental Sight to find the cart loaded with Cor Lapis",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120021901"
        ],
        "dialogs": {
          "120021901": {
            "id": "120021901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aw yeah, we found it! Check out all that Cor Lapis!",
            "nextDialogs": [
              "120021902"
            ]
          },
          "120021902": {
            "id": "120021902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Make a note of the location. We'll send the Feiyun Commerce Guild to collect it later."
          }
        }
      }
    },
    {
      "subId": "1200220",
      "subQuestName": "Use Elemental Sight to find the cart loaded with Cor Lapis",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120022001"
        ],
        "dialogs": {
          "120022001": {
            "id": "120022001",
            "speakerId": 1005,
            "speakerName": "Paimon",

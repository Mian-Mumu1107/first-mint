    {
      "subId": "1200208",
      "subQuestName": "Talk to Shizhuang the Strong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120020801"
        ],
        "dialogs": {
          "120020801": {
            "id": "120020801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hello there, are you in charge of the Cor Lapis here?",
            "nextDialogs": [
              "120020802"
            ]
          },
          "120020802": {
            "id": "120020802",
            "speakerId": 1628,
            "speakerName": "Shizhuang the Strong",
            "text": "Aha, finally! I thought you might come — I hear the Feiyun Commerce Guild has been buying up all the Cor Lapis stock in Liyue Harbor.",
            "nextDialogs": [
              "120020803"
            ]
          },
          "120020803": {
            "id": "120020803",
            "speakerId": 1628,
            "speakerName": "Shizhuang the Strong",
            "text": "As it happens, I do have a batch of Cor Lapis that hasn't been shipped yet. It's all yours if you name the right price.",
            "nextDialogs": [
              "120020806"
            ]
          },
          "120020806": {
            "id": "120020806",
            "speakerId": 1628,
            "speakerName": "Shizhuang the Strong",
            "text": "The original buyer's price was already quite high, so... The best I can do is 7,000,000 Mora.",
            "nextDialogs": [
              "120020807"
            ]
          },
          "120020807": {
            "id": "120020807",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are you serious!? We spent less than 2,000,000 Mora on the rest of Liyue's stock put together!",
            "nextDialogs": [
              "120020808"
            ]
          },
          "120020808": {
            "id": "120020808",
            "speakerId": 1628,
            "speakerName": "Shizhuang the Strong",
            "text": "I'm afraid it has to go to the highest bidder. I'm breaching an existing agreement by selling to you, so it has to be worth my while."
          }
        }
      }
    },
    {
      "subId": "1200209",

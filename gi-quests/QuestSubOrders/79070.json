  },
  "subQuests": [
    {
      "subId": "7907001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790700101"
        ],
        "dialogs": {
          "790700101": {
            "id": "790700101",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Your Excellencies. I welcome you on behalf of the Kingdom of Breezes and Bells.",
            "nextDialogs": [
              "790700102"
            ]
          },
          "790700102": {
            "id": "790700102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What will you do next?",
            "nextDialogs": [
              "790700103"
            ]
          },
          "790700103": {
            "id": "790700103",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Hmm... Well, first, I shall announce to all the people that the relic has passed judgment.",
            "nextDialogs": [
              "790700104"
            ]
          },
          "790700104": {
            "id": "790700104",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "And that the Guardian... will be Mr. Faurobert, who has come here from afar.",
            "nextDialogs": [
              "790700105"
            ]
          },
          "790700105": {
            "id": "790700105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh!? Why would you do that?",
            "nextDialogs": [
              "790700106"
            ]
          },
          "790700106": {
            "id": "790700106",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Trying to explain everything we've been through would be far too complicated.",
            "nextDialogs": [
              "790700107"
            ]
          },
          "790700107": {
            "id": "790700107",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Besides, it would take too long for them to grasp the concept of me being both a princess and a Guardian at the same time.",
            "nextDialogs": [
              "790700108"
            ]
          },
          "790700108": {
            "id": "790700108",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "When the time is right, I will make a detailed record of all that happened and then inform my people in writing.",
            "nextDialogs": [
              "790700109"
            ]
          },
          "790700109": {
            "id": "790700109",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "But until then, I will still preside over all the affairs of the kingdom as its \"Princess.\"",
            "nextDialogs": [
              "790700110"
            ]
          },
          "790700110": {
            "id": "790700110",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Once those \"trial grounds\" have been officially converted into \"training grounds,\" I will set off.",
            "nextDialogs": [
              "790700113"
            ]
          },
          "790700113": {
            "id": "790700113",
            "speakerId": 21466,
            "speakerName": "Faurobert",
            "text": "Your Highness, do you still remember... Who the relic actually lit up for back in the cave?",
            "nextDialogs": [
              "790700114"
            ]
          },
          "790700114": {
            "id": "790700114",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Hmm? Who it... actually lit up for?",
            "nextDialogs": [
              "790700115"
            ]
          },
          "790700115": {
            "id": "790700115",
            "speakerId": 21466,
            "speakerName": "Faurobert",
            "text": "Yes, as we were both next to it at the time. Of course, Your Highness fully deserves to be acknowledged, but I on the other hand... I...",
            "nextDialogs": [
              "790700116"
            ]
          },
          "790700116": {
            "id": "790700116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're a champion who's been acknowledged by a champion.",
            "nextDialogs": [
              "790700117"
            ]
          },
          "790700117": {
            "id": "790700117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Exactly, and that champion came specifically to ask for your help! How could you possibly still think you're unworthy?",
            "nextDialogs": [
              "790700118"
            ]
          },
          "790700118": {
            "id": "790700118",
            "speakerId": 21466,
            "speakerName": "Faurobert",
            "text": "*sigh* Maybe it's simply that you shine so brightly, Your Highness, that everyone was mistaken...",
            "nextDialogs": [
              "790700119"
            ]
          },
          "790700119": {
            "id": "790700119",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Pfft... Well then, Mr. Champion, would you be willing to undergo another trial?",
            "nextDialogs": [
              "790700120"
            ]
          },
          "790700120": {
            "id": "790700120",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "I, Princess Cimest of the Kingdom of Breezes and Bells, shall personally bear witness to your deeds with this relic.",
            "nextDialogs": [
              "790700121"
            ]
          },
          "790700121": {
            "id": "790700121",
            "speakerId": 21466,
            "speakerName": "Faurobert",
            "text": "Of course! I do, I do, I do!"
          }
        }
      }
    },
    {
      "subId": "7907002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790700201"
        ],
        "dialogs": {
          "790700201": {
            "id": "790700201",
            "speakerId": 21466,
            "speakerName": "Faurobert",
            "text": "Estampe! Where have you been!?",
            "nextDialogs": [
              "790700202"
            ]
          },
          "790700202": {
            "id": "790700202",
            "speakerId": 16059,
            "speakerName": "Estampe",
            "text": "Uhh, actually, I was strolling about the area, and had a go at that trial. It was fun, but I had to adopt a slightly different approach to pass it.",
            "nextDialogs": [
              "790700203"
            ]
          },
          "790700203": {
            "id": "790700203",
            "speakerId": 16059,
            "speakerName": "Estampe",
            "text": "Mr. Horellou has filled me in on everything that has happened to you. Not bad, Mr. Guardian. Turns out you're pretty talented after all, eh?",
            "nextDialogs": [
              "790700204"
            ]
          },
          "790700204": {
            "id": "790700204",
            "speakerId": 21466,
            "speakerName": "Faurobert",
            "text": "Y—Y—You... If you'd been standing next to me, I'd have pushed you off, I tell you! I'd have pushed you off ten times if I had the chance!",
            "nextDialogs": [
              "790700205"
            ]
          },
          "790700205": {
            "id": "790700205",
            "speakerId": 16059,
            "speakerName": "Estampe",
            "text": "Hence why I decided to take part in the trial instead. Faurobert, my friend, I always believed you could do it. And look... You did it!",
            "nextDialogs": [
              "790700206"
            ]
          },
          "790700206": {
            "id": "790700206",
            "speakerId": 16117,
            "speakerName": "Horellou",
            "text": "Hahaha, you're jolly good fellows, the both of you. Today is an auspicious day for our pond!",
            "nextDialogs": [
              "790700207"
            ]
          },
          "790700207": {
            "id": "790700207",
            "speakerId": 16117,
            "speakerName": "Horellou",
            "text": "Finally, we have a true champion. Though Mr. Faurobert hasn't saved a princess yet, I believe that his chance will come.",
            "nextDialogs": [
              "790700208"
            ]
          },
          "790700208": {
            "id": "790700208",
            "speakerId": 21466,
            "speakerName": "Faurobert",
            "text": "*sigh* But I really didn't do anything, Mr. Horellou, other than standing by and watching as Her Highness did all the heavy lifting...",
            "nextDialogs": [
              "790700209"
            ]
          },
          "790700209": {
            "id": "790700209",
            "speakerId": 16117,
            "speakerName": "Horellou",
            "text": "Isn't that even better? Surely you didn't want the princess to be in danger?",
            "nextDialogs": [
              "790700210"
            ]
          },
          "790700210": {
            "id": "790700210",
            "speakerId": 21466,
            "speakerName": "Faurobert",
            "text": "I... Uh...",
            "nextDialogs": [
              "790700211"
            ]
          },
          "790700211": {
            "id": "790700211",
            "speakerId": 16117,
            "speakerName": "Horellou",
            "text": "Ahh, that's quite enough, Mr. Faurobert. You were entrusted to fulfill the calling by Cibrelus himself!",
            "nextDialogs": [
              "790700212"
            ]
          },
          "790700212": {
            "id": "790700212",
            "speakerId": 21466,
            "speakerName": "Faurobert",
            "text": "Oh, pish posh! I'm not even sure if it was Cibrelus! After all, I've only ever heard of him, never heard him speak!",
            "nextDialogs": [
              "790700213"
            ]
          },
          "790700213": {
            "id": "790700213",
            "speakerId": 16059,
            "speakerName": "Estampe",
            "text": "And you even accepted the princess's trial. You're a champion if ever there was one.",
            "nextDialogs": [
              "790700214"
            ]
          },
          "790700214": {
            "id": "790700214",
            "speakerId": 21466,
            "speakerName": "Faurobert",
            "text": "Can we just... Not talk about this for now? Please...",
            "nextDialogs": [
              "790700215"
            ]
          },
          "790700215": {
            "id": "790700215",
            "speakerId": 16117,
            "speakerName": "Horellou",
            "text": "Anyway, to sum up — the future of Rainsong Pond is now in your capable hands!",
            "nextDialogs": [
              "790700216"
            ]
          },
          "790700216": {
            "id": "790700216",
            "speakerId": 16117,
            "speakerName": "Horellou",
            "text": "Now, we can simply enjoy jumping for jumping's own sake! When I get back, I'll suggest to the committee that we make \"fun\" the focus going forward!",
            "nextDialogs": [
              "790700217"
            ]
          },
          "790700217": {
            "id": "790700217",
            "speakerId": 16059,
            "speakerName": "Estampe",
            "text": "That sounds like a proposal I'd be willing to get behind. On that note, let's head back.",
            "nextDialogs": [
              "790700218"
            ]
          },
          "790700218": {
            "id": "790700218",
            "speakerId": 21466,
            "speakerName": "Faurobert",
            "text": "Hey, don't leave me here!"
          }
        }
      }
    },
    {
      "subId": "7907003",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790700301"
        ],
        "dialogs": {
          "790700301": {
            "id": "790700301",
            "speakerId": 21471,
            "speakerName": "Saborn",
            "text": "Both you and that paper frog were acknowledged as Guardians, Your Highness!?",
            "nextDialogs": [
              "790700302"
            ]
          },
          "790700302": {
            "id": "790700302",
            "speakerId": 21472,
            "speakerName": "Souffache",
            "text": "Unbelievable, unheard of! There is simply no precedent for this!",
            "nextDialogs": [
              "790700303"
            ]
          },
          "790700303": {
            "id": "790700303",
            "speakerId": 21471,
            "speakerName": "Saborn",
            "text": "And you'll have to make changes to the trial too... No, don't do this, Your Highness!",
            "nextDialogs": [
              "790700304"
            ]
          },
          "790700304": {
            "id": "790700304",
            "speakerId": 21472,
            "speakerName": "Souffache",
            "text": "You can't simply overhaul such an ancient tradition on a whim, Your Highness!",
            "nextDialogs": [
              "790700305"
            ]
          },
          "790700305": {
            "id": "790700305",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Alright, alright, keep your voices down. My ears are starting to hurt...",
            "nextDialogs": [
              "790700306"
            ]
          },
          "790700306": {
            "id": "790700306",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "It's all been decided already. Now, given that I am both a princess and a Guardian who has been acknowledged by the relic, you're in even less of a position to stop me.",
            "nextDialogs": [
              "790700307"
            ]
          },
          "790700307": {
            "id": "790700307",
            "speakerId": 21471,
            "speakerName": "Saborn",
            "text": "But, Your Highness...",
            "nextDialogs": [
              "790700308"
            ]
          },
          "790700308": {
            "id": "790700308",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "The both of you may relax. I'll host a ceremony to train up hosts of reliable flying squirrels to defend the kingdom.",
            "nextDialogs": [
              "790700309"
            ]
          },
          "790700309": {
            "id": "790700309",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Only after that will I leave the kingdom.",
            "nextDialogs": [
              "790700310"
            ]
          },
          "790700310": {
            "id": "790700310",
            "speakerId": 21472,
            "speakerName": "Souffache",
            "text": "Your Highness, we... *sigh* You...",
            "nextDialogs": [
              "790700311"
            ]
          },
          "790700311": {
            "id": "790700311",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "Don't worry, you two. I can take care of myself.",
            "nextDialogs": [
              "790700312"
            ]
          },
          "790700312": {
            "id": "790700312",
            "speakerId": 21470,
            "speakerName": "Cimest",
            "text": "As the princess, in the end it is I who shall face the wild winds of the world on my own.",
            "nextDialogs": [
              "790700313"
            ]
          },
          "790700313": {
            "id": "790700313",
            "speakerId": 21471,
            "speakerName": "Saborn",
            "text": "...As you wish, Your Highness."
          }
        }
      }
    }
  ]
}
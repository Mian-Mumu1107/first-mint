            "speakerId": 10205,
            "speakerName": "???",
            "text": "...",
            "nextDialogs": [
              "750290104"
            ]
          },
          "750290104": {
            "id": "750290104",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Hahahahaha!",
            "nextDialogs": [
              "750290105"
            ]
          },
          "750290105": {
            "id": "750290105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eek, you almost scared Paimon to death!",
            "nextDialogs": [
              "750290106"
            ]
          },
          "750290106": {
            "id": "750290106",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I take it you're here for the special training too!?",
            "nextDialogs": [
              "750290107"
            ]
          },
          "750290107": {
            "id": "750290107",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I knew it, I just knew it! Be they human or Saurian, ambitious warriors are always drawn to one another!",
            "nextDialogs": [
              "750290108"
            ]
          },
          "750290108": {
            "id": "750290108",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Well then, without any further ado, let's dive straight into the special training!"
          }
        }
      }
    },
    {
      "subId": "7502905",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750290501"
        ],
        "dialogs": {
          "750290501": {
            "id": "750290501",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "Warrior! How is your training on this course?",
            "nextDialogs": [
              "750290503",
              "750290505"
            ]
          },
          "750290503": {
            "id": "750290503",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "Pah, weak! If you're not taking a step forward, then it's a step back!",
            "nextDialogs": [
              "750290506"
            ]
          },
          "750290506": {
            "id": "750290506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, how should Paimon put this... It seems like \"forward\" and its synonyms are the only words in Matahga's dictionary.",
            "nextDialogs": [
              "750290507"
            ]
          },
          "750290507": {
            "id": "750290507",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "Indeed, I am more focused than others! Know why? Because hard work is the only thing I acknowledge.",
            "nextDialogs": [
              "750290508"
            ]
          },
          "750290508": {
            "id": "750290508",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "You need training, and so do I. Training to work with Saurians alone won't make me an all-round warrior!",
            "nextDialogs": [
              "750290509"
            ]
          },
          "750290509": {
            "id": "750290509",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "I must seek a larger stage to hone myself! And that means I'll be leaving for some time.",
            "nextDialogs": [
              "750290510"
            ]
          },
          "750290510": {
            "id": "750290510",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "Don't worry! I'll keep the course here intact, but I'll be dismantling this cabin and taking it with me."
          },
          "750290505": {
            "id": "750290505",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "Such indolence! Don't tell me, you've been wasting your life on meaningless wandering?"
          }
        }
      }
    },
    {
      "subId": "7502907",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750290701"
        ],
        "dialogs": {
          "750290701": {
            "id": "750290701",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "Wonderful! You've outdone me, Warrior! But don't slack off now — keep pushing forward to become an even greater hero!"
          }
        }
      }
    },
    {
      "subId": "7502903",
      "subQuestName": "Start the special training!",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7502904",
      "subQuestName": "Talk to Matahga",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750290201"
        ],
        "dialogs": {
          "750290201": {
            "id": "750290201",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "Wonderful, outstanding! You've surpassed me, outdone me!",
            "nextDialogs": [
              "750290202"
            ]
          },
          "750290202": {
            "id": "750290202",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "I've been keeping up with my special training, all by myself, in the hope that I would one day succeed at breaking my own record. Unfortunately, that's something I still haven't managed to do.",
            "nextDialogs": [
              "750290203"
            ]
          },
          "750290203": {
            "id": "750290203",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "But you did it! You've proven to me that I should leave this place, as there must be many more warriors out there in the world whose deeds eclipse my own!",
            "nextDialogs": [
              "750290204"
            ]
          },
          "750290204": {
            "id": "750290204",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "I'll surely be able to improve myself by sparring and exchanging pointers with them. Some day, my father and sister will acknowledge my accomplishments — just you wait!",
            "nextDialogs": [
              "750290205"
            ]
          },
          "750290205": {
            "id": "750290205",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "Acomitl aside, of course. That layabout has zero ambition. I'm ashamed to call him my brother.",
            "nextDialogs": [
              "750290206"
            ]
          },
          "750290206": {
            "id": "750290206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Acomitl...?",
            "nextDialogs": [
              "750290207"
            ]
          },
          "750290207": {
            "id": "750290207",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "Uh, never mind. That's enough chit-chat.",
            "nextDialogs": [
              "750290208"
            ]
          },
          "750290208": {
            "id": "750290208",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "Warrior, hear me now! Never stop honing your skills!",
            "nextDialogs": [
              "750290209"
            ]
          },
          "750290209": {
            "id": "750290209",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "If you want to become a legend, you must charge forward with all your might! Forward, hear me, forward! These words are my parting gift to you."
          }
        }
      }
    },
    {
      "subId": "7502906",
      "subQuestName": "Talk to Matahga",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7502908",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750290801"
        ],
        "dialogs": {
          "750290801": {
            "id": "750290801",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "I will become a warrior! No, a hero! Just you wait and see."
          }
        }
      }
    },
    {
      "subId": "7502906",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750290601"
        ],
        "dialogs": {
          "750290601": {
            "id": "750290601",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "You weren't bad, so keep it up. I know you can do it...",
            "nextDialogs": [
              "750290602"
            ]
          },
          "750290602": {
            "id": "750290602",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "Pah, you didn't really think those were the words I would leave you with, did you? No! Being \"not bad\" and \"making do\" isn't the warrior's way!",
            "nextDialogs": [
              "750290603"
            ]
          },
          "750290603": {
            "id": "750290603",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "You should only strive to be the best! Anyone who fails to do so is a failure, pure and simple!",
            "nextDialogs": [
              "750290604"
            ]
          },
          "750290604": {
            "id": "750290604",
            "speakerId": 6136,
            "speakerName": "Matahga",
            "text": "As long as you still have the courage, then keep trying! Train until you can surpass me!"
          }
        }
      }
    },
    {
      "subId": "7502913",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750291301"
        ],
        "dialogs": {
          "750291301": {
            "id": "750291301",
            "speakerId": 21736,
            "speakerName": "Eye-Catching Slogan",
            "text": "The Soaring Saurian is open all day! If you wish to join Matahga's special training, then come lift off from the Soaring Saurian! Note: Just as serious, proactive training is a cause for great pride, so laziness and slacking off is a source of great shame!",
            "nextDialogs": [
              "750291302"
            ]
          },
          "750291302": {
            "id": "750291302",
            "speakerId": 21736,
            "speakerName": "Eye-Catching Slogan",
            "text": "Laze about today, and be as trash tomorrow!",
            "nextDialogs": [
              "750291303"
            ]
          },
          "750291303": {
            "id": "750291303",
            "speakerId": 21736,
            "speakerName": "Eye-Catching Slogan",
            "text": "Only those who push forward boldly shall truly know greatness as Saurian riders!"
          }
        }
      }
    },
    {
      "subId": "7502914",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750291401"
        ],
        "dialogs": {
          "750291401": {
            "id": "750291401",
            "speakerId": 21737,
            "speakerName": "Matahga! Remember!!!",
            "text": "The order is: <color=#00E1FFFF>Blow the left horn first, then the right one, and finally the left again</color>! Don't mix it up!",
            "nextDialogs": [
              "750291402"
            ]
          },
          "750291402": {
            "id": "750291402",
            "speakerId": 21737,
            "speakerName": "Matahga! Remember!!!",
            "text": "(Seems like a reminder that someone called Matahga left for themselves. You can really feel the intensity of the emotion in their words.)",
            "nextDialogs": [
              "750291403"
            ]
          },
          "750291403": {
            "id": "750291403",
            "speakerId": 21737,
            "speakerName": "Matahga! Remember!!!",
            "text": "(But surely putting exclamation marks at the end of every reminder is the same as putting none... Isn't it?)"
          }
        }
      }
    }
  ]
}
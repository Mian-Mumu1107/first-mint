    {
      "subId": "7451904",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745190401"
        ],
        "dialogs": {
          "745190401": {
            "id": "745190401",
            "speakerId": 1027,
            "speakerName": "Noelle",
            "text": "Oh, hello there, Honorary Knight! Are you here to see Master Jean... Or is there something I can help you with?",
            "nextDialogs": [
              "745190404"
            ]
          },
          "745190404": {
            "id": "745190404",
            "speakerId": 1027,
            "speakerName": "Noelle",
            "text": "I'm currently conducting a routine cleanup of the area around the Knights of Favonius offices. Most of the dust has been cleaned out at this point. Next, I'll be re-organizing our old files.",
            "nextDialogs": [
              "745190405"
            ]
          },
          "745190405": {
            "id": "745190405",
            "speakerId": 1027,
            "speakerName": "Noelle",
            "text": "Those documents have piled up for a while now. I'm thinking that everyone will have an easier time looking them up if I sort them into different categories.",
            "nextDialogs": [
              "745190406"
            ]
          },
          "745190406": {
            "id": "745190406",
            "speakerId": 1027,
            "speakerName": "Noelle",
            "text": "Also, I can learn a lot from those who came before me in the process. That's a form of training too, isn't it?",
            "nextDialogs": [
              "745190407"
            ]
          },
          "745190407": {
            "id": "745190407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're as serious about your work as ever, Noelle.",
            "nextDialogs": [
              "745190408"
            ]
          },
          "745190408": {
            "id": "745190408",
            "speakerId": 1027,
            "speakerName": "Noelle",
            "text": "Just doing my duty. You and the other Knights are always pushing forward, so I've got to catch up as soon as I can."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "1103001",
      "subQuestName": "Talk to the Jade Chamber secretaries",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300101"
        ],
        "dialogs": {
          "110300101": {
            "id": "110300101",
            "speakerId": 1000,
            "speakerName": "Baixiao",
            "text": "It's shocking how much work there is to do, even for the three of us...",
            "nextDialogs": [
              "110300102"
            ]
          },
          "110300102": {
            "id": "110300102",
            "speakerId": 1001,
            "speakerName": "Baishi",
            "text": "And she's been handling it alone all along... The Qixing's secretary clearly isn't an ordinary person. It's so frustrating...",
            "nextDialogs": [
              "110300103"
            ]
          },
          "110300103": {
            "id": "110300103",
            "speakerId": 1002,
            "speakerName": "Baiwen",
            "text": "Huh. You're...",
            "nextDialogs": [
              "110300104"
            ]
          },
          "110300104": {
            "id": "110300104",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Aren't you Ningguang's servants? How come you're here?",
            "nextDialogs": [
              "110300105"
            ]
          },
          "110300105": {
            "id": "110300105",
            "speakerId": 1000,
            "speakerName": "Baixiao",
            "text": "Ahem... We are Ms. Ningguang's private secretaries, not servants.",
            "nextDialogs": [
              "110300106"
            ]
          },
          "110300106": {
            "id": "110300106",
            "speakerId": 1002,
            "speakerName": "Baiwen",
            "text": "Have you seen Ms. Ganyu, Traveler?",
            "nextDialogs": [
              "110300107"
            ]
          },
          "110300107": {
            "id": "110300107",
            "speakerId": 1002,
            "speakerName": "Baiwen",
            "text": "It has been several days since Ganyu left for Jueyun Karst. She's the General Secretary of the Liyue Qixing. We've only taken over her responsibilities until she gets back...",
            "nextDialogs": [
              "110300110"
            ]
          },
          "110300110": {
            "id": "110300110",
            "speakerId": 1000,
            "speakerName": "Baixiao",
            "text": "Ah, even though the Qixing have made peace with the adepti after the latter had denounced Liyue, they still want to pay their respects to the illuminated ones...",
            "nextDialogs": [
              "110300111"
            ]
          },
          "110300111": {
            "id": "110300111",
            "speakerId": 1000,
            "speakerName": "Baixiao",
            "text": "They commissioned Ganyu as their envoy to deliver a letter to Jueyun Karst and bring the adepti the latest news about the crisis.",
            "nextDialogs": [
              "110300112"
            ]
          },
          "110300112": {
            "id": "110300112",
            "speakerId": 1000,
            "speakerName": "Baixiao",
            "text": "Still... Ganyu should have been back to her usual responsibilities by now, but she's disappeared without a trace.",
            "nextDialogs": [
              "110300113"
            ]
          },
          "110300113": {
            "id": "110300113",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Is that so... Maybe Ganyu just took a little detour? Who can blame her, after working so hard?",
            "nextDialogs": [
              "110300114"
            ]
          },
          "110300114": {
            "id": "110300114",
            "speakerId": 1002,
            "speakerName": "Baiwen",
            "text": "I'm afraid it's not very likely... Ever since we met Ms. Ganyu, she's been nothing but the most conscientious person in all of Liyue.",
            "nextDialogs": [
              "110300115"
            ]
          },
          "110300115": {
            "id": "110300115",
            "speakerId": 1002,
            "speakerName": "Baiwen",
            "text": "Even when it's time for her annual leave, Ms. Ganyu stays on duty at Yuehai Pavilion, saying that \"there is still so much to do.\"",
            "nextDialogs": [
              "110300116"
            ]
          },
          "110300116": {
            "id": "110300116",
            "speakerId": 1002,
            "speakerName": "Baiwen",
            "text": "She couldn't possibly be using her mission as an excuse to slack off.",
            "nextDialogs": [
              "110300117"
            ]
          },
          "110300117": {
            "id": "110300117",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Oh, Paimon sees how it is... But she's half-adeptus. She wouldn't get in trouble, right? Why do you look so upset...",
            "nextDialogs": [
              "110300118"
            ]
          },
          "110300118": {
            "id": "110300118",
            "speakerId": 1001,
            "speakerName": "Baishi",
            "text": "Well... It's because of this absurd workload of hers!",
            "nextDialogs": [
              "110300119"
            ]
          },
          "110300119": {
            "id": "110300119",
            "speakerId": 1001,
            "speakerName": "Baishi",
            "text": "*sigh* When we first heard the three of us would be taking over for Ms. Ganyu, we thought it would simply be a matter of changing our work environment.",
            "nextDialogs": [
              "110300120"
            ]
          },
          "110300120": {
            "id": "110300120",
            "speakerId": 1000,
            "speakerName": "Baixiao",
            "text": "We couldn't have imagined that Ms. Ganyu's daily workload far exceeds what the three of us are used to doing."
          }
        }
      }
    },
    {
      "subId": "1103002",
      "subQuestName": "Head near Mt. Aocang to look for Ganyu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300201"
        ],
        "dialogs": {
          "110300201": {
            "id": "110300201",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Ganyu! Here you are!",
            "nextDialogs": [
              "110300202"
            ]
          },
          "110300202": {
            "id": "110300202",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "You two... I did not expect to meet you here. Is it official or private affairs that bring you here?",
            "nextDialogs": [
              "110300203"
            ]
          },
          "110300203": {
            "id": "110300203",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "Ah, I shouldn't... I have left the human world. Please contact the Yuehai Pavilion regarding matters concerning the commercial port.",
            "nextDialogs": [
              "110300206"
            ]
          },
          "110300206": {
            "id": "110300206",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Huh, you don't want to be the Qixing's secretary anymore? But they're all waiting for you to come back...",
            "nextDialogs": [
              "110300207"
            ]
          },
          "110300207": {
            "id": "110300207",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "That's why you're here? You want me to come back? I'm afraid you came here in vain.",
            "nextDialogs": [
              "110300208"
            ]
          },
          "110300208": {
            "id": "110300208",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "What? Did something happen?",
            "nextDialogs": [
              "110300209"
            ]
          },
          "110300209": {
            "id": "110300209",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "The clouds fold and unfold, the tide ebbs and flows. It was meant to be.",
            "nextDialogs": [
              "110300210"
            ]
          },
          "110300210": {
            "id": "110300210",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "When the adepti entrusted humans with overseeing Liyue, I knew it was only a matter of time until I had to leave.",
            "nextDialogs": [
              "110300211"
            ]
          },
          "110300211": {
            "id": "110300211",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "My adepti blood makes me unwelcome in Liyue Harbor.",
            "nextDialogs": [
              "110300212"
            ]
          },
          "110300212": {
            "id": "110300212",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "I delivered the letter and came back to Liyue Harbor only to discover that I had been replaced by Baiwen, Baixiao, and Baishi...",
            "nextDialogs": [
              "110300213"
            ]
          },
          "110300213": {
            "id": "110300213",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "Perhaps that mission of mine was just a pretext to remove me. Since the Qixing gave me a chance to leave with dignity, I decided to be tactful, as well."
          }
        }
      }
    },
    {
      "subId": "1103003",
      "subQuestName": "Find and talk to Ganyu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1103004",
      "subQuestName": "Head to the site of Ganyu's trial and speak to her",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300301"
        ],
        "dialogs": {
          "110300301": {
            "id": "110300301",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "So here you are, Ganyu!",
            "nextDialogs": [
              "110300302"
            ]
          },
          "110300302": {
            "id": "110300302",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "Why did you come here?",
            "nextDialogs": [
              "110300304",
              "110300308"
            ]
          },
          "110300304": {
            "id": "110300304",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "Ah, I... Humans should not remain in the realm of adepti for too long.",
            "nextDialogs": [
              "110300305"
            ]
          },
          "110300305": {
            "id": "110300305",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "Hmm... Considering the kindness you have shown me, I can let you stay for the adeptus training.",
            "nextDialogs": [
              "110300306"
            ]
          },
          "110300306": {
            "id": "110300306",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Yay~!",
            "nextDialogs": [
              "110300309"
            ]
          },
          "110300309": {
            "id": "110300309",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "This trial was prepared by Cloud Retainer. Its goal is to help me feel like an adeptus again.",
            "nextDialogs": [
              "110300310"
            ]
          },
          "110300310": {
            "id": "110300310",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "The training is much to her signature style... I hope it won't make it seem like she is too unaware of the abilities of others.",
            "nextDialogs": [
              "110300311"
            ]
          },
          "110300311": {
            "id": "110300311",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "I—Is it difficult?",
            "nextDialogs": [
              "110300312"
            ]
          },
          "110300312": {
            "id": "110300312",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "No, I'm aware of your strength, Traveler. The power hidden within you is not inferior to mine.",
            "nextDialogs": [
              "110300313"
            ]
          },
          "110300313": {
            "id": "110300313",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "If you're ready, we shall begin the training."
          },
          "110300308": {
            "id": "110300308",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "Is that so? You really are interested in the ways of adepti."
          }
        }
      }
    },
    {
      "subId": "1103005",
      "subQuestName": "Complete Cloud Retainer's trial",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300501"
        ],
        "dialogs": {
          "110300501": {
            "id": "110300501",
            "speakerId": 1005,
            "speakerName": "Xiao",
            "text": "You're half an hour late... I see you still haven't abandoned the wrongful ways of humankind.",
            "nextDialogs": [
              "110300502"
            ]
          },
          "110300502": {
            "id": "110300502",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "I'm sorry, I had a meeting with Cloud Retainer, I...",
            "nextDialogs": [
              "110300503"
            ]
          },
          "110300503": {
            "id": "110300503",
            "speakerId": 1005,
            "speakerName": "Xiao",
            "text": "I don't need your explanations and don't require any mutual understanding between us. I'm just helping you with your training, that's all.",
            "nextDialogs": [
              "110300504"
            ]
          },
          "110300504": {
            "id": "110300504",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Xiao is such a strict teacher.",
            "nextDialogs": [
              "110300505"
            ]
          },
          "110300505": {
            "id": "110300505",
            "speakerId": 1005,
            "speakerName": "Xiao",
            "text": "You're neither an adeptus, nor a human, always treading the line between the two worlds. It must create a lot of confusion.",
            "nextDialogs": [
              "110300506"
            ]
          },
          "110300506": {
            "id": "110300506",
            "speakerId": 1005,
            "speakerName": "Xiao",
            "text": "Instead of explaining yourself to me, you should face your true self.",
            "nextDialogs": [
              "110300507"
            ]
          },
          "110300507": {
            "id": "110300507",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "I... I have nothing to hide.",
            "nextDialogs": [
              "110300510"
            ]
          },
          "110300510": {
            "id": "110300510",
            "speakerId": 1005,
            "speakerName": "Xiao",
            "text": "The body and the mind are one. If something worries your mind, your body can help you find a solution.",
            "nextDialogs": [
              "110300511"
            ]
          },
          "110300511": {
            "id": "110300511",
            "speakerId": 1005,
            "speakerName": "Xiao",
            "text": "The trial I've prepared for you will explore the true potential of your body.",
            "nextDialogs": [
              "110300512"
            ]
          },
          "110300512": {
            "id": "110300512",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "Yes, I'm ready."
          }
        }
      }
    },
    {
      "subId": "1103006",
      "subQuestName": "Talk to Ganyu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300401"
        ],
        "dialogs": {
          "110300401": {
            "id": "110300401",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "We've completed the task. What do you think?",
            "nextDialogs": [
              "110300403",
              "110300405"
            ]
          },
          "110300403": {
            "id": "110300403",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "I agree. You possess many qualities similar to those of adepti, despite having none of their blood.",
            "nextDialogs": [
              "110300406"
            ]
          },
          "110300406": {
            "id": "110300406",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Ganyu, what were you planning to do once your training was over?",
            "nextDialogs": [
              "110300407"
            ]
          },
          "110300407": {
            "id": "110300407",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "The training's not over yet. The part prepared by Cloud Retainer is only the first trial.",
            "nextDialogs": [
              "110300408"
            ]
          },
          "110300408": {
            "id": "110300408",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Huh? So there are more trials, prepared by other adepti?"
          },
          "110300405": {
            "id": "110300405",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "Hardships are a fact of life, both for the adepti and humans alike."
          }
        }
      }
    },
    {
      "subId": "1103007",
      "subQuestName": "Go to Nantianmen and speak with Xiao",

    {
      "subId": "1103008",
      "subQuestName": "Complete Xiao's trial",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300801"
        ],
        "dialogs": {
          "110300801": {
            "id": "110300801",
            "speakerId": 1005,
            "speakerName": "Xiao",
            "text": "Focus on the trial. I'm not here for idle chatter."
          }
        }
      }
    },
    {
      "subId": "1103009",
      "subQuestName": "Talk to Xiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300601"
        ],
        "dialogs": {
          "110300601": {
            "id": "110300601",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "I've completed your trial.",
            "nextDialogs": [
              "110300602"
            ]
          },
          "110300602": {
            "id": "110300602",
            "speakerId": 1005,
            "speakerName": "Xiao",
            "text": "You don't have to report back to me. Seeking other people's validation won't benefit your training.",
            "nextDialogs": [
              "110300603"
            ]
          },
          "110300603": {
            "id": "110300603",
            "speakerId": 1005,
            "speakerName": "Xiao",
            "text": "Only you can evaluate the result of this trial. You'll progress faster that way.",
            "nextDialogs": [
              "110300604"
            ]
          },
          "110300604": {
            "id": "110300604",
            "speakerId": 1004,
            "speakerName": "Ganyu",
            "text": "Um... Understood.",
            "nextDialogs": [
              "110300605"
            ]
          },
          "110300605": {
            "id": "110300605",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Xiao always has such strong opinions.",
            "nextDialogs": [
              "110300608"
            ]
          },
          "110300608": {
            "id": "110300608",
            "speakerId": 1005,
            "speakerName": "Xiao",
            "text": "From tomorrow on, I'll start raising the difficulty of your training, so you'll have to...",
            "nextDialogs": [
              "110300609"
            ]
          },
          "110300609": {
            "id": "110300609",
            "speakerId": 1005,
            "speakerName": "Xiao",
            "text": "...",
            "nextDialogs": [
              "110300610"
            ]
          },
          "110300610": {
            "id": "110300610",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Have to do what?",
            "nextDialogs": [
              "110300611"
            ]
          },
          "110300611": {
            "id": "110300611",
            "speakerId": 1005,
            "speakerName": "Xiao",
            "text": "Huh... Another one of those pesky visitors...",
            "nextDialogs": [
              "110300612"
            ]
          },
          "110300612": {
            "id": "110300612",
            "speakerId": 1005,
            "speakerName": "Xiao",
            "text": "I'll leave him to you, Ganyu. It's also a part of your training.",
            "nextDialogs": [
              "110300613"
            ]
          },
          "110300613": {
            "id": "110300613",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Pesky visitor? So even here there are those that Xiao can't deal with?",
            "nextDialogs": [
              "110300614"
            ]
          },
          "110300614": {
            "id": "110300614",
            "speakerId": 1006,
            "speakerName": "Xin Cheng",
            "text": "Oh—Oh heavens! Blessed be Rex Lapis, I've finally come upon the adepti!",
            "nextDialogs": [
              "110300615"
            ]
          },
          "110300615": {
            "id": "110300615",
            "speakerId": 1006,
            "speakerName": "Xin Cheng",
            "text": "Are all of you the adepti of this mountain?",
            "nextDialogs": [
              "110300616"
            ]
          },
          "110300616": {
            "id": "110300616",
            "speakerId": 1006,
            "speakerName": "Xin Cheng",
            "text": "Great! My name's Xin Cheng. I came to ask for your merciful blessings, O adepti! I beg of you, please grant me luck, wealth, and a good career!",
            "nextDialogs": [
              "110300617"
            ]
          },
          "110300617": {
            "id": "110300617",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Oh, so it's a pilgrim."
          }
        }
      }
    },

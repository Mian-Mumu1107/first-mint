    {
      "subId": "1103007",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110300701"
        ],
        "dialogs": {
          "110300701": {
            "id": "110300701",
            "speakerId": 1007,
            "speakerName": "Cloud Retainer",
            "text": "This trial will test her spirit.",
            "nextDialogs": [
              "110300702"
            ]
          },
          "110300702": {
            "id": "110300702",
            "speakerId": 1007,
            "speakerName": "Cloud Retainer",
            "text": "Even so, one hopes that it shall trouble her little..."
          }
        }

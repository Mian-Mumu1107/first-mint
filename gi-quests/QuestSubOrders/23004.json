          "230041201"
        ],
        "dialogs": {
          "230041201": {
            "id": "230041201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's sure we've met someone with a snake for a pet before... Right! It's that weirdo named Baizhu...",
            "nextDialogs": [
              "230041204"
            ]
          },
          "230041204": {
            "id": "230041204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's special food for pet snakes? Don't they eat mice and stuff?",
            "nextDialogs": [
              "230041205"
            ]
          },
          "230041205": {
            "id": "230041205",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "Yes, they did hunt by themselves in the past.",
            "nextDialogs": [
              "230041206"
            ]
          },
          "230041206": {
            "id": "230041206",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "But ever since they startled several children whilst feeding, I have banned them from going out without me. I've started making food for them.",
            "nextDialogs": [

            ]
          },
          "230041207": {
            "id": "230041207",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "*sigh* But after that, they haven't been moving much, and have stubbornly refused to eat any other food.",
            "nextDialogs": [
              "230041208"
            ]
          },
          "230041208": {
            "id": "230041208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*sigh* Paimon thought \"there was no such thing as a free lunch\"..."
          }
        }
      }
    },
    {
      "subId": "2300413",
      "subQuestName": "Report back to Gulabgir",
      "sceneId": null,
      "locations": [],

    {
      "subId": "2300416",
      "subQuestName": "Report back to Gulabgir",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230040501"
        ],
        "dialogs": {
          "230040501": {
            "id": "230040501",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "Yes! That's it! So I did leave it in the camp after all.",
            "nextDialogs": [
              "230040502"
            ]
          },
          "230040502": {
            "id": "230040502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "When we arrived, there were Fungi that were trying to swipe it.",
            "nextDialogs": [
              "230040503"
            ]
          },
          "230040503": {
            "id": "230040503",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "Fungi, huh... Phew, guess I was lucky to have you go instead. Thank you so much, Traveler.",
            "nextDialogs": [
              "230040504"
            ]
          },
          "230040504": {
            "id": "230040504",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "I can't thank you enough. Please, accept this as your payment.",
            "nextDialogs": [
              "230040505"
            ]
          },
          "230040505": {
            "id": "230040505",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "Here's your meal, little fellas..."
          }
        }
      }
    },
    {
      "subId": "2300419",
      "subQuestName": "Report back to Gulabgir",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230041901"
        ],
        "dialogs": {
          "230041901": {
            "id": "230041901",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "What's the matter? Anything else on your mind?",
            "nextDialogs": [
              "230041902"
            ]
          },
          "230041902": {
            "id": "230041902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I found something else in the camp."
          }
        }
      }
    },
    {
      "subId": "2300420",
      "subQuestName": "Report back to Gulabgir",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230042001"
        ],
        "dialogs": {
          "230042001": {
            "id": "230042001",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "Huh? This bead... How... Where did you find this?",
            "nextDialogs": [
              "230042002"
            ]
          },
          "230042002": {
            "id": "230042002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Inside a pot in the camp. Did you leave that behind?",
            "nextDialogs": [
              "230042003"
            ]
          },
          "230042003": {
            "id": "230042003",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "Ah, it was used in past shows. Whenever I play the flute, my little fellas would carry that bead on their heads and dance with their upper bodies in the air.",
            "nextDialogs": [
              "230042004"
            ]
          },
          "230042004": {
            "id": "230042004",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "But tricks of this kind have long ceased being profitable, and I haven't performed for quite some time either. I didn't even notice that it had gone missing...",
            "nextDialogs": [
              "230042005"
            ]
          },
          "230042005": {
            "id": "230042005",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "Anyway, thanks for bringing it back. Here's your payment, please take it."
          }
        }
      }
    },
    {
      "subId": "2300421",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230042101"
        ],
        "dialogs": {
          "230042101": {
            "id": "230042101",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "What's the matter? Anything else on your mind?",
            "nextDialogs": [
              "230042102"
            ]
          },
          "230042102": {
            "id": "230042102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I found something else in the camp."
          }
        }
      }
    },
    {
      "subId": "2300422",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230042201"
        ],
        "dialogs": {
          "230042201": {
            "id": "230042201",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "Huh? These hats... Hahaha, I made them for the snakes. How did I even forget these?",
            "nextDialogs": [
              "230042202"
            ]
          },
          "230042202": {
            "id": "230042202",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "I made each of them a nightcap so that they could attract children to the show.",
            "nextDialogs": [
              "230042203"
            ]
          },
          "230042203": {
            "id": "230042203",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "Red for Jori, green for Amum, yellow for Gana, and blue for Drak...",

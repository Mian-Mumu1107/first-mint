  "subQuests": [
    {
      "subId": "2300401",
      "subQuestName": "Talk to Gulabgir",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230040101"
        ],
        "dialogs": {
          "230040101": {
            "id": "230040101",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "Gone again... Um... Traveler! Could you please do me a favor?",
            "nextDialogs": [
              "230040102"
            ]
          },
          "230040102": {
            "id": "230040102",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "My food is missing!",
            "nextDialogs": [
              "230040103"
            ]
          },
          "230040103": {
            "id": "230040103",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "Uh, no, that can't be it! My pet snakes' food — that's what's missing!"
          }
        }
      }
    },
    {
      "subId": "2300402",
      "subQuestName": "Go to the camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230040201"
        ],
        "dialogs": {
          "230040201": {
            "id": "230040201",
            "speakerId": 4171,
            "speakerName": "Gulabgir",
            "text": "How did it go? Did you find the food?"
          }
        }
      }
    },

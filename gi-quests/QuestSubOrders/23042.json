  "subQuests": [
    {
      "subId": "2304201",
      "subQuestName": "Talk to Nermin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230420101"
        ],
        "dialogs": {
          "230420101": {
            "id": "230420101",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "This is definitely gonna be a surprise for Raef... Hehe...",
            "nextDialogs": [
              "230420102"
            ]
          },
          "230420102": {
            "id": "230420102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What surprise?",
            "nextDialogs": [
              "230420103"
            ]
          },
          "230420103": {
            "id": "230420103",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Whoa! Don't scare me like that, Traveler!",
            "nextDialogs": [
              "230420104"
            ]
          },
          "230420104": {
            "id": "230420104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's not like I sneaked up on you...",
            "nextDialogs": [
              "230420105"
            ]
          },
          "230420105": {
            "id": "230420105",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "I was thinking about something, so I didn't notice you.",
            "nextDialogs": [
              "230420106"
            ]
          },
          "230420106": {
            "id": "230420106",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Traveler, have you heard of something called \"perfume\"?",
            "nextDialogs": [
              "230420107"
            ]
          },
          "230420107": {
            "id": "230420107",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Granny Jawahir told me that she used to make perfume when she was young...",
            "nextDialogs": [
              "230420108"
            ]
          },
          "230420108": {
            "id": "230420108",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Not only can they cover up the smell of sweat on people's bodies, certain types of perfume have invigorating properties...",
            "nextDialogs": [
              "230420109"
            ]
          },
          "230420109": {
            "id": "230420109",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Raef has to guard the village all the time. He's always really sweaty from the heat and often complains about the sunlight making him dizzy...",
            "nextDialogs": [
              "230420110"
            ]
          },
          "230420110": {
            "id": "230420110",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "So I wanna make a bottle of Mint perfume for him.",
            "nextDialogs": [
              "230420111"
            ]
          },
          "230420111": {
            "id": "230420111",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Granny Jawahir wrote down the recipe for making perfume and helped me buy the ingredients...",
            "nextDialogs": [
              "230420112"
            ]
          },
          "230420112": {
            "id": "230420112",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "But making perfume is so much trickier than I expected... Just getting the ingredients ready took me a really long time. I made lots of mistakes along the way, too...",
            "nextDialogs": [
              "230420113"
            ]
          },
          "230420113": {
            "id": "230420113",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "If things go on like this, Raef's gonna find out I'm making perfume for him!",
            "nextDialogs": [
              "230420114"
            ]
          },
          "230420114": {
            "id": "230420114",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Traveler, could you help me prepare some ingredients? Be careful not to let Raef discover anything, okay?",
            "nextDialogs": [
              "230420116",
              "230420118"
            ]
          },
          "230420116": {
            "id": "230420116",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "I've been preparing this surprise for a long time. I'm not gonna let him know and ruin it all now!",
            "nextDialogs": [
              "230420119"
            ]
          },
          "230420119": {
            "id": "230420119",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "It's not a lot of work. Go find Mr. Azalai and pick up the goods I ordered, then fetch a small bucket of water. That's all!",
            "nextDialogs": [
              "230420120"
            ]
          },
          "230420120": {
            "id": "230420120",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Remember to keep it on the down low. Don't let Raef know!"
          },
          "230420118": {
            "id": "230420118",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Thanks once again. Don't worry, I'll be sure to make it worth your while!"
          }
        }
      }
    },
    {
      "subId": "2304202",
      "subQuestName": "Talk to Azalai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230420301"
        ],
        "dialogs": {
          "230420301": {
            "id": "230420301",
            "speakerId": 1001,
            "speakerName": "Azalai",
            "text": "Welcome! What do you need today?",
            "nextDialogs": [
              "230420302"
            ]
          },
          "230420302": {
            "id": "230420302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Nermin's order...",
            "nextDialogs": [
              "230420303"
            ]
          },
          "230420303": {
            "id": "230420303",
            "speakerId": 1001,
            "speakerName": "Azalai",
            "text": "Oh, Nermin's order... I have it prepared right here. These are all high-quality ingredients, and they're inexpensive, too.",
            "nextDialogs": [
              "230420304"
            ]
          },
          "230420304": {
            "id": "230420304",
            "speakerId": 1001,
            "speakerName": "Azalai",
            "text": "I'm guessing Nermin wants to make some perfume with these ingredients, right?",
            "nextDialogs": [
              "230420305"
            ]
          },
          "230420305": {
            "id": "230420305",
            "speakerId": 1001,
            "speakerName": "Azalai",
            "text": "*sigh* It's a good thing to be enthusiastic, but Nermin needs to take better care of herself..."
          }
        }
      }
    },
    {
      "subId": "2304203",
      "subQuestName": "Fetch a bucket of water",
      "sceneId": null,
      "locations": [],

      }
    },
    {
      "subId": "2304205",
      "subQuestName": "Report back to Nermin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230420501"
        ],
        "dialogs": {
          "230420501": {
            "id": "230420501",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Great, I still have some remaining ingredients from last time. With the new stuff you brought, I'll get to try a few more times before making the final product.",
            "nextDialogs": [
              "230420502"
            ]
          },
          "230420502": {
            "id": "230420502",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Whew... Let me look over my notes again. I'm sure I'll make it work this time!",
            "nextDialogs": [
              "230420503"
            ]
          },
          "230420503": {
            "id": "230420503",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Oh, I need a few flower petals as well...",
            "nextDialogs": [
              "230420504"
            ]
          },
          "230420504": {
            "id": "230420504",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Nermin nervously starts making the perfume...",
            "nextDialogs": [
              "230420505"
            ]
          },
          "230420505": {
            "id": "230420505",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "It's done! It smells pretty nice... And it didn't turn out all sticky either...",
            "nextDialogs": [
              "230420506"
            ]
          },
          "230420506": {
            "id": "230420506",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "That means I've succeeded this time, right...?",
            "nextDialogs": [
              "230420509"
            ]
          },
          "230420509": {
            "id": "230420509",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Yeah! Look, I even bought a bottle to put the perfume in!",
            "nextDialogs": [
              "230420510"
            ]
          },
          "230420510": {
            "id": "230420510",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Traveler, let's go give the perfume to Raef together. I hope he'll like it..."
          }
        }
      }
    },
    {
      "subId": "2304206",
      "subQuestName": "Give Raef the perfume",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230420601"
        ],
        "dialogs": {
          "230420601": {
            "id": "230420601",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "Nermin, and... the Traveler. What brings you here? Did you run into trouble?",
            "nextDialogs": [
              "230420602"
            ]
          },
          "230420602": {
            "id": "230420602",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "Don't tell me something's wrong with the flowers... I'm still on duty right now... When I'm done, I'll...",
            "nextDialogs": [
              "230420603"
            ]
          },
          "230420603": {
            "id": "230420603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Nermin has something for you.",
            "nextDialogs": [
              "230420604"
            ]
          },
          "230420604": {
            "id": "230420604",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Here, this bottle of perfume is for you! It's Mint-scented.",
            "nextDialogs": [
              "230420605"
            ]
          },
          "230420605": {
            "id": "230420605",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "I wanted to make it smell like Zaytun Peaches at first... But for some reason, once I added them into the mixture, the perfume became all sticky...",
            "nextDialogs": [
              "230420606"
            ]
          },
          "230420606": {
            "id": "230420606",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "Th—Thank you. But what is this... \"perfume\" supposed to be for?",
            "nextDialogs": [
              "230420607"
            ]
          },
          "230420607": {
            "id": "230420607",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Helping you stay alert! It also helps cover up the smell of your sweat. Don't you feel dizzy from getting drenched in sweat all day?",
            "nextDialogs": [
              "230420608"
            ]
          },
          "230420608": {
            "id": "230420608",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "Uh, I guess I'm used to it. It might feel a little awkward if the smell's suddenly gone...",
            "nextDialogs": [
              "230420609"
            ]
          },
          "230420609": {
            "id": "230420609",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Then don't use it. I'm taking it back.",
            "nextDialogs": [
              "230420610"
            ]
          },
          "230420610": {
            "id": "230420610",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "Hey, wait! I was just joking!",
            "nextDialogs": [
              "230420611"
            ]
          },
          "230420611": {
            "id": "230420611",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "Give me that perfume, quick! I'm starting to feel dizzy...",
            "nextDialogs": [
              "230420612"
            ]
          },
          "230420612": {
            "id": "230420612",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Here you go. You just have to apply it onto your arms — that's what Granny Jawahir said.",
            "nextDialogs": [
              "230420613"
            ]
          },
          "230420613": {
            "id": "230420613",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "The smell's not bad, and it's indeed quite refreshing. It feels nice and cool on my arms...",
            "nextDialogs": [
              "230420614"
            ]
          },
          "230420614": {
            "id": "230420614",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "Hmph! It's Granny Jawahir's secret recipe after all.",
            "nextDialogs": [
              "230420615"
            ]
          },
          "230420615": {
            "id": "230420615",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "I got to make such wonderful perfume thanks to the Traveler's help.",
            "nextDialogs": [
              "230420616"
            ]
          },
          "230420616": {
            "id": "230420616",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I just helped a little.",
            "nextDialogs": [
              "230420617"
            ]
          },
          "230420617": {
            "id": "230420617",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "Please forgive me for asking so many favors of you...",
            "nextDialogs": [
              "230420618"
            ]
          },
          "230420618": {
            "id": "230420618",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "These are for you. Just think of them as your compensation... Thank you so much.",
            "nextDialogs": [
              "230420619"
            ]
          },
          "230420619": {
            "id": "230420619",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "This perfume is indeed pretty handy...",
            "nextDialogs": [
              "230420620"
            ]
          },
          "230420620": {
            "id": "230420620",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "But... uh... Nermin, why are there red spots forming where I've applied it...?"
          }
        }
      }
    },
    {
      "subId": "2304207",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230420701"
        ],
        "dialogs": {
          "230420701": {
            "id": "230420701",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "How should I go about this step again? My notes... Where are my notes..."
          }
        }
      }
    },
    {
      "subId": "2304208",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230420801"
        ],
        "dialogs": {
          "230420801": {
            "id": "230420801",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "Traveler, what are you busy with this time? Running around like that...",
            "nextDialogs": [
              "230420802"
            ]
          },
          "230420802": {
            "id": "230420802",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "Oh yeah, have you been helping Nermin with anything lately? Or... perhaps heard any rumors about her?",
            "nextDialogs": [
              "230420803"
            ]
          },
          "230420803": {
            "id": "230420803",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "It feels like she's been really busy, but I have no idea what's going on...",
            "nextDialogs": [
              "230420805",
              "230420807"
            ]
          },
          "230420805": {
            "id": "230420805",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "Is that so? But I didn't see any new flower pots in her house..."
          },
          "230420807": {
            "id": "230420807",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "Huh? Is Hilmi and the others asking her for Minty Bean Soup again?",
            "nextDialogs": [
              "230420808"
            ]
          },
          "230420808": {
            "id": "230420808",
            "speakerId": 1003,
            "speakerName": "Raef",
            "text": "These kids... I need to talk to them when I have the time."
          }
        }
      }
    },
    {
      "subId": "2304209",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230420901"
        ],
        "dialogs": {
          "230420901": {
            "id": "230420901",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "*cough*... The smell... This doesn't seem right...",
            "nextDialogs": [
              "230420902"
            ]
          },
          "230420902": {
            "id": "230420902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you alright?",
            "nextDialogs": [
              "230420903"
            ]
          },
          "230420903": {
            "id": "230420903",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "I'm fine! I accidentally messed up a step in the procedure. Another failed attempt...",
            "nextDialogs": [
              "230420904"
            ]
          },
          "230420904": {
            "id": "230420904",
            "speakerId": 1000,
            "speakerName": "Nermin",
            "text": "But let's not talk about that for now. Did you get the ingredients?",
            "nextDialogs": [
              "230420905"
            ]
          },
          "230420905": {
            "id": "230420905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, got them right here."
          }
        }
      }
    },
    {
      "subId": "2304299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230429901"
        ],
        "dialogs": {
          "230429901": {
            "id": "230429901",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "This should be enough water. Let's get back to Nermin!"
          }
        }
      }
    }
  ]
}
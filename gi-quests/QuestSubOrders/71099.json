  },
  "subQuests": [
    {
      "subId": "7109901",
      "subQuestName": "Talk to Liu Su",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990101"
        ],
        "dialogs": {
          "710990101": {
            "id": "710990101",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Ugh, just my luck. I'm not gonna tell any more stories today, not today, I swear it!",
            "nextDialogs": [
              "710990102"
            ]
          },
          "710990102": {
            "id": "710990102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's going on?",
            "nextDialogs": [
              "710990103"
            ]
          },
          "710990103": {
            "id": "710990103",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "This tiny little stage is really annoying me. It's been poorly maintained for decades! It squeaks at the lightest touch!",
            "nextDialogs": [
              "710990104"
            ]
          },
          "710990104": {
            "id": "710990104",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "I've long told our boss, Fan Er'ye, that it needed to be replaced, but he would always brush me off, saying that he couldn't find a good carpenter to do the job.",
            "nextDialogs": [
              "710990105"
            ]
          },
          "710990105": {
            "id": "710990105",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Today, when I was telling the story of \"The Wrath of Haishan,\" it would make that infernal squeak with every pose I would strike.",
            "nextDialogs": [
              "710990106"
            ]
          },
          "710990106": {
            "id": "710990106",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Nothing could've killed the mood more effectively. Everyone present burst out laughing, and some even made fun of me for it.",
            "nextDialogs": [
              "710990107"
            ]
          },
          "710990107": {
            "id": "710990107",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "I'm fed up with it. I must bring a good carpenter to see Fan Er'ye. Then we'll see what other excuses he can come up with this time!",
            "nextDialogs": [
              "710990108"
            ]
          },
          "710990108": {
            "id": "710990108",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "You're from the Adventurers' Guild, right? Can I just directly ask you to find a carpenter for me?",
            "nextDialogs": [
              "710990111"
            ]
          },
          "710990111": {
            "id": "710990111",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Oh, my bad. You don't look like you're from around here. How can I expect you to know where to find good carpenters?",
            "nextDialogs": [
              "710990112"
            ]
          },
          "710990112": {
            "id": "710990112",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Well, then, how about you go to Qingce Village and look for Master Lu at Fanmu Carpenter's. He's known for good skills. Please ask him if he's willing to help me.",
            "nextDialogs": [
              "710990113"
            ]
          },
          "710990113": {
            "id": "710990113",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "He can send an apprentice if he's not available.",
            "nextDialogs": [
              "710990114"
            ]
          },
          "710990114": {
            "id": "710990114",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Any carpenter from Fanmu Carpenter's can manage the job, and if they build it right, that means we can finally have a befitting stage for Ms. Yun.",
            "nextDialogs": [
              "710990115"
            ]
          },
          "710990115": {
            "id": "710990115",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Hah! I'm such a genius! With this reasoning that I just came up with, I don't see how Er'ye could say no again this time.",
            "nextDialogs": [
              "710990116"
            ]
          },
          "710990116": {
            "id": "710990116",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Just rest assured, as long as you bring the carpenter here, you'll be paid in full.",
            "nextDialogs": [
              "710990117"
            ]
          },
          "710990117": {
            "id": "710990117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it.",
            "nextDialogs": [
              "710990118"
            ]
          },
          "710990118": {
            "id": "710990118",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Then I'll be counting on you. I'm at the tea house every day. Come to me when you've found our carpenter."
          }
        }
      }
    },
    {
      "subId": "7109902",
      "subQuestName": "Head to Qingce Village and look for Master Lu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990201"
        ],
        "dialogs": {
          "710990201": {
            "id": "710990201",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Er'ye, you need to seriously think about it, or else they'll all go to Third-Round Knockout."
          }
        }
      }
    },
    {
      "subId": "7109903",
      "subQuestName": "Talk to Master Lu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990301"
        ],
        "dialogs": {
          "710990301": {
            "id": "710990301",
            "speakerId": 2310,
            "speakerName": "Master Lu",
            "text": "#What's the hurry, young {M#man}{F#lady}? Would you like to sit down and have a cup of tea?",
            "nextDialogs": [
              "710990304"
            ]
          },
          "710990304": {
            "id": "710990304",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You explain Liu Su's request to Master Lu...",
            "nextDialogs": [
              "710990305"
            ]
          },
          "710990305": {
            "id": "710990305",
            "speakerId": 2310,
            "speakerName": "Master Lu",
            "text": "Oh, it's not difficult to build a new stage, but I'm afraid I can't help.",
            "nextDialogs": [
              "710990306"
            ]
          },
          "710990306": {
            "id": "710990306",
            "speakerId": 2310,
            "speakerName": "Master Lu",
            "text": "Liyue Harbor is too far away. No one will be taking care of Fanmu Carpenter's if I go.",
            "nextDialogs": [
              "710990307"
            ]
          },
          "710990307": {
            "id": "710990307",
            "speakerId": 2310,
            "speakerName": "Master Lu",
            "text": "What's more, I'm too old to travel this far. It would take a toll on my fragile bones."
          }
        }
      }
    },
    {
      "subId": "7109904",
      "subQuestName": "Collect furniture materials",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990401"
        ],
        "dialogs": {
          "710990401": {
            "id": "710990401",
            "speakerId": 2306,
            "speakerName": "Granny Ruoxin",
            "text": "Honestly, I'm quite shocked that Er'ye never replaced the stage for all the years...",
            "nextDialogs": [
              "710990402"
            ]
          },
          "710990402": {
            "id": "710990402",
            "speakerId": 2306,
            "speakerName": "Granny Ruoxin",
            "text": "He was stingy as a young man, and he's certainly got even worse over the years.",
            "nextDialogs": [
              "710990405"
            ]
          },
          "710990405": {
            "id": "710990405",
            "speakerId": 2306,
            "speakerName": "Granny Ruoxin",
            "text": "Hmph, I know him well enough to tell that he's making things difficult for himself again, even at this age...",
            "nextDialogs": [
              "710990406"
            ]
          },
          "710990406": {
            "id": "710990406",
            "speakerId": 2306,
            "speakerName": "Granny Ruoxin",
            "text": "Forget it. The little girl from the Yun family is going to visit me. I gotta go home and make some preparations for my guest."
          }
        }
      }
    },
    {
      "subId": "7109905",
      "subQuestName": "Talk to Dayu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990601"
        ],
        "dialogs": {
          "710990601": {
            "id": "710990601",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "Here they are.",
            "nextDialogs": [
              "710990602"
            ]
          },
          "710990602": {
            "id": "710990602",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Dayu busies himself making the chair.",
            "nextDialogs": [
              "710990603"
            ]
          },
          "710990603": {
            "id": "710990603",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "The last chair is finished. Here you are, Granny Ruoxin. Now, time to head to the tea house.",
            "nextDialogs": [
              "710990604"
            ]
          },
          "710990604": {
            "id": "710990604",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "Take care, Master. I'll be back in a few days.",
            "nextDialogs": [
              "710990605"
            ]
          },
          "710990605": {
            "id": "710990605",
            "speakerId": 2310,
            "speakerName": "Master Lu",
            "text": "Alright, be safe.",
            "nextDialogs": [
              "710990606"
            ]
          },
          "710990606": {
            "id": "710990606",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "Well then, if I leave now, I'll reach Liyue Harbor by tomorrow evening.",
            "nextDialogs": [
              "710990607"
            ]
          },
          "710990607": {
            "id": "710990607",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "See you at the Heyu Tea House then."
          }
        }
      }
    },
    {
      "subId": "7109906",
      "subQuestName": "Wait until the following day (18:00 – 21:00)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7109907",
      "subQuestName": "Head to Heyu Tea House",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990701"
        ],
        "dialogs": {
          "710990701": {
            "id": "710990701",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "What do you mean? Don't tell me that you're still arguing amongst yourselves?",
            "nextDialogs": [
              "710990702"
            ]
          },
          "710990702": {
            "id": "710990702",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "Oh, I get it. Mr. Liu Su wants to build a new stage, but he doesn't get to make the call here. Fan Er'ye, who is actually in charge, isn't keen on building something new. Fine.",
            "nextDialogs": [
              "710990703"
            ]
          },
          "710990703": {
            "id": "710990703",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "Just let me know when you two have things sorted out. I've just had a tiring trip and would like to get some rest while waiting.",
            "nextDialogs": [
              "710990704"
            ]
          },
          "710990704": {
            "id": "710990704",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "*sigh* This is just great...",
            "nextDialogs": [
              "710990707"
            ]
          },
          "710990707": {
            "id": "710990707",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Be patient. Let me try talking to him again.",
            "nextDialogs": [
              "710990708"
            ]
          },
          "710990708": {
            "id": "710990708",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Er'ye, if you don't want to spend a small sum of money on this stage, you'll lose a big fortune in the future.",
            "nextDialogs": [
              "710990709"
            ]
          },
          "710990709": {
            "id": "710990709",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Just think about it: Every time Ms. Yun gives her marvelous \"spear flourish\" performance, the audience will hear the squeak of the stage before they even get to applaud.",
            "nextDialogs": [
              "710990710"
            ]
          },
          "710990710": {
            "id": "710990710",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Isn't that simply embarrassing? The Yun-Han Opera Troupe isn't obliged to perform at our tea house. They could go somewhere else if they're displeased. That would be a huge loss on our side.",
            "nextDialogs": [
              "710990711"
            ]
          },
          "710990711": {
            "id": "710990711",
            "speakerId": 2011,
            "speakerName": "Fan Er'ye",
            "text": "Ms. Yun is a dear friend, she would never do that to me.",
            "nextDialogs": [
              "710990712"
            ]
          },
          "710990712": {
            "id": "710990712",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "You're quite an optimist, aren't you? But I heard that many people have chosen to go to Third-Round Knockout instead of our tea house lately.",
            "nextDialogs": [
              "710990713"
            ]
          },
          "710990713": {
            "id": "710990713",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Iron Tongue Tian has gotten even more popular than me. Could you try to be a little more realistic?",
            "nextDialogs": [
              "710990714"
            ]
          },
          "710990714": {
            "id": "710990714",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "With all the money Ms. Yun has earned for the tea house, don't tell me that you can't even afford to build a new stage.",
            "nextDialogs": [
              "710990715"
            ]
          },
          "710990715": {
            "id": "710990715",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "Did someone just call my name? Oh, it's you, Mr. Liu Su. You look angry. What happened?",
            "nextDialogs": [
              "710990716"
            ]
          },
          "710990716": {
            "id": "710990716",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "It's nothing. I'm not angry, actually. Well, are you here to perform today?",
            "nextDialogs": [
              "710990717"
            ]
          },
          "710990717": {
            "id": "710990717",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "I'm just here to have some tea and pay you and Er'ye a visit.",
            "nextDialogs": [
              "710990718"
            ]
          },
          "710990718": {
            "id": "710990718",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "#Ah, if it isn't {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "7109908",
      "subQuestName": "Brew tea with Yun Jin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990801"
        ],
        "dialogs": {
          "710990801": {
            "id": "710990801",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Ms. Yun, I was wondering why Er'ye refused to build a new stage despite all its benefits.",
            "nextDialogs": [
              "710990802"
            ]
          },
          "710990802": {
            "id": "710990802",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Now I see why — thanks to your clever choice of topic.",
            "nextDialogs": [
              "710990803"
            ]
          },
          "710990803": {
            "id": "710990803",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "I understand his nostalgia. Yes I really do, but I didn't expect him to have held on to that for decades.",
            "nextDialogs": [
              "710990804"
            ]
          },
          "710990804": {
            "id": "710990804",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "Now we know the reason behind it.",
            "nextDialogs": [
              "710990805"
            ]
          },
          "710990805": {
            "id": "710990805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't get it.",
            "nextDialogs": [
              "710990806"
            ]
          },
          "710990806": {
            "id": "710990806",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "This is an old story, but since you're involved, I guess it won't hurt to tell you.",
            "nextDialogs": [
              "710990807"
            ]
          },
          "710990807": {
            "id": "710990807",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "Fan Er'ye used to be an opera singer when he was young, and he often performed together with Granny Ruoxin. They would usually play a couple. Perhaps Er'ye wanted it to be real.",
            "nextDialogs": [
              "710990808"
            ]
          },
          "710990808": {
            "id": "710990808",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "But Granny Ruoxin had feelings for someone else. Later, she grew tired of stage performance and then decided to go to Qingce Village with the one she loved.",
            "nextDialogs": [
              "710990809"
            ]
          },
          "710990809": {
            "id": "710990809",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "But that person didn't make it to Qingce Village with Granny Ruoxin, leaving her to live alone in the village ever since.",
            "nextDialogs": [
              "710990810"
            ]
          },
          "710990810": {
            "id": "710990810",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "Knowing that I often visit her, Er'ye would ask me about her from time to time.",
            "nextDialogs": [
              "710990811"
            ]
          },
          "710990811": {
            "id": "710990811",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "I can tell that he still cares for Granny Ruoxin. He sees the stage as a symbol of their past and thus doesn't want to tear it down.",
            "nextDialogs": [
              "710990812"
            ]
          },
          "710990812": {
            "id": "710990812",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "*sigh* Since the stage means so much to Er'ye, he's not gonna let us build a new one. Guess all our efforts are wasted...",
            "nextDialogs": [
              "710990813"
            ]
          },
          "710990813": {
            "id": "710990813",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "That's not necessarily the case. I have a way to change his mind. Give me some time, Mr. Liu Su.",
            "nextDialogs": [
              "710990814"
            ]
          },
          "710990814": {
            "id": "710990814",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Really? As long as the stage gets repaired, I'll be in your debt, Ms. Yun.",
            "nextDialogs": [
              "710990815"
            ]
          },
          "710990815": {
            "id": "710990815",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "#I won't ask for too much. Please tell \"Ring of Raining Blades\" to its very end. {NICKNAME}, you can join me if you want.",
            "nextDialogs": [
              "710990816"
            ]
          },
          "710990816": {
            "id": "710990816",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Somehow Yun Jin feels very different than usual.",
            "nextDialogs": [
              "710990817"
            ]
          },
          "710990817": {
            "id": "710990817",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Our tea house has collaborated with the Yun-Han Opera Troupe for decades. Ms. Yun would naturally feel more approachable around us.",
            "nextDialogs": [
              "710990818"
            ]
          },
          "710990818": {
            "id": "710990818",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "No problem. I'll make some time and tell the story just for you.",
            "nextDialogs": [
              "710990819"
            ]
          },
          "710990819": {
            "id": "710990819",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "Alright, now that we've finished the tea, it's time to talk to Er'ye."
          }
        }
      }
    },
    {
      "subId": "7109909",
      "subQuestName": "Talk to Fan Er'ye",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990901"
        ],
        "dialogs": {
          "710990901": {
            "id": "710990901",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "Er'ye, when we were drinking tea, I suddenly remembered what Granny Ruoxin told me.",
            "nextDialogs": [
              "710990902"
            ]
          },
          "710990902": {
            "id": "710990902",
            "speakerId": 2011,
            "speakerName": "Fan Er'ye",
            "text": "Oh, what did she say?",
            "nextDialogs": [
              "710990903"
            ]
          },
          "710990903": {
            "id": "710990903",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "She said: \"Er'ye always loves to make things difficult for himself. I feel sad about it.\"",
            "nextDialogs": [
              "710990904"
            ]
          },
          "710990904": {
            "id": "710990904",
            "speakerId": 2011,
            "speakerName": "Fan Er'ye",
            "text": "*sigh* She truly understands me.",
            "nextDialogs": [
              "710990905"
            ]
          },
          "710990905": {
            "id": "710990905",
            "speakerId": 2011,
            "speakerName": "Fan Er'ye",
            "text": "But it seems that she doesn't miss the old stage. I'm the only person who can't let go.",
            "nextDialogs": [
              "710990906"
            ]
          },
          "710990906": {
            "id": "710990906",
            "speakerId": 2011,
            "speakerName": "Fan Er'ye",
            "text": "What a fool was I to be so obsessed with this stage. Alright, you can rebuild it as you want.",
            "nextDialogs": [
              "710990907"
            ]
          },
          "710990907": {
            "id": "710990907",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "It's a touching thing to have kept that stage for so many years. I don't find it foolish at all. Please don't think of it that way.",
            "nextDialogs": [
              "710990908"
            ]
          },
          "710990908": {
            "id": "710990908",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "The stage must be rebuilt, but we mustn't damage what Er'ye wants to preserve in memory.",
            "nextDialogs": [
              "710990909"
            ]
          },
          "710990909": {
            "id": "710990909",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "So you've finally made your decision? Great, I'll start working right away.",
            "nextDialogs": [
              "710990910"
            ]
          },
          "710990910": {
            "id": "710990910",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "Here, take a look at my blueprint. The grand stage on the Jade Chamber was built based on it.",
            "nextDialogs": [
              "710990911"
            ]
          },
          "710990911": {
            "id": "710990911",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "According to this design, we need to tear down the walls on the two sides, and...",
            "nextDialogs": [
              "710990912"
            ]
          },
          "710990912": {
            "id": "710990912",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "Let's not get ahead of ourselves. I think we need to repair the stage instead of building something entirely new. Since the problem is caused by the squeaky wood floor, why don't we repair the floor first?",
            "nextDialogs": [
              "710990913"
            ]
          },
          "710990913": {
            "id": "710990913",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "As for the rest, we can talk about it later. What do you think, Mr. Liu Su?",
            "nextDialogs": [
              "710990914"
            ]
          },
          "710990914": {
            "id": "710990914",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "So long as the stage won't affect performance, I have no objections to Ms. Yun and Er'ye's arrangements.",
            "nextDialogs": [
              "710990915"
            ]
          },
          "710990915": {
            "id": "710990915",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "Huh, is that all you want? So you don't need me to build a new stage?",
            "nextDialogs": [
              "710990916"
            ]
          },
          "710990916": {
            "id": "710990916",
            "speakerId": 2011,
            "speakerName": "Fan Er'ye",
            "text": "I agree. Ms. Yun's idea is a good one.",
            "nextDialogs": [
              "710990917"
            ]
          },
          "710990917": {
            "id": "710990917",
            "speakerId": 2011,
            "speakerName": "Fan Er'ye",
            "text": "As it happens, we don't need to buy the planks. We can find some at the docks.",
            "nextDialogs": [
              "710990918"
            ]
          },
          "710990918": {
            "id": "710990918",
            "speakerId": 2011,
            "speakerName": "Fan Er'ye",
            "text": "#Um... May I trouble you to bring me the planks, {NICKNAME}? I'll pay you for everything in full later.",
            "nextDialogs": [
              "710990919"
            ]
          },
          "710990919": {
            "id": "710990919",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That works for me.",
            "nextDialogs": [
              "710990920"
            ]
          },
          "710990920": {
            "id": "710990920",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "...Alright then, leave everything to me."
          }
        }
      }
    },
    {
      "subId": "7109910",
      "subQuestName": "Go to the warehouse at the dock and obtain the wooden planks",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7109911",
      "subQuestName": "Give the planks to Dayu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710991101"
        ],
        "dialogs": {
          "710991101": {
            "id": "710991101",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "These planks would do. I'll start right away."
          }
        }
      }
    },
    {
      "subId": "7109905",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990501"
        ],
        "dialogs": {
          "710990501": {
            "id": "710990501",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "Thank you for your help. Have you found three pieces of Pine Wood and one Red Dye?"
          }
        }
      }
    },
    {
      "subId": "7109950",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710995001"
        ],
        "dialogs": {
          "710995001": {
            "id": "710995001",
            "speakerId": 2310,
            "speakerName": "Master Lu",
            "text": "#{M#Young man}{F#Young lady}, I took on an apprentice today! Let me make some pork stew tonight to celebrate!"
          }
        }
      }
    },
    {
      "subId": "7109951",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710995101"
        ],
        "dialogs": {
          "710995101": {
            "id": "710995101",
            "speakerId": 2011,
            "speakerName": "Fan Er'ye",
            "text": "Stop nagging me about repairing the stage. Let me think about it."
          }
        }
      }
    },
    {
      "subId": "7109952",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710995201"
        ],
        "dialogs": {
          "710995201": {
            "id": "710995201",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "I thought it was a serious job and even brought with me the blueprint for the grand stage on the Jade Chamber. Who would've thought that the requesters hadn't even reached a consensus? Was it just a practical joke or something?"
          }
        }
      }
    },
    {
      "subId": "7109953",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710995301"
        ],
        "dialogs": {
          "710995301": {
            "id": "710995301",
            "speakerId": 2011,
            "speakerName": "Fan Er'ye",
            "text": "Ms. Yun really understands me."
          }
        }
      }
    },
    {
      "subId": "7109954",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710995401"
        ],
        "dialogs": {
          "710995401": {
            "id": "710995401",
            "speakerId": 2010,
            "speakerName": "Tea Master Liu Su",
            "text": "Just one round of \"Ring of Raining Blades\"? No problem."
          }
        }
      }
    },
    {
      "subId": "7109955",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710995501"
        ],
        "dialogs": {
          "710995501": {
            "id": "710995501",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "It's settled then. Wonderful.",
            "nextDialogs": [
              "710995503",
              "710995509"
            ]
          },
          "710995503": {
            "id": "710995503",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "I did just come back from Qingce Village, and yes, I visited Granny Ruoxin. I directly quoted what she said. It's just...",
            "nextDialogs": [
              "710995504"
            ]
          },
          "710995504": {
            "id": "710995504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's just?",
            "nextDialogs": [
              "710995505"
            ]
          },
          "710995505": {
            "id": "710995505",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "Shh! It's just that I didn't quote the full sentence. What she said was:",
            "nextDialogs": [
              "710995506"
            ]
          },
          "710995506": {
            "id": "710995506",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "\"Er'ye always loves to make things difficult for himself. He's stingy with Mora, and people around him suffer for it as well. It's honestly rather saddening.\"",
            "nextDialogs": [
              "710995507"
            ]
          },
          "710995507": {
            "id": "710995507",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "Although what she said was true, Er'ye would've been irritated had I repeated exactly every word, so I took the liberty of omitting the other half."
          },
          "710995509": {
            "id": "710995509",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "Great, this is my second favorite thing: to spend some time in the tea house.",
            "nextDialogs": [
              "710995510"
            ]
          },
          "710995510": {
            "id": "710995510",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "Even when Mr. Liu Su isn't telling a story, the mere sound of the bustling city itself is soothing.",
            "nextDialogs": [
              "710995511"
            ]
          },
          "710995511": {
            "id": "710995511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Then, what's your most favorite thing?",
            "nextDialogs": [
              "710995512"
            ]
          },
          "710995512": {
            "id": "710995512",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "It's definitely singing the opera on the stage!",
            "nextDialogs": [
              "710995513"
            ]
          },
          "710995513": {
            "id": "710995513",
            "speakerId": 1046,
            "speakerName": "Yun Jin",
            "text": "I'd love to chat with you more, but I believe that Mr. Liu Su is still waiting for you to bring him his planks so that the stage can get fixed."
          }
        }
      }
    },
    {
      "subId": "7109956",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710995601"
        ],
        "dialogs": {
          "710995601": {
            "id": "710995601",
            "speakerId": 12641,
            "speakerName": "Dayu",
            "text": "Master is right, it's difficult to work for people in cities."
          }
        }
      }
    }
  ]
}
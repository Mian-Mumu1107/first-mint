    {
      "subId": "7608506",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760850601"
        ],
        "dialogs": {
          "760850601": {
            "id": "760850601",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...!",
            "nextDialogs": [
              "760850602"
            ]
          },
          "760850602": {
            "id": "760850602",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "This one is delicious!",
            "nextDialogs": [
              "760850603"
            ]
          },
          "760850603": {
            "id": "760850603",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "It's my favorite so far.",
            "nextDialogs": [
              "760850604"
            ]
          },
          "760850604": {
            "id": "760850604",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow! Finally, a drink that Columbina likes! Paimon's over the moon...",
            "nextDialogs": [
              "760850605"
            ]
          },
          "760850605": {
            "id": "760850605",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Uhm... sorry?",
            "nextDialogs": [
              "760850606"
            ]
          },
          "760850606": {
            "id": "760850606",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's summarize: No noticeable bitterness, never add fruit juice straight, and milk's okay but it's better without...",
            "nextDialogs": [
              "760850607"
            ]
          },
          "760850607": {
            "id": "760850607",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "760850608"
            ]
          },
          "760850608": {
            "id": "760850608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So this is a \"lighter-bodied\" drink...",
            "nextDialogs": [
              "760850609"
            ]
          },
          "760850609": {
            "id": "760850609",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Figuring out the pattern's a good thing! In the future, we'll know how to mix drinks the way you like 'em.",
            "nextDialogs": [
              "760850610"
            ]
          },
          "760850610": {
            "id": "760850610",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...In the future?",
            "nextDialogs": [
              "760850611"
            ]
          },
          "760850611": {
            "id": "760850611",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Of course, we're friends! Whenever you're feeling thirsty, you just let us know!",
            "nextDialogs": [
              "760850612"
            ]
          },
          "760850612": {
            "id": "760850612",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, is that why you aren't finishing your drink? You're not saving it because you think this is the last cup you'll ever taste, are you?",
            "nextDialogs": [
              "760850613"
            ]
          },
          "760850613": {
            "id": "760850613",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...Uhm.",
            "nextDialogs": [
              "760850614"
            ]
          },
          "760850614": {
            "id": "760850614",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's fine, don't worry.",
            "nextDialogs": [
              "760850615"
            ]
          },
          "760850615": {
            "id": "760850615",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "760850616"
            ]
          },
          "760850616": {
            "id": "760850616",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Thanks for the treat."
          }
        }
      }
    },
    {
      "subId": "7608503",
      "subQuestName": "Talk to The Damselette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760520201"
        ],
        "dialogs": {
          "760520201": {
            "id": "760520201",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Hmm...",
            "nextDialogs": [
              "760520202"
            ]
          },
          "760520202": {
            "id": "760520202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So, what do you think?",
            "nextDialogs": [
              "760520203"
            ]
          },
          "760520203": {
            "id": "760520203",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "It reminds me of a time long, long ago, when I was living with the Frostmoon Scions...",
            "nextDialogs": [
              "760520204"
            ]
          },
          "760520204": {
            "id": "760520204",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "The people used to make a kind of tea brewed with fresh mint leaves, spices, and dried berries.",
            "nextDialogs": [
              "760520205"
            ]
          },
          "760520205": {
            "id": "760520205",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Whenever I passed by their homes, there was always a subtle herbal aroma wafting from the windows...",
            "nextDialogs": [
              "760520206"
            ]
          },
          "760520206": {
            "id": "760520206",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Did you ever get to try it?",
            "nextDialogs": [
              "760520207"
            ]
          },
          "760520207": {
            "id": "760520207",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "I wanted to, but never got the chance.",
            "nextDialogs": [
              "760520208"
            ]
          },
          "760520208": {
            "id": "760520208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, why not...?",
            "nextDialogs": [
              "760520209"
            ]
          },
          "760520209": {
            "id": "760520209",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "When a \"Goddess\" arrives at your door and asks, \"May I try your tea?\"... No one dares to offer up the \"rustic tea\" thrown together for their own consumption...",
            "nextDialogs": [
              "760520210"
            ]
          },
          "760520210": {
            "id": "760520210",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ah... Yeah.",
            "nextDialogs": [
              "760520211"
            ]
          },
          "760520211": {
            "id": "760520211",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "What I received in the end was more like an \"offering\" for the divine, complete with ornate packaging and all.",
            "nextDialogs": [
              "760520212"
            ]
          },
          "760520212": {
            "id": "760520212",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Not that it tasted bad, per se... But, it was missing that sense of... \"home.\"",
            "nextDialogs": [
              "760520213"
            ]
          },
          "760520213": {
            "id": "760520213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, now we can fix that!",
            "nextDialogs": [
              "760520214"
            ]
          },
          "760520214": {
            "id": "760520214",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Mmm...",
            "nextDialogs": [
              "760520215"
            ]
          },
          "760520215": {
            "id": "760520215",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "The flavor is delightful.",
            "nextDialogs": [
              "760520216"
            ]
          },
          "760520216": {
            "id": "760520216",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...Though I must say, the idea of adding milk seems quite unorthodox to me.",
            "nextDialogs": [
              "760520217"
            ]
          },
          "760520217": {
            "id": "760520217",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ah, well this is a Mondstadt recipe. People love adding milk, cream, and sugar to their tea over there.",
            "nextDialogs": [
              "760520218"
            ]
          },
          "760520218": {
            "id": "760520218",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "It's novel... but in a good way.",
            "nextDialogs": [
              "760520219"
            ]
          },
          "760520219": {
            "id": "760520219",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Phew, glad you like it!",
            "nextDialogs": [
              "760520220"
            ]
          },
          "760520220": {
            "id": "760520220",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Mm... Thank you.",
            "nextDialogs": [
              "760520221"
            ]
          },
          "760520221": {
            "id": "760520221",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "It seems moonlight is not the only medium through which one can glimpse the past. Even something as simple as the aroma of a drink can bring back long-forgotten memories..."
          }
        }
      }
    },
    {
      "subId": "7605204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760520401"
        ],
        "dialogs": {
          "760520401": {
            "id": "760520401",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Hm, I've smelled something like this before.",
            "nextDialogs": [
              "760520402"
            ]
          },
          "760520402": {
            "id": "760520402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, really? Where?",
            "nextDialogs": [
              "760520403"
            ]
          },
          "760520403": {
            "id": "760520403",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "In Sandrone's room. She had a drink that smelled like this. The aroma caught my interest, and when she noticed... she just held on to the drink for ages without finishing it.",
            "nextDialogs": [
              "760520404"
            ]
          },
          "760520404": {
            "id": "760520404",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "It was like... she was waiting for me to ask about it.",
            "nextDialogs": [
              "760520405"
            ]
          },
          "760520405": {
            "id": "760520405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So... did you?",
            "nextDialogs": [
              "760520406"
            ]
          },
          "760520406": {
            "id": "760520406",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Yes.",
            "nextDialogs": [
              "760520407"
            ]
          },
          "760520407": {
            "id": "760520407",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What did you ask?",
            "nextDialogs": [
              "760520408"
            ]
          },
          "760520408": {
            "id": "760520408",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Shouldn't you be drinking engine oil instead?",
            "nextDialogs": [
              "760520409"
            ]
          },
          "760520409": {
            "id": "760520409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And... how did she respond?",
            "nextDialogs": [
              "760520410"
            ]
          },
          "760520410": {
            "id": "760520410",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Um...",
            "nextDialogs": [
              "760520411"
            ]
          },
          "760520411": {
            "id": "760520411",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "She said something quite unpleasant. It doesn't bear repeating.",
            "nextDialogs": [
              "760520412"
            ]
          },
          "760520412": {
            "id": "760520412",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "760520413"
            ]
          },
          "760520413": {
            "id": "760520413",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You lost interest after a single sip!?",
            "nextDialogs": [
              "760520414"
            ]
          },
          "760520414": {
            "id": "760520414",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Sorry, it was a little bitter... all in all, not very good. No wonder Sandrone looked so sour when she drank it.",
            "nextDialogs": [
              "760520415"
            ]
          },
          "760520415": {
            "id": "760520415",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon thinks there might've been other reasons for that..."
          }
        }
      }
    },
    {
      "subId": "7605205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760520501"
        ],
        "dialogs": {
          "760520501": {
            "id": "760520501",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "*glug*... *glug*...",
            "nextDialogs": [
              "760520502"
            ]
          },
          "760520502": {
            "id": "760520502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, that was quick! Looks like she loves it!",
            "nextDialogs": [
              "760520503"
            ]
          },
          "760520503": {
            "id": "760520503",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Hm... completely flavorless.",
            "nextDialogs": [
              "760520504"
            ]
          },
          "760520504": {
            "id": "760520504",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "F—f—flavorless!?",
            "nextDialogs": [
              "760520505"
            ]
          },
          "760520505": {
            "id": "760520505",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Yes.",
            "nextDialogs": [
              "760520508"
            ]
          },
          "760520508": {
            "id": "760520508",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Oh... Thanks, but no need.",
            "nextDialogs": [
              "760520509"
            ]
          },
          "760520509": {
            "id": "760520509",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "There was a time when I failed to understand why people felt such joy at harvest time. Then, one day, I reached out to touch a piece of ripe fruit hanging from a branch...",
            "nextDialogs": [
              "760520510"
            ]
          },
          "760520510": {
            "id": "760520510",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "I sensed vitality in the very texture of its skin — the organic embodiment of sunlight, water, earth, and air.",
            "nextDialogs": [
              "760520511"
            ]
          },
          "760520511": {
            "id": "760520511",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "With each bite, I felt a refreshing sweetness surge over me like waves of cool white foam.",
            "nextDialogs": [
              "760520512"
            ]
          },
          "760520512": {
            "id": "760520512",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "And that's how I came to understand the irresistible power of aroma.",
            "nextDialogs": [
              "760520513"
            ]
          },
          "760520513": {
            "id": "760520513",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, that's interesting!",
            "nextDialogs": [
              "760520514"
            ]
          },
          "760520514": {
            "id": "760520514",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Then, we complete nature's cycle by taking that life force for ourselves.",
            "nextDialogs": [
              "760520515"
            ]
          },
          "760520515": {
            "id": "760520515",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uhh, that suddenly turned kinda dark...",
            "nextDialogs": [
              "760520516"
            ]
          },
          "760520516": {
            "id": "760520516",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "That is why I prefer fresh fruit. It allows me to see what I took from this world, exactly as it was before I took it.",
            "nextDialogs": [
              "760520517"
            ]
          },
          "760520517": {
            "id": "760520517",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "And reminds me of what I owe this world in return..."
          }
        }
      }
    },
    {
      "subId": "7605206",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760520601"
        ],
        "dialogs": {
          "760520601": {
            "id": "760520601",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Here, try it for yourselves. This Lakkaberry is very sweet, so make sure you savor it."
          }
        }
      }
    },
    {
      "subId": "7605207",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760520701"
        ],
        "dialogs": {
          "760520701": {
            "id": "760520701",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Perhaps you could make something for me again in the future?"
          }
        }
      }
    },
    {
      "subId": "7605208",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760520801"
        ],
        "dialogs": {
          "760520801": {
            "id": "760520801",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Well... Thank you for satisfying my curiosity. I'll be sure not to trust Sandrone's taste ever again."
          }
        }
      }
    },

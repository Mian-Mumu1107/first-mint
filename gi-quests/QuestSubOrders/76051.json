  "subQuests": [
    {
      "subId": "7605101",
      "subQuestName": "Meet The Damselette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760510101"
        ],
        "dialogs": {
          "760510101": {
            "id": "760510101",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "#{NICKNAME}, Paimon...",
            "nextDialogs": [
              "760510102"
            ]
          },
          "760510102": {
            "id": "760510102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What's wrong, Columbina? You look like something's troubling you.",
            "nextDialogs": [
              "760510103"
            ]
          },
          "760510103": {
            "id": "760510103",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Do you have any paint with you?",
            "nextDialogs": [
              "760510104"
            ]
          },
          "760510104": {
            "id": "760510104",
            "speakerId": 1002,
            "speakerName": "Maalaus",
            "text": "!!!",
            "nextDialogs": [
              "760510105"
            ]
          },
          "760510105": {
            "id": "760510105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh! You're... Maalaus, right?",
            "nextDialogs": [
              "760510106"
            ]
          },
          "760510106": {
            "id": "760510106",
            "speakerId": 1002,
            "speakerName": "Maalaus",
            "text": "~!",
            "nextDialogs": [
              "760510107"
            ]
          },
          "760510107": {
            "id": "760510107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "In the mood for more painting, huh? Looks like you got most of the paint on yourself, though... How did that happen?",
            "nextDialogs": [
              "760510108"
            ]
          },
          "760510108": {
            "id": "760510108",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Maalaus left for a bit and came back like this. I anticipate this paint will take quite some time to wash off.",
            "nextDialogs": [
              "760510109"
            ]
          },
          "760510109": {
            "id": "760510109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh, maybe Maalaus ran into trouble while out searching for inspiration...",
            "nextDialogs": [
              "760510110"
            ]
          },
          "760510110": {
            "id": "760510110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Still, this isn't a bad look at all. Very fitting for an artist!",
            "nextDialogs": [
              "760510111"
            ]
          },
          "760510111": {
            "id": "760510111",
            "speakerId": 1002,
            "speakerName": "Maalaus",
            "text": "??",
            "nextDialogs": [
              "760510112"
            ]
          },
          "760510112": {
            "id": "760510112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, and about the paint... We just need to give Maalaus colorful things, right? Like last time?",
            "nextDialogs": [
              "760510113"
            ]
          },
          "760510113": {
            "id": "760510113",
            "speakerId": 1002,
            "speakerName": "Maalaus",
            "text": "~~!",
            "nextDialogs": [
              "760510114"
            ]
          },
          "760510114": {
            "id": "760510114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe, now that's one happy kuuhenki. Maalaus must've hit on some really good ideas... Something fun and upbeat for sure!",
            "nextDialogs": [
              "760510115"
            ]
          },
          "760510115": {
            "id": "760510115",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's find some warm, happy colors this time!"
          }
        }
      }
    },
    {
      "subId": "7605102",
      "subQuestName": "Give the kuuhenki some objects with vivid colors",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760510201"
        ],
        "dialogs": {
          "760510201": {
            "id": "760510201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Warm, happy colors...)"
          }
        }
      }
    },
    {
      "subId": "7605103",
      "subQuestName": "Admire the kuuhenki's art",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760510301"
        ],
        "dialogs": {
          "760510301": {
            "id": "760510301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That should do it, right?",
            "nextDialogs": [
              "760510302"
            ]
          },
          "760510302": {
            "id": "760510302",
            "speakerId": 1002,
            "speakerName": "Maalaus",
            "text": "~~!",
            "nextDialogs": [
              "760510303"
            ]
          },
          "760510303": {
            "id": "760510303",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh! There she goes, painting away already!",
            "nextDialogs": [
              "760510304"
            ]
          },
          "760510304": {
            "id": "760510304",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ahem... Dear judges, prepare to be amazed! What kind of masterpiece will our talented kuuhenki artist bring us toda—",
            "nextDialogs": [
              "760510305"
            ]
          },
          "760510305": {
            "id": "760510305",
            "speakerId": 1002,
            "speakerName": "Maalaus",
            "text": "!!!",
            "nextDialogs": [
              "760510306"
            ]
          },
          "760510306": {
            "id": "760510306",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? You're done already!? Paimon didn't even get to finish her intro...!",
            "nextDialogs": [
              "760510307"
            ]
          },
          "760510307": {
            "id": "760510307",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, let's see here. Oh! Another drawing of Columbina. No surprise there!",
            "nextDialogs": [
              "760510310"
            ]
          },
          "760510310": {
            "id": "760510310",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Is that... a forest somewhere in Nod-Krai? There are so many little animals!",
            "nextDialogs": [
              "760510311"
            ]
          },
          "760510311": {
            "id": "760510311",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "I'm afraid... you would have to go back to the time before I left the Frostmoon Scions to see a scene like this.",
            "nextDialogs": [
              "760510312"
            ]
          },
          "760510312": {
            "id": "760510312",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, Paimon's so jealous! Did cute little animals really gather around you like that?",
            "nextDialogs": [
              "760510313"
            ]
          },
          "760510313": {
            "id": "760510313",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Yes, most of them were drawn to the kuuvahki around me. They felt safe curling up next to me like that.",
            "nextDialogs": [
              "760510314"
            ]
          },
          "760510314": {
            "id": "760510314",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's so awesome! You could pet them all you wanted without them running away!",
            "nextDialogs": [
              "760510315"
            ]
          },
          "760510315": {
            "id": "760510315",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Hm... I would say the chic badgers were the nicest to pet. They're the ones with the big, fluffy tails.",
            "nextDialogs": [
              "760510316"
            ]
          },
          "760510316": {
            "id": "760510316",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "The fur on a rimehorn deer's neck is quite soft as well. It makes a very comfortable pillow.",
            "nextDialogs": [
              "760510317"
            ]
          },
          "760510317": {
            "id": "760510317",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Which do you prefer?",
            "nextDialogs": [
              "760510318"
            ]
          },
          "760510318": {
            "id": "760510318",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um, we don't really have the same kind of experience to go off of...",
            "nextDialogs": [
              "760510319"
            ]
          },
          "760510319": {
            "id": "760510319",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But, Paimon would probably choose to pet a chic badger's tail.",
            "nextDialogs": [
              "760510320"
            ]
          },
          "760510320": {
            "id": "760510320",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Chic badgers can be quite timid. If you want to pet them, they need to feel safe first.",
            "nextDialogs": [
              "760510321"
            ]
          },
          "760510321": {
            "id": "760510321",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Ah... But I would exercise caution, Paimon.",
            "nextDialogs": [
              "760510322"
            ]
          },
          "760510322": {
            "id": "760510322",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why? Do they... bite, or something? P—Paimon promises to be super gentle...",
            "nextDialogs": [
              "760510323"
            ]
          },
          "760510323": {
            "id": "760510323",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "No. I'm referring to danger from above.",
            "nextDialogs": [
              "760510324"
            ]
          },
          "760510324": {
            "id": "760510324",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Danger from above...?",
            "nextDialogs": [
              "760510325"
            ]
          },
          "760510325": {
            "id": "760510325",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Yes... Longplume ibises often hunt little animals like these. I had to issue them a warning to get them to stop going after the kuuhenki.",
            "nextDialogs": [
              "760510326"
            ]
          },
          "760510326": {
            "id": "760510326",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You're just telling Paimon this now!? It's a miracle she hasn't been carried off yet!",
            "nextDialogs": [
              "760510327"
            ]
          },
          "760510327": {
            "id": "760510327",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Ah... Then, the next time I see one, I'll advise them that you are off limits as well.",
            "nextDialogs": [
              "760510328"
            ]
          },
          "760510328": {
            "id": "760510328",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Next time? No, you need to find one right now, or Paimon'll be too scared to even fly out that door!",
            "nextDialogs": [
              "760510329"
            ]
          },
          "760510329": {
            "id": "760510329",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Ah, I see. In that case, I will be sure to tell them that Paimon is..."
          }
        }
      }
    },
    {
      "subId": "7605104",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760510401"
        ],
        "dialogs": {
          "760510401": {
            "id": "760510401",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "*sigh*... I really would like to pet the little animals again."
          }
        }
      }
    }
  ]
}
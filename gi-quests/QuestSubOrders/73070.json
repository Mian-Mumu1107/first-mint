          "730701408": {
            "id": "730701408",
            "speakerId": 1000,
            "speakerName": "Arama",
            "text": "#But with memories of adventuring together with Nara {NICKNAME} and Paimon, my powers will grow!",
            "nextDialogs": [
              "730701409"
            ]
          },
          "730701409": {
            "id": "730701409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do we need to enter the dream of the Vasara Tree this time too?",
            "nextDialogs": [

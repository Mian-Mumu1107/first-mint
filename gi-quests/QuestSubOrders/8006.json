    {
      "subId": "800608",
      "subQuestName": "Talk to Dainsleif",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80060801"
        ],
        "dialogs": {
          "80060801": {
            "id": "80060801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whew! You've been hunting this Abyss Herald for aaages — now you finally got him!",
            "nextDialogs": [
              "80060802"
            ]
          },
          "80060802": {
            "id": "80060802",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "There's no time to celebrate. The Abyss Order's device is activating, but there's still time to destroy it.",
            "nextDialogs": [
              "80060803"
            ]
          },
          "80060803": {
            "id": "80060803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright! Let's go!"
          }
        }
      }
    },
    {
      "subId": "800620",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80062001"
        ],
        "dialogs": {
          "80062001": {
            "id": "80062001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's even a bonfire here, like what hilichurls build in the wild.",
            "nextDialogs": [
              "80062002"
            ]
          },
          "80062002": {
            "id": "80062002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, but wasn't Dain saying that hilichurls get scared of the light when they reach the very end of their lives...?",
            "nextDialogs": [
              "80062003"
            ]
          },
          "80062003": {
            "id": "80062003",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, maybe in the very, very end, they still want to feel some light and warmth? Uh... just thinking aloud here, could also be another reason!"
          }
        }
      }
    },
    {
      "subId": "800621",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80062101"
        ],
        "dialogs": {
          "80062101": {
            "id": "80062101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hilichurls usually store food in crates like these, right?",
            "nextDialogs": [
              "80062102"
            ]
          },
          "80062102": {
            "id": "80062102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But... these seem pretty much empty. Is it because they're so near to the end that they don't need to eat anymore?",
            "nextDialogs": [
              "80062103"
            ]
          },
          "80062103": {
            "id": "80062103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Even if they don't need to eat anymore, Paimon bets they still miss food for the flavor."
          }
        }
      }
    },
    {
      "subId": "800622",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80062201"
        ],
        "dialogs": {
          "80062201": {
            "id": "80062201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems like... these hilichurls have no life left in them at all. Before long, they'll become one with the darkness.",
            "nextDialogs": [
              "80062202"
            ]
          },
          "80062202": {
            "id": "80062202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The hilichurls we meet in the wild are always so rowdy... Paimon never would have imagined that this is how they spend their final days.",
            "nextDialogs": [
              "80062203"
            ]
          },
          "80062203": {
            "id": "80062203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We may not have a whole lot of happy memories dealing with hilichurls, but still, Paimon hopes they're at peace in their last moments."
          }
        }
      }
    },
    {
      "subId": "800699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80069901"
        ],
        "dialogs": {
          "80069901": {
            "id": "80069901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There are more signs of hilichurl activity here."
          }
        }
      }
    }
  ]
}
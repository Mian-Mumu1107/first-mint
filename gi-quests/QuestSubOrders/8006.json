  "subQuests": [
    {
      "subId": "800601",
      "subQuestName": "Go along the path that Halfdan has indicated",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80060101"
        ],
        "dialogs": {
          "80060101": {
            "id": "80060101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like Halfdan disappeared at the far end of this path...",
            "nextDialogs": [
              "80060102"
            ]
          },
          "80060102": {
            "id": "80060102",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "Perhaps whatever lies ahead is what he wants us to see. Let's keep going."
          }
        }
      }
    },

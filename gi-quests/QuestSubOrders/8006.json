    {
      "subId": "800606",
      "subQuestName": "Leave the hilichurl camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80060601"
        ],
        "dialogs": {
          "80060601": {
            "id": "80060601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We can see the upside-down city from here, too.",
            "nextDialogs": [
              "80060602"
            ]
          },
          "80060602": {
            "id": "80060602",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "Wait... Watch out!",
            "nextDialogs": [
              "80060603"
            ]
          },
          "80060603": {
            "id": "80060603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aaaah!",
            "nextDialogs": [
              "80060604"
            ]
          },
          "80060604": {
            "id": "80060604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wh—What's going on!? Is that light coming from the room in the center? Ow, it's too bright!",
            "nextDialogs": [
              "80060605"
            ]
          },
          "80060605": {
            "id": "80060605",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "The mutation is continuing... Has the Abyss made its move already?",
            "nextDialogs": [
              "80060606"
            ]
          },
          "80060606": {
            "id": "80060606",
            "speakerId": 10916,
            "speakerName": "Abyss Herald",
            "text": "Dainsleif... I see your incessant meddling continues, and that you have once again joined forces with Our Highness's kin...",
            "nextDialogs": [
              "80060607"
            ]
          },
          "80060607": {
            "id": "80060607",
            "speakerId": 10916,
            "speakerName": "Abyss Herald",
            "text": "Regrettably, I was not in time to control your exit from the network... and it sent you here, of all places. This was a catastrophic error.",
            "nextDialogs": [
              "80060608"
            ]
          },
          "80060608": {
            "id": "80060608",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "Hmph! I am surprised that you dare to face me. You ran like a coward last time.",
            "nextDialogs": [
              "80060609"
            ]
          },
          "80060609": {
            "id": "80060609",
            "speakerId": 10916,
            "speakerName": "Abyss Herald",
            "text": "Our Highness's will must be done. All interferences must be removed... whatever the price to pay.",
            "nextDialogs": [
              "80060610"
            ]
          },
          "80060610": {
            "id": "80060610",
            "speakerId": 10916,
            "speakerName": "Abyss Herald",
            "text": "This time... the curse that torments our people must be undone, once and for all.",
            "nextDialogs": [
              "80060611"
            ]
          },
          "80060611": {
            "id": "80060611",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "You are the only ones who torment them.",
            "nextDialogs": [
              "80060612"
            ]
          },
          "80060612": {
            "id": "80060612",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "There is nothing else left of those hilichurls. Nothing besides the curse itself.",
            "nextDialogs": [
              "80060613"
            ]
          },
          "80060613": {
            "id": "80060613",
            "speakerId": 10916,
            "speakerName": "Abyss Herald",
            "text": "Say what you wish. I am going nowhere, Dainsleif.",
            "nextDialogs": [
              "80060614"
            ]
          },
          "80060614": {
            "id": "80060614",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "Then you will give your life just to delay the inevitable? How absurd. But since you wish to persist, then so be it!"
          }
        }
      }
    },
    {
      "subId": "800607",
      "subQuestName": "Defeat the Abyss Herald",
      "sceneId": null,
      "locations": [],
      "dialogue": {

    {
      "subId": "800612",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80060401"
        ],
        "dialogs": {
          "80060401": {
            "id": "80060401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's a humble hilichurl camp...",
            "nextDialogs": [
              "80060402"
            ]
          },
          "80060402": {
            "id": "80060402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, these hilichurls look like they're in pretty bad shape, too. Some of them look like they've already... taken their final breath...",
            "nextDialogs": [
              "80060403"
            ]
          },
          "80060403": {
            "id": "80060403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is this what Halfdan wanted to show us?",
            "nextDialogs": [
              "80060404"
            ]
          },
          "80060404": {
            "id": "80060404",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "Whether it is or not, everything here is worth investigating in detail. Inspect the area. Leave no stone unturned."
          }
        }
      }
    },
    {
      "subId": "800604",
      "subQuestName": "Head to the hilichurl camp",
      "sceneId": null,
      "locations": [],

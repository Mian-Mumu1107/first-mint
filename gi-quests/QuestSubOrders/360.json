  "subQuests": [
    {
      "subId": "36001",
      "subQuestName": "Defeat the nearby hilichurls",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3600101"
        ],
        "dialogs": {
          "3600101": {
            "id": "3600101",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Heh, nothing to it.",
            "nextDialogs": [
              "3600102"
            ]
          },
          "3600102": {
            "id": "3600102",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Though I've gotta say, you surprised me a little with your moves there...",
            "nextDialogs": [
              "3600103"
            ]
          },
          "3600103": {
            "id": "3600103",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Thanks for the backup. How'd it feel?",
            "nextDialogs": [
              "3600106"
            ]
          },
          "3600106": {
            "id": "3600106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Now that you mention it, how is it the hilichurls ended up here?",
            "nextDialogs": [
              "3600107"
            ]
          },
          "3600107": {
            "id": "3600107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "These creatures don't seem like the type to set up camp so close to cities like this.",
            "nextDialogs": [
              "3600108"
            ]
          },
          "3600108": {
            "id": "3600108",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Exactly. It's more normal for them to be much further out in the wilderness.",
            "nextDialogs": [
              "3600109"
            ]
          },
          "3600109": {
            "id": "3600109",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "But because the dragon — Stormterror — has been around a lot more recently, our orchards have been destroyed and the local market has been affected as well.",
            "nextDialogs": [
              "3600110"
            ]
          },
          "3600110": {
            "id": "3600110",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "When the storms hit, we usually end up with at least a few injuries, so the Knights of Favonius have been tied up doing the best they can to defend the area.",
            "nextDialogs": [
              "3600111"
            ]
          },
          "3600111": {
            "id": "3600111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So these annoying creatures have been getting closer and closer to the city?",
            "nextDialogs": [
              "3600112"
            ]
          },
          "3600112": {
            "id": "3600112",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Exactly. That said, clearing this camp helped make the area a little bit safer.",
            "nextDialogs": [
              "3600113"
            ]
          },
          "3600113": {
            "id": "3600113",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Come with me! A responsible knight must make sure to see you to the city safely."
          }
        }
      }
    },

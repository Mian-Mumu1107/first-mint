  "subQuests": [
    {
      "subId": "1012201",
      "subQuestName": "Head towards Springvale and look for Schubert",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101220101"
        ],
        "dialogs": {
          "101220101": {
            "id": "101220101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(The tent seems to be pretty tattered, but there's a really fancy chair...)",
            "nextDialogs": [
              "101220102"
            ]
          },
          "101220102": {
            "id": "101220102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(Could this be another aristocratic custom?)",
            "nextDialogs": [
              "101220103"
            ]
          },
          "101220103": {
            "id": "101220103",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Ah, it's you again. I thought I had rid myself of you two.",
            "nextDialogs": [
              "101220105",
              "101220107"
            ]
          },
          "101220105": {
            "id": "101220105",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Magnanimous... Yes, indeed that is true.",
            "nextDialogs": [
              "101220108"
            ]
          },
          "101220108": {
            "id": "101220108",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Very well, I am certainly not one to be narrow-minded. I'll overlook your previous misconduct for now and listen to what you have to say.",
            "nextDialogs": [
              "101220109"
            ]
          },
          "101220109": {
            "id": "101220109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(Wow, this guy thinks so highly of himself!)"
          },
          "101220107": {
            "id": "101220107",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "\"A few humble words,\" eh? Yes, that sounds appropriate enough."
          }
        }
      }
    },
    {
      "subId": "1012204",
      "subQuestName": "Go with Schubert to meet his \"friends\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101220401"
        ],
        "dialogs": {
          "101220401": {
            "id": "101220401",
            "speakerId": 10390,
            "speakerName": "Daler",
            "text": "Hold it right there. Who's this?",
            "nextDialogs": [
              "101220402"
            ]
          },
          "101220402": {
            "id": "101220402",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "If you really must know...",
            "nextDialogs": [
              "101220403"
            ]
          },
          "101220403": {
            "id": "101220403",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "They're my guests. If you happen to offend them in even the slightest, then you will be held accountable by the Lawrence Clan.",
            "nextDialogs": [
              "101220404"
            ]
          },
          "101220404": {
            "id": "101220404",
            "speakerId": 10390,
            "speakerName": "Daler",
            "text": "But this matter is of utmost secrecy, we must exercise caution.",
            "nextDialogs": [
              "101220405"
            ]
          },
          "101220405": {
            "id": "101220405",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "You dare question the ways of a nobleman? I don't have time for this. Make way!",
            "nextDialogs": [
              "101220406"
            ]
          },
          "101220406": {
            "id": "101220406",
            "speakerId": 10390,
            "speakerName": "Daler",
            "text": "No need to sound all high and mighty like that...",
            "nextDialogs": [
              "101220407"
            ]
          },
          "101220407": {
            "id": "101220407",
            "speakerId": 10390,
            "speakerName": "Daler",
            "text": "Fine, you may proceed."
          }
        }
      }
    },
    {
      "subId": "1012205",
      "subQuestName": "Talk to Schubert",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101220301"
        ],
        "dialogs": {
          "101220301": {
            "id": "101220301",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Huh? Why have you put on a mask all of a sudden?",
            "nextDialogs": [
              "101220304"
            ]
          },
          "101220304": {
            "id": "101220304",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Hmm, even if they are powerful, our status is much higher than theirs in the land of Mondstadt...",
            "nextDialogs": [
              "101220305"
            ]
          },
          "101220305": {
            "id": "101220305",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "...And therefore, we shouldn't allow them to admire our true faces so easily! I see, haha...",
            "nextDialogs": [
              "101220306"
            ]
          },
          "101220306": {
            "id": "101220306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Good thinking, Paimon thought for sure they'd recognize us.",
            "nextDialogs": [
              "101220307"
            ]
          },
          "101220307": {
            "id": "101220307",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Let's proceed, shall we? I'll introduce you as my guest."
          }
        }
      }
    },
    {
      "subId": "1012206",
      "subQuestName": "Follow Schubert",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101220601"
        ],
        "dialogs": {
          "101220601": {
            "id": "101220601",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Don't touch me, get out of my way! I'll leave on my own!",
            "nextDialogs": [
              "101220602"
            ]
          },
          "101220602": {
            "id": "101220602",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "It seems we've finally caught up with you. This place is crawling with Fatui.",
            "nextDialogs": [
              "101220603"
            ]
          },
          "101220603": {
            "id": "101220603",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Oh, it's you. It seems your investigation went well.",
            "nextDialogs": [
              "101220606"
            ]
          },
          "101220606": {
            "id": "101220606",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Aha! I see now. So you're the one that taught them our etiquette? And I thought you despised such pleasantries!",
            "nextDialogs": [
              "101220607"
            ]
          },
          "101220607": {
            "id": "101220607",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Furthermore, there is a rule in our family. Such traditions are never to be taught to outsiders!",
            "nextDialogs": [
              "101220608"
            ]
          },
          "101220608": {
            "id": "101220608",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Ah yes, rings a bell. So what? I had no reason not to teach them.",
            "nextDialogs": [
              "101220609"
            ]
          },
          "101220609": {
            "id": "101220609",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Y—You have brought shame to our family and ruined my plans! It's all for naught now!",
            "nextDialogs": [
              "101220610"
            ]
          },
          "101220610": {
            "id": "101220610",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "I know that you poured great efforts into these plans, uncle. But you were well aware that it was not the right thing to do. As a Knight of Favonius, I could not overlook your actions.",
            "nextDialogs": [
              "101220611"
            ]
          },
          "101220611": {
            "id": "101220611",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Knight of Favonius!? Let's get one thing straight. I am your uncle, and you are a member of the Lawrence Clan! You should strive to restore your family's glory!",
            "nextDialogs": [
              "101220612"
            ]
          },
          "101220612": {
            "id": "101220612",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "You still have a chance. Defeat every Knight of Favonius here, and leave with me!",
            "nextDialogs": [
              "101220613"
            ]
          },
          "101220613": {
            "id": "101220613",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Then I shall plea with the family to spare you and give you a new beginning!",
            "nextDialogs": [
              "101220614"
            ]
          },
          "101220614": {
            "id": "101220614",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "So just to be clear, you want a Knight of Favonius to attack the Knights of Favonius?",
            "nextDialogs": [
              "101220615"
            ]
          },
          "101220615": {
            "id": "101220615",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "I shall say this one last time. You are not a Knight of Favonius. You are a descendant of the Lawrence Clan!",
            "nextDialogs": [
              "101220616"
            ]
          },
          "101220616": {
            "id": "101220616",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "The blood of the Lawrence Clan flows in your veins! You must comply with the will of the family!",
            "nextDialogs": [
              "101220617"
            ]
          },
          "101220617": {
            "id": "101220617",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Since when have I ever complied with the will of the family?",
            "nextDialogs": [
              "101220618"
            ]
          },
          "101220618": {
            "id": "101220618",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Wh—Why you... you unruly maid!",
            "nextDialogs": [
              "101220619"
            ]
          },
          "101220619": {
            "id": "101220619",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "If anyone should be angry, it should be me. As a member of the Lawrence Clan, you knowingly plotted against the city of Mondstadt and threatened its safety.",
            "nextDialogs": [
              "101220620"
            ]
          },
          "101220620": {
            "id": "101220620",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Had you ever stopped to consider the trouble it would bring to so many people? Had you considered how many enemies you would make trying to keep the plans under wraps?",
            "nextDialogs": [
              "101220621"
            ]
          },
          "101220621": {
            "id": "101220621",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Y—You dare lecture me!",
            "nextDialogs": [
              "101220622"
            ]
          },
          "101220622": {
            "id": "101220622",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "That's right, in the name of the family that you so dearly revere, Uncle Schubert.",
            "nextDialogs": [
              "101220623"
            ]
          },
          "101220623": {
            "id": "101220623",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "I've never experienced the age of \"glory\" you always speak of, and I've never understood our family's incessant pursuit of it.",
            "nextDialogs": [
              "101220624"
            ]
          },
          "101220624": {
            "id": "101220624",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "But I am capable of discerning right from wrong, and I deeply understand what \"freedom\" means to the people of Mondstadt.",
            "nextDialogs": [
              "101220625"
            ]
          },
          "101220625": {
            "id": "101220625",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "The Lawrence Clan should never and will never become what you've dreamed it to be!",
            "nextDialogs": [
              "101220626"
            ]
          },
          "101220626": {
            "id": "101220626",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Grr...",
            "nextDialogs": [
              "101220627"
            ]
          },
          "101220627": {
            "id": "101220627",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Oh, the disgrace of it all! How could such a rebellious monster emerge from our own family!?",
            "nextDialogs": [
              "101220628"
            ]
          },
          "101220628": {
            "id": "101220628",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Heh... things are starting to get pretty hysterical here. Politeness and elegance seem to have gone out the window.",
            "nextDialogs": [
              "101220629"
            ]
          },
          "101220629": {
            "id": "101220629",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "That's enough fuss for today. You two, take him away. The Honorary Knight and I have other matters to attend to.",
            "nextDialogs": [
              "101220630"
            ]
          },
          "101220630": {
            "id": "101220630",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Given that you've already taken action, I assume you've come across some conclusive evidence?"
          }
        }
      }
    },
    {
      "subId": "1012207",
      "subQuestName": "Talk to the Fatuus guarding the entrance",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1012208",
      "subQuestName": "Keep following Schubert",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101220801"
        ],
        "dialogs": {
          "101220801": {
            "id": "101220801",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "Please don't tell Eula a word of what I've said.",
            "nextDialogs": [
              "101220802"
            ]
          },
          "101220802": {
            "id": "101220802",
            "speakerId": 10002,
            "speakerName": "Sara",
            "text": "She might think I'm being too nosy."
          }
        }
      }
    },
    {
      "subId": "1012209",
      "subQuestName": "Talk to the Fatui ahead of you",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101220501"
        ],
        "dialogs": {
          "101220501": {
            "id": "101220501",
            "speakerId": 10391,
            "speakerName": "Sergei",
            "text": "(Huh, where have I seen this person before...?)",
            "nextDialogs": [
              "101220502"
            ]
          },
          "101220502": {
            "id": "101220502",
            "speakerId": 10391,
            "speakerName": "Sergei",
            "text": "And who, may I ask, is this? We mustn't bring just anyone in here.",
            "nextDialogs": [
              "101220503"
            ]
          },
          "101220503": {
            "id": "101220503",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "This is our new ally that I've recently met. They are completely trustworthy, you have the word of the Lawrence Clan.",
            "nextDialogs": [
              "101220506"
            ]
          },
          "101220506": {
            "id": "101220506",
            "speakerId": 10391,
            "speakerName": "Sergei",
            "text": "Our plans are strictly confidential. It's not wise to bring in an outsider at this time.",
            "nextDialogs": [
              "101220507"
            ]
          },
          "101220507": {
            "id": "101220507",
            "speakerId": 10391,
            "speakerName": "Sergei",
            "text": "Furthermore, there's been word that an outlander who joined the Knights of Favonius has been very active in Mondstadt recently.",
            "nextDialogs": [
              "101220508"
            ]
          },
          "101220508": {
            "id": "101220508",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Don't be ridiculous. Besides, my guest is well-versed in the etiquette of the nobility. I must treat them with the proper mutual respect.",
            "nextDialogs": [
              "101220509"
            ]
          },
          "101220509": {
            "id": "101220509",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "The Knights of Favonius pay no regard to such details, they could never understand the intricacies of our etiquette.",
            "nextDialogs": [
              "101220510"
            ]
          },
          "101220510": {
            "id": "101220510",
            "speakerId": 10391,
            "speakerName": "Sergei",
            "text": "And what about this... thing?",
            "nextDialogs": [
              "101220511"
            ]
          },
          "101220511": {
            "id": "101220511",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh...? You mean Paimon?",
            "nextDialogs": [
              "101220512"
            ]
          },
          "101220512": {
            "id": "101220512",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Enough! You dare question my word? Need I remind you who it is that has made your activity in Mondstadt possible?",
            "nextDialogs": [
              "101220513"
            ]
          },
          "101220513": {
            "id": "101220513",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Without the support of the Lawrence Clan, you would all have been driven out by the Knights of Favonius like dogs.",
            "nextDialogs": [
              "101220514"
            ]
          },
          "101220514": {
            "id": "101220514",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "You must immediately offer your sincerest apologies to my friend — you've offended their honor!",
            "nextDialogs": [
              "101220515"
            ]
          },
          "101220515": {
            "id": "101220515",
            "speakerId": 10391,
            "speakerName": "Sergei",
            "text": "Tsk!",
            "nextDialogs": [
              "101220516"
            ]
          },
          "101220516": {
            "id": "101220516",
            "speakerId": 10391,
            "speakerName": "Sergei",
            "text": "Fine. I'll take your word and make no further inquiries.",
            "nextDialogs": [
              "101220517"
            ]
          },
          "101220517": {
            "id": "101220517",
            "speakerId": 10391,
            "speakerName": "Sergei",
            "text": "Now, to the matter at hand. Did you bring the diagram of Mondstadt's defenses, as promised?",
            "nextDialogs": [
              "101220518"
            ]
          },
          "101220518": {
            "id": "101220518",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(Oh... so that's what's going on here...!)",
            "nextDialogs": [
              "101220519"
            ]
          },
          "101220519": {
            "id": "101220519",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Yes, of course. Here it is.",
            "nextDialogs": [
              "101220520"
            ]
          },
          "101220520": {
            "id": "101220520",
            "speakerId": 10391,
            "speakerName": "Sergei",
            "text": "Let me see... Huh. Why is it so poorly drawn? Everything's so squiggly and crooked. And what is this shape supposed to be?",
            "nextDialogs": [
              "101220521"
            ]
          },
          "101220521": {
            "id": "101220521",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Excuse me? I'll have you know that I went to great lengths to carefully draw this map by hand myself!",
            "nextDialogs": [
              "101220522"
            ]
          },
          "101220522": {
            "id": "101220522",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "That \"shape\" is the symbol of the Knights of Favonius.",
            "nextDialogs": [
              "101220523"
            ]
          },
          "101220523": {
            "id": "101220523",
            "speakerId": 10391,
            "speakerName": "Sergei",
            "text": "Ah, I see. Crude, but I can make do. Are you able to verify that this is all reliable information?",
            "nextDialogs": [
              "101220524"
            ]
          },
          "101220524": {
            "id": "101220524",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Of course, you needn't worry about that. Don't forget what we agreed upon, the flag of the Lawrence Clan will fly above the Knights of Favonius Headquarters.",
            "nextDialogs": [
              "101220525"
            ]
          },
          "101220525": {
            "id": "101220525",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "The rights to that building as well as the whole of Mondstadt belong to the Lawrence Clan.",
            "nextDialogs": [
              "101220526"
            ]
          },
          "101220526": {
            "id": "101220526",
            "speakerId": 10391,
            "speakerName": "Sergei",
            "text": "Yes, yes, we will both profit from this agreement. There's no use haggling over the details.",
            "nextDialogs": [
              "101220527"
            ]
          },
          "101220527": {
            "id": "101220527",
            "speakerId": 10391,
            "speakerName": "Sergei",
            "text": "We will make good use of the intel you provided. Also, be certain not to divulge our identity. There would be diplomatic consequences, you know.",
            "nextDialogs": [
              "101220528"
            ]
          },
          "101220528": {
            "id": "101220528",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Don't worry. This matter is only between you and I... and my new friend here. No one else will know of it.",
            "nextDialogs": [
              "101220529"
            ]
          },
          "101220529": {
            "id": "101220529",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Once this is over, I shall stand atop the Favonius Headquarters and rebuke their pathetic rule over Mondstadt. Then, the city and all its people will once again be under the rightful and unwavering rule of the Lawrence Clan!",
            "nextDialogs": [
              "101220530"
            ]
          },
          "101220530": {
            "id": "101220530",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Haha, perfect! Just as it once was, and just as it should be!",
            "nextDialogs": [
              "101220531"
            ]
          },
          "101220531": {
            "id": "101220531",
            "speakerId": 10391,
            "speakerName": "Sergei",
            "text": "*sigh*...",
            "nextDialogs": [
              "101220532"
            ]
          },
          "101220532": {
            "id": "101220532",
            "speakerId": 10391,
            "speakerName": "Sergei",
            "text": "May I remind you once again that we mustn't act rashly. That is all... for now.",
            "nextDialogs": [
              "101220533"
            ]
          },
          "101220533": {
            "id": "101220533",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Very well.",
            "nextDialogs": [
              "101220534"
            ]
          },
          "101220534": {
            "id": "101220534",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Very well.",
            "nextDialogs": [
              "101220535"
            ]
          },
          "101220535": {
            "id": "101220535",
            "speakerId": 10386,
            "speakerName": "Schubert",
            "text": "Huh, what are you doing?"
          }
        }
      }
    },

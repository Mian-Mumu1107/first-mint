      }
    },
    {
      "subId": "7216210",
      "subQuestName": "Activate the mechanism",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721621001"
        ],
        "dialogs": {
          "721621001": {
            "id": "721621001",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Ohh, what now!?",
            "nextDialogs": [
              "721621002"
            ]
          },
          "721621002": {
            "id": "721621002",
            "speakerId": 16867,
            "speakerName": "Fatui",
            "text": "Hand that picture over.",
            "nextDialogs": [
              "721621003"
            ]
          },
          "721621003": {
            "id": "721621003",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The Fatui!? Wh—What are they doing here!?",
            "nextDialogs": [
              "721621004"
            ]
          },
          "721621004": {
            "id": "721621004",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "It's just your ordinary, normal, run-of-the-mill picture! If you want it, just take it, alright?",
            "nextDialogs": [
              "721621005"
            ]
          },
          "721621005": {
            "id": "721621005",
            "speakerId": 16867,
            "speakerName": "Fatui",
            "text": "Is there anything else? Hand those over too!",
            "nextDialogs": [
              "721621006"
            ]
          },
          "721621006": {
            "id": "721621006",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Anything else? There's nothing else! I really only found this one picture!",
            "nextDialogs": [
              "721621007"
            ]
          },
          "721621007": {
            "id": "721621007",
            "speakerId": 16867,
            "speakerName": "Fatui",
            "text": "Hmph! Why would one crummy picture be hidden by so many complex mechanisms?",
            "nextDialogs": [
              "721621008"
            ]
          },
          "721621008": {
            "id": "721621008",
            "speakerId": 16867,
            "speakerName": "Fatui",
            "text": "If we hadn't trailed those samurai, we wouldn't have found this basement at all.",
            "nextDialogs": [
              "721621009"
            ]
          },
          "721621009": {
            "id": "721621009",
            "speakerId": 16867,
            "speakerName": "Fatui",
            "text": "We're not leaving empty-handed after so much waiting. Get them!",
            "nextDialogs": [
              "721621010"
            ]
          },
          "721621010": {
            "id": "721621010",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "I... I really... Traveler, please, help me!"
          }
        }
      }
    },
    {
      "subId": "7216207",
      "subQuestName": "Activate the mechanism",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620701"
        ],
        "dialogs": {
          "721620701": {
            "id": "721620701",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Just when did we catch the eye of those Treasure Hoarders...",
            "nextDialogs": [
              "721620702"
            ]
          },
          "721620702": {
            "id": "721620702",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Thank you, Traveler, let's head back to camp."
          }
        }
      }
    },
    {
      "subId": "7216208",
      "subQuestName": "Activate the mechanism again",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620801"
        ],
        "dialogs": {
          "721620801": {
            "id": "721620801",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Wh—What is going on...",
            "nextDialogs": [
              "721620802"
            ]
          },
          "721620802": {
            "id": "721620802",
            "speakerId": 20383,
            "speakerName": "Masterless Samurai",
            "text": "Please halt.",
            "nextDialogs": [
              "721620803"
            ]
          },
          "721620803": {
            "id": "721620803",
            "speakerId": 20383,
            "speakerName": "Masterless Samurai",
            "text": "Could we bother you to leave the treasure you found with us?",
            "nextDialogs": [
              "721620804"
            ]
          },
          "721620804": {
            "id": "721620804",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "What...",
            "nextDialogs": [
              "721620805"
            ]
          },
          "721620805": {
            "id": "721620805",
            "speakerId": 20383,
            "speakerName": "Masterless Samurai",
            "text": "Did you not just fight those Treasure Hoarders off to protect the treasure you found?",
            "nextDialogs": [
              "721620806"
            ]
          },
          "721620806": {
            "id": "721620806",
            "speakerId": 20383,
            "speakerName": "Masterless Samurai",
            "text": "It stands to reason, then, that it must be something very valuable.",
            "nextDialogs": [
              "721620807"
            ]
          },
          "721620807": {
            "id": "721620807",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "I thought I said that it was just one picture!",
            "nextDialogs": [
              "721620808"
            ]
          },
          "721620808": {
            "id": "721620808",
            "speakerId": 20383,
            "speakerName": "Masterless Samurai",
            "text": "It seems we are at an impasse, then. But we shall not be denied, not after following those Treasure Hoarders for all this time. Attack!",
            "nextDialogs": [
              "721620809"
            ]
          },
          "721620809": {
            "id": "721620809",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "H—Hey, listen to me, will you!? Traveler! Help!"
          }
        }
      }
    },
    {
      "subId": "7216209",
      "subQuestName": "Wait for Fujiwara Toshiko to open the chest",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620901"
        ],
        "dialogs": {
          "721620901": {
            "id": "721620901",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "These people aren't listening to me at all! I said it already, we only found one picture!",
            "nextDialogs": [
              "721620902"
            ]
          },
          "721620902": {
            "id": "721620902",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Let's go. We need to get back to my campsite..."
          }
        }
      }
    },
    {
      "subId": "7216219",
      "subQuestName": "Talk to Fujiwara Toshiko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620401"
        ],
        "dialogs": {
          "721620401": {
            "id": "721620401",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Why's there only this inside...",
            "nextDialogs": [
              "721620402"
            ]
          },
          "721620402": {
            "id": "721620402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "721620403"
            ]
          },
          "721620403": {
            "id": "721620403",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Other than this picture, there's nothing in this chest.",
            "nextDialogs": [
              "721620404"
            ]
          },
          "721620404": {
            "id": "721620404",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Is this the treasure? That's so odd.",
            "nextDialogs": [
              "721620405"
            ]
          },
          "721620405": {
            "id": "721620405",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "*sigh* I don't think we can split this, can we...",
            "nextDialogs": [
              "721620406"
            ]
          },
          "721620406": {
            "id": "721620406",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Well, how about this, then? Let's head back to my camp first.",
            "nextDialogs": [
              "721620407"
            ]
          },
          "721620407": {
            "id": "721620407",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "I'll provide you with the payment once we get back there.",
            "nextDialogs": [
              "721620408"
            ]
          },
          "721620408": {
            "id": "721620408",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Right, then. Let's go.",
            "nextDialogs": [
              "721620409"
            ]
          },
          "721620409": {
            "id": "721620409",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Only one picture? How strange..."
          }
        }
      }
    },
    {
      "subId": "7216211",
      "subQuestName": "Catch up with Fujiwara Toshiko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721621101"
        ],
        "dialogs": {
          "721621101": {
            "id": "721621101",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Wh—Why doesn't anyone believe that this picture is all I found? I mean...",
            "nextDialogs": [
              "721621102"
            ]
          },
          "721621102": {
            "id": "721621102",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "You've got to at least let your victim tell you what they've got while you're robbing them, right?",
            "nextDialogs": [
              "721621103"
            ]
          },
          "721621103": {
            "id": "721621103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's just go...",
            "nextDialogs": [
              "721621104"
            ]
          },
          "721621104": {
            "id": "721621104",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "*whimpers* A—Alright... Let's just get back to camp. I've had enough of this..."
          }
        }
      }
    },
    {
      "subId": "7216212",
      "subQuestName": "Follow Fujiwara Toshiko to the camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721621201"
        ],
        "dialogs": {
          "721621201": {
            "id": "721621201",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Meow!",
            "nextDialogs": [
              "721621202"
            ]
          },
          "721621202": {
            "id": "721621202",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Agh! Wh—Who is it this time! Please, I just found this one picture, that's all I found, honest!",
            "nextDialogs": [
              "721621203"
            ]
          },
          "721621203": {
            "id": "721621203",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "I'm sorry! I'm sorry! I'll never go looking for treasure ever again!",
            "nextDialogs": [
              "721621204"
            ]
          },
          "721621204": {
            "id": "721621204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's just a cat...",
            "nextDialogs": [
              "721621205"
            ]
          },
          "721621205": {
            "id": "721621205",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Eh? Is it? Oh..."
          }
        }
      }
    },

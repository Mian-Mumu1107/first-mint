    {
      "subId": "7216226",
      "subQuestName": "Talk to Fujiwara Toshiko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721621301"
        ],
        "dialogs": {
          "721621301": {
            "id": "721621301",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Phew, we're back at last. Hold on for a moment while I get your payment ready.",
            "nextDialogs": [
              "721621302"
            ]
          },
          "721621302": {
            "id": "721621302",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "That should do it. This isn't much, but please accept it.",
            "nextDialogs": [
              "721621303"
            ]
          },
          "721621303": {
            "id": "721621303",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "This treasure hunt sure turned out to be a mess — and all that for a single picture.",
            "nextDialogs": [
              "721621304"
            ]
          },
          "721621304": {
            "id": "721621304",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Why would my ancestors set up so many mechanisms just to protect one picture?",
            "nextDialogs": [
              "721621305"
            ]
          },
          "721621305": {
            "id": "721621305",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "I don't get it at all. Maybe I should bring this picture back to Inazuma City and ask around a bit...",
            "nextDialogs": [
              "721621306"
            ]
          },
          "721621306": {
            "id": "721621306",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Hmm, maybe I should go ask Mr. Oda Tarou..."
          }
        }
      }
    },

    {
      "subId": "7216203",
      "subQuestName": "Activate the mechanism",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620301"
        ],
        "dialogs": {
          "721620301": {
            "id": "721620301",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "This mechanism seems to be of the same kind as the one that we unlocked on the way in.",
            "nextDialogs": [
              "721620302"
            ]
          },
          "721620302": {
            "id": "721620302",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Just, you know... more complicated...",
            "nextDialogs": [
              "721620303"
            ]
          },
          "721620303": {
            "id": "721620303",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "But it's fine, right? I'm sure the ancestral map I've got has some clues for us!"
          }
        }
      }
    },
    {
      "subId": "7216205",
      "subQuestName": "Check and activate the mechanism",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620501"
        ],
        "dialogs": {
          "721620501": {
            "id": "721620501",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "The camp's not far now, we'll reach it in just a moment..."
          }
        }
      }
    },
    {
      "subId": "7216204",
      "subQuestName": "Talk to Fujiwara Toshiko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721629902"
        ],
        "dialogs": {
          "721629902": {
            "id": "721629902",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Wh—What was that noise...",
            "nextDialogs": [
              "721629903"
            ]
          },
          "721629903": {
            "id": "721629903",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Did you just see that? A giant... hole just opened up over there!",
            "nextDialogs": [
              "721629904"
            ]
          },
          "721629904": {
            "id": "721629904",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Looks like there's... some sort of basement here! Let's go in and have a look, come on!"
          }
        }
      }
    },
    {
      "subId": "7216206",
      "subQuestName": "Enter the basement",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620601"
        ],
        "dialogs": {
          "721620601": {
            "id": "721620601",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Eh? What is it this time...",
            "nextDialogs": [
              "721620602"
            ]
          },
          "721620602": {
            "id": "721620602",
            "speakerId": 10422,
            "speakerName": "Treasure Hoarder",
            "text": "Struck it rich, did you?",
            "nextDialogs": [
              "721620603"
            ]
          },
          "721620603": {
            "id": "721620603",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Y—You...",
            "nextDialogs": [
              "721620604"
            ]
          },
          "721620604": {
            "id": "721620604",
            "speakerId": 10422,
            "speakerName": "Treasure Hoarder",
            "text": "Hehe. Come on now, cut it with the nonsense. Give it up, or else! We're not leaving empty-handed...",
            "nextDialogs": [
              "721620605"
            ]
          },
          "721620605": {
            "id": "721620605",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "What? Wait a moment! All I found was this picture!",
            "nextDialogs": [
              "721620606"
            ]
          },
          "721620606": {
            "id": "721620606",
            "speakerId": 10422,
            "speakerName": "Treasure Hoarder",
            "text": "A picture? Well, we'll take that too! Come on lads, get 'er!",
            "nextDialogs": [
              "721620607"
            ]
          },
          "721620607": {
            "id": "721620607",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "H—Help me, Traveler, please!"
          }
        }
      }
    },
    {
      "subId": "7216217",
      "subQuestName": "Talk to Fujiwara Toshiko",
      "sceneId": null,
      "locations": [],

  "subQuests": [
    {
      "subId": "7216201",
      "subQuestName": "Rescue the person surrounded by monsters",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721620101"
        ],
        "dialogs": {
          "721620101": {
            "id": "721620101",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Th—Thank you... Phew, to think that these guys would try to catch me unaware like that...",
            "nextDialogs": [
              "721620104"
            ]
          },
          "721620104": {
            "id": "721620104",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "I'm Fujiwara Toshiko, and I'm here to... Um...",
            "nextDialogs": [
              "721620105"
            ]
          },
          "721620105": {
            "id": "721620105",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Never mind. Since you did save me, I might as well tell you.",
            "nextDialogs": [
              "721620106"
            ]
          },
          "721620106": {
            "id": "721620106",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "I'm actually here to find treasure that my ancestors left behind here!",
            "nextDialogs": [
              "721620107"
            ]
          },
          "721620107": {
            "id": "721620107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "T—Treasure...!",
            "nextDialogs": [
              "721620108"
            ]
          },
          "721620108": {
            "id": "721620108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And have you found it?",
            "nextDialogs": [
              "721620109"
            ]
          },
          "721620109": {
            "id": "721620109",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Hahaha, of course I have. I've followed some clues to the treasure's location, and I've ascertained my method of entry.",
            "nextDialogs": [
              "721620110"
            ]
          },
          "721620110": {
            "id": "721620110",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "But just as I was about to activate the switch and enter the area where the treasure is stored, those monsters sneaked up and attacked me.",
            "nextDialogs": [
              "721620111"
            ]
          },
          "721620111": {
            "id": "721620111",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "I owe you my life for chasing those monsters away. Thank you.",
            "nextDialogs": [
              "721620112"
            ]
          },
          "721620112": {
            "id": "721620112",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Um, so, could I...",
            "nextDialogs": [
              "721620113"
            ]
          },
          "721620113": {
            "id": "721620113",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "Could I ask you to protect me for a while longer?",
            "nextDialogs": [
              "721620114"
            ]
          },
          "721620114": {
            "id": "721620114",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "I still have to find that treasure, but I don't think I'll be able to handle all these monsters alone...",
            "nextDialogs": [
              "721620115"
            ]
          },
          "721620115": {
            "id": "721620115",
            "speakerId": 3063,
            "speakerName": "Fujiwara Toshiko",
            "text": "I'll... I'll even share some of the treasure with you!"
          }
        }
      }
    },
    {
      "subId": "7216202",

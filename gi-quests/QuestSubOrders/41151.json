              "411510303"
            ]
          },
          "411510303": {
            "id": "411510303",
            "speakerId": 1000,
            "speakerName": "Chef Mao",
            "text": "This Jueyun Chili Chicken won't hold up if you <color=#00E1FFFF>fly or climb all over the place, if you touch anything elements, or if you take too long</color>. Neglect one of these and you could ruin the taste.",
            "nextDialogs": [
              "411510304"
            ]
          },
          "411510304": {
            "id": "411510304",
            "speakerId": 1000,
            "speakerName": "Chef Mao",
            "text": "If something happens along the way, come back here and I'll make another serving. Whatever you do, don't bring the name of Wanmin Restaurant down."
          }

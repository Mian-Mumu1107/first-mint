    {
      "subId": "7153301",
      "subQuestName": "Talk to Mika",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715330101"
        ],
        "dialogs": {
          "715330101": {
            "id": "715330101",
            "speakerId": 1000,
            "speakerName": "Mika",
            "text": "Huh, this doesn't seem right, either... These gift envelopes are really hard to make.",
            "nextDialogs": [
              "715330102"
            ]
          },
          "715330102": {
            "id": "715330102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Mika, are you making gift envelopes?",
            "nextDialogs": [
              "715330103"
            ]
          },
          "715330103": {
            "id": "715330103",
            "speakerId": 1000,
            "speakerName": "Mika",
            "text": "#{NICKNAME}! What a coincidence! I wasn't expecting to see you here.",
            "nextDialogs": [
              "715330104"
            ]
          },
          "715330104": {
            "id": "715330104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you here to celebrate Lantern Rite?",
            "nextDialogs": [
              "715330105"
            ]
          },
          "715330105": {
            "id": "715330105",
            "speakerId": 1000,
            "speakerName": "Mika",
            "text": "Oh, no, no. I came to deliver a letter, and it just so happened to be during Lantern Rite.",
            "nextDialogs": [
              "715330106"
            ]
          },
          "715330106": {
            "id": "715330106",
            "speakerId": 1000,
            "speakerName": "Mika",
            "text": "Klee said she really wanted a Lantern Rite gift envelope, so I thought about buying one to take back.",
            "nextDialogs": [
              "715330107"
            ]
          },
          "715330107": {
            "id": "715330107",
            "speakerId": 1000,
            "speakerName": "Mika",
            "text": "Imagine my surprise when I found out you have to make them yourself...",
            "nextDialogs": [
              "715330108"
            ]
          },
          "715330108": {
            "id": "715330108",
            "speakerId": 1000,
            "speakerName": "Mika",
            "text": "I spent a long time trying to make one, but it still feels \"off\" for some reason. I can't tell where I went wrong...",
            "nextDialogs": [
              "715330109"
            ]
          },
          "715330109": {
            "id": "715330109",
            "speakerId": 1000,
            "speakerName": "Mika",
            "text": "#{NICKNAME}, you know more about Liyue customs than me... Could you give me some advice on how to improve it?",
            "nextDialogs": [
              "715330110"
            ]
          },
          "715330110": {
            "id": "715330110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hmm, let me think about it for a second..."
          }
        }
      }
    },

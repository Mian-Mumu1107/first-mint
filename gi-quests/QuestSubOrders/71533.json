        "dialogs": {
          "715330301": {
            "id": "715330301",
            "speakerId": 1000,
            "speakerName": "Mika",
            "text": "#Whoa, it's beautiful! So well made, and you did it so fast... You're amazing, {NICKNAME}!",
            "nextDialogs": [
              "715330302"
            ]
          },
          "715330302": {
            "id": "715330302",
            "speakerId": 1000,
            "speakerName": "Mika",
            "text": "...Oh no! I should really get going! I need to report back to the Knights!",
            "nextDialogs": [

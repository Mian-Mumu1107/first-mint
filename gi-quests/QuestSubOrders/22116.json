  "subQuests": [
    {
      "subId": "2211601",
      "subQuestName": "Talk to Chang the Ninth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221160301"
        ],
        "dialogs": {
          "221160301": {
            "id": "221160301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Epic battles.",
            "nextDialogs": [
              "221160302"
            ]
          },
          "221160302": {
            "id": "221160302",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Battles, eh... Battles... There's something to that idea. It's attention-grabbing, at least.",
            "nextDialogs": [
              "221160303"
            ]
          },
          "221160303": {
            "id": "221160303",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Though I can hardly find inspiration on that topic in Qingce Village... No battles here, let alone the epic variety...",
            "nextDialogs": [
              "221160304"
            ]
          },
          "221160304": {
            "id": "221160304",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "I'd need to look further afield... In the wild! Yes, that'd do it! I hear there are many adventurers out in the wild.",
            "nextDialogs": [
              "221160305"
            ]
          },
          "221160305": {
            "id": "221160305",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "They go roaming all over the place looking for treasure, and always end up in battle with monsters.",
            "nextDialogs": [
              "221160306"
            ]
          },
          "221160306": {
            "id": "221160306",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "As it happens, I know a place where there are plenty of monsters. Not your average monsters either, these ones are quite something! Yes! We can go there and wait for an adventurer to show up, and then witness the ensuing battle firsthand.",
            "nextDialogs": [
              "221160307"
            ]
          },
          "221160307": {
            "id": "221160307",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "And then... Haha, then I'd have everything I need! Right then! Without further ado, I shall be off! There's quite some distance to cover, so don't be too long yourselves, either!"
          }
        }
      }
    },
    {

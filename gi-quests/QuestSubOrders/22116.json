    {
      "subId": "2211609",
      "subQuestName": "Listen in on Zhihua and Qiming's conversation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221161001"
        ],
        "dialogs": {
          "221161001": {
            "id": "221161001",
            "speakerId": 1001,
            "speakerName": "Zhihua",
            "text": "Hello there, Qiming! Today, I—",
            "nextDialogs": [
              "221161002"
            ]
          },
          "221161002": {
            "id": "221161002",
            "speakerId": 1002,
            "speakerName": "Qiming",
            "text": "Today's not good for me.",
            "nextDialogs": [
              "221161003"
            ]
          },
          "221161003": {
            "id": "221161003",
            "speakerId": 1001,
            "speakerName": "Zhihua",
            "text": "...But I hadn't even said what it was yet.",
            "nextDialogs": [
              "221161004"
            ]
          },
          "221161004": {
            "id": "221161004",
            "speakerId": 1002,
            "speakerName": "Qiming",
            "text": "No need. I have a fairly good idea of where you were headed. And today is just not good for me.",
            "nextDialogs": [
              "221161005"
            ]
          },
          "221161005": {
            "id": "221161005",
            "speakerId": 1001,
            "speakerName": "Zhihua",
            "text": "Well then... when is a good day for you? Or don't you—",
            "nextDialogs": [
              "221161006"
            ]
          },
          "221161006": {
            "id": "221161006",
            "speakerId": 1002,
            "speakerName": "Qiming",
            "text": "Oh, don't worry. The day will come. It will be a very good day for me when it does.",
            "nextDialogs": [
              "221161007"
            ]
          },
          "221161007": {
            "id": "221161007",
            "speakerId": 1001,
            "speakerName": "Zhihua",
            "text": "...That tells me nothing! Qiming, please. Hear me out, now—",
            "nextDialogs": [
              "221161008"
            ]
          },
          "221161008": {
            "id": "221161008",
            "speakerId": 1002,
            "speakerName": "Qiming",
            "text": "Thank you, next!",
            "nextDialogs": [
              "221161009"
            ]
          },
          "221161009": {
            "id": "221161009",
            "speakerId": 1001,
            "speakerName": "Zhihua",
            "text": "But I haven't finished! And... what do you mean, \"next\"!? There isn't even a queue!"
          }
        }
      }
    },
    {
      "subId": "2211610",
      "subQuestName": "Listen in on Sisi and Chaoxi's conversation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221161101"
        ],
        "dialogs": {
          "221161101": {
            "id": "221161101",
            "speakerId": 1003,
            "speakerName": "Sisi",
            "text": "Chaoxi, you're back! I just found out how to cook this amazing new dish. Why not come back with me? I'll cook it for you!",
            "nextDialogs": [
              "221161102"
            ]
          },
          "221161102": {
            "id": "221161102",
            "speakerId": 1004,
            "speakerName": "Chaoxi",
            "text": "Sisi, I literally just got back and I'm completely drained, mentally and physically. I just need to lie down right now...",
            "nextDialogs": [
              "221161103"
            ]
          },
          "221161103": {
            "id": "221161103",
            "speakerId": 1003,
            "speakerName": "Sisi",
            "text": "Yes, of course — all that hard work, you must be exhausted. Definitely get some rest.",
            "nextDialogs": [
              "221161104"
            ]
          },
          "221161104": {
            "id": "221161104",
            "speakerId": 1003,
            "speakerName": "Sisi",
            "text": "So... Let's have a proper catch-up after you've fully recovered, shall we? We could always set a date now...",
            "nextDialogs": [
              "221161105"
            ]
          },
          "221161105": {
            "id": "221161105",
            "speakerId": 1004,
            "speakerName": "Chaoxi",
            "text": "Sure, sounds great. I'll let you know. I just can't commit to a specific date right now... I'm not trying to get out of it, I just don't want to make a promise I can't keep...",
            "nextDialogs": [
              "221161106"
            ]
          },
          "221161106": {
            "id": "221161106",
            "speakerId": 1004,
            "speakerName": "Chaoxi",
            "text": "*sigh* I'm a sailor, Sisi. And as a sailor, I'm married to the sea. You deserve much better...",
            "nextDialogs": [
              "221161107"
            ]
          },
          "221161107": {
            "id": "221161107",
            "speakerId": 1003,
            "speakerName": "Sisi",
            "text": "Don't talk like that, Chaoxi... You know I understand..."
          }
        }
      }
    },
    {
      "subId": "2211611",
      "subQuestName": "Listen in on the conversation between Little Meng, Little Fei, and Little Lulu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221161201"
        ],
        "dialogs": {
          "221161201": {
            "id": "221161201",
            "speakerId": 1005,
            "speakerName": "Little Meng",
            "text": "Lulu, it's definitely Fei's turn to be the captain this time.",
            "nextDialogs": [
              "221161202"
            ]
          },
          "221161202": {
            "id": "221161202",
            "speakerId": 1006,
            "speakerName": "Little Fei",
            "text": "Right! I keep saying, why do I have to be the first mate all the time?",
            "nextDialogs": [
              "221161203"
            ]
          },
          "221161203": {
            "id": "221161203",
            "speakerId": 1007,
            "speakerName": "Little Lulu",
            "text": "I just think it's more fun for everyone involved when Meng is the captain.",
            "nextDialogs": [
              "221161204"
            ]
          },
          "221161204": {
            "id": "221161204",
            "speakerId": 1005,
            "speakerName": "Little Meng",
            "text": "That's a bit unfair, Lulu. I think Fei plays it very well.",
            "nextDialogs": [
              "221161205"
            ]
          },
          "221161205": {
            "id": "221161205",
            "speakerId": 1007,
            "speakerName": "Little Lulu",
            "text": "Everyone plays their parts very well. You as the captain, me as the rich merchant, and Fei as first mate.",
            "nextDialogs": [
              "221161206"
            ]
          },
          "221161206": {
            "id": "221161206",
            "speakerId": 1007,
            "speakerName": "Little Lulu",
            "text": "And this time is gonna be the funnest of all! What do you think, Fei?",
            "nextDialogs": [
              "221161207"
            ]
          },
          "221161207": {
            "id": "221161207",
            "speakerId": 1005,
            "speakerName": "Little Meng",
            "text": "Lulu, come on...",
            "nextDialogs": [
              "221161208"
            ]
          },
          "221161208": {
            "id": "221161208",
            "speakerId": 1006,
            "speakerName": "Little Fei",
            "text": "Well... If that's what you think, Lulu... I—I guess it's okay by me.",
            "nextDialogs": [
              "221161209"
            ]
          },
          "221161209": {
            "id": "221161209",
            "speakerId": 1005,
            "speakerName": "Little Meng",
            "text": "Fei...! We've talked about this...",
            "nextDialogs": [
              "221161210"
            ]
          },
          "221161210": {
            "id": "221161210",
            "speakerId": 1006,
            "speakerName": "Little Fei",
            "text": "No, it's fine. I don't mind. Whatever makes Lulu happy. Come on, let's play.",
            "nextDialogs": [
              "221161211"
            ]
          },
          "221161211": {
            "id": "221161211",
            "speakerId": 1006,
            "speakerName": "Little Fei",
            "text": "Captain shmaptain. Not like I care.",
            "nextDialogs": [
              "221161212"
            ]
          },
          "221161212": {
            "id": "221161212",
            "speakerId": 1005,
            "speakerName": "Little Meng",
            "text": "...Ugh, you guys are unbelievable..."
          }
        }
      }
    },
    {
      "subId": "2211607",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221160701"
        ],
        "dialogs": {
          "221160701": {
            "id": "221160701",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Last time I went into the city, I saw a man talking to a young lady who appeared to be a fortune-teller. He was prattling away... I didn't bother to listen in.",
            "nextDialogs": [
              "221160702"
            ]
          },
          "221160702": {
            "id": "221160702",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "I later found out the garrulous gent's name is Zhihua, and the fortune-telling lady's is Qiming. Seems there's some history there... Why don't you go ask them about their stories? If it's anything interesting, come back and fill me in."
          }
        }
      }
    },
    {
      "subId": "2211612",
      "subQuestName": "Report back to Chang the Ninth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221161301"
        ],
        "dialogs": {
          "221161301": {
            "id": "221161301",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Well, how'd it go? Got a story for me?",
            "nextDialogs": [
              "221161302"
            ]
          },
          "221161302": {
            "id": "221161302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here are our notes.",
            "nextDialogs": [
              "221161303"
            ]
          },
          "221161303": {
            "id": "221161303",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Great! Let me see... Zhihua and Qiming! I knew it...",
            "nextDialogs": [
              "221161304"
            ]
          },
          "221161304": {
            "id": "221161304",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Mm-hmm... Yes... This is great material! Excellent!",
            "nextDialogs": [
              "221161305"
            ]
          },
          "221161305": {
            "id": "221161305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Seriously?",
            "nextDialogs": [
              "221161306"
            ]
          },
          "221161306": {
            "id": "221161306",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Can't you see? Maybe it isn't obvious at first, but if you look closely, there's a subtle but powerful tension here... There's clearly something going on between these two, they've just agreed to keep it to themselves...",
            "nextDialogs": [
              "221161307"
            ]
          },
          "221161307": {
            "id": "221161307",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Mm, yes... I think I have the beginnings of a plot...",
            "nextDialogs": [
              "221161308"
            ]
          },
          "221161308": {
            "id": "221161308",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Oh, and please take these. Thanks for your help! Now, to think... perchance, to write..."
          }
        }
      }
    },
    {
      "subId": "2211608",
      "subQuestName": "Talk to Chang the Ninth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221160501"
        ],
        "dialogs": {
          "221160501": {
            "id": "221160501",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Hey, this is great... Now I can say I've experienced an epic battle firsthand!",
            "nextDialogs": [
              "221160502"
            ]
          },
          "221160502": {
            "id": "221160502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I thought you just wanted to watch from a distance?",
            "nextDialogs": [
              "221160503"
            ]
          },
          "221160503": {
            "id": "221160503",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Well, yes, that was the original idea. But then the adventurers I was counting on didn't show up...",
            "nextDialogs": [
              "221160504"
            ]
          },
          "221160504": {
            "id": "221160504",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "I noticed the monsters were slowly starting to make a move. If they'd all left, this would have been a wasted trip.",
            "nextDialogs": [
              "221160505"
            ]
          },
          "221160505": {
            "id": "221160505",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "So... I threw a stone at them. That's how the stories always go, isn't it? Throw a stone, get their attention. Or something.",
            "nextDialogs": [
              "221160506"
            ]
          },
          "221160506": {
            "id": "221160506",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "How was I to know the stone would hit one of them square on the head? And then... Well, you know the rest.",
            "nextDialogs": [
              "221160507"
            ]
          },
          "221160507": {
            "id": "221160507",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Anyway, all's well that ends well. Sure, I got some scrapes and bruises... but boy, did I get a story too. And that's what I came for.",
            "nextDialogs": [
              "221160508"
            ]
          },
          "221160508": {
            "id": "221160508",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Finally, I can feel the creative juices starting to flow! Oh — by the way, take this for your trouble. Thanks.",
            "nextDialogs": [
              "221160509"
            ]
          },
          "221160509": {
            "id": "221160509",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Methinks my writer's block has been dealt a fatal blow! I must away, my pen and paper eagerly await my return..."
          }
        }
      }
    },
    {
      "subId": "2211601",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221160101"
        ],
        "dialogs": {
          "221160101": {
            "id": "221160101",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "I just don't know where to start...",
            "nextDialogs": [
              "221160102"
            ]
          },
          "221160102": {
            "id": "221160102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you up to now?",
            "nextDialogs": [
              "221160103"
            ]
          },
          "221160103": {
            "id": "221160103",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Oh, it's you again. I'm writing a new novel — well, trying to. I just can't seem to find a compelling idea for an intro.",
            "nextDialogs": [
              "221160104"
            ]
          },
          "221160104": {
            "id": "221160104",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "I've been racking my brains for ages, but I'm at a complete loss. At this rate, who knows when I'll be able to start writing in earnest...",
            "nextDialogs": [
              "221160105"
            ]
          },
          "221160105": {
            "id": "221160105",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "You're a traveler, yes? You know what the world is like. So tell me, what do you think the key ingredient is to a successful novel?"
          }
        }
      }
    },
    {
      "subId": "2211608",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221160801"
        ],
        "dialogs": {
          "221160801": {
            "id": "221160801",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Now I think about it... do you know a Sisi, by any chance? She often hangs around the harbor, waiting for some sailor named Chaoxi.",
            "nextDialogs": [
              "221160802"
            ]
          },
          "221160802": {
            "id": "221160802",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "She seems to go out and look for him on quite a regular basis. There must be a backstory there, surely?",
            "nextDialogs": [
              "221160803"
            ]
          },
          "221160803": {
            "id": "221160803",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Do a little investigating, anyway. If you come across any good stories, note them down and bring them back here."
          }
        }
      }
    },
    {
      "subId": "2211609",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221160901"
        ],
        "dialogs": {
          "221160901": {
            "id": "221160901",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Ah yes, there's three children who are always playing down by the harbor. Meng, Lulu, Fei. Ring any bells?",
            "nextDialogs": [
              "221160902"
            ]
          },
          "221160902": {
            "id": "221160902",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "I know they're only children, but... between the three of them, they must have some tales to tell, surely.",
            "nextDialogs": [
              "221160903"
            ]
          },
          "221160903": {
            "id": "221160903",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Go and look into it, anyway. Make a note of any good material, and bring it back here."
          }
        }
      }
    },
    {
      "subId": "2211615",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221161501"
        ],
        "dialogs": {
          "221161501": {
            "id": "221161501",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Romance... I'd have my work cut out, that's for sure. My knowledge of romance is... let's say, broad strokes at the most..."
          }
        }
      }
    },
    {
      "subId": "2211616",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221161601"
        ],
        "dialogs": {
          "221161601": {
            "id": "221161601",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "But you have a point — there are plenty of people like me in the world who are completely lacking in experience or understanding of romance. The market is ripe for the taking.",
            "nextDialogs": [
              "221161602"
            ]
          },
          "221161602": {
            "id": "221161602",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "But how would I research for a romantic story? Let me see..."
          }
        }
      }
    },
    {
      "subId": "2211617",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221161701"
        ],
        "dialogs": {
          "221161701": {
            "id": "221161701",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Well, how'd it go? Got a story for me?",
            "nextDialogs": [
              "221161702"
            ]
          },
          "221161702": {
            "id": "221161702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here are our notes.",
            "nextDialogs": [
              "221161703"
            ]
          },
          "221161703": {
            "id": "221161703",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Ah, wonderful! Let me see... Hmm, something's not right with this Chaoxi chap... Wait, no, I take it back. Something's wrong with both of them.",
            "nextDialogs": [
              "221161704"
            ]
          },
          "221161704": {
            "id": "221161704",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Does this count as romance? Hmm... Well, romance or not, there's a plot here, at least. I can work with this.",
            "nextDialogs": [
              "221161705"
            ]
          },
          "221161705": {
            "id": "221161705",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Oh, and please take these. Thanks for bringing me some material. Now, I need to think about where to go with this story...",
            "nextDialogs": [
              "221161706"
            ]
          },
          "221161706": {
            "id": "221161706",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Hmm, I think it should work fine for a novel, although I shudder to think about how the real-life version of the story will end! Probably with the Millelith picking up the pieces...",
            "nextDialogs": [
              "221161707"
            ]
          },
          "221161707": {
            "id": "221161707",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "These two are headed for disaster..."
          }
        }
      }
    },
    {
      "subId": "2211618",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221161801"
        ],
        "dialogs": {
          "221161801": {
            "id": "221161801",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Well, how'd it go? Got a story for me?",
            "nextDialogs": [
              "221161802"
            ]
          },
          "221161802": {
            "id": "221161802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here are our notes.",
            "nextDialogs": [
              "221161803"
            ]
          },
          "221161803": {
            "id": "221161803",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Fabulous! ...But a little lacking in grit. They are only children, after all... Maybe if you went back in a few years, there'd be more of a blossoming romance there.",
            "nextDialogs": [
              "221161804"
            ]
          },
          "221161804": {
            "id": "221161804",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "I'll hold onto it, though. There's the beginnings of a story in there. It may not be bursting with romantic potential, but I can probably think of a way to flesh it out.",
            "nextDialogs": [
              "221161805"
            ]
          },
          "221161805": {
            "id": "221161805",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Oh, and please take these. Thanks for bringing me some material. Now, I need to think about how to develop it..."
          }
        }
      }
    },
    {
      "subId": "2211622",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221162201"
        ],
        "dialogs": {
          "221162201": {
            "id": "221162201",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Romantic thoughts, Chang, romantic thoughts... Hmm, this is really not my forte..."
          }
        }
      }
    }
  ]
}
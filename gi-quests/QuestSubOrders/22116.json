    {
      "subId": "2211605",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221160201"
        ],
        "dialogs": {
          "221160201": {
            "id": "221160201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Heart and soul.",
            "nextDialogs": [
              "221160202"
            ]
          },
          "221160202": {
            "id": "221160202",
            "speakerId": 1000,
            "speakerName": "Chang the Ninth",
            "text": "Oh, come on. Don't give me that nonsense! I'm asking a serious question here!"
          }
        }
      }
    },

          "769070102": {
            "id": "769070102",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "It's only after coming to Nod-Krai that I've truly begun to understand what I missed out on.",
            "nextDialogs": [
              "769070103"
            ]
          },
          "769070103": {
            "id": "769070103",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "It's not like I've been idle these past few years, but compared to those brave knights in the expedition party who faced countless challenges in the ice and snow, I really am too weak.",
            "nextDialogs": [
              "769070104"
            ]
          },
          "769070104": {
            "id": "769070104",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "Whether it's combat skills or knightly chivalry, I can't keep lagging behind the rest!",
            "nextDialogs": [
              "769070105"
            ]
          },
          "769070105": {
            "id": "769070105",
            "speakerId": 1000,
            "speakerName": "Godwin",
            "text": "These are some things I picked up from the others. They might not seem like much to you, but I'll share them with you anyway!"
          }

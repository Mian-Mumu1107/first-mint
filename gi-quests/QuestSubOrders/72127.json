  "subQuests": [
    {
      "subId": "7212701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721270101"
        ],
        "dialogs": {
          "721270101": {
            "id": "721270101",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Hello, you're here. Do you see a lot of flowers in bloom? Aren't they pretty?",
            "nextDialogs": [
              "721270103",
              "721270105"
            ]
          },
          "721270103": {
            "id": "721270103",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Hehe...that's for sure. I'm taking good care of them...",
            "nextDialogs": [
              "721270106"
            ]
          },
          "721270106": {
            "id": "721270106",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "By the way, can you do me a favor again? Now that the flowers are blooming so well, I was going to pick some flowers and make them into dried flowers, and send them along with letters to those who have yet to return to Tatarasuna.",
            "nextDialogs": [
              "721270107"
            ]
          },
          "721270107": {
            "id": "721270107",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "But... I don't know if it's because I had too little sleep, I just went out to pick a few flowers and I'm already so tired...",
            "nextDialogs": [
              "721270108"
            ]
          },
          "721270108": {
            "id": "721270108",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Could you please help me pick some Sweet Flowers around here? Just three will do."
          },
          "721270105": {
            "id": "721270105",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "It's not that long, it's just... I just sleep a little less."
          }
        }
      }
    },
    {
      "subId": "7212702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721270201"
        ],
        "dialogs": {
          "721270201": {
            "id": "721270201",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Have you gathered the Sweet Flowers?"
          }
        }
      }
    },
    {
      "subId": "7212703",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721270301"
        ],
        "dialogs": {
          "721270301": {
            "id": "721270301",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Thank you. These Sweet Flowers should be enough. I'll go make the dried flowers.",
            "nextDialogs": [
              "721270302"
            ]
          },
          "721270302": {
            "id": "721270302",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Oh yes, I have a small present for you.",
            "nextDialogs": [
              "721270303"
            ]
          },
          "721270303": {
            "id": "721270303",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Here, please take this dried flower. Although it is a bit withered, but it's a very valuable flower.",
            "nextDialogs": [
              "721270307",
              "721270306"
            ]
          },
          "721270307": {
            "id": "721270307",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "This is the first flower that bloomed in this sea of flowers. You helped me find the flower seeds, so I would like to give you this flower.",
            "nextDialogs": [
              "721270308"
            ]
          },
          "721270308": {
            "id": "721270308",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Although it isn't anything very valuable, but still... thank you very much!",
            "nextDialogs": [
              "721270309"
            ]
          },
          "721270309": {
            "id": "721270309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm sure everyone will return.",
            "nextDialogs": [
              "721270310"
            ]
          },
          "721270310": {
            "id": "721270310",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "That's right! And that's why I need to plant more flowers so that when everyone comes back, they can see more flowers."
          },
          "721270306": {
            "id": "721270306",
            "speakerId": 3165,
            "speakerName": "Hanayama Kaoru",
            "text": "Of course there's something special about it! If there weren't, I wouldn't be giving it to you."
          }
        }
      }
    }
  ]
}
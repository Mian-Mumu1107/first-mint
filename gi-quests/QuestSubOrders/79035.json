        "dialogs": {
          "790350101": {
            "id": "790350101",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "#{NICKNAME}, Paimon, have you met two bake-danuki recently, by any chance? One of them carries a purple cloth bag, while the other has a yellow one...",
            "nextDialogs": [
              "790350102"
            ]
          },
          "790350102": {
            "id": "790350102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh! You must be talking about Mamesuke and Shibasuke!",
            "nextDialogs": [
              "790350103"
            ]
          },
          "790350103": {
            "id": "790350103",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "Ah, great, so you do know them.",
            "nextDialogs": [
              "790350104"
            ]
          },
          "790350104": {
            "id": "790350104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um, did something happen to them?",
            "nextDialogs": [
              "790350105"
            ]
          },
          "790350105": {
            "id": "790350105",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "Not really, they just made a bunch of gestures before giving me this...",
            "nextDialogs": [
              "790350106"
            ]
          },
          "790350106": {
            "id": "790350106",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "I've heard that you once visited the Good Hunter with a bake-danuki from Inazuma, so I thought you might be friends. I think they wanted me to give this to you.",
            "nextDialogs": [
              "790350107"
            ]
          },
          "790350107": {
            "id": "790350107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh! So this is a gift from Mamesuke and Shibasuke!",
            "nextDialogs": [
              "790350108"
            ]
          },
          "790350108": {
            "id": "790350108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, looks like their journey's off to a good start! Paimon wonders if we'll ever meet again..."
          }
        }
      }

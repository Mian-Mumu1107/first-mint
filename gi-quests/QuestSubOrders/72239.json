  "subQuests": [
    {
      "subId": "7223901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722390101"
        ],
        "dialogs": {
          "722390101": {
            "id": "722390101",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Never give up, children. Hope is amongst you...",
            "nextDialogs": [
              "722390102"
            ]
          },
          "722390102": {
            "id": "722390102",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Is that you? Children? Have you succeeded, my children?",
            "nextDialogs": [
              "722390103"
            ]
          },
          "722390103": {
            "id": "722390103",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "No... I can feel it. You are not...",
            "nextDialogs": [
              "722390104"
            ]
          },
          "722390104": {
            "id": "722390104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, this person seems to have gone blind before becoming an afterimage...",
            "nextDialogs": [
              "722390105"
            ]
          },
          "722390105": {
            "id": "722390105",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Whoever you are, please, could you help me? Help me find my children! I must tell them something.",
            "nextDialogs": [
              "722390106"
            ]
          },
          "722390106": {
            "id": "722390106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uhh, first off, who are you?",
            "nextDialogs": [
              "722390107"
            ]
          },
          "722390107": {
            "id": "722390107",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "My... my name is...",
            "nextDialogs": [
              "722390108"
            ]
          },
          "722390108": {
            "id": "722390108",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I've... forgotten my name...",
            "nextDialogs": [
              "722390109"
            ]
          },
          "722390109": {
            "id": "722390109",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I only remember... I once stood forward for Byakuyakoku, and I fought for hope.",
            "nextDialogs": [
              "722390110"
            ]
          },
          "722390110": {
            "id": "722390110",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "To this day, I remain a member of the resistance.",
            "nextDialogs": [
              "722390111"
            ]
          },
          "722390111": {
            "id": "722390111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But what would you be resisting down here in Byakuyakoku?",
            "nextDialogs": [
              "722390112"
            ]
          },
          "722390112": {
            "id": "722390112",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Those filthy, holier-than-thou nobles, of course!",
            "nextDialogs": [
              "722390113"
            ]
          },
          "722390113": {
            "id": "722390113",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "They claim to have received some divine decree and fly the flag of the gods, but they only seek to satiate their base desires!",
            "nextDialogs": [
              "722390114"
            ]
          },
          "722390114": {
            "id": "722390114",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Ostensibly, they guard the Sunchild. But in truth, they are the real rulers of the nation — parasitic worms who suck the flesh and blood of the people!",
            "nextDialogs": [
              "722390115"
            ]
          },
          "722390115": {
            "id": "722390115",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "They must. Be. Destroyed.",
            "nextDialogs": [
              "722390116"
            ]
          },
          "722390116": {
            "id": "722390116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You remember all this so well, but you don't even remember your name...",
            "nextDialogs": [
              "722390117"
            ]
          },
          "722390117": {
            "id": "722390117",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "This only goes to show how cruel their methods are!",
            "nextDialogs": [
              "722390118"
            ]
          },
          "722390118": {
            "id": "722390118",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I was captured after our previous failure, imprisoned here in this altar, and tortured.",
            "nextDialogs": [
              "722390119"
            ]
          },
          "722390119": {
            "id": "722390119",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "This prison is a malignant thing. Even now, I can feel my soul being ground down, precious things stripped away from me...",
            "nextDialogs": [
              "722390120"
            ]
          },
          "722390120": {
            "id": "722390120",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Please, kind soul, I beg you! While I still yet remember, help me find my children!",
            "nextDialogs": [
              "722390121"
            ]
          },
          "722390121": {
            "id": "722390121",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Tell them to never give up, for hope lives amongst them...",
            "nextDialogs": [
              "722390122"
            ]
          },
          "722390122": {
            "id": "722390122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Your children?",
            "nextDialogs": [
              "722390123"
            ]
          },
          "722390123": {
            "id": "722390123",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "There is a group of bright young minds who follow me willingly. They are my students, and our reserve force. I see them as my own children.",
            "nextDialogs": [
              "722390124"
            ]
          },
          "722390124": {
            "id": "722390124",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Those wicked people at the top used all manner of ways to pry my mouth open and force me to give those children up, but I did not.",
            "nextDialogs": [
              "722390125"
            ]
          },
          "722390125": {
            "id": "722390125",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "After all, I know that hope lives amongst them...",
            "nextDialogs": [
              "722390126"
            ]
          },
          "722390126": {
            "id": "722390126",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They're probably all gone by this point...",
            "nextDialogs": [
              "722390127"
            ]
          },
          "722390127": {
            "id": "722390127",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "No, never! They are good children. They will surely hold on to our ideals.",
            "nextDialogs": [
              "722390128"
            ]
          },
          "722390128": {
            "id": "722390128",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I haven't given up... nor do I believe that they have, either.",
            "nextDialogs": [
              "722390129"
            ]
          },
          "722390129": {
            "id": "722390129",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How will we find them?",
            "nextDialogs": [
              "722390130"
            ]
          },
          "722390130": {
            "id": "722390130",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I remember that. Surely, I do...",
            "nextDialogs": [
              "722390131"
            ]
          },
          "722390131": {
            "id": "722390131",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Let me tell you where they are hiding.",
            "nextDialogs": [
              "722390132"
            ]
          },
          "722390132": {
            "id": "722390132",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But if we do find them, how will we explain ourselves to them?",
            "nextDialogs": [
              "722390133"
            ]
          },
          "722390133": {
            "id": "722390133",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"We came here because a resistance member who has forgotten his name told us to?\"",
            "nextDialogs": [
              "722390134"
            ]
          },
          "722390134": {
            "id": "722390134",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "No, that will not do. I have taught them well. Unless you prove yourselves, they will not trust you.",
            "nextDialogs": [
              "722390135"
            ]
          },
          "722390135": {
            "id": "722390135",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "But I cannot even recall my own name... Curses!",
            "nextDialogs": [
              "722390136"
            ]
          },
          "722390136": {
            "id": "722390136",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#This guy seems like he was once a wanted criminal in Byakuyakoku, {NICKNAME} — the kind you'd write into the history books.",
            "nextDialogs": [
              "722390137"
            ]
          },
          "722390137": {
            "id": "722390137",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon bets that it shouldn't be hard for us to find some record of him. We might even find some nearby!",
            "nextDialogs": [
              "722390138"
            ]
          },
          "722390138": {
            "id": "722390138",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "If history should recall my name, I pray that that history may be written by those who inherit our will."
          }
        }
      }
    },
    {
      "subId": "7223902",
      "subQuestName": "Talk to the afterimage at the altar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

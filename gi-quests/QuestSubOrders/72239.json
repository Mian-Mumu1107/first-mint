      }
    },
    {
      "subId": "7223903",
      "subQuestName": "Help the afterimage find out their identity",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722392401"
        ],
        "dialogs": {
          "722392401": {
            "id": "722392401",
            "speakerId": 20489,
            "speakerName": "An Ancient Stone Tablet",
            "text": "(There are two rows of text on this headstone. The first row is in the script of Byakuyakoku and is unintelligible.)",
            "nextDialogs": [
              "722392402"
            ]
          },
          "722392402": {
            "id": "722392402",
            "speakerId": 20489,
            "speakerName": "An Ancient Stone Tablet",
            "text": "The second row is in the common script, and it reads as follows:",
            "nextDialogs": [
              "722392403"
            ]
          },
          "722392403": {
            "id": "722392403",
            "speakerId": 20489,
            "speakerName": "An Ancient Stone Tablet",
            "text": "\"Here lies Spartacus the Righteous, known now as Supada no Hiko. Beneath lies the litany of his crimes. Read them and remember our history.\"",
            "nextDialogs": [
              "722392404"
            ]
          },
          "722392404": {
            "id": "722392404",
            "speakerId": 20489,
            "speakerName": "An Ancient Stone Tablet",
            "text": "\"Supada no Hiko, the notorious outlaw, mastermind of great crimes, and the root of unrest. Now in the name of Tokoyo Ookami, may his sight be cut off, and may his soul be crushed. May he be thrown into a deep prison, now and forever.\""
          }
        }
      }
    },
    {
      "subId": "7223920",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722391301"
        ],
        "dialogs": {
          "722391301": {
            "id": "722391301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh, this reads... \"The Bandit, Supada no Hiko\"?",
            "nextDialogs": [
              "722391302"
            ]
          },
          "722391302": {
            "id": "722391302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, no, it should just be \"Supada no Hiko.\" That's that man's name! Let's go tell him, quick!"
          }
        }
      }
    },
    {
      "subId": "7223904",
      "subQuestName": "Report back to the afterimage",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722390301"
        ],
        "dialogs": {
          "722390301": {
            "id": "722390301",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "You... Who are you? You sound quite familiar...",
            "nextDialogs": [
              "722390302"
            ]
          },
          "722390302": {
            "id": "722390302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? You've forgotten us already? Oh no, you're in worse shape than Paimon thought...",
            "nextDialogs": [
              "722390303"
            ]
          },
          "722390303": {
            "id": "722390303",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Thank you. Are we truly acquainted?",
            "nextDialogs": [
              "722390306"
            ]
          },
          "722390306": {
            "id": "722390306",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Ah, yes, I remember. In this place, your very soul shall be eroded. My memories must have been ground away too severely.",
            "nextDialogs": [
              "722390307"
            ]
          },
          "722390307": {
            "id": "722390307",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I'm sorry, I... *sigh*",
            "nextDialogs": [
              "722390308"
            ]
          },
          "722390308": {
            "id": "722390308",
            "speakerId": 20344,
            "speakerName": "Supada no Hiko",
            "text": "Did you manage to find anything useful, then?"
          }
        }
      }
    },
    {
      "subId": "7223905",
      "subQuestName": "Find where the \"children are hidden\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722390501"
        ],
        "dialogs": {
          "722390501": {
            "id": "722390501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "If we've got the time, why don't we try making some Dragonbone Orbs?",
            "nextDialogs": [
              "722390502"
            ]
          },
          "722390502": {
            "id": "722390502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's never heard of such a thing."
          }
        }
      }
    },
    {
      "subId": "7223906",
      "subQuestName": "Talk to the afterimage in the hiding place",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722391901"
        ],
        "dialogs": {
          "722391901": {
            "id": "722391901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "After the sun, the darkness starts...",
            "nextDialogs": [
              "722391902"
            ]
          },
          "722391902": {
            "id": "722391902",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "...But true light hides... within our hearts.",
            "nextDialogs": [
              "722391903"
            ]
          },
          "722391903": {
            "id": "722391903",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "...I'd almost forgotten. It's been so long since I've heard this phrase.",
            "nextDialogs": [
              "722391904"
            ]
          },
          "722391904": {
            "id": "722391904",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "Tell me, my good comrade, who sent you?",
            "nextDialogs": [
              "722391905"
            ]
          },
          "722391905": {
            "id": "722391905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Supada no Hiko.",
            "nextDialogs": [
              "722391906"
            ]
          },
          "722391906": {
            "id": "722391906",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "Master Spartacus!? Master sent you!?",
            "nextDialogs": [
              "722391907"
            ]
          },
          "722391907": {
            "id": "722391907",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "Where is he? I only know that he was captured during the uprising by the henchmen of the Sunchild. We lost all contact with him after that.",
            "nextDialogs": [
              "722391908"
            ]
          },
          "722391908": {
            "id": "722391908",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He's been locked in the altar at the Serpent's Heart, and judging by how things look, he can't get out. That's why he sent us to look for you.",
            "nextDialogs": [
              "722391909"
            ]
          },
          "722391909": {
            "id": "722391909",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "That accursed Sunchild...",
            "nextDialogs": [
              "722391910"
            ]
          },
          "722391910": {
            "id": "722391910",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "What instructions did Master entrust you with?",
            "nextDialogs": [
              "722391911"
            ]
          },
          "722391911": {
            "id": "722391911",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He just asked us to carry a message.",
            "nextDialogs": [
              "722391912"
            ]
          },
          "722391912": {
            "id": "722391912",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Never give up, children. The hope of Byakuyakoku lives amongst you.\"",
            "nextDialogs": [
              "722391913"
            ]
          },
          "722391913": {
            "id": "722391913",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "...",
            "nextDialogs": [
              "722391914"
            ]
          },
          "722391914": {
            "id": "722391914",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "...",
            "nextDialogs": [
              "722391915"
            ]
          },
          "722391915": {
            "id": "722391915",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "I... I'm sorry! We have failed you, Master!",
            "nextDialogs": [
              "722391916"
            ]
          },
          "722391916": {
            "id": "722391916",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "722391917"
            ]
          },
          "722391917": {
            "id": "722391917",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "The resistance is no more.",
            "nextDialogs": [
              "722391918"
            ]
          },
          "722391918": {
            "id": "722391918",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh!?",
            "nextDialogs": [
              "722391919"
            ]
          },
          "722391919": {
            "id": "722391919",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "After Master was captured, the backbone of the resistance collapsed utterly.",
            "nextDialogs": [
              "722391920"
            ]
          },
          "722391920": {
            "id": "722391920",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "Only those of us students who followed him ordinarily escaped thanks to being far from the center of events.",
            "nextDialogs": [
              "722391921"
            ]
          },
          "722391921": {
            "id": "722391921",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "Afterward, those of us who were lucky enough to get away fled to our pre-prepared hiding places, hoping to muster our strength once more.",
            "nextDialogs": [
              "722391922"
            ]
          },
          "722391922": {
            "id": "722391922",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "We have excellent strategists, professional scholars, skilled mystics, and reliable doctors amongst us...",
            "nextDialogs": [
              "722391923"
            ]
          },
          "722391923": {
            "id": "722391923",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, that sounds promising!",
            "nextDialogs": [
              "722391924"
            ]
          },
          "722391924": {
            "id": "722391924",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "That's what we thought too. Given time, we believed that we could revitalize the movement.",
            "nextDialogs": [
              "722391925"
            ]
          },
          "722391925": {
            "id": "722391925",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "But all these things needed funds... which we didn't have any of.",
            "nextDialogs": [
              "722391926"
            ]
          },
          "722391926": {
            "id": "722391926",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "Finally, someone suggested that we sell Dragonbone Orbs.",
            "nextDialogs": [
              "722391927"
            ]
          },
          "722391927": {
            "id": "722391927",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's a Dragonbone Orb?",
            "nextDialogs": [
              "722391928"
            ]
          },
          "722391928": {
            "id": "722391928",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "It is a rare fruit that Dragonbone Flowers will bear under special circumstances.",
            "nextDialogs": [
              "722391929"
            ]
          },
          "722391929": {
            "id": "722391929",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "Its fragrance can relax the mind and calm anxious thoughts, sweeping all of one's worries away. As such, it can fetch a very high price on the market.",
            "nextDialogs": [
              "722391930"
            ]
          },
          "722391930": {
            "id": "722391930",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is it really that mystical? You sure this isn't a scam?",
            "nextDialogs": [
              "722391931"
            ]
          },
          "722391931": {
            "id": "722391931",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "I only wish it were all a lie... Naive as I was, I did not perceive the perils that lay down that path.",
            "nextDialogs": [
              "722391932"
            ]
          },
          "722391932": {
            "id": "722391932",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "I do not know where the formula came from, but I do know that it did earn us a lot of capital.",
            "nextDialogs": [
              "722391933"
            ]
          },
          "722391933": {
            "id": "722391933",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "Everything was going so well... But soon, we discovered that some of our comrades suddenly began to avoid conflict and reject the idea of going into battle...",
            "nextDialogs": [
              "722391934"
            ]
          },
          "722391934": {
            "id": "722391934",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "The number of such people increased by the day, to the point where they requested to leave our ranks. I was unable to stop them...",
            "nextDialogs": [
              "722391935"
            ]
          },
          "722391935": {
            "id": "722391935",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How did this happen? Is this because the orbs earned you and your comrades so much money that most people lost the will to fight on?",
            "nextDialogs": [
              "722391948"
            ]
          },
          "722391948": {
            "id": "722391948",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "Do you mean the corrupting allure of money? No... I... I don't know.",
            "nextDialogs": [
              "722391949"
            ]
          },
          "722391949": {
            "id": "722391949",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "I only know that when oppressed peoples grow satisfied with their lives, they cease to resist.",
            "nextDialogs": [
              "722391936"
            ]
          },
          "722391936": {
            "id": "722391936",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "That was where the collapse started, and once it began, there was no stopping it.",
            "nextDialogs": [
              "722391947"
            ]
          },
          "722391947": {
            "id": "722391947",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "Sometimes, I actually wonder if the formula for making these things wasn't leaked to us by those despicable rulers...",
            "nextDialogs": [
              "722391950"
            ]
          },
          "722391950": {
            "id": "722391950",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "Sometimes I wonder if the best-selling nature of these orbs wasn't all a false pretense created by those despicable rulers...?",
            "nextDialogs": [
              "722391937"
            ]
          },
          "722391937": {
            "id": "722391937",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "*sigh* If Master had been there, I'm sure that he would have been able to control the situation. He might even have nipped it in the bud right from the start.",
            "nextDialogs": [
              "722391938"
            ]
          },
          "722391938": {
            "id": "722391938",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "I'm sorry, Master. We could not become hope...",
            "nextDialogs": [
              "722391941"
            ]
          },
          "722391941": {
            "id": "722391941",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "I cannot face him like this...",
            "nextDialogs": [
              "722391942"
            ]
          },
          "722391942": {
            "id": "722391942",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "But still, you have my thanks for bringing news of him.",
            "nextDialogs": [
              "722391943"
            ]
          },
          "722391943": {
            "id": "722391943",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "I do not have anything with which I can thank you. But if you do not mind, allow me to tell you the secret of the Dragonbone Orbs.",
            "nextDialogs": [
              "722391944"
            ]
          },
          "722391944": {
            "id": "722391944",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "They can only be created through the use of the waters of Tokoyo Reisen, that is to say, the waters of Lethe.",
            "nextDialogs": [
              "722391945"
            ]
          },
          "722391945": {
            "id": "722391945",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "Perhaps you might be able to exchange it for some money, or keep it for yourself.",
            "nextDialogs": [
              "722391946"
            ]
          },
          "722391946": {
            "id": "722391946",
            "speakerId": 20352,
            "speakerName": "Adonis",
            "text": "Still, be wary. Keep your desire to press onward about you."
          }
        }
      }
    },

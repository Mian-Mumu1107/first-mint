  "subQuests": [
    {
      "subId": "1050101",
      "subQuestName": "Go to Wangshu Inn en route to Mondstadt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105010101"
        ],
        "dialogs": {
          "105010101": {
            "id": "105010101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Since it's Mona's treat, we can order whatever we want, right?",
            "nextDialogs": [
              "105010102"
            ]
          },
          "105010102": {
            "id": "105010102",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Of course. I am a most generous master, after all. But only if you can finish it all. Wasting food simply will not do."
          }
        }
      }
    },
    {
      "subId": "1050113",
      "subQuestName": "Sit next to the table and accept Mona's invitation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1050102",
      "subQuestName": "Talk to Mona and enjoy a good meal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105011201"
        ],
        "dialogs": {
          "105011201": {
            "id": "105011201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll order them all.",
            "nextDialogs": [
              "105011202"
            ]
          },
          "105011202": {
            "id": "105011202",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "A—All of them? We only have three... No, two and a half people? Isn't that too much food?",
            "nextDialogs": [
              "105011203"
            ]
          },
          "105011203": {
            "id": "105011203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's not how you count it! Besides, Paimon hasn't even ordered yet!",
            "nextDialogs": [
              "105011204"
            ]
          },
          "105011204": {
            "id": "105011204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Squirrel Fish, Jueyun Chili Chicken, and Jewelry Soup, please!",
            "nextDialogs": [
              "105011205"
            ]
          },
          "105011205": {
            "id": "105011205",
            "speakerId": 2206,
            "speakerName": "Yuhua",
            "text": "Sure. And is there anything else that you would like to order, ma'am?",
            "nextDialogs": [
              "105011206"
            ]
          },
          "105011206": {
            "id": "105011206",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "I—I'd just like to ask, how much do the current dishes cost in total?",
            "nextDialogs": [
              "105011207"
            ]
          },
          "105011207": {
            "id": "105011207",
            "speakerId": 2206,
            "speakerName": "Yuhua",
            "text": "Um, around twenty thousand Mora.",
            "nextDialogs": [
              "105011208"
            ]
          },
          "105011208": {
            "id": "105011208",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Then... Uh, I—I'll just have some vegetarian noodles, please.",
            "nextDialogs": [
              "105011209"
            ]
          },
          "105011209": {
            "id": "105011209",
            "speakerId": 2206,
            "speakerName": "Yuhua",
            "text": "Alright. A bowl of vegetarian noodles, was it? Please wait a moment, we will serve you shortly.",
            "nextDialogs": [
              "105011210"
            ]
          },
          "105011210": {
            "id": "105011210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's been thinking about something since we started eating...",
            "nextDialogs": [
              "105011211"
            ]
          },
          "105011211": {
            "id": "105011211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why did she only order one dish?",
            "nextDialogs": [
              "105011212"
            ]
          },
          "105011212": {
            "id": "105011212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is it... because she actually doesn't have money?",
            "nextDialogs": [
              "105011213"
            ]
          },
          "105011213": {
            "id": "105011213",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "I heard that! I said I was treating. How could I be rattled by something as mundane as Mora!?",
            "nextDialogs": [
              "105011214"
            ]
          },
          "105011214": {
            "id": "105011214",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "An astrologist's mind is set on studying the stars. Being so easily disturbed by such banal matters would hamper my judgment.",
            "nextDialogs": [
              "105011215"
            ]
          },
          "105011215": {
            "id": "105011215",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Especially the act of overly gratifying oneself using Mora. It is both vulgar...",
            "nextDialogs": [
              "105011216"
            ]
          },
          "105011216": {
            "id": "105011216",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "*stomach grumble*",
            "nextDialogs": [
              "105011217"
            ]
          },
          "105011217": {
            "id": "105011217",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "...and dangerous.",
            "nextDialogs": [
              "105011218"
            ]
          },
          "105011218": {
            "id": "105011218",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So not eating the dishes we ordered is also part of an astrologist's pride? Paimon doesn't get it.",
            "nextDialogs": [
              "105011219"
            ]
          },
          "105011219": {
            "id": "105011219",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But it feels kinda bad that only we got to feast...",
            "nextDialogs": [
              "105011220"
            ]
          },
          "105011220": {
            "id": "105011220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let me whip something up for you.",
            "nextDialogs": [
              "105011221"
            ]
          },
          "105011221": {
            "id": "105011221",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, yes! We can do that! Just give us a minute!"
          }
        }
      }
    },
    {
      "subId": "1050114",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105011401"
        ],
        "dialogs": {
          "105011401": {
            "id": "105011401",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "There's no need to spend all that effort on me, I'm not in dire need of food...",
            "nextDialogs": [
              "105011402"
            ]
          },
          "105011402": {
            "id": "105011402",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "I am a little hungry... but it's not a big deal."
          }
        }
      }
    },
    {
      "subId": "1050103",
      "subQuestName": "Look for the innkeeper and ask to borrow the kitchen to make Mona a dish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105010201"
        ],
        "dialogs": {
          "105010201": {
            "id": "105010201",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Hello, how may I help you?",
            "nextDialogs": [
              "105010202"
            ]
          },
          "105010202": {
            "id": "105010202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We'd like to borrow the kitchen here.",
            "nextDialogs": [
              "105010205"
            ]
          },
          "105010205": {
            "id": "105010205",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Ah, I see. In that case, sure. As long as you've prepared your own ingredients, feel free to use the kitchen.",
            "nextDialogs": [
              "105010206"
            ]
          },
          "105010206": {
            "id": "105010206",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "If I may... You must be well-versed in the art of cooking, yes?"
          }
        }
      }
    },
    {
      "subId": "1050104",
      "subQuestName": "Cook Golden Crab",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105010401"
        ],
        "dialogs": {
          "105010401": {
            "id": "105010401",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Phew. That was tiring, but we're finally in Mondstadt.",
            "nextDialogs": [
              "105010402"
            ]
          },
          "105010402": {
            "id": "105010402",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "The quest to plumb the wondrous depths of knowledge is indeed arduous...",
            "nextDialogs": [
              "105010403"
            ]
          },
          "105010403": {
            "id": "105010403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's not tired.",
            "nextDialogs": [
              "105010404"
            ]
          },
          "105010404": {
            "id": "105010404",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Ugh, that's because you float.",
            "nextDialogs": [
              "105010405"
            ]
          },
          "105010405": {
            "id": "105010405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, it doesn't look like an astrologist is all that amazing either.",
            "nextDialogs": [
              "105010406"
            ]
          },
          "105010406": {
            "id": "105010406",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "That's because you have too many unrealistic fantasies about astrology.",
            "nextDialogs": [
              "105010407"
            ]
          },
          "105010407": {
            "id": "105010407",
            "speakerId": 10096,
            "speakerName": "Tyler",
            "text": "Are you also resting your feet here?",
            "nextDialogs": [
              "105010408"
            ]
          },
          "105010408": {
            "id": "105010408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Who are you?",
            "nextDialogs": [
              "105010409"
            ]
          },
          "105010409": {
            "id": "105010409",
            "speakerId": 10096,
            "speakerName": "Tyler",
            "text": "Oh, my brothers and I are all merchants. We just finished doing business in Liyue, and we're preparing to head back to Mondstadt.",
            "nextDialogs": [
              "105010410"
            ]
          },
          "105010410": {
            "id": "105010410",
            "speakerId": 10096,
            "speakerName": "Tyler",
            "text": "You look rather tired. The cart we hired will be coming in a while — what say you to coming along for the ride?",
            "nextDialogs": [
              "105010412",
              "105010414"
            ]
          },
          "105010412": {
            "id": "105010412",
            "speakerId": 10096,
            "speakerName": "Tyler",
            "text": "Haha, let's go, then. We can make conversation along the way, the more the merrier.",
            "nextDialogs": [
              "105010415"
            ]
          },
          "105010415": {
            "id": "105010415",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "There's no need. Now shoo. Get out of our way.",
            "nextDialogs": [
              "105010416"
            ]
          },
          "105010416": {
            "id": "105010416",
            "speakerId": 10096,
            "speakerName": "Tyler",
            "text": "Eh? Miss... Is there something wrong?",
            "nextDialogs": [
              "105010417"
            ]
          },
          "105010417": {
            "id": "105010417",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Cease your pretensions, bandit.",
            "nextDialogs": [
              "105010418"
            ]
          },
          "105010418": {
            "id": "105010418",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Picking up people on the road who appear vulnerable, robbing them blind once they've gotten on the cart, and then taking them to some archon-forsaken place — is that your deal?",
            "nextDialogs": [
              "105010419"
            ]
          },
          "105010419": {
            "id": "105010419",
            "speakerId": 10096,
            "speakerName": "Tyler",
            "text": "Wh—What are you saying? We came over here to make conversation, and this is how we're rewarded? With insults?",
            "nextDialogs": [
              "105010420"
            ]
          },
          "105010420": {
            "id": "105010420",
            "speakerId": 10096,
            "speakerName": "Tyler",
            "text": "If you don't want to get on, don't! Crazy girl...",
            "nextDialogs": [
              "105010421"
            ]
          },
          "105010421": {
            "id": "105010421",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Well then, shall I tell you now which objects you have on you that are stolen?",
            "nextDialogs": [
              "105010422"
            ]
          },
          "105010422": {
            "id": "105010422",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "If you have any quibbles, we can bring people to corroborate what I've said, and all will come to light.",
            "nextDialogs": [
              "105010423"
            ]
          },
          "105010423": {
            "id": "105010423",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "If I lose, I'll pay you twenty thousand Mora. But if I win, then you'll be eating prison rations in Liyue Harbor tonight.",
            "nextDialogs": [
              "105010424"
            ]
          },
          "105010424": {
            "id": "105010424",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "How about it? If you're real legitimate businessmen, there's nothing to fear, is there?",
            "nextDialogs": [
              "105010425"
            ]
          },
          "105010425": {
            "id": "105010425",
            "speakerId": 10096,
            "speakerName": "Tyler",
            "text": "You... You!",
            "nextDialogs": [
              "105010426"
            ]
          },
          "105010426": {
            "id": "105010426",
            "speakerId": 10096,
            "speakerName": "Tyler",
            "text": "You've pushed it too far, brat!",
            "nextDialogs": [
              "105010427"
            ]
          },
          "105010427": {
            "id": "105010427",
            "speakerId": 10096,
            "speakerName": "Tyler",
            "text": "I don't know how you found out, but as long as we get rid of you, no one will have to know!"
          },
          "105010414": {
            "id": "105010414",
            "speakerId": 10096,
            "speakerName": "Tyler",
            "text": "No need, no need, we're already heading that way anyway."
          }
        }
      }
    },
    {
      "subId": "1050110",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

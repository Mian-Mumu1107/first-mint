    {
      "subId": "1050108",
      "subQuestName": "Fend the bandits off",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105010801"
        ],
        "dialogs": {
          "105010801": {
            "id": "105010801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "These Golden Shrimp Balls...",
            "nextDialogs": [
              "105010802"
            ]
          },
          "105010802": {
            "id": "105010802",
            "speakerId": 2206,
            "speakerName": "Yuhua",
            "text": "These are made using large, succulent shrimp wrapped in crispy-fried potatoes. They have an amazing texture."
          }
        }
      }
    },
    {
      "subId": "1050109",
      "subQuestName": "Talk to Mona",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105010501"
        ],
        "dialogs": {
          "105010501": {
            "id": "105010501",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Hmph, what did you think? Did that satisfy your expectations?",
            "nextDialogs": [
              "105010504"
            ]
          },
          "105010504": {
            "id": "105010504",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Such things are elementary for an astrologist.",
            "nextDialogs": [
              "105010505"
            ]
          },
          "105010505": {
            "id": "105010505",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Lies are worthless before astrology. Destiny and truth are written in the stars.",
            "nextDialogs": [
              "105010506"
            ]
          },
          "105010506": {
            "id": "105010506",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Though it may take more time to garner the specifics, I can read the gist of a situation at a glance.",
            "nextDialogs": [
              "105010507"
            ]
          },
          "105010507": {
            "id": "105010507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But you did hit some bumps in the road...",
            "nextDialogs": [
              "105010508"
            ]
          },
          "105010508": {
            "id": "105010508",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "That's because Teyvat's stars can only display the fates and truths of \"this world.\"",
            "nextDialogs": [
              "105010509"
            ]
          },
          "105010509": {
            "id": "105010509",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "Anything related to you becomes like a fog that even I cannot penetrate.",
            "nextDialogs": [
              "105010510"
            ]
          },
          "105010510": {
            "id": "105010510",
            "speakerId": 10095,
            "speakerName": "Mona",
            "text": "That is why I must meet that successor. With our knowledge combined, I might be able to gain new insight into your fate."
          }
        }
      }
    },

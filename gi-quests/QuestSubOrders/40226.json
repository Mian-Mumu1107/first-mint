  "subQuests": [
    {
      "subId": "4022601",
      "subQuestName": "Go to The Flagship",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402260101"
        ],
        "dialogs": {
          "402260101": {
            "id": "402260101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "The Flagship... Guess this participant decided to figure out lodging first.",
            "nextDialogs": [
              "402260102"
            ]
          },
          "402260102": {
            "id": "402260102",
            "speakerId": 1001,
            "speakerName": "Navia",
            "text": "Partner! Paimon!",
            "nextDialogs": [
              "402260103"
            ]
          },
          "402260103": {
            "id": "402260103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Navia! It's been forever!",
            "nextDialogs": [
              "402260106"
            ]
          },
          "402260106": {
            "id": "402260106",
            "speakerId": 1001,
            "speakerName": "Navia",
            "text": "You got that right. Representing the Spina di Rosula, of course.",
            "nextDialogs": [
              "402260107"
            ]
          },
          "402260107": {
            "id": "402260107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Top dog of the criminal underworld... Yep, that checks out.",
            "nextDialogs": [
              "402260108"
            ]
          },
          "402260108": {
            "id": "402260108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Top dog of the criminal underworld... Yep, that checks out.",
            "nextDialogs": [
              "402260109"
            ]
          },
          "402260109": {
            "id": "402260109",
            "speakerId": 1001,
            "speakerName": "Navia",
            "text": "Haha, is that my new nickname? I'm not opposed — it's kinda snazzy.",
            "nextDialogs": [
              "402260110"
            ]
          },
          "402260110": {
            "id": "402260110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's great that we found you! We're working a commission to help with participant registration right now. Y'know, goods verification, stuff like that...",
            "nextDialogs": [
              "402260111"
            ]
          },
          "402260111": {
            "id": "402260111",
            "speakerId": 1001,
            "speakerName": "Navia",
            "text": "Oh, I see. Well, in that case, take a seat. I ordered a whole bunch of food. Clorinde and Chevreuse went to unpack some things, but should be back in a sec... Ohh, speak of the devil!",
            "nextDialogs": [
              "402260112"
            ]
          },
          "402260112": {
            "id": "402260112",
            "speakerId": 1002,
            "speakerName": "Clorinde",
            "text": "Talking about us?",
            "nextDialogs": [
              "402260113"
            ]
          },
          "402260113": {
            "id": "402260113",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Clorinde! Chevreuse! You're here too!",
            "nextDialogs": [
              "402260114"
            ]
          },
          "402260114": {
            "id": "402260114",
            "speakerId": 1002,
            "speakerName": "Clorinde",
            "text": "Nod-Krai is a chaotic and dangerous place. Considering the Spina's importance to Fontaine, the last thing we need is for something to happen to its president.",
            "nextDialogs": [
              "402260115"
            ]
          },
          "402260115": {
            "id": "402260115",
            "speakerId": 1001,
            "speakerName": "Navia",
            "text": "I do find it nice to travel with friends, but c'mon... Look who you're talking to! What's the worst that could happen?",
            "nextDialogs": [
              "402260116"
            ]
          },
          "402260116": {
            "id": "402260116",
            "speakerId": 1002,
            "speakerName": "Clorinde",
            "text": "With that nonchalant attitude, it's anybody's guess...",
            "nextDialogs": [
              "402260117"
            ]
          },
          "402260117": {
            "id": "402260117",
            "speakerId": 1001,
            "speakerName": "Navia",
            "text": "Fair enough. Guess you can mark down our Champion Duelist here as my... bodyguard.",
            "nextDialogs": [
              "402260118"
            ]
          },
          "402260118": {
            "id": "402260118",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Gang boss and her bodyguard... Got it. Should we mark you down for the expo too, Chevreuse?",
            "nextDialogs": [
              "402260119"
            ]
          },
          "402260119": {
            "id": "402260119",
            "speakerId": 1003,
            "speakerName": "Chevreuse",
            "text": "No need. I'm here on official business. A lot of our recent cases have had ties to Nod-Krai.",
            "nextDialogs": [
              "402260120"
            ]
          },
          "402260120": {
            "id": "402260120",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Aaand that's Paimon's cue to butt out, hehe.",
            "nextDialogs": [
              "402260121"
            ]
          },
          "402260121": {
            "id": "402260121",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, one more thing! What's the Spina planning to trade at the expo?",
            "nextDialogs": [
              "402260122"
            ]
          },
          "402260122": {
            "id": "402260122",
            "speakerId": 1001,
            "speakerName": "Navia",
            "text": "Ah, this right here! It's one of the Fontaine Research Institute's newest inventions. It's a kind of relay system that allows the user to unleash pneuma and ousia energy in battle!",
            "nextDialogs": [
              "402260123"
            ]
          },
          "402260123": {
            "id": "402260123",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So, it's... a weapon?",
            "nextDialogs": [
              "402260124"
            ]
          },
          "402260124": {
            "id": "402260124",
            "speakerId": 1001,
            "speakerName": "Navia",
            "text": "Of course! At a market with no legal oversight like this one, weapons are gonna be the first to go!",
            "nextDialogs": [
              "402260125"
            ]
          },
          "402260125": {
            "id": "402260125",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Guess so... Still, bragging about not having to follow the law in front of Chevreuse feels wrong.",
            "nextDialogs": [
              "402260126"
            ]
          },
          "402260126": {
            "id": "402260126",
            "speakerId": 1003,
            "speakerName": "Chevreuse",
            "text": "I don't mind. I've read quite a bit about \"lawless territories\" in crime novels before.",
            "nextDialogs": [
              "402260127"
            ]
          },
          "402260127": {
            "id": "402260127",
            "speakerId": 1003,
            "speakerName": "Chevreuse",
            "text": "As a detective, I know that I'll need to put the rules aside for now if I want to get things done here.",
            "nextDialogs": [
              "402260128"
            ]
          },
          "402260128": {
            "id": "402260128",
            "speakerId": 1003,
            "speakerName": "Chevreuse",
            "text": "And, on that note, I should get to work. I've got Patrol members waiting on me.",
            "nextDialogs": [
              "402260129"
            ]
          },
          "402260129": {
            "id": "402260129",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, ready to head over to the venue? Just follow us!",
            "nextDialogs": [
              "402260130"
            ]
          },
          "402260130": {
            "id": "402260130",
            "speakerId": 1001,
            "speakerName": "Navia",
            "text": "Alright, let's get this show on the road! I wanna get a bit of shopping in as well."
          }
        }
      }
    },
    {
      "subId": "4022602",
      "subQuestName": "Take Navia and Clorinde to the event venue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402260201"
        ],
        "dialogs": {
          "402260201": {
            "id": "402260201",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You lead Navia and Clorinde to the venue.",
            "nextDialogs": [
              "402260202"
            ]
          },
          "402260202": {
            "id": "402260202",
            "speakerId": 1001,
            "speakerName": "Navia",
            "text": "Wow, it's even bigger than I expected. I'm hoping more people will show up, though...",
            "nextDialogs": [
              "402260203"
            ]
          },
          "402260203": {
            "id": "402260203",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It'll get busier once things kick off. Still, looks like Jahoda needs a lot of help.",
            "nextDialogs": [
              "402260204"
            ]
          },
          "402260204": {
            "id": "402260204",
            "speakerId": 1001,
            "speakerName": "Navia",
            "text": "Well, Clorinde and I are all set up for now. Be sure to stop by our booth when you get a chance!"
          }
        }
      }
    }
  ]
}
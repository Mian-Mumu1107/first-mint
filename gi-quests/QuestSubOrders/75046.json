  "subQuests": [
    {
      "subId": "7504601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750460101"
        ],
        "dialogs": {
          "750460101": {
            "id": "750460101",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "Yoohoo— Come back now, little ones! Yooohoooo—",
            "nextDialogs": [
              "750460102"
            ]
          },
          "750460102": {
            "id": "750460102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hello.",
            "nextDialogs": [
              "750460103"
            ]
          },
          "750460103": {
            "id": "750460103",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "Yoooohoooo— *sigh*",
            "nextDialogs": [
              "750460104"
            ]
          },
          "750460104": {
            "id": "750460104",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "I feel awful. So... sad. How can I... make it better...",
            "nextDialogs": [
              "750460105"
            ]
          },
          "750460105": {
            "id": "750460105",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "Ugh, I step out for one moment to buy some hay, and now I have no idea where my other eight little Tatankasaurs have run off to...",
            "nextDialogs": [
              "750460106"
            ]
          },
          "750460106": {
            "id": "750460106",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "They're still so small! What if they get bullied by hilichurls... or lost... or trapped somewhere?",
            "nextDialogs": [
              "750460107"
            ]
          },
          "750460107": {
            "id": "750460107",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "Kind soul, is there any chance you've seen my little Tatankasaurs?",
            "nextDialogs": [
              "750460108"
            ]
          },
          "750460108": {
            "id": "750460108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do they look like?",
            "nextDialogs": [
              "750460109"
            ]
          },
          "750460109": {
            "id": "750460109",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "I raised their mother, you know. She's practically my daughter.",
            "nextDialogs": [
              "750460110"
            ]
          },
          "750460110": {
            "id": "750460110",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "She's one of the most stunning saurians in the whole of the Collective of Plenty. She even won the grand prize in our regional beauty pageant!",
            "nextDialogs": [
              "750460111"
            ]
          },
          "750460111": {
            "id": "750460111",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "Those eight little rascals all inherited their mother's good looks. They've got fair, pink skin, with a dash of purple on their perfectly symmetrical fan-shaped horns.",
            "nextDialogs": [
              "750460112"
            ]
          },
          "750460112": {
            "id": "750460112",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "If you see them, please help me get them back here. I'm counting on you!",
            "nextDialogs": [
              "750460113"
            ]
          },
          "750460113": {
            "id": "750460113",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "My little saurians... I promise I won't be so strict with you anymore...",
            "nextDialogs": [
              "750460118"
            ]
          },
          "750460118": {
            "id": "750460118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll keep an eye out.",
            "nextDialogs": [
              "750460119"
            ]
          },
          "750460119": {
            "id": "750460119",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "Thank you, kind soul. May your bench press today hit a new personal best and your pull-ups stay cramp-free!"
          }
        }
      }
    },

          },
          "750460415": {
            "id": "750460415",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "Was it you who brought them back? Honestly, I can't thank you enough! Here, please help yourself to the rewards in these chests.",
            "nextDialogs": [
              "750460416"
            ]
          },
          "750460416": {
            "id": "750460416",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "I'll head over to see them in just a moment. Oh little saurians, my little saurians!",
            "nextDialogs": [
              "750460417"
            ]
          },
          "750460417": {
            "id": "750460417",
            "speakerId": 6423,
            "speakerName": "Urubamba",
            "text": "Now I can focus on being a trainer again. Oh, and speaking of which — if you're interested in taking the Warrior's Challenge, feel free to come find me again!"

  "subQuests": [
    {
      "subId": "7181720",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718172001"
        ],
        "dialogs": {
          "718172001": {
            "id": "718172001",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Ah, yes. I've already asked Yuhua to bring the food down to those two customers. They're pretty pleased with it, too — thanks for making that trip.",
            "nextDialogs": [
              "718172002"
            ]
          },
          "718172002": {
            "id": "718172002",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "So, are all the other matters settled?",
            "nextDialogs": [
              "718172003"
            ]
          },
          "718172003": {
            "id": "718172003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I've sent those meals out.",
            "nextDialogs": [
              "718172004"
            ]
          },
          "718172004": {
            "id": "718172004",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Good, good — have you bought the ingredients as well?"
          }
        }
      }
    },
    {
      "subId": "7181701",
      "subQuestName": "Talk to Smiley Yanxiao at night (19:00 – 23:00)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718170201"
        ],
        "dialogs": {
          "718170201": {
            "id": "718170201",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Argh, I need a rest. My hands are so sore that I can barely lift my wok...",
            "nextDialogs": [
              "718170202"
            ]
          },
          "718170202": {
            "id": "718170202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "718170203"
            ]
          },
          "718170203": {
            "id": "718170203",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Ah, Traveler! I was just wondering how nice it'd be if I could have some help. You up for it?",
            "nextDialogs": [
              "718170204"
            ]
          },
          "718170204": {
            "id": "718170204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What sort of help...",
            "nextDialogs": [
              "718170205"
            ]
          },
          "718170205": {
            "id": "718170205",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Most all our staff have headed back to spend the Lantern Rite in the city. We're so short-handed right now that we can barely keep our heads above water, so any help is good help.",
            "nextDialogs": [
              "718170206"
            ]
          },
          "718170206": {
            "id": "718170206",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "You needn't worry, we don't expect you to do any heavy lifting. Just need to help us serve some dishes and gather some ingredients.",
            "nextDialogs": [
              "718170207"
            ]
          },
          "718170207": {
            "id": "718170207",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Give me a moment, let me see what we can get you to do right now..."
          }
        }
      }
    },
    {
      "subId": "7181702",
      "subQuestName": "Talk to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718170301"
        ],
        "dialogs": {
          "718170301": {
            "id": "718170301",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Ack, I forgot to take orders from the customers at that table downstairs.",
            "nextDialogs": [
              "718170302"
            ]
          },
          "718170302": {
            "id": "718170302",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "How about this? Go and take orders from those two guests downstairs, Holderlin and Caspar.",
            "nextDialogs": [
              "718170303"
            ]
          },
          "718170303": {
            "id": "718170303",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "They've been waiting for a while now, so they might be getting annoyed. Just remember to bring them <color=#00E1FFFF>two</color> side dishes. Some <color=#00E1FFFF>Delicious Chicken-Mushroom Skewer</color> should do the trick.",
            "nextDialogs": [
              "718170304"
            ]
          },
          "718170304": {
            "id": "718170304",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "After the sides have been served, ask them what they'd like to have for their main course — save yourself that extra trip.",
            "nextDialogs": [
              "718170305"
            ]
          },
          "718170305": {
            "id": "718170305",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Alright, run along now. Don't keep them waiting."
          }
        }
      }
    },
    {
      "subId": "7181703",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718171801"
        ],
        "dialogs": {
          "718171801": {
            "id": "718171801",
            "speakerId": 1001,
            "speakerName": "Zhuyu",
            "text": "Look, Qinglian, look — our takeout's here! Thanks for making the trip."
          }
        }
      }
    },
    {
      "subId": "7181709",
      "subQuestName": "Cook 2 Delicious Chicken-Mushroom Skewers",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718170901"
        ],
        "dialogs": {
          "718170901": {
            "id": "718170901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Golden Shrimp Balls.",
            "nextDialogs": [
              "718170902"
            ]
          },
          "718170902": {
            "id": "718170902",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "No problem, this won't be hard.",
            "nextDialogs": [
              "718170903"
            ]
          },
          "718170903": {
            "id": "718170903",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "And what would Caspar like to eat?"
          }
        }
      }
    },
    {
      "subId": "7181710",
      "subQuestName": "Serve dishes to Holderlin and Caspar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718171001"
        ],
        "dialogs": {
          "718171001": {
            "id": "718171001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Jueyun Chili Chicken.",
            "nextDialogs": [
              "718171002"
            ]
          },
          "718171002": {
            "id": "718171002",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "No problem, this won't be hard.",
            "nextDialogs": [
              "718171003"
            ]
          },
          "718171003": {
            "id": "718171003",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "What would Caspar like to eat?"
          }
        }
      }
    },
    {
      "subId": "7181704",
      "subQuestName": "Serve dishes to Holderlin and Caspar",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718170601"
        ],
        "dialogs": {
          "718170601": {
            "id": "718170601",
            "speakerId": 1002,
            "speakerName": "Holderlin",
            "text": "Well, finally! I was just about to leave...",
            "nextDialogs": [
              "718170602"
            ]
          },
          "718170602": {
            "id": "718170602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What would you like to order?",
            "nextDialogs": [
              "718170603"
            ]
          },
          "718170603": {
            "id": "718170603",
            "speakerId": 1002,
            "speakerName": "Holderlin",
            "text": "I've heard that the people of Liyue make excellent seafood, so I'd like to try some...",
            "nextDialogs": [
              "718170604"
            ]
          },
          "718170604": {
            "id": "718170604",
            "speakerId": 1002,
            "speakerName": "Holderlin",
            "text": "But I've been trying the vegetarian lifestyle out recently, so I can't have meat. I wonder if they have something... vegetarian that tastes like seafood...",
            "nextDialogs": [
              "718170605"
            ]
          },
          "718170605": {
            "id": "718170605",
            "speakerId": 1003,
            "speakerName": "Caspar",
            "text": "Ever since I tried spicy food at Wanmin Restaurant, I've been completely smitten by that flavor. Nowadays, I can't eat anything if it doesn't have that spice in it.",
            "nextDialogs": [
              "718170606"
            ]
          },
          "718170606": {
            "id": "718170606",
            "speakerId": 1003,
            "speakerName": "Caspar",
            "text": "I'll pass on the seafood, I've had too much of it lately. Some fowl would be great.",
            "nextDialogs": [
              "718170607"
            ]
          },
          "718170607": {
            "id": "718170607",
            "speakerId": 1003,
            "speakerName": "Caspar",
            "text": "I'm not too familiar with Liyue cuisine, so I'll take whatever you recommend, thanks."
          }
        }
      }
    },
    {
      "subId": "7181705",
      "subQuestName": "Report back to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718171401"
        ],
        "dialogs": {
          "718171401": {
            "id": "718171401",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Alright, alright, I've got them down now... Phew, this'll be a busy day and no mistake.",
            "nextDialogs": [
              "718171402"
            ]
          },
          "718171402": {
            "id": "718171402",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Let me see if there's anything we need your help with... Oh yes, we have two servings of takeout here. Could I trouble you to send them out?",
            "nextDialogs": [
              "718171403"
            ]
          },
          "718171403": {
            "id": "718171403",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "One serving of Almond Tofu for Aunt Qiao, and a serving of Golden Shrimp Balls for Zhuyu.",
            "nextDialogs": [
              "718171404"
            ]
          },
          "718171404": {
            "id": "718171404",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Having made so many dishes in such a short time, we're starting to run out of ingredients.",
            "nextDialogs": [
              "718171405"
            ]
          },
          "718171405": {
            "id": "718171405",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "How about this? While you're on your trip, you bring some ingredients back with you. <color=#00E1FFFF>Three servings of</color> <color=#00E1FFFF>Rice, Almonds, and Tofu</color> each should do the trick.",
            "nextDialogs": [
              "718171406"
            ]
          },
          "718171406": {
            "id": "718171406",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "We really don't have sufficient ingredients on hand right now, so I'll have to trouble you to go out and buy some. You should be able to get all these ingredients from <color=#00E1FFFF>Second Life</color>, just report the bill to me afterwards."
          }
        }
      }
    },
    {

    {
      "subId": "7181715",
      "subQuestName": "Report back to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718173201"
        ],
        "dialogs": {
          "718173201": {
            "id": "718173201",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Thanks, you've lightened my load a fair bit.",
            "nextDialogs": [
              "718173202"
            ]
          },
          "718173202": {
            "id": "718173202",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Haha, aren't I a busy man... It's the Lantern Rite, and I haven't put a lantern together yet...",
            "nextDialogs": [
              "718173203"
            ]
          },
          "718173203": {
            "id": "718173203",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Ah, right. Traveler, do you know how to make Xiao Lanterns?",
            "nextDialogs": [
              "718173204"
            ]
          },
          "718173204": {
            "id": "718173204",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "It doesn't feel right to ask you for help with this as well, but I really can't spare the time to source for materials to make a lantern.",
            "nextDialogs": [
              "718173205"
            ]
          },
          "718173205": {
            "id": "718173205",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "If you're willing to help out, could you make me one... No, two — two lanterns?",
            "nextDialogs": [
              "718173206"
            ]
          },
          "718173206": {
            "id": "718173206",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "I'll take one of them, and I'd like you to help me send the other to Jiangxue. He can usually be found fishing near the inn.",
            "nextDialogs": [
              "718173207"
            ]
          },
          "718173207": {
            "id": "718173207",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "He's usually something of a freeloader, but for some reason, he hasn't come over today..."
          }
        }
      }
    },
    {
      "subId": "7181716",
      "subQuestName": "Give a Xiao Lantern to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7181717",
      "subQuestName": "Talk to Smiley Yanxiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718172201"
        ],
        "dialogs": {
          "718172201": {
            "id": "718172201",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "You've got nimble hands. Thank you, I should be able to send this Xiao Lantern off soon.",
            "nextDialogs": [
              "718172202"
            ]
          },
          "718172202": {
            "id": "718172202",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Ah, yes — make sure you don't forget to pass the other Xiao Lantern to Jiangxue."
          }
        }
      }
    },
    {
      "subId": "7181718",
      "subQuestName": "Give a Xiao Lantern to Jiangxue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7181719",
      "subQuestName": "Talk to Jiangxue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718172401"
        ],
        "dialogs": {
          "718172401": {
            "id": "718172401",
            "speakerId": 1005,
            "speakerName": "Jiangxue",
            "text": "A Xiao Lantern? Why so sudden...",
            "nextDialogs": [
              "718172402"
            ]
          },
          "718172402": {
            "id": "718172402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Smiley Yanxiao wanted me to send this to you.",
            "nextDialogs": [
              "718172403"
            ]
          },
          "718172403": {
            "id": "718172403",
            "speakerId": 1005,
            "speakerName": "Jiangxue",
            "text": "Ha, that chef is a thoughtful man indeed. He's... changed a great deal since our initial meeting.",
            "nextDialogs": [
              "718172404"
            ]
          },
          "718172404": {
            "id": "718172404",
            "speakerId": 1005,
            "speakerName": "Jiangxue",
            "text": "Time slips by, and yet here I am, still unable to wholly let go. How shameful.",
            "nextDialogs": [
              "718172405"
            ]
          },
          "718172405": {
            "id": "718172405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What can't you let go of?",
            "nextDialogs": [
              "718172406"
            ]
          },
          "718172406": {
            "id": "718172406",
            "speakerId": 1005,
            "speakerName": "Jiangxue",
            "text": "Nothing, really. Mere trivial matters that aren't worth any mention. Thanks for coming all this way and sending me that Xiao Lantern.",
            "nextDialogs": [
              "718172407"
            ]
          },
          "718172407": {
            "id": "718172407",
            "speakerId": 1005,
            "speakerName": "Jiangxue",
            "text": "I don't have anything to wish for, nor have I released a Xiao Lantern of my own in a long time...",
            "nextDialogs": [
              "718172408"
            ]
          },
          "718172408": {
            "id": "718172408",
            "speakerId": 1005,
            "speakerName": "Jiangxue",
            "text": "But having a lantern by my side to look at isn't too bad. Thank you very much."
          }
        }
      }
    },
    {
      "subId": "7181721",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718170101"
        ],
        "dialogs": {
          "718170101": {
            "id": "718170101",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "This is bad...",
            "nextDialogs": [
              "718170102"
            ]
          },
          "718170102": {
            "id": "718170102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Something the matter?",
            "nextDialogs": [
              "718170103"
            ]
          },
          "718170103": {
            "id": "718170103",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Lantern Rite's the matter, what else? We've had lots of staff head back to the city to spend the festive period there, so we've got our hands full right now.",
            "nextDialogs": [
              "718170104"
            ]
          },
          "718170104": {
            "id": "718170104",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Haven't the time for idle chat right now. Need to get ready for the guests' orders at night — doubt I'll even have time to get a sip of water.",
            "nextDialogs": [
              "718170105"
            ]
          },
          "718170105": {
            "id": "718170105",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "If you cared enough to check on me, you might as well help out later tonight.",
            "nextDialogs": [
              "718170106"
            ]
          },
          "718170106": {
            "id": "718170106",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "*sigh* What I'd do for some help right now. Where's that Yuhua run off to..."
          }
        }
      }
    },
    {
      "subId": "7181704",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718170401"
        ],
        "dialogs": {
          "718170401": {
            "id": "718170401",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Ack, I forgot to take orders from the customers at that table downstairs.",
            "nextDialogs": [
              "718170402"
            ]
          },
          "718170402": {
            "id": "718170402",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "How about this? Go and take orders from those two guests downstairs, Holderlin and Caspar.",
            "nextDialogs": [
              "718170403"
            ]
          },
          "718170403": {
            "id": "718170403",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "They've been waiting for a while now, so they might be getting annoyed. Just remember to bring them <color=#00E1FFFF>two</color> side dishes. Some <color=#00E1FFFF>Delicious Chicken-Mushroom Skewer</color> should do the trick.",
            "nextDialogs": [
              "718170404"
            ]
          },
          "718170404": {
            "id": "718170404",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "After the sides have been served, ask them what they'd like to have for their main course — save yourself that extra trip.",
            "nextDialogs": [
              "718170405"
            ]
          },
          "718170405": {
            "id": "718170405",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Alright, run along now. Don't keep them waiting."
          }
        }
      }
    },
    {
      "subId": "7181705",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718170501"
        ],
        "dialogs": {
          "718170501": {
            "id": "718170501",
            "speakerId": 1002,
            "speakerName": "Holderlin",
            "text": "We've been here all day, why hasn't anyone come to take our orders yet?"
          }
        }
      }
    },
    {
      "subId": "7181712",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718171201"
        ],
        "dialogs": {
          "718171201": {
            "id": "718171201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Golden Shrimp Balls.",
            "nextDialogs": [
              "718171202"
            ]
          },
          "718171202": {
            "id": "718171202",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Alright, I've got it."
          }
        }
      }
    },
    {
      "subId": "7181715",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718171501"
        ],
        "dialogs": {
          "718171501": {
            "id": "718171501",
            "speakerId": 1004,
            "speakerName": "Aunt Qiao",
            "text": "Anything I can do for you, youngster?"
          }
        }
      }
    },
    {
      "subId": "7181717",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718171701"
        ],
        "dialogs": {
          "718171701": {
            "id": "718171701",
            "speakerId": 1001,
            "speakerName": "Zhuyu",
            "text": "Qinglian, is there anything else you'd like to eat other than Golden Shrimp Balls?",
            "nextDialogs": [
              "718171702"
            ]
          },
          "718171702": {
            "id": "718171702",
            "speakerId": 1006,
            "speakerName": "Qinglian",
            "text": "*cough* Don't worry. Let's wait a while more, the takeout should be here soon.",
            "nextDialogs": [
              "718171703"
            ]
          },
          "718171703": {
            "id": "718171703",
            "speakerId": 1001,
            "speakerName": "Zhuyu",
            "text": "Hmm? Do you need anything?"
          }
        }
      }
    },
    {
      "subId": "7181719",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718171901"
        ],
        "dialogs": {
          "718171901": {
            "id": "718171901",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "You've got some smooth moves, don't you? As expected of an adventurer..."
          }
        }
      }
    },
    {
      "subId": "7181721",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718172101"
        ],
        "dialogs": {
          "718172101": {
            "id": "718172101",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "What's with that freeloader today..."
          }
        }
      }
    },
    {
      "subId": "7181723",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718172301"
        ],
        "dialogs": {
          "718172301": {
            "id": "718172301",
            "speakerId": 1005,
            "speakerName": "Jiangxue",
            "text": "Another year, another Lantern Rite..."
          }
        }
      }
    },
    {
      "subId": "7181725",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718172501"
        ],
        "dialogs": {
          "718172501": {
            "id": "718172501",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Why's that girl Yuhua not in the kitchen helping me out..."
          }
        }
      }
    },
    {
      "subId": "7181726",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718172601"
        ],
        "dialogs": {
          "718172601": {
            "id": "718172601",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Taking orders and sending takeout, buying ingredients, serving the food... What else have we got..."
          }
        }
      }
    },
    {
      "subId": "7181727",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718172701"
        ],
        "dialogs": {
          "718172701": {
            "id": "718172701",
            "speakerId": 1002,
            "speakerName": "Holderlin",
            "text": "Hope my order arrives soon...",
            "nextDialogs": [
              "718172702"
            ]
          },
          "718172702": {
            "id": "718172702",
            "speakerId": 1003,
            "speakerName": "Caspar",
            "text": "I wonder what I'll be served..."
          }
        }
      }
    },
    {
      "subId": "7181728",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718172801"
        ],
        "dialogs": {
          "718172801": {
            "id": "718172801",
            "speakerId": 1004,
            "speakerName": "Aunt Qiao",
            "text": "#Thank you, young {M#man}{F#lady}."
          }
        }
      }
    },
    {
      "subId": "7181729",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718172901"
        ],
        "dialogs": {
          "718172901": {
            "id": "718172901",
            "speakerId": 1001,
            "speakerName": "Zhuyu",
            "text": "Thanks for coming all this way."
          }
        }
      }
    },
    {
      "subId": "7181730",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718173001"
        ],
        "dialogs": {
          "718173001": {
            "id": "718173001",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Strange — I wonder why those customers don't look too pleased after their dishes arrived.",
            "nextDialogs": [
              "718173002"
            ]
          },
          "718173002": {
            "id": "718173002",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Did my hand slip somewhere? That can't be...",
            "nextDialogs": [
              "718173003"
            ]
          },
          "718173003": {
            "id": "718173003",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "So, are all the other matters settled?",
            "nextDialogs": [
              "718173004"
            ]
          },
          "718173004": {
            "id": "718173004",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I've sent those meals out.",
            "nextDialogs": [
              "718173005"
            ]
          },
          "718173005": {
            "id": "718173005",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Good, good — have you bought the ingredients as well?"
          }
        }
      }
    },
    {
      "subId": "7181731",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718173101"
        ],
        "dialogs": {
          "718173101": {
            "id": "718173101",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Hmm, you were a little slow... *sigh* But there were too many things to do, after all..."
          }
        }
      }
    },
    {
      "subId": "7181733",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718173301"
        ],
        "dialogs": {
          "718173301": {
            "id": "718173301",
            "speakerId": 1000,
            "speakerName": "Smiley Yanxiao",
            "text": "Come again at night, I need to hurry up and finish making preparations..."
          }
        }
      }
    }

    {
      "subId": "7181708",
      "subQuestName": "Deliver the food to Aunt Qiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718171601"
        ],
        "dialogs": {
          "718171601": {
            "id": "718171601",
            "speakerId": 1004,
            "speakerName": "Aunt Qiao",
            "text": "Oh? This is... the delivery from Wangshu Inn?",
            "nextDialogs": [
              "718171602"
            ]
          },
          "718171602": {
            "id": "718171602",
            "speakerId": 1004,
            "speakerName": "Aunt Qiao",
            "text": "Oh yes, this is wonderful... A serving of Wangshu Inn's Almond Tofu on a festive occasion is always great.",
            "nextDialogs": [
              "718171603"
            ]
          },
          "718171603": {
            "id": "718171603",
            "speakerId": 1004,
            "speakerName": "Aunt Qiao",
            "text": "#Thank you, young {M#man}{F#lady}."
          }
        }
      }
    },
    {

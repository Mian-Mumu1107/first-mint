        ],
        "dialogs": {
          "741659901": {
            "id": "741659901",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Is this... the Primordial Sea?",
            "nextDialogs": [
              "741659902"
            ]
          },
          "741659902": {
            "id": "741659902",
            "speakerId": 1003,
            "speakerName": "???",
            "text": "The day of return has arrived...",
            "nextDialogs": [
              "741659903"
            ]
          },
          "741659903": {
            "id": "741659903",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wh—Who was that?"
          }
        }
      }
    }
  ]

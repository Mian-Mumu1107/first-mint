      "dialogue": {
        "startDialogs": [
          "701120101"
        ],
        "dialogs": {
          "701120101": {
            "id": "701120101",
            "speakerId": 1000,
            "speakerName": "Josephus",
            "text": "Well then, Dexter. Times have changed. I suppose it's time for you to leave your childhood behind.",
            "nextDialogs": [
              "701120102"
            ]
          },
          "701120102": {
            "id": "701120102",
            "speakerId": 1000,
            "speakerName": "Josephus",
            "text": "You, too, must submit to the baptism that we call a coming of age, learn of matters only grown-ups know. Watch closely, now. I shall only demonstrate this once.",
            "nextDialogs": [
              "701120103"
            ]
          },
          "701120103": {
            "id": "701120103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why did that sound like someone giving their final words?",
            "nextDialogs": [
              "701120104"
            ]
          },
          "701120104": {
            "id": "701120104",
            "speakerId": 1000,
            "speakerName": "Josephus",
            "text": "Your final lesson is as such. Read along with me — \"The classification of the elements.\" Now, you try it."
          }
        }
      }
    },
    {
      "subId": "7011203",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701120301"
        ],
        "dialogs": {
          "701120301": {
            "id": "701120301",
            "speakerId": 1000,
            "speakerName": "Josephus",
            "text": "I wish I could imitate Istoria and exclaim, \"Excellent\"! Alas, I cannot bring myself to...",
            "nextDialogs": [
              "701120302"
            ]
          },
          "701120302": {
            "id": "701120302",
            "speakerId": 1000,
            "speakerName": "Josephus",
            "text": "Clearly, I have nothing left to teach you. That concludes the final lesson.",
            "nextDialogs": [
              "701120303"
            ]
          },
          "701120303": {
            "id": "701120303",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Wait a second! You didn't teach a thing — {NICKNAME} did it all!"
          }
        }
      }
    },
    {
      "subId": "7011204",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701120201"
        ],
        "dialogs": {
          "701120201": {
            "id": "701120201",
            "speakerId": 1000,
            "speakerName": "Josephus",
            "text": "Well done.",
            "nextDialogs": [
              "701120202"
            ]
          },
          "701120202": {
            "id": "701120202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hold on. Who exactly were you praising there?",
            "nextDialogs": [
              "701120203"
            ]
          },
          "701120203": {
            "id": "701120203",
            "speakerId": 1000,
            "speakerName": "Josephus",
            "text": "Now then, the next step is to consider how things influence one another.",
            "nextDialogs": [
              "701120204"
            ]
          },
          "701120204": {
            "id": "701120204",
            "speakerId": 1000,
            "speakerName": "Josephus",
            "text": "Observe the elemental reactions, the long-range forces, and the short-range forces. And remember to avoid unnecessary disturbances.",
            "nextDialogs": [
              "701120205"
            ]
          },
          "701120205": {
            "id": "701120205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh, what language are you speaking right now!?"
          }
        }
      }
    }
  ]
}
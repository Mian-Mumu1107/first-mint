    {
      "subId": "7350701",
      "subQuestName": "Talk to the two people at the stall",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735070101"
        ],
        "dialogs": {
          "735070101": {
            "id": "735070101",
            "speakerId": 1000,
            "speakerName": "Haniyyah",
            "text": "Golden Comet and Silver Companion... We meet again.",
            "nextDialogs": [
              "735070102"
            ]
          },
          "735070102": {
            "id": "735070102",
            "speakerId": 1000,
            "speakerName": "Haniyyah",
            "text": "As spirited as ever, I see!",
            "nextDialogs": [
              "735070104",
              "735070107"
            ]
          },
          "735070104": {
            "id": "735070104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "H—Haniyyah! And Balfour, too!",
            "nextDialogs": [
              "735070105"
            ]
          },
          "735070105": {
            "id": "735070105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Fancy running into both of you here!",
            "nextDialogs": [
              "735070114"
            ]
          },
          "735070114": {
            "id": "735070114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, back to the point, then. What are the two of you doing here? If Paimon still remembers correctly, this was where we could get those Floral Jellies...",
            "nextDialogs": [
              "735070115"
            ]
          },
          "735070115": {
            "id": "735070115",
            "speakerId": 1002,
            "speakerName": "Balfour",
            "text": "Ah, our two great heroes! Your voices alone swell my confidence greatly.",
            "nextDialogs": [
              "735070116"
            ]
          },
          "735070116": {
            "id": "735070116",
            "speakerId": 1002,
            "speakerName": "Balfour",
            "text": "Well then, I shall proceed to give my report on the results of our work.",
            "nextDialogs": [
              "735070117"
            ]
          },
          "735070117": {
            "id": "735070117",
            "speakerId": 1002,
            "speakerName": "Balfour",
            "text": "Previously, the two of you declared that the Nilotpala Cup Beast Tamers Tournament should be suspended for a time while the Akademiya improves the design of the Wisdom Orb.",
            "nextDialogs": [
              "735070118"
            ]
          },
          "735070118": {
            "id": "735070118",
            "speakerId": 1002,
            "speakerName": "Balfour",
            "text": "I believe the two of you are still waiting for notice concerning that?",
            "nextDialogs": [
              "735070119"
            ]
          },
          "735070119": {
            "id": "735070119",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah, that's right! Layla, Cyno, or the researchers responsible should inform us if there's any progress, right?"
          },
          "735070107": {
            "id": "735070107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Oh, come on, {NICKNAME}, what are you on about?",
            "nextDialogs": [
              "735070108"
            ]
          },
          "735070108": {
            "id": "735070108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We took part in the Nilotpala Cup Beast Tamers Tournament, didn't we? It was great fun hanging out with our shroom buddies!",
            "nextDialogs": [
              "735070109"
            ]
          },
          "735070109": {
            "id": "735070109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We met Haniyyah then, and Balfour was the previous event's most responsible staff member.",
            "nextDialogs": [
              "735070110"
            ]
          },
          "735070110": {
            "id": "735070110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, have you forgotten Bongo-Head and Twirly-Whirly too?"
          }
        }
      }
    },
    {
      "subId": "7350706",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735070501"
        ],
        "dialogs": {
          "735070501": {
            "id": "735070501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "C'mon, Bongo-Head, let's play a clapping game!",
            "nextDialogs": [
              "735070502"
            ]
          },
          "735070502": {
            "id": "735070502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "C'mon, Kindlejoy, let's dance with Bongo-Head!",
            "nextDialogs": [
              "735070503"
            ]
          },
          "735070503": {
            "id": "735070503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... We've gotten pretty familiar with Kindlejoy, but we still can't quite communicate as well with it as we can with Bongo-Head...",
            "nextDialogs": [
              "735070506"
            ]
          },
          "735070506": {
            "id": "735070506",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#You're here, {NICKNAME}!",
            "nextDialogs": [
              "735070507"
            ]
          },
          "735070507": {
            "id": "735070507",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "How are things going with the Fungus Mechanicus trials?"
          }
        }
      }
    },
    {

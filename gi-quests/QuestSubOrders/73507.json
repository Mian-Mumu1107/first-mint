    {
      "subId": "7350704",
      "subQuestName": "Try Fungus Mechanicus",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735070401"
        ],
        "dialogs": {
          "735070401": {
            "id": "735070401",
            "speakerId": 1002,
            "speakerName": "Balfour",
            "text": "Well then, let's not lose any time. Come, Golden Comet, the internal test build of Fungus Mechanicus is ready for you!"
          }
        }
      }
    },
    {
      "subId": "7350703",
      "subQuestName": "Talk to Haniyyah and Balfour",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735070301"
        ],
        "dialogs": {
          "735070301": {
            "id": "735070301",
            "speakerId": 1002,
            "speakerName": "Balfour",
            "text": "How was it, Golden Comet? How did your first taste of Fungus Mechanicus gameplay go?",
            "nextDialogs": [
              "735070302"
            ]
          },
          "735070302": {
            "id": "735070302",
            "speakerId": 1000,
            "speakerName": "Haniyyah",
            "text": "Judging by your expression, I suppose you haven't come to a conclusion yet.",
            "nextDialogs": [
              "735070305"
            ]
          },
          "735070305": {
            "id": "735070305",
            "speakerId": 1002,
            "speakerName": "Balfour",
            "text": "That is true. With this little test content, it is indeed rather difficult to judge the strengths and flaws of Fungus Mechanicus.",
            "nextDialogs": [
              "735070306"
            ]
          },
          "735070306": {
            "id": "735070306",
            "speakerId": 1002,
            "speakerName": "Balfour",
            "text": "Don't you worry. Ms. Haniyyah and I will be here for a while, and we'll have one new Mechanicus stage for you every day — seven in total.",
            "nextDialogs": [
              "735070307"
            ]
          },
          "735070307": {
            "id": "735070307",
            "speakerId": 1002,
            "speakerName": "Balfour",
            "text": "Come over whenever you have the time, and you'll get the opportunity to test those stages!",
            "nextDialogs": [
              "735070308"
            ]
          },
          "735070308": {
            "id": "735070308",
            "speakerId": 1002,
            "speakerName": "Balfour",
            "text": "Although you are the overall overseer in these matters, this game was something that Ms. Haniyyah and I came up with of our own accord — so this is an expenditure of time that lies outside your plans.",
            "nextDialogs": [
              "735070309"
            ]
          },
          "735070309": {
            "id": "735070309",
            "speakerId": 1002,
            "speakerName": "Balfour",
            "text": "As such, a fee will be provided to you for services rendered!"
          }
        }
      }
    },

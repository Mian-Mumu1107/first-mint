      "dialogue": {
        "startDialogs": [
          "110020201"
        ],
        "dialogs": {
          "110020201": {
            "id": "110020201",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "I think we're getting close...",
            "nextDialogs": [
              "110020202"
            ]
          },
          "110020202": {
            "id": "110020202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Have you decided what you're looking for yet?",
            "nextDialogs": [
              "110020203"
            ]
          },
          "110020203": {
            "id": "110020203",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "Of course not!",
            "nextDialogs": [
              "110020204"
            ]
          },
          "110020204": {
            "id": "110020204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Then how are you so sure of yourself?",
            "nextDialogs": [
              "110020205"
            ]
          },
          "110020205": {
            "id": "110020205",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "That's just my style. If I decided in advance exactly how I was going to cook something, there'd be no element of surprise to the dish.",
            "nextDialogs": [
              "110020206"
            ]
          },
          "110020206": {
            "id": "110020206",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "In the same way, if I knew what I was looking for before I found it, it wouldn't be a surprise.",
            "nextDialogs": [
              "110020207"
            ]
          },
          "110020207": {
            "id": "110020207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But that's so risky...",
            "nextDialogs": [
              "110020208"
            ]
          },
          "110020208": {
            "id": "110020208",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "Relax, this is how I came up with all the signature dishes at Wanmin Restaurant.",
            "nextDialogs": [
              "110020209"
            ]
          },
          "110020209": {
            "id": "110020209",
            "speakerId": 1000,
            "speakerName": "Xiangling",
            "text": "Let's look around here, I'll let you know when I find something I like."
          }
        }
      }
    },

    {
      "subId": "2230605",
      "subQuestName": "Talk to Bolai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223060601"
        ],
        "dialogs": {
          "223060601": {
            "id": "223060601",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "You're back! Found the treasure?",
            "nextDialogs": [
              "223060602"
            ]
          },
          "223060602": {
            "id": "223060602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes.",
            "nextDialogs": [
              "223060603"
            ]
          },
          "223060603": {
            "id": "223060603",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Nice one! I said you looked like a real adventurer, didn't I? Well, now you've proven it.",
            "nextDialogs": [
              "223060604"
            ]
          },
          "223060604": {
            "id": "223060604",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Right, let's see what we have in this box... Hmph. What a pile of junk...",
            "nextDialogs": [
              "223060605"
            ]
          },
          "223060605": {
            "id": "223060605",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Well, can't blame you for trying! Here's your share, I'll hold on to Zhang Shun's share until he comes to collect it.",
            "nextDialogs": [
              "223060606"
            ]
          },
          "223060606": {
            "id": "223060606",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "*sigh* Still didn't find it... That guy is taking me for a ride, I swear..."
          }
        }
      }
    },
    {
      "subId": "2230605",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223060501"
        ],
        "dialogs": {
          "223060501": {
            "id": "223060501",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "If it wasn't for my injury... I could be out there chasing down even bigger treasure hoards with the captain and my old crew mates...",
            "nextDialogs": [
              "223060502"
            ]
          },
          "223060502": {
            "id": "223060502",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "*sigh* What I would give to be back on board that ship just one more time..."
          }
        }
      }
    },
    {
      "subId": "2230607",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223060701"
        ],
        "dialogs": {
          "223060701": {
            "id": "223060701",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Are you sure? I would have thought it'd be a useful nugget of information..."
          }
        }
      }
    },
    {
      "subId": "2230609",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223060901"
        ],
        "dialogs": {
          "223060901": {
            "id": "223060901",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "You're back! Found the treasure?",
            "nextDialogs": [
              "223060902"
            ]
          },
          "223060902": {
            "id": "223060902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes.",
            "nextDialogs": [
              "223060903"
            ]
          },
          "223060903": {
            "id": "223060903",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Nice one! I said you looked like a real adventurer, didn't I? Well, now you've proven it.",
            "nextDialogs": [
              "223060904"
            ]
          },
          "223060904": {
            "id": "223060904",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Right, let's see what we have in this box... What's this? Map fragments?",
            "nextDialogs": [
              "223060905"
            ]
          },
          "223060905": {
            "id": "223060905",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Huh, so he was right. Those batty old Treasure Maps really do have clues to where the treasure lies...",
            "nextDialogs": [
              "223060906"
            ]
          },
          "223060906": {
            "id": "223060906",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Oh? You're still here? Here, take your share... and hurry along now, you must have other things to do. I'll hold Zhang Shun's share till he comes to collect it."
          }
        }
      }
    }
  ]
}
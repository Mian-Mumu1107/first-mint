    },
    {
      "subId": "2230641",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223060201"
        ],
        "dialogs": {
          "223060201": {
            "id": "223060201",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Hello there, my friend! What can I get you?",
            "nextDialogs": [
              "223060202"
            ]
          },
          "223060202": {
            "id": "223060202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Treasure Maps.",
            "nextDialogs": [
              "223060203"
            ]
          },
          "223060203": {
            "id": "223060203",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Treasure Maps? Oh, you must mean Zhang Shun's maps.",
            "nextDialogs": [
              "223060204"
            ]
          },
          "223060204": {
            "id": "223060204",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "So, you're really going to look for this treasure, eh? I must say, I only ever saw them as a bit of fun.",
            "nextDialogs": [
              "223060205"
            ]
          },
          "223060205": {
            "id": "223060205",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "You, though, I can tell with one look that you're the real adventurer type. The sort whose eyes light up as soon as someone mentions the word \"treasure.\"",
            "nextDialogs": [
              "223060206"
            ]
          },
          "223060206": {
            "id": "223060206",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "I don't have much use for these Treasure Maps at the end of the day, so you might as well have them.",
            "nextDialogs": [
              "223060207"
            ]
          },
          "223060207": {
            "id": "223060207",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "That said, if you do find any treasure, let's split it evenly.",
            "nextDialogs": [
              "223060208"
            ]
          },
          "223060208": {
            "id": "223060208",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "After all, I have been looking after these maps for a while. It's only fair to contribute something in the way of storage fees..."
          }
        }
      }
    },

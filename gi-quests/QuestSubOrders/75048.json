    {
      "subId": "7504810",
      "subQuestName": "Explore Ashflow Street",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750481001"
        ],
        "dialogs": {
          "750481001": {
            "id": "750481001",
            "speakerId": 21583,
            "speakerName": "Bona",
            "text": "About time, too. If we can shoot it down from here...",
            "nextDialogs": [
              "750481002"
            ]
          },
          "750481002": {
            "id": "750481002",
            "speakerId": 21602,
            "speakerName": "Cocouik",
            "text": "Chee! Kuchee!",
            "nextDialogs": [
              "750481003"
            ]
          },
          "750481003": {
            "id": "750481003",
            "speakerId": 21583,
            "speakerName": "Bona",
            "text": "#Yes, we just need to use that thing. Try putting your hand on Coco, {NICKNAME}...",
            "nextDialogs": [
              "750481004"
            ]
          },
          "750481004": {
            "id": "750481004",
            "speakerId": 21583,
            "speakerName": "Bona",
            "text": "\"Super Awesomesauce Laser,\" fire!"
          }
        }
      }
    },

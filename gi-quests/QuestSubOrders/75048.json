      }
    },
    {
      "subId": "7504812",
      "subQuestName": "Track the evil dragon down",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750481201"
        ],
        "dialogs": {
          "750481201": {
            "id": "750481201",
            "speakerId": 14631,
            "speakerName": "Bona",
            "text": "Nice! The Super Awesomesauce Laser is pretty hot stuff, eh?",
            "nextDialogs": [
              "750481202"
            ]
          },
          "750481202": {
            "id": "750481202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah! But why's it called that, though? You sure have strange tastes...",
            "nextDialogs": [
              "750481203"
            ]
          },
          "750481203": {
            "id": "750481203",
            "speakerId": 14631,
            "speakerName": "Bona",
            "text": "You don't think it sounds awesome? Speaking from my experience as an adventurer, it's much easier for people to remember and pass on skill names if they're flashy.",
            "nextDialogs": [
              "750481204"
            ]
          },
          "750481204": {
            "id": "750481204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's forget about the name for a moment here... Thanks for helping us out again, Coco. We couldn't have beat the dragon back without you.",
            "nextDialogs": [
              "750481205"
            ]
          },
          "750481205": {
            "id": "750481205",
            "speakerId": 21602,
            "speakerName": "Cocouik",
            "text": "Kru...",
            "nextDialogs": [
              "750481206"
            ]
          },
          "750481206": {
            "id": "750481206",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Wrrooo...",
            "nextDialogs": [
              "750481207"
            ]
          },
          "750481207": {
            "id": "750481207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Don't be sad! We're not saying that you didn't do anything, {REALNAME[ID(2)|SHOWHOST(true)]}.",
            "nextDialogs": [
              "750481209",
              "750481211"
            ]
          },
          "750481209": {
            "id": "750481209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#C'mon, just help Paimon explain, {NICKNAME}! We've all got different strengths! This just wasn't the time for {REALNAME[ID(2)|SHOWHOST(true)]} to shine yet!",
            "nextDialogs": [
              "750481212"
            ]
          },
          "750481212": {
            "id": "750481212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, the evil dragon flew off in that direction, huh?",
            "nextDialogs": [
              "750481213"
            ]
          },
          "750481213": {
            "id": "750481213",
            "speakerId": 14631,
            "speakerName": "Bona",
            "text": "Hmph. An injured beast always flees to its nest first. I'll bet that's its lair over that way",
            "nextDialogs": [
              "750481214"
            ]
          },
          "750481214": {
            "id": "750481214",
            "speakerId": 14631,
            "speakerName": "Bona",
            "text": "We'll have to get the Pyrophosphorite back before it recovers!",
            "nextDialogs": [
              "750481215"
            ]
          },
          "750481215": {
            "id": "750481215",
            "speakerId": 14631,
            "speakerName": "Bona",
            "text": "If I were alone, I wouldn't have dared to take the dragon on even if it were injured.",
            "nextDialogs": [
              "750481216"
            ]
          },
          "750481216": {
            "id": "750481216",
            "speakerId": 14631,
            "speakerName": "Bona",
            "text": "But we're a group now, and you're pretty good... I think we'll be fine."
          },
          "750481211": {
            "id": "750481211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#That's right. You'll get your chance soon, {REALNAME[ID(2)|SHOWHOST(true)]}, Paimon knows it!"
          }
        }
      }
    },

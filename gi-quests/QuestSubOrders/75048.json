    {
      "subId": "7504808",
      "subQuestName": "Talk to the mysterious adventurer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750480801"
        ],
        "dialogs": {
          "750480801": {
            "id": "750480801",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Hey, you over there!",
            "nextDialogs": [
              "750480802"
            ]
          },
          "750480802": {
            "id": "750480802",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Yes, I'm talking about the three of you! Turn around.",
            "nextDialogs": [
              "750480803"
            ]
          },
          "750480803": {
            "id": "750480803",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Looks like you understand what I'm saying.",
            "nextDialogs": [
              "750480804"
            ]
          },
          "750480804": {
            "id": "750480804",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Phew. You scared me back there, you know? I thought you were Abyss monsters pretending to be humans. If you hadn't responded, I'd have struck first.",
            "nextDialogs": [
              "750480806",
              "750480808"
            ]
          },
          "750480806": {
            "id": "750480806",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, we sure didn't think there would be other people here!",
            "nextDialogs": [
              "750480810"
            ]
          },
          "750480810": {
            "id": "750480810",
            "speakerId": 21583,
            "speakerName": "Bona",
            "text": "Heh. Anyway, the way we're meeting here, I'd call it destiny. I'm the ace adventurer of the Flower-Feather Clan. Call me Bona."
          },
          "750480808": {
            "id": "750480808",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Is that why you exposed your back to me with such confidence?",
            "nextDialogs": [
              "750480809"
            ]
          },
          "750480809": {
            "id": "750480809",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, we didn't think there would be other people here!"
          }
        }
      }
    },

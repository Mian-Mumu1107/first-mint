      "dialogue": {
        "startDialogs": [
          "722060101"
        ],
        "dialogs": {
          "722060101": {
            "id": "722060101",
            "speakerId": 1000,
            "speakerName": "Abe",
            "text": "Hey! I'm over here, you know?",
            "nextDialogs": [
              "722060102"
            ]
          },
          "722060102": {
            "id": "722060102",
            "speakerId": 1000,
            "speakerName": "Abe",
            "text": "Young people these days... Don't you kids have any kind of courtesy at all?",
            "nextDialogs": [
              "722060104",
              "722060106"
            ]
          },
          "722060104": {
            "id": "722060104",
            "speakerId": 1000,
            "speakerName": "Abe",
            "text": "Hmph! That's more like it. As for those mushrooms, let's just call that my gift... But don't you touch the rest however you like!"
          },
          "722060106": {
            "id": "722060106",
            "speakerId": 1000,
            "speakerName": "Abe",
            "text": "None of your business! Just stop picking them however you like and get out of here!"
          }
        }
      }
    },
    {
      "subId": "7220603",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722060201"
        ],
        "dialogs": {
          "722060201": {
            "id": "722060201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eek! That guy just now... Did you see that!?",
            "nextDialogs": [
              "722060204"
            ]
          },
          "722060204": {
            "id": "722060204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uhh, that's just too spooky. Let's just grab a few mushrooms and get out of here, shall we?"
          }
        }
      }
    },
    {
      "subId": "7220604",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722060401"
        ],
        "dialogs": {
          "722060401": {
            "id": "722060401",
            "speakerId": 1000,
            "speakerName": "Abe",
            "text": "How's it going? I'm ready and waiting to have my horizons broadened!",
            "nextDialogs": [
              "722060402"
            ]
          },
          "722060402": {
            "id": "722060402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Will these mushrooms do for you?"
          }
        }
      }
    },
    {
      "subId": "7220605",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722060301"
        ],
        "dialogs": {
          "722060301": {
            "id": "722060301",
            "speakerId": 1000,
            "speakerName": "Abe",
            "text": "Hey! Hey! Didn't I warn you lot before!? Are you hard of hearing, or do you just not have eyes, huh?",
            "nextDialogs": [
              "722060302"
            ]
          },
          "722060302": {
            "id": "722060302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oh, look, a ghost!",
            "nextDialogs": [
              "722060303"
            ]
          },
          "722060303": {
            "id": "722060303",
            "speakerId": 1000,
            "speakerName": "Abe",
            "text": "Eek! Ghost? Where? Where!?",
            "nextDialogs": [
              "722060306"
            ]
          },
          "722060306": {
            "id": "722060306",
            "speakerId": 1000,
            "speakerName": "Abe",
            "text": "Aaaagh! Go! Shoo! Evil begone! By my clan's name, Abe, depart from this place!",
            "nextDialogs": [
              "722060307"
            ]
          },
          "722060307": {
            "id": "722060307",
            "speakerId": 1000,
            "speakerName": "Abe",
            "text": "...What? N—No! That can't be! I've... I've never encountered such a wicked spirit in all my years! Wh—Why aren't you leaving?",
            "nextDialogs": [
              "722060308"
            ]
          },
          "722060308": {
            "id": "722060308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why, I've come from beyond this island.",
            "nextDialogs": [
              "722060309"
            ]
          },
          "722060309": {
            "id": "722060309",
            "speakerId": 1000,
            "speakerName": "Abe",
            "text": "An evil spirit from beyond the Sea of Fog? I—I'm not afraid of you! Just you wait! Th—The Great Thunderbird will exorcise you!"
          }
        }
      }
    },
    {
      "subId": "7220607",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722060501"
        ],
        "dialogs": {
          "722060501": {
            "id": "722060501",
            "speakerId": 1000,
            "speakerName": "Abe",
            "text": "Ooh! Haha... Wow, they've got such odd shapes! Do they have souls, too? Do they contain peoples' memories?",
            "nextDialogs": [
              "722060502"
            ]
          },
          "722060502": {
            "id": "722060502",
            "speakerId": 1000,
            "speakerName": "Abe",
            "text": "And these soft, wing-like things... Can they fly?",
            "nextDialogs": [
              "722060503"
            ]
          },
          "722060503": {
            "id": "722060503",
            "speakerId": 1000,
            "speakerName": "Abe",
            "text": "Ah, me and my endless curiosity! The boatman's getting annoyed now, I think. I'm sorry, but I reckon I must go. Yes, I must..."
          }
        }
      }
    }
  ]
}
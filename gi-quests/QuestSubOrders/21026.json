  "subQuests": [
    {
      "subId": "2102601",
      "subQuestName": "Talk to Yue Chuan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210260101"
        ],
        "dialogs": {
          "210260101": {
            "id": "210260101",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "The handwriting in this bottled letter seems to belong to a child...",
            "nextDialogs": [
              "210260102"
            ]
          },
          "210260102": {
            "id": "210260102",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "\"Little Meng\"? Who's that?",
            "nextDialogs": [
              "210260103"
            ]
          },
          "210260103": {
            "id": "210260103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Huh? Is that drifting bottle...",
            "nextDialogs": [
              "210260104"
            ]
          },
          "210260104": {
            "id": "210260104",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "Traveler? Judging from your tone, you know the person who wrote this letter, don't you?",
            "nextDialogs": [
              "210260107"
            ]
          },
          "210260107": {
            "id": "210260107",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "Ah, so that's how it is. Quite the thinker too, this kid. Wanting to become mature...",
            "nextDialogs": [
              "210260108"
            ]
          },
          "210260108": {
            "id": "210260108",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "You know what? I think he'd gain a lot from taking a little trip outside to broaden his horizons.",
            "nextDialogs": [
              "210260109"
            ]
          },
          "210260109": {
            "id": "210260109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh. Little Meng did say that he'd like to travel outside Liyue Harbor...",
            "nextDialogs": [
              "210260110"
            ]
          },
          "210260110": {
            "id": "210260110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But we invited him that time, didn't we? Why didn't he just agree then?",
            "nextDialogs": [
              "210260111"
            ]
          },
          "210260111": {
            "id": "210260111",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "Hahaha, I suppose that's a wee bit of what you might call a boy's \"stubbornness.\"",
            "nextDialogs": [
              "210260112"
            ]
          },
          "210260112": {
            "id": "210260112",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "It's his troubles, and he wants to solve them himself, you know? Can't be relying on others all the time.",
            "nextDialogs": [
              "210260113"
            ]
          },
          "210260113": {
            "id": "210260113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But he's not going to solve this problem by floating a bottle downstream...",
            "nextDialogs": [
              "210260114"
            ]
          },
          "210260114": {
            "id": "210260114",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "Well, yes. And that's where a reliable adult comes in, no?",
            "nextDialogs": [
              "210260115"
            ]
          },
          "210260115": {
            "id": "210260115",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "Come on, Traveler. Let's write this kid a letter together, shall we?",
            "nextDialogs": [
              "210260116"
            ]
          },
          "210260116": {
            "id": "210260116",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "Let's tell the kid about all the fascinating things waiting for him in the outside world.",
            "nextDialogs": [
              "210260117"
            ]
          },
          "210260117": {
            "id": "210260117",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "That said... Well, it's not like I've been to too many places, so you're in charge of the details, Traveler."
          }
        }
      }
    },
    {
      "subId": "2102602",
      "subQuestName": "Release the Drifting Bottle",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2102603",
      "subQuestName": "Talk to Yue Chuan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210261001"
        ],
        "dialogs": {
          "210261001": {
            "id": "210261001",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "How did it go? Have you sent the bottle off on its way?",
            "nextDialogs": [
              "210261002"
            ]
          },
          "210261002": {
            "id": "210261002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Will Little Meng really receive it?",
            "nextDialogs": [
              "210261003"
            ]
          },
          "210261003": {
            "id": "210261003",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "Heh. Usually, it would be a difficult thing. Impossible, even.",
            "nextDialogs": [
              "210261004"
            ]
          },
          "210261004": {
            "id": "210261004",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Then what was the point of us doing all that?",
            "nextDialogs": [
              "210261005"
            ]
          },
          "210261005": {
            "id": "210261005",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "Haha, relax. I did say that a certain responsible adult would help him.",
            "nextDialogs": [
              "210261006"
            ]
          },
          "210261006": {
            "id": "210261006",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "Do you know of a place called Sumeru?",
            "nextDialogs": [
              "210261007"
            ]
          },
          "210261007": {
            "id": "210261007",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "I have a few friends who are businessmen. They are currently planning to get into the mushroom market, so they're going there to perform market surveys.",
            "nextDialogs": [
              "210261008"
            ]
          },
          "210261008": {
            "id": "210261008",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "But as you know, \"market surveys\" tend to also leave much time open for leisure.",
            "nextDialogs": [
              "210261009"
            ]
          },
          "210261009": {
            "id": "210261009",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "Since that kid called Little Meng wants to travel, I can ask those friends of mine if they can bring another person along.",
            "nextDialogs": [
              "210261010"
            ]
          },
          "210261010": {
            "id": "210261010",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "Don't worry about it. I'll handle all the arrangements.",
            "nextDialogs": [
              "210261011"
            ]
          },
          "210261011": {
            "id": "210261011",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "I've made another copy of the letter for other purposes. As for the bottle... Let it go on its way, though I doubt anyone will pick it up.",
            "nextDialogs": [
              "210261014"
            ]
          },
          "210261014": {
            "id": "210261014",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "Isn't fulfilling the dreams of children something adults should do? Relax, you can leave this matter to me.",
            "nextDialogs": [
              "210261015"
            ]
          },
          "210261015": {
            "id": "210261015",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "Ah, yes. I should ask those friends of mine to dress a bit better. Scaring people just won't do..."
          }
        }
      }
    },
    {
      "subId": "2102609",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210260901"
        ],
        "dialogs": {
          "210260901": {
            "id": "210260901",
            "speakerId": 1000,
            "speakerName": "Yue Chuan",
            "text": "Well, I've put this letter into the drifting bottle. Send it down the river."
          }
        }
      }
    },
    {
      "subId": "2102611",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210261101"
        ],
        "dialogs": {
          "210261101": {
            "id": "210261101",
            "speakerId": 1002,
            "speakerName": "Check",
            "text": "Yue Chuan's drifting bottle was only just released, and hasn't floated off very far yet."
          }
        }
      }
    }
  ]
}
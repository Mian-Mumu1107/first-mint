    {
      "subId": "4131307",
      "subQuestName": "Talk to Huai'an",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413130701"
        ],
        "dialogs": {
          "413130701": {
            "id": "413130701",
            "speakerId": 1003,
            "speakerName": "Huai'an",
            "text": "Here's not too bad... and it's safely away from all the foot traffic. A fitting choice.",
            "nextDialogs": [
              "413130702"
            ]
          },
          "413130702": {
            "id": "413130702",
            "speakerId": 1003,
            "speakerName": "Huai'an",
            "text": "We've got ourselves a nice spot, now we need to build a proper stall. I've thought about it, and I believe I know roughly how to go about it.",
            "nextDialogs": [
              "413130703"
            ]
          },
          "413130703": {
            "id": "413130703",
            "speakerId": 1003,
            "speakerName": "Huai'an",
            "text": "If you'll excuse me for a moment, I'll try to figure out where to start...",
            "nextDialogs": [
              "413130704"
            ]
          },
          "413130704": {
            "id": "413130704",
            "speakerId": 1003,
            "speakerName": "Huai'an",
            "text": "And voila! A little rough around the edges, but it should serve us well. What do you think?",
            "nextDialogs": [
              "413130705"
            ]
          },
          "413130705": {
            "id": "413130705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I think you've missed your true calling! Such expert carpentry...",
            "nextDialogs": [
              "413130706"
            ]
          },
          "413130706": {
            "id": "413130706",
            "speakerId": 1003,
            "speakerName": "Huai'an",
            "text": "It was no big deal! Just a little bit of DIY that I picked up years ago. I've forgotten most of it, actually.",
            "nextDialogs": [
              "413130707"
            ]
          },
          "413130707": {
            "id": "413130707",
            "speakerId": 1003,
            "speakerName": "Huai'an",
            "text": "Well, we can check the stall off our to-do list. It looks quite festive decorated with that Xiao Lantern, wouldn't you say?",
            "nextDialogs": [
              "413130708"
            ]
          },
          "413130708": {
            "id": "413130708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You know how to make Xiao Lanterns too?",
            "nextDialogs": [
              "413130709"
            ]
          },
          "413130709": {
            "id": "413130709",
            "speakerId": 1003,
            "speakerName": "Huai'an",
            "text": "Well yes, but in my generation, it's just the norm for everyone who grew up in Liyue.",
            "nextDialogs": [
              "413130710"
            ]
          },
          "413130710": {
            "id": "413130710",
            "speakerId": 1003,
            "speakerName": "Huai'an",
            "text": "Anyway, speaking of festivities... No celebration is complete without a feast. Do you know what you would like on the menu?",
            "nextDialogs": [
              "413130711"
            ]
          },
          "413130711": {
            "id": "413130711",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Almond Tofu, that's for sure! We've made it for Xiao before.",
            "nextDialogs": [
              "413130712"
            ]
          },
          "413130712": {
            "id": "413130712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And Grilled Tiger Fish.",
            "nextDialogs": [
              "413130713"
            ]
          },
          "413130713": {
            "id": "413130713",
            "speakerId": 1003,
            "speakerName": "Huai'an",
            "text": "Almond Tofu and Grilled Tiger Fish, hmm... What an interesting combination of flavors! I'll have a word with Smiley Yanxiao.",
            "nextDialogs": [
              "413130714"
            ]
          },
          "413130714": {
            "id": "413130714",
            "speakerId": 1003,
            "speakerName": "Huai'an",
            "text": "He should be able to rustle those up in no time. Luckily, the inn's pantry contains all the necessary ingredients.",
            "nextDialogs": [
              "413130715"
            ]
          },
          "413130715": {
            "id": "413130715",
            "speakerId": 1003,
            "speakerName": "Huai'an",
            "text": "Oh, it's about time to summon our honored guest. Could you fetch him? The food should be ready by the time you come down."
          }
        }
      }
    },
    {
      "subId": "4131308",
      "subQuestName": "Talk to Xiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413130801"
        ],
        "dialogs": {
          "413130801": {
            "id": "413130801",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "What now?",
            "nextDialogs": [
              "413130802"
            ]
          },
          "413130802": {
            "id": "413130802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'd like you to come to Lantern Rite with us.",
            "nextDialogs": [
              "413130803"
            ]
          },
          "413130803": {
            "id": "413130803",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "...We've had the talk about crowded places. Do not make me repeat myself. Best you go alone.",
            "nextDialogs": [
              "413130804"
            ]
          },
          "413130804": {
            "id": "413130804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I didn't say you have to go to Liyue Harbor.",
            "nextDialogs": [
              "413130805"
            ]
          },
          "413130805": {
            "id": "413130805",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "...What is that supposed to mean?",
            "nextDialogs": [
              "413130806"
            ]
          },
          "413130806": {
            "id": "413130806",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You wouldn't go to the festival, so we brought the festival to you.",
            "nextDialogs": [
              "413130807"
            ]
          },
          "413130807": {
            "id": "413130807",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "You \"brought the festival to me\"?",
            "nextDialogs": [
              "413130808"
            ]
          },
          "413130808": {
            "id": "413130808",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Okay, so there's a bunch of delicious snacks just laid out below the inn, and a bunch of Xiao lanterns, and there's practically no one else around to have to worry about.",
            "nextDialogs": [
              "413130809"
            ]
          },
          "413130809": {
            "id": "413130809",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's even Almond Tofu and Grilled Tiger Fish...",
            "nextDialogs": [
              "413130810"
            ]
          },
          "413130810": {
            "id": "413130810",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Better hurry up or the food's gonna go cold. Come on down!"
          }
        }
      }
    },
    {
      "subId": "4131309",
      "subQuestName": "Dine with Xiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413130901"
        ],
        "dialogs": {
          "413130901": {
            "id": "413130901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ta-da! Your very own, miniature Lantern Rite festival! Well if it doesn't look mouth-watering...",
            "nextDialogs": [
              "413130902"
            ]
          },
          "413130902": {
            "id": "413130902",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "So this is what you meant by bringing the festival to me... *sigh* Is there no end to the peculiarities of human behavior?",
            "nextDialogs": [
              "413130903"
            ]
          },
          "413130903": {
            "id": "413130903",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "Does it serve any grander purpose?",
            "nextDialogs": [
              "413130906"
            ]
          },
          "413130906": {
            "id": "413130906",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "...Is that so? Hmph, human motives defy my attempts to fathom them.",
            "nextDialogs": [
              "413130907"
            ]
          },
          "413130907": {
            "id": "413130907",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Less fathoming, more eating! Come on, dig in, before it gets cold!",
            "nextDialogs": [
              "413130908"
            ]
          },
          "413130908": {
            "id": "413130908",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Mmm-mmm, okay, Paimon's gonna concentrate on eating now.",
            "nextDialogs": [
              "413130909"
            ]
          },
          "413130909": {
            "id": "413130909",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ahh... Now that we're done with the most important part of the celebration, we should be heading out to see the Mingxiao Lantern.",
            "nextDialogs": [
              "413130910"
            ]
          },
          "413130910": {
            "id": "413130910",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Come with us, Xiao.",
            "nextDialogs": [
              "413130911"
            ]
          },
          "413130911": {
            "id": "413130911",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "You may take your leave. There's nothing for me over there."
          }
        }
      }
    },
    {
      "subId": "4131320",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413132001"
        ],
        "dialogs": {
          "413132001": {
            "id": "413132001",
            "speakerId": 1003,
            "speakerName": "Huai'an",
            "text": "There, the stall's really starting to come together now.",
            "nextDialogs": [
              "413132002"
            ]
          },
          "413132002": {
            "id": "413132002",
            "speakerId": 1003,
            "speakerName": "Huai'an",
            "text": "Speaking of which, how's the food coming along?",
            "nextDialogs": [
              "413132003"
            ]
          },
          "413132003": {
            "id": "413132003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Everything's ready.",
            "nextDialogs": [
              "413132004"
            ]
          },
          "413132004": {
            "id": "413132004",
            "speakerId": 1003,
            "speakerName": "Huai'an",
            "text": "Good. Let me start setting it all out then. In the meantime, you can go bring our guest. Hurry along now, we don't want to let our food get cold."
          }
        }
      }
    },
    {
      "subId": "4131310",
      "subQuestName": "Go to Liyue Harbor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4131311",
      "subQuestName": "Talk to Xiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413131101"
        ],
        "dialogs": {
          "413131101": {
            "id": "413131101",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "This is as far as I will go. Please see yourselves into the city.",
            "nextDialogs": [
              "413131103"
            ]
          },
          "413131103": {
            "id": "413131103",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "What now?",
            "nextDialogs": [
              "413131105"
            ]
          },
          "413131105": {
            "id": "413131105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You are obviously one of the heroes this festival is all about... Why don't you want to get involved?",
            "nextDialogs": [
              "413131106"
            ]
          },
          "413131106": {
            "id": "413131106",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "I... detest the rabble.",
            "nextDialogs": [
              "413131107"
            ]
          },
          "413131107": {
            "id": "413131107",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "No cares in the world, so peaceful, so joyful... They are nothing like me.",
            "nextDialogs": [
              "413131108"
            ]
          },
          "413131108": {
            "id": "413131108",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "Too long have I spent slaughtering, accompanied by the burden of suffering that follows in its wake. Crossing paths with all those jubilant people will only make me...",
            "nextDialogs": [
              "413131109"
            ]
          },
          "413131109": {
            "id": "413131109",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "...That's all I have to say.",
            "nextDialogs": [
              "413131110"
            ]
          },
          "413131110": {
            "id": "413131110",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "Farewell.",
            "nextDialogs": [
              "413131111"
            ]
          },
          "413131111": {
            "id": "413131111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you sure you don't want to go with us?",
            "nextDialogs": [
              "413131112"
            ]
          },
          "413131112": {
            "id": "413131112",
            "speakerId": 1000,
            "speakerName": "Xiao",
            "text": "Are you really so enamored with such trivial amusements?",
            "nextDialogs": [
              "413131113"
            ]
          },
          "413131113": {
            "id": "413131113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do you think?",
            "nextDialogs": [
              "413131114"
            ]
          },
          "413131114": {
            "id": "413131114",
            "speakerId": 1001,

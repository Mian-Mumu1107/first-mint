    },
    {
      "subId": "7415402",
      "subQuestName": "Discuss with Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741540201"
        ],
        "dialogs": {
          "741540201": {
            "id": "741540201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Something's fishy, something's fishy... Even Paimon can tell that there's something off about all this!",
            "nextDialogs": [
              "741540202"
            ]
          },
          "741540202": {
            "id": "741540202",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, you're the brighter spark here. What should we do next?",
            "nextDialogs": [
              "741540207"
            ]
          },
          "741540207": {
            "id": "741540207",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Then how about we go take another look near Benoit's house? Wasn't there a strange box by his back window?",
            "nextDialogs": [
              "741540208"
            ]
          },
          "741540208": {
            "id": "741540208",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "There's definitely something hidden in there, and it might just be the proof you're looking for..."
          }
        }
      }
    },

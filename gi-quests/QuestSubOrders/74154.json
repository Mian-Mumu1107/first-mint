  "subQuests": [
    {
      "subId": "7415408",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741540801"
        ],
        "dialogs": {
          "741540801": {
            "id": "741540801",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, look! Fresh Fish, and the floor looks clean too. Someone definitely just tidied up.",
            "nextDialogs": [
              "741540802"
            ]
          },
          "741540802": {
            "id": "741540802",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "There's someone in Benoit's house for sure. Let's go over and listen.",
            "nextDialogs": [
              "741540803"
            ]
          },
          "741540803": {
            "id": "741540803",
            "speakerId": 1001,
            "speakerName": "Athos",
            "text": "...He's right, he can't just disappear altogether. At the very least, he needs to be seen once in a while... out on a walk or something like that.",
            "nextDialogs": [
              "741540804"
            ]
          },
          "741540804": {
            "id": "741540804",
            "speakerId": 1001,
            "speakerName": "Athos",
            "text": "If nothing else, it'll stop the neighbors from calling the Maison Gardiennage — I'd rather not have the Special Patrol's Musketeers breathing down our necks.",
            "nextDialogs": [
              "741540805"
            ]
          },
          "741540805": {
            "id": "741540805",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "Dad, you really want to go out for a walk, don't you?",
            "nextDialogs": [
              "741540806"
            ]
          },
          "741540806": {
            "id": "741540806",
            "speakerId": 1003,
            "speakerName": "Benoit Leroy",
            "text": "C—Can I?",
            "nextDialogs": [
              "741540807"
            ]
          },
          "741540807": {
            "id": "741540807",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "Of course you can! Not only that, but we'd be delighted to come with you.",
            "nextDialogs": [
              "741540808"
            ]
          },
          "741540808": {
            "id": "741540808",
            "speakerId": 1001,
            "speakerName": "Athos",
            "text": "Careful now — don't let him use it as an opportunity to call for help. Those two weirdos have been watching this place like hawks...",
            "nextDialogs": [
              "741540809"
            ]
          },
          "741540809": {
            "id": "741540809",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "Dad won't do that, I'm sure.",
            "nextDialogs": [
              "741540810"
            ]
          },
          "741540810": {
            "id": "741540810",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "Dad, you wouldn't want the Maison Gardiennage to know...",
            "nextDialogs": [
              "741540811"
            ]
          },
          "741540811": {
            "id": "741540811",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...To know what!? Why are they speaking so quietly? Paimon can't hear a thing.",
            "nextDialogs": [
              "741540812"
            ]
          },
          "741540812": {
            "id": "741540812",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They're about to come out.",
            "nextDialogs": [
              "741540813"
            ]
          },
          "741540813": {
            "id": "741540813",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Okay, we need to move a bit further away. This time, we have to think of a way to speak with Benoit, right?",
            "nextDialogs": [
              "741540814"
            ]
          },
          "741540814": {
            "id": "741540814",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yup.",
            "nextDialogs": [
              "741540815"
            ]
          },
          "741540815": {
            "id": "741540815",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Alright, let's scoot.",
            "nextDialogs": [
              "741540816"
            ]
          },
          "741540816": {
            "id": "741540816",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "How is it, Dad? Are you feeling any better now?",
            "nextDialogs": [
              "741540817"
            ]
          },
          "741540817": {
            "id": "741540817",
            "speakerId": 1003,
            "speakerName": "Benoit Leroy",
            "text": "It's you!",
            "nextDialogs": [
              "741540818"
            ]
          },
          "741540818": {
            "id": "741540818",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Benoit...",
            "nextDialogs": [
              "741540819"
            ]
          },
          "741540819": {
            "id": "741540819",
            "speakerId": 1003,
            "speakerName": "Benoit Leroy",
            "text": "...Help me! Uh, I mean, don't help me...",
            "nextDialogs": [
              "741540820"
            ]
          },
          "741540820": {
            "id": "741540820",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "What are you saying, Dad? What's all this \"help me, don't help me\" business? Hehe.",
            "nextDialogs": [
              "741540821"
            ]
          },
          "741540821": {
            "id": "741540821",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "Oh, it's you two. No wonder Dad went out of his way to talk to you — you are acquainted, after all.",
            "nextDialogs": [
              "741540822"
            ]
          },
          "741540822": {
            "id": "741540822",
            "speakerId": 1003,
            "speakerName": "Benoit Leroy",
            "text": "...N—No, I don't! We don't know each other at all!",
            "nextDialogs": [
              "741540823"
            ]
          },
          "741540823": {
            "id": "741540823",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "No? But why would they be waiting here just for you then, Dad?",
            "nextDialogs": [
              "741540824"
            ]
          },
          "741540824": {
            "id": "741540824",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "They were even nice enough to get the paper for us. Why, they even went to the Fleuve Cendre to talk to our old neighbor, Snodgrass.",
            "nextDialogs": [
              "741540825"
            ]
          },
          "741540825": {
            "id": "741540825",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "I think you must be very close! And no wonder. You've always loved kids, haven't you, Dad?",
            "nextDialogs": [
              "741540826"
            ]
          },
          "741540826": {
            "id": "741540826",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "I love kids too! But I'm afraid I'm not as selfless as my father. I love my own child the most, but... she's gone.",
            "nextDialogs": [
              "741540828",
              "741540830"
            ]
          },
          "741540828": {
            "id": "741540828",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "Athos and I are our father's children. Dad loves us, and we love him too. Isn't it obvious?",
            "nextDialogs": [
              "741540831"
            ]
          },
          "741540831": {
            "id": "741540831",
            "speakerId": 1001,
            "speakerName": "Athos",
            "text": "Morticia, look at how lovely the weather is today. Perfect for a walk.",
            "nextDialogs": [
              "741540832"
            ]
          },
          "741540832": {
            "id": "741540832",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "So it is, Athos.",
            "nextDialogs": [
              "741540833"
            ]
          },
          "741540833": {
            "id": "741540833",
            "speakerId": 1001,
            "speakerName": "Athos",
            "text": "Have you seen today's Steambird? There are quite a few interesting stories.",
            "nextDialogs": [
              "741540834"
            ]
          },
          "741540834": {
            "id": "741540834",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "Oh dear, I fear I haven't.",
            "nextDialogs": [
              "741540835"
            ]
          },
          "741540835": {
            "id": "741540835",
            "speakerId": 1001,
            "speakerName": "Athos",
            "text": "There's one in particular about an old man who met an unfortunate end. Apparently, he encountered some thieves, and as there was no one by his side looking out for him, he ended up falling off a cliff and died.",
            "nextDialogs": [
              "741540836"
            ]
          },
          "741540836": {
            "id": "741540836",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "Oh, really? The horror! That's so terrible.",
            "nextDialogs": [
              "741540837"
            ]
          },
          "741540837": {
            "id": "741540837",
            "speakerId": 1001,
            "speakerName": "Athos",
            "text": "And another about a very unlucky merchant who drowned. It seems he drank too much, and walked into a lake in a stupor, and just like that... he drowned.",
            "nextDialogs": [
              "741540838"
            ]
          },
          "741540838": {
            "id": "741540838",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "Ah! My word! Truly unlucky!",
            "nextDialogs": [
              "741540839"
            ]
          },
          "741540839": {
            "id": "741540839",
            "speakerId": 1001,
            "speakerName": "Athos",
            "text": "#And this last one is very interesting! It's about a meddling busybody who just couldn't keep their nose out of other people's business. *sigh* {M#He}{F#She} accidentally took the wrong medicine.",
            "nextDialogs": [
              "741540840"
            ]
          },
          "741540840": {
            "id": "741540840",
            "speakerId": 1001,
            "speakerName": "Athos",
            "text": "#{M#He}{F#She} mistook poison for medicine for {M#his}{F#her} illness, and just like that, swallowed the lot! And then ended up dying very, very painfully.",
            "nextDialogs": [
              "741540841"
            ]
          },
          "741540841": {
            "id": "741540841",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "Oh my! There really are so many ways to die. Please, go on.",
            "nextDialogs": [
              "741540842"
            ]
          },
          "741540842": {
            "id": "741540842",
            "speakerId": 1003,
            "speakerName": "Benoit Leroy",
            "text": "...Sorry, sorry! I won't ever do that again.",
            "nextDialogs": [
              "741540843"
            ]
          },
          "741540843": {
            "id": "741540843",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "What ever are you talking about, Dad? We're not trying to say it's your fault or anything. But... you must be tired after running around so much.",
            "nextDialogs": [
              "741540844"
            ]
          },
          "741540844": {
            "id": "741540844",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "Athos, why don't we go back and read the newspaper to Dad? You subscribe to a lot of papers, don't you, Dad?",
            "nextDialogs": [
              "741540845"
            ]
          },
          "741540845": {
            "id": "741540845",
            "speakerId": 1001,
            "speakerName": "Athos",
            "text": "That's right! We've been chatting long enough. We ought to go back now.",
            "nextDialogs": [
              "741540846"
            ]
          },
          "741540846": {
            "id": "741540846",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "Let's go back together, Daddy dearest."
          },
          "741540830": {
            "id": "741540830",
            "speakerId": 1002,
            "speakerName": "Morticia",
            "text": "Do you mean accompanying our dad on a walk? It's our duty as his children to do so, is it not? Failing such a basic responsibility to him would be a poor way to repay the care he has given us."
          }
        }
      }
    },
    {
      "subId": "7415401",
      "subQuestName": "Observe what's going on near Benoit's residence",
      "sceneId": null,

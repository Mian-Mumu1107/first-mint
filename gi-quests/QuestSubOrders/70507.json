  "subQuests": [
    {
      "subId": "7050701",
      "subQuestName": "Talk to Luka and enter the tavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705070101"
        ],
        "dialogs": {
          "705070101": {
            "id": "705070101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Zh—Zhongli!",
            "nextDialogs": [
              "705070102"
            ]
          },
          "705070102": {
            "id": "705070102",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "Ah, Traveler. Good to see you, I trust you are well?",
            "nextDialogs": [
              "705070103"
            ]
          },
          "705070103": {
            "id": "705070103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "W—Wait... Uh, Zhongli, what are you doing here?",
            "nextDialogs": [
              "705070104"
            ]
          },
          "705070104": {
            "id": "705070104",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "If I am to roam about the world, then I certainly mustn't limit my destinations. The free and prosperous Land of Wind is as splendid a place to visit as any.",
            "nextDialogs": [
              "705070105"
            ]
          },
          "705070105": {
            "id": "705070105",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "And it's quite a pleasant surprise to run into you here.",
            "nextDialogs": [
              "705070108"
            ]
          },
          "705070108": {
            "id": "705070108",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "One Misty Garden please. I take my tea strong, thank you."
          }
        }
      }
    },

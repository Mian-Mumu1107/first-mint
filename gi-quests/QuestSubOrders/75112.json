  "subQuests": [
    {
      "subId": "7511201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751120101"
        ],
        "dialogs": {
          "751120101": {
            "id": "751120101",
            "speakerId": 1000,
            "speakerName": "Quiltec",
            "text": "Between the rocks and the boulders... Leaping back and forth, moving ever faster...",
            "nextDialogs": [
              "751120104"
            ]
          },
          "751120104": {
            "id": "751120104",
            "speakerId": 1000,
            "speakerName": "Quiltec",
            "text": "So, the challenge... You up for it?"
          }
        }
      }
    },
    {
      "subId": "7511202",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751120201"
        ],
        "dialogs": {
          "751120201": {
            "id": "751120201",
            "speakerId": 1001,
            "speakerName": "Centaca",
            "text": "Hehe. I felt your presence from afar, outlander warrior. Very impressive!",
            "nextDialogs": [
              "751120204"
            ]
          },
          "751120204": {
            "id": "751120204",
            "speakerId": 1001,
            "speakerName": "Centaca",
            "text": "Wanna take part in this Warrior's Challenge? Not to brag or anything, but I'm sure my trial will be of great help to you."
          }
        }
      }
    },
    {
      "subId": "7511203",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751120301"
        ],
        "dialogs": {
          "751120301": {
            "id": "751120301",
            "speakerId": 1002,
            "speakerName": "Xiuhyo",
            "text": "Hmm... Outlander warrior, I have a favor to ask.",
            "nextDialogs": [
              "751120304"
            ]
          },
          "751120304": {
            "id": "751120304",
            "speakerId": 1002,
            "speakerName": "Xiuhyo",
            "text": "I am the \"Master Trainer\" of our tribe, but my abilities have yet to match my title, so I can't be sure about the difficulty of the \"Warrior's Challenge\" I've come up with...",
            "nextDialogs": [
              "751120305"
            ]
          },
          "751120305": {
            "id": "751120305",
            "speakerId": 1002,
            "speakerName": "Xiuhyo",
            "text": "So, could you help me test it?"
          }
        }
      }
    },
    {
      "subId": "7511204",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751120401"
        ],
        "dialogs": {
          "751120401": {
            "id": "751120401",
            "speakerId": 1003,
            "speakerName": "Lirio",
            "text": "For us, the Scions of the Canopy, agility and finesse are essential qualities, and that's why I've prepared this Warrior's Challenge.",
            "nextDialogs": [
              "751120404"
            ]
          },
          "751120404": {
            "id": "751120404",
            "speakerId": 1003,
            "speakerName": "Lirio",
            "text": "So, outlander warrior! Wanna take a swing at this?"
          }
        }
      }
    },
    {
      "subId": "7511205",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751120501"
        ],
        "dialogs": {
          "751120501": {
            "id": "751120501",
            "speakerId": 1004,
            "speakerName": "Cima",
            "text": "Hmm, a rare guest from afar, I see. Well, what do you say? Wanna try my Warrior's Challenge?",
            "nextDialogs": [
              "751120504"
            ]
          },
          "751120504": {
            "id": "751120504",
            "speakerId": 1004,
            "speakerName": "Cima",
            "text": "Many a Warrior's Challenge awaits our tribal fighters throughout Natlan. And as for me, I'm one of those who arranges those challenges.",
            "nextDialogs": [
              "751120505"
            ]
          },
          "751120505": {
            "id": "751120505",
            "speakerId": 1004,
            "speakerName": "Cima",
            "text": "Well, don't you look like a tough one, outlander? Wanna take on the challenge that I've prepared?"
          }
        }
      }
    },
    {
      "subId": "7511206",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751120601"
        ],
        "dialogs": {
          "751120601": {
            "id": "751120601",
            "speakerId": 1005,
            "speakerName": "Manzana",
            "text": "This Warrior's Challenge is designed for couriers, so it will be tough. Not that I'm underestimating you, of course.",
            "nextDialogs": [
              "751120604"
            ]
          },
          "751120604": {
            "id": "751120604",
            "speakerId": 1005,
            "speakerName": "Manzana",
            "text": "How about it? Want to give it a go?"
          }
        }
      }
    },
    {
      "subId": "7511207",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751120701"
        ],
        "dialogs": {
          "751120701": {
            "id": "751120701",
            "speakerId": 1006,
            "speakerName": "Tepache",
            "text": "There's nothing more fun than leaping up high, before feeling the weightlessness of your fall.",
            "nextDialogs": [
              "751120704"
            ]
          },
          "751120704": {
            "id": "751120704",
            "speakerId": 1006,
            "speakerName": "Tepache",
            "text": "Hey there! What would you say to trying out my Warrior's Challenge?"
          }
        }
      }
    },
    {
      "subId": "7511208",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751120801"
        ],
        "dialogs": {
          "751120801": {
            "id": "751120801",
            "speakerId": 1007,
            "speakerName": "Matzatli",
            "text": "Wanna try out this Spiritway challenge?",
            "nextDialogs": [
              "751120804"
            ]
          },
          "751120804": {
            "id": "751120804",
            "speakerId": 1007,
            "speakerName": "Matzatli",
            "text": "Well, you're here, so you might as well give it a whirl! Sure beats going back empty-handed, am I right?"
          }
        }
      }
    },
    {
      "subId": "7511209",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751120901"
        ],
        "dialogs": {
          "751120901": {
            "id": "751120901",
            "speakerId": 1008,
            "speakerName": "Avuia",
            "text": "I love the feeling of sliding along the Spiritways. There's nothing more soothing than hearing the wind whistling in your ears.",
            "nextDialogs": [
              "751120904"
            ]
          },
          "751120904": {
            "id": "751120904",
            "speakerId": 1008,
            "speakerName": "Avuia",
            "text": "I became a Master Trainer to help our tribespeople understand the joys of gliding along Spiritways even as I train them to become warriors.",
            "nextDialogs": [
              "751120905"
            ]
          },
          "751120905": {
            "id": "751120905",
            "speakerId": 1008,
            "speakerName": "Avuia",
            "text": "What about you? Wanna try joining in?"
          }
        }
      }
    },
    {
      "subId": "7511210",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751121001"
        ],
        "dialogs": {
          "751121001": {
            "id": "751121001",
            "speakerId": 1000,
            "speakerName": "Quiltec",
            "text": "To follow the veins of the earth is most important indeed..."
          }
        }
      }
    },
    {
      "subId": "7511211",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751121101"
        ],
        "dialogs": {
          "751121101": {
            "id": "751121101",
            "speakerId": 1001,
            "speakerName": "Centaca",
            "text": "Collect as many Challenge Coins as you can and complete the challenge. I've naught but faith in you!"
          }
        }
      }
    },
    {
      "subId": "7511212",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751121201"
        ],
        "dialogs": {
          "751121201": {
            "id": "751121201",
            "speakerId": 1002,
            "speakerName": "Xiuhyo",
            "text": "Um... Collect the Challenge Coins along your path and... better yet, try to catch up to the little Tepetlisaurus.",
            "nextDialogs": [
              "751121202"
            ]
          },
          "751121202": {
            "id": "751121202",
            "speakerId": 1002,
            "speakerName": "Xiuhyo",
            "text": "Why? Well, little Tepetlisaurs are really cute, so I thought this would make things more interesting..."
          }
        }
      }
    },
    {
      "subId": "7511213",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751121301"
        ],
        "dialogs": {
          "751121301": {
            "id": "751121301",
            "speakerId": 1003,
            "speakerName": "Lirio",
            "text": "Stay quick on your feet and grab all the Challenge Coins you can... Yeah, that's kinda how the trial's gonna go."
          }
        }
      }
    },
    {
      "subId": "7511214",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751121401"
        ],
        "dialogs": {
          "751121401": {
            "id": "751121401",
            "speakerId": 1004,
            "speakerName": "Cima",
            "text": "Well, simply put, just collect Challenge Coins, as many as you can get. The more, the better! The quicker, the stronger!"
          }
        }
      }
    },
    {
      "subId": "7511215",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751121501"
        ],
        "dialogs": {
          "751121501": {
            "id": "751121501",
            "speakerId": 1005,
            "speakerName": "Manzana",
            "text": "Use the grappling hook... or other means, to collect the explosive barrels and defeat your foes. This, too, is one of a messenger's many tasks... sorta."
          }
        }
      }
    },
    {
      "subId": "7511216",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751121601"
        ],
        "dialogs": {
          "751121601": {
            "id": "751121601",
            "speakerId": 1006,
            "speakerName": "Tepache",
            "text": "You can use Jet-Set Eddies to reach high places, and it's quite the experience to boot. Be careful when you land in the water, though."
          }
        }
      }
    },
    {
      "subId": "7511217",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751121701"
        ],
        "dialogs": {
          "751121701": {
            "id": "751121701",
            "speakerId": 1007,
            "speakerName": "Matzatli",
            "text": "Get on the Spiritway, then... Uh, how do I put it? Earn a higher score with some flashy-splashy motions? Something like that! There you go, super easy."
          }
        }
      }
    },
    {
      "subId": "7511218",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751121801"
        ],
        "dialogs": {
          "751121801": {
            "id": "751121801",
            "speakerId": 1008,
            "speakerName": "Avuia",
            "text": "Riding Spiritways is unbelievably fun, and I'd love to share that with more folks."
          }
        }
      }
    }
  ]
}
    {
      "subId": "4134201",
      "subQuestName": "Talk to Siyu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413420101"
        ],
        "dialogs": {
          "413420101": {
            "id": "413420101",
            "speakerId": 2095,
            "speakerName": "Siyu",
            "text": "I suppose I should give him a Xiao Lantern after all...",
            "nextDialogs": [
              "413420102"
            ]
          },
          "413420102": {
            "id": "413420102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Give who a Xiao Lantern?",
            "nextDialogs": [
              "413420103"
            ]
          },
          "413420103": {
            "id": "413420103",
            "speakerId": 2095,
            "speakerName": "Siyu",
            "text": "Oh, Traveler, it's you. Well, \"The Wrench\" has always taken good care of me. Even now, he helps me out all the time — he's almost like a real brother to me.",
            "nextDialogs": [
              "413420104"
            ]
          },
          "413420104": {
            "id": "413420104",
            "speakerId": 2095,
            "speakerName": "Siyu",
            "text": "This is supposed to be a festival, and yet he's still working non-stop...",
            "nextDialogs": [
              "413420105"
            ]
          },
          "413420105": {
            "id": "413420105",
            "speakerId": 2095,
            "speakerName": "Siyu",
            "text": "So, I'd like to give him a Xiao Lantern as a gift. Hehe, we were childhood playmates, and he absolutely loved the sight of the lanterns when he was little.",
            "nextDialogs": [
              "413420106"
            ]
          },
          "413420106": {
            "id": "413420106",
            "speakerId": 2095,
            "speakerName": "Siyu",
            "text": "I'm sure he'd love to get one now. Traveler, could you help me deliver this Xiao Lantern to him?",
            "nextDialogs": [
              "413420109"
            ]
          },
          "413420109": {
            "id": "413420109",
            "speakerId": 2095,
            "speakerName": "Siyu",
            "text": "I'd love to, but I've still got so many things to take care of at home...",
            "nextDialogs": [
              "413420110"
            ]
          },
          "413420110": {
            "id": "413420110",
            "speakerId": 2095,
            "speakerName": "Siyu",
            "text": "I've left my husband to do all the housework while I've been out shopping. I should get back to help him out as soon as I can.",
            "nextDialogs": [
              "413420111"
            ]
          },
          "413420111": {
            "id": "413420111",
            "speakerId": 2095,
            "speakerName": "Siyu",
            "text": "So I'm leaving the matter of the Xiao Lantern to you. Once we've got some time, my husband and I will go see \"The Wrench\" together.",
            "nextDialogs": [
              "413420112"
            ]
          },
          "413420112": {
            "id": "413420112",
            "speakerId": 2095,
            "speakerName": "Siyu",
            "text": "I do hope that he'll manage to get a little more free time..."
          }
        }
      }
    },
    {
      "subId": "4134204",
      "subQuestName": "Give a Xiao Lantern to Wrench Wang",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413420401"
        ],
        "dialogs": {
          "413420401": {
            "id": "413420401",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Hmm? Do you have some business with me, Traveler? I'm quite busy at the moment.",
            "nextDialogs": [
              "413420402"
            ]
          },
          "413420402": {
            "id": "413420402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's a Xiao Lantern from Siyu..."
          }
        }
      }
    },
    {
      "subId": "4134205",
      "subQuestName": "Talk to Wrench Wang",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413420501"
        ],
        "dialogs": {
          "413420501": {
            "id": "413420501",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Siyu? She... she got me a Xiao Lantern? L—Let me see!",
            "nextDialogs": [
              "413420502"
            ]
          },
          "413420502": {
            "id": "413420502",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Hahaha, she wrote this wish for me, didn't she? Yep, that was my greatest wish as a kid...",
            "nextDialogs": [
              "413420503"
            ]
          },
          "413420503": {
            "id": "413420503",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "So many years have passed in the blink of an eye. Time truly flies...",
            "nextDialogs": [
              "413420504"
            ]
          },
          "413420504": {
            "id": "413420504",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Still, how come she asked you to deliver it to me?",
            "nextDialogs": [
              "413420507"
            ]
          },
          "413420507": {
            "id": "413420507",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Ah, is that so... Good, good. Yes. Very good.",
            "nextDialogs": [
              "413420508"
            ]
          },
          "413420508": {
            "id": "413420508",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Sounds like she's got a good life now. That's all that matters... Haha... Heh.",
            "nextDialogs": [
              "413420509"
            ]
          },
          "413420509": {
            "id": "413420509",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "It's a good thing. It's very good... I'm sorry, I've still got a lot of work to do. If you'll please excuse me..."
          }
        }
      }
    },
    {
      "subId": "4134206",
      "subQuestName": "Talk to Hammer Li",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413420602"
        ],
        "dialogs": {
          "413420602": {
            "id": "413420602",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "That Xiao Lantern was from Siyu, wasn't it?",
            "nextDialogs": [
              "413420605"
            ]
          },
          "413420605": {
            "id": "413420605",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "Hah, I just know him well enough. There was no need to even guess.",
            "nextDialogs": [
              "413420606"
            ]
          },
          "413420606": {
            "id": "413420606",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "He did exactly the same thing last year. Went off for a walk, then came right back and proceeded to hammer nails into a ship's hull the whole night through.",
            "nextDialogs": [
              "413420607"
            ]
          },
          "413420607": {
            "id": "413420607",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "I know why he does this, but still... *sigh*",
            "nextDialogs": [
              "413420608"
            ]
          },
          "413420608": {
            "id": "413420608",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "Traveler, could you please go help him out? Tormenting oneself is no way to spend a festival...",
            "nextDialogs": [
              "413420609"
            ]
          },
          "413420609": {
            "id": "413420609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll do it...",
            "nextDialogs": [
              "413420610"
            ]
          },
          "413420610": {
            "id": "413420610",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "*sigh* Sorry for troubling you.",
            "nextDialogs": [
              "413420611"
            ]
          },
          "413420611": {
            "id": "413420611",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "I bet he's onboard a ship right now, working away... Best you go find him quick.",
            "nextDialogs": [
              "413420612"
            ]
          },
          "413420612": {
            "id": "413420612",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "I'll be preparing some food in a bit. Come back here once you're done and we'll eat together."
          }
        }
      }
    },
    {
      "subId": "4134210",
      "subQuestName": "Talk to Wrench Wang",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413421001"
        ],
        "dialogs": {
          "413421001": {
            "id": "413421001",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "We've dallied so long, I'm sure we've fallen behind on work. Best we put our backs into it.",
            "nextDialogs": [
              "413421002"
            ]
          },
          "413421002": {
            "id": "413421002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Y—You sure you're alright?",
            "nextDialogs": [
              "413421003"
            ]
          },
          "413421003": {
            "id": "413421003",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Hey! What are you trying to say? I'm fine! Why wouldn't I be?",
            "nextDialogs": [
              "413421004"
            ]
          },
          "413421004": {
            "id": "413421004",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "I should get back to work now. Once I've finished... *sigh* Well, I'll see.",
            "nextDialogs": [
              "413421005"
            ]
          },
          "413421005": {
            "id": "413421005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Allow me to help.",
            "nextDialogs": [
              "413421006"
            ]
          },
          "413421006": {
            "id": "413421006",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Hmm? ...Well, if you really want to, you can bring me some wooden planks."
          }
        }
      }
    },
    {
      "subId": "4134211",
      "subQuestName": "Collect planks",
      "sceneId": null,
      "locations": [],

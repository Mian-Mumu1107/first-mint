    {
      "subId": "4134212",
      "subQuestName": "Report back to Wrench Wang",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413421201"
        ],
        "dialogs": {
          "413421201": {
            "id": "413421201",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Have you brought the planks?"
          }
        }
      }
    },
    {
      "subId": "4134202",
      "subQuestName": "Report back to Wrench Wang",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413421202"
        ],
        "dialogs": {
          "413421202": {
            "id": "413421202",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Mm, these should do the trick. Many thanks.",
            "nextDialogs": [
              "413421203"
            ]
          },
          "413421203": {
            "id": "413421203",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "There's still a few loose ends to tie up. Could I trouble you to go to the dock and take inventory of some newly arrived goods?",
            "nextDialogs": [
              "413421204"
            ]
          },
          "413421204": {
            "id": "413421204",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "There should be a total of three crates piled up at the dock.",
            "nextDialogs": [
              "413421205"
            ]
          },
          "413421205": {
            "id": "413421205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Leave it to me.",
            "nextDialogs": [
              "413421206"
            ]
          },
          "413421206": {
            "id": "413421206",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "You're a big help. In the meantime, I need to get a move on and finish up everything here..."
          }
        }
      }
    },
    {
      "subId": "4134207",
      "subQuestName": "Check the inventory",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4134213",
      "subQuestName": "Talk to Wrench Wang",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413421301"
        ],
        "dialogs": {
          "413421301": {
            "id": "413421301",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Have you tallied the numbers up?",
            "nextDialogs": [
              "413421302"
            ]
          },
          "413421302": {
            "id": "413421302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "All done.",
            "nextDialogs": [
              "413421303"
            ]
          },
          "413421303": {
            "id": "413421303",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Thank you very much!",
            "nextDialogs": [
              "413421304"
            ]
          },
          "413421304": {
            "id": "413421304",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Well then! That's today's urgent work dealt with.",
            "nextDialogs": [
              "413421305"
            ]
          },
          "413421305": {
            "id": "413421305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hammer Li says he's got some food prepped for you.",
            "nextDialogs": [
              "413421306"
            ]
          },
          "413421306": {
            "id": "413421306",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Huh? Does he, now? ...That guy worries too much.",
            "nextDialogs": [
              "413421307"
            ]
          },
          "413421307": {
            "id": "413421307",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Well, whatever. Since he's already gone to the trouble of making it, let's go and join him.",
            "nextDialogs": [
              "413421308"
            ]
          },
          "413421308": {
            "id": "413421308",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Besides, you helped me out a lot too, so some of that should go to you as compensation."
          }
        }
      }
    },
    {
      "subId": "4134209",
      "subQuestName": "Talk to Hammer Li",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413420901"
        ],
        "dialogs": {
          "413420901": {
            "id": "413420901",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "It's done. I hope I didn't keep you waiting.",
            "nextDialogs": [
              "413420902"
            ]
          },
          "413420902": {
            "id": "413420902",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "Oh, you've finished everything?",
            "nextDialogs": [
              "413420903"
            ]
          },
          "413420903": {
            "id": "413420903",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Aye. It was a small matter, and with this traveler helping, it was easy.",
            "nextDialogs": [
              "413420904"
            ]
          },
          "413420904": {
            "id": "413420904",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "You... *sigh*",
            "nextDialogs": [
              "413420905"
            ]
          },
          "413420905": {
            "id": "413420905",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Oh, come on. It's the festive season, no need for the long face.",
            "nextDialogs": [
              "413420906"
            ]
          },
          "413420906": {
            "id": "413420906",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "Yes, sure, whatever you say. Have you prepared a Xiao Lantern yet?",
            "nextDialogs": [
              "413420907"
            ]
          },
          "413420907": {
            "id": "413420907",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "A Xiao Lantern... Ugh, I forgot! What's with my memory today...",
            "nextDialogs": [
              "413420908"
            ]
          },
          "413420908": {
            "id": "413420908",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Ah well, never mind, eh? It's just a lantern. So what if we don't release one this time?",
            "nextDialogs": [
              "413420909"
            ]
          },
          "413420909": {
            "id": "413420909",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "Hah, don't you try that with me. You're not seriously suggesting that we celebrate the Lantern Rite without a lantern, now, are you?",
            "nextDialogs": [
              "413420910"
            ]
          },
          "413420910": {
            "id": "413420910",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "Traveler, could you make a lantern for my colleague ?",
            "nextDialogs": [
              "413420911"
            ]
          },
          "413420911": {
            "id": "413420911",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Leave it to me.",
            "nextDialogs": [
              "413420912"
            ]
          },
          "413420912": {
            "id": "413420912",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "Thank you very much. We'll be waiting for you here."
          }
        }
      }
    },
    {
      "subId": "4134215",
      "subQuestName": "Talk to Hammer Li",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413421501"
        ],
        "dialogs": {
          "413421501": {
            "id": "413421501",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "Did you bring the Xiao Lantern?",
            "nextDialogs": [
              "413421502"
            ]
          },
          "413421502": {
            "id": "413421502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it right here, sir."
          }
        }
      }
    },
    {
      "subId": "4134214",
      "subQuestName": "Talk to Wrench Wang",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413421401"
        ],
        "dialogs": {
          "413421401": {
            "id": "413421401",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "That will do. Thank you.",
            "nextDialogs": [
              "413421402"
            ]
          },
          "413421402": {
            "id": "413421402",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "You've really done a lot, Traveler, and during the festive period, too...",
            "nextDialogs": [
              "413421403"
            ]
          },
          "413421403": {
            "id": "413421403",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Well then, what should I wish for...",
            "nextDialogs": [
              "413421404"
            ]
          },
          "413421404": {
            "id": "413421404",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "Hmm, let's go with this: \"New year, new horizons!\"",
            "nextDialogs": [
              "413421407"
            ]
          },
          "413421407": {
            "id": "413421407",
            "speakerId": 2038,
            "speakerName": "Wrench Wang",
            "text": "You think so? Hahaha, that's good... Ah, I do wish that it would come true...",
            "nextDialogs": [
              "413421408"
            ]
          },
          "413421408": {
            "id": "413421408",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "*sigh*",
            "nextDialogs": [
              "413421409"
            ]
          },
          "413421409": {
            "id": "413421409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "413421410"
            ]
          },
          "413421410": {
            "id": "413421410",
            "speakerId": 2005,
            "speakerName": "Hammer Li",
            "text": "He made the same wish last year as well..."
          }
        }
      }
    },
    {
      "subId": "4134203",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413420301"
        ],
        "dialogs": {
          "413420301": {
            "id": "413420301",
            "speakerId": 2095,
            "speakerName": "Siyu",
            "text": "",

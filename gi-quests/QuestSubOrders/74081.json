    {
      "subId": "7408129",
      "subQuestName": "Talk to the researcher",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740812901"
        ],
        "dialogs": {
          "740812901": {
            "id": "740812901",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I almost thought Mr. Eastinghouse had come back, what with all the shaking and fighting noises... Turns out it was actually someone accidentally triggering the devices outside...",
            "nextDialogs": [
              "740812902"
            ]
          },
          "740812902": {
            "id": "740812902",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Oh no, Maillardet's prototypes... How did they end up like this?"
          }
        }
      }
    },
    {
      "subId": "7408117",
      "subQuestName": "Talk to the researcher",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740811701"
        ],
        "dialogs": {
          "740811701": {
            "id": "740811701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, did we... Did we just do something really bad?",
            "nextDialogs": [
              "740811702"
            ]
          },
          "740811702": {
            "id": "740811702",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "That's quite odd, I felt a vibration earlier...",
            "nextDialogs": [
              "740811705"
            ]
          },
          "740811705": {
            "id": "740811705",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, it could be because we messed with the device on the upper level...",
            "nextDialogs": [
              "740811706"
            ]
          },
          "740811706": {
            "id": "740811706",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "The door here was locked before, right? And there were even some clockwork meka specially guarding it..."
          }
        }
      }
    },
    {
      "subId": "7408120",
      "subQuestName": "",
      "sceneId": null,

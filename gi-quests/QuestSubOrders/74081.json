          "740810901"
        ],
        "dialogs": {
          "740810901": {
            "id": "740810901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's a room here too? How mysterious... Maybe we actually stumbled into some weirdo's secret lab!"
          }
        }
      }
    },
    {
      "subId": "7408111",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740811101"
        ],
        "dialogs": {
          "740811101": {
            "id": "740811101",
            "speakerId": 5223,
            "speakerName": "Sevigne",
            "text": "The punched tapes should be on the bookshelves inside, so look for them there. As for the other research materials...",
            "nextDialogs": [
              "740811102"
            ]
          },
          "740811102": {
            "id": "740811102",
            "speakerId": 5223,
            "speakerName": "Sevigne",
            "text": "It should be okay to look, right? Not like they're classified or anything..."
          }
        }
      }
    },
    {
      "subId": "7408106",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740810601"
        ],
        "dialogs": {
          "740810601": {
            "id": "740810601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The beam crosses over to the other side... Are those some sort of mechanisms over there? The large device in the middle doesn't seem to be reacting at all...",
            "nextDialogs": [
              "740810602"
            ]
          },
          "740810602": {
            "id": "740810602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Based on our previous experiences adventuring, as long as we turn on all the similar-looking mechanisms, something big should happen!"
          }
        }
      }
    },

    {
      "subId": "800000",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80000001"
        ],
        "dialogs": {
          "80000001": {
            "id": "80000001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What is this power...? Paimon's never seen it before...",
            "nextDialogs": [
              "80000002"
            ]
          },
          "80000002": {
            "id": "80000002",
            "speakerId": 1005,
            "speakerName": "Paimon",

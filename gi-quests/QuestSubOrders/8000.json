    {
      "subId": "800009",
      "subQuestName": "Negotiate with the Abyss Herald",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80000401"
        ],
        "dialogs": {
          "80000401": {
            "id": "80000401",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "You cannot spy on the secrets of the Abyss.",
            "nextDialogs": [
              "80000402"
            ]
          },
          "80000402": {
            "id": "80000402",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "You have come here, you have seen our secrets. For this, you must pay the price.",
            "nextDialogs": [
              "80000403"
            ]
          },
          "80000403": {
            "id": "80000403",
            "speakerId": 10916,
            "speakerName": "Abyss Herald",
            "text": "As a Herald, I will mete out your punishment.",
            "nextDialogs": [
              "80000404"
            ]
          },
          "80000404": {
            "id": "80000404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "An Abyss Herald!?",
            "nextDialogs": [
              "80000407"
            ]
          },
          "80000407": {
            "id": "80000407",
            "speakerId": 10916,
            "speakerName": "Abyss Herald",
            "text": "Dain... Dainsleif? Oh, I thought you were just a couple of pests that stumbled in here by mistake... So, you are with Dainsleif, that constant annoyance in our affairs...",
            "nextDialogs": [
              "80000408"
            ]
          },
          "80000408": {
            "id": "80000408",
            "speakerId": 10916,
            "speakerName": "Abyss Herald",
            "text": "Did he send you here to die? His resistance against the Abyss has gone nowhere for a long time. There is nothing you can do to change the tide...",
            "nextDialogs": [
              "80000409"
            ]
          },
          "80000409": {
            "id": "80000409",
            "speakerId": 10916,
            "speakerName": "Abyss Herald",
            "text": "The Abyss... is unstoppable!"
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "7451401",
      "subQuestName": "Talk to Asagiri",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745140101"
        ],
        "dialogs": {
          "745140101": {
            "id": "745140101",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "S—So cold... I definitely shouldn't have just gone out into the wind willy-nilly...",
            "nextDialogs": [
              "745140102"
            ]
          },
          "745140102": {
            "id": "745140102",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "#...Huh? {NICKNAME}! Paimon! It's yo—AH-CHOO!",
            "nextDialogs": [
              "745140103"
            ]
          },
          "745140103": {
            "id": "745140103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Asagiri? What're you doing here?",
            "nextDialogs": [
              "745140104"
            ]
          },
          "745140104": {
            "id": "745140104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are you okay? How'd you make it out this far all by yourself...",
            "nextDialogs": [
              "745140105"
            ]
          },
          "745140105": {
            "id": "745140105",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "I'm... well... fine! I'm much better now! See, I'm not even coughing anymore.",
            "nextDialogs": [
              "745140106"
            ]
          },
          "745140106": {
            "id": "745140106",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "Haha... ha...",
            "nextDialogs": [
              "745140109"
            ]
          },
          "745140109": {
            "id": "745140109",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "Whoa! No need! I admit it, I sneaked out on my own! Happy?",
            "nextDialogs": [
              "745140110"
            ]
          },
          "745140110": {
            "id": "745140110",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "I... I didn't have a choice. How could I possibly paint beautiful pictures if I just sat in Inazuma all the time?",
            "nextDialogs": [
              "745140111"
            ]
          },
          "745140111": {
            "id": "745140111",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "Even if I have you running around taking pictures for me, picture references can't compare to seeing things with your own eyes.",
            "nextDialogs": [
              "745140112"
            ]
          },
          "745140112": {
            "id": "745140112",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "So, I asked an author I worked with before to contact a merchant ship for me, and quietly hitched a ride with them so I could travel.",
            "nextDialogs": [
              "745140113"
            ]
          },
          "745140113": {
            "id": "745140113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And you even brought all your painting tools with you...",
            "nextDialogs": [
              "745140114"
            ]
          },
          "745140114": {
            "id": "745140114",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "But of course! The canvas is my very soul! How could I ever abandon any of them?",
            "nextDialogs": [
              "745140115"
            ]
          },
          "745140115": {
            "id": "745140115",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "Plus, my paintings are selling exceptionally well in Fontaine. A few Fontainian authors have even asked me to do the covers for their novels!",
            "nextDialogs": [
              "745140116"
            ]
          },
          "745140116": {
            "id": "745140116",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "Though... Apparently putting illustrations throughout novels isn't a thing for them! Truly strange...",
            "nextDialogs": [
              "745140117"
            ]
          },
          "745140117": {
            "id": "745140117",
            "speakerId": 30160,
            "speakerName": "Asagiri",
            "text": "#Oh, right... Since you happen to be here, {NICKNAME}... Would you mind helping me collect some reference materials?"
          }
        }
      }
    }
  ]
}
      "dialogue": {
        "startDialogs": [
          "756710101"
        ],
        "dialogs": {
          "756710101": {
            "id": "756710101",
            "speakerId": 1000,
            "speakerName": "Basima the Fifth",
            "text": "Chirp chirp! Coo coo! Chirp chirp chirp!",
            "nextDialogs": [
              "756710102"
            ]
          },
          "756710102": {
            "id": "756710102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um... what's going on here?",
            "nextDialogs": [
              "756710105"
            ]
          },
          "756710105": {
            "id": "756710105",
            "speakerId": 1000,
            "speakerName": "Basima the Fifth",
            "text": "Sort of! This is a technique I use to communicate with the cute little finches.",
            "nextDialogs": [
              "756710106"
            ]
          },
          "756710106": {
            "id": "756710106",
            "speakerId": 1000,
            "speakerName": "Basima the Fifth",
            "text": "Oh, I seem to have forgotten to say hello to you folks. And the all-important opening line.",
            "nextDialogs": [
              "756710107"
            ]
          },
          "756710107": {
            "id": "756710107",
            "speakerId": 1000,
            "speakerName": "Basima the Fifth",
            "text": "Kind Travelers passing through, I, Basima the Fifth, Amurta researcher, rising mercantile star, and expert on adorable animals, offer my heartfelt greetings.",
            "nextDialogs": [
              "756710108"
            ]
          },
          "756710108": {
            "id": "756710108",
            "speakerId": 1000,
            "speakerName": "Basima the Fifth",
            "text": "Please. Relax thy body, clear thy mind, and listen closely, for I have a matter of utmost importance to share with you—",
            "nextDialogs": [
              "756710109"
            ]
          },
          "756710109": {
            "id": "756710109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"Finches are the cutest\"...?",
            "nextDialogs": [
              "756710110"
            ]
          },
          "756710110": {
            "id": "756710110",
            "speakerId": 1000,
            "speakerName": "Basima the Fifth",
            "text": "You're absolutely correct! Congratulations, looks like the Finch's cuteness got to you too. You're even jumping to answer right away!",
            "nextDialogs": [
              "756710111"
            ]
          },
          "756710111": {
            "id": "756710111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This is odd. Paimon's not sure why, but when she saw the game on the table, this line just popped into her head.",
            "nextDialogs": [
              "756710112"
            ]
          },
          "756710112": {
            "id": "756710112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Does this feel familiar to you too, {NICKNAME}?"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2006601",
      "subQuestName": "Talk to Ellin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200660101"
        ],
        "dialogs": {
          "200660101": {
            "id": "200660101",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Ugh, what a headache... What am I supposed to do about this?",
            "nextDialogs": [
              "200660102"
            ]
          },
          "200660102": {
            "id": "200660102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you up to?",
            "nextDialogs": [
              "200660103"
            ]
          },
          "200660103": {
            "id": "200660103",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Practicing for the Knights of Favonius' tryouts!",
            "nextDialogs": [
              "200660104"
            ]
          },
          "200660104": {
            "id": "200660104",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "*sigh* But I'm nowhere near as powerful as Jean.",
            "nextDialogs": [
              "200660105"
            ]
          },
          "200660105": {
            "id": "200660105",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "I think it's better for me to focus on technique rather than power.",
            "nextDialogs": [
              "200660106"
            ]
          },
          "200660106": {
            "id": "200660106",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "For example, I was thinking about how to break all these wooden dummies in one fell swoop... I know they don't look that robust, but they're what I've got. My father went to a lot of trouble to get them for me, so I shouldn't complain.",
            "nextDialogs": [
              "200660107"
            ]
          },
          "200660107": {
            "id": "200660107",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "If you're at a loose end, fancy helping me think about how to tackle it?",
            "nextDialogs": [
              "200660110",
              "200660112"
            ]
          },
          "200660110": {
            "id": "200660110",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Sure, take your time. It's not like these dummies are going anywhere.",
            "nextDialogs": [
              "200660111"
            ]
          },
          "200660111": {
            "id": "200660111",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Nor is my life going anywhere while I'm stuck trying to sort this out, ugh...",
            "nextDialogs": [
              "200660114"
            ]
          },
          "200660114": {
            "id": "200660114",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "At this distance, maybe the best solution would be for me to deal with one side and drop a bomb to deal with the other side.",
            "nextDialogs": [
              "200660115"
            ]
          },
          "200660115": {
            "id": "200660115",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Haha, just kidding. I have no idea where I would even get a bomb from anyway."
          },
          "200660112": {
            "id": "200660112",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "You like team combat, then? Alright for some... always someone to help you out.",
            "nextDialogs": [
              "200660113"
            ]
          },
          "200660113": {
            "id": "200660113",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "For people like me, the best I can do is try and hold my own as a lone fighter."
          }
        }
      }
    },
    {
      "subId": "2006602",
      "subQuestName": "Destroy all the training dummies in under 2 seconds",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200660201"
        ],
        "dialogs": {
          "200660201": {
            "id": "200660201",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "How are you getting along? Had a eureka moment yet?",
            "nextDialogs": [
              "200660202"
            ]
          },
          "200660202": {
            "id": "200660202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Still thinking it over...",
            "nextDialogs": [
              "200660203"
            ]
          },
          "200660203": {
            "id": "200660203",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Huh. I've met a few other Adventurers before. They were the same way.",
            "nextDialogs": [
              "200660204"
            ]
          },
          "200660204": {
            "id": "200660204",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "They fight monsters like pros, but they're hopelessly lost when it comes to trying to break a few wooden sticks.",
            "nextDialogs": [
              "200660205"
            ]
          },
          "200660205": {
            "id": "200660205",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "And they reinforce the wood like it's for building a storm shelter or something... Way overestimating their own strength.",
            "nextDialogs": [
              "200660206"
            ]
          },
          "200660206": {
            "id": "200660206",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "If they want a challenge so desperately, why don't they just go off into the wilderness and pick a fight with the biggest monster they can find?"
          }
        }
      }
    },
    {
      "subId": "2006603",
      "subQuestName": "Talk to Ellin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200660301"
        ],
        "dialogs": {
          "200660301": {
            "id": "200660301",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Nailed it!",
            "nextDialogs": [
              "200660302"
            ]
          },
          "200660302": {
            "id": "200660302",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Huh, I never even thought of trying that...",
            "nextDialogs": [
              "200660303"
            ]
          },
          "200660303": {
            "id": "200660303",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Thanks! I'm gonna try it myself now."
          }
        }
      }
    }
  ]
}
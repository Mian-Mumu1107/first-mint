  "subQuests": [
    {
      "subId": "4117001",
      "subQuestName": "Speak to Hughes",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411700101"
        ],
        "dialogs": {
          "411700101": {
            "id": "411700101",
            "speakerId": 1000,
            "speakerName": "Hughes",
            "text": "Yes... Yes! This place is good. It's a good spot for takeoff!",
            "nextDialogs": [
              "411700102"
            ]
          },
          "411700102": {
            "id": "411700102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Takeoff from where?",
            "nextDialogs": [
              "411700103"
            ]
          },
          "411700103": {
            "id": "411700103",
            "speakerId": 1000,
            "speakerName": "Hughes",
            "text": "From a suitable location, of course? Oh, hello, Traveler. Nice to meet you. I'm Hughes, an adventurer.",
            "nextDialogs": [
              "411700104"
            ]
          },
          "411700104": {
            "id": "411700104",
            "speakerId": 1000,
            "speakerName": "Hughes",
            "text": "Well, I say that... But I've honestly spent more time researching ways to use my wind glider than I have at the Guild.",
            "nextDialogs": [
              "411700105"
            ]
          },
          "411700105": {
            "id": "411700105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ways to use your wind glider?",
            "nextDialogs": [
              "411700106"
            ]
          },
          "411700106": {
            "id": "411700106",
            "speakerId": 1000,
            "speakerName": "Hughes",
            "text": "Indeed. It's a real science, it is.",
            "nextDialogs": [
              "411700107"
            ]
          },
          "411700107": {
            "id": "411700107",
            "speakerId": 1000,
            "speakerName": "Hughes",
            "text": "Some who put on a wind glider can soar with the birds, but others... well, they don't get very far.",
            "nextDialogs": [
              "411700108"
            ]
          },
          "411700108": {
            "id": "411700108",
            "speakerId": 1000,
            "speakerName": "Hughes",
            "text": "Ultimately, it has to do with individual differences in one's grasp on various gliding techniques.",
            "nextDialogs": [
              "411700109"
            ]
          },
          "411700109": {
            "id": "411700109",
            "speakerId": 1000,
            "speakerName": "Hughes",
            "text": "The best way to refine one's technique, to whit, is via practical drills.",
            "nextDialogs": [
              "411700110"
            ]
          },
          "411700110": {
            "id": "411700110",
            "speakerId": 1000,
            "speakerName": "Hughes",
            "text": "Traveler, you have a wind glider too, right? I've just discovered a most excellent spot from which one can utilize wind gliders...",
            "nextDialogs": [
              "411700111"
            ]
          },
          "411700111": {
            "id": "411700111",
            "speakerId": 1000,
            "speakerName": "Hughes",
            "text": "So how about it? How would you like to spread your wings and soar?",
            "nextDialogs": [
              "411700113",
              "411700115"
            ]
          },
          "411700113": {
            "id": "411700113",
            "speakerId": 1000,
            "speakerName": "Hughes",
            "text": "Great! Just let me mark it on your map..."
          },
          "411700115": {
            "id": "411700115",
            "speakerId": 1000,
            "speakerName": "Hughes",
            "text": "Sure, go finish what you have to first."
          }
        }
      }
    }
  ]
}
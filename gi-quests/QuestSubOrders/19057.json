    {
      "subId": "1905707",
      "subQuestName": "Talk to Kano Nana",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190570701"
        ],
        "dialogs": {
          "190570701": {
            "id": "190570701",
            "speakerId": 1000,
            "speakerName": "Etsu",
            "text": "I apologize for earlier, I don't know what came over me.",
            "nextDialogs": [
              "190570702"
            ]
          },
          "190570702": {
            "id": "190570702",
            "speakerId": 1000,
            "speakerName": "Etsu",
            "text": "Oh, Detective Heizou? He can't stand people like me, I'm sure of it.",
            "nextDialogs": [
              "190570703"
            ]
          },
          "190570703": {
            "id": "190570703",
            "speakerId": 1000,
            "speakerName": "Etsu",
            "text": "Although he sounds polite and friendly, I can tell that he treats inmates convicted of fraud differently... He's really got something against us.",
            "nextDialogs": [
              "190570704"
            ]
          },
          "190570704": {
            "id": "190570704",
            "speakerId": 1000,
            "speakerName": "Etsu",
            "text": "Do you think he may have been defrauded himself before? Impossible, who could ever be cunning enough to fool Detective Heizou like that, hmm?"
          }
        }
      }
    },
    {

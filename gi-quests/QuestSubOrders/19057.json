    {
      "subId": "1905709",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190570901"
        ],
        "dialogs": {
          "190570901": {
            "id": "190570901",
            "speakerId": 1002,
            "speakerName": "Iba",
            "text": "Getting on the wrong side of Heizou really was a mistake...",
            "nextDialogs": [
              "190570902"
            ]
          },
          "190570902": {
            "id": "190570902",
            "speakerId": 1002,
            "speakerName": "Iba",
            "text": "Eh? You two want to know what happened? There's not much to it, really.",
            "nextDialogs": [
              "190570903"
            ]
          },
          "190570903": {
            "id": "190570903",
            "speakerId": 1002,
            "speakerName": "Iba",
            "text": "As soon as I heard that Heizou was on the case, I knew it was over. I took the easy way out and confessed to everything. After all, what else can you do when a \"Cyclone\" is heading your way?",
            "nextDialogs": [
              "190570904"
            ]
          },
          "190570904": {
            "id": "190570904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Cyclone\"?",
            "nextDialogs": [
              "190570905"
            ]
          },
          "190570905": {
            "id": "190570905",
            "speakerId": 1002,
            "speakerName": "Iba",
            "text": "Heizou's nickname. It's what all the prisoners call him, haven't you heard it before?",
            "nextDialogs": [
              "190570906"
            ]
          },
          "190570906": {
            "id": "190570906",
            "speakerId": 1002,
            "speakerName": "Iba",
            "text": "There's nowhere to run, nowhere to hide... For criminals, Heizou is a force of nature nobody can contend with.",
            "nextDialogs": [
              "190570907"
            ]
          },
          "190570907": {
            "id": "190570907",
            "speakerId": 1002,
            "speakerName": "Iba",
            "text": "Alas, if only I'd known..."
          }
        }
      }
    }
  ]

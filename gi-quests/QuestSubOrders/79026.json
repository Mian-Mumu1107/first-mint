  "subQuests": [
    {
      "subId": "7902601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790260101"
        ],
        "dialogs": {
          "790260101": {
            "id": "790260101",
            "speakerId": 1000,
            "speakerName": "Twilight Theater Head",
            "text": "Welcome! Welcome!",
            "nextDialogs": [
              "790260102"
            ]
          },
          "790260102": {
            "id": "790260102",
            "speakerId": 1000,
            "speakerName": "Twilight Theater Head",
            "text": "Welcome!",
            "nextDialogs": [
              "790260104"
            ]
          },
          "790260104": {
            "id": "790260104",
            "speakerId": 1000,
            "speakerName": "Twilight Theater Head",
            "text": "#You must be the world-famous {NICKNAME}! And this must be the Traveler's best companion, Paimon!",
            "nextDialogs": [
              "790260105"
            ]
          },
          "790260105": {
            "id": "790260105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow! How did you know our names?",
            "nextDialogs": [
              "790260106"
            ]
          },
          "790260106": {
            "id": "790260106",
            "speakerId": 1000,
            "speakerName": "Twilight Theater Head",
            "text": "You are the island's most distinguished guests, of course I know who you are! After all, I am...",
            "nextDialogs": [
              "790260107"
            ]
          },
          "790260107": {
            "id": "790260107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You are...?",
            "nextDialogs": [
              "790260108"
            ]
          },
          "790260108": {
            "id": "790260108",
            "speakerId": 1000,
            "speakerName": "Twilight Theater Head",
            "text": "I am the world-famous Head of Twilight Theater!",
            "nextDialogs": [
              "790260109"
            ]
          },
          "790260109": {
            "id": "790260109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I can't believe someone would call himself world-famous.",
            "nextDialogs": [
              "790260110"
            ]
          },
          "790260110": {
            "id": "790260110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You say you're world-famous, but we've never heard of you.",
            "nextDialogs": [
              "790260111"
            ]
          },
          "790260111": {
            "id": "790260111",
            "speakerId": 1000,
            "speakerName": "Twilight Theater Head",
            "text": "It's fine! Now you have!",
            "nextDialogs": [
              "790260112"
            ]
          },
          "790260112": {
            "id": "790260112",
            "speakerId": 1000,
            "speakerName": "Twilight Theater Head",
            "text": "After a painstaking amount of work, our play, \"Tale of the Sword-Wielding Princess,\" is finally ready for the stage!",
            "nextDialogs": [
              "790260113"
            ]
          },
          "790260113": {
            "id": "790260113",
            "speakerId": 1000,
            "speakerName": "Twilight Theater Head",
            "text": "There are five acts in this play, each with two scenes...",
            "nextDialogs": [
              "790260114"
            ]
          },
          "790260114": {
            "id": "790260114",
            "speakerId": 1000,
            "speakerName": "Twilight Theater Head",
            "text": "My distinguished guests, you have come at the perfect time! The show is about to start! Please take a seat!",
            "nextDialogs": [
              "790260115"
            ]
          },
          "790260115": {
            "id": "790260115",
            "speakerId": 1000,
            "speakerName": "Twilight Theater Head",
            "text": "I still need to take care of something backstage. Please excuse me.",
            "nextDialogs": [
              "790260116"
            ]
          },
          "790260116": {
            "id": "790260116",
            "speakerId": 1000,
            "speakerName": "Twilight Theater Head",
            "text": "You are about to witness the debut of Twilight Theater's best ever play! Please sit back and enjoy!"
          }
        }
      }
    },

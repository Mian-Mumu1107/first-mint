            ]
          },
          "3720103": {
            "id": "3720103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Dvalin? Who's that?",
            "nextDialogs": [
              "3720106"
            ]
          },
          "3720106": {
            "id": "3720106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? ...Oh, right. Most people seem to call him \"Stormterror.\"",
            "nextDialogs": [
              "3720107"
            ]
          },
          "3720107": {
            "id": "3720107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why do you call him that... are you two meant to be close or something?",
            "nextDialogs": [
              "3720108"
            ]
          },
          "3720108": {
            "id": "3720108",
            "speakerId": 1160,
            "speakerName": "Green Fellow",
            "text": "Oh, so close...",
            "nextDialogs": [
              "3720109"
            ]
          },
          "3720109": {
            "id": "3720109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hey, {NICKNAME}. Paimon thinks this guy has a screw loose..."
          }
        }
      }
    },
    {

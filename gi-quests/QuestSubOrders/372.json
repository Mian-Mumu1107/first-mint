    {
      "subId": "37205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3720501"
        ],
        "dialogs": {
          "3720501": {
            "id": "3720501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ehhhh!?",
            "nextDialogs": [
              "3720502"
            ]
          },
          "3720502": {
            "id": "3720502",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "You... really do have some wonderful abilities...",
            "nextDialogs": [
              "3720503"
            ]
          },
          "3720503": {
            "id": "3720503",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Someone like you is going to end up getting written into a bard's poem.",
            "nextDialogs": [
              "3720504"
            ]
          },
          "3720504": {
            "id": "3720504",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "#Oh, a hero so bright, should {M#he}{F#she} stand in the light. Though stand in the shade, and you'll be met by a blade...",
            "nextDialogs": [
              "3720505"
            ]
          },
          "3720505": {
            "id": "3720505",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Alas... I've really not the time to compose a melody for you at this moment.",
            "nextDialogs": [
              "3720506"
            ]
          },
          "3720506": {
            "id": "3720506",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Anyway, even if Dvalin is not taken down, his life will still wither away in the breeze...",
            "nextDialogs": [
              "3720507"
            ]
          },
          "3720507": {
            "id": "3720507",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "He'll burn himself out in the flames of anger...",
            "nextDialogs": [
              "3720509",
              "3720512",
              "3720515"
            ]
          },
          "3720509": {
            "id": "3720509",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Thank you for that, and you for purifying the Teardrop Crystal.",
            "nextDialogs": [
              "3720510"
            ]
          },
          "3720510": {
            "id": "3720510",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "But I have my own plans for what is to follow.",
            "nextDialogs": [
              "3720517"
            ]
          },
          "3720517": {
            "id": "3720517",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh? And what plan would that be?",
            "nextDialogs": [
              "3720518"
            ]
          },
          "3720518": {
            "id": "3720518",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Seeing this tear has brought to mind a friend so dear.",
            "nextDialogs": [
              "3720519"
            ]
          },
          "3720519": {
            "id": "3720519",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Friend?",
            "nextDialogs": [
              "3720520"
            ]
          },
          "3720520": {
            "id": "3720520",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Heh-heh, one must be going.",
            "nextDialogs": [
              "3720521"
            ]
          },
          "3720521": {
            "id": "3720521",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Where're you running off to!?",
            "nextDialogs": [
              "3720522"
            ]
          },
          "3720522": {
            "id": "3720522",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "To the \"Symbol of Mondstadt's Hero.\" Bye-bye~",
            "nextDialogs": [
              "3720523"
            ]
          },
          "3720523": {
            "id": "3720523",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Huh... {NICKNAME}, what do you make of that?",
            "nextDialogs": [
              "3720524"
            ]
          },
          "3720524": {
            "id": "3720524",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This \"weirdo\" as you put it — we need to keep an eye on him...",
            "nextDialogs": [
              "3720525"
            ]
          },
          "3720525": {
            "id": "3720525",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "As far as he's concerned, you're a weirdo too ya know...",
            "nextDialogs": [
              "3720526"
            ]
          },
          "3720526": {
            "id": "3720526",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You know...",
            "nextDialogs": [
              "3720527"
            ]
          },
          "3720527": {
            "id": "3720527",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Know what?",
            "nextDialogs": [
              "3720528"
            ]
          },
          "3720528": {
            "id": "3720528",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "His voice seems familiar..."
          },
          "3720512": {
            "id": "3720512",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "I really must thank you for purifying the Teardrop Crystal, it has helped me greatly.",
            "nextDialogs": [
              "3720513"
            ]
          },
          "3720513": {
            "id": "3720513",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "But I've already come to devise my own plan."
          },
          "3720515": {
            "id": "3720515",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Do you really deem that necessary?",
            "nextDialogs": [
              "3720516"
            ]
          },
          "3720516": {
            "id": "3720516",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "You can forget about me turning us in for now... I have another plan."
          }
        }
      }
    }
  ]

    {
      "subId": "7507113",
      "subQuestName": "Talk to Magnifico",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750711321"
        ],
        "dialogs": {
          "750711321": {
            "id": "750711321",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You defeat the enemy and smash open the cage imprisoning the little Sumpter Beast. It leaps out of the cage and sends a happy cry your way.",
            "nextDialogs": [
              "750711301"
            ]
          },
          "750711301": {
            "id": "750711301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow... Phew! Well, that's over. What a rush!",
            "nextDialogs": [
              "750711302"
            ]
          },
          "750711302": {
            "id": "750711302",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Shh—! Look...",
            "nextDialogs": [
              "750711303"
            ]
          },
          "750711303": {
            "id": "750711303",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "*click*",
            "nextDialogs": [
              "750711304"
            ]
          },
          "750711304": {
            "id": "750711304",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Perfect.",
            "nextDialogs": [
              "750711305"
            ]
          },
          "750711305": {
            "id": "750711305",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa, they're getting along so well... And here Paimon thought that the Sumpter Beast might get eaten... or something.",
            "nextDialogs": [
              "750711306"
            ]
          },
          "750711306": {
            "id": "750711306",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Hehe, now, now. Tepetlisaurs might look fierce, but they're actually gentle souls.",
            "nextDialogs": [
              "750711307"
            ]
          },
          "750711307": {
            "id": "750711307",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Well, that's the photo taken, and here's your copy. Ah, yes, and your payment... here.",
            "nextDialogs": [
              "750711308"
            ]
          },
          "750711308": {
            "id": "750711308",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "*sigh* Here I thought we might capture an intimate moment between a Tepetlisaur whelp and an adult — but it seems the Sumpter Beast was one step ahead!",
            "nextDialogs": [
              "750711309"
            ]
          },
          "750711309": {
            "id": "750711309",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe, c'mon, Sumpter Beasts aren't that annoying. Paimon's sure you think so too!",
            "nextDialogs": [
              "750711310"
            ]
          },
          "750711310": {
            "id": "750711310",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Well, it doesn't matter what I think — it's the photography judging committee's opinion that counts!",
            "nextDialogs": [
              "750711311"
            ]
          },
          "750711311": {
            "id": "750711311",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Still... It might be too dangerous for our lil' Sumpter Beast to wander about in Natlan's unfamiliar environs. And I happen to need a partner to help carry some things...",
            "nextDialogs": [
              "750711312"
            ]
          },
          "750711312": {
            "id": "750711312",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Why, I suppose I'll just have to take it in.",
            "nextDialogs": [
              "750711313"
            ]
          },
          "750711313": {
            "id": "750711313",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What about its original owner, then...?",
            "nextDialogs": [
              "750711314"
            ]
          },
          "750711314": {
            "id": "750711314",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Hmph. His own fault for leaving the little beastie out here in such a dangerous spot!",
            "nextDialogs": [
              "750711317"
            ]
          },
          "750711317": {
            "id": "750711317",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "But anyway, enough of that! Fontaine's photo galleries, here I come! Haha... I trust you'll visit when the time comes as well, alright?",
            "nextDialogs": [
              "750711318"
            ]
          },
          "750711318": {
            "id": "750711318",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "#My apologies, but I must leave this nation now. Farewell, {NICKNAME}, Paimon! Farewell, my little fellow!",
            "nextDialogs": [
              "750711319"
            ]
          },
          "750711319": {
            "id": "750711319",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750711320"
            ]
          },
          "750711320": {
            "id": "750711320",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Also... catch! A memento, so you don't forget me, little ones!"
          }
        }
      }
    },

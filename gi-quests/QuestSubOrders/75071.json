  "subQuests": [
    {
      "subId": "7507110",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750711001"
        ],
        "dialogs": {
          "750711001": {
            "id": "750711001",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "#Haha, my dear {NICKNAME} and Paimon, my muse and my... Err, mini-muse!",
            "nextDialogs": [
              "750711002"
            ]
          },
          "750711002": {
            "id": "750711002",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "#Ah yes, and {REALNAME[ID(2)|SHOWHOST(true)]}, of course!",
            "nextDialogs": [
              "750711003"
            ]
          },
          "750711003": {
            "id": "750711003",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hah! Who's the mini-me here, anyway?",
            "nextDialogs": [
              "750711004"
            ]
          },
          "750711004": {
            "id": "750711004",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Raaawr!",
            "nextDialogs": [
              "750711005"
            ]
          },
          "750711005": {
            "id": "750711005",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Haha, come now, don't mind me.",
            "nextDialogs": [
              "750711006"
            ]
          },
          "750711006": {
            "id": "750711006",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmph, Paimon minds a lot!",
            "nextDialogs": [
              "750711008",
              "750711012"
            ]
          },
          "750711008": {
            "id": "750711008",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Of course! However... Hehe, new inspiration means... that I'll need your help once more.",
            "nextDialogs": [
              "750711009"
            ]
          },
          "750711009": {
            "id": "750711009",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "No problem! You pay every time, anyway.",
            "nextDialogs": [
              "750711010"
            ]
          },
          "750711010": {
            "id": "750711010",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Haha, wonderful, my little mercenary!",
            "nextDialogs": [
              "750711017"
            ]
          },
          "750711017": {
            "id": "750711017",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "You see, I'm taking a photo of a Tepetlisaurus this time... Shh. Careful now, we don't want to disturb it.",
            "nextDialogs": [
              "750711018"
            ]
          },
          "750711018": {
            "id": "750711018",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "This is my first time interacting with such a Saurian, but I've been observing them for a while now... Truly fascinating creatures they are, each with unique personalities beneath their hardened shells.",
            "nextDialogs": [
              "750711019"
            ]
          },
          "750711019": {
            "id": "750711019",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Hehe, this one's learned some basic commands after being fed a few times, to boot.",
            "nextDialogs": [
              "750711020"
            ]
          },
          "750711020": {
            "id": "750711020",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Still, I'm going to need your help, dear Saurian tamers, to bring the wayward Saurian with us and take a photo of it interacting with its fellow Tepetlisaurs.",
            "nextDialogs": [
              "750711021"
            ]
          },
          "750711021": {
            "id": "750711021",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Hehe, a simple task, eh?",
            "nextDialogs": [
              "750711022"
            ]
          },
          "750711022": {
            "id": "750711022",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yup, super easy!"
          },
          "750711012": {
            "id": "750711012",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Mousse... Heh, Paimon's feeling hungry already...",
            "nextDialogs": [
              "750711013"
            ]
          },
          "750711013": {
            "id": "750711013",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Groo... Groo...",
            "nextDialogs": [
              "750711014"
            ]
          },
          "750711014": {
            "id": "750711014",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Uh, you mean \"muses,\" don't you? Those aren't for eating!",
            "nextDialogs": [
              "750711015"
            ]
          },
          "750711015": {
            "id": "750711015",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, so long as you're paying, that Mora will soon become food!",
            "nextDialogs": [
              "750711016"
            ]
          },
          "750711016": {
            "id": "750711016",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Whatever you say, Paimon... But I do indeed have money, so you shan't have to worry about working for free!"
          }
        }
      }
    },
    {
      "subId": "7507116",
      "subQuestName": "Indwell the Tepetlisaurus and then talk to Magnifico",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750711901"
        ],
        "dialogs": {
          "750711901": {
            "id": "750711901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Here comes the Tepetlisaurus! Let's start taking pictures, shall we?",
            "nextDialogs": [
              "750711902"
            ]
          },
          "750711902": {
            "id": "750711902",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Capital idea!"
          }
        }
      }
    },
    {
      "subId": "7507114",
      "subQuestName": "Assist with Magnifico's shoot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7507111",
      "subQuestName": "Talk to Magnifico",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750711101"
        ],
        "dialogs": {
          "750711101": {
            "id": "750711101",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "Have you noticed? Our little fellow seems to have taken note of something... Family, perhaps?",
            "nextDialogs": [
              "750711102"
            ]
          },
          "750711102": {
            "id": "750711102",
            "speakerId": 1000,
            "speakerName": "Magnifico",
            "text": "It's heading over on its own! Come now, let's follow — we can't afford to lose it!"
          }
        }
      }
    },
    {
      "subId": "7507115",

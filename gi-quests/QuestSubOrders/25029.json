    {
      "subId": "2502904",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250290401"
        ],
        "dialogs": {
          "250290401": {
            "id": "250290401",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Wow, you're awesome! I couldn't catch what you were doing at all — you've got to be even faster than Mayta, I bet!",
            "nextDialogs": [
              "250290405",
              "250290404"
            ]
          },
          "250290405": {
            "id": "250290405",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "I don't think Qica will be able to match your time, though... It's way too fast...",
            "nextDialogs": [
              "250290406"
            ]
          },
          "250290406": {
            "id": "250290406",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Hrroo, roooh...",
            "nextDialogs": [
              "250290407"
            ]
          },
          "250290407": {
            "id": "250290407",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Guess I'll go show Mayta your climbing time. Maybe he can come up with a more... reasonable training plan for us?",
            "nextDialogs": [
              "250290408"
            ]
          },
          "250290408": {
            "id": "250290408",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Anyway, thanks a lot for your help. Here, have these Cacahuatls!",
            "nextDialogs": [
              "250290409"
            ]
          },
          "250290409": {
            "id": "250290409",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "We picked them ourselves, so they're super fresh, and they'll make super tasty chocolate!",
            "nextDialogs": [
              "250290410"
            ]
          },
          "250290410": {
            "id": "250290410",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Orrooo, orrooo!",
            "nextDialogs": [
              "250290411"
            ]
          },
          "250290411": {
            "id": "250290411",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "In that case, we'll head out now. I wonder if Mayta's back at the settlement. He hasn't gone out climbing again, has he..."
          },
          "250290404": {
            "id": "250290404",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "He's a friend of mine who's real good at mountain climbing. Apart from Big Sis Roca, almost no one's his match."
          }
        }
      }
    },
    {
      "subId": "2502905",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

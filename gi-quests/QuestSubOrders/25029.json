        ],
        "dialogs": {
          "250290501": {
            "id": "250290501",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Hehe. We're in your capable hands, then! We'll be keeping time for you from here.",
            "nextDialogs": [
              "250290502"
            ]
          },
          "250290502": {
            "id": "250290502",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Rawr, Rrooh? Hrroo..."
          }
        }
      }
    },
    {
      "subId": "2502907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

  "subQuests": [
    {
      "subId": "2502901",
      "subQuestName": "Talk to Tlatem",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250290101"
        ],
        "dialogs": {
          "250290101": {
            "id": "250290101",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Come on, don't be discouraged. You just need to get well, and... keep trying! You'll make it to the mountaintop in no time!",
            "nextDialogs": [
              "250290102"
            ]
          },
          "250290102": {
            "id": "250290102",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Grooo... Groooo...",
            "nextDialogs": [
              "250290103"
            ]
          },
          "250290103": {
            "id": "250290103",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Are you hungry? Hmm... Then why don't I get you something to eat?",
            "nextDialogs": [
              "250290104"
            ]
          },
          "250290104": {
            "id": "250290104",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Hroo... Oroo...",
            "nextDialogs": [
              "250290105"
            ]
          },
          "250290105": {
            "id": "250290105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you up to?",
            "nextDialogs": [
              "250290106"
            ]
          },
          "250290106": {
            "id": "250290106",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "I'm playing with my buddy Qica. He's still small, but Mom says he'll be the equal of any other Yumkasaurus when he grows up!",
            "nextDialogs": [
              "250290107"
            ]
          },
          "250290107": {
            "id": "250290107",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Hroo... Rroooh...",
            "nextDialogs": [
              "250290108"
            ]
          },
          "250290108": {
            "id": "250290108",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Don't be sad. Your body's just too frail at the moment, and you were injured previously to boot.",
            "nextDialogs": [
              "250290109"
            ]
          },
          "250290109": {
            "id": "250290109",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Mom says you'll get better for sure. You've just gotta eat well and train with me.",
            "nextDialogs": [
              "250290110"
            ]
          },
          "250290110": {
            "id": "250290110",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Rooh? Rrrooh...",
            "nextDialogs": [
              "250290112",
              "250290114"
            ]
          },
          "250290112": {
            "id": "250290112",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Grooo... Groooo...",
            "nextDialogs": [
              "250290119"
            ]
          },
          "250290119": {
            "id": "250290119",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Haha. Well, would you look at the time? We've got training coming up soon, so let's get eating!",
            "nextDialogs": [
              "250290120"
            ]
          },
          "250290120": {
            "id": "250290120",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Mom made these dried fruits, you know! Fried them in a big pot before adding lots of nice-smelling condiments...",
            "nextDialogs": [
              "250290121"
            ]
          },
          "250290121": {
            "id": "250290121",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Right, and she sprinkled in lots of sugar and petals, too... Either way, it tastes great! Just a moment, I'll give you some...",
            "nextDialogs": [
              "250290122"
            ]
          },
          "250290122": {
            "id": "250290122",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Wait. Where'd my dried fruits go? I'm sure I put them in my bag...",
            "nextDialogs": [
              "250290123"
            ]
          },
          "250290123": {
            "id": "250290123",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "...Hroo, rrooo...",
            "nextDialogs": [
              "250290124"
            ]
          },
          "250290124": {
            "id": "250290124",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Whoa! Qica! Did you eat it all? C'mon, I've told you not to get greedy... You're gonna have trouble moving around if you eat too much!",
            "nextDialogs": [
              "250290125"
            ]
          },
          "250290125": {
            "id": "250290125",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "...Rrooh, oroo..."
          },
          "250290114": {
            "id": "250290114",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "I don't know... but maybe Mom does! Qica was already ill when she brought him in.",
            "nextDialogs": [
              "250290115"
            ]
          },
          "250290115": {
            "id": "250290115",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "He couldn't eat and didn't even have the strength to move. All I could do was dissolve some medicine in water and have him drink it every day.",
            "nextDialogs": [
              "250290116"
            ]
          },
          "250290116": {
            "id": "250290116",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "He recovered in the end, but... his body is still really weak, so he can't scamper all over the cliffsides like the other Yumkasaurs.",
            "nextDialogs": [
              "250290117"
            ]
          },
          "250290117": {
            "id": "250290117",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "That's really upsetting for him, so I'm trying to help him get back into tip-top shape... stronger than any other Yumkasaurus!",
            "nextDialogs": [
              "250290118"
            ]
          },
          "250290118": {
            "id": "250290118",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Roar!"
          }
        }
      }
    },
    {
      "subId": "2502902",
      "subQuestName": "Climb to the top of the mountain",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250290201"
        ],
        "dialogs": {
          "250290201": {
            "id": "250290201",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Good boy, good boy! Eaten your fill today? Ready to train?",
            "nextDialogs": [
              "250290202"
            ]
          },
          "250290202": {
            "id": "250290202",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Raar, oroo, rrooh!",
            "nextDialogs": [
              "250290203"
            ]
          },
          "250290203": {
            "id": "250290203",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Pretty energetic today, aren't we? Awesome! Let's do this!",
            "nextDialogs": [
              "250290204"
            ]
          },
          "250290204": {
            "id": "250290204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yeah, let's do this!",
            "nextDialogs": [
              "250290206"
            ]
          },
          "250290206": {
            "id": "250290206",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Huh? Oh, hello there! We're doing some more mountain climbing training right now.",
            "nextDialogs": [
              "250290207"
            ]
          },
          "250290207": {
            "id": "250290207",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Rroo! Wrroo!",
            "nextDialogs": [
              "250290208"
            ]
          },
          "250290208": {
            "id": "250290208",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Wrooo, rrooh...",
            "nextDialogs": [
              "250290210",
              "250290213"
            ]
          },
          "250290210": {
            "id": "250290210",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Well... we're \"making progress.\" Qica's made it up a lot further this time.",
            "nextDialogs": [
              "250290211"
            ]
          },
          "250290211": {
            "id": "250290211",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "It's just that Qica's not very familiar with how you climb mountains, and...",
            "nextDialogs": [
              "250290216"
            ]
          },
          "250290216": {
            "id": "250290216",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Could you demonstrate for us again, by the way?"
          },
          "250290213": {
            "id": "250290213",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "That's right. Mom says I'm getting real good at caring for him.",
            "nextDialogs": [
              "250290214"
            ]
          },
          "250290214": {
            "id": "250290214",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Qica's improved loads. He can climb way higher than he could last time.",
            "nextDialogs": [
              "250290215"
            ]
          },
          "250290215": {
            "id": "250290215",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "It's just that Qica's not very familiar with how you climb mountains, and..."
          }
        }
      }
    },
    {
      "subId": "2502903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250290301"
        ],
        "dialogs": {
          "250290301": {
            "id": "250290301",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "You're amazing! You're just about as fast as Mayta!",
            "nextDialogs": [
              "250290303",
              "250290305"
            ]
          },
          "250290303": {
            "id": "250290303",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Really? You mean you could've been faster still? Wow. Guess you really are an expert adventurer, huh...",
            "nextDialogs": [
              "250290306"
            ]
          },
          "250290306": {
            "id": "250290306",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "If we set this time as our goal... Hmm...",
            "nextDialogs": [
              "250290307"
            ]
          },
          "250290307": {
            "id": "250290307",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Hrroo, roooh...",
            "nextDialogs": [
              "250290308"
            ]
          },
          "250290308": {
            "id": "250290308",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "...Yeah, I know, it's going to be a bit difficult for you, huh?",
            "nextDialogs": [
              "250290309"
            ]
          },
          "250290309": {
            "id": "250290309",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Guess I'll go show Mayta your climbing time. Maybe he can come up with a more... reasonable training plan for us?",
            "nextDialogs": [
              "250290310"
            ]
          },
          "250290310": {
            "id": "250290310",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Anyway, thanks a lot for your help. Here, have this Cacahuatl!",
            "nextDialogs": [
              "250290311"
            ]
          },
          "250290311": {
            "id": "250290311",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "We picked it ourselves, so it's super fresh, and it'll make super tasty chocolate!",
            "nextDialogs": [
              "250290312"
            ]
          },
          "250290312": {
            "id": "250290312",
            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Orrooo, orrooo!",
            "nextDialogs": [
              "250290313"
            ]
          },
          "250290313": {
            "id": "250290313",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "In that case, we'll head out now. I wonder if Mayta's back at the settlement. He hasn't gone out climbing again, has he..."
          },
          "250290305": {
            "id": "250290305",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "He's a friend of mine who's real good at mountain climbing. Apart from Big Sis Roca, almost no one's his match."
          }
        }
      }
    },

            "speakerId": 14372,
            "speakerName": "Qica",
            "text": "Mountain, so high, so tired..."
          }
        }
      }
    },
    {
      "subId": "2502908",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250290801"
        ],
        "dialogs": {
          "250290801": {
            "id": "250290801",
            "speakerId": 14371,
            "speakerName": "Tlatem",
            "text": "Hehe. We're in your capable hands, then! We'll be watching your movements carefully and timing you from down below."
          }
        }
      }

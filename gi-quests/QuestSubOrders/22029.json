  },
  "subQuests": [
    {
      "subId": "2202901",
      "subQuestName": "Find Asakura, who issued the commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220290101"
        ],
        "dialogs": {
          "220290101": {
            "id": "220290101",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "I must! I must...",
            "nextDialogs": [
              "220290102"
            ]
          },
          "220290102": {
            "id": "220290102",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Huh? Who are you?",
            "nextDialogs": [
              "220290103"
            ]
          },
          "220290103": {
            "id": "220290103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I accepted your commission.",
            "nextDialogs": [
              "220290104"
            ]
          },
          "220290104": {
            "id": "220290104",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Oh, you mean my request for a training partner. That's right, I posted that. I want to find someone as my martial arts training partner.",
            "nextDialogs": [
              "220290105"
            ]
          },
          "220290105": {
            "id": "220290105",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "So you're the one who accepted it? I don't think I have ever met you in the city before.",
            "nextDialogs": [
              "220290106"
            ]
          },
          "220290106": {
            "id": "220290106",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Sorry, I don't mean to question your strength. But I'm really not sure what your martial arts skills are like...",
            "nextDialogs": [
              "220290108",
              "220290110"
            ]
          },
          "220290108": {
            "id": "220290108",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Hahaha... is that so? Actually, I'm more curious about where you found one of those. I've only heard of them before...",
            "nextDialogs": [
              "220290112"
            ]
          },
          "220290112": {
            "id": "220290112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oh, don't worry, I'm pretty capable.",
            "nextDialogs": [
              "220290113"
            ]
          },
          "220290113": {
            "id": "220290113",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Haha, anyway, words won't prove anything. Let's put the words to test with our hands then."
          },
          "220290110": {
            "id": "220290110",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Eh, what are you talking about? You mean that you've taken part in the Rite of Descension in Liyue before, right?",
            "nextDialogs": [
              "220290111"
            ]
          },
          "220290111": {
            "id": "220290111",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Hahaha, based on your logic, many people in Liyue have \"witnessed the fall of a god\" as well."
          }
        }
      }
    },
    {
      "subId": "2202904",
      "subQuestName": "Talk to Asakura",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220290401"
        ],
        "dialogs": {
          "220290401": {
            "id": "220290401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Bring it on!",
            "nextDialogs": [
              "220290601"
            ]
          },
          "220290601": {
            "id": "220290601",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Swords do not discriminate. Here I come!"
          }
        }
      }
    },
    {
      "subId": "2202902",
      "subQuestName": "Finish training with Asakura",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220290201"
        ],
        "dialogs": {
          "220290201": {
            "id": "220290201",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Did you hold back just now?",
            "nextDialogs": [
              "220290202"
            ]
          },
          "220290202": {
            "id": "220290202",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Don't worry about my pride. Please bring out all you have. I... must become stronger!"
          }
        }
      }
    },
    {
      "subId": "2202903",
      "subQuestName": "Talk to Asakura",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220290301"
        ],
        "dialogs": {
          "220290301": {
            "id": "220290301",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "*panting* You... are indeed formidable.",
            "nextDialogs": [
              "220290302"
            ]
          },
          "220290302": {
            "id": "220290302",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "I... I have learned much.",
            "nextDialogs": [
              "220290305"
            ]
          },
          "220290305": {
            "id": "220290305",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "That's... alright. I just need to catch my breath...",
            "nextDialogs": [
              "220290306"
            ]
          },
          "220290306": {
            "id": "220290306",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "But you are so powerful that I would have believed it even if you claimed to have defeated a giant dragon...",
            "nextDialogs": [
              "220290307"
            ]
          },
          "220290307": {
            "id": "220290307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Actually, I have defeated giant dragons...",
            "nextDialogs": [
              "220290308"
            ]
          },
          "220290308": {
            "id": "220290308",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Hahaha... I believe you, of course. Thank you for training with me. I will remember what I have learned from this match.",
            "nextDialogs": [
              "220290309"
            ]
          },
          "220290309": {
            "id": "220290309",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "If you do not mind, please come and practice with me often from now on. Having a strong warrior such as yourself as my training partner... I am sure that I will complete that deed soon.",
            "nextDialogs": [
              "220290310"
            ]
          },
          "220290310": {
            "id": "220290310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"That deed\"?",
            "nextDialogs": [
              "220290311"
            ]
          },
          "220290311": {
            "id": "220290311",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Ahem... It's just a little wish I have on my mind. Thank you for your help. Please take these as payment.",
            "nextDialogs": [
              "220290312"
            ]
          },
          "220290312": {
            "id": "220290312",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Now, I need to go back and take a break. Your moves were most mighty indeed..."
          }
        }
      }
    },
    {
      "subId": "2202905",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220290501"
        ],
        "dialogs": {
          "220290501": {
            "id": "220290501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Give me a moment.",
            "nextDialogs": [
              "220290502"
            ]
          },
          "220290502": {
            "id": "220290502",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Take your time. Let me know when you are ready."
          }
        }
      }
    },
    {
      "subId": "2202906",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220290602"
        ],
        "dialogs": {
          "220290602": {
            "id": "220290602",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "So, are you ready?"
          }
        }
      }
    },
    {
      "subId": "2202911",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220291101"
        ],
        "dialogs": {
          "220291101": {
            "id": "220291101",
            "speakerId": 1000,
            "speakerName": "Asakura",
            "text": "Hold your weapon tight. I'm attacking!"
          }
        }
      }
    }
  ]
}
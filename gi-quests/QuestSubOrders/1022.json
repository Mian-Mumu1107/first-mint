    {
      "subId": "102206",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10220601"
        ],
        "dialogs": {
          "10220601": {
            "id": "10220601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Those weren't Glaze Lilies! Glaze Lilies wouldn't hit people!",
            "nextDialogs": [
              "10220602"
            ]
          },
          "10220602": {
            "id": "10220602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Those flowers put up quite a fight...",
            "nextDialogs": [
              "10220603"
            ]
          },
          "10220603": {
            "id": "10220603",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "This little monster is known as a \"Whopperflower.\"",
            "nextDialogs": [
              "10220604"
            ]
          },
          "10220604": {
            "id": "10220604",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Hmm... Strange. These petals look interesting.",
            "nextDialogs": [
              "10220605"
            ]
          },
          "10220605": {
            "id": "10220605",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "The Glaze Lilies used as a disguise were buried with the Whopperflower for too long. The result seems to have surprisingly potent medicinal value. Let's collect what we can of these petals.",
            "nextDialogs": [
              "10220606"
            ]
          },
          "10220606": {
            "id": "10220606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well that's nice and all, but will those petals be useful for the Rite of Parting?",
            "nextDialogs": [
              "10220607"
            ]
          },
          "10220607": {
            "id": "10220607",
            "speakerId": 10232,
            "speakerName": "Zhongli",
            "text": "Unfortunately, no.",
            "nextDialogs": [
              "10220608"
            ]
          },
          "10220608": {
            "id": "10220608",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, that's so lame...",
            "nextDialogs": [
              "10220609"
            ]
          },
          "10220609": {
            "id": "10220609",
            "speakerId": 1015,
            "speakerName": "Ganyu",
            "text": "Excuse me...",
            "nextDialogs": [
              "10220610"
            ]
          },
          "10220610": {
            "id": "10220610",
            "speakerId": 1015,
            "speakerName": "Ganyu",
            "text": "Are you searching for Glaze Lilies?",
            "nextDialogs": [
              "10220611"
            ]
          },
          "10220611": {
            "id": "10220611",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, hey! It's... what's her face... Ah, Paimon can't remember...",
            "nextDialogs": [
              "10220613",
              "10220615"
            ]
          },
          "10220613": {
            "id": "10220613",
            "speakerId": 1015,
            "speakerName": "Ganyu",
            "text": "Hello, traveler. I'm surprised you still remember my name.",
            "nextDialogs": [
              "10220617"
            ]
          },
          "10220617": {
            "id": "10220617",
            "speakerId": 1015,
            "speakerName": "Ganyu",
            "text": "Ah! That reminds me, how was your visit to the Jade Chamber?",
            "nextDialogs": [
              "10220618"
            ]
          },
          "10220618": {
            "id": "10220618",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, it sure would've been better if you'd told us how to get up there!",
            "nextDialogs": [
              "10220619"
            ]
          },
          "10220619": {
            "id": "10220619",
            "speakerId": 1015,
            "speakerName": "Ganyu",
            "text": "Didn't I tell you the way!? Surely I did!",
            "nextDialogs": [
              "10220620"
            ]
          },
          "10220620": {
            "id": "10220620",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Nope, we found the way on our own!"
          },
          "10220615": {
            "id": "10220615",
            "speakerId": 1015,
            "speakerName": "Ganyu",
            "text": "\"Yangu\"? Wh—Who's that?",
            "nextDialogs": [
              "10220616"
            ]
          },
          "10220616": {
            "id": "10220616",
            "speakerId": 1015,
            "speakerName": "Ganyu",
            "text": "Eh... You've completely forgotten my name, haven't you?"
          }
        }
      }
    },
    {

    {
      "subId": "7226503",
      "subQuestName": "Wait for the fake Gendou to show up",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722650301"
        ],
        "dialogs": {
          "722650301": {
            "id": "722650301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, look! There's someone walking out from the shrine!",
            "nextDialogs": [
              "722650302"
            ]
          },
          "722650302": {
            "id": "722650302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's our mark, alright! The fake Gendou! She's heading down the mountain. C'mon, after her!"
          }
        }
      }
    },
    {
      "subId": "7226504",
      "subQuestName": "Use Elemental Sight to pursue the fake Gendou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7226505",
      "subQuestName": "Eavesdrop on their conversation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722650501"
        ],
        "dialogs": {
          "722650501": {
            "id": "722650501",
            "speakerId": 1002,
            "speakerName": "\"Gendou Ringo\"",
            "text": "It hasn't come time yet to meet the Teacher, I'm sure of it. In that case, this must be about that incident...",
            "nextDialogs": [
              "722650502"
            ]
          },
          "722650502": {
            "id": "722650502",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "Lyudochka.",
            "nextDialogs": [
              "722650503"
            ]
          },
          "722650503": {
            "id": "722650503",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "Ah, Teacher, you're here!",
            "nextDialogs": [
              "722650504"
            ]
          },
          "722650504": {
            "id": "722650504",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "Sorry for bothering you. Allow me to make my report. So, concerning your instructions to infiltrate the Shuumatsuban...",
            "nextDialogs": [
              "722650505"
            ]
          },
          "722650505": {
            "id": "722650505",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "Enough, Lyudochka. I tire of your delaying tactics.",
            "nextDialogs": [
              "722650506"
            ]
          },
          "722650506": {
            "id": "722650506",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "\"Frequent contact might raise suspicion,\" \"The Shuumatsuban's direction may change due to the end of the Vision Hunt Decree, I must gather more information\"...",
            "nextDialogs": [
              "722650507"
            ]
          },
          "722650507": {
            "id": "722650507",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "You always say these things! Tell me. You don't actually have the trust of those two Shuumatsuban members, do you? Why else would you spout all these lies, hoping to stave me off?",
            "nextDialogs": [
              "722650508"
            ]
          },
          "722650508": {
            "id": "722650508",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "That's not it, Teacher! They do trust me. I just need a little more time...",
            "nextDialogs": [
              "722650509"
            ]
          },
          "722650509": {
            "id": "722650509",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "Time, you say? I have given you more than sufficient time.",
            "nextDialogs": [
              "722650510"
            ]
          },
          "722650510": {
            "id": "722650510",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "Understand this. My patience is limited, as is that of Lady Arlecchino.",
            "nextDialogs": [
              "722650511"
            ]
          },
          "722650511": {
            "id": "722650511",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "My apologies...",
            "nextDialogs": [
              "722650512"
            ]
          },
          "722650512": {
            "id": "722650512",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "I did not spend all those years raising you to listen to apologies. What I want are results. Results!",
            "nextDialogs": [
              "722650513"
            ]
          },
          "722650513": {
            "id": "722650513",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "...Forget it. I will not chase down every little detail of this matter. Your inability to win their trust, your present lifestyle getting to your head... None of this matters.",
            "nextDialogs": [
              "722650514"
            ]
          },
          "722650514": {
            "id": "722650514",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "I have written your \"final instructions\" on this sheet of paper. Take it, and read it well.",
            "nextDialogs": [
              "722650515"
            ]
          },
          "722650515": {
            "id": "722650515",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "Yes, Teacher! I will complete the mission. I will not disappoint you!",
            "nextDialogs": [
              "722650516"
            ]
          },
          "722650516": {
            "id": "722650516",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "...Th—This is!?",
            "nextDialogs": [
              "722650517"
            ]
          },
          "722650517": {
            "id": "722650517",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "Is something wrong?",
            "nextDialogs": [
              "722650518"
            ]
          },
          "722650518": {
            "id": "722650518",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "Ah, no. Not at all...",
            "nextDialogs": [
              "722650519"
            ]
          },
          "722650519": {
            "id": "722650519",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "Lyudochka. May I take your previous words as your promise?",
            "nextDialogs": [
              "722650520"
            ]
          },
          "722650520": {
            "id": "722650520",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "...",
            "nextDialogs": [
              "722650521"
            ]
          },
          "722650521": {
            "id": "722650521",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "Answer me. Yes? Or no?",
            "nextDialogs": [
              "722650522"
            ]
          },
          "722650522": {
            "id": "722650522",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "Teacher! I have no objections to your decision. But... You said that Lady Arlecchino can recall us from Inazuma at any time.",
            "nextDialogs": [
              "722650523"
            ]
          },
          "722650523": {
            "id": "722650523",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "And at this moment, the Shogunate and Watatsumi Island have reached a ceasefire, so... Is what we're doing really necessary?",
            "nextDialogs": [
              "722650524"
            ]
          },
          "722650524": {
            "id": "722650524",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "Hah. That is precisely why our mission has value.",
            "nextDialogs": [
              "722650525"
            ]
          },
          "722650525": {
            "id": "722650525",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "Lady Signora may have met her end here in Inazuma, but that makes it the best time for us to repay Lady Arlecchino's kindness and build up her prestige.",
            "nextDialogs": [
              "722650526"
            ]
          },
          "722650526": {
            "id": "722650526",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "And I have always told you that as far as we are concerned, \"chaos\" is the most fertile soil.",
            "nextDialogs": [
              "722650527"
            ]
          },
          "722650527": {
            "id": "722650527",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "...",
            "nextDialogs": [
              "722650528"
            ]
          },
          "722650528": {
            "id": "722650528",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "What are you wavering for, Lyudochka?",
            "nextDialogs": [
              "722650529"
            ]
          },
          "722650529": {
            "id": "722650529",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "This way, there will certainly be more orphans...",
            "nextDialogs": [
              "722650530"
            ]
          },
          "722650530": {
            "id": "722650530",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "And wouldn't that be well? We can take them in and train them. They will join us — well, provided you complete your mission, of course.",
            "nextDialogs": [
              "722650531"
            ]
          },
          "722650531": {
            "id": "722650531",
            "speakerId": 20486,
            "speakerName": "Efim Snezhevich",
            "text": "Do not disappoint me again, Lyudochka. We go many years back. I have no wish to take things too far.",
            "nextDialogs": [
              "722650532"
            ]
          },
          "722650532": {
            "id": "722650532",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "Ohh...",
            "nextDialogs": [
              "722650533"
            ]
          },
          "722650533": {
            "id": "722650533",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no, something terrible's going to happen to Watatsumi Island!",
            "nextDialogs": [
              "722650534"
            ]
          },
          "722650534": {
            "id": "722650534",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Looks like Lyudochka's alone now, {NICKNAME}. Let's find a way to get those final instructions from her!"
          }
        }
      }
    },
    {
      "subId": "7226506",
      "subQuestName": "Face off against Lyudochka",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722650601"
        ],
        "dialogs": {
          "722650601": {
            "id": "722650601",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "...",
            "nextDialogs": [
              "722650602"
            ]
          },
          "722650602": {
            "id": "722650602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Lyudochka.",
            "nextDialogs": [
              "722650603"
            ]
          },
          "722650603": {
            "id": "722650603",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "Who's there!?",
            "nextDialogs": [
              "722650604"
            ]
          },
          "722650604": {
            "id": "722650604",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "#You... {NICKNAME}, why are you here?",
            "nextDialogs": [
              "722650605"
            ]
          },
          "722650605": {
            "id": "722650605",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "That, I... No, you misunderstand! I... I was here because...",
            "nextDialogs": [
              "722650606"
            ]
          },
          "722650606": {
            "id": "722650606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't think I'm misunderstanding anything.",
            "nextDialogs": [
              "722650609"
            ]
          },
          "722650609": {
            "id": "722650609",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "...Well, well, I suppose there's no point saying anything now.",
            "nextDialogs": [
              "722650610"
            ]
          },
          "722650610": {
            "id": "722650610",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "Now that you've exposed my true identity, I can't let you leave alive!"
          }
        }
      }
    },
    {
      "subId": "7226507",
      "subQuestName": "Fight Lyudochka",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7226508",
      "subQuestName": "Talk to Lyudochka",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722650801"
        ],
        "dialogs": {
          "722650801": {
            "id": "722650801",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "*cough* Ugh... *pants*",
            "nextDialogs": [
              "722650802"
            ]
          },
          "722650802": {
            "id": "722650802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, are you alright?",
            "nextDialogs": [
              "722650803"
            ]
          },
          "722650803": {
            "id": "722650803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sorry. I didn't quite hold back enough.",
            "nextDialogs": [
              "722650804"
            ]
          },
          "722650804": {
            "id": "722650804",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "*pants* Why... aren't you finishing me off?",
            "nextDialogs": [
              "722650805"
            ]
          },
          "722650805": {
            "id": "722650805",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "You must be trying to get those final instructions from me. Well? Wouldn't it be simpler to just be rid of me first?",
            "nextDialogs": [
              "722650806"
            ]
          },
          "722650806": {
            "id": "722650806",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That would certainly be simple, yes.",
            "nextDialogs": [
              "722650807"
            ]
          },
          "722650807": {
            "id": "722650807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I suppose that might even be a release for you.",
            "nextDialogs": [
              "722650808"
            ]
          },
          "722650808": {
            "id": "722650808",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "...",
            "nextDialogs": [
              "722650809"
            ]
          },
          "722650809": {
            "id": "722650809",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Gendou... No, Ms. Lyudochka. We can tell, y'know? You came at us pretty hard at first, but you weren't serious at all while the two of you were fighting, were you?",
            "nextDialogs": [
              "722650812"
            ]
          },
          "722650812": {
            "id": "722650812",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "Eh? I... I wasn't faking it that much, was I?",
            "nextDialogs": [
              "722650813"
            ]
          },
          "722650813": {
            "id": "722650813",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, you were certainly trying to finish things — for yourself, at least.",
            "nextDialogs": [
              "722650814"
            ]
          },
          "722650814": {
            "id": "722650814",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ms. Lyudochka, we overheard your conversation with that Teacher of yours. Things... seem kinda tough. Could you tell us what happened? We can help you!",
            "nextDialogs": [
              "722650815"
            ]
          },
          "722650815": {
            "id": "722650815",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "But I... I'm a Fatuus."
          }
        }
      }
    },
    {
      "subId": "7226509",
      "subQuestName": "Report your results to Momoyo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722650901"
        ],
        "dialogs": {
          "722650901": {
            "id": "722650901",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "You're only back now? Well then. Did you get the intel?"
          }
        }
      }
    },
    {
      "subId": "7226517",
      "subQuestName": "Report back to Momoyo and talk to her",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651701"
        ],
        "dialogs": {
          "722651701": {
            "id": "722651701",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "Not bad. With this, we should be able to foil the Fatui's scheme. I will get people to perform follow-up operations immediately. You need no longer worry.",
            "nextDialogs": [
              "722651702"
            ]
          },
          "722651702": {
            "id": "722651702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Actually, Momoyo, we've got something to ask of you...",
            "nextDialogs": [
              "722651703"
            ]
          },
          "722651703": {
            "id": "722651703",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "You tell Momoyo the details of what happened.",
            "nextDialogs": [
              "722651704"
            ]
          },
          "722651704": {
            "id": "722651704",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "...",
            "nextDialogs": [
              "722651705"
            ]
          },
          "722651705": {
            "id": "722651705",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh, Momoyo, stop staring at Paimon. Um... Just say something, would you?",
            "nextDialogs": [
              "722651706"
            ]
          },
          "722651706": {
            "id": "722651706",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "You want to save a Fatuus? What has that got to do with me!?",
            "nextDialogs": [
              "722651707"
            ]
          },
          "722651707": {
            "id": "722651707",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "That woman replaced me, you know? If it wasn't for your overly fortuitous bumbling, the Shuumatsuban might be in a crisis right now!",
            "nextDialogs": [
              "722651708"
            ]
          },
          "722651708": {
            "id": "722651708",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Um, {NICKNAME}, help Paimon out here! If we can't convince Momoyo, Ms. Lyudochka's life might be in danger!",
            "nextDialogs": [
              "722651712"
            ]
          },
          "722651712": {
            "id": "722651712",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "Hmph. That won't work on me. I will not associate with these Fatui!",
            "nextDialogs": [
              "722651713"
            ]
          },
          "722651713": {
            "id": "722651713",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "Do you two think that making cadavers is so simple? I've been working day and night this whole time you've been out fishing for intel to finish the work I currently had.",
            "nextDialogs": [
              "722651714"
            ]
          },
          "722651714": {
            "id": "722651714",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "You need this much <color=#00E1FFFF>Raw Meat</color> to constitute one person's weight! And then you also need to smelt <color=#00E1FFFF>White Iron Chunks</color> together with a plethora of other ingredients to make fake bones!",
            "nextDialogs": [
              "722651715"
            ]
          },
          "722651715": {
            "id": "722651715",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "And without any <color=#00E1FFFF>Sea Ganoderma</color>, the body will not contain sufficient fat. It won't look convincing at all.",
            "nextDialogs": [
              "722651716"
            ]
          },
          "722651716": {
            "id": "722651716",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "And putting the <color=#00E1FFFF>clothes</color> on the fake cadaver is just the worst when you need to create any realistic burns. Go too far, and those clothes will be all but unrecognizable!",
            "nextDialogs": [
              "722651717"
            ]
          },
          "722651717": {
            "id": "722651717",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "722651718"
            ]
          },
          "722651718": {
            "id": "722651718",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "722651719"
            ]
          },
          "722651719": {
            "id": "722651719",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "What? Did you both go deaf? What are you standing around for? <color=#00E1FFFF>Eight hunks of Raw Meat, four White Iron Chunks, and three Sea Ganoderma</color>, plus one set of clearly identifiable <color=#00E1FFFF>clothes</color>!",
            "nextDialogs": [
              "722651720"
            ]
          },
          "722651720": {
            "id": "722651720",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We knew you were a great person, Momoyo!",
            "nextDialogs": [
              "722651721"
            ]
          },
          "722651721": {
            "id": "722651721",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "Ugh, just scram! Quit bugging me already!"
          }
        }
      }
    },
    {
      "subId": "7226513",
      "subQuestName": "Collect 8 Raw Meat",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651301"
        ],
        "dialogs": {
          "722651301": {
            "id": "722651301",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "I'll continue to work as a proofreader here for now. I pray for your success.",
            "nextDialogs": [
              "722651302"
            ]
          },
          "722651302": {
            "id": "722651302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How's the proofreading going, by the way?",
            "nextDialogs": [
              "722651303"
            ]
          },
          "722651303": {
            "id": "722651303",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "It's going quite smoothly, but there's a lot of content to go through. And considering that Yae Publishing House will be short-handed for the next two days... It'll be a long night, I think.",
            "nextDialogs": [
              "722651304"
            ]
          },
          "722651304": {
            "id": "722651304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That sounds tough!",
            "nextDialogs": [
              "722651305"
            ]
          },
          "722651305": {
            "id": "722651305",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "Haha. It is, but I find it fascinating! Being able to read the novels I love in advance, and even touch the hand-written manuscripts themselves... Ah, it's so wonderful!"
          }
        }
      }
    },
    {
      "subId": "7226514",
      "subQuestName": "Collect 4 White Iron Chunks",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651401"
        ],
        "dialogs": {
          "722651401": {
            "id": "722651401",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "Go on, quickly now. Get the powder onto that fake, and we'll be able to track her using Elemental Sight.",
            "nextDialogs": [
              "722651402"
            ]
          },
          "722651402": {
            "id": "722651402",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "The Fatui are surely up to no good on Watatsumi Island. But now that the Tenryou Commission isn't covering for them, they can forget about trying anything funny."
          }
        }
      }
    },
    {
      "subId": "7226516",
      "subQuestName": "Obtain a set of Lyudochka's clothes",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651601"
        ],
        "dialogs": {
          "722651601": {
            "id": "722651601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ms. Lyudochka, are you there?",
            "nextDialogs": [
              "722651602"
            ]
          },
          "722651602": {
            "id": "722651602",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "#Ah, it's {NICKNAME} and Paimon. Did something not go as planned? Don't worry, I'll leave this place immediately. I won't trouble you any further...",
            "nextDialogs": [
              "722651603"
            ]
          },
          "722651603": {
            "id": "722651603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No, no! We came here because our current plan requires a set of your clothes — we'll need a set with which people can identify you immediately.",
            "nextDialogs": [
              "722651604"
            ]
          },
          "722651604": {
            "id": "722651604",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "A highly-identifiable set of clothes? Alright.",
            "nextDialogs": [
              "722651605"
            ]
          },
          "722651605": {
            "id": "722651605",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "This is my Fatui uniform. Those who know me should be able to recognize this set in particular.",
            "nextDialogs": [
              "722651606"
            ]
          },
          "722651606": {
            "id": "722651606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Feels kinda warm to the touch.",
            "nextDialogs": [
              "722651607"
            ]
          },
          "722651607": {
            "id": "722651607",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "Ah, I apologize, but I was wearing it under my other clothes in case of an emergency.",
            "nextDialogs": [
              "722651608"
            ]
          },
          "722651608": {
            "id": "722651608",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright. Now that we have this set of clothes, this plan should go off without a hitch!",
            "nextDialogs": [
              "722651609"
            ]
          },
          "722651609": {
            "id": "722651609",
            "speakerId": 20485,
            "speakerName": "Lyudochka Snezhevna",
            "text": "Thank you, and best of luck."
          }
        }
      }
    },
    {
      "subId": "7226515",
      "subQuestName": "Collect 3 Sea Ganoderma",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651501"
        ],
        "dialogs": {
          "722651501": {
            "id": "722651501",
            "speakerId": 3110,
            "speakerName": "Riku",
            "text": "Ah, an outlander! Hello!",
            "nextDialogs": [
              "722651502"
            ]
          },
          "722651502": {
            "id": "722651502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did you see anything earlier?",
            "nextDialogs": [
              "722651503"
            ]
          },
          "722651503": {
            "id": "722651503",
            "speakerId": 3110,
            "speakerName": "Riku",
            "text": "Oh yeah, I did.",
            "nextDialogs": [
              "722651504"
            ]
          },
          "722651504": {
            "id": "722651504",
            "speakerId": 3110,
            "speakerName": "Riku",
            "text": "I saw a shrine maiden lady walk over there... and then turn all purple, like, fwoosh! Then she flew away! That was super cool!"
          }
        }
      }
    },
    {
      "subId": "7226510",
      "subQuestName": "Give the materials to Momoyo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651001"
        ],
        "dialogs": {
          "722651001": {
            "id": "722651001",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "You're back."
          }
        }
      }
    },
    {
      "subId": "7226520",
      "subQuestName": "Give the materials to Momoyo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722652101"
        ],
        "dialogs": {
          "722652101": {
            "id": "722652101",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "Hmph. When did I say that I wanted these materials?",
            "nextDialogs": [
              "722652102"
            ]
          },
          "722652102": {
            "id": "722652102",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "But now that you've laid them out in front of me, I suppose I can help you. Your intelligence will save many lives, after all.",
            "nextDialogs": [
              "722652103"
            ]
          },
          "722652103": {
            "id": "722652103",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "Raw Meat, White Iron Chunks, Sea Ganoderma... These will do."
          }
        }
      }
    },
    {
      "subId": "7226519",
      "subQuestName": "Hand over the set of Lyudochka's clothes",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651901"
        ],
        "dialogs": {
          "722651901": {
            "id": "722651901",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "So, do you have some clothes with which people can easily identify Lyudochka?"
          }
        }
      }
    },
    {
      "subId": "7226518",
      "subQuestName": "Ask Momoyo to start making the fake cadaver",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651801"
        ],
        "dialogs": {
          "722651801": {
            "id": "722651801",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "Alright, everything's ready. What happens after this is none of your business.",
            "nextDialogs": [
              "722651802"
            ]
          },
          "722651802": {
            "id": "722651802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What about the operation that's happening on Watatsumi Island?",
            "nextDialogs": [
              "722651803"
            ]
          },
          "722651803": {
            "id": "722651803",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "I had it arranged while you were out looking for these materials.",
            "nextDialogs": [
              "722651804"
            ]
          },
          "722651804": {
            "id": "722651804",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "The item you need will take a whole day to craft, so come back tomorrow.",
            "nextDialogs": [
              "722651805"
            ]
          },
          "722651805": {
            "id": "722651805",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "When that time comes, we will talk about how we might use this dummy body."
          }
        }
      }
    },
    {
      "subId": "7226511",
      "subQuestName": "Leave the safehouse",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722651101"
        ],
        "dialogs": {
          "722651101": {
            "id": "722651101",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "The crafting will take a whole day, so come back tomorrow. Stop floating around me, you'll ruin my mood."
          }
        }
      }
    },
    {
      "subId": "7226512",
      "subQuestName": "Wait until the following afternoon (14:00 – 18:00)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7226520",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722652001"
        ],
        "dialogs": {
          "722652001": {
            "id": "722652001",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "The materials are <color=#00E1FFFF>eight hunks of Raw Meat</color>, <color=#00E1FFFF>four White Iron Chunks</color>, and <color=#00E1FFFF>three Sea Ganoderma</color>. Plus one set of <color=#00E1FFFF>clothes</color> with which to distinguish Lyudochka.",
            "nextDialogs": [
              "722652002"
            ]
          },
          "722652002": {
            "id": "722652002",
            "speakerId": 20482,
            "speakerName": "Momoyo",
            "text": "If you've got it, get going! I still need to arrange the operation to capture the Fatui on Watatsumi Island."
          }
        }
      }
    }
  ]
}
{
  "lineCounts": {
    "Julie": 22,
    "Kamei Munehisa": 41,
    "Parvaneh": 42,
    "Player": 36,
    "Xudong": 49
  },
  "subQuests": [
    {
      "subId": "2201601",
      "subQuestName": "Talk to Parvaneh",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220160101"
        ],
        "dialogs": {
          "220160101": {
            "id": "220160101",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Traveler... you're just in time! Have you seen Julie? The... the short Mondstadt girl who was with me!?",
            "nextDialogs": [
              "220160102"
            ]
          },
          "220160102": {
            "id": "220160102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No, I haven't...",
            "nextDialogs": [
              "220160103"
            ]
          },
          "220160103": {
            "id": "220160103",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "You— You haven't seen her either? Where on earth did that idiot go...",
            "nextDialogs": [
              "220160104"
            ]
          },
          "220160104": {
            "id": "220160104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "220160105"
            ]
          },
          "220160105": {
            "id": "220160105",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Julie suddenly disappeared. No, well... maybe it's not accurate to say that she \"suddenly\" disappeared.",
            "nextDialogs": [
              "220160106"
            ]
          },
          "220160106": {
            "id": "220160106",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "We met an old man named Kamei Munehisa when you last came with us to collect ingredients. Do you remember him?",
            "nextDialogs": [
              "220160109"
            ]
          },
          "220160109": {
            "id": "220160109",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Yeah. He defeated the monsters near the camp and gave us ingredients from around those parts.",
            "nextDialogs": [
              "220160110"
            ]
          },
          "220160110": {
            "id": "220160110",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Ever since we got back, Julie has been talking about sending him food to show our appreciation...",
            "nextDialogs": [
              "220160111"
            ]
          },
          "220160111": {
            "id": "220160111",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Xudong and I thought she was just saying it. However, she left a note in the camp today and actually went looking for him.",
            "nextDialogs": [
              "220160112"
            ]
          },
          "220160112": {
            "id": "220160112",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "The idiot... She doesn't know what she's doing! That Kamei Munehisa looked so suspicious!",
            "nextDialogs": [
              "220160113"
            ]
          },
          "220160113": {
            "id": "220160113",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "*sigh* Xudong and I split up. He went to find the place where we met Kamei Munehisa the previous time. I came to the Adventurers' Guild to post a missing person commission.",
            "nextDialogs": [
              "220160114"
            ]
          },
          "220160114": {
            "id": "220160114",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "I can't believe that she actually dared to run off with how things are in Inazuma right now... We must find her, and quickly!"
          }
        }
      }
    },
    {
      "subId": "2201602",
      "subQuestName": "Meet up with Xudong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220160201"
        ],
        "dialogs": {
          "220160201": {
            "id": "220160201",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Parvaneh... and Traveler? What brings you here?",
            "nextDialogs": [
              "220160203",
              "220160206"
            ]
          },
          "220160203": {
            "id": "220160203",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Really? Thank you so much! Now, Julie seems to have gone deeper within...",
            "nextDialogs": [
              "220160204"
            ]
          },
          "220160204": {
            "id": "220160204",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "There are tons of monsters there. It's hard to deal with them with just the two of us. But we should be much better off with your help.",
            "nextDialogs": [
              "220160210"
            ]
          },
          "220160210": {
            "id": "220160210",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Let's get going. Julie should be in the woods."
          },
          "220160206": {
            "id": "220160206",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "No problem. But I can't cook it alone.",
            "nextDialogs": [
              "220160207"
            ]
          },
          "220160207": {
            "id": "220160207",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Traveler, could you do me a favor and help us get Julie back first?",
            "nextDialogs": [
              "220160208"
            ]
          },
          "220160208": {
            "id": "220160208",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Julie seems to have gone deeper in... and there are tons of monsters there. It will hard going with just the two of us.",
            "nextDialogs": [
              "220160209"
            ]
          },
          "220160209": {
            "id": "220160209",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "After we find Julie, I'll make you the feast I promised."
          }
        }
      }
    },
    {
      "subId": "2201603",
      "subQuestName": "Talk to Xudong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2201604",
      "subQuestName": "Search ahead",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220160401"
        ],
        "dialogs": {
          "220160401": {
            "id": "220160401",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Ahem... Sorry that you have to see me like this.",
            "nextDialogs": [
              "220160402"
            ]
          },
          "220160402": {
            "id": "220160402",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "Uncle Munehisa, are you okay?...",
            "nextDialogs": [
              "220160403"
            ]
          },
          "220160403": {
            "id": "220160403",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Just a few lost go-arounds. No big deal.",
            "nextDialogs": [
              "220160404"
            ]
          },
          "220160404": {
            "id": "220160404",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Now, Julie, could you tell us the whole story, then?",
            "nextDialogs": [
              "220160405"
            ]
          },
          "220160405": {
            "id": "220160405",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Tell me everything please, or my books were wrecked for nothing... Agh, the pages are all wrinkled now...",
            "nextDialogs": [
              "220160406"
            ]
          },
          "220160406": {
            "id": "220160406",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "It's simple... I just wanted to bring him some food.",
            "nextDialogs": [
              "220160407"
            ]
          },
          "220160407": {
            "id": "220160407",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "*sigh*... You only met him once. Why... do you trust him so much?",
            "nextDialogs": [
              "220160408"
            ]
          },
          "220160408": {
            "id": "220160408",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "I'm sure he's a good man! He was starving, but he gave the food to us instead of keeping it for himself.",
            "nextDialogs": [
              "220160409"
            ]
          },
          "220160409": {
            "id": "220160409",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "Anyone who is willing to share food with others when they are hungry must be a good person!",
            "nextDialogs": [
              "220160410"
            ]
          },
          "220160410": {
            "id": "220160410",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Your concept of good and evil is so straightforward and pure...",
            "nextDialogs": [
              "220160411"
            ]
          },
          "220160411": {
            "id": "220160411",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "You must live in some fairy tale world instead of Teyvat.",
            "nextDialogs": [
              "220160412"
            ]
          },
          "220160412": {
            "id": "220160412",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hahaha, I think she's right, though.",
            "nextDialogs": [
              "220160413"
            ]
          },
          "220160413": {
            "id": "220160413",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I agree. Those who can uphold their honor and decency when they are hungry can't be all that bad.",
            "nextDialogs": [
              "220160414"
            ]
          },
          "220160414": {
            "id": "220160414",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Such simple and straightforward logic...",
            "nextDialogs": [
              "220160415"
            ]
          },
          "220160415": {
            "id": "220160415",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Anyway, Julie, do continue.",
            "nextDialogs": [
              "220160416"
            ]
          },
          "220160416": {
            "id": "220160416",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "So I made some Chicken-Mushroom Skewers and wanted to try my luck finding him where we first met.",
            "nextDialogs": [
              "220160417"
            ]
          },
          "220160417": {
            "id": "220160417",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "I did see him there, as it turned out.",
            "nextDialogs": [
              "220160418"
            ]
          },
          "220160418": {
            "id": "220160418",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "I was just about to say hello when I noticed that he was confronting some Kairagi.",
            "nextDialogs": [
              "220160419"
            ]
          },
          "220160419": {
            "id": "220160419",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "I wanted to get away, but I was spotted by them...",
            "nextDialogs": [
              "220160420"
            ]
          },
          "220160420": {
            "id": "220160420",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I'll take it from here...",
            "nextDialogs": [
              "220160421"
            ]
          },
          "220160421": {
            "id": "220160421",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Among those... people, are some of my old friends who served with me under the Shogunate.",
            "nextDialogs": [
              "220160422"
            ]
          },
          "220160422": {
            "id": "220160422",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "After Inazuma's sudden change, we all left the Shogunate one after another to make our own living.",
            "nextDialogs": [
              "220160424",
              "220160426",
              "220160428"
            ]
          },
          "220160424": {
            "id": "220160424",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "...Yes. We don't have any way to make money other than by the sword.",
            "nextDialogs": [
              "220160432"
            ]
          },
          "220160432": {
            "id": "220160432",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Since then, they became the Kairagi as you see them, making a living by plundering.",
            "nextDialogs": [
              "220160433"
            ]
          },
          "220160433": {
            "id": "220160433",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I didn't want to live like that, so I've wandered the land looking for work.",
            "nextDialogs": [
              "220160434"
            ]
          },
          "220160434": {
            "id": "220160434",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "But no one would dare hire me as soon as they found out that I used to be a samurai who had left the Shogunate.",
            "nextDialogs": [
              "220160435"
            ]
          },
          "220160435": {
            "id": "220160435",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Since then, as you can see, I've had to scavenge for food in the wilderness.",
            "nextDialogs": [
              "220160436"
            ]
          },
          "220160436": {
            "id": "220160436",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Recently, my former comrades seem to be short-handed, so they have come every day to persuade me to join them. I refused every time.",
            "nextDialogs": [
              "220160437"
            ]
          },
          "220160437": {
            "id": "220160437",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Today... when Julie appeared, they thought that I must've joined some Clan or another and was trying to get rid of them. So they attacked us."
          },
          "220160426": {
            "id": "220160426",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Not all. But regardless, they were all cowards who raise their swords against the weak."
          },
          "220160428": {
            "id": "220160428",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I just... couldn't agree with what the Shogunate was doing in Inazuma.",
            "nextDialogs": [
              "220160429"
            ]
          },
          "220160429": {
            "id": "220160429",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I'm just a martial artist. I don't know what's good for the country or not.",
            "nextDialogs": [
              "220160430"
            ]
          },
          "220160430": {
            "id": "220160430",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I only knew that it went against what was in my heart, so I chose to leave.",
            "nextDialogs": [
              "220160431"
            ]
          },
          "220160431": {
            "id": "220160431",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Hehe. Perhaps I was just too old-fashioned... Please try not to laugh."
          }
        }
      }
    },
    {
      "subId": "2201605",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220160501"
        ],
        "dialogs": {
          "220160501": {
            "id": "220160501",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Ah, full at last... Hmm...",
            "nextDialogs": [
              "220160503",
              "220160514"
            ]
          },
          "220160503": {
            "id": "220160503",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Do you mean Uncle Munehisa? I did it out of my professional ethics as a chef, of course.",
            "nextDialogs": [
              "220160504"
            ]
          },
          "220160504": {
            "id": "220160504",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hah, just kidding. But I really don't want to see a good man like him go hungry.",
            "nextDialogs": [
              "220160505"
            ]
          },
          "220160505": {
            "id": "220160505",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "In truth... I don't want to see anyone go hungry.",
            "nextDialogs": [
              "220160506"
            ]
          },
          "220160506": {
            "id": "220160506",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hunger is a terrible feeling. I've had first-hand experience.",
            "nextDialogs": [
              "220160507"
            ]
          },
          "220160507": {
            "id": "220160507",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "People can do terrible things under the influence of hunger.",
            "nextDialogs": [
              "220160508"
            ]
          },
          "220160508": {
            "id": "220160508",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I think that if everyone in this world ate well, perhaps, a lot of terrible things could be avoided.",
            "nextDialogs": [
              "220160509"
            ]
          },
          "220160509": {
            "id": "220160509",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "I can't do it alone, true, but as a chef, I can at least try to help the people around me eat well.",
            "nextDialogs": [
              "220160510"
            ]
          },
          "220160510": {
            "id": "220160510",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hahaha, to put it simply, I just want everyone to have food and eat well. A rather meaningless ideal, I suppose.",
            "nextDialogs": [
              "220160511"
            ]
          },
          "220160511": {
            "id": "220160511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No, it's a noble ideal.",
            "nextDialogs": [
              "220160512"
            ]
          },
          "220160512": {
            "id": "220160512",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Hehe, thanks a lot. Okay... no more talking. Have some more and don't leave any on your plate. Wasting food is a terrible sin."
          },
          "220160514": {
            "id": "220160514",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "You're leaving? Not having any seconds?"
          }
        }
      }
    },
    {
      "subId": "2201606",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220160601"
        ],
        "dialogs": {
          "220160601": {
            "id": "220160601",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "Hehe. This is actually quite tasty. I'll definitely go for another round...",
            "nextDialogs": [
              "220160603",
              "220160607",
              "220160610"
            ]
          },
          "220160603": {
            "id": "220160603",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "Well... I just didn't want to see him go hungry.",
            "nextDialogs": [
              "220160604"
            ]
          },
          "220160604": {
            "id": "220160604",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "The last time I saw him, he seemed sad. I thought it was probably because he didn't have enough to eat.",
            "nextDialogs": [
              "220160605"
            ]
          },
          "220160605": {
            "id": "220160605",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "So I wanted to bring some food to him. He won't be so sad once he's full, I thought."
          },
          "220160607": {
            "id": "220160607",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "That's... an adventurer's intuition. I'm very good at telling the good guys from the bad guys.",
            "nextDialogs": [
              "220160608"
            ]
          },
          "220160608": {
            "id": "220160608",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "Only good people give out food when they're hungry..."
          },
          "220160610": {
            "id": "220160610",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "Bye. I'll never miss breakfast again..."
          }
        }
      }
    },
    {
      "subId": "2201609",
      "subQuestName": "Talk to Julie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220160301"
        ],
        "dialogs": {
          "220160301": {
            "id": "220160301",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Hey! If you break the wok, what will we cook with!?",
            "nextDialogs": [
              "220160302"
            ]
          },
          "220160302": {
            "id": "220160302",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Don't underestimate Liyue's skill in making woks. This is a unique cast iron wok specially designed for tossing. It won't break easily.",
            "nextDialogs": [
              "220160303"
            ]
          },
          "220160303": {
            "id": "220160303",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Besides, it's just a few monsters. What kind of iron wok would it be if it couldn't knock them flat?",
            "nextDialogs": [
              "220160304"
            ]
          },
          "220160304": {
            "id": "220160304",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "You're expecting too much out of it...",
            "nextDialogs": [
              "220160306",
              "220160309",
              "220160313"
            ]
          },
          "220160306": {
            "id": "220160306",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Of course! A chef has to carry himself in a certain way.",
            "nextDialogs": [
              "220160307"
            ]
          },
          "220160307": {
            "id": "220160307",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "I've never heard of such a thing! Why would a chef learn to smash monsters with an iron pot?!",
            "nextDialogs": [
              "220160315"
            ]
          },
          "220160315": {
            "id": "220160315",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Okay. Julie, let's get out of here. And fast...!",
            "nextDialogs": [
              "220160316"
            ]
          },
          "220160316": {
            "id": "220160316",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "W—Wait! We have to help Uncle Munehisa! He's fighting against Kairagi in the woods, all alone.",
            "nextDialogs": [
              "220160317"
            ]
          },
          "220160317": {
            "id": "220160317",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Kairagi? Not monsters? How did you get involved with them?",
            "nextDialogs": [
              "220160318"
            ]
          },
          "220160318": {
            "id": "220160318",
            "speakerId": 20269,
            "speakerName": "Julie",
            "text": "I—I'll tell you later... Let's go help him! He's all alone...",
            "nextDialogs": [
              "220160319"
            ]
          },
          "220160319": {
            "id": "220160319",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Alright, I got it. Traveler, could you come with us?"
          },
          "220160309": {
            "id": "220160309",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "Haha, great question. I had it specially cast at Hanfeng's Ironmongers.",
            "nextDialogs": [
              "220160310"
            ]
          },
          "220160310": {
            "id": "220160310",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "It's said to have materials excavated from the Chasm added to the iron. If you want to get one, go to Hanfeng's Ironmongers.",
            "nextDialogs": [
              "220160311"
            ]
          },
          "220160311": {
            "id": "220160311",
            "speakerId": 20268,
            "speakerName": "Xudong",
            "text": "But I heard that the Chasm has been locked down for a long time. I doubt he would be able to make any now..."
          },
          "220160313": {
            "id": "220160313",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Huh? Well... hahaha, I just threw a few books at the monster's heads. You were the one who fought them off.",
            "nextDialogs": [
              "220160314"
            ]
          },
          "220160314": {
            "id": "220160314",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Wait. Where is \"Along with Divinity Volume 6\"? Did I throw it, too? I haven't finished that one yet!"
          }
        }
      }
    },
    {
      "subId": "2201607",
      "subQuestName": "Look for traces of Kamei Munehisa up ahead",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220160701"
        ],
        "dialogs": {
          "220160701": {
            "id": "220160701",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "I can't believe those two...",
            "nextDialogs": [
              "220160703",
              "220160706",
              "220160714"
            ]
          },
          "220160703": {
            "id": "220160703",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "You mean Kamei Munehisa? Of course not... we've only met him a few times, how could I trust him so quickly?",
            "nextDialogs": [
              "220160704"
            ]
          },
          "220160704": {
            "id": "220160704",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "...But while I don't trust Kamei Munehisa, I do trust Xudong's judgment."
          },
          "220160706": {
            "id": "220160706",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Sort of. I was originally doing field research for the Akademiya when I met Xudong in Liyue.",
            "nextDialogs": [
              "220160707"
            ]
          },
          "220160707": {
            "id": "220160707",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "He was planning to travel around and study recipes, and the topic I was studying happened to be related to food. After we talked a few times, we decided to travel together.",
            "nextDialogs": [
              "220160708"
            ]
          },
          "220160708": {
            "id": "220160708",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "We first went to Mondstadt where we were surrounded by a bunch of monsters. That's when Julie came, and she helped us chase them away.",
            "nextDialogs": [
              "220160709"
            ]
          },
          "220160709": {
            "id": "220160709",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "When she heard that we were traveling around looking for different cuisine, she joined us.",
            "nextDialogs": [
              "220160710"
            ]
          },
          "220160710": {
            "id": "220160710",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "She said she was planning to go adventuring, but I have the feeling that she just wanted to have some good food...",
            "nextDialogs": [
              "220160711"
            ]
          },
          "220160711": {
            "id": "220160711",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "We'll be going to Sumeru next. I'm almost done with my research, so it's time for me to go back to Akademiya.",
            "nextDialogs": [
              "220160712"
            ]
          },
          "220160712": {
            "id": "220160712",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "When we get to Sumeru, I'll make sure they get a taste of our local specialties..."
          },
          "220160714": {
            "id": "220160714",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Okay, goodbye."
          }
        }
      }
    },
    {
      "subId": "2201608",
      "subQuestName": "Talk to Kamei Munehisa",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2201608",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220160801"
        ],
        "dialogs": {
          "220160801": {
            "id": "220160801",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "What is the matter?",
            "nextDialogs": [
              "220160803",
              "220160808",
              "220160815",
              "220160820"
            ]
          },
          "220160803": {
            "id": "220160803",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Like Xudong said, if I want to have enough to eat... working for him is my best option at the moment.",
            "nextDialogs": [
              "220160804"
            ]
          },
          "220160804": {
            "id": "220160804",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Besides, Julie and Xudong are both of high moral character, and it will be an honor to travel with them.",
            "nextDialogs": [
              "220160805"
            ]
          },
          "220160805": {
            "id": "220160805",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Parvaneh... is a thoughtful person. It is understandable she would be wary of me.",
            "nextDialogs": [
              "220160806"
            ]
          },
          "220160806": {
            "id": "220160806",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Besides, she is merely a little suspicious of me as opposed to rejecting me outright, and that... that is enough for me."
          },
          "220160808": {
            "id": "220160808",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Indeed. I would never lie. Since I left the Shogunate, I've been just wandering around.",
            "nextDialogs": [
              "220160809"
            ]
          },
          "220160809": {
            "id": "220160809",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I usually fill my stomach with wild fruits and, when I'm lucky, fresh game.",
            "nextDialogs": [
              "220160810"
            ]
          },
          "220160810": {
            "id": "220160810",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Occasionally, I also help people to fight off monsters or Kairagi, which gets me at least some payment.",
            "nextDialogs": [
              "220160811"
            ]
          },
          "220160811": {
            "id": "220160811",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Hehe... For someone like me who has no skills other than wielding a sword, job opportunities are a bit scarce.",
            "nextDialogs": [
              "220160812"
            ]
          },
          "220160812": {
            "id": "220160812",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Not to mention my background of leaving the Shogunate. People always associate me with the Kairagi, and that makes it even harder to find work.",
            "nextDialogs": [
              "220160813"
            ]
          },
          "220160813": {
            "id": "220160813",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I have no home or family to go to in Inazuma. Since I had nowhere to go, I just wandered."
          },
          "220160815": {
            "id": "220160815",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I just... couldn't agree with what the Shogunate was doing in Inazuma.",
            "nextDialogs": [
              "220160816"
            ]
          },
          "220160816": {
            "id": "220160816",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I'm just a martial artist. I don't know what's good for the country or not.",
            "nextDialogs": [
              "220160817"
            ]
          },
          "220160817": {
            "id": "220160817",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "I only knew that it went against what was in my heart, so I chose to leave.",
            "nextDialogs": [
              "220160818"
            ]
          },
          "220160818": {
            "id": "220160818",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Hehe. Perhaps I was just too old-fashioned... Please try not to laugh."
          },
          "220160820": {
            "id": "220160820",
            "speakerId": 20271,
            "speakerName": "Kamei Munehisa",
            "text": "Farewell."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7751101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "775110101"
        ],
        "dialogs": {
          "775110101": {
            "id": "775110101",
            "speakerId": 1000,
            "speakerName": "Match Commentator",
            "text": "To all the outstanding adventurers from across Teyvat — the first Adventurers' Tournament has officially come to an end.",
            "nextDialogs": [
              "775110102"
            ]
          },
          "775110102": {
            "id": "775110102",
            "speakerId": 1000,
            "speakerName": "Match Commentator",
            "text": "#The results are in, and the very title of \"legend\" has come to life: the unstoppable duo of {NICKNAME} and {M#his}{F#her} guide, Paimon, have claimed victory!",
            "nextDialogs": [
              "775110103"
            ]
          },
          "775110103": {
            "id": "775110103",
            "speakerId": 16438,
            "speakerName": "Sarin",
            "text": "Well done!",
            "nextDialogs": [
              "775110104"
            ]
          },
          "775110104": {
            "id": "775110104",
            "speakerId": 30531,
            "speakerName": "Valerina",
            "text": "Congratulations, you two!",
            "nextDialogs": [
              "775110105"
            ]
          },
          "775110105": {
            "id": "775110105",
            "speakerId": 16953,
            "speakerName": "Sukhrab",
            "text": "This mysterious senior... is someone I'll definitely be striving toward in the future...",
            "nextDialogs": [
              "775110106"
            ]
          },
          "775110106": {
            "id": "775110106",
            "speakerId": 16951,
            "speakerName": "Lan",
            "text": "If it were anyone else knocking me out of first place at the very last moment, I might've been a little sore about it.",
            "nextDialogs": [
              "775110107"
            ]
          },
          "775110107": {
            "id": "775110107",
            "speakerId": 16951,
            "speakerName": "Lan",
            "text": "But if it's you and Paimon? Then what's there to say? That just makes it worth celebrating!",
            "nextDialogs": [
              "775110108"
            ]
          },
          "775110108": {
            "id": "775110108",
            "speakerId": 17171,
            "speakerName": "Rika",
            "text": "Let's drink to that!",
            "nextDialogs": [
              "775110109"
            ]
          },
          "775110109": {
            "id": "775110109",
            "speakerId": 17015,
            "speakerName": "Talalikhin",
            "text": "Aside from the Mora reward, we've also prepared some commemorative items for you. Please wait a moment...",
            "nextDialogs": [
              "775110112"
            ]
          },
          "775110112": {
            "id": "775110112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Honestly, even though Paimon ended up joining this competition out of nowhere, and there weren't even that many spectators... well, it was a last-minute event, but Paimon still had a lot of fun!",
            "nextDialogs": [
              "775110113"
            ]
          },
          "775110113": {
            "id": "775110113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Besides, we also got some good practice in, and managed to sharpen those new skills we had just picked up!",
            "nextDialogs": [
              "775110114"
            ]
          },
          "775110114": {
            "id": "775110114",
            "speakerId": 17171,
            "speakerName": "Rika",
            "text": "Then what about the victory feast...?",
            "nextDialogs": [
              "775110115"
            ]
          },
          "775110115": {
            "id": "775110115",
            "speakerId": 1665,
            "speakerName": "Iris",
            "text": "We can talk about drinking later. The most important issue of this competition still hasn't been resolved.",
            "nextDialogs": [
              "775110116"
            ]
          },
          "775110116": {
            "id": "775110116",
            "speakerId": 17171,
            "speakerName": "Rika",
            "text": "Uh... Right. That's true.",
            "nextDialogs": [
              "775110117"
            ]
          },
          "775110117": {
            "id": "775110117",
            "speakerId": 16951,
            "speakerName": "Lan",
            "text": "Now that we have someone here who fully commands everyone's respect, the meeting we paused earlier should resume.",
            "nextDialogs": [
              "775110118"
            ]
          },
          "775110118": {
            "id": "775110118",
            "speakerId": 17015,
            "speakerName": "Talalikhin",
            "text": "#According to the rules, when voting on any proposal, {NICKNAME}'s vote carries the same weight as everyone else combined.",
            "nextDialogs": [
              "775110119"
            ]
          },
          "775110119": {
            "id": "775110119",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Combined... meaning added together... so in other words...",
            "nextDialogs": [
              "775110120"
            ]
          },
          "775110120": {
            "id": "775110120",
            "speakerId": 16951,
            "speakerName": "Lan",
            "text": "#{NICKNAME} has a single vote that can approve or veto decisions outright, and can even suggest modifications directly.",
            "nextDialogs": [
              "775110121"
            ]
          },
          "775110121": {
            "id": "775110121",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#So that's what it means to be the champion... At this point, anything {NICKNAME} says could influence hundreds or even thousands of adventurers."
          }
        }
      }
    },
    {
      "subId": "7751102",
      "subQuestName": "Go to the event venue",

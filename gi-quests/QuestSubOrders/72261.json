    {
      "subId": "7226106",
      "subQuestName": "Look for Kichiboushi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7226107",
      "subQuestName": "Talk to Kichiboushi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722610401"
        ],
        "dialogs": {
          "722610401": {
            "id": "722610401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Thank goodness we found you! Are you alright, Kichiboushi?",
            "nextDialogs": [
              "722610402"
            ]
          },
          "722610402": {
            "id": "722610402",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "*whimpers*",
            "nextDialogs": [
              "722610403"
            ]
          },
          "722610403": {
            "id": "722610403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Don't worry, it's okay. But don't run off by yourself next time, alright?",
            "nextDialogs": [
              "722610405",
              "722610409",
              "722610411"
            ]
          },
          "722610405": {
            "id": "722610405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's older than Kichiboushi. Of course Paimon's the big sister!",
            "nextDialogs": [
              "722610406"
            ]
          },
          "722610406": {
            "id": "722610406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Though I could hardly tell...",
            "nextDialogs": [
              "722610407"
            ]
          },
          "722610407": {
            "id": "722610407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey!",
            "nextDialogs": [
              "722610412"
            ]
          },
          "722610412": {
            "id": "722610412",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "#Mm-mm! Thank you, {NICKNAME}. Thank you, Paimon.",
            "nextDialogs": [
              "722610413"
            ]
          },
          "722610413": {
            "id": "722610413",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Kichiboushi, almost sealed! Very scary. But Paimon calling Kichiboushi, so not so scary.",
            "nextDialogs": [
              "722610414"
            ]
          },
          "722610414": {
            "id": "722610414",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, right, Ioroi did say that some smaller tanuki were also sealed...",
            "nextDialogs": [
              "722610415"
            ]
          },
          "722610415": {
            "id": "722610415",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Inside amber, very scary. Dark, cannot see. Cannot talk. Cannot move. Cannot \"kapow\"! Like becoming stone.",
            "nextDialogs": [
              "722610416"
            ]
          },
          "722610416": {
            "id": "722610416",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Ioroi is stone, but still very powerful. Can talk, can see. But cannot move."
          },
          "722610409": {
            "id": "722610409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What!?"
          },
          "722610411": {
            "id": "722610411",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#\"Ooh, {NICKNAME}, you've got to eat more. You're still growing! How will you grow unless you eat more?\""
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "7226101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722610101"
        ],
        "dialogs": {
          "722610101": {
            "id": "722610101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hello— Mountain Shaper—!",
            "nextDialogs": [
              "722610102"
            ]
          },
          "722610102": {
            "id": "722610102",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "Hello— Mon-Mon—",
            "nextDialogs": [
              "722610103"
            ]
          },
          "722610103": {
            "id": "722610103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "722610104"
            ]
          },
          "722610104": {
            "id": "722610104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Argh, seems like the adeptus isn't at home...",
            "nextDialogs": [
              "722610105"
            ]
          },
          "722610105": {
            "id": "722610105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's not be impolite to the adepti, now.",
            "nextDialogs": [
              "722610106"
            ]
          },
          "722610106": {
            "id": "722610106",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "Paimon, what are adepti?",
            "nextDialogs": [
              "722610107"
            ]
          },
          "722610107": {
            "id": "722610107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... They're very special people... Or very special animals?",
            "nextDialogs": [
              "722610108"
            ]
          },
          "722610108": {
            "id": "722610108",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "Like Kichiboushi?",
            "nextDialogs": [
              "722610109"
            ]
          },
          "722610109": {
            "id": "722610109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, not exactly! They have mystical powers...",
            "nextDialogs": [
              "722610110"
            ]
          },
          "722610110": {
            "id": "722610110",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "They can \"kapow\"? Then, Kichiboushi also adeptus.",
            "nextDialogs": [
              "722610111"
            ]
          },
          "722610111": {
            "id": "722610111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um, adepti are much more ancient, and they have a certain... Prestige? Dignity?",
            "nextDialogs": [
              "722610112"
            ]
          },
          "722610112": {
            "id": "722610112",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "Oh. Then Kichiboushi, not adeptus. Ioroi is adeptus!",
            "nextDialogs": [
              "722610113"
            ]
          },
          "722610113": {
            "id": "722610113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, this is pretty hard to explain.",
            "nextDialogs": [
              "722610114"
            ]
          },
          "722610114": {
            "id": "722610114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The adepti are ancient powers who defend Liyue.",
            "nextDialogs": [
              "722610115"
            ]
          },
          "722610115": {
            "id": "722610115",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "Kichiboushi understands. Ioroi protects Chinju Forest, so not adeptus.",
            "nextDialogs": [
              "722610116"
            ]
          },
          "722610116": {
            "id": "722610116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's pretty sure that's not how it works, but if it clears up any misunderstandings...",
            "nextDialogs": [
              "722610117"
            ]
          },
          "722610117": {
            "id": "722610117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But since we've got this adeptus' abode in front of us, let's take a picture of Kichiboushi right here!",
            "nextDialogs": [
              "722610118"
            ]
          },
          "722610118": {
            "id": "722610118",
            "speakerId": 15132,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm! Kichiboushi, pose for picture!",
            "nextDialogs": [
              "722610119"
            ]
          },
          "722610119": {
            "id": "722610119",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Good Kichiboushi!"
          }
        }
      }
    },
    {

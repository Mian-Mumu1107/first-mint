{
  "lineCounts": {
    "\"Boatman\"": 20,
    "Player": 7
  },
  "subQuests": [
    {
      "subId": "7217401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740101"
        ],
        "dialogs": {
          "721740101": {
            "id": "721740101",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "The near side of the river, hey! The cypress painted silver, hoi! The silver wormwood on the ground, the silver stones lie all around...",
            "nextDialogs": [
              "721740104"
            ]
          },
          "721740104": {
            "id": "721740104",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "Oho, who have we here? Guests? Here to board the boat, perhaps?",
            "nextDialogs": [
              "721740105"
            ]
          },
          "721740105": {
            "id": "721740105",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "Ai yai yai, but let's see, now let's see... Oh, you seem like outsiders. That won't do, no, that won't do..."
          }
        }
      }
    },
    {
      "subId": "7217402",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740201"
        ],
        "dialogs": {
          "721740201": {
            "id": "721740201",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "Now I spy, with my little eye... A grandmother missing her grandchildren. She cannot put them down, no she cannot, and she cannot board the boat!"
          }
        }
      }
    },
    {
      "subId": "7217403",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721741001"
        ],
        "dialogs": {
          "721741001": {
            "id": "721741001",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "They have all come, ya-ho, ya-hey, we have our merry cast...",
            "nextDialogs": [
              "721741002"
            ]
          },
          "721741002": {
            "id": "721741002",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "Thank you, fair outlander, ho! We set off now at last...",
            "nextDialogs": [
              "721741003"
            ]
          },
          "721741003": {
            "id": "721741003",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "The far side of the river, hey! The golden oak is yonder, hoi! The golden wormwood on the ground, the golden stones lie all around...",
            "nextDialogs": [
              "721741004"
            ]
          },
          "721741004": {
            "id": "721741004",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "The sights are lovely as can be, much further than the eye can see..."
          }
        }
      }
    },
    {
      "subId": "7217404",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740401"
        ],
        "dialogs": {
          "721740401": {
            "id": "721740401",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "Ah, there, yes there too indeed. One who has grown too swift and wild, but whose soul is yet that of a child. One playful in a funny way, who forgot to board the boat today..."
          }
        }
      }
    },
    {
      "subId": "7217403",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740301"
        ],
        "dialogs": {
          "721740301": {
            "id": "721740301",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "I spy the dear little children, who dearly miss their grandmother. A shame yes, a pity indeed, that they cannot board the boat."
          }
        }
      }
    },
    {
      "subId": "7217405",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740501"
        ],
        "dialogs": {
          "721740501": {
            "id": "721740501",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "The silver shining moon, yah-hey, the silver gleaming hearts, yah-ho... Those who guard the foggy plain, fain not in yon misty woods remain. Aye, board the boat, yes, board the boat!"
          }
        }
      }
    },
    {
      "subId": "7217406",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740601"
        ],
        "dialogs": {
          "721740601": {
            "id": "721740601",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "Ye old who linger on things yet strange and new, let us return, let us return, to the golden halls upon the moon."
          }
        }
      }
    },
    {
      "subId": "7217407",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740701"
        ],
        "dialogs": {
          "721740701": {
            "id": "721740701",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "The child who picks shells by the shore, come, board the boat! The brother you knew has left his forebears' souls to seek a life on the far shore. Forget him now, forget the pain of parting..."
          }
        }
      }
    },
    {
      "subId": "7217408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740801"
        ],
        "dialogs": {
          "721740801": {
            "id": "721740801",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "And you, child lingering by the shore, pray, what more have you lost? Come, now, board quickly now, be not nostalgia-crossed."
          }
        }
      }
    },
    {
      "subId": "7217411",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721741101"
        ],
        "dialogs": {
          "721741101": {
            "id": "721741101",
            "speakerId": 20431,
            "speakerName": "\"Boatman\"",
            "text": "Lost, lonely, little child, are you playing on your own? Come now, come sail away, to a land where none play alone."
          }
        }
      }
    }
  ]
}
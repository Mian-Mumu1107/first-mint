  "subQuests": [
    {
      "subId": "4012316",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401231601"
        ],
        "dialogs": {
          "401231601": {
            "id": "401231601",
            "speakerId": 2111,
            "speakerName": "Aunt Qiao",
            "text": "Even Stone Gate is bustling now... Haha, now that's a sight!",
            "nextDialogs": [
              "401231602"
            ]
          },
          "401231602": {
            "id": "401231602",
            "speakerId": 2111,
            "speakerName": "Aunt Qiao",
            "text": "You look weary, child. Why not take a rest?"
          }
        }
      }
    },
    {
      "subId": "4012317",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401231701"
        ],
        "dialogs": {
          "401231701": {
            "id": "401231701",
            "speakerId": 2404,
            "speakerName": "Pops Zhou",
            "text": "Haha, young folks these days... Always brimming with new ideas.",
            "nextDialogs": [
              "401231702"
            ]
          },
          "401231702": {
            "id": "401231702",
            "speakerId": 2404,
            "speakerName": "Pops Zhou",
            "text": "A poetry gala... Ah, thinking back on my youth, I certainly had stories I could put to paper back then...",
            "nextDialogs": [
              "401231703"
            ]
          },
          "401231703": {
            "id": "401231703",
            "speakerId": 2404,
            "speakerName": "Pops Zhou",
            "text": "*sigh* ...The world is eternal, but youth is ephemeral..."
          }
        }
      }
    },
    {
      "subId": "4012621",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262101"
        ],
        "dialogs": {
          "401262101": {
            "id": "401262101",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "Now then, didn't you say you wanted to publish a book?",
            "nextDialogs": [
              "401262102"
            ]
          },
          "401262102": {
            "id": "401262102",
            "speakerId": 1021,
            "speakerName": "Hu Tao",
            "text": "Yes, I do.",
            "nextDialogs": [
              "401262103"
            ]
          },
          "401262103": {
            "id": "401262103",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "...So where's the book?",
            "nextDialogs": [
              "401262104"
            ]
          },
          "401262104": {
            "id": "401262104",
            "speakerId": 1021,
            "speakerName": "Hu Tao",
            "text": "It's in the works! Just waiting on the poems!",
            "nextDialogs": [
              "401262105"
            ]
          },
          "401262105": {
            "id": "401262105",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "...And where are the poems?",
            "nextDialogs": [
              "401262106"
            ]
          },
          "401262106": {
            "id": "401262106",
            "speakerId": 1021,
            "speakerName": "Hu Tao",
            "text": "They're on the way.",
            "nextDialogs": [
              "401262107"
            ]
          },
          "401262107": {
            "id": "401262107",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "...Look, I'm sorry Director Hu, but how do you expect me to talk business with you when you don't even have the poems yet?",
            "nextDialogs": [
              "401262108"
            ]
          },
          "401262108": {
            "id": "401262108",
            "speakerId": 1021,
            "speakerName": "Hu Tao",
            "text": "I just figured while we're waiting, we could discuss terms in advance.",
            "nextDialogs": [
              "401262109"
            ]
          },
          "401262109": {
            "id": "401262109",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "Well, I need to see the content to decide if I even want to sell it, let alone how much to sell it for.",
            "nextDialogs": [
              "401262110"
            ]
          },
          "401262110": {
            "id": "401262110",
            "speakerId": 1021,
            "speakerName": "Hu Tao",
            "text": "Oh, come on, I showed you a sample already, and it was some of my finest work! Besides, you only need a few highlights to sell an anthology!",
            "nextDialogs": [
              "401262111"
            ]
          },
          "401262111": {
            "id": "401262111",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "...You think your poem, \"Fifteen Tenderloin Steaks\" will carry the whole book, do you?",
            "nextDialogs": [
              "401262112"
            ]
          },
          "401262112": {
            "id": "401262112",
            "speakerId": 1021,
            "speakerName": "Hu Tao",
            "text": "That and \"Square Meals In the Basement\"! My consultant, the erudite Mr. Zhongli, described it as a meticulous masterpiece! Ooh — quote that on the cover! It'll practically sell itself!",
            "nextDialogs": [
              "401262113"
            ]
          },
          "401262113": {
            "id": "401262113",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "...Director, we're a small business. If we invest money in printing and nobody buys it, it's my bottom line that's affected.",
            "nextDialogs": [
              "401262114"
            ]
          },
          "401262114": {
            "id": "401262114",
            "speakerId": 1021,
            "speakerName": "Hu Tao",
            "text": "Don't you worry! I guarantee you, when this anthology comes out, it will take the world by storm! Gods and ghosts alike will weep!",
            "nextDialogs": [
              "401262115"
            ]
          },
          "401262115": {
            "id": "401262115",
            "speakerId": 1021,
            "speakerName": "Hu Tao",
            "text": "As a matter of fact, I heard a ghost crying on the way here. If you don't believe me, I can bring it over?",
            "nextDialogs": [
              "401262116"
            ]
          },
          "401262116": {
            "id": "401262116",
            "speakerId": 1625,
            "speakerName": "Jifang",
            "text": "...There'll be no need for that."
          }
        }
      }
    },
    {
      "subId": "4012622",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262201"
        ],
        "dialogs": {
          "401262201": {
            "id": "401262201",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "...It's you.",
            "nextDialogs": [
              "401262202"
            ]
          },
          "401262202": {
            "id": "401262202",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "...",
            "nextDialogs": [
              "401262203"
            ]
          },
          "401262203": {
            "id": "401262203",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "I thought about what you said... and tried to write a poem.",
            "nextDialogs": [
              "401262204"
            ]
          },
          "401262204": {
            "id": "401262204",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "After putting my feelings onto paper, my heart feels much calmer...",
            "nextDialogs": [
              "401262205"
            ]
          },
          "401262205": {
            "id": "401262205",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Can they... really hear it...?"
          }
        }
      }
    },
    {
      "subId": "4012623",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262302"
        ],
        "dialogs": {
          "401262302": {
            "id": "401262302",
            "speakerId": 13495,
            "speakerName": "(Listen...)",
            "text": "(A happy melody...)"
          }
        }
      }
    },
    {
      "subId": "4012624",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262401"
        ],
        "dialogs": {
          "401262401": {
            "id": "401262401",
            "speakerId": 30396,
            "speakerName": "Huanxi",
            "text": "It's nice to have a chance to write poetry with our friends from Mondstadt.",
            "nextDialogs": [
              "401262402"
            ]
          },
          "401262402": {
            "id": "401262402",
            "speakerId": 30396,
            "speakerName": "Huanxi",
            "text": "But simply standing at the venue gets boring, so I brought some fruits and vegetables from my hometown to sell.",
            "nextDialogs": [
              "401262403"
            ]
          },
          "401262403": {
            "id": "401262403",
            "speakerId": 30396,
            "speakerName": "Huanxi",
            "text": "Oh, but if you're looking to talk about poetry, I'm all ears."
          }
        }
      }
    },
    {
      "subId": "4012625",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262501"
        ],
        "dialogs": {
          "401262501": {
            "id": "401262501",
            "speakerId": 30397,
            "speakerName": "Levin",
            "text": "I heard that they specially sent someone over from The Cat's Tail as the mixologist for this event.",
            "nextDialogs": [
              "401262502"
            ]
          },
          "401262502": {
            "id": "401262502",
            "speakerId": 30397,
            "speakerName": "Levin",
            "text": "I've never really visited, since it's always so crowded in there, but I'm dying to try just how good their drinks are."
          }
        }
      }
    },
    {
      "subId": "4012626",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262601"
        ],
        "dialogs": {
          "401262601": {
            "id": "401262601",
            "speakerId": 30433,
            "speakerName": "Jochen",
            "text": "Please take a seat wherever you like. Enjoy the scenery, write a poem or two, and top it off with the finest drinks.",
            "nextDialogs": [
              "401262602"
            ]
          },
          "401262602": {
            "id": "401262602",
            "speakerId": 30433,
            "speakerName": "Jochen",
            "text": "...Huh, people in Liyue and Mondstadt sure have similar ways to pass the time."
          }
        }
      }
    },
    {
      "subId": "4012628",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262801"
        ],
        "dialogs": {
          "401262801": {
            "id": "401262801",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "I think the answer to the riddle on the left is \"Glaze Lily.\"",
            "nextDialogs": [
              "401262802"
            ]
          },
          "401262802": {
            "id": "401262802",
            "speakerId": 1010,
            "speakerName": "Reply",
            "text": "But according to the riddle, these flowers were once everywhere... Were there really that many Glaze Lilies?",
            "nextDialogs": [
              "401262803"
            ]
          },
          "401262803": {
            "id": "401262803",
            "speakerId": 1010,
            "speakerName": "Reply",
            "text": "What about Mint? The poem did say something about the plant being fragrant.",
            "nextDialogs": [
              "401262804"
            ]
          },
          "401262804": {
            "id": "401262804",
            "speakerId": 1010,
            "speakerName": "Reply",
            "text": "I still think Glaze Lilies fit the description better.",
            "nextDialogs": [
              "401262805"
            ]
          },
          "401262805": {
            "id": "401262805",
            "speakerId": 1010,
            "speakerName": "Reply",
            "text": "Has anyone solved the riddle on the right? I'm running out of ideas. Wait, could it be something I've never seen before?",
            "nextDialogs": [
              "401262806"
            ]
          },
          "401262806": {
            "id": "401262806",
            "speakerId": 1010,
            "speakerName": "Reply",
            "text": "I know what it is, but I'm afraid I'm not at liberty to tell...",
            "nextDialogs": [
              "401262807"
            ]
          },
          "401262807": {
            "id": "401262807",
            "speakerId": 1010,
            "speakerName": "Reply",
            "text": "C'mon, it's just the answer to a riddle!"
          }
        }
      }
    },
    {
      "subId": "4012629",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262901"
        ],
        "dialogs": {
          "401262901": {
            "id": "401262901",
            "speakerId": 1011,
            "speakerName": "Revealed Riddle Answer",
            "text": "Glaze Lilies, Golden Raven Insignia."
          }
        }
      }
    },
    {
      "subId": "4012630",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401263001"
        ],
        "dialogs": {
          "401263001": {
            "id": "401263001",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "If I remember correctly, Liyue's couplets can be quite difficult to write...",
            "nextDialogs": [
              "401263002"
            ]
          },
          "401263002": {
            "id": "401263002",
            "speakerId": 1010,
            "speakerName": "Reply",
            "text": "Yeah, it's harder if you follow the rules and try to match every word.",
            "nextDialogs": [
              "401263003"
            ]
          },
          "401263003": {
            "id": "401263003",
            "speakerId": 1010,
            "speakerName": "Reply",
            "text": "Apart from having exactly the same number of syllables, you have to take note of certain tonal patterns and make the words rhyme...",
            "nextDialogs": [
              "401263004"
            ]
          },
          "401263004": {
            "id": "401263004",
            "speakerId": 1010,
            "speakerName": "Reply",
            "text": "Anyway, it's a rare opportunity to have guests visiting from Mondstadt, so let's all just enjoy ourselves."
          }
        }
      }
    },
    {
      "subId": "4012631",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401263101"
        ],
        "dialogs": {
          "401263101": {
            "id": "401263101",
            "speakerId": 1012,
            "speakerName": "Someone's Poem",
            "text": "\"I want to be a mushroom. Not blue like a lake, nor reflecting the moon.\"",
            "nextDialogs": [
              "401263102"
            ]
          },
          "401263102": {
            "id": "401263102",
            "speakerId": 1012,
            "speakerName": "Someone's Poem",
            "text": "\"I just want to be an ordinary mushroom, a mushroom no one bothers to pick.\"",
            "nextDialogs": [
              "401263103"
            ]
          },
          "401263103": {
            "id": "401263103",
            "speakerId": 1012,
            "speakerName": "Someone's Poem",
            "text": "\"I want to hide within the foot of the tree, unless a forest boar happens to discover me. Then it'll put me atop its head, as if I'm a crown of flowers made.\"",
            "nextDialogs": [
              "401263104"
            ]
          },
          "401263104": {
            "id": "401263104",
            "speakerId": 1012,
            "speakerName": "Someone's Poem",
            "text": "\"You see, I didn't want this fungal metamorphosis, because it's just an excuse for loneliness.\""
          }
        }
      }
    },
    {
      "subId": "4012632",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401263201"
        ],
        "dialogs": {
          "401263201": {
            "id": "401263201",
            "speakerId": 1012,
            "speakerName": "Someone's Poem",
            "text": "\"Color the lyre-strings like a rainbow. Pitter-patter, pitter-patter.\"",
            "nextDialogs": [
              "401263202"
            ]
          },
          "401263202": {
            "id": "401263202",
            "speakerId": 1012,
            "speakerName": "Someone's Poem",
            "text": "\"Even the leaves taste sweet whenever rain falls.\""
          }
        }
      }
    },
    {
      "subId": "7152102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715210201"
        ],
        "dialogs": {
          "715210201": {
            "id": "715210201",
            "speakerId": 30424,
            "speakerName": "Batlo",
            "text": "This is the spot where the painting needs to be restored...",
            "nextDialogs": [
              "715210202"
            ]
          },
          "715210202": {
            "id": "715210202",
            "speakerId": 30424,
            "speakerName": "Batlo",
            "text": "#{NICKNAME}! I'm so happy to see you again. Thanks again for helping me track down the original scenery.",
            "nextDialogs": [
              "715210203"
            ]
          },
          "715210203": {
            "id": "715210203",
            "speakerId": 30424,
            "speakerName": "Batlo",
            "text": "With your help, surely I can restore these paintings more efficiently."
          }
        }
      }
    },
    {
      "subId": "7152202",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715220201"
        ],
        "dialogs": {
          "715220201": {
            "id": "715220201",
            "speakerId": 30425,
            "speakerName": "Buies",
            "text": "So? Do you want to find some inspiration?",
            "nextDialogs": [
              "715220203",
              "715220205"
            ]
          },
          "715220203": {
            "id": "715220203",
            "speakerId": 30425,
            "speakerName": "Buies",
            "text": "Sure thing. This way. Prepare to be inspired!"
          },
          "715220205": {
            "id": "715220205",
            "speakerId": 30425,
            "speakerName": "Buies",
            "text": "Very well. Come find me when you want to try."
          }
        }
      }
    },
    {
      "subId": "7152302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715230201"
        ],
        "dialogs": {
          "715230201": {
            "id": "715230201",
            "speakerId": 30426,
            "speakerName": "Ting Zhi",
            "text": "Do you want to try playing Hundred-Pace Hurling Rites?",
            "nextDialogs": [
              "715230203",
              "715230205"
            ]
          },
          "715230203": {
            "id": "715230203",
            "speakerId": 30426,
            "speakerName": "Ting Zhi",
            "text": "Here are your Darts, and the pots are over there."
          },
          "715230205": {
            "id": "715230205",
            "speakerId": 30426,
            "speakerName": "Ting Zhi",
            "text": "No problem. I have everything set up already. Just drop by when you want to try."
          }
        }
      }
    }
  ]
}
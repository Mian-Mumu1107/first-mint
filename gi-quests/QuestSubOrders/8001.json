    {
      "subId": "800108",
      "subQuestName": "Talk to Dainsleif",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80010501"
        ],
        "dialogs": {
          "80010501": {
            "id": "80010501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Over there! It's more Ruin Guards and Abyss Mages.",
            "nextDialogs": [
              "80010502"
            ]
          },
          "80010502": {
            "id": "80010502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Dain was just saying how these ancient machines are from Khaenri'ah...",
            "nextDialogs": [
              "80010503"
            ]
          },
          "80010503": {
            "id": "80010503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So... did Khaenri'ah have a lot of ruins that needed to be guarded?",
            "nextDialogs": [
              "80010504"
            ]
          },
          "80010504": {
            "id": "80010504",
            "speakerId": 1000,
            "speakerName": "Dainsleif",
            "text": "No. \"Ruin Guard\" is the name modern people have given these machines. No one called them that 500 years ago.",
            "nextDialogs": [
              "80010505"
            ]
          },
          "80010505": {
            "id": "80010505",
            "speakerId": 1000,
            "speakerName": "Dainsleif",
            "text": "These \"Ruin Guards\" were known as \"Field Tillers\" by the people of Khaenri'ah.",
            "nextDialogs": [
              "80010506"
            ]
          },
          "80010506": {
            "id": "80010506",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"Field Tillers\"? What a strange name.",
            "nextDialogs": [
              "80010509"
            ]
          },
          "80010509": {
            "id": "80010509",
            "speakerId": 1000,
            "speakerName": "Dainsleif",
            "text": "It's not like you think. \"Field Tiller\" was just a code name. The people of Khaenri'ah liked to give code names to their weapons.",
            "nextDialogs": [
              "80010510"
            ]
          },
          "80010510": {
            "id": "80010510",
            "speakerId": 1000,
            "speakerName": "Dainsleif",
            "text": "\"The land is not to be tilled with farming tools, but rather is to be fought for with steel and blood.\" —This is how the \"Field Tiller\" came about.",
            "nextDialogs": [
              "80010511"
            ]
          },
          "80010511": {
            "id": "80010511",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"Fought for with steel and blood\"? Well that's an interesting way of understanding \"tilling\"... Paimon doesn't think it's a very positive interpretation.",
            "nextDialogs": [
              "80010512"
            ]
          },
          "80010512": {
            "id": "80010512",
            "speakerId": 1000,
            "speakerName": "Dainsleif",
            "text": "...",
            "nextDialogs": [
              "80010513"
            ]
          },
          "80010513": {
            "id": "80010513",
            "speakerId": 1000,
            "speakerName": "Dainsleif",
            "text": "After the destruction of Khaenri'ah, these masterless \"Field Tillers\" went completely out of control.",
            "nextDialogs": [
              "80010514"
            ]
          },
          "80010514": {
            "id": "80010514",
            "speakerId": 1000,
            "speakerName": "Dainsleif",
            "text": "They wandered aimlessly over the centuries, gradually spreading to every corner of Teyvat.",
            "nextDialogs": [
              "80010515"
            ]
          },
          "80010515": {
            "id": "80010515",
            "speakerId": 1000,
            "speakerName": "Dainsleif",
            "text": "Perhaps resonating with the sorrow of other civilizations lost to time, they found their way to various ruins across the land, where they lie dormant.",
            "nextDialogs": [
              "80010516"
            ]
          },
          "80010516": {
            "id": "80010516",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That sounds... so sad..."
          }
        }
      }
    },

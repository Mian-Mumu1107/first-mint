    {
      "subId": "2300920",
      "subQuestName": "Talk to Akim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230092001"
        ],
        "dialogs": {
          "230092001": {
            "id": "230092001",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "This is exactly what I'm looking for! Thank you so much.",
            "nextDialogs": [
              "230092002"
            ]
          },
          "230092002": {
            "id": "230092002",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Please take these as your reward.",
            "nextDialogs": [
              "230092003"
            ]
          },
          "230092003": {
            "id": "230092003",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Well... as fertile as it is, this soil is pretty weighty, and it doesn't seem to have great permeability...",
            "nextDialogs": [
              "230092004"
            ]
          },
          "230092004": {
            "id": "230092004",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Hmm... I'd better mix it with some other soil types..."
          }
        }
      }
    },
    {
      "subId": "2300914",
      "subQuestName": "Talk to Akim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230091401"
        ],
        "dialogs": {
          "230091401": {
            "id": "230091401",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Ugh, this is awful. Where did I go wrong...",
            "nextDialogs": [
              "230091402"
            ]
          },
          "230091402": {
            "id": "230091402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's going on?",
            "nextDialogs": [
              "230091403"
            ]
          },
          "230091403": {
            "id": "230091403",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Ah! It's... it's you, Traveler...",
            "nextDialogs": [
              "230091404"
            ]
          },
          "230091404": {
            "id": "230091404",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "*sigh* There's something wrong with my Concresoil...",
            "nextDialogs": [
              "230091405"
            ]
          },
          "230091405": {
            "id": "230091405",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Was it the mix ratio? Or the lack of experimental trials...",
            "nextDialogs": [
              "230091406"
            ]
          },
          "230091406": {
            "id": "230091406",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Many customers who have built their kitchens using Concresoil have reported cracking after only a few days.",
            "nextDialogs": [
              "230091407"
            ]
          },
          "230091407": {
            "id": "230091407",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Perhaps the temperature grew so high that some parts of the soil just failed to work?",

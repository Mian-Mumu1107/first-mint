          "230091409": {
            "id": "230091409",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "There were too many people needing repairs for me to take all the scraped Concresoil away, so I asked them to just keep it in some pots. And ah, there were very many pots indeed...",

  "subQuests": [
    {
      "subId": "2300902",
      "subQuestName": "Talk to Akim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230090201"
        ],
        "dialogs": {
          "230090201": {
            "id": "230090201",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "I still need more materials...",
            "nextDialogs": [
              "230090202"
            ]
          },
          "230090202": {
            "id": "230090202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How's your Concresoil coming along?",
            "nextDialogs": [
              "230090203"
            ]
          },
          "230090203": {
            "id": "230090203",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Amazing, actually! As it turns out, this soil can be used for a wide variety of purposes.",
            "nextDialogs": [
              "230090204"
            ]
          },
          "230090204": {
            "id": "230090204",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "For example, it can be used to make pottery and fix cracks in houses.",
            "nextDialogs": [
              "230090205"
            ]
          },
          "230090205": {
            "id": "230090205",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "With a small adjustment of the mix ratio, I can even build houses with this soil.",
            "nextDialogs": [
              "230090206"
            ]
          },
          "230090206": {
            "id": "230090206",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "However... I'm running low on materials due to a surge in orders.",
            "nextDialogs": [
              "230090207"
            ]
          },
          "230090207": {
            "id": "230090207",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Critically, I've ran out of Slime Condensate. Traveler, could you please bring me three more portions of Slime Condensate?",
            "nextDialogs": [
              "230090212",
              "230090210"
            ]
          },
          "230090212": {
            "id": "230090212",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "So, Traveler, could you please fetch three more portions of Slime Condensate for me?"
          },
          "230090210": {
            "id": "230090210",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "I have made purchases from different channels or asked others for help.",
            "nextDialogs": [
              "230090211"
            ]
          },
          "230090211": {
            "id": "230090211",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "I just didn't expect that Slime Condensate could run out so quickly..."
          }
        }
      }
    },
    {
      "subId": "2300903",
      "subQuestName": "Give three portions of Slime Condensate to Akim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230090301"
        ],
        "dialogs": {
          "230090301": {
            "id": "230090301",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Traveler, have you obtained the Slime Condensate?"
          }
        }
      }
    },
    {
      "subId": "2300917",
      "subQuestName": "Keep talking to Akim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230091701"
        ],
        "dialogs": {
          "230091701": {
            "id": "230091701",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Thank you. Then I have all the materials I need for now.",
            "nextDialogs": [
              "230091702"
            ]
          },
          "230091702": {
            "id": "230091702",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Give me a second while I mix the Concresoil...",
            "nextDialogs": [
              "230091703"
            ]
          },
          "230091703": {
            "id": "230091703",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Akim starts to mix the soil...",
            "nextDialogs": [
              "230091704"
            ]
          },
          "230091704": {
            "id": "230091704",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Okay, it's done. Please take the soil to Nima.",
            "nextDialogs": [
              "230091705"
            ]
          },
          "230091705": {
            "id": "230091705",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "He has been waiting for it for ages.",
            "nextDialogs": [
              "230091706"
            ]
          },
          "230091706": {
            "id": "230091706",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "This child is... um... unusually imaginative.",
            "nextDialogs": [
              "230091707"
            ]
          },
          "230091707": {
            "id": "230091707",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Nima told me he wanted to make a group of talking \"pot warriors\" that can roll over enemies and have all sorts of magical powers.",
            "nextDialogs": [
              "230091708"
            ]
          },
          "230091708": {
            "id": "230091708",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "The power of these warriors will vary with the materials stuffed in their pot bodies.",
            "nextDialogs": [
              "230091709"
            ]
          },
          "230091709": {
            "id": "230091709",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "He even gave these pot warriors a name, called Ad... Well, forget it, I don't remember.",
            "nextDialogs": [
              "230091710"
            ]
          },
          "230091710": {
            "id": "230091710",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Unfortunately, I can't really make pot warriors with magical powers. But still, it's an interesting idea.",
            "nextDialogs": [
              "230091711"
            ]
          },
          "230091711": {
            "id": "230091711",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "So I thought, why not give him the soil as a toy gift?",
            "nextDialogs": [
              "230091712"
            ]
          },
          "230091712": {
            "id": "230091712",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "This way, he can make his own pot warriors and command them like a general!",
            "nextDialogs": [
              "230091713"
            ]
          },
          "230091713": {
            "id": "230091713",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Ahem, anyway, please help me send this pot of soil to Nima.",
            "nextDialogs": [
              "230091714"
            ]
          },
          "230091714": {
            "id": "230091714",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Once his pot warriors are complete, maybe he will appoint us both \"pot generals\" as well!"
          }
        }
      }
    },
    {
      "subId": "2300904",
      "subQuestName": "Give the soil to Nima",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230090401"
        ],
        "dialogs": {
          "230090401": {
            "id": "230090401",
            "speakerId": 4103,
            "speakerName": "Nima",
            "text": "#Hello, {F#Miss}{M#Mister}, what can I do for you?"
          }
        }
      }
    },
    {
      "subId": "2300918",
      "subQuestName": "Keep talking to Nima",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230091801"
        ],
        "dialogs": {
          "230091801": {
            "id": "230091801",
            "speakerId": 4103,
            "speakerName": "Nima",
            "text": "Wow, this must be the soil that can make everything. Just like Akim told me!",
            "nextDialogs": [
              "230091802"
            ]
          },
          "230091802": {
            "id": "230091802",
            "speakerId": 4103,
            "speakerName": "Nima",
            "text": "#Yay! Thank you, {M#Mister}{F#Miss}!",
            "nextDialogs": [
              "230091803"
            ]
          },
          "230091803": {
            "id": "230091803",
            "speakerId": 4103,
            "speakerName": "Nima",
            "text": "Now I can make \"Adri\"!",
            "nextDialogs": [
              "230091804"
            ]
          },
          "230091804": {
            "id": "230091804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What is Adri, anyway?",
            "nextDialogs": [
              "230091805"
            ]
          },
          "230091805": {
            "id": "230091805",
            "speakerId": 4103,
            "speakerName": "Nima",
            "text": "#Didn't Akim tell you about it, {M#Mister}{F#Miss}?",
            "nextDialogs": [
              "230091806"
            ]
          },
          "230091806": {
            "id": "230091806",
            "speakerId": 4103,
            "speakerName": "Nima",
            "text": "I'm making some pot warriors. Adri is gonna be the first and the best of them!",
            "nextDialogs": [
              "230091807"
            ]
          },
          "230091807": {
            "id": "230091807",
            "speakerId": 4103,
            "speakerName": "Nima",
            "text": "He is a kind warrior with a good temper. When he awakens as a pot warrior, the first thing he will do is to apologize to the grass under him.",
            "nextDialogs": [
              "230091808"
            ]
          },
          "230091808": {
            "id": "230091808",
            "speakerId": 4103,
            "speakerName": "Nima",
            "text": "His power is... is...",
            "nextDialogs": [
              "230091809"
            ]
          },
          "230091809": {
            "id": "230091809",
            "speakerId": 4103,
            "speakerName": "Nima",
            "text": "I—I haven't decided on it yet... but you'll be the first to know once I have!",
            "nextDialogs": [
              "230091810"
            ]
          },
          "230091810": {
            "id": "230091810",
            "speakerId": 4103,
            "speakerName": "Nima",
            "text": "After Adri is done, I'll make Ivar, his adjutant, and Lasson, his disciple.",
            "nextDialogs": [
              "230091811"
            ]
          },
          "230091811": {
            "id": "230091811",
            "speakerId": 4103,
            "speakerName": "Nima",
            "text": "The three of them... no, the three pot warriors... They will embark on a long, long journey..."
          }
        }
      }
    },
    {
      "subId": "2300908",
      "subQuestName": "Talk to Akim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230090801"
        ],
        "dialogs": {
          "230090801": {
            "id": "230090801",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "I still need more materials...",
            "nextDialogs": [
              "230090802"
            ]
          },
          "230090802": {
            "id": "230090802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How's your Concresoil coming along?",
            "nextDialogs": [
              "230090803"
            ]
          },
          "230090803": {
            "id": "230090803",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Amazing, actually! As it turns out, this soil can be used for a wide variety of purposes.",
            "nextDialogs": [
              "230090804"
            ]
          },
          "230090804": {
            "id": "230090804",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "For example, it can be used to make pottery and fix cracks in houses.",
            "nextDialogs": [
              "230090805"
            ]
          },
          "230090805": {
            "id": "230090805",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "By making small adjustment to the mix ratio, I can even build houses with this soil.",
            "nextDialogs": [
              "230090806"
            ]
          },
          "230090806": {
            "id": "230090806",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "However... I'm running low on materials due to a surge in orders.",
            "nextDialogs": [
              "230090807"
            ]
          },
          "230090807": {
            "id": "230090807",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Even the Whopperflower soil has run out... Traveler, could you please go and get me some more of that?",
            "nextDialogs": [
              "230090812",
              "230090810"
            ]
          },
          "230090812": {
            "id": "230090812",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "Thank you. Don't forget, it's the soil where Whopperflowers grow that we're looking for!"
          },
          "230090810": {
            "id": "230090810",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "I've made purchases through various means and asked others for help.",
            "nextDialogs": [
              "230090811"
            ]
          },
          "230090811": {
            "id": "230090811",
            "speakerId": 4016,
            "speakerName": "Akim",
            "text": "But I'm out of this particular type of soil. I really should have stored more of it..."
          }
        }
      }
    },
    {
      "subId": "2300909",

  },
  "subQuests": [
    {
      "subId": "2301601",
      "subQuestName": "Talk to Garcia",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230160101"
        ],
        "dialogs": {
          "230160101": {
            "id": "230160101",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "My hands... Ugh! They're both numb...",
            "nextDialogs": [
              "230160102"
            ]
          },
          "230160102": {
            "id": "230160102",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Sir, you still need to do accounts for Ms. Kaia later. Please don't exhaust yourself.",
            "nextDialogs": [
              "230160103"
            ]
          },
          "230160103": {
            "id": "230160103",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Not right now, Lutong! I—I am well aware!",
            "nextDialogs": [
              "230160104"
            ]
          },
          "230160104": {
            "id": "230160104",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Of course, if you can't make it, I will stand in for you.",
            "nextDialogs": [
              "230160105"
            ]
          },
          "230160105": {
            "id": "230160105",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "No! I will do that myself. I am just... I just need to... forge a couple more gears...",
            "nextDialogs": [
              "230160106"
            ]
          },
          "230160106": {
            "id": "230160106",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "...",
            "nextDialogs": [
              "230160107"
            ]
          },
          "230160107": {
            "id": "230160107",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Okay, I give up, I just can't continue anymore...",
            "nextDialogs": [
              "230160108"
            ]
          },
          "230160108": {
            "id": "230160108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing now...",
            "nextDialogs": [
              "230160109"
            ]
          },
          "230160109": {
            "id": "230160109",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Oh, it's you, Traveler... Ouch... My hands...",
            "nextDialogs": [
              "230160110"
            ]
          },
          "230160110": {
            "id": "230160110",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Well, here's the situation. Mr. Ahangar is also otherwise engaged, and so it is not possible to constantly commission him to make the parts I need...",
            "nextDialogs": [
              "230160111"
            ]
          },
          "230160111": {
            "id": "230160111",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Moreover, the parts he makes are often ever so slightly different from those that I picture in my mind.",
            "nextDialogs": [
              "230160112"
            ]
          },
          "230160112": {
            "id": "230160112",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "So, to ensure the reliability of these parts, I asked Mr. Ahangar to teach me some forging skills and decided to forge the parts on my own.",
            "nextDialogs": [
              "230160113"
            ]
          },
          "230160113": {
            "id": "230160113",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Fortunately, I have acquired relevant experience in Fontaine... But some of the techniques Mr. Ahangar spoke of were just so hard to remember. Ouch...",
            "nextDialogs": [
              "230160114"
            ]
          },
          "230160114": {
            "id": "230160114",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Traveler, could you please ask Mr. Ahangar about his forging techniques? I really need some rest...",
            "nextDialogs": [
              "230160121",
              "230160117"
            ]
          },
          "230160121": {
            "id": "230160121",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Thank you for being willing to help. Ugh... My hands..."
          },
          "230160117": {
            "id": "230160117",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "A business partner! A... um... very talented and... rich business partner!",
            "nextDialogs": [
              "230160118"
            ]
          },
          "230160118": {
            "id": "230160118",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "We have signed a long-term accounting contract with her! And that is why I've been meeting her often, as I'm certain Lutong can attest to.",
            "nextDialogs": [
              "230160119"
            ]
          },
          "230160119": {
            "id": "230160119",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "That is perfectly right, sir.",
            "nextDialogs": [
              "230160120"
            ]
          },
          "230160120": {
            "id": "230160120",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "S—So that's how things stand... Traveler, do help us find Mr. Ahangar as soon as possible. I shall be waiting here."
          }
        }
      }
    },
    {
      "subId": "2301602",
      "subQuestName": "Ask Ahangar questions",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230160201"
        ],
        "dialogs": {
          "230160201": {
            "id": "230160201",
            "speakerId": 4042,
            "speakerName": "Ahangar",
            "text": "I told you! Just wait a sec... Huh. It's you.",
            "nextDialogs": [
              "230160204"
            ]
          },
          "230160204": {
            "id": "230160204",
            "speakerId": 4042,
            "speakerName": "Ahangar",
            "text": "So he actually went and did that himself... What a weirdo.",
            "nextDialogs": [
              "230160205"
            ]
          },
          "230160205": {
            "id": "230160205",
            "speakerId": 4042,
            "speakerName": "Ahangar",
            "text": "I've been a blacksmith for a great many years. This is the first time I've encountered someone with such strict requirements.",
            "nextDialogs": [
              "230160206"
            ]
          },
          "230160206": {
            "id": "230160206",
            "speakerId": 4042,
            "speakerName": "Ahangar",
            "text": "He even brings a ruler to measure the seam between iron tubes, and the distance between threads.",
            "nextDialogs": [
              "230160207"
            ]
          },
          "230160207": {
            "id": "230160207",
            "speakerId": 4042,
            "speakerName": "Ahangar",
            "text": "I just can't put up with him, so I told him to do it himself... And you know what? He actually came the next day and asked me to teach him some forging skills.",
            "nextDialogs": [
              "230160208"
            ]
          },
          "230160208": {
            "id": "230160208",
            "speakerId": 4042,
            "speakerName": "Ahangar",
            "text": "Really, there's nothing I can do about him, so I let him be. As long as he pays for the materials, I'll let him use whatever tools he wants.",
            "nextDialogs": [
              "230160209"
            ]
          },
          "230160209": {
            "id": "230160209",
            "speakerId": 4042,
            "speakerName": "Ahangar",
            "text": "*sigh* I've no idea what this guy has in mind..."
          }
        }
      }
    },
    {
      "subId": "2301603",
      "subQuestName": "Report back to Garcia",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163901"
        ],
        "dialogs": {
          "230163901": {
            "id": "230163901",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Garcia begins his work...",
            "nextDialogs": [
              "230163902"
            ]
          },
          "230163902": {
            "id": "230163902",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Aha! Success! This gear looks mighty fine, if I should say so myself!",
            "nextDialogs": [
              "230163903"
            ]
          },
          "230163903": {
            "id": "230163903",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "The spacing between its teeth... Thickness... Size... Ah, I must fetch a ruler...",
            "nextDialogs": [
              "230163904"
            ]
          },
          "230163904": {
            "id": "230163904",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "It's best that we leave Mr. Garcia to his measurements. Traveler, here is your payment. Please take it.",
            "nextDialogs": [
              "230163905"
            ]
          },
          "230163905": {
            "id": "230163905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you still... cautiously pessimistic?",
            "nextDialogs": [
              "230163906"
            ]
          },
          "230163906": {
            "id": "230163906",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Yes, that's how I have always been.",
            "nextDialogs": [
              "230163907"
            ]
          },
          "230163907": {
            "id": "230163907",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Mr. Garcia and I have been wandering in front of a giant mountain for some time now, and we have only just removed a tiny stone from the foot of this mountain.",
            "nextDialogs": [
              "230163908"
            ]
          },
          "230163908": {
            "id": "230163908",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "We have, in truth, not yet found a way up.",
            "nextDialogs": [
              "230163909"
            ]
          },
          "230163909": {
            "id": "230163909",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Hopefully, Mr. Garcia's talents will lead us to the right path...",
            "nextDialogs": [
              "230163910"
            ]
          },
          "230163910": {
            "id": "230163910",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Or I will have to tell myself that \"when your path is blocked by a mountain, there will be a way through.\""
          }
        }
      }
    },
    {
      "subId": "2301603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230160301"
        ],
        "dialogs": {
          "230160301": {
            "id": "230160301",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Lutong! This gear is ready for demolding! Come help me!",
            "nextDialogs": [
              "230160302"
            ]
          },
          "230160302": {
            "id": "230160302",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Traveler, you're back. So, Mr. Ahangar has taught you his tricks, I trust?",
            "nextDialogs": [
              "230160303"
            ]
          },
          "230160303": {
            "id": "230160303",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Tell me then, how should I process this gear?"
          }
        }
      }
    },
    {
      "subId": "2301631",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163101"
        ],
        "dialogs": {
          "230163101": {
            "id": "230163101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "When sending the parts into the furnace again, remember to add more fuel."
          }
        }
      }
    },
    {
      "subId": "2301632",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163201"
        ],
        "dialogs": {
          "230163201": {
            "id": "230163201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "When sending the parts into the furnace again, don't add more fuel."
          }
        }
      }
    },
    {
      "subId": "2301633",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163301"
        ],
        "dialogs": {
          "230163301": {
            "id": "230163301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "When sending the parts into the furnace again, remember to add less fuel."
          }
        }
      }
    },
    {
      "subId": "2301634",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163401"
        ],
        "dialogs": {
          "230163401": {
            "id": "230163401",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Garcia begins his work...",
            "nextDialogs": [
              "230163402"
            ]
          },
          "230163402": {
            "id": "230163402",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Alright, this gear has been heated up... What next?"
          }
        }
      }
    },
    {
      "subId": "2301635",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163501"
        ],
        "dialogs": {
          "230163501": {
            "id": "230163501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hammer it in the middle and work your way out to the edges."
          }
        }
      }
    },
    {
      "subId": "2301636",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163601"
        ],
        "dialogs": {
          "230163601": {
            "id": "230163601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hammer it around the edges and work your way into the middle."
          }
        }
      }
    },
    {
      "subId": "2301637",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163701"
        ],
        "dialogs": {
          "230163701": {
            "id": "230163701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hammer it in the middle real hard."
          }
        }
      }
    },
    {
      "subId": "2301638",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230163801"
        ],
        "dialogs": {
          "230163801": {
            "id": "230163801",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Garcia begins his work...",
            "nextDialogs": [
              "230163802"
            ]
          },
          "230163802": {
            "id": "230163802",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Um... The gear doesn't quite... look right.",
            "nextDialogs": [
              "230163803"
            ]
          },
          "230163803": {
            "id": "230163803",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "It's okay, we'll start over... Traveler, what should I take into consideration?"
          }
        }
      }
    },
    {
      "subId": "2301650",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230165001"
        ],
        "dialogs": {
          "230165001": {
            "id": "230165001",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Sir, I humbly suggest that we might have to... change our approach.",
            "nextDialogs": [
              "230165002"
            ]
          },
          "230165002": {
            "id": "230165002",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Change our approach?",
            "nextDialogs": [
              "230165003"
            ]
          },
          "230165003": {
            "id": "230165003",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Perhaps we might make something less complicated but equally intricate.",
            "nextDialogs": [
              "230165004"
            ]
          },
          "230165004": {
            "id": "230165004",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "I believe that with your talents, making machines of this sort should be...",
            "nextDialogs": [
              "230165005"
            ]
          },
          "230165005": {
            "id": "230165005",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "My dear Lutong, we have spoken of this matter before. You know my answer... but I will always respect your choices.",
            "nextDialogs": [
              "230165006"
            ]
          },
          "230165006": {
            "id": "230165006",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Perhaps we should instead discuss where you shall have dinner with Ms. Kaia next, sir.",
            "nextDialogs": [
              "230165007"
            ]
          },
          "230165007": {
            "id": "230165007",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Ah, thank you, Lutong.",
            "nextDialogs": [
              "230165008"
            ]
          },
          "230165008": {
            "id": "230165008",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "My pleasure, sir. Our contract has not ended yet."
          }
        }
      }
    },
    {
      "subId": "2301651",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230165101"
        ],
        "dialogs": {
          "230165101": {
            "id": "230165101",
            "speakerId": 13349,
            "speakerName": "Ahangar",
            "text": "Do you have other questions for me?",
            "nextDialogs": [
              "230165103",
              "230165106"
            ]
          },
          "230165103": {
            "id": "230165103",
            "speakerId": 13349,
            "speakerName": "Ahangar",
            "text": "Quite some time, I would say. This guy is even more passionate than some of my apprentices.",
            "nextDialogs": [
              "230165104"
            ]
          },
          "230165104": {
            "id": "230165104",
            "speakerId": 13349,
            "speakerName": "Ahangar",
            "text": "But he just doesn't look like someone who wants to make a living as a blacksmith..."
          },
          "230165106": {
            "id": "230165106",
            "speakerId": 13349,
            "speakerName": "Ahangar",
            "text": "Hmm... There is a woman who visits him quite often, and she comes bringing lots of things.",
            "nextDialogs": [
              "230165107"
            ]
          },
          "230165107": {
            "id": "230165107",
            "speakerId": 13349,
            "speakerName": "Ahangar",
            "text": "He has told me that the woman is named Kaia... Or something like that.",
            "nextDialogs": [
              "230165108"
            ]
          },
          "230165108": {
            "id": "230165108",
            "speakerId": 13349,
            "speakerName": "Ahangar",
            "text": "I don't get it. These people look nothing like blacksmiths, so why do they hang around in my smithy..."
          }
        }
      }
    },
    {
      "subId": "2301652",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230165201"
        ],
        "dialogs": {
          "230165201": {
            "id": "230165201",
            "speakerId": 13349,
            "speakerName": "Ahangar",
            "text": "What on earth does this guy have in his mind..."
          }
        }
      }
    },
    {
      "subId": "2301699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230169901"
        ],
        "dialogs": {
          "230169901": {
            "id": "230169901",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "(The gear's dimensions should be... Kaia helped me record them last time... Ugh! What is WRONG with me!?)",
            "nextDialogs": [
              "230169902"
            ]
          },
          "230169902": {
            "id": "230169902",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "(Maybe I should go talk to Ms. Kaia...)"
          }
        }
      }
    }
  ]
}
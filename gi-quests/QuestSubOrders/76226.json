        "dialogs": {
          "762260201": {
            "id": "762260201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Maalaus? You're here too? We didn't expect to run into you on the moon!",
            "nextDialogs": [
              "762260202"
            ]
          },
          "762260202": {
            "id": "762260202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So Columbina brought you here, right? She did say she'd take you to the moon for your exhibition.",
            "nextDialogs": [
              "762260203"
            ]
          },
          "762260203": {
            "id": "762260203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right, speaking of the exhibition... where are your paintings?",
            "nextDialogs": [
              "762260204"
            ]
          },
          "762260204": {
            "id": "762260204",
            "speakerId": 15603,
            "speakerName": "Maalaus",
            "text": "!",
            "nextDialogs": [
              "762260205"
            ]
          },
          "762260205": {
            "id": "762260205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's wrong? Don't tell me... they're lost?",
            "nextDialogs": [
              "762260206"
            ]
          },
          "762260206": {
            "id": "762260206",
            "speakerId": 15603,
            "speakerName": "Maalaus",
            "text": "!",
            "nextDialogs": [
              "762260207"
            ]
          },
          "762260207": {
            "id": "762260207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How could that happen? We're on the moon! They couldn't have been stolen, right...?",
            "nextDialogs": [
              "762260208"
            ]
          },
          "762260208": {
            "id": "762260208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, let's help Maalaus look for them first. Maybe they just got left somewhere nearby."
          }
        }
      }
    },
    {
      "subId": "7622603",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762260101"
        ],
        "dialogs": {
          "762260101": {
            "id": "762260101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Maalaus, look! We found all your paintings and brought them back!",
            "nextDialogs": [
              "762260102"
            ]
          },
          "762260102": {
            "id": "762260102",
            "speakerId": 15603,
            "speakerName": "Maalaus",
            "text": "♪~",
            "nextDialogs": [
              "762260103"
            ]
          },
          "762260103": {
            "id": "762260103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, no need to thank us. We had a hand in these paintings too, after all.",
            "nextDialogs": [
              "762260104"
            ]
          },
          "762260104": {
            "id": "762260104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Since when can you understand what Maalaus is saying, Paimon?",
            "nextDialogs": [
              "762260105"
            ]
          },
          "762260105": {
            "id": "762260105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Come on, we've been to the Silvermoon Hall together so many times already. It's not that surprising I'd start getting what Maalaus means, right?",
            "nextDialogs": [
              "762260106"
            ]
          },
          "762260106": {
            "id": "762260106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So what did Maalaus say happened to the paintings?",
            "nextDialogs": [
              "762260107"
            ]
          },
          "762260107": {
            "id": "762260107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh... well... let Paimon try to interpret... Maalaus says...",
            "nextDialogs": [
              "762260108"
            ]
          },
          "762260108": {
            "id": "762260108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Maybe other kuuhenki stole them...",
            "nextDialogs": [
              "762260109"
            ]
          },
          "762260109": {
            "id": "762260109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Mm... or maybe those fancy transport things on the moon took them...",
            "nextDialogs": [
              "762260110"
            ]
          },
          "762260110": {
            "id": "762260110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Or... maybe Columbina stole them...",
            "nextDialogs": [
              "762260111"
            ]
          },
          "762260111": {
            "id": "762260111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hey! That's definitely not true!",
            "nextDialogs": [
              "762260112"
            ]
          },
          "762260112": {
            "id": "762260112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Oh... did I get it wrong after all...",
            "nextDialogs": [
              "762260113"
            ]
          },
          "762260113": {
            "id": "762260113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So it was just wild guessing...",
            "nextDialogs": [
              "762260114"
            ]
          },
          "762260114": {
            "id": "762260114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph. Learning a foreign language isn't that easy, you know...",
            "nextDialogs": [
              "762260115"
            ]
          },
          "762260115": {
            "id": "762260115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "All Paimon needs is a good teacher! When the time comes, Paimon's gonna get Columbina to teach her properly!"
          }
        }
      }
    }
  ]

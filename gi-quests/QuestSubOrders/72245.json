  },
  "subQuests": [
    {
      "subId": "7224501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450101"
        ],
        "dialogs": {
          "722450101": {
            "id": "722450101",
            "speakerId": 1000,
            "speakerName": "Rikoru",
            "text": "What? Don't disturb me. I'm thinking...",
            "nextDialogs": [
              "722450102"
            ]
          },
          "722450102": {
            "id": "722450102",
            "speakerId": 1000,
            "speakerName": "Rikoru",
            "text": "Yes, I'm thinking about something very important!",
            "nextDialogs": [
              "722450103"
            ]
          },
          "722450103": {
            "id": "722450103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What is it?",
            "nextDialogs": [
              "722450104"
            ]
          },
          "722450104": {
            "id": "722450104",
            "speakerId": 1000,
            "speakerName": "Rikoru",
            "text": "Have you seen that thing they call the Dainichi Mikoshi?",
            "nextDialogs": [
              "722450105"
            ]
          },
          "722450105": {
            "id": "722450105",
            "speakerId": 1000,
            "speakerName": "Rikoru",
            "text": "The tallest thing in the whole country.",
            "nextDialogs": [
              "722450106"
            ]
          },
          "722450106": {
            "id": "722450106",
            "speakerId": 1000,
            "speakerName": "Rikoru",
            "text": "I was thinking about how I can build something even taller than that!",
            "nextDialogs": [
              "722450107"
            ]
          },
          "722450107": {
            "id": "722450107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But it's only so tall so that it can light up Byakuyakoku, right?",
            "nextDialogs": [
              "722450108"
            ]
          },
          "722450108": {
            "id": "722450108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What's the reason for your building being so tall?",
            "nextDialogs": [
              "722450109"
            ]
          },
          "722450109": {
            "id": "722450109",
            "speakerId": 1000,
            "speakerName": "Rikoru",
            "text": "To display my glory, of course! The glory of Rikoru the Great!",
            "nextDialogs": [
              "722450110"
            ]
          },
          "722450110": {
            "id": "722450110",
            "speakerId": 1000,
            "speakerName": "Rikoru",
            "text": "That'll show that old man Aberaku who's boss!",
            "nextDialogs": [
              "722450113"
            ]
          },
          "722450113": {
            "id": "722450113",
            "speakerId": 1000,
            "speakerName": "Rikoru",
            "text": "Of course. He built the Dainichi Mikoshi and saved Byakuyakoku. I used to look up to him...",
            "nextDialogs": [
              "722450114"
            ]
          },
          "722450114": {
            "id": "722450114",
            "speakerId": 1000,
            "speakerName": "Rikoru",
            "text": "But as it turned out, he had designs on the throne. If it wasn't for those adults, I would be dead right now.",
            "nextDialogs": [
              "722450115"
            ]
          },
          "722450115": {
            "id": "722450115",
            "speakerId": 1000,
            "speakerName": "Rikoru",
            "text": "That's why I will build something taller than the Dainichi Mikoshi.",
            "nextDialogs": [
              "722450116"
            ]
          },
          "722450116": {
            "id": "722450116",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "H—How long will that take?",
            "nextDialogs": [
              "722450117"
            ]
          },
          "722450117": {
            "id": "722450117",
            "speakerId": 1000,
            "speakerName": "Rikoru",
            "text": "Like I care!",
            "nextDialogs": [
              "722450118"
            ]
          },
          "722450118": {
            "id": "722450118",
            "speakerId": 1000,
            "speakerName": "Rikoru",
            "text": "The people of Byakuyakoku should be happy that I would ask them to build such a historical wonder for me!",
            "nextDialogs": [
              "722450119"
            ]
          },
          "722450119": {
            "id": "722450119",
            "speakerId": 1000,
            "speakerName": "Rikoru",
            "text": "Alright, then! Stop bothering me!",
            "nextDialogs": [
              "722450120"
            ]
          },
          "722450120": {
            "id": "722450120",
            "speakerId": 1000,
            "speakerName": "Rikoru",
            "text": "Let me think. If the beams are this long... If we do it that way, the load-bearing and wood joinery..."
          }
        }
      }
    },
    {
      "subId": "7224502",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450201"
        ],
        "dialogs": {
          "722450201": {
            "id": "722450201",
            "speakerId": 1002,
            "speakerName": "Isumenasu",
            "text": "Hmm? I've never seen people dressed like you are before.",
            "nextDialogs": [
              "722450202"
            ]
          },
          "722450202": {
            "id": "722450202",
            "speakerId": 1002,
            "speakerName": "Isumenasu",
            "text": "Are you someone who fell from... that, uh, from beyond the skies?",
            "nextDialogs": [
              "722450203"
            ]
          },
          "722450203": {
            "id": "722450203",
            "speakerId": 1002,
            "speakerName": "Isumenasu",
            "text": "So! The world does not end with our glorious nation! Well, then. Surrender your maps to me for my perusal.",
            "nextDialogs": [
              "722450204"
            ]
          },
          "722450204": {
            "id": "722450204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(You give him your map...)",
            "nextDialogs": [
              "722450205"
            ]
          },
          "722450205": {
            "id": "722450205",
            "speakerId": 1002,
            "speakerName": "Isumenasu",
            "text": "Ah, how very intricate. Not only are the landforms accurately drawn, but even the paths of the mountains and rivers can be seen.",
            "nextDialogs": [
              "722450206"
            ]
          },
          "722450206": {
            "id": "722450206",
            "speakerId": 1002,
            "speakerName": "Isumenasu",
            "text": "Well, then. How large is this nation you call \"Teyvat\"? How does it measure up to Byakuyakoku?",
            "nextDialogs": [
              "722450207"
            ]
          },
          "722450207": {
            "id": "722450207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Teyvat's a whole continent...",
            "nextDialogs": [
              "722450208"
            ]
          },
          "722450208": {
            "id": "722450208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Also, Enkanomiya... That is, Byakuyakoku, is this small patch on the south end of the map.",
            "nextDialogs": [
              "722450209"
            ]
          },
          "722450209": {
            "id": "722450209",
            "speakerId": 1002,
            "speakerName": "Isumenasu",
            "text": "Nonsense! Our lands are vast and broad! How can they occupy but such a puny space?",
            "nextDialogs": [
              "722450210"
            ]
          },
          "722450210": {
            "id": "722450210",
            "speakerId": 1002,
            "speakerName": "Isumenasu",
            "text": "This map may seem exquisitely drawn, but is in truth an errant fraud. Away, away with it!",
            "nextDialogs": [
              "722450211"
            ]
          },
          "722450211": {
            "id": "722450211",
            "speakerId": 1002,
            "speakerName": "Isumenasu",
            "text": "To think I had even a moment of admiration for this cheap charlatanry, to the defilement of mine eyes!",
            "nextDialogs": [
              "722450212"
            ]
          },
          "722450212": {
            "id": "722450212",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, suit yourself, kiddo!"
          }
        }
      }
    },
    {
      "subId": "7224503",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450301"
        ],
        "dialogs": {
          "722450301": {
            "id": "722450301",
            "speakerId": 1003,
            "speakerName": "Surepio",
            "text": "Travelers from distant lands... *cough* You seem quite tired.",
            "nextDialogs": [
              "722450302"
            ]
          },
          "722450302": {
            "id": "722450302",
            "speakerId": 1003,
            "speakerName": "Surepio",
            "text": "That won't do, you know? Many illnesses have their humble beginnings in exhaustion.",
            "nextDialogs": [
              "722450303"
            ]
          },
          "722450303": {
            "id": "722450303",
            "speakerId": 1003,
            "speakerName": "Surepio",
            "text": "You must ensure that you get enough rest every day, so that you— *cough*",
            "nextDialogs": [
              "722450304"
            ]
          },
          "722450304": {
            "id": "722450304",
            "speakerId": 1003,
            "speakerName": "Surepio",
            "text": "*cough* *cough* —can grow healthily.",
            "nextDialogs": [
              "722450305"
            ]
          },
          "722450305": {
            "id": "722450305",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Y'know what, you're not looking too good yourself.",
            "nextDialogs": [
              "722450306"
            ]
          },
          "722450306": {
            "id": "722450306",
            "speakerId": 1003,
            "speakerName": "Surepio",
            "text": "Ahaha, it is an old malady of mine.",
            "nextDialogs": [
              "722450307"
            ]
          },
          "722450307": {
            "id": "722450307",
            "speakerId": 1003,
            "speakerName": "Surepio",
            "text": "You must maintain a healthy body to stimulate a healthy soul, Traveler.",
            "nextDialogs": [
              "722450308"
            ]
          },
          "722450308": {
            "id": "722450308",
            "speakerId": 1003,
            "speakerName": "Surepio",
            "text": "*sigh* If only I had more time. I would become the greatest physician in the world...",
            "nextDialogs": [
              "722450309"
            ]
          },
          "722450309": {
            "id": "722450309",
            "speakerId": 1003,
            "speakerName": "Surepio",
            "text": "That way, even with this body of mine, I would surely be able to walk out of my room in good health and play to my heart's content."
          }
        }
      }
    },
    {
      "subId": "7224504",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450401"
        ],
        "dialogs": {
          "722450401": {
            "id": "722450401",
            "speakerId": 1004,
            "speakerName": "Risutaiosu",
            "text": "Stop moving!",
            "nextDialogs": [
              "722450402"
            ]
          },
          "722450402": {
            "id": "722450402",
            "speakerId": 1004,
            "speakerName": "Risutaiosu",
            "text": "Oh, stop it! Stop, I say! Come on, I told you to stop moving! Didn't you hear me?",
            "nextDialogs": [
              "722450403"
            ]
          },
          "722450403": {
            "id": "722450403",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh, Paimon can't just stop moving...",
            "nextDialogs": [
              "722450406"
            ]
          },
          "722450406": {
            "id": "722450406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "No way!",
            "nextDialogs": [
              "722450407"
            ]
          },
          "722450407": {
            "id": "722450407",
            "speakerId": 1004,
            "speakerName": "Risutaiosu",
            "text": "Ugh, alright, turn around then. I have never seen these clothes in my life.",
            "nextDialogs": [
              "722450408"
            ]
          },
          "722450408": {
            "id": "722450408",
            "speakerId": 1004,
            "speakerName": "Risutaiosu",
            "text": "They're not entirely aesthetically pleasing, but they are somewhat interesting.",
            "nextDialogs": [
              "722450409"
            ]
          },
          "722450409": {
            "id": "722450409",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "If you don't like 'em, why'd you even look?",
            "nextDialogs": [
              "722450410"
            ]
          },
          "722450410": {
            "id": "722450410",
            "speakerId": 1004,
            "speakerName": "Risutaiosu",
            "text": "Seriously? Asking those lady retainers to model for me was hardly this difficult.",
            "nextDialogs": [
              "722450411"
            ]
          },
          "722450411": {
            "id": "722450411",
            "speakerId": 1004,
            "speakerName": "Risutaiosu",
            "text": "That said, I've gotten quite sick of looking at the way our people dress.",
            "nextDialogs": [
              "722450412"
            ]
          },
          "722450412": {
            "id": "722450412",
            "speakerId": 1004,
            "speakerName": "Risutaiosu",
            "text": "As for what you're wearing, now that's new.",
            "nextDialogs": [
              "722450413"
            ]
          },
          "722450413": {
            "id": "722450413",
            "speakerId": 1004,
            "speakerName": "Risutaiosu",
            "text": "Hmm, I know. So that's how they put those clothes together... Wow, you outsiders really are shameless.",
            "nextDialogs": [
              "722450414"
            ]
          },
          "722450414": {
            "id": "722450414",
            "speakerId": 1004,
            "speakerName": "Risutaiosu",
            "text": "I see, I see... So if the clothes are made like that, then the body shape should be like... this!",
            "nextDialogs": [
              "722450415"
            ]
          },
          "722450415": {
            "id": "722450415",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What are you doing?",
            "nextDialogs": [
              "722450416"
            ]
          },
          "722450416": {
            "id": "722450416",
            "speakerId": 1004,
            "speakerName": "Risutaiosu",
            "text": "Making a statue. I mix clay and water, and then I knead them into shape with both hands. It helps to calm me — it's one of the only things that does.",
            "nextDialogs": [
              "722450417"
            ]
          },
          "722450417": {
            "id": "722450417",
            "speakerId": 1004,
            "speakerName": "Risutaiosu",
            "text": "And you know what definitely doesn't calm me? Sitting in regular meetings, reading aloud based on material pre-written by those adults.",
            "nextDialogs": [
              "722450418"
            ]
          },
          "722450418": {
            "id": "722450418",
            "speakerId": 1004,
            "speakerName": "Risutaiosu",
            "text": "Well, whatever. I'm done with your forms as well.",
            "nextDialogs": [
              "722450419"
            ]
          },
          "722450419": {
            "id": "722450419",
            "speakerId": 1004,
            "speakerName": "Risutaiosu",
            "text": "Now stop bothering me. Go do your own stuff."
          }
        }
      }
    },
    {
      "subId": "7224505",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450501"
        ],
        "dialogs": {
          "722450501": {
            "id": "722450501",
            "speakerId": 1005,
            "speakerName": "Ion",
            "text": "Oh ho, Traveler, you look pretty interesting. What say I take a stab at reading your fortune?",
            "nextDialogs": [
              "722450502"
            ]
          },
          "722450502": {
            "id": "722450502",
            "speakerId": 1005,
            "speakerName": "Ion",
            "text": "I am Ion, after all. I never miss a reading.",
            "nextDialogs": [
              "722450503"
            ]
          },
          "722450503": {
            "id": "722450503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Really?",
            "nextDialogs": [
              "722450504"
            ]
          },
          "722450504": {
            "id": "722450504",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You sound like a hustler.",
            "nextDialogs": [
              "722450505"
            ]
          },
          "722450505": {
            "id": "722450505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "(Also, Paimon remembers that his tombstone read...)",
            "nextDialogs": [
              "722450506"
            ]
          },
          "722450506": {
            "id": "722450506",
            "speakerId": 1005,
            "speakerName": "Ion",
            "text": "Oh, come now, what's with that suspicious look? I always read peoples' fortunes.",
            "nextDialogs": [
              "722450507"
            ]
          },
          "722450507": {
            "id": "722450507",
            "speakerId": 1005,
            "speakerName": "Ion",
            "text": "That said... Few of Byakuyakoku's people have happy fates awaiting them.",
            "nextDialogs": [
              "722450508"
            ]
          },
          "722450508": {
            "id": "722450508",
            "speakerId": 1005,
            "speakerName": "Ion",
            "text": "So I often cheat them, telling them that their luck will turn.",
            "nextDialogs": [
              "722450509"
            ]
          },
          "722450509": {
            "id": "722450509",
            "speakerId": 1005,
            "speakerName": "Ion",
            "text": "If nothing else, I think that I can grant them a little happiness that way.",
            "nextDialogs": [
              "722450510"
            ]
          },
          "722450510": {
            "id": "722450510",
            "speakerId": 1005,
            "speakerName": "Ion",
            "text": "In the end, they said that I couldn't tell fortunes at all. Ah, how saddening.",
            "nextDialogs": [
              "722450511"
            ]
          },
          "722450511": {
            "id": "722450511",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Is that how it is?",
            "nextDialogs": [
              "722450512"
            ]
          },
          "722450512": {
            "id": "722450512",
            "speakerId": 1005,
            "speakerName": "Ion",
            "text": "Well, little one, I'll prove it to you, right now!",
            "nextDialogs": [
              "722450513"
            ]
          },
          "722450513": {
            "id": "722450513",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "O—Oh? Sure! Try Paimon on for size!",
            "nextDialogs": [
              "722450514"
            ]
          },
          "722450514": {
            "id": "722450514",
            "speakerId": 1005,
            "speakerName": "Ion",
            "text": "Hmm, alright... Let me have a careful go at this... Huh. Why's there so much interference?",
            "nextDialogs": [
              "722450515"
            ]
          },
          "722450515": {
            "id": "722450515",
            "speakerId": 1005,
            "speakerName": "Ion",
            "text": "Eh!?",
            "nextDialogs": [
              "722450516"
            ]
          },
          "722450516": {
            "id": "722450516",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wh—What's wrong?",
            "nextDialogs": [
              "722450517"
            ]
          },
          "722450517": {
            "id": "722450517",
            "speakerId": 1005,
            "speakerName": "Ion",
            "text": "I... can't read your fortune.",
            "nextDialogs": [
              "722450518"
            ]
          },
          "722450518": {
            "id": "722450518",
            "speakerId": 1005,
            "speakerName": "Ion",
            "text": "How could that be? I don't get it exactly right most of the time, but I usually don't fail to get a reading at all...",
            "nextDialogs": [
              "722450519"
            ]
          },
          "722450519": {
            "id": "722450519",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, guess you ain't that good, huh?",
            "nextDialogs": [
              "722450520"
            ]
          },
          "722450520": {
            "id": "722450520",
            "speakerId": 1005,
            "speakerName": "Ion",
            "text": "It does seem so. It seems that I must continue my studies in earnest."
          }
        }
      }
    },
    {
      "subId": "7224506",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450601"
        ],
        "dialogs": {
          "722450601": {
            "id": "722450601",
            "speakerId": 1006,
            "speakerName": "Piramumon",
            "text": "Oh ho! Judging by your appearance, you must be a traveler from another nation!",
            "nextDialogs": [
              "722450602"
            ]
          },
          "722450602": {
            "id": "722450602",
            "speakerId": 1006,
            "speakerName": "Piramumon",
            "text": "Where do you hail from?",
            "nextDialogs": [
              "722450603"
            ]
          },
          "722450603": {
            "id": "722450603",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We're from Mondstadt.",
            "nextDialogs": [
              "722450604"
            ]
          },
          "722450604": {
            "id": "722450604",
            "speakerId": 1006,
            "speakerName": "Piramumon",
            "text": "Mondstadt?",
            "nextDialogs": [
              "722450605"
            ]
          },
          "722450605": {
            "id": "722450605",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "You describe the Mondstadt's scenery to Piramumon in a simple manner...",
            "nextDialogs": [
              "722450606"
            ]
          },
          "722450606": {
            "id": "722450606",
            "speakerId": 1006,
            "speakerName": "Piramumon",
            "text": "I've never heard of such a city. To think that there was such a place...",
            "nextDialogs": [
              "722450607"
            ]
          },
          "722450607": {
            "id": "722450607",
            "speakerId": 1006,
            "speakerName": "Piramumon",
            "text": "Hahaha! It's just as I said, then! The world couldn't possibly only be the size of Byakuyakoku!",
            "nextDialogs": [
              "722450608"
            ]
          },
          "722450608": {
            "id": "722450608",
            "speakerId": 1006,
            "speakerName": "Piramumon",
            "text": "I mean, if Byakuyakoku were all there was in the world, that would be a most lonely world indeed.",
            "nextDialogs": [
              "722450609"
            ]
          },
          "722450609": {
            "id": "722450609",
            "speakerId": 1006,
            "speakerName": "Piramumon",
            "text": "The ancient texts also talk about times before our nation was founded. That's when I began to believe that there were lands beyond ours.",
            "nextDialogs": [
              "722450610"
            ]
          },
          "722450610": {
            "id": "722450610",
            "speakerId": 1006,
            "speakerName": "Piramumon",
            "text": "But I was still scared, you know? Scared that there was really nothing else out there.",
            "nextDialogs": [
              "722450611"
            ]
          },
          "722450611": {
            "id": "722450611",
            "speakerId": 1006,
            "speakerName": "Piramumon",
            "text": "You have no idea, Traveler, how much your arrival sets my heart at ease. Haha, so there are many more fascinating places to see in this world.",
            "nextDialogs": [
              "722450612"
            ]
          },
          "722450612": {
            "id": "722450612",
            "speakerId": 1006,
            "speakerName": "Piramumon",
            "text": "It's just a shame that I have this festival called the Rite of Solar Return to attend to.",
            "nextDialogs": [
              "722450613"
            ]
          },
          "722450613": {
            "id": "722450613",
            "speakerId": 1006,
            "speakerName": "Piramumon",
            "text": "How about this, Traveler? Tell me how you came here.",
            "nextDialogs": [
              "722450614"
            ]
          },
          "722450614": {
            "id": "722450614",
            "speakerId": 1006,
            "speakerName": "Piramumon",
            "text": "Once the festival has ended, I'll find an opportunity to sneak out of the Dainichi Mikoshi.",
            "nextDialogs": [
              "722450615"
            ]
          },
          "722450615": {
            "id": "722450615",
            "speakerId": 1006,
            "speakerName": "Piramumon",
            "text": "Let's have some fruit juice together instead! Haha!"
          }
        }
      }
    },
    {
      "subId": "7224507",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450701"
        ],
        "dialogs": {
          "722450701": {
            "id": "722450701",
            "speakerId": 1008,
            "speakerName": "Orupeusu",
            "text": "*sigh* So you are the traveler from afar...",
            "nextDialogs": [
              "722450702"
            ]
          },
          "722450702": {
            "id": "722450702",
            "speakerId": 1008,
            "speakerName": "Orupeusu",
            "text": "What are you pursuing? The sight of you coming this way was grievous to watch.",
            "nextDialogs": [
              "722450703"
            ]
          },
          "722450703": {
            "id": "722450703",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Grief? What's there to be sad about?",
            "nextDialogs": [
              "722450704"
            ]
          },
          "722450704": {
            "id": "722450704",
            "speakerId": 1008,
            "speakerName": "Orupeusu",
            "text": "For a singer of songs, everything in this world is worth grieving.",
            "nextDialogs": [
              "722450705"
            ]
          },
          "722450705": {
            "id": "722450705",
            "speakerId": 1008,
            "speakerName": "Orupeusu",
            "text": "Where there are meetings, there must be partings, and those who are born will one day return to the earth...",
            "nextDialogs": [
              "722450706"
            ]
          },
          "722450706": {
            "id": "722450706",
            "speakerId": 1008,
            "speakerName": "Orupeusu",
            "text": "Reunions are too brief to salve the pain of long separations... And as for you, Traveler...",
            "nextDialogs": [
              "722450707"
            ]
          },
          "722450707": {
            "id": "722450707",
            "speakerId": 1008,
            "speakerName": "Orupeusu",
            "text": "Only those in pursuit of something will journey into another realm as you do.",
            "nextDialogs": [
              "722450708"
            ]
          },
          "722450708": {
            "id": "722450708",
            "speakerId": 1008,
            "speakerName": "Orupeusu",
            "text": "The locals, who have lived here for a long time, would find such a journey romantic, but for the wayfarer themselves, it may mean unspeakable pain.",
            "nextDialogs": [
              "722450709"
            ]
          },
          "722450709": {
            "id": "722450709",
            "speakerId": 1008,
            "speakerName": "Orupeusu",
            "text": "If you came in an earlier clime, I might have sung for you.",
            "nextDialogs": [
              "722450710"
            ]
          },
          "722450710": {
            "id": "722450710",
            "speakerId": 1008,
            "speakerName": "Orupeusu",
            "text": "But I have sworn an oath with someone that I shall not sing again until I hear her voice.",
            "nextDialogs": [
              "722450711"
            ]
          },
          "722450711": {
            "id": "722450711",
            "speakerId": 1008,
            "speakerName": "Orupeusu",
            "text": "I can only wish you well, though you seem far older than I...",
            "nextDialogs": [
              "722450712"
            ]
          },
          "722450712": {
            "id": "722450712",
            "speakerId": 1008,
            "speakerName": "Orupeusu",
            "text": "I hope your wish comes true."
          }
        }
      }
    },
    {
      "subId": "7224508",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722450801"
        ],
        "dialogs": {
          "722450801": {
            "id": "722450801",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It seems like each of the Sunchildren is pretty different, huh..."
          }
        }
      }
    }
  ]
}
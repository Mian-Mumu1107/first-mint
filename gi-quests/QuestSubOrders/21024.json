  "subQuests": [
    {
      "subId": "2102401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210240101"
        ],
        "dialogs": {
          "210240101": {
            "id": "210240101",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "This is really bad...",
            "nextDialogs": [
              "210240102"
            ]
          },
          "210240102": {
            "id": "210240102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened to you?",
            "nextDialogs": [
              "210240103"
            ]
          },
          "210240103": {
            "id": "210240103",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "Oh, you're a traveler... Well, you see, I'm a merchant, and I often shuttle between Mondstadt and Liyue on business.",
            "nextDialogs": [
              "210240104"
            ]
          },
          "210240104": {
            "id": "210240104",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "I had just closed a big deal in Mondstadt, and was getting ready to deliver the invoices back to my boss...",
            "nextDialogs": [
              "210240105"
            ]
          },
          "210240105": {
            "id": "210240105",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "But I never imagined that I'd be attacked by monsters while passing through this area.",
            "nextDialogs": [
              "210240106"
            ]
          },
          "210240106": {
            "id": "210240106",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "I couldn't fight them off, so I could only flee for my life, and ended up stumbling my way into this inn.",
            "nextDialogs": [
              "210240107"
            ]
          },
          "210240107": {
            "id": "210240107",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "But I've run off, and left all the invoices behind... Could I ask you to get them back for me?",
            "nextDialogs": [
              "210240109",
              "210240112",
              "210240117"
            ]
          },
          "210240109": {
            "id": "210240109",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "That's wonderful! I remember the places I passed by as I ran, more or less. Here, let me mark them for you...",
            "nextDialogs": [
              "210240110"
            ]
          },
          "210240110": {
            "id": "210240110",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "I placed all the invoices inside a box. It shouldn't be too hard to find, so please, help me out!"
          },
          "210240112": {
            "id": "210240112",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "For wine, of course. What other business would one do in Mondstadt, anyway?",
            "nextDialogs": [
              "210240113"
            ]
          },
          "210240113": {
            "id": "210240113",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "This is a huge deal. If anything goes wrong, my boss will hang the loss on me for sure.",
            "nextDialogs": [
              "210240114"
            ]
          },
          "210240114": {
            "id": "210240114",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "Please help me out. I've marked all the rough locations out for you.",
            "nextDialogs": [
              "210240115"
            ]
          },
          "210240115": {
            "id": "210240115",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "I placed all the invoices inside a box. It shouldn't be too hard to find, so please, help me out!"
          },
          "210240117": {
            "id": "210240117",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "My boss? Uh, well, it's a really rich merchant in Liyue. Really rich.",
            "nextDialogs": [
              "210240118"
            ]
          },
          "210240118": {
            "id": "210240118",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "Oh, just don't ask too much. I'm just the errand runner, I don't know that much about the boss.",
            "nextDialogs": [
              "210240119"
            ]
          },
          "210240119": {
            "id": "210240119",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "But if I mess this one up, I'm going to lose this errand-running job for sure.",
            "nextDialogs": [
              "210240120"
            ]
          },
          "210240120": {
            "id": "210240120",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "Please help me out. I've marked all the rough locations out for you.",
            "nextDialogs": [
              "210240121"
            ]
          },
          "210240121": {
            "id": "210240121",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "I placed all the invoices inside a box. It shouldn't be too hard to find, so please, help me out!"
          }
        }
      }
    },

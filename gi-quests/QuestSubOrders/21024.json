    {
      "subId": "2102408",
      "subQuestName": "Talk to Bao'er",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210240801"
        ],
        "dialogs": {
          "210240801": {
            "id": "210240801",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "Did you get those Noctilucous Jades?"
          }
        }
      }
    },
    {
      "subId": "2102409",
      "subQuestName": "Talk to Landa",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210240901"
        ],
        "dialogs": {
          "210240901": {
            "id": "210240901",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "Did you find the invoices?",
            "nextDialogs": [
              "210240902"
            ]
          },
          "210240902": {
            "id": "210240902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Found them all.",
            "nextDialogs": [
              "210240903"
            ]
          },
          "210240903": {
            "id": "210240903",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "Thank you, truly! This is wonderful. I'm so glad that nothing went wrong.",
            "nextDialogs": [
              "210240904"
            ]
          },
          "210240904": {
            "id": "210240904",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "If these invoices were lost, I have no idea how angry my boss would have been.",
            "nextDialogs": [
              "210240905"
            ]
          },
          "210240905": {
            "id": "210240905",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "You want to ask what business these invoices were written for, don't you?",
            "nextDialogs": [
              "210240906"
            ]
          },
          "210240906": {
            "id": "210240906",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "I'm sorry, I really can't tell you. It's a secret.",
            "nextDialogs": [
              "210240907"
            ]
          },
          "210240907": {
            "id": "210240907",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "Well, here's your remuneration, please take it... Wait a moment. Why has this box been opened?",
            "nextDialogs": [
              "210240908"
            ]
          },
          "210240908": {
            "id": "210240908",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "...You met someone out in the wild who took a look at it after picking it up?",
            "nextDialogs": [
              "210240909"
            ]
          },
          "210240909": {
            "id": "210240909",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "Oh, I'm dead. Dead. Dead! This... this won't do. I have to tell the boss quickly...",
            "nextDialogs": [
              "210240910"
            ]
          },
          "210240910": {
            "id": "210240910",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "Oh, don't worry, I'm not suspicious of you. I mean, I did do my homework regarding your...",
            "nextDialogs": [
              "210240911"
            ]
          },
          "210240911": {
            "id": "210240911",
            "speakerId": 1000,
            "speakerName": "Landa",
            "text": "Ahem. Well, I need to find a way to contact my boss. Please carry on with your business."
          }
        }
      }
    },
    {
      "subId": "2102410",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210240802"
        ],
        "dialogs": {
          "210240802": {
            "id": "210240802",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "Not bad. I'll take them. Here's the invoices, take care of them now.",
            "nextDialogs": [
              "210240803"
            ]
          },
          "210240803": {
            "id": "210240803",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "Alright then, best you be off. The person who hired you must be a real bundle of nerves right now."
          }
        }
      }
    },
    {
      "subId": "2102408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210240820"
        ],
        "dialogs": {
          "210240820": {
            "id": "210240820",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "I only had a little look. That won't get me in trouble, will it?"
          }
        }
      }
    }
  ]
}
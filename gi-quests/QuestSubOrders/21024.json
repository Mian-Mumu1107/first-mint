    {
      "subId": "2102406",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210240601"
        ],
        "dialogs": {
          "210240601": {
            "id": "210240601",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "This doesn't seem to have any use...",
            "nextDialogs": [
              "210240602"
            ]
          },
          "210240602": {
            "id": "210240602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Excuse me. Have you seen a box?",
            "nextDialogs": [
              "210240603"
            ]
          },
          "210240603": {
            "id": "210240603",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "A box? Well, I did pick one up.",
            "nextDialogs": [
              "210240604"
            ]
          },
          "210240604": {
            "id": "210240604",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "I already had a look inside, and it was a batch of invoices. Seems like someone was doing a real huge business venture.",
            "nextDialogs": [
              "210240605"
            ]
          },
          "210240605": {
            "id": "210240605",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "Oh me, oh my, I wonder how much the owner of this box would pay to have it back?",
            "nextDialogs": [
              "210240606"
            ]
          },
          "210240606": {
            "id": "210240606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...What do you mean?",
            "nextDialogs": [
              "210240607"
            ]
          },
          "210240607": {
            "id": "210240607",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "Hey, don't look so nervous. I was just pulling your leg.",
            "nextDialogs": [
              "210240608"
            ]
          },
          "210240608": {
            "id": "210240608",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "The value of the goods on those invoices is not low by any means. Makes one wonder which big shot in Liyue it was who signed off on it.",
            "nextDialogs": [
              "210240609"
            ]
          },
          "210240609": {
            "id": "210240609",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "I've got a sense of time and place. I'm not about to kick the hornet's nest just because I can.",
            "nextDialogs": [
              "210240610"
            ]
          },
          "210240610": {
            "id": "210240610",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "Still, don't you think it's a bit unreasonable for you to just take this and leave after all the time and effort I've spent guarding it?",
            "nextDialogs": [
              "210240611"
            ]
          },
          "210240611": {
            "id": "210240611",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "How about this? Let's barter. It's the most traditional way of solving such problems.",
            "nextDialogs": [
              "210240612"
            ]
          },
          "210240612": {
            "id": "210240612",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "You fetch me 3 Noctilucous Jades, and I'll give you the invoices. How does that sound?",
            "nextDialogs": [
              "210240613"
            ]
          },
          "210240613": {
            "id": "210240613",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "I mean, these 3 Noctilucous Jades probably aren't worth anything compared to the things listed on those invoices.",
            "nextDialogs": [
              "210240615",
              "210240618"
            ]
          },
          "210240615": {
            "id": "210240615",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "Well, hop to it then. When you're back, we'll trade, one for one."
          },
          "210240618": {
            "id": "210240618",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "Oh, you don't know? So you're just here to do someone else's work. Well, that's just fine.",
            "nextDialogs": [
              "210240619"
            ]
          },
          "210240619": {
            "id": "210240619",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "Let me give you some advice: you're better off not asking too much about transactions of this scale.",
            "nextDialogs": [
              "210240620"
            ]
          },
          "210240620": {
            "id": "210240620",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "Alright, go get me those Noctilucous Jades, and I'll give you the invoices. Then you can pass it on to the person who requested your services.",
            "nextDialogs": [
              "210240621"
            ]
          },
          "210240621": {
            "id": "210240621",
            "speakerId": 1001,
            "speakerName": "Bao'er",
            "text": "All done, no mess or fuss."
          }
        }
      }
    },
    {
      "subId": "2102407",

    {
      "subId": "7618004",
      "subQuestName": "Enjoy teatime",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761800601"
        ],
        "dialogs": {
          "761800601": {
            "id": "761800601",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Wh—What? That's impossible!",
            "nextDialogs": [
              "761800602"
            ]
          },
          "761800602": {
            "id": "761800602",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Looks like you lost, Sandrone.",
            "nextDialogs": [
              "761800603"
            ]
          },
          "761800603": {
            "id": "761800603",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "I... I let you win!",
            "nextDialogs": [
              "761800604"
            ]
          },
          "761800604": {
            "id": "761800604",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Really? Then why do you seem so worked up?",
            "nextDialogs": [
              "761800605"
            ]
          },
          "761800605": {
            "id": "761800605",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Darn it... I want a rematch!",
            "nextDialogs": [
              "761800606"
            ]
          },
          "761800606": {
            "id": "761800606",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Hmph, piece of cake.",
            "nextDialogs": [
              "761800607"
            ]
          },
          "761800607": {
            "id": "761800607",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "You win. You really are quite skilled, Sandrone.",
            "nextDialogs": [
              "761800608"
            ]
          },
          "761800608": {
            "id": "761800608",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Let's play something more challenging next time. I know a lot of fun math-based games.",
            "nextDialogs": [
              "761800609"
            ]
          },
          "761800609": {
            "id": "761800609",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Sounds exciting! Hehe.",
            "nextDialogs": [
              "761800610"
            ]
          },
          "761800610": {
            "id": "761800610",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Huh? What's so funny?",
            "nextDialogs": [
              "761800611"
            ]
          },
          "761800611": {
            "id": "761800611",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "I can barely remember seeing you this happy before. You hardly ever invited me to play games. Usually, you'd just chase me away.",
            "nextDialogs": [
              "761800612"
            ]
          },
          "761800612": {
            "id": "761800612",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Hey... Don't make me out to be some sort of bully! I'll invite you to more tea parties from now on, alright?",
            "nextDialogs": [
              "761800613"
            ]
          },
          "761800613": {
            "id": "761800613",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "I'd like that, Sandrone. I enjoy these little gatherings."
          }
        }
      }
    },
    {
      "subId": "7618001",
      "subQuestName": "Enjoy teatime",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761800801"
        ],
        "dialogs": {
          "761800801": {
            "id": "761800801",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "It's a lot of fun playing games. I look forward to doing it more often.",
            "nextDialogs": [
              "761800802"
            ]
          },
          "761800802": {
            "id": "761800802",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "(Let's sit like this for a little while longer.)",
            "nextDialogs": [
              "761800804"
            ]
          },
          "761800804": {
            "id": "761800804",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Leaving already? Alright, see you next time."
          }
        }
      }
    },
    {
      "subId": "7618004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761800401"
        ],
        "dialogs": {
          "761800401": {
            "id": "761800401",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "We always used to gather in your garden, Sandrone. Now you're the one visiting me for tea. It's such an odd feeling.",
            "nextDialogs": [
              "761800402"
            ]
          },
          "761800402": {
            "id": "761800402",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "I'm still the one getting everything ready. Doesn't feel so different to me...",
            "nextDialogs": [
              "761800403"
            ]
          },
          "761800403": {
            "id": "761800403",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Mmhmm, and your food is every bit as delicious as I remember.",
            "nextDialogs": [
              "761800404"
            ]
          },
          "761800404": {
            "id": "761800404",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "#Hmm... I hear {NICKNAME} visits you quite often. What do you usually do?",
            "nextDialogs": [
              "761800405"
            ]
          },
          "761800405": {
            "id": "761800405",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Sometimes we chat, sometimes we play games with the kuuhenki, and we also like to watch them draw. Oh, and we play Moon Chess, too.",
            "nextDialogs": [
              "761800406"
            ]
          },
          "761800406": {
            "id": "761800406",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Moon Chess? Is that the one where you try to get three pieces in a row? Who usually wins?",
            "nextDialogs": [
              "761800407"
            ]
          },
          "761800407": {
            "id": "761800407",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "#I don't keep count, but I must say {NICKNAME}'s a very skilled player.",
            "nextDialogs": [
              "761800408"
            ]
          },
          "761800408": {
            "id": "761800408",
            "speakerId": 1000,
            "speakerName": "Marionette",
            "text": "Heh, I'll show you what real skill looks like. Care for a game? If we draw, it counts as a win for you.",
            "nextDialogs": [
              "761800409"
            ]
          },
          "761800409": {
            "id": "761800409",
            "speakerId": 1001,
            "speakerName": "The Damselette",
            "text": "Sure thing. Let's go!"
          }
        }
      }
    }
  ]
}
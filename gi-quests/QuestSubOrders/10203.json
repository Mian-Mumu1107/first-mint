        "dialogs": {
          "102030101": {
            "id": "102030101",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "*sigh* Klee is no ordinary child. In fact, she holds the title of Spark Knight within our ranks.",
            "nextDialogs": [
              "102030102"
            ]
          },
          "102030102": {
            "id": "102030102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "No way! Even Klee gets to be a Knight of Favonius!?",
            "nextDialogs": [
              "102030105"
            ]
          },
          "102030105": {
            "id": "102030105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yes! Paimon thinks this is quite unjust!",
            "nextDialogs": [
              "102030106"
            ]
          },
          "102030106": {
            "id": "102030106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Although... The name kinda makes sense considering what Klee's treasure does.",
            "nextDialogs": [
              "102030107"
            ]
          },
          "102030107": {
            "id": "102030107",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "Yes. She causes her fair share of trouble for the Knights of Favonius, but we care a great deal about her.",
            "nextDialogs": [
              "102030108"
            ]
          },
          "102030108": {
            "id": "102030108",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "As for her background...",
            "nextDialogs": [
              "102030109"
            ]
          },
          "102030109": {
            "id": "102030109",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "In short, you will understand her more as time goes by.",
            "nextDialogs": [
              "102030110"
            ]
          },
          "102030110": {
            "id": "102030110",
            "speakerId": 1000,
            "speakerName": "Jean",
            "text": "#Please keep an eye on her in the future, {NICKNAME}."
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "7521801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752180101"
        ],
        "dialogs": {
          "752180101": {
            "id": "752180101",
            "speakerId": 1000,
            "speakerName": "Huqiru",
            "text": "#Ah, it's {NICKNAME}! Please, wait!",
            "nextDialogs": [
              "752180102"
            ]
          },
          "752180102": {
            "id": "752180102",
            "speakerId": 1000,
            "speakerName": "Huqiru",
            "text": "Here you are...",
            "nextDialogs": [
              "752180103"
            ]
          },
          "752180103": {
            "id": "752180103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh hey! Do you need help with something?",
            "nextDialogs": [
              "752180104"
            ]
          },
          "752180104": {
            "id": "752180104",
            "speakerId": 1000,
            "speakerName": "Huqiru",
            "text": "Haha, not quite. I was just passing by with a package for the two of you. And there I was wondering how I'd track you down...",
            "nextDialogs": [
              "752180105"
            ]
          },
          "752180105": {
            "id": "752180105",
            "speakerId": 1000,
            "speakerName": "Huqiru",
            "text": "Speak of the devil, or make that devils, huh?",
            "nextDialogs": [
              "752180106"
            ]
          },
          "752180106": {
            "id": "752180106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A package! Who's it from?",
            "nextDialogs": [
              "752180107"
            ]
          },
          "752180107": {
            "id": "752180107",
            "speakerId": 1000,
            "speakerName": "Huqiru",
            "text": "Well, it's had quite a journey. It first turned up in the Adventurers' Guild, then after changing hands many times, finally got picked up by the Scions of the Canopy's couriers...",
            "nextDialogs": [
              "752180108"
            ]
          },
          "752180108": {
            "id": "752180108",
            "speakerId": 1000,
            "speakerName": "Huqiru",
            "text": "Considering Natlan's recent state of affairs, normal caravans haven't been up and running for a while. The sender didn't leave their name on the package, but judging by the signature... it seems to be from Fontaine.",
            "nextDialogs": [
              "752180109"
            ]
          },
          "752180109": {
            "id": "752180109",
            "speakerId": 1000,
            "speakerName": "Huqiru",
            "text": "Seems like you've got friends all the way in Fontaine, huh?",
            "nextDialogs": [
              "752180112"
            ]
          },
          "752180112": {
            "id": "752180112",
            "speakerId": 1000,
            "speakerName": "Huqiru",
            "text": "Whew, today's work sure is off to a great start. No sooner do I get the package than I run into its recipient. Praised be the Pyro Archon!",
            "nextDialogs": [
              "752180113"
            ]
          },
          "752180113": {
            "id": "752180113",
            "speakerId": 1000,
            "speakerName": "Huqiru",
            "text": "Alright, I'm gonna go get more deliveries done. Have a good day!",
            "nextDialogs": [
              "752180114"
            ]
          },
          "752180114": {
            "id": "752180114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah, good luck with your work!",
            "nextDialogs": [
              "752180115"
            ]
          },
          "752180115": {
            "id": "752180115",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "From Fontaine, huh... He called it a package, but it's so small! Looks more like a letter to Paimon.",
            "nextDialogs": [
              "752180116"
            ]
          },
          "752180116": {
            "id": "752180116",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's open it and see!",
            "nextDialogs": [
              "752180117"
            ]
          },
          "752180117": {
            "id": "752180117",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, it's from Charlotte! It's the photo we took when we were leaving Fontaine...",
            "nextDialogs": [
              "752180118"
            ]
          },
          "752180118": {
            "id": "752180118",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It hasn't been that long since we took the photo, but it sure feels like forever!",
            "nextDialogs": [
              "752180119"
            ]
          },
          "752180119": {
            "id": "752180119",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe, let's keep this photo someplace safe!"
          }
        }
      }
    },

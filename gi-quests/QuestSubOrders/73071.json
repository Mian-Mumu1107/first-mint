      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730710601"
        ],
        "dialogs": {
          "730710601": {
            "id": "730710601",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "Wow, there are so many Sweet Flowers!",
            "nextDialogs": [
              "730710602"
            ]
          },
          "730710602": {
            "id": "730710602",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Don't run so fast, Varsha!",
            "nextDialogs": [
              "730710603"
            ]
          },
          "730710603": {
            "id": "730710603",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "The flowers are coming along very well here!",
            "nextDialogs": [
              "730710604"
            ]
          },
          "730710604": {
            "id": "730710604",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "#Come on over, Paimon! You too, {NICKNAME}!",
            "nextDialogs": [
              "730710605"
            ]
          },
          "730710605": {
            "id": "730710605",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Varsha just can't sit still for even a second... Let's go, {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "7307107",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730710501"
        ],
        "dialogs": {
          "730710501": {
            "id": "730710501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Strange, what's this kid doing here? Hey kid! Why are you here all alone?",
            "nextDialogs": [
              "730710502"
            ]
          },
          "730710502": {
            "id": "730710502",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Ah! A weird person, and a weird flying person.",
            "nextDialogs": [
              "730710503"
            ]
          },
          "730710503": {
            "id": "730710503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Come on, that's rude!",
            "nextDialogs": [
              "730710504"
            ]
          },
          "730710504": {
            "id": "730710504",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Yeah, that's right. Rude's my middle name. Didn't even have parents to teach me \"manners,\" don'cha know?",
            "nextDialogs": [
              "730710505"
            ]
          },
          "730710505": {
            "id": "730710505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(There's a story behind this for sure...)",
            "nextDialogs": [
              "730710506"
            ]
          },
          "730710506": {
            "id": "730710506",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... Anyway, we aren't weird people, and we definitely aren't bad guys.",
            "nextDialogs": [
              "730710508",
              "730710510"
            ]
          },
          "730710508": {
            "id": "730710508",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Exactly. And that's why we don't leave those who are troubled behind.",
            "nextDialogs": [
              "730710511"
            ]
          },
          "730710511": {
            "id": "730710511",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Paimon's name is Paimon, and this is {NICKNAME}. Might we know your name?",
            "nextDialogs": [
              "730710512"
            ]
          },
          "730710512": {
            "id": "730710512",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "My name is Varsha...",
            "nextDialogs": [
              "730710513"
            ]
          },
          "730710513": {
            "id": "730710513",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And why are you here all alone, Varsha? We can escort you back if you're lost.",
            "nextDialogs": [
              "730710514"
            ]
          },
          "730710514": {
            "id": "730710514",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "No. The past should stay in the past. I've decided to move on.",
            "nextDialogs": [
              "730710515"
            ]
          },
          "730710515": {
            "id": "730710515",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh?",
            "nextDialogs": [
              "730710516"
            ]
          },
          "730710516": {
            "id": "730710516",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "I can't rely on adults. I must go my own way...",
            "nextDialogs": [
              "730710517"
            ]
          },
          "730710517": {
            "id": "730710517",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What's with this old-person talk...? You are just a kid! Anyway, the forest can be pretty dangerous. A kid like you isn't gonna be able to handle it.",
            "nextDialogs": [
              "730710518"
            ]
          },
          "730710518": {
            "id": "730710518",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "Some bad guy tried to take me away earlier... But it's okay. I'm more careful now. I'll be able to avoid danger.",
            "nextDialogs": [
              "730710519"
            ]
          },
          "730710519": {
            "id": "730710519",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "He was a guy from Vimara Village, and he looked nice enough. But as it turns out, he was no different from those adults I met before...",
            "nextDialogs": [
              "730710520"
            ]
          },
          "730710520": {
            "id": "730710520",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You almost got taken away by some bad guy!? You haven't learned your lesson at all, then! Wait, and how did you manage to get away last time, anyway?",
            "nextDialogs": [
              "730710521"
            ]
          },
          "730710521": {
            "id": "730710521",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "Some small creature whisked me to this place. I've never seen something this small in Gandharva Ville, so I believe that it had to be a forest spirit.",
            "nextDialogs": [
              "730710522"
            ]
          },
          "730710522": {
            "id": "730710522",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(That should be an Aranara.)",
            "nextDialogs": [
              "730710523"
            ]
          },
          "730710523": {
            "id": "730710523",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "(That said, could \"that guy from Vimara Village\" refer to...)",
            "nextDialogs": [
              "730710524"
            ]
          },
          "730710524": {
            "id": "730710524",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Anyway, it's still not safe for kids to be alone in the forest. You might encounter all kinds of dangers, like...",
            "nextDialogs": [
              "730710525"
            ]
          },
          "730710525": {
            "id": "730710525",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Running into dangerous Fungi.",
            "nextDialogs": [
              "730710526"
            ]
          },
          "730710526": {
            "id": "730710526",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah! And villains such as Nara Marana. Ugh, no, Paimon meant to say...",
            "nextDialogs": [
              "730710527"
            ]
          },
          "730710527": {
            "id": "730710527",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You might run into bad guys that might try to kidnap you.",
            "nextDialogs": [
              "730710528"
            ]
          },
          "730710528": {
            "id": "730710528",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Yup! What {NICKNAME} said! Or... or you might starve!",
            "nextDialogs": [
              "730710529"
            ]
          },
          "730710529": {
            "id": "730710529",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "It's impossible to starve in a forest full of nature's gifts. Starshrooms, Sweet Flowers, and Mints are everywhere, and I eat like a bird anyway.",
            "nextDialogs": [
              "730710530"
            ]
          },
          "730710530": {
            "id": "730710530",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "And I've always been pretty good at taking care of plants, so finding a safe place to plant some Sweet Flowers or Mints to feed myself won't be a problem.",
            "nextDialogs": [
              "730710531"
            ]
          },
          "730710531": {
            "id": "730710531",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "Haha, a garden full of Sweet Flowers... Wouldn't that be paradise?",
            "nextDialogs": [
              "730710532"
            ]
          },
          "730710532": {
            "id": "730710532",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A garden full of Sweet Flowers, huh... Ooh, Paimon remembers that there were many in the garden we took care of for the Aranara!",
            "nextDialogs": [
              "730710533"
            ]
          },
          "730710533": {
            "id": "730710533",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "Wait. Are you saying that there really is a paradise like that out there, Paimon?",
            "nextDialogs": [
              "730710534"
            ]
          },
          "730710534": {
            "id": "730710534",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yup! And believe it or not, the \"forest spirit\" that saved you is from a species called the Aranara.",
            "nextDialogs": [
              "730710535"
            ]
          },
          "730710535": {
            "id": "730710535",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We know this, 'cause we've helped plant many Viparyas for them.",
            "nextDialogs": [
              "730710536"
            ]
          },
          "730710536": {
            "id": "730710536",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We helped the earth to remember.",
            "nextDialogs": [
              "730710537"
            ]
          },
          "730710537": {
            "id": "730710537",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's right. According to Aranakula, Vanarana remembers everything, so the Viparyas can sprout in the garden once the land remembers them again.",
            "nextDialogs": [
              "730710538"
            ]
          },
          "730710538": {
            "id": "730710538",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "...I've heard a lot of stories like this before, and only kids take them seriously. But I know you said this with good intentions, Paimon, so thank you.",
            "nextDialogs": [
              "730710539"
            ]
          },
          "730710539": {
            "id": "730710539",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Aren't you a kid as well? And Paimon's not telling stories. Paimon means it for real!",
            "nextDialogs": [
              "730710540"
            ]
          },
          "730710540": {
            "id": "730710540",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "Yeah. That's what every storyteller says.",
            "nextDialogs": [
              "730710541"
            ]
          },
          "730710541": {
            "id": "730710541",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "If you don't believe us... Well, seeing is believing! Come with us and see for yourself!",
            "nextDialogs": [
              "730710542"
            ]
          },
          "730710542": {
            "id": "730710542",
            "speakerId": 1000,
            "speakerName": "Varsha",
            "text": "Wait, you've really prepared a place to fit your story? Now I'm getting curious.",
            "nextDialogs": [
              "730710543"
            ]
          },
          "730710543": {
            "id": "730710543",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ugh, Paimon's telling you the truth...",
            "nextDialogs": [
              "730710544"
            ]
          },
          "730710544": {
            "id": "730710544",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Let's take her to the Aranara's garden, {NICKNAME}. That should silence her doubts once and for all."
          },
          "730710510": {
            "id": "730710510",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yes. So of course we got worried when we saw a little girl like you here all alone! We just can't leave you like this knowing that you might need help."
          }
        }
      }
    },

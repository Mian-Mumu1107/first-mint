    {
      "subId": "2204801",
      "subQuestName": "Talk to Neko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220480101"
        ],
        "dialogs": {
          "220480101": {
            "id": "220480101",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "The shrine is getting messy again...",
            "nextDialogs": [
              "220480102"
            ]
          },
          "220480102": {
            "id": "220480102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "220480103"
            ]
          },
          "220480103": {
            "id": "220480103",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Meow, it is you again. Well met.",
            "nextDialogs": [
              "220480104"
            ]
          },
          "220480104": {
            "id": "220480104",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Ah, the fallen leaves infest the shrine once again. How unsightly...",
            "nextDialogs": [
              "220480105"
            ]
          },
          "220480105": {
            "id": "220480105",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "This is no way to greet those humans coming to pay their respects.",
            "nextDialogs": [
              "220480106"
            ]
          },
          "220480106": {
            "id": "220480106",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Could you aid me in cleaning up the shrine, as you did before?",
            "nextDialogs": [
              "220480108",
              "220480113"
            ]
          },
          "220480108": {
            "id": "220480108",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "I... will not speak to those two green humans of my own accord.",
            "nextDialogs": [
              "220480109"
            ]
          },
          "220480109": {
            "id": "220480109",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "The tall human always looks upon me with a strange gaze...",
            "nextDialogs": [
              "220480110"
            ]
          },
          "220480110": {
            "id": "220480110",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "And the other green human never seems particularly... motivated?",
            "nextDialogs": [
              "220480111"
            ]
          },
          "220480111": {
            "id": "220480111",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Meow meow, regardless, they are not reliable humans.",
            "nextDialogs": [
              "220480115"
            ]
          },
          "220480115": {
            "id": "220480115",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Whatever the case, I can only rely on you for this task. Just use the long stick to clean it all up."
          },
          "220480113": {
            "id": "220480113",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "The stone human is always busy with his knock-knock-knocking. Who knows what he is doing.",
            "nextDialogs": [
              "220480114"
            ]
          },
          "220480114": {
            "id": "220480114",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "The stone was knocked, after all. What is he knocking this time, I wonder... How annoying..."
          }
        }
      }
    },
    {
      "subId": "2204802",
      "subQuestName": "Sweep the fallen leaves around the Asase Shrine away",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220480201"
        ],
        "dialogs": {
          "220480201": {
            "id": "220480201",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "In any case, the cleanup shall be left to you. I will wait for you here, meow meow."
          }
        }
      }
    },
    {
      "subId": "2204803",
      "subQuestName": "Report back to Neko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220480301"
        ],
        "dialogs": {
          "220480301": {
            "id": "220480301",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Mm, have you finished this \"cleanup\" business?",
            "nextDialogs": [
              "220480302"
            ]
          },
          "220480302": {
            "id": "220480302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We sure have.",
            "nextDialogs": [
              "220480303"
            ]
          },
          "220480303": {
            "id": "220480303",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Meow meow, that is good. You are indeed very reliable.",
            "nextDialogs": [
              "220480304"
            ]
          },
          "220480304": {
            "id": "220480304",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "The shrine certainly looks the part now. Ah, Hibiki will be pleased when she returns.",
            "nextDialogs": [
              "220480305"
            ]
          },
          "220480305": {
            "id": "220480305",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "I must continue taking good care of this shrine... Meow meow..."
          }
        }
      }
    }
  ]

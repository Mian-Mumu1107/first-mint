  "subQuests": [
    {
      "subId": "7611401",
      "subQuestName": "Visit the Curatorium of Secrets",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761140101"
        ],
        "dialogs": {
          "761140101": {
            "id": "761140101",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "So, this time we're investigating... a suspicious hermit?",
            "nextDialogs": [
              "761140102"
            ]
          },
          "761140102": {
            "id": "761140102",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Aren't hermits all suspicious by nature? Anyone who runs off to live halfway up a remote mountain can't be entirely normal...",
            "nextDialogs": [
              "761140103"
            ]
          },
          "761140103": {
            "id": "761140103",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "People don't change for no reason, regardless of whether those changes are driven by internal or external factors.",
            "nextDialogs": [
              "761140104"
            ]
          },
          "761140104": {
            "id": "761140104",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Besides, that missing merchant raises questions...",
            "nextDialogs": [
              "761140105"
            ]
          },
          "761140105": {
            "id": "761140105",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Huh? But that area's full of dangers — everyone knows that. Bandits, monsters... There are a million ways a traveling merchant might meet their end out there.",
            "nextDialogs": [
              "761140106"
            ]
          },
          "761140106": {
            "id": "761140106",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Seeing as everyone knows how dangerous it is, don't you think a merchant who regularly passes through would be well prepared?",
            "nextDialogs": [
              "761140107"
            ]
          },
          "761140107": {
            "id": "761140107",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Despite knowing the lay of the land, an experienced merchant just disappeared. Something like that rightly raises suspicion.",
            "nextDialogs": [
              "761140108"
            ]
          },
          "761140108": {
            "id": "761140108",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Jahoda, I'm leaving it to you to visit this \"suspicious hermit.\"",
            "nextDialogs": [
              "761140109"
            ]
          },
          "761140109": {
            "id": "761140109",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "It's a long road — make sure you don't stray from the path.",
            "nextDialogs": [
              "761140110"
            ]
          },
          "761140110": {
            "id": "761140110",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Oh... Sure thing, Boss Nef! Leave it to me!"
          }
        }
      }
    },
    {
      "subId": "7611402",
      "subQuestName": "Investigate the hermit's hut",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761140201"
        ],
        "dialogs": {
          "761140201": {
            "id": "761140201",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Hello? Is anybody there?",
            "nextDialogs": [
              "761140202"
            ]
          },
          "761140202": {
            "id": "761140202",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Mr. Derwent? Are you home?",
            "nextDialogs": [
              "761140203"
            ]
          },
          "761140203": {
            "id": "761140203",
            "speakerId": 1002,
            "speakerName": "Derwent?",
            "text": "...Who's there?",
            "nextDialogs": [
              "761140204"
            ]
          },
          "761140204": {
            "id": "761140204",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "The name's Jahoda. I'm here from the Curatorium of Secrets. I was wondering if I could ask you a few questions...",
            "nextDialogs": [
              "761140205"
            ]
          },
          "761140205": {
            "id": "761140205",
            "speakerId": 1002,
            "speakerName": "Derwent?",
            "text": "...You can ask from there. I'm ill, don't expect me to get up for you.",
            "nextDialogs": [
              "761140206"
            ]
          },
          "761140206": {
            "id": "761140206",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(How strange... The Conch Gang kids said Mr. Derwent taught them how to read. They said he always spoke softly...)",
            "nextDialogs": [
              "761140207"
            ]
          },
          "761140207": {
            "id": "761140207",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(This voice is hoarse, but he doesn't sound ill. It sounds like his voice is naturally rough...)",
            "nextDialogs": [
              "761140208"
            ]
          },
          "761140208": {
            "id": "761140208",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Are you alright? If it's serious, I could help you find a doctor...",
            "nextDialogs": [
              "761140209"
            ]
          },
          "761140209": {
            "id": "761140209",
            "speakerId": 1002,
            "speakerName": "Derwent?",
            "text": "...No need. I'll be right in a bit.",
            "nextDialogs": [
              "761140210"
            ]
          },
          "761140210": {
            "id": "761140210",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Alright. In that case, you should head to Nasha Town when you're better — your friends have been worried about you.",
            "nextDialogs": [
              "761140211"
            ]
          },
          "761140211": {
            "id": "761140211",
            "speakerId": 1002,
            "speakerName": "Derwent?",
            "text": "...",
            "nextDialogs": [
              "761140212"
            ]
          },
          "761140212": {
            "id": "761140212",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(...Why's he not saying anything? I can hear someone walking around in there, but the footsteps are heavy...)",
            "nextDialogs": [
              "761140213"
            ]
          },
          "761140213": {
            "id": "761140213",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Have you not been outside much recently?",
            "nextDialogs": [
              "761140214"
            ]
          },
          "761140214": {
            "id": "761140214",
            "speakerId": 1002,
            "speakerName": "Derwent?",
            "text": "...I've been cultivating myself.",
            "nextDialogs": [
              "761140215"
            ]
          },
          "761140215": {
            "id": "761140215",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Yeah, word on the street is that you've recently had a bit of a makeover... Someone was saying they couldn't believe how strong you look — they said you used to look so thin when you were wearing robes.",
            "nextDialogs": [
              "761140216"
            ]
          },
          "761140216": {
            "id": "761140216",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "And a mask to block out kuuvahki... Is that the latest fashion?",
            "nextDialogs": [
              "761140217"
            ]
          },
          "761140217": {
            "id": "761140217",
            "speakerId": 1002,
            "speakerName": "Derwent?",
            "text": "...It's to block out the noise.",
            "nextDialogs": [
              "761140218"
            ]
          },
          "761140218": {
            "id": "761140218",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "So you can better cultivate yourself...?",
            "nextDialogs": [
              "761140219"
            ]
          },
          "761140219": {
            "id": "761140219",
            "speakerId": 1002,
            "speakerName": "Derwent?",
            "text": "...",
            "nextDialogs": [
              "761140220"
            ]
          },
          "761140220": {
            "id": "761140220",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "Anyway, there was a merchant who came to visit you not long ago. Do you know where he went?",
            "nextDialogs": [
              "761140221"
            ]
          },
          "761140221": {
            "id": "761140221",
            "speakerId": 1002,
            "speakerName": "Derwent?",
            "text": "...No idea.",
            "nextDialogs": [
              "761140222"
            ]
          },
          "761140222": {
            "id": "761140222",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "A—Alright, then... Sorry to bother you.",
            "nextDialogs": [
              "761140223"
            ]
          },
          "761140223": {
            "id": "761140223",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(I'm not sure why, but I feel it in my bones — this is getting dangerous...)",
            "nextDialogs": [
              "761140224"
            ]
          },
          "761140224": {
            "id": "761140224",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(They weren't wrong. This seems like a completely different guy...)",
            "nextDialogs": [
              "761140225"
            ]
          },
          "761140225": {
            "id": "761140225",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(I can't go back to Boss Nef having only learned so little. I'd better stay close and investigate the surrounding area.)"
          }
        }
      }
    },
    {
      "subId": "7611403",
      "subQuestName": "Look for clues outside the hut",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761140301"
        ],
        "dialogs": {
          "761140301": {
            "id": "761140301",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(Huh? This looks like... It hasn't been completely burned...)",
            "nextDialogs": [
              "761140302"
            ]
          },
          "761140302": {
            "id": "761140302",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(I heard Mr. Derwent would take in injured adventurers... This seems to have happened recently.)",
            "nextDialogs": [
              "761140303"
            ]
          },
          "761140303": {
            "id": "761140303",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(Why would he try to burn these...?)"
          }
        }
      }
    },
    {
      "subId": "7611404",
      "subQuestName": "Talk to the person inside the hut",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761140401"
        ],
        "dialogs": {
          "761140401": {
            "id": "761140401",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(I can't hear anything. Is he resting? Or...)"
          }
        }
      }
    },
    {
      "subId": "7611499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761149901"
        ],
        "dialogs": {
          "761149901": {
            "id": "761149901",
            "speakerId": 1317,
            "speakerName": "Jahoda",
            "text": "(It's about time I left.)"
          }
        }
      }
    }
  ]
}
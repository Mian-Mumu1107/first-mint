  "subQuests": [
    {
      "subId": "2300502",
      "subQuestName": "Talk to Hatim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050201"
        ],
        "dialogs": {
          "230050201": {
            "id": "230050201",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "Hm... Not bad at all...",
            "nextDialogs": [
              "230050202"
            ]
          },
          "230050202": {
            "id": "230050202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Looks like you've made a fortune...",
            "nextDialogs": [
              "230050203"
            ]
          },
          "230050203": {
            "id": "230050203",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "Ah, Traveler! Thanks to you, I've made a small profit this time. Looks like the \"Golden Dish\" proved effective.",
            "nextDialogs": [
              "230050204"
            ]
          },
          "230050204": {
            "id": "230050204",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "However, it's not much different from what I usually earn from normal trades...",
            "nextDialogs": [
              "230050205"
            ]
          },
          "230050205": {
            "id": "230050205",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "This is not how a \"Golden Dish\" should work. Did I eat the wrong dish...?",
            "nextDialogs": [
              "230050206"
            ]
          },
          "230050206": {
            "id": "230050206",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "Traveler, let's try this once more. Can you please help me choose a \"Golden Dish\" again?",
            "nextDialogs": [
              "230050207"
            ]
          },
          "230050207": {
            "id": "230050207",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "Just as always, please pick one from among <color=#00E1FFFF>Mora Meat</color>, <color=#00E1FFFF>Butter Chicken</color>, and <color=#00E1FFFF>Pile 'Em Up</color>."
          }
        }
      }
    },
    {
      "subId": "2300503",
      "subQuestName": "Help Hatim select a Golden Dish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050301"
        ],
        "dialogs": {
          "230050301": {
            "id": "230050301",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "After the minor profit last time, I'm definitely making a killing this time! <color=#00E1FFFF>Mora Meat</color>, <color=#00E1FFFF>Butter Chicken</color>, and <color=#00E1FFFF>Pile 'Em Up</color>. How about it, then? What'll your choice be?"
          }
        }
      }
    },
    {
      "subId": "2300507",
      "subQuestName": "Help Hatim select a Golden Dish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050701"
        ],
        "dialogs": {
          "230050701": {
            "id": "230050701",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "Good! A dish of excellent quality! I'm sure the futures I bought will surge this time!"
          }
        }
      }
    },
    {
      "subId": "2300508",
      "subQuestName": "Help Hatim select a Golden Dish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050801"
        ],
        "dialogs": {
          "230050801": {
            "id": "230050801",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "This looks to be of good quality. Will I be able to make a fine profit this time?"
          }
        }
      }
    },
    {
      "subId": "2300509",
      "subQuestName": "Help Hatim select a Golden Dish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050901"
        ],
        "dialogs": {
          "230050901": {
            "id": "230050901",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "This dish looks a little strange... Oh well, it matters not. Work calls me.",
            "nextDialogs": [
              "230050902"
            ]
          },
          "230050902": {
            "id": "230050902",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "I can't thank you enough, Traveler! Hope we'll meet again."
          }
        }
      }
    },
    {
      "subId": "2300504",
      "subQuestName": "Talk to Hatim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050401"
        ],
        "dialogs": {
          "230050401": {
            "id": "230050401",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "Uh...",
            "nextDialogs": [
              "230050402"
            ]
          },
          "230050402": {
            "id": "230050402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hi! Hatim, how have you been?",
            "nextDialogs": [
              "230050403"
            ]
          },
          "230050403": {
            "id": "230050403",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "Oh... It's you guys.",
            "nextDialogs": [
              "230050404"
            ]
          },
          "230050404": {
            "id": "230050404",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "Well, I guess you can tell from my expression, no?",
            "nextDialogs": [
              "230050405"
            ]
          },
          "230050405": {
            "id": "230050405",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "I'll be honest, my wallet has been rendered half empty.",
            "nextDialogs": [
              "230050406"
            ]
          },
          "230050406": {
            "id": "230050406",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "Strange... This isn't how things should have gone...",
            "nextDialogs": [
              "230050407"
            ]
          },
          "230050407": {
            "id": "230050407",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "But then again... I have a suspicion that this is a sign that the market's about to take off.",
            "nextDialogs": [
              "230050408"
            ]
          },
          "230050408": {
            "id": "230050408",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "It's like how people have to bend down before they can leap high.",
            "nextDialogs": [
              "230050409"
            ]
          },
          "230050409": {
            "id": "230050409",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "The same goes for the futures trading market. The entire market just fell to an all-time low and it's about to bottom out!",
            "nextDialogs": [
              "230050410"
            ]
          },
          "230050410": {
            "id": "230050410",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "In other words, now is the best time to go bargain-hunting!",
            "nextDialogs": [
              "230050413"
            ]
          },
          "230050413": {
            "id": "230050413",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "No. I am pretty sure this is a once-in-a-lifetime chance, and Hatim never misses any chance to gain wealth.",
            "nextDialogs": [
              "230050414"
            ]
          },
          "230050414": {
            "id": "230050414",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "That would be worthy of my name as Kalimi's exceptionally wealthy Hatim!",
            "nextDialogs": [
              "230050415"
            ]
          },
          "230050415": {
            "id": "230050415",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "Come, friend, help me out one more time, will you? Please choose another \"Golden Dish\"!",
            "nextDialogs": [
              "230050416"
            ]
          },
          "230050416": {
            "id": "230050416",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Still from the original options?",
            "nextDialogs": [
              "230050417"
            ]
          },
          "230050417": {
            "id": "230050417",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "Hm... Wait, no! Since we're going bargain-hunting, I need a dish that is extra special to turn the tide on the market.",
            "nextDialogs": [
              "230050418"
            ]
          },
          "230050418": {
            "id": "230050418",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "I heard that Mondstadt has a tycoon who runs a super profitable alcohol business...",
            "nextDialogs": [
              "230050419"
            ]
          },
          "230050419": {
            "id": "230050419",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you mean...",
            "nextDialogs": [
              "230050420"
            ]
          },
          "230050420": {
            "id": "230050420",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Master Diluc?",
            "nextDialogs": [
              "230050421"
            ]
          },
          "230050421": {
            "id": "230050421",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But how did you know about...",
            "nextDialogs": [
              "230050422"
            ]
          },
          "230050422": {
            "id": "230050422",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "Hahaha, how could I not know of him, when I even know about \"Pile 'Em Up\"?",
            "nextDialogs": [
              "230050423"
            ]
          },
          "230050423": {
            "id": "230050423",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "He owns a tavern where they sell something wonderful known as Apple Cider. If I down some of that, I believe I shall imbibe some of his affinity for wealth as well!",
            "nextDialogs": [
              "230050424"
            ]
          },
          "230050424": {
            "id": "230050424",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "So please, help me get a bottle of Apple Cider!"
          }
        }
      }
    },
    {
      "subId": "2300505",
      "subQuestName": "Help Hatim prepare an Apple Cider",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050501"
        ],
        "dialogs": {
          "230050501": {
            "id": "230050501",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "We shall earn back what was lost, and with interest to boot!"
          }
        }
      }
    },
    {
      "subId": "2300506",
      "subQuestName": "Talk to Hatim",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050601"
        ],
        "dialogs": {
          "230050601": {
            "id": "230050601",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "This is that tycoon's apple cider, yes? Ah, what an extraordinary aroma. It truly clears the mind!",
            "nextDialogs": [
              "230050602"
            ]
          },
          "230050602": {
            "id": "230050602",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "Great! This is the good stuff indeed. It shall surely bring about a shift in the market!",
            "nextDialogs": [
              "230050603"
            ]
          },
          "230050603": {
            "id": "230050603",
            "speakerId": 1000,
            "speakerName": "Hatim",
            "text": "I won't forget the help you two have given me! I'll see you around!"
          }
        }
      }
    }
  ]
}
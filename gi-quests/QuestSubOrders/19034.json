  "subQuests": [
    {
      "subId": "1903401",
      "subQuestName": "Look for signs of evil spirits alone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "1903201201"
        ],
        "dialogs": {
          "1903201201": {
            "id": "1903201201",
            "speakerId": 1000,
            "speakerName": "Zhouliang",
            "text": "Ugh... I'm beat. Finally, I can take a break.",
            "nextDialogs": [
              "1903201202"
            ]
          },
          "1903201202": {
            "id": "1903201202",
            "speakerId": 1000,
            "speakerName": "Zhouliang",
            "text": "*sigh* I wonder if I took things a little too far... A few people seemed scared out of their minds.",
            "nextDialogs": [
              "1903201203"
            ]
          },
          "1903201203": {
            "id": "1903201203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Who are you?",
            "nextDialogs": [
              "1903201204"
            ]
          },
          "1903201204": {
            "id": "1903201204",
            "speakerId": 1000,
            "speakerName": "Zhouliang",
            "text": "Huh? Hey, you shouldn't be here!",
            "nextDialogs": [
              "1903201205"
            ]
          },
          "1903201205": {
            "id": "1903201205",
            "speakerId": 1000,
            "speakerName": "Zhouliang",
            "text": "*sigh* Never mind. I assume you overheard me anyway.",
            "nextDialogs": [
              "1903201206"
            ]
          },
          "1903201206": {
            "id": "1903201206",
            "speakerId": 1000,
            "speakerName": "Zhouliang",
            "text": "I work here pretending to be a ghost, but now's my break time, so I took off my costume. I get all hot and stuffy wearing that thing...",
            "nextDialogs": [
              "1903201209"
            ]
          },
          "1903201209": {
            "id": "1903201209",
            "speakerId": 1000,
            "speakerName": "Zhouliang",
            "text": "Of course, how could there be real ghosts here?",
            "nextDialogs": [
              "1903201210"
            ]
          },
          "1903201210": {
            "id": "1903201210",
            "speakerId": 1000,
            "speakerName": "Zhouliang",
            "text": "No one wants to see a real ghost, neither us nor the participants.",
            "nextDialogs": [
              "1903201211"
            ]
          },
          "1903201211": {
            "id": "1903201211",
            "speakerId": 1000,
            "speakerName": "Zhouliang",
            "text": "They just come here for the atmosphere, or should I say, the chance... Everyone wants the chance to feel the thrill of excitement.",
            "nextDialogs": [
              "1903201212"
            ]
          },
          "1903201212": {
            "id": "1903201212",
            "speakerId": 1000,
            "speakerName": "Zhouliang",
            "text": "When people find themselves in a scary situation, they'll say things that they'd never dare to otherwise. That's what the Test of Courage is all about."
          }
        }
      }
    },

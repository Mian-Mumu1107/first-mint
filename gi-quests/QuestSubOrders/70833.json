  "subQuests": [
    {
      "subId": "7083301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "618010301"
        ],
        "dialogs": {
          "618010301": {
            "id": "618010301",
            "speakerId": 1000,
            "speakerName": "Lohen",
            "text": "There. Perfect.",
            "nextDialogs": [
              "618010302"
            ]
          },
          "618010302": {
            "id": "618010302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wait, Lohen? Is that... a report you're writing?",
            "nextDialogs": [
              "618010303"
            ]
          },
          "618010303": {
            "id": "618010303",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This is a surprise. Paimon always figured you'd hate paperwork even more than Varka does.",
            "nextDialogs": [
              "618010304"
            ]
          },
          "618010304": {
            "id": "618010304",
            "speakerId": 1000,
            "speakerName": "Lohen",
            "text": "Not at all. This is simply part of a captain's responsibility... even if I'm only the Vice Captain for now.",
            "nextDialogs": [
              "618010305"
            ]
          },
          "618010305": {
            "id": "618010305",
            "speakerId": 1000,
            "speakerName": "Lohen",
            "text": "This report concerns the personnel arrangements for the expeditionary force upon their return. It still needs to be reviewed by Cardinal Seamus, who was in charge of administration during the expedition.",
            "nextDialogs": [
              "618010306"
            ]
          },
          "618010306": {
            "id": "618010306",
            "speakerId": 1000,
            "speakerName": "Lohen",
            "text": "By the way, if you happen to be heading back to Mondstadt, would you mind taking this with you?",
            "nextDialogs": [
              "618010309"
            ]
          },
          "618010309": {
            "id": "618010309",
            "speakerId": 1000,
            "speakerName": "Lohen",
            "text": "Haha, that's precisely why I want to entrust it to you, Honorary Knight."
          }
        }
      }
    },
    {
      "subId": "7083302",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "618010401"
        ],
        "dialogs": {
          "618010401": {
            "id": "618010401",
            "speakerId": 1002,
            "speakerName": "Seamus Pegg",
            "text": "Hello, Honorary Knight. What brings you to the Cathedral today?",
            "nextDialogs": [
              "618010402"
            ]
          },
          "618010402": {
            "id": "618010402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Lohen asked me to drop off a report...",
            "nextDialogs": [
              "618010403"
            ]
          },
          "618010403": {
            "id": "618010403",
            "speakerId": 1002,
            "speakerName": "Seamus Pegg",
            "text": "Lohen? Submitting a report before the deadline? Truly a marvel of our time... Let me take a look.",
            "nextDialogs": [
              "618010404"
            ]
          },
          "618010404": {
            "id": "618010404",
            "speakerId": 1002,
            "speakerName": "Seamus Pegg",
            "text": "Hmm... The handwriting is quite neat, and the phrasing is very precise...",
            "nextDialogs": [
              "618010405"
            ]
          },
          "618010405": {
            "id": "618010405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is something wrong? Or is the report satisfactory?",
            "nextDialogs": [
              "618010406"
            ]
          },
          "618010406": {
            "id": "618010406",
            "speakerId": 1002,
            "speakerName": "Seamus Pegg",
            "text": "Nothing's wrong, aside from the fact that it's obvious Lohen didn't write a word of it. Ten to one, he outsourced this to Gunther or Ursula.",
            "nextDialogs": [
              "618010407"
            ]
          },
          "618010407": {
            "id": "618010407",
            "speakerId": 1002,
            "speakerName": "Seamus Pegg",
            "text": "Still, at least he turned it in on time for once, and it looks like he actually bothered to check it himself... I won't say any more.",
            "nextDialogs": [
              "618010408"
            ]
          },
          "618010408": {
            "id": "618010408",
            "speakerId": 1002,
            "speakerName": "Seamus Pegg",
            "text": "I only hope Grand Master Varka and Lord Barbatos can find it in their hearts to excuse him, too.",
            "nextDialogs": [
              "618010409"
            ]
          },
          "618010409": {
            "id": "618010409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Varka and Barbatos, you say...",
            "nextDialogs": [
              "618010410"
            ]
          },
          "618010410": {
            "id": "618010410",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Knowing them... They'll let it slide."
          }
        }
      }
    }
  ]
}
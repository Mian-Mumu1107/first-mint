    {
      "subId": "2302711",
      "subQuestName": "Report back to Yasmin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230271101"
        ],
        "dialogs": {
          "230271101": {
            "id": "230271101",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "You're back. How are the Divine Tree roots?",
            "nextDialogs": [
              "230271102"
            ]
          },
          "230271102": {
            "id": "230271102",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You describe the condition of the roots to Yasmin...",
            "nextDialogs": [
              "230271103"
            ]
          },
          "230271103": {
            "id": "230271103",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "...Oh, if there are living creatures gathered there, then the area should still be full of vitality.",
            "nextDialogs": [
              "230271104"
            ]
          },
          "230271104": {
            "id": "230271104",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "That means that the roots of the Divine Tree should be able to grow steadily without any serious problems for now.",
            "nextDialogs": [
              "230271105"
            ]
          },
          "230271105": {
            "id": "230271105",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "The only concern... is the possible eutrophication of the surrounding water bodies, which might nourish more Fungi...",
            "nextDialogs": [
              "230271106"
            ]
          },
          "230271106": {
            "id": "230271106",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "Anyway, here's your payment. Thanks for your help.",
            "nextDialogs": [
              "230271107"
            ]
          },
          "230271107": {
            "id": "230271107",
            "speakerId": 4178,
            "speakerName": "Yasmin",
            "text": "We'd best have Ladep and Pharez monitor the concentration of elements nearby..."
          }
        }
      }
    }

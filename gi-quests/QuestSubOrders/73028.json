  "subQuests": [
    {
      "subId": "7302801",
      "subQuestName": "Look for the submerged cave",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730280101"
        ],
        "dialogs": {
          "730280101": {
            "id": "730280101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's a big robot component here, too. Paimon reckons that Jazari'll take his Kamera out again if he sees it.",
            "nextDialogs": [
              "730280102"
            ]
          },
          "730280102": {
            "id": "730280102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ararycan claims to have moved the big components back there. But that can't be true, right?",
            "nextDialogs": [
              "730280103"
            ]
          },
          "730280103": {
            "id": "730280103",
            "speakerId": 16767,
            "speakerName": "Ararycan",
            "text": "Of course it is true. Ararycan doesn't deceive Nara.",
            "nextDialogs": [
              "730280106"
            ]
          },
          "730280106": {
            "id": "730280106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ararycan was the Aranara who played with the kids at the secret base.",
            "nextDialogs": [
              "730280107"
            ]
          },
          "730280107": {
            "id": "730280107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But Ararycan remembers nothing about this..."
          }
        }
      }
    },
    {
      "subId": "7302804",

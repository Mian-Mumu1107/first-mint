    {
      "subId": "7302802",
      "subQuestName": "Go to the cave below",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730280201"
        ],
        "dialogs": {
          "730280201": {
            "id": "730280201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like there are big robot parts here, too. Gee, imagine what would happen if Jazari saw them, eh? He'd whip his Kamera out again, and that would be the last we'd hear of him for a while.",
            "nextDialogs": [
              "730280202"
            ]
          },
          "730280202": {
            "id": "730280202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ararycan claims to have moved the components back there. But that can't be true, right?",
            "nextDialogs": [
              "730280203"
            ]
          },
          "730280203": {
            "id": "730280203",
            "speakerId": 16767,
            "speakerName": "Ararycan",
            "text": "Of course it is true. Ararycan doesn't deceive Nara.",
            "nextDialogs": [
              "730280206"
            ]
          },
          "730280206": {
            "id": "730280206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ararycan was the Aranara who played with the kids at the secret base.",
            "nextDialogs": [
              "730280207"
            ]
          },
          "730280207": {
            "id": "730280207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But Ararycan remembers nothing about this... Do Aranara forget the past too?",
            "nextDialogs": [
              "730280208"
            ]
          },
          "730280208": {
            "id": "730280208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"The forest remembers everything.\"",
            "nextDialogs": [
              "730280209"
            ]
          },
          "730280209": {
            "id": "730280209",
            "speakerId": 16767,
            "speakerName": "Ararycan",
            "text": "Ararycan doesn't know what you're talking about and Ararycan can't remember. But it's fun hanging around with little Nara!",
            "nextDialogs": [
              "730280210"
            ]
          },
          "730280210": {
            "id": "730280210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon hopes you remain happy wherever you may go, Ararycan."
          }
        }
      }
    },

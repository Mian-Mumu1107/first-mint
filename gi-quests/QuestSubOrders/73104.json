    {
      "subId": "7310412",
      "subQuestName": "Talk to Helbet and Kayvan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731041201"
        ],
        "dialogs": {
          "731041201": {
            "id": "731041201",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Looks like everything's going well. Time for one last fishing attempt.",
            "nextDialogs": [
              "731041202"
            ]
          },
          "731041202": {
            "id": "731041202",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Whew... Third time's a charm. Please let me hook some fish! Even a teeny-tiny one will do.",

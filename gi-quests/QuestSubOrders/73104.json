    {
      "subId": "7310407",
      "subQuestName": "Talk to Helbet and Kayvan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731040701"
        ],
        "dialogs": {
          "731040701": {
            "id": "731040701",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Okay. Here goes the fishing again.",
            "nextDialogs": [
              "731040702"
            ]
          },
          "731040702": {
            "id": "731040702",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "I need to concentrate. Please don't make any noise...",
            "nextDialogs": [
              "731040703"
            ]
          },
          "731040703": {
            "id": "731040703",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Kayvan begins to focus on fishing...",
            "nextDialogs": [
              "731040704"
            ]
          },
          "731040704": {
            "id": "731040704",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "Argh! Look over there! So many Slimes!",
            "nextDialogs": [
              "731040705"
            ]
          },
          "731040705": {
            "id": "731040705",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Huh? I've never seen anything like this before.",
            "nextDialogs": [
              "731040708"
            ]
          },
          "731040708": {
            "id": "731040708",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's with all the troubles when Mr. Kayvan is fishing..."
          }
        }
      }
    },

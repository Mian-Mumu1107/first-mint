            ]
          },
          "731041219": {
            "id": "731041219",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "I don't know exactly why you couldn't hook a fish. But... It doesn't hurt to ask a professional.",
            "nextDialogs": [

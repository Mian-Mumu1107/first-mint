    {
      "subId": "7310403",
      "subQuestName": "Give the bait materials to Kayvan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731040301"
        ],
        "dialogs": {
          "731040301": {
            "id": "731040301",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Did you find the materials?"
          }
        }
      }
    },
    {
      "subId": "7310404",
      "subQuestName": "Talk to Helbet and Kayvan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731040401"
        ],
        "dialogs": {
          "731040401": {
            "id": "731040401",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "That's pretty quick! Thanks!",
            "nextDialogs": [
              "731040402"
            ]
          },
          "731040402": {
            "id": "731040402",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "Please start fishing, or the relics could... I mean the fish...",
            "nextDialogs": [
              "731040403"
            ]
          },
          "731040403": {
            "id": "731040403",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "No rush. I need to feel the flow of the water to ensure I can cast the rod with the peace of mind.",
            "nextDialogs": [
              "731040404"
            ]
          },
          "731040404": {
            "id": "731040404",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Let's see what big fish lies for me here...",
            "nextDialogs": [
              "731040405"
            ]
          },
          "731040405": {
            "id": "731040405",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Kayvan prepares the bait and begins fishing.",
            "nextDialogs": [
              "731040406"
            ]
          },
          "731040406": {
            "id": "731040406",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Kayvan catches a wet package after a long while.",
            "nextDialogs": [
              "731040407"
            ]
          },
          "731040407": {
            "id": "731040407",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "What do I have here...?",
            "nextDialogs": [
              "731040408"
            ]
          },
          "731040408": {
            "id": "731040408",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "This is... Let me check!",
            "nextDialogs": [
              "731040409"
            ]
          },
          "731040409": {
            "id": "731040409",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "This is it! One of the lost antiques! Unscathed. No aquatic creature has gotten inside...",
            "nextDialogs": [
              "731040410"
            ]
          },
          "731040410": {
            "id": "731040410",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "You actually hooked a relic! You are really the Supreme Hookshot!",
            "nextDialogs": [
              "731040411"
            ]
          },
          "731040411": {
            "id": "731040411",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Is that a compliment? Doesn't really make me happy...",
            "nextDialogs": [
              "731040412"
            ]
          },
          "731040412": {
            "id": "731040412",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "Well, the relic at the first spot has been salvaged, and the next... fishing spot is just west of here.",
            "nextDialogs": [
              "731040413"
            ]
          },
          "731040413": {
            "id": "731040413",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Let's get rolling. The sooner I can go back and catch real fish in peace, the better.",
            "nextDialogs": [
              "731040414"
            ]
          },
          "731040414": {
            "id": "731040414",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "No problem. Please follow me!",
            "nextDialogs": [
              "731040415"
            ]
          },
          "731040415": {
            "id": "731040415",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Traveler, we'll be using Harra Fruit as bait this time. My gut tells me this is the most suitable material.",
            "nextDialogs": [
              "731040416"
            ]
          },
          "731040416": {
            "id": "731040416",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "I know a place where the Harra Fruit is the finest. I'll show you the location.",
            "nextDialogs": [
              "731040417"
            ]
          },
          "731040417": {
            "id": "731040417",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "We'll head off first. Let's meet at the next fishing spot."
          }
        }
      }
    },

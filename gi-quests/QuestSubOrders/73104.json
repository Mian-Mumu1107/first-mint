    {
      "subId": "7310409",
      "subQuestName": "Talk to Helbet and Kayvan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731040901"
        ],
        "dialogs": {
          "731040901": {
            "id": "731040901",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "You guys are so good! Thanks a lot!",
            "nextDialogs": [
              "731040902"
            ]
          },
          "731040902": {
            "id": "731040902",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "When all the relics are recovered, I will apply for more compensation as your payment.",
            "nextDialogs": [
              "731040903"
            ]
          },
          "731040903": {
            "id": "731040903",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "You just don't believe I can hook a real fish, do you...?",
            "nextDialogs": [
              "731040904"
            ]
          },
          "731040904": {
            "id": "731040904",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Wait, something big is on the hook!",
            "nextDialogs": [
              "731040905"
            ]
          },
          "731040905": {
            "id": "731040905",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Kayvan lifts the rod hard...",
            "nextDialogs": [
              "731040906"
            ]
          },
          "731040906": {
            "id": "731040906",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "What's this...?",
            "nextDialogs": [
              "731040907"
            ]
          },
          "731040907": {
            "id": "731040907",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "Ah, this is another pack of the relics! Great!",
            "nextDialogs": [
              "731040908"
            ]
          },
          "731040908": {
            "id": "731040908",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "I didn't expect it to go so well. You've recovered two relics now! What a hook, Mr. Kayvan!",
            "nextDialogs": [
              "731040909"
            ]
          },
          "731040909": {
            "id": "731040909",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "I shouldn't have said that...",
            "nextDialogs": [
              "731040910"
            ]
          },
          "731040910": {
            "id": "731040910",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There are tons of fish in the river. Not so for relics.",
            "nextDialogs": [
              "731040911"
            ]
          },
          "731040911": {
            "id": "731040911",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "But I haven't caught a single fish!",
            "nextDialogs": [
              "731040912"
            ]
          },
          "731040912": {
            "id": "731040912",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look at the bright side. We've recovered the relics. It's a good thing.",
            "nextDialogs": [
              "731040913"
            ]
          },
          "731040913": {
            "id": "731040913",
            "speakerId": 12710,
            "speakerName": "Helbet",
            "text": "The last fishing spot is near Vimara Village. A much safer place for fishing. Let's get moving.",
            "nextDialogs": [
              "731040914"
            ]
          },
          "731040914": {
            "id": "731040914",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Yeah, yeah. Off we go...",
            "nextDialogs": [
              "731040915"
            ]
          },
          "731040915": {
            "id": "731040915",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "This is so weird. Is there something wrong with my bait, or the way I fish...?",
            "nextDialogs": [
              "731040916"
            ]
          },
          "731040916": {
            "id": "731040916",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Never mind. Traveler, please find some fresh Zaytun Peaches for me this time.",
            "nextDialogs": [
              "731040917"
            ]
          },
          "731040917": {
            "id": "731040917",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "Since it's the last spot, I'll have to use my special bait.",
            "nextDialogs": [
              "731040918"
            ]
          },
          "731040918": {
            "id": "731040918",
            "speakerId": 4163,
            "speakerName": "Kayvan",
            "text": "I'm counting that on you, Traveler."
          }
        }
      }
    },
    {

    {
      "subId": "7501729",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750171801"
        ],
        "dialogs": {
          "750171801": {
            "id": "750171801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, guess we just need to insert the key into the statue, just like before, right?",
            "nextDialogs": [
              "750171802"
            ]
          },
          "750171802": {
            "id": "750171802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, don't you think it's super quiet here? No strange mechanical monsters around the statue and stuff... This place is so different from other parts of Ochkanatlan...",
            "nextDialogs": [
              "750171803"
            ]
          },
          "750171803": {
            "id": "750171803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa! Abyssal monsters! Why'd they just pop out all of a sudden!?"
          }
        }
      }
    },

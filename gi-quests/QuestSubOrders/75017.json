    {
      "subId": "7501707",
      "subQuestName": "Investigate the source of the sound",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750170701"
        ],
        "dialogs": {
          "750170701": {
            "id": "750170701",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "The sovereign ruler of the Land of Se{RUBY#[D]Chichen Uctokah}ven Flames extends salutations unto you, chosen one. May your path be one paved with flowers that shall never wither.",
            "nextDialogs": [
              "750170702"
            ]
          },
          "750170702": {
            "id": "750170702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That voice... Sounds like it came from this... big statue.",
            "nextDialogs": [
              "750170706",
              "750170705"
            ]
          },
          "750170706": {
            "id": "750170706",
            "speakerId": 1002,
            "speakerName": "Ix Uxul Tz'ib Bolon Ch'ule-L",
            "text": "Dragonlord Ix Uxul Tz'ib{RUBY#[D]Type-L Self-Regulating Overseer Array Integrated Processing Unit} Bolon Ch'ule-L is my name, aforetime the ruler of Chichen Uctokah.",
            "nextDialogs": [
              "750170707"
            ]
          },
          "750170707": {
            "id": "750170707",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ixu... What's your name now? Sure that's something you call yourself, and not some kind of mumbo-jumbo spell?",
            "nextDialogs": [
              "750170708"
            ]
          },
          "750170708": {
            "id": "750170708",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whatever, Paimon's gonna call you \"Ixlel.\" That'll do. Not like she'll remember the rest anyway!",
            "nextDialogs": [
              "750170709"
            ]
          },
          "750170709": {
            "id": "750170709",
            "speakerId": 21532,
            "speakerName": "Ixlel",
            "text": "According to the sacred dest{RUBY#[D]K'uhul}ined path hath ye and those with ye... No, wait! What did you name me, you white, round, elemental floating object!?",
            "nextDialogs": [
              "750170710"
            ]
          },
          "750170710": {
            "id": "750170710",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#And who are you calling a \"white, round, elemental floating object\"!? Paimon's the name, this is {NICKNAME}, and...",
            "nextDialogs": [
              "750170711"
            ]
          },
          "750170711": {
            "id": "750170711",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rraaar!",
            "nextDialogs": [
              "750170712"
            ]
          },
          "750170712": {
            "id": "750170712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#And this is {REALNAME[ID(2)|SHOWHOST(true)]}.",
            "nextDialogs": [
              "750170713"
            ]
          },
          "750170713": {
            "id": "750170713",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Also, you're the one who called yourself \"Ix-whachamacallitagain-lel,\" or whatever, didn't you?",
            "nextDialogs": [
              "750170714"
            ]
          },
          "750170714": {
            "id": "750170714",
            "speakerId": 21532,
            "speakerName": "Ixlel",
            "text": "S—Such impertinence! This sacred name comes from the most glorious of rulers. How dare this white, round, elemental floating object speak thus, and vastly overstep its station!",
            "nextDialogs": [
              "750170715"
            ]
          },
          "750170715": {
            "id": "750170715",
            "speakerId": 21532,
            "speakerName": "Ixlel",
            "text": "#Noble {NICKNAME}! Forgive my blunt speech, but surely you grant your servant gross latitude, that it should address a sovereign ruler thusly!"
          },
          "750170705": {
            "id": "750170705",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Indeed. Chosen of Dragons you are, and noble elect of mine also."
          }
        }
      }
    },

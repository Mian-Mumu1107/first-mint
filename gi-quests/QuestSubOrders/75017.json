    {
      "subId": "7501709",
      "subQuestName": "Deliver the heart fragments to Ixlel",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750170901"
        ],
        "dialogs": {
          "750170901": {
            "id": "750170901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, Ixlel! We've found the bits and bobs you need!",
            "nextDialogs": [
              "750170902"
            ]
          },
          "750170902": {
            "id": "750170902",
            "speakerId": 21532,
            "speakerName": "Ixlel",
            "text": "Wh—Who do you name \"Ixlel,\" you insolent whelp? I've told you, my name is...",
            "nextDialogs": [
              "750170903"
            ]
          },
          "750170903": {
            "id": "750170903",
            "speakerId": 21532,
            "speakerName": "Ixlel",
            "text": "#Alright, never mind! I tire of waiting to die! Come, noble {NICKNAME}, put ye these into my chest...",
            "nextDialogs": [
              "750170904"
            ]
          },
          "750170904": {
            "id": "750170904",
            "speakerId": 21532,
            "speakerName": "Ixlel",
            "text": "And then dig out my heart, and allow me to perish by your noble hands!",
            "nextDialogs": [
              "750170905"
            ]
          },
          "750170905": {
            "id": "750170905",
            "speakerId": 21532,
            "speakerName": "Ixlel",
            "text": "Rejoice thou also, O white, round, elemental floating object! For I shall bestow upon you too the honor of witnessing the passing of Chichen Uctokah's ruler!",
            "nextDialogs": [
              "750170906"
            ]
          },
          "750170906": {
            "id": "750170906",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, don't get so excited about this stuff, would ya? Anyway, we just need to put these components in first, right?",
            "nextDialogs": [
              "750170907"
            ]
          },
          "750170907": {
            "id": "750170907",
            "speakerId": 21532,
            "speakerName": "Ixlel",
            "text": "Indeed, indeed! Come now, I shall open my heart to you. Take it out, and this task shall be done!",
            "nextDialogs": [
              "750170908"
            ]
          },
          "750170908": {
            "id": "750170908",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, do you really have to put it that way?",
            "nextDialogs": [
              "750170909"
            ]
          },
          "750170909": {
            "id": "750170909",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Insert the components.)",
            "nextDialogs": [
              "750170910"
            ]
          },
          "750170910": {
            "id": "750170910",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, and then..."
          }
        }
      }
    },

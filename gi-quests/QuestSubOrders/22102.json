  "subQuests": [
    {
      "subId": "2210201",
      "subQuestName": "Talk to Huai'an",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221020101"
        ],
        "dialogs": {
          "221020101": {
            "id": "221020101",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "This is becoming an absolute nightmare...",
            "nextDialogs": [
              "221020102"
            ]
          },
          "221020102": {
            "id": "221020102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "221020103"
            ]
          },
          "221020103": {
            "id": "221020103",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "I haven't slept properly in days... See the dark circles under my eyes?",
            "nextDialogs": [
              "221020104"
            ]
          },
          "221020104": {
            "id": "221020104",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Have you met any of the guests? They're a handful, to say the least. A brand-new crisis with each one. One of them actually jumped from the top of the building. A building this high. What were they thinking!?",
            "nextDialogs": [
              "221020105"
            ]
          },
          "221020105": {
            "id": "221020105",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "But never mind that. Right now, I'm waiting on a food delivery from the city, it should be here soon.",
            "nextDialogs": [
              "221020106"
            ]
          },
          "221020106": {
            "id": "221020106",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "There are monsters on the road though, and they're sure to stir up trouble. Could I trouble you to get rid of them for me?",
            "nextDialogs": [
              "221020109",
              "221020110"
            ]
          },
          "221020109": {
            "id": "221020109",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Thanks."
          },
          "221020110": {
            "id": "221020110",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Well... When your doors are open to travelers from all over the world, expect a world's worth of baggage... That's what I like to say.",
            "nextDialogs": [
              "221020111"
            ]
          },
          "221020111": {
            "id": "221020111",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "We can manage though. It's just an inn that's a bit further out and a bit busier than most.",
            "nextDialogs": [
              "221020112"
            ]
          },
          "221020112": {
            "id": "221020112",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "I appreciate your help. Thanks, and good luck."
          }
        }
      }
    },
    {
      "subId": "2210202",
      "subQuestName": "Clear out nearby monsters",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221020201"
        ],
        "dialogs": {
          "221020201": {
            "id": "221020201",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "How's it coming along? All clear?",
            "nextDialogs": [
              "221020202"
            ]
          },
          "221020202": {
            "id": "221020202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet.",
            "nextDialogs": [
              "221020203"
            ]
          },
          "221020203": {
            "id": "221020203",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Okay, please be as quick as you can. The chef has run out of supplies.",
            "nextDialogs": [
              "221020204"
            ]
          },
          "221020204": {
            "id": "221020204",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "I could go and sort it myself if it came to it, but that's a last resort."
          }
        }
      }
    },
    {
      "subId": "2210203",
      "subQuestName": "Report back to Huai'an",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221020301"
        ],
        "dialogs": {
          "221020301": {
            "id": "221020301",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "How's it coming along? All clear?",
            "nextDialogs": [
              "221020302"
            ]
          },
          "221020302": {
            "id": "221020302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "All clear.",
            "nextDialogs": [
              "221020303"
            ]
          },
          "221020303": {
            "id": "221020303",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Great. Thanks a lot.",
            "nextDialogs": [
              "221020304"
            ]
          },
          "221020304": {
            "id": "221020304",
            "speakerId": 2202,
            "speakerName": "Huai'an",
            "text": "Here's your payment. If you're ever in the area again, feel free to stop by anytime."
          }
        }
      }
    }
  ]

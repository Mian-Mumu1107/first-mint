    {
      "subId": "2230405",
      "subQuestName": "Talk to Bolai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040601"
        ],
        "dialogs": {
          "223040601": {
            "id": "223040601",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "You're back! Found the treasure?",
            "nextDialogs": [
              "223040602"
            ]
          },
          "223040602": {
            "id": "223040602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes.",
            "nextDialogs": [
              "223040603"
            ]
          },
          "223040603": {
            "id": "223040603",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Nice one! I said you looked like a real adventurer, didn't I? Well, now you've proven it.",
            "nextDialogs": [
              "223040604"
            ]
          },
          "223040604": {
            "id": "223040604",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Right, let's see what we have in this box... Hmph. What a pile of junk...",
            "nextDialogs": [
              "223040605"
            ]
          },
          "223040605": {
            "id": "223040605",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Well, can't blame you for trying! Here's your share, I'll hold on to Zhang Shun's share until he comes to collect it.",
            "nextDialogs": [
              "223040606"
            ]
          },
          "223040606": {
            "id": "223040606",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "*sigh* Still didn't find it... That guy is taking me for a ride, I swear..."
          }
        }
      }
    },
    {
      "subId": "2230405",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040501"
        ],
        "dialogs": {
          "223040501": {
            "id": "223040501",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "If it wasn't for my injury... I could be out there chasing down even bigger treasure hoards with the captain and my old crew mates...",
            "nextDialogs": [
              "223040502"
            ]
          },
          "223040502": {
            "id": "223040502",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "*sigh* What I would give to be back on board that ship just one more time..."
          }
        }
      }
    },
    {
      "subId": "2230407",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040701"
        ],
        "dialogs": {
          "223040701": {
            "id": "223040701",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Are you sure? I would have thought it'd be a useful nugget of information..."
          }
        }
      }
    },
    {
      "subId": "2230409",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040901"
        ],
        "dialogs": {
          "223040901": {
            "id": "223040901",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "You're back! Found the treasure?",
            "nextDialogs": [
              "223040902"
            ]
          },
          "223040902": {
            "id": "223040902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes.",
            "nextDialogs": [
              "223040903"
            ]
          },
          "223040903": {
            "id": "223040903",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Nice one! I said you looked like a real adventurer, didn't I? Well, now you've proven it.",
            "nextDialogs": [
              "223040904"
            ]
          },
          "223040904": {
            "id": "223040904",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Right, let's see what we have in this box... What's this? Map fragments?",
            "nextDialogs": [
              "223040905"
            ]
          },
          "223040905": {
            "id": "223040905",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Huh, so he was right. Those batty old Treasure Maps really do have clues to where the treasure lies...",
            "nextDialogs": [
              "223040906"
            ]
          },
          "223040906": {
            "id": "223040906",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Oh? You're still here? Here, take your share... and hurry along now, you must have other things to do. I'll hold Zhang Shun's share till he comes to collect it."
          }
        }
      }
    }
  ]
}
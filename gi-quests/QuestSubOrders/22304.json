    },
    {
      "subId": "2230441",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040201"
        ],
        "dialogs": {
          "223040201": {
            "id": "223040201",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Hello there, my friend! What can I get you?",
            "nextDialogs": [
              "223040202"
            ]
          },
          "223040202": {
            "id": "223040202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Treasure Maps.",
            "nextDialogs": [
              "223040203"
            ]
          },
          "223040203": {
            "id": "223040203",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Treasure Maps? Oh, you must mean Zhang Shun's maps.",
            "nextDialogs": [
              "223040204"
            ]
          },
          "223040204": {
            "id": "223040204",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "So, you're really going to look for this treasure, eh? I must say, I only ever saw them as a bit of fun.",
            "nextDialogs": [
              "223040205"
            ]
          },
          "223040205": {
            "id": "223040205",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "You, though, I can tell with one look that you're the real adventurer type. The sort whose eyes light up as soon as someone mentions the word \"treasure.\"",
            "nextDialogs": [
              "223040206"
            ]
          },
          "223040206": {
            "id": "223040206",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "I don't have much use for these Treasure Maps at the end of the day, so you might as well have them.",
            "nextDialogs": [
              "223040207"
            ]
          },
          "223040207": {
            "id": "223040207",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "That said, if you do find any treasure, let's split it evenly.",
            "nextDialogs": [
              "223040208"
            ]
          },
          "223040208": {
            "id": "223040208",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "After all, I have been looking after these maps for a while. It's only fair to contribute something in the way of storage fees..."
          }
        }
      }
    },

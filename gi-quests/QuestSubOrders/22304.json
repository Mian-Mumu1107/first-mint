    "Zhang Shun": 19
  },
  "subQuests": [
    {
      "subId": "2230401",
      "subQuestName": "Talk to Zhang Shun",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040101"
        ],
        "dialogs": {
          "223040101": {
            "id": "223040101",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "Hmm, what to do, what to do...",
            "nextDialogs": [
              "223040102"
            ]
          },
          "223040102": {
            "id": "223040102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "223040103"
            ]
          },
          "223040103": {
            "id": "223040103",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "I used to be a sailor with The Crux, until I suffered an unlucky injury...",
            "nextDialogs": [
              "223040104"
            ]
          },
          "223040104": {
            "id": "223040104",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "After I left the fleet I needed money, so I pawned a few Treasure Maps. I gave them to local businessman Bolai.",
            "nextDialogs": [
              "223040105"
            ]
          },
          "223040105": {
            "id": "223040105",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "The agreement was that I would get a share of any treasure found. But I haven't heard a word from him since, and I suspect he hasn't even tried to look for the treasure.",
            "nextDialogs": [
              "223040106"
            ]
          },
          "223040106": {
            "id": "223040106",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "I can't keep waiting around like this. Would you be willing to search for the treasure for me?",
            "nextDialogs": [
              "223040108",
              "223040110"
            ]
          },
          "223040108": {
            "id": "223040108",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "Thank you.",
            "nextDialogs": [
              "223040120"
            ]
          },
          "223040120": {
            "id": "223040120",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "Start by paying a visit to <color=#00E1FFFF>Bolai</color> to fetch the <color=#00E1FFFF>Treasure Maps</color>. Then, find the <color=#00E1FFFF>treasure</color> and <color=#00E1FFFF>take it to him</color>.",
            "nextDialogs": [
              "223040121"
            ]
          },
          "223040121": {
            "id": "223040121",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "I spoke to him about it already. He will hold onto my share for me."
          },
          "223040110": {
            "id": "223040110",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "I realized that my past injury could flare up at any point and start causing real trouble. I couldn't let something like that put the rest of the crew at risk, so I chose to leave.",
            "nextDialogs": [
              "223040111"
            ]
          },
          "223040111": {
            "id": "223040111",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "I started selling a few odds and ends that I'd picked up over the years to earn a living. But business wasn't great and I soon ran out of things to sell anyway.",
            "nextDialogs": [
              "223040112"
            ]
          },
          "223040112": {
            "id": "223040112",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "I used to own a few Treasure Maps. They were loot I picked up back in the day with the crew.",
            "nextDialogs": [
              "223040113"
            ]
          },
          "223040113": {
            "id": "223040113",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "In my condition though, it's enough of a struggle just to walk down the street... I can't exactly go shooting off around the world on a treasure hunt, can I?",
            "nextDialogs": [
              "223040114"
            ]
          },
          "223040114": {
            "id": "223040114",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "So I pawned them, gave them to Bolai for a bit of cash.",
            "nextDialogs": [
              "223040115"
            ]
          },
          "223040115": {
            "id": "223040115",
            "speakerId": 1000,
            "speakerName": "Zhang Shun",
            "text": "But it seems like he can't go and look for the treasure in person either. He is just a businessman, after all... So that's why I need your help."
          }
        }
      }
    },
    {
      "subId": "2230402",
      "subQuestName": "Talk to Bolai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040801"
        ],
        "dialogs": {
          "223040801": {
            "id": "223040801",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "I almost forgot, do you know how to read these Treasure Maps?",
            "nextDialogs": [
              "223040802"
            ]
          },
          "223040802": {
            "id": "223040802",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Frankly, I couldn't make head or tail of them when I first got them, so I had several people take a look.",
            "nextDialogs": [
              "223040803"
            ]
          },
          "223040803": {
            "id": "223040803",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "They figured out more or less where the treasure is. But they said if I went to look for the treasure, I should pay them an extra fee... That's why I never bothered to go.",
            "nextDialogs": [
              "223040804"
            ]
          },
          "223040804": {
            "id": "223040804",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "If it saves you the bother, I can mark the location for you, no problem. Just say the word.",
            "nextDialogs": [
              "223040805"
            ]
          },
          "223040805": {
            "id": "223040805",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "But, y'know, I'd have to make you pay a contribution... Let's call it <color=#00E1FFFF>100 Mora</color>?",
            "nextDialogs": [
              "223040806"
            ]
          },
          "223040806": {
            "id": "223040806",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "What do you say? Shall I <color=#00E1FFFF>mark the location</color> on the Treasure Maps for you?"
          }
        }
      }
    },
    {
      "subId": "2230403",
      "subQuestName": "Talk to Bolai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040301"
        ],
        "dialogs": {
          "223040301": {
            "id": "223040301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes please.",
            "nextDialogs": [
              "223040302"
            ]
          },
          "223040302": {
            "id": "223040302",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Alright... There you go.",
            "nextDialogs": [
              "223040303"
            ]
          },
          "223040303": {
            "id": "223040303",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Have a good one. And don't forget to bring the treasure back here when you find it — we split it three ways, as agreed."
          }
        }
      }
    },
    {
      "subId": "2230404",
      "subQuestName": "Find the treasure",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223040401"
        ],
        "dialogs": {
          "223040401": {
            "id": "223040401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No need.",
            "nextDialogs": [
              "223040402"
            ]
          },
          "223040402": {
            "id": "223040402",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Alright then, it's your funeral...",
            "nextDialogs": [
              "223040403"
            ]
          },
          "223040403": {
            "id": "223040403",
            "speakerId": 1001,
            "speakerName": "Bolai",
            "text": "Have a good one. And don't forget to bring the treasure back here when you find it — we split it three ways, as agreed."
          }
        }
      }
    },

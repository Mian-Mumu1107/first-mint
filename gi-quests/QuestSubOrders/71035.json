  "subQuests": [
    {
      "subId": "7103501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710350101"
        ],
        "dialogs": {
          "710350101": {
            "id": "710350101",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "What would you two like?",
            "nextDialogs": [
              "710350102"
            ]
          },
          "710350102": {
            "id": "710350102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Three servings of Grilled Tiger Fish to go, please.",
            "nextDialogs": [
              "710350103"
            ]
          },
          "710350103": {
            "id": "710350103",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "You got it! Hang on for a moment, they'll be ready soon!",
            "nextDialogs": [
              "710350104"
            ]
          },
          "710350104": {
            "id": "710350104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Three servings? One for you, one for Paimon... Who's the last one for?",
            "nextDialogs": [
              "710350107"
            ]
          },
          "710350107": {
            "id": "710350107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You mean gave-us-the-Seven-Star-Lamps-and-Censer Pervases?",
            "nextDialogs": [
              "710350108"
            ]
          },
          "710350108": {
            "id": "710350108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, that's right. He did say that he missed the taste of Grilled Tiger Fish...",
            "nextDialogs": [
              "710350109"
            ]
          },
          "710350109": {
            "id": "710350109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But isn't he gone now?",
            "nextDialogs": [
              "710350110"
            ]
          },
          "710350110": {
            "id": "710350110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Even so, we can still pay our respects.",
            "nextDialogs": [
              "710350111"
            ]
          },
          "710350111": {
            "id": "710350111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, that makes sense. Let's go see him, then!",
            "nextDialogs": [
              "710350112"
            ]
          },
          "710350112": {
            "id": "710350112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The last time that we met Pervases there, the temple was in a pretty sad state, and there were Treasure Hoarders in the area, too...",
            "nextDialogs": [
              "710350113"
            ]
          },
          "710350113": {
            "id": "710350113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's hope that his statue hasn't been defaced...",
            "nextDialogs": [
              "710350114"
            ]
          },
          "710350114": {
            "id": "710350114",
            "speakerId": 2045,
            "speakerName": "Chef Mao",
            "text": "Your three servings of Grilled Tiger Fish. Hold on to them, now!",
            "nextDialogs": [
              "710350115"
            ]
          },
          "710350115": {
            "id": "710350115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Ooh, these smell so nice! C'mon, {NICKNAME}. Off to our next stop!"
          }
        }
      }
    },
    {
      "subId": "7103502",

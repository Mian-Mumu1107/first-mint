    {
      "subId": "7103503",
      "subQuestName": "Pay respects to Pervases",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710350301"
        ],
        "dialogs": {
          "710350301": {
            "id": "710350301",
            "speakerId": 12326,
            "speakerName": "Wang Ping'an",
            "text": "Thank you, O mighty adeptus, thank you, mighty hero! ...Oh, what are the odds? We meet again.",
            "nextDialogs": [
              "710350302"
            ]
          },
          "710350302": {
            "id": "710350302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You know us?",
            "nextDialogs": [
              "710350303"
            ]
          },
          "710350303": {
            "id": "710350303",
            "speakerId": 12326,
            "speakerName": "Wang Ping'an",
            "text": "How could I forget you...",
            "nextDialogs": [
              "710350304"
            ]
          },
          "710350304": {
            "id": "710350304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're...",
            "nextDialogs": [
              "710350305"
            ]
          },
          "710350305": {
            "id": "710350305",
            "speakerId": 12326,
            "speakerName": "Wang Ping'an",
            "text": "I'm Wang Ping'an! Don't you remember me?",
            "nextDialogs": [
              "710350307",
              "710350309"
            ]
          },
          "710350307": {
            "id": "710350307",
            "speakerId": 12326,
            "speakerName": "Wang Ping'an",
            "text": "Huh!? What? What \"Starsnatcher\"? ...Please, l—let's not bring that up, not in front of the adeptus...",
            "nextDialogs": [
              "710350310"
            ]
          },
          "710350310": {
            "id": "710350310",
            "speakerId": 12326,
            "speakerName": "Wang Ping'an",
            "text": "I was just getting ready to make an offering at the temple of the Yaksha, Pervases.",
            "nextDialogs": [
              "710350311"
            ]
          },
          "710350311": {
            "id": "710350311",
            "speakerId": 12326,
            "speakerName": "Wang Ping'an",
            "text": "But not long after I entered the mountains, I was set upon by those Treasure Hoarders... Thank you for saving me...",
            "nextDialogs": [
              "710350312"
            ]
          },
          "710350312": {
            "id": "710350312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait a moment. What were you going to do at Pervases' temple?",
            "nextDialogs": [
              "710350313"
            ]
          },
          "710350313": {
            "id": "710350313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Were you planning to do something bad to his statue?",
            "nextDialogs": [
              "710350314"
            ]
          },
          "710350314": {
            "id": "710350314",
            "speakerId": 12326,
            "speakerName": "Wang Ping'an",
            "text": "No, no! I wouldn't dream of it!",
            "nextDialogs": [
              "710350315"
            ]
          },
          "710350315": {
            "id": "710350315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Then what were you planning to do?",
            "nextDialogs": [
              "710350316"
            ]
          },
          "710350316": {
            "id": "710350316",
            "speakerId": 12326,
            "speakerName": "Wang Ping'an",
            "text": "I... I wanted to restore the temple.",
            "nextDialogs": [
              "710350317"
            ]
          },
          "710350317": {
            "id": "710350317",
            "speakerId": 12326,
            "speakerName": "Wang Ping'an",
            "text": "My plan today was to closely examine the temple's current condition and arrange for the purchase of the appropriate materials.",
            "nextDialogs": [
              "710350318"
            ]
          },
          "710350318": {
            "id": "710350318",
            "speakerId": 12326,
            "speakerName": "Wang Ping'an",
            "text": "I never expected to be targeted halfway by Treasure Hoarders and forced to flee.",
            "nextDialogs": [
              "710350319"
            ]
          },
          "710350319": {
            "id": "710350319",
            "speakerId": 12326,
            "speakerName": "Wang Ping'an",
            "text": "But as I ran, I... lost my way. As for the rest, you know what happened.",
            "nextDialogs": [
              "710350320"
            ]
          },
          "710350320": {
            "id": "710350320",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's speak further at the temple.",
            "nextDialogs": [
              "710350321"
            ]
          },
          "710350321": {
            "id": "710350321",
            "speakerId": 12326,
            "speakerName": "Wang Ping'an",
            "text": "Right, this is hardly the place for conversation. Let's go to the temple first.",
            "nextDialogs": [
              "710350322"
            ]
          },
          "710350322": {
            "id": "710350322",
            "speakerId": 12326,
            "speakerName": "Wang Ping'an",
            "text": "We'll speak there.",
            "nextDialogs": [
              "710350323"
            ]
          },
          "710350323": {
            "id": "710350323",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Go. I have other things to handle.",
            "nextDialogs": [
              "710350324"
            ]
          },
          "710350324": {
            "id": "710350324",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? You're leaving already?",
            "nextDialogs": [
              "710350325"
            ]
          },
          "710350325": {
            "id": "710350325",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...And he's gone."
          },
          "710350309": {
            "id": "710350309",
            "speakerId": 12326,
            "speakerName": "Wang Ping'an",
            "text": "Ah, good, good."
          }
        }
      }
    },
    {
      "subId": "7103504",
      "subQuestName": "Talk to Xiao",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710350201"
        ],
        "dialogs": {
          "710350201": {
            "id": "710350201",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "Why are you here?",
            "nextDialogs": [
              "710350202"
            ]
          },
          "710350202": {
            "id": "710350202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you here to see Pervases as well?",
            "nextDialogs": [
              "710350203"
            ]
          },
          "710350203": {
            "id": "710350203",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "I was just passing through.",
            "nextDialogs": [
              "710350204"
            ]
          },
          "710350204": {
            "id": "710350204",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "What are you two here for?",
            "nextDialogs": [
              "710350205"
            ]
          },
          "710350205": {
            "id": "710350205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're here to see Pervases!",
            "nextDialogs": [
              "710350206"
            ]
          },
          "710350206": {
            "id": "710350206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Aw, but this place is in as much of a mess as last time...",
            "nextDialogs": [
              "710350207"
            ]
          },
          "710350207": {
            "id": "710350207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's a temple here, and a statue, too... Why doesn't anyone come to maintain this place?",
            "nextDialogs": [
              "710350208"
            ]
          },
          "710350208": {
            "id": "710350208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Perhaps this place has been forgotten.",
            "nextDialogs": [
              "710350209"
            ]
          },
          "710350209": {
            "id": "710350209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How could people forget something like this? The Yakshas are heroes who defended Liyue Harbor...",
            "nextDialogs": [
              "710350210"
            ]
          },
          "710350210": {
            "id": "710350210",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "...",
            "nextDialogs": [
              "710350211"
            ]
          },
          "710350211": {
            "id": "710350211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Xiao, are... are you angry?",
            "nextDialogs": [
              "710350212"
            ]
          },
          "710350212": {
            "id": "710350212",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "No. The Yakshas did not perform their duty for any form of recognition.",
            "nextDialogs": [
              "710350213"
            ]
          },
          "710350213": {
            "id": "710350213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Eh, let's not talk about this stuff right now. Grilled Tiger Fish first!",
            "nextDialogs": [
              "710350214"
            ]
          },
          "710350214": {
            "id": "710350214",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, and if you wanna have some, Xiao, we can give you half of our share each.",
            "nextDialogs": [
              "710350215"
            ]
          },
          "710350215": {
            "id": "710350215",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "It's fine...",
            "nextDialogs": [
              "710350216"
            ]
          },
          "710350216": {
            "id": "710350216",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Help! Help me!",
            "nextDialogs": [
              "710350217"
            ]
          },
          "710350217": {
            "id": "710350217",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Did you hear that?",
            "nextDialogs": [
              "710350218"
            ]
          },
          "710350218": {
            "id": "710350218",
            "speakerId": 10204,
            "speakerName": "Xiao",
            "text": "There. Someone's calling for help.",
            "nextDialogs": [
              "710350219"
            ]
          },
          "710350219": {
            "id": "710350219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's go!",
            "nextDialogs": [
              "710350220"
            ]
          },
          "710350220": {
            "id": "710350220",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh!? What about the Grilled Tiger Fish? Paimon hasn't eaten yet!"
          }
        }
      }
    },

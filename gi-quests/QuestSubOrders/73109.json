  "subQuests": [
    {
      "subId": "7310901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731090101"
        ],
        "dialogs": {
          "731090101": {
            "id": "731090101",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "This is strange... It should be around here. Why can't I find it?",
            "nextDialogs": [
              "731090102"
            ]
          },
          "731090102": {
            "id": "731090102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you looking for?",
            "nextDialogs": [
              "731090103"
            ]
          },
          "731090103": {
            "id": "731090103",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "You're... Oh, the Traveler, right? I've heard about you.",
            "nextDialogs": [
              "731090104"
            ]
          },
          "731090104": {
            "id": "731090104",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "I'm Javi, a... normal salesperson. I'm looking for the \"Dream Box\" I buried before.",
            "nextDialogs": [
              "731090105"
            ]
          },
          "731090105": {
            "id": "731090105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's a strange name... What is in it?",
            "nextDialogs": [
              "731090106"
            ]
          },
          "731090106": {
            "id": "731090106",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Well... If I have to put it into words, it contains my childhood \"dreams to be realized.\"",
            "nextDialogs": [
              "731090107"
            ]
          },
          "731090107": {
            "id": "731090107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why did you do that?",
            "nextDialogs": [
              "731090108"
            ]
          },
          "731090108": {
            "id": "731090108",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Hahaha, that was a childhood game I played with friends.",
            "nextDialogs": [
              "731090109"
            ]
          },
          "731090109": {
            "id": "731090109",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "We each wrote down the most precious dream we had then, and buried it here. We have agreed on a time when we are gonna gather here again and dig our \"Dream Boxes\" out.",
            "nextDialogs": [
              "731090110"
            ]
          },
          "731090110": {
            "id": "731090110",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Now the time comes, but... Seems that I'm the only one remembering the promise.",
            "nextDialogs": [
              "731090111"
            ]
          },
          "731090111": {
            "id": "731090111",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "*sigh* That's okay, though... As long as they keep their dreams.",
            "nextDialogs": [
              "731090112"
            ]
          },
          "731090112": {
            "id": "731090112",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Anyway, I'm coming to dig my box out, so that I can have some closure.",
            "nextDialogs": [
              "731090113"
            ]
          },
          "731090113": {
            "id": "731090113",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "But I searched around and found nothing. Could it be that someone took it?",
            "nextDialogs": [
              "731090118",
              "731090116"
            ]
          },
          "731090118": {
            "id": "731090118",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "I remember burying it beside a tree...",
            "nextDialogs": [
              "731090119"
            ]
          },
          "731090119": {
            "id": "731090119",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A tree? B—But Paimon sees lots of trees here!",
            "nextDialogs": [
              "731090120"
            ]
          },
          "731090120": {
            "id": "731090120",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "I didn't expect this as a child, you know. We only set up a tiny sign as a reminder.",
            "nextDialogs": [
              "731090121"
            ]
          },
          "731090121": {
            "id": "731090121",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "But it's all gone after all this time, and the trees nearby have totally grown different...",
            "nextDialogs": [
              "731090122"
            ]
          },
          "731090122": {
            "id": "731090122",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "I just got the vague impression that the box was buried somewhere near.",
            "nextDialogs": [
              "731090123"
            ]
          },
          "731090123": {
            "id": "731090123",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Traveler, could you help me find it?"
          },
          "731090116": {
            "id": "731090116",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Hahaha... Can't say I disagree, since I can't even remember what I wrote...",
            "nextDialogs": [
              "731090117"
            ]
          },
          "731090117": {
            "id": "731090117",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "But even if my dream can fly away, the box cannot."
          }
        }
      }
    },
    {
      "subId": "7310902",
      "subQuestName": "Help Javi look for his \"dream\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7310903",
      "subQuestName": "Give the \"dream\" to Javi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731090301"
        ],
        "dialogs": {
          "731090301": {
            "id": "731090301",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Oh no. This isn't my Dream Box.",
            "nextDialogs": [
              "731090303"
            ]
          },
          "731090303": {
            "id": "731090303",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Haha... I've got one, too...",
            "nextDialogs": [
              "731090305"
            ]
          },
          "731090305": {
            "id": "731090305",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "I even opened it, and found a piece of paper with Ami's name on it.",
            "nextDialogs": [
              "731090306"
            ]
          },
          "731090306": {
            "id": "731090306",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "I remember that kid, the daughter of Jahangir, who was always found near the food shop.",
            "nextDialogs": [
              "731090307"
            ]
          },
          "731090307": {
            "id": "731090307",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "So she dreamed of becoming a florist, who would care for a lot of flowers...",
            "nextDialogs": [
              "731090308"
            ]
          },
          "731090308": {
            "id": "731090308",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "That was unexpected. I always thought Jahangir was gonna pass the shop to her."
          }
        }
      }
    },
    {
      "subId": "7310904",
      "subQuestName": "Collect Sumeru Rose Seeds",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7310905",
      "subQuestName": "Talk to Ami",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731090501"
        ],
        "dialogs": {
          "731090501": {
            "id": "731090501",
            "speakerId": 4160,
            "speakerName": "Ami",
            "text": "Is this... for me?",
            "nextDialogs": [
              "731090502"
            ]
          },
          "731090502": {
            "id": "731090502",
            "speakerId": 4160,
            "speakerName": "Ami",
            "text": "I wasn't serious about the box or the paper! So it's alright, you don't need to apologize!",
            "nextDialogs": [
              "731090503"
            ]
          },
          "731090503": {
            "id": "731090503",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Don't worry, this flower pot has no use for me anyway. Please take it.",
            "nextDialogs": [
              "731090504"
            ]
          },
          "731090504": {
            "id": "731090504",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "I've asked someone to find some seeds. They should arrive at any minute...",
            "nextDialogs": [
              "731090507"
            ]
          },
          "731090507": {
            "id": "731090507",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Huh? When did you arrive? I didn't even notice...",
            "nextDialogs": [
              "731090508"
            ]
          },
          "731090508": {
            "id": "731090508",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Ahem... Ami, you wanted to be a florist, right? You can start with planting these.",
            "nextDialogs": [
              "731090509"
            ]
          },
          "731090509": {
            "id": "731090509",
            "speakerId": 4160,
            "speakerName": "Ami",
            "text": "Thanks... But if I do that beside my dad's shop, bugs might get into the pot...",
            "nextDialogs": [
              "731090510"
            ]
          },
          "731090510": {
            "id": "731090510",
            "speakerId": 4160,
            "speakerName": "Ami",
            "text": "That would be a pity, for the bugs in the pot, and the grown-ups having bugs in their food.",
            "nextDialogs": [
              "731090511"
            ]
          },
          "731090511": {
            "id": "731090511",
            "speakerId": 4160,
            "speakerName": "Ami",
            "text": "But if I move the flowers further, I might forget about them. That's also a pity, for the dying flowers...",
            "nextDialogs": [
              "731090512"
            ]
          },
          "731090512": {
            "id": "731090512",
            "speakerId": 4160,
            "speakerName": "Ami",
            "text": "Besides, dad is always busy, and he never lets me go far...",
            "nextDialogs": [
              "731090513"
            ]
          },
          "731090513": {
            "id": "731090513",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Um... We can take care of it together, if you want. How about that?",
            "nextDialogs": [
              "731090514"
            ]
          },
          "731090514": {
            "id": "731090514",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Although I could only visit after work, I do have some free time.",
            "nextDialogs": [
              "731090515"
            ]
          },
          "731090515": {
            "id": "731090515",
            "speakerId": 4160,
            "speakerName": "Ami",
            "text": "Great! But dad might say no...",
            "nextDialogs": [
              "731090516"
            ]
          },
          "731090516": {
            "id": "731090516",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Mr. Jahangir and I are basically friends. He should agree if we talk to him together.",
            "nextDialogs": [
              "731090517"
            ]
          },
          "731090517": {
            "id": "731090517",
            "speakerId": 4160,
            "speakerName": "Ami",
            "text": "Okay! I... I want more flowers, then! Sumeru Rose is my favorite! Someday... I'll surround my dad's shop with Sumeru Roses!",
            "nextDialogs": [
              "731090518"
            ]
          },
          "731090518": {
            "id": "731090518",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Good, that's a beautiful dream, little girl. Let's do our best for that!"
          }
        }
      }
    },
    {
      "subId": "7310930",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731093001"
        ],
        "dialogs": {
          "731093001": {
            "id": "731093001",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "Nothing here either...",
            "nextDialogs": [
              "731093002"
            ]
          },
          "731093002": {
            "id": "731093002",
            "speakerId": 20819,
            "speakerName": "Javi",
            "text": "*sigh* Come on, the box can't have grown legs..."
          }
        }
      }
    },
    {
      "subId": "7310999",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731099901"
        ],
        "dialogs": {
          "731099901": {
            "id": "731099901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Nothing here... Let's check the next tree.",
            "nextDialogs": [
              "731099902"
            ]
          },
          "731099902": {
            "id": "731099902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No, nothing. Maybe someone has taken it...",
            "nextDialogs": [
              "731099903"
            ]
          },
          "731099903": {
            "id": "731099903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? There's actually a box here. Let's bring it back to him."
          }
        }
      }
    }
  ]
}
    {
      "subId": "4002903",
      "subQuestName": "Return to the adventurer camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400290301"
        ],
        "dialogs": {
          "400290301": {
            "id": "400290301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Timaeus!",
            "nextDialogs": [
              "400290302"
            ]
          },
          "400290302": {
            "id": "400290302",
            "speakerId": 1005,
            "speakerName": "Timaeus",
            "text": "Traveler and Paimon. What can I do for you?",
            "nextDialogs": [
              "400290303"
            ]
          },
          "400290303": {
            "id": "400290303",
            "speakerId": 1005,
            "speakerName": "Timaeus",
            "text": "Wait a minute... You've got that mischievous look on your face... you're not still thinking about that ridiculous juicer thing, are you!?",
            "nextDialogs": [
              "400290304"
            ]
          },
          "400290304": {
            "id": "400290304",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Timaeus, will you help us?",
            "nextDialogs": [
              "400290307"
            ]
          },
          "400290307": {
            "id": "400290307",
            "speakerId": 1005,
            "speakerName": "Timaeus",
            "text": "Well, if the Traveler isn't really interested then, uh, maybe I'll give this one a pass... It's just the weirdest request ever...",
            "nextDialogs": [
              "400290308"
            ]
          },
          "400290308": {
            "id": "400290308",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Nooo, but Paimon's Sunsettias are gonna go to waste without it!",
            "nextDialogs": [
              "400290309"
            ]
          },
          "400290309": {
            "id": "400290309",
            "speakerId": 1005,
            "speakerName": "Timaeus",
            "text": "In the time it would take me to research something like that, I could probably pick those Sunsettias again ten times over...",
            "nextDialogs": [
              "400290310"
            ]
          },
          "400290310": {
            "id": "400290310",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "New research project, Timaeus?",
            "nextDialogs": [
              "400290311"
            ]
          },
          "400290311": {
            "id": "400290311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hmm?",
            "nextDialogs": [
              "400290312"
            ]
          },
          "400290312": {
            "id": "400290312",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "We meet again.",
            "nextDialogs": [
              "400290313"
            ]
          },
          "400290313": {
            "id": "400290313",
            "speakerId": 1005,
            "speakerName": "Timaeus",
            "text": "Albedo! Thank goodness. So the situation is, Paimon wants a machine that can turn fruit into juice and keep the juice fresh. I mean, surely it's—",
            "nextDialogs": [
              "400290314"
            ]
          },
          "400290314": {
            "id": "400290314",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Majorly important, that's what it is! If you can manage to invent this, we'll never have to worry about fruit going bad ever again!",
            "nextDialogs": [
              "400290315"
            ]
          },
          "400290315": {
            "id": "400290315",
            "speakerId": 1005,
            "speakerName": "Timaeus",
            "text": "That's impossible! ..."
          }
        }
      }
    },

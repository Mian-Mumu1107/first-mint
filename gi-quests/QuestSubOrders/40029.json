          },
          "400290205": {
            "id": "400290205",
            "speakerId": 1006,
            "speakerName": "Joel",
            "text": "Dad! This is that traveler I was telling you about. The traveler's helped me out loads in the past, and this time we even built a snowman together.",
            "nextDialogs": [

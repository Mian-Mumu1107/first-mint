  "subQuests": [
    {
      "subId": "7305601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560101"
        ],
        "dialogs": {
          "730560101": {
            "id": "730560101",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Haha, interesting... That's really curious. It's reviving, the forest is... reviving...",
            "nextDialogs": [
              "730560102"
            ]
          },
          "730560102": {
            "id": "730560102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hello, grandpa! Are you lost?",
            "nextDialogs": [
              "730560103"
            ]
          },
          "730560103": {
            "id": "730560103",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "Hmm...hmm? Rost...? Ah, are you talking to me? Haha, lost, is that what you said? No, no, I'm not lost...",
            "nextDialogs": [
              "730560104"
            ]
          },
          "730560104": {
            "id": "730560104",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Good day, kids. I am Giyath Khayyam, an Amu{RUBY#[S]Biology}rta Dastur, haha... Just call me Khayyam.",
            "nextDialogs": [
              "730560105"
            ]
          },
          "730560105": {
            "id": "730560105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... Hello, Mr. Khayyam!",
            "nextDialogs": [
              "730560106"
            ]
          },
          "730560106": {
            "id": "730560106",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "No... Follow me, lower the tip of your tongue, and arch the middle of it... Khaaa. After that, round your mouth... Yyaaa. Finally, close your lips naturally... Mmm.",
            "nextDialogs": [
              "730560107"
            ]
          },
          "730560107": {
            "id": "730560107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um... Khaaa... Yyaaa... Mmm...",
            "nextDialogs": [
              "730560108"
            ]
          },
          "730560108": {
            "id": "730560108",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "That's right! Well done! Now, golden one, repeat that.",
            "nextDialogs": [
              "730560110",
              "730560112"
            ]
          },
          "730560110": {
            "id": "730560110",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Haha, nice! You did much better than the white little thing! See? I said I could teach phonetics!",
            "nextDialogs": [
              "730560113"
            ]
          },
          "730560113": {
            "id": "730560113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So, Mr. Khayyam... If you're not lost, what are you doing here?",
            "nextDialogs": [
              "730560114"
            ]
          },
          "730560114": {
            "id": "730560114",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "What am I doing? Hehe... I am a forest researcher. For us, the forest is our hometown. How could I be lost in my hometown, where I finally returned?",
            "nextDialogs": [
              "730560115"
            ]
          },
          "730560115": {
            "id": "730560115",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh...",
            "nextDialogs": [
              "730560116"
            ]
          },
          "730560116": {
            "id": "730560116",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "The forest was once deeply troubled by The Withering. In the past three decades, the plants were quickly decreasing in species and numbers, while the malicious Shroom-Kin kept growing...",
            "nextDialogs": [
              "730560117"
            ]
          },
          "730560117": {
            "id": "730560117",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "However, The Withering nearby disappeared lately. The plants that were once gone started growing again, and the reproduction of Shroom-Kin was somehow restrained.",
            "nextDialogs": [
              "730560118"
            ]
          },
          "730560118": {
            "id": "730560118",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "I haven't seen anything like this since 60 years ago... So I came here for the purpose of validating my amateur guess.",
            "nextDialogs": [
              "730560119"
            ]
          },
          "730560119": {
            "id": "730560119",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon sees..."
          },
          "730560112": {
            "id": "730560112",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Hmm... Your pronunciation was too fast, too rapid. But it's fine... Slowing it down would be all you need."
          }
        }
      }
    },
    {
      "subId": "7305613",
      "subQuestName": "Go to Mawtiyima",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7305606",
      "subQuestName": "Talk to Khayyam",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560201"
        ],
        "dialogs": {
          "730560201": {
            "id": "730560201",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "I am focusing my investigation mainly on three sites. Haha, I hope my memories of 30 years ago haven't totally faded... I should be able to identify the locations.",
            "nextDialogs": [
              "730560202"
            ]
          },
          "730560202": {
            "id": "730560202",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "All in all, thanks for your companionship.",
            "nextDialogs": [
              "730560203"
            ]
          },
          "730560203": {
            "id": "730560203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Don't mention it, Mr. Khayyam! That's what we Javans should do!"
          }
        }
      }
    },
    {
      "subId": "7305607",
      "subQuestName": "Investigate the plants in the specified locations",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560701"
        ],
        "dialogs": {
          "730560701": {
            "id": "730560701",
            "speakerId": 1003,
            "speakerName": "Aranaga",
            "text": "Why come here, you two?",
            "nextDialogs": [
              "730560702"
            ]
          },
          "730560702": {
            "id": "730560702",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa!! Y—You scared Paimon!",
            "nextDialogs": [
              "730560703"
            ]
          },
          "730560703": {
            "id": "730560703",
            "speakerId": 1003,
            "speakerName": "Aranaga",
            "text": "Know my name, you two. But has never seen you here before, Aranaga.",
            "nextDialogs": [
              "730560704"
            ]
          },
          "730560704": {
            "id": "730560704",
            "speakerId": 1003,
            "speakerName": "Aranaga",
            "text": "So... why come here?",
            "nextDialogs": [
              "730560706",
              "730560709"
            ]
          },
          "730560706": {
            "id": "730560706",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Even if you have forgotten many things, you should know that we don't mean any harm! We're always on your side, and we'll always help Mawtiyima!",
            "nextDialogs": [
              "730560707"
            ]
          },
          "730560707": {
            "id": "730560707",
            "speakerId": 1003,
            "speakerName": "Aranaga",
            "text": "Mawtiyima... You know?",
            "nextDialogs": [
              "730560710"
            ]
          },
          "730560710": {
            "id": "730560710",
            "speakerId": 1003,
            "speakerName": "Aranaga",
            "text": "Hmph, don't look like bad guys, you.",
            "nextDialogs": [
              "730560711"
            ]
          },
          "730560711": {
            "id": "730560711",
            "speakerId": 1003,
            "speakerName": "Aranaga",
            "text": "But please don't stay, here. Leave soon. Still recovering, the forest... So, no staying here, new guests.",
            "nextDialogs": [
              "730560712"
            ]
          },
          "730560712": {
            "id": "730560712",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, wait!",
            "nextDialogs": [
              "730560713"
            ]
          },
          "730560713": {
            "id": "730560713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We have something for you!",
            "nextDialogs": [
              "730560714"
            ]
          },
          "730560714": {
            "id": "730560714",
            "speakerId": 1003,
            "speakerName": "Aranaga",
            "text": "Something, for me?",
            "nextDialogs": [
              "730560715"
            ]
          },
          "730560715": {
            "id": "730560715",
            "speakerId": 1003,
            "speakerName": "Aranaga",
            "text": "Give me.",
            "nextDialogs": [
              "730560716"
            ]
          },
          "730560716": {
            "id": "730560716",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here.",
            "nextDialogs": [
              "730560717"
            ]
          },
          "730560717": {
            "id": "730560717",
            "speakerId": 1003,
            "speakerName": "Aranaga",
            "text": "...",
            "nextDialogs": [
              "730560718"
            ]
          },
          "730560718": {
            "id": "730560718",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "See? Remember? You gave us the same flower before!",
            "nextDialogs": [
              "730560719"
            ]
          },
          "730560719": {
            "id": "730560719",
            "speakerId": 1003,
            "speakerName": "Aranaga",
            "text": "Really... are friends with me? Very important flower, why here, with you?"
          },
          "730560709": {
            "id": "730560709",
            "speakerId": 1003,
            "speakerName": "Aranaga",
            "text": "Friends...?"
          }
        }
      }
    },
    {
      "subId": "7305609",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560301"
        ],
        "dialogs": {
          "730560301": {
            "id": "730560301",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Interesting... The plants here seem to be... reviving. So Mawtiyima is back in effect... Magical.",
            "nextDialogs": [
              "730560302"
            ]
          },
          "730560302": {
            "id": "730560302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh... So Mr. Khayyam knows about Mawtiyima, too? Paimon thought only Aranara know that...",
            "nextDialogs": [
              "730560305"
            ]
          },
          "730560305": {
            "id": "730560305",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Aranara, right? So you have also seen them...",
            "nextDialogs": [
              "730560306"
            ]
          },
          "730560306": {
            "id": "730560306",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh...? Um... Y—Yes."
          }
        }
      }
    },
    {
      "subId": "7305608",
      "subQuestName": "Investigate the plants in the specified locations",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560801"
        ],
        "dialogs": {
          "730560801": {
            "id": "730560801",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "The plants here are growing pretty nicely...",
            "nextDialogs": [
              "730560803",
              "730560805"
            ]
          },
          "730560803": {
            "id": "730560803",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "I never thought soil that had been tainted by Marana could ever provide nourishment for plants again."
          },
          "730560805": {
            "id": "730560805",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Dismissing the unique lifeforms that kids call Aranara as \"imaginary friends\" is undoubtedly incorrect.",
            "nextDialogs": [
              "730560806"
            ]
          },
          "730560806": {
            "id": "730560806",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Since the Akademiya sensors couldn't detect them either, only young kids could prove that they exist.",
            "nextDialogs": [
              "730560807"
            ]
          },
          "730560807": {
            "id": "730560807",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Hence, Amu{RUBY#[S]Biology}rta has classified them as \"unidentified lifeforms.\""
          }
        }
      }
    },
    {
      "subId": "7305610",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560401"
        ],
        "dialogs": {
          "730560401": {
            "id": "730560401",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Ha! Here! Look at this!",
            "nextDialogs": [
              "730560402"
            ]
          },
          "730560402": {
            "id": "730560402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh? New plant? Why are you so excited?",
            "nextDialogs": [
              "730560403"
            ]
          },
          "730560403": {
            "id": "730560403",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "No, not that, but even better! Look at it, our secret castle! Ha! What a mess it is now!",
            "nextDialogs": [
              "730560404"
            ]
          },
          "730560404": {
            "id": "730560404",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh...? \"Secret castle\"?",
            "nextDialogs": [
              "730560405"
            ]
          },
          "730560405": {
            "id": "730560405",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Haha! Here returns Scholar Omar! He came with the celestial secrets! Irfan, Siman, where are you! Aren't you bidding a welcome to me?",
            "nextDialogs": [
              "730560406"
            ]
          },
          "730560406": {
            "id": "730560406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "730560407"
            ]
          },
          "730560407": {
            "id": "730560407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "730560408"
            ]
          },
          "730560408": {
            "id": "730560408",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Ah... Ahem, my apologies, children. I... I was carried away.",
            "nextDialogs": [
              "730560409"
            ]
          },
          "730560409": {
            "id": "730560409",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Old age always does this to me, blurring the present, and endearing the past, more and more... Hehe...",
            "nextDialogs": [
              "730560410"
            ]
          },
          "730560410": {
            "id": "730560410",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Irfan and Siman, they are friends of mine. We built the castle together, the three of us together.",
            "nextDialogs": [
              "730560411"
            ]
          },
          "730560411": {
            "id": "730560411",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Back then, Irfan was the great musician, Siman was the supreme commander, and I was the astrology scholar. We switched our roles sometimes, you know... Children would play something different after getting bored.",
            "nextDialogs": [
              "730560412"
            ]
          },
          "730560412": {
            "id": "730560412",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Irfan was talented in music; Siman was tall and strong, beyond comparison; and me? Haha, I was just an avid reader born in a family with a little extra Mora.",
            "nextDialogs": [
              "730560414",
              "730560416"
            ]
          },
          "730560414": {
            "id": "730560414",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "No, this is our secret world — I'm serious about it. We made a promise together, saying that we will never forget each other, and will lead the Reconquest Army to take back the castle...",
            "nextDialogs": [
              "730560418"
            ]
          },
          "730560418": {
            "id": "730560418",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Hehe, 20 years have passed, and they might have forgotten our promise... It became my own research campsite in the forest, which was kept in operation till 30 years ago.",
            "nextDialogs": [
              "730560419"
            ]
          },
          "730560419": {
            "id": "730560419",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "After that, even Marana had come, but the Reconquest Army never showed up. Hehe, that's understandable... How could those childish promises stand up against death itself?",
            "nextDialogs": [
              "730560420"
            ]
          },
          "730560420": {
            "id": "730560420",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But... Since you still remember them, they must be doing the same! Please don't lose your heart, Mr. Khayyam!",
            "nextDialogs": [
              "730560421"
            ]
          },
          "730560421": {
            "id": "730560421",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Lose heart? No way. The childhood memories, shared \"imaginary friends,\" and the world closed to adults. It may be a pity, but... Time won't reverse itself.",
            "nextDialogs": [
              "730560422"
            ]
          },
          "730560422": {
            "id": "730560422",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"Imaginary friends\"... Do you mean Aranara?"
          },
          "730560416": {
            "id": "730560416",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "No, not all of these. We promised that we will lead the Reconquest Army to take back the castle... Hehe.",
            "nextDialogs": [
              "730560417"
            ]
          },
          "730560417": {
            "id": "730560417",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "I grew up to be a botanical researcher in the Akademiya, and I happened to return here for some reconstruction. I visited multiple times, bringing and taking away plenty of rubbish here."
          }
        }
      }
    },

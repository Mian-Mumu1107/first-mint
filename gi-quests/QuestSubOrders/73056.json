    {
      "subId": "7305603",
      "subQuestName": "Talk to Khayyam",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730560501"
        ],
        "dialogs": {
          "730560501": {
            "id": "730560501",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Look, look here... The plants are thriving! It seems that the soil devastated by Marana could still nourish lively plants!",
            "nextDialogs": [
              "730560502"
            ]
          },
          "730560502": {
            "id": "730560502",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Haha, Mawtiyima you old pal! Still active, aren't you?",
            "nextDialogs": [
              "730560503"
            ]
          },
          "730560503": {
            "id": "730560503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, Mr. Khayyam seems to get younger all of a sudden!",
            "nextDialogs": [
              "730560505",
              "730560507"
            ]
          },
          "730560505": {
            "id": "730560505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! What's that supposed to mean?",
            "nextDialogs": [
              "730560508"
            ]
          },
          "730560508": {
            "id": "730560508",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Hmm... These should be enough. Thanks for coming all the way here with me. Since we have done everything planned, we should go now.",
            "nextDialogs": [
              "730560509"
            ]
          },
          "730560509": {
            "id": "730560509",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Haha, this is excellent... These samples might really help my research on the secrets and weaknesses of The Withering...",
            "nextDialogs": [
              "730560510"
            ]
          },
          "730560510": {
            "id": "730560510",
            "speakerId": 1002,
            "speakerName": "Khayyam",
            "text": "Thanks for your hard work, let us take the same route back... I have something for you.",
            "nextDialogs": [
              "730560511"
            ]
          },
          "730560511": {
            "id": "730560511",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yay! Rewards!",
            "nextDialogs": [
              "730560512"
            ]

  "subQuests": [
    {
      "subId": "7151001",
      "subQuestName": "Report back to Hosseini",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715100101"
        ],
        "dialogs": {
          "715100101": {
            "id": "715100101",
            "speakerId": 1000,
            "speakerName": "Hosseini",
            "text": "How did it go? Did you manage to operate the Spike successfully?",
            "nextDialogs": [
              "715100104"
            ]
          },
          "715100104": {
            "id": "715100104",
            "speakerId": 1000,
            "speakerName": "Hosseini",
            "text": "Good, good. Though the Pursina's Spike cannot seal the opening in one go, as long as it is successful once, continued operation should not be an issue.",
            "nextDialogs": [
              "715100105"
            ]
          },
          "715100105": {
            "id": "715100105",
            "speakerId": 1000,
            "speakerName": "Hosseini",
            "text": "This means that it's really just a matter of time before the opening closes completely.",
            "nextDialogs": [
              "715100106"
            ]
          },
          "715100106": {
            "id": "715100106",
            "speakerId": 1000,
            "speakerName": "Hosseini",
            "text": "Our problem is, therefore, solved.",
            "nextDialogs": [
              "715100107"
            ]
          },
          "715100107": {
            "id": "715100107",
            "speakerId": 1000,
            "speakerName": "Hosseini",
            "text": "I must record this... For all I know, I may yet become a figure of some influence in the Akademiya once the full research report on the Pursina's Spikes is submitted.",
            "nextDialogs": [
              "715100108"
            ]
          },
          "715100108": {
            "id": "715100108",
            "speakerId": 1000,
            "speakerName": "Hosseini",
            "text": "#I might even write it into my future memoirs. I can see it now: \"My Experiments With the Preternaturally Skilled {NICKNAME} at The Chasm...\"",
            "nextDialogs": [
              "715100109"
            ]
          },
          "715100109": {
            "id": "715100109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll be waiting eagerly for that day to come.",
            "nextDialogs": [
              "715100110"
            ]
          },
          "715100110": {
            "id": "715100110",
            "speakerId": 1000,
            "speakerName": "Hosseini",
            "text": "Haha! Well, I fear I'm not hardly as good at writing stories as I am at reports.",
            "nextDialogs": [
              "715100111"
            ]
          },
          "715100111": {
            "id": "715100111",
            "speakerId": 1000,
            "speakerName": "Hosseini",
            "text": "I can only hope that you'll forgive any flaws in my work."
          }
        }
      }
    }
  ]
}
        "dialogs": {
          "190561201": {
            "id": "190561201",
            "speakerId": 1000,
            "speakerName": "An Approval Reply for \"Heizou Talks Fraud\"",
            "text": "Police Station: Your application for the public awareness campaign \"Heizou Talks Fraud\" has been received. Following review, your station has been authorized to run the performance with Shikanoin Doushin in charge of the related work. — The Headquarters of the Tenryou Commission",
            "nextDialogs": [
              "190561202"
            ]
          },
          "190561202": {
            "id": "190561202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Heizou Talks Fraud\"? What's that? Sounds interesting, whatever it is."
          }
        }
      }
    },
    {
      "subId": "1905604",
      "subQuestName": "Check the case files",

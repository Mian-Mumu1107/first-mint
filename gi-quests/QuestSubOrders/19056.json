        ],
        "dialogs": {
          "190561301": {
            "id": "190561301",
            "speakerId": 1002,
            "speakerName": "\"Case of the Missing Eastern Express\"",
            "text": "The beloved dog, \"Eastern Express,\" reportedly went missing late in the night. The owner discovered twelve canine footprints of varying sizes in the courtyard, leading to the initial assumption that the crime was carried out by a team...",
            "nextDialogs": [
              "190561302"
            ]
          },
          "190561302": {
            "id": "190561302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Who would give a dog such a strange name?"
          }
        }
      }
    },
    {
      "subId": "1905605",
      "subQuestName": "Check the case files",
      "sceneId": null,

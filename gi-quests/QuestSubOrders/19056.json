          "190561401": {
            "id": "190561401",
            "speakerId": 1003,
            "speakerName": "\"The Prince of Mischief in Hanamizaka\"",
            "text": "There is a slacker who claims to be the \"Prince of Mischief\" terrorizing Hanamizaka. Children have reportedly been losing valuables in the area, the bulk of which are Onikabuto, Genius Invokation TCG cards, and so on...",
            "nextDialogs": [
              "190561402"
            ]
          },
          "190561402": {
            "id": "190561402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What! Ugh, not him again..."
          }
        }
      }
    },

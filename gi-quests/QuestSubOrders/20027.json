    {
      "subId": "2002701",
      "subQuestName": "Go check the details",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200270101"
        ],
        "dialogs": {
          "200270101": {
            "id": "200270101",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "#Thank you, {NICKNAME}...",
            "nextDialogs": [
              "200270102"
            ]
          },
          "200270102": {
            "id": "200270102",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "I just wanted to tend to the grape vines, and then... this happened.",
            "nextDialogs": [
              "200270103"
            ]
          },
          "200270103": {
            "id": "200270103",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "*sigh* Please don't say a word about this to my son. He's one of the Knights of Favonius, so I'm sure he has enough to worry about as it is.",
            "nextDialogs": [
              "200270104"
            ]
          },
          "200270104": {
            "id": "200270104",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "There's no need to bother him over a silly old man getting himself into a bit of a pickle.",
            "nextDialogs": [
              "200270105"
            ]
          },
          "200270105": {
            "id": "200270105",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "Recently, though, we do seem to be having a bit of a slime problem around the winery area. I worry constantly that they'll demolish my grape vines. It's keeping me up at night.",
            "nextDialogs": [
              "200270106"
            ]
          },
          "200270106": {
            "id": "200270106",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "I don't know if you have the time to spare for an old man like me... but if so, could you chase off the slimes in the area for me, to stop them from getting at my grapes?",
            "nextDialogs": [
              "200270109",
              "200270110"
            ]
          },
          "200270109": {
            "id": "200270109",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "Bless you, child! I will rest better for it."
          },
          "200270110": {
            "id": "200270110",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "*sigh* I would happily do it myself, but at my age my strength is not what it used to be... For a youngster like you, this should be no problem. Come on, make an old man's day."
          }
        }
      }
    },
    {

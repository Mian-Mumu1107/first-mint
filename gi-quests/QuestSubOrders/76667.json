    {
      "subId": "7666701",
      "subQuestName": "Talk to Lyylikki",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766670301"
        ],
        "dialogs": {
          "766670301": {
            "id": "766670301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll go gather some for you.",
            "nextDialogs": [
              "766670302"
            ]
          },
          "766670302": {
            "id": "766670302",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "You... you want to help?! Thank you so much! Really, thank you! Then... please bring me five <color=#00E1FFFF>Lakkaberries</color>, that should be just enough!",
            "nextDialogs": [
              "766670303"
            ]
          },
          "766670303": {
            "id": "766670303",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "Once you bring them back, I promise I'll make you the tastiest Feast of the Moon you've ever had!"
          }
        }
      }
    },
    {
      "subId": "7666704",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766670401"
        ],
        "dialogs": {
          "766670401": {
            "id": "766670401",
            "speakerId": 16125,
            "speakerName": "Lyylikki",
            "text": "These will be enough. Thank you, thank you so much! Just a moment — I'll prepare the most delicious Feast of the Moon you've ever seen!",
            "nextDialogs": [
              "766670402"
            ]
          },
          "766670402": {
            "id": "766670402",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Lyylikki rushes to the kitchen and throws herself into preparing the Feast of the Moon...",
            "nextDialogs": [
              "766670403"
            ]
          },
          "766670403": {
            "id": "766670403",
            "speakerId": 16125,
            "speakerName": "Lyylikki",
            "text": "It's ready. Please, have a taste.",
            "nextDialogs": [
              "766670404"
            ]
          },
          "766670404": {
            "id": "766670404",
            "speakerId": 16125,
            "speakerName": "Lyylikki",
            "text": "Thank you again for your help. Should you get hungry next time, please feel free to come by. I'll prepare a special portion just for you."
          }
        }
      }
    },

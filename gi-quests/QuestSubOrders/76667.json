    {
      "subId": "7666701",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766670101"
        ],
        "dialogs": {
          "766670101": {
            "id": "766670101",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "Ugh... I should have brought more Lakkaberries...",
            "nextDialogs": [
              "766670104"
            ]
          },
          "766670104": {
            "id": "766670104",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "#Hello, {NICKNAME}, are you here for a Feast of the Moon? I'm so sorry, but... you might have to wait a little while.",
            "nextDialogs": [
              "766670105"
            ]
          },
          "766670105": {
            "id": "766670105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What is a Feast of the Moon?",
            "nextDialogs": [
              "766670106"
            ]
          },
          "766670106": {
            "id": "766670106",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "Huh? Didn't you get one last time...? Oh, right, Lady Lauma organized that one... and I guess she didn't mention the meal's official name.",
            "nextDialogs": [
              "766670107"
            ]
          },
          "766670107": {
            "id": "766670107",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "Simply put, a Feast of the Moon is a free meal we Frostmoon Scions distribute to those in need.",
            "nextDialogs": [
              "766670108"
            ]
          },
          "766670108": {
            "id": "766670108",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "Helping such people has ever been one of our traditions, though it used to be limited to the area around Hiisi Island...",
            "nextDialogs": [
              "766670109"
            ]
          },
          "766670109": {
            "id": "766670109",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "But under Lady Lauma's leadership and with everyone's help, we've gradually expanded our reach.",
            "nextDialogs": [
              "766670110"
            ]
          },
          "766670110": {
            "id": "766670110",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "Lady Lauma says this is part of spreading the Moon Goddess's Favor to all. There's a saying that goes... Um...",
            "nextDialogs": [
              "766670111"
            ]
          },
          "766670111": {
            "id": "766670111",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "\"The first fruit of the harvest must be placed upon the Moonlight Altar — not as an offering to the gods, but as a spark for...\"",
            "nextDialogs": [
              "766670112"
            ]
          },
          "766670112": {
            "id": "766670112",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "\"A spark for...\" Umm... What was the rest of it again...",
            "nextDialogs": [
              "766670113"
            ]
          },
          "766670113": {
            "id": "766670113",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "*Ahem*, anyway! This shop is one of the main distribution points for the meal. Hehe, and I manage almost everything here by myself! Pretty impressive, right?",
            "nextDialogs": [
              "766670114"
            ]
          },
          "766670114": {
            "id": "766670114",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "We've had a lot of trouble getting the meals out in Nasha Town, but I believe in what Lady Lauma says — we really can help more people this way!",
            "nextDialogs": [
              "766670115"
            ]
          },
          "766670115": {
            "id": "766670115",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "However... when I was preparing the ingredients yesterday, I forgot to close the box lid tightly, and when I woke up this morning, many fruits had been pecked open by birds and were completely unusable.",
            "nextDialogs": [
              "766670116"
            ]
          },
          "766670116": {
            "id": "766670116",
            "speakerId": 7058,
            "speakerName": "Lyylikki",
            "text": "I can barely make any Feasts of the Moon with the remaining Lakkaberries... *sigh*... What should I do now..."
          }
        }
      }
    },

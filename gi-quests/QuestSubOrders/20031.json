    {
      "subId": "2003102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200310201"
        ],
        "dialogs": {
          "200310201": {
            "id": "200310201",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "#You did a fine job, {NICKNAME}! Outstanding performance, considering it was your first time.",
            "nextDialogs": [
              "200310202"
            ]
          },
          "200310202": {
            "id": "200310202",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "The requester even asked me to thank you on their behalf.",
            "nextDialogs": [
              "200310203"
            ]
          },
          "200310203": {
            "id": "200310203",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "And, as promised, you are due your reward."
          }
        }
      }
    },
    {
      "subId": "2003104",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200310401"
        ],
        "dialogs": {
          "200310401": {
            "id": "200310401",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "#I heard something through the grape vine, {NICKNAME}.",
            "nextDialogs": [
              "200310402"
            ]
          },
          "200310402": {
            "id": "200310402",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Word has it that you completed a <color=#00E1FFFF>commission</color>. The requester sends their thanks.",
            "nextDialogs": [
              "200310403"
            ]
          },
          "200310403": {
            "id": "200310403",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "What commission? Refresh my memory.",
            "nextDialogs": [
              "200310404"
            ]
          },
          "200310404": {
            "id": "200310404",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "You helped someone in need while you were out on the road.",
            "nextDialogs": [
              "200310405"
            ]
          },
          "200310405": {
            "id": "200310405",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "In fact many of those you will meet have commissioned the Guild to assist.",
            "nextDialogs": [
              "200310408"
            ]
          },
          "200310408": {
            "id": "200310408",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Let me explain the Guild's system to you in a little more detail.",
            "nextDialogs": [
              "200310409"
            ]
          },
          "200310409": {
            "id": "200310409",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "The Guild receives requests from far and wide each day, and assigns commissions to adventurers accordingly.",
            "nextDialogs": [
              "200310410"
            ]
          },
          "200310410": {
            "id": "200310410",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "These commissioned adventures are the main source of compensation for our guild members.",
            "nextDialogs": [
              "200310411"
            ]
          },
          "200310411": {
            "id": "200310411",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "On the subject of compensation, I should mention that the Guild has prepared a little something for you."
          }
        }
      }
    }
  ]

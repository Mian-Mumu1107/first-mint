  "subQuests": [
    {
      "subId": "2003101",
      "subQuestName": "Talk to Katheryne",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200310101"
        ],
        "dialogs": {
          "200310101": {
            "id": "200310101",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "We meet again, avid adventurer.",
            "nextDialogs": [
              "200310102"
            ]
          },
          "200310102": {
            "id": "200310102",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Are your adventures going smoothly?",
            "nextDialogs": [
              "200310104",
              "200310106"
            ]
          },
          "200310104": {
            "id": "200310104",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "That is the spirit. Keep it up!",
            "nextDialogs": [
              "200310107"
            ]
          },
          "200310107": {
            "id": "200310107",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "It seems that you have a wealth of experience under your belt now. Time to introduce you to the formal work of the Guild.",
            "nextDialogs": [
              "200310108"
            ]
          },
          "200310108": {
            "id": "200310108",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "The Guild receives requests from far and wide each day, and assigns <color=#00E1FFFF>commissions</color> to adventurers accordingly.",
            "nextDialogs": [
              "200310109"
            ]
          },
          "200310109": {
            "id": "200310109",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "These commissioned adventures are the main source of compensation for our guild members.",
            "nextDialogs": [
              "200310110"
            ]
          },
          "200310110": {
            "id": "200310110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What kind of commissions are they?",
            "nextDialogs": [
              "200310111"
            ]
          },
          "200310111": {
            "id": "200310111",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "It is a mixed bag! Anything from running an errand for fellow citizens to dealing with monsters. Some are textbook, others are extremely dangerous.",
            "nextDialogs": [
              "200310112"
            ]
          },
          "200310112": {
            "id": "200310112",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "But you do not have to take my word for it. You should find out for yourself.",
            "nextDialogs": [
              "200310113"
            ]
          },
          "200310113": {
            "id": "200310113",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Here you can find the details of today's commissions.",
            "nextDialogs": [
              "200310114"
            ]
          },
          "200310114": {
            "id": "200310114",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Please report back to me upon completion. There will be a generous reward waiting for you."
          },
          "200310106": {
            "id": "200310106",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "It is always that way when you are starting out. Preparing properly before an adventure can help things go more smoothly."
          }
        }
      }
    },
    {
      "subId": "2003102",
      "subQuestName": "Talk to Katheryne",

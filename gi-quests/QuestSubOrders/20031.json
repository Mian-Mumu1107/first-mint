    {
      "subId": "2003103",
      "subQuestName": "Complete the commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "201013701"
        ],
        "dialogs": {
          "201013701": {
            "id": "201013701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "<color=#FFCC33FF>Claim Daily Commission Reward</color>",
            "nextDialogs": [
              "201013702"
            ]
          },
          "201013702": {
            "id": "201013702",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Thank you for completing today's commissions. Here is your reward."
          }
        }
      }
    },
    {
      "subId": "2003104",
      "subQuestName": "Talk to Katheryne",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200310301"
        ],
        "dialogs": {
          "200310301": {
            "id": "200310301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, you shouldn't have! Except, you totally should.",
            "nextDialogs": [
              "200310302"
            ]
          },
          "200310302": {
            "id": "200310302",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "This is a token of the Guild's gratitude.",
            "nextDialogs": [
              "200310303"
            ]
          },
          "200310303": {
            "id": "200310303",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "We receive many new commissions every day, and without the efforts of each and every adventurer there is no way we could respond to them all.",
            "nextDialogs": [
              "200310304"
            ]
          },
          "200310304": {
            "id": "200310304",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "If you complete enough commissions each day, you will be eligible to claim a special reward from me.",
            "nextDialogs": [
              "200310305"
            ]
          },
          "200310305": {
            "id": "200310305",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Your Adventurer Handbook keeps a record of how many adventures you complete each day.",
            "nextDialogs": [
              "200310306"
            ]
          },
          "200310306": {
            "id": "200310306",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "Make sure you claim your daily rewards on the days that you complete sufficient adventures. There is a limited quantity of rewards, so it will become forfeit should you not claim it.",
            "nextDialogs": [
              "200310308",
              "200310310"
            ]
          },
          "200310308": {
            "id": "200310308",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "You're more than welcome. After all, you are the one helping me.",
            "nextDialogs": [
              "200310312"
            ]
          },
          "200310312": {
            "id": "200310312",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "And please note that helping a fellow adventurer to complete a commission also counts towards your eligibility for a daily reward.",
            "nextDialogs": [
              "200310313"
            ]
          },
          "200310313": {
            "id": "200310313",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "We encourage you to work actively with your fellow adventurers. Ad astra abyssosque!"
          },
          "200310310": {
            "id": "200310310",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "As things currently stand, yes... My apologies.",
            "nextDialogs": [
              "200310311"
            ]
          },
          "200310311": {
            "id": "200310311",
            "speakerId": 12913,
            "speakerName": "Katheryne",
            "text": "But please be assured that we are constantly pushing Headquarters to make sure all our adventurers receive fair and adequate compensation."
          }
        }
      }
    },

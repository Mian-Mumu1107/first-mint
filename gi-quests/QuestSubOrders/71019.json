      "dialogue": {
        "startDialogs": [
          "710190201"
        ],
        "dialogs": {
          "710190201": {
            "id": "710190201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "There's a big stone inside that basin. Paimon guesses this is a \"rockery.\"",
            "nextDialogs": [
              "710190202"
            ]
          },
          "710190202": {
            "id": "710190202",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But aren't they usually put inside gardens or yards? What's the point of putting one out here?",
            "nextDialogs": [
              "710190203"
            ]
          },
          "710190203": {
            "id": "710190203",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh. The top of this rockery has something strange on it. It seems to be a mark of some kind... Paimon's quite concerned.",
            "nextDialogs": [
              "710190204"
            ]
          },
          "710190204": {
            "id": "710190204",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, since we're on a journey... let's just look out for mountains that look like this rockery.",
            "nextDialogs": [
              "710190205"
            ]
          },
          "710190205": {
            "id": "710190205",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It'll be nice if we find something."
          }
        }
      }
    },
    {
      "subId": "7101903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710190301"
        ],
        "dialogs": {
          "710190301": {
            "id": "710190301",
            "speakerId": 1001,
            "speakerName": "Rockery",
            "text": "(A basin of what seems like a rockery used for decoration. A strange marking adorns its peak.)",
            "nextDialogs": [
              "710190302"
            ]
          },
          "710190302": {
            "id": "710190302",
            "speakerId": 1001,
            "speakerName": "Rockery",
            "text": "(Look out for a similar-looking mountain in your travels in Liyue, and examine the peak of such a mountain carefully. Who knows if you may find something unexpected...)"
          }
        }
      }
    }

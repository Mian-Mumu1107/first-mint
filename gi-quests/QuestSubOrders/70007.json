  "subQuests": [
    {
      "subId": "7000701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700070101"
        ],
        "dialogs": {
          "700070101": {
            "id": "700070101",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "Ye ika gusha mosi!",
            "nextDialogs": [
              "700070104"
            ]
          },
          "700070104": {
            "id": "700070104",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "My apologies... That's because the library's been so loud recently that I can't study Hilichurlian in peace.",
            "nextDialogs": [
              "700070105"
            ]
          },
          "700070105": {
            "id": "700070105",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "Ever since the Windblume Festival started, there's been a great number of people hanging out here. Initially, they were keeping quiet and reading books, but then they started... chatting.",
            "nextDialogs": [
              "700070106"
            ]
          },
          "700070106": {
            "id": "700070106",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "There's more... They did a lot of terrifying things...",
            "nextDialogs": [
              "700070107"
            ]
          },
          "700070107": {
            "id": "700070107",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "Turning book corners... Sticking strange objects between the pages... They even went as far as to put books back on the shelves upside down!",
            "nextDialogs": [
              "700070108"
            ]
          },
          "700070108": {
            "id": "700070108",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "A library is not a place for romantic rendezvous! Unless one aims to disrupt all scholars actually studying inside as intended, that is!"
          }
        }
      }
    },
    {
      "subId": "7000712",
      "subQuestName": "Go to the library and find Ella Musk",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7000702",
      "subQuestName": "Try and convince the lovebirds to be quiet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700070201"
        ],
        "dialogs": {
          "700070201": {
            "id": "700070201",
            "speakerId": 10023,
            "speakerName": "Young Man in Love",
            "text": "Such a thrilling story! It's a shame they didn't get to have their happy ending.",
            "nextDialogs": [
              "700070202"
            ]
          },
          "700070202": {
            "id": "700070202",
            "speakerId": 10024,
            "speakerName": "Young Woman in Love",
            "text": "We definitely won't become like them, right?",
            "nextDialogs": [
              "700070203"
            ]
          },
          "700070203": {
            "id": "700070203",
            "speakerId": 10023,
            "speakerName": "Young Man in Love",
            "text": "That goes without saying. Even if we were torn apart and placed in different corners of the world, I'd find a way to bring you back to me.",
            "nextDialogs": [
              "700070206"
            ]
          },
          "700070206": {
            "id": "700070206",
            "speakerId": 10024,
            "speakerName": "Young Woman in Love",
            "text": "Huh? I've been keeping my voice low all this time.",
            "nextDialogs": [
              "700070207"
            ]
          },
          "700070207": {
            "id": "700070207",
            "speakerId": 10023,
            "speakerName": "Young Man in Love",
            "text": "*sigh* It's like in that book — an obstacle in the way of our love...",
            "nextDialogs": [
              "700070208"
            ]
          },
          "700070208": {
            "id": "700070208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You should also put the books you've finished reading back where they belong.",
            "nextDialogs": [
              "700070209"
            ]
          },
          "700070209": {
            "id": "700070209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look at all those books lying around in complete disarray. Somebody will have to put them back on the right shelves, and they're not gonna be happy about this mess.",
            "nextDialogs": [
              "700070210"
            ]
          },
          "700070210": {
            "id": "700070210",
            "speakerId": 10023,
            "speakerName": "Young Man in Love",
            "text": "Yeah, yeah, we got it. Could you leave us alone? You've interrupted us at a crucial moment.",
            "nextDialogs": [
              "700070211"
            ]
          },
          "700070211": {
            "id": "700070211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Crucial moment...?",
            "nextDialogs": [
              "700070212"
            ]
          },
          "700070212": {
            "id": "700070212",
            "speakerId": 10024,
            "speakerName": "Young Woman in Love",
            "text": "No matter what hardships befall us, do you promise to stay the same as you are now and never change?",
            "nextDialogs": [
              "700070213"
            ]
          },
          "700070213": {
            "id": "700070213",
            "speakerId": 10023,
            "speakerName": "Young Man in Love",
            "text": "I do. I swear on my life.",
            "nextDialogs": [
              "700070214"
            ]
          },
          "700070214": {
            "id": "700070214",
            "speakerId": 10024,
            "speakerName": "Young Woman in Love",
            "text": "That seems a bit excessive... The very thought of losing you tears my heart in two.",
            "nextDialogs": [
              "700070215"
            ]
          },
          "700070215": {
            "id": "700070215",
            "speakerId": 10023,
            "speakerName": "Young Man in Love",
            "text": "Ah, your gentle nature makes me fall for you even more...",
            "nextDialogs": [
              "700070216"
            ]
          },
          "700070216": {
            "id": "700070216",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's like talking to a brick wall."
          }
        }
      }
    },
    {
      "subId": "7000703",
      "subQuestName": "Try and convince the lovebirds to be quiet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700070301"
        ],
        "dialogs": {
          "700070301": {
            "id": "700070301",
            "speakerId": 10026,
            "speakerName": "Besotted Woman",
            "text": "Excuse me? Did you want something?",
            "nextDialogs": [
              "700070304"
            ]
          },
          "700070304": {
            "id": "700070304",
            "speakerId": 10026,
            "speakerName": "Besotted Woman",
            "text": "My apologies, I'll be more mindful of that. I just can't help giving voice to my feelings sometimes.",
            "nextDialogs": [
              "700070305"
            ]
          },
          "700070305": {
            "id": "700070305",
            "speakerId": 10025,
            "speakerName": "Man Doing Magic Tricks",
            "text": "While you weren't paying attention, I drew out a rose from between the pages.",
            "nextDialogs": [
              "700070306"
            ]
          },
          "700070306": {
            "id": "700070306",
            "speakerId": 10025,
            "speakerName": "Man Doing Magic Tricks",
            "text": "This book-born rose is just like you — delicate and full of scholarly beauty...",
            "nextDialogs": [
              "700070307"
            ]
          },
          "700070307": {
            "id": "700070307",
            "speakerId": 10026,
            "speakerName": "Besotted Woman",
            "text": "Wha—!? That was amazing!",
            "nextDialogs": [
              "700070308"
            ]
          },
          "700070308": {
            "id": "700070308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're being too noisy! And books aren't meant to be used as props for magic tricks! You'll tear them apart!",
            "nextDialogs": [
              "700070309"
            ]
          },
          "700070309": {
            "id": "700070309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You might want to keep it down too, Paimon...",
            "nextDialogs": [
              "700070310"
            ]
          },
          "700070310": {
            "id": "700070310",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, sorry. Paimon didn't mean to...",
            "nextDialogs": [
              "700070311"
            ]
          },
          "700070311": {
            "id": "700070311",
            "speakerId": 10026,
            "speakerName": "Besotted Woman",
            "text": "So now you understand. Some things are beyond our control.",
            "nextDialogs": [
              "700070312"
            ]
          },
          "700070312": {
            "id": "700070312",
            "speakerId": 10026,
            "speakerName": "Besotted Woman",
            "text": "Once again, I'm truly sorry. I'll keep my volume in check.",
            "nextDialogs": [
              "700070313"
            ]
          },
          "700070313": {
            "id": "700070313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It doesn't seem like they took it to heart..."
          }
        }
      }
    },
    {
      "subId": "7000704",
      "subQuestName": "Try and convince the lovebirds to be quiet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700070401"
        ],
        "dialogs": {
          "700070401": {
            "id": "700070401",
            "speakerId": 10028,
            "speakerName": "Seemingly Rational Woman",
            "text": "You claim that \"fluctuations of emotions may influence the accuracy of research and analysis\"? This assertion is founded on insufficient grounds.",
            "nextDialogs": [
              "700070402"
            ]
          },
          "700070402": {
            "id": "700070402",
            "speakerId": 10027,
            "speakerName": "Seemingly Rational Man",
            "text": "*sigh* I understand. I must be encountering some strange hindrance to my research...",
            "nextDialogs": [
              "700070403"
            ]
          },
          "700070403": {
            "id": "700070403",
            "speakerId": 10027,
            "speakerName": "Seemingly Rational Man",
            "text": "You've come at the right moment. I'm having a little trouble right now, and I'd like to have your opinion on it as an outlander.",
            "nextDialogs": [
              "700070404"
            ]
          },
          "700070404": {
            "id": "700070404",
            "speakerId": 10027,
            "speakerName": "Seemingly Rational Man",
            "text": "If I want to prove the veracity of my logic, I must ensure that I keep my cool.",
            "nextDialogs": [
              "700070405"
            ]
          },
          "700070405": {
            "id": "700070405",
            "speakerId": 10027,
            "speakerName": "Seemingly Rational Man",
            "text": "But I can never do this, and especially not when I'm debating with her — I just can't seem to keep my cool and think.",
            "nextDialogs": [
              "700070406"
            ]
          },
          "700070406": {
            "id": "700070406",
            "speakerId": 10028,
            "speakerName": "Seemingly Rational Woman",
            "text": "I find it strange, too. Did you not sleep well last night? Or are you hungover?",
            "nextDialogs": [
              "700070408"
            ]
          },
          "700070408": {
            "id": "700070408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Either way, you should both pipe down a bit.",
            "nextDialogs": [
              "700070409"
            ]
          },
          "700070409": {
            "id": "700070409",
            "speakerId": 10027,
            "speakerName": "Seemingly Rational Man",
            "text": "Sorry, but I won't rest until I figure this out.",
            "nextDialogs": [
              "700070410"
            ]
          },
          "700070410": {
            "id": "700070410",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "H—He didn't listen at all...",
            "nextDialogs": [
              "700070411"
            ]
          },
          "700070411": {
            "id": "700070411",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, you shouldn't be disturbing others either way. Also, stop putting the books back on the shelves with spines facing inward!",
            "nextDialogs": [
              "700070412"
            ]
          },
          "700070412": {
            "id": "700070412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh... They're not paying us any mind at all..."
          }
        }
      }
    },
    {
      "subId": "7000707",
      "subQuestName": "Talk to Paimon about countermeasures",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700070701"
        ],
        "dialogs": {
          "700070701": {
            "id": "700070701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*sigh* Guess nobody's in the mood for advice, huh?",
            "nextDialogs": [
              "700070702"
            ]
          },
          "700070702": {
            "id": "700070702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "None of them have very good library etiquette. Best we go talk it over with Wyratt."
          }
        }
      }
    },
    {
      "subId": "7000708",
      "subQuestName": "Talk to Wyratt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700070801"
        ],
        "dialogs": {
          "700070801": {
            "id": "700070801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, about the racket in the library...",
            "nextDialogs": [
              "700070802"
            ]
          },
          "700070802": {
            "id": "700070802",
            "speakerId": 1648,
            "speakerName": "Wyratt",
            "text": "I see... I guess we'll just have to use \"that method.\"",
            "nextDialogs": [
              "700070803"
            ]
          },
          "700070803": {
            "id": "700070803",
            "speakerId": 1648,
            "speakerName": "Wyratt",
            "text": "Miss Lisa mentioned in the past that there will be consequences for breaking the library rules...",
            "nextDialogs": [
              "700070804"
            ]
          },
          "700070804": {
            "id": "700070804",
            "speakerId": 1648,
            "speakerName": "Wyratt",
            "text": "Do you mind going into the library to pass Miss Lisa's message along?",
            "nextDialogs": [
              "700070805"
            ]
          },
          "700070805": {
            "id": "700070805",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Making dog-ears on pages, stuffing roses into books, putting them onto shelves the wrong way... These are definitely violations of the library rules.",
            "nextDialogs": [
              "700070806"
            ]
          },
          "700070806": {
            "id": "700070806",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, let's go pass Lisa's message on to those people in the library who aren't reading the way they should."
          }
        }
      }
    },
    {
      "subId": "7000709",
      "subQuestName": "Carry Lisa's message",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7000710",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700071001"
        ],
        "dialogs": {
          "700071001": {
            "id": "700071001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh!? What? Lisa's coming back soon?",
            "nextDialogs": [
              "700071002"
            ]
          },
          "700071002": {
            "id": "700071002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no! She'll be real mad when she finds out that people have made a mess out of the books and even dog-eared the pages, won't she?",
            "nextDialogs": [
              "700071003"
            ]
          },
          "700071003": {
            "id": "700071003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's right — oh no, how terrible! Who will save us?",
            "nextDialogs": [
              "700071004"
            ]
          },
          "700071004": {
            "id": "700071004",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, what are we to do? Oh, oh! Maybe there might still be time if we start cleaning up now!",
            "nextDialogs": [
              "700071005"
            ]
          },
          "700071005": {
            "id": "700071005",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "That was quite ingenious of you. Quite unexpected.",
            "nextDialogs": [
              "700071006"
            ]
          },
          "700071006": {
            "id": "700071006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That was Wyratt's idea.",
            "nextDialogs": [
              "700071007"
            ]
          },
          "700071007": {
            "id": "700071007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, Lisa's reputation precedes her.",
            "nextDialogs": [
              "700071008"
            ]
          },
          "700071008": {
            "id": "700071008",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "Still, Miss Lisa probably would have been mad if she had seen the state the library was in earlier. This is a library, after all — a place of learning.",
            "nextDialogs": [
              "700071009"
            ]
          },
          "700071009": {
            "id": "700071009",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "Guess I can finally continue my research in peace. Here, take this as thanks."
          }
        }
      }
    },
    {
      "subId": "6164801",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "616480101"
        ],
        "dialogs": {
          "616480101": {
            "id": "616480101",
            "speakerId": 15240,
            "speakerName": "Wyratt",
            "text": "Hello, how may I help?"
          }
        }
      }
    },
    {
      "subId": "6164802",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "616480201"
        ],
        "dialogs": {
          "616480201": {
            "id": "616480201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What is this place?",
            "nextDialogs": [
              "616480202"
            ]
          },
          "616480202": {
            "id": "616480202",
            "speakerId": 15240,
            "speakerName": "Wyratt",
            "text": "The main hall of the Knights of Favonius Headquarters. Please keep noise to a minimum.",
            "nextDialogs": [
              "616480203"
            ]
          },
          "616480203": {
            "id": "616480203",
            "speakerId": 15240,
            "speakerName": "Wyratt",
            "text": "Please wipe your shoes before entering the Library to avoid taking any dust or dirt inside."
          }
        }
      }
    },
    {
      "subId": "6164803",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "616480301"
        ],
        "dialogs": {
          "616480301": {
            "id": "616480301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Goodbye.",
            "nextDialogs": [
              "616480302"
            ]
          },
          "616480302": {
            "id": "616480302",
            "speakerId": 15240,
            "speakerName": "Wyratt",
            "text": "Goodbye. Don't forget to close the door behind you when you leave."
          }
        }
      }
    },
    {
      "subId": "7000751",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700075101"
        ],
        "dialogs": {
          "700075101": {
            "id": "700075101",
            "speakerId": 1565,
            "speakerName": "Ella Musk",
            "text": "Please lend me a hand, I really need some peace and quiet..."
          }
        }
      }
    },
    {
      "subId": "7000752",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700075201"
        ],
        "dialogs": {
          "700075201": {
            "id": "700075201",
            "speakerId": 10023,
            "speakerName": "Young Man in Love",
            "text": "Let's read this one next. Would you like me to read it to you?",
            "nextDialogs": [
              "700075202"
            ]
          },
          "700075202": {
            "id": "700075202",
            "speakerId": 10024,
            "speakerName": "Young Woman in Love",
            "text": "Of course. I love hearing you tell stories."
          }
        }
      }
    },
    {
      "subId": "7000753",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700075301"
        ],
        "dialogs": {
          "700075301": {
            "id": "700075301",
            "speakerId": 10025,
            "speakerName": "Man Doing Magic Tricks",
            "text": "And what shall my next trick be? No need to tell me, just let me read your mind...",
            "nextDialogs": [
              "700075302"
            ]
          },
          "700075302": {
            "id": "700075302",
            "speakerId": 10026,
            "speakerName": "Besotted Woman",
            "text": "Oh, I'm so nervous..."
          }
        }
      }
    },
    {
      "subId": "7000754",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700075401"
        ],
        "dialogs": {
          "700075401": {
            "id": "700075401",
            "speakerId": 10027,
            "speakerName": "Seemingly Rational Man",
            "text": "What's the matter, I wonder?",

  },
  "subQuests": [
    {
      "subId": "7267801",
      "subQuestName": "Go to Stormterror's Lair",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726780101"
        ],
        "dialogs": {
          "726780101": {
            "id": "726780101",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "This city is very big, but... feels grim.",
            "nextDialogs": [
              "726780102"
            ]
          },
          "726780102": {
            "id": "726780102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We came here before with a lot of companions, and we fought a battle against Stormterror.",
            "nextDialogs": [
              "726780103"
            ]
          },
          "726780103": {
            "id": "726780103",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Is Stormterror a large, sharp-tooth, scary dragon with flip-flap wings?",
            "nextDialogs": [
              "726780106"
            ]
          },
          "726780106": {
            "id": "726780106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Do you still remember that Anemo Archon statue we saw in Mondstadt?",
            "nextDialogs": [
              "726780107"
            ]
          },
          "726780107": {
            "id": "726780107",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Anemo Archon Statue...?",
            "nextDialogs": [
              "726780108"
            ]
          },
          "726780108": {
            "id": "726780108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That big, tall stone statue.",
            "nextDialogs": [
              "726780109"
            ]
          },
          "726780109": {
            "id": "726780109",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm! Yes! Anemo Archon had big hands!",
            "nextDialogs": [
              "726780110"
            ]
          },
          "726780110": {
            "id": "726780110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Stormterror is the archon's good friend! Long ago, the Anemo Archon was from this city, too...",
            "nextDialogs": [
              "726780111"
            ]
          },
          "726780111": {
            "id": "726780111",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Ooh!",
            "nextDialogs": [
              "726780112"
            ]
          },
          "726780112": {
            "id": "726780112",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "But if Storm-Storm is so big, how does he get in here?"
          }
        }
      }
    },
    {
      "subId": "7267802",

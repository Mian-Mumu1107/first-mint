    {
      "subId": "7267811",
      "subQuestName": "Return to Chinju Forest to visit Ioroi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726790101"
        ],
        "dialogs": {
          "726790101": {
            "id": "726790101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're back, Ioroi!",
            "nextDialogs": [
              "726790102"
            ]
          },
          "726790102": {
            "id": "726790102",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Ooh, you've finally returned! How has Kichiboushi's training gone?",
            "nextDialogs": [
              "726790103"
            ]
          },
          "726790103": {
            "id": "726790103",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Squelch squelch, kapow!",
            "nextDialogs": [
              "726790104"
            ]
          },
          "726790104": {
            "id": "726790104",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Mmhahaha! Good, good!",
            "nextDialogs": [
              "726790105"
            ]
          },
          "726790105": {
            "id": "726790105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh brother, we can't understand Kichiboushi anymore...",
            "nextDialogs": [
              "726790106"
            ]
          },
          "726790106": {
            "id": "726790106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We even took a lot of photos. Have a look, Ioroi...",
            "nextDialogs": [
              "726790107"
            ]
          },
          "726790107": {
            "id": "726790107",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You show all the photos you took for Kichiboushi during this time to Ioroi.\\nYou also tell him about your adventures.",
            "nextDialogs": [
              "726790108"
            ]
          },
          "726790108": {
            "id": "726790108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...And that's how we completed your request to \"take Kichiboushi to eight places to train,\" Ioroi.",
            "nextDialogs": [
              "726790109"
            ]
          },
          "726790109": {
            "id": "726790109",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Mm! Good, very good, as might be expected of humans I had mine eye on. If you were also tanuki, you would be great and renowned indeed. Perhaps half as great as I when put together!",
            "nextDialogs": [
              "726790110"
            ]
          },
          "726790110": {
            "id": "726790110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(That's not super impressive...)",
            "nextDialogs": [
              "726790111"
            ]
          },
          "726790111": {
            "id": "726790111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But since we've completed the task, we should probably leave now.",
            "nextDialogs": [
              "726790112"
            ]
          },
          "726790112": {
            "id": "726790112",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mmmph...",
            "nextDialogs": [
              "726790113"
            ]
          },
          "726790113": {
            "id": "726790113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, don't be like that. Come on, Kichiboushi, Paimon's gonna teach you one more thing!",
            "nextDialogs": [
              "726790114"
            ]
          },
          "726790114": {
            "id": "726790114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "When you say goodbye to friends, you should see them off with a smile! That way, you'll be even happier when you meet again.",
            "nextDialogs": [
              "726790115"
            ]
          },
          "726790115": {
            "id": "726790115",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "...Mm? Alright. Sure. Leave it to me.",
            "nextDialogs": [
              "726790116"
            ]
          },
          "726790116": {
            "id": "726790116",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Kichiboushi says, \"Got it, White Fur.\"",
            "nextDialogs": [
              "726790117"
            ]
          },
          "726790117": {
            "id": "726790117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? Does this mean...",
            "nextDialogs": [
              "726790120"
            ]
          },
          "726790120": {
            "id": "726790120",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "It has been some time. The effects of the tanuki meal must have worn off.",
            "nextDialogs": [
              "726790121"
            ]
          },
          "726790121": {
            "id": "726790121",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Hmph! If I were free from this stone seal, it would be a thing of ease to have you understand tanuki speech all the time...",
            "nextDialogs": [
              "726790122"
            ]
          },
          "726790122": {
            "id": "726790122",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "...Hmm? Of course, I will pass it on.",
            "nextDialogs": [
              "726790123"
            ]
          },
          "726790123": {
            "id": "726790123",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "\"Kichiboushi train hard.\"",
            "nextDialogs": [
              "726790124"
            ]
          },
          "726790124": {
            "id": "726790124",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "\"Become strong bake-danuki, like Ioroi!\"",
            "nextDialogs": [
              "726790125"
            ]
          },
          "726790125": {
            "id": "726790125",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Mm? Hahaha! That's quite the boast, you little rascal. Reminds me of myself when I was your age!",
            "nextDialogs": [
              "726790126"
            ]
          },
          "726790126": {
            "id": "726790126",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "\"Then White Fur and Yellow Fur no eat bake-danuki food, understand Kichiboushi.\"",
            "nextDialogs": [
              "726790127"
            ]
          },
          "726790127": {
            "id": "726790127",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We'll be waiting, Kichiboushi! We'll come train with you next time, too.",
            "nextDialogs": [
              "726790128"
            ]
          },
          "726790128": {
            "id": "726790128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Good luck, Kichiboushi.",
            "nextDialogs": [
              "726790129"
            ]
          },
          "726790129": {
            "id": "726790129",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't get sealed by humans, now.",
            "nextDialogs": [
              "726790130"
            ]
          },
          "726790130": {
            "id": "726790130",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Mm!?",
            "nextDialogs": [
              "726790131"
            ]
          },
          "726790131": {
            "id": "726790131",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm!",
            "nextDialogs": [
              "726790132"
            ]
          },
          "726790132": {
            "id": "726790132",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Eh, forget it. I shall not pursue the matter, considering that you did take Kichiboushi out to train.",
            "nextDialogs": [
              "726790133"
            ]
          },
          "726790133": {
            "id": "726790133",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Ah, yes. There was once this fellow called Utamarou who painted the tanuki sealed in Chinju Forest and left some drafts behind.",
            "nextDialogs": [
              "726790134"
            ]
          },
          "726790134": {
            "id": "726790134",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "You can have it, to look upon whenever you wish to remember the handsome forms of the tanuki race!",
            "nextDialogs": [
              "726790135"
            ]
          },
          "726790135": {
            "id": "726790135",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "*sigh* If only you, too, were tanuki...",
            "nextDialogs": [
              "726790136"
            ]
          },
          "726790136": {
            "id": "726790136",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wouldn't we have been turned into stone already, then?",
            "nextDialogs": [
              "726790137"
            ]
          },
          "726790137": {
            "id": "726790137",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Mmph, true. Well then, off you go now. I have a little magic to teach Kichiboushi."
          }
        }
      }
    },

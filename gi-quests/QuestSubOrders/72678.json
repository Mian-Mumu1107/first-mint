      }
    },
    {
      "subId": "7267803",
      "subQuestName": "Talk to Kichiboushi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726780301"
        ],
        "dialogs": {
          "726780301": {
            "id": "726780301",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm... Very nice...",
            "nextDialogs": [
              "726780302"
            ]
          },
          "726780302": {
            "id": "726780302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's wrong, Kichiboushi?",
            "nextDialogs": [
              "726780303"
            ]
          },
          "726780303": {
            "id": "726780303",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "This is a grim city. Very sad, don't know why. Strange.",
            "nextDialogs": [
              "726780306"
            ]
          },
          "726780306": {
            "id": "726780306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Next up, let's head into the center of this \"city\"..."
          }
        }
      }
    },
    {
      "subId": "7267804",
      "subQuestName": "Head for the tower in Stormterror's Lair",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726780401"
        ],
        "dialogs": {
          "726780401": {
            "id": "726780401",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mmmph! The wind... strong...",
            "nextDialogs": [
              "726780402"
            ]
          },
          "726780402": {
            "id": "726780402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We can't pass through these storm-walls. We've got to go around!",
            "nextDialogs": [
              "726780403"
            ]
          },
          "726780403": {
            "id": "726780403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Easy now, Kichiboushi, just follow us around."
          }
        }
      }
    },
    {
      "subId": "7267809",
      "subQuestName": "Head deeper into Stormterror's Lair",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7267805",
      "subQuestName": "Head deeper into Stormterror's Lair",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726780501"
        ],
        "dialogs": {
          "726780501": {
            "id": "726780501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're finally here!",
            "nextDialogs": [
              "726780502"
            ]
          },
          "726780502": {
            "id": "726780502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The view's much better up here. Look over there — that's the spot where we came from!",
            "nextDialogs": [
              "726780503"
            ]
          },
          "726780503": {
            "id": "726780503",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Paimon likes high spots, mm?",
            "nextDialogs": [
              "726780507",
              "726780506"
            ]
          },
          "726780507": {
            "id": "726780507",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Does Storm-Storm sleep here?",
            "nextDialogs": [
              "726780508"
            ]
          },
          "726780508": {
            "id": "726780508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yup — for a really long time, too.",
            "nextDialogs": [
              "726780509"
            ]
          },
          "726780509": {
            "id": "726780509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Even though {NICKNAME} fought Stormterror, he's not a bad dragon.",
            "nextDialogs": [
              "726780510"
            ]
          },
          "726780510": {
            "id": "726780510",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He just experienced something terrible, got hurt, and was tricked by bad people, so he thought that his friend, the Anemo Archon, no longer needed him.",
            "nextDialogs": [
              "726780511"
            ]
          },
          "726780511": {
            "id": "726780511",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm... Then what happened?",
            "nextDialogs": [
              "726780512"
            ]
          },
          "726780512": {
            "id": "726780512",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#After that, huh? Do you remember, {NICKNAME}?",
            "nextDialogs": [
              "726780513"
            ]
          },
          "726780513": {
            "id": "726780513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I purified his poisoned blood during our battle.",
            "nextDialogs": [
              "726780514"
            ]
          },
          "726780514": {
            "id": "726780514",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But the platform we were battling on collapsed. At first, it looked like we and the Anemo Archon were going to fall into a deep, dark place...",
            "nextDialogs": [
              "726780515"
            ]
          },
          "726780515": {
            "id": "726780515",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Eek! That's horrible... What did you do? Did you fly away?"
          },
          "726780506": {
            "id": "726780506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's not what this is about! You can see everything from up here, and the air is great, too."
          }
        }
      }
    },

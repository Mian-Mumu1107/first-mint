        ],
        "dialogs": {
          "4680201": {
            "id": "4680201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is there anything I can do to help?",
            "nextDialogs": [
              "4680202"
            ]
          },
          "4680202": {
            "id": "4680202",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "You are...?",
            "nextDialogs": [
              "4680203"
            ]
          },
          "4680203": {
            "id": "4680203",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "...Ah, travelers. How kind of you.",
            "nextDialogs": [
              "4680204"
            ]
          },
          "4680204": {
            "id": "4680204",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "Now is the ripening season for grapes. But a herd of boars came out of nowhere and they have their eyes set on the vineyard.",
            "nextDialogs": [
              "4680205"
            ]
          },
          "4680205": {
            "id": "4680205",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "I can't chase them away by myself and my son is not with me now, so all I can do now is to watch them wreck my land...",
            "nextDialogs": [
              "4680206"
            ]
          },
          "4680206": {
            "id": "4680206",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "If you can help me kick those boars out, I'll repay you handsomely!"
          }
        }
      }
    },
    {
      "subId": "46801",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4680101"
        ],
        "dialogs": {
          "4680101": {
            "id": "4680101",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "My grape vines are destroyed... These boars..."
          }
        }
      }
    },
    {
      "subId": "46803",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4680301"
        ],
        "dialogs": {
          "4680301": {
            "id": "4680301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I've got something else to do...",
            "nextDialogs": [
              "4680302"
            ]
          },
          "4680302": {
            "id": "4680302",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "Well then, guess I can only wait until my son's back to punish those boars."
          }
        }
      }
    },
    {
      "subId": "46804",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4680401"
        ],
        "dialogs": {
          "4680401": {
            "id": "4680401",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "Hello. Do you have any message from my son?",
            "nextDialogs": [
              "4680602"
            ]
          },
          "4680602": {
            "id": "4680602",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "Me? Pals in the winery call me Old Tunner. I'm a farmer here at the Dawn Winery.",
            "nextDialogs": [
              "4680603"
            ]
          },
          "4680603": {
            "id": "4680603",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "My family has been farming here for generations. Most of the good wines you've had were probably fermented using the grapes here.",
            "nextDialogs": [
              "4680604"
            ]
          },
          "4680604": {
            "id": "4680604",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "Every owner of the winery has been treating our family very generously.",
            "nextDialogs": [
              "4680605"
            ]
          },
          "4680605": {
            "id": "4680605",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "But I don't think it's a good thing for my son to inherit this land and become a farmer for his whole life..."
          }
        }
      }
    },
    {
      "subId": "46805",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4680501"
        ],
        "dialogs": {
          "4680501": {
            "id": "4680501",
            "speakerId": 1000,
            "speakerName": "Tunner",
            "text": "There are still some boars wandering there..."
          }
        }
      }
    }
  ]

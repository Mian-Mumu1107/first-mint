    {
      "subId": "4005111",
      "subQuestName": "Open the path to the area beneath the Dainichi Mikoshi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400511101"
        ],
        "dialogs": {
          "400511101": {
            "id": "400511101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's shocked. It actually worked!",
            "nextDialogs": [
              "400511102"
            ]
          },
          "400511102": {
            "id": "400511102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "For once, he didn't lie to us.",
            "nextDialogs": [
              "400511103"
            ]
          },
          "400511103": {
            "id": "400511103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Technically speaking, he's never really lied to us.",
            "nextDialogs": [
              "400511104"
            ]
          },
          "400511104": {
            "id": "400511104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well maybe with his sneaky way of explaining things, he doesn't have to! Why does Paimon feel like you two have reached some sort of mutual understanding!? That is not okay!",
            "nextDialogs": [
              "400511105"
            ]
          },
          "400511105": {
            "id": "400511105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The Dainichi Mikoshi should be accessible again now. Let's get down there and see."
          }
        }
      }
    },

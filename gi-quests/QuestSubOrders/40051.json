    {
      "subId": "4005119",
      "subQuestName": "Head beneath the Dainichi Mikoshi to look for Tsumi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400511901"
        ],
        "dialogs": {
          "400511901": {
            "id": "400511901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "After a careful headcount, it seems like the baby vishaps aren't here anymore. Guess they got rescued...",
            "nextDialogs": [
              "400511902"
            ]
          },
          "400511902": {
            "id": "400511902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "If the Bathysmal Vishaps really did come down here, that means that guy was telling the truth...",
            "nextDialogs": [
              "400511903"
            ]
          },
          "400511903": {
            "id": "400511903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So... Tsumi really is a Vishap-person?",
            "nextDialogs": [
              "400511904"
            ]
          },
          "400511904": {
            "id": "400511904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But we still haven't seen her anywhere. Where the heck is she?",
            "nextDialogs": [
              "400511905"
            ]
          },
          "400511905": {
            "id": "400511905",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*sigh* Whatever. Let's head back up."
          }
        }
      }
    },
    {
      "subId": "4005114",
      "subQuestName": "Return to the Dainichi Mikoshi and take stock of the situation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4005115",
      "subQuestName": "Talk to Tsumi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400511501"
        ],
        "dialogs": {
          "400511501": {
            "id": "400511501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's Tsumi! Uh, what is she doing in front of the Dainichi Mikoshi?",
            "nextDialogs": [
              "400511502"
            ]
          },
          "400511502": {
            "id": "400511502",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "Since you came back, I'm curious to know — did our rescue operation succeed?",
            "nextDialogs": [
              "400511503"
            ]
          },
          "400511503": {
            "id": "400511503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Some baby vishaps were rescued before we got there. But the old and weak vishaps went back in the water to hide after we defeated the elites.",
            "nextDialogs": [
              "400511504"
            ]
          },
          "400511504": {
            "id": "400511504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um, Tsumi... Are you really a Vishap-person?",
            "nextDialogs": [
              "400511505"
            ]
          },
          "400511505": {
            "id": "400511505",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "I have no intention of explaining anything. Although I can communicate with you, I know all too well that interaction with humans can only end in betrayal.",
            "nextDialogs": [
              "400511506"
            ]
          },
          "400511506": {
            "id": "400511506",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "The conflict between our two kinds will go on forever.",
            "nextDialogs": [
              "400511507"
            ]
          },
          "400511507": {
            "id": "400511507",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "Before I leave, I'm going to destroy this light.",
            "nextDialogs": [
              "400511508"
            ]
          },
          "400511508": {
            "id": "400511508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You think you have what it takes?",
            "nextDialogs": [
              "400511509"
            ]
          },
          "400511509": {
            "id": "400511509",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "Do not come any closer. And don't even think about trying to sneak up on me.",
            "nextDialogs": [
              "400511510"
            ]
          },
          "400511510": {
            "id": "400511510",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "This tower seems to hear my wishes... I just need to think the thought and it will change its brightness.",
            "nextDialogs": [
              "400511511"
            ]
          },
          "400511511": {
            "id": "400511511",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "And if I so desire, it will collapse before me.",
            "nextDialogs": [
              "400511512"
            ]
          },
          "400511512": {
            "id": "400511512",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "With the cognitive equivalent of a click of the fingers, I could destroy this source of great pain for the vishaps.",
            "nextDialogs": [
              "400511513"
            ]
          },
          "400511513": {
            "id": "400511513",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "So why... why can't I do it...?",
            "nextDialogs": [
              "400511514"
            ]
          },
          "400511514": {
            "id": "400511514",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Oh no, this is way more serious than losing access to the Bloodbranch Coral! What're we gonna do, {NICKNAME}?",
            "nextDialogs": [
              "400511517"
            ]
          },
          "400511517": {
            "id": "400511517",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "It's...",
            "nextDialogs": [
              "400511518"
            ]
          },
          "400511518": {
            "id": "400511518",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Tsumi remembers her pendant. She combines it with the other pieces.",
            "nextDialogs": [
              "400511519"
            ]
          },
          "400511519": {
            "id": "400511519",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's a pendant in the shape of... are those three entwined snakes?",
            "nextDialogs": [
              "400511520"
            ]
          },
          "400511520": {
            "id": "400511520",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "This pendant has been with me for as long as I can remember. Why does it fit with your two pieces?",
            "nextDialogs": [
              "400511521"
            ]
          },
          "400511521": {
            "id": "400511521",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I think deep down, you already know the answer.",
            "nextDialogs": [
              "400511522"
            ]
          },
          "400511522": {
            "id": "400511522",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "Don't be ridiculous. Are you trying to say that... that I...",
            "nextDialogs": [
              "400511523"
            ]
          },
          "400511523": {
            "id": "400511523",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon doesn't understand... This one is Kokomi's, this one is from the Dainichi Mikoshi, and Tsumi's has been with her all along...",
            "nextDialogs": [
              "400511524"
            ]
          },
          "400511524": {
            "id": "400511524",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You belong to Watatsumi Island.",
            "nextDialogs": [
              "400511525"
            ]
          },
          "400511525": {
            "id": "400511525",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "...",
            "nextDialogs": [
              "400511526"
            ]
          },
          "400511526": {
            "id": "400511526",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "I grew up with the vishaps. My only possessions were this pendant and a few boxes of books. I learned human language and writing from them.",
            "nextDialogs": [
              "400511527"
            ]
          },
          "400511527": {
            "id": "400511527",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "But not long after that, Enkanomiya was left without a single human being. It became completely empty.",
            "nextDialogs": [
              "400511528"
            ]
          },
          "400511528": {
            "id": "400511528",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "Only recently did I finally have the chance to make contact with humans and learn what the things I'd read in the books really meant.",
            "nextDialogs": [
              "400511529"
            ]
          },
          "400511529": {
            "id": "400511529",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Tsumi...",
            "nextDialogs": [
              "400511530"
            ]
          },
          "400511530": {
            "id": "400511530",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "There is a saying in your human books that I've never understood until right now.",
            "nextDialogs": [
              "400511531"
            ]
          },
          "400511531": {
            "id": "400511531",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "\"People belong where they are born, but creatures belong where they are fed.\" I am a vishap, not a human. So I'm going back to where I belong.",
            "nextDialogs": [
              "400511532"
            ]
          },
          "400511532": {
            "id": "400511532",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "I guess the Dainichi Mikoshi isn't my concern. But we'll be back one day.",
            "nextDialogs": [
              "400511534"
            ]
          },
          "400511534": {
            "id": "400511534",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Tsumi is gone.",
            "nextDialogs": [
              "400511535"
            ]
          },
          "400511535": {
            "id": "400511535",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why did she suddenly change her mind in the end?",
            "nextDialogs": [
              "400511536"
            ]
          },
          "400511536": {
            "id": "400511536",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe Kokomi knows.",
            "nextDialogs": [
              "400511537"
            ]
          },
          "400511537": {
            "id": "400511537",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right. Kokomi will have definitely anticipated this possibility. That would be why she gave us the pendant fragment in the first place.",
            "nextDialogs": [
              "400511538"
            ]
          },
          "400511538": {
            "id": "400511538",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Everything's resolved here. Let's go back and tell her."
          }
        }
      }
    },
    {
      "subId": "4005116",
      "subQuestName": "Leave Enkanomiya and speak to Kokomi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400511601"
        ],
        "dialogs": {
          "400511601": {
            "id": "400511601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, Kokomi!",
            "nextDialogs": [
              "400511602"
            ]
          },
          "400511602": {
            "id": "400511602",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "Ah, you're back. The soldiers briefed me about what happened.",
            "nextDialogs": [
              "400511603"
            ]
          },
          "400511603": {
            "id": "400511603",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "You successfully worked with a shrine maiden named Tsumi to clear the darkness, but then there was an unexpected change at the Dainichi Mikoshi. Is that so?",
            "nextDialogs": [
              "400511604"
            ]
          },
          "400511604": {
            "id": "400511604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, that's right. But after that is where things started to get all kinds of weird.",
            "nextDialogs": [
              "400511605"
            ]
          },
          "400511605": {
            "id": "400511605",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You tell Kokomi what had happened.",
            "nextDialogs": [
              "400511606"
            ]
          },
          "400511606": {
            "id": "400511606",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "Really?",
            "nextDialogs": [
              "400511607"
            ]
          },
          "400511607": {
            "id": "400511607",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh, sorry, Kokomi... Paimon feels kinda bad that we ended up giving your pendant away.",
            "nextDialogs": [
              "400511608"
            ]
          },
          "400511608": {
            "id": "400511608",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "There's no need to apologize. As I said, Watatsumi Island has no further need for it.",
            "nextDialogs": [
              "400511609"
            ]
          },
          "400511609": {
            "id": "400511609",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "It's a relic from back in the very beginning, when the Watatsumi Omikami reorganized the court and reformed Enkanomiya. The three pendants were given to the Dainichi Mikoshi, the Sangonomiya line, and the Vassals of Watatsumi.",
            "nextDialogs": [
              "400511610"
            ]
          },
          "400511610": {
            "id": "400511610",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "The original intention was that the common folk, the officials, and the divine vassals would all hold each other accountable. But today, only the common folk have flourished, while the other two bloodlines have declined. So the pendant is of little use anymore.",
            "nextDialogs": [
              "400511611"
            ]
          },
          "400511611": {
            "id": "400511611",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Funny you should say vassals... One of the soldiers seemed to think that Tsumi was one of those. But actually, her vertical pupils meant that she was a reptile... She fooled us all.",
            "nextDialogs": [
              "400511612"
            ]
          },
          "400511612": {
            "id": "400511612",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "That's not true. Vassals of Watatsumi typically take on a half-human, half-snake form, symbolizing that they are the familiars of our serpent god. At least, they used to. Over time, the vassals gradually became identical to humans — all except for the pupils of their eyes.",
            "nextDialogs": [
              "400511613"
            ]
          },
          "400511613": {
            "id": "400511613",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "But Vishap-people and Reptilians... they're pure fiction. There is no evidence for their existence anywhere among Sangonomiya's classified documents.",
            "nextDialogs": [
              "400511614"
            ]
          },
          "400511614": {
            "id": "400511614",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, so Tsumi isn't actually a vishap?",
            "nextDialogs": [
              "400511615"
            ]
          },
          "400511615": {
            "id": "400511615",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "The Watatsumi Omikami exhausted its power to create Watatsumi Island, and after that, it grew weaker and weaker. No more Vassals of Watatsumi were born after that. But the records do mention the very last of the vassals...",
            "nextDialogs": [
              "400511616"
            ]
          },
          "400511616": {
            "id": "400511616",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "All our hopes were placed onto her. She was going to be the one who could communicate between the vishaps and the humans. But when she was just an infant girl, she and her guardian shrine maiden were attacked by vishaps at the border of Enkanomiya. Her whereabouts have been unknown ever since.",
            "nextDialogs": [
              "400511617"
            ]
          },
          "400511617": {
            "id": "400511617",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "Most believe she died that day. But some believe she was raised by the vishaps.",
            "nextDialogs": [
              "400511618"
            ]
          },
          "400511618": {
            "id": "400511618",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "The people of Watatsumi owe a great debt of gratitude to the Vassals of Watatsumi. Now that the vishaps and Watatsumi Islanders no longer have a territorial dispute, I sincerely hope that she will find her way to where she belongs... wherever that is for her.",
            "nextDialogs": [
              "400511619"
            ]
          },
          "400511619": {
            "id": "400511619",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What a story...",
            "nextDialogs": [
              "400511620"
            ]
          },
          "400511620": {
            "id": "400511620",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "Still, now that we know how Bloodbranch Coral works, I, as Divine Priestess of Sangonomiya, may need to think of a new way to counteract the Holy Soil phenomenon.",
            "nextDialogs": [
              "400511621"
            ]
          },
          "400511621": {
            "id": "400511621",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "For the time being, however, the issue is resolved, and all thanks to you. Watatsumi Island will be at peace for many decades to come.",
            "nextDialogs": [
              "400511622"
            ]
          },
          "400511622": {
            "id": "400511622",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "I can't thank you enough."
          }
        }
      }
    },
    {
      "subId": "4005199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400519903"
        ],
        "dialogs": {
          "400519903": {
            "id": "400519903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's him!",
            "nextDialogs": [
              "400519904"
            ]
          },
          "400519904": {
            "id": "400519904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This must be the mechanism he mentioned, but how do we reach it?",
            "nextDialogs": [
              "400519907"
            ]
          },
          "400519907": {
            "id": "400519907",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ohh, that's where the mechanism is!"
          }
        }
      }
    }
  ]
}
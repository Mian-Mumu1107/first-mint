  "subQuests": [
    {
      "subId": "4005101",
      "subQuestName": "Return to the Dainichi Mikoshi to look for Tsumi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400510101"
        ],
        "dialogs": {
          "400510101": {
            "id": "400510101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Tsumi, we did it!",
            "nextDialogs": [
              "400510102"
            ]
          },
          "400510102": {
            "id": "400510102",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "I can tell. It looks like all three towers have been successfully taken care of.",
            "nextDialogs": [
              "400510103"
            ]
          },
          "400510103": {
            "id": "400510103",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "The evacuation is now going much more quickly thanks to the improved environmental conditions. Most of the soldiers have gotten out...",
            "nextDialogs": [
              "400510104"
            ]
          },
          "400510104": {
            "id": "400510104",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "But it seems like something happened that I hadn't foreseen. Please come with me."
          }
        }
      }
    },
    {
      "subId": "4005102",
      "subQuestName": "Go to the Dainichi Mikoshi's entrance",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400510201"
        ],
        "dialogs": {
          "400510201": {
            "id": "400510201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's darkness churning inside the Dainichi Mikoshi!",
            "nextDialogs": [
              "400510202"
            ]
          },
          "400510202": {
            "id": "400510202",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "Logically speaking, all of Enkanomiya should be back to normal by now...",
            "nextDialogs": [
              "400510203"
            ]
          },
          "400510203": {
            "id": "400510203",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "Unfortunately, this place has now become the most dangerous of all. I don't know why this is happening or what to do about it.",
            "nextDialogs": [
              "400510204"
            ]
          },
          "400510204": {
            "id": "400510204",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "But what I can tell you is the location of the guy behind all of this. I'm going to have to ask you to confront him and make him reveal his whole plan.",
            "nextDialogs": [
              "400510205"
            ]
          },
          "400510205": {
            "id": "400510205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How did this happen?",
            "nextDialogs": [
              "400510206"
            ]
          },
          "400510206": {
            "id": "400510206",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "I've been observing the flow of the darkness and I've noticed something peculiar.",
            "nextDialogs": [
              "400510207"
            ]
          },
          "400510207": {
            "id": "400510207",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "There was a faint vortex continuously absorbing the darkness. I can only assume that the flow must be triggered by his need for Abyssal energy.",
            "nextDialogs": [
              "400510208"
            ]
          },
          "400510208": {
            "id": "400510208",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "He is extremely dangerous. Even most vishaps would be no match for him...",
            "nextDialogs": [
              "400510211"
            ]
          },
          "400510211": {
            "id": "400510211",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "Music to my ears. Thank you.",
            "nextDialogs": [
              "400510212"
            ]
          },
          "400510212": {
            "id": "400510212",
            "speakerId": 30000,
            "speakerName": "Tsumi",
            "text": "If I have deduced correctly, he should be in the <color=#00E1FFFF>library</color> area right now."
          }
        }
      }
    },
    {
      "subId": "4005103",
      "subQuestName": "Go and search for the Abyss Lector",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400510301"
        ],
        "dialogs": {
          "400510301": {
            "id": "400510301",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "Oh, hey. I would say this is a nice surprise, but... it's really not that surprising. Look at you, venturing out into the darkness, doggedly fighting your way through, just to come and see me.",
            "nextDialogs": [
              "400510302"
            ]
          },
          "400510302": {
            "id": "400510302",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "You're the only person I can think of who could actually pull that off. Still, what's with you joining forces with them? Didn't expect that.",
            "nextDialogs": [
              "400510303"
            ]
          },
          "400510303": {
            "id": "400510303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're just trying to stall for time with small talk again!",
            "nextDialogs": [
              "400510304"
            ]
          },
          "400510304": {
            "id": "400510304",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "...Huh. I guess maybe you're not so clued up after all.",
            "nextDialogs": [
              "400510305"
            ]
          },
          "400510305": {
            "id": "400510305",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "Look, I understand that seeing me has gotten you a little agitated. But frankly, the fact that you're still so fired up and raring to go after the long journey here is a bit of a problem for me.",
            "nextDialogs": [
              "400510306"
            ]
          },
          "400510306": {
            "id": "400510306",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "So let's burn off that excess energy with a little exercise, huh! Just to calm you down enough to hear me out."
          }
        }
      }
    },
    {
      "subId": "4005104",
      "subQuestName": "Defeat the Abyss Lector",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4005105",
      "subQuestName": "Speak to the Abyss Lector",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400510501"
        ],
        "dialogs": {
          "400510501": {
            "id": "400510501",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "Stop, stop! My life is flashing before my eyes!",
            "nextDialogs": [
              "400510502"
            ]
          },
          "400510502": {
            "id": "400510502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oh, then I'm not finished just yet!",
            "nextDialogs": [
              "400510503"
            ]
          },
          "400510503": {
            "id": "400510503",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "That woman, with the slender pupils, what does she call herself?",
            "nextDialogs": [
              "400510504"
            ]
          },
          "400510504": {
            "id": "400510504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, how do you know about her?",
            "nextDialogs": [
              "400510505"
            ]
          },
          "400510505": {
            "id": "400510505",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "Her name. What is it?",
            "nextDialogs": [
              "400510506"
            ]
          },
          "400510506": {
            "id": "400510506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "She calls herself Tsumi.",
            "nextDialogs": [
              "400510507"
            ]
          },
          "400510507": {
            "id": "400510507",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "Hmph. That Reptilian seems to be doing a pretty good job of human imitation.",
            "nextDialogs": [
              "400510508"
            ]
          },
          "400510508": {
            "id": "400510508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Reptilian...",
            "nextDialogs": [
              "400510509"
            ]
          },
          "400510509": {
            "id": "400510509",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "Makes sense, doesn't it? The Bathysmal Vishaps are a highly intelligent and fast-evolving kind. There have been legends about this for over a thousand years now.",
            "nextDialogs": [
              "400510510"
            ]
          },
          "400510510": {
            "id": "400510510",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "The \"Vishap-people.\"",
            "nextDialogs": [
              "400510511"
            ]
          },
          "400510511": {
            "id": "400510511",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Vishap-people\"? Huh, sounds like the kind of nickname Paimon comes up with all the time.",
            "nextDialogs": [
              "400510512"
            ]
          },
          "400510512": {
            "id": "400510512",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "Well this one comes from an old Enkanomiyan legend. When the Bathysmal Vishaps were defeated, they began evolving to survive. That is to say, they imitated the victors.",
            "nextDialogs": [
              "400510513"
            ]
          },
          "400510513": {
            "id": "400510513",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "Eventually, this gave rise to a line of vishaps who were indistinguishable from humans except for their pupils. These were the Vishap-people. The story goes that they gradually infiltrated Enkanomiya and took over many high-ranking positions.",
            "nextDialogs": [
              "400510514"
            ]
          },
          "400510514": {
            "id": "400510514",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "Remind you of anyone?",
            "nextDialogs": [
              "400510515"
            ]
          },
          "400510515": {
            "id": "400510515",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We did hear that Tsumi's pupils are vertical...",
            "nextDialogs": [
              "400510516"
            ]
          },
          "400510516": {
            "id": "400510516",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "Yep. In good lighting, you can see that reptiles' pupils are thin, vertical lines. That's hard evidence that she's betrayed you right there.",
            "nextDialogs": [
              "400510517"
            ]
          },
          "400510517": {
            "id": "400510517",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But she's been helping us.",
            "nextDialogs": [
              "400510518"
            ]
          },
          "400510518": {
            "id": "400510518",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "She is just using you to get revenge on me. I mean, I betrayed them first.",
            "nextDialogs": [
              "400510519"
            ]
          },
          "400510519": {
            "id": "400510519",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "I formed an alliance with the vishaps. I said I'd plunge all of Enkanomiya into darkness so they could send their elites into the Dainichi Mikoshi and rescue their captive kin.",
            "nextDialogs": [
              "400510520"
            ]
          },
          "400510520": {
            "id": "400510520",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "In return, they'd allow the Abyss Order safe passage through their territory and help me rebuild the three towers.",
            "nextDialogs": [
              "400510521"
            ]
          },
          "400510521": {
            "id": "400510521",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "But they didn't know that the darkness of the Abyss was a terrible poison to elemental beings.",
            "nextDialogs": [
              "400510522"
            ]
          },
          "400510522": {
            "id": "400510522",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So they thought you had betrayed them?",
            "nextDialogs": [
              "400510523"
            ]
          },
          "400510523": {
            "id": "400510523",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "I mean, I totally did betray them. To be fair, it'd be pretty humiliating for the Abyss Order if we unleashed the power of the Abyss on them and they were just frolicking around with no side effects.",
            "nextDialogs": [
              "400510524"
            ]
          },
          "400510524": {
            "id": "400510524",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You are pure evil!",
            "nextDialogs": [
              "400510525"
            ]
          },
          "400510525": {
            "id": "400510525",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "Well, here's where we are now: Once she's done with you, she'll use the power of the Dainichi Mikoshi to suppress the Sangacorallia and create darkness to protect the vishaps.",
            "nextDialogs": [
              "400510526"
            ]
          },
          "400510526": {
            "id": "400510526",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "They are probably diving down into the depths to rescue their imprisoned companions as we speak. It won't be long before the source of Bloodbranch Coral is completely cut off.",
            "nextDialogs": [
              "400510527"
            ]
          },
          "400510527": {
            "id": "400510527",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, poor Bathysmal Vishaps, but still...",
            "nextDialogs": [
              "400510528"
            ]
          },
          "400510528": {
            "id": "400510528",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "If you still want to save Watatsumi Island, you're gonna have to hurry.",
            "nextDialogs": [
              "400510529"
            ]
          },
          "400510529": {
            "id": "400510529",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "You can use the mechanism I left behind to guide the light and dispel the darkness in the Dainichi Mikoshi.",
            "nextDialogs": [
              "400510530"
            ]
          },
          "400510530": {
            "id": "400510530",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We don't believe a single word that comes out of your mouth!",
            "nextDialogs": [
              "400510531"
            ]
          },
          "400510531": {
            "id": "400510531",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "Ugh, come on guys, do you honestly have another choice?",
            "nextDialogs": [
              "400510532"
            ]
          },
          "400510532": {
            "id": "400510532",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "This is just another fruitless trip to Enkanomiya for me at this point. But no biggie. I'm just a marginal figure in the Order.",
            "nextDialogs": [
              "400510533"
            ]
          },
          "400510533": {
            "id": "400510533",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "Unlike those who are falling over themselves to serve our Highness, I'm interested in more inconsequential things.",
            "nextDialogs": [
              "400510534"
            ]
          },
          "400510534": {
            "id": "400510534",
            "speakerId": 20518,
            "speakerName": "The Thing Calling Itself \"Enjou\"",
            "text": "Yikes, I think I'm all out of time here. I'd better go. I would say \"see ya,\" but... I probably won't. Here, I've got a parting gift for you. It's something I picked up at the Dainichi Mikoshi.",
            "nextDialogs": [
              "400510535"
            ]
          },
          "400510535": {
            "id": "400510535",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This looks like part of the same set as the one that Kokomi gave us... Wait, now's not the time for that...",
            "nextDialogs": [
              "400510536"
            ]
          },
          "400510536": {
            "id": "400510536",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, Paimon's so angry! He got away again!",
            "nextDialogs": [
              "400510537"
            ]
          },
          "400510537": {
            "id": "400510537",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We can't trust that guy, even if he sounds like he's making sense. So let's go back to Tsumi and ask her about all this."
          }
        }
      }
    },
    {
      "subId": "4005117",
      "subQuestName": "Return to the Dainichi Mikoshi to look for Tsumi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400511701"
        ],
        "dialogs": {
          "400511701": {
            "id": "400511701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no, Tsumi's gone...",
            "nextDialogs": [
              "400511702"
            ]
          },
          "400511702": {
            "id": "400511702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We couldn't have missed her on the way here...",
            "nextDialogs": [
              "400511703"
            ]
          },
          "400511703": {
            "id": "400511703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Why does it always end like this.",
            "nextDialogs": [
              "400511704"
            ]
          },
          "400511704": {
            "id": "400511704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aw, c'mon, it's okay. Don't be sad.",
            "nextDialogs": [
              "400511705"
            ]
          },
          "400511705": {
            "id": "400511705",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "On the bright side, most of the soldiers have been successfully evacuated. If any vishaps did come through here just now, at least no one will have gotten hurt.",
            "nextDialogs": [
              "400511706"
            ]
          },
          "400511706": {
            "id": "400511706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Even though just thinking about that guy drives Paimon nuts, it seems we've got no choice but to give what he said a shot. Let's get some light in here."
          }
        }
      }
    },

    {
      "subId": "7518902",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751890201"
        ],
        "dialogs": {
          "751890201": {
            "id": "751890201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sounds like you don't like it here.",
            "nextDialogs": [
              "751890202"
            ]
          },
          "751890202": {
            "id": "751890202",
            "speakerId": 1000,
            "speakerName": "Awanyu",
            "text": "\"And neither would you, were you ever to have been regarded as a criminal.\""
          }
        }
      }
    },
    {
      "subId": "7518905",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751890501"
        ],
        "dialogs": {
          "751890501": {
            "id": "751890501",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "\"I knew you would arrive, and so I prepared a welcome of suitable pomp and circumstance...\"",
            "nextDialogs": [
              "751890502"
            ]
          },
          "751890502": {
            "id": "751890502",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751890503"
            ]
          },
          "751890503": {
            "id": "751890503",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "\"Though I know that you are only being polite, I am indeed glad to see you.\"",
            "nextDialogs": [
              "751890504"
            ]
          },
          "751890504": {
            "id": "751890504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, so it's you after all! So, uh, what are you calling yourself this time?",
            "nextDialogs": [
              "751890505"
            ]
          },
          "751890505": {
            "id": "751890505",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "\"This time, my name belonged to a scribe from the Chamber of Deliberation. In truth, he rarely ever touched quill or ink himself — not since the Secret Source Servants were invented, anyway.\"",
            "nextDialogs": [
              "751890506"
            ]
          },
          "751890506": {
            "id": "751890506",
            "speakerId": 21800,
            "speakerName": "Secret Source Servant",
            "text": "\"Awanyu... You may address me so.\"",
            "nextDialogs": [
              "751890507"
            ]
          },
          "751890507": {
            "id": "751890507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright then, Awanyu. So, are you here to help us out with this \"Sacred Mountain Heart Permit\" thing?",
            "nextDialogs": [
              "751890508"
            ]
          },
          "751890508": {
            "id": "751890508",
            "speakerId": 1000,
            "speakerName": "Awanyu",
            "text": "\"If you are without it, the Astral Assemblages within the Heart of the Sacred Mountain will attack upon detecting any unauthorized entry...\"",
            "nextDialogs": [
              "751890509"
            ]
          },
          "751890509": {
            "id": "751890509",
            "speakerId": 1000,
            "speakerName": "Awanyu",
            "text": "\"...I have extracted records from 'Awanyu.' According to them, the permit required to enter the Heart of the Sacred Mountain has been placed above the Chamber of Deliberation.\"",
            "nextDialogs": [
              "751890510"
            ]
          },
          "751890510": {
            "id": "751890510",
            "speakerId": 1000,
            "speakerName": "Awanyu",
            "text": "\"For that cause, I have no choice but to set foot in this place... This congress of arrogant fools, this assembly of those who gloried in their powerlessness.\"",
            "nextDialogs": [
              "751890511"
            ]
          },
          "751890511": {
            "id": "751890511",
            "speakerId": 1000,
            "speakerName": "Awanyu",
            "text": "\"Not to mention a den of pretenders claiming the right to judge their own kin...\""
          }
        }
      }
    }
  ]
}
        ],
        "dialogs": {
          "210319901": {
            "id": "210319901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh? The monsters here have all been beaten up!",
            "nextDialogs": [
              "210319902"
            ]
          },
          "210319902": {
            "id": "210319902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, this place is a complete mess...",
            "nextDialogs": [
              "210319903"
            ]
          },
          "210319903": {
            "id": "210319903",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What happened here? Let's check this area out. We might find some clues!"

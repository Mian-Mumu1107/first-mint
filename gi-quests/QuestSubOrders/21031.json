          "210310503": {
            "id": "210310503",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Hahaha, that's right. It took quite a lot of work, you know? Ah, I'm just not the young fighter I used to be.",
            "nextDialogs": [
              "210310504"
            ]
          },
          "210310504": {
            "id": "210310504",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "I suppose you've defeated the ones on your end as well, eh?",
            "nextDialogs": [
              "210310505"
            ]
          },
          "210310505": {
            "id": "210310505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Xiao...",
            "nextDialogs": [
              "210310506"
            ]
          },
          "210310506": {
            "id": "210310506",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "So he did it? But why would he...",
            "nextDialogs": [

    {
      "subId": "2103105",
      "subQuestName": "Report back to Huai'an",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210310401"
        ],
        "dialogs": {
          "210310401": {
            "id": "210310401",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "You're back. Agh, those monsters were really hard to deal with...",
            "nextDialogs": [
              "210310402"
            ]
          },
          "210310402": {
            "id": "210310402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You beat them all?",
            "nextDialogs": [
              "210310403"
            ]
          },
          "210310403": {
            "id": "210310403",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Hahaha, that's right. It took quite a lot of work, you know? Ah, I'm just not the young fighter I used to be.",
            "nextDialogs": [
              "210310404"
            ]
          },
          "210310404": {
            "id": "210310404",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "I suppose you've defeated the ones on your end as well, eh?",
            "nextDialogs": [
              "210310405"
            ]
          },
          "210310405": {
            "id": "210310405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the monster camp...",
            "nextDialogs": [
              "210310406"
            ]
          },
          "210310406": {
            "id": "210310406",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "They were all defeated... But there was not a soul in the camp?",
            "nextDialogs": [
              "210310407"
            ]
          },
          "210310407": {
            "id": "210310407",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "That's very strange. Did some passing adventurer defeat them?",
            "nextDialogs": [
              "210310408"
            ]
          },
          "210310408": {
            "id": "210310408",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Whatever the case, thanks for patrolling the area on my behalf. Please take these."
          }
        }
      }
    },

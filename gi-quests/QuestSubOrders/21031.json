  "subQuests": [
    {
      "subId": "2103101",
      "subQuestName": "Talk to Huai'an",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210310101"
        ],
        "dialogs": {
          "210310101": {
            "id": "210310101",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Agh, I must think of something...",
            "nextDialogs": [
              "210310102"
            ]
          },
          "210310102": {
            "id": "210310102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "210310103"
            ]
          },
          "210310103": {
            "id": "210310103",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Ah, it's you. *sigh* I'd rather not talk about it.",
            "nextDialogs": [
              "210310104"
            ]
          },
          "210310104": {
            "id": "210310104",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Lately, business at the inn has been getting better and better, and we've had more people coming to stay.",
            "nextDialogs": [
              "210310105"
            ]
          },
          "210310105": {
            "id": "210310105",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Some people are looking for a peaceful time alone, while others bring their families over on trips.",
            "nextDialogs": [
              "210310106"
            ]
          },
          "210310106": {
            "id": "210310106",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "The booming business is a good thing, of course, but the fact remains that many monsters roam the nearby areas.",
            "nextDialogs": [
              "210310107"
            ]
          },
          "210310107": {
            "id": "210310107",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "If some child out at play or senior folk out on a stroll were to run into those creatures...",
            "nextDialogs": [
              "210310108"
            ]
          },
          "210310108": {
            "id": "210310108",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "To prevent such incidents from occurring, I have to go out and chase monsters around the inn away.",
            "nextDialogs": [
              "210310109"
            ]
          },
          "210310109": {
            "id": "210310109",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "But I am just one man, and they are many...",
            "nextDialogs": [
              "210310110"
            ]
          },
          "210310110": {
            "id": "210310110",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Traveler, could you lend me a hand? You will be well-paid, I assure you!",
            "nextDialogs": [
              "210310115",
              "210310113"
            ]
          },
          "210310115": {
            "id": "210310115",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "I'm counting on you, in any case. I noticed that there were various monster encampments about with dangerous creatures within them.",
            "nextDialogs": [
              "210310116"
            ]
          },
          "210310116": {
            "id": "210310116",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Also, another group of monsters tiptoed up near the inn and even set up camp there...",
            "nextDialogs": [
              "210310117"
            ]
          },
          "210310117": {
            "id": "210310117",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Ugh...",
            "nextDialogs": [
              "210310118"
            ]
          },
          "210310118": {
            "id": "210310118",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "You know what? You can leave the more dangerous ones to me. Just help me to clear out the monsters surrounding the inn.",
            "nextDialogs": [
              "210310119"
            ]
          },
          "210310119": {
            "id": "210310119",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "We'll meet up back here once all the monsters have been driven out.",
            "nextDialogs": [
              "210310120"
            ]
          },
          "210310120": {
            "id": "210310120",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "*sigh* These monsters really are a problem..."
          },
          "210310113": {
            "id": "210310113",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "Me? Well... Thank you for the praise, but I'm just passable.",
            "nextDialogs": [
              "210310114"
            ]
          },
          "210310114": {
            "id": "210310114",
            "speakerId": 1000,
            "speakerName": "Huai'an",
            "text": "And even so, I cannot fight them all by myself."
          }
        }
      }
    },
    {
      "subId": "2103102",
      "subQuestName": "Go to the monster camp and defeat them",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210310201"
        ],
        "dialogs": {
          "210310201": {
            "id": "210310201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh, not a single clue in sight. Who defeated all these monsters? Was it... another adventurer?",
            "nextDialogs": [
              "210310202"
            ]
          },
          "210310202": {
            "id": "210310202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm...",
            "nextDialogs": [
              "210310203"
            ]
          },
          "210310203": {
            "id": "210310203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But since these monsters have been defeated, let's just go back to Huai'an and tell him the news."
          }
        }
      }
    },
    {
      "subId": "2103103",
      "subQuestName": "Look around",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210310301"
        ],
        "dialogs": {
          "210310301": {
            "id": "210310301",
            "speakerId": 1002,
            "speakerName": "Xiao",
            "text": "...Oh, it's you.",
            "nextDialogs": [
              "210310304"
            ]
          },
          "210310304": {
            "id": "210310304",
            "speakerId": 1002,
            "speakerName": "Xiao",
            "text": "I encountered these monsters by chance and defeated them.",
            "nextDialogs": [
              "210310305"
            ]
          },
          "210310305": {
            "id": "210310305",
            "speakerId": 1002,
            "speakerName": "Xiao",
            "text": "This area is not safe. So...",
            "nextDialogs": [
              "210310306"
            ]
          },
          "210310306": {
            "id": "210310306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll be careful.",
            "nextDialogs": [
              "210310307"
            ]
          },
          "210310307": {
            "id": "210310307",
            "speakerId": 1002,
            "speakerName": "Xiao",
            "text": "Right. I have other matters to attend to. See you."
          }
        }
      }
    },

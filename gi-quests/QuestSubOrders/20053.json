  "subQuests": [
    {
      "subId": "2005301",
      "subQuestName": "Go and talk to Ellin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200530101"
        ],
        "dialogs": {
          "200530101": {
            "id": "200530101",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Ugh, what a headache... What am I supposed to do about this?",
            "nextDialogs": [
              "200530102"
            ]
          },
          "200530102": {
            "id": "200530102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you up to?",
            "nextDialogs": [
              "200530103"
            ]
          },
          "200530103": {
            "id": "200530103",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Practicing for the Knights of Favonius' tryouts!",
            "nextDialogs": [
              "200530104"
            ]
          },
          "200530104": {
            "id": "200530104",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "*sigh* But I'm nowhere near as powerful as Jean.",
            "nextDialogs": [
              "200530105"
            ]
          },
          "200530105": {
            "id": "200530105",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "I think it's better for me to focus on technique rather than power.",
            "nextDialogs": [
              "200530106"
            ]
          },
          "200530106": {
            "id": "200530106",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "For example, I was thinking about how to break all these wooden dummies in one fell swoop.",
            "nextDialogs": [
              "200530107"
            ]
          },
          "200530107": {
            "id": "200530107",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "If you're at a loose end, fancy helping me think about how to tackle it?",
            "nextDialogs": [
              "200530110",
              "200530112"
            ]
          },
          "200530110": {
            "id": "200530110",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Sure, take your time. It's not like these dummies are going anywhere.",
            "nextDialogs": [
              "200530111"
            ]
          },
          "200530111": {
            "id": "200530111",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Nor is my life going anywhere while I'm stuck trying to sort this out, ugh...",
            "nextDialogs": [
              "200530114"
            ]
          },
          "200530114": {
            "id": "200530114",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "At this distance, maybe the best solution would be for me to deal with one side and drop a bomb to deal with the other side.",
            "nextDialogs": [
              "200530115"
            ]
          },
          "200530115": {
            "id": "200530115",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Haha, just kidding. I have no idea where I would even get a bomb from anyway."
          },
          "200530112": {
            "id": "200530112",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "You like team combat, then? Alright for some... always someone to help you out.",
            "nextDialogs": [
              "200530113"
            ]
          },
          "200530113": {
            "id": "200530113",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "For people like me, the best I can do is try and hold my own as a lone fighter."
          }
        }
      }
    },
    {
      "subId": "2005302",
      "subQuestName": "Destroy all the training dummies in under 2 seconds",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200530201"
        ],
        "dialogs": {
          "200530201": {
            "id": "200530201",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "How are you getting along? Had a eureka moment yet?",
            "nextDialogs": [
              "200530202"
            ]
          },
          "200530202": {
            "id": "200530202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Still thinking it over...",
            "nextDialogs": [
              "200530203"
            ]
          },
          "200530203": {
            "id": "200530203",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Huh. I've met a few other adventurers before. They were the same way.",
            "nextDialogs": [
              "200530204"
            ]
          },
          "200530204": {
            "id": "200530204",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "They fight monsters like pros, but they're hopelessly lost when it comes to trying to break a few wooden sticks.",
            "nextDialogs": [
              "200530205"
            ]
          },
          "200530205": {
            "id": "200530205",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "And they reinforce the wood like it's for building a storm shelter or something... Way overestimating their own strength.",
            "nextDialogs": [
              "200530206"
            ]
          },
          "200530206": {
            "id": "200530206",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "If they want a challenge so desperately, why don't they just go off into the wilderness and pick a fight with the biggest monster they can find?"
          }
        }
      }
    },
    {
      "subId": "2005303",
      "subQuestName": "Go back and talk to Ellin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200530301"
        ],
        "dialogs": {
          "200530301": {
            "id": "200530301",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Nailed it!",
            "nextDialogs": [
              "200530302"
            ]
          },
          "200530302": {
            "id": "200530302",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Huh, I never even thought of trying that...",
            "nextDialogs": [
              "200530303"
            ]
          },
          "200530303": {
            "id": "200530303",
            "speakerId": 1000,
            "speakerName": "Ellin",
            "text": "Thanks! I'm gonna try it myself now."
          }
        }
      }
    }
  ]
}
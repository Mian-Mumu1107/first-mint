  "subQuests": [
    {
      "subId": "2210501",
      "subQuestName": "Talk to Verr Goldet",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221050101"
        ],
        "dialogs": {
          "221050101": {
            "id": "221050101",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "How stressful...",
            "nextDialogs": [
              "221050102"
            ]
          },
          "221050102": {
            "id": "221050102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "221050103"
            ]
          },
          "221050103": {
            "id": "221050103",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Something about this area just unsettles me. I can't quite explain it.",
            "nextDialogs": [
              "221050104"
            ]
          },
          "221050104": {
            "id": "221050104",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "It doesn't help that all our guests seem to be the hypervigilant types too...",
            "nextDialogs": [
              "221050105"
            ]
          },
          "221050105": {
            "id": "221050105",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "If there's the slightest disturbance, we end up with broken windows and doors, sometimes broken floorboards too.",
            "nextDialogs": [
              "221050106"
            ]
          },
          "221050106": {
            "id": "221050106",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Thankfully the guests do sort the repairs out themselves. But these piecemeal repairs have left us with an assortment of different bits and pieces that don't go together, and it just looks horrendous.",
            "nextDialogs": [
              "221050107"
            ]
          },
          "221050107": {
            "id": "221050107",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Could you take a look around outside the inn? If you find anything untoward, just... sort it out. I need to look after the guests.",
            "nextDialogs": [
              "221050110",
              "221050111"
            ]
          },
          "221050110": {
            "id": "221050110",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Thank you."
          },
          "221050111": {
            "id": "221050111",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Oh come on, they're not that bad! They're just used to being in survival mode out in the wilderness. You can't blame them for being on high alert.",
            "nextDialogs": [
              "221050112"
            ]
          },
          "221050112": {
            "id": "221050112",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Please, just take a look around the vicinity. I'm sure you won't encounter anything too disastrous."
          }
        }
      }
    },
    {

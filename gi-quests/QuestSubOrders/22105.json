            "speakerName": "Verr Goldet",
            "text": "All done?",
            "nextDialogs": [
              "221050202"
            ]
          },
          "221050202": {
            "id": "221050202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet.",
            "nextDialogs": [
              "221050203"
            ]
          },
          "221050203": {
            "id": "221050203",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Don't take too long. The guests are more likely to overreact to any disturbances once night sets in."
          }
        }
      }
    },

            ]
          },
          "221050302": {
            "id": "221050302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes.",
            "nextDialogs": [
              "221050303"
            ]
          },
          "221050303": {
            "id": "221050303",
            "speakerId": 2208,
            "speakerName": "Verr Goldet",
            "text": "Wonderful. Tonight will be a peaceful night.",
            "nextDialogs": [
              "221050304"
            ]
          },
          "221050304": {
            "id": "221050304",
            "speakerId": 2208,

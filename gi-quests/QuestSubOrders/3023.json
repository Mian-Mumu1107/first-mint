  "subQuests": [
    {
      "subId": "302301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30230101"
        ],
        "dialogs": {
          "30230101": {
            "id": "30230101",
            "speakerId": 1058,
            "speakerName": "Cyno",
            "text": "...In the past, I never imagined that even the gods could suffer from hardship.",
            "nextDialogs": [
              "30230102"
            ]
          },
          "30230102": {
            "id": "30230102",
            "speakerId": 1058,
            "speakerName": "Cyno",
            "text": "If we can find a way to change all of this... will this nation become a better place?"
          }
        }
      }
    },
    {
      "subId": "302302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30230201"
        ],
        "dialogs": {
          "30230201": {
            "id": "30230201",
            "speakerId": 1053,
            "speakerName": "Alhaitham",
            "text": "Don't rush. This is a big undertaking, and the planning and preparation for what lies ahead will no doubt take some time.",
            "nextDialogs": [
              "30230202"
            ]
          },
          "30230202": {
            "id": "30230202",
            "speakerId": 1053,
            "speakerName": "Alhaitham",
            "text": "Take it slowly. We need to make sure the plan is as effective as possible.",
            "nextDialogs": [
              "30230203"
            ]
          },
          "30230203": {
            "id": "30230203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He's starting to read his book again! Hey! Are you even listening?",
            "nextDialogs": [
              "30230204"
            ]
          },
          "30230204": {
            "id": "30230204",
            "speakerId": 1053,
            "speakerName": "Alhaitham",
            "text": "Would you like me to lend you something to read?",
            "nextDialogs": [
              "30230205"
            ]
          },
          "30230205": {
            "id": "30230205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No way! Your books aren't quite to Paimon's taste...",
            "nextDialogs": [
              "30230206"
            ]
          },
          "30230206": {
            "id": "30230206",
            "speakerId": 1053,
            "speakerName": "Alhaitham",
            "text": "I was joking. I know my books are far too difficult for you, and I have no intention of lending them out.",
            "nextDialogs": [
              "30230207"
            ]
          },
          "30230207": {
            "id": "30230207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh! You're so annoying..."
          }
        }
      }
    },
    {
      "subId": "302303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30230301"
        ],
        "dialogs": {
          "30230301": {
            "id": "30230301",
            "speakerId": 1059,
            "speakerName": "Candace",
            "text": "You must let me know if there's anything I can do to help.",
            "nextDialogs": [
              "30230302"
            ]
          },
          "30230302": {
            "id": "30230302",
            "speakerId": 1059,
            "speakerName": "Candace",
            "text": "Though I cannot leave Aaru Village, I can't help but feel... stirred when I see the looks in your eyes.",
            "nextDialogs": [
              "30230303"
            ]
          },
          "30230303": {
            "id": "30230303",
            "speakerId": 1059,
            "speakerName": "Candace",
            "text": "I've never felt as roused as this when fighting alone in the past...",
            "nextDialogs": [
              "30230304"
            ]
          },
          "30230304": {
            "id": "30230304",
            "speakerId": 1059,
            "speakerName": "Candace",
            "text": "I suppose this must be the power of camaraderie."
          }
        }
      }
    },
    {
      "subId": "302304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30230401"
        ],
        "dialogs": {
          "30230401": {
            "id": "30230401",
            "speakerId": 1052,
            "speakerName": "Dehya",
            "text": "The past few days have been some of the most challenging work I've ever taken on.",
            "nextDialogs": [
              "30230402"
            ]
          },
          "30230402": {
            "id": "30230402",
            "speakerId": 1052,
            "speakerName": "Dehya",
            "text": "And none of it will earn me a single Mora... I can't believe it...",
            "nextDialogs": [
              "30230403"
            ]
          },
          "30230403": {
            "id": "30230403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look on the bright side, Dehya! Maybe we'll get a huuuge reward after this is all over!",
            "nextDialogs": [
              "30230404"
            ]
          },
          "30230404": {
            "id": "30230404",
            "speakerId": 1052,
            "speakerName": "Dehya",
            "text": "Hmm, you've got a point. Hey, what would you do if you woke up tomorrow with more money than you could ever spend?",
            "nextDialogs": [
              "30230405"
            ]
          },
          "30230405": {
            "id": "30230405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon would buy boatloads of tasty snacks!",
            "nextDialogs": [
              "30230406"
            ]
          },
          "30230406": {
            "id": "30230406",
            "speakerId": 1052,
            "speakerName": "Dehya",
            "text": "That's it?",
            "nextDialogs": [
              "30230407"
            ]
          },
          "30230407": {
            "id": "30230407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um... and maybe some tasty drinks as well?",
            "nextDialogs": [
              "30230408"
            ]
          },
          "30230408": {
            "id": "30230408",
            "speakerId": 1052,
            "speakerName": "Dehya",
            "text": "Hahaha, how adorable.",
            "nextDialogs": [
              "30230409"
            ]
          },
          "30230409": {
            "id": "30230409",
            "speakerId": 1052,
            "speakerName": "Dehya",
            "text": "Well, here's to all our indulgent fantasies... If there's a chance they can come true, I'll give it my best shot.",
            "nextDialogs": [
              "30230410"
            ]
          },
          "30230410": {
            "id": "30230410",
            "speakerId": 1052,
            "speakerName": "Dehya",
            "text": "And here's hoping that everything we do from now on will change this world for the better."
          }
        }
      }
    }
  ]
}
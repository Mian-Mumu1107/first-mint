        ],
        "dialogs": {
          "708020301": {
            "id": "708020301",
            "speakerId": 1577,
            "speakerName": "Reckless Pallad",
            "text": "Well, at least this area's safe now. Thanks a lot.",
            "nextDialogs": [
              "708020302"
            ]
          },
          "708020302": {
            "id": "708020302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Joserf...",
            "nextDialogs": [
              "708020303"
            ]
          },
          "708020303": {
            "id": "708020303",
            "speakerId": 1577,
            "speakerName": "Reckless Pallad",
            "text": "Unfortunately, I didn't find anything earlier, either.",
            "nextDialogs": [
              "708020304"
            ]
          },
          "708020304": {
            "id": "708020304",
            "speakerId": 1577,
            "speakerName": "Reckless Pallad",
            "text": "However, since the coast is clear, I'll continue my search now.",
            "nextDialogs": [
              "708020305"
            ]
          },
          "708020305": {
            "id": "708020305",
            "speakerId": 1577,
            "speakerName": "Reckless Pallad",
            "text": "Would you mind helping me make a trip back to inform Mr. Cyrus that I've begun search efforts? Thanks!"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7080201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708020101"
        ],
        "dialogs": {
          "708020101": {
            "id": "708020101",
            "speakerId": 1668,
            "speakerName": "Joel",
            "text": "Will I really find Dad this time...",
            "nextDialogs": [
              "708020102"
            ]
          },
          "708020102": {
            "id": "708020102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Any news about your father?",
            "nextDialogs": [
              "708020103"
            ]
          },
          "708020103": {
            "id": "708020103",
            "speakerId": 1668,
            "speakerName": "Joel",
            "text": "Oh, it's you!",
            "nextDialogs": [
              "708020104"
            ]
          },
          "708020104": {
            "id": "708020104",
            "speakerId": 1668,
            "speakerName": "Joel",
            "text": "Pallad told me that Uncle Cyrus might have found some news about my dad.",
            "nextDialogs": [
              "708020105"
            ]
          },
          "708020105": {
            "id": "708020105",
            "speakerId": 1668,
            "speakerName": "Joel",
            "text": "He can't be sure yet, but according to Pallad, their latest leads seem pretty promising, so they might just find him.",
            "nextDialogs": [
              "708020106"
            ]
          },
          "708020106": {
            "id": "708020106",
            "speakerId": 1668,
            "speakerName": "Joel",
            "text": "I'd love to go up Dragonspine with them, but Uncle Cyrus says that I should stay in the camp, and that they'll tell me once they get more news...",
            "nextDialogs": [
              "708020107"
            ]
          },
          "708020107": {
            "id": "708020107",
            "speakerId": 1668,
            "speakerName": "Joel",
            "text": "Could you help me look for Uncle Cyrus and ask him, please?",
            "nextDialogs": [
              "708020110"
            ]
          },
          "708020110": {
            "id": "708020110",
            "speakerId": 1668,
            "speakerName": "Joel",
            "text": "I... I'm afraid that the news... might be bad...",
            "nextDialogs": [
              "708020111"
            ]
          },
          "708020111": {
            "id": "708020111",
            "speakerId": 1668,
            "speakerName": "Joel",
            "text": "Either way... I'm counting on you!"
          }
        }
      }
    },
    {

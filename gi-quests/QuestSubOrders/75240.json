      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752400101"
        ],
        "dialogs": {
          "752400101": {
            "id": "752400101",
            "speakerId": 6514,
            "speakerName": "Nahuatlalli",
            "text": "Welcome, friend, to the Ayar Heroes' Cup. I'm the organizer.",
            "nextDialogs": [
              "752400102"
            ]
          },
          "752400102": {
            "id": "752400102",
            "speakerId": 6514,
            "speakerName": "Nahuatlalli",
            "text": "Today's the last day of the competition. If you want to claim the crown, you'll need to defeat our top three warriors back to back.",
            "nextDialogs": [
              "752400107"
            ]
          },
          "752400107": {
            "id": "752400107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What is the Ayar Heroes' Cup?",
            "nextDialogs": [
              "752400108"
            ]
          },
          "752400108": {
            "id": "752400108",
            "speakerId": 6514,
            "speakerName": "Nahuatlalli",
            "text": "It's a battle for the glory of Ayar! Use fists, weapons, or any other trick in the book to defeat your opponent!",
            "nextDialogs": [
              "752400109"
            ]
          },
          "752400109": {
            "id": "752400109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And is Ayar a... person, or...?",
            "nextDialogs": [
              "752400110"
            ]
          },
          "752400110": {
            "id": "752400110",
            "speakerId": 6514,
            "speakerName": "Nahuatlalli",
            "text": "My friend, only champions are qualified to ask questions here!",
            "nextDialogs": [
              "752400111"
            ]
          },
          "752400111": {
            "id": "752400111",
            "speakerId": 6514,
            "speakerName": "Nahuatlalli",
            "text": "Get on stage! We'll soon see if you have the strength to earn that respect."
          }
        }
      }
    },
    {

      "dialogue": {
        "startDialogs": [
          "709080101"
        ],
        "dialogs": {
          "709080101": {
            "id": "709080101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Surely it isn't as simple as that...",
            "nextDialogs": [
              "709080102"
            ]
          },
          "709080102": {
            "id": "709080102",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "Hmph. Sharp people always make enemies of others.",
            "nextDialogs": [
              "709080103"
            ]
          },
          "709080103": {
            "id": "709080103",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "Some people were born in the sun, and thus take light and warmth for granted.",
            "nextDialogs": [
              "709080104"
            ]
          },
          "709080104": {
            "id": "709080104",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "But love, piety, holiness... all these wonderful things were built on the blood and tears of sinners.",
            "nextDialogs": [
              "709080105"
            ]
          },
          "709080105": {
            "id": "709080105",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "Can you all not see it, or do you just look away?",
            "nextDialogs": [
              "709080106"
            ]
          },
          "709080106": {
            "id": "709080106",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "If that's the case, then don't ask or think about it too much. When sin comes knocking, judgment will soon follow.",
            "nextDialogs": [
              "709080107"
            ]
          },
          "709080107": {
            "id": "709080107",
            "speakerId": 1471,
            "speakerName": "Victoria",
            "text": "Take what I've said as a warning. Take this with you, too. I hope it will keep you vigilant."
          }
        }
      }
    }
  ]
}
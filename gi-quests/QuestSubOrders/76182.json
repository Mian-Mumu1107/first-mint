  "subQuests": [
    {
      "subId": "7618201",
      "subQuestName": "Go to the hidden dwelling to start the tea party",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761820101"
        ],
        "dialogs": {
          "761820101": {
            "id": "761820101",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Is this where you used to live? It's pretty.",
            "nextDialogs": [
              "761820102"
            ]
          },
          "761820102": {
            "id": "761820102",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "It used to be even prettier. I have quite a knack for gardening, you know?",
            "nextDialogs": [
              "761820103"
            ]
          },
          "761820103": {
            "id": "761820103",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Haha...",
            "nextDialogs": [
              "761820104"
            ]
          },
          "761820104": {
            "id": "761820104",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "What are you laughing about now...",
            "nextDialogs": [
              "761820105"
            ]
          },
          "761820105": {
            "id": "761820105",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I was just picturing you crouching down, tending to the flowers. It's an adorable image.",
            "nextDialogs": [
              "761820106"
            ]
          },
          "761820106": {
            "id": "761820106",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Can I take a look inside?",
            "nextDialogs": [
              "761820107"
            ]
          },
          "761820107": {
            "id": "761820107",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Of course. I've already cleaned and dusted.",
            "nextDialogs": [
              "761820108"
            ]
          },
          "761820108": {
            "id": "761820108",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "What are you going to do with the place?",
            "nextDialogs": [
              "761820109"
            ]
          },
          "761820109": {
            "id": "761820109",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Hmm... I think I still want to hold onto it. I can come back and tidy up whenever I have the time.",
            "nextDialogs": [
              "761820110"
            ]
          },
          "761820110": {
            "id": "761820110",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "If you're busy, I can help take care of it for you.",
            "nextDialogs": [
              "761820111"
            ]
          },
          "761820111": {
            "id": "761820111",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "It gives me the same feeling your old room used to. It's comforting... A happy place.",
            "nextDialogs": [
              "761820112"
            ]
          },
          "761820112": {
            "id": "761820112",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "Hmph... Suit yourself."
          }
        }
      }
    },
    {
      "subId": "7618202",

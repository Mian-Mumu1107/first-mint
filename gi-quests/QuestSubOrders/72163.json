  "subQuests": [
    {
      "subId": "7216310",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721630401"
        ],
        "dialogs": {
          "721630401": {
            "id": "721630401",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "You're back. How's it going? Did you manage to get those pictures?",
            "nextDialogs": [
              "721630402"
            ]
          },
          "721630402": {
            "id": "721630402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Of course.",
            "nextDialogs": [
              "721630403"
            ]
          },
          "721630403": {
            "id": "721630403",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "Wonderful. Please, let me see them...",
            "nextDialogs": [
              "721630404"
            ]
          },
          "721630404": {
            "id": "721630404",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "Um... Well...",
            "nextDialogs": [
              "721630405"
            ]
          },
          "721630405": {
            "id": "721630405",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "Ahaha! I can't tell where these places are at all...",
            "nextDialogs": [
              "721630406"
            ]
          },
          "721630406": {
            "id": "721630406",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "It does seem that those three locations have changed a lot since our family left.",
            "nextDialogs": [
              "721630407"
            ]
          },
          "721630407": {
            "id": "721630407",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "I wonder if Miss Fujiwara Toshiko will be able to recognize them.",
            "nextDialogs": [
              "721630408"
            ]
          },
          "721630408": {
            "id": "721630408",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "Well, actually... I doubt it.",
            "nextDialogs": [
              "721630409"
            ]
          },
          "721630409": {
            "id": "721630409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She's also from Seirai Island?",
            "nextDialogs": [
              "721630410"
            ]
          },
          "721630410": {
            "id": "721630410",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "More accurately, she's in the same boat as me — our ancestors both lived there.",
            "nextDialogs": [
              "721630411"
            ]
          },
          "721630411": {
            "id": "721630411",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "Actually, there's a lot of us here in Inazuma City whose ancestors were once natives of the island, you know?",
            "nextDialogs": [
              "721630412"
            ]
          },
          "721630412": {
            "id": "721630412",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So why did you all move away?",
            "nextDialogs": [
              "721630413"
            ]
          },
          "721630413": {
            "id": "721630413",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "I don't really remember anymore... It was a very long time ago.",
            "nextDialogs": [
              "721630414"
            ]
          },
          "721630414": {
            "id": "721630414",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "I think it might have been the crazy storms, or to prevent smuggling and illegal border crossings...",
            "nextDialogs": [
              "721630415"
            ]
          },
          "721630415": {
            "id": "721630415",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "Whatever the case, the Shogunate arranged for the inhabitants of the island to come to Narukami Island.",
            "nextDialogs": [
              "721630416"
            ]
          },
          "721630416": {
            "id": "721630416",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "Well, that's neither here nor there. This is for you. Take it as thanks for running this errand for me.",
            "nextDialogs": [
              "721630417"
            ]
          },
          "721630417": {
            "id": "721630417",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "*sigh* Ah, I do wish that I could go to Seirai Island in person sometime...",
            "nextDialogs": [
              "721630418"
            ]
          },
          "721630418": {
            "id": "721630418",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "But I've got all this business to take care of..."
          }
        }
      }
    },
    {
      "subId": "7216312",
      "subQuestName": "Ask the adventurers some questions",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721630201"
        ],
        "dialogs": {
          "721630201": {
            "id": "721630201",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "Hmm, this is quite the headache...",
            "nextDialogs": [
              "721630202"
            ]
          },
          "721630202": {
            "id": "721630202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Would you know anything about this map...",
            "nextDialogs": [
              "721630203"
            ]
          },
          "721630203": {
            "id": "721630203",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "Judging by the topography, I'd say that this is some place on Seirai Island...",
            "nextDialogs": [
              "721630204"
            ]
          },
          "721630204": {
            "id": "721630204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How could you tell?",
            "nextDialogs": [
              "721630205"
            ]
          },
          "721630205": {
            "id": "721630205",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "The Guild has commissioned several expeditions to Seirai Island in the past.",
            "nextDialogs": [
              "721630206"
            ]
          },
          "721630206": {
            "id": "721630206",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "The adventurers who accepted those commissions would bring us intel on the island in the form of reports.",
            "nextDialogs": [
              "721630207"
            ]
          },
          "721630207": {
            "id": "721630207",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "Unfortunately, manpower issues have prevented us from launching large-scale expeditions, so we're stuck sending a few adventurers at a time to explore the area.",
            "nextDialogs": [
              "721630208"
            ]
          },
          "721630208": {
            "id": "721630208",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "I'm afraid that this limits the extent to which I can continue helping you to analyze this map.",
            "nextDialogs": [
              "721630209"
            ]
          },
          "721630209": {
            "id": "721630209",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "However, I do know someone who might have more to do with Seirai Island than me.",
            "nextDialogs": [
              "721630210"
            ]
          },
          "721630210": {
            "id": "721630210",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "His name's Oda Tarou. I've heard that his ancestors used to live on Seirai Island before migrating here for various reasons.",
            "nextDialogs": [
              "721630211"
            ]
          },
          "721630211": {
            "id": "721630211",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "Speaking of which, he did come to the Guild some time back to hire some adventurers who would accompany him to Seirai Island to see the place...",
            "nextDialogs": [
              "721630212"
            ]
          },
          "721630212": {
            "id": "721630212",
            "speakerId": 3005,
            "speakerName": "Furuya Noboru",
            "text": "You can ask him about this map. With any luck, he might know something about it."
          }
        }
      }
    },
    {
      "subId": "7216302",
      "subQuestName": "Ask Oda Tarou some questions",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

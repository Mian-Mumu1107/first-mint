        ],
        "dialogs": {
          "721630301": {
            "id": "721630301",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "*sigh* When will I find someone who'll accompany me back there...",
            "nextDialogs": [
              "721630302"
            ]
          },
          "721630302": {
            "id": "721630302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Would you know anything about this map...",
            "nextDialogs": [
              "721630303"
            ]
          },
          "721630303": {
            "id": "721630303",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "Are you... an adventurer with the Guild? Can they finally spare the people?",
            "nextDialogs": [
              "721630304"
            ]
          },
          "721630304": {
            "id": "721630304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh, I'm just a passing traveler.",
            "nextDialogs": [
              "721630305"
            ]
          },
          "721630305": {
            "id": "721630305",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "Hmm, fine, then... What's this map you spoke of?",
            "nextDialogs": [
              "721630306"
            ]
          },
          "721630306": {
            "id": "721630306",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "Now, let me see...",
            "nextDialogs": [
              "721630307"
            ]
          },
          "721630307": {
            "id": "721630307",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "Th—This! Could it be...",
            "nextDialogs": [
              "721630310"
            ]
          },
          "721630310": {
            "id": "721630310",
            "speakerId": 3062,
            "speakerName": "Oda Tarou",
            "text": "Isn't this Seirai Island!?"
          }
        }
      }
    },

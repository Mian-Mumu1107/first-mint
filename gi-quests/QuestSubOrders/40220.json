    {
      "subId": "4022011",
      "subQuestName": "Pass the baton to Minnie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402201101"
        ],
        "dialogs": {
          "402201101": {
            "id": "402201101",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "Minnie! You take it from here. I'll be right behind you!",
            "nextDialogs": [
              "402201102"
            ]
          },
          "402201102": {
            "id": "402201102",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "Alright, here goes nothing!"
          }
        }
      }
    },
    {
      "subId": "4022017",
      "subQuestName": "Follow Minnie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402201701"
        ],
        "dialogs": {
          "402201701": {
            "id": "402201701",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "Monsters! At least they're not on the course... Better steer clear.",
            "nextDialogs": [
              "402201702"
            ]
          },
          "402201702": {
            "id": "402201702",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "Oh, everyone's waiting for me by the side of the course... I'm coming, guys!",
            "nextDialogs": [
              "402201703"
            ]
          },
          "402201703": {
            "id": "402201703",
            "speakerId": 1012,
            "speakerName": "Inazuman Contestant",
            "text": "...I can't do it... I'm out of steam. Ugh, I can barely see... Wait, is this the right way?",
            "nextDialogs": [
              "402201704"
            ]
          },
          "402201704": {
            "id": "402201704",
            "speakerId": 1012,
            "speakerName": "Inazuman Contestant",
            "text": "Shoot, I've gone off-course!",
            "nextDialogs": [
              "402201705"
            ]
          },
          "402201705": {
            "id": "402201705",
            "speakerId": 1012,
            "speakerName": "Inazuman Contestant",
            "text": "No no no, stay back...",
            "nextDialogs": [
              "402201706"
            ]
          },
          "402201706": {
            "id": "402201706",
            "speakerId": 1004,
            "speakerName": "Xilonen",
            "text": "Oh... Uh oh!",
            "nextDialogs": [
              "402201707"
            ]
          },
          "402201707": {
            "id": "402201707",
            "speakerId": 1013,
            "speakerName": "Confused Inazuman Contestant",
            "text": "...Help!",
            "nextDialogs": [
              "402201708"
            ]
          },
          "402201708": {
            "id": "402201708",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "It's fine... I'll keep going... I gotta get a good ranking.",
            "nextDialogs": [
              "402201709"
            ]
          },
          "402201709": {
            "id": "402201709",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "I don't wanna drag the team down.",
            "nextDialogs": [
              "402201710"
            ]
          },
          "402201710": {
            "id": "402201710",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "I believe in you, Minnie.",
            "nextDialogs": [
              "402201711"
            ]
          },
          "402201711": {
            "id": "402201711",
            "speakerId": 1004,
            "speakerName": "Xilonen",
            "text": "I do too.",
            "nextDialogs": [
              "402201712"
            ]
          },
          "402201712": {
            "id": "402201712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let me help you.",
            "nextDialogs": [
              "402201713"
            ]
          },
          "402201713": {
            "id": "402201713",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "...I know I should keep going, but I'm sorry — I can't ignore this.",
            "nextDialogs": [
              "402201714"
            ]
          },
          "402201714": {
            "id": "402201714",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "Quick, over here!",
            "nextDialogs": [
              "402201715"
            ]
          },
          "402201715": {
            "id": "402201715",
            "speakerId": 1004,
            "speakerName": "Xilonen",
            "text": "#Someone's injured... We have to help them. Varesa! {NICKNAME}!",
            "nextDialogs": [
              "402201716"
            ]
          },
          "402201716": {
            "id": "402201716",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "On it!",
            "nextDialogs": [
              "402201717"
            ]
          },
          "402201717": {
            "id": "402201717",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "Minnie, get the injured person to the finish line. We'll handle the rest."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "4022001",
      "subQuestName": "Wait until 08:00 the following day",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402200101"
        ],
        "dialogs": {
          "402200101": {
            "id": "402200101",
            "speakerId": 1000,
            "speakerName": "Alrani",
            "text": "Don't blame yourself, Minnie. It's not your fault.",
            "nextDialogs": [
              "402200102"
            ]
          },
          "402200102": {
            "id": "402200102",
            "speakerId": 1001,
            "speakerName": "Tang Yigang",
            "text": "You did great, Minnie... *cough*",
            "nextDialogs": [
              "402200103"
            ]
          },
          "402200103": {
            "id": "402200103",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "Oh, Yigang... Don't force yourself to speak if you're not up to it. Honestly, I'm amazed you even made it here to watch.",
            "nextDialogs": [
              "402200106"
            ]
          },
          "402200106": {
            "id": "402200106",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, uh...",
            "nextDialogs": [
              "402200107"
            ]
          },
          "402200107": {
            "id": "402200107",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "It's okay, I'll explain. I'm really sorry, Honorary Knight, but by the time I got that wounded guy to the finish line, all the other teams had finished the race.",
            "nextDialogs": [
              "402200108"
            ]
          },
          "402200108": {
            "id": "402200108",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "The staff have taken him to get checked out, so I think he'll be okay. But... we didn't get the results we wanted. I'm sorry.",
            "nextDialogs": [
              "402200109"
            ]
          },
          "402200109": {
            "id": "402200109",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "You guys were leading the whole way, and I went and let the team down...",
            "nextDialogs": [
              "402200110"
            ]
          },
          "402200110": {
            "id": "402200110",
            "speakerId": 1004,
            "speakerName": "Xilonen",
            "text": "Oh, Minnie...",
            "nextDialogs": [
              "402200111"
            ]
          },
          "402200111": {
            "id": "402200111",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "When I first saw that guy in trouble, I hesitated for a moment.",
            "nextDialogs": [
              "402200112"
            ]
          },
          "402200112": {
            "id": "402200112",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "Everyone's worked so hard to get here. If I hadn't gone back to help him, we would've actually gotten a decent ranking...",
            "nextDialogs": [
              "402200113"
            ]
          },
          "402200113": {
            "id": "402200113",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "Amber and the emergency staff were nearby, and you guys weren't far away either. It's not like he would have been in life-threatening danger if I'd carried on...",
            "nextDialogs": [
              "402200114"
            ]
          },
          "402200114": {
            "id": "402200114",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "But I just couldn't tear myself away.",
            "nextDialogs": [
              "402200115"
            ]
          },
          "402200115": {
            "id": "402200115",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "It's okay, Minnie. We understand.",
            "nextDialogs": [
              "402200116"
            ]
          },
          "402200116": {
            "id": "402200116",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "How could any of us turn a blind eye to a person in need?",
            "nextDialogs": [
              "402200117"
            ]
          },
          "402200117": {
            "id": "402200117",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "\"Wherever the Soulblazer treads, help is always at hand.\"",
            "nextDialogs": [
              "402200118"
            ]
          },
          "402200118": {
            "id": "402200118",
            "speakerId": 1000,
            "speakerName": "Alrani",
            "text": "...Wait, where's that line from?",
            "nextDialogs": [
              "402200119"
            ]
          },
          "402200119": {
            "id": "402200119",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "My... brain? Just came up with it on the spot. Hehe...",
            "nextDialogs": [
              "402200120"
            ]
          },
          "402200120": {
            "id": "402200120",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "...Thanks, Captain.",
            "nextDialogs": [
              "402200121"
            ]
          },
          "402200121": {
            "id": "402200121",
            "speakerId": 1006,
            "speakerName": "Sherilyn",
            "text": "Minnie!",
            "nextDialogs": [
              "402200122"
            ]
          },
          "402200122": {
            "id": "402200122",
            "speakerId": 1006,
            "speakerName": "Sherilyn",
            "text": "Thank goodness you're okay. I was so worried.",
            "nextDialogs": [
              "402200123"
            ]
          },
          "402200123": {
            "id": "402200123",
            "speakerId": 1007,
            "speakerName": "Moritz",
            "text": "Minnie, you could've put your life at risk...",
            "nextDialogs": [
              "402200124"
            ]
          },
          "402200124": {
            "id": "402200124",
            "speakerId": 1006,
            "speakerName": "Sherilyn",
            "text": "Please, don't ever scare us like that again.",
            "nextDialogs": [
              "402200125"
            ]
          },
          "402200125": {
            "id": "402200125",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "I'm sorry...",
            "nextDialogs": [
              "402200126"
            ]
          },
          "402200126": {
            "id": "402200126",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "A minor incident ended up dashing your hopes of victory. It sucks... but that's life sometimes: You bust a gut and still end up with nothing to show for it.",
            "nextDialogs": [
              "402200127"
            ]
          },
          "402200127": {
            "id": "402200127",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "But nothing is wasted. Everyone had fun along the way, and seeds planted today may still bear fruit tomorrow.\\nMinnie still looks a little frustrated, but she'll get through it.",
            "nextDialogs": [
              "402200128"
            ]
          },
          "402200128": {
            "id": "402200128",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "Minnie, are you alright? Are you hurt at all?",
            "nextDialogs": [
              "402200129"
            ]
          },
          "402200129": {
            "id": "402200129",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "Oh, hi ref. No, I'm not hurt. I'm all good.",
            "nextDialogs": [
              "402200130"
            ]
          },
          "402200130": {
            "id": "402200130",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "...It's you...",
            "nextDialogs": [
              "402200131"
            ]
          },
          "402200131": {
            "id": "402200131",
            "speakerId": 1010,
            "speakerName": "Kenzou",
            "text": "Hello. I'm Kenzou, from team Lightning Strike. Because of your help, I escaped with no major injuries. I can't thank you enough.",
            "nextDialogs": [
              "402200132"
            ]
          },
          "402200132": {
            "id": "402200132",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "Team Lightning Strike has had a discussion with the organizing committee.",
            "nextDialogs": [
              "402200133"
            ]
          },
          "402200133": {
            "id": "402200133",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "Minnie's actions in helping her fellow contestant are commendable. The organizing committee are all in agreement that were it not for this incident, team Soulblazers would have ranked much higher in the race.",
            "nextDialogs": [
              "402200134"
            ]
          },
          "402200134": {
            "id": "402200134",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "As things stand, team Soulblazers did not rank highly enough to receive medals. However, we believe that you still deserve recognition for your performance.",
            "nextDialogs": [
              "402200135"
            ]
          },
          "402200135": {
            "id": "402200135",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "Therefore, in addition to the medals for winners and runners-up, the organizing committee has decided to issue a special honorary medal to your team, recognizing your commitment to putting lives first.",
            "nextDialogs": [
              "402200136"
            ]
          },
          "402200136": {
            "id": "402200136",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "Thank you, Mr. Draff. Mom, Dad... I know what you're gonna say. A deal's a deal, I won't fight it...",
            "nextDialogs": [
              "402200137"
            ]
          },
          "402200137": {
            "id": "402200137",
            "speakerId": 1007,
            "speakerName": "Moritz",
            "text": "Very well. Then, we'll stick to what we all agreed. From now on, Minnie...",
            "nextDialogs": [
              "402200138"
            ]
          },
          "402200138": {
            "id": "402200138",
            "speakerId": 1007,
            "speakerName": "Moritz",
            "text": "...As long as you promise to be careful, you are free to go traveling abroad.",
            "nextDialogs": [
              "402200139"
            ]
          },
          "402200139": {
            "id": "402200139",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "...What? But Dad, I thought...",
            "nextDialogs": [
              "402200140"
            ]
          },
          "402200140": {
            "id": "402200140",
            "speakerId": 1007,
            "speakerName": "Moritz",
            "text": "You achieved what you set out to do — you got ranked in the competition. Maybe it wasn't the ranking you hoped for, but it's enough for me.",
            "nextDialogs": [
              "402200141"
            ]
          },
          "402200141": {
            "id": "402200141",
            "speakerId": 1006,
            "speakerName": "Sherilyn",
            "text": "Hehe, and for me. Look, you even have a medal to prove it.",
            "nextDialogs": [
              "402200142"
            ]
          },
          "402200142": {
            "id": "402200142",
            "speakerId": 1007,
            "speakerName": "Moritz",
            "text": "You know, maybe we should turn this into a family vacation. Yes... Let's all go and visit Yae Publishing House together.",
            "nextDialogs": [
              "402200143"
            ]
          },
          "402200143": {
            "id": "402200143",
            "speakerId": 1007,
            "speakerName": "Moritz",
            "text": "After hearing so much about your favorite comic books, I'd love to find out if they have anything suitable for older folks like me and your mother.",
            "nextDialogs": [
              "402200144"
            ]
          },
          "402200144": {
            "id": "402200144",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "Amazing! Hey, Minnie, this is a great start!",
            "nextDialogs": [
              "402200145"
            ]
          },
          "402200145": {
            "id": "402200145",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "You have no idea how happy this makes me...",
            "nextDialogs": [
              "402200146"
            ]
          },
          "402200146": {
            "id": "402200146",
            "speakerId": 1000,
            "speakerName": "Alrani",
            "text": "This is a moment to remember. I think it calls for a photograph!",
            "nextDialogs": [
              "402200147"
            ]
          },
          "402200147": {
            "id": "402200147",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "Good call. Alright, group photo!",
            "nextDialogs": [
              "402200148"
            ]
          },
          "402200148": {
            "id": "402200148",
            "speakerId": 1000,
            "speakerName": "Alrani",
            "text": "Let's pose like Fietena and Mavuika! From volume 2, where they go into battle together for the first time."
          }
        }
      }
    },
    {
      "subId": "4022002",
      "subQuestName": "Head to the cross-country race arena",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402200201"
        ],
        "dialogs": {
          "402200201": {
            "id": "402200201",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "The cross country contest is about to begin. So many people have shown up... How's everyone doing? Feeling ready?",
            "nextDialogs": [
              "402200202"
            ]
          },
          "402200202": {
            "id": "402200202",
            "speakerId": 1000,
            "speakerName": "Alrani",
            "text": "Towels, hot soup, warm blankets... Yeah, I think I'm all set.",
            "nextDialogs": [
              "402200203"
            ]
          },
          "402200203": {
            "id": "402200203",
            "speakerId": 1000,
            "speakerName": "Alrani",
            "text": "Captain is taking the team through a warm-up as planned.",
            "nextDialogs": [
              "402200204"
            ]
          },
          "402200204": {
            "id": "402200204",
            "speakerId": 1000,
            "speakerName": "Alrani",
            "text": "Once the race starts, I'll go wait at the finish line to hand out water and blankets to the contestants.",
            "nextDialogs": [
              "402200205"
            ]
          },
          "402200205": {
            "id": "402200205",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "I got here a little late 'cause I was coming from home. Are they still warming up? The race is gonna start any minute...",
            "nextDialogs": [
              "402200206"
            ]
          },
          "402200206": {
            "id": "402200206",
            "speakerId": 1000,
            "speakerName": "Alrani",
            "text": "Yeah, I wonder what's taking them so long...",
            "nextDialogs": [
              "402200207"
            ]
          },
          "402200207": {
            "id": "402200207",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Oh, it's not like Varesa and Xilonen to be behind schedule... Okay, we'll go check on them.",
            "nextDialogs": [
              "402200208"
            ]
          },
          "402200208": {
            "id": "402200208",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "Thanks, guys."
          }
        }
      }
    },
    {
      "subId": "4022016",
      "subQuestName": "Go to the Soulblazers' camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402201601"
        ],
        "dialogs": {
          "402201601": {
            "id": "402201601",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Hey, they've finally emerged from the tent.",
            "nextDialogs": [
              "402201602"
            ]
          },
          "402201602": {
            "id": "402201602",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Guys, what's wrong? You all look so serious...",
            "nextDialogs": [
              "402201603"
            ]
          },
          "402201603": {
            "id": "402201603",
            "speakerId": 1004,
            "speakerName": "Xilonen",
            "text": "It's Yigang. He's come down with a fever.",
            "nextDialogs": [
              "402201604"
            ]
          },
          "402201604": {
            "id": "402201604",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "*sigh*... I wish I'd acted sooner... I've been checking in with him constantly since he started sneezing, and he said he was fine, but still. I should've known better.",
            "nextDialogs": [
              "402201605"
            ]
          },
          "402201605": {
            "id": "402201605",
            "speakerId": 1004,
            "speakerName": "Xilonen",
            "text": "He probably hoped he could tough it out until the end of the competition. But now it's broken into a full-blown fever. He doesn't even have the energy to get out of bed.",
            "nextDialogs": [
              "402201606"
            ]
          },
          "402201606": {
            "id": "402201606",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "We've been in touch with the organizing committee, and they're making sure he stays warm and takes his medication. They actually sent a medic to look after him, so he's in good hands.",
            "nextDialogs": [
              "402201607"
            ]
          },
          "402201607": {
            "id": "402201607",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Well, that's good... But what about the race? You're one team member short, and it's about to kick off any minute...",
            "nextDialogs": [
              "402201608"
            ]
          },
          "402201608": {
            "id": "402201608",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "Yeah... What're we gonna do?",
            "nextDialogs": [
              "402201609"
            ]
          },
          "402201609": {
            "id": "402201609",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "This race is a huge deal for all of us. Minnie's parents are already waiting at the finish line... Our only hope now is...",
            "nextDialogs": [
              "402201612"
            ]
          },
          "402201612": {
            "id": "402201612",
            "speakerId": 1004,
            "speakerName": "Xilonen",
            "text": "That was our first thought too. You've trained with us, so you know the course. Plus, you have a good level of fitness and plenty of outdoor experience.",
            "nextDialogs": [
              "402201613"
            ]
          },
          "402201613": {
            "id": "402201613",
            "speakerId": 1004,
            "speakerName": "Xilonen",
            "text": "I don't feel great about roping you in at the last minute, though. There's nothing worse than someone dumping an urgent job on you when you least expect it, and making you feel like you can't turn it down.",
            "nextDialogs": [
              "402201614"
            ]
          },
          "402201614": {
            "id": "402201614",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "We'd love to have you on the team — but only if you're willing."
          }
        }
      }
    },
    {
      "subId": "4022003",
      "subQuestName": "Head to the start of the track",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402200301"
        ],
        "dialogs": {
          "402200301": {
            "id": "402200301",
            "speakerId": 1011,
            "speakerName": "Slumbering Yigang",
            "text": "(The feverish patient lies fast asleep. With the competition drawing near, it's best to head to the arena with the others for now.)"
          }
        }
      }
    },
    {
      "subId": "4022005",
      "subQuestName": "Wait for the contest to start",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402200501"
        ],
        "dialogs": {
          "402200501": {
            "id": "402200501",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "Contestants, spectators, welcome to the Dragonspine International Cross Country Challenge!",
            "nextDialogs": [
              "402200502"
            ]
          },
          "402200502": {
            "id": "402200502",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "My name is Draff, and I'll be serving as referee for today's proceedings by appointment of the organizing committee.",
            "nextDialogs": [
              "402200503"
            ]
          },
          "402200503": {
            "id": "402200503",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "Let me start by saying, I wish all our teams the best of luck, and I look forward to a day of new personal bests, fantastic results — and of course, playing by the rules.",
            "nextDialogs": [
              "402200504"
            ]
          },
          "402200504": {
            "id": "402200504",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "I'm also obliged to remind everyone how important it is to remain within the bounds of the official race zone. The terrain on Dragonspine is hazardous, and the last thing we want is anyone getting injured, or worse.",
            "nextDialogs": [
              "402200505"
            ]
          },
          "402200505": {
            "id": "402200505",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "The organizing committee has taken steps to remove all hazards from the race course, but the rest of the mountain remains a danger zone.",
            "nextDialogs": [
              "402200506"
            ]
          },
          "402200506": {
            "id": "402200506",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "Contestants, if you find yourselves unable to complete the race due to injury, illness, or other reasons, please step to the side of the track. A member of the organizing committee will come to your assistance and deliver first aid if necessary.",
            "nextDialogs": [
              "402200507"
            ]
          },
          "402200507": {
            "id": "402200507",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "Captain, where's Yigang? The race is about to start!",
            "nextDialogs": [
              "402200508"
            ]
          },
          "402200508": {
            "id": "402200508",
            "speakerId": 1004,
            "speakerName": "Xilonen",
            "text": "I'm afraid Yigang came down with a fever. He's sleeping it off at the moment. Sorry, Minnie, he's not gonna be taking part today.",
            "nextDialogs": [
              "402200509"
            ]
          },
          "402200509": {
            "id": "402200509",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "What!? But, that means...",
            "nextDialogs": [
              "402200512"
            ]
          },
          "402200512": {
            "id": "402200512",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "#{NICKNAME} won't let you down, Minnie! {M#He's}{F#She's} a pro at this stuff. Heck, you might even have a shot at first place!",
            "nextDialogs": [
              "402200513"
            ]
          },
          "402200513": {
            "id": "402200513",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "...Okay, got it! Thanks for coming to the rescue!",
            "nextDialogs": [
              "402200514"
            ]
          },
          "402200514": {
            "id": "402200514",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "...And now, it gives me great pleasure to welcome the cross country relay teams:",
            "nextDialogs": [
              "402200515"
            ]
          },
          "402200515": {
            "id": "402200515",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "From Sumeru, The Sand Blasters. From Inazuma, Lightning Strike.",
            "nextDialogs": [
              "402200516"
            ]
          },
          "402200516": {
            "id": "402200516",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "From Liyue, The Sunset Squadron, and from Fontaine, The Frostbite Friends.",
            "nextDialogs": [
              "402200517"
            ]
          },
          "402200517": {
            "id": "402200517",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "Next we have the adventurer contingent, Dragonspine Must Be Scaled. And coming all the way from Springvale, The Mild Hunt.",
            "nextDialogs": [
              "402200518"
            ]
          },
          "402200518": {
            "id": "402200518",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "Last but by no means least, we have a team that brings together contestants from all over Teyvat.... The Soulblazers.",
            "nextDialogs": [
              "402200519"
            ]
          },
          "402200519": {
            "id": "402200519",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Looks like we've got some pretty strong competition.",
            "nextDialogs": [
              "402200520"
            ]
          },
          "402200520": {
            "id": "402200520",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "Don't panic! There's no need to be nervous. Think about Fietena. It's time to show our courage!",
            "nextDialogs": [
              "402200521"
            ]
          },
          "402200521": {
            "id": "402200521",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "Together, there's no obstacle we can't overcome! ...And if there is, just charge right on through!",
            "nextDialogs": [
              "402200522"
            ]
          },
          "402200522": {
            "id": "402200522",
            "speakerId": 1004,
            "speakerName": "Xilonen",
            "text": "I'm not sure that's an option for everyone else... Uhh, okay, fine, yeah, charge it is. I'm not gonna nitpick your motivational speech.",
            "nextDialogs": [
              "402200523"
            ]
          },
          "402200523": {
            "id": "402200523",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll show you how it's done.",
            "nextDialogs": [
              "402200524"
            ]
          },
          "402200524": {
            "id": "402200524",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "I'm gonna give it my all! I believe in our team, and I believe in me!",
            "nextDialogs": [
              "402200525"
            ]
          },
          "402200525": {
            "id": "402200525",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "Will all contestants please proceed to your starting positions.",
            "nextDialogs": [
              "402200526"
            ]
          },
          "402200526": {
            "id": "402200526",
            "speakerId": 1009,
            "speakerName": "Draff",
            "text": "Ready... Go!"
          }
        }
      }
    },

    {
      "subId": "4022012",
      "subQuestName": "Return to the camp with your companions",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402201201"
        ],
        "dialogs": {
          "402201201": {
            "id": "402201201",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "Well, we weren't the winning team or the runners-up, but one way or another, we still came away with medals!",
            "nextDialogs": [
              "402201202"
            ]
          },
          "402201202": {
            "id": "402201202",
            "speakerId": 1001,
            "speakerName": "Tang Yigang",
            "text": "I'm sorry... *coughing*... I picked the worst time to get sick, didn't I...",
            "nextDialogs": [
              "402201203"
            ]
          },
          "402201203": {
            "id": "402201203",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "Don't even think about that, Yigang. Just focus on getting better.",
            "nextDialogs": [
              "402201204"
            ]
          },
          "402201204": {
            "id": "402201204",
            "speakerId": 1000,
            "speakerName": "Alrani",
            "text": "It's a shame we didn't all get to compete together, but at least we got a group photo.",
            "nextDialogs": [
              "402201205"
            ]
          },
          "402201205": {
            "id": "402201205",
            "speakerId": 1004,
            "speakerName": "Xilonen",
            "text": "If anyone has regrets, I say we come back next time and go for gold.",
            "nextDialogs": [
              "402201206"
            ]
          },
          "402201206": {
            "id": "402201206",
            "speakerId": 1001,
            "speakerName": "Tang Yigang",
            "text": "I'll be back... *cough*",
            "nextDialogs": [
              "402201207"
            ]
          },
          "402201207": {
            "id": "402201207",
            "speakerId": 1000,
            "speakerName": "Alrani",
            "text": "Take it easy, Yigang. Next time, you can start by not getting ill.",
            "nextDialogs": [
              "402201208"
            ]
          },
          "402201208": {
            "id": "402201208",
            "speakerId": 1000,
            "speakerName": "Alrani",
            "text": "Captain, I think I'll join you for training next time just in case. That way, I can fill in if someone has to drop out at the last minute.",
            "nextDialogs": [
              "402201209"
            ]
          },
          "402201209": {
            "id": "402201209",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "It's decided then. The Soulblazers will return for the next cross country challenge!",
            "nextDialogs": [
              "402201210"
            ]
          },
          "402201210": {
            "id": "402201210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll be there.",
            "nextDialogs": [
              "402201211"
            ]
          },
          "402201211": {
            "id": "402201211",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "It's a deal."
          }
        }
      }
    },
    {
      "subId": "4022099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402209901"
        ],
        "dialogs": {
          "402209901": {
            "id": "402209901",
            "speakerId": 1004,
            "speakerName": "Xilonen",
            "text": "Yikes, it's even colder today... Just my luck.",
            "nextDialogs": [
              "402209902"
            ]
          },
          "402209902": {
            "id": "402209902",
            "speakerId": 1004,
            "speakerName": "Xilonen",
            "text": "#{NICKNAME}'s up ahead. Time to pass on the baton.",
            "nextDialogs": [
              "402209903"
            ]
          },
          "402209903": {
            "id": "402209903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "My section is uphill all the way. I gotta remember to pace myself.",
            "nextDialogs": [
              "402209905"
            ]
          },
          "402209905": {
            "id": "402209905",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "No time for a detour. Just gonna jump on down through the gap.",
            "nextDialogs": [
              "402209907"
            ]
          },
          "402209907": {
            "id": "402209907",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "...Around the tree, then straight ahead... We're making good time.",
            "nextDialogs": [
              "402209908"
            ]
          },
          "402209908": {
            "id": "402209908",
            "speakerId": 1002,
            "speakerName": "Minnie",
            "text": "Come on, Minnie. You can do this.",
            "nextDialogs": [
              "402209911"
            ]
          },
          "402209911": {
            "id": "402209911",
            "speakerId": 1014,
            "speakerName": "Amber",
            "text": "What happened? Someone got injured?",
            "nextDialogs": [
              "402209912"
            ]
          },
          "402209912": {
            "id": "402209912",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "Amber, we got a situation!",
            "nextDialogs": [
              "402209913"
            ]
          },
          "402209913": {
            "id": "402209913",
            "speakerId": 1014,
            "speakerName": "Amber",
            "text": "Roger that. On it!",
            "nextDialogs": [
              "402209914"
            ]
          },
          "402209914": {
            "id": "402209914",
            "speakerId": 1015,
            "speakerName": "Staff Member",
            "text": "...Boost your stamina here...",
            "nextDialogs": [
              "402209915"
            ]
          },
          "402209915": {
            "id": "402209915",
            "speakerId": 1016,
            "speakerName": "NPC#15914",
            "text": "You can do it!",
            "nextDialogs": [
              "402209916"
            ]
          },
          "402209916": {
            "id": "402209916",
            "speakerId": 1017,
            "speakerName": "NPC#15915",
            "text": "Keep going!",
            "nextDialogs": [
              "402209917"
            ]
          },
          "402209917": {
            "id": "402209917",
            "speakerId": 1018,
            "speakerName": "NPC#15916",
            "text": "Yeah, speed demon!",
            "nextDialogs": [
              "402209918"
            ]
          },
          "402209918": {
            "id": "402209918",
            "speakerId": 1019,
            "speakerName": "NPC#15917",
            "text": "You're killing it!",
            "nextDialogs": [
              "402209919"
            ]
          },
          "402209919": {
            "id": "402209919",
            "speakerId": 1020,
            "speakerName": "NPC#15918",
            "text": "Eyes on the road!",
            "nextDialogs": [
              "402209920"
            ]
          },
          "402209920": {
            "id": "402209920",
            "speakerId": 1021,
            "speakerName": "NPC#15919",
            "text": "Yeah! You're almost there!",
            "nextDialogs": [
              "402209921"
            ]
          },
          "402209921": {
            "id": "402209921",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "Unfortunately, you've already fallen a long way behind the leaders.",
            "nextDialogs": [
              "402209922"
            ]
          },
          "402209922": {
            "id": "402209922",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "The gap between you and Minnie is too big."
          }
        }
      }
    }
  ]
}
    {
      "subId": "4022009",
      "subQuestName": "Pass the baton to Varesa",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402200901"
        ],
        "dialogs": {
          "402200901": {
            "id": "402200901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Phew! Varesa, I did it.",
            "nextDialogs": [
              "402200902"
            ]
          },
          "402200902": {
            "id": "402200902",
            "speakerId": 1005,
            "speakerName": "Varesa",
            "text": "Thanks! My time to shine!"
          }

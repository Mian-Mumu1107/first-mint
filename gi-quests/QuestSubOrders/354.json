    {
      "subId": "35402",
      "subQuestName": "Talk to the perky girl",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3540401"
        ],
        "dialogs": {
          "3540401": {
            "id": "3540401",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "May the Anemo God protect you, stranger!",
            "nextDialogs": [
              "3540402"
            ]
          },
          "3540402": {
            "id": "3540402",
            "speakerId": 1001,
            "speakerName": "Amber",
            "text": "I am Amber, Outrider for the Knights of Favonius.",
            "nextDialogs": [
              "3540403"
            ]
          },
          "3540403": {
            "id": "3540403",
            "speakerId": 1001,
            "speakerName": "Amber",
            "text": "You don't look like citizens of Mondstadt. Explain yourselves!",
            "nextDialogs": [
              "3540404"
            ]
          },
          "3540404": {
            "id": "3540404",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "We're not looking for trouble.",
            "nextDialogs": [
              "3540405"
            ]
          },
          "3540405": {
            "id": "3540405",
            "speakerId": 1001,
            "speakerName": "Amber",
            "text": "That's what all the troublemakers say.",
            "nextDialogs": [
              "3540406"
            ]
          },
          "3540406": {
            "id": "3540406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#Hello, I'm {NICKNAME}.",
            "nextDialogs": [
              "3540407"
            ]
          },
          "3540407": {
            "id": "3540407",
            "speakerId": 1001,
            "speakerName": "Amber",
            "text": "...Doesn't sound like a local name to me.",
            "nextDialogs": [
              "3540408"
            ]
          },
          "3540408": {
            "id": "3540408",
            "speakerId": 1001,
            "speakerName": "Amber",
            "text": "And this... mascot, what's the deal with it?",
            "nextDialogs": [
              "3540410",
              "3540413"
            ]
          },
          "3540410": {
            "id": "3540410",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "We've only been traveling partners for two months, but...",
            "nextDialogs": [
              "3540411"
            ]
          },
          "3540411": {
            "id": "3540411",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "We've already become the very best of friends!",
            "nextDialogs": [
              "3540414"
            ]
          },
          "3540414": {
            "id": "3540414",
            "speakerId": 1001,
            "speakerName": "Amber",
            "text": "So to sum it up, you're traveling partners, right?",
            "nextDialogs": [
              "3540415"
            ]
          },
          "3540415": {
            "id": "3540415",
            "speakerId": 1001,
            "speakerName": "Amber",
            "text": "Well look, there's been a large dragon sighted around Mondstadt recently. Best you get inside the city as soon as possible.",
            "nextDialogs": [
              "3540416"
            ]
          },
          "3540416": {
            "id": "3540416",
            "speakerId": 1001,
            "speakerName": "Amber",
            "text": "It's not far from here, I'll escort you there.",
            "nextDialogs": [
              "3540417"
            ]
          },
          "3540417": {
            "id": "3540417",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh? Aren't you out here for some other reason?",
            "nextDialogs": [
              "3540418"
            ]
          },
          "3540418": {
            "id": "3540418",
            "speakerId": 1001,
            "speakerName": "Amber",
            "text": "I am. But not to worry, I can keep you both safe while doing that too.",
            "nextDialogs": [
              "3540419"
            ]
          },
          "3540419": {
            "id": "3540419",
            "speakerId": 1001,
            "speakerName": "Amber",
            "text": "Besides... I'm still not sure if I can trust you two just yet!"
          },
          "3540413": {
            "id": "3540413",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hey! That's even worse than being a mascot!"
          }
        }
      }
    },

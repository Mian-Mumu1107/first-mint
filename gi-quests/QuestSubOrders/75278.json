          "752780101": {
            "id": "752780101",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "W—Wait a second! Please stop!",
            "nextDialogs": [
              "752780102"
            ]
          },
          "752780102": {
            "id": "752780102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How can we help you, little girl?",
            "nextDialogs": [
              "752780103"
            ]
          },
          "752780103": {
            "id": "752780103",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "\"Bear the miracle of the blooming Guiztli, and let the Sacred Flame ignite your smile!\"",
            "nextDialogs": [
              "752780104"
            ]
          },
          "752780104": {
            "id": "752780104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? What's going on...",
            "nextDialogs": [
              "752780105"
            ]
          },
          "752780105": {
            "id": "752780105",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "\"In the name of the Easybreeze Holiday Resort, I present to you a dance of welcome! Shine on, Pipilpan Idol!\"",
            "nextDialogs": [
              "752780106"
            ]
          },
          "752780106": {
            "id": "752780106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah! That line again!?",
            "nextDialogs": [
              "752780107"
            ]
          },
          "752780107": {
            "id": "752780107",
            "speakerId": 21960,
            "speakerName": "\"Chiton\"",
            "text": "#That's right, it's me, \"Chiton\"! Hehe, long time no see, {M#Mr.}{F#Ms.} {NICKNAME} and Ms. Paimon!",
            "nextDialogs": [
              "752780108"
            ]
          },
          "752780108": {
            "id": "752780108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh! It's you, \"Chiton\"! Paimon thought we'd run into someone scary again...",
            "nextDialogs": [
              "752780111"
            ]
          },
          "752780111": {
            "id": "752780111",
            "speakerId": 21960,
            "speakerName": "\"Chiton\"",
            "text": "Hehe, guess what? Dad's gonna train me personally to become a proper performer!",
            "nextDialogs": [
              "752780112"
            ]
          },
          "752780112": {
            "id": "752780112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "See? He acts all tough, but he really cares about you! Paimon just hopes he can be a little more... conventional in his teaching methods...",
            "nextDialogs": [
              "752780113"
            ]
          },
          "752780113": {
            "id": "752780113",
            "speakerId": 21960,
            "speakerName": "\"Chiton\"",
            "text": "Oh, I almost forgot, this is for you!",
            "nextDialogs": [
              "752780114"
            ]
          },
          "752780114": {
            "id": "752780114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, isn't this your performance outfit? But without it...",
            "nextDialogs": [
              "752780115"
            ]
          },
          "752780115": {
            "id": "752780115",
            "speakerId": 21960,
            "speakerName": "\"Chiton\"",
            "text": "Don't worry! Dad made me a new one that fits better! No more falling off the stage for me!",
            "nextDialogs": [
              "752780116"
            ]
          },
          "752780116": {
            "id": "752780116",
            "speakerId": 21960,
            "speakerName": "\"Chiton\"",
            "text": "Consider this old outfit a keepsake! Take it, please, and think of it as a symbol of our friendship!",
            "nextDialogs": [
              "752780117"
            ]
          },
          "752780117": {
            "id": "752780117",
            "speakerId": 21960,
            "speakerName": "\"Chiton\"",
            "text": "Next time we meet, I'll wear my new outfit and dance just for you. Promise you'll come see me!",
            "nextDialogs": [
              "752780118"
            ]
          },
          "752780118": {
            "id": "752780118",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We promise!",
            "nextDialogs": [
              "752780119"
            ]
          },
          "752780119": {
            "id": "752780119",
            "speakerId": 1003,
            "speakerName": "Faraway Voice",
            "text": "\"Chiton\"! Training time!",
            "nextDialogs": [
              "752780120"
            ]
          },
          "752780120": {
            "id": "752780120",
            "speakerId": 21960,
            "speakerName": "\"Chiton\"",
            "text": "#Okay, gotta go work on these muscles. Bye bye, {M#Mr.}{F#Ms.} {NICKNAME} and Ms. Paimon!",
            "nextDialogs": [
              "752780121"
            ]
          },
          "752780121": {
            "id": "752780121",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Bye-bye!",
            "nextDialogs": [
              "752780122"
            ]
          },
          "752780122": {
            "id": "752780122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(You're really gonna go?)",
            "nextDialogs": [
              "752780123"
            ]
          },
          "752780123": {
            "id": "752780123",
            "speakerId": 1005,
            "speakerName": "Paimon",

            ]
          },
          "710421512": {
            "id": "710421512",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Eh? Really? Paimon feels alright.",
            "nextDialogs": [
              "710421515"
            ]
          },
          "710421515": {
            "id": "710421515",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "Thanks for your concern, but I'm fine. I've had my fair share of bouts of vertigo or seasickness. I'll be okay."
          }
        }

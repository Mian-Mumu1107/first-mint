    {
      "subId": "7104232",
      "subQuestName": "Talk to Zhiqiong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710421401"
        ],
        "dialogs": {
          "710421401": {
            "id": "710421401",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "We should be able to load the cannonball now. Be careful, the fuse has already been mounted...",
            "nextDialogs": [
              "710421402"
            ]
          },
          "710421402": {
            "id": "710421402",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Ugh, if we had known that we had to do this, we should have just mounted the fuse here and loaded the cannon all at once!",
            "nextDialogs": [
              "710421403"
            ]
          },
          "710421403": {
            "id": "710421403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's all water under the bridge by now, Paimon...",
            "nextDialogs": [
              "710421404"
            ]
          },
          "710421404": {
            "id": "710421404",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "Give me a hand over here, please!",
            "nextDialogs": [
              "710421405"
            ]
          },
          "710421405": {
            "id": "710421405",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You load the cannon safely."
          }
        }
      }
    },
    {
      "subId": "7104211",
      "subQuestName": "Use the great cannon to destroy the sealing rocks",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710421101"
        ],
        "dialogs": {
          "710421101": {
            "id": "710421101",
            "speakerId": 1001,
            "speakerName": "Clitopho",
            "text": "Thanks for your faith in me. I won't let everyone down.",
            "nextDialogs": [
              "710421104",
              "710421105"
            ]
          },
          "710421104": {
            "id": "710421104",
            "speakerId": 1001,
            "speakerName": "Clitopho",
            "text": "Um, alright... In that case, I won't waste your time any further."
          },
          "710421105": {
            "id": "710421105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How's Zhiqiong doing?",
            "nextDialogs": [
              "710421106"
            ]
          },
          "710421106": {
            "id": "710421106",
            "speakerId": 1001,
            "speakerName": "Clitopho",
            "text": "Zhiqiong? She's been pretty tightly-wound. I suspect that she's been around that black mud too much. She should learn to rest and stop being so neurotic all the time.",
            "nextDialogs": [
              "710421107"
            ]
          },
          "710421107": {
            "id": "710421107",
            "speakerId": 1001,
            "speakerName": "Clitopho",
            "text": "But things are still fine. I can bear with her. I also have you and Jinwu to thank for having faith in me."
          }
        }
      }
    },
    {
      "subId": "7104212",
      "subQuestName": "Talk to Zhiqiong",
      "sceneId": null,
      "locations": [],
      "dialogue": {

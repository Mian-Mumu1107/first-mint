    {
      "subId": "7104213",
      "subQuestName": "Go further in",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7104215",
      "subQuestName": "Talk to Zhiqiong",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710420601"
        ],
        "dialogs": {
          "710420601": {
            "id": "710420601",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "Lumenstone only started springing up like mushrooms within The Chasm after the miners discovered this thing... This is definitely no coincidence.",
            "nextDialogs": [
              "710420602"
            ]
          },
          "710420602": {
            "id": "710420602",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "From the way it floats and its damaged state, it really does look like the fragments that Iris said existed on Dragonspine.",
            "nextDialogs": [
              "710420603"
            ]
          },
          "710420603": {
            "id": "710420603",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "And yeah, I am talking about those floating fragments that you found earlier. Who knows, they might also be inexorably attracted to unite with a large fragment somewhere...",
            "nextDialogs": [
              "710420604"
            ]
          },
          "710420604": {
            "id": "710420604",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "Perhaps some nameless ancient civilization sleeps under our feet, just like the ancient catacombs on Dragonspine. What do you think?",
            "nextDialogs": [
              "710420607"
            ]
          },
          "710420607": {
            "id": "710420607",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "The changes to the geological structure of The Chasm have been... accelerating. The black substance that you see covering the rocks only started showing up everywhere recently.",
            "nextDialogs": [
              "710420608"
            ]
          },
          "710420608": {
            "id": "710420608",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "I can't be sure, but I think that these things are all related: the mud, the flowing light, and this floating crystal fragment.",
            "nextDialogs": [
              "710420609"
            ]
          },
          "710420609": {
            "id": "710420609",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Hmm... Why would you think that?",
            "nextDialogs": [
              "710420610"
            ]
          },
          "710420610": {
            "id": "710420610",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "Well, that's because they all make me feel sort of... queasy?",
            "nextDialogs": [
              "710420611"
            ]
          },
          "710420611": {
            "id": "710420611",
            "speakerId": 1002,
            "speakerName": "Zhiqiong",
            "text": "It's like getting motion sick on a carriage, or like losing your sense of direction on a ship in a storm...",
            "nextDialogs": [
              "710420612"
            ]
          },
          "710420612": {
            "id": "710420612",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Eh? Really? Paimon feels alright."
          }
        }
      }
    },
    {
      "subId": "7104216",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710421601"
        ],
        "dialogs": {
          "710421601": {
            "id": "710421601",
            "speakerId": 1001,
            "speakerName": "Clitopho",
            "text": "How was it? Did you have any trouble putting the Unmoving Essential Oil together?",
            "nextDialogs": [
              "710421604"
            ]
          },
          "710421604": {
            "id": "710421604",
            "speakerId": 1001,
            "speakerName": "Clitopho",
            "text": "Ah, that's fine, that's fine. Even a seven-year-old kid should be able to read the formula I wrote! Just try it a couple more times — just mind you don't hurt yourself!"
          }
        }
      }
    },

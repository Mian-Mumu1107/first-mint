    {
      "subId": "1914516",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191451601"
        ],
        "dialogs": {
          "191451601": {
            "id": "191451601",
            "speakerId": 1003,
            "speakerName": "Inagi Hotomi",
            "text": "I pray that the Electro Archon will bless that lady and her granddaughter...",
            "nextDialogs": [
              "191451602"
            ]
          },
          "191451602": {
            "id": "191451602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I wanted to ask — does she have vision problems?",
            "nextDialogs": [
              "191451603"
            ]
          },
          "191451603": {
            "id": "191451603",
            "speakerId": 1003,
            "speakerName": "Inagi Hotomi",
            "text": "Oh, you noticed? Yes, she can't see very well. We always get a little worried for her safety every time she comes up the mountain.",
            "nextDialogs": [
              "191451604"
            ]
          },
          "191451604": {
            "id": "191451604",
            "speakerId": 1003,
            "speakerName": "Inagi Hotomi",
            "text": "But she always refuses our offers to help. She insists that she knows the route like the back of her hand after walking it so many times in her life...",
            "nextDialogs": [
              "191451605"
            ]
          },
          "191451605": {
            "id": "191451605",
            "speakerId": 1003,
            "speakerName": "Inagi Hotomi",
            "text": "Luckily, there are shrine maidens along the way who can at least keep an eye on her.",
            "nextDialogs": [
              "191451606"
            ]
          },
          "191451606": {
            "id": "191451606",
            "speakerId": 1003,
            "speakerName": "Inagi Hotomi",
            "text": "May the Electro Archon watch over her and her granddaughter on their respective journeys..."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2051301",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205130101"
        ],
        "dialogs": {
          "205130101": {
            "id": "205130101",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "This one looks normal enough...",
            "nextDialogs": [
              "205130102"
            ]
          },
          "205130102": {
            "id": "205130102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You look quite well.",
            "nextDialogs": [
              "205130103"
            ]
          },
          "205130103": {
            "id": "205130103",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Yes, well, I guess I was just giving myself a fright.",
            "nextDialogs": [
              "205130104"
            ]
          },
          "205130104": {
            "id": "205130104",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Anna's looking better by the day. This doctor really is the real deal.",
            "nextDialogs": [
              "205130105"
            ]
          },
          "205130105": {
            "id": "205130105",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "If you're willing, could you help me find more ingredients? This time, we need a Wind-Caressed Aster.",
            "nextDialogs": [
              "205130107",
              "205130112",
              "205130116"
            ]
          },
          "205130107": {
            "id": "205130107",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Well, Windwheel Asters are sometimes used in medicine, but it's usually used to heal minor ailments.",
            "nextDialogs": [
              "205130108"
            ]
          },
          "205130108": {
            "id": "205130108",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Maybe the Anemo Slime is the key, but Windwheel Asters and Anemo Slimes aren't really seen together often.",
            "nextDialogs": [
              "205130109"
            ]
          },
          "205130109": {
            "id": "205130109",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Luckily, Jack has seen this happen a few times before, and he has related their rough locations to me. Let me mark the latest one out on your map.",
            "nextDialogs": [
              "205130110"
            ]
          },
          "205130110": {
            "id": "205130110",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "I can't deal with Anemo Slimes since they can fly, so I can only turn to you!"
          },
          "205130112": {
            "id": "205130112",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "I wouldn't argue with you, but Windwheel Asters and Anemo Slimes aren't seen together often.",
            "nextDialogs": [
              "205130113"
            ]
          },
          "205130113": {
            "id": "205130113",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Fortunately, Jack has seen this happen a few times before, and he has related their rough locations to me. Let me mark the latest one out on your map.",
            "nextDialogs": [
              "205130114"
            ]
          },
          "205130114": {
            "id": "205130114",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "I really can't fight Anemo Slimes, since they can fly, so I can only count on you!"
          },
          "205130116": {
            "id": "205130116",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "You just want to watch me embarrass myself, don't you?",
            "nextDialogs": [
              "205130117"
            ]
          },
          "205130117": {
            "id": "205130117",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Nonetheless, Windwheel Asters and Anemo Slimes aren't seen together often.",
            "nextDialogs": [
              "205130118"
            ]
          },
          "205130118": {
            "id": "205130118",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Fortunately, Jack has seen this happen a few times before, and he has related their rough locations to me. Let me mark the latest one out on your map.",
            "nextDialogs": [
              "205130119"
            ]
          },
          "205130119": {
            "id": "205130119",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "If you really can't find it, then bring an Anemo Slime back. I'll do anything for Anna."
          }
        }
      }
    },
    {
      "subId": "2051302",
      "subQuestName": "Acquire a Wind-Caressed Aster",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205130201"
        ],
        "dialogs": {
          "205130201": {
            "id": "205130201",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Have you found it yet?",
            "nextDialogs": [
              "205130202"
            ]
          },
          "205130202": {
            "id": "205130202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No, not yet.",
            "nextDialogs": [
              "205130203"
            ]
          },
          "205130203": {
            "id": "205130203",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Well, it is combat we're talking about. Take some time to prepare, and I'll see you again."
          }
        }
      }
    },
    {
      "subId": "2051303",
      "subQuestName": "Talk to Anthony",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205130301"
        ],
        "dialogs": {
          "205130301": {
            "id": "205130301",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Have you found it yet?",
            "nextDialogs": [
              "205130302"
            ]
          },
          "205130302": {
            "id": "205130302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it.",
            "nextDialogs": [
              "205130303"
            ]
          },
          "205130303": {
            "id": "205130303",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Huh. This Windwheel Aster does feel different from normal.",
            "nextDialogs": [
              "205130304"
            ]
          },
          "205130304": {
            "id": "205130304",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Hahaha. Don't ask me why, but I have a feeling that if Anna eats this medicine, she will certainly get well.",
            "nextDialogs": [
              "205130305"
            ]
          },
          "205130305": {
            "id": "205130305",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Maybe her recent improvement's been getting my hopes up.",
            "nextDialogs": [
              "205130306"
            ]
          },
          "205130306": {
            "id": "205130306",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "All the same, thank you so much. Take this as compensation for your trouble.",
            "nextDialogs": [
              "205130307"
            ]
          },
          "205130307": {
            "id": "205130307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hope Anna gets well.",
            "nextDialogs": [
              "205130308"
            ]
          },
          "205130308": {
            "id": "205130308",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "Thank you. She will.",
            "nextDialogs": [
              "205130309"
            ]
          },
          "205130309": {
            "id": "205130309",
            "speakerId": 1408,
            "speakerName": "Anthony",
            "text": "I have always believed so."
          }
        }
      }
    }
  ]
}
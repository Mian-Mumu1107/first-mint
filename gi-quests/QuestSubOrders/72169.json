      "dialogue": {
        "startDialogs": [
          "721690701"
        ],
        "dialogs": {
          "721690701": {
            "id": "721690701",
            "speakerId": 1002,
            "speakerName": "Julie",
            "text": "I wonder if there are any tougher branches nearby..."
          }
        }
      }
    },
    {
      "subId": "7216908",
      "subQuestName": "Additional",
      "sceneId": null,

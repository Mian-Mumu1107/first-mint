        ],
        "dialogs": {
          "761830201": {
            "id": "761830201",
            "speakerId": 1080,
            "speakerName": "The Knave",
            "text": "It's important to find time to relax now and then.",
            "nextDialogs": [
              "761830202"
            ]
          },
          "761830202": {
            "id": "761830202",
            "speakerId": 1319,
            "speakerName": "Marionette",
            "text": "(Let's sit like this for a little while longer.)",
            "nextDialogs": [
              "761830204"
            ]
          },
          "761830204": {
            "id": "761830204",
            "speakerId": 1080,
            "speakerName": "The Knave",
            "text": "Very well. I'll see you in Snezhnaya."
          }
        }
      }
    },

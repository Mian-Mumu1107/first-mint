    {
      "subId": "300802",
      "subQuestName": "Talk to Dunyarzad",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080201"
        ],
        "dialogs": {
          "30080201": {
            "id": "30080201",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "This is a stall offering foods from the Haft-Mewa Feast.",
            "nextDialogs": [
              "30080202"
            ]
          },
          "30080202": {
            "id": "30080202",
            "speakerId": 1003,
            "speakerName": "Amal",
            "text": "You are quite well-informed, Miss! I thought most people nowadays wouldn't know.",
            "nextDialogs": [
              "30080203"
            ]
          },
          "30080203": {
            "id": "30080203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "They're all plants... Aw, Paimon's a little disappointed...",
            "nextDialogs": [
              "30080204"
            ]
          },
          "30080204": {
            "id": "30080204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Actually, what is the \"Haft-Mewa Feast\" you mentioned just now?",
            "nextDialogs": [
              "30080205"
            ]
          },
          "30080205": {
            "id": "30080205",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "It's one of the Sabzeruz Festival's traditions. People used to set their tables with seven different foods to symbolize the seven virtues of the Dendro Archon.",
            "nextDialogs": [
              "30080208"
            ]
          },
          "30080208": {
            "id": "30080208",
            "speakerId": 1000,
            "speakerName": "Kimiya",
            "text": "...The remnants appear to be in the form of the Moon.",
            "nextDialogs": [
              "30080209"
            ]
          },
          "30080209": {
            "id": "30080209",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Really? Paimon thought it looked like some kind of food.",
            "nextDialogs": [
              "30080210"
            ]
          },
          "30080210": {
            "id": "30080210",
            "speakerId": 1000,
            "speakerName": "Kimiya",
            "text": "Hmm... The Moon signifies... Hmm... It's escaping me for now. Wait a moment...",
            "nextDialogs": [
              "30080211"
            ]
          },
          "30080211": {
            "id": "30080211",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Is he really looking it up in a book?",
            "nextDialogs": [
              "30080212"
            ]
          },
          "30080212": {
            "id": "30080212",
            "speakerId": 1000,
            "speakerName": "Kimiya",
            "text": "Oh, right, it means illusions and lies.",
            "nextDialogs": [
              "30080213"
            ]
          },
          "30080213": {
            "id": "30080213",
            "speakerId": 1000,
            "speakerName": "Kimiya",
            "text": "But if you trust your intuition and overcome your fears, the sun will surely rise."
          }
        }
      }
    },
    {
      "subId": "300803",
      "subQuestName": "Follow Dunyarzad",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080301"
        ],
        "dialogs": {
          "30080301": {
            "id": "30080301",
            "speakerId": 1003,
            "speakerName": "Amal",
            "text": "I picked all of these from the forest yesterday, so their freshness is guaranteed!"
          }
        }
      }
    },
    {
      "subId": "300804",
      "subQuestName": "Talk to Dunyarzad",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080401"
        ],
        "dialogs": {
          "30080401": {
            "id": "30080401",
            "speakerId": 1004,
            "speakerName": "Children",
            "text": "Farris! Farris!",
            "nextDialogs": [
              "30080402"
            ]
          },
          "30080402": {
            "id": "30080402",
            "speakerId": 1005,
            "speakerName": "Vihar",
            "text": "Alright soldiers, now that you have your Yalda Candies, don't forget your loyalty to Lesser Lord Kusanali. Dismissed!",
            "nextDialogs": [
              "30080403"
            ]
          },
          "30080403": {
            "id": "30080403",
            "speakerId": 1004,
            "speakerName": "Children",
            "text": "Yes, Knight Farris!",
            "nextDialogs": [
              "30080404"
            ]
          },
          "30080404": {
            "id": "30080404",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What's going on? Is this a play?",
            "nextDialogs": [
              "30080405"
            ]
          },
          "30080405": {
            "id": "30080405",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "Farris, the Knight of Flowers, is another Sabzeruz Festival icon, and one immensely popular with children.",
            "nextDialogs": [
              "30080406"
            ]
          },
          "30080406": {
            "id": "30080406",
            "speakerId": 1005,
            "speakerName": "Vihar",
            "text": "Haha, it's all thanks to Miss Dunyarzad's sponsorship that the children can meet the Knight of Flowers.",
            "nextDialogs": [
              "30080407"
            ]
          },
          "30080407": {
            "id": "30080407",
            "speakerId": 1005,
            "speakerName": "Vihar",
            "text": "Oh, do you want some Yalda Candies? I happen to have some boxes readied here. Take a look and pick whichever one you want.",
            "nextDialogs": [
              "30080408"
            ]
          },
          "30080408": {
            "id": "30080408",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uhh, what's to pick? Don't these boxes all look the same?",
            "nextDialogs": [
              "30080409"
            ]
          },
          "30080409": {
            "id": "30080409",
            "speakerId": 1005,
            "speakerName": "Vihar",
            "text": "Haha, it's not that simple. Each box contains a random flavor — it's up to the luck of the draw. Flavors include Lavender Melon, Harra Fruit, Sunsettia...",
            "nextDialogs": [
              "30080410"
            ]
          },
          "30080410": {
            "id": "30080410",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ooh, how interesting!",
            "nextDialogs": [
              "30080411"
            ]
          },
          "30080411": {
            "id": "30080411",
            "speakerId": 1005,
            "speakerName": "Vihar",
            "text": "...And there's also Lizard Tail and Onikabuto.",
            "nextDialogs": [
              "30080412"
            ]
          },
          "30080412": {
            "id": "30080412",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ugh! Why do those flavors even exist!?",
            "nextDialogs": [
              "30080413"
            ]
          },
          "30080413": {
            "id": "30080413",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... Traveler, help Paimon pick one. Paimon wants to eat the Sunsettia flavor!",
            "nextDialogs": [
              "30080414"
            ]
          },
          "30080414": {
            "id": "30080414",
            "speakerId": 1005,
            "speakerName": "Vihar",
            "text": "Great. These boxes of candy are numbered one to five from left to right. Which one do you want?",
            "nextDialogs": [
              "30080437",
              "30080438",
              "30080439",
              "30080440",
              "30080441"
            ]
          },
          "30080437": {
            "id": "30080437",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's definitely number one.",
            "nextDialogs": [
              "30080425"
            ]
          },
          "30080425": {
            "id": "30080425",
            "speakerId": 1005,
            "speakerName": "Vihar",
            "text": "Ah, excellently chosen! Number four is indeed Sunsettia.",
            "nextDialogs": [
              "30080426"
            ]
          },
          "30080426": {
            "id": "30080426",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Haha, Paimon bet you had incredible luck, and Paimon was right!"
          },
          "30080438": {
            "id": "30080438",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's definitely number two."
          },
          "30080439": {
            "id": "30080439",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's definitely number three."
          },
          "30080440": {
            "id": "30080440",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's definitely number four.",
            "nextDialogs": [
              "30080420"
            ]
          },
          "30080420": {
            "id": "30080420",
            "speakerId": 1005,
            "speakerName": "Vihar",
            "text": "Ah, excellently chosen! Number four is indeed Sunsettia.",
            "nextDialogs": [
              "30080421"
            ]
          },
          "30080421": {
            "id": "30080421",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Haha, Paimon bet you had incredible luck, and Paimon was right!",
            "nextDialogs": [
              "30080422"
            ]
          },
          "30080422": {
            "id": "30080422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That just now... I don't think that was luck.",
            "nextDialogs": [
              "30080423"
            ]
          },
          "30080423": {
            "id": "30080423",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't know why, but I knew it must have been number four.",
            "nextDialogs": [
              "30080424"
            ]
          },
          "30080424": {
            "id": "30080424",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? How's that possible? It's obviously random..."
          },
          "30080441": {
            "id": "30080441",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's definitely number five."
          }
        }
      }
    },
    {
      "subId": "300805",
      "subQuestName": "Go to Lambad's Tavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080501"
        ],
        "dialogs": {
          "30080501": {
            "id": "30080501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A feeling of... déjà vu?",
            "nextDialogs": [
              "30080502"
            ]
          },
          "30080502": {
            "id": "30080502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon knows what that is! It's when you feel like you've already experienced whatever is going on...",
            "nextDialogs": [
              "30080503"
            ]
          },
          "30080503": {
            "id": "30080503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "In that case, Paimon also felt something like that today... But that's just our brains playing tricks on us, isn't it?",
            "nextDialogs": [
              "30080504"
            ]
          },
          "30080504": {
            "id": "30080504",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So, why'd you run here in such a hurry?",
            "nextDialogs": [
              "30080507"
            ]
          },
          "30080507": {
            "id": "30080507",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So that's it! You're intentionally doing things you usually wouldn't, and seeing if you still get that same feeling of déjà vu...",
            "nextDialogs": [
              "30080508"
            ]
          },
          "30080508": {
            "id": "30080508",
            "speakerId": 1006,
            "speakerName": "Lambad",
            "text": "Welcome, you two! Are you here for lunch? What would you like to eat?",
            "nextDialogs": [
              "30080509"
            ]
          },
          "30080509": {
            "id": "30080509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "One Charcoal-Baked Ajilenakh Cake, please.",
            "nextDialogs": [
              "30080510"
            ]
          },
          "30080510": {
            "id": "30080510",
            "speakerId": 1006,
            "speakerName": "Lambad",
            "text": "Got it. You don't look like you're from these parts, but I gotta say, you've got good taste. I'll give this order to the kitchen.",
            "nextDialogs": [
              "30080511"
            ]
          },
          "30080511": {
            "id": "30080511",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Charcoal-Baked Ajilenakh Cake! Isn't it that... that burned thing that didn't look tasty at all?",
            "nextDialogs": [
              "30080512"
            ]
          },
          "30080512": {
            "id": "30080512",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh... Paimon understands what you're trying to do now... You'd never normally order something like this...",
            "nextDialogs": [
              "30080513"
            ]
          },
          "30080513": {
            "id": "30080513",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "After some time, the Charcoal-Baked Ajilenakh Cake is served...",
            "nextDialogs": [
              "30080514"
            ]
          },
          "30080514": {
            "id": "30080514",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That... thing... Are you really gonna eat it?",
            "nextDialogs": [
              "30080515"
            ]
          },
          "30080515": {
            "id": "30080515",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Isn't this... going a bit too far...",
            "nextDialogs": [
              "30080516"
            ]
          },
          "30080516": {
            "id": "30080516",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here goes!",
            "nextDialogs": [
              "30080517"
            ]
          },
          "30080517": {
            "id": "30080517",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "H—How was it? The look on your face is telling Paimon that it tasted awful...",
            "nextDialogs": [
              "30080518"
            ]
          },
          "30080518": {
            "id": "30080518",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No... It actually tasted really good.",
            "nextDialogs": [
              "30080519"
            ]
          },
          "30080519": {
            "id": "30080519",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Then, you mean..."
          }
        }
      }
    },
    {
      "subId": "300813",
      "subQuestName": "Leave Lambad's Tavern",
      "sceneId": null,
      "locations": [],
      "dialogue": {

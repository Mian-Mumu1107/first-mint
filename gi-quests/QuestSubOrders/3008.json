      }
    },
    {
      "subId": "300806",
      "subQuestName": "Talk to Dunyarzad",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080601"
        ],
        "dialogs": {
          "30080601": {
            "id": "30080601",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, Dunyarzad is sitting by herself on that bench over there...",
            "nextDialogs": [
              "30080602"
            ]
          },
          "30080602": {
            "id": "30080602",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What a coincidence, Dunyarzad! We meet again! Uh, why are you sitting here all by yourself?",
            "nextDialogs": [
              "30080603"
            ]
          },
          "30080603": {
            "id": "30080603",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "Oh, I ran into some kidnappers just now, but thankfully, Dehya came to my rescue. I started to feel unwell after that, so I sat down here.",
            "nextDialogs": [
              "30080604"
            ]
          },
          "30080604": {
            "id": "30080604",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Kidnappers? Oh my goodness! Are you hurt?",
            "nextDialogs": [
              "30080605"
            ]
          },
          "30080605": {
            "id": "30080605",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "I'm okay. Dehya's arm got scratched, but it isn't serious.",
            "nextDialogs": [
              "30080606"
            ]
          },
          "30080606": {
            "id": "30080606",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Phew... That's a big relief. But Dunyarzad, you seem a little down today... It's the Sabzeruz Festival, and you've been looking forward to it so much.",
            "nextDialogs": [
              "30080607"
            ]
          },
          "30080607": {
            "id": "30080607",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "Not at all. I've always been like this. Excessive physical exertion or strong emotions tend to aggravate my illness.",
            "nextDialogs": [
              "30080608"
            ]
          },
          "30080608": {
            "id": "30080608",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "Besides, no matter how amazing today may be, it is but a single day. After however many more days, my time will come to an end.",
            "nextDialogs": [
              "30080609"
            ]
          },
          "30080609": {
            "id": "30080609",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon doesn't quite follow you, and Paimon feels like something's really got you down right now...",
            "nextDialogs": [
              "30080610"
            ]
          },
          "30080610": {
            "id": "30080610",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm so sorry for leaving you behind earlier.",
            "nextDialogs": [
              "30080611"
            ]
          },
          "30080611": {
            "id": "30080611",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "It really is fine. I don't mind.",
            "nextDialogs": [
              "30080614"
            ]
          },
          "30080614": {
            "id": "30080614",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "Huh? Did something happen?",
            "nextDialogs": [
              "30080615"
            ]
          },
          "30080615": {
            "id": "30080615",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Dunyarzad... have you ever felt déjà vu? You know... Like when you've already experienced something that's happening right now?",
            "nextDialogs": [
              "30080616"
            ]
          },
          "30080616": {
            "id": "30080616",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "Déjà vu? No, but my days have been the same for years now. Even if I were feeling déjà vu, I suppose I would already be used to it.",
            "nextDialogs": [
              "30080617"
            ]
          },
          "30080617": {
            "id": "30080617",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, Paimon sees... Then, is it only the two of us...?",
            "nextDialogs": [
              "30080618"
            ]
          },
          "30080618": {
            "id": "30080618",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "It's almost time.",
            "nextDialogs": [
              "30080619"
            ]
          },
          "30080619": {
            "id": "30080619",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Time for what?",
            "nextDialogs": [
              "30080620"
            ]
          },
          "30080620": {
            "id": "30080620",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "Nilou's Dance of Sabzeruz is about to begin. Let's go."
          }
        }
      }
    },
    {
      "subId": "300807",
      "subQuestName": "Go to the Grand Bazaar and see the Dance of Sabzeruz",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080701"
        ],
        "dialogs": {
          "30080701": {
            "id": "30080701",
            "speakerId": 1008,
            "speakerName": "Azar",
            "text": "...With your lack of intellectual credentials, I do not believe you are qualified to debate with me. What you should be doing is finding workers to tear down this ridiculous eyesore.",
            "nextDialogs": [
              "30080702"
            ]
          },
          "30080702": {
            "id": "30080702",
            "speakerId": 1008,
            "speakerName": "Azar",
            "text": "When we return, have the Scribe draft an ordinance before the next Jnagarbha Day that prohibits public art performances. We will announce it to the public later via the Akasha.",
            "nextDialogs": [
              "30080703"
            ]
          },
          "30080703": {
            "id": "30080703",
            "speakerId": 1009,
            "speakerName": "Setaria",
            "text": "Understood. I will inform him when I return.",
            "nextDialogs": [
              "30080704"
            ]
          },
          "30080704": {
            "id": "30080704",
            "speakerId": 1008,
            "speakerName": "Azar",
            "text": "...",
            "nextDialogs": [
              "30080705"
            ]
          },
          "30080705": {
            "id": "30080705",
            "speakerId": 1008,
            "speakerName": "Azar",
            "text": "The Sabzeruz Festival... Go celebrate the birth of that god to your heart's content.",
            "nextDialogs": [
              "30080706"
            ]
          },
          "30080706": {
            "id": "30080706",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Nilou, are you okay?",
            "nextDialogs": [
              "30080707"
            ]
          },
          "30080707": {
            "id": "30080707",
            "speakerId": 1010,
            "speakerName": "Nilou",
            "text": "Oh, Dunyarzad, the Grand Sage ordered us to stop the performance...",
            "nextDialogs": [
              "30080708"
            ]
          },
          "30080708": {
            "id": "30080708",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "It's okay. There's nothing we can do about it.",
            "nextDialogs": [
              "30080709"
            ]
          },
          "30080709": {
            "id": "30080709",
            "speakerId": 1010,
            "speakerName": "Nilou",
            "text": "But you've been really looking forward to this. I don't want you to have any regrets...",
            "nextDialogs": [
              "30080710"
            ]
          },
          "30080710": {
            "id": "30080710",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "It truly is unfortunate, but I don't wanna cause trouble for anyone. Didn't the Grand Sage say that he might investigate the organizers?",
            "nextDialogs": [
              "30080711"
            ]
          },
          "30080711": {
            "id": "30080711",
            "speakerId": 1010,
            "speakerName": "Nilou",
            "text": "True, but... *sigh* Well, okay, we'll just have to try again next year, hehe...",
            "nextDialogs": [
              "30080712"
            ]
          },
          "30080712": {
            "id": "30080712",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "The next festival... I probably won't be around by then.",
            "nextDialogs": [
              "30080713"
            ]
          },
          "30080713": {
            "id": "30080713",
            "speakerId": 1010,
            "speakerName": "Nilou",
            "text": "Wait... What did you just say?",
            "nextDialogs": [
              "30080714"
            ]
          },
          "30080714": {
            "id": "30080714",
            "speakerId": 1002,
            "speakerName": "Dunyarzad",
            "text": "No, nothing. I'll be heading back to rest. Thank you for your help, everyone.",
            "nextDialogs": [
              "30080715"
            ]
          },
          "30080715": {
            "id": "30080715",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon can't believe what those heartless geezers did!",
            "nextDialogs": [
              "30080718"
            ]
          },
          "30080718": {
            "id": "30080718",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Did Dunyarzad already go back? We should also return and get some sleep.",
            "nextDialogs": [
              "30080719"
            ]
          },
          "30080719": {
            "id": "30080719",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "The Sabzeruz Festival was forced to come to an unfortunately abrupt end..."
          }
        }
      }
    },
    {
      "subId": "300808",
      "subQuestName": "Return to the accommodation and rest",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080801"
        ],
        "dialogs": {
          "30080801": {
            "id": "30080801",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So in the end, you still couldn't figure out what that déjà vu feeling was all about?",
            "nextDialogs": [
              "30080802"
            ]
          },
          "30080802": {
            "id": "30080802",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... Maybe it really was because of exhaustion...",
            "nextDialogs": [
              "30080805"
            ]
          },
          "30080805": {
            "id": "30080805",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Same here! That's why Paimon stopped thinking about it halfway through the day.",
            "nextDialogs": [
              "30080806"
            ]
          },
          "30080806": {
            "id": "30080806",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Then how about we settle in and get a good night's sleep. For now, we can chalk things up to exhaustion... We can do more thinking tomorrow!",
            "nextDialogs": [
              "30080807"
            ]
          },
          "30080807": {
            "id": "30080807",
            "speakerId": 1011,
            "speakerName": "???",
            "text": "*beep*",
            "nextDialogs": [
              "30080808"
            ]
          },
          "30080808": {
            "id": "30080808",
            "speakerId": 1011,
            "speakerName": "???",
            "text": "...Observing a modest drop in the output of Jnana Energy, but values still remain within normal parameters.",
            "nextDialogs": [
              "30080809"
            ]
          },
          "30080809": {
            "id": "30080809",
            "speakerId": 1011,
            "speakerName": "???",
            "text": "Continue to monitor for variances in the data, and find the cause as soon as possible."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7619701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761970101"
        ],
        "dialogs": {
          "761970101": {
            "id": "761970101",
            "speakerId": 7081,
            "speakerName": "Viljami",
            "text": "During my years at sea, I once heard a call coming from nowhere. The others didn't react at all, but I was captivated almost instantly.",
            "nextDialogs": [
              "761970102"
            ]
          },
          "761970102": {
            "id": "761970102",
            "speakerId": 21837,
            "speakerName": "Auni",
            "text": "It must have been a voice from another world. I've heard it too.",
            "nextDialogs": [
              "761970103"
            ]
          },
          "761970103": {
            "id": "761970103",
            "speakerId": 7081,
            "speakerName": "Viljami",
            "text": "Only later did I realize... That call carried with it every dream that never made it to the far shore. You might even call it a gathering of regrets.",
            "nextDialogs": [
              "761970104"
            ]
          },
          "761970104": {
            "id": "761970104",
            "speakerId": 21837,
            "speakerName": "Auni",
            "text": "You should bring an Icy Pebble with you. Look through the hole at its center, and you'll see who's been calling out to you.",
            "nextDialogs": [
              "761970105"
            ]
          },
          "761970105": {
            "id": "761970105",
            "speakerId": 7081,
            "speakerName": "Viljami",
            "text": "But back then, I was still a hot-headed young fool. Even danger looked like an opportunity to me. So I charged straight in without a second thought.",
            "nextDialogs": [
              "761970106"
            ]
          },
          "761970106": {
            "id": "761970106",
            "speakerId": 21837,
            "speakerName": "Auni",
            "text": "They say the hole at the center of the Icy Pebble is a gateway to another world... But how exactly are you supposed to cross through it?",
            "nextDialogs": [
              "761970107"
            ]
          },
          "761970107": {
            "id": "761970107",
            "speakerId": 7081,
            "speakerName": "Viljami",
            "text": "And after that... the sea and its raging winds took everything from me — my wealth, my honor, and even my family.",
            "nextDialogs": [
              "761970108"
            ]
          },
          "761970108": {
            "id": "761970108",
            "speakerId": 7081,
            "speakerName": "Viljami",
            "text": "Adventures driven by ambition and desire never end well.",
            "nextDialogs": [
              "761970109"
            ]
          },
          "761970109": {
            "id": "761970109",
            "speakerId": 21837,
            "speakerName": "Auni",
            "text": "Ah, it's stuck...",
            "nextDialogs": [
              "761970110"
            ]
          },
          "761970110": {
            "id": "761970110",
            "speakerId": 1327,
            "speakerName": "Linnea",
            "text": "Let me help you get that off. And next time, try not to do that again, okay?",
            "nextDialogs": [
              "761970111"
            ]
          },
          "761970111": {
            "id": "761970111",
            "speakerId": 21837,
            "speakerName": "Auni",
            "text": "Linnea! What brings you back here?",
            "nextDialogs": [
              "761970112"
            ]
          },
          "761970112": {
            "id": "761970112",
            "speakerId": 1327,
            "speakerName": "Linnea",
            "text": "I've been collecting Icy Pebbles nearby. I saw you chatting and thought I'd come say hello.",
            "nextDialogs": [
              "761970113"
            ]
          },
          "761970113": {
            "id": "761970113",
            "speakerId": 21837,
            "speakerName": "Auni",
            "text": "Oh! Maybe you could really use an Icy Pebble to open a gateway to another world, Linnea! If anyone could pull it off, it would be you...",
            "nextDialogs": [
              "761970114"
            ]
          },
          "761970114": {
            "id": "761970114",
            "speakerId": 1327,
            "speakerName": "Linnea",
            "text": "Even I can't do that. Didn't I tell you before? That's just a folk tale people stitched together. There's no solid evidence behind it.",
            "nextDialogs": [
              "761970115"
            ]
          },
          "761970115": {
            "id": "761970115",
            "speakerId": 7081,
            "speakerName": "Viljami",
            "text": "Ugh... Looks like this isn't gonna work.",
            "nextDialogs": [
              "761970116"
            ]
          },
          "761970116": {
            "id": "761970116",
            "speakerId": 1327,
            "speakerName": "Linnea",
            "text": "...Oh. So you were listening.",
            "nextDialogs": [
              "761970117"
            ]
          },
          "761970117": {
            "id": "761970117",
            "speakerId": 7081,
            "speakerName": "Viljami",
            "text": "Ahem... no. I'm not the person I used to be anymore. These days, I'm content with what I have, and I want nothing else.",
            "nextDialogs": [
              "761970118"
            ]
          },
          "761970118": {
            "id": "761970118",
            "speakerId": 21837,
            "speakerName": "Auni",
            "text": "What a pity. Then I'll help you collect Icy Pebbles too, Linnea.",
            "nextDialogs": [
              "761970119"
            ]
          },
          "761970119": {
            "id": "761970119",
            "speakerId": 1327,
            "speakerName": "Linnea",
            "text": "That'd be great!",
            "nextDialogs": [
              "761970124"
            ]
          },
          "761970124": {
            "id": "761970124",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "With Auni's help, the materials were soon collected...",
            "nextDialogs": [
              "761970122"
            ]
          },
          "761970122": {
            "id": "761970122",
            "speakerId": 1327,
            "speakerName": "Linnea",
            "text": "Thank you, but I've already gathered everything I need.",
            "nextDialogs": [
              "761970123"
            ]
          },
          "761970123": {
            "id": "761970123",
            "speakerId": 21837,
            "speakerName": "Auni",
            "text": "Alright then. I'll head to Moleyvalley to see Grandpa Moley and the others. See you later!"
          }
        }
      }
    },

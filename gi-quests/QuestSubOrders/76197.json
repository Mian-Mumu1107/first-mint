    },
    {
      "subId": "7619799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761979901"
        ],
        "dialogs": {
          "761979901": {
            "id": "761979901",
            "speakerId": 1327,
            "speakerName": "Linnea",
            "text": "(There are quite a few Icy Pebbles around here. I should collect some and take a closer look.)",
            "nextDialogs": [
              "761979902"
            ]
          },
          "761979902": {
            "id": "761979902",
            "speakerId": 1327,
            "speakerName": "Linnea",
            "text": "(Hmm? Is that Auni? Should I go say hello first?)",
            "nextDialogs": [
              "761979903"
            ]
          },
          "761979903": {
            "id": "761979903",
            "speakerId": 7081,
            "speakerName": "Viljami",
            "text": "The sea...",
            "nextDialogs": [
              "761979904"
            ]
          },
          "761979904": {
            "id": "761979904",
            "speakerId": 21837,
            "speakerName": "Auni",
            "text": "A gateway to another world..."
          }
        }
      }

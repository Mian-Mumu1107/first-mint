      "subId": "4002301",
      "subQuestName": "Pay Shiki Taishou a visit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400230101"
        ],
        "dialogs": {
          "400230101": {
            "id": "400230101",
            "speakerId": 1000,
            "speakerName": "Shiki Taishou",
            "text": "Traveler, Paimon!",
            "nextDialogs": [
              "400230102"
            ]
          },
          "400230102": {
            "id": "400230102",
            "speakerId": 1000,
            "speakerName": "Shiki Taishou",
            "text": "I explained the situation to the Tenryou Commission and showed them the original documentation. In the end, they believed that the Mystic Onmyou Chamber and I were innocent.",
            "nextDialogs": [
              "400230103"
            ]
          },
          "400230103": {
            "id": "400230103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Awesome! Does that mean you can start to focus on your original assignment again?",
            "nextDialogs": [
              "400230104"
            ]
          },
          "400230104": {
            "id": "400230104",
            "speakerId": 1000,
            "speakerName": "Shiki Taishou",
            "text": "That's right. I've also restored the Mystic Onmyou Chamber to its original state — a domain dedicated to honing martial prowess.",
            "nextDialogs": [
              "400230105"
            ]
          },
          "400230105": {
            "id": "400230105",
            "speakerId": 1000,
            "speakerName": "Shiki Taishou",
            "text": "With time, this Domain may exhaust itself of charm magic. When that time comes, I will let it lie dormant so that power can gradually reaccumulate.",
            "nextDialogs": [
              "400230109"
            ]
          },
          "400230109": {
            "id": "400230109",
            "speakerId": 1000,
            "speakerName": "Shiki Taishou",
            "text": "Now might be a good time to give it a try. Are you up for the challenge?",
            "nextDialogs": [
              "400230108"
            ]
          },
          "400230108": {
            "id": "400230108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah! Count Paimon in!"
          }
        }
      }
    }
  ]
}
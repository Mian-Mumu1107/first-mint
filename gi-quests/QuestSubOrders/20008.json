    {
      "subId": "2000801",
      "subQuestName": "Go to the docks and see what's going on",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200080101"
        ],
        "dialogs": {
          "200080101": {
            "id": "200080101",
            "speakerId": 1000,
            "speakerName": "Arthur",
            "text": "Thank you! You saved my life.",
            "nextDialogs": [
              "200080102"
            ]
          },
          "200080102": {
            "id": "200080102",
            "speakerId": 1000,
            "speakerName": "Arthur",
            "text": "Those slimes came out of nowhere. I didn't think they would show up around these parts... Before I knew what was happening, I was surrounded!",
            "nextDialogs": [
              "200080103"
            ]
          },
          "200080103": {
            "id": "200080103",
            "speakerId": 1000,
            "speakerName": "Arthur",
            "text": "Please don't tell my father... He's already been nagging me to stay at home, saying the slimes 'round here are supposed to be getting more hostile recently.",
            "nextDialogs": [
              "200080104"
            ]
          },
          "200080104": {
            "id": "200080104",
            "speakerId": 1000,
            "speakerName": "Arthur",
            "text": "With slimes appearing closer to the city, I've been stuck at home for days now. I managed to slip out today without him noticing.",
            "nextDialogs": [
              "200080105"
            ]
          },
          "200080105": {
            "id": "200080105",
            "speakerId": 1000,
            "speakerName": "Arthur",
            "text": "If you don't mind, could you check if the coast is clear now? And if not, get rid of the slimes for me?",
            "nextDialogs": [
              "200080108",
              "200080109"
            ]
          },
          "200080108": {
            "id": "200080108",
            "speakerId": 1000,
            "speakerName": "Arthur",
            "text": "Great! Looks like my father will never have to find out..."
          },
          "200080109": {
            "id": "200080109",
            "speakerId": 1000,
            "speakerName": "Arthur",
            "text": "B—But... I cannot get my father involved... Please, you're the only one who can help me!"
          }
        }
      }
    },
    {

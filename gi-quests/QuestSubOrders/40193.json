  "subQuests": [
    {
      "subId": "4019301",
      "subQuestName": "Talk to Itto",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401930101"
        ],
        "dialogs": {
          "401930101": {
            "id": "401930101",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Ah, compadre! A little birdie told me you went to Aisa Bathhouse last night!",
            "nextDialogs": [
              "401930102"
            ]
          },
          "401930102": {
            "id": "401930102",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "I'm gettin' the crew together, and we're gonna go there to celebrate! You in?",
            "nextDialogs": [
              "401930103"
            ]
          },
          "401930103": {
            "id": "401930103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But, we were just there...",
            "nextDialogs": [
              "401930104"
            ]
          },
          "401930104": {
            "id": "401930104",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Uh, yeah... But, I bet you were missin' a few people, yeah? Like Shinobu.. and Gorou... and, y'know... Ayato...",
            "nextDialogs": [
              "401930105"
            ]
          },
          "401930105": {
            "id": "401930105",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Basically, Boss heard about the trip, and now he really wants to go.",
            "nextDialogs": [
              "401930106"
            ]
          },
          "401930106": {
            "id": "401930106",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "A—Anyway! Once you're done perusin', come find me, and we'll SOAK! IT! UP!"
          }
        }
      }
    },
    {
      "subId": "4019304",
      "subQuestName": "Leave the venue with Itto",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401930501"
        ],
        "dialogs": {
          "401930501": {
            "id": "401930501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ready!",
            "nextDialogs": [
              "401930502"
            ]
          },
          "401930502": {
            "id": "401930502",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Aww yeah! Next stop, Aisa Bathhouse!"
          }
        }
      }
    },
    {
      "subId": "4019302",
      "subQuestName": "Go to the Aisa Bathhouse",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401930201"
        ],
        "dialogs": {
          "401930201": {
            "id": "401930201",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Following Itto's constant nagging, you all head to Aisa Bathhouse once again...",
            "nextDialogs": [
              "401930202"
            ]
          },
          "401930202": {
            "id": "401930202",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Hahaha! This has gotta be the hottest one! Let's see who can last the longest! Who's in?",
            "nextDialogs": [
              "401930203"
            ]
          },
          "401930203": {
            "id": "401930203",
            "speakerId": 1033,
            "speakerName": "Thoma",
            "text": "Hehe, if you're that excited about it, how can I refuse?",
            "nextDialogs": [
              "401930204"
            ]
          },
          "401930204": {
            "id": "401930204",
            "speakerId": 1049,
            "speakerName": "Kuki Shinobu",
            "text": "Listen... This isn't a sauna...",
            "nextDialogs": [
              "401930205"
            ]
          },
          "401930205": {
            "id": "401930205",
            "speakerId": 1040,
            "speakerName": "Sayu",
            "text": "Ahhh... so warm... *snore*",
            "nextDialogs": [
              "401930206"
            ]
          },
          "401930206": {
            "id": "401930206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, don't fall asleep in the tub!",
            "nextDialogs": [
              "401930207"
            ]
          },
          "401930207": {
            "id": "401930207",
            "speakerId": 1039,
            "speakerName": "Gorou",
            "text": "Uh... My fur is so heavy. I almost feel dizzy...",
            "nextDialogs": [
              "401930208"
            ]
          },
          "401930208": {
            "id": "401930208",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Hahaha! If you can't handle the heat, Gorou, get out of the... tub!",
            "nextDialogs": [
              "401930209"
            ]
          },
          "401930209": {
            "id": "401930209",
            "speakerId": 1038,
            "speakerName": "Kujou Sara",
            "text": "Hey! Stop being so loud!",
            "nextDialogs": [
              "401930210"
            ]
          },
          "401930210": {
            "id": "401930210",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "On the other side...",
            "nextDialogs": [
              "401930211"
            ]
          },
          "401930211": {
            "id": "401930211",
            "speakerId": 1047,
            "speakerName": "Kamisato Ayato",
            "text": "Heh, Itto is as energetic as ever.",
            "nextDialogs": [
              "401930212"
            ]
          },
          "401930212": {
            "id": "401930212",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "It's not good to get distracted during a match, brother.",
            "nextDialogs": [
              "401930213"
            ]
          },
          "401930213": {
            "id": "401930213",
            "speakerId": 1035,
            "speakerName": "Yoimiya",
            "text": "#Whoa! This game is getting heated! What's your next move, {NICKNAME}? What do you two think?",
            "nextDialogs": [
              "401930214"
            ]
          },
          "401930214": {
            "id": "401930214",
            "speakerId": 1037,
            "speakerName": "Sangonomiya Kokomi",
            "text": "Hm... I would take it slow, try to consolidate my advantage.",
            "nextDialogs": [
              "401930215"
            ]
          },
          "401930215": {
            "id": "401930215",
            "speakerId": 1057,
            "speakerName": "Shikanoin Heizou",
            "text": "Or, you could be aggressive... taking a risk isn't a bad idea!",
            "nextDialogs": [
              "401930218"
            ]
          },
          "401930218": {
            "id": "401930218",
            "speakerId": 1047,
            "speakerName": "Kamisato Ayato",
            "text": "#Oh? Very clever, {NICKNAME}! A decisive defeat... I concede! Now, based on the random draw earlier, the next player should be...",
            "nextDialogs": [
              "401930219"
            ]
          },
          "401930219": {
            "id": "401930219",
            "speakerId": 1047,
            "speakerName": "Kamisato Ayato",
            "text": "Ayaka! Have fun, you two.",
            "nextDialogs": [
              "401930220"
            ]
          },
          "401930220": {
            "id": "401930220",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "#Oh, uh... Okay! Go easy on me, {NICKNAME}...",
            "nextDialogs": [
              "401930221"
            ]
          },
          "401930221": {
            "id": "401930221",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Ayato must have lost to me on purpose to give Ayaka more time to play... Always up to something, that one...)"
          }
        }
      }
    },
    {
      "subId": "4019303",
      "subQuestName": "Go to the Aisa Bathhouse",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401930301"
        ],
        "dialogs": {
          "401930301": {
            "id": "401930301",
            "speakerId": 3038,
            "speakerName": "Aikawa Susumu",
            "text": "Boss! The Mikawa Flower Festival was a huge success for us! We had three times more visitors than usual!",
            "nextDialogs": [
              "401930302"
            ]
          },
          "401930302": {
            "id": "401930302",
            "speakerId": 3038,
            "speakerName": "Aikawa Susumu",
            "text": "Based on what we've made so far, I think we'll be able to make... this much!",
            "nextDialogs": [
              "401930303"
            ]
          },
          "401930303": {
            "id": "401930303",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "That's great news! We might even beat Yae Publishing house this month...",
            "nextDialogs": [
              "401930304"
            ]
          },
          "401930304": {
            "id": "401930304",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Oh? You look pleased about something... Having a party without me?",
            "nextDialogs": [
              "401930305"
            ]
          },
          "401930305": {
            "id": "401930305",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "Oh, hehe... It's nothing...",
            "nextDialogs": [
              "401930306"
            ]
          },
          "401930306": {
            "id": "401930306",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "I forgot to share some good news with you...",
            "nextDialogs": [
              "401930307"
            ]
          },
          "401930307": {
            "id": "401930307",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Thirty percent of the proceeds from the festival have been transferred to Yae Publishing House. We're expecting record profit this month... Don't you think congratulations are in order?",
            "nextDialogs": [
              "401930308"
            ]
          },
          "401930308": {
            "id": "401930308",
            "speakerId": 1097,
            "speakerName": "Yumemizuki Mizuki",
            "text": "What!?",
            "nextDialogs": [
              "401930309"
            ]
          },
          "401930309": {
            "id": "401930309",
            "speakerId": 3038,
            "speakerName": "Aikawa Susumu",
            "text": "W—Well, boss... I guess congratulations ARE in order... This is our 333rd time competing against Yae Publishing House in sales, and our best showing to date — second place!",
            "nextDialogs": [
              "401930310"
            ]
          },
          "401930310": {
            "id": "401930310",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Hehehe...",
            "nextDialogs": [
              "401930311"
            ]
          },
          "401930311": {
            "id": "401930311",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "...May this be a night of sweet dreams for all."
          }
        }
      }
    },
    {
      "subId": "4019304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401930401"
        ],
        "dialogs": {
          "401930401": {
            "id": "401930401",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Well? Ready to get your soak on?"
          }
        }
      }
    },
    {
      "subId": "4019306",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401930601"
        ],
        "dialogs": {
          "401930601": {
            "id": "401930601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just a sec...",
            "nextDialogs": [
              "401930602"
            ]
          },
          "401930602": {
            "id": "401930602",
            "speakerId": 1044,
            "speakerName": "Arataki Itto",
            "text": "Oh, compadre... Don't tell me the gaming bug's gotcha bad, like Akira and the others... I mean, the games are fun, but they'll still be there after a good soak!"
          }
        }
      }
    },
    {
      "subId": "4019307",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401930701"
        ],
        "dialogs": {
          "401930701": {
            "id": "401930701",
            "speakerId": 12278,
            "speakerName": "Mamoru",
            "text": "Oh, you didn't go to the hot springs?",
            "nextDialogs": [
              "401930702"
            ]
          },
          "401930702": {
            "id": "401930702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well now, I don't see you going either...",
            "nextDialogs": [
              "401930703"
            ]
          },
          "401930703": {
            "id": "401930703",
            "speakerId": 12276,
            "speakerName": "Akira",
            "text": "...We did go with the Boss, once. But then he got it into his head to start some sort of competition...",
            "nextDialogs": [
              "401930704"
            ]
          },
          "401930704": {
            "id": "401930704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...What sort of competition?",
            "nextDialogs": [
              "401930705"
            ]
          },
          "401930705": {
            "id": "401930705",
            "speakerId": 12277,
            "speakerName": "Genta",
            "text": "Um, I forgot. The only thing I remember is almost passing out from the heat..."
          }
        }
      }
    }
  ]
}
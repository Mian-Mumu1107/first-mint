  "subQuests": [
    {
      "subId": "7227201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722720101"
        ],
        "dialogs": {
          "722720101": {
            "id": "722720101",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "Hello, see anything you like? If you can't find the right one, I can have one custom-made for you.",
            "nextDialogs": [
              "722720102"
            ]
          },
          "722720102": {
            "id": "722720102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I've got some treasure I want to sell.",
            "nextDialogs": [
              "722720103"
            ]
          },
          "722720103": {
            "id": "722720103",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "Eh? Well, to tell you the truth, we've managed to restore a regular supply of goods, and we don't really make collecting odds and ends a habit, in any case...",
            "nextDialogs": [
              "722720104"
            ]
          },
          "722720104": {
            "id": "722720104",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "But just from looking at you, I think it's safe to assume that it's something most interesting indeed.",
            "nextDialogs": [
              "722720105"
            ]
          },
          "722720105": {
            "id": "722720105",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "Well... Why don't you let me have a look at it, then?",
            "nextDialogs": [
              "722720106"
            ]
          },
          "722720106": {
            "id": "722720106",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You tell Mikoshi Genichirou about the Dragonbone Orb.",
            "nextDialogs": [
              "722720107"
            ]
          },
          "722720107": {
            "id": "722720107",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "Hmm...",
            "nextDialogs": [
              "722720108"
            ]
          },
          "722720108": {
            "id": "722720108",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "I'll be honest with you. While this is quite the curious tale, it does seem a bit too out there...",
            "nextDialogs": [
              "722720109"
            ]
          },
          "722720109": {
            "id": "722720109",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "This object falls somewhat outside my area of expertise.",
            "nextDialogs": [
              "722720110"
            ]
          },
          "722720110": {
            "id": "722720110",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "Please, don't scoff. I am but a mere craftsman myself...",
            "nextDialogs": [
              "722720120"
            ]
          },
          "722720120": {
            "id": "722720120",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "How about this, then? 80,000 and 5 Sashimi Platters. Those dishes aren't cheap by any means, mind you.",
            "nextDialogs": [
              "722720111"
            ]
          },
          "722720111": {
            "id": "722720111",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "If you agree to this price, I will buy this treasure.",
            "nextDialogs": [
              "722720113",
              "722720116",
              "722720118"
            ]
          },
          "722720113": {
            "id": "722720113",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "I'm not sure at the moment. I'll need to give it some thought.",
            "nextDialogs": [
              "722720114"
            ]
          },
          "722720114": {
            "id": "722720114",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "If the situation is right, I might be able to modify this into a special netsuke and sell it for a decent price."
          },
          "722720116": {
            "id": "722720116",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "In that case, please take this Mora. As for me, I'm going to go look into this item."
          },
          "722720118": {
            "id": "722720118",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "Fair enough. I need to give this a little thought myself.",
            "nextDialogs": [
              "722720119"
            ]
          },
          "722720119": {
            "id": "722720119",
            "speakerId": 1000,
            "speakerName": "Mikoshi Genichirou",
            "text": "You can come to me again once you've thought things over."
          }
        }
      }
    },

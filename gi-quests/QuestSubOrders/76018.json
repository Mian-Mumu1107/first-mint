    {
      "subId": "7601826",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760181301"
        ],
        "dialogs": {
          "760181301": {
            "id": "760181301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? Why won't it open? Isn't this the right key...? Hmm, what should we do now?",
            "nextDialogs": [
              "760181302"
            ]
          },
          "760181302": {
            "id": "760181302",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "...",
            "nextDialogs": [
              "760181303"
            ]
          },
          "760181303": {
            "id": "760181303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow! Paimon didn't know Valberry Jelly had that kind of power. It looks like the rest of this rescue mission's gonna be an easy-peasy piece of cake!",
            "nextDialogs": [
              "760181305"
            ]
          },
          "760181305": {
            "id": "760181305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... You're right, it does look paler now. It looks weaker than before, too.",
            "nextDialogs": [
              "760181307"
            ]
          },
          "760181307": {
            "id": "760181307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did it use up all its strength just now? No, no, that can't be it! Valberry Jelly was already running low on energy...",
            "nextDialogs": [
              "760181308"
            ]
          },
          "760181308": {
            "id": "760181308",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "...",
            "nextDialogs": [
              "760181309"
            ]
          },
          "760181309": {
            "id": "760181309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "In the end... W—We still couldn't make it in time...",
            "nextDialogs": [
              "760181310"
            ]
          },
          "760181310": {
            "id": "760181310",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "...",
            "nextDialogs": [
              "760181311"
            ]
          },
          "760181311": {
            "id": "760181311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are you angry? Or sad? Or not feeling well? Hmm, it doesn't seem like any of those... Ugh, this is so frustrating! How are we supposed to know what it's trying to say?",
            "nextDialogs": [
              "760181312"
            ]
          },
          "760181312": {
            "id": "760181312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This seems like a gesture it would only make for one of its own.",
            "nextDialogs": [
              "760181313"
            ]
          },
          "760181313": {
            "id": "760181313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Does that mean... even though we couldn't save its friends, it still wants to thank us? Valberry Jelly...",
            "nextDialogs": [
              "760181314"
            ]
          },
          "760181314": {
            "id": "760181314",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It seems like jellyfish have more heart than the Fatui ever will. Those guys build all those horrible machines, and they don't care about life one bit!",
            "nextDialogs": [
              "760181315"
            ]
          },
          "760181315": {
            "id": "760181315",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So really, who's the one with no brain?"
          }
        }
      }
    },

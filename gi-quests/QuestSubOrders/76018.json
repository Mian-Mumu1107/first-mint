    {
      "subId": "7601820",
      "subQuestName": "Follow the jellyfish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760180501"
        ],
        "dialogs": {
          "760180501": {
            "id": "760180501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, Valberry Jelly is floating! This must be what you're really like, huh? Paimon knew those nasty machines had something to do with it!",
            "nextDialogs": [
              "760180502"
            ]
          },
          "760180502": {
            "id": "760180502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is it trying to lead us somewhere? Let's follow and see."
          }
        }
      }
    },
    {
      "subId": "7601821",
      "subQuestName": "Follow the jellyfish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7601818",
      "subQuestName": "Follow the jellyfish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760180601"
        ],
        "dialogs": {
          "760180601": {
            "id": "760180601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Valberry Jelly's slipped into that big shell... and ooh, is that something buried under the sand? A thank-you gift, maybe?",
            "nextDialogs": [
              "760180602"
            ]
          },
          "760180602": {
            "id": "760180602",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "...",
            "nextDialogs": [
              "760180603"
            ]
          },
          "760180603": {
            "id": "760180603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aww, it really was a gift! Valberry Jelly does have good manners!",
            "nextDialogs": [
              "760180605",
              "760180607"
            ]
          },
          "760180605": {
            "id": "760180605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're both good kids with simple hearts. We don't need words to understand each other.",
            "nextDialogs": [
              "760180608"
            ]
          },
          "760180608": {
            "id": "760180608",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It must want to say, \"Thank you for saving me! This beach is full of hidden treasures. Go ahead, please take them all!\"",
            "nextDialogs": [
              "760180609"
            ]
          },
          "760180609": {
            "id": "760180609",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "..."
          },
          "760180607": {
            "id": "760180607",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You always overthink everything! Paimon and Valberry Jelly are just good kids with simple hearts. We don't need words to understand each other."
          }
        }
      }
    },
    {
      "subId": "7601804",
      "subQuestName": "(test) Discarded",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760180401"
        ],
        "dialogs": {
          "760180401": {
            "id": "760180401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's another trapped jellyfish, and it doesn't look healthy. Come on, we've gotta get it out!"
          }
        }
      }
    },
    {
      "subId": "7601805",
      "subQuestName": "Examine the sand piles nearby",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7601806",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760180801"
        ],
        "dialogs": {
          "760180801": {
            "id": "760180801",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's a jellyfish buried here! And it's still alive!",
            "nextDialogs": [
              "760180802"
            ]
          },
          "760180802": {
            "id": "760180802",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So it wanted us to save its friends? Hmm... Paimon completely misunderstood what Valberry Jelly was trying to say...",
            "nextDialogs": [
              "760180803"
            ]
          },
          "760180803": {
            "id": "760180803",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "...",
            "nextDialogs": [
              "760180804"
            ]
          },
          "760180804": {
            "id": "760180804",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's one of the Fatui's nasty machines! Shoo, shoo! Paimon's not gonna let you hurt Valberry Jelly!"
          }
        }
      }
    },
    {
      "subId": "7601822",
      "subQuestName": "Destroy the recon bots",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7601825",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760180701"
        ],
        "dialogs": {
          "760180701": {
            "id": "760180701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "W—We didn't make it in time... Hmm, is Valberry Jelly mourning its friends?",
            "nextDialogs": [
              "760180702"
            ]
          },
          "760180702": {
            "id": "760180702",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "...",
            "nextDialogs": [
              "760180703"
            ]
          },
          "760180703": {
            "id": "760180703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Do jellyfish really not have the ability to think? It sure looks sad to Paimon...",
            "nextDialogs": [
              "760180704"
            ]
          },
          "760180704": {
            "id": "760180704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Perhaps emotions don't require thoughts.",
            "nextDialogs": [
              "760180705"
            ]
          },
          "760180705": {
            "id": "760180705",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#You're right, {NICKNAME}. You can't just think your way out of feeling sad.",
            "nextDialogs": [
              "760180706"
            ]
          },
          "760180706": {
            "id": "760180706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Maybe feelings like that... just rise up on their own, from somewhere deep inside us.",
            "nextDialogs": [
              "760180707"
            ]
          },
          "760180707": {
            "id": "760180707",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You look so sad... No tears, no words, not even a sound... Poor thing. What can we do to make you feel better?",
            "nextDialogs": [
              "760180708"
            ]
          },
          "760180708": {
            "id": "760180708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There might be other jellyfish that still need our help.",
            "nextDialogs": [
              "760180709"
            ]
          },
          "760180709": {
            "id": "760180709",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Y—You're right... So many of them have already... met their jelly molds... The Fatui really don't care at all what happens to them!",
            "nextDialogs": [
              "760180710"
            ]
          },
          "760180710": {
            "id": "760180710",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This place is huge. There's gotta be tons of those nasty machines around. We can't let the jellyfish be abandoned on the beach like this!",
            "nextDialogs": [
              "760180711"
            ]
          },
          "760180711": {
            "id": "760180711",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's certain Valberry Jelly can't be the only jellyfish trapped in this base. Let's go find the others!",
            "nextDialogs": [
              "760180712"
            ]
          },
          "760180712": {
            "id": "760180712",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "..."
          }
        }
      }
    },

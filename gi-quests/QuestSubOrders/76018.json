    {
      "subId": "7601817",
      "subQuestName": "Find and rescue the jellyfish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760181701"
        ],
        "dialogs": {
          "760181701": {
            "id": "760181701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Valberry Jelly... It doesn't even look like itself anymore... Paimon can't believe it used its power again just to help us...",
            "nextDialogs": [
              "760181702"
            ]
          },
          "760181702": {
            "id": "760181702",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "...",
            "nextDialogs": [
              "760181703"
            ]
          },
          "760181703": {
            "id": "760181703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's a gesture it would only make for one of its own.... Is it saying goodbye?"
          }
        }
      }
    },
    {
      "subId": "7601810",
      "subQuestName": "Check on the jellyfish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760181001"
        ],
        "dialogs": {
          "760181001": {
            "id": "760181001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's another one! Awesome, we've got to save it this time!",
            "nextDialogs": [
              "760181002"
            ]
          },
          "760181002": {
            "id": "760181002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Don't open that by yourself! We're almost there! Whatever you do, don't use up your strength!",
            "nextDialogs": [
              "760181003"
            ]
          },
          "760181003": {
            "id": "760181003",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "..."
          }
        }
      }
    },
    {
      "subId": "7601811",
      "subQuestName": "Look for the ID card inside the building",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760181101"
        ],
        "dialogs": {
          "760181101": {
            "id": "760181101",
            "speakerId": 22131,
            "speakerName": "Trapped Jellyfish",
            "text": "...",
            "nextDialogs": [
              "760181102"
            ]
          },
          "760181102": {
            "id": "760181102",
            "speakerId": 22131,
            "speakerName": "Trapped Jellyfish",
            "text": "(It seems to have no energy left... It needs to be rescued.)"
          }
        }
      }
    },
    {
      "subId": "7601812",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760181501"
        ],
        "dialogs": {
          "760181501": {
            "id": "760181501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? The barrier suddenly activated! Oh no... we're locked in!",
            "nextDialogs": [
              "760181502"
            ]
          },
          "760181502": {
            "id": "760181502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No way... Even Valberry Jelly and the others got knocked to the ground... How dare they!",
            "nextDialogs": [
              "760181503"
            ]
          },
          "760181503": {
            "id": "760181503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wh—What do we do now?! We're trapped too. How are we supposed to help the jellies like this...?",
            "nextDialogs": [
              "760181506"
            ]
          },
          "760181506": {
            "id": "760181506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Being stuck with {NICKNAME} isn't so scary. But Paimon's worried about Valberry Jelly and the others...",
            "nextDialogs": [
              "760181507"
            ]
          },
          "760181507": {
            "id": "760181507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Umm, since Valberry Jelly and Paimon can both fly, th—then maybe Paimon might be able to do the same thing Valberry Jelly did, right?",
            "nextDialogs": [
              "760181508"
            ]
          },
          "760181508": {
            "id": "760181508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...!",
            "nextDialogs": [
              "760181509"
            ]
          },
          "760181509": {
            "id": "760181509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's open! It actually opened! Let's go save them!"
          }
        }
      }
    },
    {
      "subId": "7601814",
      "subQuestName": "Destroy the kuuvahki separator",
      "sceneId": null,
      "locations": [],
      "dialogue": {

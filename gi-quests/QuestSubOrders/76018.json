  },
  "subQuests": [
    {
      "subId": "7601801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760180101"
        ],
        "dialogs": {
          "760180101": {
            "id": "760180101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's all limp and floppy... like someone dropped a Valberry Jelly right here on the floor. Paimon nearly didn't notice it when we passed by earlier.",
            "nextDialogs": [
              "760180102"
            ]
          },
          "760180102": {
            "id": "760180102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It doesn't seem to have noticed us... Is it taking a nap?",
            "nextDialogs": [
              "760180103"
            ]
          },
          "760180103": {
            "id": "760180103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Jellyfish don't have brains, so they probably don't need sleep...",
            "nextDialogs": [
              "760180104"
            ]
          },
          "760180104": {
            "id": "760180104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What!? N—No brain... There's really a creature with no brain!?",
            "nextDialogs": [
              "760180105"
            ]
          },
          "760180105": {
            "id": "760180105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But even without a brain, it looks like it can still feel pain... Paimon gets the impression it isn't very happy.",
            "nextDialogs": [
              "760180106"
            ]
          },
          "760180106": {
            "id": "760180106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We've got to get this barrier open and see if it's okay! But how are we supposed to do that?",
            "nextDialogs": [
              "760180108"
            ]
          },
          "760180108": {
            "id": "760180108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph! You make it sound like Paimon's brain doesn't work...",
            "nextDialogs": [
              "760180110"
            ]
          },
          "760180110": {
            "id": "760180110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hmph! Paimon's just not good at solving puzzles, that's all. But when it comes to finding tasty stuff... you've got nothing on Paimon, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "7601802",
      "subQuestName": "Rescue the fallen jellyfish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760180201"
        ],
        "dialogs": {
          "760180201": {
            "id": "760180201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "W—We didn't make it in time... Hmm, is Valberry Jelly mourning its friends?",
            "nextDialogs": [
              "760180202"
            ]
          },
          "760180202": {
            "id": "760180202",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "...",
            "nextDialogs": [
              "760180203"
            ]
          },
          "760180203": {
            "id": "760180203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Do jellyfish really not have the ability to think? It sure looks sad to Paimon...",
            "nextDialogs": [
              "760180204"
            ]
          },
          "760180204": {
            "id": "760180204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Perhaps emotions don't require thoughts.",
            "nextDialogs": [
              "760180205"
            ]
          },
          "760180205": {
            "id": "760180205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#You're right, {NICKNAME}. You can't just think your way out of feeling sad.",
            "nextDialogs": [
              "760180206"
            ]
          },
          "760180206": {
            "id": "760180206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Maybe feelings like that... just rise up on their own, from somewhere deep inside us.",
            "nextDialogs": [
              "760180207"
            ]
          },
          "760180207": {
            "id": "760180207",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "...",
            "nextDialogs": [
              "760180208"
            ]
          },
          "760180208": {
            "id": "760180208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You look so sad... No tears, no words, not even a sound... Poor thing. What can we do to make you feel better?",
            "nextDialogs": [
              "760180209"
            ]
          },
          "760180209": {
            "id": "760180209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There might be other jellyfish that still need our help.",
            "nextDialogs": [
              "760180210"
            ]
          },
          "760180210": {
            "id": "760180210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Y—You're right... So many of them have already... met their jelly molds... The Fatui really don't care at all what happens to them!",
            "nextDialogs": [
              "760180211"
            ]
          },
          "760180211": {
            "id": "760180211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This place is huge. There's gotta be tons of those nasty machines around. Valberry Jelly can't be the only one that's been trapped.",
            "nextDialogs": [
              "760180212"
            ]
          },
          "760180212": {
            "id": "760180212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's go get them all!",
            "nextDialogs": [
              "760180213"
            ]
          },
          "760180213": {
            "id": "760180213",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "..."
          }
        }
      }
    },
    {
      "subId": "7601803",
      "subQuestName": "Talk to Paimon $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760180301"
        ],
        "dialogs": {
          "760180301": {
            "id": "760180301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They seriously left the key right by the door...? The Fatui here aren't exactly the brightest, huh?",
            "nextDialogs": [
              "760180303",
              "760180306"
            ]
          },
          "760180303": {
            "id": "760180303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right! If they were clever and actually tried, we'd never have found that key so easily!",
            "nextDialogs": [
              "760180304"
            ]
          },
          "760180304": {
            "id": "760180304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Then that jellyfish... Hmm, how about we call it \"Valberry Jelly\"? ...It might not have made it out in time...",
            "nextDialogs": [
              "760180308"
            ]
          },
          "760180308": {
            "id": "760180308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, the barrier's open, so why's it still lying there?",
            "nextDialogs": [
              "760180309"
            ]
          },
          "760180309": {
            "id": "760180309",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "The rescued jellyfish tries to move, but its body gives out, and it collapses back onto the ground...",
            "nextDialogs": [
              "760180310"
            ]
          },
          "760180310": {
            "id": "760180310",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "...",
            "nextDialogs": [
              "760180311"
            ]
          },
          "760180311": {
            "id": "760180311",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "I—It still looks like it's in pain... Paimon thought it was because of the barrier...",
            "nextDialogs": [
              "760180312"
            ]
          },
          "760180312": {
            "id": "760180312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe the kuuvahki is just too weak around here.",
            "nextDialogs": [
              "760180313"
            ]
          },
          "760180313": {
            "id": "760180313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Are you not sensing much kuuvahki, {NICKNAME}?",
            "nextDialogs": [
              "760180314"
            ]
          },
          "760180314": {
            "id": "760180314",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You've been sensing it just fine since we arrived in Nod-Krai.",
            "nextDialogs": [
              "760180315"
            ]
          },
          "760180315": {
            "id": "760180315",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Could it be feeling this way because the environment suddenly changed?",
            "nextDialogs": [
              "760180316"
            ]
          },
          "760180316": {
            "id": "760180316",
            "speakerId": 21923,
            "speakerName": "\"Valberry Jelly\"",
            "text": "...",
            "nextDialogs": [
              "760180317"
            ]
          },
          "760180317": {
            "id": "760180317",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hang in there. We'll find a way to get you out of here!",
            "nextDialogs": [
              "760180318"
            ]
          },
          "760180318": {
            "id": "760180318",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Come on, {NICKNAME}, think of something!"
          },
          "760180306": {
            "id": "760180306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That doesn't sound like much of a compliment to Paimon...",
            "nextDialogs": [
              "760180307"
            ]
          },
          "760180307": {
            "id": "760180307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "If Paimon hadn't noticed this little puddle of Valberry Jelly... Hey, that's what we should call it! ...We probably would've missed the chance to save it, right?"
          }
        }
      }
    },
    {
      "subId": "7601819",

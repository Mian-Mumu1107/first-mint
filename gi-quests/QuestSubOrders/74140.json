    {
      "subId": "7414011",
      "subQuestName": "Talk to Canotila",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741401101"
        ],
        "dialogs": {
          "741401101": {
            "id": "741401101",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "Hey, we meet again. Hmm? You're with Paimon this time?",
            "nextDialogs": [
              "741401102"
            ]
          },
          "741401102": {
            "id": "741401102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Paimon was here when we meditated here the last time...",
            "nextDialogs": [
              "741401103"
            ]
          },
          "741401103": {
            "id": "741401103",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "Is that so? I don't remember.",
            "nextDialogs": [
              "741401104"
            ]
          },
          "741401104": {
            "id": "741401104",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "No matter. It's all thanks to you that I found the location of the Looking Glass and the flowers that are about to bloom, and deepened my understanding of this place.",
            "nextDialogs": [
              "741401105"
            ]
          },
          "741401105": {
            "id": "741401105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... Talking to Canotila is as confusing as ever.",
            "nextDialogs": [
              "741401106"
            ]
          },
          "741401106": {
            "id": "741401106",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "Woof!",
            "nextDialogs": [
              "741401107"
            ]
          },
          "741401107": {
            "id": "741401107",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "Hmm? But...",
            "nextDialogs": [
              "741401108"
            ]
          },
          "741401108": {
            "id": "741401108",
            "speakerId": 1002,
            "speakerName": "Puppy",
            "text": "Woof, woof!",
            "nextDialogs": [
              "741401109"
            ]
          },
          "741401109": {
            "id": "741401109",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "Okay, okay! I hear you.",
            "nextDialogs": [
              "741401110"
            ]
          },
          "741401110": {
            "id": "741401110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "(Hmm...? She's talking to the puppy? Could it be that Melusine can generally communicate with dogs?)",
            "nextDialogs": [
              "741401111"
            ]
          },
          "741401111": {
            "id": "741401111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(How incredible.)",
            "nextDialogs": [
              "741401112"
            ]
          },
          "741401112": {
            "id": "741401112",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "Well, I guess that's that. I'll see you next time. Hmph! Even if you said that, I'm still coming back to play with you.",
            "nextDialogs": [
              "741401113"
            ]
          },
          "741401113": {
            "id": "741401113",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "#Let's go, {M#Mr.}{F#Ms.} {NICKNAME}, Paimon!"
          }
        }
      }
    },
    {
      "subId": "7414013",
      "subQuestName": "Talk to Canotila",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741401301"
        ],
        "dialogs": {
          "741401301": {
            "id": "741401301",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "Well. Here we are again...",
            "nextDialogs": [
              "741401302"
            ]
          },
          "741401302": {
            "id": "741401302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What is it?",
            "nextDialogs": [
              "741401303"
            ]
          },
          "741401303": {
            "id": "741401303",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "I feel really bad for saying this since everyone's so nice to me, all of you, but...",
            "nextDialogs": [
              "741401304"
            ]
          },
          "741401304": {
            "id": "741401304",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "Don't you feel the real world is so frighteningly dull? Don't you think the world in the Book is far more beautiful?",
            "nextDialogs": [
              "741401306",
              "741401308",
              "741401310"
            ]
          },
          "741401306": {
            "id": "741401306",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Really? You think so too, huh?",
            "nextDialogs": [
              "741401311"
            ]
          },
          "741401311": {
            "id": "741401311",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "I still feel the world in the Book of Revealing is much more appealing. There are dew-covered petals everywhere, and I've finally made friends with the puppy.",
            "nextDialogs": [
              "741401312"
            ]
          },
          "741401312": {
            "id": "741401312",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That puppy... Uh, Canotila, can you communicate with dogs?",
            "nextDialogs": [
              "741401313"
            ]
          },
          "741401313": {
            "id": "741401313",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "Hm? Of course not. However, the puppy in the Book of Revealing is special. Or maybe, I'm special?",
            "nextDialogs": [
              "741401314"
            ]
          },
          "741401314": {
            "id": "741401314",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "I've been meditating to travel to the world in the Book, and then one day, the puppy's usual barking turned into something I could understand.",
            "nextDialogs": [
              "741401315"
            ]
          },
          "741401315": {
            "id": "741401315",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "As for what we talked about... He asked me to go and never come back.",
            "nextDialogs": [
              "741401316"
            ]
          },
          "741401316": {
            "id": "741401316",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "But... I still want to see the sunflowers bloom...",
            "nextDialogs": [
              "741401317"
            ]
          },
          "741401317": {
            "id": "741401317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "741401318"
            ]
          },
          "741401318": {
            "id": "741401318",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "I—Is that so... Take care, Canotila! We'll be going!"
          },
          "741401308": {
            "id": "741401308",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "Is that so...? Maybe that's right. I'm not normal."
          },
          "741401310": {
            "id": "741401310",
            "speakerId": 1000,
            "speakerName": "Canotila",
            "text": "#Looks like {M#Mr.}{F#Ms.} {NICKNAME} is the toughest of all."
          }
        }
      }
    }
  ]
}
    {
      "subId": "7301616",
      "subQuestName": "Talk to Arabalika",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730161601"
        ],
        "dialogs": {
          "730161601": {
            "id": "730161601",
            "speakerId": 1000,
            "speakerName": "Arabalika",
            "text": "Hmph. Arabalika admits you have some skills.",
            "nextDialogs": [
              "730161602"
            ]
          },
          "730161602": {
            "id": "730161602",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "He praised us! Hehe.",
            "nextDialogs": [
              "730161603"
            ]
          },
          "730161603": {
            "id": "730161603",
            "speakerId": 1000,
            "speakerName": "Arabalika",
            "text": "We can prepare to go underground now. Follow me.",
            "nextDialogs": [
              "730161604"
            ]
          },
          "730161604": {
            "id": "730161604",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Okay, let's follow Arabalika quickly."
          }
        }
      }
    },
    {
      "subId": "7301607",
      "subQuestName": "Follow Arabalika",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730160701"
        ],
        "dialogs": {
          "730160701": {
            "id": "730160701",
            "speakerId": 1000,
            "speakerName": "Arabalika",
            "text": "We've defeated the Big Iron Chunk. Follow the water. We will go under the ground.",
            "nextDialogs": [
              "730160702"
            ]
          },
          "730160702": {
            "id": "730160702",
            "speakerId": 1000,
            "speakerName": "Arabalika",
            "text": "Arabalika has not been here for a long time. Everything has changed. Maybe there are also Big Iron Chunks under the ground. Arabalika smells iron. Bad smell. Be careful.",
            "nextDialogs": [
              "730160703"
            ]
          },
          "730160703": {
            "id": "730160703",
            "speakerId": 1000,
            "speakerName": "Arabalika",
            "text": "#Nara {NICKNAME} is strong. No need to fear. But Paimon is like Aranakula. Weak. Be careful. Mushroom might eat you.",
            "nextDialogs": [
              "730160704"
            ]
          },
          "730160704": {
            "id": "730160704",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Urgh... Anyone would look weak compared to you, okay? We met many Aranara before, but Paimon doesn't think any of them can defeat a Ruin Guard with one blow...",
            "nextDialogs": [
              "730160705"
            ]
          },
          "730160705": {
            "id": "730160705",
            "speakerId": 1000,
            "speakerName": "Arabalika",
            "text": "Paimon knows too little about Aranara. Aradasha would defeat a Big Iron Chunk before you could blink.",
            "nextDialogs": [
              "730160706"
            ]
          },
          "730160706": {
            "id": "730160706",
            "speakerId": 1000,
            "speakerName": "Arabalika",
            "text": "Aradasha's Ararakalari was very powerful in the past.",
            "nextDialogs": [
              "730160707"
            ]
          },
          "730160707": {
            "id": "730160707",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "In the past? What about now?",
            "nextDialogs": [
              "730160708"
            ]
          },
          "730160708": {
            "id": "730160708",
            "speakerId": 1000,
            "speakerName": "Arabalika",
            "text": "Now? Aradasha is not in the \"now.\" That's why Arabalika must train even harder. Train Ararakalari.",
            "nextDialogs": [
              "730160709"
            ]
          },
          "730160709": {
            "id": "730160709",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon wishes she could learn how to use Ararakalari too...",
            "nextDialogs": [
              "730160711",
              "730160715"
            ]
          },
          "730160711": {
            "id": "730160711",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Hehe, and Paimon would protect {NICKNAME} instead!",
            "nextDialogs": [
              "730160712"
            ]
          },
          "730160712": {
            "id": "730160712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm counting on you, Paimon!",
            "nextDialogs": [
              "730160713"
            ]
          },
          "730160713": {
            "id": "730160713",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Leave it to Paimon! You can leave everything to Paimon!",
            "nextDialogs": [
              "730160718"
            ]
          },
          "730160718": {
            "id": "730160718",
            "speakerId": 1000,
            "speakerName": "Arabalika",
            "text": "Paimon loves to dream. A good thing? A bad thing? Can't tell. But we need to look for a stone device. Make water go away. We cannot go underground otherwise.",
            "nextDialogs": [
              "730160719"
            ]
          },
          "730160719": {
            "id": "730160719",
            "speakerId": 1000,
            "speakerName": "Arabalika",
            "text": "Aranara can dig into the soil, but not water.",
            "nextDialogs": [
              "730160720"
            ]
          },
          "730160720": {
            "id": "730160720",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Okay, {NICKNAME}, let's have a look around!"
          },
          "730160715": {
            "id": "730160715",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon can if Paimon tries!",
            "nextDialogs": [
              "730160716"
            ]
          },
          "730160716": {
            "id": "730160716",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Most people who say that are...",
            "nextDialogs": [
              "730160717"
            ]
          },
          "730160717": {
            "id": "730160717",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Should Paimon ask Arabalika to teach Paimon after we eat and rest in a safe place?"
          }
        }
      }
    },
    {
      "subId": "7301608",

  "subQuests": [
    {
      "subId": "7451201",
      "subQuestName": "Talk to Frejus",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745120101"
        ],
        "dialogs": {
          "745120101": {
            "id": "745120101",
            "speakerId": 30509,
            "speakerName": "Frejus",
            "text": "The data indicates that this invention is a success. Thank you both.",
            "nextDialogs": [
              "745120102"
            ]
          },
          "745120102": {
            "id": "745120102",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "Yup, thanks!",
            "nextDialogs": [
              "745120103"
            ]
          },
          "745120103": {
            "id": "745120103",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "See, I told you this would go well! With your genius in play, Frejus, this remote-controlled cannon thing was a piece of cake!",
            "nextDialogs": [
              "745120104"
            ]
          },
          "745120104": {
            "id": "745120104",
            "speakerId": 30509,
            "speakerName": "Frejus",
            "text": "I—I suppose...",
            "nextDialogs": [
              "745120105"
            ]
          },
          "745120105": {
            "id": "745120105",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "In that case, let's get cracking with the next awesome gadget — and I have a great idea for one, too!",
            "nextDialogs": [
              "745120106"
            ]
          },
          "745120106": {
            "id": "745120106",
            "speakerId": 30509,
            "speakerName": "Frejus",
            "text": "What?",
            "nextDialogs": [
              "745120107"
            ]
          },
          "745120107": {
            "id": "745120107",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "What about an airship that can explore the skies?",
            "nextDialogs": [
              "745120108"
            ]
          },
          "745120108": {
            "id": "745120108",
            "speakerId": 30509,
            "speakerName": "Frejus",
            "text": "Um...",
            "nextDialogs": [
              "745120109"
            ]
          },
          "745120109": {
            "id": "745120109",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "Or a mega drill that can bore deep underground?",
            "nextDialogs": [
              "745120110"
            ]
          },
          "745120110": {
            "id": "745120110",
            "speakerId": 30509,
            "speakerName": "Frejus",
            "text": "Hah...",
            "nextDialogs": [
              "745120111"
            ]
          },
          "745120111": {
            "id": "745120111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Feels like she's trying to make his life difficult on purpose...",
            "nextDialogs": [
              "745120112"
            ]
          },
          "745120112": {
            "id": "745120112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Those might be a bit of a tall order...",
            "nextDialogs": [
              "745120113"
            ]
          },
          "745120113": {
            "id": "745120113",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "I mean, you're the one who rejected the Institute's offer three times. I'm sure you can make stuff even they can't, right?",
            "nextDialogs": [
              "745120114"
            ]
          },
          "745120114": {
            "id": "745120114",
            "speakerId": 30509,
            "speakerName": "Frejus",
            "text": "Of course. I can only say that it will be tricky, but not a big deal.",
            "nextDialogs": [
              "745120115"
            ]
          },
          "745120115": {
            "id": "745120115",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "*sigh* You know what? I don't want those things anymore. Flying up into the sky or delving into the earth both sound boring. It's cold up there, and it's stuffy down there.",
            "nextDialogs": [
              "745120116"
            ]
          },
          "745120116": {
            "id": "745120116",
            "speakerId": 30509,
            "speakerName": "Frejus",
            "text": "I share that sentiment.",
            "nextDialogs": [
              "745120117"
            ]
          },
          "745120117": {
            "id": "745120117",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "In that case, could you make something that we'd use normally? ...Ooh, that's right! I love sleeping in in the mornings, so could you make me an automatic oven that bakes on its own?",
            "nextDialogs": [
              "745120118"
            ]
          },
          "745120118": {
            "id": "745120118",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well now, that sounds possible.",
            "nextDialogs": [
              "745120119"
            ]
          },
          "745120119": {
            "id": "745120119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Her earlier suggestions were intentionally impossible, I think.",
            "nextDialogs": [
              "745120120"
            ]
          },
          "745120120": {
            "id": "745120120",
            "speakerId": 30509,
            "speakerName": "Frejus",
            "text": "Alright, let me consider how this might be designed.",
            "nextDialogs": [
              "745120121"
            ]
          },
          "745120121": {
            "id": "745120121",
            "speakerId": 30534,
            "speakerName": "Chenee",
            "text": "Nice! I'll take that as agreement — and if it does prove impossible, you'll just have to make me breakfast in the future, eh, Frejus?",
            "nextDialogs": [
              "745120122"
            ]
          },
          "745120122": {
            "id": "745120122",
            "speakerId": 30509,
            "speakerName": "Frejus",
            "text": "What? What sort of request is that... In any case, you needn't worry, I'm sure such a small invention is well within my skill. I am, after all, a \"genius.\""
          }
        }
      }
    },

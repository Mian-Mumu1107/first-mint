  "subQuests": [
    {
      "subId": "7407401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740740101"
        ],
        "dialogs": {
          "740740101": {
            "id": "740740101",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "...Shouldn't you be more concerned with the person lying on the ground in your field of vision?",
            "nextDialogs": [
              "740740102"
            ]
          },
          "740740102": {
            "id": "740740102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Wah! What happened...?",
            "nextDialogs": [
              "740740103"
            ]
          },
          "740740103": {
            "id": "740740103",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "My apologies, Miss. I prioritized the search for the stone tablet. Allow me to conduct a scan now...",
            "nextDialogs": [
              "740740104"
            ]
          },
          "740740104": {
            "id": "740740104",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "...My apologies, Miss.",
            "nextDialogs": [
              "740740105"
            ]
          },
          "740740105": {
            "id": "740740105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What!?",
            "nextDialogs": [
              "740740106"
            ]
          },
          "740740106": {
            "id": "740740106",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Though he's still alive, the breath of life has escaped his body through the orifices. I've seen this handiwork before...",
            "nextDialogs": [
              "740740107"
            ]
          },
          "740740107": {
            "id": "740740107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eek! Paimon can't look.",
            "nextDialogs": [
              "740740108"
            ]
          },
          "740740108": {
            "id": "740740108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We have to get help! We can't just leave him like this!",
            "nextDialogs": [
              "740740109"
            ]
          },
          "740740109": {
            "id": "740740109",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Together, you deliver the unconscious man to Lumidouce Harbor.\\nThe people there immediately take him to receive medical treatment.\\nKnowing that he is in good hands, you all return to where you were before.",
            "nextDialogs": [
              "740740110"
            ]
          },
          "740740110": {
            "id": "740740110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright! Now let's have a look at this stone tablet.",
            "nextDialogs": [
              "740740111"
            ]
          },
          "740740111": {
            "id": "740740111",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "\"Lo, this place is the Orthant of Wishes, the Temple of Wishes, the Room of Wishes...\"",
            "nextDialogs": [
              "740740112"
            ]
          },
          "740740112": {
            "id": "740740112",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "\"Often contradicting\"... \"Born in an instant, your company in eternal rest, never separated\"... \"The tainted fruits of sin\"...",
            "nextDialogs": [
              "740740113"
            ]
          },
          "740740113": {
            "id": "740740113",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Another riddle.",
            "nextDialogs": [
              "740740114"
            ]
          },
          "740740114": {
            "id": "740740114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why do something so scary here... Could it have something to do with the answer to the riddle?",
            "nextDialogs": [
              "740740115"
            ]
          },
          "740740115": {
            "id": "740740115",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Well, Fontainians are \"sinners,\" life tainted with original sin.",
            "nextDialogs": [
              "740740116"
            ]
          },
          "740740116": {
            "id": "740740116",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "For this reason, the answer is \"life.\" I suppose I'd guessed it already.",
            "nextDialogs": [
              "740740117"
            ]
          },
          "740740117": {
            "id": "740740117",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "Can you be sure that's the answer?",
            "nextDialogs": [
              "740740118"
            ]
          },
          "740740118": {
            "id": "740740118",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "I know the rhetoric and semiotics of the Narzissenkreuz Ordo all too well. Barring any surprises, that is the answer.",
            "nextDialogs": [
              "740740119"
            ]
          },
          "740740119": {
            "id": "740740119",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Okay, it's time to make up for lost time. We need to hurry now."
          }
        }
      }
    },

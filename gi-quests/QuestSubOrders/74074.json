        ],
        "dialogs": {
          "740742101": {
            "id": "740742101",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You carefully inspect the top of the mechanism, but you don't find anything.",
            "nextDialogs": [
              "740742102"
            ]
          },
          "740742102": {
            "id": "740742102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did someone... take whatever was here, too?",
            "nextDialogs": [
              "740742103"
            ]
          },
          "740742103": {
            "id": "740742103",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Looks that way.",
            "nextDialogs": [
              "740742104"
            ]
          },
          "740742104": {
            "id": "740742104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just who is...?",
            "nextDialogs": [
              "740742105"
            ]
          },
          "740742105": {
            "id": "740742105",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "It's Jakob.",
            "nextDialogs": [
              "740742106"
            ]
          },
          "740742106": {
            "id": "740742106",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "We had an altercation with him inside Elynas once... Clarification: Recently, not \"once.\"",
            "nextDialogs": [
              "740742107"
            ]
          },
          "740742107": {
            "id": "740742107",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "When I saw that unfortunate victim at the gate, I knew it was his handiwork. It seems he's still active after all.",
            "nextDialogs": [
              "740742108"
            ]
          },
          "740742108": {
            "id": "740742108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Then what does he want with the stuff he took from here?",
            "nextDialogs": [
              "740742109"
            ]
          },
          "740742109": {
            "id": "740742109",
            "speakerId": 21048,
            "speakerName": "Caterpillar",

    {
      "subId": "7407410",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740743001"
        ],
        "dialogs": {
          "740743001": {
            "id": "740743001",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You carefully inspect the top of the mechanism, but you don't find anything.",
            "nextDialogs": [
              "740743002"
            ]
          },
          "740743002": {
            "id": "740743002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's nothing here?",
            "nextDialogs": [
              "740743003"
            ]
          },
          "740743003": {
            "id": "740743003",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no! It looks like someone already took whatever was here.",
            "nextDialogs": [
              "740743004"
            ]
          },
          "740743004": {
            "id": "740743004",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But who?"
          }
        }
      }
    },
    {
      "subId": "7407405",
      "subQuestName": "Obtain the \"Wish\" piece",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740741901"
        ],
        "dialogs": {
          "740741901": {
            "id": "740741901",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You carefully inspect the top of the mechanism, but you don't find anything.",
            "nextDialogs": [
              "740741902"
            ]
          },
          "740741902": {
            "id": "740741902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's nothing here?",
            "nextDialogs": [
              "740741903"
            ]
          },
          "740741903": {
            "id": "740741903",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "It looks like something was here, but someone else took it.",
            "nextDialogs": [
              "740741904"
            ]
          },
          "740741904": {
            "id": "740741904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, doesn't that mean that our plan's already failed?",
            "nextDialogs": [
              "740741905"
            ]
          },
          "740741905": {
            "id": "740741905",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "The birth of \"Reason\" requires the merging of the four Orthants. If we can get the rest of them, we still have a chance.",
            "nextDialogs": [
              "740741906"
            ]
          },
          "740741906": {
            "id": "740741906",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "In that case, we'd better hurry to the next area."
          }
        }
      }
    },
    {
      "subId": "7407403",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740740301"
        ],
        "dialogs": {
          "740740301": {
            "id": "740740301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A dream?",
            "nextDialogs": [
              "740740302"
            ]
          },
          "740740302": {
            "id": "740740302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon doesn't think so... Just what kind of weird thing would you have to dream up for it to be a sin?",
            "nextDialogs": [
              "740740303"
            ]
          },
          "740740303": {
            "id": "740740303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hmm... What do you think the answer is then, {NICKNAME}?"
          }
        }
      }
    },
    {
      "subId": "7407420",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740742001"
        ],
        "dialogs": {
          "740742001": {
            "id": "740742001",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You carefully inspect the top of the mechanism, but you don't find anything.",
            "nextDialogs": [
              "740742002"
            ]
          },
          "740742002": {
            "id": "740742002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's nothing here either...",
            "nextDialogs": [
              "740742003"
            ]
          },
          "740742003": {
            "id": "740742003",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "What exactly are we looking for, Caterpillar?",
            "nextDialogs": [
              "740742004"
            ]
          },
          "740742004": {
            "id": "740742004",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "We're looking for the materials necessary to forge the Holy Blade of Narzissenkreuz.",
            "nextDialogs": [
              "740742005"
            ]
          },
          "740742005": {
            "id": "740742005",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "The Ordo was able to reproduce the four requisite hypothetical substances here in the material world, based on the esoteric philosophies of the underground kingdom and ancient Fontaine.",
            "nextDialogs": [
              "740742006"
            ]
          },
          "740742006": {
            "id": "740742006",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "I do not understand.",
            "nextDialogs": [
              "740742007"
            ]
          },
          "740742007": {
            "id": "740742007",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "These enigmatic substances are purely experiential. You could say they are even further beyond ordinary logic than elemental power.",
            "nextDialogs": [
              "740742008"
            ]
          },
          "740742008": {
            "id": "740742008",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "I entered all introductory to intermediate level textbooks from the Akademiya's Spantamad into my memory banks decades ago. There is nothing mysterious about elemental power.",
            "nextDialogs": [
              "740742009"
            ]
          },
          "740742009": {
            "id": "740742009",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Is that so? Anyway, to sum up, this is born of the confluence of traditions from Fontaine and technology from the ancient underground kingdom.",
            "nextDialogs": [
              "740742010"
            ]
          },
          "740742010": {
            "id": "740742010",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "And thus, four types of substance came into being: Memory, Wish, Soul, and Persona.",
            "nextDialogs": [
              "740742011"
            ]
          },
          "740742011": {
            "id": "740742011",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "To avoid any possible ambiguity, let's call them the \"Memory\" piece, \"Wish\" piece, \"Soul\" piece, and \"Persona\" piece.",
            "nextDialogs": [
              "740742012"
            ]
          },
          "740742012": {
            "id": "740742012",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why are these used to make the Holy Blade?",
            "nextDialogs": [
              "740742013"
            ]
          },
          "740742013": {
            "id": "740742013",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "In the Narzissenkreuz Ordo's brand of mystical philosophy, the temple is a microcosm of the universe, the members are stand-ins for the gods, and the holy oil is tempered willpower.",
            "nextDialogs": [
              "740742014"
            ]
          },
          "740742014": {
            "id": "740742014",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "The Holy Blade, on the other hand, is \"reason,\" that which cuts everything open. It can only be born out of consummate human will.",
            "nextDialogs": [
              "740742015"
            ]
          },
          "740742015": {
            "id": "740742015",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Quite abstruse.",
            "nextDialogs": [
              "740742016"
            ]
          },
          "740742016": {
            "id": "740742016",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "That's esotericism for you. You attach yourself to anything that looks similar enough, and when this sort of thing becomes magic, fiction becomes reality.",
            "nextDialogs": [
              "740742017"
            ]
          },
          "740742017": {
            "id": "740742017",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Anyway, we should make our way to the next area now."
          }
        }
      }
    },
    {
      "subId": "7407421",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

  "subQuests": [
    {
      "subId": "7320401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732040101"
        ],
        "dialogs": {
          "732040101": {
            "id": "732040101",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "What are you kids doing? Come to laugh at this old man \"growing rocks,\" have you?",
            "nextDialogs": [
              "732040102"
            ]
          },
          "732040102": {
            "id": "732040102",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "I'm fine! I don't need the other villagers to worry about me.",
            "nextDialogs": [
              "732040103"
            ]
          },
          "732040103": {
            "id": "732040103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, no need to be so hostile from the get-go.",
            "nextDialogs": [
              "732040104"
            ]
          },
          "732040104": {
            "id": "732040104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're mistaken. We're not from Aaru Village, and we're not here to laugh at you.",
            "nextDialogs": [
              "732040106",
              "732040108"
            ]
          },
          "732040106": {
            "id": "732040106",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "Passers-by? Uh...",
            "nextDialogs": [
              "732040110"
            ]
          },
          "732040110": {
            "id": "732040110",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "Normally, only some old friends of mine would come over to tell me to give up on the nursery and move back to the village.",
            "nextDialogs": [
              "732040111"
            ]
          },
          "732040111": {
            "id": "732040111",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "And a few bad kids too. They keep coming over here to cause trouble.",
            "nextDialogs": [
              "732040112"
            ]
          },
          "732040112": {
            "id": "732040112",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "It's my first time seeing children dressed up like this. What is it that you do?"
          },
          "732040108": {
            "id": "732040108",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "Yeah, I'm growing flowers, not some dumb rocks.",
            "nextDialogs": [
              "732040109"
            ]
          },
          "732040109": {
            "id": "732040109",
            "speakerId": 4233,
            "speakerName": "Affan",
            "text": "I thought... Ugh. Never mind, what am I even supposed to say now..."
          }
        }
      }
    },

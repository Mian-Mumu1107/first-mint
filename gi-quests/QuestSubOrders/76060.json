  "subQuests": [
    {
      "subId": "7606001",
      "subQuestName": "Meet The Damselette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760600101"
        ],
        "dialogs": {
          "760600101": {
            "id": "760600101",
            "speakerId": 15702,
            "speakerName": "Maalaus",
            "text": "...",
            "nextDialogs": [
              "760600102"
            ]
          },
          "760600102": {
            "id": "760600102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Isn't that Maalaus? Has she been out gathering inspiration, again?",
            "nextDialogs": [
              "760600103"
            ]
          },
          "760600103": {
            "id": "760600103",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Yes. But the little one has been like this ever since she came back... As if lost in thought.",
            "nextDialogs": [
              "760600104"
            ]
          },
          "760600104": {
            "id": "760600104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, maybe the theme this time is super profound... Y'know, like when a great artist realizes some fundamental truth about the world.",
            "nextDialogs": [
              "760600105"
            ]
          },
          "760600105": {
            "id": "760600105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Come to think of it, Maalaus has given us a whole bunch of paintings. We could hold an entire exhibition at this rate!",
            "nextDialogs": [
              "760600106"
            ]
          },
          "760600106": {
            "id": "760600106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, Paimon can't wait to tell everyone all about our little painter's rise to artistic stardom! Ah, but we'd need Columbina's permission first, of course.",
            "nextDialogs": [
              "760600107"
            ]
          },
          "760600107": {
            "id": "760600107",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Hm? Why is that?",
            "nextDialogs": [
              "760600108"
            ]
          },
          "760600108": {
            "id": "760600108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, 'cause they're nearly all paintings of you.",
            "nextDialogs": [
              "760600109"
            ]
          },
          "760600109": {
            "id": "760600109",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Oh... It's okay, I don't mind. It sounds intriguing.",
            "nextDialogs": [
              "760600110"
            ]
          },
          "760600110": {
            "id": "760600110",
            "speakerId": 15702,
            "speakerName": "Maalaus",
            "text": "~!",
            "nextDialogs": [
              "760600111"
            ]
          },
          "760600111": {
            "id": "760600111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, seems like Maalaus has decided what to draw! Quick, let's see what kind of paint we've got.",
            "nextDialogs": [
              "760600112"
            ]
          },
          "760600112": {
            "id": "760600112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This time... Let's go for deep and tranquil colors!"
          }
        }
      }
    },
    {
      "subId": "7606002",
      "subQuestName": "Give the kuuhenki some objects with vivid colors",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760600201"
        ],
        "dialogs": {
          "760600201": {
            "id": "760600201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Deep, tranquil colors...)"
          }
        }
      }
    },
    {
      "subId": "7606003",
      "subQuestName": "Admire the kuuhenki's art",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760600301"
        ],
        "dialogs": {
          "760600301": {
            "id": "760600301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright, these should do. What do you think, Maalaus?",
            "nextDialogs": [
              "760600302"
            ]
          },
          "760600302": {
            "id": "760600302",
            "speakerId": 15702,
            "speakerName": "Maalaus",
            "text": "~!",
            "nextDialogs": [
              "760600303"
            ]
          },
          "760600303": {
            "id": "760600303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yep, looks like a happy kuuhenki to Paimon! Hehe, wonder what kind of painting we'll get this time...",
            "nextDialogs": [
              "760600304"
            ]
          },
          "760600304": {
            "id": "760600304",
            "speakerId": 15702,
            "speakerName": "Maalaus",
            "text": "...",
            "nextDialogs": [
              "760600305"
            ]
          },
          "760600305": {
            "id": "760600305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, is it done already?",
            "nextDialogs": [
              "760600306"
            ]
          },
          "760600306": {
            "id": "760600306",
            "speakerId": 15702,
            "speakerName": "Maalaus",
            "text": "...",
            "nextDialogs": [
              "760600307"
            ]
          },
          "760600307": {
            "id": "760600307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Maalaus seems a little sad. Is it because of the painting? Let's take a look...",
            "nextDialogs": [
              "760600308"
            ]
          },
          "760600308": {
            "id": "760600308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay so, it's Columbina... taking a walk under the moonlight and gazing up at the night sky.",
            "nextDialogs": [
              "760600309"
            ]
          },
          "760600309": {
            "id": "760600309",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Ah... I must be looking at the true moon beyond the false sky. I used to take midnight walks like that all the time.",
            "nextDialogs": [
              "760600310"
            ]
          },
          "760600310": {
            "id": "760600310",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Used to...? Oh, right...",
            "nextDialogs": [
              "760600311"
            ]
          },
          "760600311": {
            "id": "760600311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Columbina is pretty much confined to this garden, now... even though Nod-Krai is where she was born...)",
            "nextDialogs": [
              "760600312"
            ]
          },
          "760600312": {
            "id": "760600312",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Yes, I would gaze at the sky and wonder... What really lies up there on the true Frost Moon?",
            "nextDialogs": [
              "760600313"
            ]
          },
          "760600313": {
            "id": "760600313",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Perhaps it's just like here, filled with lots of little animals...",
            "nextDialogs": [
              "760600314"
            ]
          },
          "760600314": {
            "id": "760600314",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Or perhaps... there's nothing there at all.",
            "nextDialogs": [
              "760600315"
            ]
          },
          "760600315": {
            "id": "760600315",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh...",
            "nextDialogs": [
              "760600317",
              "760600320"
            ]
          },
          "760600317": {
            "id": "760600317",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Ha... An interesting thought.",
            "nextDialogs": [
              "760600318"
            ]
          },
          "760600318": {
            "id": "760600318",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "But... Since the moon lies beyond the false sky, that's one adventure I would rather not risk taking them on...",
            "nextDialogs": [
              "760600322"
            ]
          },
          "760600322": {
            "id": "760600322",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(One is a \"home\" where she isn't even free to move around... the other is a \"home\" she knows nothing about...)",
            "nextDialogs": [
              "760600323"
            ]
          },
          "760600323": {
            "id": "760600323",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(...)",
            "nextDialogs": [
              "760600324"
            ]
          },
          "760600324": {
            "id": "760600324",
            "speakerId": 15702,
            "speakerName": "Maalaus",
            "text": "...",
            "nextDialogs": [
              "760600325"
            ]
          },
          "760600325": {
            "id": "760600325",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Maalaus and the other kuuhenki are really gonna miss you...",
            "nextDialogs": [
              "760600326"
            ]
          },
          "760600326": {
            "id": "760600326",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "And I will miss them too.",
            "nextDialogs": [
              "760600327"
            ]
          },
          "760600327": {
            "id": "760600327",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "But in the end, this is a journey that only I can make... and the answer at the end of it is mine alone to seek.",
            "nextDialogs": [
              "760600328"
            ]
          },
          "760600328": {
            "id": "760600328",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "And who knows? Whatever that answer turns out to be... Perhaps it will be something beautiful.",
            "nextDialogs": [
              "760600329"
            ]
          },
          "760600329": {
            "id": "760600329",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "W—Well... We'll just have to come visit you, then! With Maalaus!",
            "nextDialogs": [
              "760600330"
            ]
          },
          "760600330": {
            "id": "760600330",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Alright. We could hold that art exhibition on the moon, perhaps.",
            "nextDialogs": [
              "760600331"
            ]
          },
          "760600331": {
            "id": "760600331",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, great idea! It's a promise!",
            "nextDialogs": [
              "760600332"
            ]
          },
          "760600332": {
            "id": "760600332",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Mm...",
            "nextDialogs": [
              "760600333"
            ]
          },
          "760600333": {
            "id": "760600333",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I hope so, I truly do..."
          },
          "760600320": {
            "id": "760600320",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Mm, I hope so.",
            "nextDialogs": [
              "760600321"
            ]
          },
          "760600321": {
            "id": "760600321",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "And I hope... if there are, the creatures would welcome the sudden and unexpected return of their \"Goddess.\""
          }
        }
      }
    },
    {
      "subId": "7606004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

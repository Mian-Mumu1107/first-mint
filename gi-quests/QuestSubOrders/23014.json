  "subQuests": [
    {
      "subId": "2301401",
      "subQuestName": "Talk to Garcia",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230140101"
        ],
        "dialogs": {
          "230140101": {
            "id": "230140101",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Sir, I most sincerely suggest that we find a way to pay.",
            "nextDialogs": [
              "230140102"
            ]
          },
          "230140102": {
            "id": "230140102",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "They were more like bandits than merchants! How could they ask for such a high price for just a couple of insignias?",
            "nextDialogs": [
              "230140103"
            ]
          },
          "230140103": {
            "id": "230140103",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Perhaps they noticed how your eyes lit up when you saw their goods.",
            "nextDialogs": [
              "230140104"
            ]
          },
          "230140104": {
            "id": "230140104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do you want the insignias for?",
            "nextDialogs": [
              "230140105"
            ]
          },
          "230140105": {
            "id": "230140105",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Traveler! Your timing is always most opportune...",
            "nextDialogs": [
              "230140106"
            ]
          },
          "230140106": {
            "id": "230140106",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Thanks to your help last time, I have basically produced an acceptable lubricant.",
            "nextDialogs": [
              "230140107"
            ]
          },
          "230140107": {
            "id": "230140107",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "However, I encountered another problem soon after that. While reproducing some of the parts, I found that... their excessively hard material will damage the other parts.",
            "nextDialogs": [
              "230140108"
            ]
          },
          "230140108": {
            "id": "230140108",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Moreover, these excessively hard parts would crack, to different extents, upon even the slightest impact...",
            "nextDialogs": [
              "230140109"
            ]
          },
          "230140109": {
            "id": "230140109",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Thus, I began searching for a material that is both hard and flexible.",
            "nextDialogs": [
              "230140110"
            ]
          },
          "230140110": {
            "id": "230140110",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "After relentless research...",
            "nextDialogs": [
              "230140111"
            ]
          },
          "230140111": {
            "id": "230140111",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "...And after relentlessly hassling Mr. Ahangar.",
            "nextDialogs": [
              "230140112"
            ]
          },
          "230140112": {
            "id": "230140112",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "I thought that I could find the material I sought in the insignias that the Treasure Hoarders carry around with them.",
            "nextDialogs": [
              "230140113"
            ]
          },
          "230140113": {
            "id": "230140113",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "But those merchants may as well have been Treasure Hoarders, the way they were robbing me!",
            "nextDialogs": [
              "230140116"
            ]
          },
          "230140116": {
            "id": "230140116",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "I should carve your name on the main bearing of my Numbering Machine! I can't express my gratitude enough!"
          }
        }
      }
    },
    {
      "subId": "2301402",
      "subQuestName": "Obtain Treasures Hoarders' insignias for Garcia",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230140201"
        ],
        "dialogs": {
          "230140201": {
            "id": "230140201",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "I assume you have obtained the insignias, yes?"
          }
        }
      }
    },
    {
      "subId": "2301403",
      "subQuestName": "Talk to Garcia",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230140301"
        ],
        "dialogs": {
          "230140301": {
            "id": "230140301",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Thank you very much, Traveler. These should suffice.",
            "nextDialogs": [
              "230140302"
            ]
          },
          "230140302": {
            "id": "230140302",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "I will have to reproduce the gear first... Um, no, I should tackle the problem with the bearings first...",
            "nextDialogs": [
              "230140303"
            ]
          },
          "230140303": {
            "id": "230140303",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Here's your payment, Traveler.",
            "nextDialogs": [
              "230140304"
            ]
          },
          "230140304": {
            "id": "230140304",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Given the current circumstances, we are probably in for some long-term cooperation.",
            "nextDialogs": [
              "230140305"
            ]
          },
          "230140305": {
            "id": "230140305",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Ugh, Mr. Garcia's accounts... Sorting them out really is a headache..."
          }
        }
      }
    },
    {
      "subId": "2301404",
      "subQuestName": "Talk to Garcia",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230140401"
        ],
        "dialogs": {
          "230140401": {
            "id": "230140401",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "Oh my! These insignias certainly are of high quality!",
            "nextDialogs": [
              "230140402"
            ]
          },
          "230140402": {
            "id": "230140402",
            "speakerId": 20657,
            "speakerName": "Garcia",
            "text": "I will have to reproduce the gear first... Um, no, I should tackle the problem with the bearings first...",
            "nextDialogs": [
              "230140403"
            ]
          },
          "230140403": {
            "id": "230140403",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Here's your payment, Traveler.",
            "nextDialogs": [
              "230140404"
            ]
          },
          "230140404": {
            "id": "230140404",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Given the current circumstances, we are probably in for some long-term cooperation.",
            "nextDialogs": [
              "230140405"
            ]
          },
          "230140405": {
            "id": "230140405",
            "speakerId": 20658,
            "speakerName": "Lutong",
            "text": "Ugh, Mr. Garcia's accounts... Sorting them out really is a headache..."
          }
        }
      }
    },
    {
      "subId": "2301450",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230145001"
        ],
        "dialogs": {
          "230145001": {
            "id": "230145001",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "I submit that we must earn some Mora, sir.",
            "nextDialogs": [
              "230145002"
            ]
          },
          "230145002": {
            "id": "230145002",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "I have heard that there is a theater in Sumeru City and that they are looking for someone to do some calculations for them.",
            "nextDialogs": [
              "230145003"
            ]
          },
          "230145003": {
            "id": "230145003",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Besides, the stage crew... You know, they earn quite some Mora, but they have no idea how to keep track of it.",
            "nextDialogs": [
              "230145004"
            ]
          },
          "230145004": {
            "id": "230145004",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "I sense opportunity here, sir.",
            "nextDialogs": [
              "230145005"
            ]
          },
          "230145005": {
            "id": "230145005",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Why, your talent in accounting and business is most astounding, my dear Lutong...",
            "nextDialogs": [
              "230145006"
            ]
          },
          "230145006": {
            "id": "230145006",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Still, give me a second, let me think..."
          }
        }
      }
    },
    {
      "subId": "2301455",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230145501"
        ],
        "dialogs": {
          "230145501": {
            "id": "230145501",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Ugh... Lutong, I need a hand...",
            "nextDialogs": [
              "230145502"
            ]
          },
          "230145502": {
            "id": "230145502",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Sir, you'd better go back and get some sleep.",
            "nextDialogs": [
              "230145503"
            ]
          },
          "230145503": {
            "id": "230145503",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Traveler, perfect timing! Come over here. I would like to ask a favor of you.",
            "nextDialogs": [
              "230145504"
            ]
          },
          "230145504": {
            "id": "230145504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong with him?",
            "nextDialogs": [
              "230145505"
            ]
          },
          "230145505": {
            "id": "230145505",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Well, in a word... Mr. Garcia had too much coffee and too little sleep.",
            "nextDialogs": [
              "230145506"
            ]
          },
          "230145506": {
            "id": "230145506",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Fortunately, it's coffee he drank, not wine.",
            "nextDialogs": [
              "230145507"
            ]
          },
          "230145507": {
            "id": "230145507",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Lutong, uh... We have to find some more insignias... You know, the ones that the Treasure Hoarders carry around with them...",
            "nextDialogs": [
              "230145508"
            ]
          },
          "230145508": {
            "id": "230145508",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Traveler! You are here. Sorry, I didn't see you there.",
            "nextDialogs": [
              "230145509"
            ]
          },
          "230145509": {
            "id": "230145509",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Would you like to get me some of those insignias? Just a few will do.",
            "nextDialogs": [
              "230145511",
              "230145513"
            ]
          },
          "230145511": {
            "id": "230145511",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "It's okay. I'm fine. I know what I'm doing. It's just that my hands play tricks on me.",
            "nextDialogs": [
              "230145514"
            ]
          },
          "230145514": {
            "id": "230145514",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Anyway, please bring back some insignias, and you will get paid.",
            "nextDialogs": [
              "230145515"
            ]
          },
          "230145515": {
            "id": "230145515",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Once you've got it, just bring it to me. I want to take a closer look. A perfect bearing must be made this time..."
          },
          "230145513": {
            "id": "230145513",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "It's not the coffee. Mr. Garcia doesn't want to sleep..."
          }
        }
      }
    },
    {
      "subId": "2301456",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230145601"
        ],
        "dialogs": {
          "230145601": {
            "id": "230145601",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Luckily, Mr. Garcia doesn't drink...",
            "nextDialogs": [
              "230145602"
            ]
          },
          "230145602": {
            "id": "230145602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you been in correspondence with Kaia?",
            "nextDialogs": [
              "230145603"
            ]
          },
          "230145603": {
            "id": "230145603",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Unfortunately, Ms. Kaia hasn't sent back any letters yet.",
            "nextDialogs": [
              "230145604"
            ]
          },
          "230145604": {
            "id": "230145604",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "And my plan to send letters to Ms. Kaia failed because I didn't know where to send them...",
            "nextDialogs": [
              "230145605"
            ]
          },
          "230145605": {
            "id": "230145605",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Have no idea where Ms. Kaia is traveling now..."
          }
        }
      }
    },
    {
      "subId": "2301457",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230145701"
        ],
        "dialogs": {
          "230145701": {
            "id": "230145701",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Well, these insignias will be enough. I... Ugh! My head is starting to hurt again.",
            "nextDialogs": [
              "230145702"
            ]
          },
          "230145702": {
            "id": "230145702",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Sir! You have to take these pills right now!",
            "nextDialogs": [
              "230145703"
            ]
          },
          "230145703": {
            "id": "230145703",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Traveler, please take these as your reward. I'll take Mr. Garcia back first.",
            "nextDialogs": [
              "230145704"
            ]
          },
          "230145704": {
            "id": "230145704",
            "speakerId": 14068,
            "speakerName": "Garcia",
            "text": "Insignias! Don't forget the insignias. Make sure they are kept properly!",
            "nextDialogs": [
              "230145705"
            ]
          },
          "230145705": {
            "id": "230145705",
            "speakerId": 14069,
            "speakerName": "Lutong",
            "text": "Don't worry sir. They are absolutely safe with me."
          }
        }
      }
    }
  ]
}
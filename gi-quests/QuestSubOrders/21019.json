    {
      "subId": "2101902",
      "subQuestName": "Observe the inscription",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210060201"
        ],
        "dialogs": {
          "210060201": {
            "id": "210060201",
            "speakerId": 1000,
            "speakerName": "Incomplete Writing",
            "text": "\"With the evil serpent gone from Qingce, the magic formula that subdued it was no longer in effect. ...\"",
            "nextDialogs": [
              "210060202"
            ]
          },
          "210060202": {
            "id": "210060202",
            "speakerId": 1000,
            "speakerName": "Incomplete Writing",
            "text": "\"...But the serpent did not perish, and its foul blood congealed within the earth and formed stone, poisoning the world...\"",
            "nextDialogs": [
              "210060203"
            ]
          },
          "210060203": {
            "id": "210060203",
            "speakerId": 1000,
            "speakerName": "Incomplete Writing",
            "text": "\"...Thus three statues were used to subdue it...\"",
            "nextDialogs": [
              "210060204"
            ]
          },
          "210060204": {
            "id": "210060204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...Just three lines and Paimon's head is hurting. Why are all Liyue's stories written like this?",
            "nextDialogs": [
              "210060205"
            ]
          },
          "210060205": {
            "id": "210060205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But anyway, that bit that goes <color=#00E1FFFF>\"foul blood something something formed stone\"</color>... does that mean there's <color=#00E1FFFF>strange stone</color> around here?",
            "nextDialogs": [
              "210060206"
            ]
          },
          "210060206": {
            "id": "210060206",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's take a look around at the <color=#00E1FFFF>stones</color> around here and see if we can find some leads."
          }
        }
      }
    },

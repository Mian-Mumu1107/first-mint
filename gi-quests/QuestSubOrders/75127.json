      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751270101"
        ],
        "dialogs": {
          "751270101": {
            "id": "751270101",
            "speakerId": 1000,
            "speakerName": "Sakaw",
            "text": "Oh, have you come to take pictures? Foreign tourists have come here before, wishing to do the same. That floating island is quite the view, after all...",
            "nextDialogs": [
              "751270102"
            ]
          },
          "751270102": {
            "id": "751270102",
            "speakerId": 1000,
            "speakerName": "Sakaw",
            "text": "It's just a shame we didn't have Kamera previously — I had to ask a foreign merchant I knew to get me one.",
            "nextDialogs": [
              "751270103"
            ]
          },
          "751270103": {
            "id": "751270103",
            "speakerId": 1000,
            "speakerName": "Sakaw",
            "text": "How about it, dear guest? Care for a picture? But you'll have to do it yourself. I'm not exactly a dab hand at photography...",
            "nextDialogs": [
              "751270104"
            ]
          },
          "751270104": {
            "id": "751270104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Strange, there's fog over the sea...",
            "nextDialogs": [
              "751270105"
            ]
          },
          "751270105": {
            "id": "751270105",
            "speakerId": 1000,
            "speakerName": "Sakaw",
            "text": "Fog? What do you mean? There can't be fog with such a strong sea breeze...",
            "nextDialogs": [
              "751270106"
            ]
          },
          "751270106": {
            "id": "751270106",
            "speakerId": 1000,
            "speakerName": "Sakaw",
            "text": "I have never seen fog over the sea since the day I was born.",
            "nextDialogs": [
              "751270107"
            ]
          },
          "751270107": {
            "id": "751270107",
            "speakerId": 1000,
            "speakerName": "Sakaw",
            "text": "Might you have confused this place with the fog-shrouded area that Tezcatepetonco Range overlooks, by any chance?",
            "nextDialogs": [
              "751270108"
            ]
          },
          "751270108": {
            "id": "751270108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Perhaps...",
            "nextDialogs": [
              "751270109"
            ]
          },
          "751270109": {
            "id": "751270109",
            "speakerId": 1000,
            "speakerName": "Sakaw",
            "text": "Hehe, if you ask me, I'd say you're just too nervous.",
            "nextDialogs": [
              "751270110"
            ]
          },
          "751270110": {
            "id": "751270110",
            "speakerId": 1000,
            "speakerName": "Sakaw",
            "text": "You should loosen up — you're touring Natlan, after all."
          }
        }
      }
    }
  ]
}
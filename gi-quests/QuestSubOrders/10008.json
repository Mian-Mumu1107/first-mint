  "subQuests": [
    {
      "subId": "1000801",
      "subQuestName": "Go to Wolvendom",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100080101"
        ],
        "dialogs": {
          "100080101": {
            "id": "100080101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Razor!",
            "nextDialogs": [
              "100080102"
            ]
          },
          "100080102": {
            "id": "100080102",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "*sniff* Familiar scent. Ah, you two.",
            "nextDialogs": [
              "100080103"
            ]
          },
          "100080103": {
            "id": "100080103",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "You have been good?",
            "nextDialogs": [
              "100080104"
            ]
          },
          "100080104": {
            "id": "100080104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, yep! We're doing great! Oh, but what happened to Boreas, Razor? We saw you talking just now. Is it a secret?",
            "nextDialogs": [
              "100080105"
            ]
          },
          "100080105": {
            "id": "100080105",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "We go on hunt. I try to convince... wolf lord.",
            "nextDialogs": [
              "100080106"
            ]
          },
          "100080106": {
            "id": "100080106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A hunt?",
            "nextDialogs": [
              "100080107"
            ]
          },
          "100080107": {
            "id": "100080107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#(Oh, {NICKNAME}, is that Razor's \"task\"?)",
            "nextDialogs": [
              "100080108"
            ]
          },
          "100080108": {
            "id": "100080108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are the wolves out of food? Is that why you're going on a hunt?",
            "nextDialogs": [
              "100080111"
            ]
          },
          "100080111": {
            "id": "100080111",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "No. This hunt is not for food.",
            "nextDialogs": [
              "100080112"
            ]
          },
          "100080112": {
            "id": "100080112",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "We hunt... enemies. The dark wolf pack. Strange scent coming from land they took. Getting stronger...",
            "nextDialogs": [
              "100080113"
            ]
          },
          "100080113": {
            "id": "100080113",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "We must hunt enemies to purify the forest.",
            "nextDialogs": [
              "100080114"
            ]
          },
          "100080114": {
            "id": "100080114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, so did Boreas agree? Paimon remembers last time he said something like...",
            "nextDialogs": [
              "100080115"
            ]
          },
          "100080115": {
            "id": "100080115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Razor, you must not get involved. This is for the wolves to settle between themselves.\"",
            "nextDialogs": [
              "100080116"
            ]
          },
          "100080116": {
            "id": "100080116",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "...",
            "nextDialogs": [
              "100080117"
            ]
          },
          "100080117": {
            "id": "100080117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, sorry, Razor. Paimon didn't mean to dig that up again...",
            "nextDialogs": [
              "100080118"
            ]
          },
          "100080118": {
            "id": "100080118",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "It's okay. I know Lupical means no harm. Besides, teacher taught me how to talk to wolf lord.",
            "nextDialogs": [
              "100080119"
            ]
          },
          "100080119": {
            "id": "100080119",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Lisa taught you how to talk to him...?",
            "nextDialogs": [
              "100080120"
            ]
          },
          "100080120": {
            "id": "100080120",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh! Like, she told you what to say? So that means you got him to agree then, right?",
            "nextDialogs": [
              "100080121"
            ]
          },
          "100080121": {
            "id": "100080121",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Yes. Words were... hard. But I did it.",
            "nextDialogs": [
              "100080122"
            ]
          },
          "100080122": {
            "id": "100080122",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hah, so you actually managed to convince that giant, stubborn old fella! That's super impressive, Razor!",
            "nextDialogs": [
              "100080123"
            ]
          },
          "100080123": {
            "id": "100080123",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Dark wolves are enemies of the whole world. Teacher said this is not wolf problem. This is world problem... And wolf lord agreed.",
            "nextDialogs": [
              "100080124"
            ]
          },
          "100080124": {
            "id": "100080124",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "But, because of that, other wolves won't join. This war is between me and dark wolf pack...",
            "nextDialogs": [
              "100080125"
            ]
          },
          "100080125": {
            "id": "100080125",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Then, count us in too! Those awful Rifthounds have been getting on our nerves for a while!",
            "nextDialogs": [
              "100080126"
            ]
          },
          "100080126": {
            "id": "100080126",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Th—Thank you... Help makes for easy hunt.",
            "nextDialogs": [
              "100080127"
            ]
          },
          "100080127": {
            "id": "100080127",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Speaking of, how is this hunt gonna work?",
            "nextDialogs": [
              "100080128"
            ]
          },
          "100080128": {
            "id": "100080128",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "We set trap. Chase dark wolves here. Into trap.",
            "nextDialogs": [
              "100080129"
            ]
          },
          "100080129": {
            "id": "100080129",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Then wolf lord pin them down, and we... finish hunt.",
            "nextDialogs": [
              "100080130"
            ]
          },
          "100080130": {
            "id": "100080130",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Tell me when ready. We start hunt.",
            "nextDialogs": [
              "100080401"
            ]
          },
          "100080401": {
            "id": "100080401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's do this!"
          }
        }
      }
    },

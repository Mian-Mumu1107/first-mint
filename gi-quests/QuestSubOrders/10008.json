    {
      "subId": "1000806",
      "subQuestName": "Talk to Razor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100080601"
        ],
        "dialogs": {
          "100080601": {
            "id": "100080601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We did it!",
            "nextDialogs": [
              "100080602"
            ]
          },
          "100080602": {
            "id": "100080602",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Thank you... for helping. I thought protecting Lupical was up to me.",
            "nextDialogs": [
              "100080603"
            ]
          },
          "100080603": {
            "id": "100080603",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "But, Lupical also...",
            "nextDialogs": [
              "100080604"
            ]
          },
          "100080604": {
            "id": "100080604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're here because we care about you, just like you do us! That's what makes us Lupical, right?",
            "nextDialogs": [
              "100080605"
            ]
          },
          "100080605": {
            "id": "100080605",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Right... We are Lupical forever.",
            "nextDialogs": [
              "100080606"
            ]
          },
          "100080606": {
            "id": "100080606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aww.. and now, there won't be any more intruders in Wolvendom!",
            "nextDialogs": [
              "100080607"
            ]
          },
          "100080607": {
            "id": "100080607",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "No... Dark wolf pack, rip open sky. They... could come again.",
            "nextDialogs": [
              "100080608"
            ]
          },
          "100080608": {
            "id": "100080608",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "But, me and Lupical will hunt them down... no matter what.",
            "nextDialogs": [
              "100080609"
            ]
          },
          "100080609": {
            "id": "100080609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Don't forget about us, now.",
            "nextDialogs": [
              "100080610"
            ]
          },
          "100080610": {
            "id": "100080610",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, if you ever need help, just say the word! We're here for you!",
            "nextDialogs": [
              "100080611"
            ]
          },
          "100080611": {
            "id": "100080611",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "I... appreciate it.",
            "nextDialogs": [
              "100080612"
            ]
          },
          "100080612": {
            "id": "100080612",
            "speakerId": 15880,
            "speakerName": "Distant Howl",
            "text": "Awoo!",
            "nextDialogs": [
              "100080613"
            ]
          },
          "100080613": {
            "id": "100080613",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "They... call for me.",
            "nextDialogs": [
              "100080614"
            ]
          },
          "100080614": {
            "id": "100080614",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sounds like they wanna make sure you're safe.",
            "nextDialogs": [
              "100080615"
            ]
          },
          "100080615": {
            "id": "100080615",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Then... I should go. Thank you... for the help.",
            "nextDialogs": [
              "100080616"
            ]
          },
          "100080616": {
            "id": "100080616",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't mention it! That's what Lupical is for!",
            "nextDialogs": [
              "100080617"
            ]
          },
          "100080617": {
            "id": "100080617",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "With Wolvendom safe for now, Razor bids you farewell and head into the forest.",
            "nextDialogs": [
              "100080618"
            ]
          },
          "100080618": {
            "id": "100080618",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Amid the dense foliage, you notice several pairs of eyes regarding him with warmth, waiting to welcome him home."
          }
        }
      }
    }
  ]
}
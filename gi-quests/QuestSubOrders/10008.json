        "dialogs": {}
      }
    },
    {
      "subId": "1000803",
      "subQuestName": "Protect the wolf pack",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100080301"
        ],
        "dialogs": {
          "100080301": {
            "id": "100080301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That was close! Good thing the wolves were there to help!",
            "nextDialogs": [
              "100080302"
            ]
          },
          "100080302": {
            "id": "100080302",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Hmm...",
            "nextDialogs": [
              "100080303"
            ]
          },
          "100080303": {
            "id": "100080303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They intercepted those Rifthounds for us, and even drove them away!",
            "nextDialogs": [
              "100080304"
            ]
          },
          "100080304": {
            "id": "100080304",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "But this isn't... wolf problem...",
            "nextDialogs": [
              "100080305"
            ]
          },
          "100080305": {
            "id": "100080305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're doing this to help your Lupical, right? Well, they want you to be safe too!",
            "nextDialogs": [
              "100080306"
            ]
          },
          "100080306": {
            "id": "100080306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon bets they went to the Wolf King and said, \"Listen here! This isn't just our Lupical's problem. This is the world's problem!\"... And then rushed over to help!",
            "nextDialogs": [
              "100080307"
            ]
          },
          "100080307": {
            "id": "100080307",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "Hm, \"Lupical\" is... \"Lupical.\"",
            "nextDialogs": [
              "100080308"
            ]
          },
          "100080308": {
            "id": "100080308",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "I am human, but I do not need to be wolf to be \"Lupical.\" I... just want to help them.",
            "nextDialogs": [
              "100080309"
            ]
          },
          "100080309": {
            "id": "100080309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well said, Razor!",
            "nextDialogs": [
              "100080310"
            ]
          },
          "100080310": {
            "id": "100080310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe Lupus Boreas agreed to let the pack help...",
            "nextDialogs": [
              "100080311"
            ]
          },
          "100080311": {
            "id": "100080311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Because he knows your heart.",
            "nextDialogs": [
              "100080312"
            ]
          },
          "100080312": {
            "id": "100080312",
            "speakerId": 1011,
            "speakerName": "Razor",
            "text": "You... think so?",
            "nextDialogs": [
              "100080313"
            ]
          },
          "100080313": {
            "id": "100080313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, absolutely! Now, c'mon! Let's go kick some Rifthound butt!"
          }
        }
      }
    },

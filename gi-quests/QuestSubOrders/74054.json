    {
      "subId": "7405407",
      "subQuestName": "Examine the terminal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740540801"
        ],
        "dialogs": {
          "740540801": {
            "id": "740540801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pull the lever.",
            "nextDialogs": [
              "740540802"
            ]
          },
          "740540802": {
            "id": "740540802",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Whoa! What are you doing, {NICKNAME}?",
            "nextDialogs": [
              "740540803"
            ]
          },
          "740540803": {
            "id": "740540803",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You pull the lever without the slightest hesitation.\\nThe entire tower then immediately trembles with a thunderous, ear-splitting rumble. It's as if the sky is crumbling and the earth is splitting...",
            "nextDialogs": [
              "740540804"
            ]
          },
          "740540804": {
            "id": "740540804",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Then... with a pop, the machine spits out a stack of paper tape right into your hands.\\nAll is quiet once more.",
            "nextDialogs": [
              "740540805"
            ]
          },
          "740540805": {
            "id": "740540805",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Is... this it?",
            "nextDialogs": [
              "740540806"
            ]
          },
          "740540806": {
            "id": "740540806",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... Paimon doesn't have a clue what's on this stuff, but it looks pretty important...",
            "nextDialogs": [
              "740540807"
            ]
          },
          "740540807": {
            "id": "740540807",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, why don't we keep this paper tape for now? Who knows, it might come in handy later..."
          }
        }
      }
    },
    {
      "subId": "7405407",
      "subQuestName": "Additional",
      "sceneId": null,

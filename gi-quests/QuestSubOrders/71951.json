            ]
          },
          "719510104": {
            "id": "719510104",
            "speakerId": 10334,
            "speakerName": "Baiwen",
            "text": "Lady Ningguang's razor-sharp mind tears through vast amounts of information at pace, and quickly reaches a verdict. These pearls of wisdom are then discarded from the Jade Chamber, giving guidance on \"prosperity\" to the world below...",
            "nextDialogs": [
              "719510105"
            ]
          },
          "719510105": {
            "id": "719510105",
            "speakerId": 10334,
            "speakerName": "Baiwen",
            "text": "Do you, too, wish to learn of such things?"

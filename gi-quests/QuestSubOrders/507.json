  "subQuests": [
    {
      "subId": "50701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070101"
        ],
        "dialogs": {
          "5070101": {
            "id": "5070101",
            "speakerId": 1000,
            "speakerName": "Hanamizaka Bulletin Board",
            "text": "This Hanamizaka bulletin board was set up by the Shogunate. Notices regarding all sorts of matters will be posted here. Do not post without authorization."
          }
        }
      }
    },
    {
      "subId": "50702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070201"
        ],
        "dialogs": {
          "5070201": {
            "id": "5070201",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "A number of suspicious outlanders have entered Inazuma lately, wandering around with seemingly sinister motives.",
            "nextDialogs": [
              "5070202"
            ]
          },
          "5070202": {
            "id": "5070202",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "The Shogunate hereby notifies everyone: those who report suspicious persons will be rewarded, while those who harbor them will be punished!",
            "nextDialogs": [
              "5070203"
            ]
          },
          "5070203": {
            "id": "5070203",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "Glory to the Shogun and her everlasting reign!"
          }
        }
      }
    },
    {
      "subId": "50703",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070301"
        ],
        "dialogs": {
          "5070301": {
            "id": "5070301",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "The Vision Hunt Decree operation is coming to an end, but those who conceal their Visions still remain.",
            "nextDialogs": [
              "5070302"
            ]
          },
          "5070302": {
            "id": "5070302",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "Following the orders of the Tenryou Commissioner, and in compliance with the command of Madam Kujou Sara, pursuit operations will avoid using force or disrupting the public as much as possible.",
            "nextDialogs": [
              "5070303"
            ]
          },
          "5070303": {
            "id": "5070303",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "Please don't worry. The Tenryou Commission will not use its public duties as an excuse to intrude on your daily lives.",
            "nextDialogs": [
              "5070304"
            ]
          },
          "5070304": {
            "id": "5070304",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "The Tenryou Commissioner guarantees this in his own name, and that of the Kujou Clan."
          }
        }
      }
    },
    {
      "subId": "50704",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070401"
        ],
        "dialogs": {
          "5070401": {
            "id": "5070401",
            "speakerId": 1002,
            "speakerName": "Arataki \"The First\" Itto",
            "text": "\"Kujou Tengu! I am here again! Where are you?\"",
            "nextDialogs": [
              "5070402"
            ]
          },
          "5070402": {
            "id": "5070402",
            "speakerId": 1002,
            "speakerName": "Arataki \"The First\" Itto",
            "text": "\"I will never forget that you took my Vision away. As long as I still breathe, I will keep coming for you!\"",
            "nextDialogs": [
              "5070403"
            ]
          },
          "5070403": {
            "id": "5070403",
            "speakerId": 1002,
            "speakerName": "Arataki \"The First\" Itto",
            "text": "\"Don't you ever forget that either!\"",
            "nextDialogs": [
              "5070404"
            ]
          },
          "5070404": {
            "id": "5070404",
            "speakerId": 1003,
            "speakerName": "Reply",
            "text": "Everyone, no need to worry! The Tenryou Commission will handle this vandal soon.",
            "nextDialogs": [
              "5070405"
            ]
          },
          "5070405": {
            "id": "5070405",
            "speakerId": 1003,
            "speakerName": "Reply",
            "text": "Madam Kujou Sara promises that she has nothing to do with this person. Please do not worry."
          }
        }
      }
    },
    {
      "subId": "50705",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070501"
        ],
        "dialogs": {
          "5070501": {
            "id": "5070501",
            "speakerId": 1004,
            "speakerName": "Hiratsuka, Yae Publishing House",
            "text": "\"Though this is not a serious matter, I still hope that it will become more common knowledge.\"",
            "nextDialogs": [
              "5070502"
            ]
          },
          "5070502": {
            "id": "5070502",
            "speakerId": 1004,
            "speakerName": "Hiratsuka, Yae Publishing House",
            "text": "\"The other day, I accidentally lost the only extant copy of the famous 'Toki Alley Tales,' written by Takizawa Kyouden.\"",
            "nextDialogs": [
              "5070503"
            ]
          },
          "5070503": {
            "id": "5070503",
            "speakerId": 1004,
            "speakerName": "Hiratsuka, Yae Publishing House",
            "text": "\"Though it's nothing major, Lady Yae still insisted that I post a lost book notice to look for it. Ah, what a headache...\"",
            "nextDialogs": [
              "5070504"
            ]
          },
          "5070504": {
            "id": "5070504",
            "speakerId": 1004,
            "speakerName": "Hiratsuka, Yae Publishing House",
            "text": "\"That poor book has probably had its pages scattered to the winds by now... I don't suppose it would be possible to find it at this point.\"",
            "nextDialogs": [
              "5070505"
            ]
          },
          "5070505": {
            "id": "5070505",
            "speakerId": 1004,
            "speakerName": "Hiratsuka, Yae Publishing House",
            "text": "\"It really is nothing of note, but if anyone could help recover it, you will have the Yae Publishing House's thanks.\""
          }
        }
      }
    },
    {
      "subId": "50706",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070601"
        ],
        "dialogs": {
          "5070601": {
            "id": "5070601",
            "speakerId": 1005,
            "speakerName": "Fire Brigade Notification",
            "text": "\"If any citizen discovers Ms. Yoimiya setting off restricted fireworks inside the city, please try to stop her!\"",
            "nextDialogs": [
              "5070602"
            ]
          },
          "5070602": {
            "id": "5070602",
            "speakerId": 1005,
            "speakerName": "Fire Brigade Notification",
            "text": "\"...Or reprimand her, at least. Do not indulge her!\"",
            "nextDialogs": [
              "5070603"
            ]
          },
          "5070603": {
            "id": "5070603",
            "speakerId": 1005,
            "speakerName": "Fire Brigade Notification",
            "text": "\"The Fire Brigade hereby urges everyone to pay special attention. Thank you!\""
          }
        }
      }
    },
    {
      "subId": "50707",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070701"
        ],
        "dialogs": {
          "5070701": {
            "id": "5070701",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"Night-time robberies, piracy, and false documentation have been rampant in Inazuma lately.\"",
            "nextDialogs": [
              "5070702"
            ]
          },
          "5070702": {
            "id": "5070702",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"Smugglers, illegal traders, people stirring up trouble\"",
            "nextDialogs": [
              "5070703"
            ]
          },
          "5070703": {
            "id": "5070703",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"Imprisonment, bribery, people who travel freely\"",
            "nextDialogs": [
              "5070704"
            ]
          },
          "5070704": {
            "id": "5070704",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"Mandatory draft, stagnation, exploitation, and deceit\"",
            "nextDialogs": [
              "5070705"
            ]
          },
          "5070705": {
            "id": "5070705",
            "speakerId": 1003,
            "speakerName": "Reply",
            "text": "The above are all lies. None of this is true!",
            "nextDialogs": [
              "5070706"
            ]
          },
          "5070706": {
            "id": "5070706",
            "speakerId": 1003,
            "speakerName": "Reply",
            "text": "Any vandal caught will be punished severely by the Tenryou Commissioner!"
          }
        }
      }
    },
    {
      "subId": "50708",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070801"
        ],
        "dialogs": {
          "5070801": {
            "id": "5070801",
            "speakerId": 1007,
            "speakerName": "Amenoma Smithy Notice",
            "text": "\"Due to the war, the supply of Jade Steel has stagnated temporarily.\"",
            "nextDialogs": [
              "5070802"
            ]
          },
          "5070802": {
            "id": "5070802",
            "speakerId": 1007,
            "speakerName": "Amenoma Smithy Notice",
            "text": "\"Please wait a while longer if you have any need for Jade Steel weapon restoration or forging.\"",
            "nextDialogs": [
              "5070803"
            ]
          },
          "5070803": {
            "id": "5070803",
            "speakerId": 1007,
            "speakerName": "Amenoma Smithy Notice",
            "text": "\"I, Amenoma Tougo, sincerely apologize, and wish for your understanding.\""
          }
        }
      }
    },
    {
      "subId": "50709",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070901"
        ],
        "dialogs": {
          "5070901": {
            "id": "5070901",
            "speakerId": 1008,
            "speakerName": "Bantan Sango Advertisement",
            "text": "\"Bantan Sango: We'll investigate anything on your behalf!\"",
            "nextDialogs": [
              "5070902"
            ]
          },
          "5070902": {
            "id": "5070902",
            "speakerId": 1008,
            "speakerName": "Bantan Sango Advertisement",
            "text": "\"Missing persons, missing pets, marital investigations, criminal investigations, commercial commissions, delivery services, procurement services...\"",
            "nextDialogs": [
              "5070903"
            ]
          },
          "5070903": {
            "id": "5070903",
            "speakerId": 1008,
            "speakerName": "Bantan Sango Advertisement",
            "text": "\"Just make us a suitable offer, and we'll even capture the likes of bandit chiefs Zenigata or Domeki for you!\""
          }
        }
      }
    },
    {
      "subId": "50710",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071001"
        ],
        "dialogs": {
          "5071001": {
            "id": "5071001",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"I heard that another shipment of goods was stranded in Ritou due to piracy.\"",
            "nextDialogs": [
              "5071002"
            ]
          },
          "5071002": {
            "id": "5071002",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"This is ridiculous! Piracy hasn't been a problem for centuries ever since the end of Ako Domeki's reign of terror.\"",
            "nextDialogs": [
              "5071003"
            ]
          },
          "5071003": {
            "id": "5071003",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"As it stands, the Sakoku Decree has actually helped to revive smuggling and piracy...\"",
            "nextDialogs": [
              "5071004"
            ]
          },
          "5071004": {
            "id": "5071004",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"If this is the will of Her Excellency the Ogosho... the will of an Archon, us mortals simply cannot fathom its meaning.\"",
            "nextDialogs": [
              "5071005"
            ]
          },
          "5071005": {
            "id": "5071005",
            "speakerId": 1003,
            "speakerName": "Reply",
            "text": "It would be advisable for you to not attempt to fathom it."
          }
        }
      }
    },
    {
      "subId": "50711",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071101"
        ],
        "dialogs": {
          "5071101": {
            "id": "5071101",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"Higi Hirotaka, male, 35 years old. Retired samurai, former miner, physically fit, hard-working.\"",
            "nextDialogs": [
              "5071102"
            ]
          },
          "5071102": {
            "id": "5071102",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"Health guaranteed, no pre-existing illnesses! In urgent need of a job to feed a family of four.\"",
            "nextDialogs": [
              "5071103"
            ]
          },
          "5071103": {
            "id": "5071103",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"Available for interview everyday from 06:00 to 20:00!\"",
            "nextDialogs": [
              "5071104"
            ]
          },
          "5071104": {
            "id": "5071104",
            "speakerId": 1003,
            "speakerName": "Reply",
            "text": "Ritou dock job recruitment has opened. This post may be taken down."
          }
        }
      }
    },
    {
      "subId": "50712",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071201"
        ],
        "dialogs": {
          "5071201": {
            "id": "5071201",
            "speakerId": 1009,
            "speakerName": "Kiminami Restaurant Advertisement",
            "text": "\"The Kiminami Restaurant will only serve the freshest and most authentic Inazuma cuisine!\"",
            "nextDialogs": [
              "5071202"
            ]
          },
          "5071202": {
            "id": "5071202",
            "speakerId": 1009,
            "speakerName": "Kiminami Restaurant Advertisement",
            "text": "\"Anyone ordering take-out will be greeted with Miss. Anna's smile!\"",
            "nextDialogs": [
              "5071203"
            ]
          },
          "5071203": {
            "id": "5071203",
            "speakerId": 1009,
            "speakerName": "Kiminami Restaurant Advertisement",
            "text": "\"May a sweet smile bring you a beautiful day!\"",
            "nextDialogs": [
              "5071204"
            ]
          },
          "5071204": {
            "id": "5071204",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"She's just forcing herself to smile to bring in more business, isn't she...\""
          }
        }
      }
    },
    {
      "subId": "50713",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071301"
        ],
        "dialogs": {
          "5071301": {
            "id": "5071301",
            "speakerId": 1010,
            "speakerName": "Arrest Warrant",
            "text": "Bounty: Yoshino Koheiji, Yoshino Koheita",
            "nextDialogs": [
              "5071302"
            ]
          },
          "5071302": {
            "id": "5071302",
            "speakerId": 1010,
            "speakerName": "Arrest Warrant",
            "text": "Crimes committed: Absconding, robbery, night-time assaults, conspiring against officials, distributing belongings to innocent villagers to incite rebellion.",
            "nextDialogs": [
              "5071303"
            ]
          },
          "5071303": {
            "id": "5071303",
            "speakerId": 1010,
            "speakerName": "Arrest Warrant",
            "text": "Wanted dead or alive with a generous bounty!"
          }
        }
      }
    },
    {
      "subId": "50714",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071401"
        ],
        "dialogs": {
          "5071401": {
            "id": "5071401",
            "speakerId": 1010,
            "speakerName": "Arrest Warrant",
            "text": "Bounty: Midorikawa Shirou",
            "nextDialogs": [
              "5071402"
            ]
          },
          "5071402": {
            "id": "5071402",
            "speakerId": 1010,
            "speakerName": "Arrest Warrant",
            "text": "Crimes committed: Absconding, riotous assembly, piracy, robbing officials, ambushing samurai, holding family members as hostages in an attempt to rebel against the Shogunate.",
            "nextDialogs": [
              "5071403"
            ]
          },
          "5071403": {
            "id": "5071403",
            "speakerId": 1010,
            "speakerName": "Arrest Warrant",
            "text": "This person and his accomplices are wanted dead or alive with a generous bounty!"
          }
        }
      }
    },
    {
      "subId": "50715",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071501"
        ],
        "dialogs": {
          "5071501": {
            "id": "5071501",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "The fight against the rebels proceeds apace. Only one more strike, and they shall be destroyed completely.",
            "nextDialogs": [
              "5071502"
            ]
          },
          "5071502": {
            "id": "5071502",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "We hope that all young samurai will join together and fight to accomplish this great work!",
            "nextDialogs": [
              "5071503"
            ]
          },
          "5071503": {
            "id": "5071503",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "Come join the army! Or you may regret not having done anything for your country when the war is over!",
            "nextDialogs": [
              "5071504"
            ]
          },
          "5071504": {
            "id": "5071504",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "Please visit the Tenryou Commission for information about joining the army.",
            "nextDialogs": [
              "5071505"
            ]
          },
          "5071505": {
            "id": "5071505",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "Attention! Families that have received draft orders must send at least one adult to join the military.",
            "nextDialogs": [
              "5071506"
            ]
          },
          "5071506": {
            "id": "5071506",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"This 'final strike' has been going on for three months... and yet the resistance has not been put down.\"",
            "nextDialogs": [
              "5071507"
            ]
          },
          "5071507": {
            "id": "5071507",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "What right do those who haven't joined the army have to criticize the samurai fighting on the front line? It's because of their protection that you are able to complain!",
            "nextDialogs": [
              "5071508"
            ]
          },
          "5071508": {
            "id": "5071508",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"I am too old to take to the battlefield, and I thank all the young people for their contributions... it's just that my three sons have yet to come home.\"",
            "nextDialogs": [
              "5071509"
            ]
          },
          "5071509": {
            "id": "5071509",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"Could the Tenryou Commissioner please grant my son a few days' leave to come home so that I shall not have any lingering regrets on account of this war?\"",
            "nextDialogs": [
              "5071510"
            ]
          },
          "5071510": {
            "id": "5071510",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "We hope for this father's kind understanding on the matter. We know that everyone has family members at the frontline and everyone is restless, but please bear with us a bit more. Victory will be ours soon.",
            "nextDialogs": [
              "5071511"
            ]
          },
          "5071511": {
            "id": "5071511",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"Let's hope so. Let's hope so...\"",
            "nextDialogs": [
              "5071512"
            ]
          },
          "5071512": {
            "id": "5071512",
            "speakerId": 1001,
            "speakerName": "Tenryou Notice",
            "text": "Defacing of military draft notices is prohibited! Anyone caught again will face a heavy penalty!"
          }
        }
      }
    },
    {
      "subId": "50716",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071601"
        ],
        "dialogs": {
          "5071601": {
            "id": "5071601",
            "speakerId": 1011,
            "speakerName": "Grand Narukami Shrine Notice",
            "text": "With the permission of Guuji Yae Miko, the Grand Narukami Shrine will provide help to those businesses and families affected by the war in the form of aid loans and food aid.",
            "nextDialogs": [
              "5071602"
            ]
          },
          "5071602": {
            "id": "5071602",
            "speakerId": 1011,
            "speakerName": "Grand Narukami Shrine Notice",
            "text": "We ask that those in need of help visit the Kamisato Clan to file the required paperwork.",
            "nextDialogs": [
              "5071603"
            ]
          },
          "5071603": {
            "id": "5071603",
            "speakerId": 1011,
            "speakerName": "Grand Narukami Shrine Notice",
            "text": "As the war continues and public funds become more tight, food aid will be reduced by half. We apologize for any inconvenience.",
            "nextDialogs": [
              "5071604"
            ]
          },
          "5071604": {
            "id": "5071604",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"It's all a lie! When it was my turn yesterday, I was told that there was nothing left!\"",
            "nextDialogs": [
              "5071605"
            ]
          },
          "5071605": {
            "id": "5071605",
            "speakerId": 1006,
            "speakerName": "Message",
            "text": "\"There must be more food in the Yashiro Commission granaries, right? Lady Yae Miko, please do not let those so-called officials fool you!\"",
            "nextDialogs": [
              "5071606"
            ]
          },
          "5071606": {
            "id": "5071606",
            "speakerId": 1011,

  "subQuests": [
    {
      "subId": "7503201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750320101"
        ],
        "dialogs": {
          "750320101": {
            "id": "750320101",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Nice view, don't you think? Perfect for flying too. Soaring through the skies, following the wind... It's an awesome feeling all around.",
            "nextDialogs": [
              "750320104"
            ]
          },
          "750320104": {
            "id": "750320104",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Ho there, warrior! If it's a trial flight you're after, feel free.",
            "nextDialogs": [
              "750320105"
            ]
          },
          "750320105": {
            "id": "750320105",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "My father built this place for me, but I don't mind sharing it."
          }
        }
      }
    },
    {
      "subId": "7503208",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750320801"
        ],
        "dialogs": {
          "750320801": {
            "id": "750320801",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Not that easy, huh?",
            "nextDialogs": [
              "750320802"
            ]
          },
          "750320802": {
            "id": "750320802",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Our captain would be furious if word got out that we flying squad members could be surpassed by just any passing adventurer. Haha!",
            "nextDialogs": [
              "750320803"
            ]
          },
          "750320803": {
            "id": "750320803",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Alright, it's nothing to be upset about. I should be thanking you for keeping my pride intact, if anything.",
            "nextDialogs": [
              "750320804"
            ]
          },
          "750320804": {
            "id": "750320804",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "You flew quite well, but it's still too soon for you to surpass me.",
            "nextDialogs": [
              "750320805"
            ]
          },
          "750320805": {
            "id": "750320805",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "If you think you can do better, why don't you give it another try? You should never stop trying while you're young. Losing isn't a big deal anyway."
          }
        }
      }
    },
    {
      "subId": "7503202",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750320201"
        ],
        "dialogs": {
          "750320201": {
            "id": "750320201",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "So, are we competing, then?",
            "nextDialogs": [
              "750320202"
            ]
          },
          "750320202": {
            "id": "750320202",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Ride your Saurian, and fly at full speed along the course, striving to get the highest possible score within the time limit. <color=#00E1FFFF>It counts as a win for you as long as you exceed the second-highest score tier.</color>",
            "nextDialogs": [
              "750320204",
              "750320206"
            ]
          },
          "750320204": {
            "id": "750320204",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Nice! Let's head to the starting point."
          },
          "750320206": {
            "id": "750320206",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Of course. Just let me know when you're ready. Flying has always been about relaxing and having fun."
          }
        }
      }
    },
    {
      "subId": "7503209",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750320901"
        ],
        "dialogs": {
          "750320901": {
            "id": "750320901",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "I enjoyed flying with you! Let's do this again sometime —but until then, take care, young adventurer."
          }
        }
      }
    },
    {
      "subId": "7503203",
      "subQuestName": "Start the scored flight!",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7503204",
      "subQuestName": "Talk to Manyoya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750320401"
        ],
        "dialogs": {
          "750320401": {
            "id": "750320401",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Hahaha! You were great! Guess it's true what they say, that the young are bound to surpass the old.",
            "nextDialogs": [
              "750320402"
            ]
          },
          "750320402": {
            "id": "750320402",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Even stars may fall, let alone people.",
            "nextDialogs": [
              "750320403"
            ]
          },
          "750320403": {
            "id": "750320403",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "My time is over. Retiring happily was the right choice.",
            "nextDialogs": [
              "750320404"
            ]
          },
          "750320404": {
            "id": "750320404",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "...",
            "nextDialogs": [
              "750320405"
            ]
          },
          "750320405": {
            "id": "750320405",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "... Ah, but it's just so difficult to accept. I'm still young, I don't even have wrinkles. Why do I even have to retire?",
            "nextDialogs": [
              "750320406"
            ]
          },
          "750320406": {
            "id": "750320406",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "How could my career be over so soon? I started falling before I could even experience what it was like to reach the top.",
            "nextDialogs": [
              "750320407"
            ]
          },
          "750320407": {
            "id": "750320407",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Had I known I'd have so many regrets...",
            "nextDialogs": [
              "750320408"
            ]
          },
          "750320408": {
            "id": "750320408",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Never mind. If I could do it all again, I would still make the same choices.",
            "nextDialogs": [
              "750320409"
            ]
          },
          "750320409": {
            "id": "750320409",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "I would still do my best to join the flying squad, which isn't difficult given my skills. Then I'd wind up retiring at this age again.",
            "nextDialogs": [
              "750320410"
            ]
          },
          "750320410": {
            "id": "750320410",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "I've done my best, and all I can do now is accept it.",
            "nextDialogs": [
              "750320411"
            ]
          },
          "750320411": {
            "id": "750320411",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "I guess that's life. Many things are beyond our control, and if you dream of being a hero, perhaps you must accept that you can shine for but an instant.",
            "nextDialogs": [
              "750320412"
            ]
          },
          "750320412": {
            "id": "750320412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Manyoya...",
            "nextDialogs": [
              "750320413"
            ]
          },
          "750320413": {
            "id": "750320413",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "#Not to worry, {M#he}{F#she}'s a brilliant flier. You had this pitying look the whole time, so why the uneasy face now?",
            "nextDialogs": [
              "750320414"
            ]
          },
          "750320414": {
            "id": "750320414",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Haha! Life's full of surprises, and they'll come whether you accept 'em or not.",
            "nextDialogs": [
              "750320415"
            ]
          },
          "750320415": {
            "id": "750320415",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Consider it a pearl of wisdom from a retired Saurian rider. My issues are my own to solve. Don't let them ruin your mood.",
            "nextDialogs": [
              "750320416"
            ]
          },
          "750320416": {
            "id": "750320416",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "I'm impressed. If only my siblings were as calm as you are.",
            "nextDialogs": [
              "750320417"
            ]
          },
          "750320417": {
            "id": "750320417",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You have siblings?",
            "nextDialogs": [
              "750320418"
            ]
          },
          "750320418": {
            "id": "750320418",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "That's right. Two younger brothers, and unlike you, they're a chore and a half to get through to.",
            "nextDialogs": [
              "750320419"
            ]
          },
          "750320419": {
            "id": "750320419",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "They're training their flying skills too— Well, no. Acomitl's just focused on running away from it all, so he might've been hiding instead.",
            "nextDialogs": [
              "750320420"
            ]
          },
          "750320420": {
            "id": "750320420",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Forget about those brats. I can see your talent, clear as day.",
            "nextDialogs": [
              "750320421"
            ]
          },
          "750320421": {
            "id": "750320421",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Try training a little more if you get the time. Who knows? The flying squad may come knocking at your door.",
            "nextDialogs": [
              "750320422"
            ]
          },
          "750320422": {
            "id": "750320422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll try my best.",
            "nextDialogs": [
              "750320423"
            ]
          },
          "750320423": {
            "id": "750320423",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "That's good to hear. I hope I'll catch you flying again. Good luck, young warrior."
          }
        }
      }
    },
    {
      "subId": "7503206",
      "subQuestName": "Talk to Manyoya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750320601"
        ],
        "dialogs": {
          "750320601": {
            "id": "750320601",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "It's time for my Saurian to return to its nest. Shall I too descend from the stage in the skies?",
            "nextDialogs": [
              "750320603",
              "750320605"
            ]
          },
          "750320603": {
            "id": "750320603",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "I guess you heard me mumbling to myself, huh?",
            "nextDialogs": [
              "750320606"
            ]
          },
          "750320606": {
            "id": "750320606",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "I should make a trip home — haven't told my family about my retirement yet.",
            "nextDialogs": [
              "750320607"
            ]
          },
          "750320607": {
            "id": "750320607",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "I'll have a bunch of free time soon, but I haven't figured out what to do with it.",
            "nextDialogs": [
              "750320608"
            ]
          },
          "750320608": {
            "id": "750320608",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Once I find my bearings, I'll have to face the next stage of my life.",
            "nextDialogs": [
              "750320609"
            ]
          },
          "750320609": {
            "id": "750320609",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "So I should hear what my family has to say about it first. My father used to be in the flying squad, and he became a training master after retirement.",
            "nextDialogs": [
              "750320610"
            ]
          },
          "750320610": {
            "id": "750320610",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "He's been on this path, so he's got to have some thoughts on the matter.",
            "nextDialogs": [
              "750320611"
            ]
          },
          "750320611": {
            "id": "750320611",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "So, I'll be dismantling this place and taking it with me, but I'll leave the course here. Young warriors like you still need a place to train, after all.",
            "nextDialogs": [
              "750320612"
            ]
          },
          "750320612": {
            "id": "750320612",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Will we meet again, Manyoya?",
            "nextDialogs": [
              "750320613"
            ]
          },
          "750320613": {
            "id": "750320613",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "I don't know. But no matter what choice I make, I don't think I can ever give up on the skies.",
            "nextDialogs": [
              "750320614"
            ]
          },
          "750320614": {
            "id": "750320614",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "So as long as you don't stop flying, I think we'll meet again.",
            "nextDialogs": [
              "750320615"
            ]
          },
          "750320615": {
            "id": "750320615",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Until next time, then.",
            "nextDialogs": [
              "750320616"
            ]
          },
          "750320616": {
            "id": "750320616",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "See you, young warrior."
          },
          "750320605": {
            "id": "750320605",
            "speakerId": 6138,
            "speakerName": "Manyoya",
            "text": "Oh, there you are."
          }
        }
      }
    },

    {
      "subId": "7503299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750329901"
        ],
        "dialogs": {
          "750329901": {
            "id": "750329901",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "\"Sing me a song, call the flying Saurians and birds who have left their nests...\"",
            "nextDialogs": [
              "750329905"
            ]
          },
          "750329905": {
            "id": "750329905",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Do you hear that? Someone way up high is singing, and they're pretty good too. Wanna go say hello to them?"
          }
        }
      }

  "subQuests": [
    {
      "subId": "7469201",
      "subQuestName": "Talk to Diona",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746920101"
        ],
        "dialogs": {
          "746920101": {
            "id": "746920101",
            "speakerId": 1000,
            "speakerName": "Diona",
            "text": "...So you can't help me fix this annoying affliction either?",
            "nextDialogs": [
              "746920102"
            ]
          },
          "746920102": {
            "id": "746920102",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Precisely. It's already too deeply intertwined with your fate. Imagine your destiny is a tree — this \"affliction\" is like a new shoot growing from its branches.",
            "nextDialogs": [
              "746920103"
            ]
          },
          "746920103": {
            "id": "746920103",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "It's been helping you absorb sunlight and dew this whole time. It long ago began to shape your fate.",
            "nextDialogs": [
              "746920104"
            ]
          },
          "746920104": {
            "id": "746920104",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "If you cut it off now, the wound left behind might fester, infecting the entire tree.",
            "nextDialogs": [
              "746920105"
            ]
          },
          "746920105": {
            "id": "746920105",
            "speakerId": 1000,
            "speakerName": "Diona",
            "text": "Hmph... You make it sound like it's a good thing. It's clearly getting in my way, keeping me from mixing the drinks I need!",
            "nextDialogs": [
              "746920106"
            ]
          },
          "746920106": {
            "id": "746920106",
            "speakerId": 1000,
            "speakerName": "Diona",
            "text": "It's more like one of those vines that wrap around the trunks of giant trees — restricting their growth and slowly strangling them!",
            "nextDialogs": [
              "746920107"
            ]
          },
          "746920107": {
            "id": "746920107",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Well, if that were the case, your fate would have rejected it, and we could have easily pruned it away... Unfortunately for you, it's not at all what you say it is.",
            "nextDialogs": [
              "746920108"
            ]
          },
          "746920108": {
            "id": "746920108",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Alright, enough talk. That should be enough to convince you I'm a legitimate fortune teller, yes?",
            "nextDialogs": [
              "746920109"
            ]
          },
          "746920109": {
            "id": "746920109",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Now, just like I told you, come here and pick a card at random, and let me give you a little advice about your future.",
            "nextDialogs": [
              "746920110"
            ]
          },
          "746920110": {
            "id": "746920110",
            "speakerId": 1000,
            "speakerName": "Diona",
            "text": "Hmm... So, I just pick one at random, hm? Okay... How about this one...? No, wait, this one...!",
            "nextDialogs": [
              "746920111"
            ]
          },
          "746920111": {
            "id": "746920111",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "Don't overthink it — no matter how you choose, you can only ever draw the card that's destined for you. Hahahaha...",
            "nextDialogs": [
              "746920112"
            ]
          },
          "746920112": {
            "id": "746920112",
            "speakerId": 1000,
            "speakerName": "Diona",
            "text": "(*shudder*... This fortune teller's laugh is so creepy! She's just like an old witch from a fairy tale!)",
            "nextDialogs": [
              "746920113"
            ]
          },
          "746920113": {
            "id": "746920113",
            "speakerId": 1000,
            "speakerName": "Diona",
            "text": "(But since she's so good at it, her advice could prove really helpful... I have to choose my card carefully!)",
            "nextDialogs": [
              "746920116"
            ]
          },
          "746920116": {
            "id": "746920116",
            "speakerId": 1000,
            "speakerName": "Diona",
            "text": "#Huh? {NICKNAME}, Paimon?",
            "nextDialogs": [
              "746920117"
            ]
          },
          "746920117": {
            "id": "746920117",
            "speakerId": 1001,
            "speakerName": "Barbeloth",
            "text": "True to form, here you are at just the right moment."
          }
        }
      }
    },

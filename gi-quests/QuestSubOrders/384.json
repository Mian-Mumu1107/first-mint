  "subQuests": [
    {
      "subId": "38402",
      "subQuestName": "Go to Starsnatch Cliff",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3840201"
        ],
        "dialogs": {
          "3840201": {
            "id": "3840201",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Everyone is finally here.",
            "nextDialogs": [
              "3840202"
            ]
          },
          "3840202": {
            "id": "3840202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What a view...",
            "nextDialogs": [
              "3840203"
            ]
          },
          "3840203": {
            "id": "3840203",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Lovely for a fated reunion, isn't it?",
            "nextDialogs": [
              "3840204"
            ]
          },
          "3840204": {
            "id": "3840204",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Well, we must be prepared for a fight.",
            "nextDialogs": [
              "3840205"
            ]
          },
          "3840205": {
            "id": "3840205",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "Regardless of the outcome, things finally seem to be taking a turn for the better.",
            "nextDialogs": [
              "3840206"
            ]
          },
          "3840206": {
            "id": "3840206",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "Mondstadt has really been going through so much recently...",
            "nextDialogs": [
              "3840207"
            ]
          },
          "3840207": {
            "id": "3840207",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Huh! In the end, the solution to our problem was as simple as a traveler and a song.",
            "nextDialogs": [
              "3840208"
            ]
          },
          "3840208": {
            "id": "3840208",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I suppose the Knights of Favonius may have played a part in it too...",
            "nextDialogs": [
              "3840209"
            ]
          },
          "3840209": {
            "id": "3840209",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Oh, we get it, Master Diluc... Everyone, please step aside!",
            "nextDialogs": [
              "3840210"
            ]
          },
          "3840210": {
            "id": "3840210",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "I, the best wandering bard of the mortal world, shall begin my performance with the Holy Lyre."
          }
        }
      }
    },
    {
      "subId": "38403",
      "subQuestName": "Talk to Venti",
      "sceneId": null,

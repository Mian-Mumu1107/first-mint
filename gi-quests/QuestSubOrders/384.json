    {
      "subId": "38404",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3840401"
        ],
        "dialogs": {
          "3840401": {
            "id": "3840401",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "Barbat— Venti, please, be careful...",
            "nextDialogs": [
              "3840402"
            ]
          },
          "3840402": {
            "id": "3840402",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Hehe... You've known my true identity for some time now, haven't you Jean?",
            "nextDialogs": [
              "3840403"
            ]
          },
          "3840403": {
            "id": "3840403",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Though, I thank you for continuing to use the name Venti.",
            "nextDialogs": [
              "3840404"
            ]
          },
          "3840404": {
            "id": "3840404",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "How's the Holy Lyre?",
            "nextDialogs": [
              "3840405"
            ]
          },
          "3840405": {
            "id": "3840405",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Can it still be played? Or does it need to be repaired?",
            "nextDialogs": [
              "3840406"
            ]
          },
          "3840406": {
            "id": "3840406",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Wow...",
            "nextDialogs": [
              "3840407"
            ]
          },
          "3840407": {
            "id": "3840407",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Unfortunately, I think it's beyond repair...",
            "nextDialogs": [
              "3840409",
              "3840411"
            ]
          },
          "3840409": {
            "id": "3840409",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "You're right. If we don't fight the evil at its source, then we can't save Dvalin at all.",
            "nextDialogs": [
              "3840413"
            ]
          },
          "3840413": {
            "id": "3840413",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "In which case I shall call upon Outrider Amber to track it down...",
            "nextDialogs": [
              "3840414"
            ]
          },
          "3840414": {
            "id": "3840414",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "No need.",
            "nextDialogs": [
              "3840415"
            ]
          },
          "3840415": {
            "id": "3840415",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "Why is that?",
            "nextDialogs": [
              "3840416"
            ]
          },
          "3840416": {
            "id": "3840416",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I eradicated one not long ago, in one of the Four Winds' temples.",
            "nextDialogs": [
              "3840417"
            ]
          },
          "3840417": {
            "id": "3840417",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What!? When...?",
            "nextDialogs": [
              "3840418"
            ]
          },
          "3840418": {
            "id": "3840418",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "If you want to track those monsters down, then I'll seek answers from my contacts. I've got other means for getting the job done.",
            "nextDialogs": [
              "3840419"
            ]
          },
          "3840419": {
            "id": "3840419",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Diluc...",
            "nextDialogs": [
              "3840420"
            ]
          },
          "3840420": {
            "id": "3840420",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Though he dislikes the Knights of Favonius, he protects Mondstadt in his own way.",
            "nextDialogs": [
              "3840421"
            ]
          },
          "3840421": {
            "id": "3840421",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Ooh? Why does our little Paimon sound so doting all of a sudden?",
            "nextDialogs": [
              "3840422"
            ]
          },
          "3840422": {
            "id": "3840422",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Hmph.",
            "nextDialogs": [
              "3840423"
            ]
          },
          "3840423": {
            "id": "3840423",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Wait for my word.",
            "nextDialogs": [
              "3840424"
            ]
          },
          "3840424": {
            "id": "3840424",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I'll be sure to let the Abyss Order know that their blatant disregard for Mondstadt...",
            "nextDialogs": [
              "3840425"
            ]
          },
          "3840425": {
            "id": "3840425",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "...will not go unpunished."
          },
          "3840411": {
            "id": "3840411",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "No, we should make that Abyss Mage pay first!",
            "nextDialogs": [
              "3840412"
            ]
          },
          "3840412": {
            "id": "3840412",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "If we don't fight the evil at its source, then we can't save Dvalin at all."
          }
        }
      }
    },
    {
      "subId": "38406",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3840601"
        ],
        "dialogs": {
          "3840601": {
            "id": "3840601",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Huh? What's this...",
            "nextDialogs": [
              "3840602"
            ]
          },
          "3840602": {
            "id": "3840602",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "After the Abyss Mage was defeated, a certain energy dispersed from its body...",
            "nextDialogs": [
              "3840603"
            ]
          },
          "3840603": {
            "id": "3840603",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "This energy was meant to isolate me from Dvalin.",
            "nextDialogs": [
              "3840604"
            ]
          },
          "3840604": {
            "id": "3840604",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "...",
            "nextDialogs": [
              "3840605"
            ]
          },
          "3840605": {
            "id": "3840605",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "#{NICKNAME}, do you know of <color=#00E1FFFF>Stormterror's Lair</color>?",
            "nextDialogs": [
              "3840607",
              "3840609",
              "3840611"
            ]
          },
          "3840607": {
            "id": "3840607",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "But Jean and Master Diluc are no doubt aware of it.",
            "nextDialogs": [
              "3840612"
            ]
          },
          "3840612": {
            "id": "3840612",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Agreed.",
            "nextDialogs": [
              "3840613"
            ]
          },
          "3840613": {
            "id": "3840613",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Now Dvalin has turned the ruins into his lair.",
            "nextDialogs": [
              "3840614"
            ]
          },
          "3840614": {
            "id": "3840614",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Similar to the storms that enveloped Mondstadt, the entrance to his lair is also protected by nigh-invincible barriers.",
            "nextDialogs": [
              "3840615"
            ]
          },
          "3840615": {
            "id": "3840615",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "But now, as the energy dispersed from the Abyss Mage, I was able to read the rhythmic flow of how the barrier's magic was woven.",
            "nextDialogs": [
              "3840616"
            ]
          },
          "3840616": {
            "id": "3840616",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "I must admit, it sounds even more horrendous than a chorus of hilichurls, but...",
            "nextDialogs": [
              "3840617"
            ]
          },
          "3840617": {
            "id": "3840617",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "...It should be enough to let us break through the storm barrier and reach <color=#00E1FFFF>Stormterror's Lair</color>.",
            "nextDialogs": [
              "3840618"
            ]
          },
          "3840618": {
            "id": "3840618",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Which means we're going to confront Dvalin?",
            "nextDialogs": [
              "3840619"
            ]
          },
          "3840619": {
            "id": "3840619",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "I'm fine with that... Jean is the one who wishes to avoid any direct confrontation.",
            "nextDialogs": [
              "3840620"
            ]
          },
          "3840620": {
            "id": "3840620",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "No. When there are no other options left, it is my responsibility to alter our course of action.",
            "nextDialogs": [
              "3840621"
            ]
          },
          "3840621": {
            "id": "3840621",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "If slaying him is our only choice, I will gladly become the knight that leads the charge.",
            "nextDialogs": [
              "3840622"
            ]
          },
          "3840622": {
            "id": "3840622",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Fortunately, we have yet to need to go that far.",
            "nextDialogs": [
              "3840623"
            ]
          },
          "3840623": {
            "id": "3840623",
            "speakerId": 1009,
            "speakerName": "Diluc",
            "text": "Hmm?",
            "nextDialogs": [
              "3840624"
            ]
          },
          "3840624": {
            "id": "3840624",
            "speakerId": 1006,
            "speakerName": "Jean",
            "text": "By that, you mean...",
            "nextDialogs": [
              "3840625"
            ]
          },
          "3840625": {
            "id": "3840625",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "I mean that the Holy Lyre is not our trump card.",
            "nextDialogs": [
              "3840626"
            ]
          },
          "3840626": {
            "id": "3840626",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "#Our real trump card? {NICKNAME} of course.",
            "nextDialogs": [
              "3840627"
            ]
          },
          "3840627": {
            "id": "3840627",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}?"
          },
          "3840609": {
            "id": "3840609",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "I believe the people of Mondstadt have all heard of it."
          },
          "3840611": {
            "id": "3840611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "When we tried to enter, we were blocked off by the storm barrier."
          }
        }
      }
    }
  ]
}
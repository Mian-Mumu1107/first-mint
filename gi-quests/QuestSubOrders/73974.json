        "dialogs": {
          "739740101": {
            "id": "739740101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I see.",
            "nextDialogs": [
              "739740102"
            ]
          },
          "739740102": {
            "id": "739740102",
            "speakerId": 1000,
            "speakerName": "Kazim",
            "text": "The longer I work at this job, the more I come to think that everything should be planned out in advance, with contingencies to match.",
            "nextDialogs": [
              "739740103"
            ]
          },
          "739740103": {
            "id": "739740103",
            "speakerId": 1000,
            "speakerName": "Kazim",
            "text": "I'm very grateful to the Village Keepers for their aid, but we can't always rely on them.",
            "nextDialogs": [
              "739740104"
            ]
          },
          "739740104": {
            "id": "739740104",
            "speakerId": 1000,
            "speakerName": "Kazim",
            "text": "Preventing problems before they can occur is the safest way to go about things.",
            "nextDialogs": [
              "739740105"
            ]
          },
          "739740105": {
            "id": "739740105",
            "speakerId": 1000,
            "speakerName": "Kazim",
            "text": "That applies to you, too, I believe. There are always times when we need to do some repairs outdoors, so take this — better safe than sorry."
          }
        }
      }
    }
  ]

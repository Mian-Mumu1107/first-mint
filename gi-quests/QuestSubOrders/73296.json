    {
      "subId": "7329613",
      "subQuestName": "Talk to Julien",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732961601"
        ],
        "dialogs": {
          "732961601": {
            "id": "732961601",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "Phew... I didn't think that drawing was such a taxing thing to do. If I had known that, I would've...",
            "nextDialogs": [
              "732961602"
            ]
          },
          "732961602": {
            "id": "732961602",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Looks like that was still a bit much for Julien...",
            "nextDialogs": [
              "732961603"
            ]
          },
          "732961603": {
            "id": "732961603",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "Well, I did just... recover from my injuries... *pants*",
            "nextDialogs": [
              "732961604"
            ]
          },
          "732961604": {
            "id": "732961604",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "But the sights here are truly unique. Indeed, I think it's strange that I never noticed them before...",
            "nextDialogs": [
              "732961605"
            ]
          },
          "732961605": {
            "id": "732961605",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The view's pretty good up ahead as well. Let's head over there — but be careful, okay?"
          }
        }
      }
    },
    {
      "subId": "7329611",

  "subQuests": [
    {
      "subId": "7329602",
      "subQuestName": "Go to the camp by the water",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732960201"
        ],
        "dialogs": {
          "732960201": {
            "id": "732960201",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "#Paimon, {NICKNAME}, you're here! Ah, indeed, one needs friends when on a journey outdoors.",
            "nextDialogs": [
              "732960202"
            ]
          },
          "732960202": {
            "id": "732960202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, we did agree to show you the way, didn't we? Guiding people around is a walk in the park for us! Even though we'll be walking in a desert...",
            "nextDialogs": [
              "732960203"
            ]
          },
          "732960203": {
            "id": "732960203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But are you sure you want to go back to Fontaine so soon? You made it all the way to Sumeru, after all. There's still so much to see here!",
            "nextDialogs": [
              "732960205",
              "732960207"
            ]
          },
          "732960205": {
            "id": "732960205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "There's lots of trees and rivers!",
            "nextDialogs": [
              "732960208"
            ]
          },
          "732960208": {
            "id": "732960208",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "They all sound really nice, but I feel that... I haven't made proper preparations for travel. This trip might've been a failure, but I suppose I did learn a lesson or two...",
            "nextDialogs": [
              "732960209"
            ]
          },
          "732960209": {
            "id": "732960209",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, um... In that case, there's also great stuff to see nearby! It would be a pity if you missed them all.",
            "nextDialogs": [
              "732960210"
            ]
          },
          "732960210": {
            "id": "732960210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon's recommendations are never wrong.",
            "nextDialogs": [
              "732960211"
            ]
          },
          "732960211": {
            "id": "732960211",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "If you insist... I guess it would be rude if I were to refuse.",
            "nextDialogs": [
              "732960212"
            ]
          },
          "732960212": {
            "id": "732960212",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe, Paimon's Teyvat's number one guide, so leave the guiding to Paimon! Just remember to keep up."
          },
          "732960207": {
            "id": "732960207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Sand and ruins as far as your eyes can see!"
          }
        }
      }
    },
    {
      "subId": "7329603",
      "subQuestName": "Go to the Vourukasha Oasis",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732960301"
        ],
        "dialogs": {
          "732960301": {
            "id": "732960301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "They say that artists will observe their subject from many angles before they start. Is that some sort of... \"stereotype\"?",
            "nextDialogs": [
              "732960302"
            ]
          },
          "732960302": {
            "id": "732960302",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We could have a look around first, and if that fails, we can find a vantage point with a better view!",
            "nextDialogs": [
              "732960303"
            ]
          },
          "732960303": {
            "id": "732960303",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "That sounds like a good idea. I'm ready to set out.",
            "nextDialogs": [
              "732960304"
            ]
          },
          "732960304": {
            "id": "732960304",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Hehe, shall we race to the destination? Are you ready, {NICKNAME}?"
          }
        }
      }
    },
    {
      "subId": "7329604",
      "subQuestName": "Talk to Julien",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732960401"
        ],
        "dialogs": {
          "732960401": {
            "id": "732960401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This place is filled with nature's scent! Doesn't it just make you feel like sketching? Doesn't it make you feel inspired?",
            "nextDialogs": [
              "732960402"
            ]
          },
          "732960402": {
            "id": "732960402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Now that's a stereotype.",
            "nextDialogs": [
              "732960403"
            ]
          },
          "732960403": {
            "id": "732960403",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Um... But it does make Paimon wanna pick up a brush! This place is so full of vitality, and the colors are so vivid...",
            "nextDialogs": [
              "732960404"
            ]
          },
          "732960404": {
            "id": "732960404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ahem.",
            "nextDialogs": [
              "732960405"
            ]
          },
          "732960405": {
            "id": "732960405",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh...",
            "nextDialogs": [
              "732960406"
            ]
          },
          "732960406": {
            "id": "732960406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon's sorry... Paimon didn't mean to...",
            "nextDialogs": [
              "732960407"
            ]
          },
          "732960407": {
            "id": "732960407",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "Haha, it's fine. I just see something different, that's all. We can all appreciate beauty, right?",
            "nextDialogs": [
              "732960408"
            ]
          },
          "732960408": {
            "id": "732960408",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's right! Paimon loves this place. It's almost as if it can purify your heart and soul.",
            "nextDialogs": [
              "732960409"
            ]
          },
          "732960409": {
            "id": "732960409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not that you need it, Paimon.",
            "nextDialogs": [
              "732960410"
            ]
          },
          "732960410": {
            "id": "732960410",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "My friends, thank you for showing me such kindness — even to someone like me, who has failed to tell you the truth from the beginning.",
            "nextDialogs": [
              "732960411"
            ]
          },
          "732960411": {
            "id": "732960411",
            "speakerId": 1000,
            "speakerName": "Julien",
            "text": "You are both indeed pure of heart.",
            "nextDialogs": [
              "732960412"
            ]
          },
          "732960412": {
            "id": "732960412",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe... No need to exaggerate so much. Oh, and there are actually more unique sights than this!",
            "nextDialogs": [
              "732960413"
            ]
          },
          "732960413": {
            "id": "732960413",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Paimon's sure you know what she's referring to, {NICKNAME}. Let's show it to Julien as well!"
          }
        }
      }
    },
    {
      "subId": "7329612",

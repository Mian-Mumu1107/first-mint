    {
      "subId": "7103301",
      "subQuestName": "Talk to Vermeer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330101"
        ],
        "dialogs": {
          "710330101": {
            "id": "710330101",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "Over here, Traveler, over here!",
            "nextDialogs": [
              "710330102"
            ]
          },
          "710330102": {
            "id": "710330102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're the artist who made an arrangement with Qingzhou earlier...",
            "nextDialogs": [
              "710330103"
            ]
          },
          "710330103": {
            "id": "710330103",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "Yes, that's me. That poet and I agreed that we would each create a work of art that sums the Lantern Rite up.",
            "nextDialogs": [
              "710330104"
            ]
          },
          "710330104": {
            "id": "710330104",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "You even helped me to find my paints and brushes back then, remember?",
            "nextDialogs": [
              "710330107"
            ]
          },
          "710330107": {
            "id": "710330107",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "My painting... Ahem, well... I have actually painted a lot already — scenes, people, even animals...",
            "nextDialogs": [
              "710330108"
            ]
          },
          "710330108": {
            "id": "710330108",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "I'm confident that these works accurately portray their subjects, but... I can't say any of them really sums up the Lantern Rite...",
            "nextDialogs": [
              "710330109"
            ]
          },
          "710330109": {
            "id": "710330109",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "*sigh* I haven't been able to eat or sleep for days with this hanging over my head. I've practically used up all my paint, and still none of my paintings really capture the spirit of the festival.",
            "nextDialogs": [
              "710330110"
            ]
          },
          "710330110": {
            "id": "710330110",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "So, I want to go find that poet and see how his poem is coming along.",
            "nextDialogs": [
              "710330111"
            ]
          },
          "710330111": {
            "id": "710330111",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "Traveler, do you know where he headed off to?",
            "nextDialogs": [
              "710330112"
            ]
          },
          "710330112": {
            "id": "710330112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He went to Qingce Village.",
            "nextDialogs": [
              "710330113"
            ]
          },
          "710330113": {
            "id": "710330113",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "Qingce Village? What did he go there for? ...Poetic inspiration?",
            "nextDialogs": [
              "710330114"
            ]
          },
          "710330114": {
            "id": "710330114",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "Quick, Traveler, we must get to Qingce Village and find him! Perhaps I may also be able to find some inspiration there...",
            "nextDialogs": [
              "710330115"
            ]
          },
          "710330115": {
            "id": "710330115",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "Ahem! Anyway, let's set out!"
          }
        }
      }
    },
    {
      "subId": "7103302",
      "subQuestName": "Go to Qingce Village",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7103303",
      "subQuestName": "Talk to Vermeer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330301"
        ],
        "dialogs": {
          "710330301": {
            "id": "710330301",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "This is Qingce Village, then... Where's that poet? Has he gone to look for inspiration somewhere?",
            "nextDialogs": [
              "710330302"
            ]
          },
          "710330302": {
            "id": "710330302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Last time we met, he was playing lantern riddle games with the children...",
            "nextDialogs": [
              "710330303"
            ]
          },
          "710330303": {
            "id": "710330303",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "L—Lantern riddles? What is the meaning of this...?",
            "nextDialogs": [
              "710330304"
            ]
          },
          "710330304": {
            "id": "710330304",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "Did he fail to find inspiration for his poem and give up altogether?",
            "nextDialogs": [
              "710330305"
            ]
          },
          "710330305": {
            "id": "710330305",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "Anyhow, regardless of what he is up to, the Lantern Rite is almost over — there's no time to waste.",
            "nextDialogs": [
              "710330306"
            ]
          },
          "710330306": {
            "id": "710330306",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "Let's go ask the person in charge around here. Today I absolutely must see where our competition stands."
          }
        }
      }
    },
    {
      "subId": "7103304",
      "subQuestName": "Talk to Granny Ruoxin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330401"
        ],
        "dialogs": {
          "710330401": {
            "id": "710330401",
            "speakerId": 1002,
            "speakerName": "Granny Ruoxin",
            "text": "Why, if it isn't the Traveler. Thanks to you, our village finally has some festive cheer to it...",
            "nextDialogs": [
              "710330402"
            ]
          },
          "710330402": {
            "id": "710330402",
            "speakerId": 1002,
            "speakerName": "Granny Ruoxin",
            "text": "Oh, you've brought a new face with you, I see? If I may ask...",
            "nextDialogs": [
              "710330403"
            ]
          },
          "710330403": {
            "id": "710330403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He's an artist, and he's here to look for Qingzhou.",
            "nextDialogs": [
              "710330404"
            ]
          },
          "710330404": {
            "id": "710330404",
            "speakerId": 1002,
            "speakerName": "Granny Ruoxin",
            "text": "Looking for Mr. Qingzhou, is he? Hmm, that's just as well...",
            "nextDialogs": [
              "710330405"
            ]
          },
          "710330405": {
            "id": "710330405",
            "speakerId": 1002,
            "speakerName": "Granny Ruoxin",
            "text": "When Miss Wang'ya left several days ago, Mr. Qingzhou said that he would like to stay here for a while longer.",
            "nextDialogs": [
              "710330406"
            ]
          },
          "710330406": {
            "id": "710330406",
            "speakerId": 1002,
            "speakerName": "Granny Ruoxin",
            "text": "He should still be making up lantern riddles for the children. If my memory serves, he's taken them outside...",
            "nextDialogs": [
              "710330407"
            ]
          },
          "710330407": {
            "id": "710330407",
            "speakerId": 1002,
            "speakerName": "Granny Ruoxin",
            "text": "You'll probably have to find him outside.",
            "nextDialogs": [
              "710330408"
            ]
          },
          "710330408": {
            "id": "710330408",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "He really is playing lantern riddle games... Traveler, if you could do me a favor...",
            "nextDialogs": [
              "710330409"
            ]
          },
          "710330409": {
            "id": "710330409",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "Go tell that poet that I've come. I will be here getting ready.",
            "nextDialogs": [
              "710330410"
            ]
          },
          "710330410": {
            "id": "710330410",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "No matter what, today I must see where our competition stands..."
          }
        }
      }
    },
    {
      "subId": "7103305",
      "subQuestName": "Talk to Qingzhou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330501"
        ],
        "dialogs": {
          "710330501": {
            "id": "710330501",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Hahaha, I think you're all getting the hang of it. You're getting the answers faster and faster every time.",
            "nextDialogs": [
              "710330504"
            ]
          },
          "710330504": {
            "id": "710330504",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Vermeer... Ah, yes, that artist. Let me see... by my count, this is indeed the agreed date.",
            "nextDialogs": [
              "710330505"
            ]
          },
          "710330505": {
            "id": "710330505",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Pity, then, that my poem remains as yet unfinished. Nor have these children yet had their fill of these lantern riddles...",
            "nextDialogs": [
              "710330506"
            ]
          },
          "710330506": {
            "id": "710330506",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Well, perhaps this is the uttermost limit of my poetic skill, then... Would you, perchance, accompany me to gather some inspiration once again?",
            "nextDialogs": [
              "710330507"
            ]
          },
          "710330507": {
            "id": "710330507",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Hmm, perhaps I should say not that it is \"gathering inspiration,\" rather, let us walk together.",
            "nextDialogs": [
              "710330508"
            ]
          },
          "710330508": {
            "id": "710330508",
            "speakerId": 1004,
            "speakerName": "Little Zuo",
            "text": "Uncle Qingzhou! Does this mean we're not solving lantern riddles anymore? I still want to give them a try!",
            "nextDialogs": [
              "710330509"
            ]
          },
          "710330509": {
            "id": "710330509",
            "speakerId": 1005,
            "speakerName": "Little Liu",
            "text": "I wanna solve some lantern riddles too, Uncle Qingzhou...",
            "nextDialogs": [
              "710330510"
            ]
          },
          "710330510": {
            "id": "710330510",
            "speakerId": 1006,
            "speakerName": "Little You",
            "text": "Hmph, I want to solve a few more, too...",
            "nextDialogs": [
              "710330511"
            ]
          },
          "710330511": {
            "id": "710330511",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Hahaha, settle down, children. I shall just go for a short stroll with this friendly traveler here. I shall return soon to give you all a new lantern riddle.",
            "nextDialogs": [
              "710330512"
            ]
          },
          "710330512": {
            "id": "710330512",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Go on back to Qingce Village and I will find you there when I get back. How's that?",
            "nextDialogs": [
              "710330513"
            ]
          },
          "710330513": {
            "id": "710330513",
            "speakerId": 1004,
            "speakerName": "Little Zuo",
            "text": "Okay! You're amazing, Uncle Qingzhou — you can come up with so many riddles!",
            "nextDialogs": [
              "710330514"
            ]
          },
          "710330514": {
            "id": "710330514",
            "speakerId": 1005,
            "speakerName": "Little Liu",
            "text": "You read tons of books, don't you, Uncle Qingzhou...?",
            "nextDialogs": [
              "710330515"
            ]
          },
          "710330515": {
            "id": "710330515",
            "speakerId": 1006,
            "speakerName": "Little You",
            "text": "I want to grow up to be just like you, Uncle Qingzhou...",
            "nextDialogs": [
              "710330516"
            ]
          },
          "710330516": {
            "id": "710330516",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "...",
            "nextDialogs": [
              "710330517"
            ]
          },
          "710330517": {
            "id": "710330517",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Well, let us go then, Traveler. Let us bring this trivial matter to an end, can't leave those children waiting too long now."
          }
        }
      }
    },
    {
      "subId": "7103306",
      "subQuestName": "Follow Qingzhou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330601"
        ],
        "dialogs": {
          "710330601": {
            "id": "710330601",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "The scenery here is... Heh, perfect for a lantern riddle."
          }
        }
      }
    },
    {
      "subId": "7103307",
      "subQuestName": "Follow Qingzhou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330701"
        ],
        "dialogs": {
          "710330701": {
            "id": "710330701",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Not bad. Quite suitable for writing a lantern riddle."
          }
        }
      }
    },
    {
      "subId": "7103308",
      "subQuestName": "Follow Qingzhou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330801"
        ],
        "dialogs": {
          "710330801": {
            "id": "710330801",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Hmm... Alright, I've got it — one sentence for the lantern riddle."
          }
        }
      }
    },
    {
      "subId": "7103309",
      "subQuestName": "Talk to Qingzhou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330901"
        ],
        "dialogs": {
          "710330901": {
            "id": "710330901",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Alright then, the lantern riddle is all done. Let us go to Qingce Village now.",
            "nextDialogs": [
              "710330902"
            ]
          },
          "710330902": {
            "id": "710330902",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "I will tell you the riddle once we arrive."
          }
        }
      }
    },
    {
      "subId": "7103310",
      "subQuestName": "Talk to the children",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710331001"
        ],
        "dialogs": {
          "710331001": {
            "id": "710331001",
            "speakerId": 1005,
            "speakerName": "Little Liu",
            "text": "Uncle Qingzhou's back! Uncle Qingzhou, have you finished writing a new lantern riddle for us?",
            "nextDialogs": [
              "710331002"
            ]
          },
          "710331002": {
            "id": "710331002",
            "speakerId": 1004,
            "speakerName": "Little Zuo",
            "text": "I'll get it right this time... I think!",
            "nextDialogs": [
              "710331003"
            ]
          },
          "710331003": {
            "id": "710331003",
            "speakerId": 1006,
            "speakerName": "Little You",
            "text": "I'll think this one through carefully...",
            "nextDialogs": [
              "710331004"
            ]
          },
          "710331004": {
            "id": "710331004",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Hahaha, yes, I've already written down the lantern riddle.",
            "nextDialogs": [
              "710331005"
            ]
          },
          "710331005": {
            "id": "710331005",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "My liege, please help me hang this Xiao Lantern up... A little higher, if you would."
          }
        }
      }
    },
    {
      "subId": "7103315",
      "subQuestName": "Hang the lantern riddle",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710331501"
        ],
        "dialogs": {
          "710331501": {
            "id": "710331501",
            "speakerId": 1007,
            "speakerName": "Lantern Riddle",
            "text": "\"Countless ships over the waves do glide, their lamps lighting up Guyun's stones. They float along with the ocean tide, till with dragon and fish they rest at last their bones.\""
          }
        }
      }
    },
    {
      "subId": "7103314",
      "subQuestName": "Talk to Qingzhou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710331401"
        ],
        "dialogs": {
          "710331401": {
            "id": "710331401",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Children, look at this Xiao Lantern. The riddle's answer is a \"thing\" at the Lantern Rite. Go on, guess.",
            "nextDialogs": [
              "710331402"
            ]
          },
          "710331402": {
            "id": "710331402",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "I must go tend to a matter with this here traveler. I'll be back to play with you once I'm done.",
            "nextDialogs": [
              "710331403"
            ]
          },
          "710331403": {
            "id": "710331403",
            "speakerId": 1005,
            "speakerName": "Little Liu",
            "text": "Aww! Uncle Qingzhou, what have you gotta go do?",
            "nextDialogs": [
              "710331404"
            ]
          },
          "710331404": {
            "id": "710331404",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "I must go find a certain painter to settle a certain... competition. I write the best poem and he creates the best painting, and we see whose work is better.",
            "nextDialogs": [
              "710331405"
            ]
          },
          "710331405": {
            "id": "710331405",
            "speakerId": 1004,
            "speakerName": "Little Zuo",
            "text": "Well, you're going to win for sure, Uncle Qingzhou. All of those lantern riddles you made were great!",
            "nextDialogs": [
              "710331406"
            ]
          },
          "710331406": {
            "id": "710331406",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Is that so? Thank you for your praise. Take this Xiao Lantern to Qingce Village first and try to guess it. It's not safe alone in the wild.",
            "nextDialogs": [
              "710331407"
            ]
          },
          "710331407": {
            "id": "710331407",
            "speakerId": 1004,
            "speakerName": "Little Zuo",
            "text": "Don't worry, Uncle Qingzhou! We're familiar with around here, we can make it back on our own. Go and show that painter what you got!",
            "nextDialogs": [
              "710331408"
            ]
          },
          "710331408": {
            "id": "710331408",
            "speakerId": 1006,
            "speakerName": "Little You",
            "text": "Then... Uncle Qingzhou, after you finish your competition with that painter, hurry on back to play with us.",
            "nextDialogs": [
              "710331409"
            ]
          },
          "710331409": {
            "id": "710331409",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Of course. I will go find you as soon as I'm done tending to the matter.",
            "nextDialogs": [
              "710331411"
            ]
          },
          "710331411": {
            "id": "710331411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We've got a winner.",
            "nextDialogs": [
              "710331412"
            ]
          },
          "710331412": {
            "id": "710331412",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Hehe, that's not even a poem, my liege. Nothing more than a lantern riddle.",
            "nextDialogs": [
              "710331413"
            ]
          },
          "710331413": {
            "id": "710331413",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Alrighty. We shall find that painter then. He's been waiting long enough."
          }
        }
      }
    },
    {
      "subId": "7103311",
      "subQuestName": "Talk to Vermeer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710331101"
        ],
        "dialogs": {
          "710331101": {
            "id": "710331101",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "You're here at last. Have you written that poem?",
            "nextDialogs": [
              "710331102"
            ]
          },
          "710331102": {
            "id": "710331102",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "No, I have not penned anything suitable.",
            "nextDialogs": [
              "710331103"
            ]
          },
          "710331103": {
            "id": "710331103",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "S—So you too... Ahem, so you haven't, have you?",
            "nextDialogs": [
              "710331104"
            ]
          },
          "710331104": {
            "id": "710331104",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Liyue is large and its households are many. I pondered the matter long, yet I could not find an appropriate summation for Lantern Rite. Have you, then, finished your painting?",
            "nextDialogs": [
              "710331105"
            ]
          },
          "710331105": {
            "id": "710331105",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "I... I haven't either. Liyue's too large! How could I paint it all, unless the sky itself were to be my canvas?",
            "nextDialogs": [
              "710331106"
            ]
          },
          "710331106": {
            "id": "710331106",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "So in the end, neither of us was able to create a poem or an artwork that could encompass Liyue Harbor and the Lantern Rite.",
            "nextDialogs": [
              "710331107"
            ]
          },
          "710331107": {
            "id": "710331107",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "I suppose, then, that this may be considered a draw.",
            "nextDialogs": [
              "710331108"
            ]
          },
          "710331108": {
            "id": "710331108",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "Uh... fine, alright then.",
            "nextDialogs": [
              "710331109"
            ]
          },
          "710331109": {
            "id": "710331109",
            "speakerId": 1004,
            "speakerName": "Little Zuo",
            "text": "Uncle Qingzhou, Uncle Qingzhou! We've figured that lantern riddle out!",
            "nextDialogs": [
              "710331110"
            ]
          },
          "710331110": {
            "id": "710331110",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "L—Lantern riddle? What lantern riddle?",
            "nextDialogs": [
              "710331111"
            ]
          },
          "710331111": {
            "id": "710331111",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "It's nothing, really. I just came up with some lantern riddles to entertain these kids.",
            "nextDialogs": [
              "710331112"
            ]
          },
          "710331112": {
            "id": "710331112",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "Oh? What is it? Can you tell me one?",
            "nextDialogs": [
              "710331113"
            ]
          },
          "710331113": {
            "id": "710331113",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "\"Countless ships over the waves do glide, their lamps lighting up Guyun's stones. They float along with the ocean tide, till with dragon and fish they rest at last their bones.\"",
            "nextDialogs": [
              "710331114"
            ]
          },
          "710331114": {
            "id": "710331114",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "You wrote this riddle for kids? It's...",
            "nextDialogs": [
              "710331115"
            ]
          },
          "710331115": {
            "id": "710331115",
            "speakerId": 1004,
            "speakerName": "Little Zuo",
            "text": "Uncle Qingzhou, who's this other uncle?",
            "nextDialogs": [
              "710331118"
            ]
          },
          "710331118": {
            "id": "710331118",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "If this poet didn't want to compete with me, then why would he make that agreement?",
            "nextDialogs": [
              "710331119"
            ]
          },
          "710331119": {
            "id": "710331119",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "You're mistaken. At first, I indeed saw it as a competition... I spent much energy going everywhere in search of inspiration... wanting to compose the perfect poem.",
            "nextDialogs": [
              "710331120"
            ]
          },
          "710331120": {
            "id": "710331120",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "But, as you may have realized as well, it's impossible to encompass Liyue Harbor and the Lantern Rite in just a few lines of words. So...",
            "nextDialogs": [
              "710331121"
            ]
          },
          "710331121": {
            "id": "710331121",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "So, you came here to play lantern riddle games with children?",
            "nextDialogs": [
              "710331122"
            ]
          },
          "710331122": {
            "id": "710331122",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Exactly, so I came to play with children, hoping I would find some poetic inspiration in these delightful lantern riddle games.",
            "nextDialogs": [
              "710331123"
            ]
          },
          "710331123": {
            "id": "710331123",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Hehe, though I never found inspiration for my poem, I was able come up with a number of lantern riddles. The children have certainly enjoyed it.",
            "nextDialogs": [
              "710331124"
            ]
          },
          "710331124": {
            "id": "710331124",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Perhaps... this experience is the very poem I sought. But alas, where would I begin writing it? Thus, with no poem, I have no way of competing with you.",
            "nextDialogs": [
              "710331125"
            ]
          },
          "710331125": {
            "id": "710331125",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "You people of Liyue... are so strange! Then what about our competition? Who won and who lost? A draw is simply unacceptable to me.",
            "nextDialogs": [
              "710331126"
            ]
          },
          "710331126": {
            "id": "710331126",
            "speakerId": 1004,
            "speakerName": "Little Zuo",
            "text": "This other uncle sure likes to talk a lot... of course the winner is Uncle Qingzhou!",
            "nextDialogs": [
              "710331127"
            ]
          },
          "710331127": {
            "id": "710331127",
            "speakerId": 1004,
            "speakerName": "Little Zuo",
            "text": "He's awesome. He came up with so many lantern riddles, and I bet you can't even guess the answers to them!",
            "nextDialogs": [
              "710331128"
            ]
          },
          "710331128": {
            "id": "710331128",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "This poet... Hmm? Hold on, I have an idea...",
            "nextDialogs": [
              "710331129"
            ]
          },
          "710331129": {
            "id": "710331129",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "How about this — let's have a new competition!",
            "nextDialogs": [
              "710331130"
            ]
          },
          "710331130": {
            "id": "710331130",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Oh? And how do you propose we commence this new competition?",
            "nextDialogs": [
              "710331131"
            ]
          },
          "710331131": {
            "id": "710331131",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "You created a lot of lantern riddles for these kids, right? Well, when I was searching for inspiration for my painting, I saw lots of Xiao Lanterns and their decorative patterns.",
            "nextDialogs": [
              "710331132"
            ]
          },
          "710331132": {
            "id": "710331132",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "You write the riddle, and I'll paint the Xiao Lantern. The children will serve as judges, and whoever's work they like more will be deemed winner. Is that fair?",
            "nextDialogs": [
              "710331133"
            ]
          },
          "710331133": {
            "id": "710331133",
            "speakerId": 1003,
            "speakerName": "Qingzhou",
            "text": "Okay! It suits me just fine, and also suits the spirit of the Lantern Rite. A very suitable competition indeed.",
            "nextDialogs": [
              "710331134"
            ]
          },
          "710331134": {
            "id": "710331134",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "Then it's settled. Let me first prepare my painting supplies, and then let our new competition commence!"
          }
        }
      }
    },
    {
      "subId": "7103312",
      "subQuestName": "Talk to Granny Ruoxin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710331201"
        ],
        "dialogs": {
          "710331201": {
            "id": "710331201",
            "speakerId": 1002,
            "speakerName": "Granny Ruoxin",
            "text": "Oh, do you need anything?",
            "nextDialogs": [
              "710331202"
            ]
          },
          "710331202": {
            "id": "710331202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Qingzhou and Vermeer...",
            "nextDialogs": [
              "710331203"
            ]
          },
          "710331203": {
            "id": "710331203",
            "speakerId": 1002,
            "speakerName": "Granny Ruoxin",
            "text": "Oh, those two? Don't worry about them. As long as they're willing to accompany the children, I'm fine with them.",
            "nextDialogs": [
              "710331204"
            ]
          },
          "710331204": {
            "id": "710331204",
            "speakerId": 1002,
            "speakerName": "Granny Ruoxin",
            "text": "This is a festive season, after all. It's good for things to be lively.",
            "nextDialogs": [
              "710331205"
            ]
          },
          "710331205": {
            "id": "710331205",
            "speakerId": 1002,
            "speakerName": "Granny Ruoxin",
            "text": "You are always running around helping out Qingce Village. Thank you, child.",
            "nextDialogs": [
              "710331208"
            ]
          },
          "710331208": {
            "id": "710331208",
            "speakerId": 1002,
            "speakerName": "Granny Ruoxin",
            "text": "You sure are a kind-hearted child... Here, take these as thanks. You must have yourself a happy festival as well, now.",
            "nextDialogs": [
              "710331209"
            ]
          },
          "710331209": {
            "id": "710331209",
            "speakerId": 1002,
            "speakerName": "Granny Ruoxin",
            "text": "I hope that future Lantern Rites here will be this exciting..."
          }
        }
      }
    },
    {
      "subId": "7103350",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710335001"
        ],
        "dialogs": {
          "710335001": {
            "id": "710335001",
            "speakerId": 1002,
            "speakerName": "Granny Ruoxin",
            "text": "What brings you here looking for Mr. Qingzhou?",
            "nextDialogs": [
              "710335002"
            ]
          },
          "710335002": {
            "id": "710335002",
            "speakerId": 1001,
            "speakerName": "Vermeer",
            "text": "Hmm... Nothing too important, just a painting and a poem, is all..."
          }
        }
      }
    },
    {
      "subId": "7103351",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710335101"
        ],
        "dialogs": {
          "710335101": {
            "id": "710335101",
            "speakerId": 1005,
            "speakerName": "Little Liu",
            "text": "So, have you solved the riddle yet?"
          }
        }
      }
    },
    {
      "subId": "7103352",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710335201"
        ],
        "dialogs": {
          "710335201": {
            "id": "710335201",
            "speakerId": 1006,
            "speakerName": "Little You",
            "text": "Uncle Qingzhou is soooo smart! How many books do I have to read to be that smart..."
          }
        }
      }
    },
    {
      "subId": "7103353",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710335301"
        ],
        "dialogs": {
          "710335301": {
            "id": "710335301",
            "speakerId": 1004,
            "speakerName": "Little Zuo",
            "text": "What's the answer? Maybe we should put our heads together?"
          }
        }
      }
    }
  ]
}
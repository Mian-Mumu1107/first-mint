    {
      "subId": "1101004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110100402"
        ],
        "dialogs": {
          "110100402": {
            "id": "110100402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And here's another one. Yep, seems the Ruin Guards did come out for a walk after all.",
            "nextDialogs": [
              "110100403"
            ]
          },
          "110100403": {
            "id": "110100403",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The trail of Ruin Guard footprints leads us here, to... Ah! A Ruin Guard! Over there!"
          }
        }
      }
    },
    {
      "subId": "1101006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110100601"
        ],
        "dialogs": {
          "110100601": {
            "id": "110100601",
            "speakerId": 1000,
            "speakerName": "Daipai",
            "text": "I must continue with my patrol now. Let's rendezvous shortly."
          }
        }
      }

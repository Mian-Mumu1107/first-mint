    {
      "subId": "1101003",
      "subQuestName": "Defeat the Ruin Guard",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110100301"
        ],
        "dialogs": {
          "110100301": {
            "id": "110100301",
            "speakerId": 1003,
            "speakerName": "Ekaterina",
            "text": "That seems a little inappropriate, don't you think, sir? How can you—",
            "nextDialogs": [
              "110100302"
            ]
          },
          "110100302": {
            "id": "110100302",
            "speakerId": 1004,
            "speakerName": "Childe",
            "text": "Relax, once in a while can't hurt. It'll be fine!",
            "nextDialogs": [
              "110100303"
            ]
          },
          "110100303": {
            "id": "110100303",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? What's he doing here...",
            "nextDialogs": [
              "110100304"
            ]
          },
          "110100304": {
            "id": "110100304",
            "speakerId": 1005,
            "speakerName": "Teucer",
            "text": "Yay, my brother! I found you!",
            "nextDialogs": [
              "110100305"
            ]
          },
          "110100305": {
            "id": "110100305",
            "speakerId": 1004,
            "speakerName": "Childe",
            "text": "I know that voice... Why, if it isn't my little brother, Teucer! My goodness!",
            "nextDialogs": [
              "110100306"
            ]
          },
          "110100306": {
            "id": "110100306",
            "speakerId": 1004,
            "speakerName": "Childe",
            "text": "Haha... What a nice surprise, Teucer! I thought I would have to wait till I return home before seeing you again...",
            "nextDialogs": [
              "110100307"
            ]
          },
          "110100307": {
            "id": "110100307",
            "speakerId": 1004,
            "speakerName": "Childe",
            "text": "How are the others — sister Tonia and brother Anthon? Is everybody keeping well?",
            "nextDialogs": [
              "110100308"
            ]
          },
          "110100308": {
            "id": "110100308",
            "speakerId": 1005,
            "speakerName": "Teucer",
            "text": "They miss you a lot! Tonia prays for you every day at dinner...",
            "nextDialogs": [
              "110100309"
            ]
          },
          "110100309": {
            "id": "110100309",
            "speakerId": 1004,
            "speakerName": "Childe",
            "text": "...Wait a second, what are you doing here in Liyue, Teucer? How have I not heard anything about this?",
            "nextDialogs": [
              "110100310"
            ]
          },
          "110100310": {
            "id": "110100310",
            "speakerId": 1005,
            "speakerName": "Teucer",
            "text": "Well... what happened was... I saw a boat that looked like it was selling toys, so obviously I thought you were on board...",
            "nextDialogs": [
              "110100311"
            ]
          },
          "110100311": {
            "id": "110100311",
            "speakerId": 1005,
            "speakerName": "Teucer",
            "text": "And then when I got off I just kept walking and walking... and then, I found a Mr. Cyclops!",
            "nextDialogs": [
              "110100312"
            ]
          },
          "110100312": {
            "id": "110100312",
            "speakerId": 1005,
            "speakerName": "Teucer",
            "text": "#Mr. Cyclops scared off a bad guy, and then I found this nice {M#guy}{F#lady} to help me come look for you...",
            "nextDialogs": [
              "110100314"
            ]
          },
          "110100314": {
            "id": "110100314",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And also... Teucer is Childe's brother!?",
            "nextDialogs": [
              "110100316"
            ]
          },
          "110100316": {
            "id": "110100316",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Cool! Suddenly, Paimon doesn't feel so bad about taking Teucer's money!",
            "nextDialogs": [
              "110100317"
            ]
          },
          "110100317": {
            "id": "110100317",
            "speakerId": 1004,
            "speakerName": "Childe",
            "text": "Teucer, what you did was extremely dangerous... I'm so happy to see you, really I am, but please... Promise me you won't do anything like this ever again...",
            "nextDialogs": [
              "110100318"
            ]
          },
          "110100318": {
            "id": "110100318",
            "speakerId": 1005,
            "speakerName": "Teucer",
            "text": "Okay, I promise... Please don't be mad at me...",
            "nextDialogs": [
              "110100319"
            ]
          },
          "110100319": {
            "id": "110100319",
            "speakerId": 1004,
            "speakerName": "Childe",
            "text": "I'm not mad at you. I just care about your safety, that's all.",
            "nextDialogs": [
              "110100320"
            ]
          },
          "110100320": {
            "id": "110100320",
            "speakerId": 1004,
            "speakerName": "Childe",
            "text": "If you hadn't met these nice people, things could have been a lot more dangerous for you, Teucer. I hope you said a big thank-you to them?",
            "nextDialogs": [
              "110100321"
            ]
          },
          "110100321": {
            "id": "110100321",
            "speakerId": 1005,
            "speakerName": "Teucer",
            "text": "Yep! I always remember my pleases and thank-yous.",
            "nextDialogs": [
              "110100322"
            ]
          },
          "110100322": {
            "id": "110100322",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, so you did notice we were here, you were just ignoring us. Gotcha.",
            "nextDialogs": [
              "110100323"
            ]
          },
          "110100323": {
            "id": "110100323",
            "speakerId": 1004,
            "speakerName": "Childe",
            "text": "Hahaha, forgive me, it's always family first where I'm from. Don't take it personally.",
            "nextDialogs": [
              "110100324"
            ]
          },
          "110100324": {
            "id": "110100324",
            "speakerId": 1004,
            "speakerName": "Childe",
            "text": "I know we've had our differences up to now, but... a few minor quibbles aside, we get on quite well, don't you think?"
          }
        }
      }
    },
    {
      "subId": "1101009",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110100501"
        ],
        "dialogs": {
          "110100501": {
            "id": "110100501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, that's one down.",
            "nextDialogs": [
              "110100502"
            ]
          },
          "110100502": {
            "id": "110100502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's keep looking around. Maybe we'll find some more."
          }
        }
      }
    },

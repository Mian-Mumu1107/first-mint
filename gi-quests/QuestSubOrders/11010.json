  "subQuests": [
    {
      "subId": "1101001",
      "subQuestName": "Ask the Millelith about the situation",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110100101"
        ],
        "dialogs": {
          "110100101": {
            "id": "110100101",
            "speakerId": 1000,
            "speakerName": "Daipai",
            "text": "Be on your guard, Traveler. Now is no time for sightseeing.",
            "nextDialogs": [
              "110100102"
            ]
          },
          "110100102": {
            "id": "110100102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, why's that? Has something happened?",
            "nextDialogs": [
              "110100103"
            ]
          },
          "110100103": {
            "id": "110100103",
            "speakerId": 1000,
            "speakerName": "Daipai",
            "text": "Yes. As unusual as this may sound, numerous eyewitness reports have confirmed an active Ruin Guard presence in this area, even though this is far beyond their normal area of activity.",
            "nextDialogs": [
              "110100104"
            ]
          },
          "110100104": {
            "id": "110100104",
            "speakerId": 1000,
            "speakerName": "Daipai",
            "text": "Sergeant sent someone to find out just where these ancient machines might have come from. It appears that they simply left their ruin and marched off all of a sudden, for no clear reason.",
            "nextDialogs": [
              "110100105"
            ]
          },
          "110100105": {
            "id": "110100105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So did somebody wake them up?",
            "nextDialogs": [
              "110100106"
            ]
          },
          "110100106": {
            "id": "110100106",
            "speakerId": 1000,
            "speakerName": "Daipai",
            "text": "As I say, the reason is still unclear. We have very little intelligence at present.",
            "nextDialogs": [
              "110100107"
            ]
          },
          "110100107": {
            "id": "110100107",
            "speakerId": 1000,
            "speakerName": "Daipai",
            "text": "Moreover... The ruin in question is of the especially spooky variety. Strange noises are often heard coming from within...",
            "nextDialogs": [
              "110100108"
            ]
          },
          "110100108": {
            "id": "110100108",
            "speakerId": 1000,
            "speakerName": "Daipai",
            "text": "As such, we are not permitted to investigate until the order comes through from headquarters.",
            "nextDialogs": [
              "110100113",
              "110100111"
            ]
          },
          "110100113": {
            "id": "110100113",
            "speakerId": 1000,
            "speakerName": "Daipai",
            "text": "In any case, the only sensible strategy in the meantime is to increase Millelith patrols. We must not let innocent civilians come to harm.",
            "nextDialogs": [
              "110100114"
            ]
          },
          "110100114": {
            "id": "110100114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's a good point... Ruin Guards are probably pretty dangerous for regular folk...",
            "nextDialogs": [
              "110100115"
            ]
          },
          "110100115": {
            "id": "110100115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is there any way I can help?",
            "nextDialogs": [
              "110100116"
            ]
          },
          "110100116": {
            "id": "110100116",
            "speakerId": 1000,
            "speakerName": "Daipai",
            "text": "Wow, uh... I'm very grateful indeed for the offer, but... it just wouldn't be worth the risk.",
            "nextDialogs": [
              "110100117"
            ]
          },
          "110100117": {
            "id": "110100117",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Oh, don't worry about that! {NICKNAME} here, {M#he}{F#she} beats up Ruin Guards for breakfast!"
          },
          "110100111": {
            "id": "110100111",
            "speakerId": 1000,
            "speakerName": "Daipai",
            "text": "Sorry? Did you say something?",
            "nextDialogs": [
              "110100112"
            ]
          },
          "110100112": {
            "id": "110100112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...Was that supposed to be your impression of Master Diluc talking about the Knights of Favonius?"
          }
        }
      }
    },
    {
      "subId": "1101002",
      "subQuestName": "Investigate the Ruin Guard's whereabouts",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110100201"
        ],
        "dialogs": {
          "110100201": {
            "id": "110100201",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Hey, you! Check this out, isn't it awesome!",
            "nextDialogs": [
              "110100202"
            ]
          },
          "110100202": {
            "id": "110100202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...What is he wearing?",
            "nextDialogs": [
              "110100203"
            ]
          },
          "110100203": {
            "id": "110100203",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "I've never seen one this close before! Have you ever seen one?",
            "nextDialogs": [
              "110100205",
              "110100207"
            ]
          },
          "110100205": {
            "id": "110100205",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Um, excuse me? His name is Mr. Cyclops, actually! What sorta dumb name is \"Ruin Guard\"?",
            "nextDialogs": [
              "110100208"
            ]
          },
          "110100208": {
            "id": "110100208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"Mr. Cyclops\"? Aw, that's cute... Wait, what? Do people seriously call them that?",
            "nextDialogs": [
              "110100209"
            ]
          },
          "110100209": {
            "id": "110100209",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Yep! My brother said so. And he's the best toy seller in the whole world! It's his job to sell this kinda stuff!",
            "nextDialogs": [
              "110100210"
            ]
          },
          "110100210": {
            "id": "110100210",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "Right now he's at the Institute for Toy Research in Liyue. That's where Mr. Cyclopses come from.",
            "nextDialogs": [
              "110100211"
            ]
          },
          "110100211": {
            "id": "110100211",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "It's always nice to meet someone else who likes toys. So tell me, where'd you get your toy from? Must be a pretty new kind, I've never seen one that can fly and talk before!"
          },
          "110100207": {
            "id": "110100207",
            "speakerId": 1002,
            "speakerName": "???",
            "text": "You bet! Mr. Cyclopses are crazy strong! No bad guys can escape from these guys, that's for sure."
          }
        }
      }
    },

    {
      "subId": "7524204",
      "subQuestName": "Go to the resort's check-in desk",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752420401"
        ],
        "dialogs": {
          "752420401": {
            "id": "752420401",
            "speakerId": 6550,
            "speakerName": "Ukucha",
            "text": "Hello, and welcome to the Easybreeze Holiday Resort! I'll get you all checked into your accommodations.",
            "nextDialogs": [
              "752420402"
            ]
          },
          "752420402": {
            "id": "752420402",
            "speakerId": 6550,
            "speakerName": "Ukucha",
            "text": "Please take this map, along with a special commemorative photo album we've prepared for our guests.",
            "nextDialogs": [
              "752420403"
            ]
          },
          "752420403": {
            "id": "752420403",
            "speakerId": 6550,
            "speakerName": "Ukucha",
            "text": "The resort is made up of four main areas: Colorfall Cliffs, Guiztli Ridge, Wavey Bay, and Tete Isle. Feel free to explore them at your leisure!",
            "nextDialogs": [
              "752420404"
            ]
          },
          "752420404": {
            "id": "752420404",
            "speakerId": 6550,
            "speakerName": "Ukucha",
            "text": "Well, your accommodations are in that direction. Feel free to head there if you need some rest. And, if you're looking to do some shopping, the Easybreeze Market — our busiest attraction — is right over here."
          }
        }
      }
    },

    {
      "subId": "35723",
      "subQuestName": "Talk to Amber",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3572301"
        ],
        "dialogs": {
          "3572301": {
            "id": "3572301",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Stormterror... is attacking Mondstadt itself!",
            "nextDialogs": [
              "3572302"
            ]
          },
          "3572302": {
            "id": "3572302",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "#Kaeya, {NICKNAME}, you've come at the right time. We must...",
            "nextDialogs": [
              "3572303"
            ]
          },
          "3572303": {
            "id": "3572303",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Hold on, Amber. Are you perhaps forgetting to introduce us?",
            "nextDialogs": [
              "3572304"
            ]
          },
          "3572304": {
            "id": "3572304",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Oh... right. This is Kaeya, our Cavalry Captain.",
            "nextDialogs": [
              "3572305"
            ]
          },
          "3572305": {
            "id": "3572305",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "#These two are travelers from afar, {NICKNAME} and Paimon.",
            "nextDialogs": [
              "3572306"
            ]
          },
          "3572306": {
            "id": "3572306",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "(From afar? Is that all we know of them?)",
            "nextDialogs": [
              "3572307"
            ]
          },
          "3572307": {
            "id": "3572307",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Long story short...",
            "nextDialogs": [
              "3572308"
            ]
          },
          "3572308": {
            "id": "3572308",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "I see. Welcome to Mondstadt — though you haven't arrived at the best of times, I'm afraid.",
            "nextDialogs": [
              "3572309"
            ]
          },
          "3572309": {
            "id": "3572309",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "I understand the anguish of being separated from family.",
            "nextDialogs": [
              "3572310"
            ]
          },
          "3572310": {
            "id": "3572310",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "I'm not really sure why you're looking for the Anemo God...",
            "nextDialogs": [
              "3572311"
            ]
          },
          "3572311": {
            "id": "3572311",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "But everyone has their secrets, right?",
            "nextDialogs": [
              "3572312"
            ]
          },
          "3572312": {
            "id": "3572312",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Haha, relax! I won't press you for more.",
            "nextDialogs": [
              "3572313"
            ]
          },
          "3572313": {
            "id": "3572313",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "First and foremost, on behalf of the Knights of Favonius, I would like to extend our thanks to you for your help just now.",
            "nextDialogs": [
              "3572318",
              "3572316"
            ]
          },
          "3572318": {
            "id": "3572318",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Your fight to defend the city against the dragon just now was witnessed by no small number of citizens.",
            "nextDialogs": [
              "3572319"
            ]
          },
          "3572319": {
            "id": "3572319",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "The Acting Grand Master of the Knights of Favonius is also very interested in meeting you, and formally invites you both to <color=#00E1FFFF>our headquarters</color>."
          },
          "3572316": {
            "id": "3572316",
            "speakerId": 1001,
            "speakerName": "Kaeya",
            "text": "Ahh... How about a traditional Mondstadt delicacy, Sticky Honey Roast?",
            "nextDialogs": [
              "3572317"
            ]
          },
          "3572317": {
            "id": "3572317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I just heard about that one!"
          }
        }
      }
    },

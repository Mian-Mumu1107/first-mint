  "subQuests": [
    {
      "subId": "2204101",
      "subQuestName": "Talk to Neko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220410101"
        ],
        "dialogs": {
          "220410101": {
            "id": "220410101",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "You time your arrival well. I was just fretting about something.",
            "nextDialogs": [
              "220410102"
            ]
          },
          "220410102": {
            "id": "220410102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "220410103"
            ]
          },
          "220410103": {
            "id": "220410103",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Do you recall that child, Konbumaru?",
            "nextDialogs": [
              "220410104"
            ]
          },
          "220410104": {
            "id": "220410104",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "That little rascal went off to play nearby and has not returned. I am most worried.",
            "nextDialogs": [
              "220410105"
            ]
          },
          "220410105": {
            "id": "220410105",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Please, help to search for Konbumaru and bring him back.",
            "nextDialogs": [
              "220410107",
              "220410109"
            ]
          },
          "220410107": {
            "id": "220410107",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Wonderful. Remember, you need to find Konbumaru and bring him back."
          },
          "220410109": {
            "id": "220410109",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Indeed... Perhaps it was my previous scolding that displeased it so.",
            "nextDialogs": [
              "220410110"
            ]
          },
          "220410110": {
            "id": "220410110",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Ah, why will this child not listen to instruction...",
            "nextDialogs": [
              "220410111"
            ]
          },
          "220410111": {
            "id": "220410111",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Either way, please find Konbumaru and bring him back here."
          }
        }
      }
    },
    {
      "subId": "2204102",
      "subQuestName": "Look for \"Konbumaru\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220410201"
        ],
        "dialogs": {
          "220410201": {
            "id": "220410201",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "I am counting on you to bring Konbumaru back to this shrine."
          }
        }
      }
    },
    {
      "subId": "2204103",
      "subQuestName": "Talk to Neko",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220410301"
        ],
        "dialogs": {
          "220410301": {
            "id": "220410301",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "How does your task go? Have you found Konbumaru?",
            "nextDialogs": [
              "220410302"
            ]
          },
          "220410302": {
            "id": "220410302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure did.",
            "nextDialogs": [
              "220410303"
            ]
          },
          "220410303": {
            "id": "220410303",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...Wait, what? It's run off again!",
            "nextDialogs": [
              "220410306"
            ]
          },
          "220410306": {
            "id": "220410306",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "No, there's no need to give chase.",
            "nextDialogs": [
              "220410307"
            ]
          },
          "220410307": {
            "id": "220410307",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "It is me that that child is still angry at... I will teach them a lesson personally later.",
            "nextDialogs": [
              "220410308"
            ]
          },
          "220410308": {
            "id": "220410308",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Ah, it is almost old enough to be an adult cat. Why is it still so stubborn? What would we do if it frightened the humans coming to the shrine?",
            "nextDialogs": [
              "220410309"
            ]
          },
          "220410309": {
            "id": "220410309",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "Right. This is for you as thanks for your help.",
            "nextDialogs": [
              "220410310"
            ]
          },
          "220410310": {
            "id": "220410310",
            "speakerId": 1000,
            "speakerName": "Neko",
            "text": "*sigh* Why can't this child be as teachable as Meshi..."
          }
        }
      }
    }
  ]
}
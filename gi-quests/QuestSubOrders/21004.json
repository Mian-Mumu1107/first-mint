  "subQuests": [
    {
      "subId": "2100401",
      "subQuestName": "Talk to Soraya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210040101"
        ],
        "dialogs": {
          "210040101": {
            "id": "210040101",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "Guizhong's Four Commandments... What are they really trying to tell us...",
            "nextDialogs": [
              "210040103",
              "210040105"
            ]
          },
          "210040103": {
            "id": "210040103",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "Haha, raring to go! That's what I like to see. Then let's begin our reading of Guizhong's Four Commandments.",
            "nextDialogs": [
              "210040106"
            ]
          },
          "210040106": {
            "id": "210040106",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "\"Teach with wisdom, be bound by virtue, fortify the bones, unite in ambition — the convergence of these four shall be known as the 'Guili Assembly.'\"",
            "nextDialogs": [
              "210040107"
            ]
          },
          "210040107": {
            "id": "210040107",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "On the surface, it does read like a set of commandments. Golden rules for life.",
            "nextDialogs": [
              "210040108"
            ]
          },
          "210040108": {
            "id": "210040108",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "But it's also supposed to contain some sort of clues to a hidden treasure...",
            "nextDialogs": [
              "210040109"
            ]
          },
          "210040109": {
            "id": "210040109",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "...I can't decipher it, though. It seems we'll have to approach this in what academics like to call the old-fashioned way...",
            "nextDialogs": [
              "210040110"
            ]
          },
          "210040110": {
            "id": "210040110",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "Those seven passages we found previously, they were all located in ruins of some sort.",
            "nextDialogs": [
              "210040111"
            ]
          },
          "210040111": {
            "id": "210040111",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "Since we're not sure where to start this time, perhaps keep searching in ruins for now."
          },
          "210040105": {
            "id": "210040105",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "Whew, the slightest mention of treasure and you're suddenly beside yourself with excitement... Hmm, so be it — let's begin our reading of Guizhong's Four Commandments."
          }
        }
      }
    },
    {
      "subId": "2100402",
      "subQuestName": "Ask Soraya about the saying of the nearby area",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210040201"
        ],
        "dialogs": {
          "210040201": {
            "id": "210040201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm definitely intrigued.",
            "nextDialogs": [
              "210040202"
            ]
          },
          "210040202": {
            "id": "210040202",
            "speakerId": 1612,
            "speakerName": "Soraya",
            "text": "I'll mark the first ruins I found on your map. I'd suggest starting there.",
            "nextDialogs": [
              "210040203"
            ]
          },
          "210040203": {
            "id": "210040203",
            "speakerId": 1612,
            "speakerName": "Soraya",
            "text": "If you do find something, don't make the amateur mistake of running off in your excitement. Be sure to <color=#00E1FFFF>note down the clue</color> first."
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "4002501",
      "subQuestName": "Go to Mondstadt's alchemy store",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250101"
        ],
        "dialogs": {
          "400250101": {
            "id": "400250101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, Timae— Huh, is that Albedo? Why is he leaving?",
            "nextDialogs": [
              "400250104"
            ]
          },
          "400250104": {
            "id": "400250104",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Hey, it's the Traveler and Paimon!",
            "nextDialogs": [
              "400250105"
            ]
          },
          "400250105": {
            "id": "400250105",
            "speakerId": 1019,
            "speakerName": "Sucrose",
            "text": "Hello, you two! It's been a long time!",
            "nextDialogs": [
              "400250106"
            ]
          },
          "400250106": {
            "id": "400250106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Were you having a really serious discussion right now, or something?",
            "nextDialogs": [
              "400250107"
            ]
          },
          "400250107": {
            "id": "400250107",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Just a regular catch-up. We meet here once in a while to go through any recent developments in our research projects.",
            "nextDialogs": [
              "400250108"
            ]
          },
          "400250108": {
            "id": "400250108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, so we just missed him. Maybe we should have hollered to him...",
            "nextDialogs": [
              "400250109"
            ]
          },
          "400250109": {
            "id": "400250109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He didn't look in the best of moods just now, though. Was he upset about something? If so, he probably wouldn't have been in the mood to help out, anyway.",
            "nextDialogs": [
              "400250110"
            ]
          },
          "400250110": {
            "id": "400250110",
            "speakerId": 1019,
            "speakerName": "Sucrose",
            "text": "Huh... upset? You mean, Albedo?",
            "nextDialogs": [
              "400250111"
            ]
          },
          "400250111": {
            "id": "400250111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah! He wasn't looking his usual self.",
            "nextDialogs": [
              "400250112"
            ]
          },
          "400250112": {
            "id": "400250112",
            "speakerId": 1019,
            "speakerName": "Sucrose",
            "text": "Upset... uh-oh, I wonder if...",
            "nextDialogs": [
              "400250113"
            ]
          },
          "400250113": {
            "id": "400250113",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Wh—What are you looking at me for?",
            "nextDialogs": [
              "400250114"
            ]
          },
          "400250114": {
            "id": "400250114",
            "speakerId": 1019,
            "speakerName": "Sucrose",
            "text": "I wonder if Timaeus's research topic is... so boring this time that Albedo finally snapped?",
            "nextDialogs": [
              "400250115"
            ]
          },
          "400250115": {
            "id": "400250115",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "S—Surely not... It's not that boring! ...Is it?",
            "nextDialogs": [
              "400250116"
            ]
          },
          "400250116": {
            "id": "400250116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, nah! Anyway, Paimon wanted to ask you for a favor, Timaeus!",
            "nextDialogs": [
              "400250117"
            ]
          },
          "400250117": {
            "id": "400250117",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "A favor? Haha, well sure! How can I help?",
            "nextDialogs": [
              "400250118"
            ]
          },
          "400250118": {
            "id": "400250118",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, Paimon found a bunch of super-duper sweet Sunsettias in the mountains the other day. But if Paimon eats them all, then they'll be gone, so Paimon isn't ready to finish them all yet...",
            "nextDialogs": [
              "400250119"
            ]
          },
          "400250119": {
            "id": "400250119",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon was thinking maybe you could make a device that you put fruits in, and it turns them into juice! That way, they'll be preserved for as long as Paimon needs!"
          }
        }
      }
    },
    {
      "subId": "4002502",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],

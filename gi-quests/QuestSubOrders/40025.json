    {
      "subId": "4002507",
      "subQuestName": "Follow the source of the voice",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250401"
        ],
        "dialogs": {
          "400250401": {
            "id": "400250401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The sound has completely stopped...",
            "nextDialogs": [
              "400250402"
            ]
          },
          "400250402": {
            "id": "400250402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It looks like we lost it.",
            "nextDialogs": [
              "400250403"
            ]
          },
          "400250403": {
            "id": "400250403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How could that happen? After all the adventures we've been on, our tracking skills are honed to perfection, aren't they?",
            "nextDialogs": [
              "400250404"
            ]
          },
          "400250404": {
            "id": "400250404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Guess we underestimated whatever was behind it, but if that's the case... then what exactly are we dealing with here?",
            "nextDialogs": [
              "400250405"
            ]
          },
          "400250405": {
            "id": "400250405",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "I know that voice...",
            "nextDialogs": [
              "400250406"
            ]
          },
          "400250406": {
            "id": "400250406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm? Huh?",
            "nextDialogs": [
              "400250407"
            ]
          },
          "400250407": {
            "id": "400250407",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "What brings you to Dragonspine?",
            "nextDialogs": [
              "400250408"
            ]
          },
          "400250408": {
            "id": "400250408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So it was just you.",
            "nextDialogs": [
              "400250409"
            ]
          },
          "400250409": {
            "id": "400250409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ohh! So it was Albedo all along!",
            "nextDialogs": [
              "400250410"
            ]
          },
          "400250410": {
            "id": "400250410",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "\"All along\"...? What do you mean by that?",
            "nextDialogs": [
              "400250411"
            ]
          },
          "400250411": {
            "id": "400250411",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "On the way here, we kept hearing weird noises and it felt like someone was watching us the whole time... Turns out it was just you.",
            "nextDialogs": [
              "400250412"
            ]
          },
          "400250412": {
            "id": "400250412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Honestly, you really gave us the creeps! If you're bored up here, go find something useful to do — don't go sneaking around and scaring the poop out of people!",
            "nextDialogs": [
              "400250413"
            ]
          },
          "400250413": {
            "id": "400250413",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "The things you felt and heard could easily be attributed to animals, or bandits perhaps. You should be wary at all times in this environment — there are all too many ways to sustain losses here if you aren't careful.",
            "nextDialogs": [
              "400250414"
            ]
          },
          "400250414": {
            "id": "400250414",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "So. What business brought you here?",
            "nextDialogs": [
              "400250415"
            ]
          },
          "400250415": {
            "id": "400250415",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's a long story...",
            "nextDialogs": [
              "400250416"
            ]
          },
          "400250416": {
            "id": "400250416",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We actually came to look for you, but then it turned into looking for Amber, but now we've met you, so we're back to that again...",
            "nextDialogs": [
              "400250417"
            ]
          },
          "400250417": {
            "id": "400250417",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Hmm. Your thought process is rather chaotic, as is the way in which you articulate it.",
            "nextDialogs": [
              "400250418"
            ]
          },
          "400250418": {
            "id": "400250418",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! How dare you! All Paimon's trying to say is that we came here to look for you!",
            "nextDialogs": [
              "400250419"
            ]
          },
          "400250419": {
            "id": "400250419",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Oh? Is that so?",
            "nextDialogs": [
              "400250420"
            ]
          },
          "400250420": {
            "id": "400250420",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Then it must surely be something of great importance. I'm all ears.",
            "nextDialogs": [
              "400250421"
            ]
          },
          "400250421": {
            "id": "400250421",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Actually... it's nothing serious...",
            "nextDialogs": [
              "400250422"
            ]
          },
          "400250422": {
            "id": "400250422",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "He seems to be in a better mood than we thought, right? Does that mean Timaeus' stupidity doesn't really get to him after all?",
            "nextDialogs": [
              "400250423"
            ]
          },
          "400250423": {
            "id": "400250423",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We were probably overthinking it.",
            "nextDialogs": [
              "400250424"
            ]
          },
          "400250424": {
            "id": "400250424",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh... Okay, let's... let's just forget that ever came up!",
            "nextDialogs": [
              "400250425"
            ]
          },
          "400250425": {
            "id": "400250425",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "It's okay if you can't tell me about it. Just treat this as an opportunity to stroll on the mountain and enjoy the view.",
            "nextDialogs": [
              "400250426"
            ]
          },
          "400250426": {
            "id": "400250426",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehehe. So basically, the truth is we're here on adventurer duty.",
            "nextDialogs": [
              "400250427"
            ]
          },
          "400250427": {
            "id": "400250427",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You tell Albedo about the event that the Adventurers' Guild is holding...",
            "nextDialogs": [
              "400250428"
            ]
          },
          "400250428": {
            "id": "400250428",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "I see. So, you foisted the rookie off onto Eula, so that you could wander off and goof around?",
            "nextDialogs": [
              "400250429"
            ]
          },
          "400250429": {
            "id": "400250429",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're not goofing around! And Eula was the right person for the job — we were just being nice.",
            "nextDialogs": [
              "400250430"
            ]
          },
          "400250430": {
            "id": "400250430",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What about you, then, huh? What're you doing on Dragonspine?",
            "nextDialogs": [
              "400250431"
            ]
          },
          "400250431": {
            "id": "400250431",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "A friend commissioned me to do some artwork recently, and I have yet to finish. I came here because it's a quiet place where I can gather my thoughts, gather inspiration — and gather some raw materials while I'm at it.",
            "nextDialogs": [
              "400250432"
            ]
          },
          "400250432": {
            "id": "400250432",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Raw materials for what?",
            "nextDialogs": [
              "400250433"
            ]
          },
          "400250433": {
            "id": "400250433",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Paint.",
            "nextDialogs": [
              "400250434"
            ]
          },
          "400250434": {
            "id": "400250434",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Starsilver can be used to make high-quality silver paint. I just ran out of my previous batch, so I'll collect some ore while I'm here.",
            "nextDialogs": [
              "400250435"
            ]
          },
          "400250435": {
            "id": "400250435",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ore can be used to make paint?",
            "nextDialogs": [
              "400250436"
            ]
          },
          "400250436": {
            "id": "400250436",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Yes. But you have to be selective with the specimens you choose.",
            "nextDialogs": [
              "400250437"
            ]
          },
          "400250437": {
            "id": "400250437",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Even with a high level of impurities, Starsilver still contains fine silver-colored particles. But they lack luster, which impacts the color saturation of the pigment made from them. Paint made with such pigment is generally viewed as a fake or a defective product.",
            "nextDialogs": [
              "400250438"
            ]
          },
          "400250438": {
            "id": "400250438",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Interesting! So paint aside, can you talk about how you find inspiration? Paimon wants to learn!",
            "nextDialogs": [
              "400250439"
            ]
          },
          "400250439": {
            "id": "400250439",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "You want to learn to paint?",
            "nextDialogs": [
              "400250440"
            ]
          },
          "400250440": {
            "id": "400250440",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#No, no, not for me, for the Traveler. Paimon wants {NICKNAME} to learn how to paint!",
            "nextDialogs": [
              "400250441"
            ]
          },
          "400250441": {
            "id": "400250441",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "During our travels, we sometimes have nights where there's nothing to do. It'd sure be nice to do something memorable rather than just sit around...",
            "nextDialogs": [
              "400250442"
            ]
          },
          "400250442": {
            "id": "400250442",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Painting is a great example, because it can capture a moment in time. So it seems like it's definitely a worthwhile skill to have.",
            "nextDialogs": [
              "400250443"
            ]
          },
          "400250443": {
            "id": "400250443",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So... you want me to learn to paint now?",
            "nextDialogs": [
              "400250444"
            ]
          },
          "400250444": {
            "id": "400250444",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yep! Why not? Once you've mastered it, you can paint Paimon!",
            "nextDialogs": [
              "400250445"
            ]
          },
          "400250445": {
            "id": "400250445",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Not a bad idea. Well, since you two would like to learn more about painting, why don't you come with me to the campsite? I have painting materials there. You can practice while I give you some guidance.",
            "nextDialogs": [
              "400250446"
            ]
          },
          "400250446": {
            "id": "400250446",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sounds great!",
            "nextDialogs": [
              "400250447"
            ]
          },
          "400250447": {
            "id": "400250447",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What about Amber...?",
            "nextDialogs": [
              "400250448"
            ]
          },
          "400250448": {
            "id": "400250448",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, she'll be fiiiine! She is a knight of Favonius after all. Let's just forget about all that stuff for now and go with Albedo.",
            "nextDialogs": [
              "400250449"
            ]
          },
          "400250449": {
            "id": "400250449",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright, fine...",
            "nextDialogs": [
              "400250450"
            ]
          },
          "400250450": {
            "id": "400250450",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "C'mon, let's go! It's so cold out — Paimon wants to get to the camp and warm up by the fire!"
          }
        }
      }
    },
    {
      "subId": "4002508",
      "subQuestName": "Head for Albedo's campsite",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250601"
        ],
        "dialogs": {
          "400250601": {
            "id": "400250601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aaaah!",
            "nextDialogs": [
              "400250602"
            ]
          },
          "400250602": {
            "id": "400250602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's going on...?",
            "nextDialogs": [
              "400250603"
            ]
          },
          "400250603": {
            "id": "400250603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Thieves! It's gotta be!",
            "nextDialogs": [
              "400250604"
            ]
          },
          "400250604": {
            "id": "400250604",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "...",
            "nextDialogs": [
              "400250605"
            ]
          },
          "400250605": {
            "id": "400250605",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Some things are missing.",
            "nextDialogs": [
              "400250606"
            ]
          },
          "400250606": {
            "id": "400250606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Nothing valuable, hopefully? Wait, where's Paimon's Mora?",
            "nextDialogs": [
              "400250607"
            ]
          },
          "400250607": {
            "id": "400250607",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "It's hard to say their value, but...",
            "nextDialogs": [
              "400250608"
            ]
          },
          "400250608": {
            "id": "400250608",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Some of my alchemy notes are missing.",
            "nextDialogs": [
              "400250609"
            ]
          },
          "400250609": {
            "id": "400250609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "400250610"
            ]
          },
          "400250610": {
            "id": "400250610",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alchemy notes? Would they fetch a high price?",
            "nextDialogs": [
              "400250611"
            ]
          },
          "400250611": {
            "id": "400250611",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "To the uninitiated, they are merely scraps of paper. But for someone who knows what they're doing... the knowledge contained in those notes is more valuable than any treasure.",
            "nextDialogs": [
              "400250612"
            ]
          },
          "400250612": {
            "id": "400250612",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So you're saying only someone who knows alchemy would've stolen them? But the only people who come to Dragonspine are adventurers, thieves, and monsters... What use would any of them have with your notes?",
            "nextDialogs": [
              "400250613"
            ]
          },
          "400250613": {
            "id": "400250613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't think it's that simple.",
            "nextDialogs": [
              "400250614"
            ]
          },
          "400250614": {
            "id": "400250614",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "I feel the same way. However, hilichurl break-ins and other such incidents are not unheard-of on Dragonspine. It's difficult to draw a conclusion based solely on the evidence at hand.",
            "nextDialogs": [
              "400250615"
            ]
          },
          "400250615": {
            "id": "400250615",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "...",
            "nextDialogs": [
              "400250616"
            ]
          },
          "400250616": {
            "id": "400250616",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Hmm? These appear to be...",
            "nextDialogs": [
              "400250617"
            ]
          },
          "400250617": {
            "id": "400250617",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Footprints?",
            "nextDialogs": [
              "400250618"
            ]
          },
          "400250618": {
            "id": "400250618",
            "speakerId": 1018,
            "speakerName": "Albedo",
            "text": "Fresh ones. Meaning, our thief can't have made it far.",
            "nextDialogs": [
              "400250619"
            ]
          },
          "400250619": {
            "id": "400250619",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's chase them down. We can't let 'em get away!"
          }
        }
      }
    },
    {
      "subId": "4002507",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250701"
        ],
        "dialogs": {
          "400250701": {
            "id": "400250701",
            "speakerId": 1210,
            "speakerName": "Cyrus",
            "text": "It feels like every time I try to drum up some enthusiasm for my idea, nobody wants to know. But whenever the young lass starts talking, everyone rallies behind her! ...What am I doing wrong?",
            "nextDialogs": [
              "400250702"
            ]
          },
          "400250702": {
            "id": "400250702",
            "speakerId": 1577,
            "speakerName": "Reckless Pallad",
            "text": "Hey, don't talk that way, Cyrus! You're the branch master! You're awesome!",
            "nextDialogs": [
              "400250703"
            ]
          },
          "400250703": {
            "id": "400250703",
            "speakerId": 1210,
            "speakerName": "Cyrus",
            "text": "...",
            "nextDialogs": [
              "400250704"
            ]
          },
          "400250704": {
            "id": "400250704",
            "speakerId": 1210,
            "speakerName": "Cyrus",
            "text": "Have you done anything apart from resting all day? Come on, are your supplies ready? Have you done your warm-up exercises? If not, then get to it, lad!",
            "nextDialogs": [
              "400250705"
            ]
          },
          "400250705": {
            "id": "400250705",
            "speakerId": 1577,
            "speakerName": "Reckless Pallad",
            "text": "Oh, uh, yeah! Sure!"
          }
        }
      }
    },
    {
      "subId": "4002508",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250801"
        ],
        "dialogs": {
          "400250801": {
            "id": "400250801",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Seriously!? Albedo doesn't like my alchemy device? It can create tiny ice crystals! I thought I had a good design here — I was planning to take it further...",
            "nextDialogs": [
              "400250802"
            ]
          },
          "400250802": {
            "id": "400250802",
            "speakerId": 1019,
            "speakerName": "Sucrose",
            "text": "Timaeus... it's not completely useless, but... perhaps it needs to be a little more original...",
            "nextDialogs": [
              "400250803"
            ]
          },
          "400250803": {
            "id": "400250803",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "O—Okay... I see. I'll give it some more thought... Hmm, then again, what IS the use of this thing? I'm the one who came up with it, and even I can't think of a potential application..."
          }
        }
      }
    },
    {
      "subId": "4002599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400259901"
        ],
        "dialogs": {
          "400259901": {
            "id": "400259901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, let's go see Timaeus. Paimon has a favor to ask him!",
            "nextDialogs": [
              "400259902"
            ]
          },
          "400259902": {
            "id": "400259902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It'd be great if we could catch Sucrose and Albedo, too... but they seem really busy lately, so let's not get our hopes up.",
            "nextDialogs": [
              "400259903"
            ]
          },
          "400259903": {
            "id": "400259903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, let's go see!",
            "nextDialogs": [
              "400259904"
            ]
          },
          "400259904": {
            "id": "400259904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's coming from that direction!"
          }
        }
      }
    }
  ]
}
      }
    },
    {
      "subId": "4002503",
      "subQuestName": "Go to Dragonspine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250201"
        ],
        "dialogs": {
          "400250201": {
            "id": "400250201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm? This looks lively, what's the occasion? Let's go and have a look!",
            "nextDialogs": [
              "400250202"
            ]
          },
          "400250202": {
            "id": "400250202",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Hey, Traveler and Paimon! Fancy meeting you all the way out here.",
            "nextDialogs": [
              "400250203"
            ]
          },
          "400250203": {
            "id": "400250203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Amber, Cyrus, Pallad... What's everyone doing at Dragonspine? Don't you mind the cold?",
            "nextDialogs": [
              "400250204"
            ]
          },
          "400250204": {
            "id": "400250204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hi all. Long time no see.",
            "nextDialogs": [
              "400250205"
            ]
          },
          "400250205": {
            "id": "400250205",
            "speakerId": 1409,
            "speakerName": "Cyrus",
            "text": "Oh? The Traveler is joining us too. Great, fantastic, wonderful! Hahahaha, the more the merrier.",
            "nextDialogs": [
              "400250206"
            ]
          },
          "400250206": {
            "id": "400250206",
            "speakerId": 1577,
            "speakerName": "Reckless Pallad",
            "text": "I agree. I feel much better with the Traveler joining us. Definitely the kind of person you want to have around in a tight spot.",
            "nextDialogs": [
              "400250209"
            ]
          },
          "400250209": {
            "id": "400250209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, right! Paimon remembers most of these people are from the Adventurers' Guild... Then again, it seems a certain Outrider has joined too.",
            "nextDialogs": [
              "400250210"
            ]
          },
          "400250210": {
            "id": "400250210",
            "speakerId": 1409,
            "speakerName": "Cyrus",
            "text": "Hahaha... allow me to explain.",
            "nextDialogs": [
              "400250211"
            ]
          },
          "400250211": {
            "id": "400250211",
            "speakerId": 1409,
            "speakerName": "Cyrus",
            "text": "The Adventurers' Guild is holding winter training on Dragonspine.",
            "nextDialogs": [
              "400250212"
            ]
          },
          "400250212": {
            "id": "400250212",
            "speakerId": 1409,
            "speakerName": "Cyrus",
            "text": "As you know, our members have varying levels of adventure experience. Dragonspine is an excellent place for budding adventurers to challenge themselves and improve... but it's dangerous to go alone.",
            "nextDialogs": [
              "400250213"
            ]
          },
          "400250213": {
            "id": "400250213",
            "speakerId": 1409,
            "speakerName": "Cyrus",
            "text": "So, we made a plan for senior members to pair up with junior members. This way, everyone can experience training on Dragonspine together under safe and controlled circumstances.",
            "nextDialogs": [
              "400250214"
            ]
          },
          "400250214": {
            "id": "400250214",
            "speakerId": 1409,
            "speakerName": "Cyrus",
            "text": "Now, every adventurer can progress together. I have been working on this grand plan for half a year now, and it's finally coming together! Hahaha, it's a great plan, isn't it!?",
            "nextDialogs": [
              "400250215"
            ]
          },
          "400250215": {
            "id": "400250215",
            "speakerId": 1409,
            "speakerName": "Cyrus",
            "text": "#Hey, {NICKNAME}, you are an outstanding adventurer. Surely you must be willing to join us and help out?",
            "nextDialogs": [
              "400250216"
            ]
          },
          "400250216": {
            "id": "400250216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh... Amber, what are you doing here?",
            "nextDialogs": [
              "400250217"
            ]
          },
          "400250217": {
            "id": "400250217",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is the Adventurers' Guild short on experienced members?",
            "nextDialogs": [
              "400250218"
            ]
          },
          "400250218": {
            "id": "400250218",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Well, that's part of it, actually...",
            "nextDialogs": [
              "400250219"
            ]
          },
          "400250219": {
            "id": "400250219",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "The other reason is, when I was patrolling the perimeter of Dragonspine, I found a lost kid named Joel.",
            "nextDialogs": [
              "400250220"
            ]
          },
          "400250220": {
            "id": "400250220",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "I heard he lives here on the camp, so I escorted him back."
          }
        }
      }
    },
    {
      "subId": "4002504",
      "subQuestName": "Talk to the lonely Joel",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250301"
        ],
        "dialogs": {
          "400250301": {
            "id": "400250301",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Hey, Joel, we're here.",
            "nextDialogs": [
              "400250304"
            ]
          },
          "400250304": {
            "id": "400250304",
            "speakerId": 1668,
            "speakerName": "Joel",
            "text": "Hi, everyone. Haha, I'm so happy right now! It's nice to have so many people to hang out with.",
            "nextDialogs": [
              "400250305"
            ]
          },
          "400250305": {
            "id": "400250305",
            "speakerId": 1668,
            "speakerName": "Joel",
            "text": "Are you here to build a snowman, too?",
            "nextDialogs": [
              "400250306"
            ]
          },
          "400250306": {
            "id": "400250306",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Build... a snowman?",
            "nextDialogs": [
              "400250307"
            ]
          },
          "400250307": {
            "id": "400250307",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Oh, sorry. I forgot to do the introductions.",
            "nextDialogs": [
              "400250308"
            ]
          },
          "400250308": {
            "id": "400250308",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "This is Eula, the Spindrift Knight and Captain of the Knights of Favonius Reconnaissance Company...",
            "nextDialogs": [
              "400250309"
            ]
          },
          "400250309": {
            "id": "400250309",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Amber, you're being far too formal. The child is never going to remember all that.",
            "nextDialogs": [
              "400250310"
            ]
          },
          "400250310": {
            "id": "400250310",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Please, just call me Eula.",
            "nextDialogs": [
              "400250311"
            ]
          },
          "400250311": {
            "id": "400250311",
            "speakerId": 1668,
            "speakerName": "Joel",
            "text": "Okay, Aunty Eula! You can call me Joel.",
            "nextDialogs": [
              "400250312"
            ]
          },
          "400250312": {
            "id": "400250312",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Aunty... Eula...",
            "nextDialogs": [
              "400250313"
            ]
          },
          "400250313": {
            "id": "400250313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh oh, Eula's gonna add that to her long list of scores to settle...",
            "nextDialogs": [
              "400250314"
            ]
          },
          "400250314": {
            "id": "400250314",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "...Alright, if that's what you want to call me, go right ahead.",
            "nextDialogs": [
              "400250315"
            ]
          },
          "400250315": {
            "id": "400250315",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, Eula just let something go for once!",
            "nextDialogs": [
              "400250316"
            ]
          },
          "400250316": {
            "id": "400250316",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Amber, what's this I hear about a snowman? I came to assist because you told me the Adventurers' Guild was short-handed.",
            "nextDialogs": [
              "400250317"
            ]
          },
          "400250317": {
            "id": "400250317",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Yeah, that's something else. But look, Joel's at that age where he should be having fun, and there's nothing to play with on Dragonspine.",
            "nextDialogs": [
              "400250318"
            ]
          },
          "400250318": {
            "id": "400250318",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "He used to build snowmen with his dad, and since his dad's not around, we're keeping him company instead.",
            "nextDialogs": [
              "400250319"
            ]
          },
          "400250319": {
            "id": "400250319",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Besides, Eula, it's gotta be more fun than taking an ice bath all by yourself.",
            "nextDialogs": [
              "400250320"
            ]
          },
          "400250320": {
            "id": "400250320",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Let's combine our forces and build ourselves a huge snowman! It'll be a ton of fun.",
            "nextDialogs": [
              "400250321"
            ]
          },
          "400250321": {
            "id": "400250321",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I approve.",
            "nextDialogs": [
              "400250322"
            ]
          },
          "400250322": {
            "id": "400250322",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yup yup, count Paimon in, too! Paimon wants to build a snowman.",
            "nextDialogs": [
              "400250323"
            ]
          },
          "400250323": {
            "id": "400250323",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "...",
            "nextDialogs": [
              "400250324"
            ]
          },
          "400250324": {
            "id": "400250324",
            "speakerId": 1668,
            "speakerName": "Joel",
            "text": "Aunty Eula, are you too busy to join in?",
            "nextDialogs": [
              "400250325"
            ]
          },
          "400250325": {
            "id": "400250325",
            "speakerId": 1668,
            "speakerName": "Joel",
            "text": "If so, it's okay, I understand...",
            "nextDialogs": [
              "400250326"
            ]
          },
          "400250326": {
            "id": "400250326",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "No, nothing like that. My mind was on something else, that's all. Building a snowman with Joel, are we? Sounds wonderful. I'd be delighted to join you.",
            "nextDialogs": [
              "400250327"
            ]
          },
          "400250327": {
            "id": "400250327",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Eula?",
            "nextDialogs": [
              "400250328"
            ]
          },
          "400250328": {
            "id": "400250328",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Then let's get started! First, we need to split up into teams to gather some supplies!",
            "nextDialogs": [
              "400250329"
            ]
          },
          "400250329": {
            "id": "400250329",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "#Joel and I will be on one team. {NICKNAME}, you and Eula can be on the other team.",
            "nextDialogs": [
              "400250330"
            ]
          },
          "400250330": {
            "id": "400250330",
            "speakerId": 1002,
            "speakerName": "Amber",
            "text": "Hey Joel, see that huge tree over there? Wanna race me there?",
            "nextDialogs": [
              "400250331"
            ]
          },
          "400250331": {
            "id": "400250331",
            "speakerId": 1668,
            "speakerName": "Joel",
            "text": "Yeah! Let's do it!",
            "nextDialogs": [
              "400250332"
            ]
          },
          "400250332": {
            "id": "400250332",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, those two are fast.",
            "nextDialogs": [
              "400250333"
            ]
          },
          "400250333": {
            "id": "400250333",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's hard to tell which of them is having more fun.",
            "nextDialogs": [
              "400250334"
            ]
          },
          "400250334": {
            "id": "400250334",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, what's up with you two? Why are you just staring at each other without saying anything?"
          }
        }
      }
    },
    {
      "subId": "4002505",
      "subQuestName": "Go to Dragonspine and find Amber",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400250501"
        ],
        "dialogs": {
          "400250501": {
            "id": "400250501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Strange. Didn't they say they were going this way? Where the heck are they?",
            "nextDialogs": [
              "400250502"
            ]
          },
          "400250502": {
            "id": "400250502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did we get here too late? Have they moved on already?",
            "nextDialogs": [
              "400250505"
            ]
          },
          "400250505": {
            "id": "400250505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh... C—Could they be in danger!?",
            "nextDialogs": [
              "400250506"
            ]
          },
          "400250506": {
            "id": "400250506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hurry! Let's go check it out!"
          }
        }
      }
    },

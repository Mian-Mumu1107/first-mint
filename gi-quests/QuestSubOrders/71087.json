        "dialogs": {
          "710380601": {
            "id": "710380601",
            "speakerId": 20580,
            "speakerName": "Jinwu",
            "text": "Khedive's given her some medicine... and she's regained consciousness, but she won't tell me anything.",
            "nextDialogs": [
              "710380602"
            ]
          },
          "710380602": {
            "id": "710380602",
            "speakerId": 20580,
            "speakerName": "Jinwu",
            "text": "Do you know what happened? How did she end up like... that?",
            "nextDialogs": [
              "710380603"
            ]
          },
          "710380603": {
            "id": "710380603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She was trapped in the black mud when we found her.",
            "nextDialogs": [
              "710380604"
            ]
          },
          "710380604": {
            "id": "710380604",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's right, and we got her out just in time!",
            "nextDialogs": [
              "710380605"
            ]
          },
          "710380605": {
            "id": "710380605",
            "speakerId": 20580,
            "speakerName": "Jinwu",
            "text": "...",
            "nextDialogs": [
              "710380606"
            ]
          },
          "710380606": {
            "id": "710380606",
            "speakerId": 20580,
            "speakerName": "Jinwu",
            "text": "Never mind that for now. What Zhiqiong needs now is rest. Could you help me deliver this bowl of soup to her while it's still hot?",
            "nextDialogs": [
              "710380607"
            ]
          },
          "710380607": {
            "id": "710380607",
            "speakerId": 20580,
            "speakerName": "Jinwu",
            "text": "I'm not a very good cook, but I've had to take care of my fair share of miners, and no one's ever said my fare was bad.",
            "nextDialogs": [
              "710380608"
            ]
          },
          "710380608": {
            "id": "710380608",
            "speakerId": 20580,
            "speakerName": "Jinwu",
            "text": "Alright, go then. See if she's any better.",
            "nextDialogs": [
              "710380609"
            ]
          },
          "710380609": {
            "id": "710380609",
            "speakerId": 20580,
            "speakerName": "Jinwu",
            "text": "I have to tell Muning that Zhiqiong can't stay underground anymore."
          }
        }
      }
    }
  ]

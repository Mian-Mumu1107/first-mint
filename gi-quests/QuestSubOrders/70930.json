          },
          "709300102": {
            "id": "709300102",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "Why do I research ancient ruins? Out of curiosity, naturally! Surely you find the tantalizing traces of history inside irresistible too?",
            "nextDialogs": [
              "709300103"
            ]
          },
          "709300103": {
            "id": "709300103",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "Reading The Mondstadt Tower was what first got me interested in history.",
            "nextDialogs": [
              "709300104"
            ]
          },
          "709300104": {
            "id": "709300104",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "Everyone describes it as a historical romance, but... Personally, I didn't see what was so romantic about it when I read it.",
            "nextDialogs": [
              "709300105"
            ]
          },
          "709300105": {
            "id": "709300105",
            "speakerId": 1000,
            "speakerName": "Patchi the Curious",
            "text": "If you've never read it, you should take this copy. Seriously, it's a good read."

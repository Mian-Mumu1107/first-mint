      "dialogue": {
        "startDialogs": [
          "760830401"
        ],
        "dialogs": {
          "760830401": {
            "id": "760830401",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Go on now, little ones.",
            "nextDialogs": [
              "760830402"
            ]
          },
          "760830402": {
            "id": "760830402",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "See if you can guess what this picture is.",
            "nextDialogs": [
              "760830404",
              "760830408",
              "760830413"
            ]
          },
          "760830404": {
            "id": "760830404",
            "speakerId": 15703,
            "speakerName": "Kuuhenki",
            "text": "!!!",
            "nextDialogs": [
              "760830405"
            ]
          },
          "760830405": {
            "id": "760830405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph, that was way too obvious!",
            "nextDialogs": [
              "760830406"
            ]
          },
          "760830406": {
            "id": "760830406",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I'm afraid this riddle was a little too simple for us."
          },
          "760830408": {
            "id": "760830408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, what's wrong with this eel's waist?",
            "nextDialogs": [
              "760830409"
            ]
          },
          "760830409": {
            "id": "760830409",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "You two possess an impressive wealth of knowledge...",
            "nextDialogs": [
              "760830410"
            ]
          },
          "760830410": {
            "id": "760830410",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The correct answer is \"the moon.\"",
            "nextDialogs": [
              "760830411"
            ]
          },
          "760830411": {
            "id": "760830411",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Come back now. You did a wonderful job."
          },
          "760830413": {
            "id": "760830413",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyone with eyes can see it's an arc! How could the answer be something so simple!?",
            "nextDialogs": [
              "760830414"
            ]
          },
          "760830414": {
            "id": "760830414",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "While you aren't technically wrong, I'm afraid that's not exactly what the kuuhenki were going for.",
            "nextDialogs": [
              "760830415"
            ]
          },
          "760830415": {
            "id": "760830415",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The correct answer is \"the moon.\"",
            "nextDialogs": [
              "760830416"
            ]
          },
          "760830416": {
            "id": "760830416",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Come back now. You did a wonderful job."
          }
        }
      }

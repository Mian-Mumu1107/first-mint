        ],
        "dialogs": {
          "760830701": {
            "id": "760830701",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Once the game is over, the kuuhenki rush toward you. They appear to be extremely happy.",
            "nextDialogs": [

        "dialogs": {
          "760830501": {
            "id": "760830501",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Go on now, friends.",
            "nextDialogs": [
              "760830502"
            ]
          },
          "760830502": {
            "id": "760830502",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "All you need to do is guess what the picture is.",
            "nextDialogs": [
              "760830504",
              "760830509",
              "760830514"
            ]
          },
          "760830504": {
            "id": "760830504",
            "speakerId": 15703,
            "speakerName": "Kuuhenki",
            "text": "!!!",
            "nextDialogs": [
              "760830505"
            ]
          },
          "760830505": {
            "id": "760830505",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How did you manage to guess that!?",
            "nextDialogs": [
              "760830506"
            ]
          },
          "760830506": {
            "id": "760830506",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "So that's what it's called. Does it pick its creator up and carry her around in its hand?",
            "nextDialogs": [
              "760830507"
            ]
          },
          "760830507": {
            "id": "760830507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon thinks you might be confusing Aino with a former colleague of yours..."
          },
          "760830509": {
            "id": "760830509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Could a Weasel Thief this stuffed still steal stuff?",
            "nextDialogs": [
              "760830510"
            ]
          },
          "760830510": {
            "id": "760830510",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Or perhaps it no longer needs to steal?",
            "nextDialogs": [
              "760830511"
            ]
          },
          "760830511": {
            "id": "760830511",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The correct answer is \"the big mechanical duck next to Aino's workshop.\"",
            "nextDialogs": [
              "760830512"
            ]
          },
          "760830512": {
            "id": "760830512",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Come back now. Thank you, I know that wasn't easy."
          },
          "760830514": {
            "id": "760830514",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, the kuuhenki learned what specialized lab equipment looks like just for this game? They're really going all out!",
            "nextDialogs": [
              "760830515"
            ]
          },
          "760830515": {
            "id": "760830515",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "That's... very close.",
            "nextDialogs": [
              "760830516"
            ]
          },
          "760830516": {
            "id": "760830516",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The correct answer is \"the big mechanical duck next to Aino's workshop.\"",
            "nextDialogs": [
              "760830517"
            ]
          },
          "760830517": {
            "id": "760830517",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How is that close!?",
            "nextDialogs": [
              "760830518"
            ]
          },
          "760830518": {
            "id": "760830518",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Come back now. Thank you, I know that wasn't easy."
          }
        }
      }

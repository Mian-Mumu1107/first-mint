    {
      "subId": "1020101",
      "subQuestName": "Find the treasure trove in the Whispering Woods",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102010101"
        ],
        "dialogs": {
          "102010101": {
            "id": "102010101",
            "speakerId": 1000,
            "speakerName": "Klee",
            "text": "We're here! This is the place!",
            "nextDialogs": [
              "102010102"
            ]
          },
          "102010102": {
            "id": "102010102",
            "speakerId": 1000,
            "speakerName": "Klee",
            "text": "Look, this is where my huuuge treasure was buried...",
            "nextDialogs": [
              "102010103"
            ]
          },
          "102010103": {
            "id": "102010103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "And where there's now a huuuge empty hole in the ground...",
            "nextDialogs": [
              "102010104"
            ]
          },
          "102010104": {
            "id": "102010104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wait — who's that over there?",
            "nextDialogs": [
              "102010105"
            ]
          },
          "102010105": {
            "id": "102010105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's... an Abyss Mage!? Hey, maybe he's the one Jean was warning us about.",
            "nextDialogs": [
              "102010106"
            ]
          },
          "102010106": {
            "id": "102010106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What's that in his hand?",
            "nextDialogs": [
              "102010107"
            ]
          },
          "102010107": {
            "id": "102010107",
            "speakerId": 1000,
            "speakerName": "Klee",
            "text": "My treasure!",
            "nextDialogs": [
              "102010108"
            ]
          },
          "102010108": {
            "id": "102010108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...Wha!?",
            "nextDialogs": [
              "102010109"
            ]
          },
          "102010109": {
            "id": "102010109",
            "speakerId": 1002,
            "speakerName": "Abyss Mage",
            "text": "Hmph! I see the little girl's brought her friends with her! Time for a change of plan...",
            "nextDialogs": [
              "102010110"
            ]
          },
          "102010110": {
            "id": "102010110",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, you! If you think you're so tough, get back here and fight!",
            "nextDialogs": [
              "102010111"
            ]
          },
          "102010111": {
            "id": "102010111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "After him!"
          }
        }
      }
    },

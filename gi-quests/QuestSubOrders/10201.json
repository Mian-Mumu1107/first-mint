    {
      "subId": "1020102",
      "subQuestName": "Chase down the Abyss Mage with Klee (If the Abyss Mage gets more than 50m away, the quest will be failed)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102010201"
        ],
        "dialogs": {
          "102010201": {
            "id": "102010201",
            "speakerId": 1000,
            "speakerName": "Klee",
            "text": "What's an Abyss Mage? I play in the forest all the time, but I've never seen one before."
          }
        }
      }
    },
    {
      "subId": "1020103",
      "subQuestName": "Pursuit I",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102010301"
        ],
        "dialogs": {
          "102010301": {
            "id": "102010301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A gateway to a domain! The Abyss Mage must have snuck inside.",
            "nextDialogs": [
              "102010304"
            ]
          },
          "102010304": {
            "id": "102010304",
            "speakerId": 1000,
            "speakerName": "Klee",
            "text": "*panting* ...",
            "nextDialogs": [
              "102010305"
            ]
          },
          "102010305": {
            "id": "102010305",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Klee, do you need a rest?",
            "nextDialogs": [
              "102010306"
            ]
          },
          "102010306": {
            "id": "102010306",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Why don't you wait here while we get your treasure back for you?",
            "nextDialogs": [
              "102010307"
            ]
          },
          "102010307": {
            "id": "102010307",
            "speakerId": 1000,
            "speakerName": "Klee",
            "text": "...No, I'm coming with you!",
            "nextDialogs": [
              "102010308"
            ]
          },
          "102010308": {
            "id": "102010308",
            "speakerId": 1000,
            "speakerName": "Klee",
            "text": "It's my treasure that Mr. Fluffball stole, and it's up to me to get it back!"
          }
        }
      }
    },
    {
      "subId": "1020114",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102010601"
        ],
        "dialogs": {
          "102010601": {
            "id": "102010601",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Game's up. Now hand it over!",
            "nextDialogs": [
              "102010602"
            ]
          },
          "102010602": {
            "id": "102010602",
            "speakerId": 1002,
            "speakerName": "Abyss Mage",
            "text": "Grr...",
            "nextDialogs": [
              "102010603"
            ]
          },
          "102010603": {
            "id": "102010603",
            "speakerId": 1002,
            "speakerName": "Abyss Mage",
            "text": "You fools think I would give this up so easily after what I have been through to acquire it?",
            "nextDialogs": [
              "102010604"
            ]
          },
          "102010604": {
            "id": "102010604",
            "speakerId": 1002,
            "speakerName": "Abyss Mage",
            "text": "Hehe..."
          }
        }
      }
    },
    {
      "subId": "1020104",
      "subQuestName": "Combat I",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "102010401"
        ],
        "dialogs": {
          "102010401": {
            "id": "102010401",
            "speakerId": 1002,
            "speakerName": "Abyss Mage",
            "text": "Hmph. You followed me. I must say, I'm impressed.",
            "nextDialogs": [
              "102010402"
            ]
          },
          "102010402": {
            "id": "102010402",
            "speakerId": 1002,
            "speakerName": "Abyss Mage",
            "text": "But this is as far as you will get.",
            "nextDialogs": [
              "102010403"
            ]
          },
          "102010403": {
            "id": "102010403",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh yeah? What are you gonna do?",
            "nextDialogs": [
              "102010404"
            ]
          },
          "102010404": {
            "id": "102010404",
            "speakerId": 1002,
            "speakerName": "Abyss Mage",
            "text": "Mwuhahaha! Ahahahaha!",
            "nextDialogs": [
              "102010405"
            ]
          },
          "102010405": {
            "id": "102010405",
            "speakerId": 1002,
            "speakerName": "Abyss Mage",
            "text": "Oh, the human proclivity to gossip has provided us with everything we need...",
            "nextDialogs": [
              "102010406"
            ]
          },
          "102010406": {
            "id": "102010406",
            "speakerId": 1002,
            "speakerName": "Abyss Mage",
            "text": "We learned that your little red friend had in her possession the most powerful treasure in all of Mondstadt.",
            "nextDialogs": [
              "102010407"
            ]
          },
          "102010407": {
            "id": "102010407",
            "speakerId": 1002,
            "speakerName": "Abyss Mage",
            "text": "That treasure is now in my hands. There is nothing you can do!",
            "nextDialogs": [
              "102010408"
            ]
          },
          "102010408": {
            "id": "102010408",
            "speakerId": 1002,
            "speakerName": "Abyss Mage",
            "text": "Now your precious treasure shall be your undoing!",
            "nextDialogs": [
              "102010409"
            ]
          },
          "102010409": {
            "id": "102010409",
            "speakerId": 1000,
            "speakerName": "Klee",
            "text": "No, no, wait! D—Don't touch it!",
            "nextDialogs": [
              "102010410"
            ]
          },
          "102010410": {
            "id": "102010410",
            "speakerId": 1002,
            "speakerName": "Abyss Mage",
            "text": "Hah! Oh, how you fret now your predicament is finally clear to you!",
            "nextDialogs": [
              "102010411"
            ]
          },
          "102010411": {
            "id": "102010411",
            "speakerId": 1002,
            "speakerName": "Abyss Mage",
            "text": "Now, what have we here — a flame symbol? Mwuhahaha...",
            "nextDialogs": [
              "102010412"
            ]
          },
          "102010412": {
            "id": "102010412",
            "speakerId": 1003,
            "speakerName": "???",
            "text": "*bang*",
            "nextDialogs": [
              "102010501"
            ]
          },
          "102010501": {
            "id": "102010501",
            "speakerId": 1000,
            "speakerName": "Klee",
            "text": "NO!",
            "nextDialogs": [
              "102010502"
            ]
          },
          "102010502": {
            "id": "102010502",
            "speakerId": 1000,
            "speakerName": "Klee",
            "text": "I broke the survival rules... \"Explosions can hurt people... Jean can be dreadful...\"",
            "nextDialogs": [
              "102010503"
            ]
          },
          "102010503": {
            "id": "102010503",
            "speakerId": 1000,
            "speakerName": "Klee",
            "text": "This is it... This time I'm done for... *sobs*",
            "nextDialogs": [
              "102010504"
            ]
          },
          "102010504": {
            "id": "102010504",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "102010505"
            ]
          },
          "102010505": {
            "id": "102010505",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait, so Klee's treasure is a bomb!?",
            "nextDialogs": [
              "102010508"
            ]
          },
          "102010508": {
            "id": "102010508",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "No wonder Klee was rumored to be the strongest fighter in Mondstadt.",
            "nextDialogs": [
              "102010509"
            ]
          },
          "102010509": {
            "id": "102010509",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon for one is never picking a fight with her. Ever.",
            "nextDialogs": [
              "102010510"
            ]
          },
          "102010510": {
            "id": "102010510",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hold on... Why has she gone and run off?"
          }
        }
      }
    },

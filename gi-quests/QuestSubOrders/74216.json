  "subQuests": [
    {
      "subId": "7421601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742160201"
        ],
        "dialogs": {
          "742160201": {
            "id": "742160201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, what are you waiting for? Get onboard, sailor!",
            "nextDialogs": [
              "742160208"
            ]
          },
          "742160208": {
            "id": "742160208",
            "speakerId": 1000,
            "speakerName": "Giulietta",
            "text": "#Thank you so much, {M#good sir}{F#kind ma'am}!"
          }
        }
      }
    },
    {
      "subId": "7421602",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742160801"
        ],
        "dialogs": {
          "742160801": {
            "id": "742160801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "My Waverider's a fast and steady boat. Hop onboard, and we'll be off.",
            "nextDialogs": [
              "742160802"
            ]
          },
          "742160802": {
            "id": "742160802",
            "speakerId": 1001,
            "speakerName": "Giustino",
            "text": "Thank you."
          }
        }
      }
    },
    {

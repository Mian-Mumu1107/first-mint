    },
    {
      "subId": "7421612",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742161211"
        ],
        "dialogs": {
          "742161211": {
            "id": "742161211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Just a while more...",
            "nextDialogs": [
              "742161212"
            ]
          },
          "742161212": {
            "id": "742161212",
            "speakerId": 1001,
            "speakerName": "Giustino",
            "text": "Of course, no trouble at all."
          }
        }
      }
    },
    {
      "subId": "7421614",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742161403"
        ],
        "dialogs": {
          "742161403": {
            "id": "742161403",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hello there. Have you seen a merchant from Fontaine dressed in Sumeru garb?",
            "nextDialogs": [
              "742161404"
            ]
          },
          "742161404": {
            "id": "742161404",
            "speakerId": 1008,
            "speakerName": "Loredan",
            "text": "Huh? A Fontainian wearing clothes from Sumeru? Sorry, I was a bit busy thinking about my composition, so I didn't notice.",
            "nextDialogs": [
              "742161405"
            ]
          },
          "742161405": {
            "id": "742161405",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Hmm, alright then... Guess we should ask elsewhere, {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "7421615",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742161503"
        ],
        "dialogs": {
          "742161503": {
            "id": "742161503",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hello there. Have you seen a merchant from Fontaine dressed in Sumeru garb?",
            "nextDialogs": [
              "742161504"
            ]
          },
          "742161504": {
            "id": "742161504",
            "speakerId": 1009,
            "speakerName": "Contarini",
            "text": "I've not seen any such person. Has something happened? If there's an emergency case that requires the Special Patrol's services...",
            "nextDialogs": [
              "742161505"
            ]
          },
          "742161505": {
            "id": "742161505",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Well, it's not anything urgent, really... Anyway, we'll be looking elsewhere!"
          }
        }
      }
    }
  ]
}
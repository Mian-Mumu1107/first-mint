          "210290101"
        ],
        "dialogs": {
          "210290101": {
            "id": "210290101",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Argh! It... It failed again...",
            "nextDialogs": [
              "210290102"
            ]
          },
          "210290102": {
            "id": "210290102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you working on?",
            "nextDialogs": [
              "210290103"
            ]
          },
          "210290103": {
            "id": "210290103",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Eh? Oh, Traveler, it's you.",
            "nextDialogs": [
              "210290104"
            ]
          },
          "210290104": {
            "id": "210290104",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Remember the dish you taught me how to cook the last time? Well, I was just trying to make it... But I haven't been successful yet. Not even once.",
            "nextDialogs": [
              "210290105"
            ]
          },
          "210290105": {
            "id": "210290105",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "I was thinking that I might be using the wrong ingredients...",
            "nextDialogs": [
              "210290106"
            ]
          },
          "210290106": {
            "id": "210290106",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Could you try teaching me again?",
            "nextDialogs": [
              "210290109"
            ]
          },
          "210290109": {
            "id": "210290109",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Well... let's go with Chicken-Mushroom Skewer!",
            "nextDialogs": [
              "210290110"
            ]
          },
          "210290110": {
            "id": "210290110",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "What special ingredients are we putting in this time around, Traveler?"
          }
        }
      }
    },

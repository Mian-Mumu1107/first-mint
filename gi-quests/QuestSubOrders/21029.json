    {
      "subId": "2102908",
      "subQuestName": "Teach Little Meng how to cook",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210291101"
        ],
        "dialogs": {
          "210291101": {
            "id": "210291101",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Alright! Let's start making our dish!",
            "nextDialogs": [
              "210291102"
            ]
          },
          "210291102": {
            "id": "210291102",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Agh! I—It's too spicy! W—Water! I need water...",
            "nextDialogs": [
              "210291103"
            ]
          },
          "210291103": {
            "id": "210291103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like we put too many Jueyun Chilis in, huh...",
            "nextDialogs": [
              "210291104"
            ]
          },
          "210291104": {
            "id": "210291104",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Phew... Alright, we're fine now...",
            "nextDialogs": [
              "210291105"
            ]
          },
          "210291105": {
            "id": "210291105",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Other than the spiciness, I honestly think that this dish was pretty tasty.",
            "nextDialogs": [
              "210291106"
            ]
          },
          "210291106": {
            "id": "210291106",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "And the spiciness definitely did, uh, keep me alert.",
            "nextDialogs": [
              "210291109"
            ]
          },
          "210291109": {
            "id": "210291109",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Thank you, Traveler! I'll make sure to memorize how to make this dish.",
            "nextDialogs": [
              "210291110"
            ]
          },
          "210291110": {
            "id": "210291110",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Once Dad and I are on the road, I'll find an opportunity to cook this for him!",
            "nextDialogs": [
              "210291111"
            ]
          },
          "210291111": {
            "id": "210291111",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Actually, hang on a moment. Can Dad take spicy food? I sure think so..."
          }
        }
      }
    },

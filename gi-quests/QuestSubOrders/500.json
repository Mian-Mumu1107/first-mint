        "dialogs": {
          "5000101": {
            "id": "5000101",
            "speakerId": 1000,
            "speakerName": "Stone Gate Bulletin Board",
            "text": "This is the Stone Gate Bulletin Board. You can find notices and messages from passersby posted here.",
            "nextDialogs": [
              "5000102"
            ]
          },
          "5000102": {
            "id": "5000102",
            "speakerId": 12451,
            "speakerName": "Bulletin Board",
            "text": "There has been significant monster activity recently near Stone Gate and Dihua Marsh. Millelith patrols have been increased, and we ask all traveling merchants to take caution when passing through."
          }
        }
      }
    },
    {
      "subId": "50002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000201"
        ],
        "dialogs": {
          "5000201": {
            "id": "5000201",
            "speakerId": 1000,
            "speakerName": "Stone Gate Bulletin Board",
            "text": "This is the Stone Gate Bulletin Board. You can find notices and messages from passersby posted here.",
            "nextDialogs": [
              "5000202"
            ]
          },
          "5000202": {
            "id": "5000202",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Last day of clearance sale! Come get famous Scent of Spring wares at a huge discount!\"",
            "nextDialogs": [
              "5000203"
            ]
          },
          "5000203": {
            "id": "5000203",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Only in this village, this store! Everything, must, go!\""
          }
        }
      }
    },
    {
      "subId": "50003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000301"
        ],
        "dialogs": {
          "5000301": {
            "id": "5000301",
            "speakerId": 1000,
            "speakerName": "Stone Gate Bulletin Board",
            "text": "This is the Stone Gate Bulletin Board. You can find notices and messages from passersby posted here.",
            "nextDialogs": [
              "5000302"
            ]
          },
          "5000302": {
            "id": "5000302",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"All your travel essentials, right here!\"",
            "nextDialogs": [
              "5000303"
            ]
          },
          "5000303": {
            "id": "5000303",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"They say rare merchandise are sound investments. Any traveling merchants in need of such are welcome to come visit my hypermarket in Dihua Marsh!\""
          }
        }
      }
    },
    {
      "subId": "50004",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000401"
        ],
        "dialogs": {
          "5000401": {
            "id": "5000401",
            "speakerId": 1000,
            "speakerName": "Stone Gate Bulletin Board",
            "text": "This is the Stone Gate Bulletin Board. You can find notices and messages from passersby posted here.",
            "nextDialogs": [
              "5000402"
            ]
          },
          "5000402": {
            "id": "5000402",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Pops Zhou welcomes all travelers to come by and relax with a big cup of cheap, refreshing tea!\"",
            "nextDialogs": [
              "5000403"
            ]
          },
          "5000403": {
            "id": "5000403",
            "speakerId": 1003,
            "speakerName": "Another Note",
            "text": "\"Having known Pops Zhou for 40 years, I can vouch that his tea hasn't declined in quality one bit... though it hasn't improved either.\""
          }
        }
      }
    },
    {
      "subId": "50005",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000501"
        ],
        "dialogs": {
          "5000501": {
            "id": "5000501",
            "speakerId": 1000,
            "speakerName": "Stone Gate Bulletin Board",
            "text": "This is the Stone Gate Bulletin Board. You can find notices and messages from passersby posted here.",
            "nextDialogs": [
              "5000502"
            ]
          },
          "5000502": {
            "id": "5000502",
            "speakerId": 12451,
            "speakerName": "Bulletin Board",
            "text": "Many Treasure Hoarders have been spotted recently near Stone Gate and Dihua Marsh. Passersby should take caution.",
            "nextDialogs": [
              "5000503"
            ]
          },
          "5000503": {
            "id": "5000503",
            "speakerId": 12451,
            "speakerName": "Bulletin Board",
            "text": "If you see anything suspicious, please first get to safety and then report the situation immediately to the nearest Millelith soldier."
          }
        }
      }
    },
    {
      "subId": "50006",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000601"
        ],
        "dialogs": {
          "5000601": {
            "id": "5000601",
            "speakerId": 1000,
            "speakerName": "Stone Gate Bulletin Board",
            "text": "This is the Stone Gate Bulletin Board. You can find notices and messages from passersby posted here.",
            "nextDialogs": [
              "5000602"
            ]
          },
          "5000602": {
            "id": "5000602",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"May the Lord of Geo protect us on our journey to a faraway land, a new home where we can start a life all our own...\"",
            "nextDialogs": [
              "5000603"
            ]
          },
          "5000603": {
            "id": "5000603",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"...I only hope that our painstaking planning and past mistakes were not all for nothing.\""
          }
        }
      }
    },
    {
      "subId": "50007",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000701"
        ],
        "dialogs": {
          "5000701": {
            "id": "5000701",
            "speakerId": 1000,
            "speakerName": "Stone Gate Bulletin Board",
            "text": "This is the Stone Gate Bulletin Board. You can find notices and messages from passersby posted here.",
            "nextDialogs": [
              "5000702"
            ]
          },
          "5000702": {
            "id": "5000702",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"'The gleaming blade reveals scarlet rain in forest shadows; I only hope that many-a-drink may drown my sorrows.' — A swordsman with no understanding of poetic verse. Feedback welcome.\"",
            "nextDialogs": [
              "5000703"
            ]
          },
          "5000703": {
            "id": "5000703",
            "speakerId": 1003,
            "speakerName": "Another Note",
            "text": "\"In my humble opinion... the second line makes absolutely no sense!\""
          }
        }
      }
    },
    {
      "subId": "50008",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000801"
        ],
        "dialogs": {
          "5000801": {
            "id": "5000801",
            "speakerId": 1000,
            "speakerName": "Stone Gate Bulletin Board",
            "text": "This is the Stone Gate Bulletin Board. You can find notices and messages from passersby posted here.",
            "nextDialogs": [
              "5000802"
            ]
          },
          "5000802": {
            "id": "5000802",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Let's set off on an adventure among the delicacies of Mondstadt!\"",
            "nextDialogs": [
              "5000803"
            ]
          },
          "5000803": {
            "id": "5000803",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"In the nation of wind and wine, does even the food taste of a cool breeze and fragrant wine?\""
          }
        }
      }
    },
    {
      "subId": "50009",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000901"
        ],
        "dialogs": {
          "5000901": {
            "id": "5000901",
            "speakerId": 1000,
            "speakerName": "Stone Gate Bulletin Board",
            "text": "This is the Stone Gate Bulletin Board. You can find notices and messages from passersby posted here.",
            "nextDialogs": [
              "5000902"
            ]
          },
          "5000902": {
            "id": "5000902",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Guhua...Legend...Sword...adepti in the mist...evildoer...\"",
            "nextDialogs": [
              "5000903"
            ]
          },
          "5000903": {
            "id": "5000903",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"I...writing...remarkable...this poem...\"",
            "nextDialogs": [
              "5000904"
            ]
          },
          "5000904": {
            "id": "5000904",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "(The handwriting is so poor that the rest is completely illegible.)"
          }
        }
      }
    },
    {
      "subId": "50010",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5001001"
        ],
        "dialogs": {
          "5001001": {
            "id": "5001001",
            "speakerId": 1000,
            "speakerName": "Stone Gate Bulletin Board",
            "text": "This is the Stone Gate Bulletin Board. You can find notices and messages from passersby posted here.",
            "nextDialogs": [
              "5001002"
            ]
          },
          "5001002": {
            "id": "5001002",
            "speakerId": 12451,
            "speakerName": "Bulletin Board",
            "text": "Welcome to Stone Gate, the door of Liyue! From here head south to the bustling port city, or north to the rustic land of wine."
          }
        }
      }
    },
    {
      "subId": "50011",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5001101"
        ],
        "dialogs": {
          "5001101": {
            "id": "5001101",
            "speakerId": 1000,
            "speakerName": "Stone Gate Bulletin Board",
            "text": "This is the Stone Gate Bulletin Board. You can find notices and messages from passersby posted here.",
            "nextDialogs": [
              "5001102"
            ]
          },
          "5001102": {
            "id": "5001102",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"A wealthy-looking girl dressed in purple came by here a few days ago, asking all sorts of things about the land, people's daily consumption, and such. She seemed to be from the city.\"",
            "nextDialogs": [
              "5001103"
            ]
          },
          "5001103": {
            "id": "5001103",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"When I asked who she was, she said she was a general secretary from Yujing Terrace, sure enough. City folk really are thorough at their job...\"",
            "nextDialogs": [
              "5001104"
            ]
          },
          "5001104": {
            "id": "5001104",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"You seldom see such vigorous, resolute demeanor in young people these days.\""
          }
        }
      }
    }
  ]
}
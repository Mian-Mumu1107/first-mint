    {
      "subId": "7407716",
      "subQuestName": "Talk to everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740770401"
        ],
        "dialogs": {
          "740770401": {
            "id": "740770401",
            "speakerId": 20995,
            "speakerName": "Ann",
            "text": "#Knight {NICKNAME}, Paimon, Caterpillar, Seymour... Is everyone alright?",
            "nextDialogs": [
              "740770402"
            ]
          },
          "740770402": {
            "id": "740770402",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Yes, it seems that we can now proceed deeper down.",
            "nextDialogs": [
              "740770403"
            ]
          },
          "740770403": {
            "id": "740770403",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Let's go, while there's still time.",
            "nextDialogs": [
              "740770404"
            ]
          },
          "740770404": {
            "id": "740770404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But there's still a bunch of clockwork meka here...",
            "nextDialogs": [
              "740770405"
            ]
          },
          "740770405": {
            "id": "740770405",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Go, now! Leave this area to Seymour and I. We'll regroup at the Narzissenkreuz Ordo.",
            "nextDialogs": [
              "740770406"
            ]
          },
          "740770406": {
            "id": "740770406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Good luck.",
            "nextDialogs": [
              "740770407"
            ]
          },
          "740770407": {
            "id": "740770407",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "There is no need to worry about us. My combat assessment shows a 100% chance of survival.",
            "nextDialogs": [
              "740770408"
            ]
          },
          "740770408": {
            "id": "740770408",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You nod to Caterpillar and Seymour, and then you leap through as the seal drops.\\nAnd on the other side, you find..."
          }
        }
      }
    },
    {
      "subId": "7407717",
      "subQuestName": "Talk to Ann",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740770501"
        ],
        "dialogs": {
          "740770501": {
            "id": "740770501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Looks like Caterpillar and Seymour are stuck on the other side...",
            "nextDialogs": [
              "740770502"
            ]
          },
          "740770502": {
            "id": "740770502",
            "speakerId": 20995,
            "speakerName": "Ann",
            "text": "Seymour, Caterpillar...",
            "nextDialogs": [
              "740770503"
            ]
          },
          "740770503": {
            "id": "740770503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Don't worry about them, Ann. They're strong! Besides, we agreed that we'd meet back up at the Ordo after all this is over, didn't we?",
            "nextDialogs": [
              "740770504"
            ]
          },
          "740770504": {
            "id": "740770504",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And don't forget, we're both here with you!",
            "nextDialogs": [
              "740770505"
            ]
          },
          "740770505": {
            "id": "740770505",
            "speakerId": 20995,
            "speakerName": "Ann",
            "text": "...You're right, Paimon. I've seen how strong, smart, and kind you both are. There's nothing to fear with you two here.",
            "nextDialogs": [
              "740770506"
            ]
          },
          "740770506": {
            "id": "740770506",
            "speakerId": 20995,
            "speakerName": "Ann",
            "text": "Nothing to fear at all!",
            "nextDialogs": [
              "740770507"
            ]
          },
          "740770507": {
            "id": "740770507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(That said, Paimon's a little scared herself...)",
            "nextDialogs": [
              "740770510"
            ]
          },
          "740770510": {
            "id": "740770510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We have to keep moving forward.",
            "nextDialogs": [
              "740770511"
            ]
          },
          "740770511": {
            "id": "740770511",
            "speakerId": 1005,
            "speakerName": "Paimon & Ann",
            "text": "Okay!",
            "nextDialogs": [
              "740770512"
            ]
          },
          "740770512": {
            "id": "740770512",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's no telling what we'll run into next... Let's be careful!"
          }
        }
      }
    },
    {
      "subId": "7407721",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740772101"
        ],
        "dialogs": {
          "740772101": {
            "id": "740772101",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "#Is there anything else I can help with, Knight {NICKNAME}?",
            "nextDialogs": [
              "740772102"
            ]
          },
          "740772102": {
            "id": "740772102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is there anything in particular that you'd like to do after this is all over?",
            "nextDialogs": [
              "740772103"
            ]
          },
          "740772103": {
            "id": "740772103",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "Honestly, I haven't given it any thought. I feel like I have nowhere to go.",
            "nextDialogs": [
              "740772104"
            ]
          },
          "740772104": {
            "id": "740772104",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "After learning the truth, I can never go back to Petit Chou and Al.",
            "nextDialogs": [
              "740772105"
            ]
          },
          "740772105": {
            "id": "740772105",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "So where should I go?",
            "nextDialogs": [
              "740772106"
            ]
          },
          "740772106": {
            "id": "740772106",
            "speakerId": 16922,
            "speakerName": "Ann",
            "text": "Forget it! Those are all problems for future Ann!"
          }
        }
      }
    },
    {
      "subId": "7407709",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740770901"
        ],
        "dialogs": {
          "740770901": {
            "id": "740770901",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Let's go. The final juncture awaits."
          }
        }
      }
    },
    {
      "subId": "7407711",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740771101"
        ],
        "dialogs": {
          "740771101": {
            "id": "740771101",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "When the two of you are attacked, my permissions will activate, authorizing me to take action against official armed forces.",
            "nextDialogs": [
              "740771102"
            ]
          },
          "740771102": {
            "id": "740771102",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "As such, there is no need for concern."
          }
        }
      }
    },
    {
      "subId": "7407722",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740772201"
        ],
        "dialogs": {
          "740772201": {
            "id": "740772201",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Is there anything else I can help with?",
            "nextDialogs": [
              "740772202"
            ]
          },
          "740772202": {
            "id": "740772202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Will you go see Lanoire once this is all over?",
            "nextDialogs": [
              "740772203"
            ]
          },
          "740772203": {
            "id": "740772203",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Probably, but I should also probably keep wandering. I still have a lot of questions that need answering.",
            "nextDialogs": [
              "740772204"
            ]
          },
          "740772204": {
            "id": "740772204",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "After listening to what Jakob said, I did recall a \"Book of Revealing\" related to their activities in their early years. Maybe I'll be able to find some clues about myself in there.",
            "nextDialogs": [
              "740772205"
            ]
          },
          "740772205": {
            "id": "740772205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you still care so much about the past?",
            "nextDialogs": [
              "740772206"
            ]
          },
          "740772206": {
            "id": "740772206",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "I suppose. That said, I'm more interested in knowing whether the novel I read so many years ago has a happy ending.",
            "nextDialogs": [
              "740772207"
            ]
          },
          "740772207": {
            "id": "740772207",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "I'll find out, come hell or high water — seriously.",
            "nextDialogs": [
              "740772208"
            ]
          },
          "740772208": {
            "id": "740772208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're... joking again, aren't you?",
            "nextDialogs": [
              "740772209"
            ]
          },
          "740772209": {
            "id": "740772209",
            "speakerId": 21048,
            "speakerName": "Caterpillar",
            "text": "Just a little. But I'm genuinely looking forward to seeing how a wonderful dream ends."
          }
        }
      }
    },
    {
      "subId": "7407723",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740772301"
        ],
        "dialogs": {
          "740772301": {
            "id": "740772301",
            "speakerId": 5303,
            "speakerName": "Seymour",
            "text": "#Anything else, {M#Mr.}{F#Ms.} {NICKNAME}?",
            "nextDialogs": [
              "740772302"
            ]
          },
          "740772302": {
            "id": "740772302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you made plans for the future?",
            "nextDialogs": [
              "740772303"
            ]
          },
          "740772303": {
            "id": "740772303",
            "speakerId": 5303,
            "speakerName": "Seymour",
            "text": "Do you mean once this is all over? If I can see Ms. Mary-Ann again, I hope...",
            "nextDialogs": [
              "740772304"
            ]
          },
          "740772304": {
            "id": "740772304",
            "speakerId": 5303,
            "speakerName": "Seymour",
            "text": "I hope she will agree to visit Mamere with me, and then the three of us can travel the world together.",
            "nextDialogs": [
              "740772305"
            ]
          },
          "740772305": {
            "id": "740772305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Aww, you're a good boy, aren't you? The goodest.",
            "nextDialogs": [
              "740772306"
            ]
          },
          "740772306": {
            "id": "740772306",
            "speakerId": 5303,
            "speakerName": "Seymour",
            "text": "I don't quite understand what you mean.",
            "nextDialogs": [
              "740772307"
            ]
          },
          "740772307": {
            "id": "740772307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're such a reliable prototype!",
            "nextDialogs": [
              "740772308"
            ]
          },
          "740772308": {
            "id": "740772308",
            "speakerId": 5303,
            "speakerName": "Seymour",
            "text": "Thank you for your praise."
          }
        }
      }
    }
  ]
}
    {
      "subId": "7407722",
      "subQuestName": "Take a break and talk with everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740770601"
        ],
        "dialogs": {
          "740770601": {
            "id": "740770601",
            "speakerId": 20995,
            "speakerName": "Ann",
            "text": "#How can I help you, Knight {NICKNAME}?",
            "nextDialogs": [
              "740770602"
            ]
          },
          "740770602": {
            "id": "740770602",
            "speakerId": 20995,
            "speakerName": "Ann",
            "text": "Both Caterpillar and Seymour are helping out, but I don't seem to be of any use now.",
            "nextDialogs": [
              "740770603"
            ]
          },
          "740770603": {
            "id": "740770603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry about it.",
            "nextDialogs": [
              "740770604"
            ]
          },
          "740770604": {
            "id": "740770604",
            "speakerId": 20995,
            "speakerName": "Ann",
            "text": "Of course, I understand. Though it's obvious that we can just kick it open, we've reached an understanding to do some investigating instead.",
            "nextDialogs": [
              "740770605"
            ]
          },
          "740770605": {
            "id": "740770605",
            "speakerId": 20995,
            "speakerName": "Ann",
            "text": "I suppose this is us trying to mentally prepare ourselves... after a fashion, right?"
          }
        }
      }
    },

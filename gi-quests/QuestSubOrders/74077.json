    {
      "subId": "7407708",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740770801"
        ],
        "dialogs": {
          "740770801": {
            "id": "740770801",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "Hello. How may I assist?",
            "nextDialogs": [
              "740770802"
            ]
          },
          "740770802": {
            "id": "740770802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the Gardemeks...",
            "nextDialogs": [
              "740770803"
            ]
          },
          "740770803": {
            "id": "740770803",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "Do not worry. All of them are inactive.",
            "nextDialogs": [
              "740770804"
            ]
          },
          "740770804": {
            "id": "740770804",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "If we consider their extreme age and the fact that they are early models, the probability of them waking at all is far from certain.",
            "nextDialogs": [
              "740770805"
            ]
          },
          "740770805": {
            "id": "740770805",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "According to the records of those with me, accessing the level below will trigger their activation sequences.",
            "nextDialogs": [
              "740770806"
            ]
          },
          "740770806": {
            "id": "740770806",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "At that point, around 60% of them will activate successfully. As for the remaining 40%, it's not guaranteed that they will fail to activate either.",
            "nextDialogs": [
              "740770807"
            ]
          },
          "740770807": {
            "id": "740770807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ugh...",
            "nextDialogs": [
              "740770808"
            ]
          },
          "740770808": {
            "id": "740770808",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "At least there's a chance the slow march of time has reduced the danger we are about to face.",
            "nextDialogs": [
              "740770809"
            ]
          },
          "740770809": {
            "id": "740770809",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're starting to confuse me.",
            "nextDialogs": [
              "740770810"
            ]
          },
          "740770810": {
            "id": "740770810",
            "speakerId": 16924,
            "speakerName": "Seymour",
            "text": "#Apologies, {M#Mr.}{F#Ms.} {NICKNAME}."
          }
        }
      }
    },
    {

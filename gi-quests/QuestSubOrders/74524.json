        "dialogs": {
          "745240301": {
            "id": "745240301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Give me a second, I'm considering my options."
          }
        }
      }
    },
    {
      "subId": "7452404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745240401"
        ],
        "dialogs": {
          "745240401": {
            "id": "745240401",
            "speakerId": 1000,
            "speakerName": "Yae Miko",
            "text": "Well, well, little one. What are the odds? Or did you come running after hearing about my itinerary for the day?",
            "nextDialogs": [
              "745240404"
            ]
          },
          "745240404": {
            "id": "745240404",
            "speakerId": 1000,
            "speakerName": "Yae Miko",
            "text": "Why, haven't you got a good nose? But no, I was merely bringing some snacks and popular light novels over to a friend who is... not the outgoing sort.",
            "nextDialogs": [
              "745240405"
            ]
          },
          "745240405": {
            "id": "745240405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is Ei following the latest series as well?",
            "nextDialogs": [
              "745240406"
            ]
          },
          "745240406": {
            "id": "745240406",
            "speakerId": 1000,
            "speakerName": "Yae Miko",
            "text": "To hear her put it, she means to \"learn about recent changes to Inazumans' preferences in entertainment and leisure.\"",
            "nextDialogs": [
              "745240407"
            ]
          },
          "745240407": {
            "id": "745240407",
            "speakerId": 1000,
            "speakerName": "Yae Miko",
            "text": "She even discussed the topic with me. It started as a serious analysis of reader preferences, of course...",
            "nextDialogs": [
              "745240408"
            ]
          },
          "745240408": {
            "id": "745240408",
            "speakerId": 1000,
            "speakerName": "Yae Miko",
            "text": "...But before long, she suddenly asked me, \"So, what happened to that character in the end?\"",
            "nextDialogs": [
              "745240409"
            ]
          },
          "745240409": {
            "id": "745240409",
            "speakerId": 1000,
            "speakerName": "Yae Miko",
            "text": "Hehe, it appears that even the mighty Raiden Ei is not immune to the allure of a thrilling tale."
          }
        }
      }
    }
  ]
}
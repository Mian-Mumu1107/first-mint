  "subQuests": [
    {
      "subId": "4133711",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413371101"
        ],
        "dialogs": {
          "413371101": {
            "id": "413371101",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Are you quite alright? How did you suddenly develop a headache... Do you need any medicine?",
            "nextDialogs": [
              "413371102"
            ]
          },
          "413371102": {
            "id": "413371102",
            "speakerId": 2418,
            "speakerName": "Little Que'er",
            "text": "No, uh, no need... Just stay with me for a bit, I'm sure it'll pass..."
          }
        }
      }
    },
    {
      "subId": "4133701",
      "subQuestName": "Go to Huaguang Stone Forest",
      "sceneId": null,

    {
      "subId": "4133710",
      "subQuestName": "Report back to Sun Yu and Little Que'er",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413371001"
        ],
        "dialogs": {
          "413371001": {
            "id": "413371001",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Ah, you're back. Did you release the Xiao Lantern?",
            "nextDialogs": [
              "413371002"
            ]
          },
          "413371002": {
            "id": "413371002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About what happened when we released the lantern...",
            "nextDialogs": [
              "413371003"
            ]
          },
          "413371003": {
            "id": "413371003",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "I see. Yes, Zhiruo... I remember her. She took good care of me back then.",
            "nextDialogs": [
              "413371004"
            ]
          },
          "413371004": {
            "id": "413371004",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "And she still remembers the Guhua Clan. I am pleased...",
            "nextDialogs": [
              "413371005"
            ]
          },
          "413371005": {
            "id": "413371005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How is Little Que'er?",
            "nextDialogs": [
              "413371006"
            ]

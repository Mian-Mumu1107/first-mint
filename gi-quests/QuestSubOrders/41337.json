      }
    },
    {
      "subId": "4133702",
      "subQuestName": "Talk to Sun Yu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413370201"
        ],
        "dialogs": {
          "413370201": {
            "id": "413370201",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "If I release a lantern around here, the adepti might see it, right? But with these materials...",
            "nextDialogs": [
              "413370202"
            ]
          },
          "413370202": {
            "id": "413370202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "413370203"
            ]
          },
          "413370203": {
            "id": "413370203",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Ah, I'm sorry, my junior and I were just considering the matter of releasing a Xiao Lantern.",
            "nextDialogs": [
              "413370204"
            ]
          },
          "413370204": {
            "id": "413370204",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "The trouble is that we don't quite have sufficient materials on hand...",
            "nextDialogs": [
              "413370205"
            ]
          },
          "413370205": {
            "id": "413370205",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "But if you are willing, friend...",
            "nextDialogs": [
              "413370206"
            ]
          },
          "413370206": {
            "id": "413370206",
            "speakerId": 2418,
            "speakerName": "Little Que'er",
            "text": "There you go again... Guhua this, Guhua that...",
            "nextDialogs": [
              "413370207"
            ]
          },
          "413370207": {
            "id": "413370207",
            "speakerId": 2418,
            "speakerName": "Little Que'er",
            "text": "The Lantern Rite only comes once a year, and all you can think to make a wish about is the Guhua Clan...",
            "nextDialogs": [
              "413370208"
            ]
          },
          "413370208": {
            "id": "413370208",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Are we not both disciples of Guhua? It falls to us to revive the Guhua Clan to its former glory.",
            "nextDialogs": [
              "413370209"
            ]
          },
          "413370209": {
            "id": "413370209",
            "speakerId": 2418,
            "speakerName": "Little Que'er",
            "text": "Yes, Brother... whatever you say, Brother...",
            "nextDialogs": [
              "413370210"
            ]
          },
          "413370210": {
            "id": "413370210",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Excuse me, friend. Would you, perchance, be willing to fetch some Xiao Lantern materials for me?",
            "nextDialogs": [
              "413370212",
              "413370214"
            ]
          },
          "413370212": {
            "id": "413370212",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "I salute you.",
            "nextDialogs": [
              "413370216"
            ]
          },
          "413370216": {
            "id": "413370216",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Ahem. So, I've checked over everything. It seems like we're still missing a Qingxin...",
            "nextDialogs": [
              "413370217"
            ]
          },
          "413370217": {
            "id": "413370217",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "The last ones we picked have since dried out and turned brittle...",
            "nextDialogs": [
              "413370218"
            ]
          },
          "413370218": {
            "id": "413370218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You can make Xiao Lanterns from Qingxin?",
            "nextDialogs": [
              "413370219"
            ]
          },
          "413370219": {
            "id": "413370219",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Heh, it's an unorthodox method that my fellow Guhua disciples and I once came up with when we were bored and had nothing else to do.",
            "nextDialogs": [
              "413370220"
            ]
          },
          "413370220": {
            "id": "413370220",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "But there is something rather nice about Xiao Lanterns scented with flowers.",
            "nextDialogs": [
              "413370221"
            ]
          },
          "413370221": {
            "id": "413370221",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "I shall await you here. Please bring the materials here once you have found them. You have my thanks."
          },
          "413370214": {
            "id": "413370214",
            "speakerId": 2418,
            "speakerName": "Little Que'er",
            "text": "No, it was nothing! No, whatever he wants, that's fine by me...",
            "nextDialogs": [
              "413370215"
            ]
          },
          "413370215": {
            "id": "413370215",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "*sigh* Sister..."
          }
        }
      }
    },
    {
      "subId": "4133703",
      "subQuestName": "Give the Qingxin flowers to Sun Yu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413370301"
        ],
        "dialogs": {
          "413370301": {
            "id": "413370301",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "I shall await you here. Please bring the materials here once you have found them. You have my thanks."
          }
        }
      }
    },
    {
      "subId": "4133704",
      "subQuestName": "Talk to Sun Yu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413370401"
        ],
        "dialogs": {
          "413370401": {
            "id": "413370401",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Thank you! We should be able to make a Xiao Lantern now.",
            "nextDialogs": [
              "413370402"
            ]
          },
          "413370402": {
            "id": "413370402",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "It's done, Que'er. Inscribe our wishes on this lantern later, if you will, for your handwriting has always been very good...",
            "nextDialogs": [
              "413370403"
            ]
          },
          "413370403": {
            "id": "413370403",
            "speakerId": 2418,
            "speakerName": "Little Que'er",
            "text": "Sure, sure. I'll do the writing.",
            "nextDialogs": [
              "413370404"
            ]
          },
          "413370404": {
            "id": "413370404",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Que'er... Are you... displeased, by any chance? What's the matter?",
            "nextDialogs": [
              "413370405"
            ]
          },
          "413370405": {
            "id": "413370405",
            "speakerId": 2418,
            "speakerName": "Little Que'er",
            "text": "Oh no, I'm not displeased at all. In fact, I couldn't be more happy to help release this lantern...",
            "nextDialogs": [
              "413370408"
            ]
          },
          "413370408": {
            "id": "413370408",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "Wh—Why, uh, yes! Indeed, friend, you speak the truth — we should do exactly that.",
            "nextDialogs": [
              "413370409"
            ]
          },
          "413370409": {
            "id": "413370409",
            "speakerId": 2418,
            "speakerName": "Little Que'er",
            "text": "Okay, you can go if you want. I won't join you, though. It's a hard climb and I don't have the energy.",
            "nextDialogs": [
              "413370410"
            ]
          },
          "413370410": {
            "id": "413370410",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "But... But we've been resting here for a sufficiently long time, I do believe...",
            "nextDialogs": [
              "413370411"
            ]
          },
          "413370411": {
            "id": "413370411",
            "speakerId": 2418,
            "speakerName": "Little Que'er",
            "text": "Uh, I've got a headache coming on. I don't know, maybe I caught a cold from this mountain air. It was a bit windy just now.",
            "nextDialogs": [
              "413370412"
            ]
          },
          "413370412": {
            "id": "413370412",
            "speakerId": 2400,
            "speakerName": "Sun Yu",
            "text": "I... Uh..."
          }
        }
      }
    },
    {
      "subId": "4133705",
      "subQuestName": "Go to the old Guhua Clan spot to release the lantern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413370501"
        ],
        "dialogs": {
          "413370501": {
            "id": "413370501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This should be where Sun Yu wanted us to release the lantern."
          }
        }
      }
    },
    {
      "subId": "4133706",
      "subQuestName": "Talk to Zhiruo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413370601"
        ],
        "dialogs": {
          "413370601": {
            "id": "413370601",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "You're here... to release lanterns?",
            "nextDialogs": [
              "413370602"
            ]
          },
          "413370602": {
            "id": "413370602",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "None but the members of the Guhua Clan know of this spot, and yet your faces are unfamiliar...",
            "nextDialogs": [
              "413370603"
            ]
          },
          "413370603": {
            "id": "413370603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm here at someone's behest.",
            "nextDialogs": [
              "413370604"
            ]
          },
          "413370604": {
            "id": "413370604",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "There are those of the Guhua Clan who still remember this place?",
            "nextDialogs": [
              "413370605"
            ]
          },
          "413370605": {
            "id": "413370605",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "I saw no one when I first arrived, and that saddened me, I must admit...",
            "nextDialogs": [
              "413370606"
            ]
          },
          "413370606": {
            "id": "413370606",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "But it gladdens my heart to know that there are still those of the Guhua Clan that remember this place.",
            "nextDialogs": [
              "413370607"
            ]
          },
          "413370607": {
            "id": "413370607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Guhua Clan used to release lanterns here?",
            "nextDialogs": [
              "413370608"
            ]
          },
          "413370608": {
            "id": "413370608",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "Yes... We would craft our lanterns, then an older disciple would bring us here. They'd lead the way, and we'd follow behind with our lanterns in hand.",
            "nextDialogs": [
              "413370609"
            ]
          },
          "413370609": {
            "id": "413370609",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "Back then... Xiao Lanterns from all over the mountain would merge into one in the sky. It was a wonderful sight.",
            "nextDialogs": [
              "413370610"
            ]
          },
          "413370610": {
            "id": "413370610",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "But now...",
            "nextDialogs": [
              "413370611"
            ]
          },
          "413370611": {
            "id": "413370611",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "...Let's release the lantern first. If you have the time, we can discuss the past further as we walk."
          }
        }
      }
    },
    {
      "subId": "4133712",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413371201"
        ],
        "dialogs": {
          "413371201": {
            "id": "413371201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, the Xiao Lantern's been released. Let's go back and tell Sun Yu and Little Que'er."
          }
        }
      }
    },
    {
      "subId": "4133707",
      "subQuestName": "Follow Zhiruo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413370701"
        ],
        "dialogs": {
          "413370701": {
            "id": "413370701",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "I remember that there was once when, on the occasion of our releasing lanterns, a high-spirited senior demanded a match with me.",
            "nextDialogs": [
              "413370702"
            ]
          },
          "413370702": {
            "id": "413370702",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "I had yet to make reply when a trusty female junior of ours stealthily poured water on the ground where he stood.",
            "nextDialogs": [
              "413370703"
            ]
          },
          "413370703": {
            "id": "413370703",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "With the ground so wet and slippery, our elder disciple had not even drawn his sword before taking one step, slipping and falling, and landing right on his buttocks. I laughed so hard that I promptly followed suit.",
            "nextDialogs": [
              "413370704"
            ]
          },
          "413370704": {
            "id": "413370704",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "He was not angry, he just pointed at me and laughed. Everyone else gathered around and laughed along...",
            "nextDialogs": [
              "413370705"
            ]
          },
          "413370705": {
            "id": "413370705",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "I don't know where he is today..."
          }
        }
      }
    },
    {
      "subId": "4133713",
      "subQuestName": "Talk to Zhiruo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4133708",
      "subQuestName": "Follow Zhiruo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413370801"
        ],
        "dialogs": {
          "413370801": {
            "id": "413370801",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "I also once saw a glimmer of hope. It was a young boy who had just joined the Guhua Clan. He was handsome, well-mannered, and exceptionally talented. It seemed like he would be the one to revive the tradition.",
            "nextDialogs": [
              "413370802"
            ]
          },
          "413370802": {
            "id": "413370802",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "But he was a difficult one to track down, and no one would see a glimpse of him for long periods... *sigh* I guess I never should have put my hopes in him.",
            "nextDialogs": [
              "413370803"
            ]
          },
          "413370803": {
            "id": "413370803",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "Better to let him go, and not hold out for his return."
          }
        }
      }
    },
    {
      "subId": "4133714",
      "subQuestName": "Talk to Zhiruo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4133709",
      "subQuestName": "Follow Zhiruo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413370901"
        ],
        "dialogs": {
          "413370901": {
            "id": "413370901",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "When I left the Guhua Clan, there were barely any disciples left.",
            "nextDialogs": [
              "413370902"
            ]
          },
          "413370902": {
            "id": "413370902",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "Master did not blame me. He just told me to live a good life.",
            "nextDialogs": [
              "413370903"
            ]
          },
          "413370903": {
            "id": "413370903",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "But now, I don't know whether I have lived a good life...",
            "nextDialogs": [
              "413370904"
            ]
          },
          "413370904": {
            "id": "413370904",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "...Or just... made it through life, with little to show for it.",
            "nextDialogs": [
              "413370905"
            ]
          },
          "413370905": {
            "id": "413370905",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "I've heard people say that a Guhua disciple called Sun Yu is currently visiting the mountain, and that he seeks to revive Guhua.",
            "nextDialogs": [
              "413370906"
            ]
          },
          "413370906": {
            "id": "413370906",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "If only I had his courage...",
            "nextDialogs": [
              "413370907"
            ]
          },
          "413370907": {
            "id": "413370907",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "Sorry, I'm prattling away, aren't I... It's good to come outside once in a while, get some fresh air, and get some things off my chest...",
            "nextDialogs": [
              "413370908"
            ]
          },
          "413370908": {
            "id": "413370908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You seem a little down.",
            "nextDialogs": [
              "413370909"
            ]
          },
          "413370909": {
            "id": "413370909",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "Oh... I'm fine. It's just... this time of year.",
            "nextDialogs": [
              "413370910"
            ]
          },
          "413370910": {
            "id": "413370910",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "Anyway, it's getting a little late. Happy Lantern Rite, and... please, could you pass on a message to the one who sent you with the lantern? The message is this:",
            "nextDialogs": [
              "413370911"
            ]
          },
          "413370911": {
            "id": "413370911",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "...The message is... Um...",
            "nextDialogs": [
              "413370912"
            ]
          },
          "413370912": {
            "id": "413370912",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "...Um, um... \"Happy Lantern Rite, from Zhiruo,\" I suppose.",
            "nextDialogs": [
              "413370913"
            ]
          },
          "413370913": {
            "id": "413370913",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Happy Lantern Rite to you, too.",
            "nextDialogs": [
              "413370914"
            ]
          },
          "413370914": {
            "id": "413370914",
            "speakerId": 2079,
            "speakerName": "Zhiruo",
            "text": "Thanks. Take care of yourself."
          }
        }
      }
    },
    {
      "subId": "4133715",

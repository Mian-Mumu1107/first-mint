{
  "lineCounts": {
    "Another Person's Message": 1,
    "Message": 26,
    "Owner's Reply": 18
  },
  "subQuests": [
    {
      "subId": "50501",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050101"
        ],
        "dialogs": {
          "5050101": {
            "id": "5050101",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Mr. Okazaki, when will the next shipment of Dandelion Wine arrive? Although the Sakoku Decree is very strict, given your status at the Commission, you must have a way, right?\"",
            "nextDialogs": [
              "5050102"
            ]
          },
          "5050102": {
            "id": "5050102",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Sorry, there is no such way.",
            "nextDialogs": [
              "5050103"
            ]
          },
          "5050103": {
            "id": "5050103",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "P.S: Can this type of question really be asked on a public message board like this...?"
          }
        }
      }
    },
    {
      "subId": "50503",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050301"
        ],
        "dialogs": {
          "5050301": {
            "id": "5050301",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Mr. Okazaki, thank you for the guidance and your explanations. It was quite enlightening. I shall certainly continue to support your business going forward.\"",
            "nextDialogs": [
              "5050302"
            ]
          },
          "5050302": {
            "id": "5050302",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Oh no no. It's quite an honor to receive such flattering words from the Tenryou Commissioner's strong right hand.",
            "nextDialogs": [
              "5050303"
            ]
          },
          "5050303": {
            "id": "5050303",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "If anything troubles you in the future, please do not hesitate to talk to me. I will do my best to help."
          }
        }
      }
    },
    {
      "subId": "50504",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050401"
        ],
        "dialogs": {
          "5050401": {
            "id": "5050401",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Regarding the damage to the furniture caused by my drunk son a few days ago, I will pay for them in full. May the Kamisato Clan please accept my sincere apology.\"",
            "nextDialogs": [
              "5050402"
            ]
          },
          "5050402": {
            "id": "5050402",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "You are too kind, Sir Madarame. It was nothing."
          }
        }
      }
    },
    {
      "subId": "50505",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050501"
        ],
        "dialogs": {
          "5050501": {
            "id": "5050501",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"The Sakura wine and Sakura Mochi were excellent. Thank you for serving us.\"",
            "nextDialogs": [
              "5050502"
            ]
          },
          "5050502": {
            "id": "5050502",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "I should thank you for coming.",
            "nextDialogs": [
              "5050503"
            ]
          },
          "5050503": {
            "id": "5050503",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"I must say that the wine tasted a bit different tonight. Was that on purpose?\"",
            "nextDialogs": [
              "5050504"
            ]
          },
          "5050504": {
            "id": "5050504",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Thank you for trying the wine! It was indeed specially prepared by myself."
          }
        }
      }
    },
    {
      "subId": "50507",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050701"
        ],
        "dialogs": {
          "5050701": {
            "id": "5050701",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"I will be stationed at Tatarasuna starting tomorrow. It will be a difficult parting for me.\"",
            "nextDialogs": [
              "5050702"
            ]
          },
          "5050702": {
            "id": "5050702",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"I hope that my sister will manage the family business well, but the economy hasn't been doing well lately. It won't be easy for her.\"",
            "nextDialogs": [
              "5050703"
            ]
          },
          "5050703": {
            "id": "5050703",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"I wish that the war would be over soon so that I can come home to share the family responsibilities.\"",
            "nextDialogs": [
              "5050704"
            ]
          },
          "5050704": {
            "id": "5050704",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Lad, don't worry! I am sure that you will complete your responsibilities successfully, and that you will return home soon!"
          }
        }
      }
    },
    {
      "subId": "50508",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050801"
        ],
        "dialogs": {
          "5050801": {
            "id": "5050801",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Tengu of the Kujou Clan, hear me! You'll pay for taking away my Vision! Don't you forget about our duel!\"",
            "nextDialogs": [
              "5050802"
            ]
          },
          "5050802": {
            "id": "5050802",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"I'll be waiting for you! Think long and hard about whom you've offended each time you come through this door!\"",
            "nextDialogs": [
              "5050803"
            ]
          },
          "5050803": {
            "id": "5050803",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Dear guest, although I don't know what Madam Kujou Sara has done to you, you are always welcome here to relax.",
            "nextDialogs": [
              "5050804"
            ]
          },
          "5050804": {
            "id": "5050804",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Haha, of course! This is Mr. Okazaki's place after all!\""
          }
        }
      }
    },
    {
      "subId": "50510",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5051001"
        ],
        "dialogs": {
          "5051001": {
            "id": "5051001",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"When shall the spring flowers bloom? The worries in my mind are boundless.\"",
            "nextDialogs": [
              "5051002"
            ]
          },
          "5051002": {
            "id": "5051002",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "The remnants of snow on the tree branches do seem like flowers."
          }
        }
      }
    },
    {
      "subId": "50511",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5051101"
        ],
        "dialogs": {
          "5051101": {
            "id": "5051101",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Finally, the Uyuu Restaurant once again, at last! Mr. Okazaki's as friendly as he ever was, and the wine's still excellent!\"",
            "nextDialogs": [
              "5051102"
            ]
          },
          "5051102": {
            "id": "5051102",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Haha, you are exaggerating, dear customer. By the way, it has been a while since I heard the stories of Haishan.",
            "nextDialogs": [
              "5051103"
            ]
          },
          "5051103": {
            "id": "5051103",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"'Good men don't brag about past valor,' Mr. Okazaki. Stop listening to my brothers when they talk about silly things!\"",
            "nextDialogs": [
              "5051104"
            ]
          },
          "5051104": {
            "id": "5051104",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Well, what is an old man to do, when you have never told any of those stories yourself?",
            "nextDialogs": [
              "5051105"
            ]
          },
          "5051105": {
            "id": "5051105",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Haha, stop teasing me!\""
          }
        }
      }
    },
    {
      "subId": "50515",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5051501"
        ],
        "dialogs": {
          "5051501": {
            "id": "5051501",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Hah! Hiromi's still as much of an idiot as ever!\"",
            "nextDialogs": [
              "5051502"
            ]
          },
          "5051502": {
            "id": "5051502",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"But seriously, though, the war's over, ain't it? When's this Sakoku Decree going to be abolished, eh?\"",
            "nextDialogs": [
              "5051503"
            ]
          },
          "5051503": {
            "id": "5051503",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"C'mon, old man Okazaki, you've got ways and means, don'cha? Come on, give me the scoop...\"",
            "nextDialogs": [
              "5051504"
            ]
          },
          "5051504": {
            "id": "5051504",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"What am I gonna do with that Sakoku scoop, you might ask? Well, I'll come right back to Ritou to settle down, and I'll run a legit business, of course!\"",
            "nextDialogs": [
              "5051505"
            ]
          },
          "5051505": {
            "id": "5051505",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Please be patient, dear customer. I believe that the days will get better.",
            "nextDialogs": [
              "5051506"
            ]
          },
          "5051506": {
            "id": "5051506",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Ah, by the way. Hiromi left a letter and a gift again. I will safeguard them for you for the time being.",
            "nextDialogs": [
              "5051507"
            ]
          },
          "5051507": {
            "id": "5051507",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Thanks, Mr. Okazaki. Seriously, this idiot...\""
          }
        }
      }
    },
    {
      "subId": "50516",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5051601"
        ],
        "dialogs": {
          "5051601": {
            "id": "5051601",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"The food stalls here on Narukami Island really are good. Man, if only my home had such fine taverns.\"",
            "nextDialogs": [
              "5051602"
            ]
          },
          "5051602": {
            "id": "5051602",
            "speakerId": 1002,
            "speakerName": "Another Person's Message",
            "text": "\"I know, right? Mr. Okazaki is such a friendly man. Don't see that much on Narukami at all.\"",
            "nextDialogs": [
              "5051603"
            ]
          },
          "5051603": {
            "id": "5051603",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Oh, come on, don't say that. I mean, as a general (material redacted), I've met a lot of friendly people.\"",
            "nextDialogs": [
              "5051604"
            ]
          },
          "5051604": {
            "id": "5051604",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Come on, do you really have to redact that nowadays!?\"",
            "nextDialogs": [
              "5051605"
            ]
          },
          "5051605": {
            "id": "5051605",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "It does seem that we've been playing host to all manner of strange new customers since the ceasefire was signed..."
          }
        }
      }
    },
    {
      "subId": "50517",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5051701"
        ],
        "dialogs": {
          "5051701": {
            "id": "5051701",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"Sorry, old man Okazaki. I had to eat my words and come back.\"",
            "nextDialogs": [
              "5051702"
            ]
          },
          "5051702": {
            "id": "5051702",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Ah, come now, see what I told you? And look at you — you've grown quite a bit since you left, haven't you?",
            "nextDialogs": [
              "5051703"
            ]
          },
          "5051703": {
            "id": "5051703",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"The things that last are less than few, I look upon tombs to comfort find.\"",
            "nextDialogs": [
              "5051704"
            ]
          },
          "5051704": {
            "id": "5051704",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "\"But today spring has come anew, and in its light, we leave the ice behind.\"",
            "nextDialogs": [
              "5051705"
            ]
          },
          "5051705": {
            "id": "5051705",
            "speakerId": 13173,
            "speakerName": "Message",
            "text": "\"That last bit feels forced.\"",
            "nextDialogs": [
              "5051706"
            ]
          },
          "5051706": {
            "id": "5051706",
            "speakerId": 1001,
            "speakerName": "Owner's Reply",
            "text": "Oh, come now, don't make life difficult for an old man just because you're a person of letters."
          }
        }
      }
    }
  ]
}
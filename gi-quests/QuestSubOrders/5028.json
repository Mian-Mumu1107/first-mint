    {
      "subId": "502805",
      "subQuestName": "Continue \"your\" journey",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50280501"
        ],
        "dialogs": {
          "50280501": {
            "id": "50280501",
            "speakerId": 1003,
            "speakerName": "Voice in the Void",
            "text": "The lives of the Descenders are more valuable than you can imagine.",
            "nextDialogs": [
              "50280502"
            ]
          },
          "50280502": {
            "id": "50280502",
            "speakerId": 1003,
            "speakerName": "Voice in the Void",
            "text": "You have destroyed this world's hope with your own hands.",
            "nextDialogs": [
              "50280503"
            ]
          },
          "50280503": {
            "id": "50280503",
            "speakerId": 1089,
            "speakerName": "Mavuika",
            "text": "If I was fated to fail, then why do you fear?",
            "nextDialogs": [
              "50280504"
            ]
          },
          "50280504": {
            "id": "50280504",
            "speakerId": 1003,
            "speakerName": "Voice in the Void",
            "text": "...",
            "nextDialogs": [
              "50280505"
            ]
          },
          "50280505": {
            "id": "50280505",
            "speakerId": 1089,
            "speakerName": "Mavuika",
            "text": "(We embark on a pilgrimage, for the wishes of the people.)",
            "nextDialogs": [
              "50280506"
            ]
          },
          "50280506": {
            "id": "50280506",
            "speakerId": 1089,
            "speakerName": "Mavuika",
            "text": "(We choose to battle, to earn a glorious name.)",
            "nextDialogs": [
              "50280507"
            ]
          },
          "50280507": {
            "id": "50280507",
            "speakerId": 1089,
            "speakerName": "Mavuika",
            "text": "(And in the end, we burn to cinders for a dream.)",
            "nextDialogs": [
              "50280508"
            ]
          },
          "50280508": {
            "id": "50280508",
            "speakerId": 1089,
            "speakerName": "Mavuika",
            "text": "(And so this cycle continued, time after time...)"
          }
        }
      }
    },

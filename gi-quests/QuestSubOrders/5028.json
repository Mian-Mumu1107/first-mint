    {
      "subId": "502802",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50280202"
        ],
        "dialogs": {
          "50280202": {
            "id": "50280202",
            "speakerId": 1094,
            "speakerName": "Ororon",
            "text": "#{M#His}{F#Her} soul is noble and pure. \"Hero\" is just {M#his}{F#her} starting point",
            "nextDialogs": [
              "50280207"
            ]
          },
          "50280207": {
            "id": "50280207",
            "speakerId": 1092,
            "speakerName": "Chasca",
            "text": "#I wish to soar with {M#him}{F#her}, and see the world beyond the sky",
            "nextDialogs": [
              "50280208"
            ]
          },
          "50280208": {
            "id": "50280208",
            "speakerId": 1091,
            "speakerName": "Iansan",
            "text": "#Wherever {M#he}{F#she} calls home... surely that land is a place of freedom and warmth.",
            "nextDialogs": [
              "50280211"
            ]
          },
          "50280211": {
            "id": "50280211",
            "speakerId": 1095,
            "speakerName": "Xilonen",
            "text": "#I admire {M#his}{F#her} wisdom, how {M#he}{F#she} always lives in the moment",
            "nextDialogs": [
              "50280212"
            ]
          },
          "50280212": {
            "id": "50280212",
            "speakerId": 1087,
            "speakerName": "Mualani",
            "text": "#Being {M#his}{F#her} friend makes me so happy!"
          }
        }
      }
    },

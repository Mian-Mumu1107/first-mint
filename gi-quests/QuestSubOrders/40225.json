  "subQuests": [
    {
      "subId": "4022501",
      "subQuestName": "Head to the giant ship on the sea",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402250101"
        ],
        "dialogs": {
          "402250101": {
            "id": "402250101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, is this...?",
            "nextDialogs": [
              "402250102"
            ]
          },
          "402250102": {
            "id": "402250102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Alcor?",
            "nextDialogs": [
              "402250103"
            ]
          },
          "402250103": {
            "id": "402250103",
            "speakerId": 1001,
            "speakerName": "Beidou",
            "text": "Actually, this is the second ship in our fleet. The Alcor's back home, patrolling Guyun Stone Forest.",
            "nextDialogs": [
              "402250104"
            ]
          },
          "402250104": {
            "id": "402250104",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Beidou! The infamous merc captain who sails the high seas!",
            "nextDialogs": [
              "402250105"
            ]
          },
          "402250105": {
            "id": "402250105",
            "speakerId": 1001,
            "speakerName": "Beidou",
            "text": "Uh, yeah, haha. We've met, remember? What's with all the pomp and circumstance?",
            "nextDialogs": [
              "402250106"
            ]
          },
          "402250106": {
            "id": "402250106",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's a long story...",
            "nextDialogs": [
              "402250107"
            ]
          },
          "402250107": {
            "id": "402250107",
            "speakerId": 1001,
            "speakerName": "Beidou",
            "text": "Well, no sense standin' around. Take a seat. Tell me all about it. I'll have my men roll out the welcome mat.",
            "nextDialogs": [
              "402250108"
            ]
          },
          "402250108": {
            "id": "402250108",
            "speakerId": 1001,
            "speakerName": "Beidou",
            "text": "Ah, I see. So, you know the head honcho of the Curatorium, huh... Your network of connections is somethin' else, that's for sure.",
            "nextDialogs": [
              "402250109"
            ]
          },
          "402250109": {
            "id": "402250109",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hehe...",
            "nextDialogs": [
              "402250110"
            ]
          },
          "402250110": {
            "id": "402250110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the registration...",
            "nextDialogs": [
              "402250111"
            ]
          },
          "402250111": {
            "id": "402250111",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Right! We need a record of who's participating in the expo and what you're planning to trade.",
            "nextDialogs": [
              "402250112"
            ]
          },
          "402250112": {
            "id": "402250112",
            "speakerId": 1001,
            "speakerName": "Beidou",
            "text": "Well, mark down me and a few crew members as participants — the rest will stay on the ship. As for what we're trading... Take a look.",
            "nextDialogs": [
              "402250113"
            ]
          },
          "402250113": {
            "id": "402250113",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What is it?",
            "nextDialogs": [
              "402250114"
            ]
          },
          "402250114": {
            "id": "402250114",
            "speakerId": 1001,
            "speakerName": "Beidou",
            "text": "A while ago, Ningguang revamped the Guizhong Ballista. The beauty you see here is one of her new and improved models.",
            "nextDialogs": [
              "402250115"
            ]
          },
          "402250115": {
            "id": "402250115",
            "speakerId": 1001,
            "speakerName": "Beidou",
            "text": "It has insane firepower and comes complete with remote guidance for accurate striking even at long distances. I just know people are gonna be fighting to get their hands on it.",
            "nextDialogs": [
              "402250116"
            ]
          },
          "402250116": {
            "id": "402250116",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Are you sure you're allowed to sell stuff like this!?",
            "nextDialogs": [
              "402250117"
            ]
          },
          "402250117": {
            "id": "402250117",
            "speakerId": 1001,
            "speakerName": "Beidou",
            "text": "Haha, don't worry. Compared to the model the Millelith's using, this one might as well be an antique.",
            "nextDialogs": [
              "402250118"
            ]
          },
          "402250118": {
            "id": "402250118",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...Nefer wasn't kidding when she said \"no restrictions,\" huh...",
            "nextDialogs": [
              "402250119"
            ]
          },
          "402250119": {
            "id": "402250119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But, who's gonna buy something like this?",
            "nextDialogs": [
              "402250120"
            ]
          },
          "402250120": {
            "id": "402250120",
            "speakerId": 1002,
            "speakerName": "Yelan",
            "text": "Oh, I'm sure someone will bite. Buyers from all over Teyvat will be in attendance, after all.",
            "nextDialogs": [
              "402250121"
            ]
          },
          "402250121": {
            "id": "402250121",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...Yelan?",
            "nextDialogs": [
              "402250122"
            ]
          },
          "402250122": {
            "id": "402250122",
            "speakerId": 1001,
            "speakerName": "Beidou",
            "text": "Ah, sorry. I was so busy with the cargo, I forgot to mention that Yelan was aboard.",
            "nextDialogs": [
              "402250123"
            ]
          },
          "402250123": {
            "id": "402250123",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "No worries. You here for the expo too, Yelan?",
            "nextDialogs": [
              "402250124"
            ]
          },
          "402250124": {
            "id": "402250124",
            "speakerId": 1002,
            "speakerName": "Yelan",
            "text": "No, I'm just here for work. Captain Beidou was kind enough to lend me a ride. So, no need to register me with the expo.",
            "nextDialogs": [
              "402250125"
            ]
          },
          "402250125": {
            "id": "402250125",
            "speakerId": 1002,
            "speakerName": "Yelan",
            "text": "#Anyway, it's been a while, {NICKNAME}. If you get the chance, be sure to pass along my regards to the head of the Curatorium.",
            "nextDialogs": [
              "402250126"
            ]
          },
          "402250126": {
            "id": "402250126",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What kind of work?",
            "nextDialogs": [
              "402250127"
            ]
          },
          "402250127": {
            "id": "402250127",
            "speakerId": 1002,
            "speakerName": "Yelan",
            "text": "The... sensitive kind.",
            "nextDialogs": [
              "402250128"
            ]
          },
          "402250128": {
            "id": "402250128",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Sounds like our cue to stop asking questions, doesn't it...?",
            "nextDialogs": [
              "402250129"
            ]
          },
          "402250129": {
            "id": "402250129",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "One hundred percent.",
            "nextDialogs": [
              "402250130"
            ]
          },
          "402250130": {
            "id": "402250130",
            "speakerId": 1002,
            "speakerName": "Yelan",
            "text": "Well, I'll be off, then. Once I'm done with this, drinks are on me.",
            "nextDialogs": [
              "402250131"
            ]
          },
          "402250131": {
            "id": "402250131",
            "speakerId": 1001,
            "speakerName": "Beidou",
            "text": "About time! I've been itching to see Nod-Krai from the bottom of a bottle, haha.",
            "nextDialogs": [
              "402250132"
            ]
          },
          "402250132": {
            "id": "402250132",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Alright, that's it for registration. Follow us, and we'll take you to the venue."
          }
        }
      }
    },
    {
      "subId": "4022502",
      "subQuestName": "Take Beidou to the event venue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402250201"
        ],
        "dialogs": {
          "402250201": {
            "id": "402250201",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Beidou directs her crew to unload the cargo and follows you to the venue.",
            "nextDialogs": [
              "402250202"
            ]
          },
          "402250202": {
            "id": "402250202",
            "speakerId": 1001,
            "speakerName": "Beidou",
            "text": "So, this is the place, huh? Not a bad spot!",
            "nextDialogs": [
              "402250203"
            ]
          },
          "402250203": {
            "id": "402250203",
            "speakerId": 1001,
            "speakerName": "Beidou",
            "text": "When you've got some time, come help me test the remote guidance on this thing. It's a real thrill — you'll love it."
          }
        }
      }
    }
  ]
}
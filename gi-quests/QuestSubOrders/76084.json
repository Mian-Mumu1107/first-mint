  "subQuests": [
    {
      "subId": "7608401",
      "subQuestName": "Meet The Damselette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490603"
        ],
        "dialogs": {
          "760490603": {
            "id": "760490603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's try calm and gentle...",
            "nextDialogs": [
              "760490604"
            ]
          },
          "760490604": {
            "id": "760490604",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "That was lovely. So you really did memorize my tune.",
            "nextDialogs": [
              "760490605"
            ]
          },
          "760490605": {
            "id": "760490605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, only 'cause you're such a great singer! Whenever we hear your voice, sometimes we stop for a bit just to listen...",
            "nextDialogs": [
              "760490606"
            ]
          },
          "760490606": {
            "id": "760490606",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Hm, the kuuhenki seemed quite enraptured with your performance as well. Perhaps they picked up a few things...",
            "nextDialogs": [
              "760490607"
            ]
          },
          "760490607": {
            "id": "760490607",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I might require your educational assistance again in the future.",
            "nextDialogs": [
              "760490608"
            ]
          },
          "760490608": {
            "id": "760490608",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Come, give me your hand.",
            "nextDialogs": [
              "760490609"
            ]
          },
          "760490609": {
            "id": "760490609",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? No, no, this was a free performance. No tuition fee required!",
            "nextDialogs": [
              "760490610"
            ]
          },
          "760490610": {
            "id": "760490610",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Hmm? Tuition fee?",
            "nextDialogs": [
              "760490611"
            ]
          },
          "760490611": {
            "id": "760490611",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "I only thought... the gentle glow of moonlight would make a fitting accompaniment for such a beautiful melody."
          }
        }
      }
    },
    {
      "subId": "7604903",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490301"
        ],
        "dialogs": {
          "760490301": {
            "id": "760490301",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "The kuuhenki seem quite content for the day. Even so... I may have to trouble you to drop by again when they wish to learn more."
          }
        }
      }
    },
    {
      "subId": "7604907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490709"
        ],
        "dialogs": {
          "760490709": {
            "id": "760490709",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "We have pierced through cloud and fog, and together, witnessed the answer on the moon... Its beauty is like the music your strings now sing."
          }
        }
      }
    },
    {
      "subId": "7608401",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760840101"
        ],
        "dialogs": {
          "760840101": {
            "id": "760840101",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Ah, you're here? The kuuhenki are playing the lyre again. Could you play a song for them like last time?",
            "nextDialogs": [
              "760840102"
            ]
          },
          "760840102": {
            "id": "760840102",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "And I happen to be in the mood to hear something different myself.",
            "nextDialogs": [
              "760840103"
            ]
          },
          "760840103": {
            "id": "760840103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Hmm, what should I play...)"
          }
        }
      }
    },
    {
      "subId": "7608402",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760840201"
        ],
        "dialogs": {
          "760840201": {
            "id": "760840201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's try the one Columbina always sings...",
            "nextDialogs": [
              "760490202"
            ]
          },
          "760490202": {
            "id": "760490202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's try the one Columbina always sings...",
            "nextDialogs": [
              "760490201"
            ]
          },
          "760490201": {
            "id": "760490201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(But what tone should I go for...)",
            "nextDialogs": [
              "760490702"
            ]
          },
          "760490702": {
            "id": "760490702",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Oh, it's over already? I could listen to that forever...",
            "nextDialogs": [
              "760490703"
            ]
          },
          "760490703": {
            "id": "760490703",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "As I once told you, this is the only lullaby I can remember.",
            "nextDialogs": [
              "760490704"
            ]
          },
          "760490704": {
            "id": "760490704",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Although I have yet to discern the meaning behind it, after hearing you play, I feel like whatever answer is waiting for me, up there on the moon... at the very least, it must be a beautiful one.",
            "nextDialogs": [
              "760490705"
            ]
          },
          "760490705": {
            "id": "760490705",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Here, give me your hand.",
            "nextDialogs": [
              "760490706"
            ]
          },
          "760490706": {
            "id": "760490706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's okay. Seriously, you don't need to give us anything in return.",
            "nextDialogs": [
              "760490707"
            ]
          },
          "760490707": {
            "id": "760490707",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Ah, that wasn't my intention... I only wished to adorn your melody with a ray of gentle moonlight."
          }
        }
      }
    },

    {
      "subId": "7608405",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760840501"
        ],
        "dialogs": {
          "760840501": {
            "id": "760840501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's make it cheerful..."
          }
        }
      }
    },
    {
      "subId": "7608406",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760840601"
        ],
        "dialogs": {
          "760840601": {
            "id": "760840601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's try something from another nation...",
            "nextDialogs": [
              "760490801"
            ]
          },
          "760490801": {
            "id": "760490801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's try something from another nation...",
            "nextDialogs": [
              "760490802"
            ]
          },
          "760490802": {
            "id": "760490802",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "How curious... I have heard melodies like this before, but your playing lends a whole new dimension...",
            "nextDialogs": [
              "760490803"
            ]
          },
          "760490803": {
            "id": "760490803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Ah, maybe because {NICKNAME} was channeling {M#his}{F#her} emotional connection to that place...",
            "nextDialogs": [
              "760490804"
            ]
          },
          "760490804": {
            "id": "760490804",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "What's curious is that... I feel as if I can picture the landscape just by listening to the melody. I wonder how the real thing compares to my imagination...",
            "nextDialogs": [
              "760490805"
            ]
          },
          "760490805": {
            "id": "760490805",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You should just go see it someday! We can be your tour guides!",
            "nextDialogs": [
              "760490806"
            ]
          },
          "760490806": {
            "id": "760490806",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Mm... Perhaps. If that day ever comes."
          }
        }
      }
    }
  ]

        "dialogs": {
          "722420201": {
            "id": "722420201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "The five symbols on this big door must be the Key Sigils.",
            "nextDialogs": [
              "722420202"
            ]
          },
          "722420202": {
            "id": "722420202",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Let's have a look around. From what we've experienced in the past, we'll probably need to do something else first."
          }
        }
      }
    },
    {
      "subId": "7224204",
      "subQuestName": "Go to the building up ahead",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722420401"
        ],
        "dialogs": {
          "722420401": {
            "id": "722420401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wow! Paimon never thought that there'd be such a huge place underneath Watatsumi Island!",
            "nextDialogs": [
              "722420402"
            ]
          },
          "722420402": {
            "id": "722420402",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Looks like our goal is that place in the middle.",
            "nextDialogs": [
              "722420403"
            ]
          },
          "722420403": {
            "id": "722420403",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Alrighty then, {NICKNAME}. Let's head in. Steadily now...",
            "nextDialogs": [
              "722420404"
            ]
          },
          "722420404": {
            "id": "722420404",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Those ruins seem to be closer to us. Let's start there!",
            "nextDialogs": [
              "722420405"
            ]
          },
          "722420405": {
            "id": "722420405",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Buildings means people... once upon a time, anyway. And where there's people, there'll be writing!",
            "nextDialogs": [
              "722420406"
            ]
          },
          "722420406": {
            "id": "722420406",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "And where there's writing and paper, there'll be those... hints that we can't even read."
          }
        }
      }
    },

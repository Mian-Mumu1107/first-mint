    {
      "subId": "1201302",
      "subQuestName": "Approach the Tenryou Commission officers who are blocking the road",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120130201"
        ],
        "dialogs": {
          "120130201": {
            "id": "120130201",
            "speakerId": 1005,
            "speakerName": "Yoshitaka",
            "text": "Sorry, official business. I can't let you pass.",
            "nextDialogs": [
              "120130202"
            ]
          },
          "120130202": {
            "id": "120130202",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Sakujirou and Keisuke are up ahead, right? We need to talk to them about something.",
            "nextDialogs": [
              "120130203"
            ]
          },
          "120130203": {
            "id": "120130203",
            "speakerId": 1005,
            "speakerName": "Yoshitaka",
            "text": "Didn't you hear me? You're not getting past.",
            "nextDialogs": [
              "120130204"
            ]
          },
          "120130204": {
            "id": "120130204",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Ugh, what a nuisance! Well, you've only got yourself to blame!"
          }
        }
      }
    },
    {
      "subId": "1201303",
      "subQuestName": "Defeat the Tenryou Commission officers",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120130301"
        ],
        "dialogs": {
          "120130301": {
            "id": "120130301",
            "speakerId": 1005,
            "speakerName": "Yoshitaka",
            "text": "How dare you impede the work of the Tenryou Commission!",
            "nextDialogs": [
              "120130302"
            ]
          },
          "120130302": {
            "id": "120130302",
            "speakerId": 1005,
            "speakerName": "Yoshitaka",
            "text": "You will be punished for your actions!",
            "nextDialogs": [
              "120130303"
            ]
          },
          "120130303": {
            "id": "120130303",
            "speakerId": 1005,
            "speakerName": "Yoshitaka",
            "text": "There is nowhere you can escape justice, not even at the edges of the world!",
            "nextDialogs": [
              "120130304"
            ]
          },
          "120130304": {
            "id": "120130304",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Look at that — the one with the loudest mouth had the fastest feet.",
            "nextDialogs": [
              "120130305"
            ]
          },
          "120130305": {
            "id": "120130305",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "We can't waste any more time on these guys. Let's push on, they should be just ahead."
          }
        }
      }
    },
    {
      "subId": "1201304",
      "subQuestName": "Talk to the panicking Tenryou Commission officers",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1201305",
      "subQuestName": "Proceed deeper within to find Sakujirou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120130501"
        ],
        "dialogs": {
          "120130501": {
            "id": "120130501",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "*panting*... *panting*...",
            "nextDialogs": [
              "120130502"
            ]
          },
          "120130502": {
            "id": "120130502",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "Your skills with the sword have stagnated, Sakujirou...",
            "nextDialogs": [
              "120130503"
            ]
          },
          "120130503": {
            "id": "120130503",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "You should have known that you stood no chance against me in a duel.",
            "nextDialogs": [
              "120130504"
            ]
          },
          "120130504": {
            "id": "120130504",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "I never imagined I'd fall into your hands.",
            "nextDialogs": [
              "120130505"
            ]
          },
          "120130505": {
            "id": "120130505",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "...",
            "nextDialogs": [
              "120130506"
            ]
          },
          "120130506": {
            "id": "120130506",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "If this is to be my fate, I accept it. I have nothing else to say.",
            "nextDialogs": [
              "120130507"
            ]
          },
          "120130507": {
            "id": "120130507",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "But your return says that you finally came around to my point of view.",
            "nextDialogs": [
              "120130508"
            ]
          },
          "120130508": {
            "id": "120130508",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "Whatever you say.",
            "nextDialogs": [
              "120130509"
            ]
          },
          "120130509": {
            "id": "120130509",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "You will return with me to the Tenryou Commission to await your sentencing.",
            "nextDialogs": [
              "120130510"
            ]
          },
          "120130510": {
            "id": "120130510",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "The one who made this boat will also be punished.",
            "nextDialogs": [
              "120130511"
            ]
          },
          "120130511": {
            "id": "120130511",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Wait!",
            "nextDialogs": [
              "120130512"
            ]
          },
          "120130512": {
            "id": "120130512",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "It doesn't have to end like this! Don't you have anything else to say to one another!?",
            "nextDialogs": [
              "120130513"
            ]
          },
          "120130513": {
            "id": "120130513",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "Hey, I know you. You're Naganohara's girl, who makes the fireworks... Huh. I know you like to get involved in other people's business, but stay out of this. It does not concern you.",
            "nextDialogs": [
              "120130514"
            ]
          },
          "120130514": {
            "id": "120130514",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "It's okay, Yoimiya. The past is the past.",
            "nextDialogs": [
              "120130515"
            ]
          },
          "120130515": {
            "id": "120130515",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Then why did you risk life and limb to get yourself back into Inazuma!? And why were you so reluctant to leave after you got here!?",
            "nextDialogs": [
              "120130516"
            ]
          },
          "120130516": {
            "id": "120130516",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "I'll tell you why, this is why! This is the chance you've been waiting for, to talk everything through!",
            "nextDialogs": [
              "120130517"
            ]
          },
          "120130517": {
            "id": "120130517",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "I have nothing to say to him.",
            "nextDialogs": [
              "120130518"
            ]
          },
          "120130518": {
            "id": "120130518",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "He's a criminal, I work for the Tenryou Commission. There was never any room for discussion.",
            "nextDialogs": [
              "120130519"
            ]
          },
          "120130519": {
            "id": "120130519",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "Out of respect for the friendship we once had, I gave him a chance to fight for his freedom. But his skills with the sword are as disappointing now as they ever were.",
            "nextDialogs": [
              "120130520"
            ]
          },
          "120130520": {
            "id": "120130520",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "What are you talking about? And just who do you think you're kidding!?",
            "nextDialogs": [
              "120130521"
            ]
          },
          "120130521": {
            "id": "120130521",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "You left all your subordinates back there to guard the road, making sure no one else followed you here. Seems to me like you were hoping for a chance to talk.",
            "nextDialogs": [
              "120130522"
            ]
          },
          "120130522": {
            "id": "120130522",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "I can see it in your faces. You both have so much to say... and you're just gonna choose to keep it all inside?",
            "nextDialogs": [
              "120130523"
            ]
          },
          "120130523": {
            "id": "120130523",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "...",
            "nextDialogs": [
              "120130524"
            ]
          },
          "120130524": {
            "id": "120130524",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "Don't flatter yourself. What would you know?",
            "nextDialogs": [
              "120130525"
            ]
          },
          "120130525": {
            "id": "120130525",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "Yoimiya, leave it. It was just my wishful thinking.",
            "nextDialogs": [
              "120130526"
            ]
          },
          "120130526": {
            "id": "120130526",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "No, I won't leave it! I will not stand by and watch when you haven't even done anything!",
            "nextDialogs": [
              "120130527"
            ]
          },
          "120130527": {
            "id": "120130527",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Keisuke, you seem to like settling things with a duel. So let's do it your way! I challenge you to a duel!",
            "nextDialogs": [
              "120130528"
            ]
          },
          "120130528": {
            "id": "120130528",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "If I win, then you need to say everything that's in your heart. No more running from your feelings!",
            "nextDialogs": [
              "120130529"
            ]
          },
          "120130529": {
            "id": "120130529",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "And the same goes for you, Sakujirou! If I win, you will tell Keisuke exactly why you came back. No matter what the consequences are. You have to tell him everything!",
            "nextDialogs": [
              "120130530"
            ]
          },
          "120130530": {
            "id": "120130530",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "If you don't say anything now, you may never have another chance!",
            "nextDialogs": [
              "120130531"
            ]
          },
          "120130531": {
            "id": "120130531",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "And if you lose?",
            "nextDialogs": [
              "120130532"
            ]
          },
          "120130532": {
            "id": "120130532",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Then I'll admit to collaborating with Sakujirou and accept the Tenryou Commission's punishment!",
            "nextDialogs": [
              "120130533"
            ]
          },
          "120130533": {
            "id": "120130533",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "Yoimiya...",
            "nextDialogs": [
              "120130534"
            ]
          },
          "120130534": {
            "id": "120130534",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "I accept. Let's settle this with a duel."
          }
        }
      }
    },
    {
      "subId": "1201306",
      "subQuestName": "Defeat Imatani Keisuke",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1201307",
      "subQuestName": "Talk to Imatani Keisuke and Sakujirou",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120130701"
        ],
        "dialogs": {
          "120130701": {
            "id": "120130701",
            "speakerId": 1005,
            "speakerName": "Yoshitaka",
            "text": "Sir, they are too strong. We need more men...",
            "nextDialogs": [
              "120130702"
            ]
          },
          "120130702": {
            "id": "120130702",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "Stand down.",
            "nextDialogs": [
              "120130703"
            ]
          },
          "120130703": {
            "id": "120130703",
            "speakerId": 1005,
            "speakerName": "Yoshitaka",
            "text": "Wh—What?",
            "nextDialogs": [
              "120130704"
            ]
          },
          "120130704": {
            "id": "120130704",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "I thought I told you to stay away! Now, stand down!",
            "nextDialogs": [
              "120130705"
            ]
          },
          "120130705": {
            "id": "120130705",
            "speakerId": 1005,
            "speakerName": "Yoshitaka",
            "text": "Y—Yes, Sir... Sorry!",
            "nextDialogs": [
              "120130706"
            ]
          },
          "120130706": {
            "id": "120130706",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "Young lady, you are just as obstinate as Sakujirou was back then.",
            "nextDialogs": [
              "120130707"
            ]
          },
          "120130707": {
            "id": "120130707",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "Why were you so convinced that we had things to say to each other?",
            "nextDialogs": [
              "120130708"
            ]
          },
          "120130708": {
            "id": "120130708",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Because... Sakujirou may not have told me about you when he came back, but he did order a firework from me.",
            "nextDialogs": [
              "120130709"
            ]
          },
          "120130709": {
            "id": "120130709",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Then, your parents told me what happened between you when you were younger. Once I'd heard the story, I realized that the firework meant something special to you both.",
            "nextDialogs": [
              "120130710"
            ]
          },
          "120130710": {
            "id": "120130710",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "And that's why I simply refuse to believe that you have nothing to say to each other!",
            "nextDialogs": [
              "120130711"
            ]
          },
          "120130711": {
            "id": "120130711",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Nobody sets off a firework to feel lonely, do they...",
            "nextDialogs": [
              "120130712"
            ]
          },
          "120130712": {
            "id": "120130712",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "...",
            "nextDialogs": [
              "120130713"
            ]
          },
          "120130713": {
            "id": "120130713",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "The reason I came back is that... I felt lost.",
            "nextDialogs": [
              "120130714"
            ]
          },
          "120130714": {
            "id": "120130714",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "It wasn't that I'd changed my mind, I just felt that what I'd done in the past was to try to escape from reality.",
            "nextDialogs": [
              "120130715"
            ]
          },
          "120130715": {
            "id": "120130715",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "I saw the freedom of Mondstadt, the contracts of Liyue, the wisdom of Sumeru, and the justice of Fontaine... It all left a deep impression on me.",
            "nextDialogs": [
              "120130716"
            ]
          },
          "120130716": {
            "id": "120130716",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "I was glad that I'd left Inazuma. But then I happened to hear about the Sakoku Decree.",
            "nextDialogs": [
              "120130717"
            ]
          },
          "120130717": {
            "id": "120130717",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "I was an escapee, and I was proud of that. But really, what I should have tried to do is take the good things from the outside world and bring them back home.",
            "nextDialogs": [
              "120130718"
            ]
          },
          "120130718": {
            "id": "120130718",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "So that's why you came back? Out of your naive hope of changing the way things are here?",
            "nextDialogs": [
              "120130719"
            ]
          },
          "120130719": {
            "id": "120130719",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "No, I let go of those delusions of grandeur. I just felt that... I never should have run away like that...",
            "nextDialogs": [
              "120130720"
            ]
          },
          "120130720": {
            "id": "120130720",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "After all, you never ran away.",
            "nextDialogs": [
              "120130721"
            ]
          },
          "120130721": {
            "id": "120130721",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "...!",
            "nextDialogs": [
              "120130722"
            ]
          },
          "120130722": {
            "id": "120130722",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "I don't know about you, but life hasn't been easy for me.",
            "nextDialogs": [
              "120130723"
            ]
          },
          "120130723": {
            "id": "120130723",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "But I just had to come back and visit. It was like fate was calling me, and I couldn't ignore it any longer.",
            "nextDialogs": [
              "120130724"
            ]
          },
          "120130724": {
            "id": "120130724",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "...Life isn't easy for anyone.",
            "nextDialogs": [
              "120130725"
            ]
          },
          "120130725": {
            "id": "120130725",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "I truly worship the Raiden Shogun. Her ideas are my personal creed, and I desire nothing more than to see her will done.",
            "nextDialogs": [
              "120130726"
            ]
          },
          "120130726": {
            "id": "120130726",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "But now, my role is to punish violators of the Sakoku Decree and confiscate people's Visions. It's not what I signed up for when I joined the Tenryou Commission...",
            "nextDialogs": [
              "120130727"
            ]
          },
          "120130727": {
            "id": "120130727",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "I do wonder... Am I really doing the right thing?",
            "nextDialogs": [
              "120130728"
            ]
          },
          "120130728": {
            "id": "120130728",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "...",
            "nextDialogs": [
              "120130729"
            ]
          },
          "120130729": {
            "id": "120130729",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "...",
            "nextDialogs": [
              "120130730"
            ]
          },
          "120130730": {
            "id": "120130730",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "The boat is yours.",
            "nextDialogs": [
              "120130731"
            ]
          },
          "120130731": {
            "id": "120130731",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "Huh?",
            "nextDialogs": [
              "120130732"
            ]
          },
          "120130732": {
            "id": "120130732",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "I couldn't make you stay in Inazuma, but that doesn't mean I want to keep you here by force.",
            "nextDialogs": [
              "120130733"
            ]
          },
          "120130733": {
            "id": "120130733",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "What will you say to the higher-ups?",
            "nextDialogs": [
              "120130734"
            ]
          },
          "120130734": {
            "id": "120130734",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "Don't worry about that. I'll handle it.",
            "nextDialogs": [
              "120130735"
            ]
          },
          "120130735": {
            "id": "120130735",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "If you wanna come back, I hear that the process of returning to Inazuma from the outside world is long and complicated. But it can be done.",
            "nextDialogs": [
              "120130736"
            ]
          },
          "120130736": {
            "id": "120130736",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "I will lend you my help. But until then, wait for me out there.",
            "nextDialogs": [
              "120130737"
            ]
          },
          "120130737": {
            "id": "120130737",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "...And don't kick the bucket on the way out.",
            "nextDialogs": [
              "120130738"
            ]
          },
          "120130738": {
            "id": "120130738",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "Don't worry, Keisuke.",
            "nextDialogs": [
              "120130739"
            ]
          },
          "120130739": {
            "id": "120130739",
            "speakerId": 1006,
            "speakerName": "Sakujirou",
            "text": "Any chance we could watch the fireworks together?",
            "nextDialogs": [
              "120130740"
            ]
          },
          "120130740": {
            "id": "120130740",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "Mm. Maybe next time.",
            "nextDialogs": [
              "120130741"
            ]
          },
          "120130741": {
            "id": "120130741",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "*sigh* I'll be demoted for sure...",
            "nextDialogs": [
              "120130742"
            ]
          },
          "120130742": {
            "id": "120130742",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "It's not like me to give in to childish sentiment like this. I can't explain why I went through with it.",
            "nextDialogs": [
              "120130743"
            ]
          },
          "120130743": {
            "id": "120130743",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That boat...",
            "nextDialogs": [
              "120130744"
            ]
          },
          "120130744": {
            "id": "120130744",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "It's the one that Sakujirou planned on using for his escape. I asked Yoshitaka and the others to transport it here, citing the Temporary Contraband Storage clause.",
            "nextDialogs": [
              "120130745"
            ]
          },
          "120130745": {
            "id": "120130745",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "Forcing Sakujirou to this spot was also something I had planned all along.",
            "nextDialogs": [
              "120130746"
            ]
          },
          "120130746": {
            "id": "120130746",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "It's just like you said, Yoimiya. Even though I hadn't fully made up my mind, my actions betrayed my intent...",
            "nextDialogs": [
              "120130747"
            ]
          },
          "120130747": {
            "id": "120130747",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "But I think you did the right thing. And look, now you've managed to resolve the grievance in your heart by talking about it.",
            "nextDialogs": [
              "120130748"
            ]
          },
          "120130748": {
            "id": "120130748",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "I understand now, thank you. I didn't know you were quite so perceptive — you saw right into what I was thinking.",
            "nextDialogs": [
              "120130749"
            ]
          },
          "120130749": {
            "id": "120130749",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Hehe, that's only because I know your parents so well. They're both really nice people, so I didn't think the apple would fall too far from the tree.",
            "nextDialogs": [
              "120130750"
            ]
          },
          "120130750": {
            "id": "120130750",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "I had heard that there was a new Naganohara running things these days. A little loud and reckless, maybe but... You live up to the family name.",
            "nextDialogs": [
              "120130751"
            ]
          },
          "120130751": {
            "id": "120130751",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "By the way, Naganohara Fireworks can reproduce the firework that the two of us set off back then, right? Would you be able to make one for me?",
            "nextDialogs": [
              "120130752"
            ]
          },
          "120130752": {
            "id": "120130752",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Sorry, no can do. Without the slip for reference, I can't make the same one again, and I'm afraid Sakujirou is the one with the slip.",
            "nextDialogs": [
              "120130753"
            ]
          },
          "120130753": {
            "id": "120130753",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "Ah, I see...",
            "nextDialogs": [
              "120130754"
            ]
          },
          "120130754": {
            "id": "120130754",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "Never mind, then.",
            "nextDialogs": [
              "120130755"
            ]
          },
          "120130755": {
            "id": "120130755",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Hehe, don't get too down just yet, though — I mentioned that Sakujirou ordered a firework from me, didn't I?",
            "nextDialogs": [
              "120130756"
            ]
          },
          "120130756": {
            "id": "120130756",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "I can't make another one, but I'm guessing Sakujirou probably won't be needing his anymore... It'd be a shame for it to go to waste, so I'll make an exception and let you set it off instead.",
            "nextDialogs": [
              "120130757"
            ]
          },
          "120130757": {
            "id": "120130757",
            "speakerId": 1007,
            "speakerName": "Imatani Keisuke",
            "text": "...Thank you very much.",
            "nextDialogs": [
              "120130758"
            ]
          },
          "120130758": {
            "id": "120130758",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "No worries. And don't miss out on the start of the fireworks show.",
            "nextDialogs": [
              "120130759"
            ]
          },
          "120130759": {
            "id": "120130759",
            "speakerId": 1008,
            "speakerName": "Paimon",
            "text": "Yoimiya, the way you took command of that whole situation was amazing!",
            "nextDialogs": [
              "120130760"
            ]
          },
          "120130760": {
            "id": "120130760",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "What can I say — I like to talk. I'm a strong believer in the power of words.",
            "nextDialogs": [
              "120130761"
            ]
          },
          "120130761": {
            "id": "120130761",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "If you're not willing to communicate, then the problem just sits there. If you just keep staring at it without doing anything, eventually you'll watch every last opportunity to resolve it slip away before your eyes.",
            "nextDialogs": [
              "120130762"
            ]
          },
          "120130762": {
            "id": "120130762",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Sakujirou and Keisuke can't turn back the clock in their relationship, but... that's no reason to live with remorse.",
            "nextDialogs": [
              "120130763"
            ]
          },
          "120130763": {
            "id": "120130763",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Anyway, follow me. I'll bring you to the perfect place to watch the fireworks.",
            "nextDialogs": [
              "120130764"
            ]
          },
          "120130764": {
            "id": "120130764",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "My pops will set off the firework that I wanted to give to you."
          }
        }
      }
    },
    {
      "subId": "1201308",
      "subQuestName": "Go to a place to watch the Fireworks Show",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120130801"
        ],
        "dialogs": {
          "120130801": {
            "id": "120130801",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Ahh, that was amazing. It was so beautiful I could weep.",
            "nextDialogs": [
              "120130802"
            ]
          },
          "120130802": {
            "id": "120130802",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Uh, I didn't actually cry, though, right? I just feel a bit misty-eyed.",
            "nextDialogs": [
              "120130805"
            ]
          },
          "120130805": {
            "id": "120130805",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Oh, remember that big one that went up first? The gold one?",
            "nextDialogs": [
              "120130806"
            ]
          },
          "120130806": {
            "id": "120130806",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "That's the one I had pops make for you.",
            "nextDialogs": [
              "120130807"
            ]
          },
          "120130807": {
            "id": "120130807",
            "speakerId": 1008,
            "speakerName": "Paimon",
            "text": "Oh, Paimon saw it! It was one of the best ones, they won't forget that any time soon!",
            "nextDialogs": [
              "120130808"
            ]
          },
          "120130808": {
            "id": "120130808",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Haha, that's what I wanted to hear. I was hoping it would leave a deep impression on you guys.",
            "nextDialogs": [
              "120130809"
            ]
          },
          "120130809": {
            "id": "120130809",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "No matter where your journey takes you, and no matter what hardships might lie ahead, I hope you'll always be able to look back fondly on the fireworks you saw tonight.",
            "nextDialogs": [
              "120130810"
            ]
          },
          "120130810": {
            "id": "120130810",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "I believe that as time goes by, this firework will only grow brighter and more beautiful in your heart.",
            "nextDialogs": [
              "120130811"
            ]
          },
          "120130811": {
            "id": "120130811",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Oh, and also, you're technically my customers now. Here, this is your paper slip. If you ever wanna see that golden firework again, just come and see me."
          }
        }
      }
    },
    {
      "subId": "1201309",
      "subQuestName": "Talk to Yoimiya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1201209",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120120901"
        ],
        "dialogs": {
          "120120901": {
            "id": "120120901",
            "speakerId": 1009,
            "speakerName": "Imatani Saburou",
            "text": "I'm sorry that we weren't much help.",
            "nextDialogs": [
              "120120902"
            ]
          },
          "120120902": {
            "id": "120120902",
            "speakerId": 1010,
            "speakerName": "Imatani Kaori",
            "text": "One day, though, that child is going to have to face up to his feelings.",
            "nextDialogs": [
              "120120903"
            ]
          },
          "120120903": {
            "id": "120120903",
            "speakerId": 1010,
            "speakerName": "Imatani Kaori",
            "text": "This is one life lesson that he can't learn from his parents."
          }
        }
      }
    },
    {
      "subId": "1201309",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120130901"
        ],
        "dialogs": {
          "120130901": {
            "id": "120130901",
            "speakerId": 1011,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "Things aren't boding well for Sakujirou.",
            "nextDialogs": [
              "120130902"
            ]
          },
          "120130902": {
            "id": "120130902",
            "speakerId": 1011,
            "speakerName": "Naganohara Ryuunosuke",
            "text": "If only there was something we could do..."
          }
        }
      }
    },
    {
      "subId": "1201399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120139901"
        ],
        "dialogs": {
          "120139901": {
            "id": "120139901",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "It's Matsuzaka and his friends! Let's ask them!",
            "nextDialogs": [
              "120139902"
            ]
          },
          "120139902": {
            "id": "120139902",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "It looks like this is the right way. Let's keep going!",
            "nextDialogs": [
              "120139903"
            ]
          },
          "120139903": {
            "id": "120139903",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "If Sakujirou still hasn't made up his mind, I guess I'll have to step in...",
            "nextDialogs": [
              "120139904"
            ]
          },
          "120139904": {
            "id": "120139904",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Look, there are people from the Tenryou Commission over there! That must be them."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "1201310",
      "subQuestName": "Follow the road out of the city to look for clues",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120131001"
        ],
        "dialogs": {
          "120131001": {
            "id": "120131001",
            "speakerId": 1000,
            "speakerName": "Morihiko",
            "text": "...Be careful.",
            "nextDialogs": [
              "120131002"
            ]
          },
          "120131002": {
            "id": "120131002",
            "speakerId": 1000,
            "speakerName": "Morihiko",
            "text": "This is the Tenryou Commission we're talking about. Please, don't do anything you might live to regret."
          }
        }
      }
    },
    {
      "subId": "1201301",
      "subQuestName": "Talk with the children",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120130101"
        ],
        "dialogs": {
          "120130101": {
            "id": "120130101",
            "speakerId": 1001,
            "speakerName": "Matsuzaka",
            "text": "Hi, Yoimiya! Are the weapons to scare away the Great Mujina Youkai ready yet?",
            "nextDialogs": [
              "120130102"
            ]
          },
          "120130102": {
            "id": "120130102",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Oh, Mr. Ryuunosuke is making them right now. You can go collect them from my house later.",
            "nextDialogs": [
              "120130103"
            ]
          },
          "120130103": {
            "id": "120130103",
            "speakerId": 1003,
            "speakerName": "Saika",
            "text": "Uh... Aren't you gonna play with us, Yoimiya?",
            "nextDialogs": [
              "120130104"
            ]
          },
          "120130104": {
            "id": "120130104",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "I'm sorry, I have something important to do right now. I'll be back later on.",
            "nextDialogs": [
              "120130105"
            ]
          },
          "120130105": {
            "id": "120130105",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "...But I'll bring you guys some candy next time! The extra-sweet candy, the one you guys love.",
            "nextDialogs": [
              "120130106"
            ]
          },
          "120130106": {
            "id": "120130106",
            "speakerId": 1004,
            "speakerName": "Iwao",
            "text": "Yay-ay! We're gonna get candy, woohoo.",
            "nextDialogs": [
              "120130107"
            ]
          },
          "120130107": {
            "id": "120130107",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Also, I wanted to ask you guys something. Did you see a bunch of scary-looking men come by here, at all?",
            "nextDialogs": [
              "120130108"
            ]
          },
          "120130108": {
            "id": "120130108",
            "speakerId": 1003,
            "speakerName": "Saika",
            "text": "Yep, we did! It looked like they were chasing someone!",
            "nextDialogs": [
              "120130109"
            ]
          },
          "120130109": {
            "id": "120130109",
            "speakerId": 1004,
            "speakerName": "Iwao",
            "text": "Are they trying to catch a monster, too?",
            "nextDialogs": [
              "120130110"
            ]
          },
          "120130110": {
            "id": "120130110",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "No, don't worry. It's all just a big misunderstanding.",
            "nextDialogs": [
              "120130111"
            ]
          },
          "120130111": {
            "id": "120130111",
            "speakerId": 1002,
            "speakerName": "Yoimiya",
            "text": "Be good kids and stay out of trouble, alright? Stay in the city for now, and I'll come play with you after the fireworks start.",
            "nextDialogs": [
              "120130112"
            ]
          },
          "120130112": {
            "id": "120130112",
            "speakerId": 1001,
            "speakerName": "Matsuzaka",
            "text": "We will! We'll be on our best behavior, especially for you, Yoimiya!"
          }
        }
      }
    },
    {
      "subId": "1201311",

  "subQuests": [
    {
      "subId": "2301201",
      "subQuestName": "Talk to Sareh",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230121101"
        ],
        "dialogs": {
          "230121101": {
            "id": "230121101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well, I've spoken to cats before...",
            "nextDialogs": [
              "230121102"
            ]
          },
          "230121102": {
            "id": "230121102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You mean Neko? But she can speak our language. That doesn't really count as \"cat-talk\"...",
            "nextDialogs": [
              "230121103"
            ]
          },
          "230121103": {
            "id": "230121103",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Indeed. Still, in exchange, you will need to help me find a cat.",
            "nextDialogs": [
              "230121108",
              "230121106"
            ]
          },
          "230121108": {
            "id": "230121108",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "So you agree? Why, thank you so much!",
            "nextDialogs": [
              "230121109"
            ]
          },
          "230121109": {
            "id": "230121109",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Ahem... Now, listen carefully. This is the outline of cat language that I've been working on for a long time."
          },
          "230121106": {
            "id": "230121106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Heh, that's true! If you think about it, we've helped people find cats in quite a few cities by now...",
            "nextDialogs": [
              "230121107"
            ]
          },
          "230121107": {
            "id": "230121107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Should we say that everyone just loves cats, or that everyone who owns a cat has the same problem?"
          }
        }
      }
    },
    {
      "subId": "2301209",
      "subQuestName": "Confirm the cat's message with Sareh",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230121901"
        ],
        "dialogs": {
          "230121901": {
            "id": "230121901",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Thank you very much, Traveler. I'll be waiting for you here.",
            "nextDialogs": [
              "230121902"
            ]
          },
          "230121902": {
            "id": "230121902",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "I hope that your talk with the cat goes well."
          }
        }
      }
    },
    {
      "subId": "2301206",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230121501"
        ],
        "dialogs": {
          "230121501": {
            "id": "230121501",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "The one that has slipped out today is a black and white cat called \"Lale.\"",
            "nextDialogs": [
              "230121502"
            ]
          },
          "230121502": {
            "id": "230121502",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "In cat language, you should call for it like this... \"Meow, meow meow meow, meeeeow!\"",
            "nextDialogs": [
              "230121503"
            ]
          },
          "230121503": {
            "id": "230121503",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Keep in mind how the tone falls and then rises again. Make sure that the last \"meow\" is very high.",
            "nextDialogs": [
              "230121504"
            ]
          },
          "230121504": {
            "id": "230121504",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Hmm... Let me write a note for you. Please wait just a moment."
          }
        }
      }
    },
    {
      "subId": "2301207",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230121601"
        ],
        "dialogs": {
          "230121601": {
            "id": "230121601",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "The one that has slipped out for snacks today is a dark gray cat called \"Nargis.\"",
            "nextDialogs": [
              "230121602"
            ]
          },
          "230121602": {
            "id": "230121602",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "In cat language, you should call for it like this... \"Meow! Meow meow, meow.\"",
            "nextDialogs": [
              "230121603"
            ]
          },
          "230121603": {
            "id": "230121603",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Remember to stress the first meow and say the following ones quickly.",
            "nextDialogs": [
              "230121604"
            ]
          },
          "230121604": {
            "id": "230121604",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Hmm... Let me write a note for you. Wait just a moment."
          }
        }
      }
    },
    {
      "subId": "2301208",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230121701"
        ],
        "dialogs": {
          "230121701": {
            "id": "230121701",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "The one that has slipped out for a date today is a gray and black striped cat called \"Rozan.\"",
            "nextDialogs": [
              "230121702"
            ]
          },
          "230121702": {
            "id": "230121702",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "In cat language, you would call for it by saying... \"Meow meow meow, meow meow meow.\"",
            "nextDialogs": [
              "230121703"
            ]
          },
          "230121703": {
            "id": "230121703",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Both sets of meows are quick sounds, so make sure you don't drawl.",
            "nextDialogs": [
              "230121704"
            ]
          },
          "230121704": {
            "id": "230121704",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Actually... Let me write a note for you. Wait just a moment, will you?"
          }
        }
      }
    },
    {
      "subId": "2301202",
      "subQuestName": "Search for Lale",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230122101"
        ],
        "dialogs": {
          "230122101": {
            "id": "230122101",
            "speakerId": 12679,
            "speakerName": "Lale",
            "text": "Meow... meow meow?",
            "nextDialogs": [
              "230122102"
            ]
          },
          "230122102": {
            "id": "230122102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#It's your turn to meow, {NICKNAME}! Come on, you can do it!",
            "nextDialogs": [
              "230122104",
              "230122108",
              "230122112"
            ]
          },
          "230122104": {
            "id": "230122104",
            "speakerId": 12679,
            "speakerName": "Lale",
            "text": "Meow, meow meow, meow meow meow.",
            "nextDialogs": [
              "230122105"
            ]
          },
          "230122105": {
            "id": "230122105",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Lale jumps into your arms.",
            "nextDialogs": [
              "230122106"
            ]
          },
          "230122106": {
            "id": "230122106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow! That was quick! Looks like it worked..."
          },
          "230122108": {
            "id": "230122108",
            "speakerId": 12679,
            "speakerName": "Lale",
            "text": "Meow? Meow? Meow? Meow!",
            "nextDialogs": [
              "230122109"
            ]
          },
          "230122109": {
            "id": "230122109",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Lale turns around and runs away.",
            "nextDialogs": [
              "230122110"
            ]
          },
          "230122110": {
            "id": "230122110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It doesn't sound happy... Did you pronounce its name wrongly?"
          },
          "230122112": {
            "id": "230122112",
            "speakerId": 12679,
            "speakerName": "Lale",
            "text": "Meow? Meow? Meow? Meow!",
            "nextDialogs": [
              "230122113"
            ]
          },
          "230122113": {
            "id": "230122113",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Lale turns around and runs away.",
            "nextDialogs": [
              "230122114"
            ]
          },
          "230122114": {
            "id": "230122114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It doesn't sound happy... Did you pronounce its name wrongly?"
          }
        }
      }
    },
    {
      "subId": "2301203",
      "subQuestName": "Search for Nargis",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230122201"
        ],
        "dialogs": {
          "230122201": {
            "id": "230122201",
            "speakerId": 12719,
            "speakerName": "Nargis",
            "text": "Meow... meow... meow meow...",
            "nextDialogs": [
              "230122202"
            ]
          },
          "230122202": {
            "id": "230122202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#It's your turn to meow, {NICKNAME}! Come on, you can do it!",
            "nextDialogs": [
              "230122208",
              "230122204",
              "230122212"
            ]
          },
          "230122208": {
            "id": "230122208",
            "speakerId": 12719,
            "speakerName": "Nargis",
            "text": "Meow? Meow meow meow...",
            "nextDialogs": [
              "230122209"
            ]
          },
          "230122209": {
            "id": "230122209",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Nargis turns around and jumps into a pile of things nearby...",
            "nextDialogs": [
              "230122210"
            ]
          },
          "230122210": {
            "id": "230122210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? Why did it leave? Did you pronounce its name wrong?"
          },
          "230122204": {
            "id": "230122204",
            "speakerId": 12719,
            "speakerName": "Nargis",
            "text": "Meow! meow meow meow—",
            "nextDialogs": [
              "230122205"
            ]
          },
          "230122205": {
            "id": "230122205",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Nargis jumps on your shoulder and... Wow, it sure is heavy!",
            "nextDialogs": [
              "230122206"
            ]
          },
          "230122206": {
            "id": "230122206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This cat's pretty agile for a glutton..."
          },
          "230122212": {
            "id": "230122212",
            "speakerId": 12719,
            "speakerName": "Nargis",
            "text": "Meow? Meow meow meow...",
            "nextDialogs": [
              "230122213"
            ]
          },
          "230122213": {
            "id": "230122213",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Nargis turns around and jumps into a pile of things nearby...",
            "nextDialogs": [
              "230122214"
            ]
          },
          "230122214": {
            "id": "230122214",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? Why did it leave? Did you pronounce its name wrong?"
          }
        }
      }
    },
    {
      "subId": "2301204",
      "subQuestName": "Search for Rozan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230122301"
        ],
        "dialogs": {
          "230122301": {
            "id": "230122301",
            "speakerId": 12720,
            "speakerName": "Rozan",
            "text": "Meow?",
            "nextDialogs": [
              "230122302"
            ]
          },
          "230122302": {
            "id": "230122302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#It's your turn to meow, {NICKNAME}! Come on, you can do it!",
            "nextDialogs": [
              "230122304",
              "230122311",
              "230122318"
            ]
          },
          "230122304": {
            "id": "230122304",
            "speakerId": 12720,
            "speakerName": "Rozan",
            "text": "Meow... Meow meow, meow.",
            "nextDialogs": [
              "230122305"
            ]
          },
          "230122305": {
            "id": "230122305",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Rozan shakes its head indifferently and leaves...",
            "nextDialogs": [
              "230122306"
            ]
          },
          "230122306": {
            "id": "230122306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Why did the kitty leave?",
            "nextDialogs": [
              "230122307"
            ]
          },
          "230122307": {
            "id": "230122307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did I pronounce something wrong?",
            "nextDialogs": [
              "230122308"
            ]
          },
          "230122308": {
            "id": "230122308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Does it mean \"I'm not the cat you're looking for\"?",
            "nextDialogs": [
              "230122309"
            ]
          },
          "230122309": {
            "id": "230122309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This cat sure does have a personality..."
          },
          "230122311": {
            "id": "230122311",
            "speakerId": 12720,
            "speakerName": "Rozan",
            "text": "Meow... Meow meow, meow.",
            "nextDialogs": [
              "230122312"
            ]
          },
          "230122312": {
            "id": "230122312",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Rozan shakes its head indifferently and leaves...",
            "nextDialogs": [
              "230122313"
            ]
          },
          "230122313": {
            "id": "230122313",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Why did the kitty leave?",
            "nextDialogs": [
              "230122314"
            ]
          },
          "230122314": {
            "id": "230122314",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did I pronounce something wrong?",
            "nextDialogs": [
              "230122315"
            ]
          },
          "230122315": {
            "id": "230122315",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Does it mean \"I'm not the cat you're looking for\"?",
            "nextDialogs": [
              "230122316"
            ]
          },
          "230122316": {
            "id": "230122316",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This cat sure does have a personality..."
          },
          "230122318": {
            "id": "230122318",
            "speakerId": 12720,
            "speakerName": "Rozan",
            "text": "Meow, meow meow.",
            "nextDialogs": [
              "230122319"
            ]
          },
          "230122319": {
            "id": "230122319",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Rozan nods gently...",
            "nextDialogs": [
              "230122320"
            ]
          },
          "230122320": {
            "id": "230122320",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So... it's willing to go with us?",
            "nextDialogs": [
              "230122321"
            ]
          },
          "230122321": {
            "id": "230122321",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What a polite cat..."
          }
        }
      }
    },
    {
      "subId": "2301205",
      "subQuestName": "Report back to Sareh",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230120301"
        ],
        "dialogs": {
          "230120301": {
            "id": "230120301",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Oh, you brought the kitten back. Thank you so much.",
            "nextDialogs": [
              "230120302"
            ]
          },
          "230120302": {
            "id": "230120302",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Well, it looks like you are doing pretty well with cat-talk.",
            "nextDialogs": [
              "230120303"
            ]
          },
          "230120303": {
            "id": "230120303",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Here, please take this as compensation.",
            "nextDialogs": [
              "230120304"
            ]
          },
          "230120304": {
            "id": "230120304",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "There aren't many people who can pick up cat language this fast. You know... I could even use your help in the future.",
            "nextDialogs": [
              "230120305"
            ]
          },
          "230120305": {
            "id": "230120305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Meow!",
            "nextDialogs": [
              "230120306"
            ]
          },
          "230120306": {
            "id": "230120306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, you can speak normally. Ms. Sareh is not a cat!",
            "nextDialogs": [
              "230120307"
            ]
          },
          "230120307": {
            "id": "230120307",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "I can see from your face that you were trying to say \"my pleasure,\" but your pronunciation still has room for improvement, I think.",
            "nextDialogs": [
              "230120308"
            ]
          },
          "230120308": {
            "id": "230120308",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "It's okay though. I'll keep teaching you about cat language. We'll learn together!"
          }
        }
      }
    },
    {
      "subId": "2301201",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230120101"
        ],
        "dialogs": {
          "230120101": {
            "id": "230120101",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Meow— *cough*...",
            "nextDialogs": [
              "230120102"
            ]
          },
          "230120102": {
            "id": "230120102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Uh, what are you doing...?",
            "nextDialogs": [
              "230120103"
            ]
          },
          "230120103": {
            "id": "230120103",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "I'm looking for my kittens. Normally, they respond to my call.",
            "nextDialogs": [
              "230120104"
            ]
          },
          "230120104": {
            "id": "230120104",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Is my pronunciation off today somehow? I've been calling them for ages, and none of them have answered. How strange...",
            "nextDialogs": [
              "230120106",
              "230120110"
            ]
          },
          "230120106": {
            "id": "230120106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah. Don't people usually call kittens' names when looking for them, right?",
            "nextDialogs": [
              "230120107"
            ]
          },
          "230120107": {
            "id": "230120107",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "But if you call for them in our language, they can't understand it, can they?",
            "nextDialogs": [
              "230120108"
            ]
          },
          "230120108": {
            "id": "230120108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? Well, you do have a point there...",
            "nextDialogs": [
              "230120113"
            ]
          },
          "230120113": {
            "id": "230120113",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Still, I'm getting nowhere shouting myself hoarse like this.",
            "nextDialogs": [
              "230120114"
            ]
          },
          "230120114": {
            "id": "230120114",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Traveler, I'd like to ask you a serious question."
          },
          "230120110": {
            "id": "230120110",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Well, I was calling their names, actually, just in the language of cats.",
            "nextDialogs": [
              "230120111"
            ]
          },
          "230120111": {
            "id": "230120111",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "After all, they wouldn't necessarily understand if we called them in our language, right?",
            "nextDialogs": [
              "230120112"
            ]
          },
          "230120112": {
            "id": "230120112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? Well, you do have a point there..."
          }
        }
      }
    },
    {
      "subId": "2301212",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230121201"
        ],
        "dialogs": {
          "230121201": {
            "id": "230121201",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Indeed. But in exchange, you need to help me find a cat.",
            "nextDialogs": [
              "230121206",
              "230121204"
            ]
          },
          "230121206": {
            "id": "230121206",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "So you agree? Why, thank you so much!",
            "nextDialogs": [
              "230121207"
            ]
          },
          "230121207": {
            "id": "230121207",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Ahem... Now, listen carefully. This is the outline of cat language that I've been working on for a long time."
          },
          "230121204": {
            "id": "230121204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Heh, that's true! If you think about it, we've helped people find cats in quite a few cities by now...",
            "nextDialogs": [
              "230121205"
            ]
          },
          "230121205": {
            "id": "230121205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Should we say that everyone just loves cats, or that everyone who owns a cat has the same problem?"
          }
        }
      }
    },
    {
      "subId": "2301231",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230123101"
        ],
        "dialogs": {
          "230123101": {
            "id": "230123101",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Eh? You didn't find the cat?",
            "nextDialogs": [
              "230123102"
            ]
          },
          "230123102": {
            "id": "230123102",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You tell Sareh what happened...",
            "nextDialogs": [
              "230123103"
            ]
          },
          "230123103": {
            "id": "230123103",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Is that so? Well, it's okay. Cat language is not easy for beginners, after all.",
            "nextDialogs": [
              "230123104"
            ]
          },
          "230123104": {
            "id": "230123104",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "I'll go find them myself later. Still, thank you for the trouble. Please take these as your payment, Traveler."
          }
        }
      }
    },
    {
      "subId": "2301250",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230125001"
        ],
        "dialogs": {
          "230125001": {
            "id": "230125001",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Do you have any further questions, Traveler?",
            "nextDialogs": [
              "230125003",
              "230125005"
            ]
          },
          "230125003": {
            "id": "230125003",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "That's on the note I wrote for you. Please refer to it if your memory fails you."
          },
          "230125005": {
            "id": "230125005",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "Well, people in town love the cats. They often play with them and feed them.",
            "nextDialogs": [
              "230125006"
            ]
          },
          "230125006": {
            "id": "230125006",
            "speakerId": 4136,
            "speakerName": "Sareh",
            "text": "I'm just hoping that they don't eat too much and get overweight."
          }
        }
      }
    }
  ]
}
            "id": "761680101",
            "speakerId": 7618,
            "speakerName": "Lantainen",
            "text": "Ugh... Nothing fuels me for patrol like a warm, delicious loaf of bread...",
            "nextDialogs": [
              "761680102"
            ]
          },
          "761680102": {
            "id": "761680102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing here?",
            "nextDialogs": [
              "761680103"
            ]
          },
          "761680103": {
            "id": "761680103",
            "speakerId": 7618,
            "speakerName": "Lantainen",
            "text": "I'm getting supplies needed for patrol, but it looks like we're out of stock on my favorite, the Mushroom Phantasm.",
            "nextDialogs": [
              "761680104"
            ]
          },
          "761680104": {
            "id": "761680104",
            "speakerId": 7618,
            "speakerName": "Lantainen",
            "text": "It's a new bread Ms. Beryna came up with. Everyone loves it so much that there's never any left in stock.",
            "nextDialogs": [
              "761680105"
            ]
          },
          "761680105": {
            "id": "761680105",
            "speakerId": 7618,
            "speakerName": "Lantainen",
            "text": "*sigh* Just thinking about not getting any Mushroom Phantasm drains all my motivation...",
            "nextDialogs": [
              "761680106"
            ]
          },
          "761680106": {
            "id": "761680106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I think I know how to make them.",
            "nextDialogs": [
              "761680107"
            ]
          },
          "761680107": {
            "id": "761680107",
            "speakerId": 7618,
            "speakerName": "Lantainen",
            "text": "Really? That's awesome, my friend!",
            "nextDialogs": [
              "761680108"
            ]
          },
          "761680108": {
            "id": "761680108",
            "speakerId": 7618,
            "speakerName": "Lantainen",
            "text": "If that's the case, could you make some Mushroom Phantasm for me? Don't worry, I won't let you work for nothing."
          }
        }
      }
    },

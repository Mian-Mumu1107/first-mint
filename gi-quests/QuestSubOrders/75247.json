  "subQuests": [
    {
      "subId": "7524701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752470101"
        ],
        "dialogs": {
          "752470101": {
            "id": "752470101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "This should be the place from the picture. Look, Ororon and Ifa are here!",
            "nextDialogs": [
              "752470102"
            ]
          },
          "752470102": {
            "id": "752470102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hello!",
            "nextDialogs": [
              "752470103"
            ]
          },
          "752470103": {
            "id": "752470103",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Ah, now that sounds like a happy Paimon. Great! No need to be on guard then.",
            "nextDialogs": [
              "752470104"
            ]
          },
          "752470104": {
            "id": "752470104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Please, even an \"angry Paimon\" is harmless.",
            "nextDialogs": [
              "752470105"
            ]
          },
          "752470105": {
            "id": "752470105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh! Watch it, buddy!",
            "nextDialogs": [
              "752470106"
            ]
          },
          "752470106": {
            "id": "752470106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "All you gotta do is give her a treat.",
            "nextDialogs": [
              "752470107"
            ]
          },
          "752470107": {
            "id": "752470107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey! Paimon's not Cacucu! You can't just give her a cracker and call it a day...! Okay, maybe that would help...",
            "nextDialogs": [
              "752470108"
            ]
          },
          "752470108": {
            "id": "752470108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But, y'know what? It doesn't matter! Paimon's in a good mood today, and you're not gonna tease her out of it!",
            "nextDialogs": [
              "752470109"
            ]
          },
          "752470109": {
            "id": "752470109",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hold on, speaking of Cacucu... Where is he? Don't tell Paimon the Capybara King gobbled him up?",
            "nextDialogs": [
              "752470110"
            ]
          },
          "752470110": {
            "id": "752470110",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "What? Do you even hear yourself, bro?",
            "nextDialogs": [
              "752470111"
            ]
          },
          "752470111": {
            "id": "752470111",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Cacucu has joined hands with the enemy to bully us.",
            "nextDialogs": [
              "752470112"
            ]
          },
          "752470112": {
            "id": "752470112",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Bully you? Cacucu? Hahaha, good one, Ororon...",
            "nextDialogs": [
              "752470113"
            ]
          },
          "752470113": {
            "id": "752470113",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "That wasn't meant to be a joke.",
            "nextDialogs": [
              "752470114"
            ]
          },
          "752470114": {
            "id": "752470114",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh?",
            "nextDialogs": [
              "752470115"
            ]
          },
          "752470115": {
            "id": "752470115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Then, this so-called \"enemy\" is...?",
            "nextDialogs": [
              "752470116"
            ]
          },
          "752470116": {
            "id": "752470116",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "He said his name was \"Cacasha.\"",
            "nextDialogs": [
              "752470117"
            ]
          },
          "752470117": {
            "id": "752470117",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, so does that mean he's an Asha? An Asha that can talk?",
            "nextDialogs": [
              "752470118"
            ]
          },
          "752470118": {
            "id": "752470118",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Whoa, hold up. Ororon is... embellishing. Let me explain.",
            "nextDialogs": [
              "752470119"
            ]
          },
          "752470119": {
            "id": "752470119",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Cacucu is, uh... playing hide-and-seek around here with an Asha.",
            "nextDialogs": [
              "752470120"
            ]
          },
          "752470120": {
            "id": "752470120",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "And by that, we mean that they're allied against us.",
            "nextDialogs": [
              "752470121"
            ]
          },
          "752470121": {
            "id": "752470121",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Cacucu is fast, and Cacasha can disguise himself... So, we face a crafty enemy indeed.",
            "nextDialogs": [
              "752470122"
            ]
          },
          "752470122": {
            "id": "752470122",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "We played round after round with the little guys before you showed up.",
            "nextDialogs": [
              "752470123"
            ]
          },
          "752470123": {
            "id": "752470123",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "And, listen, Cacucu is a beast at this game. Am I proud of him? Yeah. But man, I am getting worn out...",
            "nextDialogs": [
              "752470124"
            ]
          },
          "752470124": {
            "id": "752470124",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "It's your own fault for not going to Coach Iansan's fitness class.",
            "nextDialogs": [
              "752470125"
            ]
          },
          "752470125": {
            "id": "752470125",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "*sigh* Seriously, having to search up and down for these little guys, round after round... My back's killing me!",
            "nextDialogs": [
              "752470126"
            ]
          },
          "752470126": {
            "id": "752470126",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Of course it is. Because you didn't go to Coach Iansan's fitness class.",
            "nextDialogs": [
              "752470127"
            ]
          },
          "752470127": {
            "id": "752470127",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "...Alright, alright. I get the picture! I'll go when we get back. Happy?",
            "nextDialogs": [
              "752470128"
            ]
          },
          "752470128": {
            "id": "752470128",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, shouldn't you do a little more seeking right about now? Who's gonna track down Cacucu and Cacasha if you keep bickering like this?",
            "nextDialogs": [
              "752470129"
            ]
          },
          "752470129": {
            "id": "752470129",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Ah, well, that brings us to the perfectly good lemon that just fell right into our lap...",
            "nextDialogs": [
              "752470130"
            ]
          },
          "752470130": {
            "id": "752470130",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Me... again?",
            "nextDialogs": [
              "752470131"
            ]
          },
          "752470131": {
            "id": "752470131",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Mm-hmm.",
            "nextDialogs": [
              "752470132"
            ]
          },
          "752470132": {
            "id": "752470132",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Fine. I'll go.",
            "nextDialogs": [
              "752470133"
            ]
          },
          "752470133": {
            "id": "752470133",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "#You got this, {M#Gramps}{F#other Granny}! Oh, and you too, Granny Paimon!",
            "nextDialogs": [
              "752470134"
            ]
          },
          "752470134": {
            "id": "752470134",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Just have fun, and call us if you need help.",
            "nextDialogs": [
              "752470135"
            ]
          },
          "752470135": {
            "id": "752470135",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Wait, I thought we were gonna be Ashas as well?",
            "nextDialogs": [
              "752470136"
            ]
          },
          "752470136": {
            "id": "752470136",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh no... Please don't tell Paimon you're gonna hide with them and force us to find you too?",
            "nextDialogs": [
              "752470137"
            ]
          },
          "752470137": {
            "id": "752470137",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "That's right! From now on, I'm \"Orasha,\" and he's \"Ifasha.\" Gotta go hide. Good luck!",
            "nextDialogs": [
              "752470138"
            ]
          },
          "752470138": {
            "id": "752470138",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Bro! What the...! Gah...",
            "nextDialogs": [
              "752470139"
            ]
          },
          "752470139": {
            "id": "752470139",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Sorry, guys. Mind humoring him for a bit?",
            "nextDialogs": [
              "752470142"
            ]
          },
          "752470142": {
            "id": "752470142",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Thanks, you two! Guess that means I should get hiding!"
          }
        }
      }
    },
    {
      "subId": "7524702",

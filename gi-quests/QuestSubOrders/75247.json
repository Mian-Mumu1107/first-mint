    {
      "subId": "7524703",
      "subQuestName": "Rendezvous with everyone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752470301"
        ],
        "dialogs": {
          "752470301": {
            "id": "752470301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "*sigh*... We did it, finally! That was too much work.",
            "nextDialogs": [
              "752470302"
            ]
          },
          "752470302": {
            "id": "752470302",
            "speakerId": 1003,
            "speakerName": "Cacasha",
            "text": "♪",
            "nextDialogs": [
              "752470303"
            ]
          },
          "752470303": {
            "id": "752470303",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, you must be Cacasha! You and Cacucu make a really impressive duo! And, as part of a formidable duo herself, Paimon would know!",
            "nextDialogs": [
              "752470304"
            ]
          },
          "752470304": {
            "id": "752470304",
            "speakerId": 1004,
            "speakerName": "Cacucu",
            "text": "Impressive, bro!",
            "nextDialogs": [
              "752470305"
            ]
          },
          "752470305": {
            "id": "752470305",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "See what I mean? When those two join forces, it's almost impossible to beat them.",
            "nextDialogs": [
              "752470306"
            ]
          },
          "752470306": {
            "id": "752470306",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Cacucu, I can officially say you've earned your certificate in the \"art of concealment.\" From now on, you can call yourself a master trickster.",
            "nextDialogs": [
              "752470307"
            ]
          },
          "752470307": {
            "id": "752470307",
            "speakerId": 1004,
            "speakerName": "Cacucu",
            "text": "Oh, wow! You're the best, bro!",
            "nextDialogs": [
              "752470308"
            ]
          },
          "752470308": {
            "id": "752470308",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Hey, what about me? I was the one who played with you the most!",
            "nextDialogs": [
              "752470309"
            ]
          },
          "752470309": {
            "id": "752470309",
            "speakerId": 1004,
            "speakerName": "Cacucu",
            "text": "You're awesome, too, bro!",
            "nextDialogs": [
              "752470310"
            ]
          },
          "752470310": {
            "id": "752470310",
            "speakerId": 1003,
            "speakerName": "Cacasha",
            "text": "♪",
            "nextDialogs": [
              "752470311"
            ]
          },
          "752470311": {
            "id": "752470311",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Huh... I think he has something to give us...",
            "nextDialogs": [
              "752470312"
            ]
          },
          "752470312": {
            "id": "752470312",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "Cacasha presents a Gift Egg to the group...",
            "nextDialogs": [
              "752470313"
            ]
          },
          "752470313": {
            "id": "752470313",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Oh! Another Gift Egg, and another picture too. I think I've seen this symbol around the Easybreeze Market...",
            "nextDialogs": [
              "752470314"
            ]
          },
          "752470314": {
            "id": "752470314",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Bro... Why does it feel like we've got another challenge coming our way...?",
            "nextDialogs": [
              "752470315"
            ]
          },
          "752470315": {
            "id": "752470315",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Huh? Is this some kind of secret treasure hunt, hidden around the resort? I have to see it through!",
            "nextDialogs": [
              "752470316"
            ]
          },
          "752470316": {
            "id": "752470316",
            "speakerId": 1004,
            "speakerName": "Cacucu",
            "text": "See it through, bro!",
            "nextDialogs": [
              "752470317"
            ]
          },
          "752470317": {
            "id": "752470317",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Seems like Cacucu is having a blast.",
            "nextDialogs": [
              "752470318"
            ]
          },
          "752470318": {
            "id": "752470318",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Well, you can't have an adventure without {NICKNAME} and Paimon! Whaddaya say, wanna check it out?",
            "nextDialogs": [
              "752470319"
            ]
          },
          "752470319": {
            "id": "752470319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Definitely! Let's see it through!",
            "nextDialogs": [
              "752470320"
            ]
          },
          "752470320": {
            "id": "752470320",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Alright, guess I'm along for the ride, then."
          }
        }
      }
    },
    {
      "subId": "7524704",
      "subQuestName": "Head to Easybreeze Market",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752470401"
        ],
        "dialogs": {
          "752470401": {
            "id": "752470401",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Found it! We were right about the Easybreeze Market!",
            "nextDialogs": [
              "752470402"
            ]
          },
          "752470402": {
            "id": "752470402",
            "speakerId": 1004,
            "speakerName": "Cacucu",
            "text": "Easybreeze Market!!",
            "nextDialogs": [
              "752470403"
            ]
          },
          "752470403": {
            "id": "752470403",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Chill, bro. I know you're excited, but we've gotta get the lay of the land first.",
            "nextDialogs": [
              "752470404"
            ]
          },
          "752470404": {
            "id": "752470404",
            "speakerId": 1006,
            "speakerName": "Challwa",
            "text": "Ahem... Step on up, dear patrons! Pick an egg, any egg! Let this be your lucky day!",
            "nextDialogs": [
              "752470405"
            ]
          },
          "752470405": {
            "id": "752470405",
            "speakerId": 1006,
            "speakerName": "Challwa",
            "text": "Test 'em out free of charge! What do you say?",
            "nextDialogs": [
              "752470406"
            ]
          },
          "752470406": {
            "id": "752470406",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, so this is where the picture was leading us. This must be where the Gift Eggs come from.",
            "nextDialogs": [
              "752470407"
            ]
          },
          "752470407": {
            "id": "752470407",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, hehe... Let's see how far that lucky streak gets us!",
            "nextDialogs": [
              "752470408"
            ]
          },
          "752470408": {
            "id": "752470408",
            "speakerId": 1006,
            "speakerName": "Challwa",
            "text": "S—Step right up! The gift eggs are all set for the picking!",
            "nextDialogs": [
              "752470409"
            ]
          },
          "752470409": {
            "id": "752470409",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Hmm...",
            "nextDialogs": [
              "752470410"
            ]
          },
          "752470410": {
            "id": "752470410",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "You first.",
            "nextDialogs": [
              "752470411"
            ]
          },
          "752470411": {
            "id": "752470411",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Seriously, bro? Don't tell me you actually buy into the whole \"bad luck to go first\" thing? ...Fine, fine. Have it your way.",
            "nextDialogs": [
              "752470412"
            ]
          },
          "752470412": {
            "id": "752470412",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "By the luck of the Asha, gimme something good!",
            "nextDialogs": [
              "752470413"
            ]
          },
          "752470413": {
            "id": "752470413",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa, Saurus Crackers! Score!",
            "nextDialogs": [
              "752470414"
            ]
          },
          "752470414": {
            "id": "752470414",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Oh...",
            "nextDialogs": [
              "752470415"
            ]
          },
          "752470415": {
            "id": "752470415",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Pff...",
            "nextDialogs": [
              "752470416"
            ]
          },
          "752470416": {
            "id": "752470416",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You don't like Saurus Crackers, Ifa?",
            "nextDialogs": [
              "752470417"
            ]
          },
          "752470417": {
            "id": "752470417",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Oh, don't get me wrong, we both love 'em. But, when it comes to Gift Eggs, they're not exactly one of the better prizes.",
            "nextDialogs": [
              "752470418"
            ]
          },
          "752470418": {
            "id": "752470418",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Whatever, anything that tastes good is fine by me. Here, everyone can have some.",
            "nextDialogs": [
              "752470419"
            ]
          },
          "752470419": {
            "id": "752470419",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Make fun of me all you want, bro. Just wait until you get one of those weird Magma Eggs, and see if I help you then!",
            "nextDialogs": [
              "752470420"
            ]
          },
          "752470420": {
            "id": "752470420",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Impossible. You can never resist helping people.",
            "nextDialogs": [
              "752470421"
            ]
          },
          "752470421": {
            "id": "752470421",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Now... Is there a special ritual I should do before opening the egg?",
            "nextDialogs": [
              "752470422"
            ]
          },
          "752470422": {
            "id": "752470422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Whatever you think will bring you good luck, I guess.",
            "nextDialogs": [
              "752470423"
            ]
          },
          "752470423": {
            "id": "752470423",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Got it. \"Flower-Feather Clan Patrol Team — open up!\"",
            "nextDialogs": [
              "752470424"
            ]
          },
          "752470424": {
            "id": "752470424",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "?",
            "nextDialogs": [
              "752470425"
            ]
          },
          "752470425": {
            "id": "752470425",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa, it's the Flower-Feather Clan specialty, \"Sing Your Heart Out\"... Guess that ritual actually worked...",
            "nextDialogs": [
              "752470426"
            ]
          },
          "752470426": {
            "id": "752470426",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Nice! I'll take anything but Mystique Soup, honestly. I'm so tired of that stuff...",
            "nextDialogs": [
              "752470427"
            ]
          },
          "752470427": {
            "id": "752470427",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Guess I lucked out with this huge tub of candy! Dig in, everyone!",
            "nextDialogs": [
              "752470428"
            ]
          },
          "752470428": {
            "id": "752470428",
            "speakerId": 1004,
            "speakerName": "Cacucu",
            "text": "You're the best, bro!",
            "nextDialogs": [
              "752470429"
            ]
          },
          "752470429": {
            "id": "752470429",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "After making a meal of the Saurus Crackers, Cacucu crunches away at the candy.",
            "nextDialogs": [
              "752470430"
            ]
          },
          "752470430": {
            "id": "752470430",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "All the sugar gives everyone a bit of a rush..."
          }
        }
      }
    },
    {
      "subId": "7524750",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752475001"
        ],
        "dialogs": {
          "752475001": {
            "id": "752475001",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Well, are you happy, buddy? Did you have fun?",
            "nextDialogs": [
              "752475002"
            ]
          },
          "752475002": {
            "id": "752475002",
            "speakerId": 1004,
            "speakerName": "Cacucu",
            "text": "Oh wow, bro!",
            "nextDialogs": [
              "752475003"
            ]
          },
          "752475003": {
            "id": "752475003",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "I think that's a yes. Happy birthday, bro.",
            "nextDialogs": [
              "752475004"
            ]
          },
          "752475004": {
            "id": "752475004",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Oh, and that reminds me. Why didn't you tell me about the plan, bro? Seriously, bro, bros don't hide things from other bros, bro.",
            "nextDialogs": [
              "752475005"
            ]
          },
          "752475005": {
            "id": "752475005",
            "speakerId": 1002,
            "speakerName": "Ifa",
            "text": "Haha... To be honest, I wanted to see if you remembered the anniversary.",
            "nextDialogs": [
              "752475006"
            ]
          },
          "752475006": {
            "id": "752475006",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Psh... You've changed, Ifa. How am I supposed to trust you when you betray a bro like that?",
            "nextDialogs": [
              "752475007"
            ]
          },
          "752475007": {
            "id": "752475007",
            "speakerId": 1001,
            "speakerName": "Ororon",
            "text": "Heh... Well, jokes on you, because I did remember. I saved some fresh honey for Cacucu. I know the price of forgetting the anniversary, and I wasn't about to get pecked in the head for a whole year.",
            "nextDialogs": [
              "752475008"
            ]
          },
          "752475008": {
            "id": "752475008",
            "speakerId": 1004,
            "speakerName": "Cacucu",
            "text": "Wouldn't do that, bro! You're the best!"
          }
        }
      }
    },
    {
      "subId": "7524751",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

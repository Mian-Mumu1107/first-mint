        ],
        "dialogs": {
          "752475101": {
            "id": "752475101",
            "speakerId": 1004,
            "speakerName": "Cacucu",
            "text": "Hello again, bro!",
            "nextDialogs": [
              "752475102"
            ]
          },
          "752475102": {
            "id": "752475102",
            "speakerId": 1004,
            "speakerName": "Cacucu",
            "text": "Earlier, I was trying to tell Ifa that he got the date wrong.",
            "nextDialogs": [
              "752475103"
            ]
          },
          "752475103": {
            "id": "752475103",
            "speakerId": 1004,
            "speakerName": "Cacucu",
            "text": "But, I stopped myself. I guess part of being mature is knowing when it's better to let things go."
          }
        }
      }
    },

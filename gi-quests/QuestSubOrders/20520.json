        ],
        "dialogs": {
          "205200801": {
            "id": "205200801",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "This warmth... I—It must be... R—Radish Veggie Soup!",
            "nextDialogs": [
              "205200802"
            ]
          },
          "205200802": {
            "id": "205200802",

  "subQuests": [
    {
      "subId": "2052001",
      "subQuestName": "Talk to Tommy",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205200101"
        ],
        "dialogs": {
          "205200101": {
            "id": "205200101",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "T—Traveler... Could... could you h—help me...",
            "nextDialogs": [
              "205200102"
            ]
          },
          "205200102": {
            "id": "205200102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong with you...",
            "nextDialogs": [
              "205200103"
            ]
          },
          "205200103": {
            "id": "205200103",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "P—Please... I—I need some warmth... It's... t—too cold...",
            "nextDialogs": [
              "205200104"
            ]
          },
          "205200104": {
            "id": "205200104",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "O—Or maybe... s—some hot food might also be g—good.",
            "nextDialogs": [
              "205200105"
            ]
          },
          "205200105": {
            "id": "205200105",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "P—Please... I'm just... too c—cold..."
          }
        }
      }
    },
    {
      "subId": "2052002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205200201"
        ],
        "dialogs": {
          "205200201": {
            "id": "205200201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I can help you find a heat source.",
            "nextDialogs": [
              "205200202"
            ]
          },
          "205200202": {
            "id": "205200202",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "That's good... That's good. P—Please, hurry... I—I feel like I might freeze any m—moment now..."
          }
        }
      }
    },
    {
      "subId": "2052003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205200301"
        ],
        "dialogs": {
          "205200301": {
            "id": "205200301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll make you a hot meal.",
            "nextDialogs": [
              "205200302"
            ]
          },
          "205200302": {
            "id": "205200302",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "That... also works. P—Please, hurry... I—I feel like I might freeze any m—moment now..."
          }
        }
      }
    },
    {
      "subId": "2052004",
      "subQuestName": "Help Tommy find a source of heat",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205200401"
        ],
        "dialogs": {
          "205200401": {
            "id": "205200401",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "Phew... Much better. Thank you, Traveler.",
            "nextDialogs": [
              "205200402"
            ]
          },
          "205200402": {
            "id": "205200402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What brings you to this place?",
            "nextDialogs": [
              "205200403"
            ]
          },
          "205200403": {
            "id": "205200403",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "*sigh* A commission, what else? I've been at the camp all this time because of a rather... tricky commission.",
            "nextDialogs": [
              "205200404"
            ]
          },
          "205200404": {
            "id": "205200404",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "But I didn't want to stay there forever, so I was looking for something else to do...",
            "nextDialogs": [
              "205200405"
            ]
          },
          "205200405": {
            "id": "205200405",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "The chef, Harris, was looking for someone to find some Chilled Meat up the mountain.",
            "nextDialogs": [
              "205200406"
            ]
          },
          "205200406": {
            "id": "205200406",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "He said that I just needed to find some small frozen boar, and that there was no need to go too far up the mountain, so there'd be no danger at all...",
            "nextDialogs": [
              "205200407"
            ]
          },
          "205200407": {
            "id": "205200407",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "I thought it sounded straightforward enough, so I accepted the commission.",
            "nextDialogs": [
              "205200408"
            ]
          },
          "205200408": {
            "id": "205200408",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "I'd been preparing myself, too — training myself slowly, acclimatizing myself to Dragonspine's environment...",
            "nextDialogs": [
              "205200409"
            ]
          },
          "205200409": {
            "id": "205200409",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "...All so that I might finish the commission given to me by that alchemist lady.",
            "nextDialogs": [
              "205200410"
            ]
          },
          "205200410": {
            "id": "205200410",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "But I didn't expect that I'd lose my way not long after I started my ascent, and nearly get frozen in the process. I was lucky to have met you...",
            "nextDialogs": [
              "205200411"
            ]
          },
          "205200411": {
            "id": "205200411",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "My only regret is that... I couldn't complete my commission...",
            "nextDialogs": [
              "205200412"
            ]
          },
          "205200412": {
            "id": "205200412",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "Traveler... you seem to know this mountain well. Could I trouble you to do me a favor?",
            "nextDialogs": [
              "205200413"
            ]
          },
          "205200413": {
            "id": "205200413",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "I just need you to find me one serving of Chilled Meat. Just one is fine — that is all I need to complete my commission.",
            "nextDialogs": [
              "205200414"
            ]
          },
          "205200414": {
            "id": "205200414",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I've got your back.",
            "nextDialogs": [
              "205200415"
            ]
          },
          "205200415": {
            "id": "205200415",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "Thanks. In that case, let me mark the locations where Harris mentioned we might find small frozen boars on your map.",
            "nextDialogs": [
              "205200416"
            ]
          },
          "205200416": {
            "id": "205200416",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "I'll head down to the camp at the base of the mountain and await your good news there."
          }
        }
      }
    },
    {
      "subId": "2052005",
      "subQuestName": "Make Tommy a serving of Delicious Radish Veggie Soup",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205200501"
        ],
        "dialogs": {
          "205200501": {
            "id": "205200501",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "Have you found any Chilled Meat?",
            "nextDialogs": [
              "205200502"
            ]
          },
          "205200502": {
            "id": "205200502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it right here.",
            "nextDialogs": [
              "205200503"
            ]
          },
          "205200503": {
            "id": "205200503",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "Great! So, this is Chilled Meat? Honestly, I don't really see the difference, besides the fact that it's cold to the touch...",
            "nextDialogs": [
              "205200504"
            ]
          },
          "205200504": {
            "id": "205200504",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "Well, so long as the commission's complete...",
            "nextDialogs": [
              "205200505"
            ]
          },
          "205200505": {
            "id": "205200505",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "Thanks, Traveler. I'd have been in a bad way if it hadn't been for you.",
            "nextDialogs": [
              "205200506"
            ]
          },
          "205200506": {
            "id": "205200506",
            "speakerId": 1000,
            "speakerName": "Tommy",
            "text": "Here, you must take this as compensation."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7602901",
      "subQuestName": "Meet The Damselette",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760290101"
        ],
        "dialogs": {
          "760290101": {
            "id": "760290101",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Greetings.",
            "nextDialogs": [
              "760290102"
            ]
          },
          "760290102": {
            "id": "760290102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Are you heading out, Columbina?",
            "nextDialogs": [
              "760290103"
            ]
          },
          "760290103": {
            "id": "760290103",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Yes. I need to get a lyre repaired.",
            "nextDialogs": [
              "760290104"
            ]
          },
          "760290104": {
            "id": "760290104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...What?",
            "nextDialogs": [
              "760290105"
            ]
          },
          "760290105": {
            "id": "760290105",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "One of the kuuhenki's lyres is broken. She greatly values this lyre, so I wish to have it restored.",
            "nextDialogs": [
              "760290106"
            ]
          },
          "760290106": {
            "id": "760290106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Man, kuuhenki sure are multi-talented...",
            "nextDialogs": [
              "760290107"
            ]
          },
          "760290107": {
            "id": "760290107",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Of course. This little one often performs around here, and I sometimes sing along.",
            "nextDialogs": [
              "760290108"
            ]
          },
          "760290108": {
            "id": "760290108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Y'know, Paimon's been thinking this for a while, but you sure do spoil the kuuhenki.",
            "nextDialogs": [
              "760290109"
            ]
          },
          "760290109": {
            "id": "760290109",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Well, it's only right. They have kept me company all this time, and often bring me amusing objects as well.",
            "nextDialogs": [
              "760290110"
            ]
          },
          "760290110": {
            "id": "760290110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Lauma told me about this before — the natural instinct of kuuhenki to make the Moon Goddesses happy.)",
            "nextDialogs": [
              "760290111"
            ]
          },
          "760290111": {
            "id": "760290111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "If you don't mind Paimon asking, how do you plan to fix this lyre? Didn't you say you didn't want to be seen by others?",
            "nextDialogs": [
              "760290112"
            ]
          },
          "760290112": {
            "id": "760290112",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Hmm... In the past, small animals or kuuhenki would help deliver broken objects to an artisan's doorstep for me.",
            "nextDialogs": [
              "760290113"
            ]
          },
          "760290113": {
            "id": "760290113",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "All I had to do was wait for the artisan to find it. Of course, sometimes, that would take a few days.",
            "nextDialogs": [
              "760290114"
            ]
          },
          "760290114": {
            "id": "760290114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Seems like a roundabout way of doing things...",
            "nextDialogs": [
              "760290115"
            ]
          },
          "760290115": {
            "id": "760290115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why don't you let us handle it?",
            "nextDialogs": [
              "760290116"
            ]
          },
          "760290116": {
            "id": "760290116",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "760290117"
            ]
          },
          "760290117": {
            "id": "760290117",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah, just leave it to us. Who knows, we might even be able to get this done today.",
            "nextDialogs": [
              "760290118"
            ]
          },
          "760290118": {
            "id": "760290118",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...Very well. Thank you.",
            "nextDialogs": [
              "760290119"
            ]
          },
          "760290119": {
            "id": "760290119",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Our pleasure! By the way, what artisan do you usually bring your stuff to?",
            "nextDialogs": [
              "760290120"
            ]
          },
          "760290120": {
            "id": "760290120",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "I don't know her name, but there's a large mechanical hand by her door, and she lives in a round, conch-like home.",
            "nextDialogs": [
              "760290121"
            ]
          },
          "760290121": {
            "id": "760290121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Wait, she must mean...)",
            "nextDialogs": [
              "760290122"
            ]
          },
          "760290122": {
            "id": "760290122",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "The aroma of krumkakes often wafts from within as well.",
            "nextDialogs": [
              "760290123"
            ]
          },
          "760290123": {
            "id": "760290123",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yep, that clears it up for sure..."
          }
        }
      }
    },
    {
      "subId": "7602902",
      "subQuestName": "Go to the Clink-Clank Krumkake Craftshop",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760290201"
        ],
        "dialogs": {
          "760290201": {
            "id": "760290201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Aino? Are you home?",
            "nextDialogs": [
              "760290202"
            ]
          },
          "760290202": {
            "id": "760290202",
            "speakerId": 1002,
            "speakerName": "Aino",
            "text": "Wait, Paimon? Is that you?",
            "nextDialogs": [
              "760290203"
            ]
          },
          "760290203": {
            "id": "760290203",
            "speakerId": 1002,
            "speakerName": "Aino",
            "text": "What brings you here, guys? Bring me any snacks?",
            "nextDialogs": [
              "760290204"
            ]
          },
          "760290204": {
            "id": "760290204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon knew you'd say that! Here, we got you these on the way.",
            "nextDialogs": [
              "760290205"
            ]
          },
          "760290205": {
            "id": "760290205",
            "speakerId": 1002,
            "speakerName": "Aino",
            "text": "Quick, hand 'em over! Ineffa's gonna be back soon.",
            "nextDialogs": [
              "760290206"
            ]
          },
          "760290206": {
            "id": "760290206",
            "speakerId": 1002,
            "speakerName": "Aino",
            "text": "So, you here to hang out? What sorta fun things should we do?",
            "nextDialogs": [
              "760290207"
            ]
          },
          "760290207": {
            "id": "760290207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe... Actually, we need your help with something...",
            "nextDialogs": [
              "760290208"
            ]
          },
          "760290208": {
            "id": "760290208",
            "speakerId": 1002,
            "speakerName": "Aino",
            "text": "Waaah! Get... Get that weird thing away from me!",
            "nextDialogs": [
              "760290209"
            ]
          },
          "760290209": {
            "id": "760290209",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "\"Weird thing\"? You mean this lyre?",
            "nextDialogs": [
              "760290210"
            ]
          },
          "760290210": {
            "id": "760290210",
            "speakerId": 1002,
            "speakerName": "Aino",
            "text": "I told you, I don't mess with stuff that science and mechanics can't explain...",
            "nextDialogs": [
              "760290211"
            ]
          },
          "760290211": {
            "id": "760290211",
            "speakerId": 1002,
            "speakerName": "Aino",
            "text": "I'm telling you, that lyre just... shows up on my doorstep at random. And, after I fix it, the thing up and disappears!",
            "nextDialogs": [
              "760290212"
            ]
          },
          "760290212": {
            "id": "760290212",
            "speakerId": 1002,
            "speakerName": "Aino",
            "text": "N—Not that I believe in spooky, superstitious stuff like that!",
            "nextDialogs": [
              "760290213"
            ]
          },
          "760290213": {
            "id": "760290213",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ah, okay... Seems like there's some sort of misunderstanding here...",
            "nextDialogs": [
              "760290214"
            ]
          },
          "760290214": {
            "id": "760290214",
            "speakerId": 1002,
            "speakerName": "Aino",
            "text": "What do you mean?",
            "nextDialogs": [
              "760290217"
            ]
          },
          "760290217": {
            "id": "760290217",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah. She doesn't mean any harm, she just... has her reasons for taking the lyre back without being seen...",
            "nextDialogs": [
              "760290218"
            ]
          },
          "760290218": {
            "id": "760290218",
            "speakerId": 1002,
            "speakerName": "Aino",
            "text": "Really? You better not be making this up.",
            "nextDialogs": [
              "760290219"
            ]
          },
          "760290219": {
            "id": "760290219",
            "speakerId": 1002,
            "speakerName": "Aino",
            "text": "Fine. I'm... I'm trusting you on this! I'll fix this thing for you, and this time, I'll try to make it last...",
            "nextDialogs": [
              "760290220"
            ]
          },
          "760290220": {
            "id": "760290220",
            "speakerId": 1002,
            "speakerName": "Aino",
            "text": "Wait for me here. I'll be right back.",
            "nextDialogs": [
              "760290221"
            ]
          },
          "760290221": {
            "id": "760290221",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Knew we could count on Aino! Paimon feels a little bad Columbina's random item drop-offs had her so freaked out though...",
            "nextDialogs": [
              "760290222"
            ]
          },
          "760290222": {
            "id": "760290222",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "Yes, she deserves something in return.",
            "nextDialogs": [
              "760290223"
            ]
          },
          "760290223": {
            "id": "760290223",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Exactl— Aaah! What are you doing here!? You scared us!",
            "nextDialogs": [
              "760290224"
            ]
          },
          "760290224": {
            "id": "760290224",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "I have something to give you.",
            "nextDialogs": [
              "760290225"
            ]
          },
          "760290225": {
            "id": "760290225",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm? What are these?",
            "nextDialogs": [
              "760290226"
            ]
          },
          "760290226": {
            "id": "760290226",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "A few trinkets the kuuhenki collected. I thought the artisan might like them. Perhaps you could give them to her as thanks.",
            "nextDialogs": [
              "760290227"
            ]
          },
          "760290227": {
            "id": "760290227",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ohhh... What a weird collection of components. Yeah, alright! We'll pass 'em along!",
            "nextDialogs": [
              "760290228"
            ]
          },
          "760290228": {
            "id": "760290228",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Take care on your way back! There could be people around here.",
            "nextDialogs": [
              "760290229"
            ]
          },
          "760290229": {
            "id": "760290229",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "760290230"
            ]
          },
          "760290230": {
            "id": "760290230",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon...",
            "nextDialogs": [
              "760290231"
            ]
          },
          "760290231": {
            "id": "760290231",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? What is it?",
            "nextDialogs": [
              "760290232"
            ]
          },
          "760290232": {
            "id": "760290232",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Over there...",
            "nextDialogs": [
              "760290233"
            ]
          },
          "760290233": {
            "id": "760290233",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...!",
            "nextDialogs": [
              "760290234"
            ]
          },
          "760290234": {
            "id": "760290234",
            "speakerId": 1003,
            "speakerName": "Ineffa",
            "text": "...",
            "nextDialogs": [
              "760290235"
            ]
          },
          "760290235": {
            "id": "760290235",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "...",
            "nextDialogs": [
              "760290236"
            ]
          },
          "760290236": {
            "id": "760290236",
            "speakerId": 1003,
            "speakerName": "Ineffa",
            "text": "...Analyzing appearance...",
            "nextDialogs": [
              "760290237"
            ]
          },
          "760290237": {
            "id": "760290237",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What are you doing that for!?",
            "nextDialogs": [
              "760290238"
            ]
          },
          "760290238": {
            "id": "760290238",
            "speakerId": 1003,
            "speakerName": "Ineffa",
            "text": "Match found: Resemblance to Nod-Krai Moon Goddess Statues is 95%..."
          }
        }
      }
    },
    {
      "subId": "7602904",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760290301"
        ],
        "dialogs": {
          "760290301": {
            "id": "760290301",
            "speakerId": 1000,
            "speakerName": "The Damselette",
            "text": "You appear acquainted with that artisan. I shall await you here."
          }
        }
      }
    },
    {
      "subId": "7602904",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760290401"
        ],
        "dialogs": {
          "760290401": {
            "id": "760290401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Hmm? Music from a lyre? It seems Columbina is playing for the kuuhenki.)",
            "nextDialogs": [
              "760290402"
            ]
          },
          "760290402": {
            "id": "760290402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(The last time we popped by, the lyre hadn't been repaired yet. That was well before Columbina got to know everyone...)",
            "nextDialogs": [
              "760290403"
            ]
          },
          "760290403": {
            "id": "760290403",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Not long ago..."
          }
        }
      }
    }
  ]
}
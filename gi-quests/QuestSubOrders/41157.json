    {
      "subId": "4115703",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411570301"
        ],
        "dialogs": {
          "411570301": {
            "id": "411570301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I heard that someone placed a custom order...",
            "nextDialogs": [
              "411570302"
            ]
          },
          "411570302": {
            "id": "411570302",
            "speakerId": 1000,
            "speakerName": "Chef Mao",
            "text": "That's right. That boy Zi'rui ordered some Lotus Seed and Bird Egg Soup from us. As I recall, he should be off wandering in the Guyun Stone Forest right about now.",
            "nextDialogs": [
              "411570303"
            ]
          },
          "411570303": {
            "id": "411570303",
            "speakerId": 1000,
            "speakerName": "Chef Mao",
            "text": "So many young people, all headed out to that weird place — what is Liyue coming to nowadays?",
            "nextDialogs": [
              "411570304"
            ]
          },
          "411570304": {
            "id": "411570304",
            "speakerId": 1000,
            "speakerName": "Chef Mao",
            "text": "Whatever the case may be, could I trouble you to deliver this meal to him? <color=#00E1FFFF>Just don't fly about too much,</color> or the soup'll spill out."
          }
        }
      }
    },
    {

          "6051102": {
            "id": "6051102",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "Everything good, here?",
            "nextDialogs": [
              "6051103"
            ]
          },
          "6051103": {
            "id": "6051103",
            "speakerId": 1000,
            "speakerName": "Sucrose",
            "text": "All good! A few monsters made it into the city, but Master Diluc and Mr. Kaeya helped me take care of them.",
            "nextDialogs": [
              "6051104"
            ]
          },
          "6051104": {
            "id": "6051104",
            "speakerId": 1000,
            "speakerName": "Sucrose",
            "text": "I have some spare time right now, so I was planning to make some potions to help the people fighting!",
            "nextDialogs": [
              "6051105"
            ]
          },
          "6051105": {
            "id": "6051105",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "A sound plan.",
            "nextDialogs": [
              "6051106"
            ]
          },
          "6051106": {
            "id": "6051106",
            "speakerId": 1001,
            "speakerName": "Albedo",
            "text": "Remember to be careful. I know it's unlikely, but if you encounter a situation you can't handle, retreat to somewhere safe. Don't worry about the front line.",
            "nextDialogs": [
              "6051107"
            ]
          },
          "6051107": {
            "id": "6051107",
            "speakerId": 1000,
            "speakerName": "Sucrose",
            "text": "Understood!"
          }
        }
      }
    },

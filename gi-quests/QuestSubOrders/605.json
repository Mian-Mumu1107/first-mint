        "dialogs": {
          "6050201": {
            "id": "6050201",
            "speakerId": 1002,
            "speakerName": "Kaeya",
            "text": "Fantastic job defending this place, you two.",
            "nextDialogs": [
              "6050202"
            ]
          },
          "6050202": {
            "id": "6050202",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "We'll take it from here.",
            "nextDialogs": [
              "6050203"
            ]
          },
          "6050203": {
            "id": "6050203",
            "speakerId": 1004,
            "speakerName": "Lawrence",
            "text": "Captain Kaeya, Swan is—",
            "nextDialogs": [
              "6050204"
            ]
          },
          "6050204": {
            "id": "6050204",
            "speakerId": 1005,
            "speakerName": "Swan",
            "text": "Hey! I'm fine. It's your leg we should be worried about...",
            "nextDialogs": [
              "6050205"
            ]
          },
          "6050205": {
            "id": "6050205",
            "speakerId": 1002,
            "speakerName": "Kaeya",
            "text": "Swan, Lawrence, you should both get treated at the Church. Don't push yourselves. We'll take care of things here.",
            "nextDialogs": [
              "6050206"
            ]
          },
          "6050206": {
            "id": "6050206",
            "speakerId": 1005,
            "speakerName": "Swan",
            "text": "But, Master Diluc... Didn't you leave the Knights of Favonius?",
            "nextDialogs": [
              "6050207"
            ]
          },
          "6050207": {
            "id": "6050207",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "What, are Knights the only ones capable of defending this gate?",
            "nextDialogs": [
              "6050208"
            ]
          },
          "6050208": {
            "id": "6050208",
            "speakerId": 1002,
            "speakerName": "Kaeya",
            "text": "It's fine. Master Diluc is just... altruistic as always. If a civilian is willing to help out, who are we to turn him away?",
            "nextDialogs": [
              "6050209"
            ]
          },
          "6050209": {
            "id": "6050209",
            "speakerId": 1005,
            "speakerName": "Swan",
            "text": "...Understood. We're grateful for the support.",
            "nextDialogs": [
              "6050210"
            ]
          },
          "6050210": {
            "id": "6050210",
            "speakerId": 1004,
            "speakerName": "Lawrence",
            "text": "Yeah, thanks a million! We'll be back soon.",
            "nextDialogs": [
              "6050211"
            ]
          },

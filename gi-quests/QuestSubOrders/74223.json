        "dialogs": {
          "742230401": {
            "id": "742230401",
            "speakerId": 1000,
            "speakerName": "Venier",
            "text": "Huh... So that's how you chose to handle it...",
            "nextDialogs": [
              "742230402"
            ]
          },
          "742230402": {
            "id": "742230402",
            "speakerId": 1000,
            "speakerName": "Venier",
            "text": "Truly splendid. Have you previously served in our God King's armies, by any chance?",
            "nextDialogs": [
              "742230403"
            ]
          },
          "742230403": {
            "id": "742230403",
            "speakerId": 1001,
            "speakerName": "Nameless Stone Statue",
            "text": "...",
            "nextDialogs": [
              "742230404"
            ]
          },
          "742230404": {
            "id": "742230404",
            "speakerId": 1000,
            "speakerName": "Venier",
            "text": "Our fine officer also praises your performance! It seems I must work harder!"
          }
        }
      }
    },
    {
      "subId": "7422302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742230201"
        ],
        "dialogs": {
          "742230201": {
            "id": "742230201",
            "speakerId": 1000,
            "speakerName": "Venier",
            "text": "A hundred and thirty-six... Alright, fourteen more times, and we'll take a break!",
            "nextDialogs": [
              "742230202"
            ]
          },
          "742230202": {
            "id": "742230202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you need a hand?",
            "nextDialogs": [
              "742230203"
            ]
          },
          "742230203": {
            "id": "742230203",
            "speakerId": 1000,
            "speakerName": "Venier",
            "text": "A hand? No, no need. What training requires the assistance of another?",
            "nextDialogs": [
              "742230204"
            ]
          },
          "742230204": {
            "id": "742230204",
            "speakerId": 1000,
            "speakerName": "Venier",
            "text": "Only by honing my physique can I join Legion Athanatoi as one of its sublime soldiers, just like this officer here!",
            "nextDialogs": [
              "742230205"
            ]
          },
          "742230205": {
            "id": "742230205",
            "speakerId": 1001,
            "speakerName": "Nameless Stone Statue",
            "text": "...",
            "nextDialogs": [
              "742230206"
            ]
          },
          "742230206": {
            "id": "742230206",
            "speakerId": 1000,
            "speakerName": "Venier",
            "text": "Ah yes, introductions are in order! This is my instructor. Only by clearing the tests he sets can I earn the right to ascend.",
            "nextDialogs": [
              "742230208",
              "742230211"
            ]
          },
          "742230208": {
            "id": "742230208",
            "speakerId": 1000,
            "speakerName": "Venier",
            "text": "What are you saying, citizen? Are not all Remurians this way?",
            "nextDialogs": [
              "742230209"
            ]
          },
          "742230209": {
            "id": "742230209",
            "speakerId": 1000,
            "speakerName": "Venier",
            "text": "In any case, would you like to have a go? The initial test involves the simultaneous smashing of these stone pillars.",
            "nextDialogs": [
              "742230213"
            ]
          },
          "742230213": {
            "id": "742230213",
            "speakerId": 1000,
            "speakerName": "Venier",
            "text": "Don't underestimate them, however! Even with all my training, I can only shatter one with a single punch."
          },
          "742230211": {
            "id": "742230211",
            "speakerId": 1000,
            "speakerName": "Venier",
            "text": "Combat tests, naturally. An ascendant, immortal form is one thing, but combat skills must be honed of one's own accord.",
            "nextDialogs": [
              "742230212"
            ]
          },
          "742230212": {
            "id": "742230212",
            "speakerId": 1000,
            "speakerName": "Venier",
            "text": "In any case, would you like to have a go? The initial test involves the simultaneous smashing of these stone pillars."
          }
        }
      }

    {
      "subId": "7333007",
      "subQuestName": "Talk to the Fatui officer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733300701"
        ],
        "dialogs": {
          "733300701": {
            "id": "733300701",
            "speakerId": 1000,
            "speakerName": "Sorush",
            "text": "Hey, you scheming humans! I suggest leaving this place at once — the heritage and secrets of us Pari are not for you to covet, and certainly not within your reach.",
            "nextDialogs": [
              "733300702"
            ]
          },
          "733300702": {
            "id": "733300702",
            "speakerId": 1001,
            "speakerName": "Markozov",
            "text": "...Pari? You're a Pari! Oh, what an amazing experience!",
            "nextDialogs": [
              "733300703"
            ]
          },
          "733300703": {
            "id": "733300703",
            "speakerId": 1001,
            "speakerName": "Markozov",
            "text": "#Oh! And there's also a {M#wiry young man}{F#little young lady} with {M#his}{F#her}... pet?",
            "nextDialogs": [
              "733300704"
            ]
          },
          "733300704": {
            "id": "733300704",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "#Hey, watch what you say! Paimon's {M#his}{F#her} best friend!",
            "nextDialogs": [
              "733300705"
            ]
          },
          "733300705": {
            "id": "733300705",
            "speakerId": 1001,
            "speakerName": "Markozov",
            "text": "Friend... Why, of course! \"Best friend\"... What a beautiful sound! I've always wanted to have a \"best friend\" since childhood...",
            "nextDialogs": [
              "733300706"
            ]
          },
          "733300706": {
            "id": "733300706",
            "speakerId": 1001,
            "speakerName": "Markozov",
            "text": "#{M#Wiry young man}{F#Little young lady}, you're certainly not in need of two best friends, are you?",
            "nextDialogs": [
              "733300710",
              "733300709"
            ]
          },
          "733300710": {
            "id": "733300710",
            "speakerId": 1001,
            "speakerName": "Markozov",
            "text": "I mean... Even if you're the one having two best friends, don't you think it's a little unfair?",
            "nextDialogs": [
              "733300711"
            ]
          },
          "733300711": {
            "id": "733300711",
            "speakerId": 1001,
            "speakerName": "Markozov",
            "text": "Inequities like this are impossible to forgive... So please, hand the Pari over to me. As for how I'll treat it... you wouldn't have to worry. I'll make sure it's used to its full potential.",
            "nextDialogs": [
              "733300712"
            ]
          },
          "733300712": {
            "id": "733300712",
            "speakerId": 1000,
            "speakerName": "Sorush",
            "text": "Insolent fool...",
            "nextDialogs": [
              "733300713"
            ]
          },
          "733300713": {
            "id": "733300713",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Whoa, he's being so unreasonable... There's no getting through to him!",
            "nextDialogs": [
              "733300714"
            ]
          },
          "733300714": {
            "id": "733300714",
            "speakerId": 1000,
            "speakerName": "Sorush",
            "text": "We can always make him understand without wasting our words... My clever Yasnapati, surely you know what I mean?",
            "nextDialogs": [
              "733300715"
            ]
          },
          "733300715": {
            "id": "733300715",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh, Paimon knows! Sorush wants us to teach him a lesson!",
            "nextDialogs": [
              "733300716"
            ]
          },
          "733300716": {
            "id": "733300716",
            "speakerId": 1000,
            "speakerName": "Sorush",
            "text": "Hmph! Silence, Pale Floater!"
          },
          "733300709": {
            "id": "733300709",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "No way! Only Paimon can be your best friend!"
          }
        }
      }
    },

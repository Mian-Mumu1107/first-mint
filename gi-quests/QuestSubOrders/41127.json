        ],
        "dialogs": {
          "411270301": {
            "id": "411270301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What were you doing out there?",
            "nextDialogs": [
              "411270302"
            ]
          },
          "411270302": {
            "id": "411270302",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Oh, come on. What's with that look of suspicion?",
            "nextDialogs": [
              "411270303"
            ]
          },
          "411270303": {
            "id": "411270303",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "I just went out for a stroll, really! I legged it back here the moment those meteorites started falling.",
            "nextDialogs": [
              "411270304"
            ]
          },
          "411270304": {
            "id": "411270304",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Well, whatever. Go out there and have a look. <color=#00E1FFFF>Come back and look for me if you really can't find it</color>.",
            "nextDialogs": [
              "411270305"
            ]
          },
          "411270305": {
            "id": "411270305",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "I'll give it a bit more thought. Maybe I'll remember something..."
          }
        }
      }
    },

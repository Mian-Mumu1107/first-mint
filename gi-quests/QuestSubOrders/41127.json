  "subQuests": [
    {
      "subId": "4112701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411270101"
        ],
        "dialogs": {
          "411270101": {
            "id": "411270101",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Oh, this is terrible. I'm finished for sure...",
            "nextDialogs": [
              "411270102"
            ]
          },
          "411270102": {
            "id": "411270102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Something wrong?",
            "nextDialogs": [
              "411270103"
            ]
          },
          "411270103": {
            "id": "411270103",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Gah! Staying here was just too boring, what with the weird looks the sisters give me and all, so I decided to get out, get some fresh air...",
            "nextDialogs": [
              "411270104"
            ]
          },
          "411270104": {
            "id": "411270104",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "But just as I left the city, thinking to go to the Thousand Winds Temple for a stroll... all these meteorites started raining down from the sky.",
            "nextDialogs": [
              "411270105"
            ]
          },
          "411270105": {
            "id": "411270105",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "There was no way I was staying out there, so I ran back into the city... And that's when I realized that I left a box behind...",
            "nextDialogs": [
              "411270106"
            ]
          },
          "411270106": {
            "id": "411270106",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Given all the chaos out there, I didn't dare to go out to look for it, either.",
            "nextDialogs": [
              "411270107"
            ]
          },
          "411270107": {
            "id": "411270107",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "And, well... I'm Fatui. If I were to make any sudden moves, I'd be suspected of doing something untoward for sure...",
            "nextDialogs": [
              "411270108"
            ]
          },
          "411270108": {
            "id": "411270108",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Bah, enough nonsense. Could you help me look for that thing?",
            "nextDialogs": [
              "411270109"
            ]
          },
          "411270109": {
            "id": "411270109",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Our transactions have been quite amiable so far, and I plan to continue doing good business with you...",
            "nextDialogs": [
              "411270110"
            ]
          },
          "411270110": {
            "id": "411270110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Stop saying such suspicious stuff.",
            "nextDialogs": [
              "411270111"
            ]
          },
          "411270111": {
            "id": "411270111",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "What? Come now, there was nothing suspicious about the stories I told you...",
            "nextDialogs": [
              "411270112"
            ]
          },
          "411270112": {
            "id": "411270112",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Well, how about it? Will you help me out, or won't you?"
          }
        }
      }
    },
    {
      "subId": "4112702",
      "subQuestName": "Talk to Viktor",
      "sceneId": null,
      "locations": [],

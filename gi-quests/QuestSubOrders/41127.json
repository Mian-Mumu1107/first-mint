    {
      "subId": "4112711",
      "subQuestName": "Report back to Viktor",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411271101"
        ],
        "dialogs": {
          "411271101": {
            "id": "411271101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, what do you know about the meteorites?",
            "nextDialogs": [
              "411271102"
            ]
          },
          "411271102": {
            "id": "411271102",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "The meteorites... Well, not that I don't want to tell you, but I have no clue either.",
            "nextDialogs": [
              "411271103"
            ]
          },
          "411271103": {
            "id": "411271103",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "All I do is stand here in Mondstadt, unable to leave or move. What do I know?",
            "nextDialogs": [
              "411271104"
            ]
          },
          "411271104": {
            "id": "411271104",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "But my gut feeling tells me that those meteorites don't bode well...",
            "nextDialogs": [
              "411271105"
            ]
          },
          "411271105": {
            "id": "411271105",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "I'd stay out of this one if I were you. It can only mean trouble."
          }
        }
      }
    },

          "411270901": {
            "id": "411270901",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Have you found that box?",
            "nextDialogs": [
              "411270902"
            ]
          },
          "411270902": {
            "id": "411270902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it right here.",
            "nextDialogs": [
              "411270903"
            ]
          },
          "411270903": {
            "id": "411270903",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "You... actually managed to find it! Phew... That's good... That's good.",
            "nextDialogs": [
              "411270904"
            ]
          },
          "411270904": {
            "id": "411270904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And as for our \"deal\"?",
            "nextDialogs": [
              "411270905"
            ]
          },
          "411270905": {
            "id": "411270905",
            "speakerId": 1517,
            "speakerName": "Viktor",
            "text": "Uh, fine... Fine, I get it. Out with it, then. What do you want to know this time?"
          }
        }
      }

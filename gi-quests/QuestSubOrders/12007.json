    {
      "subId": "1200705",
      "subQuestName": "Talk to Kamisato Ayaka",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120070201"
        ],
        "dialogs": {
          "120070201": {
            "id": "120070201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Did it open, did it open? Did our \"Inazumadeptus\" leave any treasure here?",
            "nextDialogs": [
              "120070202"
            ]
          },
          "120070202": {
            "id": "120070202",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "What's this?",
            "nextDialogs": [
              "120070203"
            ]
          },
          "120070203": {
            "id": "120070203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh... Looks like a book.",
            "nextDialogs": [
              "120070204"
            ]
          },
          "120070204": {
            "id": "120070204",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "It seems to be another notebook.",
            "nextDialogs": [
              "120070205"
            ]
          },
          "120070205": {
            "id": "120070205",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Could it be Tsubaki's notebook...?",
            "nextDialogs": [
              "120070206"
            ]
          },
          "120070206": {
            "id": "120070206",
            "speakerId": 1013,
            "speakerName": "Kamisato Ayaka",
            "text": "Let's step back outside now. The atmosphere here is different than I'd imagined. Somehow... it makes me a little reluctant to open the notebook.",
            "nextDialogs": [
              "120070207"
            ]
          },
          "120070207": {
            "id": "120070207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon knows what you mean — reading in low light is really bad for your eyes. C'mon, let's get back outside!"
          }
        }
      }
    },

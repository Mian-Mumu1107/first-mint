    {
      "subId": "7510403",
      "subQuestName": "Talk to Rongo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751040701"
        ],
        "dialogs": {
          "751040701": {
            "id": "751040701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright, let's begin.",
            "nextDialogs": [
              "751040702"
            ]
          },
          "751040702": {
            "id": "751040702",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "Haha, mighty straightforward of ya! Now that's the spirit our people lack right now, y'know? Righty then. I'll make the preparations now!"
          }
        }
      }
    },
    {
      "subId": "7510419",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751040801"
        ],
        "dialogs": {
          "751040801": {
            "id": "751040801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wait a bit, I've got something else I need to do.",
            "nextDialogs": [
              "751040802"
            ]
          },
          "751040802": {
            "id": "751040802",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "#No problem! I'll go fix the wooden racks a bit and wait here for your return, {M#kane}{F#wahine}!"
          }
        }
      }
    },
    {
      "subId": "7510422",
      "subQuestName": "Talk to Rongo",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751042201"
        ],
        "dialogs": {
          "751042201": {
            "id": "751042201",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "#Haha, such skill! If all our kids were half as nimble as you, {M#kane}{F#wahine}, they wouldn't need training.",
            "nextDialogs": [
              "751042202"
            ]
          },
          "751042202": {
            "id": "751042202",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "And here's the shell you were promised. Take it!",
            "nextDialogs": [
              "751042203"
            ]
          },
          "751042203": {
            "id": "751042203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, just glad we could help.",
            "nextDialogs": [
              "751042204"
            ]
          },
          "751042204": {
            "id": "751042204",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "Still, now that you've finished testing, I've realized that there's a serious problem...",
            "nextDialogs": [
              "751042205"
            ]
          },
          "751042205": {
            "id": "751042205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? What would that problem be?",
            "nextDialogs": [
              "751042206"
            ]
          },
          "751042206": {
            "id": "751042206",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "Don't you think... this is just a real regular surfing spot?",
            "nextDialogs": [
              "751042209"
            ]
          },
          "751042209": {
            "id": "751042209",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "#Well, uh... You see the Spiritdoors over there, {M#kane}{F#wahine}? When Amina and I were discussing this whole affair, these old Phlogiston Devices still operated normally.",
            "nextDialogs": [
              "751042210"
            ]
          },
          "751042210": {
            "id": "751042210",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "*sigh* If they could still be used to activate those Spiritways, we could've ridden them straight up to the rainbow, just like Uenuku once did!"
          }
        }
      }
    },

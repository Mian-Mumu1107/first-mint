    {
      "subId": "7510423",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751041301"
        ],
        "dialogs": {
          "751041301": {
            "id": "751041301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, what a pretty shell! Why's it on this platform anyway?",
            "nextDialogs": [
              "751041302"
            ]
          },
          "751041302": {
            "id": "751041302",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "#Why, hey there, {M#kane}{F#wahine}. Impeccable timing! You got a moment?",
            "nextDialogs": [
              "751041303"
            ]
          },
          "751041303": {
            "id": "751041303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Whoa, someone's here! Well, {NICKNAME}, guess we should hear what he has to say...?"
          }
        }
      }
    },
    {
      "subId": "7510401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751040101"
        ],
        "dialogs": {
          "751040101": {
            "id": "751040101",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "#Hey there, {M#kane}{F#wahine}. Impeccable timing!",
            "nextDialogs": [
              "751040102"
            ]
          },
          "751040102": {
            "id": "751040102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm? You talking to us?",
            "nextDialogs": [
              "751040103"
            ]
          },
          "751040103": {
            "id": "751040103",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "That's right! You're outlanders from far abroad, yes? I've got something I'd like your opinion on.",
            "nextDialogs": [
              "751040104"
            ]
          },
          "751040104": {
            "id": "751040104",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "From the perspective of a guest, have you ever thought that the life the People of the Springs lead is too laid-back?",
            "nextDialogs": [
              "751040105"
            ]
          },
          "751040105": {
            "id": "751040105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, what do you mean by that?",
            "nextDialogs": [
              "751040106"
            ]
          },
          "751040106": {
            "id": "751040106",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "Well, something you should know is that our ancestors were warriors famed throughout the lands. Uenuku the Treader of the Rainbow, Tupac the Giant... Renowned heroes all!",
            "nextDialogs": [
              "751040107"
            ]
          },
          "751040107": {
            "id": "751040107",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "But nowadays? Mention \"the People of the Springs,\" and people assume you're talking about \"hot springs\"!",
            "nextDialogs": [
              "751040109",
              "751040111"
            ]
          },
          "751040109": {
            "id": "751040109",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "Hardly, no, but all this easy living will see our fighting spirit vanish in time, mark my words!",
            "nextDialogs": [
              "751040113"
            ]
          },
          "751040113": {
            "id": "751040113",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "This can't go on! That's why I told lil' Amina that we've gotta build a training ground — to stoke that spirit once more!",
            "nextDialogs": [
              "751040114"
            ]
          },
          "751040114": {
            "id": "751040114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, what did she say?",
            "nextDialogs": [
              "751040115"
            ]
          },
          "751040115": {
            "id": "751040115",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "\"I don't get what you're saying at all, but if it's interesting, we'll go along with it.\"",
            "nextDialogs": [
              "751040116"
            ]
          },
          "751040116": {
            "id": "751040116",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "So, this is it! The Great Training Arena of the People of the Springs!"
          },
          "751040111": {
            "id": "751040111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And about delicious fruit juice...",
            "nextDialogs": [
              "751040112"
            ]
          },
          "751040112": {
            "id": "751040112",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "That's all the same to me! This easy living will see our fighting spirit vanish in time — mark my words!"
          }
        }
      }
    },
    {
      "subId": "7510402",
      "subQuestName": "Help Rongo chase the Flowcurrent Birds away",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751040201"
        ],
        "dialogs": {
          "751040201": {
            "id": "751040201",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "Ho there! Have you driven all those Flowcurrent Birds off?",
            "nextDialogs": [
              "751040202"
            ]
          },
          "751040202": {
            "id": "751040202",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "#Haha, awesome! Good job, {M#kane}{F#wahine}! That squares our basic prep away — now, we can start testing our Great Training Arena!",
            "nextDialogs": [
              "751040203"
            ]
          },
          "751040203": {
            "id": "751040203",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "Well, are you ready?"
          }
        }
      }
    },

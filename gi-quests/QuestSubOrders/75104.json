    {
      "subId": "7510406",
      "subQuestName": "Look around nearby for a way to repair the Spiritdoors",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751040601"
        ],
        "dialogs": {
          "751040601": {
            "id": "751040601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh. Seems like the Spiritway's shut again...",
            "nextDialogs": [
              "751040602"
            ]
          },
          "751040602": {
            "id": "751040602",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "#Haha, no worries, no worries! It was fixed once, it can be fixed again! You just enjoy yourself, {M#kane}{F#wahine}!",
            "nextDialogs": [
              "751040603"
            ]
          },
          "751040603": {
            "id": "751040603",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "Our current Training Arena is meant to hone young people and their fighting spirit, in any case... So this is more than enough.",
            "nextDialogs": [
              "751040604"
            ]
          },
          "751040604": {
            "id": "751040604",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "If you've got the time and the mind to hone your spirit, feel free to come back!"
          }
        }
      }
    },

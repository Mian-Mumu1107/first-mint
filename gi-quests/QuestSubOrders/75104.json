    {
      "subId": "7510404",
      "subQuestName": "Complete the surfing test",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751040401"
        ],
        "dialogs": {
          "751040401": {
            "id": "751040401",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "Ohh! Ohhh! I... didn't expect you to actually fix those doors! You... You've got spirit alright! Lots of it!",
            "nextDialogs": [
              "751040402"
            ]
          },
          "751040402": {
            "id": "751040402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, how should Paimon put this, though? We've reactivated the devices, but Paimon thinks they need partial readjusting...",
            "nextDialogs": [
              "751040406",
              "751040405"
            ]
          },
          "751040406": {
            "id": "751040406",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "Haha, no worries! Leave those details to me!",
            "nextDialogs": [
              "751040407"
            ]
          },
          "751040407": {
            "id": "751040407",
            "speakerId": 6257,
            "speakerName": "Rongo",
            "text": "You just come back around tomorrow, alright?"
          },
          "751040405": {
            "id": "751040405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "?"
          }
        }
      }
    },

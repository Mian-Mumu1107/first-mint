            "id": "749350101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Your uncle?",
            "nextDialogs": [
              "749350102"
            ]
          },
          "749350102": {
            "id": "749350102",
            "speakerId": 5343,
            "speakerName": "Moce",
            "text": "That's right. I don't know his name, and he's never written us any letters... Dad always calls him \"that blockhead,\" or \"that guy\"...",
            "nextDialogs": [
              "749350103"
            ]
          },
          "749350103": {
            "id": "749350103",
            "speakerId": 5343,
            "speakerName": "Moce",
            "text": "But he's gotta be a pretty awesome guy to have bucked with tradition and left town by himself to Sumeru! Better than Dad, who only ever talks about family and duty and stuff like that...",
            "nextDialogs": [
              "749350104"
            ]
          },
          "749350104": {
            "id": "749350104",
            "speakerId": 5343,
            "speakerName": "Moce",
            "text": "Uh, hmm. Did I say too much? Keep that stuff a secret and don't tell Dad, alright? Thanks!"
          }
        }
      }
    }
  ]

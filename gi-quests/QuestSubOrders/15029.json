            "speakerId": 14647,
            "speakerName": "Montluson",
            "text": "My bank balance..."
          }
        }
      }
    },
    {
      "subId": "1502951",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150295101"
        ],
        "dialogs": {
          "150295101": {
            "id": "150295101",
            "speakerId": 15018,
            "speakerName": "Caholom",
            "text": "Ah, Natlan's victory against the Abyss! Very fitting for a scroll like this...",
            "nextDialogs": [
              "150295102"
            ]
          },
          "150295102": {
            "id": "150295102",
            "speakerId": 14652,
            "speakerName": "Aywastin",
            "text": "I wonder how long until Elder Tlapo chooses the next appointed?",
            "nextDialogs": [
              "150295103"
            ]
          },
          "150295103": {
            "id": "150295103",
            "speakerId": 14653,
            "speakerName": "Besuci",
            "text": "Speaking of Elder Tlapo, I heard he went missing yesterday! Do you know what happened?",
            "nextDialogs": [
              "150295104"
            ]
          },
          "150295104": {
            "id": "150295104",
            "speakerId": 14654,
            "speakerName": "Chogan",
            "text": "Elder Tlapo works in mysterious ways. The meaning of his departure will become clear in time, but for now, we cannot hope to fathom it."
          }
        }
      }
    },
    {
      "subId": "1502999",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150299901"
        ],
        "dialogs": {
          "150299901": {
            "id": "150299901",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Claw helps you bring the woven scroll outside."
          }
        }
      }
    }
  ]
}
    "Tlapo": 3
  },
  "subQuests": [
    {
      "subId": "1502901",
      "subQuestName": "Accompany Citlali back to her dwelling",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150290101"
        ],
        "dialogs": {
          "150290101": {
            "id": "150290101",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Now, when it comes to weaving the scroll itself, you don't actually need to lift a finger. But, if we're going to pass on Huitzilin's technique, your participation is critical.",
            "nextDialogs": [
              "150290102"
            ]
          },
          "150290102": {
            "id": "150290102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What are you saying, Citlali?",
            "nextDialogs": [
              "150290103"
            ]
          },
          "150290103": {
            "id": "150290103",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Follow me.",
            "nextDialogs": [
              "150290104"
            ]
          },
          "150290104": {
            "id": "150290104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, look at this place... Do you weave scrolls, too?",
            "nextDialogs": [
              "150290105"
            ]
          },
          "150290105": {
            "id": "150290105",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Scrolls...",
            "nextDialogs": [
              "150290106"
            ]
          },
          "150290106": {
            "id": "150290106",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Scrolls? I thought you were going to show me your masterpiece?",
            "nextDialogs": [
              "150290107"
            ]
          },
          "150290107": {
            "id": "150290107",
            "speakerId": 14936,
            "speakerName": "Huitzilin",
            "text": "That I am, old friend. The technique I'm about to show you directly relates to woven scrolls.",
            "nextDialogs": [
              "150290108"
            ]
          },
          "150290108": {
            "id": "150290108",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "*sigh* Fine, what is it? Something that can turn the tide of war or prevent a great disaster?",
            "nextDialogs": [
              "150290109"
            ]
          },
          "150290109": {
            "id": "150290109",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "You probably want to challenge me, right? I know you don't have the strength for a real fight, so I'll let you beat me with words.",
            "nextDialogs": [
              "150290110"
            ]
          },
          "150290110": {
            "id": "150290110",
            "speakerId": 14936,
            "speakerName": "Huitzilin",
            "text": "*cough*... Old friend, my life is nearing its end. I'm afraid... I don't have time for another match.",
            "nextDialogs": [
              "150290111"
            ]
          },
          "150290111": {
            "id": "150290111",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Hey...",
            "nextDialogs": [
              "150290112"
            ]
          },
          "150290112": {
            "id": "150290112",
            "speakerId": 14936,
            "speakerName": "Huitzilin",
            "text": "Don't worry. I trust in the belief of our tribe... that death is not the end, but the beginning of a new existence in the Night Kingdom, where everything is made of memories.",
            "nextDialogs": [
              "150290113"
            ]
          },
          "150290113": {
            "id": "150290113",
            "speakerId": 14936,
            "speakerName": "Huitzilin",
            "text": "So, do you know why our ancestors insisted on using colorful woven scrolls to record our history?",
            "nextDialogs": [
              "150290114"
            ]
          },
          "150290114": {
            "id": "150290114",
            "speakerId": 14936,
            "speakerName": "Huitzilin",
            "text": "Because... history is the memory of a people.",
            "nextDialogs": [
              "150290115"
            ]
          },
          "150290115": {
            "id": "150290115",
            "speakerId": 14936,
            "speakerName": "Huitzilin",
            "text": "We give our scrolls an orange hue so the dead can still feel the warmth of the setting sun.",
            "nextDialogs": [
              "150290116"
            ]
          },
          "150290116": {
            "id": "150290116",
            "speakerId": 14936,
            "speakerName": "Huitzilin",
            "text": "We decorate them with kernels of Grainfruit so the dead can still enjoy the abundance of our harvests.",
            "nextDialogs": [
              "150290117"
            ]
          },
          "150290117": {
            "id": "150290117",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "I know that... But, something this important? Why entrust it to me and not one of your students?",
            "nextDialogs": [
              "150290118"
            ]
          },
          "150290118": {
            "id": "150290118",
            "speakerId": 14936,
            "speakerName": "Huitzilin",
            "text": "Hehe, as your friend, I admit... I'm being a bit selfish.",
            "nextDialogs": [
              "150290119"
            ]
          },
          "150290119": {
            "id": "150290119",
            "speakerId": 14936,
            "speakerName": "Huitzilin",
            "text": "*cough* I don't have long, Citlali. I'm not sure... I can truly explain my decision. But, I know you will understand one day.",
            "nextDialogs": [
              "150290120"
            ]
          },
          "150290120": {
            "id": "150290120",
            "speakerId": 14936,
            "speakerName": "Huitzilin",
            "text": "For now... will you accept my final request?",
            "nextDialogs": [
              "150290121"
            ]
          },
          "150290121": {
            "id": "150290121",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "...Just this once.",
            "nextDialogs": [
              "150290122"
            ]
          },
          "150290122": {
            "id": "150290122",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "I understand now, Huitzilin — just like you said I would... Claw, help me move this outside. I'm going to color it.",
            "nextDialogs": [
              "150290123"
            ]
          },
          "150290123": {
            "id": "150290123",
            "speakerId": 6249,
            "speakerName": "Tlapo",
            "text": "!",
            "nextDialogs": [
              "150290124"
            ]
          },
          "150290124": {
            "id": "150290124",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "#{NICKNAME}, Paimon, come with me."
          }
        }
      }
    },
    {
      "subId": "1502902",
      "subQuestName": "Go outside together with Citlali",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150290201"
        ],
        "dialogs": {
          "150290201": {
            "id": "150290201",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "We are like birds, soaring through the horizons of time...",
            "nextDialogs": [
              "150290203"
            ]
          },
          "150290203": {
            "id": "150290203",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "(Package Video)",
            "nextDialogs": [
              "150290204"
            ]
          },
          "150290204": {
            "id": "150290204",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "I knew you would understand.",
            "nextDialogs": [
              "150290205"
            ]
          },
          "150290205": {
            "id": "150290205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This... This is the special scroll! How did you know how to weave it, Citlali?",
            "nextDialogs": [
              "150290206"
            ]
          },
          "150290206": {
            "id": "150290206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Remember the \"gift from the spirits\"?",
            "nextDialogs": [
              "150290207"
            ]
          },
          "150290207": {
            "id": "150290207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hold on, you've lived for more than two hundred years, you know how to weave the special scroll — that must mean... You're the one behind the \"gifts from the spirits\"!",
            "nextDialogs": [
              "150290208"
            ]
          },
          "150290208": {
            "id": "150290208",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Well, it's not like I wanted to interact with the appointed, so whenever I delivered the scroll, I used illusions to confuse them.",
            "nextDialogs": [
              "150290209"
            ]
          },
          "150290209": {
            "id": "150290209",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "The fact that it turned into some kind of \"divine intervention\" is because no one was skilled enough to see through my tricks...",
            "nextDialogs": [
              "150290210"
            ]
          },
          "150290210": {
            "id": "150290210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why not just tell them?",
            "nextDialogs": [
              "150290211"
            ]
          },
          "150290211": {
            "id": "150290211",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You've carried the duty alone for all these years? Even if you don't like interacting with people, why not teach someone else how to do it?",
            "nextDialogs": [
              "150290212"
            ]
          },
          "150290212": {
            "id": "150290212",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "#...{NICKNAME}, you can see the special color, right?",
            "nextDialogs": [
              "150290213"
            ]
          },
          "150290213": {
            "id": "150290213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes.",
            "nextDialogs": [
              "150290214"
            ]
          },
          "150290214": {
            "id": "150290214",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "The essence of that color is memory. That means completing the special scroll is a process of searching for color within your memories.",
            "nextDialogs": [
              "150290215"
            ]
          },
          "150290215": {
            "id": "150290215",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Passing the technique on to someone means sharing your memories with them. You need to leave traces of your color in their memory, and they must do the same.",
            "nextDialogs": [
              "150290216"
            ]
          },
          "150290216": {
            "id": "150290216",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Even though I only confirmed that today, I've had suspicions for a long time.",
            "nextDialogs": [
              "150290217"
            ]
          },
          "150290217": {
            "id": "150290217",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "And, well... ever since Huitzilin died, I haven't wanted to form that kind of connection with people.",
            "nextDialogs": [
              "150290218"
            ]
          },
          "150290218": {
            "id": "150290218",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, yeah...",
            "nextDialogs": [
              "150290219"
            ]
          },
          "150290219": {
            "id": "150290219",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "It was her final wish, so I kind of resigned myself to taking on the burden forever. After all, I have all the time in the world.",
            "nextDialogs": [
              "150290220"
            ]
          },
          "150290220": {
            "id": "150290220",
            "speakerId": 6249,
            "speakerName": "Tlapo",
            "text": "!",
            "nextDialogs": [
              "150290221"
            ]
          },
          "150290221": {
            "id": "150290221",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "But, Claw never stopped appointing new candidates to weave the scroll — despite knowing exactly how I felt about the situation.",
            "nextDialogs": [
              "150290222"
            ]
          },
          "150290222": {
            "id": "150290222",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You mean, he never stopped trying to find new friends for you?",
            "nextDialogs": [
              "150290223"
            ]
          },
          "150290223": {
            "id": "150290223",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "...I knew exactly what he was doing. And, yeah, if I ever did share my memories with someone, I guess that person would be a friend. But, it never got to that point.",
            "nextDialogs": [
              "150290224"
            ]
          },
          "150290224": {
            "id": "150290224",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "This time, though, you win, Claw.",
            "nextDialogs": [
              "150290225"
            ]
          },
          "150290225": {
            "id": "150290225",
            "speakerId": 6249,
            "speakerName": "Tlapo",
            "text": "...",
            "nextDialogs": [
              "150290226"
            ]
          },
          "150290226": {
            "id": "150290226",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Take this. I guess... it's my response to what you told me the other night.",
            "nextDialogs": [
              "150290227"
            ]
          },
          "150290227": {
            "id": "150290227",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What is it?",
            "nextDialogs": [
              "150290228"
            ]
          },
          "150290228": {
            "id": "150290228",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "If I had to choose my color, it would be the color of this handkerchief.",
            "nextDialogs": [
              "150290229"
            ]
          },
          "150290229": {
            "id": "150290229",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Countless people exist in my memories, and I know one day, that will be my fate, too — a memory living on in someone else's head.",
            "nextDialogs": [
              "150290230"
            ]
          },
          "150290230": {
            "id": "150290230",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Since you have a long lifespan, you're the perfect candidate to bear this memory... and carry my color in your mind.",
            "nextDialogs": [
              "150290231"
            ]
          },
          "150290231": {
            "id": "150290231",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Does this mean I'm officially your friend?",
            "nextDialogs": [
              "150290232"
            ]
          },
          "150290232": {
            "id": "150290232",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "...Just keep it safe, and you better not forget my color when I'm gone.",
            "nextDialogs": [
              "150290233"
            ]
          },
          "150290233": {
            "id": "150290233",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, it's a little early to talk about death, don't you think? It's only been a few seconds since we made the friendship official...",
            "nextDialogs": [
              "150290234"
            ]
          },
          "150290234": {
            "id": "150290234",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Isn't that what friends are for?",
            "nextDialogs": [
              "150290235"
            ]
          },
          "150290235": {
            "id": "150290235",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Okay, this is a serious commitment... Well, Citlali, if {NICKNAME}'s going to leave their color in your mind, too, it'll probably be gold, right?",
            "nextDialogs": [
              "150290236"
            ]
          },
          "150290236": {
            "id": "150290236",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Actually, their mark is already there. Remember the mind-reading effect I couldn't fix? Well, I finally got to the bottom of it.",
            "nextDialogs": [
              "150290237"
            ]
          },
          "150290237": {
            "id": "150290237",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Sharing senses allows communication to occur between the consciousness of different people. Naturally, memories are also involved in that process.",
            "nextDialogs": [
              "150290238"
            ]
          },
          "150290238": {
            "id": "150290238",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Although I didn't know it at the time, we both have the ability to see the \"color of memory,\" which means that when I shared my senses with you, a connection was created between our memories.",
            "nextDialogs": [
              "150290239"
            ]
          },
          "150290239": {
            "id": "150290239",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "And that connection is what caused my original spell to go haywire...",
            "nextDialogs": [
              "150290240"
            ]
          },
          "150290240": {
            "id": "150290240",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#So... you can hear {NICKNAME}'s thoughts because you left traces of color in each other's memories?",
            "nextDialogs": [
              "150290241"
            ]
          },
          "150290241": {
            "id": "150290241",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#And that's why {NICKNAME} could hear your thoughts, too! Because it works both ways, right?",
            "nextDialogs": [
              "150290242"
            ]
          },
          "150290242": {
            "id": "150290242",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Quick thinking, but only those trained in the mystic arts can maintain that level of connection.",
            "nextDialogs": [
              "150290243"
            ]
          },
          "150290243": {
            "id": "150290243",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "#That's why I can still hear {NICKNAME}'s thoughts, but not the other way around.",
            "nextDialogs": [
              "150290244"
            ]
          },
          "150290244": {
            "id": "150290244",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "There's no need to worry, though. Now that I've figured out how it works, I'll get rid of it in no time.",
            "nextDialogs": [
              "150290245"
            ]
          },
          "150290245": {
            "id": "150290245",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh...",
            "nextDialogs": [
              "150290246"
            ]
          },
          "150290246": {
            "id": "150290246",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "(I lied — hearing each other's thoughts actually depends on the strength of the connection between our memories.)",
            "nextDialogs": [
              "150290247"
            ]
          },
          "150290247": {
            "id": "150290247",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "(So, after everything we just went through, I bet you can hear me again.)",
            "nextDialogs": [
              "150290248"
            ]
          },
          "150290248": {
            "id": "150290248",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(!)",
            "nextDialogs": [
              "150290249"
            ]
          },
          "150290249": {
            "id": "150290249",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "(I knew it...)",
            "nextDialogs": [
              "150290250"
            ]
          },
          "150290250": {
            "id": "150290250",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(So, is there a way to stop it?)",
            "nextDialogs": [
              "150290251"
            ]
          },
          "150290251": {
            "id": "150290251",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "(Since the connection between our memories is already there, the only way to get rid of the effect is for one of us to forget about the other.)",
            "nextDialogs": [
              "150290252"
            ]
          },
          "150290252": {
            "id": "150290252",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(...)",
            "nextDialogs": [
              "150290253"
            ]
          },
          "150290253": {
            "id": "150290253",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "(Heh, just messing with you... I'm a legendary shaman of my tribe, now that I know the cause, of course I can figure out how to fix it.)",
            "nextDialogs": [
              "150290254"
            ]
          },
          "150290254": {
            "id": "150290254",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "(It'll probably still take some time, though. So, bear with me for now.)",
            "nextDialogs": [
              "150290255"
            ]
          },
          "150290255": {
            "id": "150290255",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "(Besides, I'm an open book. It's not like you're gonna hear anything embarrassing... Oh, um, unless I've had a few drinks.)",
            "nextDialogs": [
              "150290257",
              "150290260"
            ]
          },
          "150290257": {
            "id": "150290257",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "(A shame? I mean, if you ever miss this whole telepathy mess, I could always share my senses with you again.)",
            "nextDialogs": [
              "150290258"
            ]
          },
          "150290258": {
            "id": "150290258",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "(No promises, though. Some thoughts are better kept to yourself.)",
            "nextDialogs": [
              "150290261"
            ]
          },
          "150290261": {
            "id": "150290261",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhh... Huh...?"
          },
          "150290260": {
            "id": "150290260",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "(Yeah, I get what you mean. Some thoughts are better kept to yourself.)"
          }
        }
      }
    },
    {
      "subId": "1502903",
      "subQuestName": "Wait until morning the next day (08:00 – 12:00)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1502904",
      "subQuestName": "Give the woven scroll to Chief Biram",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150290401"
        ],
        "dialogs": {
          "150290401": {
            "id": "150290401",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Ah, you did it? Your investigation into the Battle of Seven Colors must have been fruitful indeed. I do hope you share what you learned.",
            "nextDialogs": [
              "150290402"
            ]
          },
          "150290402": {
            "id": "150290402",
            "speakerId": 6251,
            "speakerName": "Caholom",
            "text": "Wow, the scroll is finished already!",
            "nextDialogs": [
              "150290403"
            ]
          },
          "150290403": {
            "id": "150290403",
            "speakerId": 14652,
            "speakerName": "Aywastin",
            "text": "Elder Tlapo's wisdom is never wrong!",
            "nextDialogs": [
              "150290404"
            ]
          },
          "150290404": {
            "id": "150290404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Yeah, we should explain... Take it away, {NICKNAME}!",
            "nextDialogs": [
              "150290405"
            ]
          },
          "150290405": {
            "id": "150290405",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You share everything you learned about the special color while keeping Citlali's contribution a secret.",
            "nextDialogs": [
              "150290406"
            ]
          },
          "150290406": {
            "id": "150290406",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "I see...",
            "nextDialogs": [
              "150290407"
            ]
          },
          "150290407": {
            "id": "150290407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You don't look surprised at all...",
            "nextDialogs": [
              "150290408"
            ]
          },
          "150290408": {
            "id": "150290408",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "It makes perfect sense! History is the memory of a people. If we want to depict it, a dye derived from people's memories is, of course, the best choice.",
            "nextDialogs": [
              "150290409"
            ]
          },
          "150290409": {
            "id": "150290409",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Now, it's just a matter of preserving this secret technique...",
            "nextDialogs": [
              "150290410"
            ]
          },
          "150290410": {
            "id": "150290410",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Hmm... From your description, it sounds like learning the technique requires the previous holder to share their memories?",
            "nextDialogs": [
              "150290411"
            ]
          },
          "150290411": {
            "id": "150290411",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, yeah...",
            "nextDialogs": [
              "150290412"
            ]
          },
          "150290412": {
            "id": "150290412",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "In that case, I must work with our priests to re-invent the technique based on the principles you described.",
            "nextDialogs": [
              "150290413"
            ]
          },
          "150290413": {
            "id": "150290413",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "#After all, memories are precious things — meant to be shared with those closest to us. I cannot take that choice away from you, {NICKNAME}.",
            "nextDialogs": [
              "150290414"
            ]
          },
          "150290414": {
            "id": "150290414",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "You completed your task admirably. Finding a way to carry on that legacy is now our duty.",
            "nextDialogs": [
              "150290415"
            ]
          },
          "150290415": {
            "id": "150290415",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright! We'll leave that to you!",
            "nextDialogs": [
              "150290416"
            ]
          },
          "150290416": {
            "id": "150290416",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Oh, and please pass along my thanks to Granny Itztli.",
            "nextDialogs": [
              "150290417"
            ]
          },
          "150290417": {
            "id": "150290417",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "We interrogated the Fontainian merchant she apprehended, and it turns out, he is the reason some among our tribe started to question our history.",
            "nextDialogs": [
              "150290418"
            ]
          },
          "150290418": {
            "id": "150290418",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "He hired people to spread misinformation about the Battle of Seven Colors. The recent friction within the tribe is entirely his doing.",
            "nextDialogs": [
              "150290419"
            ]
          },
          "150290419": {
            "id": "150290419",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "We now have a record of his crimes and will begin working with Fontaine authorities in a few days.",
            "nextDialogs": [
              "150290420"
            ]
          },
          "150290420": {
            "id": "150290420",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, he was behind the controversy in the first place! Guess it's easier to investigate when people are already questioning something...",
            "nextDialogs": [
              "150290421"
            ]
          },
          "150290421": {
            "id": "150290421",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, that clears it up! People don't just question their history out of nowhere.",
            "nextDialogs": [
              "150290422"
            ]
          },
          "150290422": {
            "id": "150290422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thank you, Biram. We'll be on our way.",
            "nextDialogs": [
              "150290423"
            ]
          },
          "150290423": {
            "id": "150290423",
            "speakerId": 6250,
            "speakerName": "Biram",
            "text": "Until we meet again."
          }
        }
      }
    },
    {
      "subId": "1502905",
      "subQuestName": "Explain the situation to Citlali",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150290501"
        ],
        "dialogs": {
          "150290501": {
            "id": "150290501",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "You told him everything, right?",
            "nextDialogs": [
              "150290502"
            ]
          },
          "150290502": {
            "id": "150290502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yep! We left out the part about your contribution, but it kinda seemed like Chief Biram saw through us...",
            "nextDialogs": [
              "150290503"
            ]
          },
          "150290503": {
            "id": "150290503",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "You could have just said it was a \"gift from the spirits\"...",
            "nextDialogs": [
              "150290504"
            ]
          },
          "150290504": {
            "id": "150290504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yeah, but Chief Biram deserved something in return for his hard work.",
            "nextDialogs": [
              "150290505"
            ]
          },
          "150290505": {
            "id": "150290505",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "...I guess he is different from the previous chiefs. But, if he figures out it was me all these years, I'm in for a world of trouble.",
            "nextDialogs": [
              "150290506"
            ]
          },
          "150290506": {
            "id": "150290506",
            "speakerId": 14648,
            "speakerName": "Allier",
            "text": "There you are! I've been looking everywhere for you!",
            "nextDialogs": [
              "150290507"
            ]
          },
          "150290507": {
            "id": "150290507",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, it's the other Fontainian researcher... He wasn't taken away with his boss?",
            "nextDialogs": [
              "150290508"
            ]
          },
          "150290508": {
            "id": "150290508",
            "speakerId": 14648,
            "speakerName": "Allier",
            "text": "Please, call me Allier... After questioning, the tribe absolved me of any serious wrongdoing, so here I am.",
            "nextDialogs": [
              "150290509"
            ]
          },
          "150290509": {
            "id": "150290509",
            "speakerId": 14648,
            "speakerName": "Allier",
            "text": "I'll be heading back to Fontaine soon — no employer means no funding, after all. But, I wanted to finish my investigation first.",
            "nextDialogs": [
              "150290510"
            ]
          },
          "150290510": {
            "id": "150290510",
            "speakerId": 14648,
            "speakerName": "Allier",
            "text": "I'd like to ask some questions about Huitzilin. I want people outside of Natlan to hear her story, but my understanding still has some holes.",
            "nextDialogs": [
              "150290511"
            ]
          },
          "150290511": {
            "id": "150290511",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Questions? Hmph... Why should I let an outlander tell our stories?",
            "nextDialogs": [
              "150290512"
            ]
          },
          "150290512": {
            "id": "150290512",
            "speakerId": 14648,
            "speakerName": "Allier",
            "text": "Don't misunderstand — I have no intention of twisting your history or using it to make a profit. It's just honest curiosity, I assure you.",
            "nextDialogs": [
              "150290513"
            ]
          },
          "150290513": {
            "id": "150290513",
            "speakerId": 14648,
            "speakerName": "Allier",
            "text": "I believe amazing stories deserve to be shared with the world. Culture thrives through dialogue and exchange.",
            "nextDialogs": [
              "150290514"
            ]
          },
          "150290514": {
            "id": "150290514",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "He has a point.",
            "nextDialogs": [
              "150290515"
            ]
          },
          "150290515": {
            "id": "150290515",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Alright, you can ask your questions, but be quick. I have important plans after this.",
            "nextDialogs": [
              "150290516"
            ]
          },
          "150290516": {
            "id": "150290516",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Important plans?",
            "nextDialogs": [
              "150290517"
            ]
          },
          "150290517": {
            "id": "150290517",
            "speakerId": 14648,
            "speakerName": "Allier",
            "text": "Thank you very much!",
            "nextDialogs": [
              "150290518"
            ]
          },
          "150290518": {
            "id": "150290518",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Allier conducts a thorough interview, only leaving when Citlali finally runs out of patience.",
            "nextDialogs": [
              "150290519"
            ]
          },
          "150290519": {
            "id": "150290519",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Another day, another drained social battery...",
            "nextDialogs": [
              "150290520"
            ]
          },
          "150290520": {
            "id": "150290520",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We should probably get going, then.",
            "nextDialogs": [
              "150290521"
            ]
          },
          "150290521": {
            "id": "150290521",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Mhm... Ah, hold on — you owe me a pair of books!",
            "nextDialogs": [
              "150290522"
            ]
          },
          "150290522": {
            "id": "150290522",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, that... When it comes to light novels, your memory is like a steel trap, huh...",
            "nextDialogs": [
              "150290523"
            ]
          },
          "150290523": {
            "id": "150290523",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Books that rare will take some time to find...",
            "nextDialogs": [
              "150290524"
            ]
          },
          "150290524": {
            "id": "150290524",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "You're telling me... Yeah, it's not gonna be easy — you might need to go to Yae Publishing House in person...",
            "nextDialogs": [
              "150290525"
            ]
          },
          "150290525": {
            "id": "150290525",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "But, I don't need them right away. Just don't forget, okay?",
            "nextDialogs": [
              "150290526"
            ]
          },
          "150290526": {
            "id": "150290526",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Of course! We'll get them sent to you as soon as we can!",
            "nextDialogs": [
              "150290527"
            ]
          },
          "150290527": {
            "id": "150290527",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "Sent to me...? Nuh-uh, I don't want a stranger knocking on my door when I'm hungover. Here, just take this.",
            "nextDialogs": [
              "150290528"
            ]
          },
          "150290528": {
            "id": "150290528",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And this is...?",
            "nextDialogs": [
              "150290529"
            ]
          },
          "150290529": {
            "id": "150290529",
            "speakerId": 1096,
            "speakerName": "Citlali",
            "text": "The key to my house. Don't bother knocking next time — you'll disturb my sleep."
          }
        }
      }
    },
    {
      "subId": "1502950",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

  "subQuests": [
    {
      "subId": "7055201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705520101"
        ],
        "dialogs": {
          "705520101": {
            "id": "705520101",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Huh? So you're looking after the drinks stand now... If I'd known sooner, I would have stopped by this morning!",
            "nextDialogs": [
              "705520104"
            ]
          },
          "705520104": {
            "id": "705520104",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "I've got to say, I'm getting curious. I've heard a lot about your mixology skills.",
            "nextDialogs": [
              "705520105"
            ]
          },
          "705520105": {
            "id": "705520105",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "I wonder what kinds of drinks you can mix with the ingredients Glenfidia has prepared?"
          }
        }
      }
    },
    {
      "subId": "7055203",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705520301"
        ],
        "dialogs": {
          "705520301": {
            "id": "705520301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Here's your all-new \"Seafoam Swordsong,\" mixed to meet your personal preferences!",
            "nextDialogs": [
              "705520302"
            ]
          },
          "705520302": {
            "id": "705520302",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Oh my, what beautiful colors! And you even added my Romaritime Flower Fruit Extract!",
            "nextDialogs": [
              "705520303"
            ]
          },
          "705520303": {
            "id": "705520303",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "The aroma is perfect, and I can smell the alcohol, but it doesn't stifle the fruity fragrance... Let's see how it tastes!",
            "nextDialogs": [
              "705520304"
            ]
          },
          "705520304": {
            "id": "705520304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Can't wait to hear what you think!",
            "nextDialogs": [
              "705520305"
            ]
          },
          "705520305": {
            "id": "705520305",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Phew, give me a moment to... *hic*... come up with the right words. I need to think carefully...",
            "nextDialogs": [
              "705520306"
            ]
          },
          "705520306": {
            "id": "705520306",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "I know it's unbecoming of a lady, and a proper connoisseur would savor their drinks slowly...",
            "nextDialogs": [
              "705520307"
            ]
          },
          "705520307": {
            "id": "705520307",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "But... I'm sorry, this is just... too good to be true!",
            "nextDialogs": [
              "705520308"
            ]
          },
          "705520308": {
            "id": "705520308",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "...Can you mix me another?",
            "nextDialogs": [
              "705520311"
            ]
          },
          "705520311": {
            "id": "705520311",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "And so Eula, lost in friendly conversation, drank three Seafoam Swordsongs without even realizing it...",
            "nextDialogs": [
              "705520312"
            ]
          },
          "705520312": {
            "id": "705520312",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Ah... Ahahaha... Oh no, w—what was I going to say... I've completely lost my train of thought, haha...",
            "nextDialogs": [
              "705520313"
            ]
          },
          "705520313": {
            "id": "705520313",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Ah, whatever, I feel fantastic! This cocktail... It's the best I've ever had!",
            "nextDialogs": [
              "705520314"
            ]
          },
          "705520314": {
            "id": "705520314",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Ah... I... I think I'm gonna head home and get some sleep..."
          }
        }
      }
    },
    {
      "subId": "7055206",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705520201"
        ],
        "dialogs": {
          "705520201": {
            "id": "705520201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "One Twinkling Starlight for Captain Eula. Hope you like it!",
            "nextDialogs": [
              "705520202"
            ]
          },
          "705520202": {
            "id": "705520202",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Judging by your confident tone, I'm certain I will. Well then, I'll make sure to savor this thoroughly...",
            "nextDialogs": [
              "705520203"
            ]
          },
          "705520203": {
            "id": "705520203",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Huh? Not bad!",
            "nextDialogs": [
              "705520204"
            ]
          },
          "705520204": {
            "id": "705520204",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Sweet and tingly, with a delightful airiness. The fizzy water really brings it to life...",
            "nextDialogs": [
              "705520205"
            ]
          },
          "705520205": {
            "id": "705520205",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "I suddenly feel full of vim and vigor, but just one glass doesn't quite scratch the itch... How about something with a bit more bite?",
            "nextDialogs": [
              "705520208"
            ]
          },
          "705520208": {
            "id": "705520208",
            "speakerId": 1029,
            "speakerName": "Eula",
            "text": "Hah, don't hold back. You don't need to worry about putting me on the floor with nothing but a couple of drinks!"
          }
        }
      }
    }
  ]
}
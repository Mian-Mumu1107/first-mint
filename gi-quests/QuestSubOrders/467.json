  "subQuests": [
    {
      "subId": "46701",
      "subQuestName": "Pass by the pot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4670101"
        ],
        "dialogs": {
          "4670101": {
            "id": "4670101",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "What should I cook next...?",
            "nextDialogs": [
              "4670102"
            ]
          },
          "4670102": {
            "id": "4670102",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "Oh, are you travelers from around here as well?",
            "nextDialogs": [
              "4670103"
            ]
          },
          "4670103": {
            "id": "4670103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "No, we just happen to be passing by. *sniff* *sniff* What are you cooking? Smells good!",
            "nextDialogs": [
              "4670104"
            ]
          },
          "4670104": {
            "id": "4670104",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "I see. Welcome, travelers!",
            "nextDialogs": [
              "4670105"
            ]
          },
          "4670105": {
            "id": "4670105",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "I'm Lynn, the survival expert of the Adventurers' Guild. As you can see, I'm experimenting with some new recipes.",
            "nextDialogs": [
              "4670106"
            ]
          },
          "4670106": {
            "id": "4670106",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "\"Eat before you go\" — The first rule in the \"Wilderness Survival Guide.\"",
            "nextDialogs": [
              "4670107"
            ]
          },
          "4670107": {
            "id": "4670107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A picnic! Oh, Paimon just loves picnics!",
            "nextDialogs": [
              "4670108"
            ]
          },
          "4670108": {
            "id": "4670108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "My travel partner here is good at cooking as well!",
            "nextDialogs": [
              "4670802",
              "4670902"
            ]
          },
          "4670802": {
            "id": "4670802",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "That's okay. Let's see what you can do!",
            "nextDialogs": [
              "4670803"
            ]
          },
          "4670803": {
            "id": "4670803",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "You won't get a lot of chances like this to learn from a survival expert!",
            "nextDialogs": [
              "4671001"
            ]
          },
          "4671001": {
            "id": "4671001",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "There are some Mushrooms and meat in the barrel over there. Try making a <color=#00E1FFFF>Chicken-Mushroom Skewer</color> for me."
          },
          "4670902": {
            "id": "4670902",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "Oh, there's a cooking pot right here. Show me what you got!",
            "nextDialogs": [
              "4670903"
            ]
          },
          "4670903": {
            "id": "4670903",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "It's good to have someone to practice with."
          }
        }
      }
    },

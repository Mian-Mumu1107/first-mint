            ]
          },
          "4670305": {
            "id": "4670305",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "Wow...",
            "nextDialogs": [
              "4670306"
            ]
          },
          "4670306": {
            "id": "4670306",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ahh... Uh oh...",
            "nextDialogs": [
              "4670307"
            ]
          },
          "4670307": {
            "id": "4670307",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "The taste is... hard to describe. A borderline pass!",
            "nextDialogs": [
              "4670308"
            ]
          },
          "4670308": {
            "id": "4670308",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#What? {NICKNAME} can do better. That doesn't count!",
            "nextDialogs": [
              "4670309"
            ]
          },
          "4670309": {
            "id": "4670309",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "You have great potential. All you need is more practice.",
            "nextDialogs": [
              "4670310"
            ]
          },
          "4670310": {
            "id": "4670310",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "Oh. I've got some raw ingredients in my bag. Have them in return for this meal.",
            "nextDialogs": [
              "4670311"
            ]
          },
          "4670311": {
            "id": "4670311",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Can we really have them? Won't you run out of ingredients?",
            "nextDialogs": [
              "4670312"
            ]
          },
          "4670312": {
            "id": "4670312",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "That's okay. You should be able to find lots of ingredients when <color=#00E1FFFF>exploring the wilderness</color>. Don't forget to look carefully.",
            "nextDialogs": [
              "4670313"
            ]
          },
          "4670313": {
            "id": "4670313",
            "speakerId": 1000,
            "speakerName": "Lynn",
            "text": "There's also a restaurant in Mondstadt known as <color=#00E1FFFF>Good Hunter</color> that sells food and ingredients. Go have a look when you've got the time.",
            "nextDialogs": [
              "4670314"
            ]
          },
          "4670314": {
            "id": "4670314",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Okay, thank you for the info. *gasp* Hey! Leave some Chicken-Mushroom Skewers for Paimon!"
          }
        }
      }
    },

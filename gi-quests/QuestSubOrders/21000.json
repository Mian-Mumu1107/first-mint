    {
      "subId": "2100001",
      "subQuestName": "Talk to Little Meng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210000101"
        ],
        "dialogs": {
          "210000101": {
            "id": "210000101",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "*sigh* Can I really do this?",
            "nextDialogs": [
              "210000102"
            ]
          },
          "210000102": {
            "id": "210000102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong, Little Meng?",
            "nextDialogs": [
              "210000103"
            ]
          },
          "210000103": {
            "id": "210000103",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Oh, it's you, Traveler. How do you do?",
            "nextDialogs": [
              "210000104"
            ]
          },
          "210000104": {
            "id": "210000104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You look kinda upset, Little Meng.",
            "nextDialogs": [
              "210000105"
            ]
          },
          "210000105": {
            "id": "210000105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's the matter? Did the other kids stop playing that, uh, pirate game with you?",
            "nextDialogs": [
              "210000106"
            ]
          },
          "210000106": {
            "id": "210000106",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Eh? No, no. Little Lulu and Little Fei have just gone home, that's all.",
            "nextDialogs": [
              "210000107"
            ]
          },
          "210000107": {
            "id": "210000107",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "I... wanted to have a little walk by myself, so I haven't gone back yet.",
            "nextDialogs": [
              "210000108"
            ]
          },
          "210000108": {
            "id": "210000108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Won't your parents be worried?",
            "nextDialogs": [
              "210000109"
            ]
          },
          "210000109": {
            "id": "210000109",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "They should still be at work.",
            "nextDialogs": [
              "210000110"
            ]
          },
          "210000110": {
            "id": "210000110",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "But let's not talk about that right now. Can I ask you a question?",
            "nextDialogs": [
              "210000114",
              "210000113"
            ]
          },
          "210000114": {
            "id": "210000114",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "So... I've heard lots of people tell stories about you.",
            "nextDialogs": [
              "210000115"
            ]
          },
          "210000115": {
            "id": "210000115",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "You've been to so many places and you've seen so much, so perhaps you can give me an answer...",
            "nextDialogs": [
              "210000116"
            ]
          },
          "210000116": {
            "id": "210000116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, you're getting all serious now. What's the question?",
            "nextDialogs": [
              "210000117"
            ]
          },
          "210000117": {
            "id": "210000117",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "I'd like to ask...",
            "nextDialogs": [
              "210000118"
            ]
          },
          "210000118": {
            "id": "210000118",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "How does someone \"mature\"?"
          },
          "210000113": {
            "id": "210000113",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Hahaha, I only play that game with Little Lulu and Little Fei. Since they're not around, the game is off for sure."
          }
        }
      }
    },
    {
      "subId": "2100002",
      "subQuestName": "Head over to Bishui River",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210000201"
        ],
        "dialogs": {
          "210000201": {
            "id": "210000201",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Are we there yet? Hmm... We've got to pick a good spot to send our bottle off.",
            "nextDialogs": [
              "210000202"
            ]
          },
          "210000202": {
            "id": "210000202",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "We should find an upstream position if we want it to go out further..."
          }
        }
      }
    },

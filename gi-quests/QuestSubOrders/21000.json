    {
      "subId": "2100007",
      "subQuestName": "Talk to Little Meng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210000301"
        ],
        "dialogs": {
          "210000301": {
            "id": "210000301",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "What the... To think that these things existed... That was scary!",
            "nextDialogs": [
              "210000302"
            ]
          },
          "210000302": {
            "id": "210000302",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Thank you so much! C'mon, let's continue.",
            "nextDialogs": [
              "210000303"
            ]
          },
          "210000303": {
            "id": "210000303",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "...Wait. Where's my drifting bottle? I was just holding onto it, but now it's gone!",
            "nextDialogs": [
              "210000304"
            ]
          },
          "210000304": {
            "id": "210000304",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Did I drop it while we were fighting that... that Whopperflower?",
            "nextDialogs": [
              "210000305"
            ]
          },
          "210000305": {
            "id": "210000305",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Please, help me find it!"
          }
        }
      }
    },

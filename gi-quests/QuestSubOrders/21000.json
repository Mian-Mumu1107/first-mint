    {
      "subId": "2100005",
      "subQuestName": "Check the Sweet Flower",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210000501"
        ],
        "dialogs": {
          "210000501": {
            "id": "210000501",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Phew... I was up all night writing that message. If we'd lost the bottle, I'd have to write it all over again...",
            "nextDialogs": [
              "210000502"
            ]
          },
          "210000502": {
            "id": "210000502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, an all-nighter? You sure have a lot of worries, huh?",
            "nextDialogs": [
              "210000503"
            ]
          },
          "210000503": {
            "id": "210000503",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Well... not really? I just really want to know how I can become mature.",
            "nextDialogs": [
              "210000504"
            ]
          },
          "210000504": {
            "id": "210000504",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "I've looked at lots of sources and read a ton of books, but the more I read, the less I understand...",
            "nextDialogs": [
              "210000505"
            ]
          },
          "210000505": {
            "id": "210000505",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Hehe, and that's why I wrote all the questions I don't understand into that message, in hopes that I'd get an answer.",
            "nextDialogs": [
              "210000506"
            ]
          },
          "210000506": {
            "id": "210000506",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "C'mon! Let's send our bottle off!"
          }
        }
      }
    },
    {
      "subId": "2100006",
      "subQuestName": "Defeat the Whopperflower",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210000601"
        ],
        "dialogs": {
          "210000601": {
            "id": "210000601",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "This looks like a good spot. Let's put the bottle in the water here.",
            "nextDialogs": [
              "210000602"
            ]
          },
          "210000602": {
            "id": "210000602",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "I hope I'll get my answers...",
            "nextDialogs": [
              "210000603"
            ]
          },
          "210000603": {
            "id": "210000603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You will.",
            "nextDialogs": [
              "210000604"
            ]
          },
          "210000604": {
            "id": "210000604",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Thanks! Alright then, let's head back into the city.",
            "nextDialogs": [
              "210000605"
            ]
          },
          "210000605": {
            "id": "210000605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Still, will Little Meng's questions really be resolved with a little bottle floating down the river?",
            "nextDialogs": [
              "210000606"
            ]
          },
          "210000606": {
            "id": "210000606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Perhaps this is just his way of comforting himself.",
            "nextDialogs": [
              "210000607"
            ]
          },
          "210000607": {
            "id": "210000607",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really? Paimon feels like there's a lot he's not telling us...",
            "nextDialogs": [
              "210000608"
            ]
          },
          "210000608": {
            "id": "210000608",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But come to think of it, this whole maturity thing is pretty tricky, huh?"
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "7306701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730670101"
        ],
        "dialogs": {
          "730670101": {
            "id": "730670101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? These hilichurls dropped something strange...",
            "nextDialogs": [
              "730670102"
            ]
          },
          "730670102": {
            "id": "730670102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It seems to be made out of flowers. Weird, but these flowers are ordinary and were picked quite some time ago, yet they still haven't wilted.",
            "nextDialogs": [
              "730670103"
            ]
          },
          "730670103": {
            "id": "730670103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon can sense quite a lot of Dendro energy on it, and it's been discarded here, too...",
            "nextDialogs": [
              "730670105",
              "730670107"
            ]
          },
          "730670105": {
            "id": "730670105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yeah, must be.",
            "nextDialogs": [
              "730670108"
            ]
          },
          "730670108": {
            "id": "730670108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, this flower thing has so much Dendro energy that it didn't even wither in the hands of the hilichurls."
          },
          "730670107": {
            "id": "730670107",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What are you saying? It must be from an Aranara who lives here."
          }
        }
      }
    },
    {
      "subId": "7306702",
      "subQuestName": "Defeat the hilichurls by the Aranara house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730670201"
        ],
        "dialogs": {
          "730670201": {
            "id": "730670201",
            "speakerId": 1001,
            "speakerName": "Inconsistently-Written Notes",
            "text": "(The first few pages contain very small and scribbled writing...)",
            "nextDialogs": [
              "730670202"
            ]
          },
          "730670202": {
            "id": "730670202",
            "speakerId": 1001,
            "speakerName": "Inconsistently-Written Notes",
            "text": "\"Ohhh... I can't believe there is a Nara willing to be Arashakun's friend. What a good Nara! The good Nara didn't mind timid Arashakun, and even taught Arashakun how to write Nara words...\"",
            "nextDialogs": [
              "730670203"
            ]
          },
          "730670203": {
            "id": "730670203",
            "speakerId": 1001,
            "speakerName": "Inconsistently-Written Notes",
            "text": "\"...Good Nara comforted Arashakun when Arashakun was frightened by a leaf that fell on his head. Good Nara is Arashakun's friend forever!\"",
            "nextDialogs": [
              "730670204"
            ]
          },
          "730670204": {
            "id": "730670204",
            "speakerId": 1001,
            "speakerName": "Inconsistently-Written Notes",
            "text": "(The handwriting becomes tinier and more flustered in the following pages...)",
            "nextDialogs": [
              "730670205"
            ]
          },
          "730670205": {
            "id": "730670205",
            "speakerId": 1001,
            "speakerName": "Inconsistently-Written Notes",
            "text": "\"Oh no... Nara friend was taken by Furry Mask Demon King! It has such long arms. So scary...\"",
            "nextDialogs": [
              "730670206"
            ]
          },
          "730670206": {
            "id": "730670206",
            "speakerId": 1001,
            "speakerName": "Inconsistently-Written Notes",
            "text": "\"But... must save Nara... Ohh...\"",
            "nextDialogs": [
              "730670207"
            ]
          },
          "730670207": {
            "id": "730670207",
            "speakerId": 1001,
            "speakerName": "Inconsistently-Written Notes",
            "text": "(The following pages are written in big, forceful handwriting...)",
            "nextDialogs": [
              "730670208"
            ]
          },
          "730670208": {
            "id": "730670208",
            "speakerId": 1001,
            "speakerName": "Inconsistently-Written Notes",
            "text": "\"The Furry Mask Demon King has been defeated! Saved Nara friend, and Nara friend gave Arashakun 'courage'! Arashakun is not the same old timid Arashakun anymore.\"",
            "nextDialogs": [
              "730670209"
            ]
          },
          "730670209": {
            "id": "730670209",
            "speakerId": 1001,
            "speakerName": "Inconsistently-Written Notes",
            "text": "\"Arashakun has 'courage' now and bravely fought the furry masked monsters. No Nara nearby will ever have to worry about getting bullied by the furry masked monsters again!\"",
            "nextDialogs": [
              "730670210"
            ]
          },
          "730670210": {
            "id": "730670210",
            "speakerId": 1001,
            "speakerName": "Inconsistently-Written Notes",
            "text": "(The handwriting shrinks back down in the latest pages...)",
            "nextDialogs": [
              "730670211"
            ]
          },
          "730670211": {
            "id": "730670211",
            "speakerId": 1001,
            "speakerName": "Inconsistently-Written Notes",
            "text": "\"Oh no... How did this happen? Arashakun's 'courage' is missing... The 'courage' Nara gave to Arashakun... It must have been stolen by the Furry Mask Demon King.\"",
            "nextDialogs": [
              "730670212"
            ]
          },
          "730670212": {
            "id": "730670212",
            "speakerId": 1001,
            "speakerName": "Inconsistently-Written Notes",
            "text": "\"Furry Mask Demon King, arms very long, very scary. But Arashakun can do nothing after losing his 'courage'... Arashakun will go looking for it in <color=#00E1FFFF>the cave to the east</color>...\""
          }
        }
      }
    },
    {
      "subId": "7306715",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7306704",
      "subQuestName": "Enter the Aranara house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730670401"
        ],
        "dialogs": {
          "730670401": {
            "id": "730670401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Are you Arashakun?",
            "nextDialogs": [
              "730670402"
            ]
          },
          "730670402": {
            "id": "730670402",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "*sob*... Arashakun is indeed my name... Eek, don't come so close so quickly!",
            "nextDialogs": [
              "730670403"
            ]
          },
          "730670403": {
            "id": "730670403",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "Arashakun's very grateful to you two for saving me, but I must still request that you keep a certain distance... *sob*",
            "nextDialogs": [
              "730670404"
            ]
          },
          "730670404": {
            "id": "730670404",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "That will make Arashakun feel a bit more comfortable...",
            "nextDialogs": [
              "730670405"
            ]
          },
          "730670405": {
            "id": "730670405",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What? We just rescued you!",
            "nextDialogs": [
              "730670406"
            ]
          },
          "730670406": {
            "id": "730670406",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "I'm sorry! Sorry for my rude request. Sorry for angering you...",
            "nextDialogs": [
              "730670407"
            ]
          },
          "730670407": {
            "id": "730670407",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "But I've been trapped here and am still... I—I haven't settled down yet. *sob* Please forgive me...",
            "nextDialogs": [
              "730670408"
            ]
          },
          "730670408": {
            "id": "730670408",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's okay, it's okay...",
            "nextDialogs": [
              "730670409"
            ]
          },
          "730670409": {
            "id": "730670409",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "Okay, thank you. May Arashakun get your names?",
            "nextDialogs": [
              "730670410"
            ]
          },
          "730670410": {
            "id": "730670410",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It's Paimon.",
            "nextDialogs": [
              "730670411"
            ]
          },
          "730670411": {
            "id": "730670411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#I'm {NICKNAME}.",
            "nextDialogs": [
              "730670412"
            ]
          },
          "730670412": {
            "id": "730670412",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "#Golden Nara {NICKNAME} and Paimon... So, how come you know Arashakun's name?",
            "nextDialogs": [
              "730670413"
            ]
          },
          "730670413": {
            "id": "730670413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We read the journal in the house.",
            "nextDialogs": [
              "730670414"
            ]
          },
          "730670414": {
            "id": "730670414",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "#Golden-haired Nara {NICKNAME} read the journal and came looking for Arashakun? Then rescued trapped Arashakun? Nara is so kind and so powerful.",
            "nextDialogs": [
              "730670415"
            ]
          },
          "730670415": {
            "id": "730670415",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "*sob* If Arashakun hadn't lost \"courage,\" Arashakun wouldn't have been so helpless...",
            "nextDialogs": [
              "730670416"
            ]
          },
          "730670416": {
            "id": "730670416",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "We read about that in the journal. What did you mean by missing \"courage,\" Arashakun?",
            "nextDialogs": [
              "730670417"
            ]
          },
          "730670417": {
            "id": "730670417",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "This is a story from long, long ago...",
            "nextDialogs": [
              "730670418"
            ]
          },
          "730670418": {
            "id": "730670418",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "Many moons ago, Arashakun was just like the Arashakun now, without \"courage.\" Back then, even the sound of a twig snapping would keep Arashakun up at night...",
            "nextDialogs": [
              "730670419"
            ]
          },
          "730670419": {
            "id": "730670419",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "But even timid Arashakun had a Nara friend for a companion. That Nara friend was no mighty Nara Varuna, but was still a very good Nara!",
            "nextDialogs": [
              "730670420"
            ]
          },
          "730670420": {
            "id": "730670420",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "He never teased timid Arashakun. When Arashakun felt scared, he would hold Arashakun's hand. He was a friend Arashakun would never forget.",
            "nextDialogs": [
              "730670421"
            ]
          },
          "730670421": {
            "id": "730670421",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "But one day, that Nara was taken by the Furry Mask Demon King...",
            "nextDialogs": [
              "730670422"
            ]
          },
          "730670422": {
            "id": "730670422",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, what's this Furry Mask Demon King you speak of?",
            "nextDialogs": [
              "730670423"
            ]
          },
          "730670423": {
            "id": "730670423",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "Furry Mask Demon King is a furry demon king wearing a mask.",
            "nextDialogs": [
              "730670424"
            ]
          },
          "730670424": {
            "id": "730670424",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Uh, yeah, sure...",
            "nextDialogs": [
              "730670426",
              "730670428"
            ]
          },
          "730670426": {
            "id": "730670426",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "There's no way Paimon would know that...",
            "nextDialogs": [
              "730670429"
            ]
          },
          "730670429": {
            "id": "730670429",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But the Furry Mask Demon King captured Arashakun's friend.",
            "nextDialogs": [
              "730670430"
            ]
          },
          "730670430": {
            "id": "730670430",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "The Furry Mask Demon King was very cunning. Just thinking about it makes Arashakun shudder.",
            "nextDialogs": [
              "730670431"
            ]
          },
          "730670431": {
            "id": "730670431",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "*sob*... When Nara friend was taken, Arashakun was afraid of getting beat up by the Furry Mask Demon King, but was even more terrified of never seeing Nara friend again.",
            "nextDialogs": [
              "730670432"
            ]
          },
          "730670432": {
            "id": "730670432",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "So Arashakun tried very hard! Closed eyes! Gritted teeth! Used hands and hit, and hit, and hit! Then saved Nara friend.",
            "nextDialogs": [
              "730670433"
            ]
          },
          "730670433": {
            "id": "730670433",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "After that, Nara friend used flowers to make a \"Talisman of Courage\" and told Arashakun, \"Arashakun is a good Aranara with courage, not a timid Aranara!\"",
            "nextDialogs": [
              "730670434"
            ]
          },
          "730670434": {
            "id": "730670434",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "So from then on, Arashakun had \"courage.\"",
            "nextDialogs": [
              "730670435"
            ]
          },
          "730670435": {
            "id": "730670435",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But wasn't \"Closed eyes! Gritted teeth! Used hands and hit, and hit, and hit!\" very courageous?",
            "nextDialogs": [
              "730670436"
            ]
          },
          "730670436": {
            "id": "730670436",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "No. Arashakun only had \"courage\" after getting it from Nara friend.",
            "nextDialogs": [
              "730670437"
            ]
          },
          "730670437": {
            "id": "730670437",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But your act to save your friend was already brave.",
            "nextDialogs": [
              "730670438"
            ]
          },
          "730670438": {
            "id": "730670438",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "No, no, no. Arashakun was so scared when saving Nara friend. Arms and legs, all shaky. But after getting \"courage,\" Arashakun's arms and legs were not weak anymore.",
            "nextDialogs": [
              "730670439"
            ]
          },
          "730670439": {
            "id": "730670439",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ah..."
          },
          "730670428": {
            "id": "730670428",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon has no clue what this Furry Mask Demon King could be..."
          }
        }
      }
    },
    {
      "subId": "7306705",
      "subQuestName": "Search the Aranara house for clues",
      "sceneId": null,
      "locations": [],
      "dialogue": {

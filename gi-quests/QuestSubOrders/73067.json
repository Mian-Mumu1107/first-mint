      }
    },
    {
      "subId": "7306714",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730670301"
        ],
        "dialogs": {
          "730670301": {
            "id": "730670301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Uh, so, is \"Arashakun\" the Aranara who wrote all this?",
            "nextDialogs": [
              "730670302"
            ]
          },
          "730670302": {
            "id": "730670302",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "The writing in this journal is big at times and real tiny at others. The big letters are fine, but...",
            "nextDialogs": [
              "730670303"
            ]
          },
          "730670303": {
            "id": "730670303",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Gotta say, the small ones hurt Paimon's eyes a little.",
            "nextDialogs": [
              "730670304"
            ]
          },
          "730670304": {
            "id": "730670304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Our little Paimon's having trouble reading those small letters?",
            "nextDialogs": [
              "730670305"
            ]
          },
          "730670305": {
            "id": "730670305",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, Paimon reads letters in normal size just fine, thank you! Paimon's just not used to reading tiny letters, that's all!",
            "nextDialogs": [
              "730670306"
            ]
          },
          "730670306": {
            "id": "730670306",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, did this Arashakun not return after writing these most recent pages...?",
            "nextDialogs": [
              "730670307"
            ]
          },
          "730670307": {
            "id": "730670307",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Let's check out that cave in the east. The journal said that his courage is missing... Can \"courage\" really go missing? Paimon's curious..."
          }
        }
      }
    },
    {
      "subId": "7306706",
      "subQuestName": "Find Arashakun in the cave",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730670601"
        ],
        "dialogs": {
          "730670601": {
            "id": "730670601",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "Yes, this is it, this is it!",
            "nextDialogs": [
              "730670602"
            ]
          },
          "730670602": {
            "id": "730670602",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "This is the \"Talisman of Courage\"! The flower has faded a bit after being apart from Arashakun for a few days...",
            "nextDialogs": [
              "730670603"
            ]
          },
          "730670603": {
            "id": "730670603",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "But it's okay! Arashakun will guard it well from now on!",
            "nextDialogs": [
              "730670604"
            ]
          },
          "730670604": {
            "id": "730670604",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "\"Arashakun is a good Aranara with courage, not a timid Aranara!\"",
            "nextDialogs": [
              "730670605"
            ]
          },
          "730670605": {
            "id": "730670605",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "#Thank you so much, Nara {NICKNAME} and Paimon!",
            "nextDialogs": [
              "730670606"
            ]
          },
          "730670606": {
            "id": "730670606",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "Arashakun now has \"courage\" back. Nothing can stop me! I beat Furry Mask Demon King once before and I shall do it again!",
            "nextDialogs": [
              "730670607"
            ]
          },
          "730670607": {
            "id": "730670607",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "(Whoa, Arashakun's attitude and tone are completely different now.)",
            "nextDialogs": [
              "730670608"
            ]
          },
          "730670608": {
            "id": "730670608",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "#The Furry Mask Demon King has done a lot of evil things. Please come with me, Nara {NICKNAME} and Paimon. With your help, we'll defeat it for sure!",
            "nextDialogs": [
              "730670609"
            ]
          },
          "730670609": {
            "id": "730670609",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "Arashakun can feel it. Today... will be the day it meets its end!",
            "nextDialogs": [
              "730670610"
            ]
          },
          "730670610": {
            "id": "730670610",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Okay then, {NICKNAME}, let's go and see what on earth that Furry Mask Demon King is supposed to be!"
          }
        }
      }
    },
    {
      "subId": "7306707",
      "subQuestName": "Defeat the monsters besieging the Aranara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730670701"
        ],
        "dialogs": {
          "730670701": {
            "id": "730670701",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon had her guesses... But as it turns out, the Furry Mask Demon King really was a hilichurl all along.",
            "nextDialogs": [
              "730670702"
            ]
          },
          "730670702": {
            "id": "730670702",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "A hilichurl?",
            "nextDialogs": [
              "730670703"
            ]
          },
          "730670703": {
            "id": "730670703",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yes, the \"Furry Mask Demon King\" is actually a hilichurl.",
            "nextDialogs": [
              "730670704"
            ]
          },
          "730670704": {
            "id": "730670704",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "Are all Hillychuchu \"Furry Mask Demon Kings\"?",
            "nextDialogs": [
              "730670705"
            ]
          },
          "730670705": {
            "id": "730670705",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Uh, no...",
            "nextDialogs": [
              "730670706"
            ]
          },
          "730670706": {
            "id": "730670706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But that's all you need to know, Arashakun.",
            "nextDialogs": [
              "730670707"
            ]
          },
          "730670707": {
            "id": "730670707",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "Okay, Arashakun understands.",
            "nextDialogs": [
              "730670708"
            ]
          },
          "730670708": {
            "id": "730670708",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "#Yes, with help from Nara {NICKNAME} and Paimon, Arashakun will lead the charge and be invincible! Even the devious Furry Mask Demon King will be no match!",
            "nextDialogs": [
              "730670709"
            ]
          },
          "730670709": {
            "id": "730670709",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "Arashakun shall mark today with a big entry!",
            "nextDialogs": [
              "730670710"
            ]
          },
          "730670710": {
            "id": "730670710",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "A big entry...?",
            "nextDialogs": [
              "730670711"
            ]
          },
          "730670711": {
            "id": "730670711",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "Yeah, a big entry in big writing!",
            "nextDialogs": [
              "730670712"
            ]
          },
          "730670712": {
            "id": "730670712",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Arashakun with \"courage\" and without sure feel like two completely different Aranara.",
            "nextDialogs": [
              "730670713"
            ]
          },
          "730670713": {
            "id": "730670713",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "Arashakun with no \"courage\" has weak arms and legs, but Arashakun with \"courage\" can do all sorts of amazing feats!",
            "nextDialogs": [
              "730670714"
            ]
          },
          "730670714": {
            "id": "730670714",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "\"Courage\" is not just the best gift from Nara friend, but also the most important thing to Arashakun.",
            "nextDialogs": [
              "730670715"
            ]
          },
          "730670715": {
            "id": "730670715",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, make sure you keep it safe and don't let the hilichurls steal it again!",
            "nextDialogs": [
              "730670716"
            ]
          },
          "730670716": {
            "id": "730670716",
            "speakerId": 1002,
            "speakerName": "Arashakun",
            "text": "Arashakun understands. Arashakun will never let \"courage\" go missing again!"
          }
        }
      }

        "dialogs": {
          "766562001": {
            "id": "766562001",
            "speakerId": 7048,
            "speakerName": "Ginette",
            "text": "#Hello, {NICKNAME} and Paimon. Thanks to your help, I've finished making adjustments to the robots you found previously.",
            "nextDialogs": [
              "766562002"
            ]
          },
          "766562002": {
            "id": "766562002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, the gang's all here!",
            "nextDialogs": [
              "766562003"
            ]
          },
          "766562003": {
            "id": "766562003",
            "speakerId": 7048,
            "speakerName": "Ginette",
            "text": "So far, I haven't run into any new problems, but what I have run into is a new idea...",
            "nextDialogs": [
              "766562004"
            ]
          },
          "766562004": {
            "id": "766562004",
            "speakerId": 7048,
            "speakerName": "Ginette",
            "text": "#When you track down the other robots, {NICKNAME}, can you pay attention to any of their special behaviors?",
            "nextDialogs": [
              "766562005"
            ]
          },
          "766562005": {
            "id": "766562005",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Behaviors,\" meaning...?",
            "nextDialogs": [
              "766562006"
            ]
          },
          "766562006": {
            "id": "766562006",
            "speakerId": 7048,
            "speakerName": "Ginette",
            "text": "Well, that'd be... how they interact with each other, I suppose? Ah, it should be much more obvious once we've recovered enough of them.",
            "nextDialogs": [
              "766562007"
            ]
          },
          "766562007": {
            "id": "766562007",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay... Well, leave it to us!",
            "nextDialogs": [
              "766562008"
            ]
          },
          "766562008": {
            "id": "766562008",
            "speakerId": 7048,
            "speakerName": "Ginette",
            "text": "Thank you both! I'll mark the next area on your map..."
          }
        }
      }
    }
  ]

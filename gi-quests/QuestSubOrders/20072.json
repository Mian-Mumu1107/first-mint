  "subQuests": [
    {
      "subId": "2007213",
      "subQuestName": "Talk to Flora",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200720401"
        ],
        "dialogs": {
          "200720401": {
            "id": "200720401",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Here, over here!",
            "nextDialogs": [
              "200720402"
            ]
          },
          "200720402": {
            "id": "200720402",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Do you still remember the flowers that I asked you to store on Dragonspine?",
            "nextDialogs": [
              "200720403"
            ]
          },
          "200720403": {
            "id": "200720403",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "It's been a day since then, and I'd like to see the results of our cold storage experiment.",
            "nextDialogs": [
              "200720404"
            ]
          },
          "200720404": {
            "id": "200720404",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Could you help me go up the mountain and bring those flowers back?",
            "nextDialogs": [
              "200720406",
              "200720408"
            ]
          },
          "200720406": {
            "id": "200720406",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "I'm counting on you, then. I'll be waiting here, so do come back soon."
          },
          "200720408": {
            "id": "200720408",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "You forgot? You put them <color=#00E1FFFF>beside a Statue of The Seven</color>, <color=#00E1FFFF>by a body of water in the mountains</color>, and <color=#00E1FFFF>near a cavern</color>.",
            "nextDialogs": [
              "200720409"
            ]
          },
          "200720409": {
            "id": "200720409",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Let me help you mark them on your map again."
          }
        }
      }
    },
    {
      "subId": "2007201",
      "subQuestName": "Head to Dragonspine to retrieve the packages",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200720101"
        ],
        "dialogs": {
          "200720101": {
            "id": "200720101",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "How are the flowers that we stored away on Dragonspine earlier?",
            "nextDialogs": [
              "200720102"
            ]
          },
          "200720102": {
            "id": "200720102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I only managed to retrieve one container...",
            "nextDialogs": [
              "200720103"
            ]
          },
          "200720103": {
            "id": "200720103",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "The others couldn't be retrieved? Um... Well, alright then. It is quite hard to predict conditions on that mountain, after all.",
            "nextDialogs": [
              "200720104"
            ]
          },
          "200720104": {
            "id": "200720104",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "But if we only have one, then we can't make any comparisons. I suppose we'll just have to wait for an opportunity to have another look...",
            "nextDialogs": [
              "200720105"
            ]
          },
          "200720105": {
            "id": "200720105",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Thank you for taking the trouble, though. Here, I prepared these as compensation — I might need to call upon your help in the future as well."
          }
        }
      }
    },
    {
      "subId": "2007202",
      "subQuestName": "Retrieve the package near the Dragonspine Statue of The Seven",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200720201"
        ],
        "dialogs": {
          "200720201": {
            "id": "200720201",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "How are the flowers?",
            "nextDialogs": [
              "200720202"
            ]
          },
          "200720202": {
            "id": "200720202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm sorry...",
            "nextDialogs": [
              "200720203"
            ]
          },
          "200720203": {
            "id": "200720203",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Huh? What happened?",
            "nextDialogs": [
              "200720204"
            ]
          },
          "200720204": {
            "id": "200720204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I broke the containers and flowers by accident...",
            "nextDialogs": [
              "200720205"
            ]
          },
          "200720205": {
            "id": "200720205",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "B—By accident!?",
            "nextDialogs": [
              "200720206"
            ]
          },
          "200720206": {
            "id": "200720206",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Ugh... I specifically picked those flowers out. You can't find such good flowers just anywhere...",
            "nextDialogs": [
              "200720207"
            ]
          },
          "200720207": {
            "id": "200720207",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Is Dragonspine so dangerous that even an adventurer like you couldn't keep one container from...",
            "nextDialogs": [
              "200720208"
            ]
          },
          "200720208": {
            "id": "200720208",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Still, thanks for making that trip for me. Please take these as thanks. Now, if you'll excuse me, I have to go tend to my flowers.",
            "nextDialogs": [
              "200720209"
            ]
          },
          "200720209": {
            "id": "200720209",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "*sigh* Maybe I should try the method that Sara suggested after all..."
          }
        }
      }
    },
    {
      "subId": "2007203",
      "subQuestName": "Retrieve the package near the Dragonspine Statue of The Seven",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200720301"
        ],
        "dialogs": {
          "200720301": {
            "id": "200720301",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "How are the flowers that we stored away on Dragonspine earlier?",
            "nextDialogs": [
              "200720302"
            ]
          },
          "200720302": {
            "id": "200720302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I have them all here.",
            "nextDialogs": [
              "200720303"
            ]
          },
          "200720303": {
            "id": "200720303",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "All of them? That's great! Here, let me see.",
            "nextDialogs": [
              "200720304"
            ]
          },
          "200720304": {
            "id": "200720304",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Hehe, not bad at all. Hmm... Looks like this method really does work.",
            "nextDialogs": [
              "200720305"
            ]
          },
          "200720305": {
            "id": "200720305",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "The only problem is that Dragonspine is really far from Mondstadt. I can't be troubling you every time, either. I have to find some other way in future...",
            "nextDialogs": [
              "200720306"
            ]
          },
          "200720306": {
            "id": "200720306",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Thank you very much, all the same. Here's your compensation, please take it!"
          }
        }
      }
    },

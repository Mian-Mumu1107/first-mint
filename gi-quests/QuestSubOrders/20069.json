    {
      "subId": "2006904",
      "subQuestName": "Place a package near the mountain cave",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200690401"
        ],
        "dialogs": {
          "200690401": {
            "id": "200690401",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "How are the flowers?",
            "nextDialogs": [
              "200690402"
            ]
          },
          "200690402": {
            "id": "200690402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm sorry...",
            "nextDialogs": [
              "200690403"
            ]
          },
          "200690403": {
            "id": "200690403",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Eh? What happened?",
            "nextDialogs": [
              "200690404"
            ]
          },
          "200690404": {
            "id": "200690404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I broke the containers and flowers by accident...",
            "nextDialogs": [
              "200690405"
            ]
          },
          "200690405": {
            "id": "200690405",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "B—By accident!?",
            "nextDialogs": [
              "200690406"
            ]
          },
          "200690406": {
            "id": "200690406",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Ugh... I specifically picked those flowers out. You can't find such good flowers just anywhere...",
            "nextDialogs": [
              "200690407"
            ]
          },
          "200690407": {
            "id": "200690407",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Is Dragonspine so dangerous that even an adventurer like you couldn't keep one container from...",
            "nextDialogs": [
              "200690408"
            ]
          },
          "200690408": {
            "id": "200690408",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Still, thanks for making that trip for me. Please take these as thanks. Now, if you'll excuse me, I have to go tend to my flowers.",
            "nextDialogs": [
              "200690409"
            ]
          },
          "200690409": {
            "id": "200690409",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "*sigh* Maybe I should try the method that Sara suggested after all..."
          }
        }

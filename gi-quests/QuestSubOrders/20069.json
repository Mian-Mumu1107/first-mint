  "subQuests": [
    {
      "subId": "2006901",
      "subQuestName": "Talk to Flora",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200690101"
        ],
        "dialogs": {
          "200690101": {
            "id": "200690101",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "These flowers aren't looking so good, either. What a shame...",
            "nextDialogs": [
              "200690102"
            ]
          },
          "200690102": {
            "id": "200690102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Something the matter?",
            "nextDialogs": [
              "200690103"
            ]
          },
          "200690103": {
            "id": "200690103",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Well, lots of people tend to buy single flowers to give as gifts, so I usually cut some flowers specifically for that purpose.",
            "nextDialogs": [
              "200690104"
            ]
          },
          "200690104": {
            "id": "200690104",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "But the flowers I trim don't stay fresh for long. If they don't sell out, they'll wilt...",
            "nextDialogs": [
              "200690105"
            ]
          },
          "200690105": {
            "id": "200690105",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "I've tried many methods in the past, but the flowers degrade by the end of the day all the same.",
            "nextDialogs": [
              "200690106"
            ]
          },
          "200690106": {
            "id": "200690106",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "I wonder if there's any way to preserve those flowers for longer...",
            "nextDialogs": [
              "200690108",
              "200690112"
            ]
          },
          "200690108": {
            "id": "200690108",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "I've heard Sara from Good Hunter say that they put unused ingredients in a cool place, or preserve them using blocks of ice...",
            "nextDialogs": [
              "200690109"
            ]
          },
          "200690109": {
            "id": "200690109",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "I've tried these methods too, but flowers stored using ice blocks always end up looking weird.",
            "nextDialogs": [
              "200690110"
            ]
          },
          "200690110": {
            "id": "200690110",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "They won't have withered, but I wouldn't call them fresh either... and either way, they wouldn't be presentable anymore...",
            "nextDialogs": [
              "200690114"
            ]
          },
          "200690114": {
            "id": "200690114",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "I asked a lot of people, and Mr. Sayid... You know who he is, right? He's that researcher.",
            "nextDialogs": [
              "200690115"
            ]
          },
          "200690115": {
            "id": "200690115",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "One day, when he came to buy flowers, he told me that he once read about putting flowers in cold storage in a book.",
            "nextDialogs": [
              "200690116"
            ]
          },
          "200690116": {
            "id": "200690116",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Specifically... it involves using a container to store the flowers before placing that container near blocks of ice...",
            "nextDialogs": [
              "200690117"
            ]
          },
          "200690117": {
            "id": "200690117",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "He also mentioned that if I wanted to do some experiments, the most suitable place would be the low-temperature environment on Dragonspine.",
            "nextDialogs": [
              "200690118"
            ]
          },
          "200690118": {
            "id": "200690118",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "But I've heard that Dragonspine's a very dangerous place, and I couldn't find any adventurers willing to help me on such short notice...",
            "nextDialogs": [
              "200690119"
            ]
          },
          "200690119": {
            "id": "200690119",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Traveler, could you help me bury these three flower containers in the Dragonspine snow?"
          },
          "200690112": {
            "id": "200690112",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "That would be best. But there are always one or two flowers that don't get sold.",
            "nextDialogs": [
              "200690113"
            ]
          },
          "200690113": {
            "id": "200690113",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "I know it's only one or two, but I don't want to just let them wither away."
          }
        }
      }
    },
    {
      "subId": "2006902",
      "subQuestName": "Head to Dragonspine's Statue of The Seven and place a package there",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200690201"
        ],
        "dialogs": {
          "200690201": {
            "id": "200690201",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "How are the flowers?",
            "nextDialogs": [
              "200690202"
            ]
          },
          "200690202": {
            "id": "200690202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Snugly underground.",
            "nextDialogs": [
              "200690203"
            ]
          },
          "200690203": {
            "id": "200690203",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Thank you. We'll leave them there on the mountain for a while.",
            "nextDialogs": [
              "200690204"
            ]
          },
          "200690204": {
            "id": "200690204",
            "speakerId": 1000,
            "speakerName": "Flora",
            "text": "Hehe, thanks so much for helping me out. Please, take these for your trouble."
          }
        }
      }
    },

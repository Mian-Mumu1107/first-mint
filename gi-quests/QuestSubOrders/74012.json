    {
      "subId": "7401209",
      "subQuestName": "Examine the terminal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740121001"
        ],
        "dialogs": {
          "740121001": {
            "id": "740121001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pull the lever.",
            "nextDialogs": [
              "740121002"
            ]
          },
          "740121002": {
            "id": "740121002",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Whoa! What are you doing, {NICKNAME}?",
            "nextDialogs": [
              "740121003"
            ]
          },
          "740121003": {
            "id": "740121003",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You pull the lever without the slightest hesitation.\\nThe entire tower then immediately trembles with a thunderous, ear-splitting rumble. It's as if the sky is crumbling and the earth is splitting...",
            "nextDialogs": [
              "740121004"
            ]
          },
          "740121004": {
            "id": "740121004",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Then... with a pop, the machine spits out a stack of paper tape right into your hands.\\nAll is quiet once more.",
            "nextDialogs": [
              "740121005"
            ]
          },
          "740121005": {
            "id": "740121005",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Is... Is that it?",
            "nextDialogs": [
              "740121006"
            ]
          },
          "740121006": {
            "id": "740121006",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... Paimon doesn't have a clue what's on it, but it looks pretty important...",
            "nextDialogs": [
              "740121007"
            ]
          },
          "740121007": {
            "id": "740121007",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, why don't we keep this paper tape for now? Who knows, it might come in handy later..."
          }
        }
      }
    },
    {
      "subId": "7401209",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740120901"
        ],
        "dialogs": {
          "740120901": {
            "id": "740120901",
            "speakerId": 1002,
            "speakerName": "Research Terminal",
            "text": "(There's a memo stuck next to the lever on the right side of the console. In neat and elegant handwriting, it reads, \"Do NOT touch under any circumstances!\")"
          }
        }
      }
    },
    {
      "subId": "7401211",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740121101"
        ],
        "dialogs": {
          "740121101": {
            "id": "740121101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We probably shouldn't touch it...",
            "nextDialogs": [
              "740121102"
            ]
          },
          "740121102": {
            "id": "740121102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#R... Right. It does seem dangerous... {NICKNAME}, maybe we should take a step back..."
          }
        }
      }
    },
    {
      "subId": "7401212",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740121201"
        ],
        "dialogs": {
          "740121201": {
            "id": "740121201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? It's a console just like the one in that other tower from before...",
            "nextDialogs": [
              "740121202"
            ]
          },
          "740121202": {
            "id": "740121202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pull the lever.",
            "nextDialogs": [
              "740121203"
            ]
          },
          "740121203": {
            "id": "740121203",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You pull the lever.\\nJust like before, the machine spits out a stack of paper tape after a moment of rumbling and shaking...",
            "nextDialogs": [
              "740121204"
            ]
          },
          "740121204": {
            "id": "740121204",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, it's paper tape, just like before...",
            "nextDialogs": [
              "740121205"
            ]
          },
          "740121205": {
            "id": "740121205",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon still doesn't get it, but we should probably take this stuff with us in case we need it later."
          }
        }
      }
    },
    {
      "subId": "7401213",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740121301"
        ],
        "dialogs": {
          "740121301": {
            "id": "740121301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What do we have here... Right, looks like a lever with \"Do NOT touch under any circumstances!\" written next to it!",
            "nextDialogs": [
              "740121302"
            ]
          },
          "740121302": {
            "id": "740121302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pull the lever.",
            "nextDialogs": [
              "740121303"
            ]
          },
          "740121303": {
            "id": "740121303",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You pull the lever.\\nAfter some rumbling and shaking, the machine spits out a stack of paper tape...",
            "nextDialogs": [
              "740121304"
            ]
          },
          "740121304": {
            "id": "740121304",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Great! Now we have the monitoring data from the Crepes Suzette Station!",
            "nextDialogs": [
              "740121305"
            ]
          },
          "740121305": {
            "id": "740121305",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#All that's left now is the Pate de Fruit Station. Let's go, {NICKNAME}!"
          }
        }
      }
    },

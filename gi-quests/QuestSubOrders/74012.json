    {
      "subId": "7401205",
      "subQuestName": "Look for clues in the nearby camps",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740120501"
        ],
        "dialogs": {
          "740120501": {
            "id": "740120501",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa! So strict! Paimon definitely doesn't want to work for that guy!",
            "nextDialogs": [
              "740120502"
            ]
          },
          "740120502": {
            "id": "740120502",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Where do they get the nerve to talk about \"a sense of collective honor\"? Where's the honor in not even letting anyone eat?",
            "nextDialogs": [
              "740120504",
              "740120506"
            ]
          },
          "740120504": {
            "id": "740120504",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, discipline is important, but... surely this is taking it too far?",
            "nextDialogs": [
              "740120507"
            ]
          },
          "740120507": {
            "id": "740120507",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? Come to think of it, if we also cause a commotion, we can probably lure that platoon leader Shumilov down, right?",
            "nextDialogs": [
              "740120508"
            ]
          },
          "740120508": {
            "id": "740120508",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Then, we'd be able to get up there... {NICKNAME}, let's give it a try!"
          },
          "740120506": {
            "id": "740120506",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Right!? The more someone doesn't know how to get things done, the weirder they get about discipline and rules..."
          }
        }
      }
    },
    {
      "subId": "7401206",
      "subQuestName": "Strike the cooking pot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740120601"
        ],
        "dialogs": {
          "740120601": {
            "id": "740120601",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Thump... thump... thump...\\nNot long after, hurried and frantic footsteps can be heard coming from higher up in the tower..."
          }
        }
      }
    },
    {

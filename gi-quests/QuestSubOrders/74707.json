  "subQuests": [
    {
      "subId": "7470701",
      "subQuestName": "Head near the aquarium tank",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747070101"
        ],
        "dialogs": {
          "747070101": {
            "id": "747070101",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "...Alright, that was great! Let's just do one more take.",
            "nextDialogs": [
              "747070102"
            ]
          },
          "747070102": {
            "id": "747070102",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Good. Aaaand... cut!",
            "nextDialogs": [
              "747070103"
            ]
          },
          "747070103": {
            "id": "747070103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Furina! Oh, plus Columbina and Chiori too! You're still here?",
            "nextDialogs": [
              "747070104"
            ]
          },
          "747070104": {
            "id": "747070104",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Mmhmm! We just wrapped up filming our B-roll.",
            "nextDialogs": [
              "747070105"
            ]
          },
          "747070105": {
            "id": "747070105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ohh! You mean the fishie acting stuff you were doing? How did it all go?",
            "nextDialogs": [
              "747070106"
            ]
          },
          "747070106": {
            "id": "747070106",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Thanks to your help, we found a suitable actor for the role. The shoot went very smoothly!",
            "nextDialogs": [
              "747070107"
            ]
          },
          "747070107": {
            "id": "747070107",
            "speakerId": 1082,
            "speakerName": "Chiori",
            "text": "You two have a real talent for this whole aquarium thing. Furina was just telling us how you've even inspired her to shoot an underwater documentary.",
            "nextDialogs": [
              "747070110"
            ]
          },
          "747070110": {
            "id": "747070110",
            "speakerId": 16252,
            "speakerName": "Columbina",
            "text": "I like it too. I can sense how content the little fish are, swimming around. You've done a great job taking care of their needs.",
            "nextDialogs": [
              "747070111"
            ]
          },
          "747070111": {
            "id": "747070111",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "I just wish this aquarium could stay here forever. That way, I'd be able to come and visit whenever I wanted.",
            "nextDialogs": [
              "747070112"
            ]
          },
          "747070112": {
            "id": "747070112",
            "speakerId": 1082,
            "speakerName": "Chiori",
            "text": "If you're going to miss it so much, why not add a few more scenic shots to the film?",
            "nextDialogs": [
              "747070113"
            ]
          },
          "747070113": {
            "id": "747070113",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "You're right. We should totally shoot some more!",
            "nextDialogs": [
              "747070114"
            ]
          },
          "747070114": {
            "id": "747070114",
            "speakerId": 1318,
            "speakerName": "The Damselette",
            "text": "Some more fish?",
            "nextDialogs": [
              "747070115"
            ]
          },
          "747070115": {
            "id": "747070115",
            "speakerId": 1073,
            "speakerName": "Furina",
            "text": "Some more shots! Come on now, lights, kamera... Where's my script supervisor? Everyone, take your positions!",
            "nextDialogs": [
              "747070116"
            ]
          },
          "747070116": {
            "id": "747070116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's ready! But calling out takes for fish actors is... definitely a new experience, that's for sure."
          }
        }
      }
    }
  ]
}
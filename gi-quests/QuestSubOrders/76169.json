          },
          "761690102": {
            "id": "761690102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We came to see him as well.",
            "nextDialogs": [
              "761690103"
            ]
          },
          "761690103": {
            "id": "761690103",
            "speakerId": 1000,
            "speakerName": "Illuga",
            "text": "If he knew you came... Well, he certainly wouldn't say it, but it'd make him happy.",
            "nextDialogs": [
              "761690104"
            ]
          },
          "761690104": {
            "id": "761690104",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "You stand together with Illuga before the grave for a while...\\nIlluga speaks to your fallen comrade, recounting the small and big events that have taken place in Piramida lately...",
            "nextDialogs": [
              "761690105"
            ]
          },
          "761690105": {
            "id": "761690105",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "He can finally rest in peace knowing that everyone in Piramida's doing well, right?",
            "nextDialogs": [
              "761690106"
            ]
          },
          "761690106": {
            "id": "761690106",
            "speakerId": 1000,
            "speakerName": "Illuga",
            "text": "Yes. He completed his mission. We will continue with ours.",
            "nextDialogs": [
              "761690107"
            ]
          },
          "761690107": {
            "id": "761690107",
            "speakerId": 1000,
            "speakerName": "Illuga",
            "text": "And after us, others will continue to watch over this land. Like the Winter Icelea, they will endure storms and cold, yet still grow strong."
          }
        }
      }
    },

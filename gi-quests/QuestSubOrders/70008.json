    {
      "subId": "7000817",
      "subQuestName": "Report back to Margaret",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700083801"
        ],
        "dialogs": {
          "700083801": {
            "id": "700083801",
            "speakerId": 1000,
            "speakerName": "Margaret",
            "text": "Alright, looks like we've got all the ingredients we need. Let's start blending our beverage.",
            "nextDialogs": [
              "700083802"
            ]
          },
          "700083802": {
            "id": "700083802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I wonder how it'll taste...",
            "nextDialogs": [
              "700083803"
            ]
          },
          "700083803": {
            "id": "700083803",
            "speakerId": 1000,
            "speakerName": "Margaret",
            "text": "Oh, are you interested in trying it out, too?",
            "nextDialogs": [
              "700083804"
            ]
          },
          "700083804": {
            "id": "700083804",
            "speakerId": 1000,
            "speakerName": "Margaret",
            "text": "Well... the blending process itself isn't particularly complicated. You just need to follow the steps I've come up with and it should be a ringing success.",
            "nextDialogs": [
              "700083805"
            ]
          },
          "700083805": {
            "id": "700083805",
            "speakerId": 1000,
            "speakerName": "Margaret",
            "text": "So, want to try making it yourself, Traveler?",
            "nextDialogs": [
              "700083806"
            ]
          },
          "700083806": {
            "id": "700083806",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure, I'll give it a go.",
            "nextDialogs": [
              "700083807"
            ]
          },
          "700083807": {
            "id": "700083807",
            "speakerId": 1000,
            "speakerName": "Margaret",
            "text": "Great. Now, just let me explain the process of making this beverage. Make sure you remember it.",
            "nextDialogs": [
              "700083808"
            ]
          },
          "700083808": {
            "id": "700083808",
            "speakerId": 1000,
            "speakerName": "Margaret",
            "text": "First, place a <color=#00E1FFFF>Sweet Flower</color> inside before pouring the base alcohol we're using for this cocktail... and then, of course, we'll drizzle some <color=#00E1FFFF>Milk</color> in to lay the foundations for the clear, sweet texture we're going for this time around.",
            "nextDialogs": [
              "700083809"
            ]
          },
          "700083809": {
            "id": "700083809",
            "speakerId": 1000,
            "speakerName": "Margaret",
            "text": "We'll need to add the <color=#00E1FFFF>Windwheel Aster</color> in at this point to add flavor.",
            "nextDialogs": [
              "700083810"
            ]
          },
          "700083810": {
            "id": "700083810",
            "speakerId": 1000,
            "speakerName": "Margaret",
            "text": "Don't rush to mix it all together. Let it <color=#00E1FFFF>sit</color> for a moment and let the floral fragrance emerge.",
            "nextDialogs": [
              "700083811"
            ]
          },
          "700083811": {
            "id": "700083811",
            "speakerId": 1000,
            "speakerName": "Margaret",
            "text": "Then scatter the <color=#00E1FFFF>Dandelion Seeds</color> in to make the drink look like it's been adorned with stars. Then, place some <color=#00E1FFFF>ice cubes</color> in, and that's a wrap!",
            "nextDialogs": [
              "700083812"
            ]
          },
          "700083812": {
            "id": "700083812",
            "speakerId": 1000,
            "speakerName": "Margaret",
            "text": "And that's how it works. You can't get the steps mixed up if you want to make something delicious.",
            "nextDialogs": [
              "700083813"
            ]
          },
          "700083813": {
            "id": "700083813",
            "speakerId": 1000,
            "speakerName": "Margaret",
            "text": "If you've memorized the steps, give it a go. If you've forgotten, feel free to ask me again."
          }
        }
      }
    },

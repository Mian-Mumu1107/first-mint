    {
      "subId": "7150005",
      "subQuestName": "Help Cloud Retainer complete the dish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715000901"
        ],
        "dialogs": {
          "715000901": {
            "id": "715000901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm ready.",
            "nextDialogs": [
              "715000902"
            ]
          },
          "715000902": {
            "id": "715000902",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "Then let us begin.",
            "nextDialogs": [
              "715000903"
            ]
          },
          "715000903": {
            "id": "715000903",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "Supreme Cuisine Machine... activate!"
          }
        }
      }
    },
    {
      "subId": "7150006",
      "subQuestName": "Help Cloud Retainer complete the dish",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715000601"
        ],
        "dialogs": {
          "715000601": {
            "id": "715000601",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "Traveler, the machine has been activated. Follow the tracks it has created and reclaim one's Bamboo Shoots."
          }
        }
      }
    },
    {
      "subId": "7150007",
      "subQuestName": "Report back to Cloud Retainer",
      "sceneId": null,

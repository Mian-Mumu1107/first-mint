    {
      "subId": "7150004",
      "subQuestName": "Report back to Cloud Retainer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715000401"
        ],
        "dialogs": {
          "715000401": {
            "id": "715000401",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "One could not call the heat control desirable...",
            "nextDialogs": [
              "715000402"
            ]
          },
          "715000402": {
            "id": "715000402",
            "speakerId": 1000,
            "speakerName": "Cloud Retainer",
            "text": "But no matter. One has ingredients to spare with which to attempt this once more."
          }
        }
      }
    },
    {
      "subId": "7150010",

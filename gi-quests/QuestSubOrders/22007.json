    {
      "subId": "2200701",
      "subQuestName": "Talk to Bao'er",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220070101"
        ],
        "dialogs": {
          "220070101": {
            "id": "220070101",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Where did it go...",
            "nextDialogs": [
              "220070102"
            ]
          },
          "220070102": {
            "id": "220070102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "220070103"
            ]
          },
          "220070103": {
            "id": "220070103",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "I was investigating a ruin, when suddenly monsters attacked me...",
            "nextDialogs": [
              "220070104"
            ]
          },
          "220070104": {
            "id": "220070104",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "I panicked and ran, and must have dropped the relic I'd just uncovered right where I found it.",
            "nextDialogs": [
              "220070105"
            ]
          },
          "220070105": {
            "id": "220070105",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "After the monsters left, I came back, but I couldn't find the relic.",
            "nextDialogs": [
              "220070106"
            ]
          },
          "220070106": {
            "id": "220070106",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "I've searched all over the place and I just can't find it. I wonder if maybe the monsters took it?",
            "nextDialogs": [
              "220070107"
            ]
          },
          "220070107": {
            "id": "220070107",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Can you help me search for it? If you find it, you can store it in this box."
          }
        }
      }
    },
    {
      "subId": "2200702",
      "subQuestName": "Search for the item Bao'er lost",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220070201"
        ],
        "dialogs": {
          "220070201": {
            "id": "220070201",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Where did it go...",
            "nextDialogs": [
              "220070202"
            ]
          },
          "220070202": {
            "id": "220070202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This box is... a bit...",
            "nextDialogs": [
              "220070203"
            ]
          },
          "220070203": {
            "id": "220070203",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Hey! Take a closer look, I think you'll find I've padded it with plenty of clothes.",
            "nextDialogs": [
              "220070204"
            ]
          },
          "220070204": {
            "id": "220070204",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "I'm a professional scholar, don't you know! I don't make rookie errors.",
            "nextDialogs": [
              "220070205"
            ]
          },
          "220070205": {
            "id": "220070205",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Anyway, thanks for helping me look for the relic — I'd be useless in a fight with those monsters..."
          }
        }
      }
    },
    {

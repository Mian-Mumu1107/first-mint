    {
      "subId": "2200703",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220070301"
        ],
        "dialogs": {
          "220070301": {
            "id": "220070301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... We've looked everywhere — and still, nothing.",
            "nextDialogs": [
              "220070302"
            ]
          },
          "220070302": {
            "id": "220070302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Do you wanna keep looking? Or go back and check with Bao'er?",
            "nextDialogs": [
              "220070305",
              "220070306"
            ]
          },
          "220070305": {
            "id": "220070305",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright then. This time with your eyes open."
          },
          "220070306": {
            "id": "220070306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, let's see what else Bao'er has to say."
          }
        }
      }
    },
    {
      "subId": "2200704",
      "subQuestName": "Retrieve Bao'er's lost item from the monsters",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220070401"
        ],
        "dialogs": {
          "220070401": {
            "id": "220070401",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Did you find the relic?",
            "nextDialogs": [
              "220070402"
            ]
          },
          "220070402": {
            "id": "220070402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes.",
            "nextDialogs": [
              "220070403"
            ]
          },
          "220070403": {
            "id": "220070403",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Let me see... Wow! That's a relic, alright...",
            "nextDialogs": [
              "220070404"
            ]
          },
          "220070404": {
            "id": "220070404",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "Um... It doesn't look like the one I lost, though. Still, looks valuable to me!",
            "nextDialogs": [
              "220070405"
            ]
          },
          "220070405": {
            "id": "220070405",
            "speakerId": 2421,
            "speakerName": "Bao'er",
            "text": "This relic needs looking after by an expert. Don't worry, it's safe with me... Hehehe... Thank you both."
          }
        }
      }
    },

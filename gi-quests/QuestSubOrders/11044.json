    {
      "subId": "1104407",
      "subQuestName": "Observe the installations in the camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110440701"
        ],
        "dialogs": {
          "110440701": {
            "id": "110440701",
            "speakerId": 1001,
            "speakerName": "Observe Table",
            "text": "(Looks like an alchemy work table. Some potions and other apparatus are laid out here. Are these what Albedo uses to investigate the world?)",
            "nextDialogs": [
              "110440702"
            ]
          },
          "110440702": {
            "id": "110440702",
            "speakerId": 1001,
            "speakerName": "Observe Table",
            "text": "(It wouldn't hurt to touch it... would it?)"
          }
        }
      }
    },
    {
      "subId": "1104408",
      "subQuestName": "Observe the installations in the camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110440801"
        ],
        "dialogs": {
          "110440801": {
            "id": "110440801",
            "speakerId": 1002,
            "speakerName": "Observe Record Board",
            "text": "(A board with some incomprehensible experimental reports stuck onto it.)",
            "nextDialogs": [
              "110440802"
            ]
          },
          "110440802": {
            "id": "110440802",
            "speakerId": 1002,
            "speakerName": "Observe Record Board",

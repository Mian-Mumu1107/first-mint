    {
      "subId": "1104413",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110441301"
        ],
        "dialogs": {
          "110441301": {
            "id": "110441301",
            "speakerId": 1003,
            "speakerName": "Albedo",
            "text": "Hmm, an interesting term... Compelling.",
            "nextDialogs": [
              "110441302"
            ]
          },
          "110441302": {
            "id": "110441302",
            "speakerId": 1003,
            "speakerName": "Albedo",
            "text": "See what you can find, I'll be over here."
          }
        }
      }
    },
    {
      "subId": "1104403",
      "subQuestName": "Talk to Albedo and hear his conclusions",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110440320"
        ],
        "dialogs": {
          "110440320": {
            "id": "110440320",
            "speakerId": 1003,
            "speakerName": "Albedo",
            "text": "Goodness, you managed to find them? Incredible, a thousand thanks.",
            "nextDialogs": [
              "110440321"
            ]
          },
          "110440321": {
            "id": "110440321",
            "speakerId": 1003,
            "speakerName": "Albedo",
            "text": "I'm wondering, this Elemental Sight... This is what allowed you to locate the items, and find me here in the mountains, correct?",
            "nextDialogs": [
              "110440322"
            ]
          },
          "110440322": {
            "id": "110440322",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Yup! Guess it does sorta count as a superpower, huh...",
            "nextDialogs": [
              "110440323"
            ]
          },
          "110440323": {
            "id": "110440323",
            "speakerId": 1003,
            "speakerName": "Albedo",
            "text": "Unfortunately, though Elemental Sight is seldom seen, it is not unheard of in Teyvat.",
            "nextDialogs": [
              "110440324"
            ]
          },
          "110440324": {
            "id": "110440324",
            "speakerId": 1003,
            "speakerName": "Albedo",
            "text": "Only a never-before-seen, otherworldly power would be of benefit to my research.",
            "nextDialogs": [
              "110440325"
            ]
          },
          "110440325": {
            "id": "110440325",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "You mean... We failed again...?",
            "nextDialogs": [
              "110440326"
            ]
          },
          "110440326": {
            "id": "110440326",
            "speakerId": 1003,
            "speakerName": "Albedo",
            "text": "Don't be disheartened, this falls entirely within my expectations. Besides, getting these items back? I'd call this a very worthwhile experiment.",
            "nextDialogs": [
              "110440301"
            ]
          },
          "110440301": {
            "id": "110440301",
            "speakerId": 1003,
            "speakerName": "Albedo",
            "text": "I have to commend your deduction that the items would contain elemental traces.",
            "nextDialogs": [
              "110440302"
            ]
          },
          "110440302": {
            "id": "110440302",
            "speakerId": 1003,
            "speakerName": "Albedo",
            "text": "Right then. Up until now, our research has focused on your otherworldly identity. Our research on your identity as one of us is just beginning.",
            "nextDialogs": [
              "110440305"
            ]
          },
          "110440305": {
            "id": "110440305",
            "speakerId": 1003,
            "speakerName": "Albedo",
            "text": "In essence, the differences between humans are reflected in our intellectual and physical capabilities. Let's start with physical.",
            "nextDialogs": [
              "110440306"
            ]
          },
          "110440306": {
            "id": "110440306",
            "speakerId": 1003,
            "speakerName": "Albedo",
            "text": "Looking out from where we're standing, can you see what Sucrose is doing?",
            "nextDialogs": [
              "110440307"
            ]
          },
          "110440307": {
            "id": "110440307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Nope.",
            "nextDialogs": [
              "110440308"
            ]
          },
          "110440308": {
            "id": "110440308",
            "speakerId": 1003,
            "speakerName": "Albedo",
            "text": "And if you jumped from here and landed on that cliff — the one over there — could you see her then?",
            "nextDialogs": [
              "110440309"
            ]
          },
          "110440309": {
            "id": "110440309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Nope.",
            "nextDialogs": [
              "110440310"
            ]
          },
          "110440310": {
            "id": "110440310",
            "speakerId": 1003,
            "speakerName": "Albedo",
            "text": "So what about if you planted a single blow on the mountain face here and it burst into a million fragments? Then could you see her?"
          }
        }
      }
    }
  ]
}
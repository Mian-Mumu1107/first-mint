  "subQuests": [
    {
      "subId": "7210701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721070101"
        ],
        "dialogs": {
          "721070101": {
            "id": "721070101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A fox statue... Yup, it's the same as the one in Konda Village!",
            "nextDialogs": [
              "721070102"
            ]
          },
          "721070102": {
            "id": "721070102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But Paimon doesn't see a ward in it... or has the ward been hidden?",
            "nextDialogs": [
              "721070103"
            ]
          },
          "721070103": {
            "id": "721070103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, it's some troublesome <color=#00E1FFFF>secret</color> again, isn't it...",
            "nextDialogs": [
              "721070105"
            ]
          },
          "721070105": {
            "id": "721070105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehehe, right? The village chief told us everything.",
            "nextDialogs": [
              "721070107"
            ]
          },
          "721070107": {
            "id": "721070107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait! There's some writing here.",
            "nextDialogs": [
              "721070108"
            ]
          },
          "721070108": {
            "id": "721070108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "<color=#00E1FFFF>\"The ward has been sealed within by sacred words.\"</color>",
            "nextDialogs": [
              "721070109"
            ]
          },
          "721070109": {
            "id": "721070109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, what does that mean? There's some more writing here as well...",
            "nextDialogs": [
              "721070110"
            ]
          },
          "721070110": {
            "id": "721070110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Although I hope the seal will never be broken, and although you have now been missing for many years... If the seal must be broken and the Cleansing Ritual conducted, I hope that you shall be the one to break it.\"",
            "nextDialogs": [
              "721070111"
            ]
          },
          "721070111": {
            "id": "721070111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"The third line of the sacred words is something you often used to say in the past.\""
          }
        }
      }
    },
    {
      "subId": "7210734",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721071401"
        ],
        "dialogs": {
          "721071401": {
            "id": "721071401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, that should do it! Phew, Paimon's exhausted!",
            "nextDialogs": [
              "721071402"
            ]
          },
          "721071402": {
            "id": "721071402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Shouldn't I be the exhausted one...",
            "nextDialogs": [
              "721071403"
            ]
          },
          "721071403": {
            "id": "721071403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's not fuss over the details, shall we?",
            "nextDialogs": [
              "721071404"
            ]
          },
          "721071404": {
            "id": "721071404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, looks like there's a book in here...",
            "nextDialogs": [
              "721071405"
            ]
          },
          "721071405": {
            "id": "721071405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, it's so hard to read!",
            "nextDialogs": [
              "721071406"
            ]
          },
          "721071406": {
            "id": "721071406",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's read it all, but it also feels like Paimon didn't read anything at all.",
            "nextDialogs": [
              "721071407"
            ]
          },
          "721071407": {
            "id": "721071407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Forget it. Let's get some professional help!",
            "nextDialogs": [
              "721071408"
            ]
          },
          "721071408": {
            "id": "721071408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Since it's about gods and demons and stuff, let's go to the Grand Narukami Shrine, shall we?"
          }
        }
      }
    },

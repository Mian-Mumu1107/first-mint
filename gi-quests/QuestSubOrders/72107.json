    {
      "subId": "7210708",
      "subQuestName": "Return to the abandoned shrine and use the Memento Lens to investigate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721070801"
        ],
        "dialogs": {
          "721070801": {
            "id": "721070801",
            "speakerId": 20286,
            "speakerName": "Mysterious Woman",
            "text": "How quickly the shrine has fallen to neglect after losing its master and the incense within...",
            "nextDialogs": [
              "721070802"
            ]
          },
          "721070802": {
            "id": "721070802",
            "speakerId": 20286,
            "speakerName": "Mysterious Woman",
            "text": "I can only hope that the barrier within the cavern still stands strong.",
            "nextDialogs": [
              "721070803"
            ]
          },
          "721070803": {
            "id": "721070803",
            "speakerId": 20286,
            "speakerName": "Mysterious Woman",
            "text": "Ah, I remember now. She once instructed people to <color=#00E1FFFF>construct a locked gate</color> by a canal on the road leading to Chinju Forest, before giving the key to the Konda Clan.",
            "nextDialogs": [
              "721070804"
            ]
          },
          "721070804": {
            "id": "721070804",
            "speakerId": 20286,
            "speakerName": "Mysterious Woman",
            "text": "I hope everything is still alright."
          }
        }
      }
    },
    {
      "subId": "7210714",
      "subQuestName": "Recite the sacred words in front of the Sky Kitsune Statue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7210715",
      "subQuestName": "Obtain the ward",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721071501"
        ],
        "dialogs": {
          "721071501": {
            "id": "721071501",
            "speakerId": 20287,
            "speakerName": "Records",
            "text": "\"The ward has been sealed in place using <color=#00E1FFFF>sacred words</color>. There are four great spirits, and three spokes in the Mitsudomoe. I have placed <color=#00E1FFFF>three shikigami</color> here as guardians. <color=#00E1FFFF>Only when they are all gathered here in one place</color> can one proceed.\""
          }
        }
      }
    },
    {
      "subId": "7210721",
      "subQuestName": "Find the barrier",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7210722",
      "subQuestName": "Destroy the barrier",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7210723",
      "subQuestName": "Talk to Hanachirusato",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721000201"
        ],
        "dialogs": {
          "721000201": {
            "id": "721000201",
            "speakerId": 20221,
            "speakerName": "Hanachirusato",
            "text": "Again, the two of you have my thanks.",
            "nextDialogs": [
              "721000202"
            ]
          },
          "721000202": {
            "id": "721000202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa!",
            "nextDialogs": [
              "721000203"
            ]
          },
          "721000203": {
            "id": "721000203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This again, eh...",
            "nextDialogs": [
              "721000204"
            ]
          },
          "721000204": {
            "id": "721000204",
            "speakerId": 20221,
            "speakerName": "Hanachirusato",
            "text": "I apologize. There are some things that become... a habit, perhaps.",
            "nextDialogs": [
              "721000205"
            ]
          },
          "721000205": {
            "id": "721000205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why are you following us again? Couldn't you just say hello?",
            "nextDialogs": [
              "721000208"
            ]
          },
          "721000208": {
            "id": "721000208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, um, sorry. Paimon's tired from floating around too much... Paimon didn't mean to be rude.",
            "nextDialogs": [
              "721000209"
            ]
          },
          "721000209": {
            "id": "721000209",
            "speakerId": 20221,
            "speakerName": "Hanachirusato",
            "text": "It is alright. The barrier here has been undone successfully, and thus does the Cleansing Ritual come a step closer to completion. Thank you very much.",
            "nextDialogs": [
              "721000210"
            ]
          },
          "721000210": {
            "id": "721000210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's the deal with the Sacred Sakura Cleansing Ritual, anyway? Is it the same as the \"cleansing\" you asked us to do earlier?"
          }
        }
      }
    },
    {
      "subId": "7210709",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721070901"
        ],
        "dialogs": {
          "721070901": {
            "id": "721070901",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "... Yeah, it's decided. We'll let her go this time.",
            "nextDialogs": [
              "721070902"
            ]
          },
          "721070902": {
            "id": "721070902",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "After all, it's not my job, and it's not as if she is some monster, charging at me like an Ochimusha might.",
            "nextDialogs": [
              "721070903"
            ]
          },
          "721070903": {
            "id": "721070903",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "I'm all tuckered out already. I thought I had run into a long-lost friend. That feeling is so exhausting..."
          }
        }
      }
    },
    {
      "subId": "7210710",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721071001"
        ],
        "dialogs": {
          "721071001": {
            "id": "721071001",
            "speakerId": 20286,
            "speakerName": "Mysterious Woman",
            "text": "Then let us part ways here.",
            "nextDialogs": [
              "721071002"
            ]
          },
          "721071002": {
            "id": "721071002",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "Ah, you're so cold.",
            "nextDialogs": [
              "721071003"
            ]
          },
          "721071003": {
            "id": "721071003",
            "speakerId": 20286,
            "speakerName": "Mysterious Woman",
            "text": "\"Rosy-cheeked in the morning, bleached bones by dusk.\"",
            "nextDialogs": [
              "721071004"
            ]
          },
          "721071004": {
            "id": "721071004",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "Oh, come on! It was at least half an emotional reunion for me! Actually, maybe it was more like one quarter?",
            "nextDialogs": [
              "721071005"
            ]
          },
          "721071005": {
            "id": "721071005",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "Ah, you're gone already? Come on..."
          }
        }
      }
    },
    {
      "subId": "7210711",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721071101"
        ],
        "dialogs": {
          "721071101": {
            "id": "721071101",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "That being said, after she left, Ioroi seems to have led his tribe to wreak havoc everywhere.",
            "nextDialogs": [
              "721071102"
            ]
          },
          "721071102": {
            "id": "721071102",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "Well, I could have kept one eye shut, had Ioroi stayed in the Chinju Forest.",
            "nextDialogs": [
              "721071103"
            ]
          },
          "721071103": {
            "id": "721071103",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "Mm. Guess he needs to be taught a good lesson..."
          }
        }
      }
    },
    {
      "subId": "7210718",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721070701"
        ],
        "dialogs": {
          "721070701": {
            "id": "721070701",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "My, that lady is such a buzzkill.",
            "nextDialogs": [
              "721070702"
            ]
          },
          "721070702": {
            "id": "721070702",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "If I am to have a disciple one day, I shall find a cheerful and beautiful lady. Yeah, I'll make sure of that.",
            "nextDialogs": [
              "721070703"
            ]
          },
          "721070703": {
            "id": "721070703",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "Now, as for the third line... Ah, right, this looks good.",
            "nextDialogs": [
              "721070704"
            ]
          },
          "721070704": {
            "id": "721070704",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "<color=#00E1FFFF>\"Bring forth the fried tofu\"</color>!",
            "nextDialogs": [
              "721070705"
            ]
          },
          "721070705": {
            "id": "721070705",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "Since this is her territory — the land of the Hakushin bloodline — we'll go with that."
          }
        }
      }
    },
    {
      "subId": "7210712",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721071201"
        ],
        "dialogs": {
          "721071201": {
            "id": "721071201",
            "speakerId": 20286,
            "speakerName": "Mysterious Woman",
            "text": "This was... my previous...",
            "nextDialogs": [
              "721071202"
            ]
          },
          "721071202": {
            "id": "721071202",
            "speakerId": 20286,
            "speakerName": "Mysterious Woman",
            "text": "Wait, that wasn't me. It was her previous territory.",
            "nextDialogs": [
              "721071203"
            ]
          },
          "721071203": {
            "id": "721071203",
            "speakerId": 20286,
            "speakerName": "Mysterious Woman",
            "text": "That person over there... seems so familiar..."
          }
        }
      }
    },
    {
      "subId": "7210713",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721071301"
        ],
        "dialogs": {
          "721071301": {
            "id": "721071301",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "Yeah, guess we're done here. Time to write all this down and hand it over to the shrine.",
            "nextDialogs": [
              "721071302"
            ]
          },
          "721071302": {
            "id": "721071302",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "After all, this isn't like the shikigami paper I use. With any luck, they'll preserve it properly. Things might get dicey if these document come across moths or water.",
            "nextDialogs": [
              "721071303"
            ]
          },
          "721071303": {
            "id": "721071303",
            "speakerId": 20285,
            "speakerName": "Mysterious Man",
            "text": "Ah! Silly me, saying such inauspicious things..."
          }
        }
      }
    }
  ]
}
          "207010201"
        ],
        "dialogs": {
          "207010201": {
            "id": "207010201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'll see it done.",
            "nextDialogs": [
              "207010202"
            ]
          },
          "207010202": {
            "id": "207010202",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "Great! Thank you so much. I'll be waiting over here.",
            "nextDialogs": [
              "207010203"
            ]
          },
          "207010203": {
            "id": "207010203",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "Hehe... I'll finally be able to eat Jade Parcels again..."
          }
        }
      }
    },
    {
      "subId": "2070102",
      "subQuestName": "Cook Jade Parcels",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2070103",
      "subQuestName": "Give the Jade Parcels to Siegfria",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010301"
        ],
        "dialogs": {
          "207010301": {
            "id": "207010301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Would you like anything else?",
            "nextDialogs": [
              "207010302"
            ]
          },
          "207010302": {
            "id": "207010302",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "Ugh, well... I'd also like to eat other things. But if I tried to eat everything, then I wouldn't be able to eat anything at all.",
            "nextDialogs": [
              "207010303"
            ]
          },
          "207010303": {
            "id": "207010303",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "So I'd like to get a firm grasp on how Jade Parcels taste first."
          }
        }
      }
    },
    {
      "subId": "2070104",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010502"
        ],
        "dialogs": {
          "207010502": {
            "id": "207010502",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "...Ah, they're all gone.",
            "nextDialogs": [
              "207010503"
            ]
          },
          "207010503": {
            "id": "207010503",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "The mouthfeel of those vegetables... the perfectly paired flavors of the ham and the lotus... and that soup...",
            "nextDialogs": [
              "207010504"
            ]
          },
          "207010504": {
            "id": "207010504",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "This is it — this is the flavor that I tasted the last time!",
            "nextDialogs": [
              "207010531"
            ]
          },
          "207010531": {
            "id": "207010531",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "Thanks for coming over just to make me this dish. I need to go back and make some notes.",
            "nextDialogs": [
              "207010532"
            ]
          },
          "207010532": {
            "id": "207010532",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "Next we meet, I will definitely be able to make a batch of perfect Jade Parcels.",
            "nextDialogs": [
              "207010533"
            ]
          },
          "207010533": {
            "id": "207010533",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "When that time comes, do swing by to have a taste."
          }
        }
      }
    },
    {
      "subId": "2070105",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010510"
        ],
        "dialogs": {
          "207010510": {
            "id": "207010510",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "The freshness of the ham, the mouthfeel of the vegetables, and this faint spiciness...",
            "nextDialogs": [
              "207010511"
            ]
          },
          "207010511": {
            "id": "207010511",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "Hmm, this is not bad. It's a really good serving of Jade Parcels!"
          }
        }
      }
    },
    {
      "subId": "2070106",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010520"
        ],
        "dialogs": {
          "207010520": {
            "id": "207010520",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "Ugh... These vegetables are so dry, and it feels like there are some ingredients that weren't cooked all the way through...",
            "nextDialogs": [
              "207010521"
            ]
          },
          "207010521": {
            "id": "207010521",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "It's a far cry from what I had before... is this some new method of cooking that you came up with?",
            "nextDialogs": [
              "207010522"
            ]
          },
          "207010522": {
            "id": "207010522",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "There's just something off about it... but I can still use it for reference."
          }
        }
      }
    },
    {
      "subId": "2070107",
      "subQuestName": "Talk to Siegfria",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2070101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010101"
        ],
        "dialogs": {
          "207010101": {
            "id": "207010101",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "How am I already hungry again...",
            "nextDialogs": [
              "207010102"
            ]
          },
          "207010102": {
            "id": "207010102",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "Oh, it's you! Wonderful. Do you still remember me?",
            "nextDialogs": [
              "207010103"
            ]
          },
          "207010103": {
            "id": "207010103",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "From the cook-off, with Xiangling? That was me, Siegfria!",
            "nextDialogs": [
              "207010104"
            ]
          },
          "207010104": {
            "id": "207010104",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "Hehe, do you remember now? Anyway, you've come at a great time. Could I... ask you to help me with something?",
            "nextDialogs": [
              "207010105"
            ]
          },
          "207010105": {
            "id": "207010105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do you need?",
            "nextDialogs": [
              "207010106"
            ]
          },
          "207010106": {
            "id": "207010106",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "Do you still recall the Jade Parcels that you made the previous time?",
            "nextDialogs": [
              "207010107"
            ]
          },
          "207010107": {
            "id": "207010107",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "They were so delicious, I can still taste them, even now.",
            "nextDialogs": [
              "207010108"
            ]
          },
          "207010108": {
            "id": "207010108",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "So I wanted to give it a try and make some myself, but... it always feels like there's something missing...",
            "nextDialogs": [
              "207010109"
            ]
          },
          "207010109": {
            "id": "207010109",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "I feel like if I get to try it a few more times, I can recreate that flavor too!",
            "nextDialogs": [
              "207010110"
            ]
          },
          "207010110": {
            "id": "207010110",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "So, could I ask you to make some Jade Parcels for me to try?"
          }
        }
      }
    },
    {
      "subId": "2070104",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010401"
        ],
        "dialogs": {
          "207010401": {
            "id": "207010401",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "This is great! I'll finally get to taste the Jade Parcels you make again.",
            "nextDialogs": [
              "207010402"
            ]
          },
          "207010402": {
            "id": "207010402",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "I do know the recipe, and I have been able to figure out how to make it, but it doesn't quite match the flavor it had when you made it.",
            "nextDialogs": [
              "207010403"
            ]
          },
          "207010403": {
            "id": "207010403",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "*sigh* If only you could make those Jade Parcels for me a few more times. There are still many intricacies to them that I have yet to work out."
          }
        }
      }
    },
    {
      "subId": "2070105",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207010501"
        ],
        "dialogs": {
          "207010501": {
            "id": "207010501",
            "speakerId": 1000,
            "speakerName": "Siegfria",
            "text": "Are the Jade Parcels ready yet?"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "4133301",
      "subQuestName": "Talk to Iron Ingot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413330101"
        ],
        "dialogs": {
          "413330101": {
            "id": "413330101",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "The Mysterious Adeptus of the Highest Heaven Soaring Across the Skies. It's so beautiful...",
            "nextDialogs": [
              "413330102"
            ]
          },
          "413330102": {
            "id": "413330102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you star gazing?",
            "nextDialogs": [
              "413330103"
            ]
          },
          "413330103": {
            "id": "413330103",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Yes... and no. It's the Lantern Rite, after all. It only seems fitting to look upon such an elegant sight during these festive times.",
            "nextDialogs": [
              "413330104"
            ]
          },
          "413330104": {
            "id": "413330104",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "I've even been learning how to write poetry, too. The other guys tell me that girls these days are really into that sort of thing.",
            "nextDialogs": [
              "413330105"
            ]
          },
          "413330105": {
            "id": "413330105",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Hah, I'm sure Ziwei will...",
            "nextDialogs": [
              "413330108"
            ]
          },
          "413330108": {
            "id": "413330108",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Uh — ahem, well, I've heard a lot of constellation names from Ziwei. *sigh* They all sound so beautiful...",
            "nextDialogs": [
              "413330109"
            ]
          },
          "413330109": {
            "id": "413330109",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "So you see, I have to thank her somehow!",
            "nextDialogs": [
              "413330110"
            ]
          },
          "413330110": {
            "id": "413330110",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "I was thinking that I should write a poem on a Xiao Lantern and find a place to release it together with Ziwei... We'll eat snacks and sing songs...",
            "nextDialogs": [
              "413330111"
            ]
          },
          "413330111": {
            "id": "413330111",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "If this doesn't get the job done, nothing will!",
            "nextDialogs": [
              "413330112"
            ]
          },
          "413330112": {
            "id": "413330112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Get the job... done?",
            "nextDialogs": [
              "413330113"
            ]
          },
          "413330113": {
            "id": "413330113",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Ahem, I mean... This will do the job of helping us enjoy the festival more... Yeah, that's it!",
            "nextDialogs": [
              "413330114"
            ]
          },
          "413330114": {
            "id": "413330114",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Anyway, I want to find a quiet, scenic spot away from other pedestrians.",
            "nextDialogs": [
              "413330115"
            ]
          },
          "413330115": {
            "id": "413330115",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "I started asking around and I've found two potential spots so far. Here, have a look.",
            "nextDialogs": [
              "413330116"
            ]
          },
          "413330116": {
            "id": "413330116",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "The other guys told me that they've released Xiao Lanterns at these spots before...",
            "nextDialogs": [
              "413330117"
            ]
          },
          "413330117": {
            "id": "413330117",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "But I still need to come up with a poem... and I'm afraid running around to check the spots will just douse my creativity.",
            "nextDialogs": [
              "413330118"
            ]
          },
          "413330118": {
            "id": "413330118",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Could you help me go check out those two spots?",
            "nextDialogs": [
              "413330119"
            ]
          },
          "413330119": {
            "id": "413330119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure.",
            "nextDialogs": [
              "413330120"
            ]
          },
          "413330120": {
            "id": "413330120",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Thanks for your help, I'm counting on you!"
          }
        }
      }
    },
    {
      "subId": "4133302",
      "subQuestName": "Find the first suitable viewing spot and <color=#00E1FFFF>take a picture</color>",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413330201"
        ],
        "dialogs": {
          "413330201": {
            "id": "413330201",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "\"Ziwei stumbles across an iron ingot\" ...No, no, that won't do. That's laying it on a bit thick...",
            "nextDialogs": [
              "413330202"
            ]
          },
          "413330202": {
            "id": "413330202",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Oh, when did you get here? Did you check those two spots?",
            "nextDialogs": [
              "413330203"
            ]
          },
          "413330203": {
            "id": "413330203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We sure did.",
            "nextDialogs": [
              "413330204"
            ]
          },
          "413330204": {
            "id": "413330204",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "That didn't take you long. Now let me have a look...",
            "nextDialogs": [
              "413330205"
            ]
          },
          "413330205": {
            "id": "413330205",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Alright, let me have a look here... Hmm, the surrounding scenery at this spot is very unique, whereas the other spot is centered in a more picturesque landscape. It reminds me of the line, \"Ain't no mountain high enough, ain't no...\" Uh, I forget what's after that...",
            "nextDialogs": [
              "413330206"
            ]
          },
          "413330206": {
            "id": "413330206",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Anyway, never mind... Still, these spots look bright and impressive.",
            "nextDialogs": [
              "413330207"
            ]
          },
          "413330207": {
            "id": "413330207",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "I've got it! I know which one to pick... But, there's still something I'd like to ask of you, Traveler.",
            "nextDialogs": [
              "413330208"
            ]
          },
          "413330208": {
            "id": "413330208",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "My friends told me that when you go to see someone, it's best to bring something to eat. What do you think I should prepare when I go to see Ziwei?",
            "nextDialogs": [
              "413330210"
            ]
          },
          "413330210": {
            "id": "413330210",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Grilled Tiger Fish, hmm... Don't you think that'd be a little too oily? Maybe something a little more light and refined, like Almond Tofu...",
            "nextDialogs": [
              "413330212"
            ]
          },
          "413330212": {
            "id": "413330212",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Yeah, Almond Tofu! That would be perfect!",
            "nextDialogs": [
              "413330213"
            ]
          },
          "413330213": {
            "id": "413330213",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Traveler, could you please help me prepare a serving of Almond Tofu? In the meantime, I'll keep working on my poem here. Now how should this next line go...",
            "nextDialogs": [
              "413330214"
            ]
          },
          "413330214": {
            "id": "413330214",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "\"And countless sparks fly\"... Oh, that's a good line!"
          }
        }
      }
    },
    {
      "subId": "4133303",
      "subQuestName": "Find a second suitable viewing spot and <color=#00E1FFFF>take a picture</color>",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413330301"
        ],
        "dialogs": {
          "413330301": {
            "id": "413330301",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Oh, when did you get back? Did you prepare the Almond Tofu?",
            "nextDialogs": [
              "413330304"
            ]
          },
          "413330304": {
            "id": "413330304",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Ah, okay. Don't worry, I can keep working on my poem in the meantime..."
          }
        }
      }
    },
    {
      "subId": "4133304",
      "subQuestName": "Report back to Iron Ingot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4133305",
      "subQuestName": "Give the Almond Tofu to Iron Ingot",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413330501"
        ],
        "dialogs": {
          "413330501": {
            "id": "413330501",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Well, I guess this will do for now. Let's go find Ziwei!"
          }
        }
      }
    },
    {
      "subId": "4133306",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413330401"
        ],
        "dialogs": {
          "413330401": {
            "id": "413330401",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Huh? Is it me... Or does this tofu smell funny?",
            "nextDialogs": [
              "413330402"
            ]
          },
          "413330402": {
            "id": "413330402",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "I could never give this to Ziwei. Maybe you could help get another one?"
          }
        }
      }
    },
    {
      "subId": "4133308",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413330601"
        ],
        "dialogs": {
          "413330601": {
            "id": "413330601",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "This looks great! Everything's ready, all we need to do now is find Ziwei!"
          }
        }
      }
    },
    {
      "subId": "4133309",
      "subQuestName": "Go with Iron Ingot to meet Ziwei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413330701"
        ],
        "dialogs": {
          "413330701": {
            "id": "413330701",
            "speakerId": 2419,
            "speakerName": "Ziwei",
            "text": "From this angle... The constellation looks just like a dog. Now, I must think of a suitable name...",
            "nextDialogs": [
              "413330702"
            ]
          },
          "413330702": {
            "id": "413330702",
            "speakerId": 2419,
            "speakerName": "Ziwei",
            "text": "Oh, it's you, Iron Ingot. What are you doing here?",
            "nextDialogs": [
              "413330703"
            ]
          },
          "413330703": {
            "id": "413330703",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Umm, well you see... Uh, I—I was just strolling outside the city, and I happened to come across a very scenic spot...",
            "nextDialogs": [
              "413330704"
            ]
          },
          "413330704": {
            "id": "413330704",
            "speakerId": 2419,
            "speakerName": "Ziwei",
            "text": "A nice spot? You mean for star gazing?",
            "nextDialogs": [
              "413330705"
            ]
          },
          "413330705": {
            "id": "413330705",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Y—Yes, that's it! A nice spot for star gazing. It'd also be a great place to release Xiao Lanterns... See? I've already prepared one for us.",
            "nextDialogs": [
              "413330706"
            ]
          },
          "413330706": {
            "id": "413330706",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "And look, I've even written a p—poem on it...",
            "nextDialogs": [
              "413330707"
            ]
          },
          "413330707": {
            "id": "413330707",
            "speakerId": 2419,
            "speakerName": "Ziwei",
            "text": "\"Sparks fly where shovel and meteorite meet.\"",
            "nextDialogs": [
              "413330708"
            ]
          },
          "413330708": {
            "id": "413330708",
            "speakerId": 2419,
            "speakerName": "Ziwei",
            "text": "Yes... Well, even though I don't really know what your wish is, the poem is quite interesting.",
            "nextDialogs": [
              "413330709"
            ]
          },
          "413330709": {
            "id": "413330709",
            "speakerId": 2419,
            "speakerName": "Ziwei",
            "text": "But you shouldn't let others see your wish before releasing the Xiao Lantern, otherwise it will never come true.",
            "nextDialogs": [
              "413330710"
            ]
          },
          "413330710": {
            "id": "413330710",
            "speakerId": 2419,
            "speakerName": "Ziwei",
            "text": "And so, what exactly do you need from me?",
            "nextDialogs": [
              "413330711"
            ]
          },
          "413330711": {
            "id": "413330711",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Well, I...",
            "nextDialogs": [
              "413330714"
            ]
          },
          "413330714": {
            "id": "413330714",
            "speakerId": 2419,
            "speakerName": "Ziwei",
            "text": "Releasing a Xiao Lantern? Oh, I'm sorry... I was actually hoping to go somewhere away from all the lanterns.",
            "nextDialogs": [
              "413330715"
            ]
          },
          "413330715": {
            "id": "413330715",
            "speakerId": 2419,
            "speakerName": "Ziwei",
            "text": "The Xiao Lanterns are so bright that they obstruct my view of the stars. I think I'll be going as far as I can away from the festivities.",
            "nextDialogs": [
              "413330716"
            ]
          },
          "413330716": {
            "id": "413330716",
            "speakerId": 2419,
            "speakerName": "Ziwei",
            "text": "Thanks for the kind offer, but I should get going. Happy Lantern Rite.",
            "nextDialogs": [
              "413330717"
            ]
          },
          "413330717": {
            "id": "413330717",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "O—Oh..."
          }
        }
      }
    },
    {
      "subId": "4133312",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413330901"
        ],
        "dialogs": {
          "413330901": {
            "id": "413330901",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Alright, we've checked both spots. Let's go back and find Iron Ingot. Wonder how his poem is coming along..."
          }
        }
      }
    },
    {
      "subId": "4133313",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413330801"
        ],
        "dialogs": {
          "413330801": {
            "id": "413330801",
            "speakerId": 2403,
            "speakerName": "Iron Ingot",
            "text": "Mysterious Adeptus of the Highest Heaven Soaring Across the Skies... What does it mean?"
          }
        }
      }
    }
  ]
}
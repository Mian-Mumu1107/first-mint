  "subQuests": [
    {
      "subId": "7902001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790200101"
        ],
        "dialogs": {
          "790200101": {
            "id": "790200101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let Paimon see! Hmm... This looks like it might be some kind of treasure map.",
            "nextDialogs": [
              "790200102"
            ]
          },
          "790200102": {
            "id": "790200102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Really?",
            "nextDialogs": [
              "790200103"
            ]
          },
          "790200103": {
            "id": "790200103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Heh! Paimon's never wrong when she's on the scent of treasure!",
            "nextDialogs": [
              "790200116"
            ]
          },
          "790200116": {
            "id": "790200116",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, it seems like \"Ako Domeki and company\" were the ones who left this picture behind. Feels like we've heard that one before, y'know?",
            "nextDialogs": [
              "790200104"
            ]
          },
          "790200104": {
            "id": "790200104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Also, look at this! \"The treasure is hidden...\" See? There's treasure to be had, alright!",
            "nextDialogs": [
              "790200105"
            ]
          },
          "790200105": {
            "id": "790200105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's keep reading... \"... Was split into four parts...\"",
            "nextDialogs": [
              "790200106"
            ]
          },
          "790200106": {
            "id": "790200106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So they split something into four parts, huh?",
            "nextDialogs": [
              "790200109"
            ]
          },
          "790200109": {
            "id": "790200109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's not... super sure?",
            "nextDialogs": [
              "790200110"
            ]
          },
          "790200110": {
            "id": "790200110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But whatever the case, it says here that something was \"placed amidst the reefs of the four large islands.\" That should refer to the reefs on the four islands of the Golden Apple Archipelago.",
            "nextDialogs": [
              "790200111"
            ]
          },
          "790200111": {
            "id": "790200111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, isn't this one of those reefs?",
            "nextDialogs": [
              "790200112"
            ]
          },
          "790200112": {
            "id": "790200112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hmm, that means there must be four clues...",
            "nextDialogs": [
              "790200113"
            ]
          },
          "790200113": {
            "id": "790200113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And they should be close to the reefs on the four islands!",
            "nextDialogs": [
              "790200114"
            ]
          },
          "790200114": {
            "id": "790200114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmmm, that's gotta refer to the four biggest ones in the archipelago, right?",
            "nextDialogs": [
              "790200115"
            ]
          },
          "790200115": {
            "id": "790200115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's give the other three islands a shot and see what we can find!"
          }
        }
      }
    },

    {
      "subId": "7902005",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790200501"
        ],
        "dialogs": {
          "790200501": {
            "id": "790200501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, that makes four clues gained...",
            "nextDialogs": [
              "790200502"
            ]
          },
          "790200502": {
            "id": "790200502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Uhh, Paimon can't tell where this treasure is supposed to be hidden at all...",
            "nextDialogs": [
              "790200503"
            ]
          },
          "790200503": {
            "id": "790200503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What does this \"radius\" and \"center\" stuff mean, anyway?",
            "nextDialogs": [
              "790200506"
            ]
          },
          "790200506": {
            "id": "790200506",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, is that it? Then we just need to draw four circles on the map and... uh, actually, how long is a \"large boat-length\"?",
            "nextDialogs": [
              "790200507"
            ]
          },
          "790200507": {
            "id": "790200507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's take reference from some ships we've seen before...",
            "nextDialogs": [
              "790200508"
            ]
          },
          "790200508": {
            "id": "790200508",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, we could probably refer to the big ships we've seen in the harbor... Hmm...",
            "nextDialogs": [
              "790200509"
            ]
          },
          "790200509": {
            "id": "790200509",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Paimon draws four circles on the map as instructed.",
            "nextDialogs": [
              "790200510"
            ]
          },
          "790200510": {
            "id": "790200510",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, there's our four circles now. So the treasure is where all four circles overlap, huh?",
            "nextDialogs": [
              "790200511"
            ]
          },
          "790200511": {
            "id": "790200511",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aaaand that's the spot!"
          }
        }
      }
    },
    {
      "subId": "7902006",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790200601"
        ],
        "dialogs": {
          "790200601": {
            "id": "790200601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So this is the treasure left by Ako Domeki and his crew? Hmm... But could they really have left the treasure here of all places back then?",
            "nextDialogs": [
              "790200602"
            ]
          },
          "790200602": {
            "id": "790200602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It seems kinda weird no matter how you look at it...",
            "nextDialogs": [
              "790200605"
            ]
          },
          "790200605": {
            "id": "790200605",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah! Didn't those only appear because of the machine? Could they really have hidden this treasure, then?",
            "nextDialogs": [
              "790200606"
            ]
          },
          "790200606": {
            "id": "790200606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Perhaps the treasure itself wanted to be found...",
            "nextDialogs": [
              "790200607"
            ]
          },
          "790200607": {
            "id": "790200607",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Y'know, you've got a point. Maybe the wish of those who buried the treasure, that someone should find it someday, was affected by the machine...",
            "nextDialogs": [
              "790200608"
            ]
          },
          "790200608": {
            "id": "790200608",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, whatever the case, it's ours now!"
          }
        }
      }
    },

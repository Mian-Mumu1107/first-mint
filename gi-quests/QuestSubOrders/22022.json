  "subQuests": [
    {
      "subId": "2202201",
      "subQuestName": "Talk to Parvaneh",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220101"
        ],
        "dialogs": {
          "220220101": {
            "id": "220220101",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "This recipe should be like this...",
            "nextDialogs": [
              "220220102"
            ]
          },
          "220220102": {
            "id": "220220102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "220220103"
            ]
          },
          "220220103": {
            "id": "220220103",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "I'm sorting recipes out. Unfortunately, I can't remember some of them clearly...",
            "nextDialogs": [
              "220220105",
              "220220107"
            ]
          },
          "220220105": {
            "id": "220220105",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Xudong... He and his \"creative dishes\" are the main reasons why I can't remember them.",
            "nextDialogs": [
              "220220109"
            ]
          },
          "220220109": {
            "id": "220220109",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Every time he gets hold of a new recipe, he'll only follow the recipe for a day or two at most.",
            "nextDialogs": [
              "220220110"
            ]
          },
          "220220110": {
            "id": "220220110",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Then, he... tries various things to improve them."
          },
          "220220107": {
            "id": "220220107",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Please don't mention that name to me again. These words will never appear in my paper...",
            "nextDialogs": [
              "220220108"
            ]
          },
          "220220108": {
            "id": "220220108",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Besides, Xudong and his \"creative dishes\" are the main reasons why I can't remember these recipes."
          }
        }
      }
    },
    {
      "subId": "2202202",
      "subQuestName": "Talk to Parvaneh",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220701"
        ],
        "dialogs": {
          "220220701": {
            "id": "220220701",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Well, thank you. I've written them all down now. I just hope that Xudong won't mess with them again.",
            "nextDialogs": [
              "220220702"
            ]
          },
          "220220702": {
            "id": "220220702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why would he do that?",
            "nextDialogs": [
              "220220703"
            ]
          },
          "220220703": {
            "id": "220220703",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Xudong only said that he wanted to make dishes cheaper.",
            "nextDialogs": [
              "220220704"
            ]
          },
          "220220704": {
            "id": "220220704",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "I don't understand him at all... but he's really good at what he does.",
            "nextDialogs": [
              "220220705"
            ]
          },
          "220220705": {
            "id": "220220705",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "I mean... with his skills, he'd be alright making anything. But why did he have to mess with these recipes..."
          }
        }
      }
    },
    {
      "subId": "2202203",
      "subQuestName": "Talk to Parvaneh",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220801"
        ],
        "dialogs": {
          "220220801": {
            "id": "220220801",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Hmm... I can't help but feel that there is something off with these recipes...",
            "nextDialogs": [
              "220220802"
            ]
          },
          "220220802": {
            "id": "220220802",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Never mind. I'll just write them all down for now. Thank you for your help. I hope Xudong doesn't change them again!",
            "nextDialogs": [
              "220220803"
            ]
          },
          "220220803": {
            "id": "220220803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why would he do that?",
            "nextDialogs": [
              "220220804"
            ]
          },
          "220220804": {
            "id": "220220804",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Xudong only said that he wanted to make dishes cheaper.",
            "nextDialogs": [
              "220220805"
            ]
          },
          "220220805": {
            "id": "220220805",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "I don't understand him at all... but he's really good at what he does.",
            "nextDialogs": [
              "220220806"
            ]
          },
          "220220806": {
            "id": "220220806",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "I mean... with his skills, he'd be alright making anything. But why did he have to mess with these recipes..."
          }
        }
      }
    },
    {
      "subId": "2202204",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220401"
        ],
        "dialogs": {
          "220220401": {
            "id": "220220401",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "In Liyue, there is a dish called Bamboo Shoot Soup. It's supposed to be very delicate...",
            "nextDialogs": [
              "220220402"
            ]
          },
          "220220402": {
            "id": "220220402",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Xudong... he changed this one too...",
            "nextDialogs": [
              "220220403"
            ]
          },
          "220220403": {
            "id": "220220403",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "\"Chop Snapdragon and boil it with Mushrooms. Add Salt and Sugar. The soup will taste like Ham.\"",
            "nextDialogs": [
              "220220404"
            ]
          },
          "220220404": {
            "id": "220220404",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Who would cook these things together!? And even if the soup tasted like ham, it's not as if there would be any in there!",
            "nextDialogs": [
              "220220405"
            ]
          },
          "220220405": {
            "id": "220220405",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Forget it... Traveler, what I want to ask is: \"Besides raw meat, what else is in Bamboo Shoot Soup?\"",
            "nextDialogs": [
              "220220411",
              "220220410"
            ]
          },
          "220220411": {
            "id": "220220411",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Hmm... is that so? Let me write it down first..."
          },
          "220220410": {
            "id": "220220410",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Hmm... is that so? Let me write it down first..."
          }
        }
      }
    },
    {
      "subId": "2202205",
      "subQuestName": "Talk to Parvaneh",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220501"
        ],
        "dialogs": {
          "220220501": {
            "id": "220220501",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "There is a dish called Tri-Flavored Skewer in Inazuma... ever since Uncle Munehisa taught Xudong this dish, he's been working hard on it...",
            "nextDialogs": [
              "220220502"
            ]
          },
          "220220502": {
            "id": "220220502",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "I can't believe he made so many notes...",
            "nextDialogs": [
              "220220503"
            ]
          },
          "220220503": {
            "id": "220220503",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "\"'Skewer' is such a wonderful word. Any ingredient can be skewered on a stick...\"",
            "nextDialogs": [
              "220220504"
            ]
          },
          "220220504": {
            "id": "220220504",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "What exactly does he want to skewer... Oh, forget it! Traveler, what I want to ask is: \"besides Raw Meat, Flour, and Snapdragon, what else is needed for Tri-Flavored Skewer?\"",
            "nextDialogs": [
              "220220506",
              "220220510"
            ]
          },
          "220220506": {
            "id": "220220506",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Hmm... is that so? Let me write it down first..."
          },
          "220220510": {
            "id": "220220510",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Hmm... is that so? Let me write it down first..."
          }
        }
      }
    },
    {
      "subId": "2202202",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220201"
        ],
        "dialogs": {
          "220220201": {
            "id": "220220201",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "There is a dish called Northern Apple Stew in Mondstadt. Ugh, Xudong wrote down a bunch of nonsense here again...",
            "nextDialogs": [
              "220220202"
            ]
          },
          "220220202": {
            "id": "220220202",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "\"Butter is expensive and raw meat is hard to store. Why not knead the dough, wash out the gluten, steam the gluten, and season it with fruits and vegetables to give it a savory taste?\"",
            "nextDialogs": [
              "220220203"
            ]
          },
          "220220203": {
            "id": "220220203",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "This fellow... How is butter expensive? And why not just buy fresh meat?",
            "nextDialogs": [
              "220220204"
            ]
          },
          "220220204": {
            "id": "220220204",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Never mind... Traveler, what I want to ask is \"besides Apples, Butter, and Raw Meat, what else is in Northern Apple Stew?\"",
            "nextDialogs": [
              "220220210",
              "220220207"
            ]
          },
          "220220210": {
            "id": "220220210",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Hmm... is that so? Let me write it down first..."
          },
          "220220207": {
            "id": "220220207",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Hmm... is that so? Let me write it down first..."
          }
        }
      }
    },
    {
      "subId": "2202203",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220301"
        ],
        "dialogs": {
          "220220301": {
            "id": "220220301",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "There is a famous dish called Tianshu Meat in Liyue, let's see... Uh, Xudong scribbled something here, too...",
            "nextDialogs": [
              "220220302"
            ]
          },
          "220220302": {
            "id": "220220302",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "\"Steam peeled potatoes, mash while hot, add oil and salt. Then put it in a bowl and pour a thick gravy on top. The first bite is just like soft meat.\"",
            "nextDialogs": [
              "220220303"
            ]
          },
          "220220303": {
            "id": "220220303",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "The first bite... does that mean you can tell after a few more bites? Come on, that will only fool those who have never had genuine Tianshu Meat...",
            "nextDialogs": [
              "220220304"
            ]
          },
          "220220304": {
            "id": "220220304",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Forget it... Traveler, what I want to ask is: \"besides Raw Meat, Sugar, and Matsutake, what else is in Tianshu Meat?\"",
            "nextDialogs": [
              "220220310",
              "220220307"
            ]
          },
          "220220310": {
            "id": "220220310",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Hmm... is that so? Let me write it down first..."
          },
          "220220307": {
            "id": "220220307",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Hmm... is that so? Let me write it down first..."
          }
        }
      }
    },
    {
      "subId": "2202206",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220220601"
        ],
        "dialogs": {
          "220220601": {
            "id": "220220601",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "There is a famous dish in Liyue called Black-Back Perch Stew...",
            "nextDialogs": [
              "220220602"
            ]
          },
          "220220602": {
            "id": "220220602",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "\"...Violetgrass is hard to find. Boil Small Lamp Grass and Snapdragon together. Use the soup to make the dish, which will have the same taste.\"",
            "nextDialogs": [
              "220220603"
            ]
          },
          "220220603": {
            "id": "220220603",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "How did Xudong come up with all this...",
            "nextDialogs": [
              "220220604"
            ]
          },
          "220220604": {
            "id": "220220604",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Never mind. Traveler, what I want to ask is: \"besides Violetgrass, Jueyun Chili, and Fish, what else is needed in this dish?\"",
            "nextDialogs": [
              "220220610",
              "220220607"
            ]
          },
          "220220610": {
            "id": "220220610",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Hmm... is that so? Let me write it down first..."
          },
          "220220607": {
            "id": "220220607",
            "speakerId": 20270,
            "speakerName": "Parvaneh",
            "text": "Hmm... is that so? Let me write it down first..."
          }
        }
      }
    }
  ]

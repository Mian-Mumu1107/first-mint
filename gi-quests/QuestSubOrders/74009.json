{
  "lineCounts": {
    "Black Screen": 1,
    "Dangerous-looking person": 1,
    "Luca": 11,
    "Paimon": 25,
    "Player": 11,
    "Sketchy-looking person": 1,
    "Sonny": 52,
    "Untrustworthy-looking person": 1,
    "Virgil": 11
  },
  "subQuests": [
    {
      "subId": "7400902",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740090101"
        ],
        "dialogs": {
          "740090101": {
            "id": "740090101",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "Now, this is a most serendipitous meeting. Won't you agree, my dear Luca?",
            "nextDialogs": [
              "740090102"
            ]
          },
          "740090102": {
            "id": "740090102",
            "speakerId": 21248,
            "speakerName": "Luca",
            "text": "...",
            "nextDialogs": [
              "740090103"
            ]
          },
          "740090103": {
            "id": "740090103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Who are you?",
            "nextDialogs": [
              "740090104"
            ]
          },
          "740090104": {
            "id": "740090104",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "Apologies. Look at me, beginning a conversation without even introducing myself. I am Sonny, the one they sometimes call the \"White Glove.\" My friend here is Luca the Fisherman. He's pretty famous in certain circles.",
            "nextDialogs": [
              "740090105"
            ]
          },
          "740090105": {
            "id": "740090105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, hello! Paimon is...",
            "nextDialogs": [
              "740090106"
            ]
          },
          "740090106": {
            "id": "740090106",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "#It's most alright. I know that you are Paimon, and this {M#blond}{F#blonde} traveler is {NICKNAME}.",
            "nextDialogs": [
              "740090107"
            ]
          },
          "740090107": {
            "id": "740090107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? You know us already?",
            "nextDialogs": [
              "740090108"
            ]
          },
          "740090108": {
            "id": "740090108",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "But of course! It's just that before today, my knowledge of you was much like my knowledge of the Chief Justice. In other words, I knew of you, but you did not know of me.",
            "nextDialogs": [
              "740090109"
            ]
          },
          "740090109": {
            "id": "740090109",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "With your fame and accomplishments, it is only natural that news of your arrival would reach us as soon as you stepped foot in Fontaine.",
            "nextDialogs": [
              "740090110"
            ]
          },
          "740090110": {
            "id": "740090110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're that famous?",
            "nextDialogs": [
              "740090111"
            ]
          },
          "740090111": {
            "id": "740090111",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "Ah, you're too humble. How should I put it? ...Hmm, to certain people, your arrival in Fontaine would be as if someone had just set off a bomb on the stage of Opera Epiclese.",
            "nextDialogs": [
              "740090112"
            ]
          },
          "740090112": {
            "id": "740090112",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "—Of course, I mean this in only the most positive way. Don't you agree, my dear Luca?",
            "nextDialogs": [
              "740090113"
            ]
          },
          "740090113": {
            "id": "740090113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Er, but how can a bomb going off ever be a good thing...",
            "nextDialogs": [
              "740090114"
            ]
          },
          "740090114": {
            "id": "740090114",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "Hm... I'm not very good with words. How would you put it, my dear Luca?",
            "nextDialogs": [
              "740090115"
            ]
          },
          "740090115": {
            "id": "740090115",
            "speakerId": 21248,
            "speakerName": "Luca",
            "text": "Lyney and Lynette's magic show. Blasting everything wide open to accomplish the impossible. Spine-tingling experience.",
            "nextDialogs": [
              "740090116"
            ]
          },
          "740090116": {
            "id": "740090116",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "Precisely! See, I would have never thought to put it like that.",
            "nextDialogs": [
              "740090117"
            ]
          },
          "740090117": {
            "id": "740090117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "I—If you say so...",
            "nextDialogs": [
              "740090118"
            ]
          },
          "740090118": {
            "id": "740090118",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Why are you called the \"White Glove,\" though? Paimon doesn't see a glove at all...",
            "nextDialogs": [
              "740090119"
            ]
          },
          "740090119": {
            "id": "740090119",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "Ooh, now that's a hard question. How should I explain?",
            "nextDialogs": [
              "740090120"
            ]
          },
          "740090120": {
            "id": "740090120",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "Imagine, if you will, that you're wearing a white glove. If something dirty were to get on your hand, then a dark mark would be left on the glove. My duty... would be to find that dark mark and remove it from view.",
            "nextDialogs": [
              "740090121"
            ]
          },
          "740090121": {
            "id": "740090121",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh... So you're something like a cleaner?",
            "nextDialogs": [
              "740090122"
            ]
          },
          "740090122": {
            "id": "740090122",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "Exactly, my dear Paimon! See, I was never able to so succinctly summarize the nature of my work.",
            "nextDialogs": [
              "740090123"
            ]
          },
          "740090123": {
            "id": "740090123",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ahh, so people like you are the reason why the streets of the Court of Fontaine are always so well-kept and tidy!",
            "nextDialogs": [
              "740090124"
            ]
          },
          "740090124": {
            "id": "740090124",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "Hahaha, that's what I like to hear! Yes, you may understand it like that.",
            "nextDialogs": [
              "740090125"
            ]
          },
          "740090125": {
            "id": "740090125",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay, that makes sense to Paimon... But why would a cleaner need a knife?",
            "nextDialogs": [
              "740090126"
            ]
          },
          "740090126": {
            "id": "740090126",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "You may think of it as a small tool of the trade that we bring out when there are marks that are particularly hard to remove.",
            "nextDialogs": [
              "740090127"
            ]
          },
          "740090127": {
            "id": "740090127",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Got it, thanks! So... is your friend Luca here \"Luca the Fisherman\" because he's really good at fishing?",
            "nextDialogs": [
              "740090128"
            ]
          },
          "740090128": {
            "id": "740090128",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "Hmm — that's only a part of the story, I am afraid. See, there are many kinds of fish in Fontaine as well.",
            "nextDialogs": [
              "740090129"
            ]
          },
          "740090129": {
            "id": "740090129",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "And Luca here is really experienced at teaching people to spend some quality time with all the different kinds of fish. Am I right, my dear Luca?",
            "nextDialogs": [
              "740090130"
            ]
          },
          "740090130": {
            "id": "740090130",
            "speakerId": 21248,
            "speakerName": "Luca",
            "text": "...",
            "nextDialogs": [
              "740090131"
            ]
          },
          "740090131": {
            "id": "740090131",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Paimon doesn't get it... If that's the case, then—",
            "nextDialogs": [
              "740090132"
            ]
          },
          "740090132": {
            "id": "740090132",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "I must say, dear Paimon, that you've really got a knack for asking the most difficult and fascinating questions. It would be most wonderful if we could have a longer conversation, where I would be able to answer everything to your full satisfaction.",
            "nextDialogs": [
              "740090134"
            ]
          },
          "740090134": {
            "id": "740090134",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? Alright then... Sonny and Luca, is there something you'd like to ask us?",
            "nextDialogs": [
              "740090136"
            ]
          },
          "740090136": {
            "id": "740090136",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "You see, we're extremely intrigued by the practice of diving. Fontaine's waters are full of priceless treasures, left by nature and our ancestors alike.",
            "nextDialogs": [
              "740090137"
            ]
          },
          "740090137": {
            "id": "740090137",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "We heard that you had made a good friend recently, and even went for a dive with him. Your powers were such that you didn't even need to use any diving equipment, isn't that right, my dear Luca?",
            "nextDialogs": [
              "740090138"
            ]
          },
          "740090138": {
            "id": "740090138",
            "speakerId": 21248,
            "speakerName": "Luca",
            "text": "...",
            "nextDialogs": [
              "740090139"
            ]
          },
          "740090139": {
            "id": "740090139",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You want to ask about Virgil.",
            "nextDialogs": [
              "740090140"
            ]
          },
          "740090140": {
            "id": "740090140",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "Yes. We want to ask about Virgil.",
            "nextDialogs": [
              "740090141"
            ]
          },
          "740090141": {
            "id": "740090141",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Virgil... That liar and traitor! Ahh, just remembering him makes Paimon mad!",
            "nextDialogs": [
              "740090142"
            ]
          },
          "740090142": {
            "id": "740090142",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You recount your experiences with Virgil to Sonny the White Glove and Luca the Fisherman.",
            "nextDialogs": [
              "740090143"
            ]
          },
          "740090143": {
            "id": "740090143",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "...I see, I see. Thank you for telling us all of this.",
            "nextDialogs": [
              "740090144"
            ]
          },
          "740090144": {
            "id": "740090144",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're welcome! Hmph, Paimon hasn't forgotten a single thing about that guy.",
            "nextDialogs": [
              "740090145"
            ]
          },
          "740090145": {
            "id": "740090145",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "We are, of course, exceedingly grateful that you were willing to share the whole story with us. However, from my own perspective, I am even more relieved that you do not consider Virgil to be a friend. If that hadn't been the case...",
            "nextDialogs": [
              "740090146"
            ]
          },
          "740090146": {
            "id": "740090146",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "Hmm, maybe I can put it like this: had you seen him as a friend, things would have become quite awkward for both of us. Isn't that right, my dear Luca?",
            "nextDialogs": [
              "740090147"
            ]
          },
          "740090147": {
            "id": "740090147",
            "speakerId": 21248,
            "speakerName": "Luca",
            "text": "It could make things difficult.",
            "nextDialogs": [
              "740090148"
            ]
          },
          "740090148": {
            "id": "740090148",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "I agree, I agree. Thank you so much.",
            "nextDialogs": [
              "740090149"
            ]
          },
          "740090149": {
            "id": "740090149",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What are you talking about...?",
            "nextDialogs": [
              "740090150"
            ]
          },
          "740090150": {
            "id": "740090150",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "They are Virgil's enemies.",
            "nextDialogs": [
              "740090151"
            ]
          },
          "740090151": {
            "id": "740090151",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ahh!",
            "nextDialogs": [
              "740090152"
            ]
          },
          "740090152": {
            "id": "740090152",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "#Your words wound me, {M#my dear sir}{F#my lovely lady}. I have many friends and not a single enemy. Virgil is just one of my many friends — and ah, speaking of dear Virgil...",
            "nextDialogs": [
              "740090153"
            ]
          },
          "740090153": {
            "id": "740090153",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "#I think it's about time that we have a serious \"talk\" with him. Surely you understand what I mean, dear {NICKNAME}?",
            "nextDialogs": [
              "740090154"
            ]
          },
          "740090154": {
            "id": "740090154",
            "speakerId": 17163,
            "speakerName": "Sonny",
            "text": "Of course, this is also so that we can get back at him for what he's done to you. It's the least we can do for our honored guests, don't you think?",
            "nextDialogs": [
              "740090155"
            ]
          },
          "740090155": {
            "id": "740090155",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Er, Paimon is lost..."
          }
        }
      }
    },
    {
      "subId": "7400903",
      "subQuestName": "Head to your destination",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740090301"
        ],
        "dialogs": {
          "740090301": {
            "id": "740090301",
            "speakerId": 21027,
            "speakerName": "Virgil",
            "text": "Please let me explain... This is all a misunderstanding...",
            "nextDialogs": [
              "740090302"
            ]
          },
          "740090302": {
            "id": "740090302",
            "speakerId": 21027,
            "speakerName": "Virgil",
            "text": "Mr. Sonny... You see, we only got into this business because we heard there was Mora to be made, and since the higher-ups didn't agree, we figured... We figured we could just earn the money first, and then turn all of the profits over, yeah, that's exactly it!",
            "nextDialogs": [
              "740090303"
            ]
          },
          "740090303": {
            "id": "740090303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh, he's totally ignoring Paimon!",
            "nextDialogs": [
              "740090304"
            ]
          },
          "740090304": {
            "id": "740090304",
            "speakerId": 21027,
            "speakerName": "Virgil",
            "text": "I have no complaints against the organization, none at all... Oh right, I was also tricked by these crooks! That's the only reason at all why I did something so foolish...",
            "nextDialogs": [
              "740090305"
            ]
          },
          "740090305": {
            "id": "740090305",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "#Impressive, very impressive. {NICKNAME}, you are every inch as strong as the stories have made you out to be. Don't you agree, my dear Luca?",
            "nextDialogs": [
              "740090306"
            ]
          },
          "740090306": {
            "id": "740090306",
            "speakerId": 5131,
            "speakerName": "Luca",
            "text": "Super strong. Incredibly formidable.",
            "nextDialogs": [
              "740090307"
            ]
          },
          "740090307": {
            "id": "740090307",
            "speakerId": 21027,
            "speakerName": "Virgil",
            "text": "Please, if you still remember anything about the time we spent together... Mr. Sonny... Mr. Luca...",
            "nextDialogs": [
              "740090308"
            ]
          },
          "740090308": {
            "id": "740090308",
            "speakerId": 5131,
            "speakerName": "Luca",
            "text": "...",
            "nextDialogs": [
              "740090309"
            ]
          },
          "740090309": {
            "id": "740090309",
            "speakerId": 21027,
            "speakerName": "Virgil",
            "text": "Argh! Please, please no...",
            "nextDialogs": [
              "740090310"
            ]
          },
          "740090310": {
            "id": "740090310",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "Luca, our guests are still here. Let's not do anything discourteous that might bring down their mood.",
            "nextDialogs": [
              "740090311"
            ]
          },
          "740090311": {
            "id": "740090311",
            "speakerId": 5131,
            "speakerName": "Luca",
            "text": "Understood.",
            "nextDialogs": [
              "740090312"
            ]
          },
          "740090312": {
            "id": "740090312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph! See the errors of your ways now, Virgil?",
            "nextDialogs": [
              "740090313"
            ]
          },
          "740090313": {
            "id": "740090313",
            "speakerId": 21027,
            "speakerName": "Virgil",
            "text": "Ahh, it was my fault, it was all my fault... Please, have mercy...",
            "nextDialogs": [
              "740090314"
            ]
          },
          "740090314": {
            "id": "740090314",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay, at least you've admitted that you have done something wrong. Now make sure you won't do it again!",
            "nextDialogs": [
              "740090315"
            ]
          },
          "740090315": {
            "id": "740090315",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "#My dear Virgil would never do something like that again. Paimon, {NICKNAME}, I can promise you that on the honor of Sonny the White Glove, as well as that of my father and son.",
            "nextDialogs": [
              "740090320",
              "740090318"
            ]
          },
          "740090320": {
            "id": "740090320",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Mhm! Thank you so much, Sonny and Luca. It seems that there are more good than bad people in Fontaine, after all!",
            "nextDialogs": [
              "740090321"
            ]
          },
          "740090321": {
            "id": "740090321",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "#Farewell, dear Paimon, and my {M#good sir}{F#lovely lady}. I hope there'll come a day when we'll be able to work together again.",
            "nextDialogs": [
              "740090322"
            ]
          },
          "740090322": {
            "id": "740090322",
            "speakerId": 21027,
            "speakerName": "Virgil",
            "text": "Eeek..."
          },
          "740090318": {
            "id": "740090318",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "#Life can often become extremely boring when you understand everything in this world, isn't that right, my {M#good sir}{F#lovely lady}?",
            "nextDialogs": [
              "740090319"
            ]
          },
          "740090319": {
            "id": "740090319",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "And if you must know, we will have... a long and very serious chat with him. We will not take any more of your time, however."
          }
        }
      }
    },
    {
      "subId": "7400906",
      "subQuestName": "Talk to the two people",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740090201"
        ],
        "dialogs": {
          "740090201": {
            "id": "740090201",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "#Dear Paimon, and my {M#good sir}{F#lovely lady}.",
            "nextDialogs": [
              "740090202"
            ]
          },
          "740090202": {
            "id": "740090202",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "This is the stronghold that Virgil has been using as of late.",
            "nextDialogs": [
              "740090203"
            ]
          },
          "740090203": {
            "id": "740090203",
            "speakerId": 1005,
            "speakerName": "Sketchy-looking person",
            "text": "I swear, why is Virgil still not back yet...",
            "nextDialogs": [
              "740090204"
            ]
          },
          "740090204": {
            "id": "740090204",
            "speakerId": 1006,
            "speakerName": "Dangerous-looking person",
            "text": "If he's just gonna keep us waiting, I might not be able to... hold myself back from this shipment of Sinthe...",
            "nextDialogs": [
              "740090205"
            ]
          },
          "740090205": {
            "id": "740090205",
            "speakerId": 1007,
            "speakerName": "Untrustworthy-looking person",
            "text": "Hey, cut it out! That shipment took us an arm and a leg to get. Virgil will have no mercy for you if you were to just take it without his permission.",
            "nextDialogs": [
              "740090206"
            ]
          },
          "740090206": {
            "id": "740090206",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "What a pity. It would seem that my dear friend Virgil hasn't returned to the stronghold yet. We can still have a chat with these guys, however.",
            "nextDialogs": [
              "740090207"
            ]
          },
          "740090207": {
            "id": "740090207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Er, but it doesn't look like they're in the mood for a chat...",
            "nextDialogs": [
              "740090208"
            ]
          },
          "740090208": {
            "id": "740090208",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "Hm, but I think they may change their minds soon enough. What do you think, my dear Luca?",
            "nextDialogs": [
              "740090209"
            ]
          },
          "740090209": {
            "id": "740090209",
            "speakerId": 5131,
            "speakerName": "Luca",
            "text": "No problem.",
            "nextDialogs": [
              "740090210"
            ]
          },
          "740090210": {
            "id": "740090210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Are you sure that there'd be no problem? Paimon thinks they'll probably just try to beat you up!",
            "nextDialogs": [
              "740090211"
            ]
          },
          "740090211": {
            "id": "740090211",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "Oh no! You are too considerate, dear Paimon. Something like that would be most unfortunate indeed.",
            "nextDialogs": [
              "740090212"
            ]
          },
          "740090212": {
            "id": "740090212",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "...For them, of course."
          }
        }
      }
    },
    {
      "subId": "7400904",
      "subQuestName": "Have a \"chat\" with them",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740090401"
        ],
        "dialogs": {
          "740090401": {
            "id": "740090401",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "Alright, my dear Virgil... You've really put us through a lot of trouble. Now then, what should we do with you?",
            "nextDialogs": [
              "740090402"
            ]
          },
          "740090402": {
            "id": "740090402",
            "speakerId": 21027,
            "speakerName": "Virgil",
            "text": "S—Sorry...",
            "nextDialogs": [
              "740090403"
            ]
          },
          "740090403": {
            "id": "740090403",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "This won't do, this won't do at all. You know full well that time flies, and it is now too late for you to turn back. Our organization has a justice code all on our own, and one of our most important rules is that there are some trades that you just never do.",
            "nextDialogs": [
              "740090404"
            ]
          },
          "740090404": {
            "id": "740090404",
            "speakerId": 21027,
            "speakerName": "Virgil",
            "text": "But... But Mr. Sonny, please just listen to me, the profit margin on this, it's just...",
            "nextDialogs": [
              "740090405"
            ]
          },
          "740090405": {
            "id": "740090405",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "Ah, not this again. Mora, Mora, Mora — is there anything you care about other than Mora? What about your pride as a citizen of Fontaine? What about your conscience as you watch our countrymen turn into husks of themselves from this drink?",
            "nextDialogs": [
              "740090406"
            ]
          },
          "740090406": {
            "id": "740090406",
            "speakerId": 5131,
            "speakerName": "Luca",
            "text": "Bah!",
            "nextDialogs": [
              "740090407"
            ]
          },
          "740090407": {
            "id": "740090407",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "Oho? How shocking, even Luca is showing intense emotion in response to your words. You see, my dear Virgil, you've truly accomplished the impossible.",
            "nextDialogs": [
              "740090408"
            ]
          },
          "740090408": {
            "id": "740090408",
            "speakerId": 21027,
            "speakerName": "Virgil",
            "text": "Mr. Sonny, I... Please believe me, i—it's all because of what those guys said, they lied to me, I—I would not have done anything if not for...",
            "nextDialogs": [
              "740090409"
            ]
          },
          "740090409": {
            "id": "740090409",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "Silence, you worthless dross!",
            "nextDialogs": [
              "740090410"
            ]
          },
          "740090410": {
            "id": "740090410",
            "speakerId": 21027,
            "speakerName": "Virgil",
            "text": "Argh!",
            "nextDialogs": [
              "740090411"
            ]
          },
          "740090411": {
            "id": "740090411",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "You're the exact kind of lowlife I've got no time for. Even now, you're still trying to lie to me? Huh? Are you beyond dumb, or do you think I'm dumb? Not so talkative now, are you?",
            "nextDialogs": [
              "740090412"
            ]
          },
          "740090412": {
            "id": "740090412",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "#You even tried to hurt {NICKNAME}. Did you have even the faintest inkling of who you were asked to deal with? To think that he could have trained someone as clueless as you... I've really got to have a good conversation with him...",
            "nextDialogs": [
              "740090413"
            ]
          },
          "740090413": {
            "id": "740090413",
            "speakerId": 5132,
            "speakerName": "Sonny",
            "text": "But that will not be something you'll need to worry about, my dear Virgil."
          }
        }
      }
    },
    {
      "subId": "7400905",
      "subQuestName": "Talk to Virgil",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    }
  ]

  },
  "subQuests": [
    {
      "subId": "7666101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766503601"
        ],
        "dialogs": {
          "766503601": {
            "id": "766503601",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "Ina, Kari, allow me to pass the message on your behalf.",
            "nextDialogs": [
              "766503602"
            ]
          },
          "766503602": {
            "id": "766503602",
            "speakerId": 1001,
            "speakerName": "Ina",
            "text": "M—Miss Lauma!",
            "nextDialogs": [
              "766503603"
            ]
          },
          "766503603": {
            "id": "766503603",
            "speakerId": 1002,
            "speakerName": "Kari",
            "text": "Ah... Well... we wouldn't wanna trouble you. Granny Sarakka says you're always busy, so it'd be best not to disturb you with small stuff like this...",
            "nextDialogs": [
              "766503604"
            ]
          },
          "766503604": {
            "id": "766503604",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "Don't worry. I do happen to be free at the moment. And yes, I did hear what you said.",
            "nextDialogs": [
              "766503605"
            ]
          },
          "766503605": {
            "id": "766503605",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "In which case, allow me to ask this puffin if it recognizes your friend.",
            "nextDialogs": [
              "766503606"
            ]
          },
          "766503606": {
            "id": "766503606",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "Dear child. Do you know the little puffin Ina and Kari took care of previously?",
            "nextDialogs": [
              "766503607"
            ]
          },
          "766503607": {
            "id": "766503607",
            "speakerId": 1003,
            "speakerName": "Puffin",
            "text": "(Friend, friend! Know, yes! At home! Too long away, danger, danger!)",
            "nextDialogs": [
              "766503608"
            ]
          },
          "766503608": {
            "id": "766503608",
            "speakerId": 1003,
            "speakerName": "Puffin",
            "text": "(Papa, Mama, worried. Papa, Mama, stopped it from leaving!)",
            "nextDialogs": [
              "766503609"
            ]
          },
          "766503609": {
            "id": "766503609",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "...I see. Ina, it seems your deduction was spot on.",
            "nextDialogs": [
              "766503610"
            ]
          },
          "766503610": {
            "id": "766503610",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "Your friend is currently stuck at home, getting an earful from its parents for being away for too long.",
            "nextDialogs": [
              "766503611"
            ]
          },
          "766503611": {
            "id": "766503611",
            "speakerId": 1002,
            "speakerName": "Kari",
            "text": "Wow, you're pretty smart, Ina!",
            "nextDialogs": [
              "766503612"
            ]
          },
          "766503612": {
            "id": "766503612",
            "speakerId": 1001,
            "speakerName": "Ina",
            "text": "Hehe, I do read a lot of books normally, you know.",
            "nextDialogs": [
              "766503613"
            ]
          },
          "766503613": {
            "id": "766503613",
            "speakerId": 1003,
            "speakerName": "Puffin",
            "text": "(Friend, good! Friend, want to see! Come to home, hurry to home!)",
            "nextDialogs": [
              "766503614"
            ]
          },
          "766503614": {
            "id": "766503614",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "...Hmm? It seems... this puffin says that your friend also misses you.",
            "nextDialogs": [
              "766503615"
            ]
          },
          "766503615": {
            "id": "766503615",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "It can't go outside right now, but you could... go be its guests instead?",
            "nextDialogs": [
              "766503616"
            ]
          },
          "766503616": {
            "id": "766503616",
            "speakerId": 1002,
            "speakerName": "Kari",
            "text": "Huh? Could we? But I don't even know where it lives...",
            "nextDialogs": [
              "766503617"
            ]
          },
          "766503617": {
            "id": "766503617",
            "speakerId": 1001,
            "speakerName": "Ina",
            "text": "And if we're out of doors for too long, we'll be the ones getting scolded by our parents...",
            "nextDialogs": [
              "766503618"
            ]
          },
          "766503618": {
            "id": "766503618",
            "speakerId": 1004,
            "speakerName": "Rimehorn Deer",
            "text": "(Lady Lauma. Allow me to escort the two children. It is not far to go from here — a round trip shall not even take half a day.)",
            "nextDialogs": [
              "766503619"
            ]
          },
          "766503619": {
            "id": "766503619",
            "speakerId": 1004,
            "speakerName": "Rimehorn Deer",
            "text": "(It is no ill deed to help old friends meet again.)",
            "nextDialogs": [
              "766503620"
            ]
          },
          "766503620": {
            "id": "766503620",
            "speakerId": 1003,
            "speakerName": "Puffin",
            "text": "(I'll lead the way! Lead the way! I fly high! I know the shortcuts!)",
            "nextDialogs": [
              "766503621"
            ]
          },
          "766503621": {
            "id": "766503621",
            "speakerId": 1002,
            "speakerName": "Kari",
            "text": "What are they saying, Lauma?",
            "nextDialogs": [
              "766503622"
            ]
          },
          "766503622": {
            "id": "766503622",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "It would seem that your previous concerns have been resolved.",
            "nextDialogs": [
              "766503623"
            ]
          },
          "766503623": {
            "id": "766503623",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "This puffin is willing to take you to see your friend, and this deer wishes to escort you there and back again.",
            "nextDialogs": [
              "766503624"
            ]
          },
          "766503624": {
            "id": "766503624",
            "speakerId": 1001,
            "speakerName": "Ina",
            "text": "Wow? Really? Is that true, Miss Lauma, is it?",
            "nextDialogs": [
              "766503625"
            ]
          },
          "766503625": {
            "id": "766503625",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "Of course it is. Have I ever lied to you?",
            "nextDialogs": [
              "766503626"
            ]
          },
          "766503626": {
            "id": "766503626",
            "speakerId": 1002,
            "speakerName": "Kari",
            "text": "Ohh, that's... that's great! Thank you! And thank you, too!",
            "nextDialogs": [
              "766503627"
            ]
          },
          "766503627": {
            "id": "766503627",
            "speakerId": 1003,
            "speakerName": "Puffin",
            "text": "(Easy-peasy, leave it to me-see!)",
            "nextDialogs": [
              "766503628"
            ]
          },
          "766503628": {
            "id": "766503628",
            "speakerId": 1004,
            "speakerName": "Rimehorn Deer",
            "text": "(Mmm. Of wholesome heart and polite, these children are. Lady Lauma, they shall be safe with us.)",
            "nextDialogs": [
              "766503629"
            ]
          },
          "766503629": {
            "id": "766503629",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "I shall be counting on you two, then. Please come to the library once your task is done. I have a gift for you.",
            "nextDialogs": [
              "766503630"
            ]
          },
          "766503630": {
            "id": "766503630",
            "speakerId": 1004,
            "speakerName": "Rimehorn Deer",
            "text": "(You are most welcome, Lady Lauma. There is no need for such decorum when aiding family.)",
            "nextDialogs": [
              "766503631"
            ]
          },
          "766503631": {
            "id": "766503631",
            "speakerId": 1003,
            "speakerName": "Puffin",
            "text": "(I wanna eat fruit! So does he! He wants 'em too, but he won't say!)",
            "nextDialogs": [
              "766503632"
            ]
          },
          "766503632": {
            "id": "766503632",
            "speakerId": 1004,
            "speakerName": "Rimehorn Deer",
            "text": "(...*sigh*)",
            "nextDialogs": [
              "766503633"
            ]
          },
          "766503633": {
            "id": "766503633",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "Hehe. In that case, I shall prepare the sweetest of fruits for you both.",
            "nextDialogs": [
              "766503634"
            ]
          },
          "766503634": {
            "id": "766503634",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "Come, Ina, Kari. When you hop on, be sure to sit tight.",
            "nextDialogs": [
              "766503635"
            ]
          },
          "766503635": {
            "id": "766503635",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "Don't look up as you pass through the woods, and don't reach out your hands. Just stay low and stay seated, alright?",
            "nextDialogs": [
              "766503636"
            ]
          },
          "766503636": {
            "id": "766503636",
            "speakerId": 1005,
            "speakerName": "Ina & Kari",
            "text": "Okay, Miss Lauma!",
            "nextDialogs": [
              "766503637"
            ]
          },
          "766503637": {
            "id": "766503637",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "Ina and Kari climb atop the Rimehorn Deer's back. Afterward, the puffin begins flying, with the deer following closely. Very quickly, the two people and two animals disappear from sight...",
            "nextDialogs": [
              "766503638"
            ]
          },
          "766503638": {
            "id": "766503638",
            "speakerId": 1000,
            "speakerName": "Lauma",
            "text": "I hope you have a wonderful time, dear children."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7404501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740450101"
        ],
        "dialogs": {
          "740450101": {
            "id": "740450101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Puca, why are you here again?",
            "nextDialogs": [
              "740450102"
            ]
          },
          "740450102": {
            "id": "740450102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There shouldn't be any more monsters nearby, but who knows what other dangers there might be...",
            "nextDialogs": [
              "740450103"
            ]
          },
          "740450103": {
            "id": "740450103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, you shouldn't go running off on your own!",
            "nextDialogs": [
              "740450104"
            ]
          },
          "740450104": {
            "id": "740450104",
            "speakerId": 16473,
            "speakerName": "Puca",
            "text": "#I didn't run off, Paimon and {NICKNAME}... I'm just looking for my token...",
            "nextDialogs": [
              "740450105"
            ]
          },
          "740450105": {
            "id": "740450105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? You lost your token?",
            "nextDialogs": [
              "740450106"
            ]
          },
          "740450106": {
            "id": "740450106",
            "speakerId": 16473,
            "speakerName": "Puca",
            "text": "Yup... It should be somewhere around that place I usually pick rocks from...",
            "nextDialogs": [
              "740450107"
            ]
          },
          "740450107": {
            "id": "740450107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... You might've dropped it when you got trapped there before.",
            "nextDialogs": [
              "740450108"
            ]
          },
          "740450108": {
            "id": "740450108",
            "speakerId": 16473,
            "speakerName": "Puca",
            "text": "*sniff* Yeah, you might be right... I was too scared to care about anything else at that time...",
            "nextDialogs": [
              "740450109"
            ]
          },
          "740450109": {
            "id": "740450109",
            "speakerId": 16473,
            "speakerName": "Puca",
            "text": "It's still a little scary to think about, but my token's very important... I have to find it, I just have to...",
            "nextDialogs": [
              "740450110"
            ]
          },
          "740450110": {
            "id": "740450110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Paimon thinks it'll be too dangerous if Puca goes there on her own. In that case...",
            "nextDialogs": [
              "740450111"
            ]
          },
          "740450111": {
            "id": "740450111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, why don't we take a trip back there and help Puca find her token? Puca, just go home and wait for us!",
            "nextDialogs": [
              "740450114"
            ]
          },
          "740450114": {
            "id": "740450114",
            "speakerId": 16473,
            "speakerName": "Puca",
            "text": "#Thank you, {NICKNAME} and Paimon! I'll be good and wait for you at home."
          }
        }
      }
    },
    {
      "subId": "7404502",
      "subQuestName": "Look for Puca's token",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740450201"
        ],
        "dialogs": {
          "740450201": {
            "id": "740450201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Puca, we're back! We found your token.",
            "nextDialogs": [
              "740450202"
            ]
          },
          "740450202": {
            "id": "740450202",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You give the token to Puca.",
            "nextDialogs": [
              "740450203"
            ]
          },
          "740450203": {
            "id": "740450203",
            "speakerId": 5322,
            "speakerName": "Puca",
            "text": "Ohh, yes, this is the one! Thank you so much!",
            "nextDialogs": [
              "740450204"
            ]
          },
          "740450204": {
            "id": "740450204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We also found something else while we were looking for your token...",
            "nextDialogs": [
              "740450205"
            ]
          },
          "740450205": {
            "id": "740450205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's an ore we've never seen before. We thought it might be valuable, so we brought it back!",
            "nextDialogs": [
              "740450206"
            ]
          },
          "740450206": {
            "id": "740450206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "If Paimon remembers correctly, you often pick up pretty stones around this area, right? Have you seen any stones like this before?",
            "nextDialogs": [
              "740450207"
            ]
          },
          "740450207": {
            "id": "740450207",
            "speakerId": 5322,
            "speakerName": "Puca",
            "text": "Let me see... It really is pretty! But it's not precious at all... it's just an ordinary stone...",
            "nextDialogs": [
              "740450208"
            ]
          },
          "740450208": {
            "id": "740450208",
            "speakerId": 5322,
            "speakerName": "Puca",
            "text": "It's true that you won't find anything like this in other places, but they're everywhere in nearby ore veins!",
            "nextDialogs": [
              "740450209"
            ]
          },
          "740450209": {
            "id": "740450209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aw, so it's just an ordinary rock! Paimon thought it looked super valuable...",
            "nextDialogs": [
              "740450210"
            ]
          },
          "740450210": {
            "id": "740450210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seems like we can't use it for anything else. Let's just find a place to dump it...",
            "nextDialogs": [
              "740450213"
            ]
          },
          "740450213": {
            "id": "740450213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, you mean we could make a fortune if we took it elsewhere and sold it?",
            "nextDialogs": [
              "740450214"
            ]
          },
          "740450214": {
            "id": "740450214",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#You do have a point! People don't normally go mining in a Melusine village, which means they've probably never seen anything like this... Great thinking, {NICKNAME}!",
            "nextDialogs": [
              "740450215"
            ]
          },
          "740450215": {
            "id": "740450215",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "C'mon, let's take this stone to the Court of Fontaine and show the merchants!",
            "nextDialogs": [
              "740450216"
            ]
          },
          "740450216": {
            "id": "740450216",
            "speakerId": 5322,
            "speakerName": "Puca",
            "text": "If there's anything else you'd like to know about ores, come find me anytime...",
            "nextDialogs": [
              "740450217"
            ]
          },
          "740450217": {
            "id": "740450217",
            "speakerId": 5322,
            "speakerName": "Puca",
            "text": "Though I don't run a gemstone workshop like my sister and don't know much about appraisals or processing...",
            "nextDialogs": [
              "740450218"
            ]
          },
          "740450218": {
            "id": "740450218",
            "speakerId": 5322,
            "speakerName": "Puca",
            "text": "Compared to precious gems, I prefer collecting all kinds of unique rocks...",
            "nextDialogs": [
              "740450219"
            ]
          },
          "740450219": {
            "id": "740450219",
            "speakerId": 5322,
            "speakerName": "Puca",
            "text": "I guess you can say I know the local ore veins pretty well!",
            "nextDialogs": [
              "740450220"
            ]
          },
          "740450220": {
            "id": "740450220",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, gotcha!"
          }
        }
      }
    },

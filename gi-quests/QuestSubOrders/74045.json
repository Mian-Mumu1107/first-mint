    {
      "subId": "7404504",
      "subQuestName": "Take the strange ore to the Gem Merchant in the Court of Fontaine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740450401"
        ],
        "dialogs": {
          "740450401": {
            "id": "740450401",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Welcome, welcome. Our store offers the most extensive selection of precious gems in the entire Court of Fontaine. We also have a wide range of craft goods on sale.",
            "nextDialogs": [
              "740450402"
            ]
          },
          "740450402": {
            "id": "740450402",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Anything catch your eye? If not, I would be delighted to meet any other demands!",
            "nextDialogs": [
              "740450403"
            ]
          },
          "740450403": {
            "id": "740450403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We've got some mysterious ore here...",
            "nextDialogs": [
              "740450404"
            ]
          },
          "740450404": {
            "id": "740450404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yup! Since you have such an extensive inventory, you should know its value, right?",
            "nextDialogs": [
              "740450405"
            ]
          },
          "740450405": {
            "id": "740450405",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Oh? So you're here to trade ore?",
            "nextDialogs": [
              "740450406"
            ]
          },
          "740450406": {
            "id": "740450406",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Then you've come to the right person! We offer some of the best and fairest prices in Fontaine.",
            "nextDialogs": [
              "740450407"
            ]
          },
          "740450407": {
            "id": "740450407",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Let's see what you have here...",
            "nextDialogs": [
              "740450408"
            ]
          },
          "740450408": {
            "id": "740450408",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You show Chesil the strange ore you found earlier.",
            "nextDialogs": [
              "740450409"
            ]
          },
          "740450409": {
            "id": "740450409",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Whoa... Even I've never seen anything like this before...",
            "nextDialogs": [
              "740450410"
            ]
          },
          "740450410": {
            "id": "740450410",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "The unique sheen and smooth texture... Ooh, this is no doubt a rare variety!",
            "nextDialogs": [
              "740450411"
            ]
          },
          "740450411": {
            "id": "740450411",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Pardon me for asking, but what exactly is this?",
            "nextDialogs": [
              "740450413",
              "740450415",
              "740450417"
            ]
          },
          "740450413": {
            "id": "740450413",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "Is that why you're here for an appraisal?",
            "nextDialogs": [
              "740450419"
            ]
          },
          "740450419": {
            "id": "740450419",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "It's such a shame you only brought one chunk of ore...",
            "nextDialogs": [
              "740450420"
            ]
          },
          "740450420": {
            "id": "740450420",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "If only we had a steady supply... We could forge accessories that would take Fontaine by storm.",
            "nextDialogs": [
              "740450421"
            ]
          },
          "740450421": {
            "id": "740450421",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(Puca mentioned these stones were everywhere near the ore veins. Maybe we should ask her...)"
          },
          "740450415": {
            "id": "740450415",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, don't give it weird names!"
          },
          "740450417": {
            "id": "740450417",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa! Did you just come up with that on the spot?",
            "nextDialogs": [
              "740450418"
            ]
          },
          "740450418": {
            "id": "740450418",
            "speakerId": 5096,
            "speakerName": "Chesil",
            "text": "What an impressive name! No wonder it looks so unique."
          }
        }
      }
    },
    {
      "subId": "7404506",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740450601"
        ],
        "dialogs": {
          "740450601": {
            "id": "740450601",
            "speakerId": 16473,
            "speakerName": "Puca",
            "text": "Hey there, it's you again!",
            "nextDialogs": [
              "740450602"
            ]
          },
          "740450602": {
            "id": "740450602",
            "speakerId": 16473,
            "speakerName": "Puca",
            "text": "Is there anything you'd like to know about ore? You can ask me anything!",
            "nextDialogs": [
              "740450603"
            ]
          },
          "740450603": {
            "id": "740450603",
            "speakerId": 16473,
            "speakerName": "Puca",
            "text": "Even though I might not have an answer...",
            "nextDialogs": [
              "740450605",
              "740450608",
              "740450610"
            ]
          },
          "740450605": {
            "id": "740450605",
            "speakerId": 16473,
            "speakerName": "Puca",
            "text": "There's lots of beautiful and sparkly stones in the ore veins nearby, but they're nowhere as good as real gemstones...",
            "nextDialogs": [
              "740450606"
            ]
          },
          "740450606": {
            "id": "740450606",
            "speakerId": 16473,
            "speakerName": "Puca",
            "text": "If I were better at finding real gemstones, maybe I could open my own gemstone workshop, just like Sluasi!"
          },
          "740450608": {
            "id": "740450608",
            "speakerId": 16473,
            "speakerName": "Puca",
            "text": "Huh? I've never thought about that before... I only collect stones because they're pretty..."
          },
          "740450610": {
            "id": "740450610",
            "speakerId": 16473,
            "speakerName": "Puca",
            "text": "Hehe, thanks for coming to play with me!"
          }
        }
      }
    },
    {
      "subId": "7404508",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740450501"
        ],
        "dialogs": {
          "740450501": {
            "id": "740450501",
            "speakerId": 16473,
            "speakerName": "Puca",
            "text": "My token is really important... I have to find it..."
          }
        }
      }
    }
  ]
}
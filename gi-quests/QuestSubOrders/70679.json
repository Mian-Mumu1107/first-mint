        "dialogs": {
          "706790101": {
            "id": "706790101",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "Why hello, hello! We meet again! What fortune!",
            "nextDialogs": [
              "706790103",
              "706790105"
            ]
          },
          "706790103": {
            "id": "706790103",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "Gygax! I'm Gygax! You know, from Windtrace! Ring any bells?",
            "nextDialogs": [
              "706790106"
            ]
          },
          "706790106": {
            "id": "706790106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So that's who you are!",
            "nextDialogs": [
              "706790107"
            ]
          },
          "706790107": {
            "id": "706790107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oh, I remember now!",
            "nextDialogs": [
              "706790108"
            ]
          },
          "706790108": {
            "id": "706790108",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "You say that, but your expression says you don't remember a thing...",
            "nextDialogs": [
              "706790109"
            ]
          },
          "706790109": {
            "id": "706790109",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "Anyway, please, look over here. I'm sure you remember Windtrace at least, don't you?",
            "nextDialogs": [
              "706790110"
            ]
          },
          "706790110": {
            "id": "706790110",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "Didn't you give me a ton of suggestions after your previous round of play-testing? They were great ideas, too. I've taken just about all of them on board.",
            "nextDialogs": [
              "706790111"
            ]
          },
          "706790111": {
            "id": "706790111",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "I've revised the rules and gameplay once... Uh, well, several times since then."
          },
          "706790105": {
            "id": "706790105",
            "speakerId": 1000,
            "speakerName": "Gygax",
            "text": "It's Gygax! But you're not wrong... and it's not as if I'm upset that Windtrace is more famous than I am."
          }
        }
      }
    }
  ]
}
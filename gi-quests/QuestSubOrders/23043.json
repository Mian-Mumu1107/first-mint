  "subQuests": [
    {
      "subId": "2304306",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230430601"
        ],
        "dialogs": {
          "230430601": {
            "id": "230430601",
            "speakerId": 4154,
            "speakerName": "Rama",
            "text": "Made up your mind yet? Want to place your order with me?",
            "nextDialogs": [
              "230430603",
              "230430605"
            ]
          },
          "230430603": {
            "id": "230430603",
            "speakerId": 4154,
            "speakerName": "Rama",
            "text": "Thanks for your patronage! Please wait a moment while I make preparations and arrange delivery."
          },
          "230430605": {
            "id": "230430605",
            "speakerId": 4154,
            "speakerName": "Rama",
            "text": "Alright. But hurry up, please. If you wait too long, I may be out of stock."
          }
        }
      }
    },
    {
      "subId": "2304301",
      "subQuestName": "Talk to Azalai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230430101"
        ],
        "dialogs": {
          "230430101": {
            "id": "230430101",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "I'll have to ask Raef to find someone...",
            "nextDialogs": [
              "230430102"
            ]
          },
          "230430102": {
            "id": "230430102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why the long face?",
            "nextDialogs": [
              "230430103"
            ]
          },
          "230430103": {
            "id": "230430103",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "What are you looking to buy, Traveler? I'm afraid that we may be somewhat out of stock.",
            "nextDialogs": [
              "230430104"
            ]
          },
          "230430104": {
            "id": "230430104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So that's what troubles you?",
            "nextDialogs": [
              "230430105"
            ]
          },
          "230430105": {
            "id": "230430105",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "Yes... This is a desert village, so shipment has always been troublesome for us.",
            "nextDialogs": [
              "230430106"
            ]
          },
          "230430106": {
            "id": "230430106",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "Whenever I want to source some wares, I need to ask those who happen to leave the village to place an order for me, then transport it to the village together with Raef.",
            "nextDialogs": [
              "230430107"
            ]
          },
          "230430107": {
            "id": "230430107",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "One way or another, my business costs are slowly rising. To make ends meet, I have no other choice than to increase my prices.",
            "nextDialogs": [
              "230430108"
            ]
          },
          "230430108": {
            "id": "230430108",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "Thankfully, the people of this village understand my predicament and are willing to support my business, otherwise... I would've gone bankrupt a long time ago.",
            "nextDialogs": [
              "230430109"
            ]
          },
          "230430109": {
            "id": "230430109",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "But, alas... I can't find anyone who's planning to leave the village, and Raef and his crew aren't always available...",
            "nextDialogs": [
              "230430110"
            ]
          },
          "230430110": {
            "id": "230430110",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "If I'm unlucky, some low-volume goods may be out of stock soon...",
            "nextDialogs": [
              "230430112",
              "230430115"
            ]
          },
          "230430112": {
            "id": "230430112",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "They are all daily essentials. Even though I'm usually quick to source them, they sell even quicker.",
            "nextDialogs": [
              "230430113"
            ]
          },
          "230430113": {
            "id": "230430113",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "I'm running a small business, so I can't always buy large volumes.",
            "nextDialogs": [
              "230430117"
            ]
          },
          "230430117": {
            "id": "230430117",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "Ahem... that's a topic for another day. Traveler, perhaps you are getting ready to leave the village?",
            "nextDialogs": [
              "230430118"
            ]
          },
          "230430118": {
            "id": "230430118",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "I've been wanting to source some spices and need someone to place an order for me... Could you assist me with this?"
          },
          "230430115": {
            "id": "230430115",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "It's not like I haven't considered that, but look around you.",
            "nextDialogs": [
              "230430116"
            ]
          },
          "230430116": {
            "id": "230430116",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "Shipping goods into the village and running business here aren't exactly easy."
          }
        }
      }
    },
    {
      "subId": "2304302",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230430201"
        ],
        "dialogs": {
          "230430201": {
            "id": "230430201",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "How did it go? Have you placed an order yet?",
            "nextDialogs": [
              "230430204",
              "230430205"
            ]
          },
          "230430204": {
            "id": "230430204",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "You can't find her exact location? Okay... I'll mark that spot on the map for you.",
            "nextDialogs": [
              "230430206"
            ]
          },
          "230430206": {
            "id": "230430206",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "You should be good to go now. I'm counting on you, Traveler."
          },
          "230430205": {
            "id": "230430205",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "You can't find his exact location? Okay... I'll mark that spot on the map for you."
          }
        }
      }
    },

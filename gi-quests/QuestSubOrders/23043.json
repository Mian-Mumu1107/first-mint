    {
      "subId": "2304312",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230431201"
        ],
        "dialogs": {
          "230431201": {
            "id": "230431201",
            "speakerId": 4159,
            "speakerName": "Jahangir",
            "text": "Hey, have you decided yet? One word and I'll start prepping everything.",
            "nextDialogs": [
              "230431203",
              "230431205"
            ]
          },
          "230431203": {
            "id": "230431203",
            "speakerId": 4159,
            "speakerName": "Jahangir",
            "text": "Okay! I'll send one of my employees to deliver the order when I'm done making Dried Fish."
          },
          "230431205": {
            "id": "230431205",
            "speakerId": 4159,
            "speakerName": "Jahangir",
            "text": "Huh? Didn't I say you wouldn't find such tasty Dried Fish elsewhere? There's not much to think about..."
          }
        }
      }
    },
    {
      "subId": "2304305",
      "subQuestName": "Report back to Azalai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230430501"
        ],
        "dialogs": {
          "230430501": {
            "id": "230430501",
            "speakerId": 4154,
            "speakerName": "Rama",
            "text": "Welcome! Want to buy some spices? We have all the usuals, and all at affordable prices!",
            "nextDialogs": [
              "230430502"
            ]
          },
          "230430502": {
            "id": "230430502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Azalai's order...",
            "nextDialogs": [
              "230430503"
            ]
          },
          "230430503": {
            "id": "230430503",
            "speakerId": 4154,
            "speakerName": "Rama",
            "text": "Huh? Azalai asked you to place an order for him? No problem at all...",
            "nextDialogs": [
              "230430504"
            ]
          },
          "230430504": {
            "id": "230430504",
            "speakerId": 4154,
            "speakerName": "Rama",
            "text": "It's just that he used to ask the Eremites to source his goods, and this time, he commissioned an Adventurer...",
            "nextDialogs": [
              "230430505"
            ]
          },
          "230430505": {
            "id": "230430505",
            "speakerId": 4154,
            "speakerName": "Rama",
            "text": "Ahem! What's his budget today? Let's see... Ooh, quite a bit.",
            "nextDialogs": [
              "230430506"
            ]
          },
          "230430506": {
            "id": "230430506",
            "speakerId": 4154,
            "speakerName": "Rama",
            "text": "Uh, if you place an order at my store, the spices supplied by me should last him for a long while.",
            "nextDialogs": [
              "230430507"
            ]
          },
          "230430507": {
            "id": "230430507",
            "speakerId": 4154,
            "speakerName": "Rama",
            "text": "As for the selling price... Just like before, I suggest setting a slightly lower price point. That's an easy way to boost sales.",
            "nextDialogs": [
              "230430509",
              "230430511"
            ]
          },
          "230430509": {
            "id": "230430509",
            "speakerId": 4154,
            "speakerName": "Rama",
            "text": "Oh! Thanks for your patronage! Please wait a moment while I make preparations and arrange delivery."
          },
          "230430511": {
            "id": "230430511",
            "speakerId": 4154,
            "speakerName": "Rama",
            "text": "Okay... Come back and tell me if you change your mind."
          }
        }
      }
    },
    {
      "subId": "2304316",
      "subQuestName": "Report back to Azalai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230431303"
        ],
        "dialogs": {
          "230431303": {
            "id": "230431303",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You bring Azalai up to speed on sourcing goods...",
            "nextDialogs": [
              "230431304"
            ]
          },
          "230431304": {
            "id": "230431304",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "Hm... Ordered from Rama's? Should be alright.",
            "nextDialogs": [
              "230431305"
            ]
          },
          "230431305": {
            "id": "230431305",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "Her spices are both cheap and of good quality, very popular with the people of this village. Once they arrive, selling them shouldn't be a problem.",
            "nextDialogs": [
              "230431306"
            ]
          },
          "230431306": {
            "id": "230431306",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "Thanks for your help, Traveler. This is your remuneration. And this Mora, please take it along, too.",
            "nextDialogs": [
              "230431307"
            ]
          },
          "230431307": {
            "id": "230431307",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "That miser Rama though... I've ordered so many times from her, and she never gave me a discount."
          }
        }
      }
    },
    {
      "subId": "2304307",
      "subQuestName": "Talk to Azalai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230430701"
        ],
        "dialogs": {
          "230430701": {
            "id": "230430701",
            "speakerId": 4130,
            "speakerName": "Butrus",
            "text": "Welcome! Are you looking for fish? Then you've come to the right place! There are no fish fresher than mine. Ask that cat over there if you don't believe me.",
            "nextDialogs": [
              "230430702"
            ]
          },
          "230430702": {
            "id": "230430702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Azalai's order...",
            "nextDialogs": [
              "230430703"
            ]
          },
          "230430703": {
            "id": "230430703",
            "speakerId": 4130,
            "speakerName": "Butrus",
            "text": "Huh... Azalai is looking to source some Dried Fish from me? No worries.",
            "nextDialogs": [
              "230430704"
            ]
          },
          "230430704": {
            "id": "230430704",
            "speakerId": 4130,
            "speakerName": "Butrus",
            "text": "This amount of Mora is enough to buy a large quantity of Dried Fish. It should last him for a while.",
            "nextDialogs": [
              "230430705"
            ]
          },
          "230430705": {
            "id": "230430705",
            "speakerId": 4130,
            "speakerName": "Butrus",
            "text": "Though my Dried Fish is... well... faithful to the original flavor! No spices or anything like that.",
            "nextDialogs": [
              "230430707",
              "230430709"
            ]
          },
          "230430707": {
            "id": "230430707",
            "speakerId": 4130,
            "speakerName": "Butrus",
            "text": "Alright! Hehe... I'll go pick out some Dried Fish and get someone to deliver his order to him in a bit."
          },
          "230430709": {
            "id": "230430709",
            "speakerId": 4130,
            "speakerName": "Butrus",
            "text": "Huh? Fine... Go ahead and compare prices.",
            "nextDialogs": [
              "230430710"
            ]
          },
          "230430710": {
            "id": "230430710",
            "speakerId": 4130,
            "speakerName": "Butrus",
            "text": "But I can't really afford to give you another discount. I won't make any profit otherwise."
          }
        }
      }
    },
    {
      "subId": "2304308",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230430801"
        ],
        "dialogs": {
          "230430801": {
            "id": "230430801",
            "speakerId": 4130,
            "speakerName": "Butrus",
            "text": "What say you? Want to order Dried Fish from me?",
            "nextDialogs": [
              "230430803",
              "230430805"
            ]
          },
          "230430803": {
            "id": "230430803",
            "speakerId": 4130,
            "speakerName": "Butrus",
            "text": "Alright! Hehe... I'll go pick out some Dried Fish and get someone to deliver his order to him in a bit."
          },
          "230430805": {
            "id": "230430805",
            "speakerId": 4130,
            "speakerName": "Butrus",
            "text": "Don't be too long or there won't be any Dried Fish left."
          }
        }
      }
    },
    {
      "subId": "2304309",
      "subQuestName": "Learn about the situation from Butrus",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230430901"
        ],
        "dialogs": {
          "230430901": {
            "id": "230430901",
            "speakerId": 12891,
            "speakerName": "Jut",
            "text": "Hi, are you shopping for spices?",
            "nextDialogs": [
              "230430902"
            ]
          },
          "230430902": {
            "id": "230430902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Azalai's order...",
            "nextDialogs": [
              "230430903"
            ]
          },
          "230430903": {
            "id": "230430903",
            "speakerId": 12891,
            "speakerName": "Jut",
            "text": "For this amount... He won't be able to buy much. However, my spices are worth a lot of Mora.",
            "nextDialogs": [
              "230430904"
            ]
          },
          "230430904": {
            "id": "230430904",
            "speakerId": 12891,
            "speakerName": "Jut",
            "text": "Well... Since it's his order, I'll add my two cents. As a friend, I don't really recommend him to buy from me.",
            "nextDialogs": [
              "230430905"
            ]
          },
          "230430905": {
            "id": "230430905",
            "speakerId": 12891,
            "speakerName": "Jut",
            "text": "From what I gathered about business in Aaru Village... I'd say that \"selling more at a lower price point\" is the way to go.",
            "nextDialogs": [
              "230430906"
            ]
          },
          "230430906": {
            "id": "230430906",
            "speakerId": 12891,
            "speakerName": "Jut",
            "text": "Simply put, it's about selling goods of passable quality for a relatively low price, and selling large quantities fast as a way to make a quick return on the invested capital.",
            "nextDialogs": [
              "230430907"
            ]
          },
          "230430907": {
            "id": "230430907",
            "speakerId": 12891,
            "speakerName": "Jut",
            "text": "Conversely, if he tries to sell expensive high-quality goods in Aaru Village, the return will be slow.",
            "nextDialogs": [
              "230430908"
            ]
          },
          "230430908": {
            "id": "230430908",
            "speakerId": 12891,
            "speakerName": "Jut",
            "text": "But this is just my opinion. It's up to him what kind of goods he decides to sell.",
            "nextDialogs": [
              "230430910",
              "230430912"
            ]
          },
          "230430910": {
            "id": "230430910",
            "speakerId": 12891,
            "speakerName": "Jut",
            "text": "Alright. I'll go prepare the goods then."
          },
          "230430912": {
            "id": "230430912",
            "speakerId": 12891,
            "speakerName": "Jut",
            "text": "All good. If you still want to order from me, feel free to come back anytime."
          }
        }
      }
    },
    {
      "subId": "2304310",
      "subQuestName": "Learn about the situation from Jahangir",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230431001"
        ],
        "dialogs": {
          "230431001": {
            "id": "230431001",
            "speakerId": 12891,
            "speakerName": "Jut",
            "text": "How's it going? Made up your mind yet?",
            "nextDialogs": [
              "230431003",
              "230431005"
            ]
          },
          "230431003": {
            "id": "230431003",
            "speakerId": 12891,
            "speakerName": "Jut",
            "text": "Alright. I'll go prepare the goods then."
          },
          "230431005": {
            "id": "230431005",
            "speakerId": 12891,
            "speakerName": "Jut",
            "text": "I understand. We're talking about no small sums. Careful consideration is highly advised, indeed."
          }
        }
      }
    },
    {
      "subId": "2304311",
      "subQuestName": "Report back to Azalai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230431101"
        ],
        "dialogs": {
          "230431101": {
            "id": "230431101",
            "speakerId": 4159,
            "speakerName": "Jahangir",
            "text": "Welcome! Would you like to have a bite? Everything's freshly made.",
            "nextDialogs": [
              "230431102"
            ]
          },
          "230431102": {
            "id": "230431102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Azalai's order...",
            "nextDialogs": [
              "230431103"
            ]
          },
          "230431103": {
            "id": "230431103",
            "speakerId": 4159,
            "speakerName": "Jahangir",
            "text": "Ahaha, sure! I told him my Dried Fish is famous far and wide and will definitely sell for a good price.",
            "nextDialogs": [
              "230431104"
            ]
          },
          "230431104": {
            "id": "230431104",
            "speakerId": 4159,
            "speakerName": "Jahangir",
            "text": "This amount of Mora will get you some Dried Fish. Just say the word and I'll make a fresh batch for you.",
            "nextDialogs": [
              "230431105"
            ]
          },
          "230431105": {
            "id": "230431105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You'll start drying it now?",
            "nextDialogs": [
              "230431106"
            ]
          },
          "230431106": {
            "id": "230431106",
            "speakerId": 4159,
            "speakerName": "Jahangir",
            "text": "Of course not! What I meant was going to my warehouse to take the Dried Fish out and seasoning them to elevate their flavor profile.",
            "nextDialogs": [
              "230431107"
            ]
          },
          "230431107": {
            "id": "230431107",
            "speakerId": 4159,
            "speakerName": "Jahangir",
            "text": "Wait a minute... With the cost considered, you won't be able to buy that much Dried Fish after all.",
            "nextDialogs": [
              "230431109",
              "230431111"
            ]
          },
          "230431109": {
            "id": "230431109",
            "speakerId": 4159,
            "speakerName": "Jahangir",
            "text": "Okay! I'll send one of my employees to deliver the order when I'm done making Dried Fish."
          },
          "230431111": {
            "id": "230431111",
            "speakerId": 4159,
            "speakerName": "Jahangir",
            "text": "Huh? No need to rush, the price is negotiable. Besides, you won't find such tasty Dried Fish anywhere else!"
          }
        }
      }
    },
    {
      "subId": "2304317",
      "subQuestName": "Report back to Azalai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230431503"
        ],
        "dialogs": {
          "230431503": {
            "id": "230431503",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You bring Azalai up to speed on sourcing goods...",
            "nextDialogs": [
              "230431504"
            ]
          },
          "230431504": {
            "id": "230431504",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "I see, the quality of Butrus' Dried Fish is always reliable, and the quantity... not bad at all.",
            "nextDialogs": [
              "230431505"
            ]
          },
          "230431505": {
            "id": "230431505",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "When the goods arrive, I'll have to send some to doctor Maruf as thanks for treating my leg injury last time.",
            "nextDialogs": [
              "230431506"
            ]
          },
          "230431506": {
            "id": "230431506",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "There's also Raef and Fodil, they helped me unload cargo...",
            "nextDialogs": [
              "230431507"
            ]
          },
          "230431507": {
            "id": "230431507",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "Ahem! Thanks for your help, Traveler. This is your remuneration. And this Mora, please take it along, too.",
            "nextDialogs": [
              "230431508"
            ]
          },
          "230431508": {
            "id": "230431508",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "Fortunately, you ordered from Butrus. Giving some Dried Fish away shouldn't be a problem considering the order quantity."
          }
        }
      }
    },
    {
      "subId": "2304314",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230431403"
        ],
        "dialogs": {
          "230431403": {
            "id": "230431403",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You bring Azalai up to speed on sourcing goods...",
            "nextDialogs": [
              "230431404"
            ]
          },
          "230431404": {
            "id": "230431404",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "Ordered from Jut's? Are the prices high? Well, I'll have to raise my price point to match the cost then.",
            "nextDialogs": [
              "230431405"
            ]
          },
          "230431405": {
            "id": "230431405",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "But these spices seem to be of very high quality. I should not worry about selling them...",
            "nextDialogs": [
              "230431406"
            ]
          },
          "230431406": {
            "id": "230431406",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "By the way, Traveler, this is your remuneration."
          }
        }
      }
    },
    {
      "subId": "2304316",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230431603"
        ],
        "dialogs": {
          "230431603": {
            "id": "230431603",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You bring Azalai up to speed on sourcing goods...",
            "nextDialogs": [
              "230431604"
            ]
          },
          "230431604": {
            "id": "230431604",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "Purchased from Jahangir? The price is... *gasp* How can it be so pricey? What spices does he use? Mora itself?",
            "nextDialogs": [
              "230431605"
            ]
          },
          "230431605": {
            "id": "230431605",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "It's nothing I can't handle. Worst case scenario, I'll cut the Dried Fish up and sell it that way.",
            "nextDialogs": [
              "230431606"
            ]
          },
          "230431606": {
            "id": "230431606",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "Ah... Um, here is your payment, Traveler. Thank you for your help.",
            "nextDialogs": [
              "230431607"
            ]
          },
          "230431607": {
            "id": "230431607",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "How many pieces can these be cut into?"
          }
        }
      }
    },
    {
      "subId": "2304317",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230431701"
        ],
        "dialogs": {
          "230431701": {
            "id": "230431701",
            "speakerId": 4406,
            "speakerName": "Azalai",
            "text": "How's it going, Traveler? Did you place the order for me?",
            "nextDialogs": [
              "230431702"
            ]
          },
          "230431702": {
            "id": "230431702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I did."
          }
        }
      }
    }
  ]

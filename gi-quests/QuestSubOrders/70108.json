  "subQuests": [
    {
      "subId": "7010801",
      "subQuestName": "Talk to Esther",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701080101"
        ],
        "dialogs": {
          "701080101": {
            "id": "701080101",
            "speakerId": 1000,
            "speakerName": "Esther",
            "text": "Ugh, just as I expected... With only a limited number of beacons, the accuracy is nowhere near good enough. There's no way I can use this as a reliable altitude measurement.",
            "nextDialogs": [
              "701080102"
            ]
          },
          "701080102": {
            "id": "701080102",
            "speakerId": 1000,
            "speakerName": "Esther",
            "text": "Unless...",
            "nextDialogs": [
              "701080103"
            ]
          },
          "701080103": {
            "id": "701080103",
            "speakerId": 1001,
            "speakerName": "Traveler",
            "text": "...Unless?",
            "nextDialogs": [
              "701080104"
            ]
          },
          "701080104": {
            "id": "701080104",
            "speakerId": 1000,
            "speakerName": "Esther",
            "text": "Unless a fearless adventurer can scale the highest peak and place a beacon there for me.",
            "nextDialogs": [
              "701080107"
            ]
          },
          "701080107": {
            "id": "701080107",
            "speakerId": 1000,
            "speakerName": "Esther",
            "text": "Like you! Please, help me out one more time. All my other beacons keep getting destroyed by monsters, so this is the only way to reduce the margin of error in my measurements.",
            "nextDialogs": [
              "701080108"
            ]
          },
          "701080108": {
            "id": "701080108",
            "speakerId": 1000,
            "speakerName": "Esther",
            "text": "All you need to do is place it at the summit. If you succeed, I promise I will reward you generously!"
          }
        }
      }
    },
    {
      "subId": "7010802",
      "subQuestName": "Place a survey beacon on Dragonspine's summit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701080201"
        ],
        "dialogs": {
          "701080201": {
            "id": "701080201",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Brr... Th—That should d—do it...",
            "nextDialogs": [
              "701080202"
            ]
          },
          "701080202": {
            "id": "701080202",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So c—cold... Can we g—go now..."
          }
        }
      }
    },

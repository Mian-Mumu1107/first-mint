    {
      "subId": "7010804",
      "subQuestName": "Report back to Esther",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701080301"
        ],
        "dialogs": {
          "701080301": {
            "id": "701080301",
            "speakerId": 1000,
            "speakerName": "Esther",
            "text": "Did you put the beacon in place?",
            "nextDialogs": [
              "701080302"
            ]
          },
          "701080302": {
            "id": "701080302",
            "speakerId": 1001,
            "speakerName": "Traveler",
            "text": "Yep.",
            "nextDialogs": [
              "701080303"
            ]
          },
          "701080303": {
            "id": "701080303",
            "speakerId": 1000,
            "speakerName": "Esther",
            "text": "Wonderful! Thank you, now I can finally get a reliable measurement of the height of the mountain.",
            "nextDialogs": [
              "701080304"
            ]
          },
          "701080304": {
            "id": "701080304",
            "speakerId": 1000,
            "speakerName": "Esther",
            "text": "Oh, and regarding compensation — I asked Cyrus to put something together. Ask him for it next time you're in the city.",
            "nextDialogs": [
              "701080305"
            ]
          },
          "701080305": {
            "id": "701080305",
            "speakerId": 1000,
            "speakerName": "Esther",
            "text": "And since you'll see him before I do, could you also give him this letter for me? He promised to keep me in the loop about a second exploration team headed for the mountains, but I still haven't heard back about it.",
            "nextDialogs": [
              "701080306"
            ]
          },
          "701080306": {
            "id": "701080306",
            "speakerId": 1000,
            "speakerName": "Esther",
            "text": "Once the rest of my beacons are fixed, I'll have to head back up and set them all up. There's a lot of things that still need surveying on that mountain."
          }
        }
      }
    },
    {
      "subId": "7010805",
      "subQuestName": "Deliver the letter to Cyrus",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701080401"
        ],
        "dialogs": {
          "701080401": {
            "id": "701080401",
            "speakerId": 1003,
            "speakerName": "Cyrus",
            "text": "Hello, how may I help?",
            "nextDialogs": [
              "701080402"
            ]
          },
          "701080402": {
            "id": "701080402",
            "speakerId": 1001,
            "speakerName": "Traveler",
            "text": "I have a letter for you.",
            "nextDialogs": [
              "701080403"
            ]
          },
          "701080403": {
            "id": "701080403",
            "speakerId": 1003,
            "speakerName": "Cyrus",
            "text": "A letter? ...Oh, it's from her. I'll wager she's asking about the next exploration team again...",
            "nextDialogs": [
              "701080404"
            ]
          },
          "701080404": {
            "id": "701080404",
            "speakerId": 1003,
            "speakerName": "Cyrus",
            "text": "*sigh* I don't know what I can do. It's rare to find a team that's willing to take on the mountain these days — it's just too dangerous up there...",
            "nextDialogs": [
              "701080405"
            ]
          },
          "701080405": {
            "id": "701080405",
            "speakerId": 1003,
            "speakerName": "Cyrus",
            "text": "I'll write her a letter shortly to explain the situation. Thank you for making the trip to deliver this.",
            "nextDialogs": [
              "701080406"
            ]
          },
          "701080406": {
            "id": "701080406",
            "speakerId": 1003,
            "speakerName": "Cyrus",
            "text": "Speaking of letters, she sent another not long ago asking me to prepare a reward for you. Here, please take it.",
            "nextDialogs": [
              "701080407"
            ]
          },
          "701080407": {
            "id": "701080407",
            "speakerId": 1003,
            "speakerName": "Cyrus",
            "text": "One last thing... I can see that you are a hardy type, but nevertheless — I urge you to be careful in the mountains.",
            "nextDialogs": [
              "701080410"
            ]
          },
          "701080410": {
            "id": "701080410",
            "speakerId": 1003,
            "speakerName": "Cyrus",
            "text": "Ah, Dragonspine... If ever the chance arose to lead a team of explorers there in person, I would surely take it!"
          }
        }
      }
    },
    {
      "subId": "7010805",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701080501"
        ],
        "dialogs": {
          "701080501": {
            "id": "701080501",
            "speakerId": 1000,
            "speakerName": "Esther",
            "text": "A beacon placed right at the summit will be sure to minimize the margin of error in my measurements..."
          }
        }
      }
    },

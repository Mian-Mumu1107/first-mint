        "dialogs": {
          "401730501": {
            "id": "401730501",
            "speakerId": 1000,
            "speakerName": "Citlali",
            "text": "Hm? You alright?",
            "nextDialogs": [
              "401730502"
            ]
          },
          "401730502": {
            "id": "401730502",
            "speakerId": 1000,
            "speakerName": "Citlali",
            "text": "I have to return the ceremonial sword to the chief shortly, but I'll leave everything else in the camp as-is for now. Feel free to make use of it.",
            "nextDialogs": [
              "401730503"
            ]
          },
          "401730503": {
            "id": "401730503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Um... I have the latest volume of \"Mirage Warriors\" here...",
            "nextDialogs": [
              "401730504"
            ]
          },
          "401730504": {
            "id": "401730504",
            "speakerId": 1000,
            "speakerName": "Citlali",
            "text": "...Huh?",
            "nextDialogs": [
              "401730505"
            ]
          },
          "401730505": {
            "id": "401730505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Along with a special-edition spinoff of \"The Case Files of Miss Orith.\"",
            "nextDialogs": [
              "401730506"
            ]
          },
          "401730506": {
            "id": "401730506",
            "speakerId": 1000,
            "speakerName": "Citlali",
            "text": "HUH!?",
            "nextDialogs": [
              "401730507"
            ]
          },
          "401730507": {
            "id": "401730507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wanna read them together?",
            "nextDialogs": [
              "401730508"
            ]
          },
          "401730508": {
            "id": "401730508",
            "speakerId": 1000,
            "speakerName": "Citlali",
            "text": "Uhh...",
            "nextDialogs": [
              "401730509"
            ]
          },
          "401730509": {
            "id": "401730509",
            "speakerId": 1000,
            "speakerName": "Citlali",
            "text": "#(What is this? What's going on? How did {F#s}he know I like those books? Don't tell me... Has {F#she}{M#he} been trying to find out what I'm into?)",
            "nextDialogs": [
              "401730510"
            ]
          },
          "401730510": {
            "id": "401730510",
            "speakerId": 1000,
            "speakerName": "Citlali",
            "text": "(No, that's ridiculous, don't be silly... I bet Ororon sold me out, the little scamp...)",
            "nextDialogs": [
              "401730511"
            ]
          },
          "401730511": {
            "id": "401730511",
            "speakerId": 1000,
            "speakerName": "Citlali",
            "text": "#(Still... {F#s}he remembered, that's gotta mean something, right? Why make a note of some mundane detail like that?)",
            "nextDialogs": [
              "401730512"
            ]
          },
          "401730512": {
            "id": "401730512",
            "speakerId": 1000,
            "speakerName": "Citlali",
            "text": "#(Ugh, focus! {F#She}{M#He} asked me a question! Umm, umm, umm... Argh, how do I respond?)",
            "nextDialogs": [
              "401730513"
            ]
          },
          "401730513": {
            "id": "401730513",
            "speakerId": 1000,
            "speakerName": "Citlali",
            "text": "Ahem...",
            "nextDialogs": [
              "401730514"
            ]
          },
          "401730514": {
            "id": "401730514",
            "speakerId": 1000,
            "speakerName": "Citlali",
            "text": "Sure, why not. I should have some time later. I'll let you know."
          }
        }
      }
    }
  ]

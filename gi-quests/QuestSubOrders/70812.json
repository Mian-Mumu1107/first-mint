    {
      "subId": "7081206",
      "subQuestName": "Look for posters and billboards in Mondstadt",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708120601"
        ],
        "dialogs": {
          "708120601": {
            "id": "708120601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, even that signboard was blown off to such a high place..."
          }
        }
      }
    },
    {
      "subId": "7081207",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708120701"
        ],
        "dialogs": {
          "708120701": {
            "id": "708120701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This looks like a poster for the Adventurers' Guild. Let's take it with us."
          }
        }
      }
    },
    {
      "subId": "7081208",
      "subQuestName": "Talk to Aramis",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708120501"
        ],
        "dialogs": {
          "708120501": {
            "id": "708120501",
            "speakerId": 1445,
            "speakerName": "Aramis",
            "text": "Have you gotten them all?",
            "nextDialogs": [
              "708120502"
            ]
          },
          "708120502": {
            "id": "708120502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, sir!",
            "nextDialogs": [
              "708120503"
            ]
          },
          "708120503": {
            "id": "708120503",
            "speakerId": 1445,
            "speakerName": "Aramis",
            "text": "You have my utmost thanks. I'll take these posters and return them to the matching merchants in a moment.",
            "nextDialogs": [
              "708120504"
            ]
          },
          "708120504": {
            "id": "708120504",
            "speakerId": 1445,
            "speakerName": "Aramis",
            "text": "As for that signboard, it's from the Angel's Share. I've already notified Charles — he'll send someone over to take it back.",
            "nextDialogs": [
              "708120505"
            ]
          },
          "708120505": {
            "id": "708120505",
            "speakerId": 1445,
            "speakerName": "Aramis",
            "text": "Here's a little remuneration for your help. Please take it. As for me, I need to move on to other tasks.",
            "nextDialogs": [
              "708120506"
            ]
          },
          "708120506": {
            "id": "708120506",
            "speakerId": 1445,
            "speakerName": "Aramis",
            "text": "Though the storm has ceased, its effects will remain with us for a while..."
          }
        }
      }
    },
    {
      "subId": "7081204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708120401"
        ],
        "dialogs": {
          "708120401": {
            "id": "708120401",
            "speakerId": 1445,
            "speakerName": "Aramis",
            "text": "There should be three posters and one signboard now stuck on rooftops and on the city walls.",
            "nextDialogs": [
              "708120402"
            ]
          },
          "708120402": {
            "id": "708120402",
            "speakerId": 1445,
            "speakerName": "Aramis",
            "text": "Please bring those posters to me. As for the signboard, you can just leave it here on the ground. I'll have my colleagues pass it on to the appropriate merchant."
          }
        }
      }
    }
  ]

    {
      "subId": "2003910",
      "subQuestName": "Innovate - Black Copper Horn",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200391001"
        ],
        "dialogs": {
          "200391001": {
            "id": "200391001",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Yes, it's ready.",
            "nextDialogs": [
              "200391002"
            ]
          },
          "200391002": {
            "id": "200391002",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Nice work! This is some genuine bona fide Shocking Essential Oil alright. It helps people channel Electro energy more easily.",
            "nextDialogs": [
              "200391003"
            ]
          },
          "200391003": {
            "id": "200391003",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Now, let me tell you what happens if you swap the frog for butterfly wings!",
            "nextDialogs": [
              "200391004"
            ]
          },
          "200391004": {
            "id": "200391004",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "It produces a powerful Insulation Potion, which protects the taker against electroshocking.",
            "nextDialogs": [
              "200391005"
            ]
          },
          "200391005": {
            "id": "200391005",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Amazing, isn't it? The very same electro crystal can, depending on the specific alchemical process used, produce two completely opposite effects.",
            "nextDialogs": [
              "200391006"
            ]
          },
          "200391006": {
            "id": "200391006",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Go on, take this Insulation Potion and get a taste of what alchemy can really do!"
          }
        }
      }
    },
    {
      "subId": "2003911",
      "subQuestName": "Innovate - Dirty Mask",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200391101"
        ],
        "dialogs": {
          "200391101": {
            "id": "200391101",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Yes, it's ready.",
            "nextDialogs": [
              "200391102"
            ]
          },
          "200391102": {
            "id": "200391102",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Wow, that's a mighty fine batch of Frosting Essential Oil you've made! Rub some of this on you to get more in touch with your Cryo side...",
            "nextDialogs": [
              "200391103"
            ]
          },
          "200391103": {
            "id": "200391103",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "But guess what happens if you swap out the lizard tail and use crystal core instead?",
            "nextDialogs": [
              "200391104"
            ]
          },
          "200391104": {
            "id": "200391104",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Boom! You got yourself a Frostshield Potion, which protects you against the harmful effects of too much playing in the snow, amongst other things!",
            "nextDialogs": [
              "200391105"
            ]
          },
          "200391105": {
            "id": "200391105",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Amazing, isn't it? The very same mist flower corolla can, depending on the specific alchemical process used, produce two completely opposite effects.",
            "nextDialogs": [
              "200391106"
            ]
          },
          "200391106": {
            "id": "200391106",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Here's a Frostshield Potion for you. Now, go and get a taste of what alchemy can really do!"
          }
        }
      }
    },
    {
      "subId": "2003912",
      "subQuestName": "Innovate - Slime Secretions",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200391201"
        ],
        "dialogs": {
          "200391201": {
            "id": "200391201",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Yes, it's ready.",
            "nextDialogs": [
              "200391202"
            ]
          },
          "200391202": {
            "id": "200391202",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "That sure smells like Flaming Essential Oil alright! And you can really feel the heat too.",
            "nextDialogs": [
              "200391203"
            ]
          },
          "200391203": {
            "id": "200391203",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Did you know that there is a similar recipe using butterfly wings instead of a frog?",
            "nextDialogs": [
              "200391204"
            ]
          },
          "200391204": {
            "id": "200391204",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Voilà! You have yourself a Heatshield Potion. If you're ever rescuing a baby from a burning building, this little thing will make sure you don't even break a sweat.",
            "nextDialogs": [
              "200391205"
            ]
          },
          "200391205": {
            "id": "200391205",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Amazing, isn't it? The very same flaming flower stamen can, depending on the specific alchemical process used, produce two completely opposite effects.",
            "nextDialogs": [
              "200391206"
            ]
          },
          "200391206": {
            "id": "200391206",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "Take this Heatshield Potion and get a taste of what alchemy can really do!"
          }
        }
      }
    },
    {
      "subId": "2003913",
      "subQuestName": "Find a Black Bronze Horn",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200391301"
        ],
        "dialogs": {
          "200391301": {
            "id": "200391301",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "(Test) I've got all the ingredients.",
            "nextDialogs": [
              "200391302"
            ]
          },
          "200391302": {
            "id": "200391302",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "(Test) Excellent! Now, let's add a few of these, a touch of this, mix it all up... and I have no idea what will happen.",
            "nextDialogs": [
              "200391303"
            ]
          },
          "200391303": {
            "id": "200391303",
            "speakerId": 1587,
            "speakerName": "Timaeus",
            "text": "(Test) Aha, it's finished! Take it, see if you can find out what it does. I have no idea — but that's the exciting thing about alchemy!"
          }
        }
      }
    },

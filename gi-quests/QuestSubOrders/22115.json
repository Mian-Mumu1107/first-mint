  "subQuests": [
    {
      "subId": "2211501",
      "subQuestName": "Talk to Granny Ruoxin",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221150101"
        ],
        "dialogs": {
          "221150101": {
            "id": "221150101",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "*sigh* Come home, Little Chang... You're starting to worry me...",
            "nextDialogs": [
              "221150102"
            ]
          },
          "221150102": {
            "id": "221150102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Who is Little Chang...?",
            "nextDialogs": [
              "221150103"
            ]
          },
          "221150103": {
            "id": "221150103",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "Oh... It's just my pet name for Chang the Ninth.",
            "nextDialogs": [
              "221150104"
            ]
          },
          "221150104": {
            "id": "221150104",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "I'm so used to calling him Little Chang now, it feels strange saying \"Chang the Ninth.\"",
            "nextDialogs": [
              "221150105"
            ]
          },
          "221150105": {
            "id": "221150105",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "Last night, he said he was going out to do some research for his novel. I didn't think anything of it, just told him not to stay out too late. The usual.",
            "nextDialogs": [
              "221150106"
            ]
          },
          "221150106": {
            "id": "221150106",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "But he still hasn't come back. I'm so worried something's happened to him.",
            "nextDialogs": [
              "221150107"
            ]
          },
          "221150107": {
            "id": "221150107",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "And I'm too old and frail to go out looking for him. Could you two dears go and find him for me?",
            "nextDialogs": [
              "221150109",
              "221150111"
            ]
          },
          "221150109": {
            "id": "221150109",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "Wonderful. Thank you, dears."
          },
          "221150111": {
            "id": "221150111",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "*sigh* There's only one place he'll have gone. Wuwang Hill, north of here.",
            "nextDialogs": [
              "221150112"
            ]
          },
          "221150112": {
            "id": "221150112",
            "speakerId": 1000,
            "speakerName": "Granny Ruoxin",
            "text": "Please, go and find him — for my sake. He's been out there so long... I do hope nothing's happened to him."
          }
        }
      }
    },
    {
      "subId": "2211502",
      "subQuestName": "Find Chang the Ninth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221150201"
        ],
        "dialogs": {
          "221150201": {
            "id": "221150201",
            "speakerId": 1001,
            "speakerName": "Chang the Ninth",
            "text": "Hmph! These wretched monsters... Ghastly things...",
            "nextDialogs": [
              "221150202"
            ]
          },
          "221150202": {
            "id": "221150202",
            "speakerId": 1001,
            "speakerName": "Chang the Ninth",
            "text": "All I wanted was one measly morsel of inspiration for my novel... But nope, I got stuck with this rabble instead!",
            "nextDialogs": [
              "221150203"
            ]
          },
          "221150203": {
            "id": "221150203",
            "speakerId": 1001,
            "speakerName": "Chang the Ninth",
            "text": "Thanks for your help. I'm not sure what I would have done without it.",
            "nextDialogs": [
              "221150204"
            ]
          },
          "221150204": {
            "id": "221150204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Granny Ruoxin is worried sick about you.",
            "nextDialogs": [
              "221150205"
            ]
          },
          "221150205": {
            "id": "221150205",
            "speakerId": 1001,
            "speakerName": "Chang the Ninth",
            "text": "Is she? She's wasting her energy... I'm quite capable of looking after myself. I could have easily dealt with them if it came to it... It just would have been a bit of a bother, that's all...",
            "nextDialogs": [
              "221150206"
            ]
          },
          "221150206": {
            "id": "221150206",
            "speakerId": 1001,
            "speakerName": "Chang the Ninth",
            "text": "...Still, I'm glad you showed up. Otherwise, I could have been here a while longer... This way, at least I won't have to put up with her constant nagging when I get back."
          }
        }
      }
    },
    {
      "subId": "2211503",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221150301"
        ],
        "dialogs": {
          "221150301": {
            "id": "221150301",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "...And just like that, he's gone. We should get going, too.",
            "nextDialogs": [
              "221150302"
            ]
          },
          "221150302": {
            "id": "221150302",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wait — what's that on the ground? Did Chang the Ninth drop something?",
            "nextDialogs": [
              "221150303"
            ]
          },
          "221150303": {
            "id": "221150303",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "We should take a look, just in case."
          }
        }
      }
    },
    {
      "subId": "2211504",

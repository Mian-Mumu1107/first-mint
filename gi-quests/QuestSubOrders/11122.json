        "dialogs": {
          "111221001": {
            "id": "111221001",
            "speakerId": 1006,
            "speakerName": "Observe Stone",
            "text": "(This rock is no different from ordinary Cor Lapis... and yet, Kun Jun was able to see a memory through it.)",
            "nextDialogs": [
              "111221002"
            ]
          },
          "111221002": {
            "id": "111221002",
            "speakerId": 1006,
            "speakerName": "Observe Stone",
            "text": "(It was thanks to this sort of rock that we were able to find some clues.)"
          }
        }

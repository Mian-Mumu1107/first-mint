  "subQuests": [
    {
      "subId": "1112201",
      "subQuestName": "Head to Lingju Pass to investigate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111229901"
        ],
        "dialogs": {
          "111229901": {
            "id": "111229901",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, there are tracks here!",
            "nextDialogs": [
              "111229902"
            ]
          },
          "111229902": {
            "id": "111229902",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "These must have been left by the miners!",
            "nextDialogs": [
              "111229903"
            ]
          },
          "111229903": {
            "id": "111229903",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "Let us make our way to the end of Lingju Pass. If there are no footprints there, it would suggest that the miners are still within the pass itself. However, if we find new tracks, we can follow them wherever they may lead."
          }
        }
      }
    },
    {
      "subId": "1112202",
      "subQuestName": "Look for more clues in the area",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111220201"
        ],
        "dialogs": {
          "111220201": {
            "id": "111220201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey! Footprints!",
            "nextDialogs": [
              "111220202"
            ]
          },
          "111220202": {
            "id": "111220202",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "It would appear that they made their way through Lingju Pass and kept moving.",
            "nextDialogs": [
              "111220203"
            ]
          },
          "111220203": {
            "id": "111220203",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "If we follow their footprints, we should be able to find where they went!"
          }
        }
      }
    },
    {
      "subId": "1112203",
      "subQuestName": "Follow the footprints",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1112210",
      "subQuestName": "Ask people nearby for information",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111220401"
        ],
        "dialogs": {
          "111220401": {
            "id": "111220401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey there, seen any miners?",
            "nextDialogs": [
              "111220402"
            ]
          },
          "111220402": {
            "id": "111220402",
            "speakerId": 1002,
            "speakerName": "Ling",
            "text": "...It must have been about four or five days ago. There were a few men who came through here carrying baskets and picks... I guess that could have been them?",
            "nextDialogs": [
              "111220403"
            ]
          },
          "111220403": {
            "id": "111220403",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yeah! That's them!",
            "nextDialogs": [
              "111220404"
            ]
          },
          "111220404": {
            "id": "111220404",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "Four or five days ago? It appears that they were moving slower than we'd anticipated. Traversing the geography of Lingju Pass must have held them up.",
            "nextDialogs": [
              "111220405"
            ]
          },
          "111220405": {
            "id": "111220405",
            "speakerId": 1002,
            "speakerName": "Ling",
            "text": "It was so strange! Four big guys with lifeless expressions... It was like they were in some sort of trance! And there was a child staggering in front of them...",
            "nextDialogs": [
              "111220406"
            ]
          },
          "111220406": {
            "id": "111220406",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "Huh, this child... Did you see what they look like?",
            "nextDialogs": [
              "111220407"
            ]
          },
          "111220407": {
            "id": "111220407",
            "speakerId": 1002,
            "speakerName": "Ling",
            "text": "I caught a glimpse... blue hair, short. I think... I think it was a girl! She wasn't smiling, in fact she looked very serious.",
            "nextDialogs": [
              "111220408"
            ]
          },
          "111220408": {
            "id": "111220408",
            "speakerId": 1001,
            "speakerName": "Zhongli",
            "text": "And they took this road?",
            "nextDialogs": [
              "111220409"
            ]
          },
          "111220409": {
            "id": "111220409",
            "speakerId": 1002,
            "speakerName": "Ling",
            "text": "Yes, they followed it straight from here.",
            "nextDialogs": [
              "111220410"
            ]
          },
          "111220410": {
            "id": "111220410",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Let's go after them!"
          }
        }
      }
    },

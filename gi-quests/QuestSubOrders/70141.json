            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "S—S—So cold... P—Paimon's turning into a Paimon popsicle!",
            "nextDialogs": [
              "701419902"
            ]
          },
          "701419902": {
            "id": "701419902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wh—What's... going on here...",
            "nextDialogs": [
              "701419903"
            ]
          },
          "701419903": {
            "id": "701419903",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "W—We should go back and ask around at the camp in the foothills..."
          }
        }
      }
    },
    {
      "subId": "7014107",
      "subQuestName": "Go to the camp and ask for clues regarding the strange air current",
      "sceneId": null,

    {
      "subId": "7014114",
      "subQuestName": "Thaw all the shards out",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701411401"
        ],
        "dialogs": {
          "701411401": {
            "id": "701411401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, tell me about the ice.",
            "nextDialogs": [
              "701411402"
            ]
          },
          "701411402": {
            "id": "701411402",
            "speakerId": 1000,
            "speakerName": "Iris",
            "text": "Perhaps you've already noticed, but that slab of ice is surrounded by a great many blue plants.",
            "nextDialogs": [
              "701411403"
            ]
          },
          "701411403": {
            "id": "701411403",
            "speakerId": 1000,
            "speakerName": "Iris",
            "text": "I believe that those plants may be related in some way to the shard frozen in the ice.",
            "nextDialogs": [
              "701411404"
            ]
          },
          "701411404": {
            "id": "701411404",
            "speakerId": 1000,
            "speakerName": "Iris",
            "text": "If you wish to continue looking for those shards on Dragonspine, I'd say that you might have some luck following the trail of those blue plants.",
            "nextDialogs": [
              "701411405"
            ]
          },
          "701411405": {
            "id": "701411405",
            "speakerId": 1000,
            "speakerName": "Iris",
            "text": "I believe that the <color=#00E1FFFF>Snow-Covered Path</color>, the <color=#00E1FFFF>Entombed City Outskirts</color> and <color=#00E1FFFF>Starglow Cavern</color> are home to many of those blue plants. You can go and check them out. Perhaps you might discover something."
          }
        }
      }
    },

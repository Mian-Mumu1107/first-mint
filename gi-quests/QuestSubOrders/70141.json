    {
      "subId": "7014131",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701419401"
        ],
        "dialogs": {
          "701419401": {
            "id": "701419401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "S—S—So cold... P—Paimon's turning into a Paimon popsicle!",
            "nextDialogs": [
              "701419402"
            ]
          },
          "701419402": {
            "id": "701419402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wh—What's... going on here...",
            "nextDialogs": [
              "701419403"
            ]
          },
          "701419403": {
            "id": "701419403",

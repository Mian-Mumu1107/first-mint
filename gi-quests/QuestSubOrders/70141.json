    {
      "subId": "7014103",
      "subQuestName": "Head for Dragonspine's summit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701410301"
        ],
        "dialogs": {
          "701410301": {
            "id": "701410301",
            "speakerId": 1000,
            "speakerName": "Iris",
            "text": "Since we've got a way to melt that ice now, that means I can continue organizing expedition parties to explore the mountain..."
          }
        }
      }
    },
    {
      "subId": "7014105",
      "subQuestName": "Thaw all the shards out again",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701410501"
        ],
        "dialogs": {
          "701410501": {
            "id": "701410501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the summit...",
            "nextDialogs": [
              "701410502"
            ]
          },
          "701410502": {
            "id": "701410502",
            "speakerId": 1000,
            "speakerName": "Iris",
            "text": "There's a strange, huge pillar floating in mid-air at the summit? To think that there would be such a thing atop Dragonspine...",
            "nextDialogs": [
              "701410503"
            ]
          },
          "701410503": {
            "id": "701410503",
            "speakerId": 1000,
            "speakerName": "Iris",
            "text": "And there's a huge space below the ice under the pillar? That's... even weirder.",
            "nextDialogs": [
              "701410504"
            ]
          },
          "701410504": {
            "id": "701410504",
            "speakerId": 1000,
            "speakerName": "Iris",
            "text": "This is... inconceivable. Thank you. I will send explorers up there as quickly as we can to see what's happening there.",
            "nextDialogs": [
              "701410505"
            ]
          },
          "701410505": {
            "id": "701410505",
            "speakerId": 1000,
            "speakerName": "Iris",
            "text": "Ah, yes, I should thank you for helping us open the way to the summit. Please take these as thanks.",
            "nextDialogs": [
              "701410506"
            ]
          },
          "701410506": {
            "id": "701410506",
            "speakerId": 1000,
            "speakerName": "Iris",
            "text": "It seems Dragonspine really does have its secrets after all.",
            "nextDialogs": [
              "701410507"
            ]
          },
          "701410507": {
            "id": "701410507",
            "speakerId": 1000,
            "speakerName": "Iris",
            "text": "I do hope our next expedition will yield some new discoveries."
          }
        }
      }
    },
    {
      "subId": "7014123",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701419601"
        ],
        "dialogs": {
          "701419601": {
            "id": "701419601",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? The icy surface under the pillar has completely shattered. Looks like there's a huge space underneath it, too. Let's go check it out."
          }
        }
      }

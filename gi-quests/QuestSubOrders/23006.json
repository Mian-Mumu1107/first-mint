  "subQuests": [
    {
      "subId": "2300601",
      "subQuestName": "Talk to Golshan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230060101"
        ],
        "dialogs": {
          "230060101": {
            "id": "230060101",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "*sigh* How will we find anyone who will help at this hour...",
            "nextDialogs": [
              "230060102"
            ]
          },
          "230060102": {
            "id": "230060102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "230060103"
            ]
          },
          "230060103": {
            "id": "230060103",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "Oh! H—Hello there, Traveler. Are you here for treatment?",
            "nextDialogs": [
              "230060106"
            ]
          },
          "230060106": {
            "id": "230060106",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "Hehe... Was it that obvious? Well, you are right. I am worried about something.",
            "nextDialogs": [
              "230060107"
            ]
          },
          "230060107": {
            "id": "230060107",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "I don't know why, but there's been an increasing number of people seeking treatment here at Bimarstan lately. Our staff have their hands full taking care of the patients.",
            "nextDialogs": [
              "230060108"
            ]
          },
          "230060108": {
            "id": "230060108",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "Still, Dr. Zakariya insisted that I find ways to keep the surrounding area clean...",
            "nextDialogs": [
              "230060109"
            ]
          },
          "230060109": {
            "id": "230060109",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "He said that only if the hospital and patients were kept clean, then they could more easily receive the blessing of the Dendro Archon.",
            "nextDialogs": [
              "230060110"
            ]
          },
          "230060110": {
            "id": "230060110",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "*sigh* But we can't spare any hands at the moment, and it's not like I can ask the patients with mild symptoms to help out..."
          }
        }
      }
    },
    {
      "subId": "2300602",

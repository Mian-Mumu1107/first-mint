    {
      "subId": "2300603",
      "subQuestName": "Talk to Golshan",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230060401"
        ],
        "dialogs": {
          "230060401": {
            "id": "230060401",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "Have you cleaned up the surrounding area?",
            "nextDialogs": [
              "230060402"
            ]
          },
          "230060402": {
            "id": "230060402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yep.",
            "nextDialogs": [
              "230060403"
            ]
          },
          "230060403": {
            "id": "230060403",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "I can't thank you enough, Traveler. Please take this as your payment.",
            "nextDialogs": [
              "230060404"
            ]
          },
          "230060404": {
            "id": "230060404",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "By the way, Mr. Gurgen has been forcing himself to work again lately. I should take some more time to get him to change his mind...",
            "nextDialogs": [
              "230060405"
            ]
          },
          "230060405": {
            "id": "230060405",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "There have been so many things that need taking care of lately, so I might have to bother you with cleanup duties next time as well."
          }
        }
      }
    },
    {
      "subId": "2300603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230060301"
        ],
        "dialogs": {
          "230060301": {
            "id": "230060301",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "Traveler, is there anything you'd like to ask?",
            "nextDialogs": [
              "230060303",
              "230060307"
            ]
          },
          "230060303": {
            "id": "230060303",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "Dr. Zakariya is a great doctor and a devout believer of the Dendro Archon.",
            "nextDialogs": [
              "230060304"
            ]
          },
          "230060304": {
            "id": "230060304",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "He treats patients around the clock and hardly ever has time to eat.",
            "nextDialogs": [
              "230060305"
            ]
          },
          "230060305": {
            "id": "230060305",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "Dr. Zakariya even said that it's his duty to extend the blessings of the Dendro Archon to more people."
          },
          "230060307": {
            "id": "230060307",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "To be precise, the act of \"treatment\" itself is the blessing of the Dendro Archon.",
            "nextDialogs": [
              "230060308"
            ]
          },
          "230060308": {
            "id": "230060308",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "It was by the grace of the Dendro Archon that we could find cures for patients and grow herbs to treat illnesses...",
            "nextDialogs": [
              "230060309"
            ]
          },
          "230060309": {
            "id": "230060309",
            "speakerId": 4072,
            "speakerName": "Golshan",
            "text": "Thank you, O Dendro Archon, for your blessing. May everyone be kept from maladies..."
          }
        }
      }
    },

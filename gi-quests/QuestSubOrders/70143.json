  "subQuests": [
    {
      "subId": "7014302",
      "subQuestName": "Talk to Katheryne",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701430201"
        ],
        "dialogs": {
          "701430201": {
            "id": "701430201",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "Hello, Traveler. I trust your adventures are going quite smoothly?",
            "nextDialogs": [
              "701430202"
            ]
          },
          "701430202": {
            "id": "701430202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pretty smoothly.",
            "nextDialogs": [
              "701430203"
            ]
          },
          "701430203": {
            "id": "701430203",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "Good. In fact, I have been keeping up with your recent endeavors. I have no doubt that if you continue in this vein, you will become an outstanding adventurer one day.",
            "nextDialogs": [
              "701430204"
            ]
          },
          "701430204": {
            "id": "701430204",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "As for other Guild activities, I have some adventure intel I would like to share with you, if you are interested.",
            "nextDialogs": [
              "701430205"
            ]
          },
          "701430205": {
            "id": "701430205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Another commission for me? Let's hear it.",
            "nextDialogs": [
              "701430206"
            ]
          },
          "701430206": {
            "id": "701430206",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "Haha, your tone suggests you are now exceptionally familiar with the way the Guild handles its affairs.",
            "nextDialogs": [
              "701430207"
            ]
          },
          "701430207": {
            "id": "701430207",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "However, this time I do not have a commission for you. Rather, I simply have some adventure intel to share.",
            "nextDialogs": [
              "701430208"
            ]
          },
          "701430208": {
            "id": "701430208",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "It's about Dragonspine, that snowy mountain near Mondstadt.",
            "nextDialogs": [
              "701430209"
            ]
          },
          "701430209": {
            "id": "701430209",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "The Guild has set up a camp and stationed a number of adventurers there.",
            "nextDialogs": [
              "701430210"
            ]
          },
          "701430210": {
            "id": "701430210",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "I have marked the location on your Map. Once you arrive, please look for an adventurer by the name of Iris. She will brief you on the situation in that area.",
            "nextDialogs": [
              "701430211"
            ]
          },
          "701430211": {
            "id": "701430211",
            "speakerId": 1512,
            "speakerName": "Katheryne",
            "text": "That's all from me. Happy adventuring, and ad astra abyssosque!"
          }
        }
      }
    },
    {
      "subId": "7014301",
      "subQuestName": "Talk to Iris",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701430101"
        ],
        "dialogs": {
          "701430101": {
            "id": "701430101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About adventuring in Dragonspine...",
            "nextDialogs": [
              "701430102"
            ]
          },
          "701430102": {
            "id": "701430102",
            "speakerId": 1665,
            "speakerName": "Iris",
            "text": "If you really want to go into Dragonspine, you must make sure you are fully prepared — do not underestimate the dangers of the mountain.",
            "nextDialogs": [
              "701430103"
            ]
          },
          "701430103": {
            "id": "701430103",
            "speakerId": 1665,
            "speakerName": "Iris",
            "text": "Dragonspine is not forgiving towards careless adventures."
          }
        }
      }
    }
  ]
}
    {
      "subId": "4141304",
      "subQuestName": "Talk to Venti",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414130401"
        ],
        "dialogs": {
          "414130401": {
            "id": "414130401",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "Thank you, Windblume Star, for your sincere Windblume offering to the Anemo Archon, Barbatos. May the wind protect Mondstadt.",
            "nextDialogs": [
              "414130402"
            ]
          },
          "414130402": {
            "id": "414130402",
            "speakerId": 1002,
            "speakerName": "Venti",
            "text": "Huh, interesting choice.",
            "nextDialogs": [
              "414130403"
            ]
          },
          "414130403": {
            "id": "414130403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You like it?",
            "nextDialogs": [
              "414130404"
            ]
          },
          "414130404": {
            "id": "414130404",
            "speakerId": 1002,
            "speakerName": "Venti",
            "text": "Hehe, take a guess...",
            "nextDialogs": [
              "414130405"
            ]
          },
          "414130405": {
            "id": "414130405",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Typical Tone-Deaf Bard, stop making people guess all the time!",
            "nextDialogs": [
              "414130406"
            ]
          },
          "414130406": {
            "id": "414130406",
            "speakerId": 1002,
            "speakerName": "Venti",
            "text": "Ahahahaha! Okay, okay, I'll tell you. But not here though.",
            "nextDialogs": [
              "414130407"
            ]
          },
          "414130407": {
            "id": "414130407",
            "speakerId": 1002,
            "speakerName": "Venti",
            "text": "Not a good idea with so many people in the plaza... Change of surroundings needed.",
            "nextDialogs": [
              "414130408"
            ]
          },
          "414130408": {
            "id": "414130408",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Where should we go?",
            "nextDialogs": [
              "414130409"
            ]
          },
          "414130409": {
            "id": "414130409",
            "speakerId": 1002,
            "speakerName": "Venti",
            "text": "I want you to come with me to Stormterror's Lair."
          }
        }
      }
    },

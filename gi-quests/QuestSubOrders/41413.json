    {
      "subId": "4141307",
      "subQuestName": "Talk to Venti",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414130701"
        ],
        "dialogs": {
          "414130701": {
            "id": "414130701",
            "speakerId": 1002,
            "speakerName": "Venti",
            "text": "Ah... now this is a view.",
            "nextDialogs": [
              "414130704"
            ]
          },
          "414130704": {
            "id": "414130704",
            "speakerId": 1002,
            "speakerName": "Venti",
            "text": "Isn't it? I am fond of this place. Sometimes, when I've got nothing else to do, I come here just to sit and gaze awhile.",
            "nextDialogs": [
              "414130705"
            ]
          },
          "414130705": {
            "id": "414130705",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You mean sit and laze around?",
            "nextDialogs": [
              "414130706"
            ]
          },
          "414130706": {
            "id": "414130706",
            "speakerId": 1002,
            "speakerName": "Venti",
            "text": "Hahaha, guilty as charged!",
            "nextDialogs": [
              "414130707"
            ]
          },
          "414130707": {
            "id": "414130707",
            "speakerId": 1002,
            "speakerName": "Venti",
            "text": "...It's so beautiful... if only we had some cider in hand.",
            "nextDialogs": [
              "414130708"
            ]
          },
          "414130708": {
            "id": "414130708",
            "speakerId": 1002,
            "speakerName": "Venti",
            "text": "So, Traveler. The Mondstadt Windblume Festival. Do you like it?"
          }
        }
      }
    },
    {
      "subId": "4141397",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414139701"
        ],
        "dialogs": {
          "414139701": {
            "id": "414139701",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "May the wind carry our blessings and praise."
          }
        }
      }
    },
    {
      "subId": "4141398",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414139801"
        ],
        "dialogs": {
          "414139801": {
            "id": "414139801",
            "speakerId": 1002,
            "speakerName": "Venti",
            "text": "What will the Windblume be this year? I can't wait to find out!"
          }
        }
      }
    },
    {
      "subId": "4141399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414139901"
        ],
        "dialogs": {
          "414139901": {
            "id": "414139901",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "Follow your instinct. Choose whichever Windblume you see fit."
          }
        }
      }
    }

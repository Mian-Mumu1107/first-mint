    {
      "subId": "4141302",
      "subQuestName": "Talk to Jean",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414130201"
        ],
        "dialogs": {
          "414130201": {
            "id": "414130201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey, Jean!",
            "nextDialogs": [
              "414130202"
            ]
          },
          "414130202": {
            "id": "414130202",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "Traveler! Ah — excuse me. I should address you as Honorary Knight under the circumstances.",
            "nextDialogs": [
              "414130203"
            ]
          },
          "414130203": {
            "id": "414130203",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "I suppose you heard? You're this year's Windblume Star. You will be making an offering of Windblumes to the Anemo Archon, Barbatos, on behalf of the whole of Mondstadt.",
            "nextDialogs": [
              "414130204"
            ]
          },
          "414130204": {
            "id": "414130204",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "...Although... things will be a little different this time.",
            "nextDialogs": [
              "414130205"
            ]
          },
          "414130205": {
            "id": "414130205",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "*sigh* ...Yeah... But with us and the Tone-Deaf Bard here, this year's Windblume Festival is sure to be bigger than ever!",
            "nextDialogs": [
              "414130206"
            ]
          },
          "414130206": {
            "id": "414130206",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "That is true... Thank you for taking up residence in Mondstadt, and I hope you continue to enjoy Mondstadt life.",
            "nextDialogs": [
              "414130207"
            ]
          },
          "414130207": {
            "id": "414130207",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "Oh! The Windblume Ceremony is about to begin. Windblume Star, have you chosen your Windblume?",
            "nextDialogs": [
              "414130208"
            ]
          },
          "414130208": {
            "id": "414130208",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So we choose one type of flower, then offer it to the Anemo Archon, right?",
            "nextDialogs": [
              "414130209"
            ]
          },
          "414130209": {
            "id": "414130209",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "Exactly right. Please consider your choice carefully. Remember, you are representing the whole of Mondstadt.",
            "nextDialogs": [
              "414130210"
            ]
          },
          "414130210": {
            "id": "414130210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Venti, what kind of flower do you like?",
            "nextDialogs": [
              "414130211"
            ]
          },
          "414130211": {
            "id": "414130211",
            "speakerId": 1002,
            "speakerName": "Venti",
            "text": "Eh? ...Very cunning, trying to cheat, are we?",
            "nextDialogs": [
              "414130212"
            ]
          },
          "414130212": {
            "id": "414130212",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "Ahem...",
            "nextDialogs": [
              "414130213"
            ]
          },
          "414130213": {
            "id": "414130213",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hey! Don't you two go spilling secrets during an occasion like this!",
            "nextDialogs": [
              "414130214"
            ]
          },
          "414130214": {
            "id": "414130214",
            "speakerId": 1002,
            "speakerName": "Venti",
            "text": "Haha, they told us!",
            "nextDialogs": [
              "414130215"
            ]
          },
          "414130215": {
            "id": "414130215",
            "speakerId": 1002,
            "speakerName": "Venti",
            "text": "Don't worry about me, choose something you like! I trust your tastes.",
            "nextDialogs": [
              "414130216"
            ]
          },
          "414130216": {
            "id": "414130216",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "So, Honorary Knight, what is your choice?",
            "nextDialogs": [
              "414130218",
              "414130220",
              "414130222",
              "414130224",
              "414130226",
              "414130228"
            ]
          },
          "414130218": {
            "id": "414130218",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ahhhh... throwing your weight behind one of the people's favorites! Windblumes must be dandelions after all!",
            "nextDialogs": [
              "414130229"
            ]
          },
          "414130229": {
            "id": "414130229",
            "speakerId": 1001,
            "speakerName": "Jean",
            "text": "On behalf of the people of Mondstadt, please offer your Windblume to the statue."
          },
          "414130220": {
            "id": "414130220",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ahhhh... Throwing your weight behind one of the people's favorites! Windblumes must be Windwheel Asters after all!"
          },
          "414130222": {
            "id": "414130222",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh! Same idea as Beatrice, Cecilias for Windblumes. Pretty niche, but not without advocates!"
          },
          "414130224": {
            "id": "414130224",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh! Same idea as Nimrod, Small Lamp Grass for Windblumes... A flower to light up the dark!"
          },
          "414130226": {
            "id": "414130226",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh! Same idea as Sucrose, Sweet Flowers for Windblumes. A flower that has lasted through the ages!"
          },
          "414130228": {
            "id": "414130228",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh! Same idea as Razor, Wolfhooks for Windblumes. Spiky and tingly!"
          }
        }
      }
    },
    {
      "subId": "4141303",
      "subQuestName": "Make a Windblume offering to the Anemo Archon",

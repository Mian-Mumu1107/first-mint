    {
      "subId": "800310",
      "subQuestName": "Talk to Dainsleif",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80030501"
        ],
        "dialogs": {
          "80030501": {
            "id": "80030501",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "Looks like we're here.",
            "nextDialogs": [
              "80030502"
            ]
          },
          "80030502": {
            "id": "80030502",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "An eerie, lifeless, dark chamber... I understand the evil aura you were describing earlier.",
            "nextDialogs": [
              "80030503"
            ]
          },
          "80030503": {
            "id": "80030503",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ohhhh... Such a scary place...",
            "nextDialogs": [
              "80030504"
            ]
          },
          "80030504": {
            "id": "80030504",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "Be careful to not be overwhelmed by the power of the Defiled Statue— the Abyss Herald, it's here.",
            "nextDialogs": [
              "80030505"
            ]
          },
          "80030505": {
            "id": "80030505",
            "speakerId": 10916,
            "speakerName": "Abyss Herald",
            "text": "Mwahaha... You sense correctly.",
            "nextDialogs": [
              "80030506"
            ]
          },
          "80030506": {
            "id": "80030506",
            "speakerId": 10916,
            "speakerName": "Abyss Herald",
            "text": "You are just as vexatious as ever, Dainsleif, enemy of the Abyss!",
            "nextDialogs": [
              "80030507"
            ]
          },
          "80030507": {
            "id": "80030507",
            "speakerId": 10916,
            "speakerName": "Abyss Herald",
            "text": "I sense your soul is stained by terrible bloodshed, perhaps from your darkest nightmares. Unless... Huh?",
            "nextDialogs": [
              "80030508"
            ]
          },
          "80030508": {
            "id": "80030508",
            "speakerId": 10916,
            "speakerName": "Abyss Herald",
            "text": "Oh, and something far more dangerous! You reek of a corruption familiar to me...",
            "nextDialogs": [
              "80030509"
            ]
          },
          "80030509": {
            "id": "80030509",
            "speakerId": 10916,
            "speakerName": "Abyss Herald",
            "text": "Then we are the same. We're both dangerous. But dangers from outside of the Abyss Order must be caught and caged...",
            "nextDialogs": [
              "80030510"
            ]
          },
          "80030510": {
            "id": "80030510",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "Tsk.",
            "nextDialogs": [
              "80030511"
            ]
          },
          "80030511": {
            "id": "80030511",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "It is your words that forever reek of corruption...",
            "nextDialogs": [
              "80030512"
            ]
          },
          "80030512": {
            "id": "80030512",
            "speakerId": 1022,
            "speakerName": "Dainsleif",
            "text": "Time to silence you!"
          }
        }
      }
    },

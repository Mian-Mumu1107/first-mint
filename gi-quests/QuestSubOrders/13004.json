              "130040102"
            ]
          },
          "130040102": {
            "id": "130040102",
            "speakerId": 1000,
            "speakerName": "Tighnari",
            "text": "I have zero interest in group photos, but I also wouldn't just throw them away. I stored them all in a box.",
            "nextDialogs": [
              "130040103"
            ]
          },
          "130040103": {
            "id": "130040103",
            "speakerId": 1000,
            "speakerName": "Tighnari",
            "text": "After coming back yesterday, I looked through them and found one with Abattouy. I gave it to Karkata, and it seemed happy... That's good enough."
          }
        }
      }
    },

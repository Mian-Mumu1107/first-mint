        "dialogs": {
          "761500101": {
            "id": "761500101",
            "speakerId": 22272,
            "speakerName": "Zeitlind",
            "text": "*coughing*",
            "nextDialogs": [
              "761500102"
            ]
          },
          "761500102": {
            "id": "761500102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you alright?",
            "nextDialogs": [
              "761500103"
            ]
          },
          "761500103": {
            "id": "761500103",
            "speakerId": 22272,
            "speakerName": "Zeitlind",
            "text": "...I'm fine. I just had a very, very long nightmare.",
            "nextDialogs": [
              "761500104"
            ]
          },
          "761500104": {
            "id": "761500104",
            "speakerId": 22272,
            "speakerName": "Zeitlind",
            "text": "...Forget it. Pretend I didn't say that.",
            "nextDialogs": [
              "761500105"
            ]
          },
          "761500105": {
            "id": "761500105",
            "speakerId": 22272,
            "speakerName": "Zeitlind",
            "text": "I can't take it anymore. Why does this keep happening to me?",
            "nextDialogs": [
              "761500106"
            ]
          },
          "761500106": {
            "id": "761500106",
            "speakerId": 22272,
            "speakerName": "Zeitlind",
            "text": "Why is it always me... First Mom and Dad... and now my sister...",
            "nextDialogs": [
              "761500107"
            ]
          },
          "761500107": {
            "id": "761500107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's okay. I'm here with you.",
            "nextDialogs": [
              "761500108"
            ]
          },
          "761500108": {
            "id": "761500108",
            "speakerId": 22272,
            "speakerName": "Zeitlind",
            "text": "...I know. I'm not angry at you.",
            "nextDialogs": [
              "761500109"
            ]
          },
          "761500109": {
            "id": "761500109",
            "speakerId": 22438,
            "speakerName": "Dex",
            "text": "♪~",
            "nextDialogs": [
              "761500110"
            ]
          },
          "761500110": {
            "id": "761500110",
            "speakerId": 22272,
            "speakerName": "Zeitlind",
            "text": "What has Dex picked up?",
            "nextDialogs": [
              "761500111"
            ]
          },
          "761500111": {
            "id": "761500111",
            "speakerId": 1844,
            "speakerName": "Istoria",
            "text": "I call it a Deathmuse Shard. It may be a way to move from death unto life.",
            "nextDialogs": [
              "761500112"
            ]
          },
          "761500112": {
            "id": "761500112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let's go.",
            "nextDialogs": [
              "761500113"
            ]
          },
          "761500113": {
            "id": "761500113",
            "speakerId": 22272,
            "speakerName": "Zeitlind",
            "text": "Yes, let's.",
            "nextDialogs": [
              "761500114"
            ]
          },
          "761500114": {
            "id": "761500114",
            "speakerId": 1844,
            "speakerName": "Istoria",
            "text": "Now that Zeitlind's been found, let's try to find a way out.",
            "nextDialogs": [
              "761500115"
            ]
          },
          "761500115": {
            "id": "761500115",
            "speakerId": 22311,
            "speakerName": "Alara",
            "text": "Are you sure we can get out of here by ourselves?",
            "nextDialogs": [
              "761500116"
            ]
          },
          "761500116": {
            "id": "761500116",
            "speakerId": 1844,
            "speakerName": "Istoria",
            "text": "Melanta and Nihilita can move within this place freely, and they usually bring people with them. In which case, Dex should be able to do the same.",
            "nextDialogs": [
              "761500117"
            ]
          },
          "761500117": {
            "id": "761500117",
            "speakerId": 22438,
            "speakerName": "Dex",
            "text": "♪~",
            "nextDialogs": [
              "761500118"
            ]
          },
          "761500118": {
            "id": "761500118",
            "speakerId": 1844,
            "speakerName": "Istoria",
            "text": "That's three Deathmuse Shards collected.",
            "nextDialogs": [
              "761500119"
            ]
          },
          "761500119": {
            "id": "761500119",
            "speakerId": 1844,
            "speakerName": "Istoria",
            "text": "Though I should say this is a temporary name, since I have no clue what Dex will be using them for either.",
            "nextDialogs": [
              "761500120"
            ]
          },
          "761500120": {
            "id": "761500120",
            "speakerId": 1844,
            "speakerName": "Istoria",
            "text": "What next, Dex?",
            "nextDialogs": [
              "761500121"
            ]
          },
          "761500121": {
            "id": "761500121",
            "speakerId": 22438,
            "speakerName": "Dex",
            "text": "!",
            "nextDialogs": [
              "761500122"
            ]
          },
          "761500122": {
            "id": "761500122",
            "speakerId": 1844,
            "speakerName": "Istoria",
            "text": "Let's follow its directions."
          }
        }
      }
    },

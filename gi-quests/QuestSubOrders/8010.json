    {
      "subId": "801001",
      "subQuestName": "Talk to Eide",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80101404"
        ],
        "dialogs": {
          "80101404": {
            "id": "80101404",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Eide carefully waters his field...",
            "nextDialogs": [
              "80101405"
            ]
          },
          "80101405": {
            "id": "80101405",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I need you to stand guard here for a while. Whatever you do, don't let any Forest Rangers approach the house. Understand?",
            "nextDialogs": [
              "80101408"
            ]
          },
          "80101408": {
            "id": "80101408",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Good. I'll be back soon, the fertilizer won't take but a moment to make.",
            "nextDialogs": [
              "80101409"
            ]
          },
          "80101409": {
            "id": "80101409",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "You wait in the field for Eide to return. After a while...",
            "nextDialogs": [
              "80101410"
            ]
          },
          "80101410": {
            "id": "80101410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Monsters! And so many of them... It looks like they're coming for this field...)",
            "nextDialogs": [
              "80101411"
            ]
          },
          "80101411": {
            "id": "80101411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Does watering the field somehow attract monsters? Hmm, better fend them off.)"
          }
        }
      }

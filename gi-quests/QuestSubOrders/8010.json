            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "What happened? Was it monsters?",
            "nextDialogs": [
              "80101502"
            ]
          },
          "80101502": {
            "id": "80101502",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Thank goodness you were here. I couldn't have taken them on all by myself... I'd have to hide and wait until they were gone.",
            "nextDialogs": [
              "80101503"
            ]
          },
          "80101503": {
            "id": "80101503",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Oh yes — I've got the fertilizer. The effects can take some time to kick in, so let's get on with it.",
            "nextDialogs": [
              "80101504"
            ]
          },
          "80101504": {
            "id": "80101504",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Eide spreads the fertilizer evenly. Before long, the elemental energy within starts to take effect...",
            "nextDialogs": [
              "80101505"
            ]
          },
          "80101505": {
            "id": "80101505",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Next, we pick the mushrooms and repeat the same steps as before to make another dose. I trust you still remember the method?"
          }
        }
      }

  "subQuests": [
    {
      "subId": "801002",
      "subQuestName": "Look for Paimon inside the house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80100201"
        ],
        "dialogs": {
          "80100201": {
            "id": "80100201",
            "speakerId": 1000,
            "speakerName": "Intimidating Man",
            "text": "Halt! What do you think you're doing!?",
            "nextDialogs": [
              "80100204"
            ]
          },
          "80100204": {
            "id": "80100204",
            "speakerId": 1000,
            "speakerName": "Intimidating Man",
            "text": "This place is not whatever you think it is... Nor should you be poking your nose into my business! Begone!"
          }
        }
      }
    },
    {
      "subId": "801003",
      "subQuestName": "Go inside",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80100301"
        ],
        "dialogs": {
          "80100301": {
            "id": "80100301",
            "speakerId": 10222,
            "speakerName": "Hilichurl",
            "text": "...",
            "nextDialogs": [
              "80100304"
            ]
          },
          "80100304": {
            "id": "80100304",
            "speakerId": 1000,
            "speakerName": "Intimidating Man",
            "text": "Mind your own business. Don't worry, he isn't aggressive...",
            "nextDialogs": [
              "80100305"
            ]
          },
          "80100305": {
            "id": "80100305",
            "speakerId": 1000,
            "speakerName": "Intimidating Man",
            "text": "...How could he be. He was too young for anything like that.",
            "nextDialogs": [
              "80100306"
            ]
          },
          "80100306": {
            "id": "80100306",
            "speakerId": 1000,
            "speakerName": "Intimidating Man",
            "text": "So don't you lay a finger on him. Just find yourself a corner to rest if you're tired or cold.",
            "nextDialogs": [
              "80100307"
            ]
          },
          "80100307": {
            "id": "80100307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're... from Khaenri'ah, aren't you?",
            "nextDialogs": [
              "80100308"
            ]
          },
          "80100308": {
            "id": "80100308",
            "speakerId": 1000,
            "speakerName": "Intimidating Man",
            "text": "Huh?",
            "nextDialogs": [
              "80100309"
            ]
          },
          "80100309": {
            "id": "80100309",
            "speakerId": 1000,
            "speakerName": "Intimidating Man",
            "text": "You know Khaenri'ah... Who are you, exactly? And how do you know I'm from Khaenri'ah?"
          }
        }
      }
    },
    {
      "subId": "801018",
      "subQuestName": "Go inside",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80101801"
        ],
        "dialogs": {
          "80101801": {
            "id": "80101801",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "We're here. Let's begin...",
            "nextDialogs": [
              "80101802"
            ]
          },
          "80101802": {
            "id": "80101802",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Wait a moment... Hey, what was that? ...Caribert?",
            "nextDialogs": [
              "80101805"
            ]
          },
          "80101805": {
            "id": "80101805",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Oh no... He must have left while we were too busy preparing the medicine to notice...",
            "nextDialogs": [
              "80101806"
            ]
          },
          "80101806": {
            "id": "80101806",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Come on! We have to catch up with him!"
          }
        }
      }
    },
    {
      "subId": "801004",
      "subQuestName": "Talk to Eide",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80100801"
        ],
        "dialogs": {
          "80100801": {
            "id": "80100801",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "This is the method for making the medicine. You just need to follow the steps."
          }
        }
      }
    },
    {
      "subId": "801019",
      "subQuestName": "Go inside",
      "sceneId": null,
      "locations": [],

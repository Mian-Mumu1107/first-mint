    {
      "subId": "801008",
      "subQuestName": "Administer the dose of medicine to the hilichurl",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80101201"
        ],
        "dialogs": {
          "80101201": {
            "id": "80101201",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Caribert?",
            "nextDialogs": [
              "80101202"
            ]
          },
          "80101202": {
            "id": "80101202",
            "speakerId": 13170,
            "speakerName": "Caribert",
            "text": "...",
            "nextDialogs": [
              "80101203"
            ]
          },
          "80101203": {
            "id": "80101203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(The hilichurl seems almost lifeless. Its reactions to everything are incredibly weak...)",
            "nextDialogs": [
              "80101204"
            ]
          },
          "80101204": {
            "id": "80101204",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Well, we've prepared the medicine. We might as well try it.",
            "nextDialogs": [
              "80101205"
            ]
          },
          "80101205": {
            "id": "80101205",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "With your help, Eide feeds the newly made medicine to the hilichurl.",
            "nextDialogs": [
              "80101206"
            ]
          },
          "80101206": {
            "id": "80101206",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Caribert? It's me... It's your father. Caribert?",
            "nextDialogs": [
              "80101207"
            ]
          },
          "80101207": {
            "id": "80101207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Anything?",
            "nextDialogs": [
              "80101208"
            ]
          },
          "80101208": {
            "id": "80101208",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Caribert... Please, say something.",
            "nextDialogs": [
              "80101209"
            ]
          },
          "80101209": {
            "id": "80101209",
            "speakerId": 13170,
            "speakerName": "Caribert",
            "text": "...",
            "nextDialogs": [
              "80101210"
            ]
          },
          "80101210": {
            "id": "80101210",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I'm sorry I couldn't be at your side when you were born... and that I failed to reach you and mama in time when you both were suffering...",
            "nextDialogs": [
              "80101211"
            ]
          },
          "80101211": {
            "id": "80101211",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "But I'm here now. Papa's been by your side all these years. I've never left you. Not once.",
            "nextDialogs": [
              "80101212"
            ]
          },
          "80101212": {
            "id": "80101212",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Are you still angry with me, Caribert?",
            "nextDialogs": [
              "80101213"
            ]
          },
          "80101213": {
            "id": "80101213",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I know you're awake now... Do you not want to talk to me?",
            "nextDialogs": [
              "80101214"
            ]
          },
          "80101214": {
            "id": "80101214",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I'm so sorry, Caribert. Forgive me, please! Say something. Anything!",
            "nextDialogs": [
              "80101215"
            ]
          },
          "80101215": {
            "id": "80101215",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Please... please...",
            "nextDialogs": [
              "80101218"
            ]
          },
          "80101218": {
            "id": "80101218",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Aah!",
            "nextDialogs": [
              "80101219"
            ]
          },
          "80101219": {
            "id": "80101219",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Gods above! What more do you want from me!?",
            "nextDialogs": [
              "80101220"
            ]
          },
          "80101220": {
            "id": "80101220",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "You took everything from here, and I still bowed to you!",
            "nextDialogs": [
              "80101221"
            ]
          },
          "80101221": {
            "id": "80101221",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I'd give you my very life if only you cared to take it! But you won't even let me die!",
            "nextDialogs": [
              "80101222"
            ]
          },
          "80101222": {
            "id": "80101222",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "...I knew it. I should never have trusted anything that had to do with the gods. I was just deluding myself...",
            "nextDialogs": [
              "80101223"
            ]
          },
          "80101223": {
            "id": "80101223",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "The gods of this world have never stood with humanity... Not even for a moment!"
          }
        }
      }
    },

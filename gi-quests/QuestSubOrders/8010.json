    {
      "subId": "801005",
      "subQuestName": "Synthesize the Nameless Taboo Medicine of the Royal Court",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80100501"
        ],
        "dialogs": {
          "80100501": {
            "id": "80100501",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Over here.",
            "nextDialogs": [
              "80100504"
            ]
          },
          "80100504": {
            "id": "80100504",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I'm sure you're wondering why I brought Caribert here, to Sumeru.",
            "nextDialogs": [
              "80100505"
            ]
          },
          "80100505": {
            "id": "80100505",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Well, it's because he needs a medicine that can only be made here...",
            "nextDialogs": [
              "80100506"
            ]
          },
          "80100506": {
            "id": "80100506",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "One which will help him to recover his clarity of mind.",
            "nextDialogs": [
              "80100507"
            ]
          },
          "80100507": {
            "id": "80100507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Recover his clarity of mind?",
            "nextDialogs": [
              "80100508"
            ]
          },
          "80100508": {
            "id": "80100508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(When we were in The Chasm, Dain said that the curse could not be undone... Is recovery really possible?)",
            "nextDialogs": [
              "80100509"
            ]
          },
          "80100509": {
            "id": "80100509",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I do not hope to break the curse. I am well aware of my powerlessness against the punishment of the gods.",
            "nextDialogs": [
              "80100510"
            ]
          },
          "80100510": {
            "id": "80100510",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "But it's said that this medicine is imbued with the power of Sumeru's God of Wisdom, and can awaken the mind from a state of deep stupor... It has been used in the past to treat cases of mania.",
            "nextDialogs": [
              "80100511"
            ]
          },
          "80100511": {
            "id": "80100511",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I believe that it might just work...",
            "nextDialogs": [
              "80100512"
            ]
          },
          "80100512": {
            "id": "80100512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Where did you hear of this?",
            "nextDialogs": [
              "80100513"
            ]
          },
          "80100513": {
            "id": "80100513",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "...I read about it in a book from the Royal Library of Khaenri'ah. It was banned, since this medicine requires the power of The Seven to work.",
            "nextDialogs": [
              "80100514"
            ]
          },
          "80100514": {
            "id": "80100514",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "In my youth, I—I disliked the life of nobility, and craved excitement. I was leafing through some forbidden texts and happened upon it."
          }
        }
      }
    },
    {
      "subId": "801020",

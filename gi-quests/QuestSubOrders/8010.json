    {
      "subId": "801006",
      "subQuestName": "Talk to Eide",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80101001"
        ],
        "dialogs": {
          "80101001": {
            "id": "80101001",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Is it done? Splendid, let me see...",
            "nextDialogs": [
              "80101002"
            ]
          },
          "80101002": {
            "id": "80101002",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Hmm. In all honesty, I do not know what the end product is supposed to look like. The banned book didn't feature any illustrations...",
            "nextDialogs": [
              "80101003"
            ]
          },
          "80101003": {
            "id": "80101003",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "...Well, the moment has finally arrived... Curses.",
            "nextDialogs": [
              "80101006"
            ]
          },
          "80101006": {
            "id": "80101006",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "No, no. We need to perform one final step to complete the medicine.",
            "nextDialogs": [
              "80101007"
            ]
          },
          "80101007": {
            "id": "80101007",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I said before that this medicine relies on the power of the God of Wisdom for its restorative effects...",
            "nextDialogs": [
              "80101008"
            ]
          },
          "80101008": {
            "id": "80101008",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Which means... we must pay a visit to a Statue of The Seven."
          }
        }
      }
    },
    {
      "subId": "801021",
      "subQuestName": "Go inside",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "801007",
      "subQuestName": "Go to the nearby Statue of The Seven",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80101101"
        ],
        "dialogs": {
          "80101101": {
            "id": "80101101",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Look at this statue... How can I bow before this thing...",
            "nextDialogs": [
              "80101102"
            ]
          },
          "80101102": {
            "id": "80101102",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "God of Wisdom. Look at me.",
            "nextDialogs": [
              "80101103"
            ]
          },
          "80101103": {
            "id": "80101103",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I will utter no prayer, nor will I sing your praises.",
            "nextDialogs": [
              "80101104"
            ]
          },
          "80101104": {
            "id": "80101104",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "You and your kind destroyed my home, wrought unfathomable suffering on my compatriots... Yet here I stand before you.",
            "nextDialogs": [
              "80101105"
            ]
          },
          "80101105": {
            "id": "80101105",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "You cannot mock me more than fate itself already has.",
            "nextDialogs": [
              "80101106"
            ]
          },
          "80101106": {
            "id": "80101106",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "God of Wisdom, I seek not to disavow myself of the sinful blood that flows through my veins. I wish only to beseech you to have pity upon a young and unfortunate soul.",
            "nextDialogs": [
              "80101107"
            ]
          },
          "80101107": {
            "id": "80101107",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "My son, Caribert... He was turned into a monster before he had the chance to witness anything beautiful in this world... This is no fate for a child.",
            "nextDialogs": [
              "80101108"
            ]
          },
          "80101108": {
            "id": "80101108",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "...",
            "nextDialogs": [
              "80101109"
            ]
          },
          "80101109": {
            "id": "80101109",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "If everything the gods have done was in order to have the impious people of Khaenri'ah bow their heads...",
            "nextDialogs": [
              "80101110"
            ]
          },
          "80101110": {
            "id": "80101110",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Then... I bow to you now.",
            "nextDialogs": [
              "80101111"
            ]
          },
          "80101111": {
            "id": "80101111",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I have given up all I ever stood for...",
            "nextDialogs": [
              "80101112"
            ]
          },
          "80101112": {
            "id": "80101112",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "All I ask for is a tiny miracle. For Caribert to see this world once more.",
            "nextDialogs": [
              "80101113"
            ]
          },
          "80101113": {
            "id": "80101113",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "Please, god... I beg of you.",
            "nextDialogs": [
              "80101114"
            ]
          },
          "80101114": {
            "id": "80101114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "80101115"
            ]
          },
          "80101115": {
            "id": "80101115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(I may not know the whole truth behind the cataclysm, but the people of Khaenri'ah have truly suffered...)",
            "nextDialogs": [
              "80101116"
            ]
          },
          "80101116": {
            "id": "80101116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Why could Khaenri'ah and The Seven not coexist in peace?)",
            "nextDialogs": [
              "80101117"
            ]
          },
          "80101117": {
            "id": "80101117",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "I have made quite enough of a fool of myself for one day. Let's go.",
            "nextDialogs": [
              "80101118"
            ]
          },
          "80101118": {
            "id": "80101118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Things will get better.",
            "nextDialogs": [
              "80101119"
            ]
          },
          "80101119": {
            "id": "80101119",
            "speakerId": 13072,
            "speakerName": "Eide",
            "text": "...Hm."
          }
        }
      }
    },

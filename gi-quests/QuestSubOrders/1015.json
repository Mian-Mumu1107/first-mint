    {
      "subId": "101513",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10151301"
        ],
        "dialogs": {
          "10151301": {
            "id": "10151301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh, the reception is deserted. And it seems kinda spooky in here...",
            "nextDialogs": [
              "10151302"
            ]
          },
          "10151302": {
            "id": "10151302",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hello? Is anybody there?",
            "nextDialogs": [
              "10151303"
            ]
          },
          "10151303": {
            "id": "10151303",
            "speakerId": 1001,
            "speakerName": "???",
            "text": "Welcome to Bubu Pharmacy.",
            "nextDialogs": [
              "10151304"
            ]
          },
          "10151304": {
            "id": "10151304",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "...",
            "nextDialogs": [
              "10151305"
            ]
          },
          "10151305": {
            "id": "10151305",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "D—Did you hear that? Wh—Where did it come from?",
            "nextDialogs": [
              "10151306"
            ]
          },
          "10151306": {
            "id": "10151306",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "The reception, it seems.",
            "nextDialogs": [
              "10151307"
            ]
          },
          "10151307": {
            "id": "10151307",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, how about... you go check it out, and... Paimon will bring up the rear."
          }
        }
      }
    },
    {
      "subId": "101509",
      "subQuestName": "Find the source of the mystery voice",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10150901"
        ],
        "dialogs": {
          "10150901": {
            "id": "10150901",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh, there you are! But you can't even reach the counter!",
            "nextDialogs": [
              "10150903",
              "10150905"
            ]
          },
          "10150903": {
            "id": "10150903",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ah... Paimon thinks you might be right! Look at the talisman on her forehead!",
            "nextDialogs": [
              "10150908"
            ]
          },
          "10150908": {
            "id": "10150908",
            "speakerId": 1003,
            "speakerName": "Qiqi",
            "text": "Welcome to Bubu Pharmacy. I am Qiqi.",
            "nextDialogs": [
              "10150909"
            ]
          },
          "10150909": {
            "id": "10150909",
            "speakerId": 1003,
            "speakerName": "Qiqi",
            "text": "Once upon a time, Qiqi died. Then, Qiqi was saved by the adepti. Now, Qiqi is a zombie."
          },
          "10150905": {
            "id": "10150905",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Joke's on you — Paimon floats, so height is no restriction.",
            "nextDialogs": [
              "10150906"
            ]
          },
          "10150906": {
            "id": "10150906",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Anyway, there's something weird about this one over here. What's that talisman doing on her forehead?",
            "nextDialogs": [
              "10150907"
            ]
          },
          "10150907": {
            "id": "10150907",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "It can't be... she's... a zombie!?"
          }
        }
      }
    },

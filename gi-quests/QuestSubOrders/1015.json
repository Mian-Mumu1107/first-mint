    {
      "subId": "101505",
      "subQuestName": "Repair the Guizhong Ballista",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "101506",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10150601"
        ],
        "dialogs": {
          "10150601": {
            "id": "10150601",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "These parts look useful.",
            "nextDialogs": [
              "10150602"
            ]
          },
          "10150602": {
            "id": "10150602",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "One moment, I will try to repair the device...",
            "nextDialogs": [
              "10150603"
            ]
          },
          "10150603": {
            "id": "10150603",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "It is done. The Guizhong Ballista is more intricately designed than I thought.",
            "nextDialogs": [
              "10150604"
            ]
          },
          "10150604": {
            "id": "10150604",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Woo! Now how do we turn it on?",
            "nextDialogs": [
              "10150605"
            ]
          },
          "10150605": {
            "id": "10150605",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "It's easy enough. We simply need to do this... Look, it even has a scope.",
            "nextDialogs": [
              "10150617"
            ]
          },
          "10150617": {
            "id": "10150617",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Over here we have... Nothing. And over there... More nothing.",
            "nextDialogs": [
              "10150606"
            ]
          },
          "10150606": {
            "id": "10150606",
            "speakerId": 1004,
            "speakerName": "Freckle Huang",
            "text": "Hey! Just what do you think you're doing!?",
            "nextDialogs": [
              "10150607"
            ]
          },
          "10150607": {
            "id": "10150607",
            "speakerId": 1004,
            "speakerName": "Freckle Huang",
            "text": "So, you've fixed up this turret... because you're planning to do what, exactly!?",
            "nextDialogs": [
              "10150608"
            ]
          },
          "10150608": {
            "id": "10150608",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Not a turret. A Guizhong Ballista. Also, kindly state your name before you ask a question, it's just good manners.",
            "nextDialogs": [
              "10150609"
            ]
          },
          "10150609": {
            "id": "10150609",
            "speakerId": 1004,
            "speakerName": "Freckle Huang",
            "text": "Hah! Are you blind or something? You're looking at the leader of the Treasure Hoarders, old man!",
            "nextDialogs": [
              "10150610"
            ]
          },
          "10150610": {
            "id": "10150610",
            "speakerId": 1004,
            "speakerName": "Freckle Huang",
            "text": "This area's supposed to be chock-full of hidden treasures, but you can't get anywhere near them with this thing keeping watch. It might look like any other mechanical device, but trust me, it's got a mind of its own!",
            "nextDialogs": [
              "10150611"
            ]
          },
          "10150611": {
            "id": "10150611",
            "speakerId": 1004,
            "speakerName": "Freckle Huang",
            "text": "Last time we approached the mountain, it nearly skewered one of our guys...",
            "nextDialogs": [
              "10150612"
            ]
          },
          "10150612": {
            "id": "10150612",
            "speakerId": 1004,
            "speakerName": "Freckle Huang",
            "text": "A few of us risked our lives to disarm it — which, amazingly, we managed — and then we turn our backs for two seconds and you've ALREADY GONE AND REPAIRED IT!?",
            "nextDialogs": [
              "10150613"
            ]
          },
          "10150613": {
            "id": "10150613",
            "speakerId": 1004,
            "speakerName": "Freckle Huang",
            "text": "The next thing you'll be repairing is your faces, and that's if you get out of this alive!",
            "nextDialogs": [
              "10150614"
            ]
          },
          "10150614": {
            "id": "10150614",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Tut-tut. Vandalizing the legacy of an adeptus for selfish gain. Disgraceful behavior.",
            "nextDialogs": [
              "10150615"
            ]
          },
          "10150615": {
            "id": "10150615",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "It is not we who need reprimanding, but you.",
            "nextDialogs": [
              "10150616"
            ]
          },
          "10150616": {
            "id": "10150616",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Quite right! Let's get 'em, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "101510",
      "subQuestName": "Defeat the Treasure Hoarders",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "101514",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10151401"
        ],
        "dialogs": {
          "10151401": {
            "id": "10151401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "These lowlifes didn't know who they were messing with!",
            "nextDialogs": [
              "10151402"
            ]
          },
          "10151402": {
            "id": "10151402",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Troubling ourselves over this rabble is not worth the time. We should focus on our contract with Qiqi.",
            "nextDialogs": [
              "10151403"
            ]
          },
          "10151403": {
            "id": "10151403",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh yeah... that. So we've got the Guizhong Ballista working, but where's our Cocogoat?",
            "nextDialogs": [
              "10151404"
            ]
          },
          "10151404": {
            "id": "10151404",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "A search using the Guizhong Ballista revealed no significant life forms nearby, save for the usual wildlife.",
            "nextDialogs": [
              "10151405"
            ]
          },
          "10151405": {
            "id": "10151405",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "What's more, a contraption built using adeptus technology should have no trouble detecting an \"adeptibeast\" as Qiqi put it...",
            "nextDialogs": [
              "10151406"
            ]
          },
          "10151406": {
            "id": "10151406",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Which means...",
            "nextDialogs": [
              "10151410",
              "10151409"
            ]
          },
          "10151410": {
            "id": "10151410",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "We won't solve anything while standing here and racking our brains. Let's return to Bubu Pharmacy, explain that we could not find a Cocogoat, and review our next step.",
            "nextDialogs": [
              "10151411"
            ]
          },
          "10151411": {
            "id": "10151411",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Good idea. We did our best, and that's what counts."
          },
          "10151409": {
            "id": "10151409",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon wouldn't go that far. We did something positive, right?"
          }
        }
      }
    },
    {
      "subId": "101507",
      "subQuestName": "Find Qiqi back at the Bubu Pharmacy",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10150701"
        ],
        "dialogs": {
          "10150701": {
            "id": "10150701",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Forgive us, we were unable to fulfill our end of the contract. We found no trace of the Cocogoat adeptibeast of which you speak.",
            "nextDialogs": [
              "10150702"
            ]
          },
          "10150702": {
            "id": "10150702",
            "speakerId": 1003,
            "speakerName": "Qiqi",
            "text": "Ah. What a disappointment. Don't worry about it. But I feel very disappointed.",
            "nextDialogs": [
              "10150703"
            ]
          },
          "10150703": {
            "id": "10150703",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Aw, poor Qiqi... Why does Paimon feel so guilty all of a sudden?",
            "nextDialogs": [
              "10150706"
            ]
          },
          "10150706": {
            "id": "10150706",
            "speakerId": 1003,
            "speakerName": "Qiqi",
            "text": "Cocogoat milk is tasty. So tasty. Much better than normal goat milk. Only an adeptibeast could make such tasty milk.",
            "nextDialogs": [
              "10150707"
            ]
          },
          "10150707": {
            "id": "10150707",
            "speakerId": 1003,
            "speakerName": "Qiqi",
            "text": "I'm sorry. I have a poor memory. I cannot remember the name of the milk. That's why I wrote it down. Where did I put it...",
            "nextDialogs": [
              "10150708"
            ]
          },
          "10150708": {
            "id": "10150708",
            "speakerId": 1003,
            "speakerName": "Qiqi",
            "text": "Ah. Here. This is the name. \"Coconut milk.\"",
            "nextDialogs": [
              "10150709"
            ]
          },
          "10150709": {
            "id": "10150709",
            "speakerId": 1005,
            "speakerName": "Crowd",
            "text": "Ehh!?",
            "nextDialogs": [
              "10150710"
            ]
          },
          "10150710": {
            "id": "10150710",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "...",
            "nextDialogs": [
              "10150711"
            ]
          },
          "10150711": {
            "id": "10150711",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "I owe you both an apology. I hastily agreed to what appeared to be an equitable agreement with this zombie child, when perhaps I should have undertaken further due diligence.",
            "nextDialogs": [
              "10150712"
            ]
          },
          "10150712": {
            "id": "10150712",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Never mind Zhongli, you didn't know. As the Liyue proverb goes, \"All things are random, and... so how are you supposed to predict anything.\" Literally no one could have seen this coming...",
            "nextDialogs": [
              "10150713"
            ]
          },
          "10150713": {
            "id": "10150713",
            "speakerId": 1003,
            "speakerName": "Qiqi",
            "text": "Excuse me, everyone. Did Qiqi say a bad thing?",
            "nextDialogs": [
              "10150714"
            ]
          },
          "10150714": {
            "id": "10150714",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Ooh... Sorry, {NICKNAME}, but Paimon's gonna leave the job of shattering this poor kiddo's world to you..."
          }
        }
      }
    },
    {
      "subId": "101511",
      "subQuestName": "Put the Everlasting Incense in place",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10151101"
        ],
        "dialogs": {
          "10151101": {
            "id": "10151101",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Well, as it stands, we've hired helpers, and we've acquired the Everlasting Incense. The completion of our preparations is not far off.",
            "nextDialogs": [
              "10151102"
            ]
          },
          "10151102": {
            "id": "10151102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whew... Finally!",
            "nextDialogs": [
              "10151103"
            ]
          },
          "10151103": {
            "id": "10151103",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Well, Traveler, have you gained anything from our adventure so far?",
            "nextDialogs": [
              "10151104"
            ]
          },
          "10151104": {
            "id": "10151104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's been... odd.",
            "nextDialogs": [
              "10151105"
            ]
          },
          "10151105": {
            "id": "10151105",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Odd?",
            "nextDialogs": [
              "10151108"
            ]
          },
          "10151108": {
            "id": "10151108",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "Haha, which is it, I wonder?",
            "nextDialogs": [
              "10151109"
            ]
          },
          "10151109": {
            "id": "10151109",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "The questions that such travels raise are ever so complicated. Well, I'll leave you to ruminate over it yourself. As to remuneration for your help, I've decided...",
            "nextDialogs": [
              "10151110"
            ]
          },
          "10151110": {
            "id": "10151110",
            "speakerId": 1002,
            "speakerName": "Zhongli",
            "text": "...to treat you to a meal."
          }
        }
      }
    },
    {
      "subId": "10150701",
      "subQuestName": "Additional",
      "sceneId": null,

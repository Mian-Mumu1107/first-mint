    {
      "subId": "201709",
      "subQuestName": "Talk to Kamisato Ayaka",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20170901"
        ],
        "dialogs": {
          "20170901": {
            "id": "20170901",
            "speakerId": 1005,
            "speakerName": "Kamisato Ayaka",
            "text": "#Well, {NICKNAME}? How did it go?",
            "nextDialogs": [
              "20170904"
            ]
          },
          "20170904": {
            "id": "20170904",
            "speakerId": 1005,
            "speakerName": "Kamisato Ayaka",
            "text": "Well done. Let's wait for news from Sayu.",
            "nextDialogs": [
              "20170905"
            ]
          },
          "20170905": {
            "id": "20170905",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "After some time...",
            "nextDialogs": [
              "20170906"
            ]
          },
          "20170906": {
            "id": "20170906",
            "speakerId": 1001,
            "speakerName": "Sayu",
            "text": "*panting*...",
            "nextDialogs": [
              "20170907"
            ]
          },
          "20170907": {
            "id": "20170907",
            "speakerId": 1001,
            "speakerName": "Sayu",
            "text": "I know exercise helps you grow, but this was a little too much exercise...",
            "nextDialogs": [
              "20170908"
            ]
          },
          "20170908": {
            "id": "20170908",
            "speakerId": 1001,
            "speakerName": "Sayu",
            "text": "I feel so dizzy... Everyone is spinning...",
            "nextDialogs": [
              "20170909"
            ]
          },
          "20170909": {
            "id": "20170909",
            "speakerId": 1001,
            "speakerName": "Sayu",
            "text": "No, I can't sleep yet. There was something important I was supposed to do first... Oh, right, yeah. I got it!",
            "nextDialogs": [
              "20170910"
            ]
          },
          "20170910": {
            "id": "20170910",
            "speakerId": 1001,
            "speakerName": "Sayu",
            "text": "I didn't know how to find the document you guys were talking about, so I just swiped a whole bunch of stuff that looked suspicious.",
            "nextDialogs": [
              "20170911"
            ]
          },
          "20170911": {
            "id": "20170911",
            "speakerId": 1001,
            "speakerName": "Sayu",
            "text": "Here you go... I'm going to sleep now...",
            "nextDialogs": [
              "20170912"
            ]
          },
          "20170912": {
            "id": "20170912",
            "speakerId": 1003,
            "speakerName": "Thoma",
            "text": "Milady, what are we looking at?",
            "nextDialogs": [
              "20170913"
            ]
          },
          "20170913": {
            "id": "20170913",
            "speakerId": 1005,
            "speakerName": "Kamisato Ayaka",
            "text": "This sealed envelope must be an official report that the Tenryou Commission is preparing to present to the Shogun.",
            "nextDialogs": [
              "20170914"
            ]
          },
          "20170914": {
            "id": "20170914",
            "speakerId": 1005,
            "speakerName": "Kamisato Ayaka",
            "text": "In addition, we have... correspondence with the Fatui.",
            "nextDialogs": [
              "20170915"
            ]
          },
          "20170915": {
            "id": "20170915",
            "speakerId": 1005,
            "speakerName": "Kamisato Ayaka",
            "text": "It seems that Guuji Yae was right. They have been fomenting unrest behind the scenes.",
            "nextDialogs": [
              "20170916"
            ]
          },
          "20170916": {
            "id": "20170916",
            "speakerId": 1005,
            "speakerName": "Kamisato Ayaka",
            "text": "#{NICKNAME}, this should be ample evidence. Please take them to <color=#00E1FFFF>Guuji Yae</color>. I trust she will have a plan for the next step.",
            "nextDialogs": [
              "20170917"
            ]
          },
          "20170917": {
            "id": "20170917",
            "speakerId": 1005,
            "speakerName": "Kamisato Ayaka",
            "text": "I will also gather some people to try and root out the rest of the Fatui in Inazuma.",
            "nextDialogs": [
              "20170918"
            ]
          },
          "20170918": {
            "id": "20170918",
            "speakerId": 1003,
            "speakerName": "Thoma",
            "text": "Still, mind yourself when you face the Shogun. I still get goosebumps just thinking about her drawing that blade...",
            "nextDialogs": [
              "20170919"
            ]
          },
          "20170919": {
            "id": "20170919",
            "speakerId": 1005,
            "speakerName": "Kamisato Ayaka",
            "text": "Again, we'll just have to trust Guuji Yae. She is close to the Shogun, so maybe she will have a way...",
            "nextDialogs": [
              "20170920"
            ]
          },
          "20170920": {
            "id": "20170920",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "If Paimon remembers correctly, it should be time for our meeting with Yae Miko soon.",
            "nextDialogs": [
              "20170921"
            ]
          },
          "20170921": {
            "id": "20170921",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Let's pack up our things and get ready to head to the <color=#00E1FFFF>Grand Narukami Shrine</color>."
          }
        }
      }
    },
    {

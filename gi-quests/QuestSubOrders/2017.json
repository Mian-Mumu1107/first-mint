    {
      "subId": "201702",
      "subQuestName": "Find the helper who Yae Miko spoke of",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20170201"
        ],
        "dialogs": {
          "20170201": {
            "id": "20170201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ah! That toy tanuki just turned into a human!",
            "nextDialogs": [
              "20170202"
            ]
          },
          "20170202": {
            "id": "20170202",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What's going on? Paimon's never seen one of these before!",
            "nextDialogs": [
              "20170203"
            ]
          },
          "20170203": {
            "id": "20170203",
            "speakerId": 1001,
            "speakerName": "Sayu",
            "text": "Not a tanuki... I'm a mujina... *snore*...",
            "nextDialogs": [
              "20170204"
            ]
          },
          "20170204": {
            "id": "20170204",
            "speakerId": 1001,
            "speakerName": "Sayu",
            "text": "I'm so tired... If I don't get enough sleep... it'll stunt my growth...",
            "nextDialogs": [
              "20170205"
            ]
          },
          "20170205": {
            "id": "20170205",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Um, is this the \"professional\" you were talking about?",
            "nextDialogs": [
              "20170206"
            ]
          },
          "20170206": {
            "id": "20170206",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Heh... She doesn't look very professional at all.",
            "nextDialogs": [
              "20170207"
            ]
          },
          "20170207": {
            "id": "20170207",
            "speakerId": 1002,
            "speakerName": "Yae Miko",
            "text": "Hehe... She is a member of the Shuumatsuban, a genuine, bona-fide ninja.",
            "nextDialogs": [
              "20170208"
            ]
          },
          "20170208": {
            "id": "20170208",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wow, a ninja! So was that one of those legendary ninja transformation techniques?",
            "nextDialogs": [
              "20170209"
            ]
          },
          "20170209": {
            "id": "20170209",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Anyway, what's the Shuumatsuban?",
            "nextDialogs": [
              "20170210"
            ]
          },
          "20170210": {
            "id": "20170210",
            "speakerId": 1002,
            "speakerName": "Yae Miko",
            "text": "It belongs to the Yashiro Commission. A secret unit under Kamisato Ayato.",
            "nextDialogs": [
              "20170211"
            ]
          },
          "20170211": {
            "id": "20170211",
            "speakerId": 1002,
            "speakerName": "Yae Miko",
            "text": "Now, Kamisato Ayato and the Yashiro Commission are neutral parties, so I have no right to give orders to the Shuumatsuban.",
            "nextDialogs": [
              "20170212"
            ]
          },
          "20170212": {
            "id": "20170212",
            "speakerId": 1002,
            "speakerName": "Yae Miko",
            "text": "However, convincing their most chronically lazy member to help us is well within my abilities.",
            "nextDialogs": [
              "20170213"
            ]
          },
          "20170213": {
            "id": "20170213",
            "speakerId": 1001,
            "speakerName": "Sayu",
            "text": "Ah...",
            "nextDialogs": [
              "20170214"
            ]
          },
          "20170214": {
            "id": "20170214",
            "speakerId": 1002,
            "speakerName": "Yae Miko",
            "text": "Here's what I need you to do: Go into town and find evidence of the Tenryou Commission's betrayal.",
            "nextDialogs": [
              "20170215"
            ]
          },
          "20170215": {
            "id": "20170215",
            "speakerId": 1002,
            "speakerName": "Yae Miko",
            "text": "It would not be appropriate for me to be seen there myself.",
            "nextDialogs": [
              "20170216"
            ]
          },
          "20170216": {
            "id": "20170216",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You make it sound so simple, but...",
            "nextDialogs": [
              "20170219"
            ]
          },
          "20170219": {
            "id": "20170219",
            "speakerId": 1002,
            "speakerName": "Yae Miko",
            "text": "Hmm? Oh, I thought you would have figured it out by now. Alright then, I'll indulge you with a little more information.",
            "nextDialogs": [
              "20170220"
            ]
          },
          "20170220": {
            "id": "20170220",
            "speakerId": 1002,
            "speakerName": "Yae Miko",
            "text": "For a complete outsider, probing the inner workings of the Tenryou Commission is nigh on impossible.",
            "nextDialogs": [
              "20170221"
            ]
          },
          "20170221": {
            "id": "20170221",
            "speakerId": 1002,
            "speakerName": "Yae Miko",
            "text": "But since the three Commissions work together to serve the Shogun, they have a close relationship. Someone from one of the other Commissions might have an easier job of figuring out what they're up to...",
            "nextDialogs": [
              "20170222"
            ]
          },
          "20170222": {
            "id": "20170222",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Yashiro Commission!",
            "nextDialogs": [
              "20170223"
            ]
          },
          "20170223": {
            "id": "20170223",
            "speakerId": 1002,
            "speakerName": "Yae Miko",
            "text": "Hehe... Now you're following me.",
            "nextDialogs": [
              "20170224"
            ]
          },
          "20170224": {
            "id": "20170224",
            "speakerId": 1002,
            "speakerName": "Yae Miko",
            "text": "The Shogun's Army haven't given up on their search for you yet, but with the help of this Shuumatsuban ninja, I'm sure you'll be able to rendezvous with your friends.",
            "nextDialogs": [
              "20170225"
            ]
          },
          "20170225": {
            "id": "20170225",
            "speakerId": 1002,
            "speakerName": "Yae Miko",
            "text": "Don't forget we're on a tight schedule here. Be sure to bring back the evidence in good time."
          }
        }
      }
    },

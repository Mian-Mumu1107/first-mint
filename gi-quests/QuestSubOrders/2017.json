    {
      "subId": "201752",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20175201"
        ],
        "dialogs": {
          "20175201": {
            "id": "20175201",
            "speakerId": 1005,
            "speakerName": "Kamisato Ayaka",
            "text": "Fireworks are more visible at night... If possible, I suggest you wait till <color=#00E1FFFF>after dark</color> to put your plan into action."
          }
        }
      }
    },
    {
      "subId": "202201",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20220101"
        ],
        "dialogs": {
          "20220101": {
            "id": "20220101",
            "speakerId": 1008,
            "speakerName": "Patrol Soldier",
            "text": "Stop! I have orders to search for a wanted criminal!",
            "nextDialogs": [
              "20220102"
            ]
          },
          "20220102": {
            "id": "20220102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yikes! Hide — quick!"
          }
        }
      }
    },
    {
      "subId": "202202",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20220201"
        ],
        "dialogs": {
          "20220201": {
            "id": "20220201",
            "speakerId": 1008,
            "speakerName": "Patrol Soldier",
            "text": "You! The warrant is for your arrest! Freeze!",
            "nextDialogs": [
              "20220202"
            ]
          },
          "20220202": {
            "id": "20220202",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Oh no — run!"
          }
        }
      }
    }

    {
      "subId": "201707",
      "subQuestName": "Talk to Sayu",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20170701"
        ],
        "dialogs": {
          "20170701": {
            "id": "20170701",
            "speakerId": 1001,
            "speakerName": "Sayu",
            "text": "Hmm... Pretty much how I thought...",
            "nextDialogs": [
              "20170702"
            ]
          },
          "20170702": {
            "id": "20170702",
            "speakerId": 1001,
            "speakerName": "Sayu",
            "text": "There are loads and loads of people... If one of them spots me, I'll get caught...",
            "nextDialogs": [
              "20170703"
            ]
          },
          "20170703": {
            "id": "20170703",
            "speakerId": 1001,
            "speakerName": "Sayu",
            "text": "We need to get rid of them, or I won't be able to sneak inside...",
            "nextDialogs": [
              "20170704"
            ]
          },
          "20170704": {
            "id": "20170704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll just have to trust Yoimiya.",
            "nextDialogs": [
              "20170705"
            ]
          },
          "20170705": {
            "id": "20170705",
            "speakerId": 1001,
            "speakerName": "Sayu",
            "text": "After I get the document, let's meet back at <color=#00E1FFFF>Komore Teahouse</color>, okay?",
            "nextDialogs": [
              "20170706"
            ]
          },
          "20170706": {
            "id": "20170706",
            "speakerId": 1001,
            "speakerName": "Sayu",
            "text": "Also, if I do get caught... please come rescue me...",
            "nextDialogs": [
              "20170707"
            ]
          },
          "20170707": {
            "id": "20170707",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Is this really a good idea...?",
            "nextDialogs": [
              "20170708"
            ]
          },
          "20170708": {
            "id": "20170708",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Uh, a—anyway, let's make our way to the <color=#00E1FFFF>statue</color>! Careful does it, watch out for guards and don't get caught!"
          }
        }
      }
    },

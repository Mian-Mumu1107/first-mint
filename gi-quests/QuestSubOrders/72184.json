      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721840201"
        ],
        "dialogs": {
          "721840201": {
            "id": "721840201",
            "speakerId": 1000,
            "speakerName": "Rie",
            "text": "Oh, hello. Can I help you with something?",
            "nextDialogs": [
              "721840202"
            ]
          },
          "721840202": {
            "id": "721840202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About Kiminami Restaurant's pizza...",
            "nextDialogs": [
              "721840203"
            ]
          },
          "721840203": {
            "id": "721840203",
            "speakerId": 1000,
            "speakerName": "Rie",
            "text": "Oh, that pizza tastes really good.",
            "nextDialogs": [
              "721840204"
            ]
          },
          "721840204": {
            "id": "721840204",
            "speakerId": 1000,
            "speakerName": "Rie",
            "text": "But...how do I put this, I'm not very used to its flavor.",
            "nextDialogs": [
              "721840205"
            ]
          },
          "721840205": {
            "id": "721840205",
            "speakerId": 1000,
            "speakerName": "Rie",
            "text": "I just think that if you can mix some of Inazuma's local ingredients into the pizza, such as Lavender Melon...",
            "nextDialogs": [
              "721840206"
            ]
          },
          "721840206": {
            "id": "721840206",
            "speakerId": 1000,
            "speakerName": "Rie",
            "text": "Maybe, the pizza will be more popular with everyone."
          }
        }
      }
    },
    {
      "subId": "7218403",
      "subQuestName": "Talk to Kiminami Anna",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721840301"
        ],
        "dialogs": {
          "721840301": {
            "id": "721840301",
            "speakerId": 1001,
            "speakerName": "Kiminami Anna",
            "text": "Traveler, you've returned.",
            "nextDialogs": [
              "721840302"
            ]
          },
          "721840302": {
            "id": "721840302",
            "speakerId": 1001,
            "speakerName": "Kiminami Anna",
            "text": "How did it go, any feedback?",
            "nextDialogs": [
              "721840303"
            ]
          },
          "721840303": {
            "id": "721840303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the customers' feedback...",
            "nextDialogs": [
              "721840304"
            ]
          },
          "721840304": {
            "id": "721840304",
            "speakerId": 1001,
            "speakerName": "Kiminami Anna",
            "text": "Pizza made with Lavender Melon... That's not too complicated...",
            "nextDialogs": [
              "721840305"
            ]
          },
          "721840305": {
            "id": "721840305",
            "speakerId": 1001,
            "speakerName": "Kiminami Anna",
            "text": "The rest of the ingredients just need to be prepared as usual. Well, since the feedback said to \"incorporate some of Inazuma's local ingredients,\" then I can add some other ingredients...",
            "nextDialogs": [
              "721840306"
            ]
          },
          "721840306": {
            "id": "721840306",
            "speakerId": 1001,
            "speakerName": "Kiminami Anna",
            "text": "Hmm, Sea Ganoderma? Naku Weed? Oh, how about Fluorescent Fungus...",
            "nextDialogs": [
              "721840307"
            ]
          },
          "721840307": {
            "id": "721840307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Umm, need some help?",
            "nextDialogs": [
              "721840308"
            ]
          },
          "721840308": {
            "id": "721840308",
            "speakerId": 1001,
            "speakerName": "Kiminami Anna",
            "text": "Oh! I'm sorry, I was busy thinking about what ingredients to put in! Let's see, I don't think there's much Lavender Melon left in the store...",
            "nextDialogs": [
              "721840309"
            ]
          },
          "721840309": {
            "id": "721840309",
            "speakerId": 1001,
            "speakerName": "Kiminami Anna",
            "text": "Traveler, please help me get a Lavender Melon. When it comes to ingredients...this should be all that's missing.",
            "nextDialogs": [
              "721840311",
              "721840313"
            ]
          },
          "721840311": {
            "id": "721840311",
            "speakerId": 1001,
            "speakerName": "Kiminami Anna",
            "text": "Mm, I'm counting on you, then. Just one Lavender Melon will do."
          },
          "721840313": {
            "id": "721840313",
            "speakerId": 1001,
            "speakerName": "Kiminami Anna",
            "text": "There are still some other ingredients in stock in the store. Just bring back a Lavender Melon, please."
          }
        }
      }
    },
    {
      "subId": "7218404",

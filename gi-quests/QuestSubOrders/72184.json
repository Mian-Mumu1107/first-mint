          },
          "721840504": {
            "id": "721840504",
            "speakerId": 1001,
            "speakerName": "Kiminami Anna",
            "text": "This pizza looks... pretty good...",
            "nextDialogs": [
              "721840505"
            ]
          },
          "721840505": {
            "id": "721840505",
            "speakerId": 1001,
            "speakerName": "Kiminami Anna",
            "text": "Thanks for your help, Traveler. Here, these are for you.",
            "nextDialogs": [
              "721840506"
            ]
          },
          "721840506": {
            "id": "721840506",
            "speakerId": 1001,
            "speakerName": "Kiminami Anna",
            "text": "I'll make sure to savor this pizza's taste...",
            "nextDialogs": [
              "721840507"
            ]
          },
          "721840507": {
            "id": "721840507",
            "speakerId": 1001,

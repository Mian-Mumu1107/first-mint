  "subQuests": [
    {
      "subId": "7166001",
      "subQuestName": "Report the effects of the Smoldersleet Potions to Timaeus",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716600101"
        ],
        "dialogs": {
          "716600101": {
            "id": "716600101",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "You're back! How are the Smoldersleet Potions performing?",
            "nextDialogs": [
              "716600103",
              "716600106"
            ]
          },
          "716600103": {
            "id": "716600103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yup! That would take the cake!",
            "nextDialogs": [
              "716600104"
            ]
          },
          "716600104": {
            "id": "716600104",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "Oh? Seems like you liked it. Go on then, give us the details!",
            "nextDialogs": [
              "716600108"
            ]
          },
          "716600108": {
            "id": "716600108",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You explain what happened during the test run in detail.",
            "nextDialogs": [
              "716600109"
            ]
          },
          "716600109": {
            "id": "716600109",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "It's just as you predicted, Ms. Ying'er!",
            "nextDialogs": [
              "716600110"
            ]
          },
          "716600110": {
            "id": "716600110",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "Our path for improvement is clear — we must somehow contain the sublimated substances within a set area.",
            "nextDialogs": [
              "716600111"
            ]
          },
          "716600111": {
            "id": "716600111",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "Perhaps we could reverse the special characteristics of dandelions to create special excipients that can prevent the substances from being affected by the flow of air.",
            "nextDialogs": [
              "716600112"
            ]
          },
          "716600112": {
            "id": "716600112",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "There is no precedent to such a method though, and we will need a great number of trials to prove its feasibility.",
            "nextDialogs": [
              "716600113"
            ]
          },
          "716600113": {
            "id": "716600113",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow, Paimon couldn't make sense of that at all.",
            "nextDialogs": [
              "716600114"
            ]
          },
          "716600114": {
            "id": "716600114",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Still, it feels like you made some important suggestions each time, Ms. Ying'er.",
            "nextDialogs": [
              "716600115"
            ]
          },
          "716600115": {
            "id": "716600115",
            "speakerId": 1003,
            "speakerName": "Ying'er",
            "text": "Ah, I don't think I ever came up with such a detailed postulation.",
            "nextDialogs": [
              "716600116"
            ]
          },
          "716600116": {
            "id": "716600116",
            "speakerId": 1003,
            "speakerName": "Ying'er",
            "text": "Well, my hardworking alchemist, are you trying to fathom my depths, or are you just trying to please me through flattery?",
            "nextDialogs": [
              "716600117"
            ]
          },
          "716600117": {
            "id": "716600117",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "I—I'm just expressing my admiration for your knowledge!",
            "nextDialogs": [
              "716600118"
            ]
          },
          "716600118": {
            "id": "716600118",
            "speakerId": 1003,
            "speakerName": "Ying'er",
            "text": "Alright, alright. You'd best give it your all, now. Who knows? You might have to use some alternative sources of knowledge in the future, too.",
            "nextDialogs": [
              "716600119"
            ]
          },
          "716600119": {
            "id": "716600119",
            "speakerId": 1003,
            "speakerName": "Ying'er",
            "text": "Don't forget to keep me posted once your research succeeds.",
            "nextDialogs": [
              "716600120"
            ]
          },
          "716600120": {
            "id": "716600120",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "Of course! When that time comes, I'll send you my best potions as a memento!",
            "nextDialogs": [
              "716600121"
            ]
          },
          "716600121": {
            "id": "716600121",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "You know, Ms. Ying'er, if you have the time, would you like to come with us to Wanmin Restaurant...?",
            "nextDialogs": [
              "716600122"
            ]
          },
          "716600122": {
            "id": "716600122",
            "speakerId": 1003,
            "speakerName": "Ying'er",
            "text": "Oh, I'm afraid our academic exchange must come to an end for now. There are still many matters I must attend to at Scent of Spring.",
            "nextDialogs": [
              "716600123"
            ]
          },
          "716600123": {
            "id": "716600123",
            "speakerId": 1003,
            "speakerName": "Ying'er",
            "text": "Don't forget to drop by often~",
            "nextDialogs": [
              "716600124"
            ]
          },
          "716600124": {
            "id": "716600124",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We will!",
            "nextDialogs": [
              "716600125"
            ]
          },
          "716600125": {
            "id": "716600125",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Thanks, Ms. Ying'er!",
            "nextDialogs": [
              "716600126"
            ]
          },
          "716600126": {
            "id": "716600126",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "Ying'er leaves.",
            "nextDialogs": [
              "716600127"
            ]
          },
          "716600127": {
            "id": "716600127",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "*sigh* I couldn't say it in the end, huh?",
            "nextDialogs": [
              "716600128"
            ]
          },
          "716600128": {
            "id": "716600128",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "But considering that I'd already given her so much trouble, it was probably for the best that I didn't take up any more of her time.",
            "nextDialogs": [
              "716600129"
            ]
          },
          "716600129": {
            "id": "716600129",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "Alright then. We'll calm down a bit, and wait for a suitable opportunity...",
            "nextDialogs": [
              "716600130"
            ]
          },
          "716600130": {
            "id": "716600130",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What are you talking to yourself about, Timaeus?",
            "nextDialogs": [
              "716600131"
            ]
          },
          "716600131": {
            "id": "716600131",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "Uh, N—Nothing!",
            "nextDialogs": [
              "716600132"
            ]
          },
          "716600132": {
            "id": "716600132",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "Thanks for your help so far! As we agreed, I'll treat you both to a great meal at Wanmin Restaurant.",
            "nextDialogs": [
              "716600133"
            ]
          },
          "716600133": {
            "id": "716600133",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'd almost forgotten...",
            "nextDialogs": [
              "716600134"
            ]
          },
          "716600134": {
            "id": "716600134",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ooh, that's right! Alright, alright, alright! Time for a great big meal!",
            "nextDialogs": [
              "716600135"
            ]
          },
          "716600135": {
            "id": "716600135",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "You go to Wanmin Restaurant with Timaeus and have a hearty meal.",
            "nextDialogs": [
              "716600136"
            ]
          },
          "716600136": {
            "id": "716600136",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whew! Paimon's super full!",
            "nextDialogs": [
              "716600137"
            ]
          },
          "716600137": {
            "id": "716600137",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Actually, this research was pretty cool! You should bring us along next time you come to Liyue, Timaeus!"
          },
          "716600106": {
            "id": "716600106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's true... For example, it would be better if we could use it outside Domains!",
            "nextDialogs": [
              "716600107"
            ]
          },
          "716600107": {
            "id": "716600107",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "True. I was just discussing the issue with Ms. Ying'er. Please, give us all the details."
          }
        }
      }
    },

    {
      "subId": "7306603",
      "subQuestName": "Talk to the Aranara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730660301"
        ],
        "dialogs": {
          "730660301": {
            "id": "730660301",
            "speakerId": 1000,
            "speakerName": "???",
            "text": "#Golden Nara... Yep, that's right, Nara {NICKNAME}, and the Floaty, White Floaty.",
            "nextDialogs": [
              "730660302"
            ]
          },
          "730660302": {
            "id": "730660302",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Hello, Aranaga, I am! Been waiting here for a long time, I have!",
            "nextDialogs": [
              "730660303"
            ]
          },
          "730660303": {
            "id": "730660303",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "We've also been looking for you for a long time, little bean!",
            "nextDialogs": [
              "730660304"
            ]
          },
          "730660304": {
            "id": "730660304",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Aranaga, I am. Little bean, I am not. Soft-Fluffy White-Mushroom Floaty.",
            "nextDialogs": [
              "730660305"
            ]
          },
          "730660305": {
            "id": "730660305",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Soft and fluffy... white mushroom? What? Are you talking about Paimon?",
            "nextDialogs": [
              "730660307",
              "730660309"
            ]
          },
          "730660307": {
            "id": "730660307",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "No, it does not!",
            "nextDialogs": [
              "730660311"
            ]
          },
          "730660311": {
            "id": "730660311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#I'm {NICKNAME}.",
            "nextDialogs": [
              "730660312"
            ]
          },
          "730660312": {
            "id": "730660312",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "And Paimon is Paimon, hello!",
            "nextDialogs": [
              "730660313"
            ]
          },
          "730660313": {
            "id": "730660313",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Um... Aramango, what can we do for you?",
            "nextDialogs": [
              "730660314"
            ]
          },
          "730660314": {
            "id": "730660314",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "#It's Aranaga. My friends, Nara {NICKNAME} must have met. They are the ones who led you here, correct?",
            "nextDialogs": [
              "730660315"
            ]
          },
          "730660315": {
            "id": "730660315",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yes, we met your two little friends! They said we could meet you here.",
            "nextDialogs": [
              "730660316"
            ]
          },
          "730660316": {
            "id": "730660316",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Welcome to the Mawtiyima Forest, my garden, this is. Many flora friends, mushroom friends here. Here, they love.",
            "nextDialogs": [
              "730660317"
            ]
          },
          "730660317": {
            "id": "730660317",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Because is here, Mawtiyima. Protects us, protects the forest, Mawtiyima. So can gather with friends, help friends thrive, Aranaga.",
            "nextDialogs": [
              "730660318"
            ]
          },
          "730660318": {
            "id": "730660318",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "#But need help, we. Can give help, Nara {NICKNAME}.",
            "nextDialogs": [
              "730660319"
            ]
          },
          "730660319": {
            "id": "730660319",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So... What do you want us to help with?"
          },
          "730660309": {
            "id": "730660309",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "It's weird to hear you say that!",
            "nextDialogs": [
              "730660310"
            ]
          },
          "730660310": {
            "id": "730660310",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "It's not little bean, it's Aranaga. Golden melon Nara is doofus Nara, likes to be bad."
          }
        }
      }
    },

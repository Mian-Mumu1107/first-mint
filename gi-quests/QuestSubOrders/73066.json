            ]
          },
          "730664302": {
            "id": "730664302",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Alright, but it won't wait for us, the rising and setting of the moon. So hurry there and back, please do. But... No need to rush. Here, we will wait for you."
          }
        }

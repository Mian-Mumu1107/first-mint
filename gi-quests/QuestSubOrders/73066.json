    {
      "subId": "7306605",
      "subQuestName": "Talk to Aranaga",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730660501"
        ],
        "dialogs": {
          "730660501": {
            "id": "730660501",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Here it is! The Yajna Grass! It's protected, the Yajna Grass!",
            "nextDialogs": [
              "730660502"
            ]
          },
          "730660502": {
            "id": "730660502",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Unseal it, and then we can talk to the Yajna Grass!"
          }
        }
      }

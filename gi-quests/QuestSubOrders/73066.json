    {
      "subId": "7306642",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730664201"
        ],
        "dialogs": {
          "730664201": {
            "id": "730664201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I am ready.",
            "nextDialogs": [
              "730664202"
            ]
          },
          "730664202": {
            "id": "730664202",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon too!",
            "nextDialogs": [
              "730664203"
            ]
          },
          "730664203": {
            "id": "730664203",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "So... Aranakin, Aragaru, let's start the ritual.",
            "nextDialogs": [
              "730664204"
            ]
          },
          "730664204": {
            "id": "730664204",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "\"Come, come, dreams of the garden, memories of the forest...\"\\n\"Come, come, wind that doesn't return, water that doesn't flow backwards...\"\\n\"Come, come, sweet dreams and bitter aftertastes.\"",
            "nextDialogs": [
              "730664205"
            ]
          },
          "730664205": {
            "id": "730664205",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "\"Farewell, let us say:\"\\n\"Old leaves, swollen fruit...\"\\n\"Drifted dreams, fallen flowers.\"",
            "nextDialogs": [
              "730664206"
            ]
          },
          "730664206": {
            "id": "730664206",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "\"Wait, let us.\"\\n\"Season of rain returns, plants rejoice...\"\\n\"The pomegranate sings, the apples clap.\""
          }
        }
      }
    },

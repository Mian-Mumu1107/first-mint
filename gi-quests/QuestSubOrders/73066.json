            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "You're here! Welcome!",
            "nextDialogs": [
              "730664402"
            ]
          },
          "730664402": {
            "id": "730664402",
            "speakerId": 1001,
            "speakerName": "Aranaga",

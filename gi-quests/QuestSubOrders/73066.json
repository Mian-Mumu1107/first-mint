    {
      "subId": "7306616",
      "subQuestName": "Talk to Aranaga",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730661601"
        ],
        "dialogs": {
          "730661601": {
            "id": "730661601",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "The Yajna Grass is right here!",
            "nextDialogs": [
              "730661602"
            ]
          },
          "730661602": {
            "id": "730661602",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Excuse me, please. Let me say a few words, with the Yajna Grass.",
            "nextDialogs": [
              "730661603"
            ]
          },
          "730661603": {
            "id": "730661603",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Though it's the garden of Aranaga, there is only one Yajna Grass here...",
            "nextDialogs": [
              "730661604"
            ]
          },
          "730661604": {
            "id": "730661604",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "There were many, once. Whenever the moon rose or fell, a Yajna Grass would grow...",
            "nextDialogs": [
              "730661605"
            ]
          },
          "730661605": {
            "id": "730661605",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "But it came, Marana. In the wake of Marana, walking Shroom-Kin came. They ate and ate. Died, many Yajna Grass, leaving just this one.",
            "nextDialogs": [
              "730661606"
            ]
          },
          "730661606": {
            "id": "730661606",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Then what are you guys gonna do after we use the Yammering Grass to make Arahaoma?",
            "nextDialogs": [
              "730661607"
            ]
          },
          "730661607": {
            "id": "730661607",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "It's the Yajna Grass, White Mushroom silly. But no need to worry. The important seeds are kept safe by Jamikayomars. The gate of Mawtiyima, Jamikayomars is guarding.",
            "nextDialogs": [
              "730661608"
            ]
          },
          "730661608": {
            "id": "730661608",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon sees...",
            "nextDialogs": [
              "730661611"
            ]
          },
          "730661611": {
            "id": "730661611",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Aranaga whispers to the plant for a while...",
            "nextDialogs": [
              "730661612"
            ]
          },
          "730661612": {
            "id": "730661612",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Willing to become Arahaoma, he said.",
            "nextDialogs": [
              "730661613"
            ]
          },
          "730661613": {
            "id": "730661613",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "And... Thank you.",
            "nextDialogs": [
              "730661614"
            ]
          },
          "730661614": {
            "id": "730661614",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Next, let's go to Jamikayomars, together.",
            "nextDialogs": [
              "730661615"
            ]
          },
          "730661615": {
            "id": "730661615",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Then lead the way, little bean!",
            "nextDialogs": [
              "730661616"
            ]
          },
          "730661616": {
            "id": "730661616",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Little bean, not! Aranaga! Floaty is mean!",
            "nextDialogs": [
              "730661617"
            ]
          },
          "730661617": {
            "id": "730661617",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Okay, okay, Paimon is not mean!"
          }
        }
      }
    },
    {
      "subId": "7306617",
      "subQuestName": "Return to Aranaga's little garden",
      "sceneId": null,

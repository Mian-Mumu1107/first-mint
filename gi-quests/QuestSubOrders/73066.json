          },
          "730663802": {
            "id": "730663802",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Please offer Arahaoma, over here.",
            "nextDialogs": [
              "730663803"
            ]
          },
          "730663803": {
            "id": "730663803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Offer Arahaoma)",
            "nextDialogs": [
              "730663804"
            ]
          },
          "730663804": {
            "id": "730663804",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Look! Has accepted you, Jamikayomars."
          }
        }
      }
    },
    {

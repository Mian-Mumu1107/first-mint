    {
      "subId": "7306636",
      "subQuestName": "Talk to the Aranara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730663601"
        ],
        "dialogs": {
          "730663601": {
            "id": "730663601",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wow... Look, the potion is ready...",
            "nextDialogs": [
              "730663604"
            ]
          },
          "730663604": {
            "id": "730663604",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh...!",
            "nextDialogs": [
              "730663605"
            ]
          },
          "730663605": {
            "id": "730663605",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Finished, we are! Is here, Arahaoma!",
            "nextDialogs": [
              "730663606"
            ]
          },
          "730663606": {
            "id": "730663606",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Please take good care of her. Next, we will go offer the potion to Jamikayomars.",
            "nextDialogs": [
              "730663607"
            ]
          },
          "730663607": {
            "id": "730663607",
            "speakerId": 1004,
            "speakerName": "Aranakin",
            "text": "Please take good care of her! Save our dream garden together, Mawtiyima's dream.",
            "nextDialogs": [
              "730663608"
            ]
          },
          "730663608": {
            "id": "730663608",
            "speakerId": 1005,
            "speakerName": "Aragaru",
            "text": "Yep! Aragaru wants to say the same!"
          }
        }
      }
    },

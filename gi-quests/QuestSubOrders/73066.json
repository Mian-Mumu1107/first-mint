    {
      "subId": "7306641",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730664101"
        ],
        "dialogs": {
          "730664101": {
            "id": "730664101",
            "speakerId": 1004,
            "speakerName": "Aranakin",
            "text": "#Aranaga, {M#he}{F#she}'s here, they're here!",
            "nextDialogs": [
              "730664102"
            ]
          },
          "730664102": {
            "id": "730664102",
            "speakerId": 1005,
            "speakerName": "Aragaru",
            "text": "Yea, here, here!",
            "nextDialogs": [
              "730664103"
            ]
          },
          "730664103": {
            "id": "730664103",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "#Here you are, Nara {NICKNAME}, White Floaty. Welcome you, the three of us.",
            "nextDialogs": [
              "730664104"
            ]
          },
          "730664104": {
            "id": "730664104",
            "speakerId": 1004,
            "speakerName": "Aranakin",
            "text": "Welcome!",
            "nextDialogs": [
              "730664105"
            ]
          },
          "730664105": {
            "id": "730664105",
            "speakerId": 1005,
            "speakerName": "Aragaru",
            "text": "The Arahaoma ritual is about to begin. What are we waiting for?",
            "nextDialogs": [
              "730664106"
            ]
          },
          "730664106": {
            "id": "730664106",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yeah, aren't you guys really anxious to hold the... that ritual?",
            "nextDialogs": [
              "730664107"
            ]
          },
          "730664107": {
            "id": "730664107",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Still wait for a little bit, we can. Grateful, we are. So... as is customary for Nara, precious gifts, we will give you.",
            "nextDialogs": [
              "730664108"
            ]
          },
          "730664108": {
            "id": "730664108",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Uh... gifts? Precious gifts?",
            "nextDialogs": [
              "730664109"
            ]
          },
          "730664109": {
            "id": "730664109",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Yes, indeed. Gifts! Precious gifts!",
            "nextDialogs": [
              "730664110"
            ]
          },
          "730664110": {
            "id": "730664110",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Oh...!",
            "nextDialogs": [
              "730664113"
            ]
          },
          "730664113": {
            "id": "730664113",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Our gifts are the most precious. They have life. Compared to dead things, living things, are more worth protecting.",
            "nextDialogs": [
              "730664114"
            ]
          },
          "730664114": {
            "id": "730664114",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "See, Aranaga said it — the most precious gifts!",
            "nextDialogs": [
              "730664115"
            ]
          },
          "730664115": {
            "id": "730664115",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "#Helped us, saved the forest, Nara {NICKNAME}. We are grateful, so... I give you, this.",
            "nextDialogs": [
              "730664116"
            ]
          },
          "730664116": {
            "id": "730664116",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Eh... What is this...?",
            "nextDialogs": [
              "730664117"
            ]
          },
          "730664117": {
            "id": "730664117",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "It's a living memory, a \"remembrance,\" Nara calls it. Creatures that forget easily, Nara are. So must remember, use things that have life.",
            "nextDialogs": [
              "730664118"
            ]
          },
          "730664118": {
            "id": "730664118",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Here, Aranaga's remembrance, is this flower. Cannot blow him away, the Ad Oblivione; cannot destroy him, the device that takes away dreams."
          }
        }
      }
    },
    {
      "subId": "7306631",
      "subQuestName": "Talk to the Aranara",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730663101"
        ],
        "dialogs": {
          "730663101": {
            "id": "730663101",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Thank you, Nara... Golden Nara. For all that you've done, thank you.",
            "nextDialogs": [
              "730663102"
            ]
          },
          "730663102": {
            "id": "730663102",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Free of the burden of Marana, Mawtiyima is. She is very happy, Mawtiyima.",
            "nextDialogs": [
              "730663103"
            ]
          },
          "730663103": {
            "id": "730663103",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hehe, we just happened to be passing by so we lent a hand! That Morty Arena should be thanking you guys!",
            "nextDialogs": [
              "730663104"
            ]
          },
          "730663104": {
            "id": "730663104",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Is that so...",
            "nextDialogs": [
              "730663105"
            ]
          },
          "730663105": {
            "id": "730663105",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Mm... That's right. What's wrong?",
            "nextDialogs": [
              "730663106"
            ]
          },
          "730663106": {
            "id": "730663106",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Nothing, nothing... It's just, before we came here, the things we experienced together now seems like a fog, like clouds. Can't see them clearly... Need to remember.",
            "nextDialogs": [
              "730663107"
            ]
          },
          "730663107": {
            "id": "730663107",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hmm... Is it because you're too tired?",
            "nextDialogs": [
              "730663110"
            ]
          },
          "730663110": {
            "id": "730663110",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yeah, that's right. Let's go out together and bask in the sun more, and our heads will be clear!",
            "nextDialogs": [
              "730663111"
            ]
          },
          "730663111": {
            "id": "730663111",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Thanks, but... still needs our company, Mawtiyima.",
            "nextDialogs": [
              "730663112"
            ]
          },
          "730663112": {
            "id": "730663112",
            "speakerId": 1004,
            "speakerName": "Aranakin",
            "text": "Mm, because Mawtiyima just woke up and got a lot of stories to tell us!",
            "nextDialogs": [
              "730663113"
            ]
          },
          "730663113": {
            "id": "730663113",
            "speakerId": 1005,
            "speakerName": "Aragaru",
            "text": "Mawtiyima wants to share her dreams with us, so we can't leave yet...",
            "nextDialogs": [
              "730663114"
            ]
          },
          "730663114": {
            "id": "730663114",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon sees... We've just finished the important business, and Paimon hasn't got the chance to get to know you better...",
            "nextDialogs": [
              "730663115"
            ]
          },
          "730663115": {
            "id": "730663115",
            "speakerId": 1005,
            "speakerName": "Aragaru",
            "text": "It's okay, we will still be friends as long as we remember you.",
            "nextDialogs": [
              "730663116"
            ]
          },
          "730663116": {
            "id": "730663116",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "As long as... still remember you, we can.",
            "nextDialogs": [
              "730663117"
            ]
          },
          "730663117": {
            "id": "730663117",
            "speakerId": 1004,
            "speakerName": "Aranakin",
            "text": "Yeah! As long as we remember!",
            "nextDialogs": [
              "730663118"
            ]
          },
          "730663118": {
            "id": "730663118",
            "speakerId": 1004,
            "speakerName": "Aranakin",
            "text": "Here is a song so you don't forget me. Please remember this...",
            "nextDialogs": [
              "730663119"
            ]
          },
          "730663119": {
            "id": "730663119",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Okay... We got it!",
            "nextDialogs": [
              "730663120"
            ]
          },
          "730663120": {
            "id": "730663120",
            "speakerId": 1004,
            "speakerName": "Aranakin",
            "text": "Then... If I forget you guys, I will remember when I hear this song.",
            "nextDialogs": [
              "730663121"
            ]
          },
          "730663121": {
            "id": "730663121",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Eh...?",
            "nextDialogs": [
              "730663122"
            ]
          },
          "730663122": {
            "id": "730663122",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "Because... new life, memory nourishes. Death is just a loss of memory.",
            "nextDialogs": [
              "730663123"
            ]
          },
          "730663123": {
            "id": "730663123",
            "speakerId": 1001,
            "speakerName": "Aranaga",
            "text": "So... our sacrifice, please witness, please keep it in your memories and dreams."
          }
        }
      }
    },

    {
      "subId": "7306643",
      "subQuestName": "Go and clear the last Withering Zone",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730664301"
        ],
        "dialogs": {
          "730664301": {
            "id": "730664301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I have other things to do.",
            "nextDialogs": [

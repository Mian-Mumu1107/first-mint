  "subQuests": [
    {
      "subId": "2005901",
      "subQuestName": "Talk to Marjorie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200590101"
        ],
        "dialogs": {
          "200590101": {
            "id": "200590101",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "This is bad... Very bad...",
            "nextDialogs": [
              "200590102"
            ]
          },
          "200590102": {
            "id": "200590102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "200590103"
            ]
          },
          "200590103": {
            "id": "200590103",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Traveler! Just the person I needed to see. Did you know this is my souvenir shop?",
            "nextDialogs": [
              "200590104"
            ]
          },
          "200590104": {
            "id": "200590104",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "My dad used to wait till the adventurers came back and buy their spoils of war from them to sell in the shop.",
            "nextDialogs": [
              "200590105"
            ]
          },
          "200590105": {
            "id": "200590105",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "But since things started dying down at the Adventurers' Guild, my opportunities to stock up have been few and far between.",
            "nextDialogs": [
              "200590106"
            ]
          },
          "200590106": {
            "id": "200590106",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Not only that, but recently the items we get in are hardly worth anything. Nobody wants to buy them.",
            "nextDialogs": [
              "200590107"
            ]
          },
          "200590107": {
            "id": "200590107",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Traveler, your adventures take you all over the place, don't they? Could I trouble you to bring me back some treasures that I can sell next time?",
            "nextDialogs": [
              "200590109",
              "200590111"
            ]
          },
          "200590109": {
            "id": "200590109",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Thank you! Whatever you bring me, I will make sure to get a good price for."
          },
          "200590111": {
            "id": "200590111",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "I'm sorry, but nobody wants to buy that.",
            "nextDialogs": [
              "200590112"
            ]
          },
          "200590112": {
            "id": "200590112",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "My customers tend to prefer objects of the more inanimate variety."
          }
        }
      }
    },
    {
      "subId": "2005902",
      "subQuestName": "Talk to Marjorie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200590201"
        ],
        "dialogs": {
          "200590201": {
            "id": "200590201",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Everything clear? Off you go then, I'll be waiting."
          }
        }
      }
    },

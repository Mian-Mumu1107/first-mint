    {
      "subId": "2005909",
      "subQuestName": "Collect rewards from Marjorie",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "20059020",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005902001"
        ],
        "dialogs": {
          "2005902001": {
            "id": "2005902001",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Hmm, I haven't given you the slightest idea of what sells well, have I? I bet you don't know what to look for.",
            "nextDialogs": [
              "2005902002"
            ]
          },
          "2005902002": {
            "id": "2005902002",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Why don't you get me some <color=#00E1FFFF>loot from the hilichurls</color>.",
            "nextDialogs": [
              "2005902003"
            ]
          },
          "2005902003": {
            "id": "2005902003",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "I have a feeling that adventurers looking to prove their worth would be interested in that sort of thing."
          }
        }
      }
    },
    {
      "subId": "20059040",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005904001"
        ],
        "dialogs": {
          "2005904001": {
            "id": "2005904001",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Don't forget, you're looking for some <color=#00E1FFFF>loot from the hilichurls</color>.",
            "nextDialogs": [
              "2005904002"
            ]
          },
          "2005904002": {
            "id": "2005904002",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Hehehe, I'm going to make me a nice stack of Mora off this..."
          }
        }
      }
    },
    {
      "subId": "20059060",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005906001"
        ],
        "dialogs": {
          "2005906001": {
            "id": "2005906001",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "This will make a handsome sum.",
            "nextDialogs": [
              "2005906002"
            ]
          },
          "2005906002": {
            "id": "2005906002",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Wait till I've sold this and I'll be sure to compensate you fairly.",
            "nextDialogs": [
              "2005906003"
            ]
          },
          "2005906003": {
            "id": "2005906003",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Look at that! Someone's taking an interest..."
          }
        }
      }
    },
    {
      "subId": "20059100",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005910001"
        ],
        "dialogs": {
          "2005910001": {
            "id": "2005910001",
            "speakerId": 1001,
            "speakerName": "Jack",
            "text": "What's this?",
            "nextDialogs": [
              "2005910002"
            ]
          },
          "2005910002": {
            "id": "2005910002",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Welcome! You have fine taste my friend, you've zeroed in on the most valuable item we have in the store.",
            "nextDialogs": [
              "2005910003"
            ]
          },
          "2005910003": {
            "id": "2005910003",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "This is a battle trophy seized from the hand of a hilichurl chief not long ago, by none other than this traveler here!",
            "nextDialogs": [
              "2005910004"
            ]
          },
          "2005910004": {
            "id": "2005910004",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Who knows how long that frightful hilichurl hooligan has been menacing Mondstadt...",
            "nextDialogs": [
              "2005910005"
            ]
          },
          "2005910005": {
            "id": "2005910005",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "And don't think that just because this traveler is a seasoned warrior, it wasn't a fiercely fought battle!",
            "nextDialogs": [
              "2005910006"
            ]
          },
          "2005910006": {
            "id": "2005910006",
            "speakerId": 1001,
            "speakerName": "Jack",
            "text": "Really, wow... Sounds like this hilichurl was a nasty piece of work...",
            "nextDialogs": [
              "2005910007"
            ]
          },
          "2005910007": {
            "id": "2005910007",
            "speakerId": 1001,
            "speakerName": "Jack",
            "text": "...Maybe I should get this and show it to Cyrus. Or Stanley.",
            "nextDialogs": [
              "2005910008"
            ]
          },
          "2005910008": {
            "id": "2005910008",
            "speakerId": 1001,
            "speakerName": "Jack",
            "text": "Perhaps they'd see me differently then...",
            "nextDialogs": [
              "2005910009"
            ]
          },
          "2005910009": {
            "id": "2005910009",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Oh, most certainly! We know how to keep a secret in this store, don't you worry...",
            "nextDialogs": [
              "2005910010"
            ]
          },
          "2005910010": {
            "id": "2005910010",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "My advice would be to take it now, or someone else is sure to snatch it up before long.",
            "nextDialogs": [
              "2005910011"
            ]
          },
          "2005910011": {
            "id": "2005910011",
            "speakerId": 1001,
            "speakerName": "Jack",
            "text": "I need to think about it... Traveler — is it true what she says?"
          }
        }
      }
    },
    {
      "subId": "20059101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005910101"
        ],
        "dialogs": {
          "2005910101": {
            "id": "2005910101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Every last word.",
            "nextDialogs": [
              "2005910102"
            ]
          },
          "2005910102": {
            "id": "2005910102",
            "speakerId": 1001,
            "speakerName": "Jack",
            "text": "Well, I guess that decides it then. I'll take it!",
            "nextDialogs": [
              "2005910103"
            ]
          },
          "2005910103": {
            "id": "2005910103",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Excellent choice sir, if I do say so myself! Here, I've wrapped it up for you. Have a wonderful day!"
          }
        }
      }
    },
    {
      "subId": "20059102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005910201"
        ],
        "dialogs": {
          "2005910201": {
            "id": "2005910201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Actually it's just ordinary hilichurl garbage...",
            "nextDialogs": [
              "2005910202"
            ]
          },
          "2005910202": {
            "id": "2005910202",
            "speakerId": 1001,
            "speakerName": "Jack",
            "text": "Really? What would I want to buy that for?",
            "nextDialogs": [
              "2005910203"
            ]
          },
          "2005910203": {
            "id": "2005910203",
            "speakerId": 1001,
            "speakerName": "Jack",
            "text": "Whew... I almost handed over the cash too! In future, spare me the hard sell and just give me the facts!",
            "nextDialogs": [
              "2005910204"
            ]
          },
          "2005910204": {
            "id": "2005910204",
            "speakerId": 1001,
            "speakerName": "Jack",
            "text": "I'm going to look elsewhere."
          }
        }
      }
    },
    {
      "subId": "20059103",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005910301"
        ],
        "dialogs": {
          "2005910301": {
            "id": "2005910301",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "(Test) Really? You're going to take it?",
            "nextDialogs": [
              "2005910302"
            ]
          },
          "2005910302": {
            "id": "2005910302",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "(Test) We have a sale!"
          }
        }
      }
    },
    {
      "subId": "20059104",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005910401"
        ],
        "dialogs": {
          "2005910401": {
            "id": "2005910401",
            "speakerId": 1001,
            "speakerName": "Jack",
            "text": "I appreciate what you did back there, traveler.",
            "nextDialogs": [
              "2005910402"
            ]
          },
          "2005910402": {
            "id": "2005910402",
            "speakerId": 1001,
            "speakerName": "Jack",
            "text": "If it wasn't for you, I probably would have wasted a lot of money in that store.",
            "nextDialogs": [
              "2005910403"
            ]
          },
          "2005910403": {
            "id": "2005910403",
            "speakerId": 1001,
            "speakerName": "Jack",
            "text": "Take these. You deserve them."
          }
        }
      }
    },
    {
      "subId": "20059105",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005910501"
        ],
        "dialogs": {
          "2005910501": {
            "id": "2005910501",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Why didn't you play along!? You have to do a bit of legwork to sell basic rubbish like this...",
            "nextDialogs": [
              "2005910502"
            ]
          },
          "2005910502": {
            "id": "2005910502",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "How often do I get a customer in here... You're unbelievable! You realize that if you screw this up for me, we both lose out, right!?",
            "nextDialogs": [
              "2005910503"
            ]
          },
          "2005910503": {
            "id": "2005910503",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Ugh, forget it. Take these and get outta here, you're bad for business!"
          }
        }
      }
    },
    {
      "subId": "20059106",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005910601"
        ],
        "dialogs": {
          "2005910601": {
            "id": "2005910601",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Good job backing me up just now!",
            "nextDialogs": [
              "2005910602"
            ]
          },
          "2005910602": {
            "id": "2005910602",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "Now, here's what I owe you... plus a bit extra for the sterling performance.",
            "nextDialogs": [
              "2005910603"
            ]
          },
          "2005910603": {
            "id": "2005910603",
            "speakerId": 1000,
            "speakerName": "Marjorie",
            "text": "It's been a pleasure working with you. I look forward to doing this again!"
          }
        }
      }
    }
  ]
}
    {
      "subId": "101216",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10121601"
        ],
        "dialogs": {
          "10121601": {
            "id": "10121601",
            "speakerId": 2015,
            "speakerName": "Qiming",
            "text": "If you have the time, come and have your fortune told down by the harbor. I'll give you a special price."
          }
        }
      }
    },
    {
      "subId": "101218",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10121801"
        ],
        "dialogs": {
          "10121801": {
            "id": "10121801",
            "speakerId": 2083,
            "speakerName": "Ying'er",
            "text": "Well, aren't you going to try it out? Has the crafting bench broken?",
            "nextDialogs": [
              "10121802"
            ]
          },
          "10121802": {
            "id": "10121802",
            "speakerId": 2083,
            "speakerName": "Ying'er",
            "text": "Or would you prefer some... hands-on guidance for your first time...?"
          }
        }
      }
    },
    {
      "subId": "101219",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10121901"
        ],
        "dialogs": {
          "10121901": {
            "id": "10121901",
            "speakerId": 2083,
            "speakerName": "Ying'er",
            "text": "Have you fetched the water? ...No?",
            "nextDialogs": [
              "10121902"
            ]
          },
          "10121902": {
            "id": "10121902",
            "speakerId": 2083,
            "speakerName": "Ying'er",
            "text": "Have a look <color=#00E1FFFF>behind Wanmin Restaurant</color>. Chef Mao is a professional chef, he must keep a store of pure water."
          }
        }
      }
    }
  ]
}
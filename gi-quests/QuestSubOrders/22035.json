        "dialogs": {
          "220359901": {
            "id": "220359901",
            "speakerId": 10422,
            "speakerName": "Treasure Hoarder",
            "text": "It's you people again? Come on! I haven't even done anything yet!",
            "nextDialogs": [
              "220359902"
            ]
          },
          "220359902": {
            "id": "220359902",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "Sorry, we have orders to preemptively prevent criminal activities. Let's do this, Traveler.",
            "nextDialogs": [
              "220359903"
            ]
          },
          "220359903": {
            "id": "220359903",
            "speakerId": 10422,
            "speakerName": "Treasure Hoarder",
            "text": "What... what the? Wait, listen!"
          }
        }

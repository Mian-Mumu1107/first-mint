    {
      "subId": "2203508",
      "subQuestName": "Talk to Ryuuji",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220350204"
        ],
        "dialogs": {
          "220350204": {
            "id": "220350204",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "Yeah, we made quite a big ruckus this time too. Amano and Mr. Andou will assist us in letting that thief learn about this in town.",
            "nextDialogs": [
              "220350205"
            ]
          },
          "220350205": {
            "id": "220350205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How much longer will this take?",
            "nextDialogs": [
              "220350206"
            ]
          },
          "220350206": {
            "id": "220350206",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "Not long now. Once Sango is ready, we can close this case.",
            "nextDialogs": [
              "220350207"
            ]
          },
          "220350207": {
            "id": "220350207",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "Here is your payment, Traveler. Thank you for your help.",
            "nextDialogs": [
              "220350208"
            ]
          },
          "220350208": {
            "id": "220350208",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "This is the amount assigned by Sango herself, so I believe it should be commensurate. Please take them. We may yet have more work for you in the future."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2203501",
      "subQuestName": "Talk to Ryuuji",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220350101"
        ],
        "dialogs": {
          "220350101": {
            "id": "220350101",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "Traveler, we meet again. Thanks to your help last time, Sango is now sure of our culprit's identity.",
            "nextDialogs": [
              "220350102"
            ]
          },
          "220350102": {
            "id": "220350102",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "But if we want that culprit to go down for real, we still need some preparation.",
            "nextDialogs": [
              "220350103"
            ]
          },
          "220350103": {
            "id": "220350103",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "While she's dealing with other things. Let's continue the work that we started previously.",
            "nextDialogs": [
              "220350105",
              "220350108"
            ]
          },
          "220350105": {
            "id": "220350105",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "That's right. Though that culprit has nothing to do with those Treasure Hoarders...",
            "nextDialogs": [
              "220350106"
            ]
          },
          "220350106": {
            "id": "220350106",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "Those Treasure Hoarders are up to no good anyway, so we may as well have them \"help\" us.",
            "nextDialogs": [
              "220350112"
            ]
          },
          "220350112": {
            "id": "220350112",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "Sango has marked out their specific location. It's not far from the city.",
            "nextDialogs": [
              "220350113"
            ]
          },
          "220350113": {
            "id": "220350113",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "As for matters within the city... Sango has secretly instructed Amano and Mr. Andou to assist us in this operation.",
            "nextDialogs": [
              "220350114"
            ]
          },
          "220350114": {
            "id": "220350114",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "She has also promised that the credit for solving this case will all go to them, so they'll gladly work with us.",
            "nextDialogs": [
              "220350115"
            ]
          },
          "220350115": {
            "id": "220350115",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "Leave the thinking and planning to her. Let's just keep up our \"correspondence\" with those Treasure Hoarders.",
            "nextDialogs": [
              "220350116"
            ]
          },
          "220350116": {
            "id": "220350116",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "I have also marked the location on your map. Let's get going now."
          },
          "220350108": {
            "id": "220350108",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "That's right. We must make him continue to believe that our target is the Treasure Hoarders.",
            "nextDialogs": [
              "220350109"
            ]
          },
          "220350109": {
            "id": "220350109",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "This way, Sango will have more time to complete her plan.",
            "nextDialogs": [
              "220350110"
            ]
          },
          "220350110": {
            "id": "220350110",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "*chuckles*... Not that those Treasure Hoarders were up to any good anyway...",
            "nextDialogs": [
              "220350111"
            ]
          },
          "220350111": {
            "id": "220350111",
            "speakerId": 3042,
            "speakerName": "Ryuuji",
            "text": "So we may as well enlist their \"help.\""
          }
        }
      }
    },

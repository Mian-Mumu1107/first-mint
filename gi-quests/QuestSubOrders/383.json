              "3830403"
            ]
          },
          "3830403": {
            "id": "3830403",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "The lyre's Anemo power seems fully restored. We should be able to use it now.",
            "nextDialogs": [
              "3830404"
            ]
          },
          "3830404": {
            "id": "3830404",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "#It's all thanks to you, {NICKNAME}.",
            "nextDialogs": [
              "3830405"
            ]
          },
          "3830405": {
            "id": "3830405",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Now, where should we summon Stormterror?",
            "nextDialogs": [
              "3830406"
            ]
          },
          "3830406": {
            "id": "3830406",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "It must be away from the city, else there will be casualties should we fail.",
            "nextDialogs": [
              "3830407"
            ]
          },
          "3830407": {
            "id": "3830407",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Perhaps here at the winery...",
            "nextDialogs": [
              "3830408"
            ]
          },
          "3830408": {
            "id": "3830408",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "If the winery was destroyed, it's not something I couldn't eventually fix, but... I'd still rather not go through the hassle.",
            "nextDialogs": [
              "3830409"
            ]
          },
          "3830409": {
            "id": "3830409",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "...",
            "nextDialogs": [
              "3830410"
            ]
          },
          "3830410": {
            "id": "3830410",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "The wind that blows at sea or in high places should be able to carry a bard's words far away.",
            "nextDialogs": [
              "3830411"
            ]
          },
          "3830411": {
            "id": "3830411",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "It's never going to work if the air is too dry or suffocating.",
            "nextDialogs": [
              "3830412"
            ]
          },
          "3830412": {
            "id": "3830412",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon understands. Sea or high places, right?",
            "nextDialogs": [
              "3830413"
            ]
          },
          "3830413": {
            "id": "3830413",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Then the best location to play the lyre would be...",
            "nextDialogs": [
              "3830418",
              "3830417"
            ]
          },
          "3830418": {
            "id": "3830418",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "If you go east from Starfell Lake, there are mountains south of the beach.",
            "nextDialogs": [
              "3830419"
            ]
          },
          "3830419": {
            "id": "3830419",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "..Oh! You mean that beach you were snoring away on and Paimon had to wake you?",
            "nextDialogs": [
              "3830420"
            ]
          },
          "3830420": {
            "id": "3830420",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "If you head to where the cliff juts out — that place is known as <color=#00E1FFFF>Starsnatch Cliff</color>.",
            "nextDialogs": [
              "3830421"
            ]
          },
          "3830421": {
            "id": "3830421",
            "speakerId": 1003,
            "speakerName": "Diluc",
            "text": "What do you think, bard? Meets the requirements, no?",
            "nextDialogs": [
              "3830422"
            ]
          },
          "3830422": {
            "id": "3830422",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "Lemme think... Starsnatch Cliff...",
            "nextDialogs": [
              "3830423"
            ]
          },
          "3830423": {
            "id": "3830423",
            "speakerId": 1001,
            "speakerName": "Venti",
            "text": "...Alright, let's do it there.",
            "nextDialogs": [
              "3830424"
            ]
          },
          "3830424": {
            "id": "3830424",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Very well. Then let's meet at Starsnatch Cliff when we are ready.",
            "nextDialogs": [
              "3830425"
            ]
          },
          "3830425": {
            "id": "3830425",
            "speakerId": 1002,
            "speakerName": "Jean",
            "text": "Please don't be late.",
            "nextDialogs": [
              "3830426"

    {
      "subId": "7324415",
      "subQuestName": "Fix Benben",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732441504"
        ],
        "dialogs": {
          "732441504": {
            "id": "732441504",
            "speakerId": 20723,
            "speakerName": "Jeht",
            "text": "Huh, so this is what Energy Transformation Capacitors look like... But how are we supposed to use them?",
            "nextDialogs": [
              "732441505"
            ]
          },
          "732441505": {
            "id": "732441505",
            "speakerId": 20724,
            "speakerName": "Benben",
            "text": "Beep... Beep-beep...",
            "nextDialogs": [
              "732441506"
            ]
          },
          "732441506": {
            "id": "732441506",
            "speakerId": 20723,
            "speakerName": "Jeht",
            "text": "Benben?",
            "nextDialogs": [
              "732441507"
            ]
          },
          "732441507": {
            "id": "732441507",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Benben connects to the Energy Transformation Capacitors and quickly extracts energy from them.",
            "nextDialogs": [
              "732441508"
            ]
          },
          "732441508": {
            "id": "732441508",
            "speakerId": 20724,
            "speakerName": "Benben",
            "text": "Beep-beep! Beep-beep!",
            "nextDialogs": [
              "732441509"
            ]
          },
          "732441509": {
            "id": "732441509",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa! We resurrected Benben!",
            "nextDialogs": [
              "732441510"
            ]
          },
          "732441510": {
            "id": "732441510",
            "speakerId": 20723,
            "speakerName": "Jeht",
            "text": "Silly Paimon. Benben just woke up from a long nap, that's all!",
            "nextDialogs": [
              "732441511"
            ]
          },
          "732441511": {
            "id": "732441511",
            "speakerId": 20724,
            "speakerName": "Benben",
            "text": "Beep... Bee-eep...",
            "nextDialogs": [
              "732441512"
            ]
          },
          "732441512": {
            "id": "732441512",
            "speakerId": 20723,
            "speakerName": "Jeht",
            "text": "Hey, I wasn't worried! I knew you'd recover, no matter what!",
            "nextDialogs": [
              "732441513"
            ]
          },
          "732441513": {
            "id": "732441513",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph. \"I don't wanna put it in a risky situation ever again...\"",
            "nextDialogs": [
              "732441514"
            ]
          },
          "732441514": {
            "id": "732441514",
            "speakerId": 20723,
            "speakerName": "Jeht",
            "text": "Don't parrot me, Paimon!",
            "nextDialogs": [
              "732441515"
            ]
          },
          "732441515": {
            "id": "732441515",
            "speakerId": 20724,
            "speakerName": "Benben",
            "text": "Beep-beeep.",
            "nextDialogs": [
              "732441516"
            ]
          },
          "732441516": {
            "id": "732441516",
            "speakerId": 20723,
            "speakerName": "Jeht",
            "text": "#Oh, yeah! {NICKNAME}, Benben says thank you.",
            "nextDialogs": [
              "732441517"
            ]
          },
          "732441517": {
            "id": "732441517",
            "speakerId": 20723,
            "speakerName": "Jeht",
            "text": "Even though Benben was lying still without saying anything, it knows everything you've done.",
            "nextDialogs": [
              "732441518"
            ]
          },
          "732441518": {
            "id": "732441518",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No need to thank me, Benben.",
            "nextDialogs": [
              "732441519"
            ]
          },
          "732441519": {
            "id": "732441519",
            "speakerId": 20724,
            "speakerName": "Benben",
            "text": "Beep!",
            "nextDialogs": [
              "732441520"
            ]
          },
          "732441520": {
            "id": "732441520",
            "speakerId": 20723,
            "speakerName": "Jeht",
            "text": "Mm...",
            "nextDialogs": [
              "732441521"
            ]
          },
          "732441521": {
            "id": "732441521",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Is anything else the matter?",
            "nextDialogs": [
              "732441522"
            ]
          },
          "732441522": {
            "id": "732441522",
            "speakerId": 20723,
            "speakerName": "Jeht",
            "text": "Even though Benben has woken up, it still looks like it could use some rest...",
            "nextDialogs": [
              "732441523"
            ]
          },
          "732441523": {
            "id": "732441523",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right! Have a good rest, Benben!",
            "nextDialogs": [
              "732441524"
            ]
          },
          "732441524": {
            "id": "732441524",
            "speakerId": 20724,
            "speakerName": "Benben",
            "text": "Beep-beep..."
          }
        }
      }

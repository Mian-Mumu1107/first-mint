  "subQuests": [
    {
      "subId": "7324401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732440101"
        ],
        "dialogs": {
          "732440101": {
            "id": "732440101",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "How... how could I forget...",
            "nextDialogs": [
              "732440102"
            ]
          },
          "732440102": {
            "id": "732440102",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "I hope it's not too late. We should at least search around his tent...",
            "nextDialogs": [
              "732440103"
            ]
          },
          "732440103": {
            "id": "732440103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Jeht! ...What's going on? Are you going somewhere?",
            "nextDialogs": [
              "732440104"
            ]
          },
          "732440104": {
            "id": "732440104",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "#Paimon and {NICKNAME}... You came just in time. There's something I gotta do right now... I need to go to Aderfi's place.",
            "nextDialogs": [
              "732440105"
            ]
          },
          "732440105": {
            "id": "732440105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Aderfi?",
            "nextDialogs": [
              "732440106"
            ]
          },
          "732440106": {
            "id": "732440106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Isn't he that traitor who made shady deals with the Fatui? ...Oh, Paimon knows! You wanna go see if there's any valuable stuff he left behind!",
            "nextDialogs": [
              "732440107"
            ]
          },
          "732440107": {
            "id": "732440107",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "No, I'm not interested in his stuff at all.",
            "nextDialogs": [
              "732440108"
            ]
          },
          "732440108": {
            "id": "732440108",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "The tribe has its own rules on dealing with the belongings of traitors like Aderfi. Hmph... if it weren't for the rules, I would no doubt burn everything down the first chance I get.",
            "nextDialogs": [
              "732440109"
            ]
          },
          "732440109": {
            "id": "732440109",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "I'm going to his tent because...",
            "nextDialogs": [
              "732440110"
            ]
          },
          "732440110": {
            "id": "732440110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Because of Benben, right?",
            "nextDialogs": [
              "732440111"
            ]
          },
          "732440111": {
            "id": "732440111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ohh! Oh no, Benben's still over there at Aderfi's place!",
            "nextDialogs": [
              "732440112"
            ]
          },
          "732440112": {
            "id": "732440112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Jehhht... Why did you leave Benben with someone like him?",
            "nextDialogs": [
              "732440113"
            ]
          },
          "732440113": {
            "id": "732440113",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "I—I didn't know he was a traitor!",
            "nextDialogs": [
              "732440114"
            ]
          },
          "732440114": {
            "id": "732440114",
            "speakerId": 16694,
            "speakerName": "Jeht",
            "text": "Anyway, I need to check on Benben as soon as possible.",
            "nextDialogs": [
              "732440115"
            ]
          },
          "732440115": {
            "id": "732440115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, we should go with her!",
            "nextDialogs": [
              "732440118"
            ]
          },
          "732440118": {
            "id": "732440118",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah... Paimon hopes Benben's okay..."
          }
        }
      }
    },
    {
      "subId": "7324402",
      "subQuestName": "Look for clues in Aderfi's tent",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

    {
      "subId": "7051204",
      "subQuestName": "Investigate the camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705120401"
        ],
        "dialogs": {
          "705120401": {
            "id": "705120401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ha... This tent doesn't look like it belongs to Diluc. Maybe it's an adventurer camp?",
            "nextDialogs": [
              "705120402"
            ]
          },
          "705120402": {
            "id": "705120402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, there's a piece of paper and a notebook over there. Let's read them.",
            "nextDialogs": [
              "705120403"
            ]
          },
          "705120403": {
            "id": "705120403",
            "speakerId": 1002,
            "speakerName": "Someone's Notes",
            "text": "\"Dear Darknight Hero, we are seeing a repeat of the phenomenon we encountered many years ago.\"",
            "nextDialogs": [
              "705120404"
            ]
          },
          "705120404": {
            "id": "705120404",
            "speakerId": 1002,
            "speakerName": "Someone's Notes",
            "text": "\"Although you fully resolved the issue last time, the ley lines seem to have been stimulated in some way and are releasing the monsters they recorded once more.\"",
            "nextDialogs": [
              "705120405"
            ]
          },
          "705120405": {
            "id": "705120405",
            "speakerId": 1002,
            "speakerName": "Someone's Notes",
            "text": "\"I'm sure you'll want to deal with those that pose the biggest threat immediately.\"",
            "nextDialogs": [
              "705120406"
            ]
          },
          "705120406": {
            "id": "705120406",
            "speakerId": 1002,
            "speakerName": "Someone's Notes",
            "text": "\"So I'm notifying essential individuals, per the operating procedures.\"",
            "nextDialogs": [
              "705120407"
            ]
          },
          "705120407": {
            "id": "705120407",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... judging by the tone, it seems like this was written by someone Diluc knows well. Let's call him \"Diluc's friend\" for now.",
            "nextDialogs": [
              "705120408"
            ]
          },
          "705120408": {
            "id": "705120408",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "He saw something bad happen, wrote a note for Master Diluc, and then left.",
            "nextDialogs": [
              "705120409"
            ]
          },
          "705120409": {
            "id": "705120409",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh... Isn't that pretty irresponsible? What if someone else had seen it? Also, he left his notebook behind...",
            "nextDialogs": [
              "705120410"
            ]
          },
          "705120410": {
            "id": "705120410",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Mmm... Now that Paimon thinks about it... you know that strange ley line deposit on the beach?",
            "nextDialogs": [
              "705120411"
            ]
          },
          "705120411": {
            "id": "705120411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I bet that's the \"phenomenon\" he was talking about.",
            "nextDialogs": [
              "705120412"
            ]
          },
          "705120412": {
            "id": "705120412",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Other than that, everything seems fine here... not a monster in sight.",
            "nextDialogs": [
              "705120413"
            ]
          },
          "705120413": {
            "id": "705120413",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, do you wanna read Diluc's friend's notebook, too?",
            "nextDialogs": [
              "705120414"
            ]
          },
          "705120414": {
            "id": "705120414",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "If not, let's head over and take a closer look at the ley line deposit."
          }
        }
      }
    },
    {
      "subId": "7051205",
      "subQuestName": "Investigate the abnormal Ley Line deposit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705120501"
        ],
        "dialogs": {
          "705120501": {
            "id": "705120501",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa! Where did all these monsters come from!?",
            "nextDialogs": [
              "705120502"
            ]
          },
          "705120502": {
            "id": "705120502",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uh.. Wait a second... Is that Diluc?",
            "nextDialogs": [
              "705120503"
            ]
          },
          "705120503": {
            "id": "705120503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh... He looks kinda different than usual...",
            "nextDialogs": [
              "705120504"
            ]
          },
          "705120504": {
            "id": "705120504",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Look at him go! So focused and full of energy! So this is Captain Pyro when he's in top form, huh!",
            "nextDialogs": [
              "705120507"
            ]
          },
          "705120507": {
            "id": "705120507",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, you're right! Now that Paimon looks more closely, this Diluc does look younger than usual.",
            "nextDialogs": [
              "705120508"
            ]
          },
          "705120508": {
            "id": "705120508",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But what happened back then? Why was he fighting here?",
            "nextDialogs": [
              "705120509"
            ]
          },
          "705120509": {
            "id": "705120509",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm. Guess we can just ask him about it when we see him.",
            "nextDialogs": [
              "705120510"
            ]
          },
          "705120510": {
            "id": "705120510",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#What should we do now, {NICKNAME}?"
          }
        }
      }
    },
    {
      "subId": "7051206",
      "subQuestName": "Defeat the opponents",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7051207",
      "subQuestName": "Discuss the situation with Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705120701"
        ],
        "dialogs": {
          "705120701": {
            "id": "705120701",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The fight is over. Diluc wiped the floor with them... Guess some things haven't changed.",
            "nextDialogs": [
              "705120702"
            ]
          },
          "705120702": {
            "id": "705120702",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So is there any actual danger here? It looks like it's only these illusions from the past.",
            "nextDialogs": [
              "705120705"
            ]
          },
          "705120705": {
            "id": "705120705",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So, Diluc's already called it a day?",
            "nextDialogs": [
              "705120706"
            ]
          },
          "705120706": {
            "id": "705120706",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Will more monsters come out if we go up to that weird ley line deposit again? And what about young Diluc?",
            "nextDialogs": [
              "705120707"
            ]
          },
          "705120707": {
            "id": "705120707",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "If it's like the other ley line deposits we've seen, then it should've disappeared now that all the monsters are defeated."
          }
        }
      }
    },
    {
      "subId": "7051208",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705120801"
        ],
        "dialogs": {
          "705120801": {
            "id": "705120801",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Please send Master Diluc my regards when you find him.",
            "nextDialogs": [
              "705120802"
            ]
          },
          "705120802": {
            "id": "705120802",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Also, do be careful out there.",
            "nextDialogs": [
              "705120803"
            ]
          },
          "705120803": {
            "id": "705120803",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "As Master always says, \"Even when the odds of success are nine to one, you must never lower your guard.\""
          }
        }
      }
    },
    {
      "subId": "7051299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705129906"
        ],
        "dialogs": {
          "705129906": {
            "id": "705129906",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Is that a camp over there? Diluc is camping out in the wild!?",
            "nextDialogs": [
              "705129907"
            ]
          },
          "705129907": {
            "id": "705129907",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh... This is weird... Hmm... Maybe these enemies are really tough, and it's turned into a long, drawn-out battle?",
            "nextDialogs": [
              "705129908"
            ]
          },
          "705129908": {
            "id": "705129908",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's go check it out!"
          }
        }
      }
    }
  ]
}
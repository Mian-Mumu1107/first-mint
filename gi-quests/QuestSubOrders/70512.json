  "subQuests": [
    {
      "subId": "7051201",
      "subQuestName": "Go to Dawn Winery",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705120201"
        ],
        "dialogs": {
          "705120201": {
            "id": "705120201",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Good day to you both. It's been quite a long time. You're looking well, as ever.",
            "nextDialogs": [
              "705120202"
            ]
          },
          "705120202": {
            "id": "705120202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hi, Adelinde!",
            "nextDialogs": [
              "705120203"
            ]
          },
          "705120203": {
            "id": "705120203",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "To what do we owe the honor today? Important business to discuss with Master Diluc, I presume?",
            "nextDialogs": [
              "705120206"
            ]
          },
          "705120206": {
            "id": "705120206",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's right. Adelinde, since we've run into you, maybe we could just get you to help us with this one?",
            "nextDialogs": [
              "705120207"
            ]
          },
          "705120207": {
            "id": "705120207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We always miss the Winery's discount grape juice, so this time we decided to come here early...",
            "nextDialogs": [
              "705120208"
            ]
          },
          "705120208": {
            "id": "705120208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Can you reserve a bottle for us? We'll pay a deposit, just name the price!",
            "nextDialogs": [
              "705120209"
            ]
          },
          "705120209": {
            "id": "705120209",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Of course I can, and no deposit necessary!",
            "nextDialogs": [
              "705120210"
            ]
          },
          "705120210": {
            "id": "705120210",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "But I'm afraid you may be in for quite a wait. Dawn Winery's discount grape juice takes a long time to make.",
            "nextDialogs": [
              "705120211"
            ]
          },
          "705120211": {
            "id": "705120211",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Every summer, Master Diluc hand-picks two barrels of the finest grapes to turn into juice.",
            "nextDialogs": [
              "705120212"
            ]
          },
          "705120212": {
            "id": "705120212",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What? Why sell the good stuff at a low price? Shouldn't the best grapes be the most expensive?",
            "nextDialogs": [
              "705120213"
            ]
          },
          "705120213": {
            "id": "705120213",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Master has never explained his reasoning. If I had to guess...",
            "nextDialogs": [
              "705120214"
            ]
          },
          "705120214": {
            "id": "705120214",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "The discount could be a marketing technique. Special deals always attract customers.",
            "nextDialogs": [
              "705120215"
            ]
          },
          "705120215": {
            "id": "705120215",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "Perhaps Master hopes to increase the popularity of fruit juice, so that people have more options when it comes to drinking.",
            "nextDialogs": [
              "705120216"
            ]
          },
          "705120216": {
            "id": "705120216",
            "speakerId": 1000,
            "speakerName": "Adelinde",
            "text": "It makes an ideal alternative for the heaviest drinkers, because they won't get drunk and start causing mischief. At the same time, those who don't drink alcohol get the chance to try something new."
          }
        }
      }
    },
    {
      "subId": "7051203",

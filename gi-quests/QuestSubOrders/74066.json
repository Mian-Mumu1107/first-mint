            ]
          },
          "740660402": {
            "id": "740660402",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "(Whoa! Wait! Paimon is still flipping through the book...)",
            "nextDialogs": [
              "740660403"
            ]
          },
          "740660403": {
            "id": "740660403",
            "speakerId": 1001,
            "speakerName": "Monglane",
            "text": "Very good. Let's hurry up and begin then."
          }
        }
      }
    },
    {
      "subId": "7406605",

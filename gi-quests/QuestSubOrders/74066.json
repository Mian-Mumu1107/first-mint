          "740660501": {
            "id": "740660501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Please give me a moment to get ready.",
            "nextDialogs": [
              "740660502"
            ]
          },
          "740660502": {
            "id": "740660502",
            "speakerId": 1001,
            "speakerName": "Monglane",
            "text": "...Oh. I see. Please be quick about it.",
            "nextDialogs": [
              "740660503"
            ]
          },
          "740660503": {
            "id": "740660503",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "(Hey... Why is she being so impatient...?)"
          }
        }
      }
    },

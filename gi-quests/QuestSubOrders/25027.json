  "subQuests": [
    {
      "subId": "2502701",
      "subQuestName": "Talk to Milu Nui",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250270901"
        ],
        "dialogs": {
          "250270901": {
            "id": "250270901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You could try gathering some sound samples...",
            "nextDialogs": [
              "250270902"
            ]
          },
          "250270902": {
            "id": "250270902",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Sounds...? Oh, do you mean to say that we could sample the sounds of nature and use them directly in the songs?",
            "nextDialogs": [
              "250270903"
            ]
          },
          "250270903": {
            "id": "250270903",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Hmm... That does sound like a good idea. Yes, very good indeed! See, I knew you were a sharp shovel! Come on, let's get going!",
            "nextDialogs": [
              "250270904"
            ]
          },
          "250270904": {
            "id": "250270904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wait, you're not bringing anything with you?",
            "nextDialogs": [
              "250270905"
            ]
          },
          "250270905": {
            "id": "250270905",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Of course not. Or are you expecting me to drag a gramophone around out there?",
            "nextDialogs": [
              "250270906"
            ]
          },
          "250270906": {
            "id": "250270906",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Don't worry, we're just going to see what sorts of sounds we can use.",
            "nextDialogs": [
              "250270907"
            ]
          },
          "250270907": {
            "id": "250270907",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "A duck flapping its wings, for instance, or the splash made as a Koholasaurus hits the water, or the rumbling footsteps of a Tepetlisaurus walking...",
            "nextDialogs": [
              "250270908"
            ]
          },
          "250270908": {
            "id": "250270908",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Once we've selected out targets, I'll make the preparations to take those sound samples... but that's all for later.",
            "nextDialogs": [
              "250270909"
            ]
          },
          "250270909": {
            "id": "250270909",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "As for the here and now, let's head out — time's a-wasting!"
          }
        }
      }
    },
    {
      "subId": "2502704",
      "subQuestName": "Go gather materials with Milu Nui",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250270401"
        ],
        "dialogs": {
          "250270401": {
            "id": "250270401",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Look at those birds, listen to their cries! My, oh my, if those wouldn't make excellent material for my next work!",
            "nextDialogs": [
              "250270402"
            ]
          },
          "250270402": {
            "id": "250270402",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Still, things could get pretty one-note if we only recorded a few of them. If we could find a whole flock and record the sound of their collective calls...",
            "nextDialogs": [
              "250270403"
            ]
          },
          "250270403": {
            "id": "250270403",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Hang on, that's a Koholasaurus just up ahead. You hear how it scratches the stone with its claws?",
            "nextDialogs": [
              "250270404"
            ]
          },
          "250270404": {
            "id": "250270404",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Koholasaurs are the sensitive sort, so let's not get too close. I'll get some professionals from our tribe to gather what I need afterward — if anyone can pull this off, it'd be them.",
            "nextDialogs": [
              "250270405"
            ]
          },
          "250270405": {
            "id": "250270405",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Oh, ho... warriors testing themselves against one another. Good, good, the sounds of battle are lovely indeed...",
            "nextDialogs": [
              "250270406"
            ]
          },
          "250270406": {
            "id": "250270406",
            "speakerId": 14420,
            "speakerName": "Angry Tribal Warrior",
            "text": "Oi! What're you skulking about for? You here for a fight?",
            "nextDialogs": [
              "250270407"
            ]
          },
          "250270407": {
            "id": "250270407",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "We're just... gathering materials...",
            "nextDialogs": [
              "250270408"
            ]
          },
          "250270408": {
            "id": "250270408",
            "speakerId": 14420,
            "speakerName": "Angry Tribal Warrior",
            "text": "Gathering? Well, I'll show you \"gathering\"!",
            "nextDialogs": [
              "250270409"
            ]
          },
          "250270409": {
            "id": "250270409",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "#H—Help! {NICKNAME}, stop him!"
          }
        }
      }
    },
    {
      "subId": "2502708",
      "subQuestName": "\"Advise\" the angry tribespeople to leave",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2502709",
      "subQuestName": "Talk to Milu Nui",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250271301"
        ],
        "dialogs": {
          "250271301": {
            "id": "250271301",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "#Phew! You're quite the dab hand yourself, aren't you, {NICKNAME}?",
            "nextDialogs": [
              "250271302"
            ]
          },
          "250271302": {
            "id": "250271302",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "You seem good at persuading the more agitated types...",
            "nextDialogs": [
              "250271304",
              "250271306"
            ]
          },
          "250271304": {
            "id": "250271304",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "I could tell. In every possible aspect... it is quite obvious.",
            "nextDialogs": [
              "250271307"
            ]
          },
          "250271307": {
            "id": "250271307",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Well, that was quite the adventure, but either way, I've selected plenty of sounds to sample.",
            "nextDialogs": [
              "250271308"
            ]
          },
          "250271308": {
            "id": "250271308",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "After just a bit of prep work, I'll be able to officially start recording the audio...",
            "nextDialogs": [
              "250271309"
            ]
          },
          "250271309": {
            "id": "250271309",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Hmm... We should start with the \"sounds of battle\"...",
            "nextDialogs": [
              "250271310"
            ]
          },
          "250271310": {
            "id": "250271310",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Wait, no. That's not a good place to begin. We should open up with something more normal..."
          },
          "250271306": {
            "id": "250271306",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "That's very modest of you. Thank you, in any case."
          }
        }
      }
    },
    {
      "subId": "2502703",
      "subQuestName": "Seek customer feedback in the shop",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250270301"
        ],
        "dialogs": {
          "250270301": {
            "id": "250270301",
            "speakerId": 6060,
            "speakerName": "Haloa Nui",
            "text": "Ooh, a new record! The baby Saurian's gonna love this!",
            "nextDialogs": [
              "250270302"
            ]
          },
          "250270302": {
            "id": "250270302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell me about Milu Nui's music...",
            "nextDialogs": [
              "250270303"
            ]
          },
          "250270303": {
            "id": "250270303",
            "speakerId": 6060,
            "speakerName": "Haloa Nui",
            "text": "I love Uncle Milu's songs — and really, the baby Saurian we have back home loves them more than I do!",
            "nextDialogs": [
              "250270304"
            ]
          },
          "250270304": {
            "id": "250270304",
            "speakerId": 6060,
            "speakerName": "Haloa Nui",
            "text": "Whenever it gets too rowdy, Mom plays one of his songs, and then it quiets down real quick.",
            "nextDialogs": [
              "250270305"
            ]
          },
          "250270305": {
            "id": "250270305",
            "speakerId": 6060,
            "speakerName": "Haloa Nui",
            "text": "Hmm... Those songs are super long, though. I can barely remember the lyrics, let alone sing 'em for it...",
            "nextDialogs": [
              "250270306"
            ]
          },
          "250270306": {
            "id": "250270306",
            "speakerId": 6060,
            "speakerName": "Haloa Nui",
            "text": "Hehe, if he could write some songs with fewer lyrics, I'd be able to sing them every day for that kid's listening pleasure!"
          }
        }
      }
    },
    {
      "subId": "2502702",
      "subQuestName": "Seek customer feedback in the shop",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250270201"
        ],
        "dialogs": {
          "250270201": {
            "id": "250270201",
            "speakerId": 6074,
            "speakerName": "Mahina Nui",
            "text": "Mr. Milu's released a new record! Should I buy it or not...",
            "nextDialogs": [
              "250270202"
            ]
          },
          "250270202": {
            "id": "250270202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell me about Milu Nui's music...",
            "nextDialogs": [
              "250270203"
            ]
          },
          "250270203": {
            "id": "250270203",
            "speakerId": 6074,
            "speakerName": "Mahina Nui",
            "text": "Hmm? Oh, he's great! Haloa and the baby Saurian love it.",
            "nextDialogs": [
              "250270204"
            ]
          },
          "250270204": {
            "id": "250270204",
            "speakerId": 6074,
            "speakerName": "Mahina Nui",
            "text": "Every time they get all rowdy and stubborn and don't wanna sleep, I'll play them Mr. Milu's \"Spring-Day Song.\"",
            "nextDialogs": [
              "250270205"
            ]
          },
          "250270205": {
            "id": "250270205",
            "speakerId": 6074,
            "speakerName": "Mahina Nui",
            "text": "As soon as they hear it, they're asleep in no time — voila, sweet dreams, see you tomorrow.",
            "nextDialogs": [
              "250270206"
            ]
          },
          "250270206": {
            "id": "250270206",
            "speakerId": 6074,
            "speakerName": "Mahina Nui",
            "text": "Still, though... Haloa has been saying that she'd prefer something a bit more intense.",
            "nextDialogs": [
              "250270207"
            ]
          },
          "250270207": {
            "id": "250270207",
            "speakerId": 6074,
            "speakerName": "Mahina Nui",
            "text": "If Mr. Milu could come up with a couple of tunes with a bit more energy, I'm sure she'd have more fun with 'em."
          }
        }
      }
    },
    {
      "subId": "2502706",
      "subQuestName": "Seek customer feedback in the shop",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250271401"
        ],
        "dialogs": {
          "250271401": {
            "id": "250271401",
            "speakerId": 6076,
            "speakerName": "Tirda",
            "text": "...Milu's style is the same as ever.",
            "nextDialogs": [
              "250271402"
            ]
          },
          "250271402": {
            "id": "250271402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tell me about Milu Nui's music...",
            "nextDialogs": [
              "250271403"
            ]
          },
          "250271403": {
            "id": "250271403",
            "speakerId": 6076,
            "speakerName": "Tirda",
            "text": "Hmm? Oh, I love his style of composition. I listen to his songs after work. Really helps me relax.",
            "nextDialogs": [
              "250271404"
            ]
          },
          "250271404": {
            "id": "250271404",
            "speakerId": 6076,
            "speakerName": "Tirda",
            "text": "But if you asked me personally, I'd call his lyrics... a bit, well, overly complex.",
            "nextDialogs": [
              "250271405"
            ]
          },
          "250271405": {
            "id": "250271405",
            "speakerId": 6076,
            "speakerName": "Tirda",
            "text": "*sigh* I wish he'd make a record without lyrics, y'know? Only instrumental tracks."
          }
        }
      }
    },
    {
      "subId": "2502705",
      "subQuestName": "Report back to Milu Nui",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250270501"
        ],
        "dialogs": {
          "250270501": {
            "id": "250270501",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "How did it go? Did they have any feedback?",
            "nextDialogs": [
              "250270502"
            ]
          },
          "250270502": {
            "id": "250270502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I've heard these opinions...",
            "nextDialogs": [
              "250270503"
            ]
          },
          "250270503": {
            "id": "250270503",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "You convey the customer feedback to Milu Nui...",
            "nextDialogs": [
              "250270504"
            ]
          },
          "250270504": {
            "id": "250270504",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "A—Ah. Is that how things are? Thank you, the feedback is quite valuable. Let me see what I can change...",
            "nextDialogs": [
              "250270505"
            ]
          },
          "250270505": {
            "id": "250270505",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Still, from the sound of it... aren't they all treating my records like kids' songs!?",
            "nextDialogs": [
              "250270506"
            ]
          },
          "250270506": {
            "id": "250270506",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "...No, no, all the more reason to make some changes... Still, where do I begin?"
          }
        }
      }
    },
    {
      "subId": "2502701",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250270101"
        ],
        "dialogs": {
          "250270101": {
            "id": "250270101",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Seriously, there's no getting through to Pakaa... He doesn't understand my musical ideals at all!",
            "nextDialogs": [
              "250270104"
            ]
          },
          "250270104": {
            "id": "250270104",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "Hmm? You're a... traveler? Greetings. Call me Milu Nui. I'm a musician.",
            "nextDialogs": [
              "250270105"
            ]
          },
          "250270105": {
            "id": "250270105",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "If you've been to Xochicuicatl Records, you'll have seen my records in the pop music section.",
            "nextDialogs": [
              "250270106"
            ]
          },
          "250270106": {
            "id": "250270106",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "They contain all that I understand of \"pop\" itself.",
            "nextDialogs": [
              "250270107"
            ]
          },
          "250270107": {
            "id": "250270107",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "It's just that Pakaa doesn't understand me at all, and insists that my music resembles \"kiddy music\" more than it does \"pop.\"",
            "nextDialogs": [
              "250270108"
            ]
          },
          "250270108": {
            "id": "250270108",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "And no matter what I say, he wants my records placed in the children's section!",
            "nextDialogs": [
              "250270109"
            ]
          },
          "250270109": {
            "id": "250270109",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "I mean, yes, children do like my songs, and some parents do buy them as gifts for their kids...",
            "nextDialogs": [
              "250270110"
            ]
          },
          "250270110": {
            "id": "250270110",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "But in truth, children are the keenest listeners! And there's a lot of them in the tribe anyhow...",
            "nextDialogs": [
              "250270111"
            ]
          },
          "250270111": {
            "id": "250270111",
            "speakerId": 6068,
            "speakerName": "Milu Nui",
            "text": "So if my records are so popular amongst the kids, I should have a spot in the pop section!"
          }
        }
      }
    },
    {
      "subId": "2502706",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250270601"
        ],
        "dialogs": {
          "250270601": {
            "id": "250270601",
            "speakerId": 6060,
            "speakerName": "Haloa Nui",
            "text": "Hehe, if he could write some songs with fewer lyrics, I'd be able to sing them every day for that kid's listening pleasure!"
          }
        }
      }
    },
    {
      "subId": "2502707",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250270701"
        ],
        "dialogs": {
          "250270701": {
            "id": "250270701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We should hear from customers first.",
            "nextDialogs": [
              "250270702"
            ]
          },
          "250270702": {
            "id": "250270702",
            "speakerId": 14322,
            "speakerName": "Milu Nui",
            "text": "Well, that... I don't disagree, and I've actually made some inquiries myself...",
            "nextDialogs": [
              "250270703"
            ]
          },
          "250270703": {
            "id": "250270703",
            "speakerId": 14322,
            "speakerName": "Milu Nui",
            "text": "But it feels like they just default to pleasantries when they see me, so I never get to hear their honest opinions.",
            "nextDialogs": [
              "250270704"
            ]
          },
          "250270704": {
            "id": "250270704",
            "speakerId": 14322,
            "speakerName": "Milu Nui",
            "text": "#{NICKNAME}, could you help me ask around instead?",
            "nextDialogs": [
              "250270705"
            ]
          },
          "250270705": {
            "id": "250270705",
            "speakerId": 14322,
            "speakerName": "Milu Nui",
            "text": "I imagine they'll... feel more comfortable being honest with you."
          }
        }
      }
    },
    {
      "subId": "2502710",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250271001"
        ],
        "dialogs": {
          "250271001": {
            "id": "250271001",
            "speakerId": 14322,
            "speakerName": "Milu Nui",
            "text": "Pop... What is pop, anyway? Goodness..."
          }
        }
      }
    },
    {
      "subId": "2502712",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250271201"
        ],
        "dialogs": {
          "250271201": {
            "id": "250271201",
            "speakerId": 6074,
            "speakerName": "Mahina Nui",
            "text": "If Mr. Milu could come up with a couple of tunes with a bit more energy, I'm sure she'd have more fun with 'em."
          }
        }
      }
    },
    {
      "subId": "2502715",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250271501"
        ],
        "dialogs": {
          "250271501": {
            "id": "250271501",
            "speakerId": 6076,
            "speakerName": "Tirda",
            "text": "*sigh* I wish he'd make a record without lyrics, y'know? Only instrumental tracks."
          }
        }
      }
    },
    {
      "subId": "2502716",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250271601"
        ],
        "dialogs": {
          "250271601": {
            "id": "250271601",
            "speakerId": 14322,
            "speakerName": "Milu Nui",
            "text": "Pop... *sigh* What is pop, anyway?",
            "nextDialogs": [
              "250271602"
            ]
          },
          "250271602": {
            "id": "250271602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And how are you going with your musical ideals?",
            "nextDialogs": [
              "250271603"
            ]
          },
          "250271603": {
            "id": "250271603",
            "speakerId": 14322,

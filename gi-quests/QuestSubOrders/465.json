    {
      "subId": "46504",
      "subQuestName": "Go to Dawn Winery",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4650401"
        ],
        "dialogs": {
          "4650401": {
            "id": "4650401",
            "speakerId": 1003,
            "speakerName": "Abyss Mage",
            "text": "How did you find me here!? Favonian scum!",
            "nextDialogs": [
              "4650402"
            ]
          },
          "4650402": {
            "id": "4650402",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "I am no Knight of Favonius. Now, start talking! Your plan, what is it?",
            "nextDialogs": [
              "4650403"
            ]
          },
          "4650403": {
            "id": "4650403",
            "speakerId": 1003,
            "speakerName": "Abyss Mage",
            "text": "I see you received our letter... But if you think I'm going to let you in on our secrets, I'm afraid you're quite mistaken!",
            "nextDialogs": [
              "4650404"
            ]
          },
          "4650404": {
            "id": "4650404",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "Hmph. You appear to have misunderstood the situation you are in.",
            "nextDialogs": [
              "4651001"
            ]
          },
          "4651001": {
            "id": "4651001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Burn him with <color=#00E1FFFF>Searing Hand</color>!",
            "nextDialogs": [
              "4651501"
            ]
          },
          "4651501": {
            "id": "4651501",
            "speakerId": 1003,
            "speakerName": "Abyss Mage",
            "text": "D—Did you just use a Pyro Vision to shoot f—fire from your hands!? ...Aah! It burns!",
            "nextDialogs": [
              "4650601"
            ]
          },
          "4650601": {
            "id": "4650601",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "Let's see how long it takes for you to crack...",
            "nextDialogs": [
              "4650405"
            ]
          },
          "4650405": {
            "id": "4650405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Burn him with <color=#00E1FFFF>Searing Hand</color> again!",
            "nextDialogs": [
              "4651502"
            ]
          },
          "4651502": {
            "id": "4651502",
            "speakerId": 1003,
            "speakerName": "Abyss Mage",
            "text": "Stop! Stop! P—Please, the pain— I beg you... make it stop!",
            "nextDialogs": [
              "4651402"
            ]
          },
          "4651402": {
            "id": "4651402",
            "speakerId": 1003,
            "speakerName": "Abyss Mage",
            "text": "Ugh...",
            "nextDialogs": [
              "4651403"
            ]
          },
          "4651403": {
            "id": "4651403",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "Playing dead won't help you — that fire was nowhere near strong enough to— Oh... He seems to have <color=#00E1FFFF>passed out</color>...",
            "nextDialogs": [
              "4651404"
            ]
          },
          "4651404": {
            "id": "4651404",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "Hey! You sleep when I say you can sleep!",
            "nextDialogs": [
              "4651405"
            ]
          },
          "4651405": {
            "id": "4651405",
            "speakerId": 1003,
            "speakerName": "Abyss Mage",
            "text": "Aah! It burns!",
            "nextDialogs": [
              "4650901"
            ]
          },
          "4650901": {
            "id": "4650901",
            "speakerId": 1003,
            "speakerName": "Abyss Mage",
            "text": "I'll talk, I'll talk! Ow ow ow... P—Please, stop! I'll tell you <color=#00E1FFFF>everything</color>!",
            "nextDialogs": [
              "4650902"
            ]
          },
          "4650902": {
            "id": "4650902",
            "speakerId": 1003,
            "speakerName": "Abyss Mage",
            "text": "Th—The Abyss Order, we've amassed a force bound by a shared hatred for the Darknight Hero...",
            "nextDialogs": [
              "4650903"
            ]
          },
          "4650903": {
            "id": "4650903",
            "speakerId": 1003,
            "speakerName": "Abyss Mage",
            "text": "They... They will march on the Mondstadt <color=#00E1FFFF>city gates</color> at 10 PM tomorrow night.",
            "nextDialogs": [
              "4650904"
            ]
          },
          "4650904": {
            "id": "4650904",
            "speakerId": 1003,
            "speakerName": "Abyss Mage",
            "text": "That's everything I know... Please... Don't make me suffer those flames again...",
            "nextDialogs": [
              "4650905"
            ]
          },
          "4650905": {
            "id": "4650905",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "That's it? Well, I doubt you'd be foolish enough to keep anything else hidden."
          }
        }
      }
    },

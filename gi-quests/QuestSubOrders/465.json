  "subQuests": [
    {
      "subId": "46501",
      "subQuestName": "Wait till daytime",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4650101"
        ],
        "dialogs": {
          "4650101": {
            "id": "4650101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huffman!",
            "nextDialogs": [
              "4650102"
            ]
          },
          "4650102": {
            "id": "4650102",
            "speakerId": 1001,
            "speakerName": "Huffman",
            "text": "Oh, it's you two. Thank you for coming.",
            "nextDialogs": [
              "4650103"
            ]
          },
          "4650103": {
            "id": "4650103",
            "speakerId": 1001,
            "speakerName": "Huffman",
            "text": "So — the Darknight Hero. Do you have anything else you're able to share with me?",
            "nextDialogs": [
              "4650105",
              "4650107"
            ]
          },
          "4650105": {
            "id": "4650105",
            "speakerId": 1001,
            "speakerName": "Huffman",
            "text": "Ah yes, of course I should fill you in first... apologies for my appalling lapse of etiquette.",
            "nextDialogs": [
              "4650108"
            ]
          },
          "4650108": {
            "id": "4650108",
            "speakerId": 1001,
            "speakerName": "Huffman",
            "text": "The situation is... here. Take a look at this.",
            "nextDialogs": [
              "4650109"
            ]
          },
          "4650109": {
            "id": "4650109",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Geez... what horrible handwriting!",
            "nextDialogs": [
              "4650110"
            ]
          },
          "4650110": {
            "id": "4650110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, let me take a closer look... Huh, some parts of this seem to be complete gibberish.",
            "nextDialogs": [
              "4650111"
            ]
          },
          "4650111": {
            "id": "4650111",
            "speakerId": 1001,
            "speakerName": "Huffman",
            "text": "Indeed. Although this is written in the common tongue, it appears that a cipher has been used in many places.",
            "nextDialogs": [
              "4650112"
            ]
          },
          "4650112": {
            "id": "4650112",
            "speakerId": 1001,
            "speakerName": "Huffman",
            "text": "Nevertheless, one can grasp the general message from the non-ciphered portions alone...",
            "nextDialogs": [
              "4650119"
            ]
          },
          "4650119": {
            "id": "4650119",
            "speakerId": 1001,
            "speakerName": "Huffman",
            "text": "This is a war declaration from the Abyss Order to the Darknight Hero.",
            "nextDialogs": [
              "4650113"
            ]
          },
          "4650113": {
            "id": "4650113",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Does that mean... the bad guys want the Darknight Hero to go away forever and ever?",
            "nextDialogs": [
              "4650114"
            ]
          },
          "4650114": {
            "id": "4650114",
            "speakerId": 1001,
            "speakerName": "Huffman",
            "text": "Something like that. Thus, we are hoping to contact him as soon as possible so that we can attempt to coordinate a response.",
            "nextDialogs": [
              "4650115"
            ]
          },
          "4650115": {
            "id": "4650115",
            "speakerId": 1001,
            "speakerName": "Huffman",
            "text": "After all, this matter no longer concerns merely the Darknight Hero himself. It impacts the entire city of Mondstadt."
          },
          "4650107": {
            "id": "4650107",
            "speakerId": 1001,
            "speakerName": "Huffman",
            "text": "Is that so... That is a pity indeed."
          }
        }
      }
    },
    {
      "subId": "46502",
      "subQuestName": "Go to the Knights of Favonius Headquarters",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4650201"
        ],
        "dialogs": {
          "4650201": {
            "id": "4650201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Master Diluc! Just now we were at the Knights of Favonius and, and—",
            "nextDialogs": [
              "4650202"
            ]
          },
          "4650202": {
            "id": "4650202",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "I take it you're about to inform me of the war declaration from the Abyss Order?",
            "nextDialogs": [
              "4650203"
            ]
          },
          "4650203": {
            "id": "4650203",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "I am aware of it. Though I appreciate you for taking the trouble to come all this way.",
            "nextDialogs": [
              "4650204"
            ]
          },
          "4650204": {
            "id": "4650204",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What?",
            "nextDialogs": [
              "4650205"
            ]
          },
          "4650205": {
            "id": "4650205",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "The Dawn Winery's intelligence network extends beyond commercial matters.",
            "nextDialogs": [
              "4650206"
            ]
          },
          "4650206": {
            "id": "4650206",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Great! So, what's the plan, Master Diluc?",
            "nextDialogs": [
              "4650207"
            ]
          },
          "4650207": {
            "id": "4650207",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "I'm open to suggestions...",
            "nextDialogs": [
              "4650209",
              "4650214"
            ]
          },
          "4650209": {
            "id": "4650209",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "No. That would be playing right into the hands of the Abyss Order.",
            "nextDialogs": [
              "4650210"
            ]
          },
          "4650210": {
            "id": "4650210",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "They know full well that we don't exactly see eye to eye. They're using this as a means to force me into making an appearance.",
            "nextDialogs": [
              "4650211"
            ]
          },
          "4650211": {
            "id": "4650211",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "If my identity were exposed, all my future activities would be subject to some degree of interference from the Knights.",
            "nextDialogs": [
              "4650212"
            ]
          },
          "4650212": {
            "id": "4650212",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "After all, no powerful organization wishes to be outdone by someone from the outside.",
            "nextDialogs": [
              "4650217"
            ]
          },
          "4650217": {
            "id": "4650217",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whew... the Abyss Order has really dealt you a tough hand this time. What a sneaky little bunch those guys are!",
            "nextDialogs": [
              "4650218"
            ]
          },
          "4650218": {
            "id": "4650218",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "There is a way. But for it to work, I need some more information.",
            "nextDialogs": [
              "4650219"
            ]
          },
          "4650219": {
            "id": "4650219",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "Specifically, I need to decipher the obscured portions of the Abyss Order's war declaration.",
            "nextDialogs": [
              "4650220"
            ]
          },
          "4650220": {
            "id": "4650220",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Obscured portions? You mean the bits Paimon can't read?",
            "nextDialogs": [
              "4650221"
            ]
          },
          "4650221": {
            "id": "4650221",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "It must be a cipher only understood by members of the Abyss Order, used to spread messages within the organization."
          },
          "4650214": {
            "id": "4650214",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "That would be tantamount to handing this over to the Knights.",
            "nextDialogs": [
              "4650215"
            ]
          },
          "4650215": {
            "id": "4650215",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "Had they been worthy of this task to begin with, things would never have escalated to this point.",
            "nextDialogs": [
              "4650216"
            ]
          },
          "4650216": {
            "id": "4650216",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "In any case, circumstances are not dire enough to warrant me going into hiding and leaving the Knights to deal with the consequences."
          }
        }
      }
    },

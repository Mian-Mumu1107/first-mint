        "dialogs": {
          "4650301": {
            "id": "4650301",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "This is the place.",
            "nextDialogs": [
              "4650302"
            ]
          },
          "4650302": {
            "id": "4650302",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "Abandoned ruins like these are precisely the kind of place the Abyss Order likes to camp out.",
            "nextDialogs": [
              "4650303"
            ]
          },
          "4650303": {
            "id": "4650303",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "Come on. There's no time to lose."
          }
        }

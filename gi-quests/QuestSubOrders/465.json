    {
      "subId": "46520",
      "subQuestName": "Defeat the Abyss Mage",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4652001"
        ],
        "dialogs": {
          "4652001": {
            "id": "4652001",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "Now that I have the information I need, I must prepare.",
            "nextDialogs": [
              "4652002"
            ]
          },
          "4652002": {
            "id": "4652002",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "I would be grateful if you could keep me updated on how the Knights of Favonius respond to this matter.",
            "nextDialogs": [
              "4652003"
            ]
          },
          "4652003": {
            "id": "4652003",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Yes, Master Diluc sir! Anything you say, Master Diluc sir!",
            "nextDialogs": [
              "4652004"
            ]
          },
          "4652004": {
            "id": "4652004",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "...Why are you acting so strange all of a sudden?",
            "nextDialogs": [
              "4652005"
            ]
          },
          "4652005": {
            "id": "4652005",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "In... in light of what just went down here a moment ago...",
            "nextDialogs": [
              "4652006"
            ]
          },
          "4652006": {
            "id": "4652006",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Master Diluc has officially reached No. 1 on Paimon's \"people not to tick off under any circumstances\" list...",
            "nextDialogs": [
              "4652007"
            ]
          },
          "4652007": {
            "id": "4652007",
            "speakerId": 1002,
            "speakerName": "Diluc",
            "text": "..."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7513301",
      "subQuestName": "Follow Coco's guidance to find the Altar of Primal Flame",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751330101"
        ],
        "dialogs": {
          "751330101": {
            "id": "751330101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon didn't expect Coco to lead us here. This strange fortress looks just like the place where we met you, Bona.",
            "nextDialogs": [
              "751330102"
            ]
          },
          "751330102": {
            "id": "751330102",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Look, it even has the same mural! Minus the smear marks, though. Is it because we're higher up?",
            "nextDialogs": [
              "751330103"
            ]
          },
          "751330103": {
            "id": "751330103",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Look, {NICKNAME}! This must be the Python King that Bona mentioned. He sure looks mean!",
            "nextDialogs": [
              "751330104"
            ]
          },
          "751330104": {
            "id": "751330104",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "Yes, that's the Python King Och-Kan. Legend has it that he abused and oppressed his people to get the Tonatiuh built, and eventually attracted the Abyss, which led to his death and the downfall of the kingdom.",
            "nextDialogs": [
              "751330105"
            ]
          },
          "751330105": {
            "id": "751330105",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "But that's just a legend. After all, the storytellers in my tribe have told different tales about what happened to him.",
            "nextDialogs": [
              "751330106"
            ]
          },
          "751330106": {
            "id": "751330106",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "Maybe he's still roaming the Tonatiuh and feasting on his treasure. Or maybe the evil dragon that's been trying to stop us is his ghost!",
            "nextDialogs": [
              "751330107"
            ]
          },
          "751330107": {
            "id": "751330107",
            "speakerId": 1002,
            "speakerName": "Cocouik",
            "text": "Kuchi...",
            "nextDialogs": [
              "751330108"
            ]
          },
          "751330108": {
            "id": "751330108",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Please stop with the stories! You're scaring Coco!",
            "nextDialogs": [
              "751330109"
            ]
          },
          "751330109": {
            "id": "751330109",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr! Rawr!",
            "nextDialogs": [
              "751330110"
            ]
          },
          "751330110": {
            "id": "751330110",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]} sure has been eager to do something since we defeated the dragon. Is he in some kind of secret contest with Coco?",
            "nextDialogs": [
              "751330111"
            ]
          },
          "751330111": {
            "id": "751330111",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Anyway, where's this Altar we're looking for?",
            "nextDialogs": [
              "751330112"
            ]
          },
          "751330112": {
            "id": "751330112",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "If Coco was right, it should be below us... Wait, I thought it'd be somewhere higher up.",
            "nextDialogs": [
              "751330113"
            ]
          },
          "751330113": {
            "id": "751330113",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "Did we mess up? The Altar of Primal Flame can't be inside the mountain, can it? How would we be transported into the sky then, unless the mountain itself collapses?",
            "nextDialogs": [
              "751330114"
            ]
          },
          "751330114": {
            "id": "751330114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There could be a special transportation mode at play...",
            "nextDialogs": [
              "751330115"
            ]
          },
          "751330115": {
            "id": "751330115",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, what now, then? You were so sure while we were down there. And we can't understand what Coco is trying to say, either.",
            "nextDialogs": [
              "751330116"
            ]
          },
          "751330116": {
            "id": "751330116",
            "speakerId": 1002,
            "speakerName": "Cocouik",
            "text": "Kulu...",
            "nextDialogs": [
              "751330117"
            ]
          },
          "751330117": {
            "id": "751330117",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr! Rawr!",
            "nextDialogs": [
              "751330118"
            ]
          },
          "751330118": {
            "id": "751330118",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Any ideas, {REALNAME[ID(2)|SHOWHOST(true)]}?",
            "nextDialogs": [
              "751330119"
            ]
          },
          "751330119": {
            "id": "751330119",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "I think I get it now. It's trying to tell us that following rigid logic won't get us anywhere!",
            "nextDialogs": [
              "751330120"
            ]
          },
          "751330120": {
            "id": "751330120",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Wait, you made that up, didn't you?",
            "nextDialogs": [
              "751330121"
            ]
          },
          "751330121": {
            "id": "751330121",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "Well, regardless of what's below us, I say we go check it out. I mean, we're on an adventure, aren't we?",
            "nextDialogs": [
              "751330122"
            ]
          },
          "751330122": {
            "id": "751330122",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751330123"
            ]
          },
          "751330123": {
            "id": "751330123",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Huh, you sure are excited, {REALNAME[ID(2)|SHOWHOST(true)]}. Well, time to figure out how to get down there."
          }
        }
      }
    },
    {
      "subId": "7513302",

    {
      "subId": "7513303",
      "subQuestName": "Investigate the area around the ruins",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751330301"
        ],
        "dialogs": {
          "751330301": {
            "id": "751330301",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#It's open! You're awesome, {REALNAME[ID(2)|SHOWHOST(true)]}! We wouldn't have found the mechanism without you!",
            "nextDialogs": [
              "751330302"
            ]
          },
          "751330302": {
            "id": "751330302",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751330303"
            ]
          },
          "751330303": {
            "id": "751330303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#I knew you could do it, {REALNAME[ID(2)|SHOWHOST(true)]}.",
            "nextDialogs": [
              "751330304"
            ]
          },
          "751330304": {
            "id": "751330304",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "But don't get ahead of yourself. Plenty of challenges await us!",
            "nextDialogs": [
              "751330305"
            ]
          },
          "751330305": {
            "id": "751330305",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Now that the entrance is open, there's no reason to give up halfway.",
            "nextDialogs": [
              "751330306"
            ]
          },
          "751330306": {
            "id": "751330306",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "I concur, Paimon.",
            "nextDialogs": [
              "751330307"
            ]
          },
          "751330307": {
            "id": "751330307",
            "speakerId": 1002,
            "speakerName": "Cocouik",
            "text": "Cheep... Cheep!",
            "nextDialogs": [
              "751330308"
            ]
          },
          "751330308": {
            "id": "751330308",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "What's wrong? Why don't you want to go in? Are you scared? We're halfway through our journey — there's no turning back now!",
            "nextDialogs": [
              "751330309"
            ]
          },
          "751330309": {
            "id": "751330309",
            "speakerId": 1002,
            "speakerName": "Cocouik",
            "text": "Ku...",
            "nextDialogs": [
              "751330310"
            ]
          },
          "751330310": {
            "id": "751330310",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "You shouldn't force the issue, Bona. It really does look super scared. Could there be something super dangerous down there?",
            "nextDialogs": [
              "751330311"
            ]
          },
          "751330311": {
            "id": "751330311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm scared too!",
            "nextDialogs": [
              "751330312"
            ]
          },
          "751330312": {
            "id": "751330312",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Now, really? C'mon, pull yourself together like {REALNAME[ID(2)|SHOWHOST(true)]}, why don't you?",
            "nextDialogs": [
              "751330313"
            ]
          },
          "751330313": {
            "id": "751330313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This is kind of exciting.",
            "nextDialogs": [
              "751330314"
            ]
          },
          "751330314": {
            "id": "751330314",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon didn't think you'd be so pumped up. But you can probably take on anyone we find down there, so...",
            "nextDialogs": [
              "751330315"
            ]
          },
          "751330315": {
            "id": "751330315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry, our little Saurian's a brave soul.",
            "nextDialogs": [
              "751330316"
            ]
          },
          "751330316": {
            "id": "751330316",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr... Rawr!",
            "nextDialogs": [
              "751330317"
            ]
          },
          "751330317": {
            "id": "751330317",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "If Coco really is afraid, maybe we should have it stay behind... But not alone. That wouldn't work...",
            "nextDialogs": [
              "751330318"
            ]
          },
          "751330318": {
            "id": "751330318",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "I guess there's no other way. I'll stay with Coco up here. You can have the Pyrophosphorite.",
            "nextDialogs": [
              "751330319"
            ]
          },
          "751330319": {
            "id": "751330319",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "But, whatever you find down there, you have to come back and find me, alright!",
            "nextDialogs": [
              "751330320"
            ]
          },
          "751330320": {
            "id": "751330320",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We don't leave anyone behind.",
            "nextDialogs": [
              "751330321"
            ]
          },
          "751330321": {
            "id": "751330321",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "I believe in you. We'll wait for you here.",
            "nextDialogs": [
              "751330322"
            ]
          },
          "751330322": {
            "id": "751330322",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry, just wait here until we come back.",
            "nextDialogs": [
              "751330323"
            ]
          },
          "751330323": {
            "id": "751330323",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!"
          }
        }
      }
    },
    {
      "subId": "7513305",
      "subQuestName": "Head to where Bona is",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751330401"
        ],
        "dialogs": {
          "751330401": {
            "id": "751330401",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Ugh, what's this? It looks gross...",
            "nextDialogs": [
              "751330402"
            ]
          },
          "751330402": {
            "id": "751330402",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "This is nascent Abyssal Blight. Looks like it's seeping down from above... Hmm, I thought a place festooned with frescoes would be safer.",
            "nextDialogs": [
              "751330403"
            ]
          },
          "751330403": {
            "id": "751330403",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rrah... Rawr!",
            "nextDialogs": [
              "751330404"
            ]
          },
          "751330404": {
            "id": "751330404",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "Huh? Uh-oh, I think something's gonna fall down. Watch out, everyone!"
          }
        }
      }
    },
    {
      "subId": "7513306",
      "subQuestName": "Defeat the ambushing monsters",
      "sceneId": null,

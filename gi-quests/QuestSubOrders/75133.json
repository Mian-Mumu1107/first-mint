    {
      "subId": "7513307",
      "subQuestName": "Talk to Bona",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751330501"
        ],
        "dialogs": {
          "751330501": {
            "id": "751330501",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "Wow, that was a shocker! Thank goodness for our quick reactions.",
            "nextDialogs": [
              "751330502"
            ]
          },
          "751330502": {
            "id": "751330502",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "So, did you find anything?",
            "nextDialogs": [
              "751330503"
            ]
          },
          "751330503": {
            "id": "751330503",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Well, we did find something that looks like a mechanism, but it's kind of a pain...",
            "nextDialogs": [
              "751330504"
            ]
          },
          "751330504": {
            "id": "751330504",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751330505"
            ]
          },
          "751330505": {
            "id": "751330505",
            "speakerId": 1001,
            "speakerName": "Bona",
            "text": "#Oh, I don't know what you mean, but {REALNAME[ID(2)|SHOWHOST(true)]} looks pretty clued in, so let's check it out anyway!"
          }
        }
      }
    },

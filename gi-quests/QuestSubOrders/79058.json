      "dialogue": {
        "startDialogs": [
          "790580101"
        ],
        "dialogs": {
          "790580101": {
            "id": "790580101",
            "speakerId": 21108,
            "speakerName": "Scene Notes",
            "text": "This is a cut scene from the show \"The Great Escape\"",
            "nextDialogs": [
              "790580102"
            ]
          },
          "790580102": {
            "id": "790580102",
            "speakerId": 21108,
            "speakerName": "Scene Notes",
            "text": "The original story was about a Hydro Eidolon trapped in a mysterious cave, who could only use the tools hidden within a tome to escape to freedom...",
            "nextDialogs": [
              "790580103"
            ]
          },
          "790580103": {
            "id": "790580103",
            "speakerId": 21108,
            "speakerName": "Scene Notes",
            "text": "But Idyia outright rejected the idea.",
            "nextDialogs": [
              "790580104"
            ]
          },
          "790580104": {
            "id": "790580104",
            "speakerId": 21108,
            "speakerName": "Scene Notes",
            "text": "But she had a point, Hydro Eidolons wouldn't need tools to escape a cave, they could just leave whenever they wanted. Also, hiding tools in a book was a bit contrived.",
            "nextDialogs": [
              "790580105"
            ]
          },
          "790580105": {
            "id": "790580105",
            "speakerId": 21108,
            "speakerName": "Scene Notes",
            "text": "But... this is definitely a blockbuster idea! If only Idyia could see just how brilliant it is...",
            "nextDialogs": [
              "790580106"
            ]
          },
          "790580106": {
            "id": "790580106",
            "speakerId": 21108,
            "speakerName": "Scene Notes",
            "text": "But, alas, first the <color=#00E1FFFF>tome containing the tools stolen by hilichurls</color> must be retrieved...",
            "nextDialogs": [
              "790580107"
            ]
          },
          "790580107": {
            "id": "790580107",
            "speakerId": 21108,
            "speakerName": "Scene Notes",
            "text": "— The Director"
          }
        }
      }
    }
  ]
}
          },
          "210340402": {
            "id": "210340402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You've already... defeated all the monsters in the area?",
            "nextDialogs": [
              "210340403"
            ]
          },
          "210340403": {
            "id": "210340403",
            "speakerId": 1000,
            "speakerName": "Lan",
            "text": "Hmm? Of course.",
            "nextDialogs": [
              "210340404"
            ]
          },
          "210340404": {
            "id": "210340404",
            "speakerId": 1000,
            "speakerName": "Lan",
            "text": "I mean, I am the president of the Liyue Adventurers' Guild. Dealing with monsters is pretty typical for me."
          }
        }
      }
    },

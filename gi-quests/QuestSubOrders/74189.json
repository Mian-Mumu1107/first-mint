        "dialogs": {
          "741890501": {
            "id": "741890501",
            "speakerId": 5285,
            "speakerName": "Permingeat",
            "text": "One moment please. Would you like to hear a secret about the treasure?",
            "nextDialogs": [
              "741890502"
            ]
          },
          "741890502": {
            "id": "741890502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What secret?",
            "nextDialogs": [
              "741890503"
            ]
          },
          "741890503": {
            "id": "741890503",
            "speakerId": 5285,
            "speakerName": "Permingeat",
            "text": "It has to do with treasure and the key to opening the gate. How does that sound? Interested?",
            "nextDialogs": [
              "741890506"
            ]
          },
          "741890506": {
            "id": "741890506",
            "speakerId": 5285,
            "speakerName": "Permingeat",
            "text": "Of course not! We wouldn't dream of asking tavern guests to run errands.",
            "nextDialogs": [
              "741890507"
            ]
          },
          "741890507": {
            "id": "741890507",
            "speakerId": 5285,
            "speakerName": "Permingeat",
            "text": "See this naval artillery by my side and the rubble it's pointed at?",
            "nextDialogs": [
              "741890508"
            ]
          },
          "741890508": {
            "id": "741890508",
            "speakerId": 5285,
            "speakerName": "Permingeat",
            "text": "Activate the cannon and blow up those rocks, and any treasure you uncover is yours for the taking.",
            "nextDialogs": [
              "741890509"
            ]
          },
          "741890509": {
            "id": "741890509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Who on Teyvat named that cannon?",
            "nextDialogs": [
              "741890510"
            ]
          },
          "741890510": {
            "id": "741890510",
            "speakerId": 5285,
            "speakerName": "Permingeat",
            "text": "The helmsman did. I'm not entirely sure myself where he acquired it."
          }
        }
      }
    },
    {
      "subId": "7418903",

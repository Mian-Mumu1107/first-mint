      "dialogue": {
        "startDialogs": [
          "761360301"
        ],
        "dialogs": {
          "761360301": {
            "id": "761360301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Perhaps <color=#FFCC33FF>Jahoda</color> would like to inspect the chest...)",
            "nextDialogs": [
              "761360302"
            ]
          },
          "761360302": {
            "id": "761360302",
            "speakerId": 1003,
            "speakerName": "Jahoda",
            "text": "Heh heh... Let's see how much we've made recently.",
            "nextDialogs": [
              "761360303"
            ]
          },
          "761360303": {
            "id": "761360303",
            "speakerId": 1003,
            "speakerName": "Jahoda",
            "text": "I remember Boss saying she was going to give me a bonus. How about I help m—",
            "nextDialogs": [
              "761360304"
            ]
          },
          "761360304": {
            "id": "761360304",
            "speakerId": 1003,
            "speakerName": "Jahoda",
            "text": "Huh? Where's the money? There's nothing in here but a slip of paper...",
            "nextDialogs": [
              "761360305"
            ]
          },
          "761360305": {
            "id": "761360305",
            "speakerId": 1003,
            "speakerName": "Jahoda",
            "text": "\"My dear Jahoda, your bonus doesn't come from this box. Be sure to close it properly afterward.\"",
            "nextDialogs": [
              "761360306"
            ]
          },
          "761360306": {
            "id": "761360306",
            "speakerId": 1003,
            "speakerName": "Jahoda",
            "text": "Pfft, Boss is trying to scare me again. Maybe there's a hidden compartment inside here somewhere...",
            "nextDialogs": [
              "761360307"
            ]
          },
          "761360307": {
            "id": "761360307",
            "speakerId": 1001,
            "speakerName": "Nefer",
            "text": "There isn't any hidden compartment in there. Your bonus is right here.",
            "nextDialogs": [
              "761360308"
            ]
          },
          "761360308": {
            "id": "761360308",
            "speakerId": 1003,
            "speakerName": "Jahoda",
            "text": "Oh, thanks Boss. I—",
            "nextDialogs": [
              "761360309"
            ]
          },
          "761360309": {
            "id": "761360309",
            "speakerId": 1003,
            "speakerName": "Jahoda",
            "text": "Eeek! BOSS!!! I-I-I was just doing a cash count!!!",
            "nextDialogs": [
              "761360310"
            ]
          },
          "761360310": {
            "id": "761360310",
            "speakerId": 1003,
            "speakerName": "Jahoda",
            "text": "I will get to work now, right now—",
            "nextDialogs": [
              "761360311"
            ]
          },
          "761360311": {
            "id": "761360311",
            "speakerId": 1001,
            "speakerName": "Nefer",
            "text": "Stop right there.",
            "nextDialogs": [
              "761360312"
            ]
          },
          "761360312": {
            "id": "761360312",
            "speakerId": 1003,
            "speakerName": "Jahoda",
            "text": "Yes, Boss!",
            "nextDialogs": [
              "761360313"
            ]
          },
          "761360313": {
            "id": "761360313",
            "speakerId": 1001,
            "speakerName": "Nefer",
            "text": "Lock the box properly.",
            "nextDialogs": [
              "761360314"
            ]
          },
          "761360314": {
            "id": "761360314",
            "speakerId": 1003,
            "speakerName": "Jahoda",
            "text": "Yes, Boss!",
            "nextDialogs": [
              "761360315"
            ]
          },
          "761360315": {
            "id": "761360315",
            "speakerId": 1001,
            "speakerName": "Nefer",
            "text": "Now you can go.",
            "nextDialogs": [
              "761360316"
            ]
          },
          "761360316": {
            "id": "761360316",
            "speakerId": 1003,
            "speakerName": "Jahoda",
            "text": "Yes, Boss!"
          }
        }
      }

        "dialogs": {
          "761870401": {
            "id": "761870401",
            "speakerId": 1001,
            "speakerName": "Mamere",
            "text": "Hehehe... This food is delicious!",
            "nextDialogs": [
              "761870402"
            ]
          },
          "761870402": {
            "id": "761870402",
            "speakerId": 1002,
            "speakerName": "Marionette",
            "text": "(Let's sit like this for a little while longer.)",
            "nextDialogs": [
              "761870404"
            ]
          },
          "761870404": {
            "id": "761870404",
            "speakerId": 1001,
            "speakerName": "Mamere",
            "text": "Huh!? So soon? Thank you, Miss Sandrone! I hope to see you next time!"
          }
        }
      }
    }

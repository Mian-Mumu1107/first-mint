    {
      "subId": "7618703",
      "subQuestName": "Enjoy teatime",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761870301"
        ],
        "dialogs": {
          "761870301": {
            "id": "761870301",
            "speakerId": 1000,
            "speakerName": "Seymour",
            "text": "Please accept my gratitude, Miss Sandrone, on behalf of Miss Mamere, for your kind invitation.",
            "nextDialogs": [
              "761870302"
            ]
          },
          "761870302": {
            "id": "761870302",
            "speakerId": 1001,
            "speakerName": "Mamere",
            "text": "Mmhmm, this food is delicious. Thank you, Sandrone. Your culinary skills are amazing!",
            "nextDialogs": [
              "761870303"
            ]
          },
          "761870303": {
            "id": "761870303",
            "speakerId": 1002,
            "speakerName": "Marionette",
            "text": "I'm glad you like it.",
            "nextDialogs": [
              "761870304"
            ]
          },
          "761870304": {
            "id": "761870304",
            "speakerId": 1002,
            "speakerName": "Marionette",
            "text": "But Prototype 4ACV07, I believe this is the first time we've met? How did you recognize me?",
            "nextDialogs": [
              "761870305"
            ]
          },
          "761870305": {
            "id": "761870305",
            "speakerId": 1001,
            "speakerName": "Mamere",
            "text": "Whoa, that's the first time I've heard anyone call Seymour that...",
            "nextDialogs": [
              "761870306"
            ]
          },
          "761870306": {
            "id": "761870306",
            "speakerId": 1000,
            "speakerName": "Seymour",
            "text": "Affirmative. Although I am familiar with your gentleness and radiance, I have never seen you in the flesh before, Miss Sandrone.",
            "nextDialogs": [
              "761870307"
            ]
          },
          "761870307": {
            "id": "761870307",
            "speakerId": 1000,
            "speakerName": "Seymour",
            "text": "I can recognize you because your appearance is an exact match of my master, Miss Mary-Ann Guillotin. Her image is permanently recorded in my memory unit.",
            "nextDialogs": [
              "761870308"
            ]
          },
          "761870308": {
            "id": "761870308",
            "speakerId": 1000,
            "speakerName": "Seymour",
            "text": "Miss Mary-Ann told me about you. Since your appearance matches hers, the logical reasoning required to recognize you is quite simple, Miss Sandrone.",
            "nextDialogs": [
              "761870309"
            ]
          },
          "761870309": {
            "id": "761870309",
            "speakerId": 1002,
            "speakerName": "Marionette",
            "text": "Hah, even Alain's earliest work is so impressive. Though it appears you've had a few enhancements made... I suppose I should address you as Seymour now?",
            "nextDialogs": [
              "761870310"
            ]
          },
          "761870310": {
            "id": "761870310",
            "speakerId": 1002,
            "speakerName": "Marionette",
            "text": "Were you confused when you saw me?",
            "nextDialogs": [
              "761870311"
            ]
          },
          "761870311": {
            "id": "761870311",
            "speakerId": 1000,
            "speakerName": "Seymour",
            "text": "Negative. My primary directive is to accompany and protect Miss Mary-Ann on behalf of Alain Guillotin.",
            "nextDialogs": [
              "761870312"
            ]
          },
          "761870312": {
            "id": "761870312",
            "speakerId": 1000,
            "speakerName": "Seymour",
            "text": "As such, my knowledge of Miss Mary-Ann is complete. And based on a logical analysis of finite-dimensional vector spaces, you and Miss Mary-Ann are totally different, Miss Sandrone.",
            "nextDialogs": [
              "761870313"
            ]
          },
          "761870313": {
            "id": "761870313",
            "speakerId": 1000,
            "speakerName": "Seymour",
            "text": "Like the difference between the tea leaves of Chenyu Vale and the Beryl Region's Bulle Fruit.",
            "nextDialogs": [
              "761870314"
            ]
          },
          "761870314": {
            "id": "761870314",
            "speakerId": 1001,
            "speakerName": "Mamere",
            "text": "Is Sandrone the tea or the Bulle Fruit?",
            "nextDialogs": [
              "761870315"
            ]
          },
          "761870315": {
            "id": "761870315",
            "speakerId": 1000,
            "speakerName": "Seymour",
            "text": "Searching... Insufficient data. Unable to answer.",
            "nextDialogs": [
              "761870316"
            ]
          },
          "761870316": {
            "id": "761870316",
            "speakerId": 1002,
            "speakerName": "Marionette",
            "text": "(*sigh*... I'm glad Alain improved his language module design by the time he created me.)"
          }
        }
      }
    },
    {
      "subId": "7618704",
      "subQuestName": "Enjoy teatime",
      "sceneId": null,
      "locations": [],

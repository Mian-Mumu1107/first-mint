    {
      "subId": "1204010",
      "subQuestName": "Defeat the Rifthounds",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1204011",
      "subQuestName": "Talk to the person who appeared",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120400401"
        ],
        "dialogs": {
          "120400401": {
            "id": "120400401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, something seems wrong with Ei...",
            "nextDialogs": [
              "120400402"
            ]
          },
          "120400402": {
            "id": "120400402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Are you feeling okay?",
            "nextDialogs": [
              "120400403"
            ]
          },
          "120400403": {
            "id": "120400403",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Why would you ask that?",
            "nextDialogs": [
              "120400404"
            ]
          },
          "120400404": {
            "id": "120400404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, usually, you'd pull out your sword and \"swish,\" vaporize them all in one go, no?",
            "nextDialogs": [
              "120400405"
            ]
          },
          "120400405": {
            "id": "120400405",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "You are unduly concerned. I'm simply conserving my energy.",
            "nextDialogs": [
              "120400406"
            ]
          },
          "120400406": {
            "id": "120400406",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Although I have some understanding of the situation already, it could take an unexpected turn at any time.",
            "nextDialogs": [
              "120400407"
            ]
          },
          "120400407": {
            "id": "120400407",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "I must be prepared for anything. If there are more formidable monsters lying in wait in this area, I must make sure I have the strength to face them.",
            "nextDialogs": [
              "120400408"
            ]
          },
          "120400408": {
            "id": "120400408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah, makes sense! Spoken like a seasoned shogun.",
            "nextDialogs": [
              "120400409"
            ]
          },
          "120400409": {
            "id": "120400409",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The roots seem pretty badly damaged this time... We definitely need to tell the Yashiro Commission about this.",
            "nextDialogs": [
              "120400410"
            ]
          },
          "120400410": {
            "id": "120400410",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, the same light is leaking out again.",
            "nextDialogs": [
              "120400411"
            ]
          },
          "120400411": {
            "id": "120400411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is it the same situation as before?",
            "nextDialogs": [
              "120400412"
            ]
          },
          "120400412": {
            "id": "120400412",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "...Furuyama? Is that you?",
            "nextDialogs": [
              "120400413"
            ]
          },
          "120400413": {
            "id": "120400413",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "Hmm?",
            "nextDialogs": [
              "120400414"
            ]
          },
          "120400414": {
            "id": "120400414",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "Almighty Shogun? What brings you back so soon? I thought you were off fighting a battle in a distant land?",
            "nextDialogs": [
              "120400415"
            ]
          },
          "120400415": {
            "id": "120400415",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(Fighting a battle in a distant land? Sounds like this guy's talking about 500 years ago, too.)",
            "nextDialogs": [
              "120400416"
            ]
          },
          "120400416": {
            "id": "120400416",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Allow me to introduce Furuyama. He is a tea master and a member of my retinue.",
            "nextDialogs": [
              "120400417"
            ]
          },
          "120400417": {
            "id": "120400417",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Though blind, Furuyama is unparalleled in his ability to appraise tea. He brews some of the very finest tea in all of Inazuma.",
            "nextDialogs": [
              "120400418"
            ]
          },
          "120400418": {
            "id": "120400418",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "Your Excellency, you shower me with praise undeserved. I have simply had the good fortune to be in Your Excellency's presence long enough to become acquainted with all the skills that are required of me.",
            "nextDialogs": [
              "120400419"
            ]
          },
          "120400419": {
            "id": "120400419",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "It sounds like the Almighty Shogun has brought a guest?",
            "nextDialogs": [
              "120400420"
            ]
          },
          "120400420": {
            "id": "120400420",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "...I'm afraid I am unable to serve you any respectable refreshments on account of the current situation... but please sit and rest.",
            "nextDialogs": [
              "120400421"
            ]
          },
          "120400421": {
            "id": "120400421",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "After all... it's quite a mess out there.",
            "nextDialogs": [
              "120400422"
            ]
          },
          "120400422": {
            "id": "120400422",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um... what should we do?",
            "nextDialogs": [
              "120400425"
            ]
          },
          "120400425": {
            "id": "120400425",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, um... yeah, sheesh, there's monsters everywhere out there, it's pitch-black, and loads of people have been injured...",
            "nextDialogs": [
              "120400426"
            ]
          },
          "120400426": {
            "id": "120400426",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "I see. So they have fought their way this far already.",
            "nextDialogs": [
              "120400427"
            ]
          },
          "120400427": {
            "id": "120400427",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "Most of the residents in this neighborhood have already escaped. They wanted to take me with them, but it seemed rather pointless to me. So I decided to stay.",
            "nextDialogs": [
              "120400428"
            ]
          },
          "120400428": {
            "id": "120400428",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "And now the Almighty Shogun is here, I have even less reason to run away, hehe.",
            "nextDialogs": [
              "120400429"
            ]
          },
          "120400429": {
            "id": "120400429",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "Imagine, if this was something that even the Almighty Shogun was powerless to resolve, where could I possibly run to then?",
            "nextDialogs": [
              "120400430"
            ]
          },
          "120400430": {
            "id": "120400430",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How come you're not panicking?",
            "nextDialogs": [
              "120400431"
            ]
          },
          "120400431": {
            "id": "120400431",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "People flee out of a desire to live on. And the desire to live on stems from a feeling of having unfinished business in life.",
            "nextDialogs": [
              "120400432"
            ]
          },
          "120400432": {
            "id": "120400432",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "But me? I have no such thoughts, and I have no regrets.",
            "nextDialogs": [
              "120400433"
            ]
          },
          "120400433": {
            "id": "120400433",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "The Almighty Shogun often speaks to me about her dreams over tea.",
            "nextDialogs": [
              "120400434"
            ]
          },
          "120400434": {
            "id": "120400434",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "Just listening to her stories, ahh... I've been blind for many years, but her vivid descriptions took me on a splendid journey to all the most beautiful places in Inazuma... Over time, I've come to understand her mindset. Quite the romantic at heart. A true dreamer.",
            "nextDialogs": [
              "120400435"
            ]
          },
          "120400435": {
            "id": "120400435",
            "speakerId": 12377,
            "speakerName": "Furuyama",
            "text": "One thing she always says is... \"Good things don't last forever. Everything changes, fades, disappears completely over the passage of time. And so, people must make the most of the life they have, seize the chance to enjoy it while it lasts, and have no regrets in the end...\"",
            "nextDialogs": [
              "120400436"
            ]
          },
          "120400436": {
            "id": "120400436",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Umm..."
          }
        }
      }
    },
    {
      "subId": "1204012",
      "subQuestName": "Go to the Kamisato Estate to get a tea set",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1204013",
      "subQuestName": "Talk to Ei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120400505"
        ],
        "dialogs": {
          "120400505": {
            "id": "120400505",
            "speakerId": 3100,
            "speakerName": "Hirano",
            "text": "It's the Traveler, and... the Almighty Shogun!",
            "nextDialogs": [
              "120400506"
            ]
          },
          "120400506": {
            "id": "120400506",
            "speakerId": 3100,
            "speakerName": "Hirano",
            "text": "How might I be of assistance, Your Excellency?",
            "nextDialogs": [
              "120400507"
            ]
          },
          "120400507": {
            "id": "120400507",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "I wish to borrow a tea set from the Yashiro Commission.",
            "nextDialogs": [
              "120400508"
            ]
          },
          "120400508": {
            "id": "120400508",
            "speakerId": 3100,
            "speakerName": "Hirano",
            "text": "Oh, uh, sure! I'll fetch that for you right away.",
            "nextDialogs": [
              "120400509"
            ]
          },
          "120400509": {
            "id": "120400509",
            "speakerId": 3100,
            "speakerName": "Hirano",
            "text": "Uh, please step into the courtyard and have a rest, Almighty Shogun. Oh, and I'll inform my lord about your visit immediately. Ah, and the tea set, I'll bring that here as soon as it's ready...",
            "nextDialogs": [
              "120400510"
            ]
          },
          "120400510": {
            "id": "120400510",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Be at ease, I'm not here to see Commissioner Kamisato. Actually, I'd prefer to spend this time chatting with the Traveler. Please, fetch the tea set at your convenience.",
            "nextDialogs": [
              "120400511"
            ]
          },
          "120400511": {
            "id": "120400511",
            "speakerId": 3100,
            "speakerName": "Hirano",
            "text": "No, no, no. I am your humble servant, I daren't think of my own convenience when the Almighty Shogun graces me with her presence! I'll deal with it right away.",
            "nextDialogs": [
              "120400512"
            ]
          },
          "120400512": {
            "id": "120400512",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Well, it's not often we have the chance to chat. I'm sure you must have a lot of questions?",
            "nextDialogs": [
              "120400513"
            ]
          },
          "120400513": {
            "id": "120400513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Was it really you that that tea master used to serve?",
            "nextDialogs": [
              "120400514"
            ]
          },
          "120400514": {
            "id": "120400514",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Right, Paimon wanted to ask that, too! The Almighty Shogun that he described didn't sound anything like you at all.",
            "nextDialogs": [
              "120400515"
            ]
          },
          "120400515": {
            "id": "120400515",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "I seldom had the time to drink tea. Any free time I had was spent practicing martial arts.",
            "nextDialogs": [
              "120400516"
            ]
          },
          "120400516": {
            "id": "120400516",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "So in the vast majority of cases, the one he made tea for was the former Electro Archon... who was also my sister. Raiden Makoto.",
            "nextDialogs": [
              "120400517"
            ]
          },
          "120400517": {
            "id": "120400517",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "He may well have had an inkling about there being two \"Raiden Shoguns.\" But he always acted as if he was completely unaware of it.",
            "nextDialogs": [
              "120400518"
            ]
          },
          "120400518": {
            "id": "120400518",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "The philosophy of life that he shared with us just now, that was Makoto's view on reality. She always saw things that way.",
            "nextDialogs": [
              "120400519"
            ]
          },
          "120400519": {
            "id": "120400519",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You and Makoto had pretty different views, huh...",
            "nextDialogs": [
              "120400520"
            ]
          },
          "120400520": {
            "id": "120400520",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Indeed we did. It was the biggest difference between us.",
            "nextDialogs": [
              "120400521"
            ]
          },
          "120400521": {
            "id": "120400521",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "In her eyes, the most precious things in this world were dreams — the yearning for a better future held by living beings.",
            "nextDialogs": [
              "120400522"
            ]
          },
          "120400522": {
            "id": "120400522",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Dreams... or in other words, \"ambitions\"?",
            "nextDialogs": [
              "120400523"
            ]
          },
          "120400523": {
            "id": "120400523",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "They are similar, but not identical.",
            "nextDialogs": [
              "120400524"
            ]
          },
          "120400524": {
            "id": "120400524",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "When you came charging into the Plane of Euthymia, I saw human aspirations light up the sky far above in the form of countless stars. This... somewhat shook me.",
            "nextDialogs": [
              "120400525"
            ]
          },
          "120400525": {
            "id": "120400525",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Now, it seems like she was right, while I took the wayward path.",
            "nextDialogs": [
              "120400526"
            ]
          },
          "120400526": {
            "id": "120400526",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow. There sure was a lot going on beneath the surface...",
            "nextDialogs": [
              "120400527"
            ]
          },
          "120400527": {
            "id": "120400527",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Makoto saw a bigger picture than I did. In her view, a \"dream\" is more imaginary, more abstract than an \"ambition.\"",
            "nextDialogs": [
              "120400528"
            ]
          },
          "120400528": {
            "id": "120400528",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "An \"ambition\" is a yearning for something material, or a concrete outcome. It is finite in nature, and will be replaced by a new ambition in due course.",
            "nextDialogs": [
              "120400529"
            ]
          },
          "120400529": {
            "id": "120400529",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Makoto was more concerned with the force that drives humans to constantly generate new ambitions in the first place. It is something innate, rooted in instinct — in other words... it is something eternal.",
            "nextDialogs": [
              "120400530"
            ]
          },
          "120400530": {
            "id": "120400530",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's, uh, quite a lot to take in...",
            "nextDialogs": [
              "120400531"
            ]
          },
          "120400531": {
            "id": "120400531",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "To put it simply, Makoto wasn't concerned about outcomes.",
            "nextDialogs": [
              "120400532"
            ]
          },
          "120400532": {
            "id": "120400532",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "I didn't understand at the time. How can we say that we are maintaining eternity when things are constantly moving forward and evolving?",
            "nextDialogs": [
              "120400533"
            ]
          },
          "120400533": {
            "id": "120400533",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "I suppose what it comes down to is the definition of \"eternity\" she set out with.",
            "nextDialogs": [
              "120400534"
            ]
          },
          "120400534": {
            "id": "120400534",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It seems more in line with how humans view the world.",
            "nextDialogs": [
              "120400535"
            ]
          },
          "120400535": {
            "id": "120400535",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Yes, it does. I always thought that she must have grasped some elusive, arcane wisdom to arrive at the conclusions she did.",
            "nextDialogs": [
              "120400536"
            ]
          },
          "120400536": {
            "id": "120400536",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "But in the last analysis, Makoto's philosophy was — on the surface, at least — an elegantly simple one. Notwithstanding that it was also the more prudent choice, based on a more mature, far-sighted outlook.",
            "nextDialogs": [
              "120400537"
            ]
          },
          "120400537": {
            "id": "120400537",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Do you feel you're starting to understand her better now?",
            "nextDialogs": [
              "120400538"
            ]
          },
          "120400538": {
            "id": "120400538",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "You have already witnessed my previous views on eternity.",
            "nextDialogs": [
              "120400539"
            ]
          },
          "120400539": {
            "id": "120400539",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "But now, I no longer cling to what was lost. I suppose that means our differences have been reconciled.",
            "nextDialogs": [
              "120400540"
            ]
          },
          "120400540": {
            "id": "120400540",
            "speakerId": 3100,
            "speakerName": "Hirano",
            "text": "Almighty Shogun, I found a tea set! This one in particular should be fit for Your Excellency's use...",
            "nextDialogs": [
              "120400541"
            ]
          },
          "120400541": {
            "id": "120400541",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "It's quite beautiful. Thank you.",
            "nextDialogs": [
              "120400542"
            ]
          },
          "120400542": {
            "id": "120400542",
            "speakerId": 3100,
            "speakerName": "Hirano",
            "text": "You are too kind, a humble servant such as I does not deserve the gratitude of the Almighty Shogun...",
            "nextDialogs": [
              "120400543"
            ]
          },
          "120400543": {
            "id": "120400543",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's all good, Sir! She's actually pretty chill.",
            "nextDialogs": [
              "120400544"
            ]
          },
          "120400544": {
            "id": "120400544",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Let us return. We ought not keep Furuyama waiting too long."
          }
        }
      }
    },

    {
      "subId": "1204008",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120400801"
        ],
        "dialogs": {
          "120400801": {
            "id": "120400801",
            "speakerId": 30769,
            "speakerName": "Hirano",
            "text": "Take care, Almighty Shogun. You too, Traveler... And you too, um, uh... y—you take care too, anyway."
          }
        }
      }
    },
    {
      "subId": "1204099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120409901"
        ],
        "dialogs": {
          "120409901": {
            "id": "120409901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The Sacred Sakura's in danger again, huh. Who'd have thought.",
            "nextDialogs": [
              "120409902"
            ]
          },
          "120409902": {
            "id": "120409902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Keeping the Sacred Sakura safe was Hanachirusato's greatest wish, and now these mangy mutts are trying to destroy it. Time to teach them a lesson!",
            "nextDialogs": [
              "120409903"
            ]
          },
          "120409903": {
            "id": "120409903",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They're attacking the Sacred Sakura! Stop them!",
            "nextDialogs": [
              "120409904"
            ]
          },
          "120409904": {
            "id": "120409904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This color... It's similar to the color when the Sacred Sakura takes damage!",
            "nextDialogs": [
              "120409905"
            ]
          },
          "120409905": {
            "id": "120409905",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's follow it, it should be this way.",
            "nextDialogs": [
              "120409906"
            ]
          },
          "120409906": {
            "id": "120409906",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "As expected, there are a load of rifthounds here, too.",
            "nextDialogs": [
              "120409907"
            ]
          },
          "120409907": {
            "id": "120409907",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Leave them to me.",
            "nextDialogs": [
              "120409908"
            ]
          },
          "120409908": {
            "id": "120409908",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Where should we go to find a tea set?",
            "nextDialogs": [
              "120409909"
            ]
          },
          "120409909": {
            "id": "120409909",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Having a cup of tea isn't exactly the most urgent thing to do right now... but at the same time, this lovely old man from 500 years ago has been through so much, and it makes Paimon so sad...",
            "nextDialogs": [
              "120409910"
            ]
          },
          "120409910": {
            "id": "120409910",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "I'm also feeling very nostalgic for his tea.",
            "nextDialogs": [
              "120409911"
            ]
          },
          "120409911": {
            "id": "120409911",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, why don't we go to the Kamisato Estate? There'll definitely be a tea set we can borrow there.",
            "nextDialogs": [
              "120409912"
            ]
          },
          "120409912": {
            "id": "120409912",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "I'm also feeling very nostalgic for his tea.",
            "nextDialogs": [
              "120409913"
            ]
          },
          "120409913": {
            "id": "120409913",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, why don't we go to the Kamisato Estate? There'll definitely be a tea set we can borrow there."
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "1204001",
      "subQuestName": "Talk to Katheryne",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120400101"
        ],
        "dialogs": {
          "120400101": {
            "id": "120400101",
            "speakerId": 3004,
            "speakerName": "Katheryne",
            "text": "#Ad astra abyssosque, {NICKNAME}.",
            "nextDialogs": [
              "120400102"
            ]
          },
          "120400102": {
            "id": "120400102",
            "speakerId": 3004,
            "speakerName": "Katheryne",
            "text": "Recently, the Adventurers' Guild has received an unusual commission, and after careful consideration, we believe that—",
            "nextDialogs": [
              "120400103"
            ]
          },
          "120400103": {
            "id": "120400103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"The traveler would be the most suitable candidate.\" Right?",
            "nextDialogs": [
              "120400104"
            ]
          },
          "120400104": {
            "id": "120400104",
            "speakerId": 3004,
            "speakerName": "Katheryne",
            "text": "Hehe, indeed. As ever.",
            "nextDialogs": [
              "120400105"
            ]
          },
          "120400105": {
            "id": "120400105",
            "speakerId": 3004,
            "speakerName": "Katheryne",
            "text": "I will spare the pleasantries, then. May I ask if you two are available to help?",
            "nextDialogs": [
              "120400108"
            ]
          },
          "120400108": {
            "id": "120400108",
            "speakerId": 3004,
            "speakerName": "Katheryne",
            "text": "Well, let me go over it briefly. Our client for this job is the Yashiro Commission. Apparently, rifthounds are attacking the roots of the Sacred Sakura nearby Mt. Yougou in great numbers.",
            "nextDialogs": [
              "120400109"
            ]
          },
          "120400109": {
            "id": "120400109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Rifthounds? ...On Narukami Island?",
            "nextDialogs": [
              "120400110"
            ]
          },
          "120400110": {
            "id": "120400110",
            "speakerId": 3004,
            "speakerName": "Katheryne",
            "text": "Yes. We are not sure where exactly these creatures come from. But this time, they are attacking in alarming numbers with great aggression and a clear target.",
            "nextDialogs": [
              "120400111"
            ]
          },
          "120400111": {
            "id": "120400111",
            "speakerId": 3004,
            "speakerName": "Katheryne",
            "text": "The Sacred Sakura is of tremendous importance to Inazuma. I trust you are aware of this already?"
          }
        }
      }
    },
    {
      "subId": "1204002",
      "subQuestName": "Go to the area where the monsters have appeared",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120400201"
        ],
        "dialogs": {
          "120400201": {
            "id": "120400201",
            "speakerId": 1002,
            "speakerName": "Raiden Shogun?",
            "text": "Torn to oblivion!",
            "nextDialogs": [
              "120400202"
            ]
          },
          "120400202": {
            "id": "120400202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Sh—Shogun? Wait, no... could also be Ei...",
            "nextDialogs": [
              "120400203"
            ]
          },
          "120400203": {
            "id": "120400203",
            "speakerId": 1002,
            "speakerName": "Raiden Shogun?",
            "text": "...It's you two.",
            "nextDialogs": [
              "120400204"
            ]
          },
          "120400204": {
            "id": "120400204",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "It has been a long time. We have not seen each other since the resolution of the Tenryou Commission crisis.",
            "nextDialogs": [
              "120400205"
            ]
          },
          "120400205": {
            "id": "120400205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay, sounds more like Ei... it is you, right?",
            "nextDialogs": [
              "120400206"
            ]
          },
          "120400206": {
            "id": "120400206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You sure made short work of them. That was amazing!",
            "nextDialogs": [
              "120400209"
            ]
          },
          "120400209": {
            "id": "120400209",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "I'm making early preparations for what is to come.",
            "nextDialogs": [
              "120400210"
            ]
          },
          "120400210": {
            "id": "120400210",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Last time we took a walk around Inazuma together, I witnessed the way the world is today. I was finally able to comprehend some things that I had never understood in the past.",
            "nextDialogs": [
              "120400211"
            ]
          },
          "120400211": {
            "id": "120400211",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Since then, every time I encounter an obstacle in my thinking, I find myself having the urge to spend some time in the outside world.",
            "nextDialogs": [
              "120400212"
            ]
          },
          "120400212": {
            "id": "120400212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Makes sense. You must get super bored being stuck in there all the time.",
            "nextDialogs": [
              "120400213"
            ]
          },
          "120400213": {
            "id": "120400213",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "...Might I remind you that I am not here to amuse myself.",
            "nextDialogs": [
              "120400214"
            ]
          },
          "120400214": {
            "id": "120400214",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Recently, I have observed a number of changes in the external world from the Plane of Euthymia. The most serious of these being the attack on the Sacred Sakura by numerous rifthounds.",
            "nextDialogs": [
              "120400215"
            ]
          },
          "120400215": {
            "id": "120400215",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "I considered this matter worthy of my attention. So I pursued them, and they led me here, where I happened to run into you."
          }
        }
      }
    },
    {
      "subId": "1204003",
      "subQuestName": "Defeat the Rifthounds",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120400301"
        ],
        "dialogs": {
          "120400301": {
            "id": "120400301",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "We are lucky... the damage is not too serious. The Yashiro Commission will be able to nurse the root system back to health.",
            "nextDialogs": [
              "120400302"
            ]
          },
          "120400302": {
            "id": "120400302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This stuff that's flowing out, is it sap or something? And how come it's glowing...",
            "nextDialogs": [
              "120400303"
            ]
          },
          "120400303": {
            "id": "120400303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Huh?",
            "nextDialogs": [
              "120400304"
            ]
          },
          "120400304": {
            "id": "120400304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wh—What's this?",
            "nextDialogs": [
              "120400307"
            ]
          },
          "120400307": {
            "id": "120400307",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Could they be... dead people? It wouldn't be the first time we'd seen ghosts on our journey.",
            "nextDialogs": [
              "120400308"
            ]
          },
          "120400308": {
            "id": "120400308",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But... why would they appear here?",
            "nextDialogs": [
              "120400309"
            ]
          },
          "120400309": {
            "id": "120400309",
            "speakerId": 12076,
            "speakerName": "Ei",
            "text": "Let's search the area. Perhaps we will find out.",
            "nextDialogs": [
              "120400310"
            ]
          },
          "120400310": {
            "id": "120400310",
            "speakerId": 12375,
            "speakerName": "Kitamura",
            "text": "Ugh... ugh...",
            "nextDialogs": [
              "120400311"
            ]
          },
          "120400311": {
            "id": "120400311",
            "speakerId": 12375,
            "speakerName": "Kitamura",
            "text": "I can't go on like this... not when the other troops are counting on me...",
            "nextDialogs": [
              "120400312"
            ]
          },
          "120400312": {
            "id": "120400312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What happened here? Could you tell us?",
            "nextDialogs": [
              "120400313"
            ]
          },
          "120400313": {
            "id": "120400313",
            "speakerId": 12375,
            "speakerName": "Kitamura",
            "text": "Who are you? What are you doing here?",
            "nextDialogs": [
              "120400314"
            ]
          },
          "120400314": {
            "id": "120400314",
            "speakerId": 12375,
            "speakerName": "Kitamura",
            "text": "Run, quick, while you still can! The monsters will be back... And once you're in their sights, I'm telling you — there's no escaping them!",
            "nextDialogs": [
              "120400315"
            ]
          },
          "120400315": {
            "id": "120400315",
            "speakerId": 12375,
            "speakerName": "Kitamura",
            "text": "We will defend Inazuma... until our dying breath!"
          }
        }
      }
    },

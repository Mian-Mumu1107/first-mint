    {
      "subId": "4012901",
      "subQuestName": "Go to Freminet's camp",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401290101"
        ],
        "dialogs": {
          "401290101": {
            "id": "401290101",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Is your child feeling any better?",
            "nextDialogs": [
              "401290102"
            ]
          },
          "401290102": {
            "id": "401290102",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Thank you for your concern, Freminet. His condition is fairly stable. The family doctor said we might be able to take him out for a stroll today.",
            "nextDialogs": [
              "401290103"
            ]
          },
          "401290103": {
            "id": "401290103",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Zuria! Freminet! We're here.",
            "nextDialogs": [
              "401290104"
            ]
          },
          "401290104": {
            "id": "401290104",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Hehe, seems like everyone's arrived now.",
            "nextDialogs": [
              "401290105"
            ]
          },
          "401290105": {
            "id": "401290105",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Not quite, aren't we missing someone? But Paimon has a guess where he might be!",
            "nextDialogs": [
              "401290106"
            ]
          },
          "401290106": {
            "id": "401290106",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Hey! Thelxieeee!",
            "nextDialogs": [
              "401290107"
            ]
          },
          "401290107": {
            "id": "401290107",
            "speakerId": 1003,
            "speakerName": "Thelxie",
            "text": "-.. -... . -- -...?",
            "nextDialogs": [
              "401290108"
            ]
          },
          "401290108": {
            "id": "401290108",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Whoa! Thelxie's got himself a sword and a shield now! He's lookin' sharp.",
            "nextDialogs": [
              "401290109"
            ]
          },
          "401290109": {
            "id": "401290109",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Indeed, with his weapons in hand, Thelxie looks more formidable than ever. You've really outdone yourself, Freminet.",
            "nextDialogs": [
              "401290110"
            ]
          },
          "401290110": {
            "id": "401290110",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "We helped, too!",
            "nextDialogs": [
              "401290111"
            ]
          },
          "401290111": {
            "id": "401290111",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Yes, you really had a good eye for materials. Everything you found was high quality.",
            "nextDialogs": [
              "401290112"
            ]
          },
          "401290112": {
            "id": "401290112",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Speaking of which, Zuria just told me that she wants to end the adventure with a coronation ceremony. So, could I also trouble you with finding some materials for the crown?",
            "nextDialogs": [
              "401290113"
            ]
          },
          "401290113": {
            "id": "401290113",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "You can just keep an eye out for them on our way to the ruins. I was planning to collect the materials myself, but then I realized you might be able to find some prettier ones than what I could get my hands on.",
            "nextDialogs": [
              "401290114"
            ]
          },
          "401290114": {
            "id": "401290114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Consider it done.",
            "nextDialogs": [
              "401290115"
            ]
          },
          "401290115": {
            "id": "401290115",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Seems like everything's ready to go. Shall we head out?",
            "nextDialogs": [
              "401290116"
            ]
          },
          "401290116": {
            "id": "401290116",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Please wait a moment. I was just thinking... Since Thelxie has already shown us his brand-new appearance, we may already be able to draw a new page in the picture book. What do you think?",
            "nextDialogs": [
              "401290117"
            ]
          },
          "401290117": {
            "id": "401290117",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Ooh! Paimon's excited now!",
            "nextDialogs": [
              "401290118"
            ]
          },
          "401290118": {
            "id": "401290118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What should we draw on the page?",
            "nextDialogs": [
              "401290119"
            ]
          },
          "401290119": {
            "id": "401290119",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Hmm, why don't we use the story we know as a reference? Just make the atmosphere a bit less grim...",
            "nextDialogs": [
              "401290120"
            ]
          },
          "401290120": {
            "id": "401290120",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "So we'll take out the sad parts and replace them with happier stuff? Sounds great to Paimon.",
            "nextDialogs": [
              "401290121"
            ]
          },
          "401290121": {
            "id": "401290121",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Alright, I'll give it a try. I'm not very adept at drawing, but I've seen a lot of art during my work. Now, as for the actual content of the drawing... please tell me what you'd like to see.",
            "nextDialogs": [
              "401290122"
            ]
          },
          "401290122": {
            "id": "401290122",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "Let me think... We can draw the weapon. The prince has picked up the sword of courage and the shield of perseverance, which proves he has crossed the mire of doubt, and is now ready to wage war against the darkness.",
            "nextDialogs": [
              "401290123"
            ]
          },
          "401290123": {
            "id": "401290123",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Okay, I'll add the weapon... Anything else?",
            "nextDialogs": [
              "401290124"
            ]
          },
          "401290124": {
            "id": "401290124",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon wants to give him some friends! Thelxie's got some friends by his side now, so he's no longer fighting alone.",
            "nextDialogs": [
              "401290125"
            ]
          },
          "401290125": {
            "id": "401290125",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Okay, I'll also draw some companions... Anything else?",
            "nextDialogs": [
              "401290126"
            ]
          },
          "401290126": {
            "id": "401290126",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't forget to add some color.",
            "nextDialogs": [
              "401290127"
            ]
          },
          "401290127": {
            "id": "401290127",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Color. Ah, color... Yes! That's really important. The road in front of him now will no longer be just greyscale, but bursting with color and hope.",
            "nextDialogs": [
              "401290128"
            ]
          },
          "401290128": {
            "id": "401290128",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Who would've thought the page could have become so inspiring... How wonderful. Splendid ideas, everyone.",
            "nextDialogs": [
              "401290129"
            ]
          },
          "401290129": {
            "id": "401290129",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Great! Everyone looks super pumped up, Thelxie most of all!",
            "nextDialogs": [
              "401290130"
            ]
          },
          "401290130": {
            "id": "401290130",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Are you seeing this, my son? Are you feeling inspired by this as well?",
            "nextDialogs": [
              "401290131"
            ]
          },
          "401290131": {
            "id": "401290131",
            "speakerId": 1003,
            "speakerName": "Thelxie",
            "text": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
            "nextDialogs": [
              "401290132"
            ]
          },
          "401290132": {
            "id": "401290132",
            "speakerId": 1000,
            "speakerName": "Freminet",
            "text": "I'm sure he is, Zuria, and this is still just the first page.",
            "nextDialogs": [
              "401290133"
            ]
          },
          "401290133": {
            "id": "401290133",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "That's right, Paimon can't wait to see the picture book when it's all finished! We should finish it as soon as possible, and keep up the belief and hope in our hearts!",
            "nextDialogs": [
              "401290134"
            ]
          },
          "401290134": {
            "id": "401290134",
            "speakerId": 1001,
            "speakerName": "Zuria Destree",
            "text": "Mhm! I'm starting to look forward to it as well, so let's get this show on the road and head towards the Kingdom of Water Imps!",
            "nextDialogs": [
              "401290135"
            ]
          },
          "401290135": {
            "id": "401290135",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yay! Thelxie's Fantastic Adventures begin now!"
          }
        }
      }
    },
